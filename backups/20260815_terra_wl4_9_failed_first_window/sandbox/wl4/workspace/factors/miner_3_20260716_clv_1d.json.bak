{
  "factor_id": "miner_3_clv_1d",
  "factor_name": "One-Day Negative Close-Location Value",
  "version": "20260716",
  "calculation": {
    "expression": "-(2 * (close - low) / (high - low) - 1)",
    "description": "Ranks assets whose completed daily close is nearer the low of the true daily range above those closing near the high; the negative close-location score predicts next trading-day cross-asset returns.",
    "forward_horizon": "1 trading day"
  },
  "dependencies": [
    "open",
    "high",
    "low",
    "close"
  ],
  "parameters": {
    "range_floor": "nonzero",
    "min_cross_section": 8
  },
  "validation": {
