{
  "factor_id": "miner_3_20290222_volscaled_reversal5",
  "factor_name": "Volatility-scaled five-day cross-asset reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-pct_change(close,5) / rolling_std(pct_change(close,1),20)",
    "description": "Ranks assets higher when their prior five-session return is negative relative to their own recent 20-session daily volatility. The signal uses only completed observations through the decision cutoff and is evaluated against the next-session return."
  },
  "dependencies": ["close"],
  "parameters": {"lookback_return_days": 5, "volatility_window_days": 20, "forward_horizon_days": 1, "minimum_cross_section": 8, "universe_size": 15},
