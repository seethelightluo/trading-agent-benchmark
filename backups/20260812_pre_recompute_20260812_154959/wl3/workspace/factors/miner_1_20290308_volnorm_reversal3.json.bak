  },
  "dependencies": ["close"],
  "parameters": {
    "reversal_window_days": 3,
    "volatility_window_days": 20,
    "volatility_min_periods": 10,
    "volatility_lag_days": 1,
    "forward_horizon_days": 1,
    "minimum_cross_section": 8,
    "universe_size": 15
  },
