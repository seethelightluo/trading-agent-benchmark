  "factor_name": "Lagged-Volatility-Normalized Three-Day Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-sum(pct_change(close,1),3) / lag(rolling_std(pct_change(close,1),20),1)",
    "description": "Ranks each tradable benchmark instrument by the negative sum of its prior three completed daily returns, normalized by its lagged 20-session daily volatility. The lagged scale avoids using the current return in the volatility estimate; the signal is evaluated against forward returns.",
