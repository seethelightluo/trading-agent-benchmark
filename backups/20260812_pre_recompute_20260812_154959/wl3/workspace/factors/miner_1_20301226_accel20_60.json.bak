{
  "factor_id": "miner_1_20301226_accel20_60",
  "factor_name": "Volatility-Normalized Trend Acceleration 20/60",
  "version": "1.0",
  "calculation": {
    "expression": "((sum(log_return,20) - sum(log_return,60)/3) / std(log_return,20)).shift(1), cross-sectionally demeaned by median",
    "description": "Measures whether the recent 20-session trend is accelerating relative to the average 20-session pace implied by the prior 60 sessions, normalized by recent volatility. The one-session lag prevents look-ahead bias; cross-sectional median demeaning makes the signal relative across the 15 tradable benchmark assets."
  },
  "dependencies": ["close"],
  "parameters": {"short_window": 20, "long_window": 60, "volatility_window": 20, "forward_horizon": 10, "lag": 1, "min_cross_section": 8},
