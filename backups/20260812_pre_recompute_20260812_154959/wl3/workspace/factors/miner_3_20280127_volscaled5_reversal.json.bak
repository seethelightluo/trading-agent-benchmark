{
  "factor_id": "miner_3_20280127_volscaled5_reversal",
  "factor_name": "Volatility-Scaled Five-Day Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-pct_change(close,5) / (rolling_std(pct_change(close,1),20) * sqrt(252))",
    "description": "Ranks assets positively when their lagged five-session return is low after scaling by trailing 20-session annualized volatility. Signal is shifted one completed session before forward-return testing to prevent look-ahead bias."
  },
  "dependencies": ["close", "daily_returns"],
  "parameters": {"lookback_return_days": 5, "volatility_window_days": 20, "annualization": 252, "signal_lag_days": 1, "minimum_volatility_observations": 15},
  "validation": {
