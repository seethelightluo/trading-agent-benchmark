      "daily_paper_icir": 0.1099950815,
      "ic_hit_ratio": 0.5456285897,
      "ic_observations": 1567,
      "average_valid_instruments": 12.8507,
      "minimum_cross_section": 8,
      "coverage": 1.0,
      "rank_turnover": null,
