{
  "factor_id": "miner_1_20271021_beta_resid_reversal",
  "factor_name": "Market-Beta Residual 5-Day Volatility-Scaled Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(sum_5(asset_return - beta_60*equal_weight_market_return)) / (std_60(asset_return)*sqrt(252))",
    "description": "For each tradable asset, estimate a rolling 60-session beta to the equal-weight 15-asset benchmark return. Rank the negative five-session cumulative beta residual, scaled by trailing 60-session annualized volatility. All inputs end at the prior completed session."
  },
  "dependencies": ["close", "pct_change"],
  "parameters": {"market": "equal_weight_available_tradable_assets", "beta_window": 60, "reversal_window": 5, "volatility_window": 60, "annualization": 252, "winsorization": "none"},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2027-10-20",
    "last_validated": "2027-10-21T00:00:00Z",
    "metrics": {
