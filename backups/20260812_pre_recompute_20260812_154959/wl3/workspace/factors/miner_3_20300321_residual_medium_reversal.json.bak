{
  "factor_id": "miner_3_20300321_residual_medium_reversal",
  "factor_name": "Cross-Asset Residual Medium-Horizon Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-residual_5d_return/(rolling_std_60d_daily_return*sqrt(5)) + 0.25*(-residual_5d_return_lag2)/(rolling_std_60d_daily_return*sqrt(5)); residual = asset_log_return - cross_sectional_median_log_return",
    "description": "Contrarian volatility-scaled five-session return after removing the contemporaneous cross-asset median move, with a small lagged residual-shock component. Signal is cross-sectionally median demeaned and lagged one session to prevent look-ahead."
  },
  "dependencies": ["close"],
  "parameters": {"residual_window_days": 5, "volatility_window_days": 60, "lagged_component": 0.25, "signal_lag_days": 1, "cross_section_minimum": 8},
  "validation": {
