{
  "factor_id": "miner_3_20291129_residual_shock_reversal10",
  "factor_name": "Cross-Asset Residual Shock Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "(-sign(sum(residual_log_return,3))*abs(sum(residual_log_return,3))/rolling_std(residual_log_return,60)/sqrt(3)).shift(1), then cross-sectional median demean",
    "description": "Reverses the magnitude of each asset's three-session return after removing the equal-weight contemporaneous cross-asset market return. The 60-session residual volatility normalization makes shocks comparable across assets, and the one-session lag prevents look-ahead."
  },
  "dependencies": ["close"],
  "parameters": {
    "residual_market": "equal_weight_mean_daily_log_return",
    "shock_window": 3,
    "volatility_window": 60,
    "forward_horizon": 10,
    "cross_section_minimum": 8
  },
  "validation": {
