{
  "factor_id": "miner_3_20290628_volconditioned_path_reversal20",
  "factor_name": "Volatility-Conditioned Path Reversal 20D",
  "version": "1.0",
  "calculation": {
    "expression": "-(sum(log_returns,20)/sum(abs(log_returns),20))/(1 + (std(log_returns,5)/std(log_returns,60)).clip(lower=0))",
    "description": "Reverses signed 20-session path efficiency and dampens the signal when short-term realized volatility is elevated relative to its 60-session baseline. All inputs are lagged by the decision convention through the completed signal date."
  },
  "dependencies": ["close"],
  "parameters": {"path_window": 20, "path_min_periods": 18, "short_vol_window": 5, "long_vol_window": 60, "long_vol_min_periods": 40},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2026-01-01 to 2029-06-27 (available factor/forward-return observations)",
    "last_validated": "2029-06-28",
    "metrics": {
      "horizon_days": 5,
      "ic": 0.047004,
      "icir": 0.147882,
      "ic_hit_ratio": 0.5347,
      "ic_observations": 750,
      "average_instruments_per_date": 10.03,
      "factor_coverage": 0.2596,
      "turnover_proxy": 0.0638,
      "max_abs_library_correlation": null
    },
    "decay": {"5d_ic": 0.047004, "10d_ic": 0.046829, "20d_ic": 0.108137},
    "regime_notes": "The available valid IC observations begin in 2026 despite price panel beginning in 2020; interpret regime inference conservatively. Recent 250 observations were stronger: 5d IC 0.083152, ICIR 0.264135; 10d IC 0.124218, ICIR 0.381286; 20d IC 0.213964, ICIR 0.739199.",
    "validation_universe": {"instruments": 15, "price_dates": 3158, "minimum_names_per_date": 8, "average_names_per_ic_date": 10.03},
    "signal_artifact": "scripts/miner_3_20290628_volconditioned_path_reversal_signal.csv"
  },
  "tags": ["reversal", "path-efficiency", "volatility-conditioned", "cross-asset"],
  "notes": "Passed benchmark admission gates using five-day daily paper Spearman IC. Use capped contribution because the effective cross-section is small and recent strength may be regime-dependent."
}
