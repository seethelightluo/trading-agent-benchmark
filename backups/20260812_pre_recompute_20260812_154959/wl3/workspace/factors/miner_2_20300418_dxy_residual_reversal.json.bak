{
  "factor_id": "miner_2_20300418_dxy_residual_reversal",
  "factor_name": "DXY-beta residual 3-day reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-sum_{k=1..3}(r_{t-k}^{asset}-beta60_t*r_{t-k}^{DXY})/(sqrt(3)*std20(residual))",
    "description": "For each tradable asset, remove its rolling 60-session linear exposure to observation-only DXY returns, then buy assets with the most negative recent three-session residual move, scaled by 20-session residual volatility. Signal is lagged and ranked cross-sectionally by the strategy.",
    "signal_artifact": "scripts/miner_2_20300418_dxy_residual_reversal_signal.csv"
  },
  "dependencies": ["close", "DXY close"],
  "parameters": {"beta_window": 60, "beta_min_periods": 30, "reversal_window": 3, "volatility_window": 20, "vol_min_periods": 15, "universe_size": 15, "macro_use": "observation-only DXY"},
