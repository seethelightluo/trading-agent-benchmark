{
  "factor_id": "miner_3_20271230_beta_residual_reversal",
  "factor_name": "Beta-Residual Five-Day Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(asset_return_5d - rolling_beta_60d(asset_return_1d, equal_weight_benchmark_return_1d) * benchmark_return_5d), lagged 1 session",
    "description": "Ranks assets by the negative of their five-session return after removing a 60-session rolling beta exposure to the equal-weight tradable-universe benchmark. Uses only completed sessions and is intended to capture idiosyncratic short-horizon mean reversion."
  },
  "dependencies": ["close", "pct_change"],
  "parameters": {"return_window": 5, "beta_window": 60, "beta_min_periods": 40, "benchmark": "equal_weight_available_tradable_universe", "lag_sessions": 1},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2027-12-29",
    "data_cutoff": "2027-12-29",
    "metrics": {
