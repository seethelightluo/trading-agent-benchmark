  "factor_name": "Smoothed Volatility-Normalized Trend Acceleration 20-60",
  "version": "20290531",
  "calculation": {
    "expression": "rolling_mean_5(((close/close[-20])-1-(close/close[-60])-1)/(std(log_returns,60)*sqrt(60)))",
    "description": "For each tradable asset, compute the difference between 20-session and 60-session returns, normalize by 60-session log-return volatility times sqrt(60), then average the resulting signal over the latest five completed observations. Higher values indicate strengthening intermediate trends."
