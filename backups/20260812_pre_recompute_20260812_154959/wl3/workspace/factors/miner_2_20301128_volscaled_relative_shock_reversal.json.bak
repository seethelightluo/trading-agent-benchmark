{
  "factor_id": "miner_2_20301128_volscaled_relative_shock_reversal",
  "factor_name": "Volatility-scaled high-dispersion relative shock reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(R3_i - median_i(R3)) * I[dispersion > rolling_median_120(dispersion)] / volatility20_i, with inverse-volatility scale capped at cross-sectional median inverse volatility",
    "description": "Fades each instrument's lagged three-session return relative to the cross-sectional median during elevated cross-sectional dispersion, while scaling shocks by trailing 20-session annualized volatility. All inputs are lagged at the decision cutoff."
  },
  "dependencies": ["close"],
  "parameters": {"shock_window": 3, "volatility_window": 20, "dispersion_window": 120, "dispersion_statistic": "cross-sectional median absolute residual", "volatility_floor": "cross-sectional median cap", "activation": "dispersion above trailing 120-session median"},
