{
  "factor_id": "miner_3_20260730_volscaled_openclose_reversal_1d",
  "factor_name": "Volatility-Scaled Open-to-Close Reversal",
  "version": "20260730",
  "calculation": {
    "expression": "-(close/open - 1) / rolling_std(close.pct_change(), 20)",
    "description": "Reverses the current day's open-to-close return and scales it by trailing 20-session close-to-close volatility. Higher values represent larger volatility-adjusted intraday weakness and predict stronger next-day close-to-close returns. The signal uses only the current completed OHLC bar and prior returns."
  },
  "dependencies": [
    "open",
    "close"
  ],
  "parameters": {
    "volatility_window": 20,
    "forward_horizon_days": 1,
    "minimum_cross_section": 8,
    "cutoff_date": "2026-07-15",
    "zero_volatility_handling": "missing"
  },
