{
  "factor_id": "miner_2_20280309_idio_reversal_5d",
  "factor_name": "Cross-Asset Idiosyncratic 5-Day Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-((asset_return_5d - cross_asset_mean_return_5d) / rolling_std(asset_daily_return - cross_asset_mean_daily_return, 20)).shift(1)",
    "description": "Ranks assets positively when their lagged five-session return underperformed the contemporaneous cross-asset mean, scaled by trailing 20-session idiosyncratic volatility. The one-session lag prevents use of the current completed session in a decision."
  },
  "dependencies": ["close", "daily returns"],
  "parameters": {"lookback_days": 5, "volatility_window": 20, "min_vol_observations": 15, "signal_lag_days": 1, "forward_horizon_days": 5},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2028-03-08",
