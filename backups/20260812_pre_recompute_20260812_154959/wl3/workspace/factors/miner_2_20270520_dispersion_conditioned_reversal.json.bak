{
  "factor_id": "miner_2_20270520_dispersion_conditioned_reversal",
  "factor_name": "Dispersion-Conditioned Risk-Normalized 3-Day Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(close/close.shift(3)-1) / rolling_std(pct_change(close),20) * clip(1 + 0.35*tanh((cross_sectional_dispersion_20 - rolling_mean(cross_sectional_dispersion_20,120))/rolling_std(cross_sectional_dispersion_20,120)), 0.65, 1.35)",
    "description": "Reverses each asset's three-day return, normalizes by its 20-day return volatility, and scales the signal modestly higher on historically elevated cross-asset dispersion days. All inputs are lagged or contemporaneous to the decision date and use no future data."
  },
  "dependencies": [
    "close",
    "pct_change",
    "cross_asset_returns"
  ],
  "parameters": {
    "reversal_window_days": 3,
    "risk_window_days": 20,
    "dispersion_window_days": 20,
    "dispersion_baseline_days": 120,
    "conditioning_strength": 0.35,
    "condition_multiplier_floor": 0.65,
    "condition_multiplier_cap": 1.35,
    "minimum_cross_section": 8
  },
  "validation": {
