{
  "factor_id": "miner_3_20280309_trend_consistency20",
  "factor_name": "20-session Trend Consistency",
  "version": "1.0",
  "calculation": {
    "expression": "(mean(gt(pct_change(close),0),20)-0.5).shift(1)",
    "description": "For each tradable instrument, fraction of positive daily returns over the trailing 20 completed sessions, centered at zero and lagged one session. Higher values indicate persistent upward direction; lower values indicate persistent downward direction."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "lookback_sessions": 20,
    "minimum_observations": 16,
    "lag_sessions": 1
  },
