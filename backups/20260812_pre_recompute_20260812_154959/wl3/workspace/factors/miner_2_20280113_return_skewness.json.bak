{
  "factor_id": "miner_2_20280113_return_skewness",
  "factor_name": "Lagged 20-Day Return Skewness",
  "version": "2028.01.13",
  "calculation": {
    "expression": "rolling_skew(pct_change(close), 20).shift(1)",
    "description": "Cross-sectional score equal to the lagged one-session 20-session sample skewness of daily close-to-close returns. Positive values indicate less left-tailed and more positively asymmetric recent return paths. No future data are used."
  },
  "dependencies": ["close"],
  "parameters": {"window": 20, "lag": 1, "minimum_observations": 15},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 to 2028-01-12",
    "validation_date": "2028-01-13",
