{
  "factor_id": "miner_1_20270701_smoothed_reversal5",
  "factor_name": "EWMA-smoothed volatility-scaled five-session reversal",
  "version": "1.0",
  "calculation": {
    "expression": "clip(EWM3(-pct_change(close,5)/(std(pct_change(close,1),20)*sqrt(20))) - cross_sectional_median, -6, 6)",
    "description": "Ranks recent five-session losers positively after normalization by trailing 20-session realized volatility; three-session EWMA smoothing reduces rank churn. All inputs are lagged through the completed decision-date session."
  },
  "dependencies": [
    "close",
    "date"
  ],
  "parameters": {
    "reversal_lookback": 5,
    "volatility_window": 20,
    "volatility_min_periods": 12,
    "ewm_span": 3,
    "clip": [
      -6,
      6
    ],
    "minimum_cross_section": 8
  },
