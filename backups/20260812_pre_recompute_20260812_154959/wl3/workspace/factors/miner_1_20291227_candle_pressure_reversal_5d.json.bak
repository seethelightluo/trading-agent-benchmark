{
  "factor_id": "miner_1_20291227_candle_pressure_reversal_5d",
  "factor_name": "Volatility-scaled smoothed candle pressure reversal",
  "version": "1.0",
  "calculation": {
    "expression": "CSdemean(-shift1(rolling_mean_3((close-open)/(high-low))/realized_vol_20))",
    "description": "For each tradable instrument, measure close-to-open candle pressure by the signed intraday move divided by the daily high-low range, smooth over the latest three completed sessions, scale by 20-session annualized daily log-return volatility, reverse the sign, lag one session, and cross-sectionally median demean. Missing or zero ranges are excluded."
  },
  "dependencies": ["open", "high", "low", "close"],
  "parameters": {
    "smoothing_sessions": 3,
    "realized_vol_window": 20,
    "forward_horizon_sessions": 5,
    "minimum_cross_section": 8,
    "cross_section_demean": "median"
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2026-01-01 to 2029-12-26",
    "data_cutoff": "2029-12-26",
    "last_validated": "2029-12-27T00:00:00Z",
    "metrics": {
