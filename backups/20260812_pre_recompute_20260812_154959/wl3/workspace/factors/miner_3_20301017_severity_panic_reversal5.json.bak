{
  "factor_id": "miner_3_20301017_severity_panic_reversal5",
  "factor_name": "Severity-Weighted Broad-Selloff Panic Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-sum(log(close_t/close_{t-2})) * max(0, (0.35 - breadth_3d_t)/0.35)",
    "description": "Fade each asset's lagged three-day log return only during broad selloffs; continuously scale the reversal by the shortfall of positive three-day breadth below 35 percent. The signal is formed from completed data and used for forward five-day returns.",
