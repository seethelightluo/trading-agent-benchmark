{
  "factor_id": "miner_2_20290628_volshock_reversal5",
  "factor_name": "Volatility-Shock Conditioned Five-Day Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-sum(log(close/close.shift(1)), 5) * (std(log_returns,5) / std(log_returns,60))",
    "description": "Ranks assets higher when their prior five-session return is more negative and their short-term realized volatility is elevated relative to its 60-session baseline. All rolling inputs are shifted one completed session before the decision signal."
  },
  "dependencies": ["close"],
  "parameters": {"reversal_window": 5, "short_vol_window": 5, "baseline_vol_window": 60, "minimum_short_observations": 4, "minimum_baseline_observations": 40, "signal_lag_sessions": 1},
  "validation": {
