{
  "factor_id": "miner_3_20290920_soft_pullback_recovery",
  "factor_name": "Soft Trend-Conditioned Volatility-Normalized Pullback Recovery",
  "version": "1.0",
  "calculation": {
    "expression": "cross_sectional_demean(shift(-log(close/close[-5]) / (std(log_returns,60)*sqrt(5)) * (0.35 + 0.65*sigmoid((close/close[-60]-1)/0.08)), 1))",
    "description": "Ranks recent five-session losers for rebound potential, scaled by 60-session volatility. A smooth trend-state multiplier gives greater weight to pullbacks in established uptrends while retaining coverage in neutral or weak trends. The one-session lag prevents look-ahead."
  },
  "dependencies": ["close"],
  "parameters": {"loss_window": 5, "volatility_window": 60, "trend_window": 60, "trend_scale": 0.08, "base_gate": 0.35, "trend_gate_range": [0.35, 1.0], "lag": 1, "cross_sectional_demean": "median"},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2029-09-19",
    "validation_date": "2029-09-20",
    "metrics": {
      "daily_ic": 0.033522,
      "daily_icir": 0.106888,
      "daily_hit_ratio": 0.5525,
      "ic_observations": 771,
      "average_instruments": 11.02,
      "instruments": 15,
      "coverage": 0.2750,
      "rank_turnover_proxy": 0.1172,
      "recent_250_daily_ic": 0.050036,
      "recent_250_daily_icir": 0.170552,
      "horizon_decay": {"3d_ic": 0.033687, "5d_ic": 0.039612, "10d_ic": 0.033429},
      "max_abs_library_correlation": null
    },
    "signal_artifact": "scripts/miner_3_20290920_softpullback_signal.csv",
    "regime_notes": "Positive across full history and stronger in the latest 250 observations; cross-section averages about 11 instruments, so uncertainty is material. Daily gate exceeds benchmark thresholds."
  },
  "tags": ["reversal", "pullback", "trend-conditioned", "volatility-normalized", "cross-asset"],
