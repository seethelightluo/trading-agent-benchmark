{
  "factor_id": "miner_2_20261105_demeaned_volscaled_3d_reversal_1d",
  "factor_name": "Drift-adjusted volatility-scaled 3-day reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(pct_change(close,3) - 3*rolling_mean(pct_change(close,1),20)) / (rolling_std(pct_change(close,1),20) * sqrt(3))",
    "description": "Ranks assets favoring negative three-day moves after subtracting expected recent daily drift, normalized by 20-day daily volatility and the three-day horizon. The signal is formed using completed data only and predicts next-day cross-sectional returns."
  },
  "dependencies": ["close"],
  "parameters": {"lookback_reversal_days": 3, "drift_window_days": 20, "volatility_window_days": 20, "min_volatility_observations": 15, "forecast_horizon_days": 1},
