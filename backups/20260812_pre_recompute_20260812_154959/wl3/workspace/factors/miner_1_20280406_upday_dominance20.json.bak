  "factor_name": "20-session up-day dominance",
  "version": "20280406",
  "calculation": {
    "expression": "(sum(max(return,0),20)-sum(-min(return,0),20))/(sum(abs(return),20)+1e-12), lagged 1 session",
    "description": "Measures whether trailing absolute return is dominated by gains rather than losses; positive values indicate persistent gain-led movement. Signal is shifted one completed session to prevent look-ahead."
