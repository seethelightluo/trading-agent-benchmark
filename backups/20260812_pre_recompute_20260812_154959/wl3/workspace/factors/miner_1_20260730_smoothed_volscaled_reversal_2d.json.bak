  "factor_name": "Smoothed Volatility-Scaled 2-Day Reversal",
  "version": "20260730_v1",
  "calculation": {
    "expression": "-mean(return_1d, 2) / volatility_20d",
    "description": "Two-day average daily return reversal normalized by trailing 20-day return volatility. Higher values identify assets with recent losses relative to their own risk, while smoothing reduces single-day noise."
  },
