{
  "factor_id": "miner_3_20280406_trend_acceleration20_60",
  "factor_name": "Lagged 20-vs-60 Session Trend Acceleration",
  "version": "1.0",
  "calculation": {
    "expression": "(close/close.shift(20)-1 - (close/close.shift(60)-1)/3).shift(1)",
    "description": "For each tradable cross-asset instrument, compare the lagged 20-session return with one-third of the lagged 60-session return. Positive values identify strengthening intermediate trends; negative values identify weakening trends. Signal is shifted one completed session to prevent look-ahead."
  },
  "dependencies": ["close", "date"],
  "parameters": {"short_window": 20, "long_window": 60, "long_return_scaling": 3, "minimum_cross_section": 8, "admission_horizon_sessions": 5},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2028-04-05",
    "data_cutoff": "2028-04-05",
