{
  "factor_id": "miner_1_20270114_inverse_candle_pressure_1d",
  "factor_name": "Inverse Range-Normalized Candle Pressure Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-rolling_mean(5, close_location_value * (daily_range / rolling_median(20, daily_range)))",
    "description": "Contrarian cross-asset signal: weak daily closes and range expansion receive positive scores, with a five-day smoothing window. All OHLC inputs are from completed bars through the signal date; predicts next trading-day return.",
    "forward_horizon": "1 trading day",
    "signal_artifact": "scripts/miner_1_20270114_inverse_candle_pressure_signal.csv",
    "lookahead_policy": "At date t, uses OHLC through t only; forward return begins at t+1."
  },
  "dependencies": ["open", "high", "low", "close"],
  "parameters": {
    "range_definition": "high-low divided by close",
    "close_location_value": "(2*close-high-low)/(high-low)",
    "range_median_window": 20,
    "signal_smoothing_window": 5,
    "minimum_cross_section": 8
  },
