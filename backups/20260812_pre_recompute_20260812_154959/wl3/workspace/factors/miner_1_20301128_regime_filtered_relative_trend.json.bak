{
  "factor_id": "miner_1_20301128_regime_filtered_relative_trend",
  "factor_name": "Regime-Filtered Relative Trend",
  "version": "1.0",
  "calculation": {
    "expression": "sign(median_cs(ret20_lag1)) * (ret60_lag1 - median_cs(ret60_lag1)) / vol20_lag1",
    "description": "Cross-sectional 60-day relative trend, volatility-scaled and lagged one session. The signal follows relative leadership when the cross-sectional median 20-day return is positive and reverses the ranking in a bearish market regime, providing a defensive response without cash."
  },
  "dependencies": ["close"],
  "parameters": {"trend_window": 60, "regime_window": 20, "vol_window": 20, "lag_days": 1, "horizons_tested": [5,10,20], "min_cross_section": 8},
