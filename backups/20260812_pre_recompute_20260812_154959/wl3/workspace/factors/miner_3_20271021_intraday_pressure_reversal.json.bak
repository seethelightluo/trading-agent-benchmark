{
  "factor_id": "miner_3_20271021_intraday_pressure_reversal",
  "factor_name": "Volatility-Normalized Intraday Pressure Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-((close/open)-1) / rolling_std_20((close/open)-1), lagged_1_session",
    "description": "For each tradable benchmark instrument, invert the prior completed session's close-to-open intraday return and scale by its trailing 20-session cross-day volatility of intraday returns. Higher values indicate unusually weak opening-to-close pressure expected to mean-revert. The one-session lag prevents use of the current incomplete session."
  },
  "dependencies": [
    "open",
    "close"
  ],
  "parameters": {
    "volatility_window_sessions": 20,
    "signal_lag_sessions": 1,
    "minimum_cross_section": 8,
    "forward_horizon_sessions": 1
  },
