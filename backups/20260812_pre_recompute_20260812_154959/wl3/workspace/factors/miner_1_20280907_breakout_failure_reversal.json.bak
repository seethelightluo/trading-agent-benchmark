{
  "factor_id": "miner_1_20280907_breakout_failure_reversal",
  "factor_name": "Breakout Failure Reversal",
  "version": "2028-09-07",
  "calculation": {
    "expression": "((close / rolling_max(close,60) - 1) - (close / rolling_max(close,20) - 1)) / rolling_mean((high-low)/close,10), lagged one session",
    "description": "Ranks assets whose recent 20-session breakout pressure is weak or has failed relative to the 60-session pressure; positive values favor subsequent reversal. Uses only completed historical sessions."
  },
  "dependencies": ["close", "high", "low"],
  "parameters": {"short_window": 20, "medium_window": 60, "range_window": 10, "lag": 1, "min_cross_section": 8},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2028-09-06",
    "validated_at": "2028-09-07T00:00:00Z",
