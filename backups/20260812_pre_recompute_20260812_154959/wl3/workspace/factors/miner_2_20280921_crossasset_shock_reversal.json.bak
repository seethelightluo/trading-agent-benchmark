{
  "factor_id": "miner_2_20280921_crossasset_shock_reversal",
  "factor_name": "Cross-Asset Volatility-Scaled Shock Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-shift1((rolling_sum(return,5) - cross_sectional_median(rolling_sum(return,5))) / rolling_std(return,20)",
    "description": "Ranks an asset higher after a negative five-session return relative to the cross-asset median, scaled by its 20-session volatility. The one-session lag prevents look-ahead and the cross-sectional centering removes broad market direction."
  },
  "dependencies": ["close"],
  "parameters": {"shock_window": 5, "volatility_window": 20, "lag_sessions": 1, "forward_horizon_sessions": 1, "minimum_cross_section": 8},
  "validation": {
    "status": "EFFECTIVE",
    "period": {"start": "2020-01-01", "end": "2028-09-20", "cutoff": "2028-09-20"},
