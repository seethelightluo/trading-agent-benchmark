{
  "factor_id": "miner_3_20281228_downside_reversal4",
  "factor_name": "Downside-risk-scaled four-day reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-pct_change(close,4)/(sqrt(rolling_mean(min(pct_change(close,1),0)^2,30))*sqrt(4))",
    "description": "Ranks recent four-session underperformance positively, scaling by trailing 30-session downside deviation. Signal uses only completed observations at the signal date and forecasts the next daily return."
  },
  "dependencies": ["close"],
  "parameters": {"lookback_return": 4, "downside_window": 30, "minimum_downside_observations": 20, "forward_horizon": 1},
  "validation": {
