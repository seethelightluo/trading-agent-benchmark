{
  "factor_id": "miner_3_20300516_lowvix_momentum_10d",
  "factor_name": "Low-VIX Regime Cross-Asset Momentum 10D",
  "version": "1.0",
  "calculation": {
    "expression": "lag1(rolling_sum(log_return,20) - cross_sectional_median(rolling_sum(log_return,20))) * I(VIX < rolling_median(VIX,60))",
    "description": "Cross-sectional 20-session residual momentum, activated only when observation-only VIX is below its trailing 60-session median and lagged one completed session. Higher values indicate stronger relative momentum."
  },
  "dependencies": ["close", "VIX"],
  "parameters": {"momentum_window": 20, "vix_window": 60, "activation": "VIX below trailing 60-session median", "lag": 1, "primary_horizon_sessions": 10},
  "validation": {
