{
  "factor_id": "miner_2_20290809_dispersion_gated_shock_reversal3",
  "factor_name": "High-dispersion gated volatility-normalized three-session shock reversal",
  "version": "1.0",
  "calculation": {
    "expression": "demean_cs((-sum(log_return,3)) * abs(sum(log_return,3))/(rolling_std(log_return,60)*sqrt(3)) * I(cross_sectional_dispersion > rolling_median(cross_sectional_dispersion,60)))",
    "description": "Reverse an unusually large three-session move, normalized by 60-session asset volatility, only when cross-asset daily return dispersion exceeds its trailing 60-session median. Signal is cross-sectionally demeaned and uses only completed data at the signal date."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "shock_window": 3,
    "volatility_window": 60,
    "dispersion_window": 60,
    "dispersion_threshold": "trailing_median",
    "minimum_cross_section": 8,
    "signal_lag": 1
  },
