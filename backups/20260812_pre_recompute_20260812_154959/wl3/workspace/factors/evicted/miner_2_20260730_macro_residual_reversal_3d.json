  "factor_name": "DXY-Beta-Residual Three-Day Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-sum_3(asset_return - rolling_beta_60(asset_return,DXY_return)*DXY_return) / (sqrt(3)*rolling_std_20(residual_return))",
    "description": "Fades the recent three-day return component unexplained by the trailing 60-day DXY beta, scaled by residual downside-neutralized volatility. Higher values indicate stronger residual oversold conditions and use only observations available before the decision date."
