  "factor_name": "Cross-Asset Beta-Residual Volatility-Scaled Five-Day Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-rolling_sum_5(asset_daily_return - equal_weight_cross_asset_daily_return) / rolling_std_20(asset_daily_return - equal_weight_cross_asset_daily_return)",
