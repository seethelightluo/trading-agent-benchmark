{
  "factor_id": "miner_3_20260730_total_volscaled_reversal_1d",
  "factor_name": "Total (Overnight plus Intraday) Volatility-Scaled Reversal",
  "version": "20260730_v1",
  "calculation": {
    "expression": "-((open / previous_close) - 1 + (close / open) - 1) / rolling_std(close.pct_change(), 20)",
    "description": "Contrarian score for the full close-to-close daily return, decomposed into overnight gap and open-to-close move, and normalized by trailing 20-session close-to-close volatility. Higher values indicate larger recent losses relative to normal risk and predict stronger next-day returns. Uses only the completed bar and lagged close."
  },
  "dependencies": [
    "open",
    "close"
  ],
