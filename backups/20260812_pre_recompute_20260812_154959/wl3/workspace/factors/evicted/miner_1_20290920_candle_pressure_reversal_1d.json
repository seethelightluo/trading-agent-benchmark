{
  "factor_id": "miner_1_20290920_candle_pressure_reversal_1d",
  "factor_name": "Candle-Pressure Weighted Volatility-Normalized Three-Day Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-rolling_sum(log_return,3) * (1 + 0.75*rolling_mean(clip((close-open)/(high-low),-1,1),5)) / (rolling_std(log_return,60)*sqrt(3)+epsilon), cross-sectionally demeaned",
    "description": "Fades the preceding three-session return, normalized by 60-session volatility, with reversal intensity adjusted by recent candle pressure. Positive close-over-open pressure increases the fade signal and negative pressure reduces it. All observations are lagged by the decision cutoff in deployment."
  },
  "dependencies": [
    "close",
    "open",
    "high",
    "low"
  ],
  "parameters": {
    "return_window": 3,
    "volatility_window": 60,
    "pressure_window": 5,
    "pressure_weight": 0.75,
    "epsilon": 1e-12,
    "cross_sectional_demean": true
  },
