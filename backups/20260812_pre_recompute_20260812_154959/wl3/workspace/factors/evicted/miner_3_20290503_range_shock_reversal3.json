{
  "factor_id": "miner_3_20290503_range_shock_reversal3",
  "factor_name": "Range-Shock Volatility-Scaled 3-Day Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "(-pct_change(close,3) / rolling_std(pct_change(close,1),20)) * (rolling_mean((high-low)/close,5) / rolling_mean((high-low)/close,60))",
    "description": "Ranks assets for short-horizon mean reversion using the negative three-session return, scaled by 20-session volatility and amplified when the recent five-session normalized trading range is unusually large versus its 60-session baseline. All inputs are lagged to completed daily bars at decision time."
  },
  "dependencies": [
    "close",
    "high",
    "low"
  ],
  "parameters": {
    "return_lookback": 3,
    "volatility_window": 20,
    "range_short_window": 5,
    "range_long_window": 60,
    "min_periods_volatility": 10,
    "min_periods_range_short": 3,
    "min_periods_range_long": 20
  },
