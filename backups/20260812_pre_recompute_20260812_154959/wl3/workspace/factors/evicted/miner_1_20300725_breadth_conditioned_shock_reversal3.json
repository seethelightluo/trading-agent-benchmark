{
  "factor_id": "miner_1_20300725_breadth_conditioned_shock_reversal3",
  "factor_name": "Breadth-Conditioned Three-Session Shock Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "gate * (-(rolling_sum(log_return,3) - cross_sectional_median(rolling_sum(log_return,3))) / (rolling_std(log_return,30)*sqrt(3)))",
    "description": "Ranks assets for reversal after an unusually weak three-session move relative to the cross-sectional median, normalized by 30-session volatility. The signal is activated when at least 55% of instruments had negative five-session returns and VIX exceeded its trailing 90-session median. The complete signal is lagged one session."
  },
  "dependencies": [
    "close",
    "VIX"
  ],
  "parameters": {
    "shock_window": 3,
    "volatility_window": 30,
    "breadth_window": 5,
    "breadth_threshold": 0.55,
    "vix_median_window": 90,
    "minimum_cross_section": 8,
    "signal_lag": 1
  },
