  "factor_name": "Cross-sectional Relative Three-Day Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-((sum(pct_change(close),3)) - cross_sectional_median(sum(pct_change(close),3)))",
    "description": "For each asset, reverse its trailing three-session return after subtracting the same-date cross-sectional median return. This isolates relative short-term dislocations while removing broad market shocks. Signal is computed only from completed daily closes."
