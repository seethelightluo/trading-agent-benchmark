  "factor_name": "Volatility-Damped Relative Five-Day Shock Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-((sum(log_return,5)-cross_sectional_median(sum(log_return,5)))/(rolling_std(log_return,60)*sqrt(60)))*(clip((rolling_std(log_return,30)*sqrt(30))/(rolling_std(log_return,60)*sqrt(60)),0.5,2)^(-0.5)); lag 1; median demean",
    "description": "Reverses each asset's five-session return relative to the contemporaneous cross-asset median, normalizes by 60-session realized volatility, and mildly dampens signals when short-term volatility is elevated versus its 60-session baseline. Signal is lagged one completed session to avoid look-ahead."
  },
