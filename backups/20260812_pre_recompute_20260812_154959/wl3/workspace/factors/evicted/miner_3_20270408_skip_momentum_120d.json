{
  "factor_id": "miner_3_20270408_skip_momentum_120d",
  "factor_name": "Volatility-Scaled 120-Day Skip Momentum",
  "version": "1.0",
  "calculation": {
    "expression": "clip((close[t-5]/close[t-125]-1) / (std(pct_change(close),60)*sqrt(60)), -6, 6)",
    "description": "Medium-term cross-asset momentum measured over the 120 sessions ending five sessions before the signal date, scaled by trailing 60-session realized volatility. The five-session skip reduces contamination from short-term reversal and all inputs are lagged or observable at decision time."
  },
  "dependencies": [
    "close",
    "pct_change"
  ],
  "parameters": {
    "lookback_sessions": 120,
    "skip_sessions": 5,
    "volatility_window": 60,
    "volatility_min_periods": 40,
    "winsor_clip": [
      -6,
      6
    ]
  },
