{
  "factor_id": "miner_3_20260910_volscaled_reversal_3d",
  "factor_name": "Volatility-Scaled Three-Day Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-sum(close.pct_change(), 3) / (rolling_std(close.pct_change(), 20) * sqrt(3) + 1e-12)",
    "description": "Contrarian three-trading-day return, normalized by trailing 20-day close-return volatility. All inputs are trailing and the signal at date t uses no data after t."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "return_lookback_days": 3,
    "volatility_lookback_days": 20,
    "minimum_volatility_observations": 10,
    "forward_horizon_days": 1
  },
