{
  "factor_id": "miner_3_20280210_volscaled10_reversal",
  "factor_name": "Volatility-scaled 10-session reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(close / lag(close,10) - 1) / (rolling_std(daily_returns,20) * sqrt(252)), shifted by 1 day",
    "description": "Ranks instruments that experienced a large ten-session loss relative to their trailing annualized volatility, using only information available before the forecast day. Higher values indicate stronger risk-adjusted reversal exposure."
  },
  "dependencies": ["close"],
  "parameters": {"lookback_return_days": 10, "volatility_window_days": 20, "annualization": 252, "signal_lag_days": 1, "minimum_vol_observations": 15},
  "validation": {
    "status": "EFFECTIVE",
    "period": {"start": "2020-01-01", "end": "2028-02-09", "forward_horizon_days": 1},
    "metrics": {
