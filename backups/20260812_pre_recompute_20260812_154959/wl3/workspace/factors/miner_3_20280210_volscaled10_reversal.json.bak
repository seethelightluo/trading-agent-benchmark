      "max_abs_library_correlation": null
    },
    "thresholds": {"absolute_daily_ic_minimum": 0.007, "absolute_daily_icir_minimum": 0.084},
    "regime_notes": "Validated over the full synthetic cross-asset history through 2028-02-09 across 15 tradable instruments. Daily cross-sectional Spearman IC uses dates with at least 8 valid instruments; uncertainty is interpreted conservatively due to the small cross-section.",
