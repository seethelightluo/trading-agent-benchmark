  "factor_name": "Cross-sectional rank reversal over five sessions",
  "version": "1.0",
  "calculation": {
    "expression": "rank_pct(-(close_t / close_{t-5} - 1)) within each date",
    "description": "Ranks instruments cross-sectionally by negative trailing five-session return. Higher percentile indicates stronger recent underperformance and a contrarian long signal. The signal uses only completed prices through t and predicts the next session return."
  },
  "dependencies": ["close", "date", "symbol"],
  "parameters": {"lookback_sessions": 5, "rank_method": "average", "rank_pct": true, "minimum_cross_section": 8},
