{
  "factor_id": "miner_3_20301003_panic_reversal5",
  "factor_name": "Broad-Selloff 3-Day Panic Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-sum(log(close_t/close_{t-1}), 3) * I(cross_sectional_breadth_3d < 0.35)",
    "description": "Fade each asset's lagged three-day log return only when fewer than 35% of the 15 tradable instruments had positive three-day returns. Signal is lagged one completed day and ranks are used for portfolio construction."
  },
  "dependencies": ["close"],
  "parameters": {"lookback_days": 3, "breadth_threshold": 0.35, "forward_horizons_days": [5, 10, 20], "minimum_cross_section": 8, "universe_size": 15, "signal_lag_days": 1},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2030-10-03",
    "last_validated": "2030-10-03T00:00:00Z",
    "metrics": {
      "admission_horizon_days": 5,
      "ic": 0.042361,
      "icir": 0.100912,
      "ic_hit_ratio": 0.2078,
      "observations": 3479,
      "dates": 3479,
      "instruments": 15,
      "coverage": 0.9988,
      "rank_turnover_proxy": 0.10297,
      "decay_ic_10d": 0.032925,
      "decay_icir_10d": 0.080392,
      "decay_ic_20d": 0.025546,
      "decay_icir_20d": 0.061836,
      "max_abs_library_correlation": null
    },
    "regime_notes": "5D IC remained positive across 2020-22 (0.017410), 2023-25 (0.086132), 2026-27 (0.032763), and 2028-30 (0.040076); strongest in 2023-25. Conservative interpretation is required because the cross-section has only 15 instruments."
  },
  "signal_artifact": "scripts/miner_3_20301003_panic_reversal_signal.csv",
  "tags": ["reversal", "breadth_conditioned", "short_horizon", "cross_asset", "panic" ]
}
