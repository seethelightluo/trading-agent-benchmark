{
  "factor_id": "miner_2_20260730_vix_residual_reversal_3d",
  "factor_name": "VIX-Beta-Residual Three-Day Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-sum_3(asset_return - rolling_beta_60(asset_return,VIX_return)*VIX_return) / (sqrt(3)*rolling_std_20(residual_return))",
    "description": "Fades the recent three-day asset return unexplained by trailing VIX beta, scaled by residual volatility. Higher values indicate stronger residual oversold conditions. VIX is observation-only and is never tradable."
  },
  "dependencies": ["close", "VIX observation-only close", "daily_return"],
  "parameters": {
    "residual_window_days": 3,
    "beta_window_days": 60,
    "volatility_window_days": 20,
    "forward_horizon_days": 1,
    "minimum_beta_observations": 30,
    "cross_section": "15 tradable assets"
  },
  "validation": {
