{
  "factor_id": "miner_1_20271202_rank_reversal3",
  "factor_name": "Cross-sectional 3-session rank reversal",
  "version": "1.0",
  "calculation": {
    "expression": "rank_pct(cross_section(date, -((close_t / close_{t-3}) - 1)))",
    "description": "At each decision date, rank instruments by the negative lagged three-session close-to-close return. Higher percentile denotes stronger recent underperformance and a larger contrarian signal. The signal uses only completed prices through t and predicts return from t to t+1.",
    "lag": "Signal is formed at t from data through t; forward return is t to t+1.",
    "signal_artifact": "scripts/miner_1_20271202_rank_reversal_signal.csv"
  },
  "dependencies": ["close"],
  "parameters": {"lookback_sessions": 3, "ranking": "cross_sectional_percentile", "minimum_cross_section": 8},
  "validation": {
    "status": "EFFECTIVE",
    "timestamp": "2027-12-02T00:00:00Z",
    "period": "2020-01-01 through 2027-12-02 available history, forward one session",
    "metrics": {
      "daily_paper_ic": 0.0313128708,
      "daily_paper_icir": 0.0845035492,
      "valid_dates": 2042,
      "average_instruments": 14.6234,
      "minimum_instruments": 8,
      "coverage": 0.9748939,
      "ic_hit_ratio": 0.5288932,
      "recent_500_date_ic": 0.0195029,
      "max_abs_library_correlation": null
    },
    "decay": {"same_horizon": "1-session forward return"},
    "regime_notes": "Validated across the available synthetic cross-asset history and many dates using the 15-instrument universe. ICIR exceeds the benchmark admission threshold only narrowly; uncertainty is high because each daily cross-section is small.",
    "thresholds": {"absolute_daily_ic_min": 0.007, "absolute_daily_icir_min": 0.084}
  },
  "tags": ["reversal", "cross-sectional", "short-horizon", "price-only"],
