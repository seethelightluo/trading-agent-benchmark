{
  "factor_id": "miner_1_20290125_momentum_acceleration10",
  "factor_name": "Cross-Asset Momentum Acceleration (20d vs 60d Risk-Adjusted Trend)",
  "version": "1.0",
  "calculation": {
    "expression": "cross_sectional_median_demean(shift_1(close.pct_change(20)/rolling_std(pct_change(close),30) - close.pct_change(60)/rolling_std(pct_change(close),90)))",
    "description": "Measures acceleration in short risk-adjusted momentum relative to slower risk-adjusted momentum, lagged one completed session and demeaned by the contemporaneous cross-sectional median. Higher values indicate improving trend strength."
  },
  "dependencies": ["close"],
  "parameters": {"short_window": 20, "long_window": 60, "short_vol_window": 30, "long_vol_window": 90, "forward_horizon": 10, "signal_lag": 1, "minimum_cross_section": 8},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2029-01-10",
    "last_validated": "2029-01-25T00:00:00Z",
    "metrics": {
      "ic": 0.030404,
      "icir": 0.090727,
      "ic_hit_ratio": 0.5315,
      "dates": 2273,
      "instruments": 15,
      "average_instruments_per_date": 10.92,
      "coverage": 0.9536,
      "turnover_proxy": 0.0581,
      "max_abs_library_correlation": null
    },
    "regime_notes": "Passed full-sample admission gates, with positive IC in 2020-2027 but material deterioration in 2028 and negative recent-252-date IC. Use capped or regime-conditioned exposure until revalidation confirms recovery.",
    "gates": {"absolute_daily_paper_ic_min": 0.007, "absolute_daily_paper_icir_min": 0.084}
  },
  "signal_artifact": "scripts/miner_1_20290125_momentum_acceleration_signal.csv",
  "tags": ["momentum", "trend_acceleration", "risk_adjusted", "cross_asset"]
