{
  "factor_id": "miner_1_20291129_intraday_reversal_5d",
  "factor_name": "Lagged volatility-scaled intraday reversal",
  "version": "1.0",
  "calculation": {
    "expression": "CS_demean((-log(close/open)/(rolling_std(log(close).diff(),20)*sqrt(20))).shift(1))",
    "description": "For each tradable asset, oppose the prior completed session's close-to-open displacement after scaling by 20-session annualized-style realized volatility; cross-sectionally demean the lagged signal. Higher values indicate stronger expected reversal over the selected five-session horizon."
  },
  "dependencies": ["open", "close"],
  "parameters": {"volatility_window": 20, "signal_lag_sessions": 1, "admission_horizon_sessions": 5, "min_cross_section": 8},
