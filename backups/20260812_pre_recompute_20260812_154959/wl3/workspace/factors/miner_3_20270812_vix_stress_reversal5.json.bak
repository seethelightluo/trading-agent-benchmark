{
  "factor_id": "miner_3_20270812_vix_stress_reversal5",
  "factor_name": "VIX-conditioned equity-relative 5D contrarian reversal",
  "version": "1.0",
  "calculation": {
    "expression": "clip(-residual_5d * clip(1 + 0.6*max(VIX_pct_change_5d,0) + 0.4*max(VIX/median(VIX,60)-1,0), 1, 2.5), -6, 6), cross-sectionally median-centered",
    "description": "For each tradable asset, compute its 5-session return residual versus a rolling 30-session beta to the equal-weighted eight-index equity basket. Negate the residual for contrarian reversal and amplify it when observation-only VIX is elevated or rising. All VIX and price inputs are lagged/available at the signal date."
  },
  "dependencies": [
    "close",
    "VIX observation-only close",
    "000300.SH",
    "SPX",
    "HSI",
    "N225",
    "SX5E",
    "000688.SH",
    "SOX",
    "NDX"
  ],
  "parameters": {
    "residual_horizon": 5,
    "beta_window": 30,
    "beta_min_periods": 20,
    "vix_change_window": 5,
    "vix_level_window": 60,
    "vix_change_weight": 0.6,
    "vix_level_weight": 0.4,
    "stress_multiplier_max": 2.5,
    "clip": 6
  },
