{
  "factor_id": "miner_1_20270923_relative_strength_volscaled_20d",
  "factor_name": "Volatility-scaled 20-session relative strength",
  "version": "2027-09-23",
  "calculation": {
    "expression": "clip((return_20 / annualized_volatility_60) - cross_sectional_median(return_20 / annualized_volatility_60), -6, 6)",
    "description": "For each tradable benchmark asset, compute its 20-session price return divided by trailing 60-session realized volatility, then demean by the same-day cross-sectional median and clip extremes. The negative one-session IC indicates the factor is used as a contrarian ranking signal in the ensemble; all inputs are lagged/completed observations at decision time."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "return_window": 20,
    "volatility_window": 60,
    "volatility_min_periods": 30,
    "annualization": 252,
    "clip_lower": -6,
    "clip_upper": 6,
    "min_cross_section": 8
  },
