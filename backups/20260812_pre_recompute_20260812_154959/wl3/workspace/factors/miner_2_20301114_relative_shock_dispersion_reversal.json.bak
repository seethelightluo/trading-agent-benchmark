{
  "factor_id": "miner_2_20301114_relative_shock_dispersion_reversal",
  "factor_name": "High-Dispersion Relative Shock Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "- (r_3d_i - median_cross_section(r_3d)) * I(MAD_cross_section(r_3d) > rolling_median_120d(MAD))",
    "description": "Fade each asset's lagged three-session return relative to the cross-sectional median, activating only when the cross-sectional median absolute deviation of three-session returns exceeds its trailing 120-session median. Signal is evaluated with information through the prior completed session."
  },
  "dependencies": ["close"],
  "parameters": {"return_window": 3, "dispersion_window": 120, "dispersion_statistic": "cross-sectional median absolute deviation", "activation": "dispersion above trailing median", "signal_lag": 1},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2030-11-13",
    "last_validated": "2030-11-14T00:00:00Z",
    "metrics": {
      "daily_ic": 0.039716,
      "daily_icir": 0.089908,
      "daily_hit_ratio": 0.2630,
      "daily_observations": 3513,
      "instruments": 15,
      "coverage": 0.99881,
      "rank_turnover_proxy": 0.14193,
      "max_abs_library_correlation": null,
      "decay": {"1d_ic": 0.039716, "3d_ic": 0.030685, "5d_ic": 0.036977, "10d_ic": 0.030675, "20d_ic": 0.011195}
    },
    "regime_notes": "Daily IC and ICIR pass the benchmark gates. Daily IC remained positive in 2020-22 (0.051818), 2023-25 (0.054135), 2026-27 (0.019179), and 2028-30 (0.018720). Five-day IC was 0.036977 with ICIR 0.085221 and remained positive in all four regimes. Small cross-section implies conservative interpretation.",
    "signal_artifact": "scripts/miner_2_20301114_relative_shock_dispersion_signal.csv"
