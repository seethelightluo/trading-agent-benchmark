{
  "factor_id": "miner_2_20280504_recovery_adjusted_trend60",
  "factor_name": "Recovery-Adjusted 60-Day Trend",
  "version": "20280504",
  "calculation": {
    "expression": "shift(1, rolling_product(1+daily_return,60)-1) / (abs(rolling_min(close/rolling_max(close,60)-1,60))+0.05)",
    "description": "Ranks assets by lagged 60-session cumulative return scaled by worst recent close-to-close drawdown magnitude, with a 5 percentage-point stabilizer. The one-session lag prevents look-ahead."
  },
  "dependencies": ["close", "daily_return"],
  "parameters": {"return_window": 60, "drawdown_window": 60, "min_periods": 45, "stabilizer": 0.05, "signal_lag": 1},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2028-05-03",
    "validation_date": "2028-05-04",
