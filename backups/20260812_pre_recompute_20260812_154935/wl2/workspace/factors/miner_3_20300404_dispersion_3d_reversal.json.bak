{
  "factor_id": "miner_3_20300404_dispersion_3d_reversal",
  "factor_name": "Cross-Asset Dispersion-Gated 3-Day Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(sum(return,3)/stdev(return,20)) * (dispersion20/(dispersion20+0.05))",
    "description": "For each tradable instrument, fade its trailing three-session return normalized by its trailing 20-session daily return volatility. Multiply by a bounded gate based on the cross-sectional standard deviation of trailing 20-session cumulative returns, strengthening the signal when cross-asset dispersion is elevated. Signal uses data through date t only."
  },
  "dependencies": ["close", "daily_returns"],
  "parameters": {"reversal_window_days": 3, "volatility_window_days": 20, "dispersion_window_days": 20, "dispersion_scale": 0.05, "minimum_cross_section": 8},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2030-04-04",
    "validation_timestamp": "2030-04-04",
    "metrics": {
      "daily_forward_horizon_days": 1,
      "ic": 0.031160,
      "icir": 0.092518,
      "ic_hit_ratio": 0.5367,
      "dates": 1742,
      "average_instruments_per_date": 11.832,
      "factor_coverage": 0.7888,
      "turnover": "signal artifact available; not estimated in this run",
      "decay_ic_5d": 0.029878,
      "decay_icir_5d": 0.088157,
      "decay_ic_10d": -0.004352,
      "decay_icir_10d": -0.012868,
      "max_abs_library_correlation": null
    },
    "regime_notes": "Positive daily and five-session association across the full sample, with strongest five-session results during 2028 and early 2029. Predictive strength weakened after 2029-07-01, so uncertainty is material given the 15-instrument cross-section. Daily absolute IC and ICIR exceed benchmark admission thresholds of 0.0070 and 0.0840.",
    "signal_artifact": "scripts/miner_3_20300404_dispersion_3d_reversal_signal.csv"
  },
