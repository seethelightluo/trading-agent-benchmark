{
  "factor_id": "miner_3_20291101_beta_residual_reversal_3d_5d",
  "factor_name": "Volatility-Normalized Beta-Residual Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-sum_{k=0..2}(r_{i,t-k}-beta_{i,60}*mean_j(r_{j,t-k}))/((std_{60}(r_i)*sqrt(3))+epsilon) * clip(mean_t(std_cross_sectional_20d)/0.012,0.5,2.0)",
    "description": "At each prior-day decision date, estimate each asset's 60-day beta to the equal-weight universe, invert its three-day cumulative beta residual, normalize by 60-day volatility, and scale by recent cross-sectional dispersion. Higher values indicate stronger short-term idiosyncratic reversal potential. Uses only data through t."
  },
  "dependencies": [
    "close",
    "daily_returns"
  ],
  "parameters": {
    "beta_window": 60,
    "reversal_window": 3,
    "dispersion_window": 20,
    "dispersion_reference": 0.012,
    "forward_horizon": 5,
    "epsilon": 1e-09,
    "universe": 15
  },
