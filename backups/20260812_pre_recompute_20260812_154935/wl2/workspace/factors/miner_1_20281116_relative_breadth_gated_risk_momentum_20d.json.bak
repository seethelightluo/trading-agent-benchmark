{
  "factor_id": "miner_1_20281116_relative_breadth_gated_risk_momentum_20d",
  "factor_name": "Relative Persistent Breadth-Gated Risk-Adjusted Momentum 20D",
  "version": "1.0",
  "calculation": {
    "expression": "(ret20/(std20*sqrt(20)) - cross_sectional_median(ret20/(std20*sqrt(20)))) * rolling_mean_5(2*(breadth20-0.5)), lagged_1d",
    "description": "Compute each asset's 20-day log-return divided by 20-day realized volatility, demean it by the same-day cross-sectional median, and multiply by the five-day average of the breadth regime (fraction of assets with positive 20-day return, centered and scaled). Shift one completed day to prevent look-ahead."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "return_window_days": 20,
    "volatility_window_days": 20,
    "breadth_smoothing_days": 5,
    "min_periods": 15,
    "lag_days": 1,
    "minimum_cross_section": 8
  },
