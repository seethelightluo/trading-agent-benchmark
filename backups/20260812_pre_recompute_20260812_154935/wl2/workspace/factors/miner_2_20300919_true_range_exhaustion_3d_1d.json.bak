  "factor_name": "Gap-aware true-range expansion exhaustion residual reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-rolling_sum_3(asset_return - cross_sectional_median_return) * (1 + max(true_range / rolling_median_20(true_range) - 1, 0))",
    "description": "Reverse the asset-specific three-day return residual versus the contemporaneous cross-sectional median, amplifying only when gap-aware true range expands above its own 20-day rolling median; expansion ratio is clipped at four."
