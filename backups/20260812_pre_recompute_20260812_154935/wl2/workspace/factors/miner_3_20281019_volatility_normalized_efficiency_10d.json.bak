{
  "factor_id": "miner_3_20281019_volatility_normalized_efficiency_10d",
  "factor_name": "Volatility-Normalized Directional Efficiency",
  "version": "1.0",
  "calculation": {
    "expression": "rolling_sum(log_return,20) / (sqrt(20) * rolling_rms(log_return,20))",
    "description": "Measures the signed 20-day directional move relative to realized RMS daily risk, then cross-sectionally median-centers and lags by one completed trading day to prevent look-ahead. Higher values indicate efficient upward movement per unit path risk."
  },
  "dependencies": [
    "close"
  ],
