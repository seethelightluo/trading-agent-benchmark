{
  "factor_id": "miner_1_20301031_clv_dispersion_reversal_1d",
  "factor_name": "Dispersion-gated close-location pressure reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-cross_sectional_center(rolling_mean(5, ((close-low)-(high-close))/(high-low))) * I(cs_return_dispersion > rolling_median(cs_return_dispersion,60))",
    "description": "Fade five-session close-location pressure, activated when cross-asset daily return dispersion is above its trailing 60-session median. Volume-independent to improve coverage."
  },
  "dependencies": ["open", "high", "low", "close"],
  "parameters": {"pressure_window": 5, "dispersion_window": 60, "minimum_cross_section": 8, "forward_horizon": 1},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01/2030-10-30",
    "metrics": {
      "daily_ic": 0.0395171714,
      "daily_icir": 0.1200727113,
      "ic_hit_ratio": 0.5476477684,
      "valid_ic_dates": 1658,
