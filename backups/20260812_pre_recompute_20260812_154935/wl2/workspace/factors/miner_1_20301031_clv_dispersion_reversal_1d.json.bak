      "turnover": 0.1487057668,
      "decay_ic_3d": -0.1589256630,
      "decay_ic_5d": -0.1217118356,
      "decay_ic_10d": -0.0803463407,
      "max_abs_library_correlation": null
    },
    "regime_notes": "Positive one-day IC and ICIR in 2020-2022, 2023-2025, and 2026-2030. Three-, five-, and ten-day overlapping-horizon diagnostics are negative; use only as a short-horizon overlay and interpret small cross-section uncertainty conservatively.",
    "signal_artifact": "scripts/miner_1_20301031_clv_dispersion_reversal_signal.csv"
