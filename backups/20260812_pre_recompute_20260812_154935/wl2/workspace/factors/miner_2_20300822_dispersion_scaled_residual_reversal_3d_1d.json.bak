{
  "factor_id": "miner_2_20300822_dispersion_scaled_residual_reversal_3d_1d",
  "factor_name": "Dispersion-scaled cross-asset residual reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-rolling_sum_3d(asset_return - cross_sectional_median_return) / rolling_mean_5d(cross_sectional_return_dispersion)",
    "description": "For each tradable benchmark asset, reverse its three-day return residual relative to the daily cross-sectional median, scaling by the recent five-day cross-sectional return dispersion. Higher values indicate stronger idiosyncratic underperformance likely to mean-revert while normalizing signal magnitude across volatility states. Inputs are lagged completed daily observations."
  },
  "dependencies": ["close", "daily_return", "cross_sectional_median", "cross_sectional_dispersion"],
  "parameters": {"residual_window_days": 3, "dispersion_window_days": 5, "min_dispersion_observations": 3, "min_instruments_per_date": 8, "forward_horizon_days": 1},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 to 2030-08-21",
    "last_validated": "2030-08-22T00:00:00Z",
