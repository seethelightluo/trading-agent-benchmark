{
  "factor_id": "miner_1_20300613_residual_shock_reversal_3d",
  "factor_name": "Cross-Asset Residual Volatility-Normalized Shock Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(sum_return_3d(asset) - median_cross_section(sum_return_3d))/rolling_std_daily_return_20d",
    "description": "At each completed date, subtract the cross-sectional median three-day return from each asset's three-day return and reverse the residual shock, normalized by its trailing 20-day daily-return volatility. This removes broad market direction and targets asset-specific short-term mean reversion."
  },
  "dependencies": ["close", "daily_returns"],
  "parameters": {"shock_window_days": 3, "volatility_window_days": 20, "minimum_cross_section": 8},
  "signal_artifact": "scripts/miner_1_20300613_residual_shock_reversal_signal.csv",
  "validation": {
