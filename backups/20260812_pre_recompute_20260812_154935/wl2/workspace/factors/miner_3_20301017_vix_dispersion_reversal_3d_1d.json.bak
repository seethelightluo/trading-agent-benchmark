{
  "factor_id": "miner_3_20301017_vix_dispersion_reversal_3d_1d",
  "factor_name": "VIX- and cross-asset-dispersion-gated three-day residual reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-((sum_return_3d - cross_sectional_median(sum_return_3d)) / (rolling_std_daily_return_20d * sqrt(3))) * I(VIX > rolling_median(VIX,60)) * I(cross_sectional_return_dispersion > rolling_median(dispersion,60))",
    "description": "Short-horizon residual reversal normalized by 20-day volatility and activated only when both observable VIX fear and cross-asset daily dispersion are above their trailing 60-day medians. Signal is aligned at date t with next-day cross-sectional return."
  },
  "dependencies": ["close", "VIX close from ../persistent/index_data/VIX.csv"],
  "parameters": {"return_window_days": 3, "volatility_window_days": 20, "regime_window_days": 60, "minimum_cross_section": 8, "universe_size": 15},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2030-10-16 available history",
    "last_validated": "2030-10-17T00:00:00",
