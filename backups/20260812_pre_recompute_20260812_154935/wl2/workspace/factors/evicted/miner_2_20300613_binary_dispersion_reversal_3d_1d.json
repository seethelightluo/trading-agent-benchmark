{
  "factor_id": "miner_2_20300613_binary_dispersion_reversal_3d_1d",
  "factor_name": "Binary High-Dispersion Volatility-Normalized Three-Day Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "I(dispersion_3d > rolling_median(dispersion_3d, 60)) * (-sum(pct_change(close, 3)) / (std(pct_change(close), 20) + 1e-6))",
    "description": "Ranks assets by volatility-normalized three-day reversal only when cross-asset three-day return dispersion is above its trailing 60-session median. All inputs are completed bars and the signal predicts next-day cross-sectional returns without future data."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "reversal_window_days": 3,
    "volatility_window_days": 20,
    "dispersion_window_days": 3,
    "dispersion_median_window_days": 60,
    "epsilon": 1e-06,
    "forward_horizon_days": 1,
    "minimum_cross_section": 8
  },
