  "factor_name": "Dispersion-Gated Volatility-Normalized Cross-Asset Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "cross_sectional_demean((-daily_return / rolling_std(daily_return,20)) * I[cross_sectional_return_dispersion > rolling_median(dispersion,60)] )",
    "description": "Ranks one-session reversal: assets with relatively poor prior-day risk-normalized returns receive positive scores, but the signal is activated only when cross-asset return dispersion exceeds its trailing 60-session median. All inputs are lagged through the prior completed session at decision time."
  },
  "dependencies": [
    "close",
    "daily_return"
  ],
  "parameters": {
    "volatility_window": 20,
    "dispersion_window": 60,
    "dispersion_min_instruments": 8,
    "gate": "dispersion above trailing median",
    "horizon_days": 1
  },
