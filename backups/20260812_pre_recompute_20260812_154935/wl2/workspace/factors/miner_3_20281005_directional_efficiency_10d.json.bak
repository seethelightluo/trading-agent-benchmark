{
  "factor_id": "miner_3_20281005_directional_efficiency_10d",
  "factor_name": "Directional Efficiency (Net Move / Absolute Path) 10D",
  "version": "1.0",
  "calculation": {
    "expression": "((sum(log_return,20)) / (sum(abs(log_return),20))) - cross_sectional_median",
    "description": "Measures how efficiently an asset's 20-day movement travels in one direction rather than churning. Positive values indicate persistent upward movement; negative values indicate persistent downward movement. Signal is lagged one completed bar to avoid look-ahead."
  },
  "dependencies": ["close"],
  "parameters": {"lookback_days": 20, "min_periods": 15, "forward_horizon_days": 10, "cross_sectional_center": "median", "lag_days": 1},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2028-10-04",
    "metrics": {
      "ic": 0.031713,
      "icir": 0.101066,
      "horizon_days": 10,
      "dates": 2941,
      "average_instruments": 14.25,
      "coverage": 0.9440,
      "turnover": 0.040479,
      "ic_hit_ratio": 0.5308,
      "max_abs_library_correlation": null
    },
    "regime_notes": "Validated across approximately 2,941 daily cross-sectional observations and all 15 tradable benchmark instruments; positive 10-day IC and ICIR clear the benchmark admission gates. IC uncertainty is interpreted conservatively due to the small cross-section.",
    "validation_timestamp": "2028-10-05T00:00:00Z"
  },
  "signal_artifact": "scripts/miner_3_20281005_efficiency_signal.csv",
