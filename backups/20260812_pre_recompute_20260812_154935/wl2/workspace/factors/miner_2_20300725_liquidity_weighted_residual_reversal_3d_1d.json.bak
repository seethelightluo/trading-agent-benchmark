{
  "factor_id": "miner_2_20300725_liquidity_weighted_residual_reversal_3d_1d",
  "factor_name": "Liquidity-weighted robust residual reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(sum_3d(asset_return)-sum_3d(cross_sectional_median_return))/rolling_std_20d * (1 + 0.25*(log(volume/median_volume_20d)-cross_sectional_median(log(volume/median_volume_20d))))",
    "description": "Three-day residual reversal relative to the cross-sectional median, volatility scaled and modestly adjusted by trailing relative volume. The liquidity term is cross-sectionally demeaned and clipped to avoid domination by volume outliers. All inputs are available by the signal date."
  },
  "dependencies": ["close", "volume"],
  "parameters": {"residual_window_days": 3, "volatility_window_days": 20, "relative_volume_window_days": 20, "liquidity_coefficient": 0.25, "relative_volume_clip": [0.25, 4.0], "universe_size": 15, "minimum_cross_section": 8},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01/2030-07-25",
    "metrics": {
      "horizon_days": 1,
      "ic": 0.046554,
      "icir_daily": 0.095242,
      "ic_hit_ratio": 0.5391,
      "dates": 998,
      "average_instruments": 8.921,
      "coverage": 0.5947,
      "turnover": null,
      "decay_ic_5d": 0.036559,
      "decay_icir_5d": 0.074161,
      "decay_ic_10d": 0.023552,
      "decay_icir_10d": 0.047374,
      "max_abs_library_correlation": null
    },
    "regime_notes": "Passed the benchmark-wide absolute daily IC >= 0.0070 and absolute daily ICIR >= 0.0840 gates. Five- and ten-day predictive power decays but remains positive. The volume-available subset is shorter than the full close history; uncertainty is interpreted conservatively given the 15-asset cross-section.",
    "signal_artifact": "scripts/miner_2_20300725_liquidity_reversal_signal.csv",
    "validated_at": "2030-07-25T00:00:00Z"
  },
