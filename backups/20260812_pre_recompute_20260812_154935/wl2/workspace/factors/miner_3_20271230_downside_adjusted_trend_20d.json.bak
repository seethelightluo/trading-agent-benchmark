{
  "factor_id": "miner_3_20271230_downside_adjusted_trend_20d",
  "factor_name": "Downside-Risk-Adjusted 20-Day Trend",
  "version": "20271230",
  "calculation": {
    "expression": "(close_t / close_{t-20} - 1) / (std(negative_daily_returns_{t-19:t}) + 1e-5)",
    "description": "Trailing 20-session return divided by trailing downside deviation, using only returns below zero in the denominator. Higher values indicate trend persistence achieved with less harmful downside variability. Signal is lagged one session for forward-return testing."
  },
  "dependencies": ["close", "pct_change"],
  "parameters": {"lookback_sessions": 20, "downside_window": 20, "min_downside_observations": 15, "epsilon": 0.00001, "admission_horizon_sessions": 10},
