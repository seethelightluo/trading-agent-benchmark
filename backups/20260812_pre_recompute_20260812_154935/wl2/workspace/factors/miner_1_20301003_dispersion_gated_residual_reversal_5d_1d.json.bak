{
  "factor_id": "miner_1_20301003_dispersion_gated_residual_reversal_5d_1d",
  "factor_name": "Dispersion-gated five-day residual reversal",
  "version": "1.0",
  "calculation": {
    "expression": "demean_cs((-return_5d / volatility_20d) * I(dispersion_1d > median_60d(dispersion_1d)))",
    "description": "Ranks assets positively when their five-day return is below the cross-sectional median, scaled by inverse 20-day volatility and activated when cross-asset daily dispersion exceeds its trailing 60-day median. The signal uses only completed-day data."
  },
  "dependencies": ["close", "pct_change", "cross_sectional_median", "rolling_std"],
  "parameters": {"return_window_days": 5, "volatility_window_days": 20, "dispersion_window_days": 1, "dispersion_median_window_days": 60, "minimum_cross_section": 8, "gate": "dispersion > trailing_median"},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2030-10-03",
    "metrics": {
      "daily_paper_ic": 0.030438,
      "daily_paper_icir": 0.090011,
      "ic_hit_ratio": 0.5335,
      "valid_ic_dates": 1537,
      "average_instruments": 13.643,
      "factor_coverage": 0.892,
      "rank_turnover": 0.1475,
      "max_abs_library_correlation": null,
      "decay_ic_3d": 0.020923,
      "decay_ic_5d": 0.028145,
      "decay_ic_10d": 0.016388
    },
    "regime_notes": "Positive daily IC and ICIR in all tested broad regimes: 2020-2022 IC/ICIR 0.033718/0.097321; 2023-2025 0.028401/0.083799; 2026-2030 0.029780/0.089976. Small 15-asset universe requires conservative interpretation.",
    "signal_artifact": "scripts/miner_1_20301003_residual_reversal_5d_signal.csv"
  },
  "tags": ["reversal", "cross_asset", "dispersion_conditioned", "volatility_scaled", "short_horizon"],
