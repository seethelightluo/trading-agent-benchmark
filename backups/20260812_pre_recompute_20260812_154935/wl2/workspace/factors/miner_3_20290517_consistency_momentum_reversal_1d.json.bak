  "factor_name": "Consistency-Weighted Momentum Reversal",
  "version": "2029-05-17",
  "calculation": {
    "expression": "-((sum(pct_change(close),20) * mean(pct_change(close)>0,20)) / std(pct_change(close),20))",
    "description": "Ranks assets contrarian to their 20-day volatility-normalized cumulative return, with the momentum magnitude weighted by the fraction of positive sessions. The full signal is lagged one completed trading day before forecasting next-day returns.",
