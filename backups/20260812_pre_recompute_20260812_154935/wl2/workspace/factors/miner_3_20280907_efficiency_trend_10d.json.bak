{
  "factor_id": "miner_3_20280907_efficiency_trend_10d",
  "factor_name": "Path-Efficiency Relative Trend",
  "version": "1.0",
  "calculation": {
    "expression": "cross_sectional_median_center(log(close/close[-20]) / rolling_sum(abs(log(close/close[-1])),20))",
    "description": "20-trading-day signed log return divided by the 20-day sum of absolute daily log returns, cross-sectionally median centered and lagged one completed day. Higher values identify persistent directional trends rather than choppy moves."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "trend_window": 20,
    "path_window": 20,
    "minimum_path_observations": 15,
