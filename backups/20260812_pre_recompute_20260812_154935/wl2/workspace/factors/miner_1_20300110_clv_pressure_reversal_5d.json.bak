{
  "factor_id": "miner_1_20300110_clv_pressure_reversal_5d",
  "factor_name": "Volatility-Scaled Close-Location Pressure Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(0.65*rolling_mean(5, ((close-low)-(high-close))/(high-low)) + 0.35*rolling_mean(5, (close-open)/(high-low))) / (rolling_std(returns,20)+0.01)",
    "description": "Fades persistent five-day close-location and candle-body pressure, with volatility scaling. Positive values indicate potential rebound after sustained selling pressure. Zero ranges are treated as missing."
  },
  "dependencies": ["open", "high", "low", "close", "pct_change"],
  "parameters": {"pressure_window": 5, "location_weight": 0.65, "body_weight": 0.35, "volatility_window": 20, "volatility_floor": 0.01, "forward_horizons_days": [1, 5]},
  "signal_artifact": "scripts/miner_1_20300110_clv_pressure_5d_signal.csv",
