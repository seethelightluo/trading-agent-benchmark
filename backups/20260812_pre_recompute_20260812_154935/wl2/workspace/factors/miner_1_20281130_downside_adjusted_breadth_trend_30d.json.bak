{
  "factor_id": "miner_1_20281130_downside_adjusted_breadth_trend_30d",
  "factor_name": "Downside-Risk-Adjusted Breadth-Gated Trend 30D",
  "version": "1.0",
  "calculation": {
    "expression": "shift1((log(close/close_30d) / downside_std_30d) - cross_sectional_median(...) ) * clip(2*(rolling5(mean_i[log_return_30d_i>0])-0.5), -1, 1)",
    "description": "Thirty-day log momentum normalized by each instrument's 30-day downside return volatility, cross-sectionally demeaned by the daily median, multiplied by a five-day smoothed breadth gate, then lagged one completed trading day to avoid look-ahead. Downside volatility is computed from negative daily log returns only."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "momentum_window": 30,
    "downside_volatility_window": 30,
    "downside_volatility_min_periods": 20,
    "breadth_window": 30,
    "breadth_smoothing_window": 5,
    "signal_lag_days": 1,
    "cross_sectional_center": "median",
    "breadth_gate_clip": [
      -1,
      1
    ]
  },
