{
  "factor_id": "miner_3_20301003_dispersion_residual_reversal_5d_1d",
  "factor_name": "High-dispersion volatility-normalized five-day residual reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-((sum_return_5d - cross_sectional_median(sum_return_5d)) / (rolling_std_return_20d * sqrt(5))) * I(cross_sectional_dispersion_1d > trailing_median_60d)",
    "description": "Ranks assets for reversal of their five-day return relative to the cross-asset median, normalized by 20-day volatility and activated only when cross-sectional daily dispersion exceeds its trailing 60-day median. Signal is formed using data through the prior completed day."
  },
  "dependencies": ["close", "daily_returns"],
  "parameters": {"residual_window_days": 5, "volatility_window_days": 20, "dispersion_window_days": 60, "minimum_cross_section": 8},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-02 to 2030-10-02",
    "last_validated": "2030-10-03T00:00:00",
    "metrics": {
      "daily_ic": 0.0341577722,
      "daily_icir": 0.1018047803,
      "ic_hit_ratio": 0.5376670717,
      "dates": 1646,
      "average_instruments_per_date": 13.4592952612,
      "factor_coverage": 0.8919821162,
      "turnover": 0.1557532288,
      "max_abs_library_correlation": null,
      "decay_ic_3d": -0.2851251247,
      "decay_ic_5d": -0.2211037612,
      "decay_ic_10d": -0.1585723006
    },
    "regime_notes": "Daily IC and ICIR passed in 2020-2022 (0.03439, 0.09895), 2023-2025 (0.02939, 0.08703), and 2026-2030 (0.03800, 0.11667). The factor is admitted on the required one-day horizon; multi-day decay estimates are negative because the signal is a short-horizon reversal and should not be interpreted as a multi-day holding signal.",
    "gate": {"minimum_absolute_daily_ic": 0.007, "minimum_absolute_daily_icir": 0.084}
  },
  "signal_artifact": "scripts/miner_3_20301003_dispersion_residual_reversal_signal.csv",
  "tags": ["reversal", "cross_asset", "dispersion", "volatility_normalized"]
