{
  "factor_id": "miner_2_20280210_downside_adjusted_reversal_5d",
  "factor_name": "Downside-risk-adjusted short reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(close/close.shift(5)-1) / (rolling_std(negative_daily_returns,20)+1e-5)",
    "description": "Ranks recent five-session losses positively for reversal, scaling the contrarian signal by each instrument's 20-session downside-return volatility. Only completed daily bars are used."
  },
  "dependencies": [
    "close",
    "daily_returns"
  ],
  "parameters": {
    "reversal_window": 5,
    "downside_vol_window": 20,
    "downside_min_periods": 15,
    "epsilon": 1e-05,
    "forward_horizon": 1
  },
