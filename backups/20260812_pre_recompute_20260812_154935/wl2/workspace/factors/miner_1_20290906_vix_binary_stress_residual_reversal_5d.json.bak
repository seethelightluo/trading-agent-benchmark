{
  "factor_id": "miner_1_20290906_vix_binary_stress_residual_reversal_5d",
  "factor_name": "Binary VIX-Stress Beta-Residual Reversal (5d)",
  "version": "1.0",
  "calculation": {
    "expression": "2 * I(VIX_t > rolling_median(VIX,60)) * (-sum_{k=0..4}(r_asset,t-k - beta_asset,t * mean_cross_section(r_t-k))/std60_asset)",
    "description": "When observation-only VIX is above its trailing 60-day median, take a beta-neutral five-day residual reversal signal, scaled by asset 60-day volatility; otherwise signal is zero. All inputs are lagged through the completed day t."
  },
  "dependencies": ["close", "VIX observation-only macro series"],
  "parameters": {"beta_window_days": 60, "residual_window_days": 5, "volatility_window_days": 60, "vix_median_window_days": 60, "stress_multiplier": 2.0, "forward_horizon_days": 1, "minimum_cross_section": 8},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2029-09-05",
    "last_validated": "2029-09-06",
    "metrics": {
      "daily_ic": 0.029030,
      "daily_icir": 0.084831,
      "ic_hit_ratio": 0.5275,
      "valid_dates": 546,
      "average_instruments": 12.0934,
      "coverage": 0.80623,
      "rank_turnover": 0.18482,
      "decay_ic_3d": 0.024991,
      "decay_ic_5d": 0.053833,
      "decay_ic_10d": 0.042714,
      "max_abs_library_correlation": null,
      "admission_threshold_abs_daily_ic": 0.007,
      "admission_threshold_abs_daily_icir": 0.084
    },
    "regime_notes": "Full-sample daily IC and ICIR pass the benchmark-wide gates. 2029+ is strong but has only 24 observations; 2027+ and 2028+ are positive but below the ICIR gate. Interpret conservatively given the 15-asset universe.",
    "signal_artifact": "scripts/miner_1_20290906_vix_binary_residual_signal.csv"
  },
  "tags": ["macro-conditioned", "VIX", "residual-reversal", "cross-asset", "risk-adjusted"],
  "provenance": {"script": "scripts/miner_1_20290906_vix_binary_residual.py", "universe_size": 15, "observation_only_macro_not_tradable": true}
}
