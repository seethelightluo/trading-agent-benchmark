{
  "factor_id": "miner_2_20290920_continuous_dispersion_beta_residual_reversal_3d",
  "factor_name": "Continuous high-dispersion beta-neutral residual reversal",
  "version": "1.1",
  "calculation": {
    "expression": "clip(dispersion/rolling_median(dispersion,120)-1,0,2) * indicator(dispersion >= rolling_quantile(dispersion,120,0.65)) * (-sum_3d(asset_return-beta_60d*cross_asset_mean_return)/vol_60d)",
    "description": "Ranks assets by negative three-day beta-neutral residual return, volatility scaled and multiplied by a clipped continuous intensity during high cross-asset dispersion. Inputs are lagged through the prior completed session."
  },
  "dependencies": ["close", "daily_returns"],
  "parameters": {"beta_window": 60, "residual_horizon": 3, "volatility_window": 60, "dispersion_window": 120, "dispersion_quantile": 0.65, "intensity_cap": 2.0, "minimum_cross_section": 8, "lag_days": 1},
  "validation": {
