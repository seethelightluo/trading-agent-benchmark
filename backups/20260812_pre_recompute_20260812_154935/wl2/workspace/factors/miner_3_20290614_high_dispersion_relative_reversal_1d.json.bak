  "factor_name": "High-dispersion cross-asset relative reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-sum(return_1d,5)/rolling_std(return_1d,20)",
    "description": "For each tradable asset, rank the negative five-day return normalized by its 20-day volatility. Admit the signal only when the current mean cross-asset 20-day daily volatility is above its expanding historical 70th percentile. Signal is computed through the last completed day and used for next-day returns.",
    "lag": 1
  },
  "dependencies": ["close", "daily_return"],
  "parameters": {"return_window": 5, "volatility_window": 20, "dispersion_window": 20, "dispersion_threshold": "expanding_70th_percentile", "min_cross_section": 8},
