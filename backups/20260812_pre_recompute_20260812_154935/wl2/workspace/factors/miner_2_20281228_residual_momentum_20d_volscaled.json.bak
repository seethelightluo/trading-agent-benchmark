{
  "factor_id": "miner_2_residual_momentum_20d_volscaled",
  "factor_name": "Market-Residual Volatility-Scaled Momentum",
  "version": "2028-12-28",
  "calculation": {
    "expression": "shift_1(rolling_sum_20(residual_return,20) / rolling_std_20(raw_return,20))",
    "description": "For each tradable asset, remove rolling 60-session equal-weight market beta exposure from daily log returns, sum the residual returns over 20 sessions, and scale by the asset's 20-session realized volatility. The signal is lagged one completed bar to prevent look-ahead."
  },
  "dependencies": ["close", "daily_log_return", "cross_asset_equal_weight_return"],
  "parameters": {"beta_window": 60, "beta_min_periods": 40, "momentum_window": 20, "volatility_window": 20, "signal_lag_sessions": 1, "minimum_cross_section": 8},
  "validation": {
