[Unit]
Description=Push major AlphaCrafter result milestones
After=trade-agent-benchmark-autopush.service

[Service]
Type=simple
WorkingDirectory=/home/lxx/trade-agent-benchmark
ExecStart=/usr/bin/python3 /home/lxx/trade-agent-benchmark/ops/git_milestone_watch.py
Restart=always
RestartSec=15s

[Install]
WantedBy=default.target
