{"factor_id": "skew_20d", "factor_name": "Return Skewness 20d", "version": "1.0.0", "calculation": {"expression": "rolling_mean((r - rolling_mean(r,20))^3,20) / rolling_std(r,20)^3,  r=pct_change(close)", "description": "20-day rolling skewness of daily returns. Positive skew (fat right tail) historically precedes continued cross-asset upside at 10d horizon."}, "dependencies": ["close"], "parameters": {"window": 20}, "expected_direction": 1, "validation": {"status": "EFFECTIVE", "period": "2020-01-01..2026-07-15", "last_validated": "2026-08-12", "admission_horizon": 10, "regime_notes": "Validated 2020-01-01..2026-07-15 across multiple regimes: COVID crash 2020, recovery bull 2020-21, 2022 tightening bear, 2023-24 AI-led equity rally, 2024-26 crypto/commodity cycles. Cross-sectional rank IC on the 15-asset tradable universe.", "metrics": {"ic": 0.0361, "icir": 0.1109, "ic_hit_ratio": 0.5477, "n_ic_dates": 1645, "coverage_asset_days": 0.9402, "coverage_dates_ge8": 0.9642, "turnover_10d_rank": 0.2817, "decay_ic_by_horizon": {"1": 0.0016, "2": 0.0081, "3": 0.014, "5": 0.0198, "10": 0.0361, "20": 0.0433}, "max_abs_library_correlation": 0.178}, "signal_artifact": {"format": "base64:zlib:csv", "description": "Factor signal panel: rows = dates, cols = assets. Shape (4174, 15)", "columns": ["000300.SH", "000688.SH", "SPX", "HSI", "N225", "SX5E", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"], "shape": [4174, 15], "n_valid_values": 24210, "sha256": "7264a774884fc589", "data": ""}}, "tags": ["return-shape", "cross-asset"]}