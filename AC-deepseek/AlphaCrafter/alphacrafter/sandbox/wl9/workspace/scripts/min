"""
Compute correlation of vix_roc_20d with existing factors in the library.
"""
import sys
sys.path.insert(0, '.')
import numpy as np
import pandas as pd
import json, os
from alphacrafter.sim.utils import get_stock_daily_data, get_index_daily_data, get_account_dict

data = get_account_dict()
watchlist = data['watch_list']

safe_havens = ['XAU', 'US10Y', 'CN10Y']

# Get VIX data
vix_df = get_index_daily_data("VIX", 800)
vix_close = vix_df.set_index('date')['close']
vix_roc = vix_close.pct_change(20)

# Get asset data
asset_dfs = {}
for sym in watchlist:
    df = get_stock_daily_data(sym, 500)
    asset_dfs[sym] = df.set_index('date')

# Compute new factor signal panel (date x asset)
# For each date and each asset, compute factor value
dates = vix_roc.dropna().index

new_factor_signals = {}
for date in dates:
    if date not in vix_roc.index or pd.isna(vix_roc.loc[date]):
        continue
    vix_trend = vix_roc.loc[date]
    signals = {}
    for sym in watchlist:
        if sym in safe_havens:
            signals[sym] = vix_trend
        else:
            signals[sym] = -vix_trend
    new_factor_signals[date] = signals

# Load existing factor panels from library (read signal artifacts)
factor_dir = 'factors'
existing_factor_ids = ['beta_VIX_60', 'mom_120d_skip5', 'mom_10d_skip5', 'bb_width_20d', 
                       'kaufman_eff_20d', 'cny_beta_60', 'vol_z_20d', 'ac1_120d',
                       'dxy_corr_change_20_60', 'skew_20d', 'kurt_20d', 'rng_pos_20d',
                       'streak_len_14', 'days_since_high_60', 'vix_beta_cond_60x20']

# We'll compute factor values for existing factors at the same dates
# Then check correlations

# Let's compute a simple time-series of factor IC for vix_roc_20d
# and compare against key existing factors' IC time-series

# For correlation with library, compute cross-sectional factor values on common dates
# Then compute pairwise correlations

