{
  "factor_id": "mom_diff_20_60",
  "factor_name": "Fast-minus-slow momentum differential 20d vs 60d",
  "version": "1.0.0",
  "calculation": {
    "expression": "(close/close_20d_ago - 1) - (close/close_60d_ago - 1)",
    "description": "Difference between 20-day and 60-day momentum. Rises when short-horizon momentum is stronger than medium-horizon momentum (accelerating/impulse regime) and falls when short-run momentum lags the medium trend (decelerating). Captures momentum acceleration across the 15-asset cross-asset universe."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "fast_window": 20,
    "slow_window": 60,
    "horizon": 10
  },
  "tags": [
    "momentum",
    "acceleration",
    "cross-asset"
  ],
  "expected_direction": 1,
