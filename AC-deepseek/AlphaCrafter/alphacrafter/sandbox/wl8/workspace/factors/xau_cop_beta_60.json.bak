 "factor_name": "XAU/COPPER ratio beta (gold vs industrial metals sensitivity)",
 "version": "2026-07-30",
 "calculation": {
  "expression": "60d rolling beta(asset_daily_return, XAU/COPPER_ratio_daily_return)",
  "description": "Sensitivity of each asset's daily returns to moves in the gold/copper price ratio. A high positive beta means the asset co-moves with gold relative to industrial metals (defensive/real-asset tilt); a negative beta means it tracks the industrial-metals (cyclical/risk-on) side. Unit-free and cross-sectionally comparable; captures the risk-on/off commodity regime role of each instrument."
 },
