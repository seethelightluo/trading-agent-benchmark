{
 "factor_id": "eff_ratio_20",
 "factor_name": "20d Efficiency Ratio (Kaufman)",
 "version": "1.0.0",
 "calculation": {
  "expression": "abs(close - close.shift(20)) / sum(abs(diff(close)), 20)",
  "description": "Kaufman efficiency ratio over 20d: net displacement divided by total path length (1.0 = perfectly trending, 0 = choppy). Trend-efficient assets tend to outperform over the next 10 trading days in this cross-asset universe (trend persistence)."
 },
 "dependencies": [
  "close"
 ],
 "parameters": {
  "lookback": 20
 },
 "tags": [
  "trend",
  "efficiency",
  "momentum",
  "cross-asset"
 ],
