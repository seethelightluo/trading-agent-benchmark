{
 "factor_id": "eff_ratio_20",
 "factor_name": "Kaufman efficiency ratio 20d",
 "version": "1.0.0",
 "calculation": {
  "expression": "|close/close_shift(20)-1| / sum(|daily_ret|, 20)",
  "description": "Trend efficiency: net 20d displacement divided by total 20d path length. High values = clean directional trends (efficient), low values = choppy range-bound price action. Cross-sectionally favors assets in efficient trends over the next 10 trading days."
 },
 "dependencies": [
  "close"
 ],
 "parameters": {
  "win": 20
 },
 "expected_direction": 1,
