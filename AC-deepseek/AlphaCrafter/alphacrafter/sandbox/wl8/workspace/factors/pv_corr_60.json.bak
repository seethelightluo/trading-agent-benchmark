{
 "factor_id": "pv_corr_60",
 "factor_name": "price-volume correlation 60d",
 "version": "1.0.0",
 "calculation": {
  "expression": "corr(pct_change(close,1), log(volume), 60)",
  "description": "60-day rolling Pearson correlation between daily return and log trading volume per asset. Positive when price moves accompany rising participation (conviction); negative IC -> flip (low/negative pv-corr assets earn higher forward 10d returns)."
 },
 "dependencies": [
  "close",
  "volume"
 ],
 "parameters": {
  "corr_win": 60,
  "log_volume": true
 },
