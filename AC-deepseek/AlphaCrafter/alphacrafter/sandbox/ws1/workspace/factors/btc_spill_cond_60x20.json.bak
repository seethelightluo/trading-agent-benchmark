{
  "factor_id": "btc_spill_cond_60x20",
  "factor_name": "BTC spill conditional 60x20",
  "version": "1.0.0",
  "calculation": {
    "expression": "beta(asset_ret, BTC_ret, 60) * (BTC/BTC.shift(20) - 1.0)",
    "description": "Conditional crypto spillover: asset beta to BTC changes times the 20-day BTC move. Positive when risk assets with high BTC-beta rally with BTC, or hedges rise while BTC falls."
  },
  "dependencies": [
    "close",
    "BTC"
  ],
  "parameters": {
    "beta_win": 60,
    "btc_win": 20
  },
  "expected_direction": 1,
