  "factor_name": "USDJPY-beta conditional 60x20",
  "version": "1.0.0",
  "calculation": {
    "expression": "beta(asset_ret, USDJPY_ret, 60) * (USDJPY/USDJPY.shift(20) - 1.0)",
    "description": "Conditional FX signal: asset beta to USDJPY changes times the 20-day USDJPY move. High when a JPY-sensitive asset rises with a strong USDJPY (weak JPY) impulse."
