{
  "factor_id": "consec_up_ratio_20",
  "factor_name": "Consecutive up-run ratio 20d",
  "version": "1.0.0",
  "calculation": {
    "expression": "longest_up_run(20) / (longest_up_run(20) + longest_down_run(20))",
    "description": "Share of the longest winning streak in the total of the longest winning and losing streaks over 20 days; high values flag persistent directional upward pressure."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "window": 20
  },
  "expected_direction": 1,
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01..2026-07-15",
    "last_validated": "2026-07-16",
    "admission_horizon": 10,
