{
  "factor_id": "eff_ratio_60d",
  "factor_name": "Kaufman Efficiency Ratio 60d",
  "version": "1.0",
  "calculation": {
    "expression": "abs(close - close.shift(60)) / sum(abs(close.diff()), 60)",
    "description": "Trend quality: net 60-day price displacement divided by total 60-day path length. High values mean clean directional trends (higher forward returns); low values mean choppy/mean-reverting action. Slow-moving, low-turnover trend-quality signal."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "window": 60
  },
  "direction": "+",
  "tags": [
    "trend-quality",
    "efficiency",
    "low-turnover"
  ],
  "validation": {
    "horizon_days": 10,
    "period": "2020-01-01..2026-07-15",
    "status": "EFFECTIVE",
    "last_validated": "2026-07-16",
    "metrics": {
      "ic": 0.0333,
      "icir": 0.1153,
      "ic_hit_ratio": 0.539,
      "n_ic_dates": 1311,
      "n_assets_mean": 15.0,
      "coverage_asset_days": 0.957,
      "coverage_dates_ge8": 0.957,
      "turnover_10d_rank": 3.114,
      "decay_ic_by_horizon": {
        "1": 0.0139,
        "2": 0.0128,
        "3": 0.0136,
        "5": 0.0244,
        "10": 0.0333,
        "20": 0.0424
      },
      "max_abs_library_correlation": 0.1666,
      "max_abs_library_correlation_vs": "mom_10d_skip5"
    },
    "regime_notes": "mkt_up IC=+0.0346(n=725) mkt_dn IC=+0.0317(n=586) | vix_low IC=+0.0090(n=658) vix_high IC=+0.0577(n=653); yearly IC {2020: 0.0889, 2021: -0.0128, 2022: 0.0972, 2023: 0.0201, 2024: -0.0808, 2025: 0.1084, 2026: 0.0237}"
  }
}