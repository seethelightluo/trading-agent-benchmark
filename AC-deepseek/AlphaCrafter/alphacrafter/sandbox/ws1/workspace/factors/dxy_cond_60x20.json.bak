{
  "factor_id": "dxy_cond_60x20",
  "factor_name": "Conditional DXY Beta x DXY 20d Move",
  "version": "1.0",
  "calculation": {
    "expression": "beta(asset_ret, DXY_ret, 60) * (DXY/DXY.shift(20) - 1.0)",
    "description": "Macro spillover: asset's 60d beta to the dollar times the 20d DXY move. Positive when an asset is dollar-sensitive and the dollar is trending. Captures cross-asset carry/risk rotation driven by USD strength/weakness. Independent from the VIX-conditional factor."
  },
  "dependencies": [
    "close",
    "DXY"
  ],
  "parameters": {
    "beta_window": 60,
    "move_window": 20
  },
  "direction": "+",
  "tags": [
    "macro",
    "currency",
    "conditional-beta"
  ],
  "validation": {
    "horizon_days": 10,
    "period": "2020-01-01..2026-07-15",
    "status": "EFFECTIVE",
    "last_validated": "2026-07-16",
