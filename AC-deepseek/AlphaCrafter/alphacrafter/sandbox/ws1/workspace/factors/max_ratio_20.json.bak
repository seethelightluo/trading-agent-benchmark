{
  "factor_id": "max_ratio_20",
  "factor_name": "Max/min return ratio 20d",
  "version": "1.0.0",
  "calculation": {
    "expression": "max(pct_change,20) / abs(min(pct_change,20))",
    "description": "Ratio of the best up-day to the magnitude of the worst down-day over 20 days; high values indicate upside-dominated price action."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "window": 20
  },
  "expected_direction": 1,
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01..2026-07-15",
    "last_validated": "2026-07-16",
    "admission_horizon": 10,
    "regime_notes": "Validated 2020-01-01..2026-07-15 across multiple regimes: COVID crash 2020, recovery bull 2020-21, 2022 tightening bear, 2023-24 AI-led equity rally, 2024-26 crypto/commodity cycles. Cross-sectional rank IC on the 15-asset tradable universe.",
    "metrics": {
