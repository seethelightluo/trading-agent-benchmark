{
  "factor_id": "amihud_liquidity_20d",
  "factor_name": "Amihud Liquidity 20d (negated illiquidity)",
  "version": "1.0",
  "calculation": {
    "expression": "-mean(|pct_change| / volume, 20)",
    "description": "Negated 20-day Amihud illiquidity: higher values = more liquid (low |return| per unit volume). Liquid assets outperform over 10-20d horizons in this universe. NOTE: only 9/15 assets have non-zero volume in the synthetic data (SOX, XAU, COPPER, WTI, US10Y, CN10Y have zero volume -> NaN); factor is defined on the 9 volume-bearing assets."
  },
  "dependencies": [
    "close",
    "volume"
  ],
  "parameters": {
    "window": 20
  },
  "direction": "+",
  "tags": [
    "liquidity",
    "microstructure"
  ],
  "validation": {
    "horizon_days": 10,
    "period": "2020-01-01..2026-07-15",
    "status": "EFFECTIVE",
    "last_validated": "2026-07-16",
    "metrics": {
