{
 "factor_id": "miner1_20260716_rev5x_er_soft",
 "factor_name": "5d reversal x soft efficiency ratio weight",
 "version": "1.0.0",
 "calculation": {
  "expression": "-(close_t/close_{t-5} - 1) * max(0, 1 - ER20_t),  ER20_t = |close_t/close_{t-20} - 1| / sum_{i=1..20}|ln(close_{t-i+1}/close_{t-i})|",
  "description": "5-day price reversal scaled by a soft trend-efficiency weight (1 - ER20 clipped at 0). ER20 is the 20d efficiency ratio (net move / path length); low ER means choppy/mean-reverting price action, so reversal signals are upweighted when the asset is in a noisy regime. Cross-asset panel of 15 tradable instruments."
 },
 "dependencies": [
  "close"
 ],
 "parameters": {
  "rev_win": 5,
  "er_win": 20,
  "er_clip_lower": 0.0
 },
