{
  "factor_id": "mom_skew_change",
  "factor_name": "Momentum of skewness (60d-20d)",
  "version": "1.0.0",
  "calculation": {
    "expression": "skew(ret,60) - skew(ret,20)",
    "description": "Change in return skewness: short-window skew minus long-window skew. Assets whose recent return distribution has become more left-skewed relative to their longer history (falling factor) tend to outperform - rising negative skew flags deteriorating risk. expected_direction=-1."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "short_window": 20,
    "long_window": 60,
    "admission_horizon": 10
  },
  "expected_direction": -1,
  "signal_artifact": "mom_skew_change_signal.npy",
  "signal_artifact_format": "npy",
