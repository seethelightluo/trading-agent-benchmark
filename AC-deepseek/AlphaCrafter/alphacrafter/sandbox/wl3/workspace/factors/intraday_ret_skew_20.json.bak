{
  "factor_id": "intraday_ret_skew_20",
  "factor_name": "20d skew of intraday return (close/open)",
  "version": "1.0.0",
  "calculation": {
    "expression": "skew_20d(close/open - 1)",
    "description": "Skewness of the daily close-vs-open (intraday) return over 20 days. Positive skew (fat right tail of intraday moves) predicts higher forward 10d returns cross-sectionally — an asymmetry/trend-quality signal distinct from raw momentum. Max library rho ~0.36 vs skew_term_20_60 (term-structure skew) — shares the skew concept but different construction."
  },
