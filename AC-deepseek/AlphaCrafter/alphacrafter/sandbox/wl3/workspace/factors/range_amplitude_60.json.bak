{
  "factor_id": "range_amplitude_60",
  "factor_name": "(max-min)/mean of close over 60d (trading amplitude)",
  "version": "1.0.0",
  "calculation": {
    "expression": "(rolling_max(close,60) - rolling_min(close,60)) / rolling_mean(close,60)",
