{
  "factor_id": "coexceed_down_60",
  "factor_name": "Joint downside co-exceedance with SPX (60d)",
  "version": "1.0.0",
  "calculation": {
    "expression": "mean( (ret < -0.01) & (spx_ret < -0.01) over trailing 60d )",
    "description": "For each asset, count the fraction of trading days in the trailing 60-day window where both the asset return and the SPX return fell below -1% (joint downside co-exceedance). High values mark assets that crash together with US equities -- a risk-on / high systemic-beta signature. Positive cross-sectional IC: these co-crash-prone assets tend to outperform over the next 10 days in the synthetic benchmark (regime/risk-appetite classifier)."
  },
  "dependencies": [
    "close",
    "SPX.close"
  ],
  "parameters": {
    "window": 60,
    "threshold": 0.01
  },
  "expected_direction": 1,
