{
  "factor_id": "vol_regime_switch_20x60",
  "factor_name": "Vol-regime switching frequency 20x60",
  "version": "1.0.0",
  "calculation": {
    "expression": "MEAN(DIFF((RVOL20 > MEDIAN(RVOL20,60)) != 0), 60), RVOL20 = STD(pct_change(close,1),20)",
    "description": "Frequency with which an asset flips between high- and low-vol states over the trailing 60d, where the state is (20d realized vol above its 60d rolling median). Frequent vol-regime switching (unstable vol states) is followed by 10d outperformance in this worldline: positive cross-sectional IC +0.037, ICIR +0.131, high coverage (~73% asset-days), low turnover (~2.1 rank units / 10d), decay stable out to 20d (IC +0.039)."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "vol_window": 20,
    "median_window": 60,
    "switch_window": 60,
    "min_obs": 10
  },
  "expected_direction": 1,
  "signal_artifact": "vol_regime_switch_20x60_signal.npy",
