{
  "factor_id": "dd_duration_120_resid",
  "factor_name": "Drawdown Duration 120d (orthogonalized vs mom120)",
  "version": "1.0.0",
  "calculation": {
    "expression": "log1p(days_since_120d_high) - beta * zscore(mom_120d_skip5)",
    "description": "Log1p of number of days since the last 120-day rolling high, then cross-sectionally orthogonalized (per-date) against z-scored mom_120d_skip5. Captures mean-reversion/recovery pressure after prolonged drawdowns independent of raw momentum."
  },
  "dependencies": [
    "close",
    "mom_120d_skip5"
  ],
  "parameters": {
    "lookback": 120,
    "min_periods": 60,
    "transform": "log1p"
  },
  "expected_direction": "negative",
