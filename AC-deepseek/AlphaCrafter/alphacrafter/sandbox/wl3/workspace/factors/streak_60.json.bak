{
  "factor_id": "streak_60",
  "factor_name": "Max net run-streak 60d (up-streak persistence)",
  "version": "1.0.0",
  "calculation": {
    "expression": "rolling_max(up_streak - down_streak, 60) / 60, where up_streak = #consecutive pct_change>0 days and down_streak = #consecutive pct_change<0 days",
    "description": "For each asset, track the length of the current consecutive up-day run minus the current consecutive down-day run (net streak). Take the rolling 60-day maximum of this net streak and normalize by 60. Positive cross-sectional IC: assets that recently built a long positive run (persistent multi-day gains) tend to keep outperforming over the next 10 days -- run-persistence / continuation effect. Decorrelated from the library (max rho ~0.33 vs hilo_pos_60)."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "window": 60,
    "normalize": 60.0
  },
  "expected_direction": 1,
