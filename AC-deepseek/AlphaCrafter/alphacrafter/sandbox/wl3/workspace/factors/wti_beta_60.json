{
  "factor_id": "wti_beta_60",
  "factor_name": "WTI commodity beta 60d",
  "version": "1.0.0",
  "calculation": {
    "expression": "BETA(pct_change(close,1), pct_change(WTI close,1), 60)",
    "description": "Rolling 60d ordinary least-squares beta of each asset's daily returns on WTI crude daily returns. Assets co-moving with the oil/commodity cycle (positive WTI beta) tend to keep outperforming over the next 5-20d in this worldline: positive cross-sectional predictive power, monotone decay 1d 0.014 -> 20d 0.046. Low turnover (stable beta estimates) makes it a slow risk-on/commodity-cycle tilt."
  },
  "dependencies": [
    "close",
    "WTI close"
  ],
