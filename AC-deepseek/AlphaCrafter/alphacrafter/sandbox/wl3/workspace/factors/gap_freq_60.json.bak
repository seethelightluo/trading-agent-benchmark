{
  "factor_id": "gap_freq_60",
  "factor_name": "frequency of |overnight gap| > 1% over 60d (gap risk)",
  "version": "1.0.0",
  "calculation": {
    "expression": "mean(|open/close_prev - 1| > 0.01) over trailing 60d",
    "description": "frequency of |overnight gap| > 1% over 60d (gap risk)"
  },
