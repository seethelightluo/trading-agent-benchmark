{
  "factor_id": "sign_persist_20",
  "factor_name": "Sign Persistence 20d",
  "version": "1.0.0",
  "calculation": {
    "expression": "rolling_mean( sign(r_t)==sign(r_{t-1}) , 20 ) where r_t = close/close_{t-1}-1",
    "description": "Fraction of the trailing 20 days in which the sign of the daily return equals the sign of the previous day's return. Measures short-horizon return sign persistence / trendiness (positive serial dependence). High values -> assets whose daily moves keep the same direction; low values -> choppy mean-reverting assets. Cross-sectionally, persistent-trend assets have higher forward 10d returns in this worldline."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "window": 20,
    "min_valid_days": 8
  },
  "expected_direction": 1,
