  "version": "1.0.0",
  "calculation": {
    "expression": "rolling_beta(asset_daily_ret, ew_ret(XAU,COPPER,WTI), 60)",
    "description": "60-day rolling regression beta of each asset daily return on the equal-weight commodity basket (XAU/COPPER/WTI) return. Assets positively exposed to the broad commodity complex tend to outperform; acts as an inflation/real-asset regime tilt."
