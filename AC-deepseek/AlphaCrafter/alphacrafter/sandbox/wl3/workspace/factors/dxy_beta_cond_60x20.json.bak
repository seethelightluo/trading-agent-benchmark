{
  "factor_id": "dxy_beta_cond_60x20",
  "factor_name": "DXY beta conditional 60x20",
  "version": "1.0.0",
  "calculation": {
    "expression": "beta(asset_ret, DXY_ret, 60) * (DXY/ DXY.shift(20) - 1)",
    "description": "Asset sensitivity to USD (60d rolling beta to DXY) interacted with the 20d DXY move. Assets with high positive DXY beta tend to outperform when the dollar strengthens over the prior month; the conditional interaction captures cross-asset dollar-regime tilts. Positive IC -> direction +1."
  },
  "dependencies": [
    "close",
    "DXY_close"
  ],
  "parameters": {
    "beta_window": 60,
    "dxy_lookback": 20
  },
  "expected_direction": 1,
