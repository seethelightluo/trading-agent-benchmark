{
  "factor_id": "hilo_pos_60",
  "factor_name": "60-day range position (stochastic oscillator)",
  "version": "1.0.0",
  "calculation": {
    "expression": "(close - rolling_min(low,60)) / (rolling_max(high,60) - rolling_min(low,60))",
    "description": "Where today's close sits inside the trailing 60-day high-low range, normalized to [0,1]. Values near 1 mean the asset closes near its 60-day range high (intermediate-term uptrend); near 0 means range low. Positive cross-sectional predictive power at 10-20d horizon (continuation of intermediate trend regime), weaker than the 20d variant but with lower turnover and lower correlation to the short momentum library factor.",
    "python": "def hilo_pos_60(df, s):\n    hi = df['high'].rolling(60).max()\n    lo = df['low'].rolling(60).min()\n    return (df['close'] - lo) / (hi - lo)"
  },
  "dependencies": [
    "close",
    "high",
    "low"
  ],
  "parameters": {
    "window": 60
  },
  "expected_direction": 1,
