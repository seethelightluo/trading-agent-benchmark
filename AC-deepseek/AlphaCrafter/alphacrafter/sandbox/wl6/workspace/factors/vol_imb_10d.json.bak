{
 "factor_id": "vol_imb_10d",
 "factor_name": "10d up/down volume imbalance",
 "version": "1.0.0",
 "calculation": {
  "expression": "(sum(vol*I(ret>0),10) - sum(vol*I(ret<=0),10)) / sum(vol,10)",
  "description": "Volume-weighted buying pressure over 10 days: fraction of volume on up days minus fraction on down days. Faster flow proxy than vol_imb_20d; recent sub-windows monotonically improving (2026+ IC 0.1208 / ICIR 0.3523)."
 },
