{
  "factor_id": "beta_vix_60d_neg",
  "factor_name": "Negative 60d beta to VIX (defensive resilience)",
  "version": "1.0.0",
  "calculation": {
    "expression": "-cov(ret, vix_ret, 60) / var(vix_ret, 60)",
    "description": "Negative of 60-day rolling beta of each asset's daily return to VIX daily return. High values = assets that fall (or rise) when VIX falls, i.e. defensive/low-risk-off beta. Positive IC means defensive assets outperform over 10d horizon."
  },
  "dependencies": [
    "close",
    "VIX_close"
  ],
  "parameters": {
    "win": 60,
    "min_periods": 30
  },
  "expected_direction": 1,
