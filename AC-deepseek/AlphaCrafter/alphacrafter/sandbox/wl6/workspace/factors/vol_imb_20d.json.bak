{
  "factor_id": "vol_imb_20d",
  "factor_name": "20d up/down volume imbalance",
  "version": "1.0.0",
  "calculation": {
    "expression": "(sum(vol*I(ret>0),20) - sum(vol*I(ret<=0),20)) / sum(vol,20)",
    "description": "Volume-weighted buying pressure over 20 days: fraction of volume on up days minus fraction on down days. High values = persistent accumulation (flow proxy)."
  },
