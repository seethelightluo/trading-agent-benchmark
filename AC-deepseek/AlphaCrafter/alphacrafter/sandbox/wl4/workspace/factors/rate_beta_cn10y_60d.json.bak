{
  "factor_id": "rate_beta_cn10y_60d",
  "factor_name": "CN10Y rate beta 60d",
  "version": "1.0.0",
  "calculation": {
    "expression": "beta(asset_ret, pct_change(CN10Y), 60)",
    "description": "Rolling 60-day regression beta of each asset's daily return on the CN10Y yield change. High (less negative) beta = asset co-moves with China rates; negative IC means assets with lower CN10Y-beta (more defensive to China rate shocks) earn higher forward 10d returns."
  },
  "dependencies": [
    "close",
    "CN10Y"
  ],
  "parameters": {
    "beta_win": 60,
    "min_obs": 40
  },
  "expected_direction": -1,
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01..2026-07-29",
    "last_validated": "2026-07-30",
    "admission_horizon": 10,
    "regime_notes": "Validated 2020-01-01..2026-07-29 across multiple regimes: COVID crash 2020, recovery bull 2020-21, 2022 tightening bear, 2023-24 AI-led equity rally, 2024-26 crypto/commodity cycles. Cross-sectional rank IC on the 15-asset tradable universe, h=10.",
    "metrics": {
      "ic": -0.052,
      "icir": -0.1543,
      "ic_hit_ratio": 0.56,
      "n_ic_dates": 579,
      "ic_std": 0.3373,
