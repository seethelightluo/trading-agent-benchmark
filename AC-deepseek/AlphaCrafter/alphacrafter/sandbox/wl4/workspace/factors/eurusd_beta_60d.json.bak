{
  "factor_id": "eurusd_beta_60d",
  "factor_name": "EURUSD beta 60d",
  "version": "1.0.0",
  "calculation": {
    "expression": "beta(asset_ret, pct_change(EURUSD), 60)",
    "description": "Rolling 60-day regression beta of each asset's daily return on EURUSD changes (proxy for global risk-appetite / dollar weakness). Negative IC: assets with lower EURUSD-beta earn higher forward 10d returns."
  },
  "dependencies": [
    "close",
    "EURUSD"
  ],
  "parameters": {
    "beta_win": 60,
    "min_obs": 40
  },
  "expected_direction": -1,
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01..2026-07-29",
    "last_validated": "2026-07-30",
    "admission_horizon": 10,
    "regime_notes": "Validated 2020-01-01..2026-07-29 across multiple regimes: COVID crash 2020, recovery bull 2020-21, 2022 tightening bear, 2023-24 AI-led equity rally, 2024-26 crypto/commodity cycles. Cross-sectional rank IC on the 15-asset tradable universe, h=10.",
