{
 "factor_id": "mom_vol_scaled_20x10",
 "factor_name": "Volatility-scaled momentum 20x10 (quality momentum)",
 "version": "1.0.0",
 "calculation": {
  "expression": "mom / vol, mom = close.shift(10)/close.shift(30) - 1; vol = std(pct_change, 20)",
  "description": "20d momentum (with 10d skip to avoid short-term reversal) scaled by inverse 20d volatility. Combines trend-following with a quality tilt: assets that rise persistently and calmly (low vol) are favored. Positive IC at 10d horizon; strongest in 2025-26 regime."
 },
 "dependencies": [
  "close"
 ],
