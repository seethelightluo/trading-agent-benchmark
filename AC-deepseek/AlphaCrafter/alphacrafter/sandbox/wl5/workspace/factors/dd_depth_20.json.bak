{
 "factor_id": "dd_depth_20",
 "factor_name": "20-day Drawdown Depth (vs rolling high)",
 "version": "1.0.0",
 "calculation": {
  "expression": "(close - rolling_max(close,20)) / rolling_max(close,20), min_periods=10",
  "description": "Current drawdown depth relative to the trailing 20-session high (min_periods=10); 0 = at highs, negative = below the 20d high. High values (near highs, shallow drawdown) outperform over the next 10 days: shallow-drawdown / fresh-high assets continue to lead. Complementary to time_under_water_120 (duration) with a shorter 20d depth horizon. Computed on the 15-asset tradable cross-asset universe; direction +1."
 },
 "dependencies": [
  "close"
 ],
 "parameters": {
  "window": 20,
  "min_periods": 10,
  "admission_horizon": 10
 },
 "expected_direction": 1,
