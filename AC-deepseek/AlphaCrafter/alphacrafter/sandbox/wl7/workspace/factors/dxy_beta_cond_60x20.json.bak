  "version": "1.0.0",
  "calculation": {
    "expression": "-beta(asset_ret, DXY_ret, 60) * (DXY/DXY.shift(20)-1)",
    "description": "Conditional USD-risk signal: asset beta to the dollar times the 20-day DXY move, sign-flipped. Direction -1 => after USD strength, assets positively linked to the dollar outperform (USD-spillover momentum). Positive IC in 2021-2026, negative 2020."
  },
