{
  "factor_id": "btc_lead_20",
  "factor_name": "BTC-lead beta 60x20",
  "version": "1.0.0",
  "calculation": {
    "expression": "beta(asset_ret, BTC_ret, 60) * (BTC/BTC.shift(20) - 1.0)",
    "description": "Crypto-lead cross-asset signal: asset beta to BTC changes times the 20-day BTC move. Captures crypto-driven risk appetite spilling into equities/commodities. Direction set by h10 rank-IC sign (flip applied if negative)."
  },
  "dependencies": [
    "close",
    "BTC"
  ],
