{
  "factor_id": "mom30_vol60",
  "factor_name": "Risk-adjusted momentum 30d/vol60",
  "version": "3.0.0",
  "calculation": {
    "expression": "(close.shift(5)/close.shift(35)-1.0) / close.pct_change().rolling(60, min_periods=15).std()",
    "description": "30-day momentum (skip 5) scaled by 60-day realized vol; stable trend per unit risk."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "lookback": 30,
    "skip": 5,
    "vol_win": 60,
    "min_periods": 15
  },
  "expected_direction": 1,
