{
 "factor_id": "mom_curve_volscale",
 "factor_name": "Momentum curve vol-scaled",
 "version": "1.1.0",
 "calculation": {
  "expression": "((close.shift(5)/close.shift(25)-1.0) - (close.shift(5)/close.shift(65)-1.0)) / (1.0 + close.pct_change().rolling(20, min_periods=10).std())",
  "description": "Momentum curve steepness (20d vs 60d, skip5) scaled by 1/(1+20d realized vol): trend acceleration per unit risk."
 },
