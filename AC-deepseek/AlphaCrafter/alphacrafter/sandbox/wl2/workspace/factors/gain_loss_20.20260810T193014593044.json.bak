{
  "factor_id": "gain_loss_20",
  "factor_name": "20d Gain/Loss ratio",
  "version": "3.0.0",
  "calculation": {
    "expression": "close.pct_change().clip(lower=0).rolling(20, min_periods=10).mean() / (close.pct_change().clip(upper=0).rolling(20, min_periods=10).mean().abs() + 1e-9)",
    "description": "Ratio of mean positive daily return to mean |negative| daily return over 20d; skew/trend-quality of the return path."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "window": 20,
    "min_periods": 10
  },
  "expected_direction": 1,
  "validation": {
