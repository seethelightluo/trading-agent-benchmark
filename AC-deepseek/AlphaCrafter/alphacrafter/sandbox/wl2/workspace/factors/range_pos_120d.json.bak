{
 "factor_id": "range_pos_120d",
 "factor_name": "120d Range Position",
 "version": "1.1.0",
 "calculation": {
  "expression": "(close - close.rolling(120, min_periods=30).min()) / (close.rolling(120, min_periods=30).max() - close.rolling(120, min_periods=30).min() + 1e-9)",
  "description": "Position of close within its trailing 120-day high-low range (0=at low, 1=at high); trend/mean-reversion regime location."
 },
