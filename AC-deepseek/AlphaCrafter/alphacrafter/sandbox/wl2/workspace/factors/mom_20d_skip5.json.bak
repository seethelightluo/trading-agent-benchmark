{
  "factor_id": "mom_20d_skip5",
  "factor_name": "Momentum 20d (skip 5d)",
  "version": "2.0.0",
  "calculation": {
    "expression": "close.shift(5) / close.shift(25) - 1.0",
    "description": "20-day price momentum ending 5 days ago (return from t-25 to t-5), skipping the most recent week to avoid short-term reversal."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "lookback": 20,
    "skip": 5
  },
  "expected_direction": 1,
