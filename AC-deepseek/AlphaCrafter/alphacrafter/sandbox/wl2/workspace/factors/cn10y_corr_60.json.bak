 "factor_name": "CN10Y yield correlation 60d",
 "version": "1.0.0",
 "calculation": {
  "expression": "rolling_corr(daily_ret_asset, daily_ret_CN10Y, 60)",
  "description": "60d rolling correlation between asset daily returns and CN10Y yield daily changes. Assets positively co-moving with Chinese 10y yields behave like growth/risk proxies; negative IC means higher co-movement with CN10Y forecasts relative underperformance (yield-sensitive crowding). Negative cross-sectional predictor of forward 10d returns."
 },
