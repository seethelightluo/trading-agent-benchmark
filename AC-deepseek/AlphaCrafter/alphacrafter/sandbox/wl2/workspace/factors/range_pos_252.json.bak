{
  "factor_id": "range_pos_252",
  "factor_name": "252d Range Position",
  "version": "2.0.0",
  "calculation": {
    "expression": "(close - close.rolling(252, min_periods=30).min()) / (close.rolling(252, min_periods=30).max() - close.rolling(252, min_periods=30).min())",
    "description": "Position of close within its trailing 252-day high-low range (0=at low, 1=at high). Trend/mean-reversion regime location."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "window": 252,
    "min_periods": 30
  },
  "expected_direction": 1,
