              f"n_dates={r['n_dates']} n_obs={r['n_obs']}")
    print("  decay IC:", {k: round(v, 4) for k, v in dec.items()})
    return {"cov": cov, "turnover": to, "ic1": ic1, "ic5": ic5, "decay": dec}
