77:def coverage(factor_df, closes):
78:    n_total = 0
79:    n_valid = 0
80:    for s in closes:
81:        if s in factor_df.columns:
82:            n_valid += len(factor_df[s].dropna())
83:        n_total += len(closes[s])
84:    return n_valid / n_total if n_total else np.nan
