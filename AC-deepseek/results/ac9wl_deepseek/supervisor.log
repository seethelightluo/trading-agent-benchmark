131:def consec_up_ratio(win=20):
132:    def fn(sym, close, volume):
133:        r = (close.pct_change() > 0).astype(float)
134:        def run_len(x):
135:            x = x.values
136:            best_up = best_dn = cur_u = cur_d = 0
137:            for v in x:
138:                if v == 1:
139:                    cur_u += 1
140:                    cur_d = 0
141:                    best_up = max(best_up, cur_u)
142:                elif v == 0:
143:                    cur_d += 1
144:                    cur_u = 0
145:                    best_dn = max(best_dn, cur_d)
146:            s = best_up + best_dn
147:            return best_up / s if s > 0 else np.nan
148:        return r.rolling(win).apply(run_len, raw=False)
149:    return fn
