def build_returns(closes, fwd_days=1):
    """Forward return (log or simple) over fwd_days, aligned to symbol frames."""
    fwd = {}
    for s, df in closes.items():
        ret = df["close"].shift(-fwd_days) / df["close"] - 1.0
        fwd[s] = ret
    return pd.DataFrame(fwd)


