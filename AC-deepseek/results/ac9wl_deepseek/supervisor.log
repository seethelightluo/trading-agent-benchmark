ion ---\ndisp20 = rets.std(axis=1).rolling(20).mean()\nprint("\\nAvg pairwise corr (60d):", round(rets.tail(60).corr().values[np.triu_indices(15,1)].mean(),3))\nprint("CS daily dispersion (20d avg):", round(disp20.iloc[-1]*100,2), "%")\nprint("EW portfolio 20d:", round((aligned.pct_change().mean(axis=1).tail(20).add(1).prod()-1)*100,2), "%")\nprint("EW portfolio 120d:", round((aligned.pct_change().mean(axis=1).tail(120).add(1).prod()-1)*100,2), "%")\nEOF'})
