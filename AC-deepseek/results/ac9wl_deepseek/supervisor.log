    "ma60_120_slope": ma_slope(60, 120),
    "close_vs_ma60": lambda df: df["close"] / df["close"].rolling(60).mean() - 1.0,
    "close_vs_ma120": lambda df: df["close"] / df["close"].rolling(120).mean() - 1.0,
