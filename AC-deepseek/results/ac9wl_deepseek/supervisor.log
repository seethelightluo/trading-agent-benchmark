def ma_slope(n, m):
    def f(df):
        c = df["close"]
        return (c.rolling(n).mean() / c.rolling(m).mean()) - 1.0
    return f

def dist_high(nd):
    def f(df):
        return df["close"] / df["close"].rolling(nd).max() - 1.0
    return f

def dist_low(nd):
    def f(df):
        return df["close"] / df["close"].rolling(nd).min() - 1.0
    return f

def norm_ma_trend(n, m):
    def f(df):
        c = df["close"]
        ma_diff = c.rolling(n).mean() - c.rolling(m).mean()
        sd = c.rolling(n).std()
        return ma_diff / sd
    return f

