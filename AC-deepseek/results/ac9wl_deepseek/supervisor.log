def run(name, panel):
    panel = panel.reindex(idx)
    cov = panel.notna().sum().sum() / (len(idx) * panel.shape[1])
    to = F.turnover10(panel)
    ic1 = F.fast_ic(panel, fwd1)
    ic5 = F.fast_ic(panel, fwd5)
