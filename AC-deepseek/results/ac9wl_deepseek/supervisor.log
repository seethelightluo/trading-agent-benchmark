          f'cov_asset={cov_assets:.3f} cov_dates8={cov_dates8:.3f} turn={turn:.3f} '
          f'decay={decays[label]}')

# pairwise rank corr -> max_abs_library_correlation in persistence order
ranks = {l: f.rank(axis=1) for l, f in frames.items()}
