22:    R = fwd_df.reindex(idx).astype(float)
23:    if rank:
24:        F = F.rank(axis=1)
25:        R = R.rank(axis=1)
26:    Fv = F.values
27:    Rv = R.values
28:    mask = np.isfinite(Fv) & np.isfinite(Rv)
29:    n = mask.sum(axis=1)
30:    ok = n >= min_names
31:    if not ok.any():
32:        return {"n_dates": 0, "n_obs": 0, "ic": np.nan, "icir": np.nan,
