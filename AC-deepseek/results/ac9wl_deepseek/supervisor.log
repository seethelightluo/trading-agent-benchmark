14:
15:def load_close(which=SYMBOLS, dir_=DATA_DIR):
16:    out = {}
17:    for s in which:
18:        d = pd.read_csv(os.path.join(dir_, f"{s}.csv"))
19:        d["date"] = pd.to_datetime(d["date"])
20:        d = d[d["date"] <= CUT].sort_values("date").set_index("date")
21:        for col in ["close", "open", "high", "low", "volume"]:
22:            d[col] = pd.to_numeric(d[col], errors="coerce")
23:        out[s] = d
24:    return out
25:
26:
27:def build_returns(closes, fwd_days=1):
28:    """Forward return (log or simple) over fwd_days, aligned to symbol frames."""
29:    fwd = {}
30:    for s, df in closes.items():
31:        ret = df["close"].shift(-fwd_days) / df["close"] - 1.0
32:        fwd[s] = ret
33:    return pd.DataFrame(fwd)
34:
35:
36:def factor_panel(closes, factor_fn):
37:    """factor_fn(df) -> Series of factor values indexed by date. Returns DataFrame dates x symbols."""
38:    cols = {}
39:    for s, df in closes.items():
40:        try:
41:            fv = factor_fn(df)
42:            if fv is not None and len(fv):
43:                cols[s] = fv
44:        except Exception as e:
45:            print(f"  [warn] {s}: {e}")
46:    return pd.DataFrame(cols)
47:
48:
49:def ic_analysis(factor_df, closes, fwd_days=1, min_names=8, rank=True):
50:    """Daily cross-sectional IC between factor and forward return."""
51:    fwd = build_returns(closes, fwd_days)
52:    dates = factor_df.index.intersection(fwd.index)
53:    ics = []
54:    obs = []
55:    for dt in dates:
56:        f = factor_df.loc[dt].dropna()
57:        r = fwd.loc[dt].reindex(f.index).dropna()
58:        common = f.index.intersection(r.index)
59:        if len(common) < min_names:
60:            continue
61:        x = f[common].astype(float)
62:        y = r[common].astype(float)
63:        if rank:
64:            x = x.rank()
65:            y = y.rank()
66:        if x.std() == 0 or y.std() == 0:
67:            continue
68:        ic = np.corrcoef(x, y)[0, 1]
69:        if np.isfinite(ic):
70:            ics.append(ic)
71:            obs.append(len(common))
72:    ics = np.array(ics)
73:    obs = np.array(obs)
74:    if len(ics) == 0:
75:        return {"n_dates": 0, "n_obs": 0, "ic": np.nan, "icir": np.nan,
76:                "hit": np.nan, "ic_std": np.nan}
77:    return {"n_dates": int(len(ics)), "n_obs": int(obs.sum()),
78:            "ic": float(ics.mean()), "icir": float(ics.mean() / ics.std()) if ics.std() > 0 else np.nan,
79:            "hit": float((ics > 0).mean()), "ic_std": float(ics.std())}
80:
81:
82:def decay_analysis(factor_df, closes, horizons=(1, 2, 3, 5, 10, 20, 30), min_names=8):
83:    out = {}
84:    for h in horizons:
85:        r = ic_analysis(factor_df, closes, fwd_days=h, min_names=min_names)
86:        out[h] = r["ic"]
87:    return out
88:
89:
90:def coverage(factor_df, closes):
91:    n_total = 0
92:    n_valid = 0
93:    for s in closes:
94:        if s in factor_df.columns:
95:            v = factor_df[s].dropna()
96:            n_valid += len(v)
97:        n_total += len(closes[s])
98:    return n_valid / n_total if n_total else np.nan
99:
100:
101:def turnover(factor_df, rebal=10):
102:    """Mean fraction of symbols whose cross-sectional decile/rank direction flips or rank change."""
103:    ranks = factor_df.rank(axis=1)
104:    chg = []
105:    for i in range(rebal, len(ranks)):
106:        prev = ranks.iloc[i - rebal].dropna()
107:        cur = ranks.iloc[i].dropna()
108:        common = prev.index.intersection(cur.index)
109:        if len(common) < 2:
110:            continue
111:        # normalized rank change (0..1), 1 means full flip
112:        c = (cur[common] - prev[common]).abs() / (len(common) - 1)
113:        chg.append(c.mean())
114:    return float(np.mean(chg)) if chg else np.nan
115:
