  ▶️ write_file({'file_path': 'scripts/trader1_20260716_design.py', 'content': '"""Trader design sweep: offline cross-sectional ensemble simulation (warm-up data only).\n\nReproduces screener factor definitions, then sweeps weighting schemes / risk\noverlays on the 15-asset long-only fully-invested portfolio with 3bps costs.\nAll decisions use data visible through the previous completed trading day.\n"""\nimport json, os, itertools\nimport numpy as np\nimport pandas as pd\n\nASSETS = ["000300.SH","SPX","HSI","N225","SX5E","000688.SH","SOX","NDX","XAU",\n          "COPPER","WTI","BTC","ETH","US10Y","CN10Y"]\nDATA = "../persistent/stock_data"\nIDX = "../persistent/index_data"\nCAL = [pd.Timestamp(d) for d in json.load(open("../persistent/date.json"))["trading_days"]]\nCAL = pd.DatetimeIndex(CAL)\nREF_IDX = int(np.where(CAL == pd.Timestamp("2026-07-16"))[0][0])  # 2388\n\ndef load(sym, folder=DATA):\n    df = pd.read_csv(os.path.join(folder, sym + ".csv"), parse_dates=[0])\n    df.columns = [c.strip() for c in df.columns]\n    dcol = [c for c in df.columns if c.lower() in ("date", "datetime")][0]\n    df = df.set_index(pd.to_datetime(df[dcol])).sort_index()\n    ccol = [c for c in df.columns if c.lower() == "close"][0]\n    return df[ccol]\n\n# ---- aligned panels (trading-day calendar) ----\nclose = pd.DataFrame({s: load(s).reindex(CAL) for s in ASSETS})\nvix = load("VIX", IDX).reindex(CAL)\n# trim to history visible at the live start (no lookahead beyond 2026-07-15)\nclose = close.loc[: "2026-07-15"]\nvix = vix.loc[: "2026-07-15"]\nrets = close.pct_change()\n\n# ---- raw factor panels (same as screener_validate) ----\nf_mom10  = close.shift(5) / close.shift(15) - 1.0\nf_mom120 = close.shift(5) / close.shift(125) - 1.0\nf_vov    = rets.rolling(20).std().rolling(60).std()\nvix_ret  = vix.pct_change()\nbeta60   = rets.rolling(60).cov(vix_ret) / vix_ret.rolling(60).var()\nvix_move = vix / vix.shift(20) - 1.0\nf_vixb   = -beta60.multiply(vix_move, axis=0)\n\nFACTORS = {\n    "mom_120d_skip5":      (f_mom120, 1, 0.486158),\n    "mom_10d_skip5":       (f_mom10,  1, 0.276633),\n    "vix_beta_cond_60x20": (f_vixb,  -1, 0.184054),\n    "vol_of_vol20x60":     (f_vov,    1, 0.053155),\n}\n\n# ---- decision dates: every 10 trading days anchored to live cadence (idx 2388) ----\ndecision_idx = [i for i in range(140, len(CAL)) if (i - REF_IDX) % 10 == 0 and CAL[i] <= pd.Timestamp("2026-07-15")]\ndecision_idx = [i for i in decision_idx if i - 1 >= 130]  # need visible data\nprint(f"decisions: {len(decision_idx)}  from {CAL[decision_idx[0]].date()} to {CAL[decision_idx[-1]].date()}")\n\ndef percentile_rank(s):\n    """cross-sectional percentile rank, NaN -> 0.5"""\n    out = pd.Series(0.5, index=s.index)\n    v = s.dropna()\n    if len(v) >= 8 and v.nunique() > 1:\n        out.loc[v.index] = v.rank(pct=True)\n    return out\n\ndef scores_at(i):\n    """composite score vector at decision i (visible through CAL[i-1])."""\n    row = CAL[i - 1]\n    sc = pd.Series(0.0, index=ASSETS)\n    n_ok = 0\n    for name, (panel, d, w) in FACTORS.items():\n        x = panel.loc[row].reindex(ASSETS)\n        if x.notna().sum() < 8:\n            continue\n        sc = sc + w * d * percentile_rank(x)\n        n_ok += 1\n    return sc, n_ok\n\ndef ew_trend(i):\n    """equal-weight market trend info visible through CAL[i-1]."""\n    row = CAL[i - 1]\n    m = close.reindex(ASSETS).mean(axis=1)\n    r20 = m.loc[row] / m.shift(20).loc[row] - 1\n    r60 = m.loc[row] / m.shift(60).loc[row] - 1\n    return r20, r60\n\ndef weights_from_scores(sc, temp, floor, cap):\n    s = sc - sc.mean()\n    e = np.exp(np.clip(s / temp, -10, 10))\n    w = e / e.sum()\n    w = (1 - floor) * w + floor / len(ASSETS)\n    # cap\n    if cap is not None:\n        for _ in range(60):\n            over = w[w > cap].sum() - cap * (w > cap).sum()\n            if over <= 1e-12:\n                break\n            w[w > cap] = cap\n            room = w[w < cap - 1e-12]\n            if len(room) == 0:\n                break\n            w.loc[room.index] += over * room / room.sum()\n    return w / w.sum()\n\ndef simulate(temp, floor, cap, overlay, min_move):\n    """run the 10-day cadence simulation. Returns (nav_series, per_rebalance_stats)."""\n    nav = 1.0\n    prev_w = None\n    navs, stats = [], []\n    dates = []\n    for i in decision_idx:\n        sc, n_ok = scores_at(i)\n        if n_ok < 8:\n            continue\n        w = weights_from_scores(sc, temp, floor, cap)\n        # regime overlay: adjust effective factor mix via score tilt\n        if overlay in ("defensive", "both"):\n            r20, r60 = ew_trend(i)\n            if r20 < 0:\n                # risk-off: tilt toward low-vix-beta (defensive) assets\n                vb = f_vixb.loc[CAL[i - 1]].reindex(ASSETS)\n                sc2 = sc - 0.12 * (vb - vb.mean()) / (vb.std() + 1e-12)\n                w = weights_from_scores(sc2, temp, floor, cap)\n        if overlay in ("momentum", "both"):\n            r20, r60 = ew_trend(i)\n            if r20 > 0 and r60 > 0:\n                pass  # momentum already dominant; keep base weights\n        # turnover / min-move skip\n        if prev_w is not None and min_move > 0:\n            if float((w - prev_w).abs().sum()) < min_move:\n                stats.append((dates[-1] if dates else CAL[i], 0.0, 0.0))\n                navs.append(nav)\n                dates.append(CAL[i])\n                continue\n        # hold 10 days: return from CAL[i] close to CAL[i+10] close\n        j2 = min(i + 10, len(CAL) - 1)\n        rets10 = close.loc[CAL[j2]].reindex(ASSETS) / close.loc[CAL[i]].reindex(ASSETS) - 1\n        r = float((w * rets10).sum())\n        cost = 0.0 if prev_w is None else 0.0003 * float((w - prev_w).abs().sum())\n        nav = nav * (1 + r) - cost * nav\n        navs.append(nav); dates.append(CAL[i])\n        stats.append((CAL[i], r, cost))\n        prev_w = w\n    navs = pd.Series(navs, index=pd.DatetimeIndex(dates))\n    return navs, stats\n\ndef metrics(navs, stats):\n    if len(navs) < 5:\n        return dict(ret=0, cagr=0, sharpe=0, mdd=0, to=0, cost=0)\n    daily = navs.pct_change().dropna()\n    yrs = (navs.index[-1] - navs.index[0]).days / 365.25\n    ret = navs.iloc[-1] / navs.iloc[0] - 1\n    cagr = (navs.iloc[-1] / navs.iloc[0]) ** (1 / yrs) - 1 if yrs > 0.5 else 0\n    sharpe = daily.mean() / daily.std() * np.sqrt(252) if daily.std() > 0 else 0\n    mdd = float((navs / navs.cummax() - 1).min())\n    to = np.mean([s[1] for s in stats])\n    cost = sum(s[2] for s in stats)\n    return dict(ret=ret, cagr=cagr, sharpe=sharpe, mdd=mdd, to=to, cost=cost)\n\nresults = []\nfor temp, floor, cap, overlay, min_move in itertools.product(\n        [0.5, 0.75, 1.0, 1.5], [0.0, 0.08], [0.25, None],\n        ["none", "defensive"], [0.0, 0.02]):\n    navs, stats = simulate(temp, floor, cap, overlay, min_move)\n    m = metrics(navs, stats)\n    results.append((temp, floor, cap, overlay, min_move, m["ret"], m["cagr"], m["sharpe"], m["mdd"], m["to"], m["cost"]))\n\ncols = ["temp","floor","cap","overlay","minmv","ret","cagr","sharpe","mdd","turnover","cost"]\nres = pd.DataFrame(results, columns=cols).sort_values("sharpe", ascending=False)\npd.set_option("display.width", 200)\nprint("\\n=== SWEEP (sorted by Sharpe) ===")\nprint(res.head(20).to_string(index=False))\n\n# best config detail\nbest = res.iloc[0]\nprint("\\n=== BEST CONFIG ===")\nprint(best.to_string())\n'})
