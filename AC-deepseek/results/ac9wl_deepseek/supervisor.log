64:def turnover10(factor_df, rebal=10):
65:    ranks = factor_df.rank(axis=1)
66:    chg = []
67:    for i in range(rebal, len(ranks)):
68:        prev = ranks.iloc[i - rebal].dropna()
69:        cur = ranks.iloc[i].dropna()
70:        common = prev.index.intersection(cur.index)
71:        if len(common) < 2:
72:            continue
73:        chg.append((cur[common] - prev[common]).abs().mean() / (len(common) - 1))
74:    return float(np.mean(chg)) if chg else np.nan
