15:def load_close(which=SYMBOLS, dir_=DATA_DIR):
16:    out = {}
17:    for s in which:
18:        d = pd.read_csv(os.path.join(dir_, f"{s}.csv"))
19:        d["date"] = pd.to_datetime(d["date"])
20:        d = d[d["date"] <= CUT].sort_values("date").set_index("date")
21:        for col in ["close", "open", "high", "low", "volume"]:
22:            d[col] = pd.to_numeric(d[col], errors="coerce")
23:        out[s] = d
24:    return out
