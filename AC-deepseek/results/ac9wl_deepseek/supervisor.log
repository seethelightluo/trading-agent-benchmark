quidity_20d": amihud(closes, vol_panel, 20),\n    "ret_autocorr_20d": autocorr(closes, 20),\n    "dxy_cond_60x20": roll_beta(closes, dxy, 60).mul((dxy/dxy.shift(20)-1.0).reindex(closes.index), axis=0),\n}\n\n# ---------- per-date cross-sectional Spearman corr between factor pairs ----------\ndef cs_corr(fa, fb):\n    idx = fa.index.intersection(fb.index)\n    corrs = []\n    for t in idx:\n        a, b = fa.loc[t], fb.loc[t]\n        m = a.notna() & b.notna() & np.isfinite(a) & np.isfinite(b)\n        if m.sum() >= 8:\n            c, _ = spearmanr(a[m], b[m])\n            if np.isfinite(c):\n                corrs.append(c)\n    return np.array(corrs)\n\nprint("=== max |library correlation| per candidate (per-date CS Spearman, then mean of |corr|, max over library) ===")\nreport = {}\nfor cn, cf in cands.items():\n    best_name, best_abs, best_mean = None, 0.0, 0.0\n    for ln, lf in lib.items():\n        c = cs_corr(cf, lf)\n        if len(c) == 0:\n            continue\n        mean_c = float(np.mean(c))\n        mean_abs = float(np.mean(np.abs(c)))\n        if mean_abs > best_abs:\n            best_abs = mean_abs\n            best_mean = mean_c\n            best_name = ln\n        print(f"  {cn} vs {ln}: mean_corr={mean_c:+.3f} mean_abs={mean_abs:.3f} n={len(c)}")\n    report[cn] = {"best_lib": best_name, "max_abs_library_correlation": round(best_abs, 4), "best_mean_corr": round(best_mean, 4)}\n    print(f"  >>> {cn}: max_abs_library_correlation = {best_abs:.4f} (vs {best_name})")\n\nprint()\nprint(json.dumps(report, indent=2))\nEOF'})
