    icir = mean_ic / std_ic if std_ic and std_ic > 0 else np.nan
    tstat = mean_ic / (std_ic / np.sqrt(len(ics))) if std_ic and std_ic > 0 else np.nan
    hit = float((ics > 0).mean()) if mean_ic >= 0 else float((ics < 0).mean())
