 68: def forward_returns(closes, grid, horizon):
 69:     """Forward h-day return per asset on native calendar, reindexed to grid."""
 70:     out = pd.DataFrame(index=grid)
 71:     for sym, s in closes.items():
 72:         fwd = s.shift(-horizon) / s - 1.0
 73:         out[sym] = fwd.reindex(grid)
 74:     return out
