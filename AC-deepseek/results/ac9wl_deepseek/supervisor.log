cands["volume_zscore_20"] = zscore(volume, 60)
cands["amihud_illiq_20"] = -(ret.abs() / volume).rolling(20).mean()
cands["volume_trend_5_20"] = volume.rolling(5).mean() / volume.rolling(20).mean() - 1

