c1[\'n_dates\']} | "\n              f"IC5={ic5[\'ic\']:+.4f} ICIR5={ic5[\'icir\']:+.3f} | IC10={ic10[\'ic\']:+.4f} | {\'PASS\' if passed else \'fail\'}")\n    return {"name": name, "cov": cov, "to": to, "ic_all": ic_all, "passed": passed}\n\n\nprint("=== Reversal family ===")\ncands = {}\nfor nd in (1, 2, 3, 5):\n    cands[f"rev_{nd}d"] = -np.log(CP / CP.shift(nd))\n# vol-neutral reversal (reversal scaled by realized vol): risk-scaled signal\nvol20 = RET.rolling(20).std()\nfor nd in (1, 2, 5):\n    cands[f"rev_{nd}d_volsac"] = -np.log(CP / CP.shift(nd)) / vol20\n\nres = [run(n, p) for n, p in cands.items()]\n\n# ---- deeper validation for rev_1d / rev_5d ----\nprint("\\n--- detailed validation: rev_1d ---")\npanel = cands["rev_1d"].reindex(idx)\nic_all = F.fast_ic_all(panel, fwd, horizons=(1, 2, 3, 5, 10, 20, 30))\nprint("decay IC:", {h: round(r["ic"], 4) for h, r in ic_all.items()})\nprint("decay ICIR:", {h: round(r["icir"], 3) for h, r in ic_all.items()})\n\n# year-wise IC1\nf1 = fwd[1]\nprint("\\nyear      IC1     ICIR1   hit    n_dates")\nfor yr in range(2021, 2027):\n    m = (idx >= pd.Timestamp(f"{yr}-01-01")) & (idx <= pd.Timestamp(f"{yr}-12-31")) if yr < 2026 else (idx >= pd.Timestamp("2026-01-01"))\n    s = panel.loc[idx[m]]\n    r = F.fast_ic(s, f1.loc[idx[m]])\n    if r["n_dates"]:\n        print(f"{yr}  {r[\'ic\']:+.4f}  {r[\'icir\']:+.3f}  {r[\'hit\']:.3f}  {r[\'n_dates\']}")\n\n# VIX regime split for rev_1d\nprint("\\n--- VIX regime split (rev_1d) ---")\nvix_raw = pd.read_csv("../persistent/index_data/VIX.csv")\nvix_raw["date"] = pd.to_datetime(vix_raw["date"])\nvix = vix_raw.set_index("date")["close"].reindex(idx)\nmed = vix.median()\nfor label, m in [("lowVIX<med", vix < med), ("highVIX>=med", vix >= med)]:\n    r = F.fast_ic(panel.loc[idx[m]], f1.loc[idx[m]])\n    print(f"{label:14s} IC1={r[\'ic\']:+.4f} ICIR1={r[\'icir\']:+.3f} n={r[\'n_dates\']}")\n\nprint(f"\\nreversal family done in {time.time()-t0:.1f}s | {sum(r[\'passed\'] for r in results)} passed gate")'})
