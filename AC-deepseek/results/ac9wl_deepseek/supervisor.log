216:def max_lib_corr(fac, libs):
217:    best = (0.0, None)
218:    for l, lf in libs.items():
219:        common = fac.index.intersection(lf.index)
220:        F = fac.loc[common].values
221:        L = lf.loc[common].values
222:        cs = []
223:        for i in range(len(common)):
224:            f, g = F[i], L[i]
225:            m = np.isfinite(f) & np.isfinite(g)
226:            if m.sum() < MIN_VALID:
227:                continue
228:            fv = pd.Series(f[m]).rank().values
229:            gv = pd.Series(g[m]).rank().values
230:            fv = fv - fv.mean(); gv = gv - gv.mean()
231:            denom = np.sqrt((fv * fv).sum() * (gv * gv).sum())
232:            if denom == 0 or not np.isfinite(denom):
233:                continue
234:            cs.append(float((fv * gv).sum() / denom))
235:        v = float(np.mean(cs)) if cs else np.nan
236:        if np.isfinite(v) and abs(v) > abs(best[0]):
237:            best = (v, l)
238:    return best
