                "watch_list": []
            }
        
        with open(file_path, 'r', encoding='utf-8') as f:
            return json.load(f)
    
    def _write_account_file(self, data: Dict[str, any], file_path: str) -> None:
        """Write account data to file."""
        Path(file_path).parent.mkdir(parents=True, exist_ok=True)
        
