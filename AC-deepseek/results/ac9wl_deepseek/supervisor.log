# 1) beta to global equity (EW) and to SPX
for win in (20, 60, 120):
    panels[f"beta_ew_{win}"] = roll_beta_panel(EW, win)
    panels[f"beta_spx_{win}"] = roll_beta_panel(SPXR, win)

