                 m5["abs_mean_ic"], m5["icir"], admission_gate(ic1)))

print("\n=== SUMMARY sorted by |IC1|*|ICIR1| ===")
rows.sort(key=lambda r: r[1] * abs(r[2]), reverse=True)
