    ic1 = fast_ic(panel, fwd1)
    ic5 = fast_ic(panel, fwd5)
    ic10 = fast_ic(panel, fwd10)
    passed = (abs(ic1["ic"]) >= 0.0070) and (abs(ic1["icir"]) >= 0.0840)
