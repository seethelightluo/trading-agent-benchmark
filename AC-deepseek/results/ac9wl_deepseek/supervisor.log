 77: def daily_ic(factor_frame, ret_frame, min_valid=8, method='spearman'):
 78:     """Cross-sectional IC per date."""
 79:     idx = factor_frame.index.intersection(ret_frame.index)
 80:     ics = []
 81:     for d in idx:
 82:         f = factor_frame.loc[d]
 83:         r = ret_frame.loc[d]
 84:         mask = f.notna() & r.notna()
 85:         n = int(mask.sum())
 86:         if n < min_valid:
 87:             continue
 88:         fv, rv = f[mask].astype(float), r[mask].astype(float)
 89:         if fv.nunique() < 2 or rv.nunique() < 2:
 90:             continue
 91:         if method == 'spearman':
 92:             ic = fv.rank().corr(rv.rank())
 93:         else:
 94:             ic = fv.corr(rv)
 95:         if np.isfinite(ic):
 96:             ics.append((d, ic, n))
 97:     return pd.DataFrame(ics, columns=['date', 'ic', 'n']).set_index('date')
