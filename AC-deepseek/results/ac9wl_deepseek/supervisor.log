        nav = nav * (1 + r) - cost * nav
        navs.append(nav); dates.append(CAL[i]); stats.append((CAL[i], r, cost, turnover))
        prev_w = w
    return pd.Series(navs, index=pd.DatetimeIndex(dates)), stats

