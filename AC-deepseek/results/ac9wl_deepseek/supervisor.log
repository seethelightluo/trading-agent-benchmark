 40: def build_panel():
 41:     """Return dict of per-asset DataFrames (close/volume on native calendars) and union grid."""
 42:     closes, volumes = {}, {}
 43:     for sym in WATCH:
 44:         df = _fetch(sym)
 45:         if df is None:
 46:             continue
 47:         closes[sym] = df['close'].astype(float)
 48:         if 'volume' in df.columns:
 49:             volumes[sym] = df['volume'].astype(float)
 50:     macro = load_macro()
