1:"""Shared helpers for miner_1 factor research."""
2:import os
3:import numpy as np
4:import pandas as pd
5:
6:CUT = pd.Timestamp("2026-07-15")
7:START = pd.Timestamp("2020-01-01")
8:SYMBOLS = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX",
9:           "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
10:MACRO = ["DXY", "USDCNY", "USDJPY", "EURUSD", "VIX"]
11:DATA_DIR = "../persistent/stock_data"
12:IDX_DIR = "../persistent/index_data"
