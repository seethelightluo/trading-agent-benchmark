49:def ic_analysis(factor_df, closes, fwd_days=1, min_names=8, rank=True):
50:    """Daily cross-sectional IC between factor and forward return."""
51:    fwd = build_returns(closes, fwd_days)
52:    dates = factor_df.index.intersection(fwd.index)
53:    ics = []
54:    obs = []
55:    for dt in dates:
56:        f = factor_df.loc[dt].dropna()
57:        r = fwd.loc[dt].reindex(f.index).dropna()
58:        common = f.index.intersection(r.index)
59:        if len(common) < min_names:
60:            continue
61:        x = f[common].astype(float)
62:        y = r[common].astype(float)
63:        if rank:
64:            x = x.rank()
65:            y = y.rank()
66:        if x.std() == 0 or y.std() == 0:
67:            continue
68:        ic = np.corrcoef(x, y)[0, 1]
69:        if np.isfinite(ic):
70:            ics.append(ic)
71:            obs.append(len(common))
72:    ics = np.array(ics)
73:    obs = np.array(obs)
74:    if len(ics) == 0:
75:        return {"n_dates": 0, "n_obs": 0, "ic": np.nan, "icir": np.nan,
76:                "hit": np.nan, "ic_std": np.nan}
77:    return {"n_dates": int(len(ics)), "n_obs": int(obs.sum()),
78:            "ic": float(ics.mean()), "icir": float(ics.mean() / ics.std()) if ics.std() > 0 else np.nan,
79:            "hit": float((ics > 0).mean()), "ic_std": float(ics.std())}
80:
81:
82:def decay_analysis(factor_df, closes, horizons=(1, 2, 3, 5, 10, 20, 30), min_names=8):
83:    out = {}
84:    for h in horizons:
85:        r = ic_analysis(factor_df, closes, fwd_days=h, min_names=min_names)
86:        out[h] = r["ic"]
87:    return out
