    df = pd.read_csv(os.path.join(INDEX_DIR, f"{symbol}.csv"))
    df["date"] = pd.to_datetime(df["date"])
    df = df[df["date"] <= pd.Timestamp(end)].reset_index(drop=True)
    return df


