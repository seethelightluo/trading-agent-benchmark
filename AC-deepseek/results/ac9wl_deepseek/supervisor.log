def dist_low(nd):
    return CP / CP.rolling(nd).min() - 1.0


def norm_ma_trend(n, m):
    return ((CP.rolling(n).mean() - CP.rolling(m).mean()) / CP.rolling(m).std())


def ma_slope(n, m):
    return CP.rolling(n).mean() / CP.rolling(m).mean() - 1.0


