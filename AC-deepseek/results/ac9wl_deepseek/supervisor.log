50:def macro_beta_cond(macro_key, sign=1.0, win=60, mom=20, use_diff=False):
51:    def fn(sym, close, volume, panel=None):
52:        macro = panel['macro'].get(macro_key)
53:        if macro is None:
54:            macro = panel['closes'].get(macro_key)
55:        if macro is None:
56:            return None
57:        g = panel['grid']
58:        r_a = close.pct_change().reindex(g)
59:        if use_diff:
60:            r_m = macro.reindex(g).diff()
61:            mm = macro.reindex(g) - macro.shift(mom).reindex(g)
62:        else:
63:            r_m = macro.pct_change().reindex(g)
64:            mm = macro.reindex(g) / macro.shift(mom).reindex(g) - 1.0
65:        cov = r_a.rolling(win, min_periods=30).cov(r_m)
66:        var = r_m.rolling(win, min_periods=30).var()
67:        beta = cov / var
68:        return (sign * beta * mm).replace([np.inf, -np.inf], np.nan)
69:    return fn
