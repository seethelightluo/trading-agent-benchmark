ard 10d return\n\ndef rank_ic(fac, fwd, mask=None):\n    ics = []\n    for dt in fac.index:\n        f = fac.loc[dt]; r = fwd.loc[dt]\n        ok = f.notna() & r.notna()\n        if ok.sum() >= 8:\n            ics.append((dt, f[ok].rank().corr(r[ok].rank())))\n    s = pd.Series(dict(ics))\n    return s\n\nprint("\\n=== Rank IC: full vs recent 250d (forward 10d) ===")\nfor k, fac in F.items():\n    ic_full = rank_ic(fac, fwd10)\n    ic_recent = ic_full[ic_full.index >= \'2025-07-01\']\n    print(f"{k:22s} full n={len(ic_full):4d} IC={ic_full.mean():+.4f} ICIR={ic_full.mean()/ic_full.std():+.3f} | recent250 n={len(ic_recent):4d} IC={ic_recent.mean():+.4f} ICIR={ic_recent.mean()/ic_recent.std():+.3f}")\n\n# pairwise correlation of factors (recent cross-sectional)\nprint("\\n=== Factor cross-sectional corr (last 60d, avg pairwise over dates) ===")\nfkeys = list(F.keys())\ncorrs = {k:{} for k in fkeys}\nfor dt in F[fkeys[0]].index[-60:]:\n    vals = {k: F[k].loc[dt] for k in fkeys}\n    ok = pd.DataFrame(vals).dropna()\n    if len(ok) >= 8:\n        c = ok.corr()\n        for i,a in enumerate(fkeys):\n            for b in fkeys[i+1:]:\n                corrs[a][b] = corrs[a].get(b,[]) + [c.loc[a,b]]\nfor a in fkeys:\n    for b in fkeys[fkeys.index(a)+1:]:\n        print(f"{a} vs {b}: {np.mean(corrs[a][b]):+.2f}")\nEOF'})
