                if np.isfinite(r):
                    cs.append(r)
        v = float(np.mean(cs)) if cs else np.nan
        corr.loc[a, b] = v
        corr.loc[b, a] = v
pd.set_option('display.width', 250)
print('\n=== PAIRWISE CROSS-SECTIONAL RANK CORR (mean over dates) ===')
print(corr.round(2))
corr.to_csv('scripts/screener_cycle17_corr_matrix.csv')
