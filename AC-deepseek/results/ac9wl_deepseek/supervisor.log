    print(f"{label:8s} IC1={r['ic']:+.4f} ICIR1={r['icir']:+.3f} n={r['n_dates']}")

print(f"\nreversal family done in {time.time()-t0:.1f}s | {sum(r['passed'] for r in res.values())} passed gate")

