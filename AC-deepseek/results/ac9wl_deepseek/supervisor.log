36:def factor_panel(closes, factor_fn):
37:    """factor_fn(df) -> Series of factor values indexed by date. Returns DataFrame dates x symbols."""
38:    cols = {}
39:    for s, df in closes.items():
40:        try:
41:            fv = factor_fn(df)
42:            if fv is not None and len(fv):
43:                cols[s] = fv
44:        except Exception as e:
45:            print(f"  [warn] {s}: {e}")
46:    return pd.DataFrame(cols)
47:
