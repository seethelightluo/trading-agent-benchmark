21:def ranks(values, assets):
22:    valid = sorted((float(v), a) for a, v in values.items() if v is not None and isfinite(float(v)))
23:    out = {a: .5 for a in assets}
24:    for i, (_, a) in enumerate(valid): out[a] = i / max(1, len(valid)-1)
25:    return out
