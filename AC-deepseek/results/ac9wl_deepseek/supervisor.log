    if len(f10) > 2:
        ranks = f10.rank(axis=1)
        tv = float(ranks.diff().abs().mean().mean())
    m = {"name": name, "h": h, "n_dates": len(ics), "mean_ic": mean_ic, "std_ic": std_ic,
