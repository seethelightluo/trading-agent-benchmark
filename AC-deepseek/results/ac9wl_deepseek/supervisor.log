def vix_beta_cond(sym, close, volume, panel):
    macro = panel['macro'].get('VIX')
    if macro is None:
        return None
    grid = panel['grid']
    r_a = close.pct_change().reindex(grid)
    r_m = macro.pct_change().reindex(grid)
