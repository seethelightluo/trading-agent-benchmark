27:def loading_contraction(y, x):
28:    z = pd.concat([y.rename("y"), x.rename("x")], axis=1).dropna().tail(60)
29:    def beta(n):
30:        q=z.tail(n); var=float(q.x.var())
31:        return float(q.y.cov(q.x)/var) if len(q)>=12 and var>1e-14 else None
32:    new, old = beta(20), beta(60)
33:    return old-new if new is not None and old is not None else None
