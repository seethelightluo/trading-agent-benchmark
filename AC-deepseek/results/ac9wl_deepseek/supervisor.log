    r = F.fast_ic_all(cands[nm].reindex(idx), closes, horizons=(1, 2, 3, 5, 10, 20, 30))
    print(f"{nm}: " + ", ".join(f"h{h} IC={v['ic']:+.4f} ICIR={v['icir']:+.3f}" for h, v in r.items()))

print("\nyear      IC1     ICIR1   hit    n_dates   (rev_1d)")
