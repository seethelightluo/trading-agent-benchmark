cands["rel_rev5_cs"] = -(r5.sub(r5.mean(axis=1), axis=0).div(r5.std(axis=1), axis=0))

# --- A11: volume-confirmed momentum: 20d momentum * (volume z) ---
vol = price_panel("volume")
volz = z(vol, 60)
cands["mom_vol_confirm_20"] = rmom20 * volz

