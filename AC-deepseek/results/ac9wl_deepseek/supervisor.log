78:def daily_ic(factor_frame, ret_frame, min_valid=8, method='spearman'):
79:    """Cross-sectional IC per date."""
80:    idx = factor_frame.index.intersection(ret_frame.index)
81:    ics = []
82:    for d in idx:
83:        f = factor_frame.loc[d]
84:        r = ret_frame.loc[d]
85:        mask = f.notna() & r.notna()
86:        n = int(mask.sum())
87:        if n < min_valid:
88:            continue
89:        fv, rv = f[mask].astype(float), r[mask].astype(float)
90:        if fv.nunique() < 2 or rv.nunique() < 2:
91:            continue
92:        if method == 'spearman':
93:            ic = fv.rank().corr(rv.rank())
94:        else:
95:            ic = fv.corr(rv)
96:        if np.isfinite(ic):
97:            ics.append((d, ic, n))
98:    return pd.DataFrame(ics, columns=['date', 'ic', 'n']).set_index('date')
