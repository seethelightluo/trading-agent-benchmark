accel_5_20\'] = mom5 - mom20\n\nrows = []\nfor name, f in factors.items():\n    res, to, tc, cov = evaluate_factor(f, panel, horizons=(5, 10, 20, 40))\n    r20 = res[20]\n    rows.append({\n        \'factor\': name,\n        \'ic5\': res[5][\'mean_ic\'] if res[5] else np.nan,\n        \'ic10\': res[10][\'mean_ic\'] if res[10] else np.nan,\n        \'ic20\': res[20][\'mean_ic\'] if res[20] else np.nan,\n        \'ic40\': res[40][\'mean_ic\'] if res[40] else np.nan,\n        \'icir20\': r20[\'icir\'] if r20 else np.nan,\n        \'hit20\': r20[\'hit_ratio\'] if r20 else np.nan,\n        \'n_dates20\': r20[\'n_dates\'] if r20 else 0,\n        \'turnover\': to,\n        \'coverage\': round(cov[\'coverage\'], 4),\n    })\n\ntbl = pd.DataFrame(rows).sort_values(\'ic20\', key=lambda s: s.abs(), ascending=False)\npd.set_option(\'display.width\', 200)\nprint(tbl.to_string(index=False))\n', 'file_path': 'scripts/miner2_20260716_screen_batch1.py'})
