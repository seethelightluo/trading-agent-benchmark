                 r["horizons"]["fwd5d"]["ic"], r["horizons"]["fwd10d"]["ic"], gate))
rows.sort(key=lambda x: abs(x[1]) * abs(x[2]), reverse=True)
print(f"\n{'factor':<24}{'IC1':>8}{'ICIR1':>8}{'hit1':>7}{'cov':>7}{'turn':>7}{'IC5':>8}{'IC10':>8}{'gate':>6}")
