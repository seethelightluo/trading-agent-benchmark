1:"""Miner3 exploration: overnight vs intraday return decomposition.
2:
3:Hypothesis: the split between the overnight gap (open vs prev close) and the
4:intraday session move (close vs open) encodes different information in a
5:cross-asset universe. Assets that persistently gap up overnight but fade
6:intraday may behave differently going forward. Classic equity anomaly: positive
7:overnight drift on average, but cross-sectionally the gap component can carry
8:reversal or momentum information depending on market regime.
9:
10:Constructs (all signal=rolling mean of the daily component):
11:  - on_nd: overnight gap (open/prev_close - 1) smoothed over nd
12:  - id_nd: intraday move (close/open - 1) smoothed over nd
13:  - on_id_ratio_nd: relative balance (overnight minus intraday) smoothed
14:Gates: |IC1|>=0.0070 and |ICIR1|>=0.0840 on 15-instrument universe.
15:Window: 2020-01-01..2026-07-15 warm-up.
16:"""
17:import sys, os, time
18:import numpy as np
19:import pandas as pd
20:
21:sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
22:from miner1_common import SYMBOLS, load_close
23:import miner3_fast as F
24:
25:t0 = time.time()
26:closes = load_close()
27:idx = None
28:for s, df in closes.items():
29:    idx = df.index if idx is None else idx.intersection(df.index)
30:idx = idx[(idx >= pd.Timestamp("2021-01-01"))]  # 1y warmup
31:OP = pd.DataFrame({s: closes[s]["open"].reindex(idx).astype(float) for s in SYMBOLS})
32:CP = pd.DataFrame({s: closes[s]["close"].reindex(idx).astype(float) for s in SYMBOLS})
33:print(f"loaded {len(idx)} common dates {idx.min().date()}..{idx.max().date()} ({time.time()-t0:.1f}s)")
34:
35:fwd = {h: F.fwd_returns(closes, h).reindex(idx) for h in (1, 2, 3, 5, 10, 20, 30)}
36:N_CELLS = len(idx) * len(SYMBOLS)
37:
38:
39:def run(name, panel, verbose=True):
40:    panel = panel.reindex(idx)
41:    cov = float(panel.notna().sum().sum()) / N_CELLS
42:    to = F.turnover10(panel)
43:    ic1 = F.fast_ic(panel, fwd[1])
44:    ic5 = F.fast_ic(panel, fwd[5])
45:    ic10 = F.fast_ic(panel, fwd[10])
46:    passed = (abs(ic1["ic"]) >= 0.0070) and (abs(ic1["icir"]) >= 0.0840)
47:    if verbose:
48:        print(f"{name:20s} cov={cov:.3f} to={to:.3f} | IC1={ic1['ic']:+.4f} ICIR1={ic1['icir']:+.3f} "
49:              f"hit1={ic1['hit']:.2f} n1={ic1['n_dates']} | IC5={ic5['ic']:+.4f} ICIR5={ic5['icir']:+.3f} "
50:              f"| IC10={ic10['ic']:+.4f} | {'PASS' if passed else 'fail'}")
51:    return {"name": name, "cov": cov, "to": to, "ic1": ic1, "ic5": ic5, "ic10": ic10, "passed": passed}
52:
53:
54:# daily components
55:on = OP / CP.shift(1) - 1.0   # overnight gap
56:id_ = CP / OP - 1.0           # intraday session move
57:tot = CP / CP.shift(1) - 1.0  # total
58:
59:cands = {}
60:for nd in (3, 5, 10, 20):
61:    cands[f"ong_mean_{nd}d"] = on.rolling(nd).mean()
62:    cands[f"id_mean_{nd}d"] = id_.rolling(nd).mean()
63:    cands[f"oni_diff_{nd}d"] = (on - id_).rolling(nd).mean()
64:    cands[f"oni_price_{nd}d"] = (on - tot).rolling(nd).mean()
65:
66:# overnight share of total magnitude (gap intensity)
67:for nd in (10, 20):
68:    cands[f"ong_share_{nd}d"] = (on.abs().rolling(nd).mean()) / (tot.abs().rolling(nd).mean() + 1e-12)
69:
70:res = {n: run(n, p) for n, p in cands.items()}
71:print(f"\n{sum(r['passed'] for r in res.values())} passed gate | {time.time()-t0:.1f}s")

