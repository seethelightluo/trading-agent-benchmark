    c = df['close']
    mom60 = c.shift(5) / c.shift(65) - 1.0
    mom120 = c.shift(5) / c.shift(125) - 1.0
    return mom60 - mom120


def range_pos_20(df, s):
    hi = df['high'].rolling(20).max()
    lo = df['low'].rolling(20).min()
    return (df['close'] - lo) / (hi - lo).replace(0, np.nan)


