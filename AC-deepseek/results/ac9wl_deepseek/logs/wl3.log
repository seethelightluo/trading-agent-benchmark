def rolling_beta(r_asset, r_ref, window):
    z = pd.concat([r_asset.rename('a'), r_ref.rename('b')], axis=1).dropna()
    b = z['a'].rolling(window).cov(z['b']) / z['b'].rolling(window).var().replace(0, np.nan)
    return b.reindex(z.index)


