87:def downside_vol_ratio_60(df, s):
88:    r = df['close'].pct_change()
89:    mu = r.rolling(60).mean()
90:    dd = r[r < mu] - mu[r < mu]
91:    semi = (dd ** 2).rolling(60).mean().pow(0.5)
92:    total = r.rolling(60).std()
93:    return semi / total
