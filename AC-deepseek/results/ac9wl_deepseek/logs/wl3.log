 218 def build_library_panels(prices):
 219     """Recompute the 4 currently-effective library factor signals (for correlation audit)."""
 220     vix = load_index('VIX', prices=prices)
 221     out = {}
 222     def f_mom10(df, s): return df['close'].shift(5) / df['close'].shift(15) - 1.0
 223     def f_mom120(df, s): return df['close'].shift(5) / df['close'].shift(125) - 1.0
 224     def f_vixbeta(df, s):
 225         if vix is None:
 226             return None
 227         r = df['close'].pct_change(); vr = vix['close'].pct_change()
 228         z = pd.concat([r.rename('r'), vr.rename('v')], axis=1).dropna()
 229         b = z['r'].rolling(60).cov(z['v']) / z['v'].rolling(60).var()
 230         return (-b * (vix['close'] / vix['close'].shift(20) - 1.0)).reindex(z.index)
 231     def f_vov(df, s): return df['close'].pct_change().rolling(20).std().rolling(60).std()
 232     out['mom_10d_skip5'] = factor_to_panel(f_mom10, prices)
 233     out['mom_120d_skip5'] = factor_to_panel(f_mom120, prices)
 234     out['vix_beta_cond_60x20'] = factor_to_panel(f_vixbeta, prices)
 235     out['vol_of_vol20x60'] = factor_to_panel(f_vov, prices)
 236     return out
