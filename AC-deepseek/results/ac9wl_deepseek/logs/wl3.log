82: def _beta_anchor(anchor_close):
83:     def f(df, s):
84:         a = anchor_close.reindex(df.index)
85:         r = df['close'].pct_change()
86:         z = pd.concat([r.rename('r'), a.rename('a')], axis=1).dropna()
87:         b = z['r'].rolling(60).cov(z['a']) / z['a'].rolling(60).var()
88:         return b.reindex(df.index)
89:     return f
