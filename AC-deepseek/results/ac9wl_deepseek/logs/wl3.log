40: def _beta_cond(anchor_close, sign=1.0):
41:     def f(df, s):
42:         a = anchor_close.reindex(df.index)
43:         r = df['close'].pct_change()
44:         z = pd.concat([r.rename('r'), a.rename('a')], axis=1).dropna()
45:         b = z['r'].rolling(60).cov(z['a']) / z['a'].rolling(60).var()
46:         mom = (anchor_close / anchor_close.shift(20) - 1.0).reindex(df.index)
47:         return (sign * b * mom).reindex(df.index)
48:     return f
