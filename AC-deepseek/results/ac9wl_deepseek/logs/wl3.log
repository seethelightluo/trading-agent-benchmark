 192 def max_library_correlation(factor_panel, library_panels):
 193     """Max absolute mean daily cross-sectional Spearman corr with library factors."""
 194     best = 0.0
 195     best_id = None
 196     common = factor_panel.index
 197     for fid, lp in library_panels.items():
 198         if lp is None or len(lp) == 0:
 199             continue
 200         idx = common.intersection(lp.index)
 201         corrs = []
 202         for d in idx:
 203             x = factor_panel.loc[d]
 204             y = lp.loc[d]
 205             m = x.notna() & y.notna() & np.isfinite(x) & np.isfinite(y)
 206             if m.sum() >= 8:
 207                 c = x[m].rank().corr(y[m].rank())
 208                 if np.isfinite(c):
 209                     corrs.append(c)
 210         if corrs:
 211             r = float(np.mean(corrs))
 212             if abs(r) > best:
 213                 best = abs(r)
 214                 best_id = fid
 215     return best, best_id
