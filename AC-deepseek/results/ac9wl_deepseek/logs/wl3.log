def amihud_trend_20_60(df, s):
    ret = df['close'].pct_change()
    vol = df['volume'].replace(0, np.nan)
    illiq = (ret.abs() / vol)
    a20 = illiq.rolling(20).mean()
    a60 = illiq.rolling(60).mean()
    return a20 / a60.replace(0, np.nan)


