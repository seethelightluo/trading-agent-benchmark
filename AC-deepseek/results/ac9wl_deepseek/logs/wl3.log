 104 def save_signal_artifact(panel, grid, path):
 105     """Persist factor signal matrix as .npy; returns the matrix."""
 106     arr = signal_matrix(panel, grid)
 107     path = Path(path)
 108     path.parent.mkdir(parents=True, exist_ok=True)
 109     np.save(path, arr)
 110     return arr
