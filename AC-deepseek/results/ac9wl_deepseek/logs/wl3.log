    for a in assets:
        if not np.isnan(r[a]):
            score[a] += w * d * r[a]
    print(f"{fid:26s} w={w:.4f} dir={d:+d} valid={n_valid}/15")

print("=" * 100)
print("COMPOSITE SCORE (higher=preferred):")
for a in sorted(assets, key=lambda x: -score[x]):
