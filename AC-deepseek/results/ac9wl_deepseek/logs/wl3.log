    best, best_id = 0.0, None
    for fid, la in lib.items():
        corrs = []
        for i in range(arr.shape[0]):
            x, y = arr[i], la[i]
            m = np.isfinite(x) & np.isfinite(y)
            if m.sum() >= 8:
