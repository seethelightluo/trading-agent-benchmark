            sig["dxy_beta_cond_60x20"][a] = (
                b * (dxy.iloc[-1] / dxy.iloc[-21] - 1.0) if b is not None else None)
        else:
            sig["dxy_beta_cond_60x20"][a] = None
        if r_vix is not None:
            b = beta_last(r, r_vix)
            sig["vix_beta_cond_60x20"][a] = (
