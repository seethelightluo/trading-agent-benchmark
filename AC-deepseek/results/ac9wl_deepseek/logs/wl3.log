mit\').statistic\n                rs.append(r)\n        corr_mat.loc[a,b] = np.nanmean(rs)\nprint("\\nMean cross-sectional spearman correlation (last 60 common dates):")\ncm = corr_mat.astype(float)\n# print pairs with |corr| > 0.5\npairs = []\nfor i in range(len(cols)):\n    for j in range(i+1, len(cols)):\n        v = cm.iloc[i,j]\n        if abs(v) > 0.5:\n            pairs.append((cols[i], cols[j], round(v,3)))\nprint("Pairs |corr|>0.5:", pairs if pairs else "none")\nprint("\\nFull corr matrix (rounded):")\nprint(cm.round(2).to_string())\nEOF'})
