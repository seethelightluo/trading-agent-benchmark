  44 def load_index(symbol, days=2000, prices=None):
  45     """Load observation-only index signal; falls back to persistent CSV capped at
  46     the max date visible in the tradable price history (no future data)."""
  47     try:
  48         df = get_index_daily_data(symbol=symbol, days=days)
  49         if df is not None and len(df) >= 30:
  50             df = df.copy()
  51             df['date'] = pd.to_datetime(df['date'])
  52             df = df.set_index('date')
  53             df['close'] = pd.to_numeric(df['close'], errors='coerce')
  54             return df
  55     except Exception:
  56         pass
  57     # CSV fallback (persistent/index_data), capped at visible horizon
  58     try:
  59         path = Path('../persistent/index_data') / f'{symbol}.csv'
  60         df = pd.read_csv(path, parse_dates=['date'])
  61         df = df.set_index('date').sort_index()
  62         df['close'] = pd.to_numeric(df['close'], errors='coerce')
  63         if prices is not None:
  64             visible = max(dd.index.max() for dd in prices.values())
  65             df = df[df.index <= visible]
  66         return df
  67     except Exception:
  68         return None
