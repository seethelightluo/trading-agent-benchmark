  35                 df = df.set_index('date')
  36                 for c in ['open', 'close', 'high', 'low', 'volume']:
  37                     df[c] = pd.to_numeric(df[c], errors='coerce')
  38                 out[s] = df
  39         except Exception:
  40             pass
  41     return out
