def f_xau_beta_60(df, s):
    xa = prices['XAU']['close'].pct_change()
    r = df['close'].pct_change()
    z = pd.concat([r.rename('r'), xa.rename('xa')], axis=1).dropna()
    return rolling_beta(z['r'], z['xa'], 60).reindex(z.index)


