25 def load_prices(days=2000):
26     """Return dict {symbol: df} of daily OHLCV via API (capped at current date)."""
27     out = {}
28     for s in WATCHLIST:
29         try:
30             df = get_stock_daily_data(symbol=s, days=days)
31             if df is not None and len(df) >= 30:
32                 df = df.copy()
33                 df['date'] = pd.to_datetime(df['date'])
34                 df = df.set_index('date')
35                 for c in ['open', 'close', 'high', 'low', 'volume']:
36                     df[c] = pd.to_numeric(df[c], errors='coerce')
37                 out[s] = df
38         except Exception:
39             pass
40     return out
41 
42 
43 def load_index(symbol, days=2000, prices=None):
44     """Load observation-only index signal; falls back to persistent CSV capped at
45     the max date visible in the tradable price history (no future data)."""
46     try:
47         df = get_index_daily_data(symbol=symbol, days=days)
48         if df is not None and len(df) >= 30:
49             df = df.copy()
50             df['date'] = pd.to_datetime(df['date'])
51             df = df.set_index('date')
52             df['close'] = pd.to_numeric(df['close'], errors='coerce')
53             return df
54     except Exception:
55         pass
56     # CSV fallback (persistent/index_data), capped at visible horizon
57     try:
58         path = Path('../persistent/index_data') / f'{symbol}.csv'
59         df = pd.read_csv(path, parse_dates=['date'])
60         df = df.set_index('date').sort_index()
61         df['close'] = pd.to_numeric(df['close'], errors='coerce')
62         if prices is not None:
63             visible = max(dd.index.max() for dd in prices.values())
64             df = df[df.index <= visible]
65         return df
66     except Exception:
67         return None
68 
