  ▶️ shell({'command': 'python - <<\'EOF\'\nimport pandas as pd, numpy as np, glob, os\n\nassets = ["000300.SH","SPX","HSI","N225","SX5E","000688.SH","SOX","NDX","XAU","COPPER","WTI","BTC","ETH","US10Y","CN10Y"]\ndata = {}\nfor a in assets:\n    df = pd.read_csv(f"../persistent/stock_data/{a}.csv")\n    df.columns = [c.strip() for c in df.columns]\n    df[\'date\'] = pd.to_datetime(df[\'date\'])\n    df = df.sort_values(\'date\').set_index(\'date\')\n    data[a] = df[\'close\']\n\npx = pd.DataFrame(data).dropna(how=\'all\')\npx = px.loc[:\'2026-07-29\']\nprint("rows:", len(px), "last date:", px.index[-1].date())\nret = px.pct_change()\n\n# per asset stats\nprint("\\n=== PER-ASSET RECENT STATS (through 2026-07-29) ===")\nprint(f"{\'asset\':10s} {\'last\':>10s} {\'ret5d%\':>7s} {\'ret20d%\':>8s} {\'ret60d%\':>8s} {\'vol20d%\':>8s} {\'maxdd60%\':>8s} {\'aboveMA60\':>9s}")\nfor a in assets:\n    s = px[a].dropna()\n    if len(s) < 70: \n        print(a, "insufficient"); continue\n    last = s.iloc[-1]\n    r5 = s.iloc[-1]/s.iloc[-6]-1 if len(s)>6 else np.nan\n    r20 = s.iloc[-1]/s.iloc[-21]-1 if len(s)>21 else np.nan\n    r60 = s.iloc[-1]/s.iloc[-61]-1 if len(s)>61 else np.nan\n    v20 = ret[a].iloc[-20:].std()*np.sqrt(252)\n    dd = s.iloc[-60:].max()/s.max()  # not right\n    roll_max = s.iloc[-60:].cummax()\n    mdd = (s.iloc[-60:]/roll_max - 1).min()\n    ma60 = s.iloc[-60:].mean()\n    print(f"{a:10s} {last:10.2f} {r5*100:7.2f} {r20*100:8.2f} {r60*100:8.2f} {v20*100:8.2f} {mdd*100:8.2f} {\'YES\' if last>ma60 else \'no\':>9s}")\n\n# market breadth: fraction of assets with positive 20d ret, above MA60\npos20 = sum(1 for a in assets if px[a].iloc[-1]/px[a].iloc[-21]-1 > 0)\nabv60 = sum(1 for a in assets if px[a].iloc[-1] > px[a].iloc[-60:].mean())\nprint(f"\\nBreadth: {pos20}/15 positive 20d ret; {abv60}/15 above MA60")\n\n# cross-asset avg pairwise correlation (20d)\nc = ret.iloc[-20:].corr()\nvals = c.values[np.triu_indices_from(c.values, k=1)]\nprint(f"Avg pairwise |corr| (20d): {np.nanmean(np.abs(vals)):.3f}; avg corr: {np.nanmean(vals):.3f}")\n\n# VIX & DXY\nvix = pd.read_csv(\'../persistent/index_data/VIX.csv\')\nvix[\'date\']=pd.to_datetime(vix[\'date\']); vix=vix.sort_values(\'date\').set_index(\'date\')\ndxy = pd.read_csv(\'../persistent/index_data/DXY.csv\')\ndxy[\'date\']=pd.to_datetime(dxy[\'date\']); dxy=dxy.sort_values(\'date\').set_index(\'date\')\nfor nm,df in [(\'VIX\',vix),(\'DXY\',dxy)]:\n    s=df[\'close\'].loc[:\'2026-07-29\'].dropna()\n    print(f"\\n{nm}: last={s.iloc[-1]:.2f}, 20d ago={s.iloc[-21]:.2f}, 60d ago={s.iloc[-61]:.2f}, 20d chg={100*(s.iloc[-1]/s.iloc[-21]-1):.1f}%")\n\n# recent SPX path\nspx = px[\'SPX\'].dropna()\nprint("\\nSPX last 10 closes:", [round(x,1) for x in spx.iloc[-10:]])\nprint("SPX 60d ago:", round(spx.iloc[-61],1), "-> now:", round(spx.iloc[-1],1))\nEOF'})
