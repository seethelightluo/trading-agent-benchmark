SAME grid shape ----\nlib = {}\nfor p in sorted(Path(\'factors\').glob(\'*.json\')):\n    if p.name.endswith(\'.bak\') or \'deprecated\' in p.name or \'ensemble\' in p.name:\n        continue\n    try:\n        payload = json.loads(p.read_text(encoding=\'utf-8\'))\n    except Exception:\n        continue\n    if payload.get(\'validation\', {}).get(\'status\') != \'EFFECTIVE\':\n        continue\n    art = payload.get(\'signal_artifact\')\n    art_path = p.parent / str(art) if art else None\n    if art_path is not None and art_path.exists():\n        arr = np.load(art_path, allow_pickle=False)\n        if arr.shape == (len(grid), len(WATCHLIST)):\n            lib[payload[\'factor_id\']] = arr\nprint(f\'library factors (shape-matched): {len(lib)} {sorted(lib.keys())}\', flush=True)\n\ndef rank_matrix(arr):\n    out = np.full(arr.shape, np.nan)\n    for t in range(arr.shape[0]):\n        row = arr[t]\n        m = np.isfinite(row)\n        n = int(m.sum())\n        if n >= 8:\n            r = np.full(arr.shape[1], np.nan)\n            r[m] = pd.Series(row[m]).rank().values\n            out[t] = r\n    return out\n\nlib_rank = {fid: rank_matrix(arr) for fid, arr in lib.items()}\n\ndef lib_max_corr(panel):\n    arr = signal_matrix(panel, grid)\n    cand = rank_matrix(arr)\n    best, best_id = 0.0, None\n    for fid, lr in lib_rank.items():\n        corrs = []\n        for t in range(len(grid)):\n            a, b = cand[t], lr[t]\n            m = np.isfinite(a) & np.isfinite(b)\n            if m.sum() >= 8:\n                a2, b2 = a[m], b[m]\n                sa, sb = a2.std(), b2.std()\n                if sa > 1e-12 and sb > 1e-12:\n                    corrs.append(float(np.corrcoef(a2, b2)[0, 1]))\n        if corrs:\n            r = float(np.mean(corrs))\n            if abs(r) > best:\n                best, best_id = abs(r), fid\n    return best, best_id\n\n# ---- helpers ----\ndef bench_ret(sym):\n    return prices[sym][\'close\'].pct_change()\n\ndef rolling_beta(asset_df, bench_series, window, min_obs=30, bench_is_yield=False):\n    r = asset_df[\'close\'].pct_change()\n    b = bench_series.diff() if bench_is_yield else bench_series\n    z = pd.concat([r.rename(\'r\'), b.rename(\'b\')], axis=1).dropna()\n    cov = z[\'r\'].rolling(window, min_periods=min_obs).cov(z[\'b\'])\n    var = z[\'b\'].rolling(window, min_periods=min_obs).var()\n    return (cov / var).reindex(z.index)\n\ndef mom_20(sym):\n    df = prices[sym]\n    return df[\'close\'] / df[\'close\'].shift(20) - 1.0\n\n# equal-weight world return\nworld_ret = pd.concat([bench_ret(s).rename(s) for s in WATCHLIST], axis=1).mean(axis=1)\n\n# ---- candidate factor functions ----\ndef f_world_beta_60(df, s):\n    return rolling_beta(df, world_ret, 60)\n\ndef f_world_rel_mom_20(df, s):\n    mine = df[\'close\'] / df[\'close\'].shift(20) - 1.0\n    xs = pd.concat([prices[x][\'close\'].pct_change(20) for x in WATCHLIST], axis=1)\n    med = xs.median(axis=1)\n    return (mine - med).reindex(mine.index)\n\ndef f_overnight_ret_20(df, s):\n    on = df[\'open\'] / df[\'close\'].shift(1) - 1.0\n    return on.rolling(20, min_periods=10).mean()\n\ndef f_intraday_ret_20(df, s):\n    intr = df[\'close\'] / df[\'open\'] - 1.0\n    return intr.rolling(20, min_periods=10).mean()\n\ndef f_intraday_vol_20(df, s):\n    intr = df[\'close\'] / df[\'open\'] - 1.0\n    return intr.rolling(20, min_periods=10).std()\n\ndef f_trend_r2_20(df, s):\n    lc = np.log(df[\'close\'])\n    def r2(win):\n        if len(win) < 10 or win.std() == 0:\n            return np.nan\n        x = np.arange(len(win))\n        return float(np.corrcoef(x, win)[0, 1] ** 2)\n    return lc.rolling(20, min_periods=10).apply(r2, raw=True)\n\ndef f_gk_vol_z_20_60(df, s):\n    o, h, l, c = df[\'open\'], df[\'high\'], df[\'low\'], df[\'close\']\n    gk = np.sqrt(0.5 * np.log(h / l) ** 2 - (2 * np.log(2) - 1) * np.log(c / o) ** 2)\n    v20 = gk.rolling(20, min_periods=10).mean()\n    mu = v20.rolling(60, min_periods=30).mean()\n    sd = v20.rolling(60, min_periods=30).std()\n    return ((v20 - mu) / sd.replace(0, np.nan))\n\ndef f_close_typical_20(df, s):\n    tp = (df[\'high\'] + df[\'low\'] + df[\'close\']) / 3.0\n    return (df[\'close\'] / tp - 1.0).rolling(20, min_periods=10).mean()\n\ndef f_newhigh_slope_20(df, s):\n    h20 = df[\'high\'].rolling(20).max()\n    h60 = df[\'high\'].rolling(60).max()\n    return (h20 / h60 - 1.0)\n\ndef f_wti_beta_cond_60x20(df, s):\n    if \'WTI\' not in prices:\n        return None\n    b = rolling_beta(df, bench_ret(\'WTI\'), 60)\n    return (b * mom_20(\'WTI\')).reindex(b.index)\n\ndef f_copper_beta_cond_60x20(df, s):\n    if \'COPPER\' not in prices:\n        return None\n    b = rolling_beta(df, bench_ret(\'COPPER\'), 60)\n    return (b * mom_20(\'COPPER\')).reindex(b.index)\n\ndef f_dollar_vol_trend_20_60(df, s):\n    dv = df[\'close\'] * df[\'volume\'].astype(float)\n    v20 = dv.rolling(20, min_periods=10).mean()\n    v60 = dv.rolling(60, min_periods=30).mean()\n    return (v20 / v60 - 1.0)\n\ndef f_max_gap_20(df, s):\n    gap = (df[\'open\'] / df[\'close\'].shift(1) - 1.0).abs()\n    return gap.rolling(20, min_periods=10).max()\n\ndef f_hsi_ndx_beta_20(df, s):\n    if \'HSI\' not in prices or \'NDX\' not in prices:\n        return None\n    ratio = prices[\'HSI\'][\'close\'] / prices[\'NDX\'][\'close\']\n    return rolling_beta(df, ratio.pct_change(), 20, min_obs=12)\n\ndef f_xau_beta_20(df, s):\n    if \'XAU\' not in prices:\n        return None\n    return rolling_beta(df, bench_ret(\'XAU\'), 20, min_obs=12)\n\ndef f_sx5e_rel_mom_20(df, s):\n    if \'SX5E\' not in prices:\n        return None\n    mine = df[\'close\'] / df[\'close\'].shift(20) - 1.0\n    ref = prices[\'SX5E\'][\'close\'] / prices[\'SX5E\'][\'close\'].shift(20) - 1.0\n    return (mine - ref).reindex(mine.index)\n\ndef f_hsi_rel_mom_20(df, s):\n    if \'HSI\' not in prices:\n        return None\n    mine = df[\'close\'] / df[\'close\'].shift(20) - 1.0\n    ref = prices[\'HSI\'][\'close\'] / prices[\'HSI\'][\'close\'].shift(20) - 1.0\n    return (mine - ref).reindex(mine.index)\n\nCANDIDATES = [\n    (\'world_beta_60\', f_world_beta_60),\n    (\'world_rel_mom_20\', f_world_rel_mom_20),\n    (\'overnight_ret_20\', f_overnight_ret_20),\n    (\'intraday_ret_20\', f_intraday_ret_20),\n    (\'intraday_vol_20\', f_intraday_vol_20),\n    (\'trend_r2_20\', f_trend_r2_20),\n    (\'gk_vol_z_20_60\', f_gk_vol_z_20_60),\n    (\'close_typical_20\', f_close_typical_20),\n    (\'newhigh_slope_20\', f_newhigh_slope_20),\n    (\'wti_beta_cond_60x20\', f_wti_beta_cond_60x20),\n    (\'copper_beta_cond_60x20\', f_copper_beta_cond_60x20),\n    (\'dollar_vol_trend_20_60\', f_dollar_vol_trend_20_60),\n    (\'max_gap_20\', f_max_gap_20),\n    (\'hsi_ndx_beta_20\', f_hsi_ndx_beta_20),\n    (\'xau_beta_20\', f_xau_beta_20),\n    (\'sx5e_rel_mom_20\', f_sx5e_rel_mom_20),\n    (\'hsi_rel_mom_20\', f_hsi_rel_mom_20),\n]\n\nresults = {}\nfor fid, fn in CANDIDATES:\n    panel = factor_to_panel(fn, prices)\n    m = validate_factor(fid, panel, prices)\n    if m is None:\n        print(f\'{fid}: insufficient data -> None\', flush=True)\n        results[fid] = {\'ok\': False, \'metrics\': None}\n        continue\n    rho, rho_id = lib_max_corr(panel)\n    m[\'max_abs_library_correlation\'] = rho\n    m[\'max_corr_library_id\'] = rho_id\n    ic_ok = abs(m[\'ic\']) >= 0.007\n    icir_ok = abs(m[\'icir\']) >= 0.084\n    corr_ok = rho < 0.5\n    ok = ic_ok and icir_ok and corr_ok\n    results[fid] = {\'ok\': ok, \'metrics\': m}\n    print(f\'Factor {fid}: panel {panel.shape} range {panel.index.min()}..{panel.index.max()}\', flush=True)\n    print(json.dumps({k: v for k, v in m.items() if k != \'decay_ic_by_horizon\'}, indent=2, default=str), flush=True)\n    print(\'decay:\', json.dumps(m[\'decay_ic_by_horizon\'], default=str), flush=True)\n    print(f"ADMISSION: |IC|={abs(m[\'ic\']):.4f}>=0.007 {ic_ok} | |ICIR|={abs(m[\'icir\']):.4f}>=0.084 {icir_ok} | rho={rho:.3f}<0.5 {corr_ok} -> {\'PASS\' if ok else \'FAIL\'}", flush=True)\n    print(\'-\' * 80, flush=True)\n\nout = Path(\'scripts/miner_2_20260910_results_round20.json\')\nout.write_text(json.dumps(results, indent=1, default=str), encoding=\'utf-8\')\nprint(f\'elapsed={time.time()-t0:.1f}s results -> {out}\', flush=True)\n'})
