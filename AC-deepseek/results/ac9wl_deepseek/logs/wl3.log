  ▶️ shell({'command': 'python - <<\'EOF\'\nimport json, glob, os\n\n# Load library metrics\nfiles = [fp for fp in sorted(glob.glob(\'factors/*.json\')) if \'ensemble\' not in fp]\nlib = {}\nfor fp in files:\n    d = json.load(open(fp))\n    m = d[\'validation\'][\'metrics\']\n    lib[d[\'factor_id\']] = {\'ic\': m[\'ic\'], \'icir\': m[\'icir\'],\n                           \'maxrho\': m.get(\'max_abs_library_correlation\', 0),\n                           \'maxcorr_id\': m.get(\'max_corr_library_id\')}\n\nq = {fid: abs(v[\'ic\'])*abs(v[\'icir\']) for fid, v in lib.items()}\n\n# Selection rule: rank by q desc; drop crowding near-duplicates BEFORE picking top-10\n# (eurusd_beta_cond_60x20 has max library rho 0.808 vs dxy_beta_cond_60x20 -> exclude;\n#  hilo_pos_60 lowest q + rho 0.417 -> exclude)\nEXCLUDED = {\'eurusd_beta_cond_60x20\', \'hilo_pos_60\'}\ncandidates = [(fid, q[fid]) for fid in q if fid not in EXCLUDED]\ncandidates.sort(key=lambda x: -x[1])\nselected = candidates[:10]\n\ntot = sum(qq for _, qq in selected)\nens = {\n    "schema_version": 1,\n    "selected_factors": [\n        {"factor_id": fid, "weight": round(qq/tot, 10), "direction": 1 if lib[fid][\'ic\'] > 0 else -1}\n        for fid, qq in selected\n    ],\n    "method": "quality_ic_tilt"\n}\nwsum = sum(f[\'weight\'] for f in ens[\'selected_factors\'])\nprint("selected:", [f[\'factor_id\'] for f in ens[\'selected_factors\']])\nprint("weight sum:", wsum)\nassert len(ens[\'selected_factors\']) <= 10\nassert all(f[\'weight\'] >= 0 for f in ens[\'selected_factors\'])\nassert abs(wsum - 1.0) < 1e-8\n\nwith open(\'factors/factor_ensemble.json\', \'w\') as f:\n    json.dump(ens, f, indent=2)\nprint("PERSISTED factors/factor_ensemble.json")\nprint(json.dumps(ens, indent=2))\nEOF'})
