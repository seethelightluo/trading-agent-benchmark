  ▶️ shell({'command': 'python - <<\'EOF\'\nimport pandas as pd, numpy as np\n\ndef load(sym, d=\'../persistent/stock_data\'):\n    df = pd.read_csv(f\'{d}/{sym}.csv\', parse_dates=[\'date\'])\n    df = df.set_index(\'date\').sort_index()\n    return df[\'close\']\n\nassets = [\'000300.SH\',\'SPX\',\'HSI\',\'N225\',\'SX5E\',\'000688.SH\',\'SOX\',\'NDX\',\'XAU\',\'COPPER\',\'WTI\',\'BTC\',\'ETH\',\'US10Y\',\'CN10Y\']\npx = pd.DataFrame({a: load(a) for a in assets})\n# Only data through 2026-07-29 (visible)\npxv = px[px.index <= \'2026-07-29\'].dropna(how=\'all\')\nprint("visible range:", pxv.index.min().date(), "->", pxv.index.max().date(), "n=", len(pxv))\n\n# Show closes around 2026-06-15 .. 2026-07-29\nwin = pxv.loc[\'2026-06-15\':\'2026-07-29\']\nprint("\\n=== Close levels, last 6 weeks (weekly sample) ===")\nprint(win.resample(\'W-FRI\').last().tail(8).round(2).to_string())\n\n# Recent returns\nr10 = pxv.iloc[-1]/pxv.iloc[-11]-1\nr20 = pxv.iloc[-1]/pxv.iloc[-21]-1\nr60 = pxv.iloc[-1]/pxv.iloc[-61]-1\nprint("\\n=== Returns through 2026-07-29 ===")\nfor a in assets:\n    print(f"{a:12s} r10={r10.get(a,np.nan)*100:7.2f}%  r20={r20.get(a,np.nan)*100:7.2f}%  r60={r60.get(a,np.nan)*100:7.2f}%")\n\nrets = pxv.pct_change().dropna()\nrv20 = rets.iloc[-20:].std()*np.sqrt(252); rv60 = rets.iloc[-60:].std()*np.sqrt(252)\nprint("\\n=== Realized vol (ann, 20d/60d) ===")\nfor a in assets:\n    print(f"{a:12s} rv20={rv20.get(a,np.nan)*100:6.1f}%  rv60={rv60.get(a,np.nan)*100:6.1f}%")\n\nc60 = rets.iloc[-60:].corr()\ntri = c60.values[np.triu_indices(len(c60),1)]\ntri = tri[~np.isnan(tri)]\nprint("\\navg pairwise corr (60d):", round(tri.mean(),3), " median:", round(np.median(tri),3))\nspx = pxv[\'SPX\']\nma20=spx.iloc[-20:].mean(); ma60=spx.iloc[-60:].mean(); ma120=spx.iloc[-120:].mean()\nprint("\\nSPX close:", round(spx.iloc[-1],1), "| MA20:", round(ma20,1), "MA60:", round(ma60,1), "MA120:", round(ma120,1))\nprint("SPX > MA20:", spx.iloc[-1]>ma20, "> MA60:", spx.iloc[-1]>ma60, "> MA120:", spx.iloc[-1]>ma120)\n# drawdown from 120d high\nprint("SPX 120d max dd:", round((spx.iloc[-1]/spx.iloc[-120:].max()-1)*100,2), "%")\nEOF'})
