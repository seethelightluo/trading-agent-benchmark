  ▶️ shell({'command': 'python - <<\'EOF\'\nimport pandas as pd, numpy as np, glob, os\n\n# Load tradables\ntrad = [\'000300.SH\',\'SPX\',\'HSI\',\'N225\',\'SX5E\',\'000688.SH\',\'SOX\',\'NDX\',\'XAU\',\'COPPER\',\'WTI\',\'BTC\',\'ETH\',\'US10Y\',\'CN10Y\']\npx = {}\nfor t in trad:\n    df = pd.read_csv(f\'../persistent/stock_data/{t}.csv\', parse_dates=[\'date\'])\n    df = df.sort_values(\'date\').set_index(\'date\')\n    px[t] = df[\'close\']\npx = pd.DataFrame(px).dropna(how=\'all\')\nobs = {}\nfor o in [\'DXY\',\'USDCNY\',\'USDJPY\',\'EURUSD\',\'VIX\']:\n    df = pd.read_csv(f\'../persistent/index_data/{o}.csv\', parse_dates=[\'date\'])\n    df = df.sort_values(\'date\').set_index(\'date\')\n    obs[o] = df[\'close\']\nobs = pd.DataFrame(obs).dropna(how=\'all\')\n\nlast = px.index[-1]\nprint("Data through:", last, "| rows:", len(px))\nprint("\\n=== TRADABLES: recent returns (%, through", last.date(), ") ===")\nret = px.pct_change()\nfor t in trad:\n    r1 = ret[t].iloc[-1]*100\n    r5 = ret[t].iloc[-5:].sum()*100\n    r10 = ret[t].iloc[-10:].sum()*100\n    r21 = ret[t].iloc[-21:].sum()*100\n    lastv = px[t].iloc[-1]\n    print(f"{t:<10} last={lastv:>10.2f}  1d={r1:>7.2f}%  5d={r5:>7.2f}%  10d={r10:>7.2f}%  21d={r21:>7.2f}%")\n\nprint("\\n=== OBSERVATION MACROS ===")\nfor o in [\'DXY\',\'USDCNY\',\'USDJPY\',\'EURUSD\',\'VIX\']:\n    r1 = obs[o].iloc[-1]/obs[o].iloc[-2]-1\n    r5 = obs[o].iloc[-1]/obs[o].iloc[-6]-1\n    r10 = obs[o].iloc[-1]/obs[o].iloc[-11]-1\n    print(f"{o:<8} last={obs[o].iloc[-1]:>9.3f}  1d={r1*100:>6.2f}%  5d={r5*100:>6.2f}%  10d={r10*100:>6.2f}%")\n\n# Realized vol and cross-asset correlation regime\nvol = ret.tail(21).std()*np.sqrt(252)*100\nprint("\\n=== 21d realized vol (annualized %) ===")\nfor t in trad:\n    print(f"{t:<10} {vol[t]:>6.1f}%")\n\n# cross-sectional dispersion / avg pairwise corr of daily returns last 21d\nmat = ret.tail(21)\nc = mat.corr()\navg_corr = (c.values[np.triu_indices_from(c.values,1)]).mean()\nprint(f"\\nAvg pairwise 21d corr (tradables): {avg_corr:.3f}")\nprint("SPX 21d ret:", (px[\'SPX\'].iloc[-1]/px[\'SPX\'].iloc[-22]-1)*100, "%  |  CSI300 21d ret:", (px[\'000300.SH\'].iloc[-1]/px[\'000300.SH\'].iloc[-22]-1)*100, "%")\nEOF'})
