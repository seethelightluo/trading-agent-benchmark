 130 def forward_returns(prices, horizon):
 131     """Wide panel of forward h-day simple returns aligned at t."""
 132     cols = {}
 133     for s, df in prices.items():
 134         if 'close' in df:
 135             cols[s] = df['close'].shift(-horizon) / df['close'] - 1.0
 136     return pd.DataFrame(cols).sort_index()
 137 
