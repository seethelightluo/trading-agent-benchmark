  ▶️ write_file({'content': '"""miner_1 2026-08-27 exploration batch B: trend-persistence, tail-risk and\nconditional crypto-beta factors (all untested in library).\n\nMotivation: library is rich in plain/conditional macro betas and momentum;\nthis batch targets orthogonal signal families:\n  - autocorr_20        : lag-1 return autocorrelation (persistence vs reversion)\n  - adx_14             : ADX-style trend strength (directional movement system)\n  - downside_dev_20    : Sortino-like downside deviation (tail risk premium)\n  - range_ratio_20_60  : range (H-L)/close term structure (vol-of-range)\n  - crypto_beta_cond_60x20 : conditional beta on BTC/ETH basket x basket momentum\n  - kurt_20            : kurtosis of 20d returns (fat tails)\n  - mom_skew_change    : skew(60d) - skew(20d) (skew term-structure shift)\n  - close_to_20d_high  : proximity to 20d high (breakout strength)\n  - max_dd_60_recover  : recovery ratio from 60d peak (drawdown recovery)\n  - hilo_vol_ratio_20  : 20d (max-min)/close vs 20d vol (range efficiency)\n\nAdmission gate: |IC|>=0.007, |ICIR|>=0.084 at 10d horizon; crowding vs\nfull persisted signal-artifact library (rho<0.5).\n"""\nimport sys\nsys.path.insert(0, \'scripts\')\nimport json\nimport numpy as np\nimport pandas as pd\nfrom pathlib import Path\nfrom factor_common import (load_prices, factor_to_panel, validate_factor,\n                           build_library_panels, max_library_correlation,\n                           canonical_grid, signal_matrix)\n\nprices = load_prices(days=2000)\ngrid = canonical_grid(prices)\nprint(f"grid: {len(grid)} dates {grid.min().date()}..{grid.max().date()}")\n\ncrypto_r = pd.concat([\n    prices[\'BTC\'][\'close\'].pct_change().rename(\'btc\'),\n    prices[\'ETH\'][\'close\'].pct_change().rename(\'eth\'),\n], axis=1).mean(axis=1).rename(\'crypto\')\ncrypto_lev = pd.concat([\n    prices[\'BTC\'][\'close\'].rename(\'btc\'),\n    prices[\'ETH\'][\'close\'].rename(\'eth\'),\n], axis=1).mean(axis=1).rename(\'crypto_lev\')\n\n# ---------- candidate factor functions ----------\ndef f_autocorr_20(df, s):\n    r = df[\'close\'].pct_change()\n    x = r.rolling(20).apply(lambda w: w[:-1].corr(w[1:]) if w[:-1].std() > 0 and w[1:].std() > 0 else np.nan, raw=True)\n    return x\n\ndef f_adx_14(df, s):\n    up = df[\'high\'].diff()\n    dn = -df[\'low\'].diff()\n    plus_dm = np.where((up > dn) & (up > 0), up, 0.0)\n    minus_dm = np.where((dn > up) & (dn > 0), dn, 0.0)\n    tr = pd.concat([df[\'high\'] - df[\'low\'], (df[\'high\'] - df[\'close\'].shift()).abs(),\n                    (df[\'low\'] - df[\'close\'].shift()).abs()], axis=1).max(axis=1)\n    atr = tr.rolling(14).mean()\n    plus_di = 100 * pd.Series(plus_dm, index=df.index).rolling(14).mean() / atr\n    minus_di = 100 * pd.Series(minus_dm, index=df.index).rolling(14).mean() / atr\n    dx = 100 * (plus_di - minus_di).abs() / (plus_di + minus_di).replace(0, np.nan)\n    return dx.rolling(14).mean()\n\ndef f_downside_dev_20(df, s):\n    r = df[\'close\'].pct_change()\n    neg = r.clip(upper=0.0)\n    dd = (neg ** 2).rolling(20).mean() ** 0.5\n    return dd * np.sqrt(252)\n\ndef f_range_ratio_20_60(df, s):\n    rng = (df[\'high\'] - df[\'low\']) / df[\'close\']\n    return rng.rolling(20).mean() / rng.rolling(60).mean()\n\ndef f_crypto_beta_cond_60x20(df, s):\n    r = df[\'close\'].pct_change()\n    z = pd.concat([r.rename(\'r\'), crypto_r.rename(\'y\')], axis=1).dropna()\n    b = z[\'r\'].rolling(60).cov(z[\'y\']) / z[\'y\'].rolling(60).var()\n    y_move = crypto_lev / crypto_lev.shift(20) - 1.0\n    return (b * y_move).reindex(z.index)\n\ndef f_kurt_20(df, s):\n    r = df[\'close\'].pct_change()\n    return r.rolling(20).kurt()\n\ndef f_mom_skew_change(df, s):\n    r = df[\'close\'].pct_change()\n    return r.rolling(60).skew() - r.rolling(20).skew()\n\ndef f_close_to_20d_high(df, s):\n    c = df[\'close\']\n    return c / c.rolling(20).max() - 1.0\n\ndef f_max_dd_60_recover(df, s):\n    c = df[\'close\']\n    peak = c.rolling(60).max()\n    return (c / peak - 1.0).abs()  # depth of drawdown from 60d peak\n\ndef f_hilo_vol_ratio_20(df, s):\n    c = df[\'close\']\n    rng = (c.rolling(20).max() - c.rolling(20).min()) / c\n    vol = c.pct_change().rolling(20).std()\n    return rng / vol\n\ncandidates = [\n    (\'autocorr_20\', f_autocorr_20),\n    (\'adx_14\', f_adx_14),\n    (\'downside_dev_20\', f_downside_dev_20),\n    (\'range_ratio_20_60\', f_range_ratio_20_60),\n    (\'crypto_beta_cond_60x20\', f_crypto_beta_cond_60x20),\n    (\'kurt_20\', f_kurt_20),\n    (\'mom_skew_change\', f_mom_skew_change),\n    (\'close_to_20d_high\', f_close_to_20d_high),\n    (\'max_dd_60_recover\', f_max_dd_60_recover),\n    (\'hilo_vol_ratio_20\', f_hilo_vol_ratio_20),\n]\n\nlib = build_library_panels(prices)\nresults = {}\nfor fid, fn in candidates:\n    try:\n        panel = factor_to_panel(fn, prices)\n        m = validate_factor(fid, panel, prices)\n        if m is None:\n            print(f"{fid}: insufficient -> None")\n            results[fid] = {\'ok\': False, \'metrics\': {\'error\': \'insufficient\'}}\n            continue\n        rho, rho_id = max_library_correlation(panel, lib)\n        m[\'max_abs_library_correlation\'] = rho\n        m[\'max_corr_library_id\'] = rho_id\n        ok = abs(m[\'ic\']) >= 0.007 and abs(m[\'icir\']) >= 0.084\n        print(f"--- {fid}: panel {panel.shape} | IC={m[\'ic\']:.4f} ICIR={m[\'icir\']:.4f} "\n              f"hit={m[\'ic_hit_ratio\']:.3f} n={m[\'n_ic_dates\']} cov={m[\'coverage_asset_days\']:.3f} "\n              f"ge8={m[\'coverage_dates_ge8\']:.3f} turn={m[\'turnover_10d_rank\']:.3f} "\n              f"rho={rho:.3f}({rho_id}) -> {\'PASS\' if ok else \'FAIL\'}")\n        print("    decay:", {k: round(v, 4) for k, v in m[\'decay_ic_by_horizon\'].items()})\n        results[fid] = {\'ok\': ok, \'metrics\': m}\n    except Exception as e:\n        print(f"{fid}: ERROR {e}")\n        results[fid] = {\'ok\': False, \'metrics\': {\'error\': str(e)}}\n\nwith open(\'scripts/miner_1_20260827_results_batchB.json\', \'w\') as f:\n    json.dump(results, f, default=str, indent=1)\nprint("\\nDONE saved scripts/miner_1_20260827_results_batchB.json")\n', 'file_path': 'scripts/miner_1_20260827_screen_batchB.py'})
