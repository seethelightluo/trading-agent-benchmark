i in range(len(fids)):\n    for j in range(i+1, len(fids)):\n        rhos = []\n        for t in range(X.shape[1]):\n            a, b = X[i,t], X[j,t]\n            m = ~(np.isnan(a)|np.isnan(b))\n            if m.sum() >= 8:\n                rhos.append(spearmanr(a[m], b[m]).statistic)\n        rho = np.nanmedian(rhos) if rhos else np.nan\n        if abs(rho) > 0.3:\n            print(f"  {fids[i]:22s} vs {fids[j]:22s} median_rho={rho:.3f}")\nEOF'})
