def f_bw_zscore(df, s):
    c = df['close']; ma = c.rolling(20).mean(); sd = c.rolling(20).std()
    bw = 2 * sd / ma
    mu = bw.rolling(60).mean(); s60 = bw.rolling(60).std()
    return (bw - mu) / s60.replace(0, np.nan)

