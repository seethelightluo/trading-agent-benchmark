    'vol_price_corr_60':    (f_vol_price_corr, {'window': 60, 'min_periods': 30}, 'corr(pct_change(close),volume,60)'),
    'wti_beta_60':          (_beta_anchor(prices['WTI']['close']), {'anchor': 'WTI', 'window': 60}, 'BETA(ret,WTI_ret,60)'),
