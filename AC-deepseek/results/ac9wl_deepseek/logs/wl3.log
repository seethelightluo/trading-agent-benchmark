  89 def signal_matrix(panel, grid=None, prices=None):
  90     """Reindex factor panel to the canonical grid -> (n_dates, 15) float matrix.
  91 
  92     Missing values become NaN; column order is fixed to WATCHLIST order so every
  93     factor artifact is directly comparable shape-wise.
  94     """
  95     if grid is None:
  96         grid = canonical_grid(prices)
  97     m = panel.reindex(grid)
  98     for c in WATCHLIST:
  99         if c not in m.columns:
 100             m[c] = np.nan
 101     return m[WATCHLIST].values.astype(float)
 102 
