 329 def load_artifact_matrix(factor_json_path):
 330     """Reconstruct the 2D signal matrix referenced by a persisted factor JSON."""
 331     payload = json.loads(Path(factor_json_path).read_text(encoding='utf-8'))
 332     art = payload.get('signal_artifact')
 333     if not art:
 334         return None
 335     p = Path(factor_json_path).parent / str(art)
 336     if not p.exists():
 337         return None
 338     return np.load(p, allow_pickle=False)

