    rc = cn10y.reindex(df.index).pct_change()
    z = pd.concat([r.rename('r'), rc.rename('c')], axis=1).dropna()
    return z['r'].rolling(60).cov(z['c']) / z['c'].rolling(60).var()

def f_intraskew(df, s):
    return (df['close'] / df['open'] - 1.0).rolling(20).skew()

def f_momaccel(df, s):
