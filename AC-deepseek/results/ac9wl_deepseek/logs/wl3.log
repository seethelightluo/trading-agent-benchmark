  ▶️ write_file({'content': '"""Check dd_duration candidates vs ALL effective root library factors (artifact-based rho)."""\nimport sys, json\nimport numpy as np\nimport pandas as pd\nfrom pathlib import Path\nsys.path.insert(0, \'scripts\')\nfrom factor_common import (load_prices, factor_to_panel, canonical_grid, signal_matrix)\n\nprices = load_prices(days=2100)\ngrid = canonical_grid(prices)\n\n\ndef dd_duration(df, s, win=120, minp=60):\n    c = df[\'close\']\n    h = c.rolling(win, min_periods=minp).max()\n    is_high = (c >= h).fillna(False)\n    idx_high = np.flatnonzero(is_high.values)\n    pos = np.arange(len(c))\n    last = np.searchsorted(idx_high, pos) - 1\n    dur = np.where(last >= 0, pos - idx_high[np.maximum(last, 0)], np.nan)\n    return pd.Series(np.log1p(dur), index=c.index)\n\n\ndef zscore_rows(panel):\n    return panel.sub(panel.mean(axis=1), axis=0).div(panel.std(axis=1), axis=0)\n\n\ndef orthogonalize(panel, ref, min_valid=8):\n    z, zr = zscore_rows(panel), zscore_rows(ref)\n    out = z.copy()\n    for d in z.index:\n        if d not in zr.index:\n            out.loc[d] = np.nan\n            continue\n        x, y = z.loc[d], zr.loc[d]\n        m = x.notna() & y.notna() & np.isfinite(x) & np.isfinite(y)\n        if m.sum() < min_valid:\n            out.loc[d] = np.nan\n            continue\n        xv, yv = x[m].values, y[m].values\n        xv = (xv - xv.mean()) / (xv.std() + 1e-12)\n        yv = (yv - yv.mean()) / (yv.std() + 1e-12)\n        beta = float(np.dot(xv, yv) / (len(xv) + 1e-12))\n        out.loc[d, m] = xv - beta * yv\n    return out\n\n\n# effective root factors = json with status EFFECTIVE + .npy artifact present\ndef effective_library():\n    mats = {}\n    for jp in sorted(Path(\'factors\').glob(\'*.json\')):\n        try:\n            payload = json.loads(jp.read_text())\n        except Exception:\n            continue\n        if payload.get(\'validation\', {}).get(\'status\') != \'EFFECTIVE\':\n            continue\n        art = payload.get(\'signal_artifact\')\n        if not art:\n            continue\n        p = jp.parent / str(art)\n        if not p.exists():\n            continue\n        mats[payload[\'factor_id\']] = np.load(p, allow_pickle=False)\n    return mats\n\n\nlib = effective_library()\nprint(\'effective library factors (%d):\' % len(lib), sorted(lib))\n\n\ndef pair_rho(a, b, min_valid=8):\n    corrs = []\n    for i in range(len(a)):\n        x, y = a[i], b[i]\n        m = np.isfinite(x) & np.isfinite(y)\n        if m.sum() >= min_valid:\n            # Spearman via rank on valid subset\n            xs, ys = x[m], y[m]\n            r = pd.Series(xs).rank().corr(pd.Series(ys).rank())\n            if np.isfinite(r):\n                corrs.append(r)\n    return float(np.mean(corrs)) if corrs else np.nan\n\n\nmom120_panel = lib.get(\'mom_120d_skip5\')\nif mom120_panel is None:\n    # rebuild if not in effective set\n    def f_mom120(df, s): return df[\'close\'].shift(5) / df[\'close\'].shift(125) - 1.0\n    mom120_panel = signal_matrix(factor_to_panel(f_mom120, prices), grid)\n\ncands = {\n    \'dd_dur_120\': signal_matrix(factor_to_panel(lambda df, s: dd_duration(df, s, 120), prices), grid),\n    \'dd_dur_60\': signal_matrix(factor_to_panel(lambda df, s: dd_duration(df, s, 60, 30), prices), grid),\n    \'dd_dur_120_resid\': signal_matrix(orthogonalize(\n        factor_to_panel(lambda df, s: dd_duration(df, s, 120), prices), mom120_panel), grid),\n}\n\nfor fid, mat in cands.items():\n    rhos = {lid: pair_rho(mat, lm) for lid, lm in lib.items()}\n    best = max(rhos, key=lambda k: abs(rhos[k]))\n    print(f\'{fid}: max|rho|={abs(rhos[best]):.3f} vs {best} | rhos>0.5: \'\n          + \', \'.join(f\'{k}={v:.2f}\' for k, v in rhos.items() if abs(v) > 0.5))\n', 'file_path': 'scripts/miner_3_20260730_dd_duration_lib_rho.py'})
