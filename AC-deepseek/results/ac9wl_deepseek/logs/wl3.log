 139 def rank_ic_series(factor_panel, fwd_ret, min_valid=8):
 140     """Daily cross-sectional Spearman IC between factor and forward return."""
 141     common = factor_panel.index.intersection(fwd_ret.index)
 142     ic = {}
 143     for d in common:
 144         x = factor_panel.loc[d]
 145         y = fwd_ret.loc[d]
 146         m = x.notna() & y.notna() & np.isfinite(x) & np.isfinite(y)
 147         if m.sum() >= min_valid:
 148             ic[d] = x[m].rank().corr(y[m].rank())
 149     return pd.Series(ic).sort_index()
 150 
 151 
 152 def validate_factor(factor_id, factor_panel, prices, horizons=(1, 2, 3, 5, 10, 20),
 153                     min_valid=8, icir_scale=True):
 154     """Full validation battery. Returns dict of metrics."""
 155     fwd = {h: forward_returns(prices, h) for h in horizons}
 156     ic_series = {h: rank_ic_series(factor_panel, fwd[h], min_valid) for h in horizons}
 157 
 158     ic10 = ic_series[10]
 159     ic10 = ic10[(ic10.index >= VAL_START) & (ic10.index <= VAL_END)]
 160     if len(ic10) < 100:
 161         return None
 162     ic_mean = float(ic10.mean())
 163     ic_std = float(ic10.std(ddof=1))
 164     icir = ic_mean / ic_std if ic_std > 0 else 0.0
 165     hit = float((ic10 > 0).mean()) if ic_mean >= 0 else float((ic10 < 0).mean())
 166 
 167     # coverage
 168     fac = factor_panel[(factor_panel.index >= VAL_START) & (factor_panel.index <= VAL_END)]
 169     total_cells = fac.shape[0] * fac.shape[1]
 170     valid_cells = int(fac.notna().sum().sum())
 171     coverage = valid_cells / total_cells if total_cells else 0.0
 172     ge8 = float((fac.notna().sum(axis=1) >= min_valid).mean())
 173 
 174     # turnover: mean absolute rank change over 10-day steps
 175     ranked = fac.rank(axis=1)
 176     if len(ranked) > 10:
 177         turn = float(ranked.diff(10).abs().mean().mean())
 178     else:
 179         turn = float('nan')
 180 
 181     decay = {str(h): (float(ic_series[h].mean()) if len(ic_series[h]) else float('nan'))
 182              for h in horizons}
 183 
 184     return {
 185         'ic': ic_mean, 'icir': icir, 'ic_hit_ratio': hit,
 186         'n_ic_dates': int(len(ic10)), 'coverage_asset_days': coverage,
 187         'coverage_dates_ge8': ge8, 'turnover_10d_rank': turn,
 188         'decay_ic_by_horizon': decay,
 189     }
 190 
