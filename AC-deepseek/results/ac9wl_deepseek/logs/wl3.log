    vol_med = float(panel.tail(120).std().median(axis=0))
    risk_off = (mkt20 < 0.0 and mdd < -0.03) or (vol20 > 1.3 * max(vol_med, 1e-6))
    risk_on = mkt20 > 0.0 and mdd > -0.02
    def_floor = 0.15 if risk_off else (0.10 if risk_on else 0.12)
