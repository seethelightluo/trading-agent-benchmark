  ▶️ shell({'command': 'python - <<\'EOF\'\nimport pandas as pd, numpy as np, glob, os\n\ntradable = [\'000300.SH\',\'SPX\',\'HSI\',\'N225\',\'SX5E\',\'000688.SH\',\'SOX\',\'NDX\',\'XAU\',\'COPPER\',\'WTI\',\'BTC\',\'ETH\',\'US10Y\',\'CN10Y\']\nobs = [\'DXY\',\'USDCNY\',\'USDJPY\',\'EURUSD\',\'VIX\']\n\ndef load(sym, prefix=\'stock_data\'):\n    p = f\'../persistent/{prefix}/{sym}.csv\'\n    df = pd.read_csv(p)\n    df.columns = [c.strip().lower() for c in df.columns]\n    date_col = \'date\' if \'date\' in df.columns else df.columns[0]\n    df[date_col] = pd.to_datetime(df[date_col])\n    df = df.sort_values(date_col).set_index(date_col)\n    for c in [\'close\',\'open\',\'high\',\'low\',\'volume\']:\n        if c not in df.columns and \'close\' in df.columns:\n            df[c] = np.nan\n    return df\n\npx = pd.DataFrame()\nfor s in tradable:\n    df = load(s)\n    px[s] = df[\'close\']\npxo = pd.DataFrame()\nfor s in obs:\n    df = load(s, \'index_data\')\n    pxo[s] = df[\'close\']\n\npx = px.dropna(how=\'all\').ffill().dropna(how=\'all\')\npxo = pxo.dropna(how=\'all\').ffill()\nprint("price range:", px.index.min().date(), "->", px.index.max().date(), "| rows:", len(px))\n\nlast = px.iloc[-1]\nret20 = px.iloc[-1]/px.iloc[-21]-1\nret60 = px.iloc[-1]/px.iloc[-61]-1 if len(px)>61 else np.nan\nvol20 = px.pct_change().iloc[-20:].std()*np.sqrt(252)\nma20 = px.iloc[-20:].mean(); ma60 = px.iloc[-60:].mean() if len(px)>=60 else np.nan\nabove20 = last > ma20\nabove60 = last > ma60\n\nprint("\\n=== TRADABLE ASSETS (through %s) ===" % px.index.max().date())\nfor s in tradable:\n    print(f"{s:<10} last={last[s]:>12.2f}  r20={ret20[s]*100:>7.2f}%  r60={ret60[s]*100:>8.2f}%  vol20={vol20[s]*100:>5.1f}%  >SMA20={above20[s]} >SMA60={above60[s]}")\n\nprint("\\n=== OBSERVATION SIGNALS ===")\nfor s in obs:\n    r20 = pxo[s].iloc[-1]/pxo[s].iloc[-21]-1 if len(pxo[s])>21 else np.nan\n    print(f"{s:<8} last={pxo[s].iloc[-1]:>10.2f}  r20={r20*100:>7.2f}%")\n\n# cross-asset correlation regime: avg pairwise |corr| of 20d returns\nrc = px.pct_change().iloc[-60:]\ncorr = rc.corr()\nvals = corr.values[np.triu_indices(len(corr),1)]\nprint(f"\\navg pairwise corr (60d, all 15): {np.nanmean(vals):.3f}")\n\n# dispersion: cross-sectional std of 20d returns\ndisp = px.pct_change().iloc[-20:].sum(axis=0).std()\nprint(f"cross-sectional dispersion of 20d rets: {disp*100:.2f}%")\n\n# trend strength: % of assets above 20d MA and 20d MA slope\nprint(f"assets above SMA20: {above20.sum()}/15, above SMA60: {int(above60.sum())}/15")\nEOF'})
