def make_rel_strength(n=20):
    def f(df, s):
        ret20 = df['close'] / df['close'].shift(n) - 1.0
        panel = pd.DataFrame({k: v['close'] / v['close'].shift(n) - 1.0 for k, v in prices.items()})
