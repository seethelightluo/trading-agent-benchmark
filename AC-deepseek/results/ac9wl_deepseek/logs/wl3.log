def downside_vol_ratio_60(df, s):
    r = df['close'].pct_change()
    neg = r.clip(upper=0)
    sd_all = r.rolling(60).std()
    sd_neg = neg.rolling(60).std()
    return (sd_neg / sd_all).replace([float('inf')], float('nan'))

