def forward_returns(prices, horizon):
    """Wide panel of forward h-day simple returns aligned at t."""
    cols = {}
    for s, df in prices.items():
        if 'close' in df:
            cols[s] = df['close'].shift(-horizon) / df['close'] - 1.0
    return pd.DataFrame(cols).sort_index()

