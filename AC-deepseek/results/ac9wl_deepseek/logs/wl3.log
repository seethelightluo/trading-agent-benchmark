197: def pairwise_rho(ids):
198:     R = {fid: panels[fid].rank(axis=1) for fid in ids}
199:     M = pd.DataFrame(index=ids, columns=ids, dtype=float)
200:     for i, a in enumerate(ids):
201:         for b in ids[i + 1:]:
202:             xa, xb = R[a], R[b]
203:             valid = xa.notna() & xb.notna()
204:             n = valid.sum(axis=1)
205:             x1 = xa.where(valid); x2 = xb.where(valid)
206:             m1 = x1.mean(axis=1); m2 = x2.mean(axis=1)
207:             cov = ((x1.sub(m1, axis=0)) * (x2.sub(m2, axis=0))).sum(axis=1) / (n - 1)
208:             v1 = ((x1.sub(m1, axis=0)) ** 2).sum(axis=1) / (n - 1)
209:             v2 = ((x2.sub(m2, axis=0)) ** 2).sum(axis=1) / (n - 1)
210:             c = (cov / np.sqrt(v1 * v2)).where((n >= 8) & (v1 > 0) & (v2 > 0))
211:             rho = float(c.mean()) if len(c) else float('nan')
212:             M.loc[a, b] = M.loc[b, a] = rho
213:     return M
