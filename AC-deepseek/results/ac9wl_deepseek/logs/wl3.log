def vwap_dev_20(df, s):
    vol = df['volume'].replace(0, np.nan)
    pv = (df['close'] * vol).rolling(20).sum()
    vv = vol.rolling(20).sum()
    vwap = pv / vv.replace(0, np.nan)
    return df['close'] / vwap - 1.0


def macd_hist_12_26(df, s):
