0 import json, glob, os
1 
2 active = [f for f in sorted(glob.glob('factors/*.json'))
3           if not f.endswith('.bak') and os.path.basename(f) != 'factor_ensemble.json']
4 
5 rows = []
6 for f in active:
7     d = json.load(open(f))
8     m = d['validation']['metrics']
9     rows.append({
10         'factor_id': d['factor_id'],
11         'ic': m['ic'],
12         'icir': m['icir'],
13         'hit': m.get('ic_hit_ratio'),
14         'q': abs(m['ic']) * abs(m['icir']),
15         'dir': 1 if m['ic'] > 0 else -1,
16         'max_rho': m.get('max_abs_library_correlation'),
17         'max_rho_id': m.get('max_corr_library_id'),
18         'turnover_10d_rank': m.get('turnover_10d_rank'),
19     })
20 
21 # Crowding exclusion: if max_rho > 0.7 with a higher-q partner, drop lower-q member
22 excluded = set()
23 for r in sorted(rows, key=lambda x: -x['q']):
24     if r['max_rho'] and r['max_rho'] > 0.7:
25         partner = r['max_rho_id']
26         pq = next((x['q'] for x in rows if x['factor_id'] == partner), None)
27         if pq is not None and pq > r['q']:
28             excluded.add(r['factor_id'])
29 
30 print(f"{'factor_id':<24}{'ic':>8}{'icir':>8}{'hit':>7}{'q':>9}{'dir':>5}{'maxrho':>8}  excl")
31 for r in sorted(rows, key=lambda x: -x['q']):
32     print(f"{r['factor_id']:<24}{r['ic']:>8.4f}{r['icir']:>8.4f}{r['hit']:>7.3f}{r['q']:>9.4f}{r['dir']:>5}{r['max_rho'] if r['max_rho'] else 0:>8.3f}  {'*' if r['factor_id'] in excluded else ''}")
33 
34 cand = [r for r in sorted(rows, key=lambda x: -x['q']) if r['factor_id'] not in excluded][:10]
35 tot = sum(r['q'] for r in cand)
36 print(f"\nSelected {len(cand)} factors, sum q = {tot:.6f}")
37 sel = []
38 for r in cand:
39     w = r['q'] / tot
40     sel.append({'factor_id': r['factor_id'], 'weight': round(w, 10), 'direction': r['dir'], 'q': r['q']})
41     print(f"  {r['factor_id']:<24} w={w:.6f} dir={r['dir']:+d} q={r['q']:.4f}")
42 print(f"weights sum = {sum(s['weight'] for s in sel):.10f}")
43 
44 # Compare to persisted
45 ens = json.load(open('factors/factor_ensemble.json'))
46 old = {s['factor_id']: (s['weight'], s['direction']) for s in ens['selected_factors']}
47 new = {s['factor_id']: (s['weight'], s['direction']) for s in sel}
48 print("\n== Diff vs persisted ensemble ==")
49 all_ids = set(old) | set(new)
50 for fid in sorted(all_ids):
51     o, n = old.get(fid), new.get(fid)
52     mark = 'SAME' if o == n else 'DIFF'
53     print(f"  {fid:<24} old={o} new={n}  {mark}")
54 
55 # Persist
56 out = {
57     'schema_version': 1,
58     'selected_factors': [{'factor_id': s['factor_id'], 'weight': s['weight'], 'direction': s['direction']} for s in sel],
59     'method': 'quality_ic_tilt',
60 }
61 with open('factors/factor_ensemble.json', 'w') as fh:
62     json.dump(out, fh, indent=2)
63 print("\nPersisted factors/factor_ensemble.json")
64
