  18 # A. Bollinger %B / z-score 20d (mean reversion candidate)
  19 def zscore_20(df, s):
  20     m = df['close'].rolling(20).mean(); sd = df['close'].rolling(20).std()
  21     return (df['close'] - m) / sd
  22 CANDIDATES['zscore_20'] = zscore_20
  23 
  24 # B. RSI 14 (smoothed momentum oscillator)
  25 def rsi_14(df, s):
  26     d = df['close'].diff()
  27     up = d.clip(lower=0.0).rolling(14).mean()
  28     dn = (-d.clip(upper=0.0)).rolling(14).mean()
  29     rs = up / dn.replace(0, np.nan)
  30     return 100.0 - 100.0 / (1.0 + rs)
  31 CANDIDATES['rsi_14'] = rsi_14
  32 
  33 # C. Amihud illiquidity 20d (mean |ret|/volume), negative for liquidity preference test
  34 def amihud_20(df, s):
  35     r = df['close'].pct_change().abs()
  36     v = df['volume'].replace(0, np.nan)
  37     return (r / v).rolling(20).mean()
  38 CANDIDATES['amihud_illiq_20'] = amihud_20
  39 
  40 # D. Volume-price correlation 60d: corr(daily ret, volume change)
  41 def vol_price_corr_60(df, s):
  42     r = df['close'].pct_change()
  43     vc = df['volume'].pct_change()
  44     return r.rolling(60).corr(vc)
  45 CANDIDATES['vol_price_corr_60'] = vol_price_corr_60
  46 
  47 # E. Garman-Klass vol ratio: 10d efficient vol / 60d efficient vol (vol regime)
  48 def gk_vol_ratio_10x60(df, s):
  49     hl = np.log(df['high'] / df['low'])
  50     co = np.log(df['close'] / df['open'])
  51     gk2 = 0.5 * hl**2 - (2*np.log(2) - 1) * co**2
  52     gk = np.sqrt(gk2.clip(lower=0))
  53     v10 = gk.rolling(10).mean(); v60 = gk.rolling(60).mean()
  54     return v10 / v60.replace(0, np.nan)
  55 CANDIDATES['gk_vol_ratio_10x60'] = gk_vol_ratio_10x60
  56 
  57 # F. Return autocorrelation (lag-1) 60d: serial correlation
  58 def autocorr_60(df, s):
  59     r = df['close'].pct_change()
  60     return r.rolling(60).apply(lambda x: pd.Series(x).autocorr(lag=1), raw=False)
  61 CANDIDATES['autocorr1_60'] = autocorr_60
  62 
  63 # G. Risk-adjusted momentum: mom20 / vol20 (Sharpe-style)
  64 def mom20_vol20(df, s):
  65     m = df['close'].shift(5) / df['close'].shift(25) - 1.0
  66     v = df['close'].pct_change().rolling(20).std()
  67     return m / v.replace(0, np.nan)
  68 CANDIDATES['mom20_risk_adj'] = mom20_vol20
  69 
  70 # H. 52-week high proximity
  71 def high_prox_252(df, s):
  72     return df['close'] / df['close'].rolling(252).max()
  73 CANDIDATES['high_prox_252'] = high_prox_252
  74 
  75 # I. Gap momentum: mean overnight gap (open vs prev close) over 20d
  76 def gap_mom_20(df, s):
  77     g = df['open'] / df['close'].shift(1) - 1.0
  78     return g.rolling(20).mean()
  79 CANDIDATES['gap_mom_20'] = gap_mom_20
  80 
  81 # J. Upper shadow ratio 20d (supply pressure)
  82 def upper_shadow_20(df, s):
  83     hi = df['high']; lo = df['low']; op = df['open']; cl = df['close']
  84     rng = (hi - lo).replace(0, np.nan)
  85     shadow = (hi - np.maximum(op, cl)) / rng
  86     return shadow.rolling(20).mean()
  87 CANDIDATES['upper_shadow_20'] = upper_shadow_20
  88 
  89 # K. Conditional momentum: mom10_skip5 scaled by low-vol regime dummy (vol<20d median)
  90 def mom10_cond_lowvol(df, s):
  91     m = df['close'].shift(5) / df['close'].shift(15) - 1.0
  92     v = df['close'].pct_change().rolling(20).std()
  93     lowvol = (v < v.rolling(60).median()).astype(float)
  94     return m * lowvol
  95 CANDIDATES['mom10_cond_lowvol'] = mom10_cond_lowvol
  96 
  97 # L. Downside deviation 20d / total vol 20d (loss aversion proxy)
  98 def downside_ratio_20(df, s):
  99     r = df['close'].pct_change()
 100     dd = r.clip(upper=0.0).rolling(20).std()
 101     td = r.rolling(20).std()
 102     return dd / td.replace(0, np.nan)
 103 CANDIDATES['downside_ratio_20'] = downside_ratio_20
