def max_lib_corr(panel):
    arr = signal_matrix(panel, grid)
    best, best_id = 0.0, None
    for fid, la in lib.items():
        # align artifact (built on a sub-grid of the canonical grid) by tail overlap
        if la.shape[0] < arr.shape[0]:
