    'vix_beta_cond_60x20':  (f_vixbeta, {'beta_window': 60, 'move_window': 20}, '-beta(ret,VIX_ret,60)*(VIX/VIX.shift(20)-1)'),
    'vol_of_vol20x60':      (f_vol_of_vol, {'short_win': 20, 'long_win': 60}, 'STD60(STD20(ret))'),
