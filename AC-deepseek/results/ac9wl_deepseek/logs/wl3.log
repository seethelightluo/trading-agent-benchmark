239 def evaluate_candidate(factor_id, factor_fn, prices, library_panels=None, print_out=True):
240     """One-idea validation battery. Returns metrics dict or None."""
241     panel = factor_to_panel(factor_fn, prices)
242     m = validate_factor(factor_id, panel, prices)
243     if m is None:
244         if print_out:
245             print(f"{factor_id}: insufficient data -> None")
246         return None, panel
247     if library_panels is None:
248         library_panels = build_library_panels(prices)
249     rho, fid = max_library_correlation(panel, library_panels)
250     m['max_abs_library_correlation'] = rho
251     m['max_corr_library_id'] = fid
252     if print_out:
253         print(f"Factor {factor_id}: panel {panel.shape} range {panel.index.min()}..{panel.index.max()}")
254         print(json.dumps({k: v for k, v in m.items() if k != 'decay_ic_by_horizon'}, indent=2, default=str))
255         print("decay:", json.dumps(m['decay_ic_by_horizon'], default=str))
256         ok = abs(m['ic']) >= 0.007 and abs(m['icir']) >= 0.084
257         print(f"ADMISSION: |IC|={abs(m['ic']):.4f}>=0.007 {abs(m['ic'])>=0.007} | |ICIR|={abs(m['icir']):.4f}>=0.084 {abs(m['icir'])>=0.084} -> {'PASS' if ok else 'FAIL'}")
258     return m, panel
