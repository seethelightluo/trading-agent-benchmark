1| """Shared data loading + IC validation framework for the 15-asset cross-asset universe.
   2| 
   3| All data comes from the simulator API (no future data). Validation window is
   4| restricted to research warm-up 2020-01-01..2026-07-15 to match library factors.
   5| 
   6| Also provides signal-artifact persistence: every persisted factor JSON must be
   7| accompanied by a recoverable 2D signal matrix (n_dates x 15) stored on a shared
   8| canonical date grid so the deterministic gate can recompute pairwise rho.
   9| """
  10| import json
  11| import numpy as np
  12| import pandas as pd
  13| from pathlib import Path
  14| from alphacrafter.sim.utils import get_stock_daily_data, get_index_daily_data
  15| 
  16| WATCHLIST = ['000300.SH', 'SPX', 'HSI', 'N225', 'SX5E', '000688.SH', 'SOX', 'NDX',
  17|              'XAU', 'COPPER', 'WTI', 'BTC', 'ETH', 'US10Y', 'CN10Y']
  18| INDEX_SIGNALS = ['DXY', 'USDCNY', 'USDJPY', 'EURUSD', 'VIX']
  19| VAL_END = pd.Timestamp('2026-07-15')
  20| VAL_START = pd.Timestamp('2020-01-01')
  21| LIBRARY_FACTORS = ['mom_10d_skip5', 'mom_120d_skip5', 'vix_beta_cond_60x20', 'vol_of_vol20x60']
  22| 
  23| _CANON_GRID = None  # cached canonical date grid
  24| 
  25| 
  26| def load_prices(days=2000):
  27|     """Return dict {symbol: df} of daily OHLCV via API (capped at current date)."""
  28|     out = {}
  29|     for s in WATCHLIST:
  30|         try:
  31|             df = get_stock_daily_data(symbol=s, days=days)
  32|             if df is not None and len(df) >= 30:
  33|                 df = df.copy()
  34|                 df['date'] = pd.to_datetime(df['date'])
  35|                 df = df.set_index('date')
  36|                 for c in ['open', 'close', 'high', 'low', 'volume']:
  37|                     df[c] = pd.to_numeric(df[c], errors='coerce')
  38|                 out[s] = df
  39|         except Exception:
  40|             pass
  41|     return out
  42| 
  43| 
  44| def load_index(symbol, days=2000, prices=None):
