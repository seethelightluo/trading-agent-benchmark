    m['max_corr_library_id'] = lib_id
    ic_s = rank_ic_series(panel, forward_returns(prices, 10))
    ic_s = ic_s[(ic_s.index >= pd.Timestamp('2025-07-15')) & (ic_s.index <= pd.Timestamp('2026-07-15'))]
    if len(ic_s) > 30:
