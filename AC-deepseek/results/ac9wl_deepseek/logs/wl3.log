            xc = xv - xv.mean(); yc = yv - yv.mean()
            den = np.sqrt((xc * xc).sum() * (yc * yc).sum())
            if den > 0:
                ic.append((xc * yc).sum() / den)
                dates.append(t)
    return pd.Series(ic, index=grid[dates])

def validate(fid, panel):
    if panel is None or len(panel) == 0:
