  71 def canonical_grid(prices):
  72     """Sorted union of all trading dates within the validation window.
  73 
  74     Every persisted factor artifact must use this exact grid (n_dates x 15) so
  75     the gate's pairwise Spearman comparison sees identical shapes.
  76     """
  77     global _CANON_GRID
  78     if _CANON_GRID is not None:
  79         return _CANON_GRID
  80     idx = set()
  81     for s, df in prices.items():
  82         idx.update(df.index)
  83     grid = pd.DatetimeIndex(sorted(idx))
  84     grid = grid[(grid >= VAL_START) & (grid <= VAL_END)]
  85     _CANON_GRID = grid
  86     return grid
  87 
  88 
  89 def signal_matrix(panel, grid=None, prices=None):
  90     """Reindex factor panel to the canonical grid -> (n_dates, 15) float matrix.
  91 
  92     Missing values become NaN; column order is fixed to WATCHLIST order so every
  93     factor artifact is directly comparable shape-wise.
  94     """
  95     if grid is None:
  96         grid = canonical_grid(prices)
  97     m = panel.reindex(grid)
  98     for c in WATCHLIST:
  99         if c not in m.columns:
 100             m[c] = np.nan
 101     return m[WATCHLIST].values.astype(float)
