96:         b = z['r'].rolling(60).cov(z['a']) / z['a'].rolling(60).var()
97:         mom = (anchor_close / anchor_close.shift(20) - 1.0).reindex(df.index)
98:         return (sign * b * mom).reindex(df.index)
99:     return f
100: 
101: def f_hilo(df, s, w=60):
102:     hi = df['high'].rolling(w).max(); lo = df['low'].rolling(w).min()
103:     return (df['close'] - lo) / (hi - lo).replace(0, np.nan)
