109 def adx_14(df, s):
110     h, l, c = df['high'], df['low'], df['close']
111     pc = c.shift(1)
112     tr = pd.concat([(h - l), (h - pc).abs(), (l - pc).abs()], axis=1).max(axis=1)
113     up = h.diff()
114     dn = -l.diff()
115     pdm = np.where((up > dn) & (up > 0), up, 0.0)
116     ndm = np.where((dn > up) & (dn > 0), dn, 0.0)
117     atr = tr.ewm(alpha=1 / 14, adjust=False).mean()
118     pdi = 100 * pd.Series(pdm, index=df.index).ewm(alpha=1 / 14, adjust=False).mean() / atr.replace(0, np.nan)
119     ndi = 100 * pd.Series(ndm, index=df.index).ewm(alpha=1 / 14, adjust=False).mean() / atr.replace(0, np.nan)
120     dx = 100 * (pdi - ndi).abs() / (pdi + ndi).replace(0, np.nan)
121     return dx.ewm(alpha=1 / 14, adjust=False).mean()
