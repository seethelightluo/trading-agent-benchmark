s):\n    r = df['close'].pct_change()\n    return r.rolling(20).skew() - r.rolling(60).skew()\ndef f_mom120(df, s): return df['close'].shift(5) / df['close'].shift(125) - 1.0\ndef f_volvol(df, s): return df['close'].pct_change().rolling(20).std().rolling(60).std()\n\nFNS = {\n 'bollinger_z_20d': f_boll, 'rsi_14d': f_rsi, 'dxy_beta_cond_60x20': f_dxyb,\n 'high_low_range_pos_20': f_hilo, 'vol_adj_mom_20_60': f_vam,\n 'upper_wick_10': f_upper_wick_10, 'max_ret_20d': f_max_ret_20,\n 'bw_zscore_20_60': f_bw_zscore, 'skew_term_20_60': f_skew_term,\n 'mom_120d_skip5': f_mom120, 'vol_of_vol20x60': f_volvol,\n}\npanels = {k: factor_to_panel(fn, prices) for k, fn in FNS.items()}\n\ndef pair_corr(pa, pb):\n    df = pd.concat({'x': pa, 'y': pb}, axis=1)\n    x = df['x'].rank(axis=1); y = df['y'].rank(axis=1)\n    valid = df['x'].notna() & df['y'].notna() & np.isfinite(df['x']) & np.isfinite(df['y'])\n    n = valid.sum(axis=1)\n    x = x.where(valid); y = y.where(valid)\n    mx = x.mean(axis=1); my = y.mean(axis=1)\n    cov = ((x.sub(mx, axis=0)) * (y.sub(my, axis=0))).sum(axis=1) / (n - 1)\n    vx = ((x.sub(mx, axis=0)) ** 2).sum(axis=1) / (n - 1)\n    vy = ((y.sub(my, axis=0)) ** 2).sum(axis=1) / (n - 1)\n    ic = cov / np.sqrt(vx * vy)\n    return ic.where((n >= 8) & (vx > 0) & (vy > 0)).dropna().mean()\n\nids = list(FNS)\nprint('pairwise mean daily Spearman rho (abs):')\nmaxrho = {}\nfor i in range(len(ids)):\n    row = []\n    for j in range(len(ids)):\n        if i == j:\n            row.append(0.0); continue\n        r = pair_corr(panels[ids[i]], panels[ids[j]])\n        row.append(abs(float(r)))\n    print('%-22s' % ids[i], ' '.join('%.2f' % x for x in row))\n    mx = max(row)\n    if mx > 0.5:\n        maxrho[ids[i]] = mx\nprint('pairs above 0.5:', maxrho)\n\n# update persisted JSONs with self-reported provenance rho vs full library\nfor fid in ids:\n    p = f'factors/{fid}.json'\n    d = json.load(open(p))\n    others = [ids[j] for j in range(len(ids)) if ids[j] != fid]\n    best = 0.0; best_id = None\n    for o in others:\n        r = abs(float(pair_corr(panels[fid], panels[o])))\n        if r > best: best, best_id = r, o\n    d['validation']['metrics']['max_abs_library_correlation'] = round(best, 4)\n    d['validation']['metrics']['max_corr_library_id'] = best_id\n    json.dump(d, open(p, 'w'), indent=2, default=str)\n    print('updated', fid, 'max rho = %.4f (%s)' % (best, best_id))\nEOF"})
