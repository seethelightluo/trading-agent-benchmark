70 def canonical_grid(prices):
71     """Sorted union of all trading dates within the validation window.
72 
73     Every persisted factor artifact must use this exact grid (n_dates x 15) so
74     the gate's pairwise Spearman comparison sees identical shapes.
75     """
76     global _CANON_GRID
77     if _CANON_GRID is not None:
78         return _CANON_GRID
79     idx = set()
80     for s, df in prices.items():
81         idx.update(df.index)
82     grid = pd.DatetimeIndex(sorted(idx))
83     grid = grid[(grid >= VAL_START) & (grid <= VAL_END)]
84     _CANON_GRID = grid
85     return grid
86 
87 
88 def signal_matrix(panel, grid=None, prices=None):
89     """Reindex factor panel to the canonical grid -> (n_dates, 15) float matrix.
90 
91     Missing values become NaN; column order is fixed to WATCHLIST order so every
92     factor artifact is directly comparable shape-wise.
93     """
94     if grid is None:
95         grid = canonical_grid(prices)
96     m = panel.reindex(grid)
97     for c in WATCHLIST:
98         if c not in m.columns:
99             m[c] = np.nan
100     return m[WATCHLIST].values.astype(float)
101 
102 
103 def save_signal_artifact(panel, grid, path):
104     """Persist factor signal matrix as .npy; returns the matrix."""
105     arr = signal_matrix(panel, grid)
106     path = Path(path)
107     path.parent.mkdir(parents=True, exist_ok=True)
108     np.save(path, arr)
109     return arr
110 
111 
112 def factor_to_panel(factor_fn, prices, index_dict=None):
113     """Apply factor_fn(df, symbol) to each asset, return wide panel aligned on dates."""
114     cols = {}
115     for s, df in prices.items():
116         try:
117             ser = factor_fn(df, s)
118             if ser is not None and len(ser) > 0:
119                 cols[s] = ser.astype(float)
