36: # ---------------------------------------------------------------- helpers ----
37: def rank_ic_series(panel, fr, min_valid=8):
38:     common = panel.index.intersection(fr.index)
39:     ic = {}
40:     for d in common:
41:         x, y = panel.loc[d], fr.loc[d]
42:         m = x.notna() & y.notna() & np.isfinite(x) & np.isfinite(y)
43:         if m.sum() >= min_valid:
44:             ic[d] = x[m].rank().corr(y[m].rank())
45:     return pd.Series(ic).sort_index()
46: 
47: def validate(panel):
48:     ic_s = {h: rank_ic_series(panel, fwd[h]) for h in fwd}
49:     ic10 = ic_s[10]
50:     full = ic10[(ic10.index >= VAL_START) & (ic10.index <= VAL_END)]
51:     m = float(full.mean()); sd = float(full.std(ddof=1))
52:     icir = m / sd if sd > 0 else 0.0
53:     hit = float((full > 0).mean()) if m >= 0 else float((full < 0).mean())
54:     fac = panel[(panel.index >= VAL_START) & (panel.index <= VAL_END)]
55:     cov = float(fac.notna().sum().sum()) / (fac.shape[0] * fac.shape[1])
56:     ge8 = float((fac.notna().sum(axis=1) >= 8).mean())
57:     ranked = fac.rank(axis=1)
58:     turn = float(ranked.diff(10).abs().mean().mean()) if len(ranked) > 10 else float('nan')
59:     decay = {str(h): (float(ic_s[h].mean()) if len(ic_s[h]) else float('nan')) for h in fwd}
60:     return dict(ic=m, icir=icir, ic_hit_ratio=hit, n=int(len(full)), cov=cov, ge8=ge8,
61:                 turn=turn, decay=decay)
62: 
63: def pairwise_rho_vs_library(panel, lib_panels):
64:     best, best_id = 0.0, None
65:     for fid, lp in lib_panels.items():
66:         idx = panel.index.intersection(lp.index)
67:         corrs = []
68:         for d in idx:
69:             x, y = panel.loc[d], lp.loc[d]
70:             m = x.notna() & y.notna() & np.isfinite(x) & np.isfinite(y)
71:             if m.sum() >= 8:
72:                 c = x[m].rank().corr(y[m].rank())
73:                 if np.isfinite(c):
74:                     corrs.append(c)
75:         if corrs:
76:             r = float(np.mean(corrs))
77:             if abs(r) > best:
78:                 best, best_id = abs(r), fid
79:     return best, best_id
