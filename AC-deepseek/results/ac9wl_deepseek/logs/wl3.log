          f"1y={m.get('recent_1y_ic', float('nan')):+.4f} t={time.time()-ta:.1f}s -> {'PASS' if ok else 'FAIL'}", flush=True)
    print("   decay:", {k: round(v, 4) for k, v in m['decay_ic_by_horizon'].items()}, flush=True)
