53         if la.shape[0] < arr.shape[0]:
54             arr_use = arr[-la.shape[0]:]
55         else:
56             arr_use = arr
57         corrs = []
58         for i in range(arr_use.shape[0]):
59             x, y = arr_use[i], la[i]
60             m = np.isfinite(x) & np.isfinite(y)
61             if m.sum() >= 8:
62                 r = pd.Series(x[m]).rank().corr(pd.Series(y[m]).rank())
63                 if np.isfinite(r):
64                     corrs.append(r)
65         if corrs:
66             r = float(np.mean(corrs))
67             if abs(r) > best:
68                 best, best_id = abs(r), fid
69     return best, best_id
