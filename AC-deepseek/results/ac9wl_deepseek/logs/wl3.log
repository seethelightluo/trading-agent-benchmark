1 """Shared data loading + IC validation framework for the 15-asset cross-asset universe.
2 
3 All data comes from the simulator API (no future data). Validation window is
4 restricted to research warm-up 2020-01-01..2026-07-15 to match library factors.
5 
6 Also provides signal-artifact persistence: every persisted factor JSON must be
7 accompanied by a recoverable 2D signal matrix (n_dates x 15) stored on a shared
8 canonical date grid so the deterministic gate can recompute pairwise rho.
9 """
10 import json
11 import numpy as np
12 import pandas as pd
13 from pathlib import Path
14 from alphacrafter.sim.utils import get_stock_daily_data, get_index_daily_data
15 
16 WATCHLIST = ['000300.SH', 'SPX', 'HSI', 'N225', 'SX5E', '000688.SH', 'SOX', 'NDX',
17              'XAU', 'COPPER', 'WTI', 'BTC', 'ETH', 'US10Y', 'CN10Y']
18 INDEX_SIGNALS = ['DXY', 'USDCNY', 'USDJPY', 'EURUSD', 'VIX']
19 VAL_END = pd.Timestamp('2026-07-15')
20 VAL_START = pd.Timestamp('2020-01-01')
21 LIBRARY_FACTORS = ['mom_10d_skip5', 'mom_120d_skip5', 'vix_beta_cond_60x20', 'vol_of_vol20x60']
22 
23 _CANON_GRID = None  # cached canonical date grid
24 
25 
26 def load_prices(days=2000):
27     """Return dict {symbol: df} of daily OHLCV via API (capped at current date)."""
28     out = {}
29     for s in WATCHLIST:
30         try:
31             df = get_stock_daily_data(symbol=s, days=days)
32             if df is not None and len(df) >= 30:
33                 df = df.copy()
34                 df['date'] = pd.to_datetime(df['date'])
35                 df = df.set_index('date')
36                 for c in ['open', 'close', 'high', 'low', 'volume']:
37                     df[c] = pd.to_numeric(df[c], errors='coerce')
38                 out[s] = df
39         except Exception:
40             pass
41     return out
42 
43 
44 def load_index(symbol, days=2000, prices=None):
45     """Load observation-only index signal; falls back to persistent CSV capped at
46     the max date visible in the tradable price history (no future data)."""
47     try:
48         df = get_index_daily_data(symbol=symbol, days=days)
49         if df is not None and len(df) >= 30:
50             df = df.copy()
51             df['date'] = pd.to_datetime(df['date'])
52             df = df.set_index('date')
53             df['close'] = pd.to_numeric(df['close'], errors='coerce')
54             return df
55     except Exception:
56         pass
57     # CSV fallback (persistent/index_data), capped at visible horizon
58     try:
59         path = Path('../persistent/index_data') / f'{symbol}.csv'
60         df = pd.read_csv(path, parse_dates=['date'])
61         df = df.set_index('date').sort_index()
62         df['close'] = pd.to_numeric(df['close'], errors='coerce')
63         if prices is not None:
64             visible = max(dd.index.max() for dd in prices.values())
65             df = df[df.index <= visible]
66         return df
67     except Exception:
68         return None
69 
70 
71 def canonical_grid(prices):
72     """Sorted union of all trading dates within the validation window.
73 
74     Every persisted factor artifact must use this exact grid (n_dates x 15) so
75     the gate's pairwise Spearman comparison sees identical shapes.
76     """
77     global _CANON_GRID
78     if _CANON_GRID is not None:
79         return _CANON_GRID
80     idx = set()
81     for s, df in prices.items():
82         idx.update(df.index)
83     grid = pd.DatetimeIndex(sorted(idx))
84     grid = grid[(grid >= VAL_START) & (grid <= VAL_END)]
85     _CANON_GRID = grid
86     return grid
87 
88 
89 def signal_matrix(panel, grid=None, prices=None):
90     """Reindex factor panel to the canonical grid -> (n_dates, 15) float matrix.
91 
92     Missing values become NaN; column order is fixed to WATCHLIST order so every
93     factor artifact is directly comparable shape-wise.
94     """
95     if grid is None:
96         grid = canonical_grid(prices)
97     m = panel.reindex(grid)
98     for c in WATCHLIST:
99         if c not in m.columns:
100             m[c] = np.nan
101     return m[WATCHLIST].values.astype(float)
102 
103 
104 def save_signal_artifact(panel, grid, path):
105     """Persist factor signal matrix as .npy; returns the matrix."""
106     arr = signal_matrix(panel, grid)
107     path = Path(path)
108     path.parent.mkdir(parents=True, exist_ok=True)
109     np.save(path, arr)
110     return arr
111 
112 
113 def factor_to_panel(factor_fn, prices, index_dict=None):
114     """Apply factor_fn(df, symbol) to each asset, return wide panel aligned on dates."""
115     cols = {}
116     for s, df in prices.items():
117         try:
118             ser = factor_fn(df, s)
119             if ser is not None and len(ser) > 0:
120                 cols[s] = ser.astype(float)

