            },
        },
    }
    Path('factors') / f'{fid}.json'
    out = Path('factors') / f'{fid}.json'
    out.write_text(json.dumps(payload, indent=2, default=str), encoding='utf-8')
    print(f"  PERSISTED -> {out}")
print("\ndone.")

