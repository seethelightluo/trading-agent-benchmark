        results[fid] = dict(ok=False, metrics={'ic': float('nan'), 'icir': float('nan'), 'error': str(e)})
        continue"""
assert old in src, "pattern not found"
src = src.replace(old, new)
open('scripts/miner_3_20260730_screen_round9_novel.py', 'w').write(src)
print("patched OK")
