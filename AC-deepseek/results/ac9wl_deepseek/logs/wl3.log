    delta = df['close'].diff()
    up = delta.clip(lower=0.0)
    dn = (-delta).clip(lower=0.0)
    au = up.rolling(60).mean()
    ad = dn.rolling(60).mean()
    rs = au / ad.replace(0, np.nan)
    return 100 - 100 / (1 + rs)

