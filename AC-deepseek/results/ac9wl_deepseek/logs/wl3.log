  ▶️ shell({'command': 'python - <<\'EOF\'\nimport pandas as pd, numpy as np, json, glob\n\n# Load all price series\ndef load(sym, d=\'../persistent/stock_data\'):\n    df = pd.read_csv(f\'{d}/{sym}.csv\', parse_dates=[\'date\'])\n    df = df.set_index(\'date\').sort_index()\n    return df[\'close\']\n\nassets = [\'000300.SH\',\'SPX\',\'HSI\',\'N225\',\'SX5E\',\'000688.SH\',\'SOX\',\'NDX\',\'XAU\',\'COPPER\',\'WTI\',\'BTC\',\'ETH\',\'US10Y\',\'CN10Y\']\npx = pd.DataFrame({a: load(a) for a in assets}).dropna(how=\'all\')\nprint("price range:", px.index.min(), "->", px.index.max(), "n=", len(px))\nprint("last date:", px.index[-1])\n\n# Use last 130 trading days for regime\npxw = px.iloc[-130:]\nrets = pxw.pct_change().dropna()\n\n# 1) Trend: 60d and 20d returns per asset\nr20 = px.iloc[-1]/px.iloc[-21]-1\nr60 = px.iloc[-1]/px.iloc[-61]-1\nr120 = px.iloc[-1]/px.iloc[-121]-1\nprint("\\n=== Returns (last 20/60/120d) ===")\nfor a in assets:\n    if a in px.index: pass\n    print(f"{a:12s} r20={r20.get(a,np.nan)*100:7.2f}%  r60={r60.get(a,np.nan)*100:7.2f}%  r120={r120.get(a,np.nan)*100:7.2f}%")\n\n# 2) Volatility: ann realized vol over 20d and 60d\nrv20 = rets.iloc[-20:].std()*np.sqrt(252)\nrv60 = rets.iloc[-60:].std()*np.sqrt(252)\nprint("\\n=== Realized vol (ann, 20d/60d) ===")\nfor a in assets:\n    print(f"{a:12s} rv20={rv20.get(a,np.nan)*100:6.1f}%  rv60={rv60.get(a,np.nan)*100:6.1f}%")\n\n# 3) Cross-asset correlation (60d)\nc = rets.iloc[-60:].corr()\nprint("\\n=== Avg pairwise corr (60d) ===", round(c.values[np.triu_indices(len(c),1)].mean(),3))\nprint("=== Corr vs SPX (60d) ===")\nfor a in assets:\n    print(f"{a:12s} corr_spx={c.loc[a,\'SPX\']:.2f}")\n\n# 4) Trend of SPX: MA slope\nspx = px[\'SPX\']\nma20 = spx.iloc[-20:].mean(); ma60 = spx.iloc[-60:].mean(); ma120 = spx.iloc[-120:].mean()\nprint("\\nSPX last close:", round(spx.iloc[-1],1), "MA20:", round(ma20,1), "MA60:", round(ma60,1), "MA120:", round(ma120,1))\nprint("SPX above MA20:", spx.iloc[-1]>ma20, "above MA60:", spx.iloc[-1]>ma60, "above MA120:", spx.iloc[-1]>ma120)\n# consecutive up days\nsign = np.sign(rets[\'SPX\'])\nlast5 = sign.iloc[-5:].tolist()\nprint("SPX last 5 day signs:", last5)\nEOF'})
