  ▶️ shell({'command': "python << 'EOF'\nimport pandas as pd, numpy as np, glob\n\nassets = ['000300.SH','SPX','HSI','N225','SX5E','000688.SH','SOX','NDX','XAU','COPPER','WTI','BTC','ETH','US10Y','CN10Y']\npx = {}\nfor a in assets:\n    df = pd.read_csv(f'../persistent/stock_data/{a}.csv')\n    df['date'] = pd.to_datetime(df['date'])\n    df = df.set_index('date').sort_index()\n    px[a] = df['close']\n\nPX = pd.DataFrame(px).dropna(how='all')\nPX = PX[PX.index <= '2026-07-29']\nret = PX.pct_change()\n\nprint('=== LEVELS (last close 2026-07-29) ===')\nprint(PX.iloc[-1].round(2).to_string())\n\nprint('\\n=== TREND: return over 20d / 60d / 120d (%) ===')\nfor w in [20,60,120]:\n    r = (PX.iloc[-1]/PX.iloc[-1-w] - 1)*100\n    print(f'{w}d:', r.round(2).to_dict())\n\nprint('\\n=== VOLATILITY: 20d realized ann. (%) ===')\nvol20 = ret.tail(20).std()*np.sqrt(252)*100\nprint(vol20.round(1).to_string())\n\nprint('\\n=== VIX / DXY / macro observation ===')\nfor m in ['VIX','DXY','USDJPY','EURUSD','USDCNY']:\n    df = pd.read_csv(f'../persistent/index_data/{m}.csv')\n    df['date'] = pd.to_datetime(df['date'])\n    df = df.set_index('date').sort_index()\n    df = df[df.index <= '2026-07-29']\n    last = df['close'].iloc[-1]\n    prev20 = df['close'].iloc[-21]\n    print(f'{m}: last={last:.2f}, 20d chg={100*(last/prev20-1):+.2f}%')\n\nprint('\\n=== CROSS-SECTIONAL DISPERSION (stdev of 20d ret across 15 assets, %) ===')\ndisp20 = ret.tail(20).mean(axis=1).std()*100\nprint(f'dispersion of mean daily ret: {disp20:.3f}')\n\nprint('\\n=== AVG PAIRWISE CORR (60d window, daily ret) ===')\nc = ret.tail(60).corr()\nvals = c.values[np.triu_indices_from(c.values, k=1)]\nprint(f'mean pairwise corr: {np.nanmean(vals):.3f}, median: {np.nanmedian(vals):.3f}')\n\nprint('\\n=== REGIME: consecutive up/down days for SPX & 000300 ===')\nfor a in ['SPX','000300.SH']:\n    s = ret[a].tail(10)\n    print(a, 'last 10d signs:', ''.join(['+' if x>0 else '-' if x<0 else '0' for x in s]))\n\n# MA slope check\nprint('\\n=== MA20 slope (5d change in MA20, %) ===')\nfor a in ['SPX','000300.SH','HSI','N225','SX5E','BTC','XAU','WTI']:\n    ma20 = PX[a].rolling(20).mean()\n    slope = (ma20.iloc[-1]/ma20.iloc[-6]-1)*100\n    print(f'{a}: MA20 slope {slope:+.2f}%')\nEOF"})
