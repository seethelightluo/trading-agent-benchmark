  ▶️ shell({'command': 'python - <<\'EOF\'\nimport pandas as pd, numpy as np, glob, os\n\n# Load all 15 watchlist assets + VIX\nassets = [\'000300.SH\',\'SPX\',\'HSI\',\'N225\',\'SX5E\',\'000688.SH\',\'SOX\',\'NDX\',\'XAU\',\'COPPER\',\'WTI\',\'BTC\',\'ETH\',\'US10Y\',\'CN10Y\']\ndata = {}\nfor a in assets:\n    df = pd.read_csv(f\'../persistent/stock_data/{a}.csv\')\n    df[\'date\'] = pd.to_datetime(df[\'date\'])\n    df = df.sort_values(\'date\').set_index(\'date\')\n    data[a] = df[\'close\']\n\npx = pd.DataFrame(data)\nvix = pd.read_csv(\'../persistent/index_data/VIX.csv\')\nvix[\'date\'] = pd.to_datetime(vix[\'date\'])\nvix = vix.set_index(\'date\')[\'close\']\n\nprint("Latest dates per asset:")\nprint(px.index.max(), "| VIX last:", vix.index.max())\n\n# Use data through current visible date 2026-07-29\ncur = pd.Timestamp(\'2026-07-29\')\npx = px[px.index <= cur]\nvix = vix[vix.index <= cur]\n\nrets = px.pct_change().dropna(how=\'all\')\n\n# Regime assessment on recent 60 trading days\nfor label, win in [(\'60d\', 60), (\'120d\', 120), (\'250d\', 250)]:\n    r = rets.tail(win)\n    print(f"\\n=== {label} ===")\n    ann = r.mean() * 252\n    vol = r.std() * np.sqrt(252)\n    tot = (1+r).prod() - 1\n    for a in assets:\n        if a in px.columns:\n            print(f"{a:<10} ann_ret={ann[a]*100:>7.1f}%  ann_vol={vol[a]*100:>6.1f}%  tot={tot[a]*100:>7.1f}%")\n\n# trend strength: MA slope\nprint("\\n=== Trend (MA20 slope over last 10d, pct) ===")\nma20 = px.rolling(20).mean()\nslope = (ma20.iloc[-1] / ma20.iloc[-11] - 1) * 100\nprint(slope.round(2).to_string())\n\n# VIX level\nprint("\\nVIX last:", vix.iloc[-1].round(2), "| 60d mean:", vix.tail(60).mean().round(2), "| 20d mean:", vix.tail(20).mean().round(2))\nEOF'})
