    'amihud_illiq_20d': amihud_illiq_20d,
    'gk_vol_ratio_10_60': gk_vol_ratio_10_60,
    'downside_vol_ratio_60': downside_vol_ratio_60,
    'dd_depth_60': dd_depth_60,
}

