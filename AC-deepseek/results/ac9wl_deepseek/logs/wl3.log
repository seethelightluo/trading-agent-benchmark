  ▶️ shell({'command': "python << 'EOF'\nimport pandas as pd, numpy as np, glob\n\nfiles = sorted(glob.glob('../persistent/stock_data/*.csv'))\nprint('assets:', [f.split('/')[-1][:-4] for f in files])\n\ndef load(sym):\n    df = pd.read_csv(f'../persistent/stock_data/{sym}.csv')\n    df.columns = [c.strip().lower() for c in df.columns]\n    df['date'] = pd.to_datetime(df['date'])\n    df = df.sort_values('date').reset_index(drop=True)\n    return df\n\ndata = {}\nfor f in files:\n    sym = f.split('/')[-1][:-4]\n    data[sym] = load(sym)\n\n# align on common trading dates (last 100 rows of SPX as reference)\nref = data['SPX']['date']\nprint('last date:', ref.iloc[-1], 'n_days:', len(ref))\n\nrets = {}\nfor sym, df in data.items():\n    df = df.set_index('date')\n    df = df.reindex(ref).ffill()\n    rets[sym] = df['close'].pct_change()\n\nR = pd.DataFrame(rets)\nR = R.dropna(how='all')\n\n# Regime metrics over last 60 trading days\nrecent = R.tail(60)\nprint('\\n=== Last 60d per-asset ===')\nprint('60d cumulative return (%):')\nprint((recent+1).prod().sub(1).mul(100).round(1))\nprint('\\n20d realized vol (ann %):')\nprint(recent.tail(20).std().mul(np.sqrt(252)*100).round(1))\nprint('\\n60d realized vol (ann %):')\nprint(recent.std().mul(np.sqrt(252)*100).round(1))\n\n# Trend: MA20 vs MA60 slope on price\nprint('\\n=== Trend ===')\nfor sym in ['SPX','NDX','HSI','N225','000300.SH','000688.SH','BTC','ETH','XAU','COPPER','WTI','SX5E','SOX','US10Y','CN10Y']:\n    df = data[sym].set_index('date').reindex(ref).ffill()\n    px = df['close']\n    ma20 = px.rolling(20).mean(); ma60 = px.rolling(60).mean()\n    last = px.iloc[-1]; m20 = ma20.iloc[-1]; m60 = ma60.iloc[-1]\n    slope = (ma20.iloc[-1]-ma20.iloc[-6])/ma20.iloc[-6]*100\n    trend = 'UP' if last>m20>m60 else ('DOWN' if last<m20<m60 else 'MIXED')\n    print(f'{sym:10s} px={last:10.1f} MA20={m20:10.1f} MA60={m60:10.1f} 20d-slope%={slope:6.2f} trend={trend}')\nEOF"})
