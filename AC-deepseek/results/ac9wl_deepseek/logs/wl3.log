def ranks(d):
    valid = sorted((float(v), a) for a, v in d.items() if v is not None and math.isfinite(float(v)))
    out = {a: np.nan for a in assets}
    for i, (_, a) in enumerate(valid):
        out[a] = i / max(1, len(valid) - 1)
    return out

score = {a: 0.0 for a in assets}
