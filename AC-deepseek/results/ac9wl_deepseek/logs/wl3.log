def make_vam(lookback, skip, vol_win):
    def f(df, s):
        close = df['close']
        mom = close.shift(skip) / close.shift(skip + lookback) - 1.0
        vol = close.pct_change().rolling(vol_win).std()
        return mom / vol
    return f

