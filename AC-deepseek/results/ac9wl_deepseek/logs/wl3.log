  ▶️ shell({'command': 'python - <<\'EOF\'\nimport pandas as pd, numpy as np, glob, os\n\ndef load(sym):\n    df = pd.read_csv(f\'../persistent/stock_data/{sym}.csv\')\n    df.columns = [c.strip().lower() for c in df.columns]\n    df[\'date\'] = pd.to_datetime(df[\'date\'])\n    df = df.sort_values(\'date\').reset_index(drop=True)\n    return df\n\nsyms = [\'SPX\',\'NDX\',\'SOX\',\'000300.SH\',\'000688.SH\',\'HSI\',\'N225\',\'SX5E\',\'XAU\',\'COPPER\',\'WTI\',\'BTC\',\'ETH\',\'US10Y\',\'CN10Y\']\nprint(f"{\'sym\':10s} {\'last\':>10s} {\'5d%\':>7s} {\'10d%\':>7s} {\'20d%\':>7s} {\'60d%\':>7s} {\'ret60_annvol\':>12s} {\'ma20>ma60\':>8s} {\'dist_120d_hi\':>11s}")\nfor s in syms:\n    df = load(s)\n    df = df[df[\'date\'] <= \'2026-07-29\'].tail(200).reset_index(drop=True)\n    c = df[\'close\'].astype(float)\n    last = c.iloc[-1]\n    def pct(n):\n        return (last/c.iloc[-1-n]-1)*100 if len(c)>n else np.nan\n    r = c.pct_change().dropna()\n    annvol = r.tail(60).std()*np.sqrt(252)*100\n    ma20 = c.rolling(20).mean().iloc[-1]\n    ma60 = c.rolling(60).mean().iloc[-1] if len(c)>=60 else np.nan\n    hi120 = c.tail(120).max() if len(c)>=120 else c.max()\n    print(f"{s:10s} {last:10.2f} {pct(5):7.2f} {pct(10):7.2f} {pct(20):7.2f} {pct(60):7.2f} {annvol:12.1f} {str(ma20>ma60):>8s} {(last/hi120-1)*100:10.2f}%")\n\n# macro observation signals\nprint("\\n--- observation signals (last close) ---")\nfor s in [\'DXY\',\'USDCNY\',\'USDJPY\',\'EURUSD\',\'VIX\']:\n    df = pd.read_csv(f\'../persistent/index_data/{s}.csv\')\n    df.columns = [c.strip().lower() for c in df.columns]\n    df[\'date\'] = pd.to_datetime(df[\'date\'])\n    df = df[df[\'date\'] <= \'2026-07-29\'].tail(90).reset_index(drop=True)\n    c = df[\'close\'].astype(float)\n    last = c.iloc[-1]\n    p5 = (last/c.iloc[-6]-1)*100 if len(c)>6 else np.nan\n    p20 = (last/c.iloc[-21]-1)*100 if len(c)>21 else np.nan\n    p60 = (last/c.iloc[-61]-1)*100 if len(c)>61 else np.nan\n    print(f"{s:8s} last={last:9.3f}  5d={p5:6.2f}%  20d={p20:6.2f}%  60d={p60:6.2f}%")\nEOF'})
