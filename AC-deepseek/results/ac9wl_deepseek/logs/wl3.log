    pref={a:.4*(2-i/max(1,TOP-1))/max(vol.get(a,.03) or .03,.003)+.6 for i,a in enumerate(selected) if a not in DEF}
    nondef=[a for a in assets if a not in DEF]; den=sum(pref.get(a,0.) for a in nondef)
