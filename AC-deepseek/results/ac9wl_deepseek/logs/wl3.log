<｜｜DSML｜｜parameter name="content" string="true">"""Restore 4 library factors with signal artifacts + persist 2 new low-rho passes.

Each persisted factor gets {factor_id}.json + {factor_id}_signal.npy on the
shared canonical grid (VAL_START..VAL_END, WATCHLIST column order) so the
deterministic gate can recompute pairwise rho without re-running expressions.

New passes from today's batch screen (rho < 0.5 vs library, both contract
passes):
  - bw_zscore_20_60   : Bollinger bandwidth z-score (vol compression)  IC=0.0445 ICIR=0.139 rho=0.065
  - skew_term_20_60   : skew(20)-skew(60) term structure                IC=0.0263 ICIR=0.085 rho=0.052

Also recompute ensemble weights via quality_ic_tilt over the 6-member library.
"""
import sys
sys.path.insert(0, 'scripts')
import json
import numpy as np
import pandas as pd
from pathlib import Path
from factor_common import (
    load_prices, load_index, factor_to_panel, validate_factor,
    build_library_panels, max_library_correlation, persist_factor,
    canonical_grid, VAL_START, VAL_END,
)

prices = load_prices(days=2000)
lib_panels = build_library_panels(prices)

# ---------- new low-rho candidates ----------
def f_bw_zscore(df, s):
    c = df['close']
    ma = c.rolling(20).mean()
    sd = c.rolling(20).std()
    bw = 2.0 * sd / ma
    mu = bw.rolling(60).mean()
    sig = bw.rolling(60).std()
    return (bw - mu) / sig.replace(0, np.nan)

def f_skew_term(df, s):
    r = df['close'].pct_change()
    return r.rolling(20).skew() - r.rolling(60).skew()

new_factors = [
    ('bw_zscore_20_60',
     f_bw_zscore,
     '2*std20/ma20 z-scored over 60d',
     'Bollinger bandwidth compression signal. Narrow bands historically precede expansion and trend moves; cross-sectionally, assets compressed vs their own history have higher forward 10d returns in this universe (positive IC). Low correlation to existing momentum/vol library (rho=0.065).',
     ['close'],
     {'band': 20, 'z_window': 60},
     1,
     ['volatility', 'regime', 'compression']),
    ('skew_term_20_60',
     f_skew_term,
     'skew(ret,20) - skew(ret,60)',
     'Skewness term structure: short-window skew relative to long-window skew. Positive values mean recent 20d return distribution is more right-skewed than the 60d baseline. Low correlation to library (rho=0.052); positive IC indicates lottery-like upside momenta continue in this cross-asset universe.',
     ['close'],
     {'short_window': 20, 'long_window': 60},
     1,
     ['skewness', 'tail-risk', 'momentum-quality']),
]

saved = {}
for fid, fn, expr, desc, deps, params, direction, tags in new_factors:
    panel = factor_to_panel(fn, prices)
    metrics = validate_factor(fid, panel, prices)
    rho, rid = max_library_correlation(panel, lib_panels)
    metrics['max_abs_library_correlation'] = rho
    metrics['max_corr_library_id'] = rid
    if metrics is None or abs(metrics['ic']) < 0.007 or abs(metrics['icir']) < 0.084 or rho > 0.5:
        print(f"SKIP {fid}: ic={metrics and metrics['ic']:.4f} icir={metrics and metrics['icir']:.4f} rho={rho:.3f}")
        continue
    path, arr = persist_factor(
        fid, fid.replace('_', ' ').title(), expr, desc, deps, params, direction,
        panel, metrics, tags, prices=prices,
        regime_notes=('Validated 2020-01-01..2026-07-15 cross-asset 15-asset universe. '
                      f'Admission IC={metrics["ic"]:.4f} ICIR={metrics["icir"]:.4f} rho={rho:.3f}. '
                      'Signal artifact persisted on canonical grid for gate rho recomputation.'),
    )
    saved[fid] = metrics
    print(f"PERSISTED {fid}: IC={metrics['ic']:.4f} ICIR={metrics['icir']:.4f} rho={rho:.3f} -> {path}")

# ---------- restore 4 library factors with artifacts ----------
def f_mom10(df, s): return df['close'].shift(5) / df['close'].shift(15) - 1.0
def f_mom120(df, s): return df['close'].shift(5) / df['close'].shift(125) - 1.0
def f_volvol(df, s): return df['close'].pct_change().rolling(20).std().rolling(60).std()

vix = load_index('VIX', prices=prices)
def f_vixbeta(df, s):
    if vix is None:
        return None
    r = df['close'].pct_change(); vr = vix['close'].pct_change()
    z = pd.concat([r.rename('r'), vr.rename('v')], axis=1).dropna()
    b = z['r'].rolling(60).cov(z['v']) / z['v'].rolling(60).var()
    return (-b * (vix['close'] / vix['close'].shift(20) - 1.0)).reindex(z.index)

library_cands = [
    ('mom_10d_skip5', f_mom10, 'close.shift(5) / close.shift(15) - 1.0',
     'Short momentum with skip to avoid 1-5d reversal. Trend continuation signature (monotone IC decay to 20d). Founding library factor.',
     ['close'], {'lookback': 10, 'skip': 5}, 1, ['momentum', 'cross-asset']),
    ('mom_120d_skip5', f_mom120, 'close.shift(5) / close.shift(125) - 1.0',
     'Longer-horizon momentum with skip. Complements 10d momentum; both show continuation. Founding library factor.',
     ['close'], {'lookback': 120, 'skip': 5}, 1, ['momentum', 'cross-asset']),
    ('vix_beta_cond_60x20', f_vixbeta, '-beta(asset_ret, VIX_ret, 60) * (VIX/VIX.shift(20)-1)',
     'Conditional macro risk: asset beta to VIX changes times 20d VIX move. Negative IC -> inverse position. Founding library factor.',
     ['close', 'VIX'], {'beta_win': 60, 'vix_win': 20}, -1, ['macro', 'risk-off', 'conditional-beta']),
    ('vol_of_vol20x60', f_volvol, 'std(vol20, 60)',
     'Volatility-of-volatility: instability of the 20d realized vol. Positive IC -> high vol-of-vol assets outperform. Founding library factor.',
     ['close'], {'vol_win': 20, 'volvol_win': 60}, 1, ['volatility', 'cross-asset']),
]

restored = {}
for fid, fn, expr, desc, deps, params, direction, tags in library_cands:
    panel = factor_to_panel(fn, prices)
    metrics = validate_factor(fid, panel, prices)
    if metrics is None:
        print(f"SKIP {fid}: metrics is None")
        continue
    rho, rid = max_library_correlation(panel, lib_panels)
    metrics['max_abs_library_correlation'] = rho
    metrics['max_corr_library_id'] = rid
    path, arr = persist_factor(
        fid, fid.replace('_', ' ').title(), expr, desc, deps, params, direction,
        panel, metrics, tags, prices=prices,
        regime_notes='Original library member; quarantined only for missing signal artifact. Re-persisted with canonical .npy artifact 2026-07-30. Validation window 2020-01-01..2026-07-15.',
    )
    restored[fid] = metrics
    print(f"RESTORED {fid}: IC={metrics['ic']:.4f} ICIR={metrics['icir']:.4f} rho(vs lib)={rho:.3f} -> {path}")

# ---------- quality_ic_tilt ensemble weights ----------
all_m = dict(restored)
all_m.update(saved)
ids = list(all_m.keys())
ics = np.array([all_m[i]['ic'] for i in ids])
icirs = np.array([all_m[i]['icir'] for i in ids])
# tilt: positive ICIR magnitude weighted by abs(IC) (classic quality*IC tilt), normalize
raw = np.maximum(icirs, 0) * np.abs(ics)
if raw.sum() == 0:
    raw = np.abs(ics)
w = raw / raw.sum()
directions = {}
for fid, _, expr, desc, deps, params, direction, tags in library_cands:
    directions[fid] = direction
for fid, _, expr, desc, deps, params, direction, tags in new_factors:
    directions[fid] = direction

selected = []
for i, fid in enumerate(ids):
    selected.append({
        'factor_id': fid,
        'weight': float(w[i]),
        'direction': directions[fid],
    })
selected.sort(key=lambda x: -x['weight'])

ens = {
    'schema_version': 1,
    'selected_factors': selected,
    'method': 'quality_ic_tilt',
    'updated_at': '2026-07-30',
    'note': 'Library restored with signal artifacts. New low-rho additions: bw_zscore_20_60, skew_term_20_60. Gate can now recompute pairwise rho from .npy artifacts.',
}
Path('factors/factor_ensemble.json').write_text(json.dumps(ens, indent=2), encoding='utf-8')
print('ENSEMBLE:')
for s in selected:
    print(f"  {s['factor_id']:22s} weight={s['weight']:.3f} direction={s['direction']:+d}")
print('Saved factors/factor_ensemble.json')
