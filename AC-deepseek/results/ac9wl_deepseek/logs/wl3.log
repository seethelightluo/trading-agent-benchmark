import sys
sys.path.insert(0,'scripts')
from factor_common import load_prices, factor_to_panel, validate_factor
import pandas as pd, numpy as np
prices = load_prices(days=2500)

def updown_range_asym_20(df,s):
    rng = (df['high'] - df['low']) / df['close']
    up = df['close'] >= df['open']
    mu = rng[up].rolling(20).mean()
    md = rng[~up].rolling(20).mean()
    return (mu / md.replace(0, np.nan)).reindex(df.index)

panel = factor_to_panel(updown_range_asym_20, prices)
print(panel.index[:5], panel.index.dtype)
try:
    m = validate_factor('updown_range_asym_20', panel, prices)
    print(m)
except Exception as e:
    import traceback; traceback.print_exc()
