         'vol_adj_mom_20_60': 'Vol-Adjusted Momentum 20x60', 'vol_price_corr_60': 'Return-Volume Corr 60d',
         'wti_beta_60': 'WTI-beta 60d', 'streak_signed': 'Signed Streak Length',
