                'correlation_path': 'validation.metrics.max_abs_library_correlation',
            },
        },
    }
    if extra:
        payload.update(extra)
    path = Path('factors') / f'{factor_id}.json'
    path.parent.mkdir(parents=True, exist_ok=True)
