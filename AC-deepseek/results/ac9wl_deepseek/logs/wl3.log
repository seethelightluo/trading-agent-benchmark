    'intraday_share_20':   (f_intraday_share, {'window': 20}, 'mean20(intraday ret)-mean20(overnight ret)'),
    'rel_str_xau_60':      (f_rel_str_xau, {'window': 60}, 'ret60 - ret60(XAU)'),
