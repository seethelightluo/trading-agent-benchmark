    'down_vol_ratio_20': f_down_vol_ratio_20,
    'parkinson_ratio_20': f_parkinson_ratio_20,
    'cvar_60': f_cvar_60,
    'downside_vol_ratio_60': f_downside_vol_ratio_60,
    'amihud_z_60': f_amihud_z_60,
}

