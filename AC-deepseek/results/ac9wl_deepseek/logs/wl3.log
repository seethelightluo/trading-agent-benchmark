def rank_matrix(arr):
    out = np.full(arr.shape, np.nan)
    for i in range(arr.shape[0]):
        row = arr[i]
        valid = np.isfinite(row)
        if valid.sum() >= 3:
            out[i, valid] = pd.Series(row[valid]).rank().values
    return out

lib_panels = {}
