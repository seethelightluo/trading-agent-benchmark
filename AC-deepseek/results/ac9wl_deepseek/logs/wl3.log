 113 def factor_to_panel(factor_fn, prices, index_dict=None):
 114     """Apply factor_fn(df, symbol) to each asset, return wide panel aligned on dates."""
 115     cols = {}
 116     for s, df in prices.items():
 117         try:
 118             ser = factor_fn(df, s)
 119             if ser is not None and len(ser) > 0:
 120                 cols[s] = ser.astype(float)
 121         except Exception:
 122             pass
 123     if not cols:
 124         return pd.DataFrame()
 125     panel = pd.DataFrame(cols)
 126     panel = panel[~panel.index.duplicated(keep='last')].sort_index()
 127     return panel
 128 
