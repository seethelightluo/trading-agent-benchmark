    den = sum(exps)
    base = {a: exps[i] / den for i, a in enumerate(assets)}

    pref = {}
    for i, a in enumerate(assets):
        if a in DEFENSIVE:
            pref[a] = base[a] + delta / len(DEFENSIVE)
