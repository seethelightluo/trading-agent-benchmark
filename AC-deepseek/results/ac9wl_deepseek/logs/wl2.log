ResponseFunctionToolCall(arguments='{"command": "python -c \\"\\nimport json, numpy as np, os\\nfrom scipy.stats import rankdata\\n\\nens = json.load(open(\'factors/factor_ensemble.json\'))\\nsel = ens[\'selected_factors\']\\n\\ndef load_signal(f):\\n    p = f[\'signal_artifact\']\\n    if not os.path.exists(p):\\n        p = \'factors/\' + f[\'signal_artifact\'].split(\'/\')[-1]\\n    return np.load(p)\\n\\ndef transform(a):\\n    out = a.copy().astype(float)\\n    for i in range(out.shape[0]):\\n        row = out[i]\\n        m = ~np.isnan(row)\\n        if m.sum() == 0: out[i] = 0.0\\n        else:\\n            med = np.nanmedian(row); row[~m] = med\\n            r = rankdata(row) / (len(row) + 1)\\n            out[i] = (r - r.mean()) / (r.std() + 1e-12)\\n    return out\\n\\nnames, T = [], []\\nfor f in sel:\\n    names.append(f[\'factor_id\']); T.append(transform(load_signal(f)))\\ndirs = {f[\'factor_id\']: f[\'direction\'] for f in sel}\\n\\ndef pair_corr(ti, tj, rows):\\n    a, b = ti[rows], tj[rows]\\n    m = ~(np.isnan(a) | np.isnan(b))\\n    return np.corrcoef(a[m], b[m])[0, 1] if m.sum() > 30 else np.nan\\n\\nprint(\'Full pairwise raw rho (last60 window, upper triangle):\')\\nprint(\'%-26s\' % \'\', end=\'\')\\nfor n in names: print(\'%-12s\' % n[:12], end=\'\')\\nprint()\\nfor i in range(len(T)):\\n    print(\'%-26s\' % names[i][:26], end=\'\')\\n    for j in range(len(T)):\\n        if j <= i: print(\'%-12s\' % \'\', end=\'\')\\n        else:\\n            rho = pair_corr(T[i], T[j], slice(-60, None))\\n            print(\'%-12.3f\' % rho, end=\'\')\\n    print()\\nprint()\\nprint(\'Direction-adjusted exposure rho (last60):\')\\nfor i in range(len(T)):\\n    for j in range(i+1, len(T)):\\n        rho = pair_corr(T[i], T[j], slice(-60, None))\\n        expo = dirs[names[i]] * dirs[names[j]] * rho\\n        print(\'  %-24s vs %-24s raw=%+.3f expo=%+.3f\' % (names[i], names[j], rho, expo))\\n\\""}', call_id='call_00_Io4ZdleL4d3a8CW5xs5T5139', name='shell'