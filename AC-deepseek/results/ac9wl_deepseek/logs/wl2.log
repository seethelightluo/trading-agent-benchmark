77: def _rank_z(vals):
78:     """Cross-sectional rank -> [0,1] -> z-score -> winsorize 3 sigma."""
79:     n = len(vals)
80:     valid = sorted((v, i) for i, v in enumerate(vals) if v == v)
81:     ranks = [0.5] * n
82:     nv = len(valid)
83:     for k, (_, i) in enumerate(valid):
84:         ranks[i] = k / max(1, nv - 1)
85:     mean = sum(ranks) / n
86:     var = sum((x - mean) ** 2 for x in ranks) / n
87:     sd = math.sqrt(var) if var > 1e-14 else 1e-12
88:     return [max(-3.0, min(3.0, (x - mean) / sd)) for x in ranks]
