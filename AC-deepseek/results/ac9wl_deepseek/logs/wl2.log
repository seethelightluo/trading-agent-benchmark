47:
48:def _crash_ind(r: pd.Series, th_q: float = Q, w: int = TH, mp: int = 60):
49:    """1 where return < rolling w-day quantile (threshold known at t-1)."""
50:    th = r.rolling(w, min_periods=mp).quantile(th_q).shift(1)
51:    return (r < th).astype(float)
52:
53:
54:def excess_cocrash(s, driver, w=60, mp=30):
55:    """P(driver crash | asset crash) - P(driver crash), rolling w."""
56:    ca = _crash_ind(s)
57:    cd = _crash_ind(driver)
58:    joint = (ca * cd).rolling(w, min_periods=mp).mean()
59:    marg = ca.rolling(w, min_periods=mp).mean()
60:    base = cd.rolling(w, min_periods=mp).mean()
61:    out = joint / marg - base
62:    return out.where(marg >= 0.02)     # require non-degenerate marginal
63:
64:
65:def crash_bounce(s, driver, fwd_h=5, w=60, mp=30):
66:    """Mean fwd_h-day forward return after joint crash days - unconditional mean."""
67:    ca = _crash_ind(s)
68:    cd = _crash_ind(driver)
69:    joint = (ca * cd).astype(float)
70:    fwd = s.shift(-fwd_h) / s - 1.0
71:    cond = (fwd * joint).rolling(w, min_periods=mp).sum() / joint.rolling(w, min_periods=mp).sum()
72:    uncond = fwd.rolling(w, min_periods=mp).mean()
73:    return (cond - uncond).where(joint.rolling(w, min_periods=mp).sum() >= 2)
74:
