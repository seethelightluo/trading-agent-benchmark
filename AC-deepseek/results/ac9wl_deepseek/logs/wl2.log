def spearman(x, y):
    xr = pd.Series(x).rank().values
    yr = pd.Series(y).rank().values
    if len(xr) < 2:
        return np.nan
    sx, sy = xr.std(), yr.std()
    if sx < 1e-12 or sy < 1e-12:
        return np.nan
    return float(np.corrcoef(xr, yr)[0, 1])

