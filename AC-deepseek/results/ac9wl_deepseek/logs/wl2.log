cols = list(panel.columns)
def to_artifact(sig):
    vals = []
    for d in panel.index:
        row = sig.loc[d]
        vals.append([None if pd.isna(v) else round(float(v), 6) for v in row])
    return {"format": "daily_panel", "dates": dates, "columns": cols, "values": vals}

