95         if len(both) < 50:
96             continue
97         rho = float(both['x'].corr(both['y']))
98         if abs(rho) > best:
99             best = abs(rho)
100             names = [fid]
101         elif abs(rho) == best:
102             names.append(fid)
103     return best, names
