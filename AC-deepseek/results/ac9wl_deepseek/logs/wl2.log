# ---- per-asset own-calendar helpers ---------------------------------------
def _down_dev(s, w=60, minp=40):
    r = s.pct_change()
    return r.where(r < 0, 0.0).pow(2).rolling(w, min_periods=minp).mean().pow(0.5)


def _vol(s, w=60, minp=40):
    return s.pct_change().rolling(w, min_periods=minp).std()


def _down_ratio(s, w=60, minp=40):
    r = s.pct_change()
    dd = r.where(r < 0, 0.0).pow(2).rolling(w, min_periods=minp).mean().pow(0.5)
    v = r.rolling(w, min_periods=minp).std()
    return dd / v


def _skew(s, w=60, minp=40):
    return s.pct_change().rolling(w, min_periods=minp).skew()


def _maxdd(s, w=60, minp=40):
    r = s.pct_change()
    dd = np.empty(len(r)) * np.nan
    xa = r.values
    for i in range(len(xa)):
        if i < minp - 1:
            continue
        seg = xa[max(0, i - w + 1): i + 1]
        if np.isnan(seg).any():
            continue
        peak = np.maximum.accumulate(seg)[-1]
        dd[i] = seg[-1] / peak - 1.0
    return pd.Series(dd, index=r.index).abs()


def _reward_dd(s, w=60, minp=40):
    dd = _maxdd(s, w, minp)
    ret = s / s.shift(w) - 1.0
    return ret / dd.replace(0, np.nan)


def _ohlc_pair(c, op, w, minp, mode):
    """Compute overnight/intraday/gap-fade series per asset on own calendar."""
    idx = c.index.intersection(op.index)
    cc, oo = c[idx], op[idx]
    ovn = oo / cc.shift(1) - 1.0
    intr = cc / oo - 1.0
    if mode == "ovn_cum":
        return ((1 + ovn).rolling(w, min_periods=minp).apply(np.prod, raw=True) - 1.0).reindex(panel.index)
    if mode == "int_cum":
        return ((1 + intr).rolling(w, min_periods=minp).apply(np.prod, raw=True) - 1.0).reindex(panel.index)
    if mode == "ovn_share":
        oc = (1 + ovn).rolling(w, min_periods=minp).apply(np.prod, raw=True) - 1.0
        ic = (1 + intr).rolling(w, min_periods=minp).apply(np.prod, raw=True) - 1.0
        return (oc.abs() / (oc.abs() + ic.abs())).reindex(panel.index)
    if mode == "gap_fade":
        return ovn.rolling(w, min_periods=minp).corr(intr).reindex(panel.index)
    raise ValueError(mode)


def ohlc_factor(mode, w=20, minp=12):
    out = {}
    for a in panel.columns:
        c = panel[a].dropna()
        op = open_p[a].reindex(c.index).dropna()
        out[a] = _ohlc_pair(c, op, w, minp, mode)
    return pd.DataFrame(out, index=panel.index)


