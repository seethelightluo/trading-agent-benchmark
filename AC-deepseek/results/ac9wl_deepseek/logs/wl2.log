91:def max_dd_60(s, w=60, mp=30):
92:    """Max peak-to-trough drawdown over rolling w (positive number)."""
93:    def _mdd(x):
94:        x = np.asarray(x, dtype=float)
95:        if len(x) < mp:
96:            return np.nan
97:        peak = np.maximum.accumulate(x)
98:        dd = (x - peak) / peak
99:        return float(-dd.min())
100:    return s.rolling(w, min_periods=mp).apply(_mdd, raw=True)
101:
102:
103:def mdd_adj_mom(s, mom_w=20, dd_w=60, mp=30):
104:    mom = s / s.shift(mom_w) - 1.0
105:    dd = max_dd_60(s, dd_w, mp)
106:    return mom / (1.0 + dd)
