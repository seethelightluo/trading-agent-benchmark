    print(f'coverage_asset_days={cov_asset_days:.3f}  dates_ge8={cov_dates_ge8:.3f}  turnover_10d_rank={turnover:.3f}')
    print(f'decay_ic_by_horizon={decay}')
    print(f'max_abs_library_correlation={maxrho:.4f}  (vs {rho_names})')
