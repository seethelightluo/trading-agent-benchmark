185 def ic_at_horizon(fname, h):
186     ics = {}
187     for t in GRID:
188         xs, ys = [], []
189         for s in ASSETS:
190             if s not in FACTORS or s not in DATA:
191                 continue
192             f = FACTORS[s]
193             d = DATA[s]
194             if t not in f.index:
195                 continue
196             idx = d.index.get_loc(t)
197             j = idx + h
198             if j >= len(d):
199                 continue
200             x = f.loc[t, fname]
201             y = d["close"].iloc[j] / d["close"].iloc[idx] - 1.0
202             if pd.notna(x) and pd.notna(y):
203                 xs.append(x)
204                 ys.append(y)
205         if len(xs) >= MIN_ASSETS:
206             ics[t] = spearman(xs, ys)
207     return pd.Series(ics)
