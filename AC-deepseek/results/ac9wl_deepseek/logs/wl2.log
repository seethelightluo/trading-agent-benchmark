 129: def coverage_stats(factor_panel: pd.DataFrame, n_assets: int = 15, min_assets: int = 8) -> dict:
 130:     total_cells = len(factor_panel) * n_assets
 131:     valid_cells = int(factor_panel.notna().sum().sum())
 132:     ge8 = int((factor_panel.notna().sum(axis=1) >= min_assets).sum())
 133:     return {
 134:         "coverage_asset_days": round(valid_cells / total_cells, 4),
 135:         "coverage_dates_ge8": round(ge8 / len(factor_panel), 4),
 136:         "n_dates_total": int(len(factor_panel)),
 137:         "n_dates_ge8": ge8,
 138:     }
