257 def max_lib_corr(sigmat, mats):
258     best = 0.0
259     for name, m in mats.items():
260         if m.shape != sigmat.shape:
261             continue
262         mask = ~(np.isnan(sigmat) | np.isnan(m))
263         if mask.sum() < 500:
264             continue
265         a = sigmat[mask]
266         b = m[mask]
267         if a.std() < 1e-12 or b.std() < 1e-12:
268             continue
269         rho = float(np.corrcoef(a, b)[0, 1])
270         if abs(rho) > best:
271             best = abs(rho)
272     return best
273 
274 
