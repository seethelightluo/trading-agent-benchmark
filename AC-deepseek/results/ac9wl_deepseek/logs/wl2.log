24 def load_close(asset, folder='../persistent/stock_data'):
25     df = pd.read_csv(f'{folder}/{asset}.csv', parse_dates=['date'])
26     df = df[df['date'] <= pd.Timestamp(VISIBLE)].set_index('date')['close'].astype(float)
27     return df
