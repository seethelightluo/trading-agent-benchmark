    "mom_30d_skip5":    "close.shift(5) / close.shift(35) - 1.0",
    "mom_180d_skip5":   "close.shift(5) / close.shift(185) - 1.0",
    "mom_250d_skip5":   "close.shift(5) / close.shift(255) - 1.0",
