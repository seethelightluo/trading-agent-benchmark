    ar = s.pct_change()
    df = pd.concat([ar.rename("a"), dxy_ret.reindex(ar.index).rename("d")], axis=1).dropna()
    b = df["a"].rolling(60).cov(df["d"]) / df["d"].rolling(60).var()
    beta_parts[a] = b.reindex(panel.index)
