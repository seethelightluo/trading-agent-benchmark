import sys, numpy as np, pandas as pd
sys.path.insert(0,'scripts')
from miner_1_lib import load_panel, per_asset
panel = load_panel()

# replicate exact driver_ret
def driver_ret(name):
    if name=='WTI': return panel['WTI'].pct_change()

dret = driver_ret('WTI')
print('dret len', len(dret), 'non-nan', int(dret.notna().sum()))

# replicate beta_factory
def beta_factory(dret, window=60, minp=30):
    def f(s):
        ar = s.pct_change()
        df = pd.concat([ar.rename('a'), dret.reindex(ar.index).rename('m')], axis=1).dropna()
        cov = df['a'].rolling(window, min_periods=minp).cov(df['m'])
        var = df['m'].rolling(window, min_periods=minp).var()
        return (cov / var).reindex(s.index)
    return f

beta = per_asset(panel, beta_factory(dret))
print('beta non-nan', int(beta.notna().sum().sum()), 'of', beta.size)
print('beta last row non-nan', int(beta.iloc[-1].notna().sum()))
mom20 = (1.0 + dret).rolling(20).apply(np.prod, raw=True) - 1.0
sig = beta.mul(mom20, axis=0)
print('sig non-nan', int(sig.notna().sum().sum()), 'ge8', int((sig.notna().sum(axis=1)>=8).sum()))
print('columns with any non-nan:')
print(sig.notna().sum()[sig.notna().sum()>0])
