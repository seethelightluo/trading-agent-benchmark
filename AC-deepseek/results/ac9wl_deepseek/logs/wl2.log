 141: def validate_factor(factor_panel: pd.DataFrame, panel: pd.DataFrame,
 142:                     horizons=(1, 2, 3, 5, 10, 20), admission_horizon: int = 10,
 143:                     library: dict = None, min_assets: int = 8,
 144:                     fwd_cache: dict = None) -> dict:
 145:     """fwd_cache: dict {h: forward return panel} to avoid recomputation."""
 146:     ic_by_h = {}
 147:     for h in horizons:
 148:         ret = fwd_cache.get(str(h)) if fwd_cache else None
 149:         if ret is None:
 150:             ret = forward_returns(panel, h)
 151:             if fwd_cache is not None:
 152:                 fwd_cache[str(h)] = ret
 153:         ic_by_h[str(h)] = float(compute_ic(factor_panel, ret, min_assets).mean())
 154:     ret_a = fwd_cache.get(str(admission_horizon)) if fwd_cache else None
 155:     if ret_a is None:
 156:         ret_a = forward_returns(panel, admission_horizon)
 157:         if fwd_cache is not None:
 158:             fwd_cache[str(admission_horizon)] = ret_a
 159:     ic_ser = compute_ic(factor_panel, ret_a, min_assets).dropna()
 160:     ic = float(ic_ser.mean())
 161:     icir = float(ic_ser.mean() / ic_ser.std()) if ic_ser.std() > 0 else 0.0
 162:     hit = float((np.sign(ic_ser) == np.sign(ic)).mean()) if ic != 0 else 0.0
 163:     cov = coverage_stats(factor_panel, min_assets=min_assets)
 164:     to = turnover_rank(factor_panel, step=admission_horizon)
 165:     out = {
 166:         "ic": round(ic, 4),
 167:         "icir": round(icir, 4),
 168:         "ic_hit_ratio": round(hit, 3),
 169:         "n_ic_dates": int(len(ic_ser)),
 170:         "coverage_asset_days": cov["coverage_asset_days"],
 171:         "coverage_dates_ge8": cov["coverage_dates_ge8"],
 172:         "n_dates_total": cov["n_dates_total"],
 173:         "n_dates_ge8": cov["n_dates_ge8"],
 174:         "turnover_%d_rank" % admission_horizon: round(to, 3) if to == to else None,
 175:         "decay_ic_by_horizon": {k: round(v, 4) for k, v in ic_by_h.items()},
 176:     }
 177:     if library is not None:
 178:         lc = library_correlation(factor_panel, library, min_assets)
 179:         out["max_abs_library_correlation"] = round(lc["max_abs"], 4)
 180:         out["library_pairwise_corr"] = {k: round(v, 4) for k, v in lc["pairwise"].items()}
 181:     return out
