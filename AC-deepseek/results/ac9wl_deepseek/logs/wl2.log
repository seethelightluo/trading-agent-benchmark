  ▶️ shell({'command': 'python - <<\'EOF\'\nimport re\nsrc = open(\'scripts/miner2_lib.py\').read()\nold = \'\'\'def turnover_rank(factor_panel: pd.DataFrame, step: int = 10) -> float:\n    ranked = factor_panel.rank(axis=1, pct=True)\n    vals = []\n    for i in range(step, len(ranked), step):\n        a, b = ranked.iloc[i - step], ranked.iloc[i]\n        m = a.notna() & b.notna()\n        if m.sum() >= 8:\n            vals.append(float((b[m] - a[m]).abs().mean()))\n    return float(np.mean(vals)) if vals else float("nan")\'\'\'\nnew = \'\'\'def turnover_rank(factor_panel: pd.DataFrame, step: int = 10,\n                 min_assets: int = 8) -> float:\n    ranked = factor_panel.rank(axis=1, pct=True)\n    valid_mask = ranked.notna().sum(axis=1) >= min_assets\n    idx = ranked.index[valid_mask]\n    vals = []\n    for i in range(step, len(idx), step):\n        a, b = ranked.loc[idx[i - step]], ranked.loc[idx[i]]\n        m = a.notna() & b.notna()\n        if m.sum() >= 8:\n            vals.append(float((b[m] - a[m]).abs().mean()))\n    return float(np.mean(vals)) if vals else float("nan")\'\'\'\nassert old in src\nsrc = src.replace(old, new)\nopen(\'scripts/miner2_lib.py\',\'w\').write(src)\nprint(\'patched\')\nEOF'})
