86:def compute_ic(factor_panel: pd.DataFrame, ret_panel: pd.DataFrame,
87:               min_assets: int = 8) -> pd.Series:
88:    dates = factor_panel.index.intersection(ret_panel.index)
89:    F = factor_panel.loc[dates]
90:    R = ret_panel.loc[dates]
91:    Fr = F.rank(axis=1).values
92:    Rr = R.rank(axis=1).values
93:    m = (~np.isnan(Fr)) & (~np.isnan(Rr))
94:    valid = m.sum(axis=1) >= min_assets
95:    ics = np.full(len(dates), np.nan)
96:    idx = np.where(valid)[0]
97:    for i in idx:
98:        f = Fr[i, m[i]]
99:        r = Rr[i, m[i]]
100:        f = f - f.mean()
101:        r = r - r.mean()
102:        denom = np.sqrt((f * f).sum() * (r * r).sum())
103:        ics[i] = (f * r).sum() / denom if denom > 0 else np.nan
104:    return pd.Series(ics, index=dates, name="ic")
