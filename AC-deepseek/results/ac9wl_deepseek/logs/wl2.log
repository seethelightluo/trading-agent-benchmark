    "cs_beta_60d": "close.pct_change().rolling(60).cov(close.pct_change().mean(axis=1)) / close.pct_change().mean(axis=1).rolling(60).var()",
    "price_zscore_60d": "(close - close.rolling(60).mean()) / close.rolling(60).std()",
