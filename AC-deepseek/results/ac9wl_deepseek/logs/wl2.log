   1 """Shared validation harness for miner_1 (cross-asset 15-instrument universe).
   2 
   3 Data source: ../persistent/stock_data/*.csv and ../persistent/index_data/*.csv
   4 Visible cutoff: date <= 2026-07-29 (visible through current simulation date 2026-07-30).
   5 No lookahead: factor at t uses data up to t; forward return uses t+1..t+h.
   6 IMPORTANT: each asset has its own trading calendar (crypto trades weekends, equities do
   7 not). All factor and forward-return computations are done per-asset on the asset's OWN
   8 calendar (no NaN gaps), then reindexed to the union panel index for cross-sectional IC.
   9 """
  10 import math
  11 import numpy as np
  12 import pandas as pd
  13 from pathlib import Path
  14 
  15 TRADABLES = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX",
  16              "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
  17 MACRO = ["DXY", "USDCNY", "USDJPY", "EURUSD", "VIX"]
  18 VISIBLE_THROUGH = "2026-07-29"
  19 
  20 DATA_DIR = Path("../persistent/stock_data")
  21 INDEX_DIR = Path("../persistent/index_data")
  22 
  23 
  24 def load_asset(symbol: str) -> pd.DataFrame:
  25     """Load daily bars for a tradable or macro asset, truncated to visible date."""
  26     p = (INDEX_DIR if symbol in MACRO else DATA_DIR) / f"{symbol}.csv"
  27     df = pd.read_csv(p, parse_dates=["date"])
  28     df = df[df["date"] <= pd.Timestamp(VISIBLE_THROUGH)].copy()
  29     df = df.sort_values("date").reset_index(drop=True)
  30     return df
  31 
  32 
  33 def load_panel() -> pd.DataFrame:
  34     """Union-index close-price panel (cols=assets) for the 15 tradables."""
  35     frames = {}
  36     for a in TRADABLES:
  37         df = load_asset(a)
  38         frames[a] = pd.Series(df["close"].astype(float).values,
  39                               index=pd.to_datetime(df["date"]), name=a)
  40     panel = pd.concat(frames, axis=1).sort_index()
  41     return panel
  42 
  43 
  44 def macro_series(name: str) -> pd.Series:
  45     df = load_asset(name)
  46     return pd.Series(df["close"].astype(float).values, index=pd.to_datetime(df["date"]), name=name)
  47 
  48 
  49 def per_asset(panel: pd.DataFrame, func, *args, **kwargs) -> pd.DataFrame:
  50     """Apply func to each asset's own-calendar series, reindex to union panel index."""
  51     out = {}
  52     for a in panel.columns:
  53         s = panel[a].dropna()          # asset's own calendar, no gaps
  54         out[a] = func(s, *args, **kwargs).reindex(panel.index)
  55     return pd.DataFrame(out, index=panel.index)
  56 
  57 
  58 def fwd_ret_series(s: pd.Series, h: int) -> pd.Series:
  59     """h-period forward return on the series' own calendar."""
  60     return s.shift(-h) / s - 1.0
  61 
  62 
  63 def forward_returns(panel: pd.DataFrame, horizon: int) -> pd.DataFrame:
  64     return per_asset(panel, fwd_ret_series, horizon)
  65 
  66 
  67 def compute_ic(factor_panel: pd.DataFrame, ret_panel: pd.DataFrame,
  68                min_assets: int = 8) -> pd.Series:
  69     """Daily cross-sectional Spearman IC, vectorized ranks + numpy per-date pearson."""
  70     dates = factor_panel.index.intersection(ret_panel.index)
  71     F = factor_panel.loc[dates]
  72     R = ret_panel.loc[dates]
  73     Fr = F.rank(axis=1).values
  74     Rr = R.rank(axis=1).values
  75     m = (~np.isnan(Fr)) & (~np.isnan(Rr))
  76     valid = m.sum(axis=1) >= min_assets
  77     ics = np.full(len(dates), np.nan)
  78     idx = np.where(valid)[0]
  79     for i in idx:
  80         f = Fr[i, m[i]]
  81         r = Rr[i, m[i]]
  82         f = f - f.mean()
  83         r = r - r.mean()
  84         denom = np.sqrt((f * f).sum() * (r * r).sum())
  85         ics[i] = (f * r).sum() / denom if denom > 0 else np.nan
  86     return pd.Series(ics, index=dates, name="ic")
  87 
  88 
  89 def panel_rank_corr(a: pd.DataFrame, b: pd.DataFrame, min_assets: int = 8) -> float:
  90     """Mean daily cross-sectional Spearman correlation between two factor panels."""
  91     dates = a.index.intersection(b.index)
  92     Ar = a.loc[dates].rank(axis=1).values
  93     Br = b.loc[dates].rank(axis=1).values
  94     m = (~np.isnan(Ar)) & (~np.isnan(Br))
  95     valid = m.sum(axis=1) >= min_assets
  96     cs = []
  97     idx = np.where(valid)[0]
  98     for i in idx:
  99         x = Ar[i, m[i]]
 100         y = Br[i, m[i]]
 101         x = x - x.mean()
 102         y = y - y.mean()
 103         denom = np.sqrt((x * x).sum() * (y * y).sum())
 104         if denom > 0:
 105             cs.append((x * y).sum() / denom)
 106     return float(np.mean(cs)) if cs else 0.0
 107 
 108 
 109 def library_correlation(candidate: pd.DataFrame, library: dict, min_assets: int = 8) -> dict:
 110     out = {}
 111     for fid, sig in library.items():
 112         out[fid] = panel_rank_corr(candidate, sig, min_assets)
 113     max_abs = max((abs(v) for v in out.values()), default=0.0)
 114     return {"pairwise": out, "max_abs": max_abs}
 115 
 116 
 117 def turnover_rank(factor_panel: pd.DataFrame, step: int = 10) -> float:
 118     """Mean absolute change in normalized cross-sectional ranks between decisions."""
 119     ranked = factor_panel.rank(axis=1, pct=True)
 120     vals = []
 121     for i in range(step, len(ranked), step):
 122         a, b = ranked.iloc[i - step], ranked.iloc[i]
 123         m = a.notna() & b.notna()
 124         if m.sum() >= 8:
 125             vals.append(float((b[m] - a[m]).abs().mean()))
 126     return float(np.mean(vals)) if vals else float("nan")
