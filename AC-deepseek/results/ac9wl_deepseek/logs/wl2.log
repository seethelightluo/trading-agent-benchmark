154 def spearman(x, y):
155     xr = pd.Series(x).rank().values
156     yr = pd.Series(y).rank().values
157     if len(xr) < 2:
158         return np.nan
159     sx, sy = xr.std(), yr.std()
160     if sx < 1e-12 or sy < 1e-12:
161         return np.nan
162     return float(np.corrcoef(xr, yr)[0, 1])
163 
