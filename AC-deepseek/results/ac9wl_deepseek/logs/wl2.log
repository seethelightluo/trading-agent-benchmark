251 def max_lib_corr(sigmat, mats):
252     best = 0.0
253     best_name = None
254     for name, m in mats.items():
255         if m.shape != sigmat.shape:
256             continue
257         mask = ~(np.isnan(sigmat) | np.isnan(m))
258         if mask.sum() < 500:
259             continue
260         a = sigmat[mask]; b = m[mask]
261         if a.std() < 1e-12 or b.std() < 1e-12:
262             continue
263         rho = float(np.corrcoef(a, b)[0, 1])
264         if abs(rho) > best:
265             best = abs(rho)
266             best_name = name
267     return best, best_name
