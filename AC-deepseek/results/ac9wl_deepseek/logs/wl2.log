                          "n": int(len(ic_ser))}
    regime_out[fid] = rd
    print("  " + " | ".join(line))

out = {"panel_shape": list(panel.shape), "visible_through": "2026-07-29",
       "results": {k: {kk: vv for kk, vv in v.items()} for k, v in results.items()},
