                        min_assets: int = 8) -> dict:
    out = {}
    for fid, sig in library.items():
        out[fid] = panel_rank_corr(candidate, sig, min_assets)
    max_abs = max((abs(v) for v in out.values()), default=0.0)
    return {"pairwise": out, "max_abs": max_abs}


