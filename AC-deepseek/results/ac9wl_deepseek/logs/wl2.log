        out = pd.DataFrame(index=panel.index, columns=panel.columns, dtype=float)
        ret = panel.pct_change()
        for sym in panel.columns:
            z = pd.concat([ret[sym].rename("a"), vix_ret.rename("v")], axis=1).dropna()
