166:def turnover_rank(factor_panel: pd.DataFrame, step: int = 10,
167:                 min_assets: int = 8) -> float:
168:    ranked = factor_panel.rank(axis=1, pct=True)
169:    valid_mask = ranked.notna().sum(axis=1) >= min_assets
170:    idx = ranked.index[valid_mask]
171:    vals = []
172:    for i in range(step, len(idx), step):
173:        a, b = ranked.loc[idx[i - step]], ranked.loc[idx[i]]
174:        m = a.notna() & b.notna()
175:        if m.sum() >= 8:
176:            vals.append(float((b[m] - a[m]).abs().mean()))
177:    return float(np.mean(vals)) if vals else float("nan")
