  ▶️ shell({'command': 'python - <<\'EOF\'\nimport pandas as pd, numpy as np, os\n\ndef load(path, name):\n    df = pd.read_csv(path)\n    df.columns = [c.strip().lower() for c in df.columns]\n    if \'date\' in df.columns:\n        df[\'date\'] = pd.to_datetime(df[\'date\'])\n        df = df.set_index(\'date\')\n    return df\n\nassets = ["000300.SH","SPX","HSI","N225","SX5E","000688.SH","SOX","NDX","XAU","COPPER","WTI","BTC","ETH","US10Y","CN10Y"]\nbase = "../persistent/stock_data"\nclose = {}\nfor a in assets:\n    df = load(os.path.join(base, a+".csv"), a)\n    close[a] = df[\'close\'] if \'close\' in df.columns else df[\'adjclose\'] if \'adjclose\' in df.columns else df.iloc[:,3]\npx = pd.DataFrame(close).sort_index()\npx = px[~px.index.duplicated(keep=\'last\')]\nprint("price range:", px.index.min().date(), "->", px.index.max().date(), "rows:", len(px))\nlast = px.index.max()\nprint("\\n=== REGIME SNAPSHOT as of", last.date(), "===")\nrets = px.pct_change()\nrow = {}\nfor a in assets:\n    s = px[a]\n    r20 = s.iloc[-1]/s.iloc[-21]-1 if len(s)>21 else np.nan\n    r60 = s.iloc[-1]/s.iloc[-61]-1 if len(s)>61 else np.nan\n    r120 = s.iloc[-1]/s.iloc[-121]-1 if len(s)>121 else np.nan\n    r250 = s.iloc[-1]/s.iloc[-251]-1 if len(s)>251 else np.nan\n    vol20 = rets[a].iloc[-20:].std()*np.sqrt(252)\n    ma20 = s.iloc[-20:].mean(); ma60 = s.iloc[-60:].mean()\n    pos = (s.iloc[-1]-ma20)/ma20\n    row[a] = (r20, r60, r120, r250, vol20, pos, s.iloc[-1])\nprint(f"{\'asset\':10s} {\'r20\':>8s} {\'r60\':>8s} {\'r120\':>8s} {\'r250\':>8s} {\'vol20\':>7s} {\'vsMA20\':>8s} {\'close\':>12s}")\nfor a in assets:\n    r20,r60,r120,r250,vol20,pos,c = row[a]\n    print(f"{a:10s} {r20*100:8.1f} {r60*100:8.1f} {r120*100:8.1f} {r250*100:8.1f} {vol20*100:6.1f} {pos*100:8.1f} {c:12.2f}")\n\n# observation signals\nprint("\\n=== OBSERVATION SIGNALS ===")\nfor f in ["VIX","DXY","USDJPY","USDCNY","EURUSD"]:\n    p = os.path.join("../persistent/index_data", f+".csv")\n    if os.path.exists(p):\n        df = load(p, f)\n        c = df[\'close\'] if \'close\' in df.columns else df.iloc[:,3]\n        r20 = c.iloc[-1]/c.iloc[-21]-1 if len(c)>21 else np.nan\n        r60 = c.iloc[-1]/c.iloc[-61]-1 if len(c)>61 else np.nan\n        print(f"{f:8s} close={c.iloc[-1]:10.2f}  r20={r20*100:6.1f}%  r60={r60*100:6.1f}%  (last date {c.index.max().date()})")\nEOF'})
