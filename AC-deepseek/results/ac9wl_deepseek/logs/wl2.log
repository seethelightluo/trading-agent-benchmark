  ▶️ write_file({'file_path': 'scripts/miner_3_20260813_lib.py', 'content': '"""miner_3 shared lib (2026-08-13): grid-aligned data loading + factor metric engine.\nCross-asset 15-instrument universe; IC = daily cross-sectional Spearman vs fwd 10d ret.\nGates: |IC|>=0.0070, |ICIR|>=0.0840. Pairwise rho vs library artifacts on overlapping rows.\n"""\nimport json, glob, os\nimport numpy as np\nimport pandas as pd\nfrom alphacrafter.sim.utils import get_stock_daily_data, get_account_dict\n\nDATE_PATH = "../persistent/date.json"\ndate_state = json.load(open(DATE_PATH))\nTRADING_DAYS = date_state["trading_days"]\nVISIBLE = date_state["visible_through"]\nROW0 = TRADING_DAYS.index("2020-01-01")\nROW1 = TRADING_DAYS.index(VISIBLE)\nGRID = TRADING_DAYS[ROW0:ROW1 + 1]\nGIDX = {d: i for i, d in enumerate(GRID)}\nN_GRID = len(GRID)\n\nacct = get_account_dict()\nASSETS = list(acct.get("watch_list", []))\nHORIZON = 10\nMIN_ASSETS = 8\n\n\ndef load_asset(sym, days=2100):\n    df = get_stock_daily_data(sym, days=days)\n    if df is None:\n        return None\n    df = df.copy()\n    df["date"] = pd.to_datetime(df["date"]).dt.strftime("%Y-%m-%d")\n    df = df.set_index("date")\n    for c in ["open", "close", "high", "low", "volume"]:\n        df[c] = pd.to_numeric(df[c], errors="coerce")\n    return df\n\n\ndef load_grid_close():\n    """Return (N_GRID, n_assets) close matrix reindexed onto the master grid."""\n    DATA = {s: load_asset(s) for s in ASSETS}\n    close = np.full((N_GRID, len(ASSETS)), np.nan)\n    for j, s in enumerate(ASSETS):\n        df = DATA[s]\n        if df is None:\n            continue\n        for dt, row in df.iterrows():\n            if dt in GIDX:\n                close[GIDX[dt], j] = row["close"]\n    return close\n\n\ndef load_macro(name):\n    p = f"../persistent/index_data/{name}.csv"\n    if not os.path.exists(p):\n        return None\n    df = pd.read_csv(p)\n    df["date"] = pd.to_datetime(df["date"]).dt.strftime("%Y-%m-%d")\n    df = df.set_index("date")\n    return df["close"].astype(float)\n\n\ndef safe_div(a, b):\n    with np.errstate(divide="ignore", invalid="ignore"):\n        return np.where(np.abs(b) < 1e-12, np.nan, a / b)\n\n\ndef roll_mean(x, w):\n    c = np.cumsum(np.where(np.isnan(x), 0.0, x))\n    n = np.cumsum(~np.isnan(x))\n    out = np.full(len(x), np.nan)\n    out[w:] = safe_div(c[w:] - c[:-w], n[w:] - n[:-w])\n    return out\n\n\ndef roll_std(x, w):\n    mu = roll_mean(x, w)\n    sq = roll_mean(x * x, w)\n    return np.sqrt(np.maximum(sq - mu * mu, 0.0))\n\n\ndef cross_sectional_rank(mat):\n    """Row-wise Spearman rank (pct rank) of a (T, n) matrix, NaN preserved."""\n    T, n = mat.shape\n    out = np.full_like(mat, np.nan, dtype=float)\n    for t in range(T):\n        row = mat[t]\n        valid = ~np.isnan(row)\n        if valid.sum() < MIN_ASSETS:\n            continue\n        ranks = pd.Series(row[valid]).rank(pct=True).values\n        out[t, valid] = ranks\n    return out\n\n\ndef spearman_ic_matrix(factor_mat, fwd_ret):\n    """Daily cross-sectional Spearman IC between factor and fwd returns."""\n    T = factor_mat.shape[0]\n    ics = []\n    for t in range(T):\n        f = factor_mat[t]\n        r = fwd_ret[t]\n        ok = ~(np.isnan(f) | np.isnan(r))\n        if ok.sum() < MIN_ASSETS:\n            continue\n        fs = pd.Series(f[ok]); rs = pd.Series(r[ok])\n        fr = fs.rank().corr(rs.rank())\n        if np.isfinite(fr):\n            ics.append((t, fr))\n    return ics\n\n\ndef summarize(ics, dates, label, horizon):\n    if len(ics) == 0:\n        return None\n    idx = np.array([t for t, _ in ics])\n    icv = np.array([v for _, v in ics])\n    ic = float(np.nanmean(icv))\n    icir = float(np.nanmean(icv) / np.nanstd(icv)) if np.nanstd(icv) > 0 else 0.0\n    hit = float(np.mean(icv > 0))\n    n = len(icv)\n    reg = {}\n    segs = [("2020-2021", "2020-01-01", "2021-12-31"), ("2022", "2022-01-01", "2022-12-31"),\n            ("2023-2024", "2023-01-01", "2024-12-31"), ("2025-2026", "2025-01-01", "2099-12-31")]\n    for name, a, b in segs:\n        m = (dates[idx] >= a) & (dates[idx] <= b)\n        if m.sum() > 20:\n            reg[name] = {"ic": round(float(np.mean(icv[m])), 4), "icir": round(float(np.mean(icv[m]) / np.std(icv[m])), 3) if np.std(icv[m]) > 0 else 0.0, "n": int(m.sum())}\n    if n >= 250:\n        m = idx >= len(dates) - 250\n        reg["last250"] = {"ic": round(float(np.mean(icv[m])), 4), "icir": round(float(np.mean(icv[m]) / np.std(icv[m])), 3) if np.std(icv[m]) > 0 else 0.0, "n": int(m.sum())}\n    return {"label": label, "horizon": horizon, "n_ic_dates": n, "ic": ic, "icir": icir,\n            "hit": hit, "regime": reg, "idx": idx, "icv": icv}\n\n\ndef decay_curve(factor_mat, close_mat, horizons=(1, 2, 3, 5, 10, 20)):\n    T, n = close_mat.shape\n    out = {}\n    for h in horizons:\n        fwd = np.full_like(close_mat, np.nan)\n        fwd[:T - h] = close_mat[h:] / close_mat[:T - h] - 1.0\n        ics = spearman_ic_matrix(factor_mat, fwd)\n        if ics:\n            out[str(h)] = round(float(np.mean([v for _, v in ics])), 4)\n    return out\n\n\ndef turnover_10d_rank(rank_mat, step=10):\n    """Mean abs change of cross-sectional pct-rank between t and t+step (valid pairs)."""\n    T = rank_mat.shape[0]\n    d = []\n    for t in range(0, T - step):\n        a, b = rank_mat[t], rank_mat[t + step]\n        ok = ~(np.isnan(a) | np.isnan(b))\n        if ok.sum() < MIN_ASSETS:\n            continue\n        d.append(np.nanmean(np.abs(a[ok] - b[ok])))\n    return float(np.mean(d)) if d else float("nan")\n\n\ndef library_pairwise_corr(factor_mat, grid_factor=None):\n    """Spearman rho vs every factors/*.signal.npy artifact on overlapping rows.\n    Artifacts: (2398,15) aligned from 2020-01-01 by row position; ours starts same date."""\n    out = {}\n    ours = cross_sectional_rank(factor_mat)\n    for f in sorted(glob.glob("factors/*.signal.npy")):\n        arr = np.load(f, allow_pickle=True)\n        rows = min(arr.shape[0], ours.shape[0])\n        a = ours[:rows]\n        b = arr[:rows]\n        rho = None\n        for t in range(rows):\n            x = a[t]; y = b[t]\n            ok = ~(np.isnan(x) | np.isnan(y))\n            if ok.sum() >= MIN_ASSETS:\n                xs = pd.Series(x[ok]).rank(); ys = pd.Series(y[ok]).rank()\n                c = xs.corr(ys)\n                if np.isfinite(c):\n                    rho = c\n                    break\n        if rho is not None:\n            out[os.path.basename(f).replace(".signal.npy", "")] = round(float(rho), 4)\n    if out:\n        mx = max(out.items(), key=lambda kv: abs(kv[1]))\n        return out, mx[0], abs(mx[1])\n    return out, None, 0.0\n\n\ndef coverage_stats(factor_mat):\n    valid = ~np.isnan(factor_mat)\n    cov_asset_days = float(valid.mean())\n    dates_ge8 = float((valid.sum(axis=1) >= MIN_ASSETS).mean())\n    return cov_asset_days, dates_ge8\n'})
