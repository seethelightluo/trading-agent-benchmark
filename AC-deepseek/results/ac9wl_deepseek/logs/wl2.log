"""Shared validation harness for miner_1 (cross-asset 15-instrument universe).

Data source: ../persistent/stock_data/*.csv and ../persistent/index_data/*.csv
Visible cutoff: date <= 2026-07-29 (visible through current simulation date 2026-07-30).
No lookahead: factor at t uses data up to t; forward return uses t+1..t+h.
IMPORTANT: each asset has its own trading calendar (crypto trades weekends, equities do
not). All factor and forward-return computations are done per-asset on the asset's OWN
calendar (no NaN gaps), then reindexed to the union panel index for cross-sectional IC.
"""
import math
import numpy as np
import pandas as pd
from pathlib import Path

TRADABLES = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX",
             "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
