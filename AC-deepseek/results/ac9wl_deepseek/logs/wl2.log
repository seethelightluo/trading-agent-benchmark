        "last_validated": "2026-07-30",
        "admission_horizon": 10,
        "regime_notes": f"15-instrument tradable cross-asset universe. {reg_note}",
        "metrics": m,
    },
    "tags": ["volatility", "clustering", "regime", "garch", "cross-asset"],
    "benchmark_admission": {
