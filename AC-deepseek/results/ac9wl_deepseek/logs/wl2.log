        decay[str(h)] = round(float(s.mean()), 4)
    print(f"  {fid:18s} ic={ic:+.4f} icir={icir:+.4f} hit={hit:.3f} n={len(ics)} "
          f"cov={cov:.3f} dates_ge8={nge8/len(sig):.3f} turn={turn:.3f} decay={decay}")

