 207: def report(name: str, metrics: dict, gate_ic: float = 0.007, gate_icir: float = 0.084):
 208:     ic = abs(metrics.get("ic", 0.0))
 209:     icir = abs(metrics.get("icir", 0.0))
 210:     passed = (ic >= gate_ic) and (icir >= gate_icir)
 211:     print(f"[{name}] IC={metrics.get('ic')} ICIR={metrics.get('icir')} "
 212:           f"hit={metrics.get('ic_hit_ratio')} n={metrics.get('n_ic_dates')} "
 213:           f"cov_asset={metrics.get('coverage_asset_days')} cov_dates={metrics.get('coverage_dates_ge8')} "
 214:           f"turnover={metrics.get('turnover_10d_rank')} "
 215:           f"maxlibcorr={metrics.get('max_abs_library_correlation')} => {'PASS' if passed else 'FAIL'}")
 216:     return passed
