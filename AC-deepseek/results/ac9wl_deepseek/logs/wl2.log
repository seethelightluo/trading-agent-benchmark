    m["max_abs_library_correlation"] = max_library_correlation(factor_df, library_dir)
    m["n_assets"] = int(factor_df.notna().sum(axis=1).max())
    print(f"[{label}] h={horizon} IC={m['ic']:.4f} ICIR={m['icir']:.4f} "
