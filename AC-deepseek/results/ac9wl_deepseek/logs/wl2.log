  ▶️ write_file({'content': '"""miner_3 cycle-2026-08-13: return-distribution risk family (skewness / co-skewness / kurtosis).\nMotivation: crash-risk premium. Negatively skewed assets (crash-prone) should earn a premium;\nco-skewness with SPX captures lottery-like payoff structure. Orthogonal to the momentum/conditional-beta\nfactors that dominate the library. Cross-asset 15-instrument universe, no lookahead (data visible at t).\n"""\nimport sys, json\nsys.path.insert(0, "scripts")\nimport numpy as np\nimport pandas as pd\nfrom miner_3_20260813_lib import (GRID, N_GRID, ASSETS, HORIZON, MIN_ASSETS, load_grid_close,\n                                  load_macro, roll_mean, roll_std, safe_div, cross_sectional_rank,\n                                  spearman_ic_matrix, summarize, decay_curve, turnover_10d_rank,\n                                  library_pairwise_corr, coverage_stats)\n\nclose = load_grid_close()\nT, n = close.shape\nret = np.full_like(close, np.nan)\nret[1:] = close[1:] / close[:-1] - 1.0\n\n# SPX returns on grid\nspx_j = ASSETS.index("SPX")\nspx_ret = ret[:, spx_j]\n\ndef roll_skew(x, w):\n    mu = roll_mean(x, w)\n    sd = roll_std(x, w)\n    c3 = np.full(len(x), np.nan)\n    x3 = x ** 3\n    m3 = roll_mean(x3, w)\n    c3[w:] = m3[w:] - 3 * mu[w:] * roll_mean(x * x, w)[w:] + 2 * mu[w:] ** 3\n    out = np.full(len(x), np.nan)\n    ok = sd > 1e-12\n    out[ok] = c3[ok] / (sd[ok] ** 3)\n    return out\n\ndef roll_kurt(x, w):\n    mu = roll_mean(x, w)\n    sd = roll_std(x, w)\n    c4 = roll_mean(x ** 4, w) - 4 * mu * roll_mean(x ** 3, w) + 6 * mu ** 2 * roll_mean(x * x, w) - 3 * mu ** 4\n    out = np.full(len(x), np.nan)\n    ok = sd > 1e-12\n    out[ok] = c4[ok] / (sd[ok] ** 4)\n    return out\n\n# co-skewness with SPX: E[(r_i-mu_i)*(r_m-mu_m)^2] / (sd_i * sd_m^2)\ndef roll_coskew(x, m, w):\n    mux = roll_mean(x, w); mum = roll_mean(m, w)\n    sd_x = roll_std(x, w); sd_m = roll_std(m, w)\n    cross = roll_mean((x - mux) * (m - mum) ** 2, w)\n    out = np.full(len(x), np.nan)\n    ok = (sd_x > 1e-12) & (sd_m > 1e-12)\n    out[ok] = cross[ok] / (sd_x[ok] * sd_m[ok] ** 2)\n    return out\n\nW = 60\nF = {}\nF["skew_60"] = np.column_stack([roll_skew(ret[:, j], W) for j in range(n)])\nF["kurt_60"] = np.column_stack([roll_kurt(ret[:, j], W) for j in range(n)])\nF["coskew_spx_60"] = np.column_stack([roll_coskew(ret[:, j], spx_ret, W) for j in range(n)])\n\n# forward 10d return\nfwd10 = np.full_like(close, np.nan)\nfwd10[:T - HORIZON] = close[HORIZON:] / close[:T - HORIZON] - 1.0\n\nprint(f"grid rows {T} ({GRID[0]}..{GRID[-1]}), assets {n}, horizon {HORIZON}")\nprint(f"{\'factor\':16s} {\'IC\':>8s} {\'ICIR\':>7s} {\'hit\':>5s} {\'n\':>6s} {\'covA\':>6s} {\'covD8\':>6s} {\'turn\':>6s} {\'maxLibRho\':>9s}")\nresults = {}\nfor name, mat in F.items():\n    ics = spearman_ic_matrix(mat, fwd10)\n    dates = np.array(GRID)\n    s = summarize(ics, dates, name, HORIZON)\n    if s is None:\n        print(f"{name:16s} NO IC DATES")\n        continue\n    cov_a, cov_d8 = coverage_stats(mat)\n    turn = turnover_10d_rank(cross_sectional_rank(mat))\n    libcorr, mxname, mxabs = library_pairwise_corr(mat)\n    s["coverage_asset_days"] = round(cov_a, 4)\n    s["coverage_dates_ge8"] = round(cov_d8, 4)\n    s["turnover_10d_rank"] = round(turn, 4)\n    s["max_abs_library_correlation"] = mxabs\n    s["max_lib_corr_name"] = mxname\n    s["library_pairwise_corr"] = libcorr\n    s["decay"] = decay_curve(mat, close)\n    s["pass"] = abs(s["ic"]) >= 0.0070 and abs(s["icir"]) >= 0.0840\n    results[name] = s\n    print(f"{name:16s} {s[\'ic\']:8.4f} {s[\'icir\']:7.3f} {s[\'hit\']:5.3f} {s[\'n_ic_dates\']:6d} "\n          f"{cov_a:6.3f} {cov_d8:6.3f} {turn:6.3f} {mxabs:9.4f}  pass={s[\'pass\']}")\n    print("   regime:", {k: v for k, v in s["regime"].items() if k not in ("idx",)})\n    print("   decay:", s["decay"])\n\njson.dump(results, open("scripts/miner_3_20260813_skew_results.json", "w"), indent=1, default=str)\nprint("saved scripts/miner_3_20260813_skew_results.json")\n', 'file_path': 'scripts/miner_3_20260813_skew_risk_family.py'})
