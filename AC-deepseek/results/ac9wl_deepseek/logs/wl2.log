    icir = float(ic_ser.mean() / ic_ser.std()) if ic_ser.std() > 0 else 0.0
    hit = float((np.sign(ic_ser) == np.sign(ic)).mean()) if ic != 0 else 0.0
    cov = coverage_stats(factor_panel, min_assets=min_assets)
