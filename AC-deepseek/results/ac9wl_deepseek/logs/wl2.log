  ▶️ shell({'command': 'python -W ignore -c "\nimport sys, numpy as np, pandas as pd\nsys.path.insert(0, \'scripts\')\nfrom miner_1_lib import load_panel, forward_returns, compute_ic, per_asset, TRADABLES\npanel = load_panel()\nfwd = forward_returns(panel, 10)\nspx_ret = panel[\'SPX\'].dropna().pct_change()\n\ndef down_beta(s, w=60, minp=15):\n    ar = s.pct_change()\n    df = pd.concat([ar.rename(\'a\'), spx_ret.rename(\'m\')], axis=1).dropna()\n    out = pd.Series(np.nan, index=df.index)\n    for i in range(len(df)):\n        if i < w-1: continue\n        seg = df.iloc[max(0,i-w+1):i+1]\n        neg = seg[seg[\'m\']<0]\n        if len(neg) < minp: continue\n        v = neg[\'m\'].var()\n        if v > 0: out.iloc[i] = neg[\'a\'].cov(neg[\'m\'])/v\n    return out.reindex(panel.index)\n\ndef lag_beta(s, w=60, minp=30):\n    ar = s.pct_change()\n    spx_lag = spx_ret.shift(1)\n    df = pd.concat([ar.rename(\'a\'), spx_lag.rename(\'m\')], axis=1).dropna()\n    b = df[\'a\'].rolling(w, min_periods=minp).cov(df[\'m\'])/df[\'m\'].rolling(w, min_periods=minp).var()\n    return b.reindex(panel.index)\n\nfor nm, fn in [(\'downbeta_spx_60\', down_beta), (\'lagbeta_spx_60\', lag_beta)]:\n    sig = per_asset(panel, fn)\n    ic = compute_ic(sig, fwd)\n    last = ic.iloc[-250:]\n    print(nm, \'FULL\', f\'ic={ic.mean():+.4f} icir={ic.mean()/ic.std():+.3f} n={len(ic.dropna())}\')\n    print(nm, \'last250\', f\'ic={last.mean():+.4f} icir={last.mean()/last.std():+.3f} n={len(last.dropna())}\')\n    for y in [2022, 2023, 2024, 2025, 2026]:\n        sub = ic[ic.index.year==y].dropna()\n        if len(sub)>30:\n            print(\' \', y, f\'ic={sub.mean():+.4f} icir={sub.mean()/sub.std():+.3f} n={len(sub)}\')\n    print()\n" 2>/dev/null'})
