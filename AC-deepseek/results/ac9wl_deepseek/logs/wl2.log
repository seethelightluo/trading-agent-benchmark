162 def spearman(x, y):
163     xr = pd.Series(x).rank().values
164     yr = pd.Series(y).rank().values
165     if len(xr) < 2:
166         return np.nan
167     sx, sy = xr.std(), yr.std()
168     if sx < 1e-12 or sy < 1e-12:
169         return np.nan
170     return float(np.corrcoef(xr, yr)[0, 1])
