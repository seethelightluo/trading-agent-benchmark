import sys, numpy as np, pandas as pd, json
sys.path.insert(0, 'scripts')
from miner_1_lib import load_panel, forward_returns, compute_ic, per_asset, macro_series, TRADABLES, VISIBLE_THROUGH
panel = load_panel()
fwd = forward_returns(panel, 10)

def build(name):
    # downbeta
    spx_ret = panel['SPX'].dropna().pct_change()
    def down_beta(s, w=60, minp=15):
        ar = s.pct_change()
        df = pd.concat([ar.rename('a'), spx_ret.rename('m')], axis=1).dropna()
        out = pd.Series(np.nan, index=df.index)
        for i in range(len(df)):
            if i < w-1: continue
            seg = df.iloc[max(0,i-w+1):i+1]
            neg = seg[seg['m']<0]
            if len(neg) < minp: continue
            v = neg['m'].var()
            if v > 0: out.iloc[i] = neg['a'].cov(neg['m'])/v
        return out.reindex(panel.index)
    if name == 'downbeta_spx_60':
        return per_asset(panel, down_beta)
    if name == 'lagbeta_spx_60':
        def lag_beta(s, w=60, minp=30):
            ar = s.pct_change()
            spx_lag = spx_ret.shift(1)
            df = pd.concat([ar.rename('a'), spx_lag.rename('m')], axis=1).dropna()
            b = df['a'].rolling(w, min_periods=minp).cov(df['m'])/df['m'].rolling(w, min_periods=minp).var()
            return b.reindex(panel.index)
        return per_asset(panel, lag_beta)
    if name == 'vol_price_corr_60':
        def f(s):
            df = s.dropna()
            ar = df.pct_change().abs()
            return ar.rolling(60, min_periods=30).corr(df['volume'])
        # needs OHLC... skip

for nm in ['downbeta_spx_60','lagbeta_spx_60']:
    sig = build(nm)
    ic = compute_ic(sig, fwd)
    # yearly breakdown
    for y in [2020,2021,2022,2023,2024,2025]:
        sub = ic[ic.index.year==y].dropna()
        if len(sub)>30:
            print(nm, y, f'ic={sub.mean():+.4f} icir={sub.mean()/sub.std():+.3f} n={len(sub)}')
    last = ic.iloc[-250:]
    print(nm, 'last250', f'ic={last.mean():+.4f} icir={last.mean()/last.std():+.3f} n={len(last)}')
    print()
