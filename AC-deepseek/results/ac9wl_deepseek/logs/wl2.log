  ▶️ shell({'command': 'python - <<\'EOF\'\nimport numpy as np\nfrom scipy.stats import rankdata, spearmanr\n\na = np.load(\'factors/cryptobeta_cond_60x20.signal.npy\').astype(float)\nb = np.load(\'factors/downbeta_spx_60.signal.npy\').astype(float)\nT, N = a.shape\n\ndef fill_med(m):\n    o=m.copy()\n    for i in range(o.shape[0]):\n        row=o[i]; mm=~np.isnan(row)\n        if mm.sum()==0: o[i]=0.0\n        else:\n            med=np.nanmedian(row); row[~mm]=med\n    return o\n\ndef rank_row(m):\n    o=np.zeros_like(m)\n    for i in range(o.shape[0]):\n        o[i]=rankdata(m[i])\n    return o\n\ndef zrow(m):\n    o=m.copy()\n    for i in range(o.shape[0]):\n        r=o[i]\n        if r.std()>0: o[i]=(r-r.mean())/r.std()\n    return o\n\ndef corr(x,y):\n    m=~(np.isnan(x)|np.isnan(y))\n    return float(np.corrcoef(x[m],y[m])[0,1]) if m.sum()>30 else 0.0\n\nvariants = {\n \'raw stack pearson (fill-med)\': corr(fill_med(a), fill_med(b)),\n \'raw stack spearman (fill-med)\': spearmanr(fill_med(a).ravel(), fill_med(b).ravel())[0],\n \'perdate-rank stack pearson\': corr(rank_row(a), rank_row(b)),\n \'perdate-rank stack spearman\': spearmanr(rank_row(a).ravel(), rank_row(b).ravel())[0],\n \'perdate-rank+z stack pearson\': corr(zrow(rank_row(a)), zrow(rank_row(b))),\n \'mean daily CS spearman\': None,\n}\nfor k,v in variants.items():\n    print(k, "=", round(v,4) if v is not None else v)\n\n# mean daily CS corr of per-date ranks (min 8 valid)\nimport numpy as np\nAr = rank_row(a); Br = rank_row(b)\nm = (~np.isnan(Ar)) & (~np.isnan(Br))\ncs=[]\nfor i in range(T):\n    if m[i].sum() >= 8:\n        x=Ar[i,m[i]]; y=Br[i,m[i]]\n        x=x-x.mean(); y=y-y.mean()\n        den=np.sqrt((x*x).sum()*(y*y).sum())\n        if den>0: cs.append((x*y).sum()/den)\nprint("mean daily CS spearman:", round(float(np.mean(cs)),4), "n:", len(cs))\nEOF'})
