# 4) downside ratio: downside semi-dev / total std over 60d
def downside_ratio(s, w=60):
    r = s.pct_change()
    tot = r.rolling(w).std()
    neg = r.clip(upper=0.0)
    dsd = np.sqrt((neg ** 2).rolling(w).mean())
    return dsd / tot
