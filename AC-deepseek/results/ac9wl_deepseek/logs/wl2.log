165 def ic_series(fname):
166     """Daily cross-sectional Spearman IC series (h=10) on the common grid."""
167     ics = {}
168     for t in GRID:
169         xs, ys = [], []
170         for s in ASSETS:
171             if s not in FACTORS or s not in FWD:
172                 continue
173             if t not in FACTORS[s].index or t not in FWD[s].index:
174                 continue
175             x = FACTORS[s].loc[t, fname]
176             y = FWD[s].loc[t]
177             if pd.notna(x) and pd.notna(y):
178                 xs.append(x)
179                 ys.append(y)
180         if len(xs) >= MIN_ASSETS:
181             ics[t] = spearman(xs, ys)
182     return pd.Series(ics)
183 
