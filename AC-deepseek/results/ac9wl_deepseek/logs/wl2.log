        if mask.sum() < 500:
            continue
        a = sigmat[mask]; b = m[mask]
        if a.std() < 1e-12 or b.std() < 1e-12:
            continue
        rho = float(np.corrcoef(a, b)[0, 1])
        if abs(rho) > best:
            best, best_name = abs(rho), name
    return best, best_name

