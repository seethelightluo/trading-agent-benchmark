sig_mom = per_asset(close, lambda s: s.shift(5) / s.shift(25) - 1.0) * damp
dxy = macro_series("DXY")
dxy_ret = dxy.pct_change()
dxy_20 = dxy / dxy.shift(20) - 1.0
beta_parts = {}
for a in close.columns:
