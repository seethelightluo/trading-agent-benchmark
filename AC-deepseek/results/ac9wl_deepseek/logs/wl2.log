assert chk["validation"]["status"] == "EFFECTIVE", "status"
assert chk["validation"]["metrics"]["ic"] == m["ic"]
assert chk["validation"]["metrics"]["icir"] == m["icir"]
art = np.load("factors/calmness_20.signal.npy")
