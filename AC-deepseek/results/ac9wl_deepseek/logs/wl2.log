1:"""miner_2 cycle37b: co-crash tail-overlap family, coverage-improved variants.
2:
3:Cycle37 showed cocrash_spx_60 passes admission gates (IC=-0.0418, ICIR=-0.1129,
4:maxlibcorr=0.188) but has thin coverage (27% asset-days) because the 5th-pct
5:threshold with a 60d co-occurrence window requires >=2 crash days in 60d.
6:This cycle tests coverage-improving parametrizations (same idea, one family):
7:  - cocrash_spx_60_q10 : 10th-pct threshold (120d est window), 60d co-freq
8:  - cocrash_spx_90_q10 : 10th-pct threshold (90d est), 90d co-freq
9:  - cocrash_spx_60_par : parametric threshold mean - 1.0*std (120d), 60d co-freq
10:  - cocrash_med_60_q10 : cross-median driver at 10th pct (orthogonal proxy)
11:  - beta_asym_fixed_60 : up-beta minus down-beta, fixed formula (debug from 37)
12:NOTE: crash_bounce from cycle37 discarded (lookahead bug: shift(-5) inside factor).
13:
14:Admission gates (10d horizon): abs(IC)>=0.0070, abs(ICIR)>=0.0840.
15:"""
16:import json
17:import sys
18:import numpy as np
19:import pandas as pd
20:from pathlib import Path
21:
22:sys.path.insert(0, "scripts")
23:from miner2_lib import (load_close_panel, per_asset, compute_ic,
24:                        forward_returns, validate_factor, regime_breakdown,
25:                        report)
26:
27:cl = load_close_panel()
28:print(f"panel {cl.shape}, last date {cl.index[-1].date()}")
29:
30:ret = cl.pct_change()
31:med_ret = ret.median(axis=1)
32:spx_ret = ret["SPX"]
33:
34:
35:def _crash_ind_q(r, q=0.10, w=120, mp=60):
36:    th = r.rolling(w, min_periods=mp).quantile(q).shift(1)
37:    return (r < th).astype(float)
38:
39:
40:def _crash_ind_par(r, k=1.0, w=120, mp=60):
41:    m = r.rolling(w, min_periods=mp).mean().shift(1)
42:    s = r.rolling(w, min_periods=mp).std().shift(1)
43:    return (r < m - k * s).astype(float)
44:
45:
46:def excess_cocrash(s, driver, crash_fn, w=60, mp=30, min_marg=0.02):
47:    ca = crash_fn(s)
48:    cd = crash_fn(driver)
49:    joint = (ca * cd).rolling(w, min_periods=mp).mean()
50:    marg = ca.rolling(w, min_periods=mp).mean()
51:    base = cd.rolling(w, min_periods=mp).mean()
52:    out = joint / marg - base
53:    return out.where(marg >= min_marg)
54:
55:
56:def beta_asym_fixed(s, driver, w=60, mp=30):
57:    ar = s.pct_change()
58:    dr = driver.pct_change()
59:    up = (dr > 0).astype(float)
60:    dn = (dr <= 0).astype(float)
61:    def _b(mask):
62:        cnt = mask.rolling(w, min_periods=mp).sum()
63:        exy = (ar * dr * mask).rolling(w, min_periods=mp).sum() / cnt
64:        ex = (ar * mask).rolling(w, min_periods=mp).sum() / cnt
65:        ey = (dr * mask).rolling(w, min_periods=mp).sum() / cnt
66:        eyy = (dr * dr * mask).rolling(w, min_periods=mp).sum() / cnt
67:        cov = exy - ex * ey
68:        var = eyy - ey * ey
69:        b = cov / var
70:        return b.where((cnt >= mp) & (var.abs() > 1e-12))
71:    return (_b(up) - _b(dn)).replace([np.inf, -np.inf], np.nan)
72:
73:
74:cands = {
75:    "cocrash_spx_60_q10": per_asset(cl, excess_cocrash, spx_ret, _crash_ind_q, 60),
76:    "cocrash_spx_90_q10": per_asset(cl, excess_cocrash, spx_ret,
77:                                    lambda r: _crash_ind_q(r, q=0.10, w=90, mp=45), 90),
78:    "cocrash_spx_60_par": per_asset(cl, excess_cocrash, spx_ret, _crash_ind_par, 60),
79:    "cocrash_med_60_q10": per_asset(cl, excess_cocrash, med_ret, _crash_ind_q, 60),
80:    "beta_asym_fixed_60": per_asset(cl, beta_asym_fixed, spx_ret),
81:}
