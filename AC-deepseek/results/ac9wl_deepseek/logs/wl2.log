49 def spearman_ic(factor_df, fwd_df):
50     """Daily Spearman rank IC between factor values and forward returns."""
51     dates, ics = [], []
52     idx = factor_df.index.intersection(fwd_df.index)
53     for d in idx:
54         f = factor_df.loc[d]
55         r = fwd_df.loc[d]
56         mask = f.notna() & r.notna()
57         if mask.sum() < MIN_ASSETS:
58             continue
59         ic = f[mask].corr(r[mask], method='spearman')
60         if np.isfinite(ic):
61             dates.append(d)
62             ics.append(ic)
63     return pd.Series(ics, index=dates)
64 
65 
66 def mean_rank_turnover(factor_df, step=10):
67     """Mean absolute rank change over `step` days (rank in [0,1])."""
68     ranks = factor_df.rank(axis=1, pct=True)
69     chg = (ranks - ranks.shift(step)).abs()
70     return float(chg.stack().mean())
