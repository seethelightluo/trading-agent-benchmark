        if abs(rho) > maxrho:
            maxrho, pair = abs(rho), (ACTIVE[i], ACTIVE[j], rho)
print(f"max pairwise |rho| = {maxrho:.4f} ({pair[0]} vs {pair[1]}) -> gate<0.5: {maxrho < 0.5}")
assert maxrho < 0.5, "correlation gate FAILED"

