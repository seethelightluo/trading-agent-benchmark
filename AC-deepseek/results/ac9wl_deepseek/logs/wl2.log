    print(f"{a:10s} cur={cur[a]*100:6.2f}%  prop={weights[a]*100:6.2f}%  d={ (weights[a]-cur[a])*100:+6.2f}%  z={meta['z'][a]:+.2f}  f={forecast[a]*100:+.2f}%")
