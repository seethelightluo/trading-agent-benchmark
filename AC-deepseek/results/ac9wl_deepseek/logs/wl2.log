229 def load_library_artifacts():
230     import glob, os
231     mats = {}
232     # npy artifacts
233     for f in glob.glob("factors/*.signal.npy"):
234         base = os.path.basename(f)[: -len(".signal.npy")]
235         if base.endswith(".bak"):
236             continue
237         mats[base] = np.load(f, allow_pickle=True).astype(float)
238     # embedded artifacts in json
239     for f in glob.glob("factors/*.json"):
240         base = os.path.basename(f)[: -len(".json")]
241         if "." in base and not base.split(".")[0].endswith("_"):
242             pass
243         try:
244             d = json.load(open(f))
245         except Exception:
246             continue
247         art = d.get("signal_artifact")
248         if not isinstance(art, dict):
249             continue
250         vals = art.get("values")
251         if not vals:
252             continue
253         mats[base] = np.array([[float(v) if v is not None else np.nan for v in row] for row in vals])
254     return mats
