import json, os
# Check drawup_20 and sharpe_20
for fid in ['drawup_20', 'sharpe_20']:
    print(f'--- {fid} ---')
    # check all JSONs
    import glob
    for p in glob.glob(f'factors/{fid}*.json'):
        if '.bak' in p: continue
        try:
            d = json.load(open(p))
            v = d.get('validation', {})
            m = v.get('metrics', {})
            ba = d.get('benchmark_admission', {})
            sm = ba.get('selected_metrics', {})
            print(f'  {p}:')
            print(f'    status={v.get(\"status\")}, lastval={v.get(\"last_validated\")}, horizon={v.get(\"admission_horizon\")}')
            print(f'    ic={m.get(\"ic\")}, icir={m.get(\"icir\")}, q={sm.get(\"quality\")}, turn={m.get(\"turnover_10d_rank\")}')
