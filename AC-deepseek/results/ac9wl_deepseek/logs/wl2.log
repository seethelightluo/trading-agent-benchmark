 184 def load_library_signals(panel: pd.DataFrame) -> dict:
 185     """Recompute existing library factor signals (per-asset calendars, aligned)."""
 186     close = panel
 187     sig = {}
 188     sig["mom_10d_skip5"] = per_asset(close, lambda s: s.shift(5) / s.shift(15) - 1.0)
 189     sig["mom_120d_skip5"] = per_asset(close, lambda s: s.shift(5) / s.shift(125) - 1.0)
 190     sig["vol_of_vol20x60"] = per_asset(close, lambda s: s.pct_change().rolling(20).std().rolling(60).std())
 191 
 192     vix = macro_series("VIX").pct_change()
 193     beta_parts = {}
 194     for a in close.columns:
 195         s = close[a].dropna()
 196         ar = s.pct_change()
 197         df = pd.concat([ar.rename("a"), vix.reindex(ar.index).rename("v")], axis=1).dropna()
 198         b = df["a"].rolling(60).cov(df["v"]) / df["v"].rolling(60).var()
 199         beta_parts[a] = b.reindex(panel.index)
 200     beta_panel = pd.DataFrame(beta_parts, index=panel.index)
 201     vix_close = macro_series("VIX")
 202     vix_20 = vix_close / vix_close.shift(20) - 1.0
 203     sig["vix_beta_cond_60x20"] = -beta_panel * vix_20.reindex(beta_panel.index)
 204     return sig
