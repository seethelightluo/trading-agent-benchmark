  ▶️ write_file({'file_path': 'scripts/miner3_20260730_cycle23_screen.py', 'content': '"""miner_3 2026-07-30 cycle 23: screen novel close-only candidate factors.\n\nStrict-namespace-compatible expressions (eval with {\'close\',\'pd\',\'np\'} only) so the\npost-miner gate can recompute signal artifacts. Admission gate (15-asset cross-section,\ndates with >=8 valid instruments): |IC| >= 0.0070 and |ICIR| >= 0.0840 at h=10.\nAlso reports decay, coverage, turnover, regime stability, and max abs library\ncorrelation for passers.\n"""\nimport sys, json\nimport numpy as np\nimport pandas as pd\nfrom miner3_lib import (build_panel, forward_returns, spearman_ic,\n                        mean_rank_turnover, ADMISSION_HORIZON, HORIZONS,\n                        MIN_ASSETS, max_abs_library_correlation)\n\nprices = build_panel()\npanel = pd.DataFrame(prices)\nenv = {"pd": pd, "np": np, "close": panel}\nRET = "close.pct_change()"\n\nEXPRS = {\n    # --- variance-ratio / trending-ness (novel) ---\n    "var_ratio_20_60":  f"{RET}.rolling(20, min_periods=10).sum().rolling(60, min_periods=20).var() / (20.0 * {RET}.rolling(60, min_periods=20).var() + 1e-9)",\n    "trend_str_20":     f"(close/close.shift(20)-1.0)**2 / (20.0 * ({RET}**2).rolling(20, min_periods=10).mean() + 1e-9)",\n    # --- up-day frequency (outlier-robust momentum) ---\n    "up_freq_20":       f"({RET} > 0).astype(float).rolling(20, min_periods=10).mean()",\n    "up_freq_60":       f"({RET} > 0).astype(float).rolling(60, min_periods=30).mean()",\n    # --- moving-average crossover ---\n    "sma_cross_20_60":  f"close.rolling(20, min_periods=10).mean() / close.rolling(60, min_periods=30).mean() - 1.0",\n    "sma_cross_50_200": f"close.rolling(50, min_periods=25).mean() / close.rolling(200, min_periods=60).mean() - 1.0",\n    # --- Bollinger position / bandwidth ---\n    "boll_z_20":        f"(close - close.rolling(20, min_periods=10).mean()) / (close.rolling(20, min_periods=10).std() + 1e-9)",\n    "boll_bw_20":       f"close.rolling(20, min_periods=10).std() / (close.rolling(20, min_periods=10).mean() + 1e-9)",\n    # --- return asymmetry ---\n    "updown_vol_60":    f"{RET}.where({RET} > 0).rolling(60, min_periods=15).std() / ({RET}.where({RET} < 0).rolling(60, min_periods=15).std() + 1e-9)",\n    "updown_ratio_60":  f"{RET}.clip(lower=0).rolling(60, min_periods=15).mean() / ({RET}.clip(upper=0).rolling(60, min_periods=15).mean().abs() + 1e-9)",\n    # --- RSI variants ---\n    "rsi_like_7":       f"{RET}.clip(lower=0).rolling(7, min_periods=4).mean() / ({RET}.abs().rolling(7, min_periods=4).mean() + 1e-9)",\n    "rsi_like_21":      f"{RET}.clip(lower=0).rolling(21, min_periods=10).mean() / ({RET}.abs().rolling(21, min_periods=10).mean() + 1e-9)",\n    # --- long-horizon momentum / reversal ---\n    "mom250_skip5":     f"close.shift(5)/close.shift(250)-1.0",\n    "dist_sma250":      f"close/close.rolling(250, min_periods=60).mean()-1.0",\n    # --- cycle-22 passers re-confirmation ---\n    "acorr_10":         f"({RET} * {RET}.shift(1)).rolling(10, min_periods=5).mean()",\n    "rsi_like_14":      f"{RET}.clip(lower=0).rolling(14, min_periods=7).mean() / ({RET}.abs().rolling(14, min_periods=7).mean() + 1e-9)",\n    "vol_persist_60":   f"{RET}.rolling(60, min_periods=15).std() / ({RET}.rolling(60, min_periods=15).std().shift(60) + 1e-9)",\n}\n\nprint(f"panel: {panel.shape[0]} dates x {panel.shape[1]} assets  visible_through=2026-07-29")\nprint("=== strict-namespace eval (close+pd+np only) ===")\nsignals = {}\nfor fid, exp in EXPRS.items():\n    try:\n        sig = eval(exp, {"__builtins__": {}}, env)\n        ok = isinstance(sig, pd.DataFrame) and sig.shape == panel.shape and sig.notna().sum().sum() > 100\n        if ok:\n            signals[fid] = sig\n        print(f"  {fid:16s} eval={\'OK\' if ok else \'BAD_SIGNAL\'}")\n    except Exception as e:\n        print(f"  {fid:16s} eval=FAIL {type(e).__name__}: {str(e)[:80]}")\n\nfwd10 = forward_returns(prices, ADMISSION_HORIZON)\nprint(f"\\n=== validation (admission h={ADMISSION_HORIZON}) ===")\nrows = {}\nfor fid, sig in signals.items():\n    ics = spearman_ic(sig, fwd10)\n    if len(ics) == 0:\n        print(f"  {fid:16s} NO IC DATES"); continue\n    ic = float(ics.mean())\n    icir = float(ics.mean() / ics.std()) if ics.std() > 0 else 0.0\n    hit = float((ics > 0).mean()) if ic >= 0 else float((ics < 0).mean())\n    decay = {str(h): round(float(spearman_ic(sig, forward_returns(prices, h)).mean()), 4) for h in HORIZONS}\n    cov = float(sig.notna().sum().sum()) / sig.size\n    n_ge8 = sum(1 for d in sig.index if sig.loc[d].notna().sum() >= MIN_ASSETS)\n    turn = mean_rank_turnover(sig)\n    regime = {}\n    for b0, b1 in [("2020-01-01", "2021-12-31"), ("2022-01-01", "2022-12-31"),\n                   ("2023-01-01", "2024-12-31"), ("2025-01-01", "2026-12-31")]:\n        sub = ics[(ics.index >= b0) & (ics.index <= b1)]\n        if len(sub) >= 30:\n            regime[f"{b0[:4]}-{b1[:4]}"] = {"ic": round(float(sub.mean()), 4),\n                                            "icir": round(float(sub.mean() / sub.std()), 4) if sub.std() > 0 else 0.0,\n                                            "n_dates": int(len(sub))}\n    gate = (abs(ic) >= 0.0070) and (abs(icir) >= 0.0840)\n    rows[fid] = dict(ic=ic, icir=icir, hit=hit, n=len(ics), cov=cov, dates_ge8=n_ge8 / len(sig),\n                     turn=turn, decay=decay, regime=regime, gate=gate)\n    print(f"  {fid:16s} n={len(ics):5d} ic={ic:+.4f} icir={icir:+.4f} hit={hit:.3f} "\n          f"cov={cov:.3f} dates_ge8={n_ge8/len(sig):.3f} turn={turn:.3f} "\n          f"gate={\'PASS\' if gate else \'no \'} decay10={decay[\'10\']:+.4f}")\n\nprint("\\n=== passing candidates + library correlation ===")\npassers = {k: v for k, v in rows.items() if v["gate"]}\nfor k, v in sorted(passers.items(), key=lambda kv: -abs(kv[1]["ic"]) * abs(kv[1]["icir"])):\n    maxrho, rho_names = max_abs_library_correlation(signals[k])\n    v["maxrho"] = round(maxrho, 4)\n    v["rho_names"] = rho_names\n    print(f"  {k:16s} ic={v[\'ic\']:+.4f} icir={v[\'icir\']:+.4f} hit={v[\'hit\']:.3f} "\n          f"turn={v[\'turn\']:.3f} maxrho={v[\'maxrho\']:.4f} vs {rho_names}")\n\nprint("\\n=== pairwise pooled |rho| among passers ===")\nnames = sorted(passers.keys())\nif len(names) > 1:\n    rho = pd.DataFrame(index=names, columns=names, dtype=float)\n    for a in names:\n        for b in names:\n            if a == b:\n                rho.loc[a, b] = 1.0\n                continue\n            both = pd.concat([signals[a].stack().rename("x"), signals[b].stack().rename("y")], axis=1).dropna()\n            rho.loc[a, b] = float(both["x"].corr(both["y"])) if len(both) > 100 else np.nan\n    print(rho.round(3).to_string())\nelse:\n    print("  (0 or 1 passers)")\n\nwith open("scripts/miner3_cycle23_results.json", "w") as f:\n    json.dump({k: {kk: vv for kk, vv in v.items() if kk != "decay"} | {"decay": v["decay"]}\n               for k, v in rows.items()}, f, indent=1, default=str)\nprint("\\nresults saved to scripts/miner3_cycle23_results.json")\n'})
