76:def beta_asym(s, driver, w=60, mp=30):
77:    """Up-market beta minus down-market beta (sign flipped: positive = less crash-sensitive)."""
78:    ar = s.pct_change()
79:    dr = driver.pct_change()
80:    up = (dr > 0).astype(float)
81:    dn = (dr <= 0).astype(float)
82:    cov_up = (ar * dr * up).rolling(w, min_periods=mp).sum() / up.rolling(w, min_periods=mp).sum()
83:    var_up = (dr * dr * up).rolling(w, min_periods=mp).sum() / up.rolling(w, min_periods=mp).sum()
84:    cov_dn = (ar * dr * dn).rolling(w, min_periods=mp).sum() / dn.rolling(w, min_periods=mp).sum()
85:    var_dn = (dr * dr * dn).rolling(w, min_periods=mp).sum() / dn.rolling(w, min_periods=mp).sum()
86:    b_up = cov_up / var_up
87:    b_dn = cov_dn / var_dn
88:    return (b_up - b_dn).replace([np.inf, -np.inf], np.nan)
