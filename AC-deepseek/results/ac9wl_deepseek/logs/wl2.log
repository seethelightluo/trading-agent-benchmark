1 """miner_1 screening: statistical/trend-quality factor family on the 15-asset tradable cross-asset universe.
2 
3 Candidates (all computed with data visible at date t, no lookahead):
4   A. trend_r2_60      : R^2 of OLS log-price linear trend over 60d (trend strength/quality)
5   B. autocorr_20      : lag-1 autocorrelation of daily returns over 20d (trend persistence)
6   C. skew_60          : Fisher skewness of daily returns over 60d (return path asymmetry)
7   D. bollinger_pos_20 : (close - SMA20) / (2*std20) (mean-reversion position)
8   E. drawdown_60      : close/rolling_max(close,60) - 1 (continuous distance-from-high)
9   F. vol_trend_20x60  : mean(volume,5)/mean(volume,60) - 1 (volume expansion)
10   G. range_20         : mean((high-low)/close, 20) (intraday amplitude)
11   H. gap_level_20     : mean(open/prev_close - 1, 20) (overnight gap persistence)
12   K. kurt_60          : excess kurtosis of daily returns over 60d
13 
14 Metric: daily cross-sectional Spearman IC vs h=10 forward return, ICIR=mean/std,
15 hit ratio, coverage, turnover (10d rank change), decay by horizon, max abs library
16 correlation vs existing effective factor artifacts. Gates: |IC|>=0.0070, |ICIR|>=0.0840.
17 """
18 import json
19 import numpy as np
20 import pandas as pd
21 from alphacrafter.sim.utils import get_stock_daily_data, get_account_dict
22 
23 DATE_PATH = "../persistent/date.json"
24 date_state = json.load(open(DATE_PATH))
25 TRADING_DAYS = date_state["trading_days"]
26 VISIBLE = date_state["visible_through"]
27 ART_START = "2020-01-01"
28 assert ART_START in TRADING_DAYS and VISIBLE in TRADING_DAYS
29 ROW0 = TRADING_DAYS.index(ART_START)
30 ROW1 = TRADING_DAYS.index(VISIBLE)
31 GRID = TRADING_DAYS[ROW0:ROW1 + 1]
32 print(f"grid rows: {len(GRID)}  {GRID[0]}..{GRID[-1]}")
33 
34 acct = get_account_dict()
35 ASSETS = list(acct.get("watch_list", []))
36 print("assets:", len(ASSETS))
37 
38 HORIZON = 10
39 MIN_ASSETS = 8
40 
41 
42 def load_asset(sym):
43     df = get_stock_daily_data(sym, days=2000)
44     if df is None:
45         return None
46     df = df.copy()
47     df["date"] = pd.to_datetime(df["date"]).dt.strftime("%Y-%m-%d")
48     df = df.set_index("date")
49     for c in ["open", "close", "high", "low", "volume"]:
50         df[c] = pd.to_numeric(df[c], errors="coerce")
51     return df
52 
53 
54 DATA = {s: load_asset(s) for s in ASSETS}
55 for s, df in DATA.items():
56     print(f"  {s:10s} rows={0 if df is None else len(df)} first={0 if df is None else df.index[0]} last={0 if df is None else df.index[-1]}")
57 
58 
59 def safe_div(a, b):
60     return a / np.where(np.abs(b) < 1e-12, np.nan, b)
61 
62 
63 def compute_factors(df):
64     """Return DataFrame (index=date) of candidate factor values for one asset."""
65     if df is None or len(df) < 80:
66         return None
67     close = df["close"]
68     ret = close.pct_change()
69     out = pd.DataFrame(index=df.index)
70 
71     # A. trend R2 over 60d (OLS of log price on time)
72     lp = np.log(close)
73     x = np.arange(len(lp))
74     xm = x - x.mean()
75     def r2_window(i, w=60):
76         lo = max(0, i - w + 1)
77         seg = lp.iloc[lo:i + 1].values
78         if len(seg) < 30:
79             return np.nan
80         xx = xm[i - len(seg) + 1:i + 1]
81         yy = seg - seg.mean()
82         den = (xx * xx).sum()
83         if den < 1e-12 or (yy * yy).sum() < 1e-12:
84             return np.nan
85         beta = (xx * yy).sum() / den
86         resid = yy - beta * xx
87         ss_res = (resid * resid).sum()
88         ss_tot = (yy * yy).sum()
89         return 1.0 - ss_res / ss_tot
90     out["trend_r2_60"] = [r2_window(i, 60) for i in range(len(lp))]
91 
92     # B. lag-1 autocorr of daily returns over 20d
93     def acf20(i):
94         seg = ret.iloc[max(0, i - 19):i + 1].values
95         if len(seg) < 12:
96             return np.nan
97         a, b = seg[:-1], seg[1:]
98         sa, sb = a.std(), b.std()
99         if sa < 1e-12 or sb < 1e-12:
100             return np.nan
101         return float(np.corrcoef(a, b)[0, 1])
102     out["autocorr_20"] = [acf20(i) for i in range(len(ret))]
103 
104     # C. Fisher skewness over 60d
105     out["skew_60"] = ret.rolling(60, min_periods=30).skew()
106 
107     # D. bollinger position 20
108     ma20 = close.rolling(20, min_periods=10).mean()
109     sd20 = close.rolling(20, min_periods=10).std()
110     out["bollinger_pos_20"] = safe_div(close - ma20, 2 * sd20)

