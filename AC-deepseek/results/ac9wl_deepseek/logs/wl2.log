    if isinstance(sig, pd.Series):
        sig = sig.to_frame()
    sig = sig.reindex(index=panel.index, columns=panel.columns)
    signals[fid] = sig
    print(f"  {fid:22s} shape={sig.shape} nan={int(sig.isna().sum().sum())}")

# ---------------------------------------------------------------------------
# Validation
