def _gap_ratio(open_s, high_s, low_s, close_s, w=20, minp=12):
    prev_close = close_s.shift(1)
    gap = (open_s / prev_close - 1.0).abs()
    rng = (high_s - low_s) / prev_close
    num = gap.rolling(w, min_periods=minp).mean()
    den = rng.rolling(w, min_periods=minp).mean()
    return (num / den).reindex(close_s.index)
f_gap = per_asset(panel, _gap_ratio, open_p, high_p, low_p, panel)

