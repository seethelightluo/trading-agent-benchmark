<｜｜DSML｜｜parameter name="content" string="true">"""miner_1 2026-08-13: corrected full candidate screen.

The 2026-08-13 screen had a critical structural issue for many candidates:
raw per-asset computation was on the OWN calendar, but the final smoothing
rolling window was applied on the UNION GRID (which includes weekends from
BTC/ETH). This dilutes/distorts rolling statistics for weekday assets.

This script re-computes ALL candidates with the rule:
  compute every rolling statistic on the per-asset OWN calendar;
  reindex to GRID only for the cross-sectional IC.

Candidates (all from the original screen family):
  1. trend_r2_60      R^2 of log-price linear trend (already own-correct)
  2. autocorr_20      lag-1 return autocorrelation (known FAIL)
  3. skew_60          Fisher skewness, 60d
  4. kurt_60          excess kurtosis, 60d
  5. bollinger_pos_20 (C-SMA20)/(2*std20)
  6. drawdown_60      C/rolling_max(C,60)-1
  7. vol_trend_20x60  volume 5d/60d - 1
  8. range_20         mean((H-L)/C, 20)
  9. gap_level_20     mean(overnight gap, 20)  (known FAIL but keep for audit)
  10. vol_zscore_60   z-score of 20d RV vs 60d history
  11. rv_ratio_10x60  10d std / 60d std
  12. hi_lo_pos_20    (C-min20)/(max20-min20)
  13. wti_beta_60     rolling beta vs WTI (already own-correct)
  14. btc_beta_60     rolling beta vs BTC (already own-correct)
  15. gk_cc_ratio_60  Garman-Klass / close-close vol (already own-correct)
  16. amihud_20       illiquidity proxy (already own-correct)
  17. vol_slope_20x60 (std20 - std60)/std60
  18. win_rate_20     share of up days
  19. close_loc_20    mean((2C-H-L)/(H-L), 20)

Gates: |IC|>=0.0070 AND |ICIR|>=0.0840 at h=10; n_dates >= 500.
"""
import json
import numpy as np
import pandas as pd
from pathlib import Path

DS = json.load(open("../persistent/date.json"))
TRADING_DAYS = DS["trading_days"]
VISIBLE = DS["visible_through"]
ROW0 = TRADING_DAYS.index("2020-01-01")
ROW1 = TRADING_DAYS.index(VISIBLE)
GRID = TRADING_DAYS[ROW0:ROW1 + 1]
print(f"grid rows: {len(GRID)}  {GRID[0]}..{GRID[-1]}  visible={VISIBLE}")

TRADABLES = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX",
             "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
DATA_DIR = Path("../persistent/stock_data")
HORIZON = 10
MIN_ASSETS = 8
GATE_IC, GATE_ICIR = 0.0070, 0.0840


def load_own(sym, cols):
    df = pd.read_csv(DATA_DIR / f"{sym}.csv", parse_dates=["date"])
    df = df[df["date"] <= pd.Timestamp(VISIBLE)].sort_values("date")
    df["date"] = df["date"].dt.strftime("%Y-%m-%d")
    df = df.set_index("date")
    return {c: pd.to_numeric(df[c], errors="coerce").astype(float) for c in cols}


OHLCV = {a: load_own(a, ["open", "high", "low", "close", "volume"]) for a in TRADABLES}
CLOSE_OWN = {a: OHLCV[a]["close"] for a in TRADABLES}
RET_OWN = {a: CLOSE_OWN[a].pct_change() for a in TRADABLES}
VOL20_OWN = {a: RET_OWN[a].rolling(20, min_periods=10).std() for a in TRADABLES}
VOL60_OWN = {a: RET_OWN[a].rolling(60, min_periods=30).std() for a in TRADABLES}


def to_grid(d):
    return pd.DataFrame(d, index=GRID)


def rown_series(fn, *wins):
    """fn(series, win) -> series on own calendar, then reindex."""
    pass  # not needed; build each explicitly


CAND = {}

# ---- 1. trend_r2_60 (own correct) ----
lr = {}
for a in TRADABLES:
    ys = np.log(CLOSE_OWN[a].dropna())
    x = pd.Series(np.arange(len(ys)), index=ys.index)
    cxy = ys.rolling(60, min_periods=30).cov(x)
    vx = x.rolling(60, min_periods=30).var()
    vy = ys.rolling(60, min_periods=30).var()
    b = cxy / np.where(np.abs(vx) < 1e-12, np.nan, vx)
    lr[a] = (b ** 2 * vx / np.where(np.abs(vy) < 1e-12, np.nan, vy)).reindex(GRID)
CAND["trend_r2_60"] = to_grid(lr)

# ---- 2. autocorr_20 (own correct) ----
ac = {}
for a in TRADABLES:
    r = RET_OWN[a]
    ac[a] = (r * r.shift(1)).rolling(20, min_periods=10).mean() / \
            np.where((r ** 2).rolling(20, min_periods=10).mean().abs() < 1e-12, np.nan,
                     (r ** 2).rolling(20, min_periods=10).mean())
    ac[a] = ac[a].reindex(GRID)
CAND["autocorr_20"] = to_grid(ac)

# ---- 3. skew_60 / 4. kurt_60 ----
sk = {}
ku = {}
for a in TRADABLES:
    sk[a] = RET_OWN[a].rolling(60, min_periods=30).skew().reindex(GRID)
    ku[a] = RET_OWN[a].rolling(60, min_periods=30).kurt().reindex(GRID)
CAND["skew_60"] = to_grid(sk)
CAND["kurt_60"] = to_grid(ku)

# ---- 5. bollinger_pos_20 ----
bp = {}
for a in TRADABLES:
    c = CLOSE_OWN[a]
    ma = c.rolling(20, min_periods=10).mean()
    sd = c.rolling(20, min_periods=10).std()
    bp[a] = ((c - ma) / np.where(np.abs(2 * sd) < 1e-12, np.nan, 2 * sd)).reindex(GRID)
CAND["bollinger_pos_20"] = to_grid(bp)

# ---- 6. drawdown_60 ----
dd = {}
for a in TRADABLES:
    c = CLOSE_OWN[a]
    dd[a] = (c / c.rolling(60, min_periods=30).max() - 1.0).reindex(GRID)
CAND["drawdown_60"] = to_grid(dd)

# ---- 7. vol_trend_20x60 ----
vt = {}
for a in TRADABLES:
    v = OHLCV[a]["volume"]
    v5 = v.rolling(5, min_periods=3).mean()
    v60 = v.rolling(60, min_periods=20).mean()
    vt[a] = (v5 / np.where(np.abs(v60) < 1e-12, np.nan, v60) - 1.0).reindex(GRID)
CAND["vol_trend_20x60"] = to_grid(vt)

# ---- 8. range_20 ----
rg = {}
for a in TRADABLES:
    df = OHLCV[a]
    rng = (df["high"] - df["low"]) / np.where(np.abs(df["close"]) < 1e-12, np.nan, df["close"])
    rg[a] = rng.rolling(20, min_periods=10).mean().reindex(GRID)
CAND["range_20"] = to_grid(rg)

# ---- 9. gap_level_20 ----
gp = {}
for a in TRADABLES:
    df = OHLCV[a]
    gap = df["open"] / df["close"].shift(1) - 1.0
    gp[a] = gap.rolling(20, min_periods=10).mean().reindex(GRID)
CAND["gap_level_20"] = to_grid(gp)

# ---- 10. vol_zscore_60 ----
vz = {}
for a in TRADABLES:
    rv = RET_OWN[a].rolling(20, min_periods=10).std()
    m = rv.rolling(60, min_periods=30).mean()
    s = rv.rolling(60, min_periods=30).std()
    vz[a] = ((rv - m) / np.where(np.abs(s) < 1e-12, np.nan, s)).reindex(GRID)
CAND["vol_zscore_60"] = to_grid(vz)

# ---- 11. rv_ratio_10x60 ----
vr = {}
for a in TRADABLES:
    r = RET_OWN[a]
    s10 = r.rolling(10, min_periods=8).std()
    s60 = r.rolling(60, min_periods=30).std()
    vr[a] = (s10 / np.where(np.abs(s60) < 1e-12, np.nan, s60)).reindex(GRID)
CAND["rv_ratio_10x60"] = to_grid(vr)

# ---- 12. hi_lo_pos_20 ----
hl = {}
for a in TRADABLES:
    c = CLOSE_OWN[a]
    hi = c.rolling(20, min_periods=10).max()
    lo = c.rolling(20, min_periods=10).min()
    hl[a] = ((c - lo) / np.where(np.abs(hi - lo) < 1e-12, np.nan, hi - lo)).reindex(GRID)
CAND["hi_lo_pos_20"] = to_grid(hl)

# ---- 13/14. beta factors ----
def rolling_beta(ar, mkt, window, min_obs):
    df = pd.concat([ar.rename("a"), mkt.reindex(ar.index).rename("m")], axis=1).dropna()
    cov = df["a"].rolling(window, min_periods=min_obs).cov(df["m"])
    var = df["m"].rolling(window, min_periods=min_obs).var()
    b = cov / np.where(np.abs(var) < 1e-12, np.nan, var)
    return b.reindex(ar.index)

wti_ret = RET_OWN["WTI"]
btc_ret = RET_OWN["BTC"]
wb, bb = {}, {}
for a in TRADABLES:
    wb[a] = rolling_beta(RET_OWN[a], wti_ret, 60, 30).reindex(GRID)
    bb[a] = rolling_beta(RET_OWN[a], btc_ret, 60, 30).reindex(GRID)
CAND["wti_beta_60"] = to_grid(wb)
CAND["btc_beta_60"] = to_grid(bb)

# ---- 15. gk_cc_ratio_60 ----
gk = {}
for a in TRADABLES:
    df = OHLCV[a]
    o, h, l, c = df["open"], df["high"], df["low"], df["close"]
    lp = np.log(c / o)
    hl2 = np.log(h / l)
    gk2 = (0.5 * hl2 ** 2 - (2 * np.log(2) - 1) * lp ** 2).clip(lower=0)
    cc2 = np.log(c / c.shift(1)) ** 2
    gv = np.sqrt(gk2.rolling(60, min_periods=30).mean())
    cv = np.sqrt(cc2.rolling(60, min_periods=30).mean())
    gk[a] = (gv / np.where(np.abs(cv) < 1e-12, np.nan, cv)).reindex(GRID)
CAND["gk_cc_ratio_60"] = to_grid(gk)

# ---- 16. amihud_20 ----
am = {}
for a in TRADABLES:
    df = OHLCV[a]
    v = df["volume"].replace(0, np.nan)
    ill = (df["close"].pct_change().abs() / np.where(np.abs(v) < 1e-12, np.nan, v))
    am[a] = ill.rolling(20, min_periods=10).mean().reindex(GRID)
CAND["amihud_20"] = to_grid(am)

# ---- 17. vol_slope_20x60 ----
vs = {}
for a in TRADABLES:
    r = RET_OWN[a]
    s20 = r.rolling(20, min_periods=10).std()
    s60 = r.rolling(60, min_periods=30).std()
    vs[a] = ((s20 - s60) / np.where(np.abs(s60) < 1e-12, np.nan, s60)).reindex(GRID)
CAND["vol_slope_20x60"] = to_grid(vs)

# ---- 18. win_rate_20 ----
wr = {}
for a in TRADABLES:
    wr[a] = (RET_OWN[a] > 0).rolling(20, min_periods=10).mean().reindex(GRID)
CAND["win_rate_20"] = to_grid(wr)

# ---- 19. close_loc_20 ----
cl = {}
for a in TRADABLES:
    df = OHLCV[a]
    loc = (2 * df["close"] - df["high"] - df["low"]) / \
          np.where(np.abs(df["high"] - df["low"]) < 1e-12, np.nan, df["high"] - df["low"])
    cl[a] = loc.rolling(20, min_periods=10).mean().reindex(GRID)
CAND["close_loc_20"] = to_grid(cl)

print("candidates computed:", len(CAND))


# ---- validation helpers ----
def fwd_panel(h):
    out = {}
    for a in TRADABLES:
        s = CLOSE_OWN[a]
        out[a] = (s.shift(-h) / s - 1.0).reindex(GRID)
    return pd.DataFrame(out, index=GRID)


def ic_series(fp, rp):
    dates = fp.index.intersection(rp.index)
    Fr = fp.loc[dates].rank(axis=1).values
    Rr = rp.loc[dates].rank(axis=1).values
    m = (~np.isnan(Fr)) & (~np.isnan(Rr))
    valid = m.sum(axis=1) >= MIN_ASSETS
    ics = np.full(len(dates), np.nan)
    for i in np.where(valid)[0]:
        f = Fr[i, m[i]] - Fr[i, m[i]].mean()
        r = Rr[i, m[i]] - Rr[i, m[i]].mean()
        d = np.sqrt((f * f).sum() * (r * r).sum())
        ics[i] = (f * r).sum() / d if d > 0 else np.nan
    return pd.Series(ics, index=dates)


def turnover_rank(fp, step=10):
    ranked = fp.rank(axis=1, pct=True)
    vals = []
    for i in range(step, len(ranked), step):
        a, b = ranked.iloc[i - step], ranked.iloc[i]
        m = a.notna() & b.notna()
        if m.sum() >= MIN_ASSETS:
            vals.append(float((b[m] - a[m]).abs().mean()))
    return float(np.mean(vals)) if vals else np.nan


LIB = {}
for f in sorted(Path("factors").glob("*.signal.npy")):
    try:
        a = np.load(f, allow_pickle=True)
        if a.shape[1] == 15:
            n = min(a.shape[0], len(GRID))
            LIB[f.stem.replace(".signal", "")] = pd.DataFrame(a[:n], index=GRID[:n], columns=TRADABLES)
    except Exception:
        pass
print("library artifacts:", len(LIB))


def panel_rank_corr(a, b):
    dates = a.index.intersection(b.index)
    Ar = a.loc[dates].rank(axis=1).values
    Br = b.loc[dates].rank(axis=1).values
    m = (~np.isnan(Ar)) & (~np.isnan(Br))
    valid = m.sum(axis=1) >= MIN_ASSETS
    cs = []
    for i in np.where(valid)[0]:
        x = Ar[i, m[i]] - Ar[i, m[i]].mean()
        y = Br[i, m[i]] - Br[i, m[i]].mean()
        d = np.sqrt((x * x).sum() * (y * y).sum())
        if d > 0:
            cs.append((x * y).sum() / d)
    return float(np.mean(cs)) if cs else 0.0


FWD = {h: fwd_panel(h) for h in (1, 2, 3, 5, 10, 20)}
results = {}
for name, F in CAND.items():
    ic10 = ic_series(F, FWD[10]).dropna()
    ic = float(ic10.mean())
    icir = float(ic10.mean() / ic10.std()) if len(ic10) > 1 and ic10.std() > 0 else 0.0
    hit = float((np.sign(ic10) == np.sign(ic)).mean()) if ic != 0 else 0.0
    cov_a = float(F.notna().sum().sum() / (F.shape[0] * F.shape[1]))
    cov_d = float((F.notna().sum(axis=1) >= MIN_ASSETS).mean())
    to = turnover_rank(F, HORIZON)
    libc = {fid: panel_rank_corr(F, sig) for fid, sig in LIB.items()}
    maxabs = max((abs(x) for x in libc.values()), default=0.0)
    topf = sorted(libc.items(), key=lambda kv: -abs(kv[1]))[:3]
    decay = {str(h): round(float(ic_series(F, FWD[h]).dropna().mean()), 4) for h in (1, 2, 3, 5, 10, 20)}
    ic250 = float(ic10.iloc[-250:].mean()) if len(ic10) >= 250 else float("nan")
    ic60 = float(ic10.iloc[-60:].mean()) if len(ic10) >= 60 else float("nan")
    passed = abs(ic) >= GATE_IC and abs(icir) >= GATE_ICIR and len(ic10) >= 500
    results[name] = dict(
        ic=round(ic, 4), icir=round(icir, 4), hit=round(hit, 3), n_ic_dates=int(len(ic10)),
        cov_a=round(cov_a, 4), cov_d=round(cov_d, 4), turnover=round(to, 4),
        maxlib=round(maxabs, 4), top_lib=[(k, round(v, 4)) for k, v in topf],
        decay=decay, ic250=round(ic250, 4), ic60=round(ic60, 4), pass_gate=passed)
    print(f"[{name:18s}] IC={ic:+.4f} ICIR={icir:+.4f} hit={hit:.3f} n={len(ic10):5d} "
          f"cov_a={cov_a:.3f} cov_d={cov_d:.3f} to={to:.3f} maxlib={maxabs:.3f} "
          f"ic250={ic250:+.4f} ic60={ic60:+.4f} => {'PASS' if passed else 'fail'}")
    print(f"     top: {', '.join(f'{k}:{x:+.3f}' for k, x in topf)}  "
          f"decay: {', '.join(f'{h}:{v:+.3f}' for h, v in decay.items())}")

json.dump({"visible": VISIBLE, "grid_rows": len(GRID), "results": results},
          open("scripts/miner_1_20260813_corrected_results.json", "w"), indent=1)
print("\nsaved scripts/miner_1_20260813_corrected_results.json")
