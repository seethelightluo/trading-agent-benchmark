214 def turnover_10d(fname):
215     diffs = []
216     prev = None
217     for t in GRID:
218         vals = {s: FACTORS[s].loc[t, fname] for s in ASSETS
219                 if s in FACTORS and t in FACTORS[s].index and pd.notna(FACTORS[s].loc[t, fname])}
220         if len(vals) < MIN_ASSETS:
221             prev = None
222             continue
223         rk = pd.Series(vals).rank(pct=True)
224         if prev is not None and len(prev.index.intersection(rk.index)) >= MIN_ASSETS:
225             common = prev.index.intersection(rk.index)
226             diffs.append(float((rk[common] - prev[common]).abs().mean()))
227         prev = rk
228     return float(np.mean(diffs)) if diffs else np.nan
