<｜｜DSML｜｜parameter name="content" string="true">"""miner_1 exploration 2026-07-30: screen candidate factor families on the 15-asset
cross-asset universe. Data visible through 2026-07-29. No lookahead: factors use
values up to t; forward returns use asset-own-calendar t+1..t+h.
"""
import sys, time
sys.path.insert(0, "scripts")
import numpy as np
import pandas as pd
from miner_1_lib import (load_panel, macro_series, per_asset, validate_factor,
                         load_library_signals, report, TRADABLES, VISIBLE_THROUGH,
                         load_asset)

t0 = time.time()
panel = load_panel()
ret = per_asset(panel, lambda s: s.pct_change())
print(f"panel {panel.shape} dates {panel.index.min().date()}..{panel.index.max().date()} init {time.time()-t0:.1f}s", flush=True)

library = load_library_signals(panel)
print("library signals built", flush=True)

# --- Load OHLC for all assets once ---
ohlc = {}
for a in TRADABLES:
    df = load_asset(a)
    ohlc[a] = {
        "high": pd.Series(df["high"].astype(float).values, index=pd.to_datetime(df["date"])),
        "low": pd.Series(df["low"].astype(float).values, index=pd.to_datetime(df["date"])),
        "volume": pd.Series(df["volume"].astype(float).values, index=pd.to_datetime(df["date"])),
    }
high = pd.concat({a: ohlc[a]["high"] for a in TRADABLES}, axis=1).sort_index()
low = pd.concat({a: ohlc[a]["low"] for a in TRADABLES}, axis=1).sort_index()
vol = pd.concat({a: ohlc[a]["volume"] for a in TRADABLES}, axis=1).sort_index()
print("OHLC loaded", flush=True)

cands = {}

# C1: 60d drawdown from running max (negative values)
cands["dd_from_high_60d"] = per_asset(panel, lambda s: s / s.rolling(60).max() - 1.0)

# C2: 120d drawdown from running max
cands["dd_from_high_120d"] = per_asset(panel, lambda s: s / s.rolling(120).max() - 1.0)

# C3: 20d skewness of returns
cands["skew_20d"] = per_asset(panel, lambda s: s.pct_change().rolling(20).skew())

# C4: vol term structure: 5d vol / 60d vol
cands["vol_ts_5x60"] = per_asset(panel, lambda s: s.pct_change().rolling(5).std() / s.pct_change().rolling(60).std())

# C5: 20d risk-adjusted momentum (mean/std)
cands["risk_adj_mom_20d"] = per_asset(panel, lambda s: s.pct_change().rolling(20).mean() / s.pct_change().rolling(20).std())

# C6: 60d risk-adjusted momentum (mean/std)
cands["risk_adj_mom_60d"] = per_asset(panel, lambda s: s.pct_change().rolling(60).mean() / s.pct_change().rolling(60).std())

# C7: volume ratio 20d/60d (per-asset, unit-free)
cands["vol_ratio_20x60"] = vol.rolling(20).mean() / vol.rolling(60).mean()

# C8: residual momentum 20d: asset ret - equal-weight market, then 20d sum
mkt = ret.mean(axis=1)
cands["resid_mom_20d"] = ret.sub(mkt, axis=0).rolling(20).sum()

# C9: 20d distance above 20d low (drawup)
cands["dist_from_low_20d"] = per_asset(panel, lambda s: s / s.rolling(20).min() - 1.0)

# C10: US10Y-beta conditional (rates risk)
us10y = macro_series("US10Y").pct_change()
rate_beta = {}
for a in panel.columns:
    s = panel[a].dropna()
    ar = s.pct_change()
    df = pd.concat([ar.rename("a"), us10y.reindex(ar.index).rename("r")], axis=1).dropna()
    b = df["a"].rolling(60).cov(df["r"]) / df["r"].rolling(60).var()
    rate_beta[a] = b.reindex(panel.index)
rate_beta_panel = pd.DataFrame(rate_beta, index=panel.index)
us10y_close = macro_series("US10Y")
us10y_20 = us10y_close / us10y_close.shift(20) - 1.0
cands["rate_beta_cond_60x20"] = rate_beta_panel * us10y_20.reindex(rate_beta_panel.index)

# C11: 30d momentum skip 10d
cands["mom_30d_skip10"] = per_asset(panel, lambda s: s.shift(10) / s.shift(40) - 1.0)

# C12: 60d momentum skip 20d
cands["mom_60d_skip20"] = per_asset(panel, lambda s: s.shift(20) / s.shift(80) - 1.0)

# C13: EMA crossover (20/60)
cands["ema_20_60"] = per_asset(panel, lambda s: s.ewm(span=20, adjust=False).mean() / s.ewm(span=60, adjust=False).mean() - 1.0)

# C14: high-low range expansion ratio 20d/60d
cands["range_ratio_20x60"] = ((high - low) / panel).rolling(20).mean() / ((high - low) / panel).rolling(60).mean()

# C15: 20d range position (buying pressure) - needs OHLC per-asset calendars
rp = {}
for a in TRADABLES:
    df = load_asset(a)
    h = df["high"].astype(float).values
    l = df["low"].astype(float).values
    c = df["close"].astype(float).values
    denom = (h - l)
    denom[denom == 0] = np.nan
    r = pd.Series((c - l) / denom, index=pd.to_datetime(df["date"]), name=a)
    rp[a] = r.rolling(20).mean()
cands["range_pos_20d"] = pd.DataFrame(rp, index=panel.index).sort_index()

# C16: 60d volatility (realized vol)
cands["vol_60d"] = per_asset(panel, lambda s: s.pct_change().rolling(60).std())

# C17: 20d volatility (realized vol)
cands["vol_20d"] = per_asset(panel, lambda s: s.pct_change().rolling(20).std())

# C18: rolling 120d Sharpe ratio (annualized ignored, monotone)
cands["sharpe_120d"] = per_asset(panel, lambda s: s.pct_change().rolling(120).mean() / s.pct_change().rolling(120).std())

print(f"candidates built {time.time()-t0:.1f}s", flush=True)

results = {}
for name, sig in cands.items():
    sig = sig.reindex(panel.index)
    if sig is None or sig.shape[1] != 15:
        print(f"skip {name}: shape {None if sig is None else sig.shape}", flush=True)
        continue
    m = validate_factor(sig, panel, horizons=(1, 2, 3, 5, 10, 20),
                        admission_horizon=10, library=library)
    results[name] = m
    report(name, m)
    print(flush=True)

print("\n=== ranked summary ===", flush=True)
for name, m in sorted(results.items(), key=lambda kv: abs(kv[1]["icir"]), reverse=True):
    print(f"{name:24s} IC={m['ic']: .4f} ICIR={m['icir']: .4f} hit={m['ic_hit_ratio']} n={m['n_ic_dates']} cov={m['coverage_asset_days']} maxlib={m['max_abs_library_correlation']}", flush=True)
print("done", time.time()-t0)
