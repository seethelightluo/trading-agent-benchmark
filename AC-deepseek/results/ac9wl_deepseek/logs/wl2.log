210 def turnover_10d(fname):
211     """Mean absolute change of cross-sectional normalized rank over 10d."""
212     diffs = []
213     prev = None
214     for t in GRID:
215         vals = {s: FACTORS[s].loc[t, fname] for s in ASSETS
216                 if s in FACTORS and t in FACTORS[s].index and pd.notna(FACTORS[s].loc[t, fname])}
217         if len(vals) < MIN_ASSETS:
218             prev = None
219             continue
220         rk = pd.Series(vals).rank(pct=True)
221         if prev is not None and len(prev.index.intersection(rk.index)) >= MIN_ASSETS:
222             common = prev.index.intersection(rk.index)
223             diffs.append(float((rk[common] - prev[common]).abs().mean()))
224         prev = rk
225     return float(np.mean(diffs)) if diffs else np.nan
