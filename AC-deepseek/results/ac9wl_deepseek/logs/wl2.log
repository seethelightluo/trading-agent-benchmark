print("\n=== regime breakdown for selected (IC10 / ICIR10 / n) ===")
regimes = [("2020-01-01", "2021-12-31"), ("2022-01-01", "2022-12-31"),
           ("2023-01-01", "2024-12-31"), ("2025-01-01", "2026-07-29")]
