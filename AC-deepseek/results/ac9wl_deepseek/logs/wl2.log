40 def forward_returns(prices, horizon):
41     """Per-asset forward returns on each asset's own calendar, reindexed."""
42     fwd = {}
43     for a, s in prices.items():
44         f = (s.shift(-horizon) / s - 1.0)
45         fwd[a] = f
46     return pd.DataFrame(fwd)
