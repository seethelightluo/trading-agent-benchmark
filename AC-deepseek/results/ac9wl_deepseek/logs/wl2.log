m2=np.isfinite(a2)&np.isfinite(b2)\n        last60[i,j]=np.corrcoef(a2[m2],b2[m2])[0,1] if m2.sum()>10 else np.nan\n\nprint(\'FULL-window pairwise |rho| on as-consumed transformed signals (>=0.5 highlighted):\')\nfor i in range(n):\n    for j in range(i+1,n):\n        r=abs(full[i,j])\n        if r>=0.30 or (r>=0.5):\n            flag=\' <== GATE\' if r>=0.5 else \'\'\n            print(f"  {names[i]:<26} vs {names[j]:<26} rho={full[i,j]:+.3f} | last60={last60[i,j]:+.3f}{flag}")\nprint()\nprint(\'last60 pairwise |rho| >= 0.5:\')\nfor i in range(n):\n    for j in range(i+1,n):\n        r=abs(last60[i,j])\n        if r>=0.5:\n            print(f"  {names[i]:<26} vs {names[j]:<26} last60={last60[i,j]:+.3f}")\n\nprint()\nprint(\'Final-date (2026-07-29) coverage per factor:\')\nfor c in cands:\n    last=c[\'M\'][-1]\n    print(f"  {c[\'fid\']:<26} {np.sum(~np.isnan(last))}/15 non-NaN")\nEOF'})
