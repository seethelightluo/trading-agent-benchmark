  ▶️ shell({'command': 'python - <<\'EOF\'\nimport pandas as pd, numpy as np, glob, os\n\nassets = [\'000300.SH\',\'SPX\',\'HSI\',\'N225\',\'SX5E\',\'000688.SH\',\'SOX\',\'NDX\',\'XAU\',\'COPPER\',\'WTI\',\'BTC\',\'ETH\',\'US10Y\',\'CN10Y\']\ncloses = {}\nfor a in assets:\n    df = pd.read_csv(f\'../persistent/stock_data/{a}.csv\')\n    df[\'date\'] = pd.to_datetime(df[\'date\'])\n    df = df[df[\'date\'] <= \'2026-08-12\'].set_index(\'date\')[\'close\']\n    closes[a] = df\npx = pd.DataFrame(closes).dropna(how=\'all\')\npx = px[px.index <= \'2026-08-12\']\nprint("rows through:", px.index[-1].date(), "n=", len(px))\n\nret = px.pct_change()\nlast = px.iloc[-1]\nfor d in [5,10,20,60]:\n    r = last / px.iloc[-1-d] - 1 if len(px) > d else np.nan\n    print(f"\\n--- {d}d returns ---")\n    for a in assets:\n        if a in r.index:\n            print(f"{a:10s} {r[a]*100:+7.2f}%")\nprint("\\n--- 60d MA position (price/MA60-1) ---")\nma60 = px.rolling(60).mean().iloc[-1]\nprint((last/ma60-1).round(4).to_string())\nprint("\\nBreadth above 60d MA:", int((last>ma60).sum()), "/", len(assets))\n\n# realized vol\nvol20 = ret.tail(20).std()*np.sqrt(252)\nprint("\\n20d ann realized vol:")\nprint(vol20.round(3).sort_values(ascending=False).to_string())\nprint("median:", vol20.median().round(4))\n\n# pairwise correlation\nc = ret.tail(20).corr().abs()\nprint("\\nmean pairwise |20d corr|:", np.nanmean(c.values[np.triu_indices_from(c.values,1)]).round(3))\n\n# dispersion\nxs = ret.tail(10).std(axis=1)  # cross-sectional std of daily rets\nprint("mean daily cross-sectional std (10d):", xs.mean().round(4), "ann:", (xs.mean()*np.sqrt(252)).round(3))\n\n# drawdown from 60d high\ndd = px/px.rolling(60).max()-1\nprint("\\n60d drawdown from high:")\nprint(dd.iloc[-1].round(4).to_string())\nEOF'})
