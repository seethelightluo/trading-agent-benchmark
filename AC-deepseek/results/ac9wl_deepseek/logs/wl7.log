<｜｜DSML｜｜parameter name="content" string="true">"""miner_1: cycle 7b - refine near-miss / promising families with de-correlation and
parameter sweeps. Focus: (1) sharpe_20d orthogonalized to rel_mom / mom family,
(2) days_since_high variants (30/120d, normalized), (3) signed streak variants
(10d, 30d, with mean reversion sign), (4) inter-asset lead-lag (SPX->other 1-2d),
(5) weekday seasonality conditional.
Admission gates: |IC10| >= 0.007, |ICIR10| >= 0.084, library |rho| < 0.5.
"""
import sys, time
sys.path.insert(0, "scripts")
import numpy as np
import pandas as pd
from scipy.stats import rankdata
from miner_1_metrics import load_panel, load_macro, MIN_ASSETS, FACTOR_LAST, evaluate

WATCH = ["000300.SH", "000688.SH", "SPX", "NDX", "SOX", "HSI", "N225", "SX5E",
         "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]


def per_asset(fn):
    def wrapper(panel, *series_list):
        cols = {}
        for a in panel.columns:
            s = panel[a].dropna()
            args = tuple(sr[a].reindex(s.index) for sr in series_list)
            cols[a] = fn(s, *args)
        return pd.DataFrame(cols, index=panel.index)
    return wrapper


def fast_spearman(a, b):
    ra = rankdata(a); rb = rankdata(b)
    ra = ra - ra.mean(); rb = rb - rb.mean()
    denom = np.sqrt((ra * ra).sum() * (rb * rb).sum())
    return 0.0 if denom == 0 else float((ra * rb).sum() / denom)


def quick_screen(fvals, closes, horizon=10, min_assets=MIN_ASSETS, factor_last=FACTOR_LAST):
    fwd = closes.shift(-horizon) / closes - 1.0
    ics = []
    for dt in fvals.index:
        if dt > pd.Timestamp(factor_last):
            continue
        f = fvals.loc[dt]; r = fwd.loc[dt]
        m = f.notna() & r.notna() & np.isfinite(f) & np.isfinite(r)
        n = int(m.sum())
        if n < min_assets:
            continue
        ics.append(fast_spearman(f[m].values.astype(float), r[m].values.astype(float)))
    if len(ics) < 200:
        return None
    arr = np.array(ics)
    std = arr.std(ddof=1)
    return len(arr), float(arr.mean()), float(arr.mean() / std) if std > 0 else 0.0


def days_since_high(s, win=60):
    rollmax = s.rolling(win).max()
    newhigh = (s >= rollmax) & rollmax.notna()
    idx = pd.Series(np.arange(len(s)), index=s.index)
    last_true = idx.where(newhigh).ffill()
    days = (idx - last_true).where(rollmax.notna())
    return -np.log(1.0 + days)


def signed_streak(s, cap=20):
    r = s.pct_change()
    sign = np.sign(r)
    newrun = sign.ne(sign.shift(1)) | sign.isna()
    grp = newrun.cumsum()
    cnt = r.groupby(grp).cumcount() + 1
    streak = (cnt * sign).clip(-cap, cap)
    return streak


def library_signals(closes, vols, vix):
    rets = closes.pct_change()
    mkt_r = closes.mean(axis=1).pct_change()
    out = {}
    out["mom_10d_skip5"] = closes.shift(5) / closes.shift(15) - 1.0
    out["mom_120d_skip5"] = closes.shift(5) / closes.shift(125) - 1.0
    v = rets.rolling(20).std()
    out["vol_of_vol20x60"] = v.rolling(60).std()
    out["max_ret_20d"] = rets.rolling(20).max()
    out["downside_vol_ratio_20"] = -(rets.clip(upper=0).rolling(20).std() / rets.rolling(20).std())
    mom20 = closes.shift(5) / closes.shift(25) - 1.0
    out["rel_mom_20d_skip5"] = mom20.sub(mom20.median(axis=1), axis=0)
    out["beta_ew_60d"] = rets.rolling(60).cov(mkt_r) / mkt_r.rolling(60).var()
    vixr = vix.pct_change()
    out["vix_beta_cond_60x20"] = -(rets.rolling(60).cov(vixr) / vixr.rolling(60).var()) * (vix / vix.shift(20) - 1.0)
    amihud = (rets.abs() / vols.replace(0, np.nan))
    out["amihud_20"] = amihud.rolling(20).mean()
    return out


def library_corr(fvals, closes, libs, n_days=500):
    out = {}
    common = fvals.index.intersection(closes.index)
    for fid, lf in libs.items():
        cs = []
        for dt in common[-n_days:]:
            f = fvals.loc[dt]
            g = lf.loc[dt].reindex(f.index)
            m = f.notna() & g.notna() & np.isfinite(f.astype(float)) & np.isfinite(g.astype(float))
            if int(m.sum()) >= MIN_ASSETS:
                cs.append(fast_spearman(f[m].values.astype(float), g[m].values.astype(float)))
        out[fid] = round(float(np.mean(cs)), 4) if cs else None
    valid = [abs(v) for v in out.values() if v is not None]
    return (round(max(valid), 4) if valid else None), out


if __name__ == "__main__":
    t0 = time.time()
    frames = load_panel()
    closes = pd.DataFrame({s: f["close"].astype(float) for s, f in frames.items()}).sort_index()
    vols = pd.DataFrame({s: f["volume"].astype(float) for s, f in frames.items()}).sort_index()
    macro = {m: load_macro(m)["close"].astype(float) for m in ["VIX", "DXY", "USDJPY", "USDCNY", "EURUSD"]}
    vix = macro["VIX"]
    rets = closes.pct_change()
    mkt_r = closes.mean(axis=1).pct_change()
    print(f"panel {closes.index[0].date()}..{closes.index[-1].date()} rows={len(closes)} ({time.time()-t0:.1f}s)", flush=True)

    cands = {}

    # ---- 1) Sharpe 20d orthogonalized to rel_mom_20d_skip5 ----
    sh20 = (rets.rolling(20).mean() / rets.rolling(20).std().replace(0, np.nan))
    relmom20 = (closes.shift(5) / closes.shift(25) - 1.0).sub(
        (closes.shift(5) / closes.shift(25) - 1.0).median(axis=1), axis=0)
    # cross-sectional orthogonal residual at each date via rank-correlation regression
    orth = pd.DataFrame(index=sh20.index, columns=sh20.columns, dtype=float)
    for dt in sh20.index:
        f = sh20.loc[dt]; g = relmom20.loc[dt]
        m = f.notna() & g.notna() & np.isfinite(f) & np.isfinite(g)
        if m.sum() < MIN_ASSETS:
            continue
        fr = f[m].rank(); gr = g[m].rank()
        x = gr.values.astype(float); y = fr.values.astype(float)
        b = np.polyfit(x, y, 1)
        resid = pd.Series(y - np.polyval(b, x), index=f[m].index)
        orth.loc[dt, resid.index] = resid.values
    # median-center residual for cleaner signal
    cands["sharpe20_orth_relmom"] = orth.sub(orth.median(axis=1), axis=0)

    # ---- 2) days_since_high variants ----
    for w in (20, 30, 120):
        cands[f"days_high_{w}d"] = per_asset(lambda s, ww=w: days_since_high(s, ww))(closes)
    # cross-sectionally demeaned version
    dsh60 = cands["days_high_60d"]
    cands["z_days_high_60d"] = dsh60.sub(dsh60.mean(axis=1), axis=0).div(dsh60.std(axis=1).replace(0, np.nan), axis=0)

    # ---- 3) signed streak variants ----
    cands["streak_signed_10d"] = per_asset(lambda s: signed_streak(s, cap=10))(closes)
    cands["streak_signed_30d"] = per_asset(lambda s: signed_streak(s, cap=30))(closes)
    # streak change (acceleration of run)
    cands["streak_accel"] = cands["streak_signed_20d"] - cands["streak_signed_20d"].shift(5)

    # ---- 4) inter-asset lead-lag: SPX 1d / 2d lead on other assets ----
    spx_r = rets["SPX"]
    for lag in (1, 2):
        lead = spx_r.shift(lag)
        cands[f"spx_lead_{lag}d"] = pd.DataFrame({a: lead.reindex(closes.index) for a in closes.columns},
                                                 index=closes.index)
    # cross-sectional rank of SPX lead beta: 60d beta of each asset on lagged SPX
    def spx_beta_lag(s, a, lag):
        r = s.pct_change()
        x = spx_r.shift(lag).reindex(s.index)
        return r.rolling(60).cov(x) / x.rolling(60).var()
    cols = {}
    for a in closes.columns:
        s = closes[a].dropna()
        cols[a] = spx_beta_lag(s, a, 1).reindex(closes.index)
    cands["spx_lead_beta_60d"] = pd.DataFrame(cols, index=closes.index)

    # ---- 5) weekday seasonality conditional on recent momentum ----
    # factor: asset's average weekday return over last 60d minus overall avg (per weekday)
    def weekday_mom(s, win=60):
        r = s.pct_change()
        wd = r.index.dayofweek
        out = pd.Series(np.nan, index=r.index)
        for d in range(5):
            mask = (wd == d)
            avg = r[mask].rolling(win // 5).mean()
            out[mask] = avg
        return out
    cands["weekday_avg_60d"] = per_asset(weekday_mom)(closes)

    # ---- quick screen ----
    print("\n=== Quick screen (h10 only) ===", flush=True)
    passed = {}
    for fid, fv in cands.items():
        q = quick_screen(fv, closes)
        if q is None:
            print(f"{fid:24s} INSUFFICIENT dates", flush=True)
            continue
        n, ic, icir = q
        ok = abs(ic) >= 0.007 and abs(icir) >= 0.084
        print(f"{fid:24s} IC10={ic:+.4f} ICIR10={icir:+.4f} n={n} -> {'PASS' if ok else 'fail'}", flush=True)
        if ok:
            passed[fid] = fv
    print(f"screen done ({time.time()-t0:.1f}s)", flush=True)

    libs = library_signals(closes, vols, vix)
    results = {}
    for fid, fv in passed.items():
        if fid != "sharpe20_orth_relmom":
            # skip full library corr for speed on non-sharpe variants; still check
            pass
        res = evaluate(fv, closes, label=fid)
        if res is None:
            continue
        maxrho, per = library_corr(fv, closes, libs)
        res["max_abs_library_correlation"] = maxrho
        results[fid] = res
        flag = "OK" if (maxrho is not None and maxrho < 0.5) else "HIGH-CORR"
        print(f"\n{fid}: full -> IC10={res['ic']:+.4f} ICIR10={res['icir']:+.4f} hit={res['ic_hit_ratio']:.3f} "
              f"turn={res['turnover_10d_rank']:.2f} cov={res['coverage_asset_days']:.2f} "
              f"decay={res['decay_ic_by_horizon']} max_rho={maxrho} {flag}", flush=True)
        if maxrho is not None and maxrho >= 0.5:
            print(f"  -> excluded: library correlation too high", flush=True)

    # per-year robustness for passers (only those with max_rho < 0.5)
    fwd = closes.shift(-10) / closes - 1.0
    for fid in results:
        if results[fid].get("max_abs_library_correlation", 1.0) is None:
            continue
        if results[fid]["max_abs_library_correlation"] is not None and results[fid]["max_abs_library_correlation"] >= 0.5:
            continue
        fv = passed[fid]
        yrs = {}
        for dt in fv.index:
            if dt > pd.Timestamp(FACTOR_LAST):
                continue
            f = fv.loc[dt]; r = fwd.loc[dt]
            m = f.notna() & r.notna() & np.isfinite(f) & np.isfinite(r)
            if m.sum() < MIN_ASSETS:
                continue
            yrs.setdefault(dt.year, []).append(fast_spearman(f[m].values.astype(float), r[m].values.astype(float)))
        parts = []
        for y in sorted(yrs):
            arr = np.array(yrs[y])
            parts.append(f"{y}: ic={arr.mean():+.4f} icir={arr.mean()/arr.std() if arr.std()>0 else 0:+.3f} n={len(arr)}")
        print(f"\n{fid:24s} " + " | ".join(parts), flush=True)
    print(f"total time {time.time()-t0:.1f}s", flush=True)
