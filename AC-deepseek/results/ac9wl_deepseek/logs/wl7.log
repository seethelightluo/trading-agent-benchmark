            vix20 = (vix / vix.shift(20) - 1.0).reindex(s.index)
            cols[a] = (-beta * vix20)
        out["vix_beta_cond_60x20"] = pd.DataFrame(cols, index=panel.index)
    except Exception as e:
        print(f"  (lib vix_beta unavailable: {e})")
    return out


