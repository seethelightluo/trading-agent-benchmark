# 4) downside vol ratio 20d (flip sign to make IC positive)
def make_downside_vol_ratio(win, flip=False):
    def f(s):
        r = s.pct_change()
        tot = r.rolling(win).std()
        dd = r.clip(upper=0).rolling(win).std()
        v = dd / tot
        return -v if flip else v
    return per_asset(f)

