<｜｜DSML｜｜parameter name="content" string="true">import pandas as pd, numpy as np

NAMES = ['000300.SH','000688.SH','BTC','CN10Y','COPPER','ETH','HSI','N225','NDX','SOX','SPX','SX5E','US10Y','WTI','XAU']
VIS = '2026-07-29'

def load(n):
    df = pd.read_csv(f'../persistent/stock_data/{n}.csv')
    df.columns = [c.strip().lower() for c in df.columns]
    df['date'] = pd.to_datetime(df['date'])
    df = df.sort_values('date').reset_index(drop=True)
    return df[df['date'] <= VIS].set_index('date')

closes = {n: load(n)['close'].astype(float) for n in NAMES}
vols   = {n: load(n)['volume'].astype(float) for n in NAMES}
grid = pd.DatetimeIndex(sorted(set().union(*[c.index for c in closes.values()])))

# freeze check
print("Frozen (identical consecutive closes) as of 07-29:")
for n in NAMES:
    c = closes[n]
    fr = 0
    for i in range(1, min(25, len(c))):
        if c.iloc[-1-i] == c.iloc[-1]:
            fr += 1
        else:
            break
    last = c.index[-1].date()
    print(f"  {n:<10} last={last} frozen_days={fr}")

# ---- recompute factor signals on own calendars ----
R = pd.DataFrame({n: closes[n].reindex(grid).pct_change() for n in NAMES})
F = {nf: {} for nf in ['rel_mom_raw','mom_120d_skip5','beta_ew_60d','vol_of_vol20x60','vix_beta_cond_60x20','amihud_20','mom_10d_skip5']}
for n in NAMES:
    s = closes[n]
    pct = s.pct_change()
    F['mom_10d_skip5'][n] = (s.shift(5)/s.shift(15)-1).reindex(grid)
    F['mom_120d_skip5'][n] = (s.shift(5)/s.shift(125)-1).reindex(grid)
    F['rel_mom_raw'][n] = (s.shift(5)/s.shift(25)-1).reindex(grid)
    rv20 = pct.rolling(20).std()
    F['vol_of_vol20x60'][n] = rv20.rolling(60).std().reindex(grid)
    av = (pct.abs()/vols[n].replace(0,np.nan)).rolling(20,min_periods=10).mean()
    F['amihud_20'][n] = av.reindex(grid)

for n in NAMES:
    own = closes[n].index
    mkt = R.loc[own].mean(axis=1, skipna=True)
    r = closes[n].pct_change()
    cov = r.rolling(60).cov(mkt); var = mkt.rolling(60).var()
    F['beta_ew_60d'][n] = (cov/var).reindex(grid)

vdf = pd.read_csv('../persistent/index_data/VIX.csv')
vdf.columns = [c.strip().lower() for c in vdf.columns]
vdf['date'] = pd.to_datetime(vdf['date'])
vix = vdf[vdf['date'] <= VIS].sort_values('date').set_index('date')['close'].astype(float)
vixr = vix.pct_change()
vix_up = vix/vix.shift(20)-1.0
for n in NAMES:
    own = closes[n].index
    v_own = vixr.reindex(own).ffill()
    v_up_own = vix_up.reindex(own).ffill()
    r = closes[n].pct_change()
    b = r.rolling(60).cov(v_own)/v_own.rolling(60).var()
    F['vix_beta_cond_60x20'][n] = (-b*v_up_own).reindex(grid)

# ---- weighted composite (ensemble as persisted) ----
ens = {"rel_mom_20d_skip5": (0.22, 1, 'rel_mom_raw'),
       "mom_120d_skip5":    (0.16, 1, 'mom_120d_skip5'),
       "beta_ew_60d":       (0.15, 1, 'beta_ew_60d'),
       "vol_of_vol20x60":   (0.14, 1, 'vol_of_vol20x60'),
       "vix_beta_cond_60x20":(0.15, -1, 'vix_beta_cond_60x20'),
       "amihud_20":         (0.12, 1, 'amihud_20'),
       "mom_10d_skip5":     (0.06, 1, 'mom_10d_skip5')}

last = {}
for fid, (w, d, fact) in ens.items():
    row = pd.DataFrame(F[fact]).iloc[-1]
    rk = row.rank(pct=True)
    last[fid] = rk

comp = pd.Series(0.0, index=NAMES)
detail = {}
for fid, (w, d, fact) in ens.items():
    contrib = w * d * last[fid].reindex(NAMES).fillna(0.5)
    detail[fid] = contrib
    comp += contrib

print("\nComposite ensemble score (as-of 07-29; rank in [0,1], NaN->0.5):")
out = pd.DataFrame(detail).assign(COMPOSITE=comp).sort_values('COMPOSITE', ascending=False)
out.columns = [c[:12] for c in out.columns]
print(out.round(3).to_string())

# def block vs mom block
def_block = sum(last[f].fillna(0.5) for f in ['vix_beta_cond_60x20','amihud_20','vol_of_vol20x60'])/3
mom_block = sum(last[f].fillna(0.5) for f in ['rel_mom_20d_skip5','mom_120d_skip5','mom_10d_skip5'])/3
print(f"\nAvg rank defensive block: {def_block.mean():.3f}; momentum block: {mom_block.mean():.3f}")
