def rolling_beta(x: pd.DataFrame, m: pd.Series, win=60, minp=30) -> pd.DataFrame:
    cov = x.rolling(win, min_periods=minp).cov(m)
    var = m.rolling(win, min_periods=minp).var()
    return cov / var.replace(0, np.nan)


