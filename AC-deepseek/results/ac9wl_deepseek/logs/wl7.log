104 def library_signals(panel: pd.DataFrame) -> dict[str, pd.DataFrame]:
105     """Recompute all 10 effective library factors deterministically on panel."""
106     rets = panel.pct_change()
107     mkt = panel.mean(axis=1).pct_change()
108     v = rets.rolling(20, min_periods=10).std()
109     out = {}
110     out["mom_10d_skip5"] = panel.shift(5) / panel.shift(15) - 1.0
111     out["mom_120d_skip5"] = panel.shift(5) / panel.shift(125) - 1.0
112     out["vol_of_vol20x60"] = v.rolling(60, min_periods=30).std()
113     out["max_ret_20d"] = rets.rolling(20, min_periods=10).max()
114     dd = rets.clip(upper=0).rolling(20, min_periods=10).std()
115     out["downside_vol_ratio_20"] = -(dd / (v + EPS))
116     m20 = panel.shift(5) / panel.shift(25) - 1.0
117     out["rel_mom_20d_skip5"] = m20.sub(m20.median(axis=1), axis=0)
118     cov = rets.rolling(60, min_periods=30).cov(mkt)
119     var = mkt.rolling(60, min_periods=30).var().replace(0, np.nan)
120     out["beta_ew_60d"] = cov / var
121     macro = load_macro()
122     vixr = macro["VIX"].pct_change()
123     bv = rets.rolling(60, min_periods=30).cov(vixr) / vixr.rolling(60, min_periods=30).var().replace(0, np.nan)
124     out["vix_beta_cond_60x20"] = -bv * (macro["VIX"] / macro["VIX"].shift(20) - 1.0)
125     out["vol_adj_mom_20x60"] = m20 / (v + EPS)
126     vols = {a: pd.read_csv(f"../persistent/stock_data/{a}.csv").assign(
127         date=lambda d: pd.to_datetime(d["date"])).set_index("date").sort_index()["volume"].astype(float)
128         for a in WATCH}
129     volp = pd.DataFrame(vols, index=panel.index)
130     out["amihud_20"] = (rets.abs() / volp.replace(0, np.nan)).rolling(20, min_periods=10).mean()
131     return out
132 
