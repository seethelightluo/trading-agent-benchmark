<｜｜DSML｜｜parameter name="content" string="true">"""Quick timing verification for miner_1_fastlib"""
import sys, time
import numpy as np
import pandas as pd
sys.path.insert(0, "scripts")
import miner_1_fastlib as fl

t0 = time.time()
panel = fl.load_panel()
print(f"load_panel: {time.time()-t0:.1f}s, shape={panel.shape}")

t0 = time.time()
fwd = {h: fl.fwd_returns(panel, h) for h in fl.HORIZONS}
print(f"fwd_returns: {time.time()-t0:.1f}s")

t0 = time.time()
libs = fl.library_signals(panel)
print(f"library_signals (10 libs): {time.time()-t0:.1f}s, keys={list(libs.keys())}")

# test rank_ic_fast on a synthetic factor (mom_10d_skip5 with direction 1)
factor = panel.shift(5) / panel.shift(15) - 1.0
factor_w = factor.loc[:fl.FACTOR_LAST]

t0 = time.time()
ics = fl.rank_ic_fast(factor_w, fwd[10])
print(f"rank_ic_fast h10: {time.time()-t0:.3f}s, n={len(ics)}, mean={ics.mean():.4f}, std={ics.std():.4f}")

t0 = time.time()
turn = fl.turnover_10d_rank_fast(factor_w)
print(f"turnover_10d_rank_fast: {time.time()-t0:.3f}s, value={turn:.4f}")

t0 = time.time()
mc, per = fl.lib_corr_fast(factor_w, libs)
print(f"lib_corr_fast (10 libs, 700 dates): {time.time()-t0:.3f}s, max_corr={mc}, per={per}")

# full validation timing
t0 = time.time()
res = fl.validate_fast("timing_test", factor, panel, fwd, libs)
print(f"\nFull validate_fast: {time.time()-t0:.1f}s")
print(f"  ic10={res['ic_h10']:.4f} icir10={res['icir_h10']:.4f} maxcorr={res['max_abs_library_correlation']} pass={res['admission_gate']['pass']}")
