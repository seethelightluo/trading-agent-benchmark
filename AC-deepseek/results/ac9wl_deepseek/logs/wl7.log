66: def rank_ic_series(factor: pd.DataFrame, fwd: pd.DataFrame) -> pd.Series:
67:     ics = {}
68:     idx = factor.index.intersection(fwd.index)
69:     for d in idx:
70:         f = factor.loc[d].dropna()
71:         r = fwd.loc[d].reindex(f.index).dropna()
72:         if len(r) < MIN_ASSETS:
73:             continue
74:         ics[d] = spearmanr(f.reindex(r.index), r)[0]
75:     return pd.Series(ics).sort_index()
