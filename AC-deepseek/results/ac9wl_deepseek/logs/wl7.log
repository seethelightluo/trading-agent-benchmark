  ▶️ shell({'command': 'python - <<\'EOF\'\nimport pandas as pd, numpy as np\n\nNAMES = [\'000300.SH\',\'000688.SH\',\'BTC\',\'CN10Y\',\'COPPER\',\'ETH\',\'HSI\',\'N225\',\'NDX\',\'SOX\',\'SPX\',\'SX5E\',\'US10Y\',\'WTI\',\'XAU\']\nVIS = \'2026-07-29\'\n\ndef load_close(n):\n    df = pd.read_csv(f\'../persistent/stock_data/{n}.csv\')\n    df.columns = [c.strip().lower() for c in df.columns]\n    df[\'date\'] = pd.to_datetime(df[\'date\'])\n    df = df.sort_values(\'date\').reset_index(drop=True)\n    df = df[df[\'date\'] <= VIS].reset_index(drop=True)\n    return df\n\ncloses = {}\nvols = {}\nfor n in NAMES:\n    df = load_close(n)\n    closes[n] = df.set_index(\'date\')[\'close\'].astype(float)\n    vols[n] = df.set_index(\'date\')[\'volume\'].astype(float)\n\n# common date grid (union, require coverage)\nall_dates = sorted(set().union(*[c.index for c in closes.values()]))\ngrid = pd.DatetimeIndex(all_dates)\n\ndef series(name):\n    return closes[name].reindex(grid)\n\n# ---------- factor computation ----------\nfactors = {}\nfor n in NAMES:\n    s = series(n)\n    pct = s.pct_change()\n    # momentum family\n    factors.setdefault(\'mom_10d_skip5\', {})[n] = s.shift(5)/s.shift(15) - 1.0\n    factors.setdefault(\'mom_120d_skip5\', {})[n] = s.shift(5)/s.shift(125) - 1.0\n    rel20 = s.shift(5)/s.shift(25) - 1.0\n    factors.setdefault(\'rel_mom_raw\', {})[n] = rel20\n    # vol\n    rv20 = pct.rolling(20).std()\n    factors.setdefault(\'vol_of_vol20x60\', {})[n] = rv20.rolling(60).std()\n    # downside vol ratio (flipped): -(downside_semivol/total_vol)\n    neg = pct.where(pct < 0, 0.0)\n    ds = neg.rolling(20).std()\n    factors.setdefault(\'downside_vol_ratio_20\', {})[n] = -(ds / rv20)\n    # max ret 20d\n    factors.setdefault(\'max_ret_20d\', {})[n] = pct.rolling(20).max()\n    # amihud\n    av = abs(pct)/vols[n].reindex(grid).replace(0, np.nan)\n    factors.setdefault(\'amihud_20\', {})[n] = av.rolling(20, min_periods=10).mean()\n\n# EW market return for beta\nmkt_ret = pd.DataFrame({n: series(n).pct_change() for n in NAMES}).mean(axis=1, skipna=True)\nfor n in NAMES:\n    r = series(n).pct_change()\n    cov = r.rolling(60).cov(mkt_ret)\n    var = mkt_ret.rolling(60).var()\n    factors.setdefault(\'beta_ew_60d\', {})[n] = cov/var\n\n# vix_beta_cond\nvix = pd.read_csv(\'../persistent/index_data/VIX.csv\')\nvix.columns = [c.strip().lower() for c in vix.columns]\nvix[\'date\'] = pd.to_datetime(vix[\'date\'])\nvix = vix[vix[\'date\'] <= VIS].sort_values(\'date\').set_index(\'date\')[\'close\'].astype(float)\nvixr = vix.pct_change()\nvix_up = vix/vix.shift(20) - 1.0\nfor n in NAMES:\n    r = series(n).pct_change()\n    b = r.rolling(60).cov(vixr)/vixr.rolling(60).var()\n    factors.setdefault(\'vix_beta_cond_60x20\', {})[n] = -b * vix_up\n\n# ---------- cross-sectional rank IC ----------\ndef rank_ic(fact_dict, horizon=10, max_dates=120, min_cov=8):\n    F = pd.DataFrame(fact_dict)\n    fwd = pd.DataFrame({n: series(n).shift(-horizon)/series(n) - 1.0 for n in NAMES})\n    dates = F.index\n    ics = []\n    for t in range(len(dates)-horizon):\n        d = dates[t]\n        frow = F.loc[d]; rrow = fwd.loc[d]\n        m = frow.notna() & rrow.notna()\n        if m.sum() < min_cov: continue\n        ic = frow[m].rank().corr(rrow[m].rank())\n        if pd.notna(ic): ics.append((d, ic))\n    ics = pd.DataFrame(ics, columns=[\'date\',\'ic\']).set_index(\'date\')\n    return ics\n\nprint("Recent cross-sectional rank IC (h=10), trailing windows:")\nprint(f"{\'factor\':<22}{\'last60\':>8}{\'last120\':>8}{\'warmup_full\':>12}")\nfor fid in [\'rel_mom_raw\',\'mom_120d_skip5\',\'beta_ew_60d\',\'vol_of_vol20x60\',\'vix_beta_cond_60x20\',\'amihud_20\',\'mom_10d_skip5\',\'downside_vol_ratio_20\',\'max_ret_20d\']:\n    ics = rank_ic(factors[fid])\n    last60 = ics[\'ic\'].iloc[-60:].mean()\n    last120 = ics[\'ic\'].iloc[-120:].mean()\n    full = ics[\'ic\'].mean()\n    print(f"{fid:<22}{last60:>8.4f}{last120:>8.4f}{full:>12.4f}")\n\n# rel_mom demeaned: print latest ranks\nF = pd.DataFrame(factors[\'rel_mom_raw\'])\nlast_row = F.iloc[-1]\nprint("\\nLatest rel_mom raw (20d skip5) by asset:")\nprint(last_row.dropna().sort_values().round(4))\nEOF'})
