    def amihud(panel):
        cols = {}
        for a in panel.columns:
            df = getattr(sys.modules[__name__], "_get_ohlcv")(a)
            s = panel[a].dropna()
            if df is None:
                continue
            v = df.reindex(s.index)["volume"].astype(float)
            r = s.pct_change().abs()
            cols[a] = (r / v.replace(0, np.nan)).rolling(20).mean()
