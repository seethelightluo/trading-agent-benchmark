  ▶️ shell({'command': 'python -c "\nimport json, glob, numpy as np\n\nfactors = {}\nfor f in glob.glob(\'factors/*.json\'):\n    if f.endswith(\'.bak\') or \'ensemble\' in f: continue\n    d = json.load(open(f))\n    m = d[\'validation\'][\'metrics\']\n    factors[d[\'factor_id\']] = dict(\n        ic=m[\'ic\'], icir=m[\'icir\'], hit=m[\'ic_hit_ratio\'],\n        turn=m[\'turnover_10d_rank\'], maxcorr=m[\'max_abs_library_correlation\'],\n        dir=d[\'expected_direction\'], tags=d[\'tags\'])\n\nprint(f\'{\\"factor\\":22s} {\\"ic\\":>7s} {\\"icir\\":>7s} {\\"q\\":>8s} {\\"turn\\":>5s} {\\"corr\\":>5s}\')\nfor k,v in sorted(factors.items(), key=lambda x: -abs(x[1][\'ic\']*x[1][\'icir\'])):\n    q = abs(v[\'ic\']*v[\'icir\'])\n    print(f\'{k:22s} {v[\\"ic\\"]:7.4f} {v[\\"icir\\"]:7.4f} {q:8.5f} {v[\\"turn\\"]:5.2f} {v[\\"maxcorr\\"]:5.2f}\')\n\n# Selection: drop mom_10d (turnover 4.09, whipsaw in reversal) and max_ret_20d (tail fragility in drawdowns)\nselected = [\'rel_mom_20d_skip5\',\'vol_adj_mom_20x60\',\'mom_120d_skip5\',\'beta_ew_60d\',\n            \'vol_of_vol20x60\',\'downside_vol_ratio_20\',\'vix_beta_cond_60x20\',\'amihud_20\']\nq = {k: abs(factors[k][\'ic\']*factors[k][\'icir\']) for k in selected}\nraw = {k: q[k]/sum(q.values()) for k in selected}\nprint()\nprint(\'Raw quality tilt:\')\nfor k in selected: print(f\'  {k:22s} {raw[k]:.4f}\')\nprint(\'  sum:\', round(sum(raw.values()),6))\n\n# Regime adjustments (risk-off, VIX +32% in 10 sessions):\nadj = raw.copy()\nadj[\'vix_beta_cond_60x20\'] = 0.14          # defensive boost in VIX-spike regime\nadj[\'downside_vol_ratio_20\'] = 0.10        # low-downside tilt in risk-off\nadj[\'amihud_20\'] = 0.09                    # liquidity premium in stress, low turnover\nadj[\'rel_mom_20d_skip5\'] = 0.19            # capped below raw tilt (momentum crowding)\nadj[\'vol_adj_mom_20x60\'] = 0.17\nadj[\'mom_120d_skip5\'] = 0.13\nadj[\'beta_ew_60d\'] = 0.09                  # trimmed (risk-on beta fragile)\nadj[\'vol_of_vol20x60\'] = 0.09\nprint()\nprint(\'Regime-adjusted weights:\', {k: round(v,4) for k,v in adj.items()})\nprint(\'sum:\', round(sum(adj.values()),6))\nprint(\'momentum cluster weight:\', round(adj[\'rel_mom_20d_skip5\']+adj[\'vol_adj_mom_20x60\']+adj[\'mom_120d_skip5\'],3))\nprint(\'defensive sleeve:\', round(adj[\'vix_beta_cond_60x20\']+adj[\'downside_vol_ratio_20\'],3))\n"'})
