lues, k=1)]\nprint(f"avg pairwise corr (10d rets, prior window): {vals_prior.mean():.3f}")\n\n# cross-sectional dispersion (std of 20d rets across assets)\nprint(f"\\nCS dispersion of 20d rets: {r20.std()*100:.2f}%  | of 5d rets: {r5.std()*100:.2f}%")\n\n# tail events: worst 5d moves\nprint("\\nWorst 5d movers:", dict(r5.sort_values().head(4).round(4)*100))\nprint("Best 5d movers:", dict(r5.sort_values().tail(3).round(4)*100))\nEOF'})
