  13 
  14 def per_asset(fn):
  15     """Apply fn on each asset's own trading calendar, reindex to union panel."""
  16     def wrapper(panel, *macro_series):
  17         cols = {}
  18         for a in panel.columns:
  19             s = panel[a].dropna()
  20             if macro_series:
  21                 idx = s.index
  22                 for ms in macro_series:
  23                     idx = idx.intersection(ms.dropna().index)
  24                 s = s.loc[idx]
  25                 args = tuple(ms.reindex(idx) for ms in macro_series)
  26                 cols[a] = fn(s, *args)
  27             else:
  28                 cols[a] = fn(s)
  29         return pd.DataFrame(cols, index=panel.index)
  30     return wrapper
  31 
  32 
  33 
  34 def ic_series_fast(factor, panel, h):
  35     """Vectorized per-date Spearman IC (numpy), all dates <= FACTOR_LAST."""
  36     fwd = fwd_returns(panel, h)
  37     dates = factor.index.intersection(fwd.index)
  38     dates = dates[dates <= pd.Timestamp(FACTOR_LAST)]
  39     F = factor.reindex(dates).values.astype(float)
  40     R = fwd.reindex(dates).values.astype(float)
  41     A = np.argsort(np.argsort(F, axis=1), axis=1).astype(float)
  42     B = np.argsort(np.argsort(R, axis=1), axis=1).astype(float)
  43     out, idx = [], []
  44     for i in range(len(dates)):
  45         m = np.isfinite(F[i]) & np.isfinite(R[i])
  46         if int(m.sum()) < MIN_ASSETS:
  47             continue
  48         a_, b_ = A[i][m], B[i][m]
  49         ma, mb = a_.mean(), b_.mean()
  50         num = float(((a_ - ma) * (b_ - mb)).sum())
  51         den = float(np.sqrt(((a_ - ma) ** 2).sum() * ((b_ - mb) ** 2).sum()))
  52         out.append(num / den if den > 0 else 0.0)
  53         idx.append(dates[i])
  54     return pd.Series(out, index=idx)
  55 
  56 
  57 def evaluate(factor, panel, horizons=(1, 2, 3, 5, 10, 20)):
  58     ics = {h: ic_series_fast(factor, panel, h) for h in horizons}
  59     ic10 = ics[10]
  60     if len(ic10) < 200:
  61         return None
  62     direction = float(np.sign(ic10.mean())) if np.isfinite(ic10.mean()) and ic10.mean() != 0 else 1.0
  63     out = {"direction": direction}
  64     for h in horizons:
  65         ic = ics[h] * direction
  66         out[f"ic_h{h}"] = float(ic.mean())
  67         out[f"icir_h{h}"] = float(ic.mean() / ic.std()) if len(ic) > 2 and ic.std() > 0 else float("nan")
  68         out[f"hit_h{h}"] = float((ic > 0).mean())
  69         out[f"n_h{h}"] = len(ic)
  70     fw = factor.loc[:FACTOR_LAST]
  71     out["coverage_asset_days"] = float(fw.notna().mean().mean())
  72     out["coverage_dates_ge8"] = float((fw.notna().sum(axis=1) >= MIN_ASSETS).mean())
  73     out["turnover_10d_rank"] = turnover_10d_rank(fw)
  74     return out
  75 
