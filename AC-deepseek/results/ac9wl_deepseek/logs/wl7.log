  ▶️ shell({'command': 'python - <<\'EOF\'\n# Patch round11 script: replace rank_ic_series with vectorized version\nwith open(\'scripts/miner_3_20260730_screen_round11.py\') as f:\n    src = f.read()\n\nold = \'\'\'def rank_ic_series(factor, fwd):\n    ics = []\n    for d in factor.index.intersection(fwd.index):\n        f = factor.loc[d].dropna()\n        r = fwd.loc[d].reindex(f.index).dropna()\n        if len(r) >= MIN_ASSETS:\n            ics.append((d, r.corr(f.reindex(r.index), method="spearman")))\n    return pd.Series(dict(ics)).sort_index()\'\'\'\n\nnew = \'\'\'def rank_ic_series(factor, fwd):\n    """Vectorized cross-sectional Spearman IC per date (min MIN_ASSETS)."""\n    f = factor.stack(dropna=False).rename("f")\n    r = fwd.stack(dropna=False).rename("r")\n    j = pd.concat([f, r], axis=1).dropna()\n    if len(j) == 0:\n        return pd.Series(dtype=float)\n    j["fr"] = j.groupby(level=0)["f"].rank()\n    j["rr"] = j.groupby(level=0)["r"].rank()\n    cnt = j.groupby(level=0).size()\n    keep = cnt[cnt >= MIN_ASSETS].index\n    j = j[j.index.get_level_values(0).isin(keep)]\n    g = j.groupby(level=0)[["fr", "rr"]]\n    n = g.size()\n    sx, sy = g["fr"].sum(), g["rr"].sum()\n    sxx, syy = (g["fr"] ** 2).sum(), (g["rr"] ** 2).sum()\n    sxy = (g["fr"] * g["rr"]).sum()\n    num = n * sxy - sx * sy\n    den = np.sqrt((n * sxx - sx ** 2) * (n * syy - sy ** 2))\n    ic = num / den\n    return ic.sort_index()\'\'\'\n\nassert old in src, "old block not found"\nsrc = src.replace(old, new)\nwith open(\'scripts/miner_3_20260730_screen_round11.py\', \'w\') as f:\n    f.write(src)\nprint("patched OK")\nEOF'})
