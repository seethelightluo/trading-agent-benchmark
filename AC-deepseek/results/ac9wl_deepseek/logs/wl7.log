            "direction": "LONG",
            "quantity": quantity,
            "available_quantity": quantity,
            "cost_price": prices[asset],
            "current_price": prices[asset],
            "market_value": target_value,
            "profit_loss": 0.0,
            "profit_loss_rate": 0.0,
        })

