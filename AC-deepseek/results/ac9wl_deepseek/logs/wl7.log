10 # Exact admitted M=10 weights: defensive/tail 56%, recovery/persistence/trend 29%, macro 15%.
11 FW = (.17, .15, .13, .11, .10, .08, .08, .07, .06, .05)
12 DEF = {"XAU", "US10Y", "CN10Y"}
13 DEF_W, CAP, TOP = .12, .15, 15
14 
15 def stock(a, n=145):
16     try: return get_stock_daily_data(a, days=n)
17     except Exception: return None
18 
19 def index(a, n=100):
20     try: return get_index_daily_data(a, days=n)
21     except Exception: return None
22 
23 def ranks(values, assets):
24     valid = sorted((float(v), a) for a, v in values.items() if v is not None and isfinite(float(v)))
25     out = {a: .5 for a in assets}
26     for i, (_, a) in enumerate(valid): out[a] = i / max(1, len(valid)-1)
27     return out
28 
29 def loading_contraction(y, x):
30     z = pd.concat([y.rename("y"), x.rename("x")], axis=1).dropna().tail(60)
31     def beta(n):
32         q=z.tail(n); var=float(q.x.var())
33         return float(q.y.cov(q.x)/var) if len(q)>=12 and var>1e-14 else None
34     new, old = beta(20), beta(60)
35     return old-new if new is not None and old is not None else None
36 
37 def capped_normalize(w, pref):
38     for _ in range(40):
39         excess=sum(max(0., x-CAP) for x in w.values())
40         w={a:min(CAP, max(0., x)) for a, x in w.items()}
41         room=[a for a,x in w.items() if x<CAP-1e-12]
42         if excess < 1e-12 or not room: break
43         den=sum(max(0.,pref.get(a,0.)) for a in room)
44         for a in room: w[a] += excess*(max(0.,pref.get(a,0.))/den if den else 1/len(room))
45     total=sum(w.values())
46     return {a:x/total for a,x in w.items()}
47 
