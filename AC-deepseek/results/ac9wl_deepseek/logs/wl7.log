161 # ---------- full 9-factor library for correlation audit ----------
162 def build_library():
163     lib = {}
164     mom20 = per_asset(lambda s: s.shift(5) / s.shift(25) - 1.0)(panel, macro)
165     lib["rel_mom_20d_skip5"] = mom20.sub(mom20.median(axis=1), axis=0)
166     lib["beta_ew_60d"] = per_asset(lambda s: rolling_beta(s, mkt, 60))(panel, macro)
167     lib["mom_120d_skip5"] = per_asset(lambda s: s.shift(5) / s.shift(125) - 1.0)(panel, macro)
168     lib["vol_of_vol20x60"] = per_asset(lambda s: s.pct_change().rolling(20).std().rolling(60).std())(panel, macro)
169     lib["max_ret_20d"] = per_asset(lambda s: s.pct_change().rolling(20).max())(panel, macro)
170     lib["downside_vol_ratio_20"] = per_asset(
171         lambda s: -(s.pct_change().clip(upper=0).rolling(20).std() / s.pct_change().rolling(20).std().replace(0, np.nan)))(panel, macro)
172     lib["mom_10d_skip5"] = per_asset(lambda s: s.shift(5) / s.shift(15) - 1.0)(panel, macro)
173     vix = macro["VIX"].dropna()
174     lib["vix_beta_cond_60x20"] = per_asset(
175         lambda s: -rolling_beta(s, vix, 60) * (vix / vix.shift(20) - 1.0).reindex(s.index))(panel, macro)
176     vols = {}
177     for a in panel.columns:
178         df = pd.read_csv(f"../persistent/stock_data/{a}.csv")
179         df["date"] = pd.to_datetime(df["date"])
180         df = df.set_index("date").sort_index()
181         v = df["volume"].astype(float).reindex(panel.index)
182         r = panel[a].pct_change().abs()
183         vols[a] = (r / v.replace(0, np.nan)).rolling(20).mean()
184     lib["amihud_20"] = pd.DataFrame(vols, index=panel.index)
185     return lib
