28: def _execution_price(dataset_dir: Path, symbol: str, current_date: str) -> float:
29:     path = dataset_dir / f"{symbol}.csv"
30:     if not path.exists():
31:         raise FileNotFoundError(f"Missing execution data for {symbol}: {path}")
32:     frame = pd.read_csv(path)
33:     required = {"date", "open", "close"}
34:     if not required.issubset(frame.columns):
35:         raise ValueError(f"Execution data for {symbol} lacks date/open/close")
36:     frame["date"] = pd.to_datetime(frame["date"])
37:     day = pd.Timestamp(current_date)
38:     exact = frame.loc[frame["date"] == day]
39:     if not exact.empty:
40:         value = float(exact.iloc[-1]["open"])
41:         if math.isfinite(value) and value > 0:
42:             return value
43:     previous = frame.loc[frame["date"] < day].sort_values("date")
44:     if previous.empty:
45:         raise ValueError(f"No execution price is available for {symbol} on {current_date}")
46:     value = float(previous.iloc[-1]["close"])
47:     if not math.isfinite(value) or value <= 0:
48:         raise ValueError(f"Invalid execution price for {symbol} on {current_date}")
49:     return value
50: 
51: 
52: def _solve_transfer(
53:     current_values: dict[str, float],
54:     weights: dict[str, float],
55:     pre_trade_nav: float,
56:     cost_bps: float,
57: ) -> tuple[dict[str, float], float, float]:
58:     post_trade_nav = pre_trade_nav
59:     rate = float(cost_bps) / 10_000.0
60:     for _ in range(100):
61:         targets = {asset: post_trade_nav * weight for asset, weight in weights.items()}
62:         transferred = sum(
63:             max(current_values.get(asset, 0.0) - target, 0.0)
64:             for asset, target in targets.items()
65:         )
66:         cost = transferred * rate
67:         updated_nav = pre_trade_nav - cost
68:         if abs(updated_nav - post_trade_nav) <= max(1e-9, pre_trade_nav * 1e-12):
69:             return (
70:                 {asset: updated_nav * weight for asset, weight in weights.items()},
71:                 transferred,
72:                 cost,
73:             )
74:         post_trade_nav = updated_nav
75:     raise RuntimeError("asset-transfer cost fixed point did not converge")
