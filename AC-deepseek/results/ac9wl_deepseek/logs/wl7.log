 18 # ---- OHLCV panel loader ----
 19 def load_ohlcv(days: int = 4000):
 20     closes, opens, highs, lows, vols = {}, {}, {}, {}, {}
 21     for s in WATCH:
 22         df = get_stock_daily_data(s, days=days)
 23         if df is None or not len(df):
 24             continue
 25         idx = pd.to_datetime(df["date"])
 26         closes[s] = df.set_index(idx)["close"].astype(float)
 27         opens[s] = df.set_index(idx)["open"].astype(float)
 28         highs[s] = df.set_index(idx)["high"].astype(float)
 29         lows[s] = df.set_index(idx)["low"].astype(float)
 30         vols[s] = df.set_index(idx)["volume"].astype(float)
 31     def tidy(d):
 32         p = pd.concat(d, axis=1, sort=True)
 33         return p[~p.index.duplicated(keep="last")].sort_index()
 34     return tidy(closes), tidy(opens), tidy(highs), tidy(lows), tidy(vols)
 35 
 36 close, open_, high, low, volume = load_ohlcv()
 37 print(f"close panel: {close.shape}, {close.index.min().date()} .. {close.index.max().date()}")
 38 
 39 def per_asset_ohlc(fn):
 40     def wrapper(panel_close, macro):
 41         cols = {}
 42         for a in panel_close.columns:
 43             s = panel_close[a].dropna()
 44             o = open_[a].reindex(s.index)
 45             h = high[a].reindex(s.index)
 46             l = low[a].reindex(s.index)
 47             v = volume[a].reindex(s.index)
 48             cols[a] = fn(s, o, h, l, v)
 49         return pd.DataFrame(cols, index=panel_close.index)
 50     return wrapper
 51 
 52 # ---- candidate 1: variance ratio VR(5) using 20d estimation window ----
 53 def cand_variance_ratio_20x5():
 54     @per_asset_ohlc
 55     def f(s, o, h, l, v):
 56         r = s.pct_change()
 57         var1 = r.rolling(20).var()
 58         var5 = s.pct_change(5).rolling(20).var()
 59         return var5 / (5.0 * var1)
 60     return f(close, load_macro())
 61 
 62 # ---- candidate 2: rolling Sharpe ratio 60d ----
 63 def cand_roll_sharpe_60():
 64     @per_asset_ohlc
 65     def f(s, o, h, l, v):
 66         r = s.pct_change()
 67         return r.rolling(60).mean() / r.rolling(60).std()
 68     return f(close, load_macro())
