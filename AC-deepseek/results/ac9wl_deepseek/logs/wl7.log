107 def library_corr(factor: pd.DataFrame, panel: pd.DataFrame, libs: dict) -> tuple:
108     """Mean per-date cross-sectional Spearman corr with each library factor."""
109     per = {}
110     common = factor.index.intersection(panel.index)
111     for fid, lf in libs.items():
112         cs = []
113         for dt in common[-700:]:
114             if dt not in factor.index or dt not in lf.index:
115                 continue
116             f = factor.loc[dt]
117             g = lf.loc[dt]
118             if isinstance(f, pd.DataFrame):
119                 f = f.iloc[-1]
120             if isinstance(g, pd.DataFrame):
121                 g = g.iloc[-1]
122             m = f.notna() & g.notna() & np.isfinite(f.astype(float)) & np.isfinite(g.astype(float))
123             m = m.reindex(f.index).fillna(False)
124             if int(m.sum()) >= MIN_ASSETS:
125                 cs.append(spearmanr(f[m], g[m])[0])
126         per[fid] = round(float(np.mean(cs)), 4) if cs else None
127     valid = [abs(v) for v in per.values() if v is not None]
128     return (round(max(valid), 4) if valid else float("nan")), per
