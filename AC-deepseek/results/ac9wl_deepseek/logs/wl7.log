78: def turnover_10d_rank(factor: pd.DataFrame) -> float:
79:     ranks = factor.rank(axis=1)
80:     out = []
81:     for i in range(10, len(ranks)):
82:         a, b = ranks.iloc[i - 10], ranks.iloc[i]
83:         both = a.dropna().index.intersection(b.dropna().index)
84:         if len(both) < MIN_ASSETS:
85:             continue
86:         out.append(float((a[both] - b[both]).abs().mean()))
87:     return float(np.mean(out)) if out else float("nan")
88: 
