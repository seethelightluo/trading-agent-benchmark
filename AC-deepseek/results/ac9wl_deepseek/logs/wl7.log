 263|             b = np.dot(xx, yy - yy.mean()) / np.dot(xx, xx)
 264|             out[i] = b * m
 265|         return pd.Series(out, index=s.index)
 266|     return per_asset(f)(close)
 267| 
 268| 
 269| # ---------------- validation ----------------
 270| def stacked_corr(cand, libsig):
 271|     out = {}
 272|     f = cand.stack().rename("f")
 273|     for fid, ls in libsig.items():
 274|         g = ls.stack().rename("g")
 275|         j = pd.concat([f, g], axis=1).dropna()
 276|         if len(j) < 100:
 277|             out[fid] = float("nan")
 278|             continue
 279|         r = j["f"].corr(j["g"], method="spearman")
 280|         out[fid] = float(r) if np.isfinite(r) else float("nan")
 281|     return out
 282| 
 283| 
 284| def validate(name, factor, close, libsig):
 285|     res = {"n_dates": int(factor.loc[:WARM_END].shape[0])}
 286|     fwd10 = fwd_returns(close, 10)
 287|     ic = rank_ic_series(factor.loc[:WARM_END], fwd10)
 288|     direction = 1.0 if ic.mean() >= 0 else -1.0
 289|     res["ic_h10"] = float(direction * ic.mean())
 290|     res["icir_h10"] = float(direction * ic.mean() / ic.std()) if len(ic) > 2 and ic.std() > 0 else float("nan")
 291|     res["hit_h10"] = float((direction * ic > 0).mean()) if len(ic) else float("nan")
 292|     res["n_h10"] = len(ic)
 293|     res["decay"] = {}
 294|     for h in (1, 2, 3, 5, 10, 20):
 295|         ic_h = rank_ic_series(factor.loc[:WARM_END], fwd_returns(close, h))
 296|         res["decay"][str(h)] = float(direction * ic_h.mean()) if len(ic_h) else float("nan")
 297|     valid = factor.loc[:WARM_END].notna()
 298|     res["coverage_asset_days"] = float(valid.mean().mean())
 299|     res["coverage_dates_ge8"] = float((valid.sum(axis=1) >= MIN_ASSETS).mean())
 300|     res["turnover_10d_rank"] = turnover_10d_rank(factor.loc[:WARM_END])
 301|     corrs = stacked_corr(factor.loc[:WARM_END], {k: v for k, v in libsig.items()})
 302|     res["max_abs_library_correlation"] = max((abs(v) for v in corrs.values()), default=float("nan"))
 303|     res["library_corrs"] = {k: round(v, 3) for k, v in sorted(corrs.items(), key=lambda kv: -abs(kv[1]))}
 304|     gate = abs(res["ic_h10"]) >= 0.007 and abs(res["icir_h10"]) >= 0.084
 305|     lowcorr = res["max_abs_library_correlation"] < 0.5
 306|     res["PASS"] = bool(gate and lowcorr)
 307|     print(f"=== {name} === dates={res['n_dates']} direction={direction:+.2f}")
 308|     print(f"  h10 IC={res['ic_h10']:+.4f} ICIR={res['icir_h10']:+.4f} hit={res['hit_h10']:.3f} n={res['n_h10']}")
 309|     print(f"  decay={res['decay']}")
 310|     print(f"  cov_asset={res['coverage_asset_days']:.3f} cov_ge8={res['coverage_dates_ge8']:.3f} turn={res['turnover_10d_rank']:.2f}")
 311|     print(f"  max_lib_corr={res['max_abs_library_correlation']:.3f} corrs={res['library_corrs']}")
 312|     print(f"  -> {'PASS' if res['PASS'] else 'FAIL'} (gate:{gate} corr:{lowcorr})")
 313|     print()
 314|     return res
 315| 
