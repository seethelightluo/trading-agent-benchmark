                 ("dd_vol_60x20", cand_dd_vol_60x20)]:
    f = fn(panel, macro)
    corrs = corr_with_lib(f, lib)
    maxc = max((abs(v) for v in corrs.values()), default=float("nan"))
    ic, sub = subperiod_stats(f)
    print(f"\n=== {name} ===")
