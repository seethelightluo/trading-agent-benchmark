  ▶️ write_file({'file_path': 'scripts/miner_2_20260730_screen_novel_family2.py', 'content': '"""miner_2 cycle: screen novel factor families (skew/kurt, vol-regime, macd, stoich,\nvolume flow, macro-cond beta, beta asymmetry, garman-klass, drawdown).\nUniverse: 15 tradable cross-asset instruments. Gate: |IC|>=0.007 & |ICIR|>=0.084 @ h=10.\n"""\nfrom __future__ import annotations\nimport sys, json\nsys.path.insert(0, "scripts")\nimport numpy as np\nimport pandas as pd\nfrom miner_2_lib import (WATCH, MACRO, MAX_VISIBLE, FACTOR_LAST, MIN_ASSETS,\n                         ADMISSION, load_panel, load_macro, per_asset,\n                         fwd_returns, rank_ic_series, turnover_10d_rank)\n\n# ---- full library factor recomputation (all 9 effective factors) ----\ndef full_library_signals(panel: pd.DataFrame) -> dict[str, pd.DataFrame]:\n    rets = panel.pct_change()\n    macro = load_macro()\n    out = {}\n    out["mom_10d_skip5"] = panel.shift(5) / panel.shift(15) - 1.0\n    out["mom_120d_skip5"] = panel.shift(5) / panel.shift(125) - 1.0\n    out["rel_mom_20d_skip5"] = (panel.shift(5) / panel.shift(25) - 1.0).sub(\n        (panel.shift(5) / panel.shift(25) - 1.0).median(axis=1), axis=0)\n    out["vol_of_vol20x60"] = rets.rolling(20).std().rolling(60).std()\n    out["max_ret_20d"] = rets.rolling(20).max()\n    r = rets.clip(upper=0)\n    out["downside_vol_ratio_20"] = -(r.rolling(20).std() / rets.rolling(20).std())\n    # beta to EW market\n    mkt = rets.mean(axis=1)\n    beta = rets.rolling(60).cov(mkt) / mkt.rolling(60).var()\n    out["beta_ew_60d"] = beta\n    vix = macro["VIX"]; vixr = vix.pct_change()\n    out["vix_beta_cond_60x20"] = -(rets.rolling(60).cov(vixr) / vixr.rolling(60).var()) * (vix / vix.shift(20) - 1.0)\n    # amihud 20: |ret| / volume (volume in contracts; rescale per asset with rolling median)\n    vol = pd.read_csv("../persistent/stock_data/000300.SH.csv")  # placeholder replaced below\n    amih = {}\n    for a in panel.columns:\n        df = pd.read_csv(f"../persistent/stock_data/{a}.csv")\n        df["date"] = pd.to_datetime(df["date"])\n        df = df[df["date"] <= MAX_VISIBLE].set_index("date").sort_index()\n        s = df["close"].astype(float)\n        v = df["volume"].astype(float)\n        am = (s.pct_change().abs() / v).rolling(20).mean()\n        am = am / am.rolling(252).median()\n        amih[a] = am\n    amih = pd.DataFrame(amih, index=panel.index)\n    out["amihud_20"] = amih\n    return out\n\n\ndef library_corr_all(factor: pd.DataFrame, panel: pd.DataFrame) -> tuple:\n    libs = full_library_signals(panel)\n    per = {}\n    common = factor.index.intersection(panel.index)\n    for fid, lf in libs.items():\n        cs = []\n        for dt in common[-700:]:\n            f = factor.loc[dt]\n            g = lf.loc[dt]\n            m = f.notna() & g.notna() & np.isfinite(f.astype(float)) & np.isfinite(g.astype(float))\n            m = m.reindex(f.index).fillna(False)\n            if int(m.sum()) >= MIN_ASSETS:\n                from scipy.stats import spearmanr\n                cs.append(spearmanr(f[m], g[m])[0])\n        per[fid] = round(float(np.mean(cs)), 4) if cs else None\n    valid = [abs(v) for v in per.values() if v is not None]\n    return (round(max(valid), 4) if valid else float("nan")), per\n\n\ndef evaluate(name: str, factor: pd.DataFrame, panel: pd.DataFrame) -> dict:\n    factor_w = factor.loc[:FACTOR_LAST]\n    fwd = fwd_returns(panel, 10)\n    ic = rank_ic_series(factor_w, fwd)\n    direction = float(np.sign(ic.mean())) if np.isfinite(ic.mean()) and ic.mean() != 0 else 1.0\n    ic = ic * direction\n    icir = float(ic.mean() / ic.std()) if len(ic) > 2 and ic.std() > 0 else float("nan")\n    hit = float((ic > 0).mean()) if len(ic) else float("nan")\n    valid = factor_w.notna()\n    cov_ad = float(valid.mean().mean())\n    cov_d8 = float((valid.sum(axis=1) >= MIN_ASSETS).mean())\n    to = turnover_10d_rank(factor_w)\n    max_corr, per = library_corr_all(factor_w, panel)\n    res = dict(name=name, n_dates=int(len(ic)), ic_h10=float(ic.mean()), icir_h10=icir,\n               hit_h10=hit, cov_ad=cov_ad, cov_d8=cov_d8, turnover=to,\n               max_corr=max_corr, per=per, direction=direction,\n               pass_=bool(abs(float(ic.mean())) >= ADMISSION["ic"] and abs(icir) >= ADMISSION["icir"]))\n    print(f"[{name}] ic10={res[\'ic_h10\']:+.4f} icir10={res[\'icir_h10\']:+.4f} "\n          f"hit={hit:.3f} n={res[\'n_dates\']} cov_ad={cov_ad:.3f} cov_d8={cov_d8:.3f} "\n          f"to={to:.3f} max_corr={max_corr:.3f} PASS={res[\'pass_\']}")\n    return res\n\n\nif __name__ == "__main__":\n    panel = load_panel()\n    rets = panel.pct_change()\n    macro = load_macro()\n    results = {}\n\n    # 1) skewness 60d\n    skew60 = per_asset(lambda s: s.pct_change().rolling(60).skew())(panel, macro)\n    results["skew_60"] = evaluate("skew_60", skew60, panel)\n\n    # 2) skewness 20d\n    skew20 = per_asset(lambda s: s.pct_change().rolling(20).skew())(panel, macro)\n    results["skew_20"] = evaluate("skew_20", skew20, panel)\n\n    # 3) kurtosis 60d\n    kurt60 = per_asset(lambda s: s.pct_change().rolling(60).kurt())(panel, macro)\n    results["kurt_60"] = evaluate("kurt_60", kurt60, panel)\n\n    # 4) vol regime shift: rv20/rv60 - 1\n    volmom = per_asset(lambda s: s.pct_change().rolling(20).std() / s.pct_change().rolling(60).std() - 1.0)(panel, macro)\n    results["vol_mom_20x60"] = evaluate("vol_mom_20x60", volmom, panel)\n\n    # 5) MACD-style: (ema12 - ema26)/close\n    def macd(s):\n        e12 = s.ewm(span=12, adjust=False).mean()\n        e26 = s.ewm(span=26, adjust=False).mean()\n        return (e12 - e26) / s\n    results["macd_12x26"] = evaluate("macd_12x26", per_asset(macd)(panel, macro), panel)\n\n    # 6) stochastic position 20d: (close - min20)/(max20 - min20)\n    def stoich(s):\n        lo = s.rolling(20).min(); hi = s.rolling(20).max()\n        return (s - lo) / (hi - lo)\n    results["stoich_20"] = evaluate("stoich_20", per_asset(stoich)(panel, macro), panel)\n\n    # 7) volume flow: vma5/vma60 - 1 (volume z)\n    def volflow(s):\n        return s / s.rolling(60).mean() - 1.0\n    vf = {}\n    for a in panel.columns:\n        df = pd.read_csv(f"../persistent/stock_data/{a}.csv")\n        df["date"] = pd.to_datetime(df["date"])\n        df = df[df["date"] <= MAX_VISIBLE].set_index("date").sort_index()\n        v = df["volume"].astype(float)\n        vf[a] = v.rolling(5).mean() / v.rolling(60).mean() - 1.0\n    results["vol_flow_5x60"] = evaluate("vol_flow_5x60", pd.DataFrame(vf, index=panel.index), panel)\n\n    # 8) DXY beta x DXY 20d trend (conditional)\n    dxy = macro["DXY"]; dxy_r = dxy.pct_change()\n    dxy_beta = rets.rolling(60).cov(dxy_r) / dxy_r.rolling(60).var()\n    dxy_cond = -dxy_beta * (dxy / dxy.shift(20) - 1.0)\n    results["dxy_beta_cond_60x20"] = evaluate("dxy_beta_cond_60x20", dxy_cond, panel)\n\n    # 9) USDCNY beta x trend (conditional)\n    cny = macro["USDCNY"]; cny_r = cny.pct_change()\n    cny_beta = rets.rolling(60).cov(cny_r) / cny_r.rolling(60).var()\n    cny_cond = -cny_beta * (cny / cny.shift(20) - 1.0)\n    results["cny_beta_cond_60x20"] = evaluate("cny_beta_cond_60x20", cny_cond, panel)\n\n    # 10) up/down beta asymmetry vs EW market (60d)\n    mkt = rets.mean(axis=1)\n    beta_asym = {}\n    for a in panel.columns:\n        r = rets[a]\n        up = (mkt > 0) & r.notna() & mkt.notna()\n        dn = (mkt <= 0) & r.notna() & mkt.notna()\n        bu = r[up].rolling(60).apply(lambda x: np.cov(x, mkt.loc[x.index])[0, 1] / np.var(mkt.loc[x.index]), raw=False) if up.sum() > 60 else pd.Series(np.nan, index=r.index)\n        bd = r[dn].rolling(60).apply(lambda x: np.cov(x, mkt.loc[x.index])[0, 1] / np.var(mkt.loc[x.index]), raw=False) if dn.sum() > 60 else pd.Series(np.nan, index=r.index)\n        beta_asym[a] = bu - bd\n    results["beta_asym_60"] = evaluate("beta_asym_60", pd.DataFrame(beta_asym, index=panel.index), panel)\n\n    # 11) Garman-Klass vol 20d (normalized by close)\n    gk = {}\n    for a in panel.columns:\n        df = pd.read_csv(f"../persistent/stock_data/{a}.csv")\n        df["date"] = pd.to_datetime(df["date"])\n        df = df[df["date"] <= MAX_VISIBLE].set_index("date").sort_index()\n        o, h, l, c = df["open"].astype(float), df["high"].astype(float), df["low"].astype(float), df["close"].astype(float)\n        gk[a] = (0.5 * (np.log(h / l) ** 2) - (2 * np.log(2) - 1) * (np.log(c / o) ** 2)).rolling(20).mean().apply(np.sqrt)\n    results["gk_vol_20"] = evaluate("gk_vol_20", pd.DataFrame(gk, index=panel.index), panel)\n\n    # 12) max drawdown depth 60d (negative of drawdown)\n    def mdd(s):\n        r = s / s.rolling(60).max() - 1.0\n        return r\n    results["dd_60"] = evaluate("dd_60", per_asset(mdd)(panel, macro), panel)\n\n    # 13) 10d reversal skip1 (short-term reversal candidate)\n    results["rev_10d_skip1"] = evaluate("rev_10d_skip1", -(panel.shift(1) / panel.shift(11) - 1.0), panel)\n\n    # 14) 5d momentum skip1\n    results["mom_5d_skip1"] = evaluate("mom_5d_skip1", panel.shift(1) / panel.shift(6) - 1.0, panel)\n\n    json.dump(results, open("scripts/miner_2_cycle5_results.json", "w"), indent=1, default=float)\n    print("\\nSaved cycle5 results.")\n'})
