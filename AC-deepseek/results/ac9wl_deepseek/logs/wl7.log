 147 def validate_fast(name: str, factor: pd.DataFrame, panel: pd.DataFrame,
 148                   fwd: dict[int, pd.DataFrame], libs: dict[str, pd.DataFrame],
 149                   fwd_rank_cache: dict[int, np.ndarray] | None = None) -> dict:
 150     factor = factor.reindex(panel.index).loc[:FACTOR_LAST]
 151     n_valid = int(factor.notna().sum().sum())
 152     if n_valid < 100:
 153         return {"name": name, "factor_rows": len(factor), "n_assets": panel.shape[1],
 154                 "admission_gate": {"pass": False}, "reason": "insufficient_data",
 155                 "n_valid": n_valid}
 156     res = {"name": name, "factor_rows": int(len(factor)), "n_assets": panel.shape[1]}
 157     ic_by_h = {}
 158     for h in HORIZONS:
 159         F = factor.rank(axis=1).values.astype(float)
 160         if fwd_rank_cache is not None and h in fwd_rank_cache:
 161             R = fwd_rank_cache[h]
 162         else:
 163             R = fwd[h].rank(axis=1).values.astype(float)
 164         ic_by_h[h] = pd.Series(row_pearson(F, R), index=factor.index)
 165     ic10 = ic_by_h[10]
 166     direction = float(np.sign(ic10.mean())) if np.isfinite(ic10.mean()) and ic10.mean() != 0 else 1.0
 167     for h in HORIZONS:
 168         ic = ic_by_h[h] * direction
 169         res[f"ic_h{h}"] = float(ic.mean())
 170         res[f"icir_h{h}"] = float(ic.mean() / ic.std()) if len(ic) > 2 and ic.std() > 0 else float("nan")
 171         res[f"hit_h{h}"] = float((ic > 0).mean())
 172         res[f"n_dates_h{h}"] = int(len(ic))
 173     res["direction"] = direction
 174     res["raw_ic_h10"] = float(ic10.mean())
 175     valid = factor.notna()
 176     res["coverage_asset_days"] = float(valid.mean().mean())
 177     res["coverage_dates_ge8"] = float((valid.sum(axis=1) >= MIN_ASSETS).mean())
 178     res["turnover_10d_rank"] = turnover_10d_rank_fast(factor)
 179     max_corr, per = lib_corr_fast(factor, libs)
 180     res["max_abs_library_correlation"] = max_corr
 181     res["library_corrs"] = per
 182     res["decay_ic_by_horizon"] = {str(h): round(res[f"ic_h{h}"], 4) for h in HORIZONS}
 183     gate_ic = abs(res["ic_h10"]) >= ADMISSION["ic"]
 184     gate_icir = abs(res["icir_h10"]) >= ADMISSION["icir"]
 185     gate_corr = (res["max_abs_library_correlation"] is None
 186                  or not np.isfinite(res["max_abs_library_correlation"])
 187                  or res["max_abs_library_correlation"] < ADMISSION["corr"])
 188     res["admission_gate"] = {"ic_pass": bool(gate_ic), "icir_pass": bool(gate_icir),
 189                              "corr_pass": bool(gate_corr),
 190                              "pass": bool(gate_ic and gate_icir and gate_corr)}
 191     flag = "PASS" if res["admission_gate"]["pass"] else "FAIL"
