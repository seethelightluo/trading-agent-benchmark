  ▶️ write_file({'file_path': 'scripts/miner_3_20260730_persist_round7.py', 'content': '"""miner_3 persistence of round-7 passing factors.\n\nCandidates that passed the admission gate (|IC|>=0.007, |ICIR|>=0.084 at h=10,\nlibrary correlation < 0.5) on the 15-asset cross-asset universe, warm-up window\n2020-01-01..2026-07-15:\n  1. eurusd_beta_cond_60x20  IC=+0.0351 ICIR=+0.1002 max_lib_corr=0.115\n  2. btc_lead_20             IC=+0.0394 ICIR=+0.0998 max_lib_corr=0.472\n\nThis script recomputes the exact factor panels and validation metrics, builds the\nbase64:zlib:csv signal artifact for the full available panel (rows=dates,\ncols=15 assets, sorted), and writes factors/<factor_id>.json in the library schema.\n"""\nfrom __future__ import annotations\nimport base64\nimport hashlib\nimport io\nimport json\nimport zlib\n\nimport numpy as np\nimport pandas as pd\nfrom alphacrafter.sim.utils import get_stock_daily_data, get_index_daily_data\n\nWATCH = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX",\n         "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]\nMACRO = ["DXY", "USDCNY", "USDJPY", "EURUSD", "VIX"]\nMIN_ASSETS = 8\nWARM_END = "2026-07-15"\nDAYS = 4000\n\nCOLS_SORTED = sorted(WATCH)\n\n\ndef load_ohlcv(days=DAYS):\n    closes, opens, highs, lows, vols = {}, {}, {}, {}, {}\n    for s in WATCH:\n        df = get_stock_daily_data(s, days=days)\n        if df is None or not len(df):\n            continue\n        df = df.set_index("date")\n        closes[s] = df["close"].astype(float)\n        opens[s] = df["open"].astype(float)\n        highs[s] = df["high"].astype(float)\n        lows[s] = df["low"].astype(float)\n        vols[s] = df["volume"].astype(float)\n\n    def _p(d):\n        p = pd.concat(d, axis=1, sort=True)\n        return p[~p.index.duplicated(keep="last")].sort_index()\n    return _p(closes), _p(opens), _p(highs), _p(lows), _p(vols)\n\n\ndef load_macro():\n    out = {}\n    for s in MACRO:\n        df = get_index_daily_data(s, days=DAYS)\n        if df is not None and len(df):\n            out[s] = df.set_index("date")["close"].astype(float)\n    return out\n\n\ndef per_asset(fn):\n    def wrapper(panel):\n        cols = {}\n        for a in panel.columns:\n            s = panel[a].dropna()\n            cols[a] = fn(s)\n        return pd.DataFrame(cols, index=panel.index)\n    return wrapper\n\n\ndef fwd_returns(panel, h):\n    cols = {}\n    for a in panel.columns:\n        s = panel[a].dropna()\n        cols[a] = s.shift(-h) / s - 1.0\n    return pd.DataFrame(cols, index=panel.index)\n\n\ndef rank_ic_series(factor, fwd):\n    ics = []\n    for d in factor.index.intersection(fwd.index):\n        f = factor.loc[d].dropna()\n        r = fwd.loc[d].reindex(f.index).dropna()\n        if len(r) >= MIN_ASSETS:\n            ics.append((d, r.corr(f.reindex(r.index), method="spearman")))\n    return pd.Series(dict(ics)).sort_index()\n\n\ndef turnover_10d_rank(factor):\n    ranks = factor.rank(axis=1)\n    out, dates = [], ranks.index\n    for i in range(10, len(dates)):\n        a, b = ranks.iloc[i - 10], ranks.iloc[i]\n        both = a.dropna().index.intersection(b.dropna().index)\n        if len(both) >= MIN_ASSETS:\n            out.append(float((a[both] - b[both]).abs().mean()))\n    return float(np.mean(out)) if out else float("nan")\n\n\ndef library_signals(close, high, low, vol, macro):\n    """Reconstruct the 10-factor effective library exactly (same code as round7)."""\n    lib = {}\n    r = close.pct_change()\n    lib["amihud_20"] = (r.abs() / vol).rolling(20).mean()\n    ew = close.mean(axis=1)\n    ew_r = ew.pct_change()\n    cols = {}\n    for a in close.columns:\n        s = close[a].dropna()\n        er = ew_r.reindex(s.index)\n        z = pd.concat([s.pct_change().rename("r"), er.rename("m")], axis=1).dropna()\n        cols[a] = z["r"].rolling(60).cov(z["m"]) / z["m"].rolling(60).var()\n    lib["beta_ew_60d"] = pd.DataFrame(cols, index=close.index)\n\n    def dsvr(s):\n        rr = s.pct_change()\n        down = rr.where(rr < 0, 0.0)\n        ds = np.sqrt((down ** 2).rolling(20).mean())\n        tot = rr.rolling(20).std()\n        return -(ds / tot)\n    lib["downside_vol_ratio_20"] = per_asset(dsvr)(close)\n    lib["max_ret_20d"] = r.rolling(20).max()\n    lib["mom_10d_skip5"] = per_asset(lambda s: s.shift(5) / s.shift(15) - 1.0)(close)\n    lib["mom_120d_skip5"] = per_asset(lambda s: s.shift(5) / s.shift(125) - 1.0)(close)\n    m20 = per_asset(lambda s: s.shift(5) / s.shift(25) - 1.0)(close)\n    lib["rel_mom_20d_skip5"] = m20.sub(m20.median(axis=1), axis=0)\n    vix = macro["VIX"].dropna()\n    vix20 = (vix / vix.shift(20) - 1.0)\n    cols = {}\n    for a in close.columns:\n        s = close[a].dropna()\n        z = pd.concat([s.pct_change().rename("r"), vix.pct_change().reindex(s.index).rename("v")], axis=1).dropna()\n        beta = z["r"].rolling(60).cov(z["v"]) / z["v"].rolling(60).var()\n        cols[a] = (-beta * vix20.reindex(s.index))\n    lib["vix_beta_cond_60x20"] = pd.DataFrame(cols, index=close.index)\n    lib["vol_adj_mom_20x60"] = per_asset(\n        lambda s: (s.shift(5) / s.shift(25) - 1.0) / s.pct_change().rolling(60).std())(close)\n    lib["vol_of_vol20x60"] = r.rolling(20).std().rolling(60).std()\n    return lib\n\n\ndef _beta_cond(close, m):\n    m = m.dropna()\n    m20 = (m / m.shift(20) - 1.0)\n    cols = {}\n    for a in close.columns:\n        s = close[a].dropna()\n        z = pd.concat([s.pct_change().rename("r"), m.pct_change().reindex(s.index).rename("x")], axis=1).dropna()\n        beta = z["r"].rolling(60).cov(z["x"]) / z["x"].rolling(60).var()\n        cols[a] = (beta * m20.reindex(s.index))\n    return pd.DataFrame(cols, index=close.index)\n\n\ndef cand_btc_lead_20(close):\n    lead = close["BTC"].dropna()\n    lm = (lead / lead.shift(20) - 1.0)\n    cols = {}\n    for a in close.columns:\n        s = close[a].dropna()\n        z = pd.concat([s.pct_change().rename("r"), lead.pct_change().reindex(s.index).rename("x")], axis=1).dropna()\n        beta = z["r"].rolling(60).cov(z["x"]) / z["x"].rolling(60).var()\n        cols[a] = (beta * lm.reindex(s.index))\n    return pd.DataFrame(cols, index=close.index)\n\n\ndef stacked_corr(cand, libsig):\n    out = {}\n    f = cand.stack().rename("f")\n    for fid, ls in libsig.items():\n        both = pd.concat([f, ls.stack().rename("l")], axis=1).dropna()\n        if len(both) >= 200:\n            out[fid] = float(np.corrcoef(both["f"], both["l"])[0, 1])\n    return out\n\n\ndef make_artifact(factor, factor_id, warm):\n    """Encode the full-panel factor signal as base64:zlib:csv."""\n    panel = factor.reindex(columns=COLS_SORTED)\n    df = panel.copy()\n    df.index = df.index.strftime("%Y-%m-%d")\n    csv_bytes = df.to_csv().encode("utf-8")\n    z = zlib.compress(csv_bytes)\n    b64 = base64.b64encode(z).decode("ascii")\n    n_valid = int(np.isfinite(panel.to_numpy(dtype=float)).sum())\n    sha = hashlib.sha256(panel.to_numpy(dtype=float).tobytes()).hexdigest()[:16]\n    return {\n        "format": "base64:zlib:csv",\n        "description": f"Factor signal panel: rows = dates, cols = assets. Shape ({panel.shape[0]}, {panel.shape[1]})",\n        "columns": COLS_SORTED,\n        "shape": [panel.shape[0], panel.shape[1]],\n        "n_valid_values": n_valid,\n        "sha256": sha,\n        "data": b64,\n    }\n\n\ndef validate_and_dump(name, factor, close, macro, libsig, factor_id, factor_name,\n                      expression, description, deps, params, tags, direction_note):\n    factor_w = factor.loc[:WARM_END]\n    fwd10 = fwd_returns(close, 10)\n    ic10 = rank_ic_series(factor_w, fwd10)\n    direction = float(np.sign(ic10.mean())) if np.isfinite(ic10.mean()) and ic10.mean() != 0 else 1.0\n    ic = ic10 * direction\n    icir = float(ic.mean() / ic.std()) if len(ic) > 2 and ic.std() > 0 else float("nan")\n    hit = float((ic > 0).mean())\n    n = len(ic)\n\n    horizons = (1, 2, 3, 5, 10, 20)\n    fwd = {h: fwd_returns(close, h) for h in horizons}\n    ics = {h: rank_ic_series(factor_w, fwd[h]) * direction for h in horizons}\n    decay = {str(h): round(float(ics[h].mean()), 4) for h in horizons}\n\n    valid = factor_w.notna()\n    cov_asset = float(valid.mean().mean())\n    cov_ge8 = float((valid.sum(axis=1) >= MIN_ASSETS).mean())\n    turn = turnover_10d_rank(factor_w)\n    corrs = stacked_corr(factor_w, libsig)\n    maxcorr = max((abs(v) for v in corrs.values()), default=float("nan"))\n\n    artifact = make_artifact(factor, factor_id, WARM_END)\n\n    metrics = {\n        "ic": round(float(ic.mean()), 4),\n        "icir": round(icir, 4),\n        "ic_hit_ratio": round(hit, 4),\n        "n_ic_dates": n,\n        "coverage_asset_days": round(cov_asset, 4),\n        "coverage_dates_ge8": round(cov_ge8, 4),\n        "turnover_10d_rank": round(turn, 4),\n        "decay_ic_by_horizon": decay,\n        "max_abs_library_correlation": round(maxcorr, 4),\n    }\n\n    doc = {\n        "factor_id": factor_id,\n        "factor_name": factor_name,\n        "version": "1.0.0",\n        "calculation": {\n            "expression": expression,\n            "description": description,\n        },\n        "dependencies": deps,\n        "parameters": params,\n        "expected_direction": int(direction),\n        "validation": {\n            "status": "EFFECTIVE",\n            "period": "2020-01-01..2026-07-15",\n            "last_validated": "2026-07-16",\n            "admission_horizon": 10,\n            "regime_notes": ("Validated 2020-01-01..2026-07-15 across multiple regimes: COVID crash 2020, "\n                             "recovery bull 2020-21, 2022 tightening bear, 2023-24 AI-led equity rally, "\n                             "2024-26 crypto/commodity cycles. Cross-sectional rank IC on the 15-asset "\n                             "tradable universe. " + direction_note),\n            "metrics": metrics,\n            "signal_artifact": artifact,\n        },\n        "tags": tags,\n        "benchmark_admission": {\n            "contract": {\n                "ic_threshold": 0.007,\n                "icir_threshold": 0.084,\n                "correlation_threshold": 0.5,\n                "library_capacity": 30,\n                "active_top_k": 10,\n            },\n            "selected_metrics": {\n                "ic": metrics["ic"],\n                "icir": metrics["icir"],\n                "metric_path": "validation.metrics",\n                "reported_max_abs_library_correlation": metrics["max_abs_library_correlation"],\n                "correlation_path": "validation.metrics.max_abs_library_correlation",\n                "quality": round(abs(metrics["ic"] * metrics["icir"]), 8),\n            },\n            "admitted_at": "2026-07-30T00:00:00.000000",\n        },\n    }\n    with open(f"factors/{factor_id}.json", "w", encoding="utf-8") as f:\n        json.dump(doc, f, ensure_ascii=False, indent=2)\n\n    print(f"=== persisted {factor_id} ===")\n    print(f"  h10 IC={metrics[\'ic\']:+.4f} ICIR={metrics[\'icir\']:+.4f} hit={metrics[\'ic_hit_ratio\']:.3f} n={n}")\n    print(f"  decay={decay}")\n    print(f"  cov_asset={metrics[\'coverage_asset_days\']:.3f} cov_ge8={metrics[\'coverage_dates_ge8\']:.3f} "\n          f"turn={metrics[\'turnover_10d_rank\']:.2f}")\n    print(f"  max_lib_corr={metrics[\'max_abs_library_correlation\']:.3f}")\n    print(f"  artifact shape={artifact[\'shape\']} n_valid={artifact[\'n_valid_values\']} sha={artifact[\'sha256\']}")\n    print()\n    return doc\n\n\nif __name__ == "__main__":\n    close, open_, high, low, vol = load_ohlcv()\n    macro = load_macro()\n    libsig = library_signals(close, high, low, vol, macro)\n    print(f"panel: {close.shape[0]} dates x {close.shape[1]} assets")\n\n    # eurusd_beta_cond_60x20\n    f_eur = _beta_cond(close, macro["EURUSD"])\n    validate_and_dump(\n        "eurusd_beta_cond_60x20", f_eur, close, macro, libsig,\n        factor_id="eurusd_beta_cond_60x20",\n        factor_name="EURUSD-beta conditional 60x20",\n        expression="beta(asset_ret, EURUSD_ret, 60) * (EURUSD/EURUSD.shift(20) - 1.0)",\n        description=("Conditional FX-risk signal: asset beta to EURUSD changes times the 20-day EURUSD move. "\n                     "Positive when an asset moves with a strengthening/weakening EUR while EUR trends. "\n                     "Direction set by h10 rank-IC sign (flip applied if negative)."),\n        deps=["close", "EURUSD"],\n        params={"beta_win": 60, "fx_win": 20},\n        tags=["macro-beta", "fx", "conditional"],\n        direction_note="Direction fixed to +1 by h10 rank-IC sign.",\n    )\n\n    # btc_lead_20\n    f_btc = cand_btc_lead_20(close)\n    validate_and_dump(\n        "btc_lead_20", f_btc, close, macro, libsig,\n        factor_id="btc_lead_20",\n        factor_name="BTC-lead beta 60x20",\n        expression="beta(asset_ret, BTC_ret, 60) * (BTC/BTC.shift(20) - 1.0)",\n        description=("Crypto-lead cross-asset signal: asset beta to BTC changes times the 20-day BTC move. "\n                     "Captures crypto-driven risk appetite spilling into equities/commodities. "\n                     "Direction set by h10 rank-IC sign (flip applied if negative)."),\n        deps=["close", "BTC"],\n        params={"beta_win": 60, "lead_win": 20},\n        tags=["lead-lag", "crypto", "conditional"],\n        direction_note="Direction fixed to +1 by h10 rank-IC sign.",\n    )\n\n    print("DONE")\n'})
