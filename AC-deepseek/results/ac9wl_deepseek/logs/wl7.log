151 def cand_eurusd_beta_cond_60x20(panel, macro):
152     eu = macro["EURUSD"].dropna()
153     def f(s):
154         z = pd.concat([s.pct_change().rename("r"), eu.pct_change().rename("m")], axis=1).dropna()
155         beta = z["r"].rolling(60).cov(z["m"]) / z["m"].rolling(60).var().replace(0, np.nan)
156         eu20 = (eu / eu.shift(20) - 1.0).reindex(s.index)
157         return beta * eu20
158     return per_asset(f)(panel, macro)
