    per[fid] = round(float(np.mean(cs)), 4) if cs else None
max_corr = round(max([abs(v) for v in per.values() if v is not None]), 4)
print("library corr:", per, "max:", max_corr)

gate_ic = abs(res["ic_h10"]) >= ADMISSION["ic"]
