50: print(f"\nsum weights = {sum(r['weight'] for r in rows):.6f}  (n={len(rows)})")
51: mom_w = sum(r["weight"] for r in rows if r["factor_id"] in ("mom_10d_skip5", "mom_120d_skip5", "rel_mom_20d_skip5"))
52: risk_w = sum(r["weight"] for r in rows if r["factor_id"] in ("downside_vol_ratio_20", "max_ret_20d", "vol_of_vol20x60", "beta_ew_60d", "vix_beta_cond_60x20"))
