  ▶️ write_file({'file_path': 'scripts/miner_1_20260730_cycle7_tail_persistence_momentum.py', 'content': '"""miner_1: cycle 7 research - NOVEL factor families on the 15-instrument cross-asset\nbenchmark. Families: (A) tail/asymmetric-risk (downside & asymmetric beta, kurtosis,\nleverage effect), (B) path persistence (Hurst, signed streak, days-since-high),\n(C) risk-adjusted momentum (rolling Sharpe), (D) volume/liquidity dynamics\n(volume regime, amihud trend), (E) pure macro correlation (VIX corr, US10Y beta).\nAdmission gates (benchmark contract): |IC10| >= 0.007, |ICIR10| >= 0.084.\nFactor dates <= 2026-07-15; data visible through 2026-07-29.\n"""\nimport sys\nsys.path.insert(0, "scripts")\nimport numpy as np\nimport pandas as pd\nfrom scipy.stats import spearmanr\nfrom miner_1_metrics import load_panel, load_macro, MIN_ASSETS, FACTOR_LAST, MAX_VISIBLE, evaluate, gate_pass\n\nWATCH = ["000300.SH", "000688.SH", "SPX", "NDX", "SOX", "HSI", "N225", "SX5E",\n         "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]\n\n\ndef per_asset(fn):\n    """Apply fn on each asset\'s own trading calendar, reindex to union panel."""\n    def wrapper(panel, *series_list):\n        cols = {}\n        for a in panel.columns:\n            s = panel[a].dropna()\n            args = tuple(sr[a].reindex(s.index) for sr in series_list)\n            cols[a] = fn(s, *args)\n        return pd.DataFrame(cols, index=panel.index)\n    return wrapper\n\n\ndef library_signals(closes, vols, vix, dxy, usdjpy, eurusd):\n    """Recompute all 9 currently-effective library factor signals."""\n    rets = closes.pct_change()\n    mkt = closes.mean(axis=1)\n    mkt_r = mkt.pct_change()\n    out = {}\n    out["mom_10d_skip5"] = closes.shift(5) / closes.shift(15) - 1.0\n    out["mom_120d_skip5"] = closes.shift(5) / closes.shift(125) - 1.0\n    v = rets.rolling(20).std()\n    out["vol_of_vol20x60"] = v.rolling(60).std()\n    out["max_ret_20d"] = rets.rolling(20).max()\n    out["downside_vol_ratio_20"] = -(rets.clip(upper=0).rolling(20).std() / rets.rolling(20).std())\n    mom20 = closes.shift(5) / closes.shift(25) - 1.0\n    out["rel_mom_20d_skip5"] = mom20.sub(mom20.median(axis=1), axis=0)\n    out["beta_ew_60d"] = rets.rolling(60).cov(mkt_r) / mkt_r.rolling(60).var()\n    vixr = vix.pct_change()\n    out["vix_beta_cond_60x20"] = -(rets.rolling(60).cov(vixr) / vixr.rolling(60).var()) * (vix / vix.shift(20) - 1.0)\n    amihud = (rets.abs() / vols.replace(0, np.nan))\n    out["amihud_20"] = amihud.rolling(20).mean()\n    return out\n\n\ndef library_corr(fvals, closes, libs, n_days=500):\n    """Max abs mean per-date cross-sectional rank corr vs library factors."""\n    out = {}\n    common = fvals.index.intersection(closes.index)\n    for fid, lf in libs.items():\n        cs = []\n        for dt in common[-n_days:]:\n            f = fvals.loc[dt]\n            g = lf.loc[dt].reindex(f.index)\n            m = f.notna() & g.notna() & np.isfinite(f.astype(float)) & np.isfinite(g.astype(float))\n            if int(m.sum()) >= MIN_ASSETS:\n                r, _ = spearmanr(f[m].astype(float), g[m].astype(float))\n                cs.append(r)\n        out[fid] = round(float(np.mean(cs)), 4) if cs else None\n    valid = [abs(v) for v in out.values() if v is not None]\n    return (round(max(valid), 4) if valid else None), out\n\n\n# ---------------- factor constructions ----------------\ndef rolling_beta_spread(r, m, win=60, min_obs=10):\n    """Asymmetric beta: beta on up-market days minus beta on down-market days (rolling)."""\n    out = pd.Series(np.nan, index=r.index)\n    up_b = pd.Series(np.nan, index=r.index)\n    dn_b = pd.Series(np.nan, index=r.index)\n    for t in range(win, len(r)):\n        ra = r.iloc[t - win:t].values\n        ma = m.iloc[t - win:t].values\n        msk = np.isfinite(ra) & np.isfinite(ma)\n        if msk.sum() < win - 5:\n            continue\n        ra, ma = ra[msk], ma[msk]\n        mvar = np.var(ma)\n        if mvar == 0:\n            continue\n        up = ma > 0\n        dn = ma < 0\n        if up.sum() >= min_obs and np.var(ma[up]) > 0:\n            up_b.iloc[t] = np.cov(ra[up], ma[up])[0, 1] / np.var(ma[up])\n        if dn.sum() >= min_obs and np.var(ma[dn]) > 0:\n            dn_b.iloc[t] = np.cov(ra[dn], ma[dn])[0, 1] / np.var(ma[dn])\n        if np.isfinite(up_b.iloc[t]) and np.isfinite(dn_b.iloc[t]):\n            out.iloc[t] = up_b.iloc[t] - dn_b.iloc[t]\n    return out\n\n\ndef hurst_rs(s, win=60):\n    """Rescaled range (R/S) Hurst exponent on log prices over rolling window."""\n    def _h(w):\n        w = w[~np.isnan(w)]\n        if len(w) < win // 2 or np.std(w) == 0:\n            return np.nan\n        d = np.diff(w)\n        mu = d.mean()\n        dev = d - mu\n        # multiple sub-window R/S\n        rs_vals = []\n        for m in (win // 4, win // 2, win):\n            if m < 8 or m > len(d):\n                continue\n            for start in range(0, len(d) - m + 1, m // 2 if m < win else len(d) - m + 1):\n                seg = dev[start:start + m]\n                c = np.cumsum(seg)\n                R = np.max(c) - np.min(c)\n                S = np.std(seg)\n                if S > 0:\n                    rs_vals.append(R / S)\n        if len(rs_vals) < 2:\n            return np.nan\n        return float(np.mean(rs_vals))\n    lp = np.log(s)\n    return lp.rolling(win).apply(_h, raw=True)\n\n\ndef signed_streak(s, cap=20):\n    """Signed length of the current consecutive same-sign return run."""\n    def _st(w):\n        w = w[~np.isnan(w)]\n        if len(w) < 5:\n            return np.nan\n        last = w[-1]\n        if last == 0:\n            return 0.0\n        sign = 1.0 if last > 0 else -1.0\n        cnt = 0\n        for x in w[::-1]:\n            if (x > 0) == (last > 0):\n                cnt += 1\n                if cnt >= cap:\n                    break\n            else:\n                break\n        return sign * min(cnt, cap)\n    return pd.Series(s.pct_change().values, index=s.index).rolling(cap + 5).apply(_st, raw=True)\n\n\ndef days_since_high(s, win=60):\n    """-log(1 + days since rolling max within window): fresher high -> larger."""\n    def _d(w):\n        w = w[~np.isnan(w)]\n        if len(w) < win // 2:\n            return np.nan\n        mx = np.max(w)\n        idx = np.where(w == mx)[0]\n        days = len(w) - 1 - idx[-1]\n        return -np.log(1.0 + days)\n    return s.rolling(win).apply(_d, raw=True)\n\n\n# ---------------- main ----------------\nif __name__ == "__main__":\n    frames = load_panel()\n    closes = pd.DataFrame({s: f["close"].astype(float) for s, f in frames.items()}).sort_index()\n    highs = pd.DataFrame({s: f["high"].astype(float) for s, f in frames.items()}).sort_index()\n    lows = pd.DataFrame({s: f["low"].astype(float) for s, f in frames.items()}).sort_index()\n    vols = pd.DataFrame({s: f["volume"].astype(float) for s, f in frames.items()}).sort_index()\n    macro = {m: load_macro(m)["close"].astype(float) for m in ["VIX", "DXY", "USDJPY", "USDCNY", "EURUSD"]}\n    vix, dxy, usdjpy, eurusd = macro["VIX"], macro["DXY"], macro["USDJPY"], macro["EURUSD"]\n    rets = closes.pct_change()\n    mkt_r = closes.mean(axis=1).pct_change()\n    print(f"panel {closes.index[0].date()}..{closes.index[-1].date()} assets={closes.shape[1]} rows={len(closes)}")\n\n    cands = {}\n\n    # ---- Family A: tail / asymmetric risk ----\n    def _asym(s):\n        return rolling_beta_spread(s, mkt_r.reindex(s.index))\n    cands["asym_beta_60d"] = per_asset(_asym)(closes)\n\n    def _dnbeta(s):\n        out = rolling_beta_spread(s, mkt_r.reindex(s.index), min_obs=8)\n        # recover down-market beta separately\n        r = s; m = mkt_r.reindex(s.index)\n        res = pd.Series(np.nan, index=r.index)\n        win = 60\n        for t in range(win, len(r)):\n            ra = r.iloc[t - win:t].values; ma = m.iloc[t - win:t].values\n            msk = np.isfinite(ra) & np.isfinite(ma)\n            if msk.sum() < win - 5: continue\n            ra, ma = ra[msk], ma[msk]\n            dn = ma < 0\n            if dn.sum() >= 8 and np.var(ma[dn]) > 0:\n                res.iloc[t] = np.cov(ra[dn], ma[dn])[0, 1] / np.var(ma[dn])\n        return res\n    cands["down_beta_60d"] = per_asset(_dnbeta)(closes)\n    cands["kurt_20d"] = per_asset(lambda s: s.pct_change().rolling(20).kurt())(closes)\n\n    def _lev(s):\n        r = s.pct_change()\n        return r.rolling(60).corr(r.abs().shift(1))\n    cands["leverage_eff_60d"] = per_asset(_lev)(closes)\n\n    # ---- Family B: path persistence ----\n    cands["hurst_60d"] = per_asset(hurst_rs)(closes)\n    cands["streak_signed_20d"] = per_asset(signed_streak)(closes)\n    cands["days_since_high_60d"] = per_asset(days_since_high)(closes)\n\n    # ---- Family C: risk-adjusted momentum ----\n    def sharpe(s, win):\n        r = s.pct_change()\n        return r.rolling(win).mean() / r.rolling(win).std().replace(0, np.nan)\n    cands["sharpe_20d"] = per_asset(lambda s: sharpe(s, 20))(closes)\n    cands["sharpe_60d"] = per_asset(lambda s: sharpe(s, 60))(closes)\n\n    # ---- Family D: volume / liquidity dynamics ----\n    cands["vol_regime_20x250"] = vols.rolling(20).mean() / vols.rolling(250).mean().replace(0, np.nan) - 1.0\n    amihud = (rets.abs() / vols.replace(0, np.nan)).rolling(20).mean()\n    cands["amihud_trend_20x60"] = amihud / amihud.shift(60) - 1.0\n\n    # ---- Family E: pure macro correlation / sensitivity ----\n    vixr = vix.pct_change()\n    cands["vix_corr_60d"] = rets.rolling(60).corr(vixr)\n    u10 = macro_us10y = None\n    try:\n        u10df = load_macro("US10Y")\n        if u10df is None or len(u10df) == 0:\n            u10 = closes["US10Y"].pct_change()\n        else:\n            u10 = u10df["close"].astype(float).pct_change()\n    except Exception:\n        u10 = closes["US10Y"].pct_change()\n    cands["us10y_beta_60d"] = rets.rolling(60).cov(u10) / u10.rolling(60).var()\n\n    # ---- evaluate ----\n    libs = library_signals(closes, vols, vix, dxy, usdjpy, eurusd)\n    print("\\n=== Metrics (h=10 admission) ===")\n    results = {}\n    for fid, fv in cands.items():\n        res = evaluate(fv, closes, label=fid)\n        if res is None:\n            continue\n        results[fid] = res\n        gate = gate_pass(res)\n        print(f"{fid:22s} IC10={res[\'ic\']:+.4f} ICIR10={res[\'icir\']:+.4f} "\n              f"hit={res[\'ic_hit_ratio\']:.3f} n={res[\'n_ic_dates\']} "\n              f"turn={res[\'turnover_10d_rank\']:.2f} cov={res[\'coverage_asset_days\']:.2f} "\n              f"decay20={res[\'decay_ic_by_horizon\'][\'20\']:+.4f} -> {\'PASS\' if gate else \'fail\'}")\n\n    print("\\n=== Library correlation (max |rho|, last 500d) ===")\n    for fid in results:\n        maxrho, per = library_corr(cands[fid], closes, libs)\n        results[fid]["max_abs_library_correlation"] = maxrho\n        flag = "OK" if (maxrho is not None and maxrho < 0.5) else "HIGH-CORR"\n        print(f"{fid:22s} max_rho={maxrho if maxrho is not None else float(\'nan\'):.3f} {flag} "\n              + " ".join(f"{k}={v:.2f}" for k, v in sorted(per.items()) if v is not None and abs(v) >= 0.3))\n\n    print("\\n=== Per-year h10 IC (robustness) ===")\n    fwd = closes.shift(-10) / closes - 1.0\n    for fid in results:\n        fv = cands[fid]\n        yrs = {}\n        for dt in fv.index:\n            if dt > pd.Timestamp(FACTOR_LAST):\n                continue\n            f = fv.loc[dt]; r = fwd.loc[dt]\n            m = f.notna() & r.notna() & np.isfinite(f) & np.isfinite(r)\n            if m.sum() < MIN_ASSETS:\n                continue\n            ic, _ = spearmanr(f[m], r[m])\n            yrs.setdefault(dt.year, []).append(ic)\n        parts = []\n        for y in sorted(yrs):\n            arr = np.array(yrs[y])\n            parts.append(f"{y}: ic={arr.mean():+.4f} icir={arr.mean()/arr.std() if arr.std()>0 else 0:+.3f} n={len(arr)}")\n        print(f"{fid:22s} " + " | ".join(parts))\n'})
