  66:             s = panel[a].dropna()
  67:             cols[a] = fn(s)
  68:         return pd.DataFrame(cols, index=panel.index)
  69:     return wrapper
  70: 
  71: 
  72: def fwd_returns(panel, h):
  73:     cols = {}
  74:     for a in panel.columns:
  75:         s = panel[a].dropna()
  76:         cols[a] = s.shift(-h) / s - 1.0
  77:     return pd.DataFrame(cols, index=panel.index)
  78: 
  79: 
  80: def rank_ic_series(factor, fwd):
  81:     ics = []
  82:     for d in factor.index.intersection(fwd.index):
  83:         f = factor.loc[d].dropna()
  84:         r = fwd.loc[d].reindex(f.index).dropna()
  85:         if len(r) >= MIN_ASSETS:
  86:             ics.append((d, r.corr(f.reindex(r.index), method="spearman")))
  87:     return pd.Series(dict(ics)).sort_index()
  88: 
  89: 
  90: def turnover_10d_rank(factor):
  91:     ranks = factor.rank(axis=1)
  92:     out, dates = [], ranks.index
  93:     for i in range(10, len(dates)):
  94:         a, b = ranks.iloc[i - 10], ranks.iloc[i]
  95:         both = a.dropna().index.intersection(b.dropna().index)
  96:         if len(both) >= MIN_ASSETS:
  97:             out.append(float((a[both] - b[both]).abs().mean()))
  98:     return float(np.mean(out)) if out else float("nan")
  99: 
