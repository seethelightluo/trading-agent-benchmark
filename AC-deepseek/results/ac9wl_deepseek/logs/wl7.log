 70 # ---- candidate 3: trend R2 over 60d (OLS of log price on time) ----
 71 def cand_trend_r2_60():
 72     @per_asset_ohlc
 73     def f(s, o, h, l, v):
 74         lp = np.log(s)
 75         x = np.arange(len(s))
 76         r2 = lp.rolling(60).apply(
 77             lambda y: np.corrcoef(x[:len(y)], y)[0, 1] ** 2 if len(y) == 60 and np.isfinite(y).all() else np.nan,
 78             raw=True)
 79         return r2
 80     return f(close, load_macro())
