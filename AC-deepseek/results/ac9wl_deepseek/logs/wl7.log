 117:         down = rr.where(rr < 0, 0.0)
 118:         ds = np.sqrt((down ** 2).rolling(20).mean())
 119:         tot = rr.rolling(20).std()
 120:         return -(ds / tot)
 121:     lib["downside_vol_ratio_20"] = per_asset(dsvr)(close)
 122:     lib["max_ret_20d"] = r.rolling(20).max()
