    print(f"  ADMISSION (h=10): |IC|={abs(results['ic_h10']):.4f} (>=0.007: {gate_ic}), "
          f"|ICIR|={abs(results['icir_h10']):.4f} (>=0.084: {gate_icir}) -> "
          f"{'PASS' if gate_ic and gate_icir else 'FAIL'}")
    print()
    return results


