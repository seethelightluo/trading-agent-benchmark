 111:         z = pd.concat([s.pct_change().rename("r"), er.rename("m")], axis=1).dropna()
 112:         cols[a] = z["r"].rolling(60).cov(z["m"]) / z["m"].rolling(60).var()
 113:     lib["beta_ew_60d"] = pd.DataFrame(cols, index=close.index)
