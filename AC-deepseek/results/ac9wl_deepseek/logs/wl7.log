def make_dd(n: int):
    def fn(panel, macro):
        return panel / panel.rolling(n).max() - 1.0
    return fn


def make_rangepos(n: int):
    def fn(panel, macro):
        lo = panel.rolling(n).min()
        hi = panel.rolling(n).max()
        return (panel - lo) / (hi - lo)
    return fn


