)\n        upm=df["v"].where(df["r"]>0).rolling(20, min_periods=mp).mean()\n        dnm=df["v"].where(df["r"]<0).rolling(20, min_periods=mp).mean()\n        cols[a]=upm/dnm\n    return pd.DataFrame(cols, index=close.index)\n\ndef cand_updown_ret(close, mp=10):\n    cols={}\n    for a in close.columns:\n        s=close[a].dropna(); rr=s.pct_change()\n        up=rr.where(rr>0).rolling(20, min_periods=mp).mean()\n        dn=rr.where(rr<0).rolling(20, min_periods=mp).mean()\n        cols[a]=up/dn.abs()\n    return pd.DataFrame(cols, index=close.index)\n\nclose, open_, high, low, vol = load()\nfor name, fac in [("updown_vol_20", cand_updown_vol(close, vol)),\n                  ("updown_ret_20", cand_updown_ret(close))]:\n    fw = fac.loc[:WARM_END]\n    ic = rank_ic(fw, fwd(close, 10))\n    icir = ic.mean()/ic.std() if len(ic)>2 and ic.std()>0 else float("nan")\n    valid = fw.notna()\n    print(f"{name}: n={len(ic)} IC={ic.mean():+.4f} ICIR={icir:+.4f} hit={(ic>0).mean():.3f} "\n          f"cov={valid.mean().mean():.3f} cov8={(valid.sum(axis=1)>=MIN_ASSETS).mean():.3f} turn={turn10(fw):.2f}")\n    dec={h: rank_ic(fw, fwd(close,h)).mean() for h in (1,2,3,5,10,20)}\n    print("   decay:", {str(k): round(v,4) for k,v in dec.items()})\nEOF'})
