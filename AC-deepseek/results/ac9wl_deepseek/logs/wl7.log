 159|     loss = (-rr).clip(lower=0.0)
 160|     ag = gain.ewm(alpha=1.0 / n, adjust=False).mean()
 161|     al = loss.ewm(alpha=1.0 / n, adjust=False).mean()
 162|     rs = ag / al.replace(0, np.nan)
 163|     return 100.0 - 100.0 / (1.0 + rs)
