 133:         beta = z["r"].rolling(60).cov(z["v"]) / z["v"].rolling(60).var()
 134:         cols[a] = (-beta * vix20.reindex(s.index))
 135:     lib["vix_beta_cond_60x20"] = pd.DataFrame(cols, index=close.index)
 136:     lib["vol_adj_mom_20x60"] = per_asset(
