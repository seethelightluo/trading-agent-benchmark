for s in WATCH:
    df=pd.read_csv(f"../persistent/stock_data/{s}.csv")
    df["date"]=pd.to_datetime(df["date"]); df=df[df["date"]<=MAX_VISIBLE].set_index("date").sort_index()
    for k in frames: frames[k][s]=df[k].astype(float)
O,H,L,C,V = frames["open"],frames["high"],frames["low"],frames["close"],frames["volume"]
hl=(H-L).clip(lower=1e-12)
body=((C-O).abs()/hl).rolling(20,min_periods=10).mean()
sharpe=rets.rolling(60,min_periods=30).mean()/rets.rolling(60,min_periods=30).std().clip(lower=1e-12)
close_pos=((C-L)/hl).rolling(20,min_periods=10).mean()
upper=((H-np.maximum(O,C))/hl).rolling(20,min_periods=10).mean()

# library 9
lib={}
lib["mom_10d_skip5"]=panel.shift(5)/panel.shift(15)-1
lib["mom_120d_skip5"]=panel.shift(5)/panel.shift(125)-1
lib["rel_mom_20d_skip5"]=((panel.shift(5)/panel.shift(25)-1).sub((panel.shift(5)/panel.shift(25)-1).median(axis=1),axis=0))
lib["vol_of_vol20x60"]=rets.rolling(20).std().rolling(60).std()
lib["max_ret_20d"]=rets.rolling(20).max()
ds=rets.where(rets<0)
lib["downside_vol_ratio_20"]=-(ds.rolling(20,min_periods=10).std()/rets.rolling(20,min_periods=10).std())
lib["amihud_20"]=(rets.abs()/V.clip(lower=1e-12)).rolling(20,min_periods=10).mean()
mkt=rets.mean(axis=1)
lib["beta_ew_60d"]=rets.rolling(60,min_periods=30).cov(mkt).div(mkt.rolling(60,min_periods=30).var().clip(lower=1e-12),axis=0)
vix=mac["VIX"]; vixr=vix.pct_change()
beta=rets.rolling(60,min_periods=30).cov(vixr).div(vixr.rolling(60,min_periods=30).var().clip(lower=1e-12),axis=0)
lib["vix_beta_cond_60x20"]=-beta*(vix/vix.shift(20)-1)

cands={"body_ratio_20":body,"sharpe_60":sharpe,"close_pos_20":close_pos,"upper_wick_20":upper}
def corr(a,b,max_d=400):
    cs=[]
    for dt in a.index.intersection(b.index)[-max_d:]:
        x=a.loc[dt]; y=b.loc[dt]
        m=x.notna()&y.notna()&np.isfinite(x.astype(float))&np.isfinite(y.astype(float))
        m=m.reindex(x.index).fillna(False)
        if int(m.sum())>=MIN_ASSETS:
            cs.append(pd.Series(x[m]).corr(pd.Series(y[m]),method="spearman"))
    return float(np.mean(cs)) if cs else float("nan")

print("pairwise among candidates vs library (mean rho, last 400 dates):")
for cn,cf in cands.items():
    row={}
    for lid,lf in lib.items():
        row[lid]=round(corr(cf,lf),3)
    row["body"]=round(corr(cf,body),3); row["sharpe"]=round(corr(cf,sharpe),3)
    row["close_pos"]=round(corr(cf,close_pos),3); row["upper"]=round(corr(cf,upper),3)
    mx=max([abs(v) for v in row.values() if v==v])
    print(f"{cn:14s} max_abs={mx:.3f}  "+"  ".join(f"{k}={v:+.2f}" for k,v in row.items()))
