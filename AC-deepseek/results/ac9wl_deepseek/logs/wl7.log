        m=np.isfinite(a)&np.isfinite(b)
        if m.sum()>=MIN_ASSETS:
            cc=np.corrcoef(a[m],b[m])
            cs.append(cc[0,1])
    print('  mean corr', round(float(np.mean(cs)),4) if cs else None, 'n', len(cs))
