 82 # ---- candidate 4: gap-risk share (std of overnight ret / std of total ret) 20d ----
 83 def cand_gap_vol_share_20():
 84     @per_asset_ohlc
 85     def f(s, o, h, l, v):
 86         prev_close = s.shift(1)
 87         overnight = o / prev_close - 1.0
 88         total = s.pct_change()
 89         return overnight.rolling(20).std() / total.rolling(20).std()
 90     return f(close, load_macro())
