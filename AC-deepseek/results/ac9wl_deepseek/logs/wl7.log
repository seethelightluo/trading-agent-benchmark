from __future__ import annotations
import numpy as np
import pandas as pd

def rank_ic_fast(factor: pd.DataFrame, fwd: pd.DataFrame,
                 min_assets: int = 8) -> pd.Series:
    """Cross-sectional Spearman IC per date, vectorized via rank+Pearson."""
    idx = factor.index.intersection(fwd.index)
    f = factor.loc[idx]
    g = fwd.loc[idx]

    # Cross-sectional ranks; NaN stays NaN (pandas default rank na_option='keep')
    fr = f.rank(axis=1)
    gr = g.rank(axis=1)

    mask = fr.notna() & gr.notna()
    n_valid = mask.sum(axis=1)
    fr = fr.where(mask)
    gr = gr.where(mask)

    # Center using valid entries only (NaN ignored by mean)
    mf = fr.mean(axis=1)
    mg = gr.mean(axis=1)
    cf = fr.sub(mf, axis=0)
    cg = gr.sub(mg, axis=0)

    # Products: NaN * x = NaN -> fill with 0 for invalid entries
    cov = cf.mul(cg).fillna(0.0).sum(axis=1)
    nf = cf.pow(2).fillna(0.0).sum(axis=1).pow(0.5)
    ng = cg.pow(2).fillna(0.0).sum(axis=1).pow(0.5)

    ic = cov / (nf * ng).replace(0, np.nan)
    ic = ic.where(n_valid >= min_assets)
    return ic.sort_index()


def library_corr_fast(factor: pd.DataFrame, libs: dict[str, pd.DataFrame],
                      panel: pd.DataFrame, min_assets: int = 8,
                      lookback: int = 500, lib_min_assets: int = 8) -> tuple:
    """Mean per-date cross-sectional Spearman corr with each library factor.
    Uses vectorized rank IC restricted to the last `lookback` common dates.
    """
    per: dict[str, float] = {}
    common = factor.index.intersection(panel.index)
    if lookback is not None and len(common) > lookback:
        common = common[-lookback:]

    factor_w = factor.loc[common]
    for fid, lf in libs.items():
        lf_w = lf.reindex(common)
        ic = rank_ic_fast(factor_w, lf_w, min_assets=min_assets)
        valid_ic = ic.dropna()
        per[fid] = round(float(valid_ic.mean()), 4) if len(valid_ic) else None

    valid = [abs(v) for v in per.values() if v is not None]
    return (round(max(valid), 4) if valid else float("nan")), per
