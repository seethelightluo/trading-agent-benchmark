  ▶️ write_file({'file_path': 'scripts/miner_1_20260730_screen_novel_families.py', 'content': '"""miner_1 screening: novel factor families not yet in library (2026-07-30).\nUniverse: 15 tradable cross-asset instruments, warm-up window 2020-01-01..2026-07-15.\nExisting library: mom_10d_skip5, mom_120d_skip5, rel_mom_20d_skip5, vol_of_vol20x60,\nvix_beta_cond_60x20, amihud_20, max_ret_20d, beta_ew_60d, downside_vol_ratio_20.\nCandidates here: trend efficiency, return autocorr, vol-price corr, RSI, DXY beta,\nacceleration, sharpe momentum, skewness, range position.\n"""\nimport sys\nimport numpy as np\nimport pandas as pd\n\nsys.path.insert(0, "scripts")\nimport miner_2_lib as lib\n\nEPS = 1e-12\npanel = lib.load_panel()\nmacro = lib.load_macro()\n\n# ---------- per-asset candidates ----------\ndef trend_eff_20d(panel, macro):\n    """Kaufman efficiency ratio over 20d: net move / total path length."""\n    def f(s):\n        r = s.pct_change()\n        path = r.abs().rolling(20, min_periods=10).sum()\n        net = (s - s.shift(20)).abs()\n        return net / (path + EPS)\n    return lib.per_asset(f)(panel, macro)\n\ndef autocorr_20d(panel, macro):\n    """Rolling 20d lag-1 autocorrelation of daily returns (per-asset)."""\n    def f(s):\n        r = s.pct_change()\n        return r.rolling(20, min_periods=10).apply(\n            lambda x: pd.Series(x).autocorr(lag=1) if len(x) > 3 and x.std() > 1e-12 else np.nan, raw=False)\n    return lib.per_asset(f)(panel, macro)\n\ndef volprice_corr_20d(panel, macro):\n    """Rolling 20d correlation between daily return and volume pct change (confirmation)."""\n    def f(s):\n        r = s.pct_change()\n        v = pd.Series(s.index, index=s.index).map(lambda d: np.nan)  # placeholder\n        return r  # replaced below\n    return lib.per_asset(f)(panel, macro)\n\ndef volprice_corr(panel, macro):\n    out = {}\n    for a in panel.columns:\n        df = pd.read_csv(f"../persistent/stock_data/{a}.csv")\n        df["date"] = pd.to_datetime(df["date"])\n        df = df[df["date"] <= lib.MAX_VISIBLE].set_index("date").sort_index()\n        r = df["close"].pct_change()\n        vc = df["volume"].pct_change()\n        out[a] = r.rolling(20, min_periods=10).corr(vc)\n    return pd.DataFrame(out, index=panel.index)\n\ndef rsi_14(panel, macro):\n    """RSI-14 (per-asset)."""\n    def f(s):\n        r = s.pct_change()\n        up = r.clip(lower=0).rolling(14, min_periods=7).mean()\n        dn = (-r.clip(upper=0)).rolling(14, min_periods=7).mean()\n        rs = up / (dn + EPS)\n        return 100.0 - 100.0 / (1.0 + rs)\n    return lib.per_asset(f)(panel, macro)\n\ndef dxy_beta_60d(panel, macro):\n    """Rolling 60d beta of asset returns vs DXY returns (dollar sensitivity)."""\n    dxy = macro["DXY"]\n    dxy_r = dxy.pct_change()\n    rets = panel.pct_change()\n    beta = rets.rolling(60, min_periods=30).cov(dxy_r) / dxy_r.rolling(60, min_periods=30).var()\n    return beta\n\ndef accel_mom_20x60(panel, macro):\n    """Momentum acceleration: 20d mom (skip5) minus 60d mom (skip5)."""\n    m20 = panel.shift(5) / panel.shift(25) - 1.0\n    m60 = panel.shift(5) / panel.shift(65) - 1.0\n    return m20 - m60\n\ndef sharpe_mom_60d(panel, macro):\n    """Risk-adjusted momentum: 60d mean daily return / 60d std."""\n    r = panel.pct_change()\n    return r.rolling(60, min_periods=30).mean() / (r.rolling(60, min_periods=30).std() + EPS)\n\ndef skew_20d(panel, macro):\n    """Rolling 20d return skewness."""\n    r = panel.pct_change()\n    return r.rolling(20, min_periods=10).skew()\n\ndef range_pos_20d(panel, macro):\n    """Close position within 20d high-low range [0,1]."""\n    hi = panel.rolling(20, min_periods=10).max()\n    lo = panel.rolling(20, min_periods=10).min()\n    return (panel - lo) / (hi - lo + EPS)\n\nCANDIDATES = [\n    ("trend_eff_20d", trend_eff_20d, "Kaufman efficiency ratio 20d (trend vs noise)"),\n    ("autocorr_20d", autocorr_20d, "lag-1 autocorr of daily returns over 20d"),\n    ("volprice_corr_20d", volprice_corr, "20d corr(ret, vol_pct_change) confirmation"),\n    ("rsi_14", rsi_14, "Relative Strength Index 14d"),\n    ("dxy_beta_60d", dxy_beta_60d, "60d beta vs DXY returns (dollar sensitivity)"),\n    ("accel_mom_20x60", accel_mom_20x60, "momentum acceleration 20d vs 60d (skip5)"),\n    ("sharpe_mom_60d", sharpe_mom_60d, "60d risk-adjusted momentum (mean/std)"),\n    ("skew_20d", skew_20d, "20d return skewness"),\n    ("range_pos_20d", range_pos_20d, "close position in 20d range"),\n]\n\nfor name, fn, desc in CANDIDATES:\n    try:\n        res = lib.validate_factor(name, fn)\n        res["description"] = desc\n    except Exception as e:\n        print(f"=== {name} FAILED: {e} ===")\n'})
