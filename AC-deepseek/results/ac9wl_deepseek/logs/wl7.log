place(0, np.nan)).rolling(20).mean()\nsignals[\'amihud_20\'] = amih\n# vix beta cond 60x20: beta of asset vs VIX over 60d\nvb = ret.rolling(60).cov(vix_ret).div(vix_ret.rolling(60).var())\nsignals[\'vix_beta_cond_60x20\'] = vb\n\nfwd = px.shift(-10)/px - 1  # forward 10d returns\n\ndef rank_ic(sig, fwd_r, d):\n    a = sig.loc[d].dropna(); b = fwd_r.loc[d].reindex(a.index).dropna()\n    idx = a.index.intersection(b.index)\n    if len(idx) < 5: return np.nan\n    return a.loc[idx].rank().corr(b.loc[idx].rank())\n\ndates = px.index\nres = {}\nfor name, sig in signals.items():\n    ics = pd.Series({d: rank_ic(sig, fwd, d) for d in dates[30:]})\n    ics = ics.dropna()\n    recent60 = ics[ics.index >= ics.index[-1] - pd.Timedelta(days=90)].mean()  # ~60 trading days\n    recent120 = ics[ics.index >= ics.index[-1] - pd.Timedelta(days=180)].mean()\n    full = ics.mean()\n    res[name] = (full, recent120, recent60, len(ics))\nprint(f"{\'factor\':22s} {\'fullIC\':>8s} {\'120dIC\':>8s} {\'60dIC\':>8s} {\'n\':>5s}")\nfor k,v in sorted(res.items(), key=lambda x: -abs(x[1][2])):\n    print(f"{k:22s} {v[0]:8.4f} {v[1]:8.4f} {v[2]:8.4f} {v[3]:5d}")\nEOF'})
