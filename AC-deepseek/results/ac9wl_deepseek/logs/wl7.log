 134 def lib_corr_fast(factor: pd.DataFrame, libs: dict[str, pd.DataFrame],
 135                   last_n: int = 700) -> tuple[float, dict]:
 136     idx = factor.index[-last_n:]
 137     F = factor.loc[idx].rank(axis=1).values.astype(float)
 138     per = {}
 139     for fid, lf in libs.items():
 140         L = lf.reindex(idx).rank(axis=1).values.astype(float)
 141         rs = row_pearson(F, L)
 142         per[fid] = round(float(np.nanmean(rs)), 4)
 143     valid = [abs(v) for v in per.values() if np.isfinite(v)]
 144     return (round(max(valid), 4) if valid else float("nan")), per
