  ▶️ shell({'command': 'python -c "\nimport pandas as pd, numpy as np, glob\nfiles = sorted(glob.glob(\'../persistent/stock_data/*.csv\'))\nrows=[]\nfor f in files:\n    s=f.split(\'/\')[-1].replace(\'.csv\',\'\')\n    df=pd.read_csv(f, parse_dates=[\'date\']).sort_values(\'date\').reset_index(drop=True)\n    df[\'ret\']=df[\'close\'].pct_change()\n    d=df[df[\'date\']<=pd.Timestamp(\'2026-07-29\')]\n    last=d.iloc[-1]\n    r5=(d[\'close\'].iloc[-1]/d[\'close\'].iloc[-6]-1)*100 if len(d)>6 else np.nan\n    r20=(d[\'close\'].iloc[-1]/d[\'close\'].iloc[-21]-1)*100 if len(d)>21 else np.nan\n    r60=(d[\'close\'].iloc[-1]/d[\'close\'].iloc[-61]-1)*100 if len(d)>61 else np.nan\n    r120=(d[\'close\'].iloc[-1]/d[\'close\'].iloc[-121]-1)*100 if len(d)>121 else np.nan\n    ytd=(d[\'close\'].iloc[-1]/d[\'close\'].iloc[0]-1)*100\n    vol=d[\'ret\'].tail(20).std()*np.sqrt(252)*100\n    ma20=d[\'close\'].tail(20).mean(); ma60=d[\'close\'].tail(60).mean()\n    trend=\'UP\' if last[\'close\']>ma20>ma60 else (\'DOWN\' if last[\'close\']<ma20<ma60 else \'SIDE\')\n    rows.append((s,last[\'date\'].date(),round(r5,2),round(r20,2),round(r60,2),round(r120,2),round(ytd,2),round(vol,2),trend))\nprint(f\\"{\'asset\':<10}{\'date\':<12}{\'r5%\':>7}{\'r20%\':>8}{\'r60%\':>8}{\'r120%\':>9}{\'ytd%\':>8}{\'vol20%\':>8}  trend\\")\nfor r in rows:\n    print(f\'{r[0]:<10}{str(r[1]):<12}{r[2]:>7.2f}{r[3]:>8.2f}{r[4]:>8.2f}{r[5]:>9.2f}{r[6]:>8.2f}{r[7]:>8.2f}  {r[8]}\')\n"'})
