        beta = z["r"].rolling(60).cov(z["v"]) / z["v"].rolling(60).var()
        dxy20 = (dxy / dxy.shift(20) - 1.0).reindex(s.index)
        return -beta * dxy20
    return per_asset(f)(panel, macro)


def cand_beta_spx_60(panel, macro):
