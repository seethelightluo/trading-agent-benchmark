113         beta = z["r"].rolling(60).cov(z["b"]) / z["b"].rolling(60).var()
114         bret = (basket / basket.shift(20) - 1.0).reindex(s.index)
115         cols[a] = beta * bret
116     return pd.DataFrame(cols, index=panel.index)
