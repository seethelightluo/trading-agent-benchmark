        r = s.pct_change()
        z = pd.concat([r.rename("r"), spx.rename("m")], axis=1).dropna()
        beta = z["r"].rolling(60).cov(z["m"]) / z["m"].rolling(60).var()
        return beta
    return per_asset(f)(panel, macro)


