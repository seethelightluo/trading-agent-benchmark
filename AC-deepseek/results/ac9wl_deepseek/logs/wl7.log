                "max_abs_library_correlation": results.get("max_abs_library_correlation", float("nan")),
            },
        },
        "tags": tags,
        "benchmark_admission": {
            "contract": {"ic_threshold": ADMISSION["ic"], "icir_threshold": ADMISSION["icir"],
                         "correlation_threshold": 0.5},
            "selected_metrics": {
                "ic": results["ic_h10"],
                "icir": results["icir_h10"],
