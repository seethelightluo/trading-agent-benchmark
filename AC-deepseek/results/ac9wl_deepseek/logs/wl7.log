1: """Screener: build factor ensemble for cycle 2026-07-30.
2: 
3: Method: quality_ic_tilt
4:   q_raw      = |IC| * |ICIR|                          (persisted validation.metrics)
5:   direction  = sign(IC)                               (preserve persisted sign)
6:   turnover_penalty = clip(1 - 0.12*max(0, turnover_10d_rank - 1.5), 0.4, 1.0)
7:   corr_bonus = 1 + 0.25 * max(0, 0.35 - max_abs_library_correlation)
8:   w          = q_raw * turnover_penalty * corr_bonus, normalized to sum 1
9: """
10: import json, math
11: from pathlib import Path
12: 
13: FACTOR_DIR = Path("factors")
14: OUT = Path("factor_ensemble.json")
15: 
16: FACTORS = [
17:     "amihud_20", "beta_ew_60d", "downside_vol_ratio_20", "max_ret_20d",
18:     "mom_10d_skip5", "mom_120d_skip5", "rel_mom_20d_skip5",
19:     "vix_beta_cond_60x20", "vol_of_vol20x60",
20: ]
21: 
22: rows = []
23: for fid in FACTORS:
24:     d = json.loads((FACTOR_DIR / f"{fid}.json").read_text())
25:     m = d["validation"]["metrics"]
26:     ic, icir = m["ic"], m["icir"]
27:     q = abs(ic) * abs(icir)
28:     direction = 1 if ic >= 0 else -1
29:     turnover = m.get("turnover_10d_rank", 1.0)
30:     maxcorr = m.get("max_abs_library_correlation", 0.0)
31:     t_pen = max(0.4, 1.0 - 0.12 * max(0.0, turnover - 1.5))
32:     c_bonus = 1.0 + 0.25 * max(0.0, 0.35 - maxcorr)
33:     adj = q * t_pen * c_bonus
34:     rows.append({
35:         "factor_id": fid, "ic": ic, "icir": icir, "q": q,
36:         "direction": direction, "turnover": turnover, "maxcorr": maxcorr,
37:         "t_pen": t_pen, "c_bonus": c_bonus, "adj": adj,
38:         "category": d.get("tags", [])[:1],
39:     })
40: 
41: total = sum(r["adj"] for r in rows)
42: for r in rows:
43:     r["weight"] = r["adj"] / total
44: 
45: rows.sort(key=lambda r: -r["weight"])
46: print(f"{'factor':<24}{'dir':>4}{'q':>9}{'turn':>7}{'mxcorr':>8}{'t_pen':>7}{'c_bon':>7}{'weight':>9}")
47: for r in rows:
48:     print(f"{r['factor_id']:<24}{r['direction']:>4}{r['q']:>9.5f}{r['turnover']:>7.2f}"
