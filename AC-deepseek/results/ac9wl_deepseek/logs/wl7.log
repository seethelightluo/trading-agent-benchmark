67: def row_pearson(X: np.ndarray, Y: np.ndarray, min_n: int = MIN_ASSETS) -> np.ndarray:
68:     """Row-wise Pearson correlation with pairwise-NaN deletion (vectorized)."""
69:     X = np.asarray(X, dtype=float)
70:     Y = np.asarray(Y, dtype=float)
71:     valid = np.isfinite(X) & np.isfinite(Y)
72:     cnt = valid.sum(axis=1)
73:     Xv = np.where(valid, X, np.nan)
74:     Yv = np.where(valid, Y, np.nan)
75:     Xc = Xv - np.nanmean(Xv, axis=1, keepdims=True)
76:     Yc = Yv - np.nanmean(Yv, axis=1, keepdims=True)
77:     num = np.nansum(Xc * Yc, axis=1)
78:     dx = np.sqrt(np.nansum(Xc * Xc, axis=1))
79:     dy = np.sqrt(np.nansum(Yc * Yc, axis=1))
80:     r = np.full(len(X), np.nan)
81:     m = (cnt >= min_n) & (dx > 0) & (dy > 0)
82:     r[m] = num[m] / (dx[m] * dy[m])
83:     return r
84: 
85: 
86: def rank_ic_fast(factor: pd.DataFrame, fwd: pd.DataFrame) -> pd.Series:
87:     F = factor.rank(axis=1).values.astype(float)
88:     R = fwd.rank(axis=1).values.astype(float)
89:     return pd.Series(row_pearson(F, R), index=factor.index)
90: 
91: 
92: def turnover_10d_rank_fast(factor: pd.DataFrame) -> float:
93:     ranks = factor.rank(axis=1).values.astype(float)
94:     a = ranks[:-10]
95:     b = ranks[10:]
96:     valid = np.isfinite(a) & np.isfinite(b)
97:     cnt = valid.sum(axis=1)
98:     ok = cnt >= MIN_ASSETS
99:     m = np.full(len(a), np.nan)
100:     m[ok] = np.nansum(np.abs(a - b) * valid, axis=1)[ok] / cnt[ok]
101:     return float(np.nanmean(m))
102: 
