61 def rank_ic_series(factor_panel: pd.DataFrame, fwd: pd.DataFrame, min_valid: int = 8):
62     """Daily Spearman rank IC between factor cross-section and forward return cross-section."""
63     dates, ics = [], []
64     for dt in factor_panel.index:
65         f = factor_panel.loc[dt]
66         r = fwd.loc[dt] if dt in fwd.index else None
67         if r is None:
68             continue
69         pair = pd.concat([f.rename("f"), r.rename("r")], axis=1).dropna()
70         if len(pair) < min_valid or pair["r"].std() < 1e-14 or pair["f"].std() < 1e-14:
71             continue
72         ic = pair["f"].corr(pair["r"], method="spearman")
73         if not math.isnan(ic):
74             dates.append(dt)
75             ics.append(ic)
76     return pd.Series(ics, index=pd.DatetimeIndex(dates), name="ic")
77 
78 
79 def summarize_ic(ic_series: pd.Series, expected_sign: int = 1):
80     ic = ic_series.mean()
81     icir = ic_series.mean() / ic_series.std(ddof=1) if ic_series.std(ddof=1) > 0 else 0.0
82     hit = float((np.sign(ic_series) == expected_sign).mean()) if expected_sign else float((np.sign(ic_series) != 0).mean())
83     return {
84         "ic": round(float(ic), 4),
85         "icir": round(float(icir), 4),
86         "ic_hit_ratio": round(float(hit), 3),
87         "n_ic_dates": int(len(ic_series)),
88         "ic_std": round(float(ic_series.std(ddof=1)), 4),
89     }
90 
91 
92 def coverage_metrics(factor_panel: pd.DataFrame, assets=None, min_valid=8):
93     assets = assets or TRADABLE
94     valid = factor_panel.notna()
95     asset_days = float(valid[list(valid.columns)].sum().sum())
96     total_days = float(factor_panel.shape[0] * len([a for a in assets if a in valid.columns]))
97     dates_ge8 = float((valid.sum(axis=1) >= min_valid).mean())
98     return {
99         "coverage_asset_days": round(asset_days / total_days, 3) if total_days else 0.0,
100         "coverage_dates_ge8": round(dates_ge8, 3),
101     }
102 
103 
104 def turnover_rank(factor_panel: pd.DataFrame, step: int = 10):
105     """Mean absolute raw-rank change over `step` days (0..N-1 scale)."""
106     r = factor_panel.rank(axis=1, method="average")
107     diff = r.diff(step).abs().mean().mean()
108     return round(float(diff), 3) if not math.isnan(diff) else None
109 
110 
111 def decay_profile(factor_panel, closes, horizons=(1, 2, 3, 5, 10, 20), min_valid=8, expected_sign=1):
112     out = {}
113     for h in horizons:
114         fwd = forward_returns(closes, h)
115         ics = rank_ic_series(factor_panel, fwd, min_valid)
116         if len(ics):
117             out[str(h)] = round(float(ics.mean()), 4)
118     return out
119 
