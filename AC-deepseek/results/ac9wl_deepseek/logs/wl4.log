33:def rank_ic_vec(factor_panel, fwd):
34:    """Vectorized per-date Spearman IC (Pearson of ranks)."""
35:    fr = factor_panel.rank(axis=1)
36:    rr = fwd.rank(axis=1)
37:    dates, ics = [], []
38:    fv = fr.values
39:    rv = rr.values
40:    for i, dt in enumerate(fr.index):
41:        f = fv[i]
42:        r = rv[i]
43:        m = ~(np.isnan(f) | np.isnan(r))
44:        if m.sum() < MIN_VALID:
45:            continue
46:        fs = f[m]; rs = r[m]
47:        if fs.std() < 1e-14 or rs.std() < 1e-14:
48:            continue
49:        ic = np.corrcoef(fs, rs)[0, 1]
50:        if not np.isnan(ic):
51:            dates.append(dt)
52:            ics.append(ic)
53:    return pd.Series(ics, index=pd.DatetimeIndex(dates), name="ic")
54:
55:def summarize_ic(ic_series, expected_sign=1):
56:    if len(ic_series) == 0:
57:        return {"ic": np.nan, "icir": np.nan, "ic_hit_ratio": np.nan, "n_ic_dates": 0, "ic_std": np.nan}
58:    ic = ic_series.mean()
59:    std = ic_series.std(ddof=1)
60:    icir = ic / std if std > 0 else 0.0
61:    hit = float((np.sign(ic_series) == expected_sign).mean()) if expected_sign else float((np.sign(ic_series) != 0).mean())
62:    return {"ic": round(float(ic), 4), "icir": round(float(icir), 4),
63:            "ic_hit_ratio": round(float(hit), 3), "n_ic_dates": int(len(ic_series)),
64:            "ic_std": round(float(std), 4)}
