22:
23:def load_panels(days: int = 3000):
24:    """Return {asset: DataFrame} for tradable + macro, full history to last completed day."""
25:    panels = {}
26:    for s in TRADABLE:
27:        df = get_stock_daily_data(symbol=s, days=days)
28:        if df is not None and len(df) > 60:
29:            df = df.copy()
30:            df["date"] = pd.to_datetime(df["date"])
31:            df = df.set_index("date").sort_index()
32:            panels[s] = df
33:    for s in MACRO:
34:        df = get_index_daily_data(symbol=s, days=days)
35:        if df is not None and len(df) > 60:
36:            df = df.copy()
37:            df["date"] = pd.to_datetime(df["date"])
38:            df = df.set_index("date").sort_index()
39:            panels[s] = df
40:    return panels
41:
42:
43:def close_panel(panels, assets=None):
44:    assets = assets or TRADABLE
45:    return pd.concat(
46:        {a: panels[a]["close"].astype(float) for a in assets if a in panels},
47:        axis=1,
48:    ).sort_index()
49:
50:
51:def ret_panel(panels, assets=None):
52:    c = close_panel(panels, assets)
53:    return c.pct_change()
54:
55:
56:def forward_returns(closes, horizon: int):
57:    """Forward h-day return computed from closes: close[t+h]/close[t]-1."""
58:    return closes.shift(-horizon) / closes - 1.0
59:
60:
61:def rank_ic_series(factor_panel: pd.DataFrame, fwd: pd.DataFrame, min_valid: int = 8):
62:    """Daily Spearman rank IC between factor cross-section and forward return cross-section."""
63:    dates, ics = [], []
64:    for dt in factor_panel.index:
65:        f = factor_panel.loc[dt]
66:        r = fwd.loc[dt] if dt in fwd.index else None
67:        if r is None:
68:            continue
69:        pair = pd.concat([f.rename("f"), r.rename("r")], axis=1).dropna()
70:        if len(pair) < min_valid or pair["r"].std() < 1e-14 or pair["f"].std() < 1e-14:
71:            continue
72:        ic = pair["f"].corr(pair["r"], method="spearman")
73:        if not math.isnan(ic):
74:            dates.append(dt)
75:            ics.append(ic)
76:    return pd.Series(ics, index=pd.DatetimeIndex(dates), name="ic")
77:
78:
79:def summarize_ic(ic_series: pd.Series, expected_sign: int = 1):
80:    ic = ic_series.mean()
