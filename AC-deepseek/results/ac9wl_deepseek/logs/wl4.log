79:def summarize_ic(ic_series: pd.Series, expected_sign: int = 1):
80:    ic = ic_series.mean()
81:    icir = ic_series.mean() / ic_series.std(ddof=1) if ic_series.std(ddof=1) > 0 else 0.0
82:    hit = float((np.sign(ic_series) == expected_sign).mean()) if expected_sign else float((np.sign(ic_series) != 0).mean())
83:    return {
84:        "ic": round(float(ic), 4),
85:        "icir": round(float(icir), 4),
86:        "ic_hit_ratio": round(float(hit), 3),
87:        "n_ic_dates": int(len(ic_series)),
88:        "ic_std": round(float(ic_series.std(ddof=1)), 4),
89:    }
