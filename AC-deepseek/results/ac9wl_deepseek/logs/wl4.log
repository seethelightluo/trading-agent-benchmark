 144 def _load_signal_artifact(payload: dict, factor_path: Path) -> np.ndarray | None:
 145     """Load a real signal matrix when the factor provides one.
 146 
 147     Supports three formats:
 148     1. Inline ``signals`` array (legacy direct).
 149     2. Inline ``signal_artifact`` dict with ``format`` + ``data`` keys
 150        (e.g. ``base64:zlib:csv``) -- the standard DeepSeek/Luna miner output.
 151     3. File-path reference to a ``.npy`` / ``.npz`` / JSON file.
 152 
 153     A summary field such as ``max_abs_library_correlation: 0`` is never a
 154     signal artifact.  Missing matrices are intentionally returned as None so
 155     the caller can quarantine the legacy factor instead of weakening rho.
 156     """
 157     direct = payload.get("signals")
 158     artifact = payload.get("signal_artifact")
 159     validation = payload.get("validation")
 160     if isinstance(validation, dict):
 161         direct = direct if direct is not None else validation.get("signals")
 162         # Check validation.signal_artifact FIRST (standard miner output location)
 163         artifact = artifact or validation.get("signal_artifact")
 164         metrics = validation.get("metrics")
 165         if isinstance(metrics, dict):
 166             artifact = artifact or metrics.get("signal_artifact")
 167     if direct is not None:
 168         try:
 169             array = np.asarray(direct, dtype=float)
 170             return array if array.ndim >= 2 else None
 171         except (TypeError, ValueError):
 172             return None
 173     if not artifact:
 174         return None
 175     # Case: inline dict artifact with format + data
 176     if isinstance(artifact, dict):
 177         return _decode_inline_artifact(artifact)
 178     # Case: file-path reference
 179     if not isinstance(artifact, str):
 180         return None
 181     path = Path(artifact)
 182     if not path.is_absolute():
 183         path = factor_path.parent / path
 184     if not path.exists():
 185         return None
 186     try:
 187         if path.suffix == ".npy":
 188             array = np.load(path, allow_pickle=False)
 189         elif path.suffix == ".npz":
 190             with np.load(path, allow_pickle=False) as archive:
 191                 array = archive[archive.files[0]]
 192         else:
 193             array = np.asarray(json.loads(path.read_text(encoding="utf-8")), dtype=float)
 194         return array if array.ndim >= 2 else None
 195     except (OSError, ValueError, TypeError, json.JSONDecodeError):
 196         return None
