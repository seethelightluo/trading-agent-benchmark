51     Xv = np.where(V, X, np.nan)
52     Yv = np.where(V, Y, np.nan)
53     Xc = X - np.nanmean(Xv, axis=1, keepdims=True)
54     Yc = Y - np.nanmean(Yv, axis=1, keepdims=True)
55     Xc = np.where(V, Xc, 0.0)
56     Yc = np.where(V, Yc, 0.0)
