 = {}\nfor a in ASSETS:\n    s = px[a].tail(120)\n    dd[a] = (s/s.cummax()-1).min()*100\nprint("\\n=== MaxDD 120d (%) ===")\nprint(" ".join(f"{a}={dd[a]:.1f}" for a in ASSETS))\nEOF'})
