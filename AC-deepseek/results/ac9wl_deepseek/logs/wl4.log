77 def rolling_beta(asset_ret: pd.Series, driver_ret: pd.Series, win: int, min_obs: int = 40):
78     z = pd.concat([asset_ret.rename("a"), driver_ret.rename("m")], axis=1).dropna()
79     cov = z["a"].rolling(win).cov(z["m"])
80     var = z["m"].rolling(win).var()
81     return (cov / var).where(z["m"].rolling(win).count() >= min_obs)
82 
