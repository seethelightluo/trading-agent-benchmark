corr(method='spearman').round(3).to_string())\n\n# 2) recent IC (last 63 dates with valid fwd10)\nprint('\\n=== recent IC (last ~63d, h=10) ===')\nfor f in fids:\n    valid = fwd10.notna() & sig[f].notna()\n    sub = valid[valid.any(axis=1)]\n    if len(sub) == 0:\n        print(f, 'no valid dates'); continue\n    ics = []\n    for dt in sub.index[-63:]:\n        r = fwd10.loc[dt]; x = sig[f].loc[dt]\n        m = r.notna() & x.notna()\n        if m.sum() >= 8:\n            ics.append(np.corrcoef(x[m].rank(), r[m].rank())[0,1])\n    if ics:\n        print(f, 'IC mean:', round(np.mean(ics),4), 'ICIR:', round(np.mean(ics)/np.std(ics),3) if np.std(ics)>0 else float('nan'), 'n:', len(ics))\n    else:\n        print(f, 'no IC dates')\n\n# 3) coverage\nprint('\\n=== last-date valid signals per asset ===')\nprint(pd.DataFrame({f: sig[f].iloc[-1].notna() for f in fids}).astype(int).to_string())\nEOF"})
