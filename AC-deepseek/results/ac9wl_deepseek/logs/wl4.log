  ▶️ write_file({'content': '"""miner_1 batch4 exploration 2026-07-30 (vectorized rank-IC version).\n\nExplore ~14 novel factor ideas. Admission gate (15-asset universe):\n|IC|>=0.0070 and |ICIR|>=0.0840 at h=10. Report yearly IC + library corr.\n"""\nimport sys, math\nsys.path.insert(0, "scripts")\nimport numpy as np\nimport pandas as pd\nfrom factor_research_lib import (load_panels, close_panel, ret_panel, forward_returns,\n                                 coverage_metrics, turnover_rank, library_signals,\n                                 max_library_corr, TRADABLE)\n\npanels = load_panels()\ncloses = close_panel(panels)\nrets = ret_panel(panels)\nprint(f"assets={len(closes.columns)} dates={closes.index[0].date()}..{closes.index[-1].date()} "\n      f"n_days={len(closes)}", flush=True)\n\n\ndef rank_ic_fast(factor_panel, fwd_panel, min_valid=8):\n    fr = factor_panel.rank(axis=1)\n    rr = fwd_panel.reindex(factor_panel.index).rank(axis=1)\n    fv = fr.to_numpy(dtype=float)\n    rv = rr.to_numpy(dtype=float)\n    idx = factor_panel.index\n    dates, ics = [], []\n    for i in range(len(idx)):\n        m = ~(np.isnan(fv[i]) | np.isnan(rv[i]))\n        if m.sum() < min_valid:\n            continue\n        x = fv[i][m]\n        y = rv[i][m]\n        if x.std() < 1e-12 or y.std() < 1e-12:\n            continue\n        ic = float(np.corrcoef(x, y)[0, 1])\n        if not np.isnan(ic):\n            dates.append(idx[i])\n            ics.append(ic)\n    return pd.Series(ics, index=pd.DatetimeIndex(dates), name="ic")\n\n\ndef summarize(ics):\n    ic = ics.mean()\n    sd = ics.std(ddof=1)\n    return {"ic": round(float(ic), 4),\n            "icir": round(float(ic / sd), 4) if sd > 0 else 0.0,\n            "ic_hit_ratio": round(float((np.sign(ics) == 1).mean()), 3),\n            "n_ic_dates": int(len(ics)),\n            "ic_std": round(float(sd), 4)}\n\n\ndef rolling_beta(asset_ret, driver_ret, win=60, min_obs=40, exclude_anchor=None):\n    beta = {}\n    for a in asset_ret.columns:\n        if exclude_anchor and a == exclude_anchor:\n            beta[a] = pd.Series(np.nan, index=asset_ret.index)\n            continue\n        z = pd.concat([asset_ret[a].rename("a"), driver_ret.rename("m")], axis=1).dropna()\n        cov = z["a"].rolling(win).cov(z["m"])\n        var = z["m"].rolling(win).var()\n        beta[a] = (cov / var).where(z["m"].rolling(win).count() >= min_obs)\n    return pd.DataFrame(beta, index=asset_ret.index)\n\n\ndef yearly_ic(ics):\n    out = {}\n    for y, g in ics.groupby(ics.index.year):\n        out[str(y)] = round(float(g.mean()), 4)\n    return out\n\n\nH_ADM = 10\nHORIZONS = (1, 2, 3, 5, 10, 20)\nfwd_all = {h: forward_returns(closes, h) for h in HORIZONS}\n\n# sanity: fast rank-ic vs library spearman on one factor\nlib0 = library_signals(panels, closes, rets)\nics_fast = rank_ic_fast(lib0["mom_10d_skip5"], fwd_all[10])\nprint(f"[sanity] mom_10d_skip5 fast IC={ics_fast.mean():.4f} n={len(ics_fast)}", flush=True)\n\n# --- library signals (existing 4 + my 3 persisted betas) ---\nlib = dict(lib0)\ncn10 = panels["CN10Y"]["close"].astype(float)\nlib["rate_beta_cn10y_60d"] = rolling_beta(rets, cn10.pct_change(), 60)\neur = panels["EURUSD"]["close"].astype(float)\nlib["eurusd_beta_60d"] = rolling_beta(rets, eur.pct_change(), 60)\nmkt = rets.mean(axis=1)\ndn = mkt.where(mkt < 0).fillna(0.0)\nlib["dn_mkt_beta_60d"] = rolling_beta(rets, dn, 60)\n\ncandidates = {}\ncandidates["skew_20d"] = rets.rolling(20).skew()\ncandidates["kurt_20d"] = rets.rolling(20).kurt()\nhlr = {}\nfor a in TRADABLE:\n    if a in panels:\n        rng = (panels[a]["high"] - panels[a]["low"]).replace(0, np.nan)\n        hlr[a] = ((panels[a]["close"] - panels[a]["low"]) / rng).rolling(20).mean()\ncandidates["close_loc_20d"] = pd.DataFrame(hlr, index=closes.index).reindex(closes.index)\nv20 = rets.rolling(20).std()\nv60 = rets.rolling(60).std()\ncandidates["vol_term_20_60"] = v20 / v60\ntr = {}\nfor a in TRADABLE:\n    if a in panels:\n        p = panels[a]\n        trc = pd.concat([(p["high"] - p["low"]), (p["high"] - p["close"].shift()).abs(),\n                         (p["low"] - p["close"].shift()).abs()], axis=1).max(axis=1)\n        tr[a] = trc.rolling(14).mean()\natr = pd.DataFrame(tr, index=closes.index).reindex(closes.index)\nmom20 = closes / closes.shift(20) - 1.0\ncandidates["atr_mom_20"] = mom20 / atr\ncandidates["maxdd_60"] = closes / closes.rolling(60).max() - 1.0\n\n\ndef rsi14(s):\n    d = s.diff()\n    up = d.clip(lower=0).rolling(14).mean()\n    dn_ = (-d.clip(upper=0)).rolling(14).mean()\n    rs = up / dn_.replace(0, np.nan)\n    return 100 - 100 / (1 + rs)\n\n\ncandidates["rsi_14"] = pd.DataFrame({a: rsi14(closes[a]) for a in closes.columns}, index=closes.index)\ncandidates["bb_pos_20x2"] = (closes - closes.rolling(20).mean()) / (2 * closes.rolling(20).std())\ndxy = panels["DXY"]["close"].astype(float)\ncandidates["dxy_beta_60d"] = rolling_beta(rets, dxy.pct_change(), 60)\njpy = panels["USDJPY"]["close"].astype(float)\ncandidates["usdjpy_beta_60d"] = rolling_beta(rets, jpy.pct_change(), 60)\ncandidates["wti_beta_60d"] = rolling_beta(rets, closes["WTI"].pct_change(), 60, exclude_anchor="WTI")\nsp = cn10 - closes["US10Y"]\ncandidates["cnus_spread_beta_60d"] = rolling_beta(rets, sp.diff(), 60)\nvz = {}\nfor a in TRADABLE:\n    if a in panels and "volume" in panels[a].columns and panels[a]["volume"].notna().mean() > 0.5:\n        v = panels[a]["volume"].astype(float)\n        vz[a] = (v - v.rolling(20).mean()) / v.rolling(20).std()\n    else:\n        vz[a] = pd.Series(np.nan, index=closes.index)\ncandidates["volume_z_20d"] = pd.DataFrame(vz, index=closes.index).reindex(closes.index)\nreff = {}\nfor a in TRADABLE:\n    if a in panels:\n        rng = (panels[a]["high"] - panels[a]["low"]) / panels[a]["close"]\n        reff[a] = rng.rolling(20).mean() / rets[a].rolling(20).std()\ncandidates["range_eff_20"] = pd.DataFrame(reff, index=closes.index).reindex(closes.index)\n\nprint(f"{len(candidates)} candidates built", flush=True)\n\nrows = []\nfor k, (name, panel) in enumerate(candidates.items()):\n    panel = panel.reindex(closes.index)\n    ics = rank_ic_fast(panel, fwd_all[H_ADM])\n    m = summarize(ics)\n    m.update(coverage_metrics(panel))\n    m["turnover_10d_rank"] = turnover_rank(panel, 10)\n    m["decay_ic_by_horizon"] = {str(h): round(float(rank_ic_fast(panel, fwd_all[h]).mean()), 4)\n                                for h in HORIZONS}\n    corr, key = max_library_corr(panel, lib)\n    m["max_abs_library_correlation"] = corr\n    m["max_corr_factor"] = key\n    yic = yearly_ic(ics)\n    m["yearly_ic"] = yic\n    m["n_neg_years"] = sum(1 for y, v in yic.items() if v < 0)\n    passes = abs(m["ic"]) >= 0.007 and abs(m["icir"]) >= 0.084\n    rows.append((name, m, passes))\n    print(f"[{k+1}/{len(candidates)}] {name:22s} IC={m[\'ic\']:+.4f} ICIR={m[\'icir\']:+.4f} "\n          f"hit={m[\'ic_hit_ratio\']:.3f} n={m[\'n_ic_dates\']:5d} covAD={m[\'coverage_asset_days\']:.3f} "\n          f"covD8={m[\'coverage_dates_ge8\']:.3f} to={m[\'turnover_10d_rank\']:.2f} "\n          f"rho={corr:.3f}({key}) negY={m[\'n_neg_years\']} "\n          f"{\'PASS\' if passes else \'\'}", flush=True)\n\nprint("\\n--- ranked by |ICIR| ---", flush=True)\nfor name, m, passes in sorted(rows, key=lambda r: abs(r[1]["icir"]), reverse=True):\n    flag = "PASS" if passes else ""\n    print(f"{flag:4s} {name:22s} IC={m[\'ic\']:+.4f} ICIR={m[\'icir\']:+.4f} "\n          f"rho={m[\'max_abs_library_correlation\']:.3f} negY={m[\'n_neg_years\']} "\n          f"decay={m[\'decay_ic_by_horizon\']}", flush=True)\n', 'file_path': 'scripts/miner_1_20260730_explore_batch4.py'})
