 199 def _pairwise_abs_spearman(left: np.ndarray, right: np.ndarray) -> float:
 200     """Compute mean cross-sectional absolute Spearman rho over common rows.
 201 
 202     When signal panels have different row counts (e.g. seed factors computed
 203     on full history vs miner factors on visible window only), align by taking
 204     the last N rows of each where N = min(left rows, right rows).
 205     """
 206     if left.shape[1] != right.shape[1]:
 207         raise ValueError(f"signal column count differs: {left.shape[1]} vs {right.shape[1]}")
 208     if left.shape[0] != right.shape[0]:
 209         n = min(left.shape[0], right.shape[0])
 210         left = left[-n:]
 211         right = right[-n:]
 212     values: list[float] = []
 213     for row_left, row_right in zip(left, right):
 214         finite = np.isfinite(row_left) & np.isfinite(row_right)
 215         if int(finite.sum()) < 2:
 216             continue
 217         rank_left = pd_rank(row_left[finite])
 218         rank_right = pd_rank(row_right[finite])
 219         if np.std(rank_left) <= 1e-12 or np.std(rank_right) <= 1e-12:
 220             continue
 221         values.append(abs(float(np.corrcoef(rank_left, rank_right)[0, 1])))
 222     if not values:
 223         raise ValueError("signal artifacts have no common valid cross-section")
 224     return float(np.mean(values))
 225 
 226 
 227 def pd_rank(values: np.ndarray) -> np.ndarray:
 228     """Small dependency-free average-rank implementation."""
 229     order = np.argsort(values, kind="mergesort")
 230     ranks = np.empty(len(values), dtype=float)
 231     sorted_values = values[order]
 232     start = 0
 233     while start < len(values):
 234         end = start + 1
 235         while end < len(values) and sorted_values[end] == sorted_values[start]:
 236             end += 1
 237         ranks[order[start:end]] = (start + end - 1) / 2.0 + 1.0
 238         start = end
 239     return ranks
