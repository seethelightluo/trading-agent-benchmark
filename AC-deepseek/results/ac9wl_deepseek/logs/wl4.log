ic={rep(full)[0]:+.4f} icir={rep(full)[2]:+.3f} | recent240d: n={len(recent):3d} ic={rep(recent)[0]:+.4f} icir={rep(recent)[2]:+.3f} hit={((recent>0).mean() if len(recent) else np.nan):.2f}")\n    return ics\n\nfor fid in [\'vol_price_corr_20\',\'dn_mkt_beta_60d\',\'eurusd_beta_60d\',\'rate_beta_cn10y_60d\']:\n    ic_stats(fid,\'\')\nEOF'})
