ta/{a}.csv\'); df.columns=[c.strip() for c in df.columns]\n    df[\'date\']=pd.to_datetime(df[\'date\']); df=df.sort_values(\'date\')\n    s=df.set_index(\'date\')[\'close\'].astype(float)\n    rets[a]=s.pct_change()\nR=pd.DataFrame(rets).loc[ref_dates]\nR=R.dropna(how=\'all\')\ncorr=R.corr()\n# avg pairwise correlation (upper triangle)\nvals=corr.values; iu=np.triu_indices(len(corr),1)\navg_corr=np.nanmean(vals[iu])\ndisp=R.std(axis=1).mean()*100  # avg daily cross-sectional dispersion\nprint(f"\\nlast date: {ref_dates[-1]}, obs rows: {len(R)}")\nprint(f"avg pairwise corr (60d): {avg_corr:.3f}")\nprint(f"avg daily cross-sectional dispersion: {disp:.3f}%")\nprint(f"corr of SPX with others (last 60d):")\nprint(corr[\'SPX\'].drop(\'SPX\').round(2).to_string())\nEOF'})
