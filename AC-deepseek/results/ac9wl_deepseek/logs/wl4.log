244 def f_tr2(s, a):
245     lp = np.log(s)
246     t = pd.Series(np.arange(len(lp), dtype=float), index=lp.index)
247     tm = t.rolling(60).mean()
248     tv = (t * t).rolling(60).mean() - tm ** 2
249     xm = lp.rolling(60).mean()
250     xv = lp.rolling(60).var(ddof=0)
251     cov = (lp * t).rolling(60).mean() - xm * tm
252     return (cov ** 2 / (xv * tv)).where(xv > 1e-14)
