dt = p.dropna(how="all").index[100]
f = p.loc[dt]; r = fwd.loc[dt]
pair = pd.concat([f.rename("f"), r.rename("r")], axis=1).dropna()
print("manual date", dt, "pair len:", len(pair), "r std:", pair["r"].std(), "f std:", pair["f"].std())

