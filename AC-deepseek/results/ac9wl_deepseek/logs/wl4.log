  ▶️ shell({'command': 'python - <<\'EOF\'\nimport pandas as pd, numpy as np, os\n\n# Load tradable asset data\nbase = \'../persistent/stock_data\'\nassets = [\'000300.SH\',\'SPX\',\'HSI\',\'N225\',\'SX5E\',\'000688.SH\',\'SOX\',\'NDX\',\'XAU\',\'COPPER\',\'WTI\',\'BTC\',\'ETH\',\'US10Y\',\'CN10Y\']\ndata = {}\nfor a in assets:\n    df = pd.read_csv(os.path.join(base, a+\'.csv\'))\n    df.columns = [c.strip().lower() for c in df.columns]\n    df[\'date\'] = pd.to_datetime(df[\'date\'])\n    df = df.sort_values(\'date\').set_index(\'date\')\n    data[a] = df\n\n# Common date range\ndates = None\nfor a in assets:\n    if dates is None:\n        dates = set(data[a].index)\n    else:\n        dates = dates.intersection(set(data[a].index))\ndates = sorted(dates)\nprint("common date range:", dates[0].date(), "->", dates[-1].date(), "n:", len(dates))\n\n# Build close panel\npx = pd.DataFrame({a: data[a][\'close\'] for a in assets})\npx = px.loc[dates]\n# restrict to visible through 2026-10-23\nvis = pd.Timestamp(\'2026-10-23\')\npxv = px[px.index <= vis]\nprint("visible data through:", pxv.index[-1].date(), "rows:", len(pxv))\n\n# Regime stats over last 60 visible days and last 20\nfor label, win in [(\'20d\', 20), (\'60d\', 60), (\'120d\', 120)]:\n    sub = pxv.iloc[-win:]\n    rets = sub.pct_change().dropna()\n    # mean daily ret annualized\n    ann = rets.mean().mean()*252\n    vol = rets.std().mean()*np.sqrt(252)\n    # trend: last close vs ma\n    last = sub.iloc[-1]\n    ma = sub.mean()\n    above = (last > ma).mean()\n    # drawdown from rolling max\n    dd = (sub/sub.cummax()-1).min().min()\n    print(f"{label}: ann_mean_ret={ann*100:.2f}% ann_vol={vol*100:.2f}% pct_above_ma={above*100:.0f}% max_dd={dd*100:.1f}%")\n\n# Per-asset recent stats (last 20d return, 60d vol)\nprint("\\nPer-asset last 20d ret and 60d ann vol:")\nrets20 = pxv.iloc[-21:].pct_change().dropna().iloc[-20:]\nr60 = pxv.iloc[-61:].pct_change().dropna()\nfor a in assets:\n    r = rets20[a].sum()*100\n    v = r60[a].std()*np.sqrt(252)*100\n    last = pxv[a].iloc[-1]; ma20 = pxv[a].iloc[-20:].mean(); ma60 = pxv[a].iloc[-60:].mean()\n    print(f"{a:12s} ret20={r:7.2f}% vol60={v:6.1f}% last/ma20={last/ma20-1:6.2%} last/ma60={last/ma60-1:6.2%}")\n\n# Cross-sectional dispersion (avg pairwise corr of daily rets over last 60d)\nr60all = r60\ncorr = r60all.corr()\ntri = corr.values[np.triu_indices(len(corr.values), k=1)]\nprint("\\navg pairwise corr last 60d:", tri.mean().round(3), "median:", np.median(tri).round(3))\nEOF'})
