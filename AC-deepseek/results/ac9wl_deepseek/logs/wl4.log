  ▶️ write_file({'file_path': 'scripts/miner_2_20260730_explore_batch.py', 'content': '"""miner_2 exploration batch 2026-07-30.\nScreen candidate factors on the 15-asset tradable cross-asset universe.\nValidation window: 2020-01-01 .. 2026-07-29 (visible-through date).\nAdmission horizon H=10 (forward 10d returns), decay at H in {1,2,3,5,10,20}.\nGates: |IC| >= 0.0070, |ICIR| >= 0.0840.\nAlso computes max abs correlation to existing library signals.\n"""\nimport numpy as np\nimport pandas as pd\n\nTRADING_END = "2026-07-29"\nSTART = "2020-01-01"\nASSETS = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX",\n          "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]\nMACRO = ["DXY", "USDCNY", "USDJPY", "EURUSD", "VIX"]\n\ndef load(path):\n    df = pd.read_csv(path)\n    df["date"] = pd.to_datetime(df["date"])\n    df = df.set_index("date").sort_index()\n    return df[~df.index.duplicated(keep="last")]\n\n# ---------- data ----------\ncloses, vols, highs, lows = {}, {}, {}, {}\nfor a in ASSETS:\n    d = load(f"../persistent/stock_data/{a}.csv")\n    closes[a] = d["close"].astype(float)\n    vols[a] = d["volume"].astype(float)\n    highs[a] = d["high"].astype(float)\n    lows[a] = d["low"].astype(float)\nclose = pd.DataFrame(closes)\nvol = pd.DataFrame(vols)\nhigh = pd.DataFrame(highs)\nlow = pd.DataFrame(lows)\n\nmac = {}\nfor m in MACRO:\n    mac[m] = load(f"../persistent/index_data/{m}.csv")["close"].astype(float)\nmacro = pd.DataFrame(mac)\n\n# restrict to validation window\nclose = close.loc[(close.index >= START) & (close.index <= TRADING_END)]\nvol = vol.reindex(close.index)\nhigh = high.reindex(close.index)\nlow = low.reindex(close.index)\nmacro = macro.reindex(close.index)\n\nret = close.pct_change()\nprint(f"panel dates: {len(close)}  assets: {len(ASSETS)}  {close.index[0].date()}..{close.index[-1].date()}")\n\ndef fwd(h):\n    return close.shift(-h) / close - 1.0\n\ndef beta(asset_ret, factor_ret, win):\n    """rolling beta of asset returns vs factor returns"""\n    cov = asset_ret.rolling(win).cov(factor_ret)\n    var = factor_ret.rolling(win).var()\n    return cov / var\n\ndef build_signal(name, fn):\n    """fn(close, ret, vol, high, low, macro) -> DataFrame panel of signal"""\n    s = fn()\n    s = s.reindex(close.index)\n    return s\n\ncand = {}\n\n# 1. efficiency ratio 20d: net move / path length\ndef f_eff20():\n    num = (close - close.shift(20)).abs()\n    den = ret.abs().rolling(20).sum()\n    return num / den\ncand["eff_ratio_20"] = build_signal("eff_ratio_20", f_eff20)\n\n# 2. position within 20d high-low range (stochastic %K-like)\ndef f_range_pos20():\n    hh = high.rolling(20).max(); ll = low.rolling(20).min()\n    return (close - ll) / (hh - ll)\ncand["range_pos_20"] = build_signal("range_pos_20", f_range_pos20)\n\n# 3. 20d range width (vol compression/expansion)\ndef f_range_w20():\n    hh = high.rolling(20).max(); ll = low.rolling(20).min()\n    return (hh - ll) / close\ncand["range_w_20"] = build_signal("range_w_20", f_range_w20)\n\n# 4. skewness 60d\ndef f_skew60():\n    return ret.rolling(60).skew()\ncand["skew_60"] = build_signal("skew_60", f_skew60)\n\n# 5. downside concentration: 20d downside rmse / 60d total vol\ndef f_down_ratio():\n    neg = ret.clip(upper=0.0)\n    ds = (neg.pow(2).rolling(20).mean()).pow(0.5)\n    tot = ret.rolling(60).std()\n    return ds / tot\ncand["down_ratio_20x60"] = build_signal("down_ratio_20x60", f_down_ratio)\n\n# 6. drawdown depth 60d\ndef f_dd60():\n    return close / close.rolling(60).max() - 1.0\ncand["drawdown_60"] = build_signal("drawdown_60", f_dd60)\n\n# 7. volume trend 20x60\ndef f_vtrend():\n    return vol.rolling(20).mean() / vol.rolling(60).mean()\ncand["vol_trend_20x60"] = build_signal("vol_trend_20x60", f_vtrend)\n\n# 8. momentum acceleration: mom10 - mom60\ndef f_momaccel():\n    m10 = close / close.shift(10) - 1.0\n    m60 = close / close.shift(60) - 1.0\n    return m10 - m60\ncand["mom_accel_10x60"] = build_signal("mom_accel_10x60", f_momaccel)\n\n# 9. RSI 14\ndef f_rsi14():\n    d = close.diff()\n    up = d.clip(lower=0.0).rolling(14).mean()\n    dn = (-d.clip(upper=0.0)).rolling(14).mean()\n    rs = up / dn\n    return 100.0 - 100.0 / (1.0 + rs)\ncand["rsi_14"] = build_signal("rsi_14", f_rsi14)\n\n# 10. DXY beta conditional 60x20\ndef f_dxy_cond():\n    b = beta(ret, macro["DXY"].pct_change(), 60)\n    return b * (macro["DXY"] / macro["DXY"].shift(20) - 1.0)\ncand["dxy_beta_cond_60x20"] = build_signal("dxy_beta_cond_60x20", f_dxy_cond)\n\n# 11. US10Y beta conditional 60x20 (rate sensitivity * yield move)\ndef f_us10y_cond():\n    b = beta(ret, close["US10Y"].pct_change(), 60)\n    return b * (close["US10Y"] / close["US10Y"].shift(20) - 1.0)\ncand["us10y_beta_cond_60x20"] = build_signal("us10y_beta_cond_60x20", f_us10y_cond)\n\n# 12. USDCNY beta conditional 60x20\ndef f_cny_cond():\n    b = beta(ret, macro["USDCNY"].pct_change(), 60)\n    return b * (macro["USDCNY"] / macro["USDCNY"].shift(20) - 1.0)\ncand["cny_beta_cond_60x20"] = build_signal("cny_beta_cond_60x20", f_cny_cond)\n\n# 13. XAU beta conditional 60x20 (gold risk-off regime)\ndef f_xau_cond():\n    b = beta(ret, close["XAU"].pct_change(), 60)\n    return b * (close["XAU"] / close["XAU"].shift(20) - 1.0)\ncand["xau_beta_cond_60x20"] = build_signal("xau_beta_cond_60x20", f_xau_cond)\n\n# 14. BTC beta conditional 60x20 (crypto risk-on regime)\ndef f_btc_cond():\n    b = beta(ret, close["BTC"].pct_change(), 60)\n    return b * (close["BTC"] / close["BTC"].shift(20) - 1.0)\ncand["btc_beta_cond_60x20"] = build_signal("btc_beta_cond_60x20", f_btc_cond)\n\n# 15. recent 10d avg intraday range (high-low)/close\ndef f_hl10():\n    return ((high - low) / close).rolling(10).mean()\ncand["hl_range_10"] = build_signal("hl_range_10", f_hl10)\n\n# ---------- library factors (existing effective) ----------\ndef lib_signals():\n    lib = {}\n    lib["mom_10d_skip5"] = close.shift(5) / close.shift(15) - 1.0\n    lib["mom_120d_skip5"] = close.shift(5) / close.shift(125) - 1.0\n    vix_ret = macro["VIX"].pct_change()\n    lib["vix_beta_cond_60x20"] = -beta(ret, vix_ret, 60) * (macro["VIX"] / macro["VIX"].shift(20) - 1.0)\n    lib["vol_of_vol20x60"] = ret.rolling(20).std().rolling(60).std()\n    return lib\n\nlib = lib_signals()\n\n# ---------- IC machinery ----------\ndef daily_ic(factor_panel, fwd_panel, min_valid=8):\n    """Spearman rank IC per date; returns series of IC."""\n    ics = []\n    for dt in factor_panel.index:\n        f = factor_panel.loc[dt]\n        r = fwd_panel.loc[dt]\n        pair = pd.concat([f, r], axis=1).dropna()\n        if len(pair) >= min_valid:\n            ic = pair.iloc[:, 0].rank().corr(pair.iloc[:, 1].rank())\n            if np.isfinite(ic):\n                ics.append((dt, ic))\n    if not ics:\n        return pd.Series(dtype=float)\n    return pd.Series([x[1] for x in ics], index=[x[0] for x in ics])\n\ndef turnover_10d(factor_panel):\n    """mean absolute cross-sectional rank change over 10d steps"""\n    ranks = factor_panel.rank(axis=1)\n    d = ranks.diff(10).abs().mean(axis=1)\n    return float(d.dropna().mean())\n\ndef library_corr(factor_panel, lib, max_dates=40000):\n    """pooled z-scored cross-sectional correlation with each library signal"""\n    zf = factor_panel.sub(factor_panel.mean(axis=1), axis=0).div(factor_panel.std(axis=1), axis=0)\n    zf = zf.stack().dropna()\n    out = {}\n    for name, s in lib.items():\n        s = s.reindex(factor_panel.index)\n        zs = s.sub(s.mean(axis=1), axis=0).div(s.std(axis=1), axis=0).stack().dropna()\n        idx = zf.index.intersection(zs.index)\n        if len(idx) > 100:\n            c = np.corrcoef(zf.loc[idx].values, zs.loc[idx].values)[0, 1]\n            out[name] = float(c)\n    return out\n\nH = 10\nfwd10 = fwd(H)\nresults = []\nfor name, s in cand.items():\n    ic_s = daily_ic(s, fwd10)\n    ic = float(ic_s.mean())\n    icsd = float(ic_s.std())\n    icir = ic / icsd if icsd > 0 else 0.0\n    hit = float((ic_s > 0).mean())\n    cov = float(s.notna().sum().sum()) / float(s.size)\n    to = turnover_10d(s)\n    lc = library_corr(s, lib)\n    maxlc = max(abs(v) for v in lc.values()) if lc else 0.0\n    # decay\n    dec = {}\n    for h in [1, 2, 3, 5, 10, 20]:\n        dec[str(h)] = round(float(daily_ic(s, fwd(h)).mean()), 4)\n    results.append(dict(name=name, ic=ic, icir=icir, hit=hit, cov=cov, to=to,\n                        maxlc=maxlc, n_ic=len(ic_s), decay=dec, lib_corr=lc))\n\nres = pd.DataFrame(results).sort_values("icir", key=lambda x: x.abs(), ascending=False)\npd.set_option("display.width", 250)\npd.set_option("display.max_columns", 30)\nprint(res[["name", "ic", "icir", "hit", "cov", "to", "maxlc", "n_ic"]].to_string(index=False))\nprint("\\nDecay IC by horizon:")\nfor _, r in res.iterrows():\n    print(f"  {r[\'name\']:<24} " + " ".join(f"{k}:{v:+.4f}" for k, v in r[\'decay\'].items()))\nprint("\\nGate check |IC|>=0.007 & |ICIR|>=0.084:")\nfor _, r in res.iterrows():\n    ok = abs(r["ic"]) >= 0.007 and abs(r["icir"]) >= 0.084\n    print(f"  {\'PASS\' if ok else \'fail\'}  {r[\'name\']:<24} ic={r[\'ic\']:+.4f} icir={r[\'icir\']:+.4f}")\nprint("\\nLibrary correlations (for top candidates):")\nfor _, r in res.head(8).iterrows():\n    print(f"  {r[\'name\']:<24} " + " ".join(f"{k}:{v:+.3f}" for k, v in r[\'lib_corr\'].items()))\n'})
