        corr, key = max_lib_corr(panel)
        m["max_abs_library_correlation"] = corr
        m["max_corr_factor"] = key
        m["admitted"] = bool(abs(m["ic"]) >= GATE_IC and abs(m["icir"]) >= GATE_ICIR)
