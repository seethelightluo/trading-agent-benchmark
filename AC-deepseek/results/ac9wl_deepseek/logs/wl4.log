111:def decay_profile(factor_panel, closes, horizons=(1, 2, 3, 5, 10, 20), min_valid=8, expected_sign=1):
112:    out = {}
113:    for h in horizons:
114:        fwd = forward_returns(closes, h)
115:        ics = rank_ic_series(factor_panel, fwd, min_valid)
116:        if len(ics):
117:            out[str(h)] = round(float(ics.mean()), 4)
118:    return out
