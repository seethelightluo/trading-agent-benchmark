96 def rolling_beta(asset_ret, driver_ret, win=60, min_obs=40, exclude_self=None):
97     beta = {}
98     for a in asset_ret.columns:
99         if exclude_self is not None and a == exclude_self:
100             beta[a] = pd.Series(np.nan, index=asset_ret.index)
101             continue
102         z = pd.concat([asset_ret[a].rename("a"), driver_ret.rename("m")], axis=1).dropna()
103         b = z["a"].rolling(win).cov(z["m"]) / z["m"].rolling(win).var()
104         beta[a] = b.where(z["m"].rolling(win).count() >= min_obs)
105     return pd.DataFrame(beta, index=asset_ret.index)
