  ▶️ shell({'command': 'python -c "\nimport json, base64, zlib, io, csv, itertools\nimport numpy as np\nfrom scipy.stats import spearmanr\n\ndef load_panel(path):\n    d = json.load(open(path))\n    art = d[\'validation\'][\'signal_artifact\']\n    fmt = art[\'format\']\n    if fmt == \'panel_json_v1\':\n        dates = art[\'dates\']\n        assets = art[\'assets\']\n        vals = art[\'values\']\n        arr = np.array([[vals[a][i] if vals[a][i] is not None else np.nan for a in assets] for i in range(len(dates))], dtype=float)\n        return dates, arr\n    elif fmt == \'base64:zlib:csv\':\n        raw = base64.b64decode(art[\'data\'])\n        txt = zlib.decompress(raw).decode()\n        rows = list(csv.reader(io.StringIO(txt)))\n        dates = [r[0] for r in rows[1:]]\n        arr = np.array([[float(x) if x else np.nan for x in r[1:]] for r in rows[1:]])\n        return dates, arr\n    return None, None\n\nids = [\'dn_mkt_beta_60d\',\'eurusd_beta_60d\',\'rate_beta_cn10y_60d\',\'vol_price_corr_20\']\npanels = {}\nfor fid in ids:\n    dates, arr = load_panel(f\'factors/{fid}.json\')\n    panels[fid] = (dates, arr)\n    print(fid, arr.shape, \'n_valid=\', np.isfinite(arr).sum())\n\nref = set(panels[\'vol_price_corr_20\'][0])\nix = {fid: {dt:i for i,dt in enumerate(dates)} for fid,(dates,_) in panels.items()}\ncommon = sorted(ref)\nM = {}\nfor fid in ids:\n    dates, arr = panels[fid]\n    rows = [arr[ix[fid][dt]] if dt in ix[fid] else np.full(arr.shape[1], np.nan) for dt in common]\n    M[fid] = np.array(rows)\nprint(\'common dates:\', len(common))\n\nfor a,b in itertools.combinations(ids,2):\n    rs = []\n    for t in range(len(common)):\n        x, y = M[a][t], M[b][t]\n        m = np.isfinite(x) & np.isfinite(y)\n        if m.sum() >= 8:\n            r = spearmanr(x[m], y[m]).statistic\n            if np.isfinite(r): rs.append(r)\n    print(f\'{a} vs {b}: mean_abs_rho={np.mean(np.abs(rs)):.3f}  n={len(rs)}\')\n" 2>&1 | tail -12'})
