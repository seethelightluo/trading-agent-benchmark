          f"n={m['n_ic_dates']:5d} covAD={m['coverage_asset_days']:.3f} "
          f"covD8={m['coverage_dates_ge8']:.3f} to={m['turnover_10d_rank']:.3f} "
          f"rho={m['max_abs_library_correlation']:.3f}({m['max_corr_factor']}) "
          f"{'PASS' if ok else 'FAIL'}", flush=True)

