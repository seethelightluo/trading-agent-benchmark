            b = z["a"].rolling(60).cov(z["v"]) / z["v"].rolling(60).var()
            beta[a] = b
        beta_df = pd.DataFrame(beta, index=rets.index)
        cond = -beta_df * (vix / vix.shift(20) - 1.0)
        sig["vix_beta_cond_60x20"] = cond
    return sig


