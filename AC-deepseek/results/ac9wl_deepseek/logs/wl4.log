 ma20.iloc[-1]>ma60.iloc[-1], ' MA60>MA120:', ma60.iloc[-1]>ma120.iloc[-1])\nprint('MA20 slope (5d): %.4f' % (ma20.iloc[-1]/ma20.iloc[-6]-1))\nprint('Price vs MA20: %.3f  vs MA60: %.3f' % (mkt.iloc[-1]/ma20.iloc[-1]-1, mkt.iloc[-1]/ma60.iloc[-1]-1))\n\n# drawdown from 60d high\nmdd = mkt.iloc[-1]/mkt.iloc[-60:].max()-1\nprint('DD from 60d high: %.2f%%' % (mdd*100))\n\n# cross-asset correlation regime (avg pairwise corr of 15 assets, 60d)\nc = ret.iloc[-60:].corr()\nvals = c.values[np.triu_indices_from(c.values, k=1)]\nprint('Avg pairwise corr (60d): %.2f' % np.nanmean(vals))\n\n# per-asset 20d vol\nvols = ret.iloc[-20:].std()*np.sqrt(252)\nprint('\\nPer-asset ann vol (20d):')\nprint(vols.sort_values(ascending=False).round(2).to_string())\n\n# last 10 trading days per-asset returns (the block just ended)\nr10 = px.iloc[-1]/px.iloc[-11]-1\nprint('\\nLast 10d per-asset returns:')\nprint(r10.sort_values(ascending=False).round(4).to_string())\nEOF"})
