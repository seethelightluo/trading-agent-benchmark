70:        cov = z["a"].rolling(win).cov(z["m"])
71:        var = z["m"].rolling(win).var()
72:        beta[a] = (cov / var).where(z["m"].rolling(win).count() >= min_obs)
73:    return pd.DataFrame(beta, index=asset_ret.index)
