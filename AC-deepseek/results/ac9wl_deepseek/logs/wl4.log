148 def rsi_build(s, a, win=14):
149     d = s.diff()
150     up = d.clip(lower=0.0).rolling(win).mean()
151     dnw = (-d.clip(upper=0.0)).rolling(win).mean()
152     rs = up / dnw.replace(0, np.nan)
153     return 100.0 - 100.0 / (1.0 + rs)
