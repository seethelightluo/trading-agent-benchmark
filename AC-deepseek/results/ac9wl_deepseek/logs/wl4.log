rmanr(x[m], y[m]).statistic\n            if np.isfinite(r): rs.append(r)\n    print(f\'{a} vs {b}: mean_rho={np.mean(rs):.3f}  n={len(rs)}\')\n" 2>&1 | tail -20'})
