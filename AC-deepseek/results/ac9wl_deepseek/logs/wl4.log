def rsi14(s, win=14):
    d = s.diff()
    up = d.clip(lower=0).rolling(win).mean()
    dn_ = (-d.clip(upper=0)).rolling(win).mean()
    return 100 - 100 / (1 + up / dn_.replace(0, np.nan))
lib["rsi_14"] = per_asset(rsi14)

