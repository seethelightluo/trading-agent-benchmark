22 vol_panel = pd.DataFrame({a: panels[a]["volume"].astype(float) for a in closes.columns}).reindex(closes.index)
23 mkt = rets.mean(axis=1)
24 H_ADM, MIN_VALID = 10, 8
25 
26 def rolling_beta(asset_ret, driver_ret, win=60, min_obs=40):
27     beta = {}
28     for a in asset_ret.columns:
29         z = pd.concat([asset_ret[a].rename("a"), driver_ret.rename("m")], axis=1).dropna()
30         cov = z["a"].rolling(win).cov(z["m"])
31         var = z["m"].rolling(win).var()
32         beta[a] = (cov / var).where(z["m"].rolling(win).count() >= min_obs)
33     return pd.DataFrame(beta, index=asset_ret.index)
34 
35 # library signals
36 dn = mkt.where(mkt < 0)
37 eur_ret = panels["EURUSD"]["close"].pct_change()
38 cn_ret = rets["CN10Y"]
39 LIBRARY = {
40     "vol_price_corr_20": pd.DataFrame({a: rets[a].rolling(20).corr(vol_panel[a]) for a in closes.columns}, index=rets.index),
41     "dn_mkt_beta_60d": rolling_beta(rets, dn, 60, 40),
42     "eurusd_beta_60d": rolling_beta(rets, eur_ret, 60, 40),
43     "rate_beta_cn10y_60d": rolling_beta(rets, cn_ret, 60, 40),
44 }
45 
46 cands = {
47     "mom_20d_skip5": (closes.shift(5) / closes.shift(25) - 1.0, 1),
