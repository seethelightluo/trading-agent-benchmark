21                                  turnover_rank, TRADABLE)
22 
23 t0 = time.time()
24 panels = load_panels(days=3000)
25 closes = close_panel(panels)
26 rets = closes.pct_change()
27 vol_panel = pd.DataFrame({a: panels[a]["volume"].astype(float) for a in closes.columns}).reindex(closes.index)
28 opens = pd.DataFrame({a: panels[a]["open"].astype(float) for a in closes.columns}).reindex(closes.index)
29 highs = pd.DataFrame({a: panels[a]["high"].astype(float) for a in closes.columns}).reindex(closes.index)
30 lows = pd.DataFrame({a: panels[a]["low"].astype(float) for a in closes.columns}).reindex(closes.index)
31 print(f"panels loaded {time.time()-t0:.1f}s | closes {closes.shape} | {closes.index.min().date()}..{closes.index.max().date()}", flush=True)
32 
33 LAST = closes.index.max()
34 print("last completed trading day:", LAST.date(), flush=True)
35 
36 for a in ["HSI", "ETH"]:
37     s = closes[a].dropna()
38     last20 = s.tail(20)
39     print(f"{a}: n_flat_last20={int((last20.diff()==0).sum())} last_close={last20.iloc[-1]:.4f}", flush=True)
40 
41 H_ADM = 10
42 MIN_VALID = 8
43 GATE_IC, GATE_ICIR = 0.0070, 0.0840
44 mkt = rets.mean(axis=1)
45 
46 def rolling_beta(asset_ret, driver_ret, win=60, min_obs=40):
47     beta = {}
48     for a in asset_ret.columns:
49         z = pd.concat([asset_ret[a].rename("a"), driver_ret.rename("m")], axis=1).dropna()
50         cov = z["a"].rolling(win).cov(z["m"])
51         var = z["m"].rolling(win).var()
52         beta[a] = (cov / var).where(z["m"].rolling(win).count() >= min_obs)
53     return pd.DataFrame(beta, index=asset_ret.index)
54 
55 # ---------- library factor signal artifacts (recompute from definitions) ----------
56 def lib_vol_price_corr_20():
57     return pd.DataFrame({a: rets[a].rolling(20).corr(vol_panel[a]) for a in closes.columns}, index=rets.index)
58 
59 def lib_dn_mkt_beta_60d():
60     m = mkt
61     dn = m.where(m < 0)
62     beta = {}
63     for a in rets.columns:
64         z = pd.concat([rets[a].rename("a"), dn.rename("m")], axis=1).dropna()
65         cov = z["a"].rolling(60).cov(z["m"])
66         var = z["m"].rolling(60).var()
67         beta[a] = (cov / var).where(z["m"].rolling(60).count() >= 40)
68     return pd.DataFrame(beta, index=rets.index)
69 
70 def lib_eurusd_beta_60d():
71     eur = panels["EURUSD"]["close"].pct_change() if "EURUSD" in panels else None
72     return rolling_beta(rets, eur, 60, 40) if eur is not None else None
73 
74 def lib_rate_beta_cn10y_60d():
75     cn = rets["CN10Y"]
76     return rolling_beta(rets, cn, 60, 40)
77 
78 LIBRARY = {}
79 LIBRARY["vol_price_corr_20"] = lib_vol_price_corr_20()
80 LIBRARY["dn_mkt_beta_60d"] = lib_dn_mkt_beta_60d()
81 LIBRARY["eurusd_beta_60d"] = lib_eurusd_beta_60d()
82 LIBRARY["rate_beta_cn10y_60d"] = lib_rate_beta_cn10y_60d()
83 
84 def max_lib_corr(cand):
85     best, best_key = 0.0, None
86     c = cand.stack()
87     for name, s in LIBRARY.items():
88         if s is None:
89             continue
90         both = pd.concat([c.rename("cand"), s.stack().rename("lib")], axis=1).dropna()
91         if len(both) < 30:
92             continue
93         r = float(both["cand"].corr(both["lib"]))
94         if abs(r) > best:
95             best, best_key = abs(r), name
96     return round(best, 4), best_key
97 
