78     for i, lab in enumerate(labels):
79         seg = ics.iloc[i * third:(i + 1) * third if i < 2 else n]
80         s = summarize_ic(seg, exp)
81         splits[lab] = {"ic": s["ic"], "icir": s["icir"], "n": s["n_ic_dates"]}
82     m["sub_period_ic"] = splits
83     m["n_ic_dates"] = m["n_ic_dates"]
84     out[name] = m
85     print(f"=== {name} (exp {exp:+d}) ===", flush=True)
86     print(f"  IC={m['ic']} ICIR={m['icir']} hit={m['ic_hit_ratio']} n={m['n_ic_dates']} ic_std={m['ic_std']}", flush=True)
87     print(f"  coverage_asset_days={m['coverage_asset_days']} coverage_dates_ge8={m['coverage_dates_ge8']} turnover={m['turnover_10d_rank']}", flush=True)
88     print(f"  max_lib_corr={m['max_abs_library_correlation']} ({m['max_corr_factor']})", flush=True)
89     print(f"  decay={ {k: round(v,4) for k,v in m['decay_ic_by_horizon'].items()} }", flush=True)
90     print(f"  sub_period: early {splits['early']} | mid {splits['mid']} | late {splits['late']}", flush=True)
91 
92 with open("scripts/_miner3_batchH_shortlist.json", "w") as f:
93     json.dump({k: {kk: vv for kk, vv in v.items() if kk != "decay_ic_by_horizon" or True} for k, v in out.items()}, f, indent=1, default=str)
