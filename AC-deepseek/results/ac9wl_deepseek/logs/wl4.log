  42| def rank_ic_vec(F: pd.DataFrame, R: pd.DataFrame, min_valid: int = 8) -> pd.Series:
  43|     common = F.index.intersection(R.index)
  44|     Fr = F.loc[common].rank(axis=1, method="average")
  45|     Rr = R.loc[common].rank(axis=1, method="average")
  46|     X = Fr.values.astype(float)
  47|     Y = Rr.values.astype(float)
  48|     valid = ~(np.isnan(X) | np.isnan(Y))
  49|     n = valid.sum(axis=1)
  50|     keep = n >= min_valid
  51|     X, Y, V, N = X[keep], Y[keep], valid[keep], n[keep]
  52|     Xv = np.where(V, X, np.nan)
  53|     Yv = np.where(V, Y, np.nan)
  54|     Xc = X - np.nanmean(Xv, axis=1, keepdims=True)
  55|     Yc = Y - np.nanmean(Yv, axis=1, keepdims=True)
  56|     Xc = np.where(V, Xc, 0.0)
  57|     Yc = np.where(V, Yc, 0.0)
  58|     xy = (Xc * Yc).sum(axis=1)
  59|     xx = (Xc * Xc).sum(axis=1)
  60|     yy = (Yc * Yc).sum(axis=1)
  61|     denom = np.sqrt(xx * yy)
  62|     ok = (xx > 1e-14) & (yy > 1e-14) & (denom > 0)
  63|     ic = np.full(len(X), np.nan)
  64|     ic[ok] = xy[ok] / denom[ok]
  65|     return pd.Series(ic, index=Fr.index[keep], name="ic").dropna()
  66| 
