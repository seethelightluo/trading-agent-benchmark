lose\'].iloc[-1]), "| 60d mean:", f"{v[\'close\'].tail(60).mean():.1f}", "| 60d max:", f"{v[\'close\'].tail(60).max():.1f}")\n# Cross-asset dispersion & correlation\ndisp = rets.tail(60).std(axis=1)\nprint("dispersion 60d mean:", f"{disp.mean()*100:.3f}", "last20:", f"{disp.tail(20).mean()*100:.3f}")\ncorr = rets.tail(60).corr()\nprint("mean pairwise corr (60d):", f"{corr.values[np.triu_indices_from(corr.values,1)].mean():.3f}")\n# Momentum breadth\nmom60 = (panel.iloc[-1]/panel.iloc[-61]-1).dropna()\nprint("60d momentum breadth (up/down):", int((mom60>0).sum()), "/", int((mom60<0).sum()))\nprint(mom60.round(3).sort_values().to_string())\nEOF'})
