ank_ic(s, f, window):\n    out=[]\n    for t in s.index[window:]:\n        a = s.loc[t].dropna(); b = f.loc[t].reindex(a.index).dropna()\n        common = a.index.intersection(b.index)\n        if len(common) >= 6:\n            ic = a[common].rank().corr(b[common].rank())\n            if pd.notna(ic): out.append(ic)\n    return np.mean(out), np.std(out), len(out), np.mean(out)/np.std(out) if len(out)>1 else 0\n\nfor name, s in sig.items():\n    for label, win in [(\'90d\',90), (\'180d\',180)]:\n        m, sd, n, icir = rank_ic(s, fwd, win)\n        print(f"{name:20s} last{label}: rankIC={m:+.4f} icir={icir:+.3f} n={n}")\n\n# full-period for reference\nprint("\\nFull visible sample:")\nfor name, s in sig.items():\n    m, sd, n, icir = rank_ic(s, fwd, 260)\n    print(f"{name:20s} full(260d burn): rankIC={m:+.4f} icir={icir:+.3f} n={n}")\n\n# correlation among factors (recent 180d), excluding frozen assets\nmask = (close.columns != \'HSI\') & (close.columns != \'ETH\')\nsub = close.columns[mask]\nprint("\\nFactor corr (last 180d, excl HSI/ETH):")\nfc = pd.DataFrame({k: sig[k][sub].mean(axis=1) for k in sig}).dropna()\nprint(fc.tail(180).corr().round(2).to_string())\nEOF'})
