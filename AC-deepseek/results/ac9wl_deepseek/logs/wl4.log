 151| def capped_normalize(w, cap=CAP):
 152|     """Normalize weights to sum 1, then water-fill cap at `cap`."""
 153|     w = {a: max(0.0, float(x)) for a, x in w.items()}
 154|     total = sum(w.values())
 155|     if total <= 0:
 156|         return {a: 1.0 / len(w) for a in w}
 157|     w = {a: x / total for a, x in w.items()}
 158|     for _ in range(200):
 159|         excess = sum(max(0.0, x - cap) for x in w.values())
 160|         if excess < 1e-12:
 161|             break
 162|         clipped = {a: min(cap, x) for a, x in w.items()}
 163|         room = [a for a, x in clipped.items() if x < cap - 1e-12]
 164|         if not room:
 165|             w = clipped
 166|             break
 167|         room_total = sum(w[a] for a in room)
 168|         if room_total <= 0:
 169|             w = clipped
 170|             break
 171|         for a in room:
 172|             clipped[a] += excess * (w[a] / room_total)
 173|         w = clipped
 174|     total = sum(w.values())
 175|     if abs(total - 1.0) > 1e-9 and total > 0:
 176|         w = {a: x / total for a, x in w.items()}
 177|     return w
