28 def loading_contraction(y, x):
29     z = pd.concat([y.rename("y"), x.rename("x")], axis=1).dropna().tail(60)
30     def beta(n):
31         q=z.tail(n); var=float(q.x.var())
32         return float(q.y.cov(q.x)/var) if len(q)>=12 and var>1e-14 else None
33     new, old = beta(20), beta(60)
34     return old-new if new is not None and old is not None else None
35 
36 def capped_normalize(w, pref):
37     for _ in range(40):
38         excess=sum(max(0., x-CAP) for x in w.values())
39         w={a:min(CAP, max(0., x)) for a, x in w.items()}
40         room=[a for a,x in w.items() if x<CAP-1e-12]
41         if excess < 1e-12 or not room: break
42         den=sum(max(0.,pref.get(a,0.)) for a in room)
43         for a in room: w[a] += excess*(max(0.,pref.get(a,0.))/den if den else 1/len(room))
44     total=sum(w.values())
45     return {a:x/total for a,x in w.items()}
