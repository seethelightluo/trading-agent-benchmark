104:def turnover_rank(factor_panel: pd.DataFrame, step: int = 10):
105:    """Mean absolute raw-rank change over `step` days (0..N-1 scale)."""
106:    r = factor_panel.rank(axis=1, method="average")
107:    diff = r.diff(step).abs().mean().mean()
108:    return round(float(diff), 3) if not math.isnan(diff) else None
