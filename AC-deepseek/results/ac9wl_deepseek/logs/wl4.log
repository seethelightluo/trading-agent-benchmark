92:def coverage_metrics(factor_panel: pd.DataFrame, assets=None, min_valid=8):
93:    assets = assets or TRADABLE
94:    valid = factor_panel.notna()
95:    asset_days = float(valid[list(valid.columns)].sum().sum())
96:    total_days = float(factor_panel.shape[0] * len([a for a in assets if a in valid.columns]))
97:    dates_ge8 = float((valid.sum(axis=1) >= min_valid).mean())
98:    return {
99:        "coverage_asset_days": round(asset_days / total_days, 3) if total_days else 0.0,
100:        "coverage_dates_ge8": round(dates_ge8, 3),
101:    }
