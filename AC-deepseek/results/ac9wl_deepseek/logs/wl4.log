  ▶️ shell({'command': 'python - <<\'EOF\'\nimport json, base64, zlib, io, csv\nimport numpy as np\nfrom itertools import combinations\n\nfids = ["dn_mkt_beta_60d","eurusd_beta_60d","mom_10d_skip5","mom_120d_skip5",\n        "rate_beta_cn10y_60d","vix_beta_cond_60x20","vol_of_vol20x60"]\n\ndef load_panel(fid):\n    rec = json.load(open(f"factors/{fid}.json"))\n    art = rec["validation"]["signal_artifact"]\n    fmt = art.get("format")\n    if fmt == "panel_json_v1":\n        dates, assets, values = art["dates"], art["assets"], art["values"]\n        return {d: {a: values[a][i] for a in assets} for i, d in enumerate(dates)}\n    if fmt == "base64:zlib:csv":\n        raw = zlib.decompress(base64.b64decode(art["data"])).decode()\n        rows = list(csv.DictReader(io.StringIO(raw)))\n        panel = {}\n        for r in rows:\n            panel[r["date"]] = {a: (float(r[a]) if r.get(a) not in (None, "", "nan") else None) for a in art["columns"]}\n        return panel\n    raise ValueError(f"unknown fmt {fmt}")\n\npanels = {fid: load_panel(fid) for fid in fids}\nprint("loaded panels:", {fid: len(p) for fid, p in panels.items()})\n\nprint("\\n=== Pairwise cross-sectional rank corr (common dates, >=8 assets) ===")\nfor a, b in combinations(fids, 2):\n    common = sorted(set(panels[a]) & set(panels[b]))\n    rhos = []\n    for d in common:\n        pa, pb = panels[a][d], panels[b][d]\n        xs = [(pa[s], pb[s]) for s in pa if s in pb and pa[s] is not None and pb[s] is not None]\n        if len(xs) >= 8:\n            x = [p[0] for p in xs]; y = [p[1] for p in xs]\n            r = np.corrcoef(x, y)[0, 1]\n            if not np.isnan(r): rhos.append(r)\n    if rhos:\n        print(f"  {a:24s} vs {b:24s}: mean rho={np.mean(rhos):+.3f} (n={len(rhos)})")\nEOF'})
