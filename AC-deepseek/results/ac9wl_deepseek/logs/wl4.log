23:def load_panels(days: int = 3000):
24:    """Return {asset: DataFrame} for tradable + macro, full history to last completed day."""
25:    panels = {}
26:    for s in TRADABLE:
27:        df = get_stock_daily_data(symbol=s, days=days)
28:        if df is not None and len(df) > 60:
29:            df = df.copy()
30:            df["date"] = pd.to_datetime(df["date"])
31:            df = df.set_index("date").sort_index()
32:            panels[s] = df
33:    for s in MACRO:
34:        df = get_index_daily_data(symbol=s, days=days)
35:        if df is not None and len(df) > 60:
36:            df = df.copy()
37:            df["date"] = pd.to_datetime(df["date"])
38:            df = df.set_index("date").sort_index()
39:            panels[s] = df
40:    return panels
