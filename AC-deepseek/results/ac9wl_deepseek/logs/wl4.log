173 def full_eval(factor_panel, closes, horizons=(1, 2, 3, 5, 10, 20), min_valid=8,
174               expected_sign=1, library=None, admission_horizon=10):
175     """Compute all validation metrics at the admission horizon plus decay + library corr."""
176     fwd = forward_returns(closes, admission_horizon)
177     ics = rank_ic_series(factor_panel, fwd, min_valid)
178     m = summarize_ic(ics, expected_sign)
179     m.update(coverage_metrics(factor_panel, min_valid=min_valid))
180     m["turnover_10d_rank"] = turnover_rank(factor_panel, 10)
181     m["decay_ic_by_horizon"] = decay_profile(factor_panel, closes, horizons, min_valid, expected_sign)
182     if library is not None:
183         corr, key = max_library_corr(factor_panel, library)
184         m["max_abs_library_correlation"] = corr
185         m["max_corr_factor"] = key
186     return m, ics
