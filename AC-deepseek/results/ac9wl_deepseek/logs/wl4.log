127:    sig = {}
128:    # mom_10d_skip5
129:    sig["mom_10d_skip5"] = closes.shift(5) / closes.shift(15) - 1.0
130:    # mom_120d_skip5
131:    sig["mom_120d_skip5"] = closes.shift(5) / closes.shift(125) - 1.0
132:    # vol_of_vol20x60
133:    sig["vol_of_vol20x60"] = rets.rolling(20).std().rolling(60).std()
134:    # vix_beta_cond_60x20: -beta(asset,VIX,60) * (VIX/VIX.shift(20)-1)
135:    if vix is not None:
136:        vix_ret = vix.pct_change()
137:        beta = {}
138:        for a in rets.columns:
139:            z = pd.concat([rets[a].rename("a"), vix_ret.rename("v")], axis=1).dropna()
140:            b = z["a"].rolling(60).cov(z["v"]) / z["v"].rolling(60).var()
141:            beta[a] = b
142:        beta_df = pd.DataFrame(beta, index=rets.index)
143:        cond = -beta_df * (vix / vix.shift(20) - 1.0)
144:        sig["vix_beta_cond_60x20"] = cond
145:    return sig
