def max_dd(s):
    roll_max = s.rolling(60).max()
    dd = s / roll_max - 1.0
    return dd.rolling(60).min()
cand["max_drawdown_60d"] = asset_wide(max_dd)
# L return skewness 60d
cand["skew_60d"] = asset_wide(lambda s: s.pct_change().rolling(60).skew())
