  ▶️ shell({'command': 'python -c "\nimport pandas as pd, numpy as np, glob, os\n# Build live IC for the 4 active factors through 2026-12-18 using factor definitions\nfiles = sorted(glob.glob(\'../persistent/stock_data/*.csv\'))\npx = {}\nvol = {}\nfor f in files:\n    sym = os.path.basename(f).replace(\'.csv\',\'\')\n    df = pd.read_csv(f)\n    df.columns = [c.strip().lower() for c in df.columns]\n    df[\'date\'] = pd.to_datetime(df[\'date\'])\n    df = df.set_index(\'date\').sort_index()\n    px[sym] = df[\'close\'].astype(float)\n    vol[sym] = df[\'volume\'].astype(float) if \'volume\' in df.columns else np.nan\npx = pd.DataFrame(px); vol = pd.DataFrame(vol)\npx = px[px.index <= \'2026-12-18\'].sort_index()\nvol = vol.reindex(px.index)\nrets = px.pct_change()\nmkt = rets.mean(axis=1)\n\ndef rolling_beta(y, x, win=60, min_obs=40):\n    out = pd.DataFrame(index=y.index, columns=y.columns, dtype=float)\n    for c in y.columns:\n        z = pd.concat([y[c].rename(\'a\'), x.rename(\'m\')], axis=1).dropna()\n        cov = z[\'a\'].rolling(win).cov(z[\'m\'])\n        var = z[\'m\'].rolling(win).var()\n        out[c] = (cov/var).where(z[\'m\'].rolling(win).count() >= min_obs)\n    return out\n\neurusd = pd.read_csv(\'../persistent/index_data/EURUSD.csv\'); eurusd.columns=[c.strip().lower() for c in eurusd.columns]; eurusd[\'date\']=pd.to_datetime(eurusd[\'date\']); eurusd=eurusd.set_index(\'date\').sort_index()[\'close\'].astype(float)\neurusd = eurusd.reindex(px.index)\n\nf_vpc = pd.DataFrame({c: rets[c].rolling(20).corr(vol[c]) for c in px.columns}, index=px.index)\nf_dn = rolling_beta(rets, mkt.where(mkt<0,0.0), 60, 40)\nf_eur = rolling_beta(rets, eurusd.pct_change(), 60, 40)\nf_cn = rolling_beta(rets, px[\'CN10Y\'].pct_change(), 60, 40)\n\nfacs = {\'vol_price_corr_20\': f_vpc, \'dn_mkt_beta_60d\': f_dn, \'eurusd_beta_60d\': f_eur, \'rate_beta_cn10y_60d\': f_cn}\nfwd = px.shift(-10)/px - 1\n\ndef rank_ic(fval, fwd10, start, end, min_assets=6):\n    fv = fval.loc[start:end]; fr = fwd10.loc[start:end]\n    ics = []\n    for d in fv.index:\n        x = fv.loc[d]; y = fr.loc[d]\n        m = x.notna() & y.notna()\n        if m.sum() < min_assets: continue\n        ics.append((d, x[m].rank().corr(y[m].rank())))\n    if not ics: return None\n    return pd.Series(dict(ics))\n\nfor label, a, b in [(\'LIVE 08-03..12-18\',\'2026-08-03\',\'2026-12-18\'), (\'LIVE 10-12..12-18\',\'2026-10-12\',\'2026-12-18\'), (\'LIVE 11-23..12-18\',\'2026-11-23\',\'2026-12-18\')]:\n    print(f\'=== {label} (h=10 rank IC) ===\')\n    for name, fv in facs.items():\n        s = rank_ic(fv, fwd, a, b)\n        if s is None or len(s)==0:\n            print(f\'{name}: no data\'); continue\n        ic = s.mean(); icir = s.mean()/s.std() if s.std()>0 else np.nan\n        hit = (np.sign(s)>0).mean()\n        print(f\'{name}: n={len(s):3d} IC={ic:+.4f} ICIR={icir:+.3f} hit={hit:.2f}\')\n    print()\n"'})
