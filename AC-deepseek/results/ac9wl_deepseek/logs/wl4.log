def clean_panel(func):
    """Apply func to each asset's own dropna'd series, return union-indexed panel."""
    idx = closes.index
    out = {}
    for a in WL:
        s = closes[a].dropna()
        if len(s) < 30:
            out[a] = pd.Series(np.nan, index=idx)
            continue
        r = func(s)
        out[a] = r.reindex(idx)
    return pd.DataFrame(out, index=idx)

def clean_rets(func):
    idx = closes.index
    out = {}
    for a in WL:
        s = closes[a].dropna().pct_change()
        if len(s) < 30:
            out[a] = pd.Series(np.nan, index=idx)
            continue
        r = func(s)
        out[a] = r.reindex(idx)
    return pd.DataFrame(out, index=idx)

def fwd_panel(h):
    """Per-asset forward h-day return on own calendar."""
    idx = closes.index
    out = {}
    for a in WL:
        s = closes[a].dropna()
        r = s.shift(-h) / s - 1.0
        out[a] = r.reindex(idx)
    return pd.DataFrame(out, index=idx)

