160 def load_library_meta():
161     """Load persisted factor json defs to know expression/direction."""
162     meta = {}
163     if LIB_DIR.exists():
164         for p in sorted(LIB_DIR.glob("*.json")):
165             try:
166                 d = json.loads(p.read_text())
167                 meta[d["factor_id"]] = d
168             except Exception:
169                 pass
170     return meta
171 
