1:"""Shared factor research library for miner_1.
2:
3:Loads the 15-asset tradable universe + macro signals through the previous
4:completed trading day (no lookahead), computes factor panels, forward returns,
5:rank-IC metrics, and correlation vs existing library factors.
6:"""
7:from __future__ import annotations
8:
9:import json
10:import math
11:from pathlib import Path
12:
13:import numpy as np
14:import pandas as pd
15:from alphacrafter.sim.utils import get_stock_daily_data, get_index_daily_data
16:
17:TRADABLE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX",
18:            "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
19:MACRO = ["VIX", "DXY", "USDCNY", "USDJPY", "EURUSD"]
20:LIB_DIR = Path("factors")
