def body_pos(s, win=20):
    hi = s.rolling(2).max(); lo = s.rolling(2).min()
    pos = (s - lo) / (hi - lo).replace(0, np.nan)
    return pos.rolling(win).mean()
candsE["body_pos_20d"] = per_asset(lambda s: body_pos(s, 20))
