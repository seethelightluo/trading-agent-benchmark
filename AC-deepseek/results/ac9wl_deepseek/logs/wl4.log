0 """Shared factor research library for miner_1.
1 
2 Loads the 15-asset tradable universe + macro signals through the previous
3 completed trading day (no lookahead), computes factor panels, forward returns,
4 rank-IC metrics, and correlation vs existing library factors.
5 """
6 from __future__ import annotations
7 
8 import json
9 import math
10 from pathlib import Path
11 
12 import numpy as np
13 import pandas as pd
14 from alphacrafter.sim.utils import get_stock_daily_data, get_index_daily_data
15 
16 TRADABLE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX",
17             "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
18 MACRO = ["VIX", "DXY", "USDCNY", "USDJPY", "EURUSD"]
19 LIB_DIR = Path("factors")
20 
