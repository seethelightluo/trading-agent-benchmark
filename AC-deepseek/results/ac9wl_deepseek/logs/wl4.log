25:def rolling_beta(asset_ret, driver_ret, win=60, min_obs=40):
26:    beta = {}
27:    for a in asset_ret.columns:
28:        z = pd.concat([asset_ret[a].rename("a"), driver_ret.rename("m")], axis=1).dropna()
