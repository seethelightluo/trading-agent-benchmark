61:def rank_ic_series(factor_panel: pd.DataFrame, fwd: pd.DataFrame, min_valid: int = 8):
62:    """Daily Spearman rank IC between factor cross-section and forward return cross-section."""
63:    dates, ics = [], []
64:    for dt in factor_panel.index:
65:        f = factor_panel.loc[dt]
66:        r = fwd.loc[dt] if dt in fwd.index else None
67:        if r is None:
68:            continue
69:        pair = pd.concat([f.rename("f"), r.rename("r")], axis=1).dropna()
70:        if len(pair) < min_valid or pair["r"].std() < 1e-14 or pair["f"].std() < 1e-14:
71:            continue
72:        ic = pair["f"].corr(pair["r"], method="spearman")
73:        if not math.isnan(ic):
74:            dates.append(dt)
75:            ics.append(ic)
76:    return pd.Series(ics, index=pd.DatetimeIndex(dates), name="ic")
