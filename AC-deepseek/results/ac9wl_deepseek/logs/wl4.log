67 def summarize_ic(ic_series: pd.Series, expected_sign: int = 1):
68     ic = float(ic_series.mean())
69     sd = float(ic_series.std(ddof=1)) if len(ic_series) > 1 else 0.0
70     icir = ic / sd if sd > 0 else 0.0
71     hit = float((np.sign(ic_series) == expected_sign).mean()) if expected_sign else float((np.sign(ic_series) != 0).mean())
72     return {"ic": round(ic, 4), "icir": round(icir, 4),
73             "ic_hit_ratio": round(hit, 3), "n_ic_dates": int(len(ic_series)),
74             "ic_std": round(sd, 4)}
75 
