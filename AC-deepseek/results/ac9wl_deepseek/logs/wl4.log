def load_library_meta():
    """Load persisted factor json defs to know expression/direction."""
    meta = {}
    if LIB_DIR.exists():
        for p in sorted(LIB_DIR.glob("*.json")):
            try:
                d = json.loads(p.read_text())
                meta[d["factor_id"]] = d
            except Exception:
                pass
    return meta

