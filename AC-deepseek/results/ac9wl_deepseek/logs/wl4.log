                                 "max_abs_library_correlation": corr,
                                 "correlation_path": "validation.metrics.max_abs_library_correlation"},
        },
    }

    out = Path(f"factors/{fid}.json")
    out.write_text(json.dumps(rec))
    # sidecar csv: long format date,symbol,value
