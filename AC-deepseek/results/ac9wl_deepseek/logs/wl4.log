43 # ---------------- correct vectorized rank-IC ----------------
44 def rank_ic_series_vec(factor_panel: pd.DataFrame, fwd: pd.DataFrame, min_valid: int = 8):
45     fr = factor_panel.rank(axis=1, method="average", na_option="keep")
46     rr = fwd.rank(axis=1, method="average", na_option="keep")
47     valid = fr.notna() & rr.notna()
48     n = valid.sum(axis=1).astype(float)
49     f = fr.where(valid)
50     r = rr.where(valid)
51     fm = f.sub(f.mean(axis=1), axis=0)   # row demean (skips NaN)
52     rm = r.sub(r.mean(axis=1), axis=0)
53     num = fm.mul(rm).sum(axis=1, min_count=1)
54     den = np.sqrt(fm.pow(2).sum(axis=1, min_count=1) * rm.pow(2).sum(axis=1, min_count=1))
55     ic = num.div(den.replace(0, np.nan))
56     ic = ic.where((n >= min_valid) & (n >= 2) & (den > 1e-14))
57     ic = ic.replace([np.inf, -np.inf], np.nan).dropna()
58     ic.name = "ic"
59     return ic
60 
61 
62 def summarize(ic_series, expected_sign=1):
63     ic = float(ic_series.mean())
64     std = float(ic_series.std(ddof=1))
65     icir = ic / std if std > 0 else 0.0
66     hit = float((np.sign(ic_series) == expected_sign).mean())
67     return {"ic": round(ic, 4), "icir": round(icir, 4), "ic_hit_ratio": round(hit, 3),
68             "n_ic_dates": int(len(ic_series)), "ic_std": round(std, 4)}
69 
70 
71 def decay_vec(factor_panel, horizons=HORIZONS, min_valid=MIN_VALID):
72     out = {}
73     for h in horizons:
74         ics = rank_ic_series_vec(factor_panel, forward_returns(closes, h), min_valid)
75         out[str(h)] = round(float(ics.mean()), 4) if len(ics) else float("nan")
76     return out
