  ▶️ shell({'command': "python - <<'EOF'\nimport pandas as pd, numpy as np, glob, os\n\nEND = '2027-03-26'\nLOOKBACK = 130  # enough for 60d vol, MA60\n\ninstruments = ['000300.SH','000688.SH','SPX','HSI','N225','SX5E','SOX','NDX','XAU','COPPER','WTI','BTC','ETH','US10Y','CN10Y']\nrows=[]\nfor s in instruments:\n    df = pd.read_csv(f'../persistent/stock_data/{s}.csv')\n    df['date']=pd.to_datetime(df['date'])\n    df = df[df['date']<=END].tail(LOOKBACK).reset_index(drop=True)\n    px = df['close']\n    ret = px.pct_change()\n    last = px.iloc[-1]\n    r20 = px.iloc[-1]/px.iloc[-21]-1 if len(px)>21 else np.nan\n    r60 = px.iloc[-1]/px.iloc[-61]-1 if len(px)>61 else np.nan\n    vol20 = ret.tail(20).std()*np.sqrt(252)\n    ma20 = px.rolling(20).mean().iloc[-1]\n    ma60 = px.rolling(60).mean().iloc[-1] if len(px)>=60 else np.nan\n    slope_ma20 = (ma20/px.rolling(20).mean().iloc[-6]-1) if len(px)>=26 else np.nan\n    dd = (px/px.cummax()-1).min()\n    above_ma20 = last>ma20\n    above_ma60 = last>ma60\n    rows.append(dict(sym=s, last=round(last,2), r20=round(r20*100,2), r60=round(r60*100,2),\n                     vol20=round(vol20*100,1), ma20_slope=round((ma20/px.rolling(20).mean().iloc[-6]-1)*100,2) if len(px)>=26 else np.nan,\n                     above_ma20=above_ma20, above_ma60=above_ma60, maxdd60=round(dd*100,1)))\n\nout = pd.DataFrame(rows)\nprint(out.to_string(index=False))\nprint()\nprint('=== AGGREGATE ===')\nprint('N above MA20:', out.above_ma20.sum(), '/15 ; above MA60:', out.above_ma60.sum(), '/15')\nprint('median r20:', out.r20.median(), '% ; median r60:', out.r60.median(), '%')\nprint('median vol20:', out.vol20.median(), '% ; mean vol20:', out.vol20.mean(), '%')\nprint('avg maxdd60:', out.maxdd60.mean(), '%')\n\n# macro\nprint()\nprint('=== MACRO (obs-only) ===')\nfor m in ['VIX','DXY','EURUSD','USDJPY','USDCNY']:\n    df = pd.read_csv(f'../persistent/index_data/{m}.csv')\n    df['date']=pd.to_datetime(df['date'])\n    df = df[df['date']<=END].tail(70).reset_index(drop=True)\n    px=df['close']\n    r20 = px.iloc[-1]/px.iloc[-21]-1 if len(px)>21 else np.nan\n    r60 = px.iloc[-1]/px.iloc[-61]-1 if len(px)>61 else np.nan\n    print(f'{m}: last={px.iloc[-1]:.2f} r20={r20*100:+.2f}% r60={r60*100:+.2f}%')\nEOF"})
