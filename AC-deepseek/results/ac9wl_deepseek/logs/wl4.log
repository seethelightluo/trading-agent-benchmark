p = "scripts/miner_1_20260914_explore_batchC_fixed2.py"
src = open(p).read()
old = '''def rank_ic_series_vec(factor_panel: pd.DataFrame, fwd: pd.DataFrame, min_valid: int = 8):
    both = pd.concat({"f": factor_panel, "r": fwd}, axis=1)
    f = both["f"].rank(axis=1, na_option="keep")
    r = both["r"].rank(axis=1, na_option="keep")
    n = (both["f"].notna() & both["r"].notna()).sum(axis=1).astype(float)
    sx = f.sum(axis=1, min_count=1)
    sy = r.sum(axis=1, min_count=1)
    sxx = (f * f).sum(axis=1, min_count=1)
    syy = (r * r).sum(axis=1, min_count=1)
    sxy = (f * r).sum(axis=1, min_count=1)
    denom = np.sqrt((n * sxx - sx ** 2) * (n * syy - sy ** 2))
    ic = (n * sxy - sx * sy) / denom
    ic = ic.where(n >= min_valid)
    ic = ic.replace([np.inf, -np.inf], np.nan).dropna()
    ic.name = "ic"
    return ic'''
new = '''def rank_ic_series_vec(factor_panel: pd.DataFrame, fwd: pd.DataFrame, min_valid: int = 8):
    # vectorized ranks, then per-date Pearson-on-ranks (small cross-section, fast)
    f = factor_panel.rank(axis=1)
    r = fwd.rank(axis=1)
    dates, ics = [], []
    for dt in factor_panel.index:
        if dt not in fwd.index:
            continue
        fi = f.loc[dt]
        ri = r.loc[dt]
        mask = fi.notna() & ri.notna()
        n = int(mask.sum())
        if n < min_valid or n < 2:
            continue
        fi_v = fi[mask].to_numpy(dtype=float)
        ri_v = ri[mask].to_numpy(dtype=float)
        if fi_v.std() < 1e-14 or ri_v.std() < 1e-14:
            continue
        ic = float(np.corrcoef(fi_v, ri_v)[0, 1])
        if not np.isnan(ic):
            dates.append(dt)
            ics.append(ic)
    return pd.Series(ics, index=pd.DatetimeIndex(dates), name="ic")'''
assert old in src
open(p, "w").write(src.replace(old, new))
print("patched rank_ic_series_vec")
