22 def ranks(values, assets):
23     valid = sorted((float(v), a) for a, v in values.items() if v is not None and isfinite(float(v)))
24     out = {a: .5 for a in assets}
25     for i, (_, a) in enumerate(valid): out[a] = i / max(1, len(valid)-1)
