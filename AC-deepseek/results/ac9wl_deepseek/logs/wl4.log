  68| def summarize_ic(ic_series: pd.Series, expected_sign: int = 1):
  69|     ic = float(ic_series.mean())
  70|     sd = float(ic_series.std(ddof=1)) if len(ic_series) > 1 else 0.0
  71|     icir = ic / sd if sd > 0 else 0.0
  72|     hit = float((np.sign(ic_series) == expected_sign).mean()) if expected_sign else float((np.sign(ic_series) != 0).mean())
  73|     return {"ic": round(ic, 4), "icir": round(icir, 4),
  74|             "ic_hit_ratio": round(hit, 3), "n_ic_dates": int(len(ic_series)),
  75|             "ic_std": round(sd, 4)}
