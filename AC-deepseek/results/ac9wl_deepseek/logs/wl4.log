22 def load_panels(days: int = 3000):
23     """Return {asset: DataFrame} for tradable + macro, full history to last completed day."""
24     panels = {}
25     for s in TRADABLE:
26         df = get_stock_daily_data(symbol=s, days=days)
27         if df is not None and len(df) > 60:
28             df = df.copy()
29             df["date"] = pd.to_datetime(df["date"])
30             df = df.set_index("date").sort_index()
31             panels[s] = df
32     for s in MACRO:
33         df = get_index_daily_data(symbol=s, days=days)
34         if df is not None and len(df) > 60:
35             df = df.copy()
36             df["date"] = pd.to_datetime(df["date"])
37             df = df.set_index("date").sort_index()
38             panels[s] = df
39     return panels
40 
41 
42 def close_panel(panels, assets=None):
43     assets = assets or TRADABLE
44     return pd.concat(
45         {a: panels[a]["close"].astype(float) for a in assets if a in panels},
46         axis=1,
47     ).sort_index()
48 
49 
50 def ret_panel(panels, assets=None):
51     c = close_panel(panels, assets)
52     return c.pct_change()
53 
54 
55 def forward_returns(closes, horizon: int):
56     """Forward h-day return computed from closes: close[t+h]/close[t]-1."""
57     return closes.shift(-horizon) / closes - 1.0
58 
59 
60 def rank_ic_series(factor_panel: pd.DataFrame, fwd: pd.DataFrame, min_valid: int = 8):
61     """Daily Spearman rank IC between factor cross-section and forward return cross-section."""
62     dates, ics = [], []
63     for dt in factor_panel.index:
64         f = factor_panel.loc[dt]
65         r = fwd.loc[dt] if dt in fwd.index else None
66         if r is None:
67             continue
68         pair = pd.concat([f.rename("f"), r.rename("r")], axis=1).dropna()
69         if len(pair) < min_valid or pair["r"].std() < 1e-14 or pair["f"].std() < 1e-14:
70             continue
71         ic = pair["f"].corr(pair["r"], method="spearman")
72         if not math.isnan(ic):
73             dates.append(dt)
74             ics.append(ic)
75     return pd.Series(ics, index=pd.DatetimeIndex(dates), name="ic")
76 
77 
78 def summarize_ic(ic_series: pd.Series, expected_sign: int = 1):
79     ic = ic_series.mean()
80     icir = ic_series.mean() / ic_series.std(ddof=1) if ic_series.std(ddof=1) > 0 else 0.0
81     hit = float((np.sign(ic_series) == expected_sign).mean()) if expected_sign else float((np.sign(ic_series) != 0).mean())
82     return {
83         "ic": round(float(ic), 4),
84         "icir": round(float(icir), 4),
85         "ic_hit_ratio": round(float(hit), 3),
86         "n_ic_dates": int(len(ic_series)),
87         "ic_std": round(float(ic_series.std(ddof=1)), 4),
88     }
89 
90 
91 def coverage_metrics(factor_panel: pd.DataFrame, assets=None, min_valid=8):
92     assets = assets or TRADABLE
93     valid = factor_panel.notna()
94     asset_days = float(valid[list(valid.columns)].sum().sum())
95     total_days = float(factor_panel.shape[0] * len([a for a in assets if a in valid.columns]))
96     dates_ge8 = float((valid.sum(axis=1) >= min_valid).mean())
97     return {
98         "coverage_asset_days": round(asset_days / total_days, 3) if total_days else 0.0,
99         "coverage_dates_ge8": round(dates_ge8, 3),
100     }
101 
102 
103 def turnover_rank(factor_panel: pd.DataFrame, step: int = 10):
104     """Mean absolute raw-rank change over `step` days (0..N-1 scale)."""
105     r = factor_panel.rank(axis=1, method="average")
106     diff = r.diff(step).abs().mean().mean()
107     return round(float(diff), 3) if not math.isnan(diff) else None
108 
109 
110 def decay_profile(factor_panel, closes, horizons=(1, 2, 3, 5, 10, 20), min_valid=8, expected_sign=1):
111     out = {}
112     for h in horizons:
113         fwd = forward_returns(closes, h)
114         ics = rank_ic_series(factor_panel, fwd, min_valid)
115         if len(ics):
116             out[str(h)] = round(float(ics.mean()), 4)
117     return out
118 
