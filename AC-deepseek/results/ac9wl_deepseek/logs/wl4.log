147 def max_library_corr(candidate: pd.DataFrame, library: dict):
148     """Max absolute pairwise Pearson correlation of stacked cross-sectional values."""
149     best, best_key = 0.0, None
150     for name, lib_sig in library.items():
151         both = pd.concat([candidate.stack().rename("cand"), lib_sig.stack().rename("lib")], axis=1).dropna()
152         if len(both) < 30:
153             continue
154         r = float(both["cand"].corr(both["lib"]))
155         if abs(r) > best:
156             best, best_key = abs(r), name
157     return round(best, 4), best_key
158 
