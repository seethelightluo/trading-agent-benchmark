41 def rank_ic_vec(F: pd.DataFrame, R: pd.DataFrame, min_valid: int = 8) -> pd.Series:
42     common = F.index.intersection(R.index)
43     Fr = F.loc[common].rank(axis=1, method="average")
44     Rr = R.loc[common].rank(axis=1, method="average")
45     X = Fr.values.astype(float)
