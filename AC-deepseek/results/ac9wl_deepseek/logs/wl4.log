148:def max_library_corr(candidate: pd.DataFrame, library: dict):
149:    """Max absolute pairwise Pearson correlation of stacked cross-sectional values."""
150:    best, best_key = 0.0, None
151:    for name, lib_sig in library.items():
152:        both = pd.concat([candidate.stack().rename("cand"), lib_sig.stack().rename("lib")], axis=1).dropna()
153:        if len(both) < 30:
154:            continue
155:        r = float(both["cand"].corr(both["lib"]))
156:        if abs(r) > best:
157:            best, best_key = abs(r), name
158:    return round(best, 4), best_key
