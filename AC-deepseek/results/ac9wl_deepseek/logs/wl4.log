101 # A trend efficiency (Kaufman ER) 20d
102 cand["trend_eff_20d"] = asset_wide(lambda s: (s - s.shift(20)).abs() / s.pct_change().abs().rolling(20).sum())
103 # B downside deviation ratio 60d (negated: high downside share => crash risk, expect -1)
104 def downside_ratio(s):
105     r = s.pct_change()
106     dd = r.where(r < 0, 0.0).rolling(60).std()
107     tot = r.rolling(60).std()
108     return dd / tot
109 cand["downside_dev_ratio_60d"] = asset_wide(downside_ratio)
110 # C range position 20d
111 def range_pos(s):
112     hi = s.rolling(20).max()
113     lo = s.rolling(20).min()
114     return (s - lo) / (hi - lo)
115 cand["range_pos_20d"] = asset_wide(range_pos)
116 # D vol z-score: (vol20 - mean(vol20,250))/std(vol20,250)
117 def vol_zscore(s):
118     v = s.pct_change().rolling(20).std()
119     mu = v.rolling(250).mean()
120     sd = v.rolling(250).std()
121     return (v - mu) / sd
122 cand["vol_zscore_60_250"] = asset_wide(vol_zscore)
123 # E up-day ratio 60d
124 cand["upday_ratio_60d"] = asset_wide(lambda s: (s.pct_change() > 0).rolling(60).mean())
125 # F return autocorrelation 60d (trend persistence)
126 def autocorr(s):
127     r = s.pct_change()
128     z = pd.concat([r.rename("a"), r.shift(1).rename("b")], axis=1)
