224 def max_lib_corr(cand_df, lib):
225     best, best_key = 0.0, None
226     cstack = cand_df.stack().rename("cand")
227     for name, lib_df in lib.items():
228         both = pd.concat([cstack, lib_df.stack().rename("lib")], axis=1).dropna()
229         if len(both) < 30:
230             continue
231         r = float(both["cand"].corr(both["lib"]))
232         if abs(r) > best:
233             best, best_key = abs(r), name
234     return round(best, 4), best_key
