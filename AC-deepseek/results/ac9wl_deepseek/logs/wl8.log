  ▶️ shell({'command': "python - <<'EOF'\nimport json, zlib, base64, io, csv, os\nimport pandas as pd, numpy as np\n\ndef load_signal(path):\n    with open(path) as fh:\n        d = json.load(fh)\n    art = d['validation']['signal_artifact']\n    txt = zlib.decompress(base64.b64decode(art['data'])).decode()\n    rows = list(csv.reader(io.StringIO(txt)))\n    header = rows[0]\n    data = {r[0]: [float(x) if x.strip() not in ('','nan','None') else np.nan for x in r[1:]] for r in rows[1:]}\n    return header[1:], data\n\n# Load price closes from CSV\nprices = {}\nfor name in ['000300.SH','000688.SH','BTC','CN10Y','COPPER','ETH','HSI','N225','NDX','SOX','SPX','SX5E','US10Y','WTI','XAU']:\n    df = pd.read_csv(f'../persistent/stock_data/{name}.csv')\n    df['date'] = pd.to_datetime(df['date'])\n    df = df.sort_values('date').drop_duplicates('date')\n    prices[name] = df.set_index('date')['close']\n\npx = pd.DataFrame(prices).sort_index()\npx = px[px.index <= '2026-07-29']  # no future data\n\nassets, sig_mom = load_signal('factors/mom_10d_skip5.json')\nassets2, sig_vix = load_signal('factors/vix_beta_cond_60x20.json')\n\n# Build aligned signal df (dates <= 2026-07-15 for forward 10d returns ending <= 2026-07-29)\ndef sig_df(sig):\n    s = pd.DataFrame(sig).T\n    s.index = pd.to_datetime(s.index)\n    s = s.sort_index()\n    s.columns = assets\n    return s\n\nsm = sig_df(sig_mom)\nsv = sig_df(sig_vix)\n\nfwd = px.shift(-10)/px - 1  # 10d forward return\n\ndef ic_series(sig, fwd, max_date='2026-07-15'):\n    dates = sig.index[(sig.index <= max_date)]\n    ics = []\n    for d in dates:\n        s = sig.loc[d]\n        f = fwd.loc[d]\n        m = s.notna() & f.notna()\n        if m.sum() >= 8:\n            ics.append((d, s[m].rank().corr(f[m].rank())))\n    return pd.Series(dict(ics))\n\nic_mom = ic_series(sm, fwd)\nic_vix = ic_series(sv, fwd)\n\nfor nm, ic in [('mom_10d_skip5', ic_mom), ('vix_beta_cond_60x20', ic_vix)]:\n    recent = ic[ic.index >= '2026-05-01']\n    print(f'{nm}: full IC mean={ic.mean():.4f} ICIR={ic.mean()/ic.std():.3f} n={len(ic)}')\n    print(f'   recent(>=2026-05-01): mean={recent.mean():.4f} n={len(recent)} hit={ (recent>0).mean():.2f}')\n\n# pairwise corr of signals at common dates (<=2026-07-15), cross-sectional corr averaged\ncommon = sm.index.intersection(sv.index)\ncommon = common[common <= '2026-07-15']\ncs_corrs = []\nfor d in common:\n    a = sm.loc[d]; b = sv.loc[d]\n    m = a.notna() & b.notna()\n    if m.sum() >= 8:\n        cs_corrs.append(a[m].rank().corr(b[m].rank()))\ncs_corrs = pd.Series(cs_corrs)\nprint(f'\\npairwise cross-sectional spearman corr (mom vs vix_beta): mean={cs_corrs.mean():.3f} |corr|>0.5 freq={(cs_corrs.abs()>0.5).mean():.2f}')\n\n# decision-row corr\nd = '2026-07-29'\na = sm.loc[d]; b = sv.loc[d]\nm = a.notna() & b.notna()\nprint(f'decision-row ({d}) rank corr: {a[m].rank().corr(b[m].rank()):.3f}')\nEOF"})
