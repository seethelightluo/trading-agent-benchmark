ldA), (\'yield_form_B\', f_yieldB)]:\n    ics = spearman_ic(fp, fwd10)\n    if not ics: print(name, \'no dates\'); continue\n    ics_all = pd.Series([x[1] for x in ics], index=[x[0] for x in ics])\n    recent = ics_all[ics_all.index >= pd.Timestamp(\'2025-07-01\')]\n    last60 = ics_all[ics_all.index >= pd.Timestamp(\'2026-04-01\')]\n    print(f\'{name:20s} full: n={len(ics_all):4d} IC={ics_all.mean():+.4f} ICIR={ics_all.mean()/ics_all.std():+.3f} | recent(1y): n={len(recent):4d} IC={recent.mean():+.4f} | last3m: n={len(last60):3d} IC={last60.mean():+.4f}\')\n"'})
