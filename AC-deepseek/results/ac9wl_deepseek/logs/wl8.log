import numpy as np
import pandas as pd
import importlib.util, sys
spec = importlib.util.spec_from_file_location("common", "scripts/miner_3_20260730_common.py")
common = importlib.util.module_from_spec(spec); spec.loader.exec_module(common)

data = common.load_data(days=3200)
closes = {a: d["close"].astype(float) for a, d in data.items()}
vols = {a: d["volume"].astype(float) for a, d in data.items()}

fid = "vol_z_20"
factor_series = {a: (vols[a] - vols[a].rolling(20).mean()) / vols[a].rolling(20).std() for a in closes}
res = common.run_validation(
    factor_id=fid,
    factor_name="Volume Z-Score 20d (short-term volume pressure)",
    expression="(volume - volume.rolling(20).mean()) / volume.rolling(20).std()",
    description="Cross-sectional short-term volume anomaly: assets with recent 20d volume above/below their 20d average trend.",
    deps=["volume"], params={"lookback": 20},
    factor_series=factor_series, data=data,
    tags=["volume-dynamics", "short-horizon", "orthogonal-v2"],
    regime_notes="Screened cycle3 2026-07-30; vol_z_20 passed IC/ICIR gates with low library correlation "
                 "(spearman rho_yld=0.028, rho_vix=0.196, rho_mom=0.035). Need decay/turnover/regime confirmation.",
)
if res is None:
    print("REJECT: degenerate")
    sys.exit(1)
metrics, record = res
print("\n[record status]", record["validation"]["status"])
print("[metrics]", json.dumps(metrics, default=str)[:800])
if record["validation"]["status"] == "EFFECTIVE":
    path = common.persist_factor(record, factor_series)
    print("PERSISTED:", path)
else:
    print("NOT persisted (expected status EFFECTIVE)")
