from miner_3_20260730_common import load_data, run_validation

N = 60


def kaufman_eff(close, n=N):
    direction = (close - close.shift(n)).abs()
    path = close.diff().abs().rolling(n).sum()
    er = direction / path.replace(0, np.nan)
    return er


