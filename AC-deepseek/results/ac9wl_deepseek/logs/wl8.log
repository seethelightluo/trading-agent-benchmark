# Composite ensemble rank (decision date 2026-07-29)
import json, base64, zlib, io, csv
import numpy as np

def load_panel(path):
    d = json.load(open(path))
    sa = d['validation']['signal_artifact']
    txt = zlib.decompress(base64.b64decode(sa['data'])).decode()
    rows = list(csv.reader(io.StringIO(txt)))
    cols = rows[0][1:]
    dates = [r[0] for r in rows[1:]]
    mat = np.array([[float(x) if x not in ('','nan') else np.nan for x in r[1:]] for r in rows[1:]])
    return cols, dates, mat

ens = json.load(open('factors/factor_ensemble.json'))
assets = ['000300.SH','000688.SH','BTC','CN10Y','COPPER','ETH','HSI','N225','NDX','SOX','SPX','SX5E','US10Y','WTI','XAU']

scores = np.zeros(len(assets))
wsum = 0
for f in ens['selected_factors']:
    cols, dates, mat = load_panel(f'factors/{f["factor_id"]}.json')
    i = dates.index('2026-07-29')
    row = mat[i]
    # rank-normalize cross-sectionally (median rank fill if missing)
    ranks = np.full(len(assets), np.nan)
    for j, a in enumerate(assets):
        ranks[j] = row[cols.index(a)]
    # rank
    ranks = np.argsort(np.argsort(ranks))  # 0..14
    z = (ranks - ranks.mean()) / (ranks.std() + 1e-12)
    scores += f['weight'] * f['direction'] * z
    wsum += f['weight']

print("Composite score (higher = more preferred), decision date 2026-07-29:")
for a, s in sorted(zip(assets, scores), key=lambda x: -x[1]):
    print(f"  {a:<10} {s:>+.3f}")
