print('ri len', len(ri), 'rx2 len', len(rx2), 'rx2 nan', rx2.isna().sum())
try:
    cov = ri.rolling(60).cov(rx2)
    var = rx2.rolling(60).var().replace(0, np.nan)
    beta = (cov/var).replace([np.inf,-np.inf],np.nan)
    print('beta valid', beta.notna().sum(), 'tail beta', beta.dropna().tail(3).values)
except Exception as e:
    import traceback; traceback.print_exc()
