def print_result(name, res):
    print(f"\n=== {name} ===")
    for k in ["ic", "icir", "ic_hit_ratio", "n_ic_dates", "coverage_asset_days",
              "coverage_dates_ge8", "turnover_10d_rank"]:
        print(f"  {k}: {res[k]}")
    print(f"  decay_ic_by_horizon: {res['decay_ic_by_horizon']}")
    ok = abs(res["ic"]) >= IC_GATE and abs(res["icir"]) >= ICIR_GATE
    print(f"  GATE (|IC|>={IC_GATE}, |ICIR|>={ICIR_GATE}): {'PASS' if ok else 'FAIL'}")

===== artifact_b64
def artifact_b64(panel):
    csv_text = panel.to_csv()
    compressed = zlib.compress(csv_text.encode())
    return base64.b64encode(compressed).decode()

===== dense_per_asset
def dense_per_asset(close, vol, open_, high, low):
    """Return dict of per-asset dense frames (own trading calendar)."""
    dense = {}
    for a in ASSETS:
        idx = close[a].dropna().index
        dense[a] = {
            "close": close[a].reindex(idx),
            "vol": None if vol is None else vol[a].reindex(idx),
            "open": None if open_ is None else open_[a].reindex(idx),
            "high": None if high is None else high[a].reindex(idx),
            "low": None if low is None else low[a].reindex(idx),
        }
    return dense

