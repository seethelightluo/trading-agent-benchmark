    print(f"  decay_ic_by_horizon: {res['decay_ic_by_horizon']}")
    ok = abs(res["ic"]) >= IC_GATE and abs(res["icir"]) >= ICIR_GATE
    print(f"  GATE (|IC|>={IC_GATE}, |ICIR|>={ICIR_GATE}): {'PASS' if ok else 'FAIL'}")

