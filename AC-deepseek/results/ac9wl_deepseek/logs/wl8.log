    print(f"[verify] {fid}: status={st} ic={m['ic']:.4f}(>={IC_GATE}:{ok_ic}) "
          f"icir={m['icir']:.4f}(>={ICIR_GATE}:{ok_icir}) artifact_shape={p.shape} ok={shape_ok} "
