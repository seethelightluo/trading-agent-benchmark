to the current 3-factor library (mom_10d_skip5, vix_beta_cond_60x20, yield_beta_cond_60x20).
"""
import sys, time, json, base64, zlib, io
import numpy as np
import pandas as pd

sys.path.insert(0, "scripts")
from factor_validation_lib import (
