def f_yield_beta_cond_60x20(c, v, o, h, l, m):
    us10 = close["US10Y"].reindex(c.index)
    r = c.pct_change()
    dx = us10.diff()
    varx = dx.rolling(60).var()
    cov = r.rolling(60).cov(dx)
    beta = cov / varx.replace(0, np.nan)
    move = (us10 / us10.shift(20) - 1.0)
    return beta * move

