<｜｜DSML｜｜parameter name="content" string="true">"""miner_2 2026-07-30 -- deep validation of dow_spread_60 (Batch C winner).

Checks:
1. Annual regime IC stability
2. Window sensitivity
3. Library (spearman & pearson) correlation with all 3 effective factors
4. Long-horizon persistence / decay
5. Per-asset decomposition (where does the signal come from)
"""
import sys
import json
import base64
import zlib
import io
import numpy as np
import pandas as pd
from scipy.stats import spearmanr

sys.path.insert(0, "scripts")
from factor_validation_lib import (load_closes, load_index, validate_factor,
                                   factor_panel, ic_series, fwd_returns,
                                   IC_GATE, ICIR_GATE, ASSETS)

close, vol, open_, high, low = load_closes()
macro = {
    "VIX": load_index("VIX"),
    "DXY": load_index("DXY"),
    "USDCNY": load_index("USDCNY"),
    "USDJPY": load_index("USDJPY"),
    "EURUSD": load_index("EURUSD"),
}
macro["US10Y"] = close["US10Y"].dropna()
macro["CN10Y"] = close["CN10Y"].dropna()
print(f"Panel {close.index[0].date()}..{close.index[-1].date()}, {len(close)} rows", flush=True)

EFFECTIVE = ["mom_10d_skip5", "vix_beta_cond_60x20", "yield_beta_cond_60x20"]


def decode(fid):
    d = json.load(open(f"factors/{fid}.json"))
    raw = base64.b64decode(d["validation"]["signal_artifact"]["data"])
    p = pd.read_csv(io.StringIO(zlib.decompress(raw).decode()), index_col=0, parse_dates=True)
    p.index = pd.DatetimeIndex(p.index)
    return d, p


lib = {}
for fid in EFFECTIVE:
    _, lib[fid] = decode(fid)


def f_dow_spread(c, v, o, h, l, m, win=60, min_weekdays=4):
    r = c.pct_change()
    df = pd.DataFrame({"r": r.values, "dow": r.index.dayofweek}).dropna()
    out = pd.Series(np.nan, index=r.index)
    for i in range(win, len(df)):
        w = df.iloc[i - win:i]
        g = w.groupby("dow")["r"].mean()
        if len(g) >= min_weekdays:
            out.iloc[i] = g.min() - g.max()
    return out.reindex(r.index)


def lib_corr(panel, method="spearman"):
    out = {}
    for fid, lp in lib.items():
        common = panel.index.intersection(lp.index)
        cols = [c for c in panel.columns if c in lp.columns]
        if len(common) < 30 or len(cols) < 3:
            out[fid] = np.nan
            continue
        a = panel.loc[common, cols].values.ravel()
        b = lp.loc[common, cols].values.ravel()
        m = np.isfinite(a) & np.isfinite(b)
        if m.sum() < 100:
            out[fid] = np.nan
            continue
        if method == "spearman":
            rho, _ = spearmanr(a[m], b[m])
        else:
            rho = float(np.corrcoef(a[m], b[m])[0, 1])
        out[fid] = abs(float(rho))
    return out


def regime_ic(panel, h=10):
    ic = ic_series(panel, fwd_returns(close, h))
    print(f"  regime IC h={h}:", flush=True)
    for rname, (a, b) in {
        "2020": ("2020-01-01", "2020-12-31"),
        "2021": ("2021-01-01", "2021-12-31"),
        "2022": ("2022-01-01", "2022-12-31"),
        "2023": ("2023-01-01", "2023-12-31"),
        "2024": ("2024-01-01", "2024-12-31"),
        "2025": ("2025-01-01", "2025-12-31"),
        "2026H1": ("2026-01-01", "2026-06-30"),
    }.items():
        sub = ic.loc[(ic.index >= a) & (ic.index <= b)]
        if len(sub):
            print(f"    {rname}: ic={sub.mean():+.4f} icstd={sub.std():.4f} icir={sub.mean()/sub.std() if sub.std()>0 else np.nan:+.3f} n={len(sub)}", flush=True)


def per_asset_ic(panel, h=10):
    fr = fwd_returns(close, h)
    out = {}
    for a in ASSETS:
        x = panel[a]
        y = fr[a]
        m = x.notna() & y.notna()
        if m.sum() > 50:
            out[a] = float(spearmanr(x[m], y[m])[0])
    return out


print("=" * 70, flush=True)
print("DEEP VAL: dow_spread_60", flush=True)
panel = factor_panel(f_dow_spread, close, vol, open_, high, low, macro, win=60)
res = validate_factor(f_dow_spread, close, vol, open_, high, low, macro, win=60)
print(f"  IC={res['ic']:+.4f} ICIR={res['icir']:+.4f} hit={res['ic_hit_ratio']:.3f} "
      f"n={res['n_ic_dates']} cov={res['coverage_asset_days']:.3f}/{res['coverage_dates_ge8']:.3f} "
      f"to={res['turnover_10d_rank']:.2f}", flush=True)
print(f"  decay={res['decay_ic_by_horizon']}", flush=True)
print("  library corr (spearman):", {k: (round(v,4) if np.isfinite(v) else None) for k, v in lib_corr(panel, "spearman").items()}, flush=True)
print("  library corr (pearson):", {k: (round(v,4) if np.isfinite(v) else None) for k, v in lib_corr(panel, "pearson").items()}, flush=True)
regime_ic(panel)
print("  per-asset IC:", {k: round(v,4) for k, v in sorted(per_asset_ic(panel).items(), key=lambda x: -abs(x[1]))}, flush=True)

print("\nWINDOW SENSITIVITY", flush=True)
for win in [40, 50, 70, 80, 90]:
    p2 = factor_panel(f_dow_spread, close, vol, open_, high, low, macro, win=win)
    r2 = validate_factor(f_dow_spread, close, vol, open_, high, low, macro, win=win)
    cs = lib_corr(p2, "spearman")
    max_s = max([v for v in cs.values() if np.isfinite(v)], default=0)
    ok = abs(r2["ic"]) >= IC_GATE and abs(r2["icir"]) >= ICIR_GATE and max_s < 0.5
    print(f"  win={win:3d}: IC={r2['ic']:+.4f} ICIR={r2['icir']:+.4f} n={r2['n_ic_dates']} "
          f"cov={r2['coverage_asset_days']:.3f} to={r2['turnover_10d_rank']:.2f} "
          f"maxRho_s={max_s:.3f} -> {'PASS' if ok else 'fail'}", flush=True)

print("\nsanity: no lookahead by construction (trailing window only)", flush=True)
print("done", flush=True)
