import numpy as np
import pandas as pd
from scipy.stats import spearmanr, pearsonr
from alphacrafter.sim.utils import get_stock_daily_data, get_account_dict

WATCH = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX",
