  ▶️ write_file({'file_path': 'scripts/miner_1_20260730_screen_factors.py', 'content': '"""miner_1 factor screening 2026-07-30.\nExplore candidate cross-asset factor families on the 15-instrument tradable universe.\nData used strictly <= 2026-07-29 (visible through previous completed trading day).\nMethodology: per-date cross-sectional Spearman rank IC of factor vs H-day forward return,\nmin 8 valid instruments per date; ICIR = mean/std of daily IC; decay over horizons.\n"""\nimport json, base64, zlib, io\nimport numpy as np\nimport pandas as pd\n\nEND = "2026-07-29"\nASSETS = ["000300.SH", "000688.SH", "BTC", "CN10Y", "COPPER", "ETH", "HSI", "N225",\n          "NDX", "SOX", "SPX", "SX5E", "US10Y", "WTI", "XAU"]\nH = 10          # admission horizon (matches library standard)\nMIN_VALID = 8   # min assets for a valid cross-sectional IC observation\n\ndef load_close(assets, end=END):\n    closes = {}\n    for a in assets:\n        df = pd.read_csv(f"../persistent/stock_data/{a}.csv")\n        df["date"] = pd.to_datetime(df["date"])\n        df = df[df["date"] <= end]\n        closes[a] = df.set_index("date")["close"].astype(float)\n    return pd.DataFrame(closes)  # union of dates, NaN where asset has no data\n\ndef load_index(name, end=END):\n    df = pd.read_csv(f"../persistent/index_data/{name}.csv")\n    df["date"] = pd.to_datetime(df["date"])\n    df = df[df["date"] <= end]\n    return df.set_index("date")["close"].astype(float)\n\nclose = load_close(ASSETS)\nvix = load_index("VIX")\ndxy = load_index("DXY")\nusdjpy = load_index("USDJPY")\neurusd = load_index("EURUSD")\nusdcny = load_index("USDCNY")\n\ndef ret(p, n):\n    return p / p.shift(n) - 1.0\n\ndef roll_std(p, n):\n    return p.pct_change().rolling(n).std()\n\ndef roll_skew(p, n):\n    return p.pct_change().rolling(n).skew()\n\ndef roll_kurt(p, n):\n    return p.pct_change().rolling(n).kurt()\n\ndef rolling_beta(y, x, n):\n    yv = y.pct_change(); xv = x.pct_change()\n    joined = pd.concat([yv, xv], axis=1)\n    return joined[0].rolling(n).corr(joined[1]) * (joined[1].rolling(n).std() / joined[0].rolling(n).std().replace(0, np.nan))\n\n# ---------------- candidate factor definitions ----------------\nFACTORS = {\n    "rev_3d": lambda: -ret(close, 3),\n    "rev_5d": lambda: -ret(close, 5),\n    "dist_high_120": lambda: close / close.rolling(120).max() - 1.0,\n    "dist_high_60": lambda: close / close.rolling(60).max() - 1.0,\n    "mom_30d": lambda: ret(close, 30),\n    "mom_rv_60x20": lambda: ret(close, 60) / roll_std(close, 20).clip(lower=1e-6),\n    "vol_term_10x60": lambda: roll_std(close, 10) / roll_std(close, 60).clip(lower=1e-9) - 1.0,\n    "downside_vol_60": lambda: -close.pct_change().clip(upper=0).rolling(60).std(),\n    "skew_60": lambda: roll_skew(close, 60),\n    "skew_20": lambda: roll_skew(close, 20),\n    "eff_ratio_20": lambda: (close - close.shift(20)).abs() / close.pct_change().abs().rolling(20).sum().clip(lower=1e-9),\n    "beta_spx_60": lambda: rolling_beta(close, close["SPX"], 60),\n    "dxy_cond_60x20": lambda: -rolling_beta(close, dxy, 60) * (dxy / dxy.shift(20) - 1.0),\n    "vix_cond_mom_20x20": lambda: ret(close, 20) * (vix / vix.shift(20) - 1.0).reindex(close.index),\n    "sma_dev_20": lambda: (close - close.rolling(20).mean()) / close.rolling(20).mean(),\n    "kurt_60": lambda: roll_kurt(close, 60),\n    "jpy_cond_60x20": lambda: -rolling_beta(close, usdjpy, 60) * (usdjpy / usdjpy.shift(20) - 1.0),\n}\n\ndef forward_return(p, h):\n    return p.shift(-h) / p - 1.0\n\ndef validate(fp, h=H, min_valid=MIN_VALID):\n    fwd = forward_return(close, h)\n    dates = fp.index\n    ics, valid_n = [], []\n    for t in dates:\n        f = fp.loc[t]; r = fwd.loc[t]\n        mask = f.notna() & r.notna()\n        n = int(mask.sum())\n        if n < min_valid:\n            continue\n        ic = f[mask].rank().corr(r[mask].rank())\n        if np.isfinite(ic):\n            ics.append(ic); valid_n.append(n)\n    ics = np.array(ics)\n    ic = ics.mean(); icir = ic / ics.std(ddof=1) if len(ics) > 2 else np.nan\n    hit = float((ics > 0).mean())\n    # coverage\n    total_cells = len(fp.index) * fp.shape[1]\n    cov_asset = float(fp.notna().sum().sum()) / total_cells\n    ge8 = sum(1 for t in dates if (fp.loc[t].notna().sum()) >= min_valid) / max(1, len(dates))\n    # rank turnover over horizon h (mean abs rank delta normalized)\n    rk = fp.rank(axis=1)\n    rk_lag = rk.shift(h)\n    turn = float((rk - rk_lag).abs().mean().mean()) if len(fp) > h else np.nan\n    # decay\n    decay = {}\n    for hh in [1, 2, 3, 5, 10, 20]:\n        ics_h = []\n        fwd_h = forward_return(close, hh)\n        for t in fp.index:\n            f = fp.loc[t]; r = fwd_h.loc[t]\n            mask = f.notna() & r.notna()\n            if mask.sum() < min_valid: continue\n            ic_h = f[mask].rank().corr(r[mask].rank())\n            if np.isfinite(ic_h): ics_h.append(ic_h)\n        decay[str(hh)] = float(np.mean(ics_h)) if ics_h else np.nan\n    return {"ic": float(ic), "icir": float(icir) if np.isfinite(icir) else np.nan,\n            "ic_hit_ratio": float(hit), "n_ic_dates": len(ics),\n            "coverage_asset_days": cov_asset, "coverage_dates_ge8": ge8,\n            "turnover_10d_rank": turn, "decay_ic_by_horizon": decay}\n\n# ---------------- library factor panels (decode artifacts) ----------------\ndef load_library_panel(fname):\n    d = json.load(open(f"factors/{fname}.json"))\n    art = d["validation"]["signal_artifact"]\n    csv = zlib.decompress(base64.b64decode(art["data"])).decode()\n    p = pd.read_csv(io.StringIO(csv), index_col=0)\n    p.index = pd.to_datetime(p.index)\n    return p\n\nlib_names = ["mom_10d_skip5", "mom_120d_skip5", "vix_beta_cond_60x20", "vol_of_vol20x60"]\nlib_panels = {n: load_library_panel(n) for n in lib_names}\n\ndef lib_corr(fp):\n    out = {}\n    for n, lp in lib_panels.items():\n        lp_r = lp.reindex(fp.index)\n        both = fp.notna() & lp_r.notna()\n        cols = both.sum()\n        corrs = []\n        for c in fp.columns:\n            if cols[c] >= 200:\n                corrs.append(np.corrcoef(fp[c][both[c]], lp_r[c][both[c]])[0, 1])\n        out[n] = float(np.max(np.abs(corrs))) if corrs else np.nan\n    return out\n\n# ---------------- run screening ----------------\nprint(f"Data window: {close.index.min().date()} -> {close.index.max().date()} | panel rows: {len(close)}")\nprint(f"Universe: {len(ASSETS)} assets | admission horizon H={H} | min_valid={MIN_VALID}\\n")\nrows = []\nfor name, fn in FACTORS.items():\n    try:\n        fp = fn()\n        m = validate(fp)\n        corr = lib_corr(fp)\n        m["max_abs_library_correlation"] = max(corr.values()) if corr else np.nan\n        m["lib_corr_detail"] = {k: round(v, 3) for k, v in corr.items()}\n        rows.append((name, m))\n        gate = "PASS" if (abs(m["ic"]) >= 0.007 and abs(m["icir"]) >= 0.084) else "fail"\n        print(f"[{gate}] {name:22s} IC={m[\'ic\']:+.4f} ICIR={m[\'icir\']:+.4f} hit={m[\'ic_hit_ratio\']:.3f} "\n              f"n={m[\'n_ic_dates\']:4d} cov={m[\'coverage_asset_days\']:.3f} ge8={m[\'coverage_dates_ge8\']:.3f} "\n              f"turn={m[\'turnover_10d_rank\']:.2f} maxLibCorr={m[\'max_abs_library_correlation\']:.3f}")\n        print(f"         decay={ {k: round(v,4) for k,v in m[\'decay_ic_by_horizon\'].items()} }")\n        print(f"         libCorr={m[\'lib_corr_detail\']}")\n    except Exception as e:\n        print(f"[ERROR] {name}: {e}")\nprint("\\nDone.")\n'})
