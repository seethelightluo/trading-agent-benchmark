n# C. trend persistence / autocorrelation\ndef f_autocorr_20(c, v, o, h, l, m):\n    r = c.pct_change()\n    return r.rolling(20).apply(lambda x: np.corrcoef(x[:-1], x[1:])[0, 1] if len(x) > 3 else np.nan, raw=True)\ncands["autocorr_20"] = f_autocorr_20\n\ndef f_gain_loss_20(c, v, o, h, l, m):\n    r = c.pct_change()\n    pos = r.clip(lower=0).rolling(20).mean()\n    neg = (-r.clip(upper=0)).rolling(20).mean()\n    return pos / neg.replace(0, np.nan)\ncands["gain_loss_20"] = f_gain_loss_20\n\ndef f_skew_20(c, v, o, h, l, m):\n    return c.pct_change().rolling(20).skew()\ncands["skew_20"] = f_skew_20\n\ndef f_vol_adj_mom_20(c, v, o, h, l, m):\n    return (c / c.shift(20) - 1.0) / rv(c, 20)\ncands["vol_adj_mom_20"] = f_vol_adj_mom_20\n\ndef f_vol_adj_mom_60(c, v, o, h, l, m):\n    return (c / c.shift(60) - 1.0) / rv(c, 60)\ncands["vol_adj_mom_60"] = f_vol_adj_mom_60\n\n# D. volume dynamics\ndef f_vol_trend_5x60(c, v, o, h, l, m):\n    if v is None:\n        return pd.Series(np.nan, index=c.index)\n    return v.rolling(5).mean() / v.rolling(60).mean() - 1.0\ncands["vol_trend_5x60"] = f_vol_trend_5x60\n\ndef f_pv_corr_20(c, v, o, h, l, m):\n    if v is None:\n        return pd.Series(np.nan, index=c.index)\n    r = c.pct_change()\n    return r.rolling(20).corr(v.pct_change())\ncands["pv_corr_20"] = f_pv_corr_20\n\n# E. intraday / overnight structure\ndef f_oc_ratio_20(c, v, o, h, l, m):\n    intra = (o - c).abs()\n    over = (c - c.shift(1)).abs()\n    return intra.rolling(20).mean() / over.rolling(20).mean()\ncands["oc_ratio_20"] = f_oc_ratio_20\n\ndef f_body_ratio_60(c, v, o, h, l, m):\n    body = (c - o).abs()\n    rng = (h - l)\n    return body.rolling(60).mean() / rng.rolling(60).mean()\ncands["body_ratio_60"] = f_body_ratio_60\n\ndef f_upper_shadow_20(c, v, o, h, l, m):\n    upper = (h - np.maximum(o, c))\n    rng = (h - l)\n    return (upper / rng.replace(0, np.nan)).rolling(20).mean()\ncands["upper_shadow_20"] = f_upper_shadow_20\n\n# F. short-term reversal / microstructure\ndef f_rev_1d(c, v, o, h, l, m):\n    return -(c.pct_change())\ncands["rev_1d"] = f_rev_1d\n\ndef f_rev_3d_skip1(c, v, o, h, l, m):\n    return -(c.shift(1) / c.shift(4) - 1.0)\ncands["rev_3d_skip1"] = f_rev_3d_skip1\n\n# G. conditional rate beta on CN10Y (orthogonal to US10Y-based yield factor)\ndef f_cn10y_beta_cond_60x20(c, v, o, h, l, m):\n    cs = _reindex_macro(c, m["CN10Y"])\n    b = _beta(c.pct_change(), cs.pct_change(), 60)\n    return b * (cs / cs.shift(20) - 1.0)\ncands["cn10y_beta_cond_60x20"] = f_cn10y_beta_cond_60x20\n\n# H. cross-sectional dispersion (each asset vs its own 10d group)\ndef f_rel_mom_10(c, v, o, h, l, m):\n    return c.shift(1) / c.shift(11) - 1.0\ncands["rel_mom_10_skip1"] = f_rel_mom_10\n\nprint(f"{len(cands)} candidates defined", flush=True)\n\n# ---------------- run ----------------\nrows = []\nfor name, fn in cands.items():\n    try:\n        panel = factor_panel(fn, close, vol, open_, high, low, macro)\n    except Exception as e:\n        print(f"{name}: ERROR {e}", flush=True)\n        continue\n    cov_ad, cov_ge8 = coverage(panel)\n    if cov_ge8 < 0.05:\n        print(f"{name}: skip low coverage ge8={cov_ge8:.3f}", flush=True)\n        continue\n    icm = ic_series(panel, fwd[10])\n    ic = float(icm.mean()) if len(icm) else np.nan\n    icir = float(icm.mean() / icm.std()) if len(icm) > 2 else np.nan\n    hit = float((icm > 0).mean()) if np.isfinite(ic) else np.nan\n    if ic < 0:\n        hit = float((icm < 0).mean())\n    decay = {str(h): round(float(ic_series(panel, fwd[h]).mean()), 4) if len(ic_series(panel, fwd[h])) else np.nan for h in H}\n    to = turnover_rank(panel)\n    lc = lib_corr(panel)\n    gate = abs(ic) >= IC_GATE and abs(icir) >= ICIR_GATE\n    rows.append((name, ic, icir, hit, len(icm), cov_ad, cov_ge8, to, lc, gate, decay))\n    print(f"{name:28s} ic={ic: .4f} icir={icir: .4f} hit={hit:.3f} n={len(icm):4d} "\n          f"cov={cov_ad:.3f}/{cov_ge8:.2f} to={to:.2f} libcorr={lc:.3f} "\n          f