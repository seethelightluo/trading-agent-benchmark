 art.index[-1].date(), \'| max abs diff @\', END, \':\', float(diff.abs().max()) if len(diff) else \'NA\', \'| n finite:\', lrow.notna().sum())\n    print(\'  sample:\', {a: (round(float(arow[a]),4), round(float(lrow[a]),4)) for a in ASSETS[:5] if pd.notna(arow[a]) and pd.notna(lrow[a])})\n"'})
