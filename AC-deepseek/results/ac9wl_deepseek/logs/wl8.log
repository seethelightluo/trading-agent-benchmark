    p.index = pd.DatetimeIndex(p.index)
    LIB[fid] = p

def pairwise_spearman(A, B):
    common = A.index.intersection(B.index)
    cols = [c for c in A.columns if c in B.columns]
    a = A.loc[common, cols].rank()
    b = B.loc[common, cols].rank()
    aa = a.values.ravel()
    bb = b.values.ravel()
    m = np.isfinite(aa) & np.isfinite(bb)
    if m.sum() < 300:
        return None
    return float(np.corrcoef(aa[m], bb[m])[0, 1])

all_fids = list(C.keys()) + list(LIB.keys())
print("=== pairwise Spearman matrix ===")
print(f"{'':18s}", end="")
for fid in all_fids:
    print(f"{fid[:16]:>17s}", end="")
print()
mat = {}
for i, fa in enumerate(all_fids):
    row = []
    print(f"{fa[:18]:<18s}", end="")
    pa = C.get(fa) or LIB[fa]
    for fb in all_fids:
        if fa == fb:
            rho = 1.0
        else:
            pb = C.get(fb) or LIB[fb]
            rho = pairwise_spearman(pa, pb)
            rho = round(rho, 3) if rho is not None else np.nan
        row.append(rho)
        print(f"{rho:>17.3f}", end="")
    mat[fa] = row
    print()

# quality computation
def quality(ic, icir, n):
    return abs(ic) * abs(icir) * min(1.0, n / 500.0)

# per-year IC for key candidates
print("\n=== per-year IC (10d horizon) for candidates ===")

def fwd_returns(horizon):
    out = {}
    for a in ASSETS:
        c = closes[a].dropna()
        out[a] = (c.shift(-horizon) / c - 1.0).reindex(close.index)
    return pd.DataFrame(out)

fr10 = fwd_returns(10)

def ic_series(factor, fwd=fr10):
    dates, ics = [], []
    for dt in factor.index:
        if dt > SIGNAL_END:
            continue
        x, y = factor.loc[dt], fwd.loc[dt]
        m = x.notna() & y.notna()
        if m.sum() >= MIN_ASSETS_PER_DATE:
            ics.append(x[m].rank().corr(y[m].rank()))
            dates.append(dt)
    return pd.Series(ics, index=pd.DatetimeIndex(dates))

for fid in C:
    ic = ic_series(C[fid])
    yrs = {}
    for y in range(2021, 2027):
        sub = ic[ic.index.year == y]
        yrs[str(y)] = round(float(sub.mean()), 4) if len(sub) > 10 else None
    full_ic = float(ic.mean())
    icir = float(ic.mean() / ic.std()) if len(ic) > 2 else np.nan
    q = quality(full_ic, icir, len(ic))
    print(f"{fid}: n={len(ic)} ic={round(full_ic,4)} icir={round(icir,4)} q={round(q,6)} years={yrs}")
