        beta_y = r.rolling(60).cov(yr) / yr.rolling(60).var()
        lib.setdefault("yield_beta_cond_60x20", {})[a] = -beta_y * (us10 / us10.shift(20) - 1.0)
    return lib


LIB = full_library()
