1 """miner_1 factor screening 2026-07-30 (vectorized).
2 Explore candidate cross-asset factor families on the 15-instrument tradable universe.
3 Data used strictly <= 2026-07-29 (visible through previous completed trading day).
4 Methodology: per-date cross-sectional Spearman rank IC of factor vs H-day forward return,
5 min 8 valid instruments per date; ICIR = mean/std of daily IC; decay over horizons.
6 """
7 import json, base64, zlib, io, sys
8 import numpy as np
9 import pandas as pd
10 
11 END = "2026-07-29"
12 ASSETS = ["000300.SH", "000688.SH", "BTC", "CN10Y", "COPPER", "ETH", "HSI", "N225",
13           "NDX", "SOX", "SPX", "SX5E", "US10Y", "WTI", "XAU"]
14 H = 10
15 MIN_VALID = 8
16 
17 def load_close(assets, end=END):
18     closes = {}
19     for a in assets:
20         df = pd.read_csv(f"../persistent/stock_data/{a}.csv")
21         df["date"] = pd.to_datetime(df["date"])
22         df = df[df["date"] <= end]
23         closes[a] = df.set_index("date")["close"].astype(float)
24     return pd.DataFrame(closes)
25 
26 def load_index(name, end=END):
27     df = pd.read_csv(f"../persistent/index_data/{name}.csv")
28     df["date"] = pd.to_datetime(df["date"])
29     df = df[df["date"] <= end]
30     return df.set_index("date")["close"].astype(float)
31 
32 close = load_close(ASSETS)
33 vix = load_index("VIX"); dxy = load_index("DXY")
34 usdjpy = load_index("USDJPY"); eurusd = load_index("EURUSD"); usdcny = load_index("USDCNY")
35 vixr = vix.pct_change(); dxy_r = dxy.pct_change(); jpy_r = usdjpy.pct_change()
36 
37 def ret(p, n): return p / p.shift(n) - 1.0
38 def roll_std(p, n): return p.pct_change().rolling(n).std()
39 def roll_skew(p, n): return p.pct_change().rolling(n).skew()
40 def roll_kurt(p, n): return p.pct_change().rolling(n).kurt()
41 def rolling_beta(y, xr, n):
42     yv = y.pct_change()
43     xv = xr.reindex(y.index)
44     varx = xv.rolling(n).var()
45     cov = yv.rolling(n).cov(xv)
46     return cov / varx.replace(0, np.nan)
47 
48 # ---------------- candidate factor definitions ----------------
49 FACTORS = {
50     "rev_3d": lambda: -ret(close, 3),
51     "rev_5d": lambda: -ret(close, 5),
52     "dist_high_120": lambda: close / close.rolling(120).max() - 1.0,
53     "dist_high_60": lambda: close / close.rolling(60).max() - 1.0,
54     "mom_30d": lambda: ret(close, 30),
55     "mom_rv_60x20": lambda: ret(close, 60) / roll_std(close, 20).clip(lower=1e-6),
56     "vol_term_10x60": lambda: roll_std(close, 10) / roll_std(close, 60).clip(lower=1e-9) - 1.0,
57     "downside_vol_60": lambda: -close.pct_change().clip(upper=0).rolling(60).std(),
58     "skew_60": lambda: roll_skew(close, 60),
59     "skew_20": lambda: roll_skew(close, 20),
60     "eff_ratio_20": lambda: (close - close.shift(20)).abs() / close.pct_change().abs().rolling(20).sum().clip(lower=1e-9),
61     "beta_spx_60": lambda: rolling_beta(close, close["SPX"].pct_change(), 60),
62     "dxy_cond_60x20": lambda: -rolling_beta(close, dxy_r, 60) * (dxy / dxy.shift(20) - 1.0).reindex(close.index),
63     "vix_cond_mom_20x20": lambda: ret(close, 20) * (vix / vix.shift(20) - 1.0).reindex(close.index),
64     "sma_dev_20": lambda: (close - close.rolling(20).mean()) / close.rolling(20).mean(),
65     "kurt_60": lambda: roll_kurt(close, 60),
66     "jpy_cond_60x20": lambda: -rolling_beta(close, jpy_r, 60) * (usdjpy / usdjpy.shift(20) - 1.0).reindex(close.index),
67     "eur_cond_60x20": lambda: -rolling_beta(close, eurusd.pct_change(), 60) * (eurusd / eurusd.shift(20) - 1.0).reindex(close.index),
68     "cny_cond_60x20": lambda: -rolling_beta(close, usdcny.pct_change(), 60) * (usdcny / usdcny.shift(20) - 1.0).reindex(close.index),
69 }
70 
71 # precompute forward return matrices for horizons
72 HORIZONS = [1, 3, 5, 10, 20]
73 FWD = {hh: (close.shift(-hh) / close - 1.0).values for hh in HORIZONS}
74 
75 def ic_series(fp_ranked, fwd_mat):
76     """Vectorized per-date Spearman IC between ranked factor panel and fwd return matrix."""
77     m = np.isfinite(fp_ranked) & np.isfinite(fwd_mat)
78     n = m.sum(axis=1)
79     f = np.where(m, fp_ranked, 0.0); r = np.where(m, fwd_mat, 0.0)
80     mf = f.sum(axis=1) / np.maximum(n, 1); mr = r.sum(axis=1) / np.maximum(n, 1)
81     fc = f - mf[:, None] * m; rc = r - mr[:, None] * m
82     cov = (fc * rc).sum(axis=1)
83     vf = (fc * fc).sum(axis=1); vr = (rc * rc).sum(axis=1)
84     denom = np.sqrt(vf * vr)
85     ics = np.where((n >= MIN_VALID) & (denom > 1e-14), cov / np.where(denom > 1e-14, denom, 1.0), np.nan)
86     return ics, n
87 
88 def validate(fp):
89     rk = fp.rank(axis=1).values
90     ics, n = ic_series(rk, FWD[H])
91     valid = np.isfinite(ics)
92     ics_v = ics[valid]
93     ic = float(ics_v.mean()); icir = float(ics_v.mean() / ics_v.std(ddof=1)) if len(ics_v) > 2 else np.nan
94     hit = float((ics_v > 0).mean())
95     total_cells = fp.shape[0] * fp.shape[1]
96     cov_asset = float(fp.notna().to_numpy().sum()) / total_cells
97     ge8 = float((fp.notna().sum(axis=1) >= MIN_VALID).mean())
98     rkf = fp.rank(axis=1)
99     turn = float((rkf - rkf.shift(H)).abs().mean().mean())
100     decay = {}
101     for hh in HORIZONS:
102         ics_h, _ = ic_series(rk, FWD[hh])
103         v = ics_h[np.isfinite(ics_h)]
104         decay[str(hh)] = float(v.mean()) if len(v) else np.nan
105     return {"ic": ic, "icir": icir, "ic_hit_ratio": hit,
106             "n_ic_dates": int(valid.sum()), "coverage_asset_days": cov_asset,
107             "coverage_dates_ge8": ge8, "turnover_10d_rank": turn,
108             "decay_ic_by_horizon": decay}
