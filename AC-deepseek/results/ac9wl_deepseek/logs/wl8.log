  ▶️ shell({'command': 'python - <<\'EOF\'\nimport json, base64, zlib, io\nimport numpy as np\nimport pandas as pd\nfrom scipy.stats import spearmanr\n\nEND = "2026-07-29"\nASSETS = ["000300.SH","000688.SH","SPX","NDX","SOX","HSI","N225","SX5E",\n          "XAU","COPPER","WTI","BTC","ETH","US10Y","CN10Y"]\nFACTORS = ["mom_10d_skip5","vix_beta_cond_60x20","yield_beta_cond_60x20"]\n\ncloses = {}\nfor a in ASSETS:\n    df = pd.read_csv(f"../persistent/stock_data/{a}.csv")\n    df["date"] = pd.to_datetime(df["date"])\n    df = df[df["date"] <= END].set_index("date")\n    closes[a] = df["close"].astype(float)\nclose = pd.DataFrame(closes)\n\ndef lib_panel(fname):\n    d = json.load(open(f"factors/{fname}.json"))\n    art = d["validation"]["signal_artifact"]\n    csv = zlib.decompress(base64.b64decode(art["data"])).decode()\n    p = pd.read_csv(io.StringIO(csv), index_col=0)\n    p.index = pd.to_datetime(p.index)\n    return p\n\npanels = {f: lib_panel(f) for f in FACTORS}\n\ndef rank_ic(fdf, close, h=10, min_assets=8, start=None):\n    fwd = close.shift(-h) / close - 1.0\n    common = fdf.index.intersection(fwd.index)\n    if start:\n        common = common[common >= pd.Timestamp(start)]\n    ics = []\n    for d in common:\n        f = fdf.loc[d].dropna(); r = fwd.loc[d].dropna()\n        both = f.index.intersection(r.index)\n        if len(both) >= min_assets:\n            ic = spearmanr(f[both], r[both])[0]\n            if np.isfinite(ic):\n                ics.append(ic)\n    if len(ics) < 5:\n        return None\n    a = np.array(ics)\n    return dict(n=len(a), ic=float(a.mean()),\n                icir=float(a.mean()/a.std(ddof=1)) if len(a) > 2 else 0.0,\n                hit=float((a > 0).mean()))\n\n# ---- persisted metrics ----\nmeta = {}\nfor f in FACTORS:\n    d = json.load(open(f"factors/{f}.json"))\n    m = d["validation"]["metrics"]\n    meta[f] = dict(ic=m["ic"], icir=m["icir"], n=m["n_ic_dates"],\n                   cov=m["coverage_asset_days"], to=m["turnover_10d_rank"],\n                   expected_direction=d.get("expected_direction", 1))\n\n# ---- recent revalidation (3m / 6m / 1y) ----\nrecent = {}\nfor f in FACTORS:\n    r3  = rank_ic(panels[f], close, start="2026-04-30")\n    r6  = rank_ic(panels[f], close, start="2026-01-30")\n    r1y = rank_ic(panels[f], close, start="2025-07-30")\n    recent[f] = dict(three_m=r3, six_m=r6, one_y=r1y)\n    print(f"{f:22s} pers IC={meta[f][\'ic\']:+.4f} | 3m={r3[\'ic\'] if r3 else float(\'nan\'):+.4f} "\n          f"6m={r6[\'ic\'] if r6 else float(\'nan\'):+.4f} 1y={r1y[\'ic\'] if r1y else float(\'nan\'):+.4f}")\n\n# ---- stability multiplier ----\nSTAB = {}\nfor f in FACTORS:\n    pers_dir = np.sign(meta[f]["ic"])\n    agree = 0; checkable = 0\n    for k in ["three_m", "six_m", "one_y"]:\n        r = recent[f][k]\n        if r is not None:\n            checkable += 1\n            if np.sign(r["ic"]) == pers_dir:\n                agree += 1\n    if checkable == 0:\n        STAB[f] = (0.6, "no recent checkable IC dates; sparse/unverifiable live coverage")\n    elif agree == checkable:\n        STAB[f] = (1.0, "all recent windows aligned with persisted direction")\n    elif agree >= 1:\n        STAB[f] = (0.8, "mixed recent alignment")\n    else:\n        STAB[f] = (0.6, "all recent windows flipped vs persisted direction")\n\nprint("\\n=== quality_ic_tilt + stability overlay ===")\nrows = []\nfor f in FACTORS:\n    ic = meta[f]["ic"]; icir = meta[f]["icir"]; n = meta[f]["n"]\n    shrink = min(1.0, n / 500.0)\n    q_base = abs(ic) * abs(icir) * shrink\n    mult, why = STAB[f]\n    q = q_base * mult\n    rows.append(dict(factor_id=f, ic=ic, icir=icir, n=n, shrink=shrink,\n                     q_base=q_base, mult=mult, q=q,\n                     direction=1 if ic >= 0 else -1, stab_reason=why))\ntot = sum(r["q"] for r in rows)\nout = []\nfor r in rows:\n    w = r["q"] / tot\n    r["weight"] = w\n    out.append({"factor_id": r["factor_id"], "weight": round(w, 4), "direction": r["direction"]})\n    print("  %-22s IC=%+.4f ICIR=%+.4f n=%4d shrink=%.3f stab=%.2f -> w=%.4f dir=%+d" %\n          (r["factor_id"], r["ic"], r["icir"], r["n"], r["shrink"], r["mult"], w, r["direction"]))\nprint("sum(w) =", round(sum(r["weight"] for r in rows), 6))\n\nensemble = {\n    "schema_version": 1,\n    "selected_factors": out,\n    "method": "quality_ic_tilt_with_regime_stability_overlay",\n    "notes": {\n        "asof": "2026-07-30",\n        "quality_formula": "q = |IC| * |ICIR| * min(1, n_ic_dates/500); direction = sign(persisted IC); "\n                           "stability multiplier 0.6/0.8/1.0 from 3m+6m+1y revalidation IC sign agreement (fresh recompute through 2026-07-29)",\n        "library": {f: meta[f] for f in FACTORS},\n        "recent_revalidation": {\n            f: {k: (None if recent[f][k] is None else {"ic": round(recent[f][k]["ic"], 4),\n                                                       "icir": round(recent[f][k]["icir"], 4),\n                                                       "n": recent[f][k]["n"]})\n                for k in ["three_m", "six_m", "one_y"]}\n            for f in FACTORS},\n        "regime": ("mixed/corrective, HIGH cross-sectional dispersion, LOW cross-asset correlation; "\n                   "SPX +2.0% 1M resilient bull (7650, VIX 14.07 falling -14% 1M); HSI +15.9% 1M V-recovery; "\n                   "BTC +8.6% 1M recovering; CSI300 -16.8% 1M sharp bear leg; SOX -16.7% / ETH -17.6% / NDX -4.1% 1M "\n                   "tech-crypto correction; XAU -8.8% 1M / -21.6% 3M correction; WTI +9.0% 1M bounce after -22.8% 40d; "\n                   "US10Y 4.66 rising +5.0% 1M; DXY weak 99.7 (-1.6% 1M); vol pockets: SOX 44%, ETH 58%, WTI 53%, STAR50 51% ann."),\n        "risk_notes": {\n            "mom_10d_skip5": "TO_10d_rank=4.09 highest turnover -> expect larger rebalance migration (3bps on migrated notional); regime-favored primary, recent IC improving (3m +0.036, 6m +0.067, 1y +0.063), all aligned",\n            "vix_beta_cond_60x20": "ALL recent windows flipped vs persisted direction (3m IC +0.197 ICIR +0.67, 6m +0.024, 1y +0.011 vs persisted -0.038); falling-VIX regime (VIX 14.1, -23% 3m) likely invalidates the short-signal tilt; direction kept at persisted sign (full-sample n=1600), weight demoted 0.6; TRADER: watch live PnL attribution and regime (VIX spike would re-activate)",\n            "yield_beta_cond_60x20": "sparse evidence (n=49 IC dates, 14.6% asset-day coverage) and ZERO recent checkable IC dates (no date with >=8 assets in last year) -> unverifiable live; heavy evidence shrink + 0.6 stability demotion; keep small diversifying weight only",\n            "crowding": "max |pooled spearman rho| = 0.359 (mom vs yield), 0.125 (mom vs vix), 0.150 (vix vs yield); all < 0.5 gate; no redundancy within ensemble",\n            "library_gate_risk": "library concentrated at 3 factors; yield_beta_cond_60x20 remains the admission gate-keeper (candidates with rho>0.5 vs it evicted); no new miner submissions this cycle"\n        },\n        "evidence_note": ("mom_10d_skip5 is the regime-favored primary (monotone improving IC across 3m/6m/1y, "\n                          "hit ~0.54-0.56); vix_beta and yield_beta retained as diversifiers with demoted weights "\n                          "due to recent sign instability / sparse-unverifiable coverage respectively.")\n    }\n}\nwith open("factor_ensemble.json", "w") as fh:\n    json.dump(ensemble, fh, indent=2)\nwith open("factors/factor_ensemble.json", "w") as fh:\n    json.dump(ensemble, fh, indent=2)\nprint("\\n[wrote] factor_ensemble.json (root) + factors/factor_ensemble.json")\nEOF'})
