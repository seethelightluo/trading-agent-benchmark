"""miner_1: persist er20 (trend efficiency ratio) with real signal artifact."""
import numpy as np
import pandas as pd
import json, os

panel = pd.read_pickle('scripts/panel_cache.pkl')
close = panel['close']

idx_all = close.index[close.index.dayofweek < 5]
idx = idx_all[(idx_all >= pd.Timestamp('2020-01-01')) & (idx_all <= pd.Timestamp('2026-07-15'))]
VAL = idx[idx >= pd.Timestamp('2021-01-01')]
SYMS = list(close.columns)

C = close.reindex(idx).astype(float)
LR = np.log(C / C.shift(1))

# er20: |20d net return| / (sum |daily log returns| over 20d)
er20 = (C / C.shift(20) - 1.0).abs() / (LR.abs().rolling(20).sum() + 1e-12)

# ---- signal artifact on the FULL panel index/columns (2388 x 15) ----
art = er20.reindex(close.index).astype(np.float32)
np.save('factors/miner1_20260716_er20.npy', art.values)
print('artifact saved:', art.shape, art.values.dtype, 'finite:', int(np.isfinite(art.values).sum()))

