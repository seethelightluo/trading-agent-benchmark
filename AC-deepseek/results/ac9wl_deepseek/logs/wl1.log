123 cands["corr_xau_60"] = zscore_full(roll_corr(LRET, LRET["XAU"], 60).to_numpy(dtype=float))
124 cands["corr_wti_60"] = zscore_full(roll_corr(LRET, LRET["WTI"], 60).to_numpy(dtype=float))
125 btc_ret = LRET["BTC"]
126 _beta = pd.DataFrame(index=idx, columns=SYMS, dtype=float)
127 for _s in SYMS:
128     _beta[_s] = LRET[_s].rolling(60).cov(btc_ret) / (btc_ret.rolling(60).var() + 1e-12)
129 cands["beta_btc_60"] = zscore_full(_beta.to_numpy(dtype=float))
130 
131 # E. overnight / intraday share
132 gaps = O / C.shift(1) - 1.0
133 intra = C / O - 1.0
134 cands["on_share_20"] = (gaps.abs().rolling(20).sum() / (gaps.abs().rolling(20).sum() + intra.abs().rolling(20).sum() + 1e-12)).to_numpy(dtype=float)
135 cands["gap_cum_5_z"] = zscore_win(gaps.rolling(5).sum().to_numpy(dtype=float), 120, 40)
136 cands["gap_cum_20_z"] = zscore_win(gaps.rolling(20).sum().to_numpy(dtype=float), 250, 60)
137 
138 # F. robust RSI (2d and 5d) with coverage diagnostics
139 def rsi_robust(win):
140     up = RET.clip(lower=0).rolling(win).mean()
141     dn = (-RET.clip(upper=0)).rolling(win).mean()
142     rs = up / (dn + 1e-9)
143     r = 100 - 100 / (1 + rs)
144     return r
145 
146 cands["rsi_2"] = rsi_robust(2).to_numpy(dtype=float)
147 cands["rsi_5"] = rsi_robust(5).to_numpy(dtype=float)
148 
149 # G. 5d/10d return reversal, per-symbol z-scored (longer than library 1-3d)
150 cands["rev_5d_z"] = zscore_win(-(np.log(C) - np.log(C.shift(5))).to_numpy(dtype=float), 120, 40)
151 cands["rev_10d_z"] = zscore_win(-(np.log(C) - np.log(C.shift(10))).to_numpy(dtype=float), 250, 60)
152 
153 # H. momentum variants (skip recent to reduce correlation with mom_10d_skip5)
154 cands["mom_20_skip5_z"] = zscore_win((np.log(C.shift(5)) - np.log(C.shift(20))).to_numpy(dtype=float), 250, 60)
155 cands["mom_60_skip20_z"] = zscore_win((np.log(C.shift(20)) - np.log(C.shift(60))).to_numpy(dtype=float), 500, 120)
156 
157 # I. volume-conditioned reversal (coverage ~9/15; z-scored to decouple)
158 vol_ok = V > 0
159 vol_z = zscore_win(V.to_numpy(dtype=float), 120, 40)
160 cands["vol_cond_rev1"] = (-LRET * (vol_z > 0.5).astype(float)).to_numpy(dtype=float)
161 
162 # J. macro-conditioned intraday reversal (VIX high regime), z-scored
163 vix = panel["macro"]["VIX"]
164 vix_z = (vix - vix.rolling(120).mean()) / (vix.rolling(120).std() + 1e-12)
165 intra_rev = (1.0 - C / O)
166 cands["rev_intra_x_vixhi"] = zscore_win((intra_rev * (vix_z > 0.0).astype(float)).to_numpy(dtype=float), 120, 40)
167 
168 # K. vol level z (60d) - previously passed gates but rho high; try per-symbol z
169 cands["vol_z_60"] = zscore_win(LRET.rolling(60).std().to_numpy(dtype=float), 250, 60)
170 
171 
172 # ---------------- IC machinery ----------------
173 def ic_stats(fac_np, fwd=fwd1):
174     df = pd.DataFrame(fac_np, index=idx, columns=SYMS)
175     ev = df.loc[ev_idx]
176     fwd_ev = fwd.loc[ev_idx]
177     ics = []
178     for dt in ev.index:
179         f = ev.loc[dt].dropna()
180         r = fwd_ev.loc[dt].reindex(f.index).dropna()
181         common = f.index.intersection(r.index)
182         if len(common) < 8:
183             continue
184         x = f[common].astype(float).rank()
185         y = r[common].astype(float).rank()
186         if x.std() == 0 or y.std() == 0:
187             continue
188         ic = np.corrcoef(x, y)[0, 1]
189         if np.isfinite(ic):
190             ics.append(ic)
191     ics = np.array(ics)
192     if len(ics) == 0:
193         return None
194     sd = ics.std(ddof=1)
195     return dict(ic=float(ics.mean()),
196                 icir=float(ics.mean() / sd) if sd > 1e-12 else 0.0,
197                 hit=float((ics > 0).mean()), n=int(len(ics)), ics=ics)
198 
199 
200 rows = []
201 for name, fac in cands.items():
202     st = ic_stats(fac)
203     if st is None:
204         print(f"{name:20s} NO VALID IC")
205         continue
206     df = pd.DataFrame(fac, index=idx, columns=SYMS)
207     ev = df.loc[ev_idx]
