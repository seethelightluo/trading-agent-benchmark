lib["rev1_pk"] = -LRET / (pk20 + 1e-12)
ineff = (C / C.shift(20) - 1.0).abs() / (LRET.abs().rolling(20).sum() + 1e-12)
lib["rev1_x_inveff"] = LRET * (1 - ineff)
lib["id_rev_1d"] = -(C / O - 1.0)
lib["nbody_1d"] = -(C - O) / (H - L + 1e-12)
