18 import numpy as np
19 import pandas as pd
20 from scipy.stats import spearmanr
21 
22 EVAL_START = pd.Timestamp("2021-01-04")
23 END = pd.Timestamp("2026-07-15")
24 GATE_IC, GATE_ICIR = 0.0070, 0.0840
