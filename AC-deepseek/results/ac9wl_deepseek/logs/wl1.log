# ---------- D. downside vol ratio ----------
def downside_ratio(nd):
    dn = RET.clip(upper=0.0)
    dn_sd = (dn ** 2).rolling(nd).mean().apply(np.sqrt)
    tot_sd = RET.rolling(nd).std()
    return dn_sd / (tot_sd + 1e-12)

