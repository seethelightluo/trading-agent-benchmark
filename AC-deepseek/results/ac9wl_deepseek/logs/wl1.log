94 # B. volatility asymmetry / tail
95 pos = RET.where(RET > 0, 0.0)
96 neg = (-RET).where(RET < 0, 0.0)
97 cands["down_up_vol_20"] = (neg.rolling(20).std() / (pos.rolling(20).std() + 1e-12)).to_numpy(dtype=float)
98 std20 = LRET.rolling(20).std()
99 tail = (RET.abs() > 2 * std20).astype(float)
100 cands["tail_freq_60"] = tail.rolling(60).mean().to_numpy(dtype=float)
101 cands["skew_60_z"] = zscore_win(LRET.rolling(60).skew().to_numpy(dtype=float), 250, 60)
102 cands["kurt_60_z"] = zscore_win(LRET.rolling(60).kurt().to_numpy(dtype=float), 250, 60)
103 rng = (H - L) / C.shift(1)
104 rng_mean = rng.rolling(20).mean()
