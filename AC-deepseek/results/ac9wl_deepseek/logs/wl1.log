p.isfinite(a) & np.isfinite(b)\n    if m.sum() < 100: return np.nan\n    if a[m].std()==0 or b[m].std()==0: return np.nan\n    return float(np.corrcoef(a[m], b[m])[0,1])\n\nn = len(fids)\nC = np.full((n, n), np.nan)\nfor i in range(n):\n    for j in range(n):\n        C[i,j] = corr(panels[fids[i]], panels[fids[j]])\nprint("     " + "".join(f"{fids[j][:10]:>11s}" for j in range(n)))\nfor i in range(n):\n    print(f"{fids[i][:12]:>12s} " + "".join(f"{C[i,j]:>11.2f}" for j in range(n)))\n\n# recency: correlation on last 252 rows\nprint("\\nPairwise |corr| last-252d:")\nC2 = np.full((n, n), np.nan)\nfor i in range(n):\n    for j in range(n):\n        a = panels[fids[i]][-252:]; b = panels[fids[j]][-252:]\n        C2[i,j] = corr(a, b)\nprint("     " + "".join(f"{fids[j][:10]:>11s}" for j in range(n)))\nfor i in range(n):\n    print(f"{fids[i][:12]:>12s} " + "".join(f"{C2[i,j]:>11.2f}" for j in range(n)))\nEOF'})
