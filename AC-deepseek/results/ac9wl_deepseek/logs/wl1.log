nt(f"{nm:16s} decay={ {k: v for k, v in extra[nm][\'decay\'].items() if k in (1,2,3,5,10)} }")\n    print(f"{\'\':16s} by_year={yr}")\n\nprint(f"\\ndone {time.time()-t0:.1f}s")\n', 'file_path': 'scripts/miner2_20260716_deep_validate_cycle2.py'})
