0 """Trader: compute the 14 library factors on the panel and inspect cross-correlations."""
1 import numpy as np
2 import pandas as pd
3 from scipy.stats import spearmanr
4 from alphacrafter.sim.utils import get_stock_daily_data, get_account_dict
5 
6 acc = get_account_dict()
7 assets = acc["watch_list"]
8 N = 140
9 frames = {}
10 for a in assets:
11     df = get_stock_daily_data(a, days=N)
12     if df is not None and len(df) >= 80:
13         frames[a] = df.sort_values("date").reset_index(drop=True)
14 
15 # align on common dates
16 dates = None
17 for a, df in frames.items():
18     s = set(df["date"].astype(str))
19     dates = s if dates is None else dates & s
20 dates = sorted(dates)
21 print("common dates:", len(dates))
22 
23 px = {a: df.set_index(df["date"].astype(str)).reindex(dates) for a, df in frames.items()}
24 def col(a, c):
25     return px[a][c].astype(float).values
26 
27 close = pd.DataFrame({a: col(a, "close") for a in frames}, index=dates)
28 open_ = pd.DataFrame({a: col(a, "open") for a in frames}, index=dates)
29 high = pd.DataFrame({a: col(a, "high") for a in frames}, index=dates)
30 low = pd.DataFrame({a: col(a, "low") for a in frames}, index=dates)
31 
32 lr = np.log(close / close.shift(1))
33 
34 def cs_z(x):
35     return (x - x.mean(axis=1)) / x.std(axis=1)
36 
37 factors = {}
38 factors["cz_rev1"] = -cs_z(lr)
39 factors["rev1_pk"] = -lr / np.sqrt((np.log(high / low) ** 2).rolling(20).mean() / (4 * np.log(2)))
40 eff = np.abs(close / close.shift(20) - 1) / lr.abs().rolling(20).sum()
41 factors["rev1_x_inveff"] = lr * (1 - eff)
42 factors["id_rev_1d"] = -(close / open_ - 1)
43 factors["nbody_1d"] = -(close - open_) / (high - low)
44 for nd in (1, 2, 3, 5):
45     factors[f"nclv_{nd}d"] = -(close - low.rolling(nd).min()) / (high.rolling(nd).max() - low.rolling(nd).min())
46 factors["rev_1d"] = -lr
47 factors["rev_1d_vs"] = -lr / lr.rolling(20).std()
48 factors["rev_2d"] = -(np.log(close) - np.log(close.shift(2)))
49 factors["rev_3d"] = -(np.log(close) - np.log(close.shift(3)))
50 factors["mom_10d_skip5"] = np.log(close / close.shift(10)) - np.log(close / close.shift(5))
51 
52 # cross-sectional ranks per day
53 ranked = {}
54 for name, f in factors.items():
55     r = f.rank(axis=1, pct=True)
56     ranked[name] = r
57 
58 # pooled pairwise spearman among ranked factors
59 names = list(ranked)

