    print(f"\n--- {label} leave-one-out IC1 (asset exclusion) ---")
    base = ic_analysis(panel, closes, fwd_days=1)
    print(f"  all     : IC={base['ic']:+.4f} ICIR={base['icir']:+.3f} n={base['n_dates']}")
