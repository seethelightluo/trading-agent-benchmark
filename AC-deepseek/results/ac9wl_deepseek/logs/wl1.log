# RSI(14) reversal (long orientation: low RSI -> high value)
def rsi14():
    up = RET.clip(lower=0).rolling(14).mean()
    dn = (-RET).clip(lower=0).rolling(14).mean()
    rs = up / (dn + 1e-12)
    rsi = 100 - 100 / (1 + rs)
    return 50 - rsi  # positive when oversold
