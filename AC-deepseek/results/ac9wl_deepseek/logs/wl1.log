  ▶️ shell({'command': 'python - <<\'EOF\'\nimport pandas as pd, numpy as np, glob, os\n\nfiles = sorted(glob.glob(\'../persistent/stock_data/*.csv\'))\nprint(f"{\'symbol\':<10} {\'last\':>10} {\'1m%\':>8} {\'3m%\':>8} {\'6m%\':>8} {\'12m%\':>9} {\'ma50>ma200\':>10} {\'vol20\':>7} {\'d20\':>6}")\nrows=[]\nfor f in files:\n    sym = os.path.basename(f).replace(\'.csv\',\'\')\n    df = pd.read_csv(f, parse_dates=[0])\n    df.columns = [c.strip().lower() for c in df.columns]\n    date_col = df.columns[0]\n    close_col = \'close\' if \'close\' in df.columns else \'adj_close\'\n    df = df.sort_values(date_col).reset_index(drop=True)\n    c = df[close_col].astype(float)\n    last = c.iloc[-1]\n    def ret(n):\n        if len(c) > n: return (last/c.iloc[-1-n]-1)*100\n        return np.nan\n    ma50 = c.rolling(50).mean().iloc[-1]\n    ma200 = c.rolling(200).mean().iloc[-1] if len(c)>200 else np.nan\n    r = c.pct_change()\n    vol20 = r.tail(20).std()*np.sqrt(252)*100\n    d20 = (last/c.iloc[-21]-1)*100 if len(c)>21 else np.nan\n    rows.append((sym,last,ret(21),ret(63),ret(126),ret(252), ma50>ma200, vol20, d20))\n    print(f"{sym:<10} {last:>10.2f} {ret(21):>8.2f} {ret(63):>8.2f} {ret(126):>8.2f} {ret(252):>9.2f} {str(ma50>ma200):>10} {vol20:>7.1f} {d20:>6.2f}")\n\nprint("\\n--- Macro observation-only ---")\nfor f in sorted(glob.glob(\'../persistent/index_data/*.csv\')):\n    sym = os.path.basename(f).replace(\'.csv\',\'\')\n    df = pd.read_csv(f, parse_dates=[0])\n    df.columns = [c.strip().lower() for c in df.columns]\n    date_col = df.columns[0]\n    close_col = \'close\' if \'close\' in df.columns else df.columns[-1]\n    c = df[close_col].astype(float)\n    last = c.iloc[-1]\n    def ret(n):\n        if len(c) > n: return (last/c.iloc[-1-n]-1)*100\n        return np.nan\n    print(f"{sym:<10} last={last:>10.2f} 1m={ret(21):>7.2f}% 3m={ret(63):>7.2f}% 1y={ret(252):>8.2f}%")\nEOF'})
