79 def rolling_beta(y, x, win):
80     """rolling beta of y on x over win days."""
81     out = pd.DataFrame(np.nan, index=y.index, columns=y.columns)
82     for c in y.columns:
83         yy, xx = y[c], x
84         df = pd.concat([yy, xx], axis=1).dropna()
85         if len(df) < win + 10:
86             continue
87         cov = df[yy.name].rolling(win).cov(df[xx.name])
88         var = df[xx.name].rolling(win).var()
89         out.loc[df.index, c] = (cov / var)
90     return out

