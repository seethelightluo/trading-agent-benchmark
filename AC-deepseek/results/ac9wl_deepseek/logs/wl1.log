onal std)\ncs_disp = ret.dropna(how=\'all\').iloc[-20:].std(axis=1)\nprint(f"Avg cross-sectional daily dispersion (20d): {cs_disp.mean():.4f}")\ncs_disp60 = ret.dropna(how=\'all\').iloc[-60:].std(axis=1)\nprint(f"Avg cross-sectional daily dispersion (60d): {cs_disp60.mean():.4f}")\nEOF'})
