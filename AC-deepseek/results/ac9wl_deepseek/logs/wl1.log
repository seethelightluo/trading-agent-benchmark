        ic = m.get('ic1', m.get('ic'))
        icir = m.get('icir1', m.get('icir'))
        info.append(f"{os.path.basename(f)[:70]}|{v.get('status','?')}|ic={ic}|icir={icir}|art={arttype}")
    print(fid, "->", len(entries), "entries")
    for x in info:
        print("   ", x)
