  ▶️ shell({'command': 'python - <<\'EOF\'\nimport numpy as np, pandas as pd, json\nfrom scipy.stats import spearmanr\npd.set_option(\'display.width\', 220)\n\npanel = pd.read_pickle("scripts/panel_cache.pkl")\nC = panel["close"].astype(float); O=panel["open"].astype(float)\nH=panel["high"].astype(float); L=panel["low"].astype(float); V=panel["vol"].astype(float)\nidx=C.index; SYMS=list(C.columns); RET=C.pct_change(); LRET=np.log(C/C.shift(1))\nfwd1=RET.shift(-1)\nEVAL_START=pd.Timestamp("2021-01-04"); END=pd.Timestamp("2026-07-15")\nev_idx = idx[(idx>=EVAL_START)&(idx<=END)]\n\nlibs = {f.replace(\'factors/\',\'\').replace(\'.npy\',\'\'): np.load("factors/"+f, allow_pickle=True)\n        for f in ["miner2_20260716_mom_10d_skip5.npy","miner1_20260716_er20.npy","miner2_20260716_nclv_1d.npy"]}\nfor k,a in libs.items(): print("lib:", k, a.shape)\n\ndef pooled_rho(a,b):\n    m=(~np.isnan(a))&(~np.isnan(b))\n    if m.sum()<500: return float(\'nan\')\n    return float(spearmanr(a[m], b[m]).statistic)\n\ndef zwin(X, win=120, mp=40):\n    df=pd.DataFrame(X,index=idx,columns=SYMS)\n    mu=df.rolling(win,min_periods=mp).mean(); sd=df.rolling(win,min_periods=mp).std()\n    return ((df-mu)/(sd+1e-12)).to_numpy(dtype=float)\n\ndef ic_stats(fac):\n    df=pd.DataFrame(fac,index=idx,columns=SYMS); ev=df.loc[ev_idx]; fw=fwd1.loc[ev_idx]\n    ics=[]\n    for dt in ev.index:\n        f=ev.loc[dt].dropna(); r=fw.loc[dt].reindex(f.index).dropna()\n        common=f.index.intersection(r.index)\n        if len(common)<8: continue\n        x=f[common].astype(float).rank(); y=r[common].astype(float).rank()\n        if x.std()==0 or y.std()==0: continue\n        ic=np.corrcoef(x,y)[0,1]\n        if np.isfinite(ic): ics.append(ic)\n    ics=np.array(ics)\n    if len(ics)==0: return None\n    return dict(ic=float(ics.mean()),\n                icir=float(ics.mean()/ics.std(ddof=1)) if ics.std(ddof=1)>1e-12 else 0.0,\n                hit=float((ics>0).mean()), n=int(len(ics)))\n\n# ---------- candidates (full panel) ----------\ncands={}\n# RSI-2 (mean reversion)\nup=RET.clip(lower=0).rolling(2).mean(); dn=(-RET.clip(upper=0)).rolling(2).mean()\ncands["rsi_2"]=(100-100/(1+up/(dn+1e-12))).to_numpy(dtype=float)\n# intraday reversal z120\ncands["rev_intra_z120"]=zwin((1.0-C/O).to_numpy(dtype=float),120)\n# CCI-20\nmd=(C-C.rolling(20).mean()).abs().rolling(20).mean()\ncands["cci_20"]=((C-C.rolling(20).mean())/(0.015*md+1e-12)).to_numpy(dtype=float)\n# dist from 60d high\ncands["dist_high_60"]=(C/C.rolling(60).max()-1.0).to_numpy(dtype=float)\n# trend consistency 60\nsma20=C.rolling(20).mean()\ncands["trend_consist_60"]=(C>sma20).rolling(60).mean().to_numpy(dtype=float)\n# slope norm 20\nstd20=LRET.rolling(20).std()\ncands["slope_norm_20"]=((sma20/sma20.shift(10)-1.0)/(std20+1e-12)).to_numpy(dtype=float)\n# vwap dev 20\nvwap20=(C*V).rolling(20).sum()/V.rolling(20).sum()\ncands["vwap_dev_20"]=(C/vwap20-1.0).to_numpy(dtype=float)\n# vol term 5/20\nstd5=LRET.rolling(5).std(); std20b=LRET.rolling(20).std()\ncands["vol_term_5_20"]=np.log(std5/std20b).to_numpy(dtype=float)\n# gap mom 5 z\ngaps=(O/C.shift(1)-1.0)\ncands["gap_mom_5_z"]=zwin(gaps.rolling(5).sum().to_numpy(dtype=float),120)\n# parkinson vol z\npv=np.sqrt(np.log(H/L)**2/(4*np.log(2)))\ncands["park_vol_z"]=zwin(pv.to_numpy(dtype=float),120)\n# skew 20 z\ncands["skew_20_z"]=zwin(LRET.rolling(20).skew().to_numpy(dtype=float),250)\n# corr with NDX 60\ncands["corr_ndx_60"]=LRET.rolling(60).corr(LRET["NDX"]).to_numpy(dtype=float)\n# max ret 5 (reversal)\ncands["max_ret_5"]=RET.rolling(5).max().to_numpy(dtype=float)\n# 10d volume z (liquidity anomaly)\ncands["vol_ratio_10"]=zwin((V/V.rolling(60).mean()).to_numpy(dtype=float),120)\n# overnight ratio z (overnight vs intraday decomposition)\ncands["overnight_ratio_z"]=zwin((gaps/(RET-gaps+1e-12)).to_numpy(dtype=float),120)\n\nrows=[]\nfor name,fac in cands.items():\n    st=ic_stats(fac)\n    if st is None: print(f"{name:20s} no valid IC"); continue\n    df=pd.DataFrame(fac,index=idx,columns=SYMS); ev=df.loc[ev_idx]\n    cov=float(ev.notna().mean().mean())\n    rhos={k:round(pooled_rho(fac,v),3) for k,v in libs.items()}\n    maxrho=max(abs(v) for v in rhos.values())\n    qual=abs(st["ic"])*abs(st["icir"])\n    gate_ic=abs(st["ic"])>=0.007 and abs(st["icir"])>=0.084\n    diverse=maxrho<0.5\n    flag="PASS" if (gate_ic and diverse) else "    "\n    rows.append((name,st["ic"],st["icir"],st["hit"],st["n"],cov,rhos,maxrho,qual))\n    print(f"{flag} {name:20s} IC={st[\'ic\']:+.4f} ICIR={st[\'icir\']:+.3f} hit={st[\'hit\']:.3f} n={st[\'n\']} cov={cov:.3f} "\n          f"rho_mom={rhos[\'miner2_20260716_mom_10d_skip5\']:+.2f} rho_er={rhos[\'miner1_20260716_er20\']:+.2f} "\n          f"rho_nclv={rhos[\'miner2_20260716_nclv_1d\']:+.2f} maxrho={maxrho:.2f} qual={qual:.4f}")\n\nprint("\\n--- IC/ICIR gate passed (|IC|>=0.007,|ICIR|>=0.084) sorted by quality ---")\nfor r in sorted(rows,key=lambda x:-x[8]):\n    name,ic,icir,hit,n,cov,rhos,maxrho,qual=r\n    if abs(ic)>=0.007 and abs(icir)>=0.084:\n        print(f"{name:20s} IC={ic:+.4f} ICIR={icir:+.3f} hit={hit:.3f} n={n} cov={cov:.3f} maxrho={maxrho:.2f} qual={qual:.4f} {\'DIVERSE\' if maxrho<0.5 else \'CORRELATED\'}")\n\njson.dump({r[0]:dict(ic=r[1],icir=r[2],hit=r[3],n=r[4],cov=r[5],rhos=r[6],maxrho=r[7],qual=r[8]) for r in rows},\n          open("scripts/miner3_diag_full2388_results.json","w"), indent=1)\nprint("\\nsaved scripts/miner3_diag_full2388_results.json")\nEOF'})
