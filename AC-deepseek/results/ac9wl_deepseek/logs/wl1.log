# selection: pass gate + diverse vs library + mutually diverse
# -----------------------------------------------------------------------------
def quality(nm):
    r = results[nm]
    return abs(r["ic1"]["ic"]) * abs(r["ic1"]["icir"])

passers = [nm for nm, r in results.items() if r["passed"]]
