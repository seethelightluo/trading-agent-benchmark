65 def pooled_rho(a, b, min_n=500):
66     a = np.asarray(a, dtype=float).ravel()
67     b = np.asarray(b, dtype=float).ravel()
68     m = (~np.isnan(a)) & (~np.isnan(b))
69     if m.sum() < min_n:
70         return float("nan")
71     return float(spearmanr(a[m], b[m]).statistic)
72 
73 
74 def zscore_win(X, win=120, minp=40):
75     df = pd.DataFrame(X, index=idx, columns=SYMS)
76     mu = df.rolling(win, min_periods=minp).mean()
77     sd = df.rolling(win, min_periods=minp).std()
78     return ((df - mu) / (sd + 1e-12)).to_numpy(dtype=float)
