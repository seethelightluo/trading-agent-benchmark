50 # ============ Part A: known passing family (recompute) ============
51 print("=== Part A: close-based reversal ===")
52 cands = {}
53 for nd in (1, 2, 3, 5):
54     cands[f"rev_{nd}d"] = -np.log(CP / CP.shift(nd))
55 
56 # range-position (CLV) family: signed close location in n-day high-low range
57 print("=== Part A: OHLC range-position (CLV) family ===")
58 for nd in (1, 2, 3, 5):
59     hmax = HP.rolling(nd).max()
60     lmin = LP.rolling(nd).min()
61     rng = (hmax - lmin).replace(0, np.nan)
62     cands[f"nclv_{nd}d"] = -(CP - lmin) / rng
63 
64 # ============ Part B: novel candidates (this cycle) ============
65 print("=== Part B: novel short-horizon OHLC / vol variants ===")
66 rng1 = (HP - LP).replace(0, np.nan)
67 cands["wick_up_1d"] = (HP - CP) / rng1            # upper-wick fraction (overreaction up)
68 cands["nbody_1d"] = -(CP - OP) / rng1             # negative intraday body (reversal)
69 cands["gap_rev_1d"] = -(OP / CP.shift(1) - 1.0)   # gap reversal
70 cands["id_rev_1d"] = -(CP / OP - 1.0)             # intraday reversal
71 vol20 = RET.rolling(20).std()
72 cands["rev_1d_vs"] = -np.log(CP / CP.shift(1)) / (vol20 + 1e-12)  # vol-scaled reversal
73 # cross-sectional: rev_1d minus cross-sectional median (pure relative reversal)
74 _logr = -np.log(CP / CP.shift(1))
75 cands["crev_1d"] = _logr.sub(_logr.median(axis=1), axis=0)
76 
77 res = {}
78 for nm, p in cands.items():
79     res[nm] = run(nm, p)
80 
81 # ============ Part C: deep validation for passers ============
