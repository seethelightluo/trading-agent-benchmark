def roll_beta(y_panel, x, win):
    out = {}
    for s in y_panel.columns:
        y = y_panel[s]
        df = pd.concat([y, x], axis=1).dropna()
        cov = df.iloc[:, 0].rolling(win).cov(df.iloc[:, 1])
        var = df.iloc[:, 1].rolling(win).var()
        out[s] = (cov / var).reindex(idx)
    return pd.DataFrame(out)

