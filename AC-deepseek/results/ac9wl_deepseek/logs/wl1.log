# rsi-2 style factor
def rsi2(C, n=2):
    chg = C.diff()
    up = chg.clip(lower=0).rolling(n).mean()
    dn = (-chg.clip(upper=0)).rolling(n).mean()
    return 100 - 100 / (1 + up / (dn + 1e-12))
r2 = rsi2(C).to_numpy()
