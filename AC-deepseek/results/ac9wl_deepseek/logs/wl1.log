  ▶️ shell({'command': 'python - <<\'EOF\'\nimport pandas as pd, numpy as np, glob, os\nfiles = sorted(glob.glob(\'../persistent/stock_data/*.csv\'))\nassets = [os.path.basename(f)[:-4] for f in files]\ncloses = {}\nrets = {}\nfor f in files:\n    a = os.path.basename(f)[:-4]\n    df = pd.read_csv(f)\n    df[\'date\'] = pd.to_datetime(df[\'date\'])\n    df = df[df[\'date\'] <= \'2026-07-15\'].set_index(\'date\').sort_index()\n    closes[a] = df[\'close\'].astype(float)\n    rets[a] = df[\'close\'].astype(float).pct_change()\npanel = pd.DataFrame(closes).dropna(how=\'all\')\nrpanel = pd.DataFrame(rets).dropna(how=\'all\')\nprint("Panel dates:", panel.index.min().date(), "->", panel.index.max().date(), "| rows:", len(panel))\nprint("\\n=== Per-asset regime metrics (through 2026-07-15) ===")\nprint(f"{\'asset\':10s} {\'close\':>10s} {\'20d%\':>7s} {\'60d%\':>7s} {\'120d%\':>7s} {\'vol20 ann%\':>9s} {\'MA20>MA60\':>9s} {\'corr_avg\':>8s}")\navg_corr = []\nfor a in assets:\n    c = closes[a]\n    r = rpanel[a]\n    c20, c60, c120 = c.iloc[-1]/c.iloc[-21]-1, c.iloc[-1]/c.iloc[-61]-1, c.iloc[-1]/c.iloc[-121]-1\n    vol = r.tail(20).std()*np.sqrt(252)\n    ma = "UP" if c.iloc[-1] > c.rolling(20).mean().iloc[-1] and c.rolling(20).mean().iloc[-1] > c.rolling(60).mean().iloc[-1] else ("DOWN" if c.iloc[-1] < c.rolling(20).mean().iloc[-1] and c.rolling(20).mean().iloc[-1] < c.rolling(60).mean().iloc[-1] else "MIX")\n    print(f"{a:10s} {c.iloc[-1]:10.2f} {c20*100:7.2f} {c60*100:7.2f} {c120*100:7.2f} {vol*100:9.1f} {ma:>9s}")\n# cross-asset correlation\nrc = rpanel.tail(120).corr()\nvals = rc.values[np.triu_indices(len(assets), k=1)]\nprint(f"\\nAvg pairwise corr (120d): {np.nanmean(vals):.3f} | median: {np.nanmedian(vals):.3f}")\n# recent avg correlation\nrc20 = rpanel.tail(20).corr()\nvals20 = rc20.values[np.triu_indices(len(assets), k=1)]\nprint(f"Avg pairwise corr (20d): {np.nanmean(vals20):.3f}")\n# market trend\nmkt = rpanel.mean(axis=1)\nwealth = (1+mkt).cumprod()\nprint(f"\\nEqual-weight market: 20d {mkt.tail(20).sum()*100:.2f}% | 60d {mkt.tail(60).sum()*100:.2f}% | 120d {mkt.tail(120).sum()*100:.2f}%")\nprint(f"Market 20d vol ann: {mkt.tail(20).std()*np.sqrt(252)*100:.1f}%")\n# dispersion\ndisp = rpanel.tail(20).std(axis=1).mean()*100\nprint(f"Avg daily cross-sectional dispersion (20d): {disp:.2f}%")\n# drawdown\ndd = wealth/wealth.rolling(60).max()-1\nprint(f"Market max drawdown last 120d: {dd.tail(120).min()*100:.1f}%")\nEOF'})
