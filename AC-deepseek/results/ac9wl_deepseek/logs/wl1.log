    rows.append((name, st["ic"], st["icir"], st["hit"], st["n"], cov, turn, rho_max, rho_anchor, qual))
    print(f"{flag} {name:20s} IC1={st['ic']:+.4f} ICIR1={st['icir']:+.3f} hit={st['hit']:.3f} "
