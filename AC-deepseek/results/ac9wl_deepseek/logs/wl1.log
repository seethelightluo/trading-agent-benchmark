panels["pos_freq_250d_skip20"] = (LRET > 0).rolling(250).mean().shift(20)

# ---------- volume z (attention) ----------
lvol = np.log(VOL + 1e-9)
for n in (60, 90, 120):
    panels[f"vol_z_{n}d"] = (lvol - lvol.rolling(n).mean()) / lvol.rolling(n).std()

# ---------- fixed rs / beta / macro ----------
for n in (20, 60, 120):
