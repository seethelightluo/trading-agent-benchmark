                  rho_max=r[7], rho_anchor=r[8], qual=r[9]) for r in rows}
with open("scripts/miner3_screen_cycle7_results.json", "w") as fh:
    json.dump(out, fh, indent=1)
print("\nsaved scripts/miner3_screen_cycle7_results.json")
