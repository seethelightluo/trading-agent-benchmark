    for i in range(rebal, len(ranks)):
        prev = ranks.iloc[i - rebal].dropna()
        cur = ranks.iloc[i].dropna()
        common = prev.index.intersection(cur.index)
        if len(common) < 2:
            continue
        chg.append((cur[common] - prev[common]).abs().mean() / (len(common) - 1))
