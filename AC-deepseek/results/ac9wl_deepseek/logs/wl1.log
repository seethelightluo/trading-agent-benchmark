 158 def _pairwise_abs_spearman(left: np.ndarray, right: np.ndarray) -> float:
 159     """Compute mean cross-sectional absolute Spearman rho over common rows."""
 160     if left.shape != right.shape:
 161         raise ValueError(f"signal shapes differ: {left.shape} vs {right.shape}")
 162     values: list[float] = []
 163     for row_left, row_right in zip(left, right):
 164         finite = np.isfinite(row_left) & np.isfinite(row_right)
 165         if int(finite.sum()) < 2:
 166             continue
 167         rank_left = pd_rank(row_left[finite])
 168         rank_right = pd_rank(row_right[finite])
 169         if np.std(rank_left) <= 1e-12 or np.std(rank_right) <= 1e-12:
 170             continue
 171         values.append(abs(float(np.corrcoef(rank_left, rank_right)[0, 1])))
 172     if not values:
 173         raise ValueError("signal artifacts have no common valid cross-section")
 174     return float(np.mean(values))
 175 
 176 
 177 def pd_rank(values: np.ndarray) -> np.ndarray:
 178     """Small dependency-free average-rank implementation."""
 179     order = np.argsort(values, kind="mergesort")
 180     ranks = np.empty(len(values), dtype=float)
 181     sorted_values = values[order]
 182     start = 0
 183     while start < len(values):
 184         end = start + 1
 185         while end < len(values) and sorted_values[end] == sorted_values[start]:
 186             end += 1
 187         ranks[order[start:end]] = (start + end - 1) / 2.0 + 1.0
 188         start = end
 189     return ranks
