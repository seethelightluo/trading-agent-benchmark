  ▶️ shell({'command': 'python - <<\'EOF\'\nimport json, glob, os, numpy as np, pandas as pd, sys\nsys.path.insert(0, \'scripts\')\nfrom miner1_common import SYMBOLS, load_close\nprint("symbols:", SYMBOLS)\n\ncloses = load_close()\nidx = None\nfor s, df in closes.items():\n    idx = df.index if idx is None else idx.intersection(df.index)\nidx = idx[idx >= pd.Timestamp(\'2021-01-01\')]\nprint("n dates:", len(idx), idx[0], idx[-1])\n\nCP = pd.DataFrame({s: closes[s][\'close\'].reindex(idx).astype(float) for s in SYMBOLS})\nOP = pd.DataFrame({s: closes[s][\'open\'].reindex(idx).astype(float) for s in SYMBOLS})\nHP = pd.DataFrame({s: closes[s][\'high\'].reindex(idx).astype(float) for s in SYMBOLS})\nLP = pd.DataFrame({s: closes[s][\'low\'].reindex(idx).astype(float) for s in SYMBOLS})\n\n# Panels matching every persisted factor\npanels = {}\nfor nd in (1,2,3,5):\n    panels[f"rev_{nd}d"] = -np.log(CP / CP.shift(nd))\nfor nd in (1,2,3,5):\n    hmax = HP.rolling(nd).max(); lmin = LP.rolling(nd).min()\n    rng = (hmax-lmin).replace(0, np.nan)\n    panels[f"nclv_{nd}d"] = -(CP - lmin)/rng\nrng1 = (HP-LP).replace(0, np.nan)\npanels["nbody_1d"] = -(CP-OP)/rng1\npanels["id_rev_1d"] = -(CP/OP - 1.0)\npanels["rev_1d_vs"] = -np.log(CP/CP.shift(1))/(CP.pct_change().rolling(20).std()+1e-12)\n# miner3 panels (aliases)\npanels["miner3_rev_1d"] = -CP.pct_change(1)\nhmax5 = HP.rolling(5).max(); lmin5 = LP.rolling(5).min()\npanels["miner3_clv_5d"] = (CP - lmin5)/(hmax5 - lmin5 + 1e-12)\n\ndef panel_corr(a, b):\n    A = a.values.astype(float); B = b.values.astype(float)\n    m = np.isfinite(A) & np.isfinite(B)\n    n = m.sum()\n    if n < 50: return np.nan\n    x = A[m]; y = B[m]\n    if x.std()==0 or y.std()==0: return np.nan\n    return float(np.corrcoef(x,y)[0,1])\n\nnames = list(panels.keys())\nprint("n panels:", len(names))\n\n# Map persisted factor file -> panel key\ndef panel_key(fid):\n    p = fid.replace(\'miner2_20260715_\',\'\').replace(\'miner3_20260716_\',\'\')\n    if fid.startswith(\'miner3_20260716_\'):\n        return \'miner3_\' + p\n    return p\n\n# For each persisted factor, compute max_abs_library_correlation vs ALL other persisted factors\nfiles = sorted(glob.glob(\'factors/*.json\'))\nprint("files:", len(files))\nfor f in files:\n    d = json.load(open(f))\n    fid = d[\'factor_id\']\n    pk = panel_key(fid)\n    if pk not in panels:\n        print(f"!! no panel for {fid} (key {pk})")\n        continue\n    p = panels[pk]\n    rhos = []\n    for o in files:\n        od = json.load(open(o))\n        ofid = od[\'factor_id\']\n        if ofid == fid: continue\n        opk = panel_key(ofid)\n        if opk not in panels: continue\n        r = panel_corr(p, panels[opk])\n        if np.isfinite(r):\n            rhos.append((abs(r), ofid, round(r,4)))\n    rhos.sort(reverse=True)\n    maxrho = rhos[0][0] if rhos else 0.0\n    print(f"{fid:40s} max_abs_lib_rho={maxrho:+.4f}  top3: {[(o, round(r,3)) for r,o,_ in rhos[:3]]}")\nEOF'})
