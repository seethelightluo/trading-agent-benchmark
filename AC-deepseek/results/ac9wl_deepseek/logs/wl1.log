  ▶️ shell({'command': 'python - <<\'EOF\'\nimport pandas as pd, numpy as np, glob, os\n\n# Load all 15 tradable assets\nfiles = sorted(glob.glob(\'../persistent/stock_data/*.csv\'))\nprint("Assets found:", len(files))\ndata = {}\nfor f in files:\n    name = os.path.basename(f).replace(\'.csv\',\'\')\n    df = pd.read_csv(f)\n    df.columns = [c.strip().lower() for c in df.columns]\n    date_col = \'date\' if \'date\' in df.columns else df.columns[0]\n    df[date_col] = pd.to_datetime(df[date_col])\n    df = df.sort_values(date_col).set_index(date_col)\n    data[name] = df[\'close\'] if \'close\' in df.columns else df[df.columns[1]]\n    print(f"  {name}: {df.index.min().date()} .. {df.index.max().date()}, rows={len(df)}")\n\npx = pd.DataFrame(data).dropna(how=\'all\')\nprint("\\nPanel shape:", px.shape, "| last date:", px.index.max().date())\nret = px.pct_change()\n\n# Recent window stats (last 60 trading days up to 2026-07-15)\nlast = px.iloc[-1]\nw60 = px.iloc[-60:]\nw20 = px.iloc[-20:]\nret60 = last / px.iloc[-61] - 1\nret20 = last / px.iloc[-21] - 1\nvol20 = ret.iloc[-20:].std() * np.sqrt(252)\nvol60 = ret.iloc[-60:].std() * np.sqrt(252)\n\n# Trend: 20d vs 60d MA\nma20 = px.mean(axis=1)  # equal-weight portfolio proxy\npx_ew = px.mean(axis=1)\nma20_ew = px_ew.rolling(20).mean().iloc[-1]\nma60_ew = px_ew.rolling(60).mean().iloc[-1]\nprint(f"\\nEqual-weight portfolio: last={px_ew.iloc[-1]:.2f}, MA20={ma20_ew:.2f}, MA60={ma60_ew:.2f}")\nprint(f"EW 20d ret={px_ew.iloc[-1]/px_ew.iloc[-21]-1:.4f}, 60d ret={px_ew.iloc[-1]/px_ew.iloc[-61]-1:.4f}")\n\nprint("\\n=== Per-asset recent stats (through 2026-07-15) ===")\nprint(f"{\'Asset\':<8} {\'20d ret\':>8} {\'60d ret\':>8} {\'vol20\':>7} {\'vol60\':>7} {\'last\':>10}")\nfor name in px.columns:\n    print(f"{name:<8} {ret20[name]*100:>7.2f}% {ret60[name]*100:>7.2f}% {vol20[name]*100:>6.1f}% {vol60[name]*100:>6.1f}% {last[name]:>10.2f}")\nEOF'})
