 192 def evaluate_factor(payload: dict, contract: FactorContract) -> dict[str, Any]:
 193     validation = payload.get("validation") if isinstance(payload, dict) else None
 194     status = str((validation or {}).get("status", "")).upper()
 195     if status not in {"EFFECTIVE", "ACTIVE"}:
 196         raise ValueError("factor validation.status must be EFFECTIVE or ACTIVE")
 197 
 198     passing = [
 199         pair for pair in _metric_pairs(payload)
 200         if abs(pair[0]) >= contract.ic_threshold and abs(pair[1]) >= contract.icir_threshold
 201     ]
 202     if not passing:
 203         raise ValueError(
 204             "factor has no same-horizon IC/ICIR pair passing "
 205             f"|IC|>={contract.ic_threshold:.4f} and |ICIR|>={contract.icir_threshold:.4f}"
 206         )
 207     selected = max(passing, key=lambda pair: abs(pair[0]) * abs(pair[1]))
 208 
 209     # The AC Miner field is provenance/audit metadata, not the conflict gate.
 210     # The native prompt asks the model to self-report a library correlation,
 211     # but the benchmark contract must compare both real signal artifacts on a
 212     # common sample.  Rejecting a candidate here would prevent the lower/higher
 213     # quality comparison required by the worldline contract.
 214     reported_correlation, correlation_path = _find_correlation(payload)
 215     return {
 216         "ic": selected[0],
 217         "icir": selected[1],
 218         "metric_path": selected[2],
 219         "reported_max_abs_library_correlation": reported_correlation,
 220         "correlation_path": correlation_path,
 221         "quality": abs(selected[0]) * abs(selected[1]),
 222     }
