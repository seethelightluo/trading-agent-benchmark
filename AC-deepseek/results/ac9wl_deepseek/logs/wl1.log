  85 def _walk_dicts(
  86     value: Any, path: tuple[str, ...] = ()
  87 ) -> Iterable[tuple[tuple[str, ...], dict]]:
  88     if isinstance(value, dict):
  89         yield path, value
  90         for key, child in value.items():
  91             yield from _walk_dicts(child, path + (str(key),))
  92     elif isinstance(value, list):
  93         for index, child in enumerate(value):
  94             yield from _walk_dicts(child, path + (str(index),))
  95 
