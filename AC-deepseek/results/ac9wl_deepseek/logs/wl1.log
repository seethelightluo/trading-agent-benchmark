 236 def _archive(path: Path, bucket: str) -> Path:
 237     target_dir = path.parent / bucket
 238     target_dir.mkdir(parents=True, exist_ok=True)
 239     target = target_dir / path.name
 240     if target.exists():
 241         target = target_dir / (
 242             f"{path.stem}.{datetime.now().strftime('%Y%m%dT%H%M%S%f')}{path.suffix}"
 243         )
 244     shutil.move(str(path), str(target))
 245     return target
