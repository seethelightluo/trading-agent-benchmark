    for yr in range(2021, 2027):
        m = (idx >= pd.Timestamp(f"{yr}-01-01")) & (idx <= pd.Timestamp(f"{yr}-12-31"))
        if m.sum() < 50:
            continue
        r = ic_analysis(panel.loc[idx[m]], closes, fwd_days=1)
        if r["n_dates"]:
