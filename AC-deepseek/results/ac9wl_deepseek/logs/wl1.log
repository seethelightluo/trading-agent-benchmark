  99 def _metric_pairs(payload: dict) -> list[tuple[float, float, str]]:
 100     pairs: list[tuple[float, float, str]] = []
 101     for path, mapping in _walk_dicts(payload):
 102         ic = next((_finite_float(mapping.get(key)) for key in _IC_KEYS if key in mapping), None)
 103         icir = next((_finite_float(mapping.get(key)) for key in _ICIR_KEYS if key in mapping), None)
 104         if ic is not None and icir is not None:
 105             pairs.append((ic, icir, ".".join(path) or "root"))
 106     return pairs
