panels["beta_spx60_x_vixlevel"] = b_spx[60] * np.sign(vix.rolling(20).mean() - vix.rolling(120).mean())
panels["beta_vix120_x_vixtrend"] = -b_vix[120] * np.sign(vix_trend)

