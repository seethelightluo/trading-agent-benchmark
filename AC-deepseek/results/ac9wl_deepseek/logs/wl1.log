138 def rsi_robust(win):
139     up = RET.clip(lower=0).rolling(win).mean()
140     dn = (-RET.clip(upper=0)).rolling(win).mean()
141     rs = up / (dn + 1e-9)
142     r = 100 - 100 / (1 + rs)
143     return r
144 
