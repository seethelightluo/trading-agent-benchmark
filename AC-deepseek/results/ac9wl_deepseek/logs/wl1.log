    factor_id = f"miner1_{VALID_DATE.replace('-', '')}_{nm}"
    doc = {
        "factor_id": factor_id,
        "factor_name": META[nm]["name"],
        "version": "1.0.0",
        "calculation": {
            "expression": META[nm]["expr"],
            "description": (META[nm]["name"] + " on the 15-name cross-asset panel; "
