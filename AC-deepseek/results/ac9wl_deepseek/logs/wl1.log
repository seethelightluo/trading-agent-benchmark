        rho[(a, b)] = r
        flag = " <CONFLICT>" if r >= RHO_MAX else ""
        print(f"  rho({a},{b}) = {r:.3f}{flag}")

# ---------------- greedy diverse selection by quality ----------------
def quality(nm):
    r = results[nm]
