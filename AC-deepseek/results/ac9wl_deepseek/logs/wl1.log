  97 def _metric_pairs(payload: dict) -> list[tuple[float, float, str]]:
  98     pairs: list[tuple[float, float, str]] = []
  99     for path, mapping in _walk_dicts(payload):
 100         ic = next((_finite_float(mapping.get(key)) for key in _IC_KEYS if key in mapping), None)
 101         icir = next((_finite_float(mapping.get(key)) for key in _ICIR_KEYS if key in mapping), None)
 102         if ic is not None and icir is not None:
 103             pairs.append((ic, icir, ".".join(path) or "root"))
 104     return pairs
