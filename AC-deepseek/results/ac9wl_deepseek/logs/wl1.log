156:         return None
157: 
158: 
159: def _pairwise_abs_spearman(left: np.ndarray, right: np.ndarray) -> float:
160:     """Compute mean cross-sectional absolute Spearman rho over common rows."""
161:     if left.shape != right.shape:
162:         raise ValueError(f"signal shapes differ: {left.shape} vs {right.shape}")
163:     values: list[float] = []
164:     for row_left, row_right in zip(left, right):
165:         finite = np.isfinite(row_left) & np.isfinite(row_right)
166:         if int(finite.sum()) < 2:
167:             continue
168:         rank_left = pd_rank(row_left[finite])
169:         rank_right = pd_rank(row_right[finite])
170:         if np.std(rank_left) <= 1e-12 or np.std(rank_right) <= 1e-12:
171:             continue
172:         values.append(abs(float(np.corrcoef(rank_left, rank_right)[0, 1])))
173:     if not values:
174:         raise ValueError("signal artifacts have no common valid cross-section")
175:     return float(np.mean(values))
176: 
177: 
178: def pd_rank(values: np.ndarray) -> np.ndarray:
179:     """Small dependency-free average-rank implementation."""
180:     order = np.argsort(values, kind="mergesort")
181:     ranks = np.empty(len(values), dtype=float)
182:     sorted_values = values[order]
183:     start = 0
184:     while start < len(values):
185:         end = start + 1
186:         while end < len(values) and sorted_values[end] == sorted_values[start]:
187:             end += 1
188:         ranks[order[start:end]] = (start + end - 1) / 2.0 + 1.0
189:         start = end
190:     return ranks
191: 
