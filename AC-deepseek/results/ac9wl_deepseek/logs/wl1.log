<｜｜DSML｜｜parameter name="content" string="true">"""Miner3 focused family: Kaufman Efficiency Ratio (path directionality).

er_10d passed the baseline gate (IC=+0.0276, ICIR=+0.093). Here we expand the
family with:
  A) ER at many horizons, raw and rank-transformed
  B) sign-conditional ER (trend up vs down asymmetry)
  C) ER change / acceleration (derivative signals)
  D) ER vs volatility-normalized variants (path/total distance normalized)
  E) fractal dimension proxy: D = 2 - log(ER)/log(nd)
  F) ER-based oscillators (ER-weighted MA crossover = Kaufman Adaptive MA slope)

Also compute redundancy vs known library panel (rev_1d from miner3, clv_5d,
nbody, gap families) using embedded panels if available, otherwise simple
reconstruction from OHLC.
"""
import sys, os, time
import numpy as np
import pandas as pd

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from miner1_common import SYMBOLS, load_close
import miner3_fast as F

t0 = time.time()
closes = load_close()
idx = None
for s, df in closes.items():
    idx = df.index if idx is None else idx.intersection(df.index)
idx = idx[(idx >= pd.Timestamp("2021-01-01"))]
OP = pd.DataFrame({s: closes[s]["open"].reindex(idx).astype(float) for s in SYMBOLS})
HP = pd.DataFrame({s: closes[s]["high"].reindex(idx).astype(float) for s in SYMBOLS})
LP = pd.DataFrame({s: closes[s]["low"].reindex(idx).astype(float) for s in SYMBOLS})
CP = pd.DataFrame({s: closes[s]["close"].reindex(idx).astype(float) for s in SYMBOLS})
VP = pd.DataFrame({s: closes[s]["volume"].reindex(idx).astype(float) for s in SYMBOLS})
RET = CP.pct_change()
print(f"loaded {len(idx)} common dates {idx.min().date()}..{idx.max().date()} ({time.time()-t0:.1f}s)")

fwd = {h: F.fwd_returns(closes, h).reindex(idx) for h in (1, 2, 3, 5, 10, 20, 30)}
N_CELLS = len(idx) * len(SYMBOLS)


def run(name, panel, verbose=True):
    panel = panel.reindex(idx)
    cov = float(panel.notna().sum().sum()) / N_CELLS
    to = F.turnover10(panel)
    ic1 = F.fast_ic(panel, fwd[1])
    ic5 = F.fast_ic(panel, fwd[5])
    ic10 = F.fast_ic(panel, fwd[10])
    passed = (abs(ic1["ic"]) >= 0.0070) and (abs(ic1["icir"]) >= 0.0840)
    if verbose:
        print(f"{name:24s} cov={cov:.3f} to={to:.3f} | IC1={ic1['ic']:+.4f} ICIR1={ic1['icir']:+.3f} "
              f"hit1={ic1['hit']:.2f} n1={ic1['n_dates']} | IC5={ic5['ic']:+.4f} ICIR5={ic5['icir']:+.3f} "
              f"| IC10={ic10['ic']:+.4f} | {'PASS' if passed else 'fail'}")
    return {"name": name, "panel": panel, "cov": cov, "to": to,
            "ic1": ic1, "ic5": ic5, "ic10": ic10, "passed": passed}


def kaufman_er(nd, src=CP):
    path = src.diff().abs().rolling(nd).sum()
    net = (src - src.shift(nd)).abs()
    return net / (path + 1e-12)


cands = {}

# A. raw ER horizons
for nd in (6, 8, 10, 12, 15, 20, 30):
    cands[f"er_{nd}d"] = kaufman_er(nd)

# A2. ER with sign (trend-direction aware): signed ER * sign(ret)
for nd in (6, 8, 10, 12, 15, 20):
    s = np.sign(CP - CP.shift(nd))
    cands[f"ser_{nd}d"] = kaufman_er(nd) * s

# B. rank ER over trailing M days (cross-sectional stability)
for nd in (10, 20):
    er = kaufman_er(nd)
    cands[f"er_rank_{nd}_120"] = er.rolling(120).apply(lambda x: pd.Series(x).rank().iloc[-1] / len(x), raw=False)
    cands[f"er_rank_{nd}_60"] = er.rolling(60).apply(lambda x: pd.Series(x).rank().iloc[-1] / len(x), raw=False)

# C. ER change / slope
for nd in (10, 20):
    cands[f"er_chg_{nd}d"] = kaufman_er(nd) - kaufman_er(nd).shift(nd)

# D. fractal dimension proxy
for nd in (10, 20, 40):
    D = 2.0 - np.log(kaufman_er(nd) + 1e-12) / np.log(nd)
    cands[f"fractal_{nd}d"] = D
    cands[f"inv_fractal_{nd}d"] = -D

# E. Kaufman Adaptive MA slope (normalized by ATR)
def atr(nd=14):
    tr = pd.concat([HP - LP, (HP - CP.shift()).abs(), (LP - CP.shift()).abs()], axis=1).max(axis=1)
    return tr.rolling(nd).mean()

def kama(nd=10, fast=2, slow=30):
    er = kaufman_er(nd)
    sc = (er * (2 / (fast + 1) - 2 / (slow + 1)) + 2 / (slow + 1)) ** 2
    out = CP.copy()
    for s in CP.columns:
        vals = CP[s].values
        k = np.zeros(len(vals)); k[:nd] = vals[:nd]
        scs = sc[s].values
        for i in range(nd, len(vals)):
            if np.isfinite(vals[i]) and np.isfinite(scs[i]):
                k[i] = k[i - 1] + scs[i] * (vals[i] - k[i - 1])
            else:
                k[i] = k[i - 1]
        out[s] = k
    return out

atr14 = atr(14)
for nd in (10, 20):
    kam = kama(nd)
    slope = kam.diff(5) / (atr14 + 1e-12)
    cands[f"kama_slope_{nd}d"] = slope
    cands[f"kama_pos_{nd}d"] = (CP - kam) / (atr14 + 1e-12)

# F. high-low path efficiency (HL-based ER)
def hl_er(nd):
    path = (HP.diff().abs() + LP.diff().abs() + HP.sub(LP).diff().abs()).rolling(nd).sum()
    net = (CP - CP.shift(nd)).abs()
    return net / (path + 1e-12)

for nd in (10, 20, 30):
    cands[f"hler_{nd}d"] = hl_er(nd)
    s = np.sign(CP - CP.shift(nd))
    cands[f"shler_{nd}d"] = hl_er(nd) * s

res = {n: run(n, p) for n, p in cands.items()}
print(f"\nscreen done {time.time()-t0:.1f}s | {len(res)} candidates | {sum(r['passed'] for r in res.values())} PASSED gate")

print("\n=== PASSED ===")
passed = {n: r for n, r in res.items() if r["passed"]}
for n, r in sorted(passed.items(), key=lambda kv: -abs(kv[1]["ic1"]["ic"])):
    print(f"  {n:24s} IC1={r['ic1']['ic']:+.4f} ICIR1={r['ic1']['icir']:+.3f} hit={r['ic1']['hit']:.3f} "
          f"cov={r['cov']:.3f} to={r['to']:.3f} IC5={r['ic5']['ic']:+.4f} IC10={r['ic10']['ic']:+.4f}")

# ---------- redundancy vs existing library panels ----------
lib = {}
# reconstruct library-family panels used by gate (de facto library signal family)
lib["rev_1d"] = -RET
lib["clv_5d"] = (CP - LP.rolling(5).min()) / (HP.rolling(5).max() - LP.rolling(5).min() + 1e-12)
lib["nclv_1d"] = -(CP - LP) / (HP - LP + 1e-12)
lib["nbody_1d"] = -(CP - OP) / (HP - LP + 1e-12)
lib["id_rev_1d"] = -(CP / OP - 1.0)
lib["rev_5d"] = -(CP / CP.shift(5) - 1.0)

def panel_corr(a, b):
    A = a.values.astype(float); B = b.values.astype(float)
    m = np.isfinite(A) & np.isfinite(B)
    if m.sum() < 50 or A[m].std() == 0 or B[m].std() == 0:
        return np.nan
    return float(np.corrcoef(A[m], B[m])[0, 1])

print("\n=== redundancy check vs library panels for PASSED ===")
for n, r in sorted(passed.items(), key=lambda kv: -abs(kv[1]["ic1"]["ic"])):
    mx = 0.0; arg = ""
    for k, lp in lib.items():
        c = panel_corr(r["panel"], lp)
        if np.isfinite(c) and abs(c) > mx:
            mx = abs(c); arg = k
    flag = "  <-- redundant(>0.5)" if mx > 0.5 else ""
    print(f"  {n:24s} max|corr|={mx:.3f} vs {arg}{flag}")

# also run deep validation on the single best non-redundant candidate
print("\n=== top candidate once non-redundant filtered ===")
for n, r in sorted(passed.items(), key=lambda kv: -abs(kv[1]["ic1"]["ic"])):
    mx = max(abs(panel_corr(r["panel"], lp)) for lp in lib.values())
    if mx < 0.5:
        print(f"  BEST: {n} IC1={r['ic1']['ic']:+.4f} ICIR1={r['ic1']['icir']:+.3f} max|libcorr|={mx:.3f}")
        break
