33:
34:n = min(arr.shape[0] for arr in sigs.values())
35:print('common rows:', n)
36:
37:def datewise_corr(a, b):
38:    a, b = a[:n], b[:n]
39:    cs = []
40:    for i in range(n):
41:        va, vb = a[i], b[i]
42:        ok = ~(np.isnan(va) | np.isnan(vb))
43:        if ok.sum() >= 5:
44:            ra = np.argsort(np.argsort(va[ok])).astype(float)
45:            rb = np.argsort(np.argsort(vb[ok])).astype(float)
46:            ra = ra - ra.mean(); rb = rb - rb.mean()
47:            denom = np.sqrt((ra * ra).sum() * (rb * rb).sum())
48:            if denom > 0:
49:                cs.append((ra * rb).sum() / denom)
50:    return np.nanmean(cs) if cs else np.nan
