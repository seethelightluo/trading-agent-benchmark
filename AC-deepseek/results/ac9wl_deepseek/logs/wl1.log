 = {}\nfor a, d in data.items():\n    fwd[a] = np.log(d['close'].shift(-1)/d['close'])\nfwddf = pd.DataFrame(fwd)\n\nresults = {}\nfor name, d in signals.items():\n    sdf = pd.DataFrame(d)\n    zdf = sdf.apply(cs_z, axis=1).shift(1)  # signal known at close t, applied to t+1 return\n    common = zdf.index.intersection(fwddf.index)\n    z, f = zdf.loc[common], fwddf.loc[common]\n    ics, ics26, ics24 = [], [], []\n    for dt in z.index:\n        s = z.loc[dt].values.astype(float); r = f.loc[dt].values.astype(float)\n        m = np.isfinite(s) & np.isfinite(r)\n        if m.sum() >= 8:\n            ic = spearmanr(s[m], r[m])[0]\n            ics.append(ic)\n            if dt >= '2026-01-01': ics26.append(ic)\n            if dt >= '2024-01-01': ics24.append(ic)\n    results[name] = dict(ic_full=np.nanmean(ics), icir_full=np.nanmean(ics)/np.nanstd(ics) if len(ics)>2 else np.nan,\n                         ic_24=np.nanmean(ics24), ic_26=np.nanmean(ics26), n26=len(ics26))\nres = pd.DataFrame(results).T\nres['q'] = res['ic_full'].abs()*res['icir_full'].abs()\nprint(res.round(4).sort_values('q', ascending=False).to_string())\nEOF"})
