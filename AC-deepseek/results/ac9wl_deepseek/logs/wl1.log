 117 def _load_signal_artifact(payload: dict, factor_path: Path) -> np.ndarray | None:
 118     """Load a real signal matrix when the factor provides one.
 119 
 120     A summary field such as ``max_abs_library_correlation: 0`` is never a
 121     signal artifact.  Missing matrices are intentionally returned as None so
 122     the caller can quarantine the legacy factor instead of weakening rho.
 123     """
 124     direct = payload.get("signals")
 125     artifact = payload.get("signal_artifact")
 126     validation = payload.get("validation")
 127     if isinstance(validation, dict):
 128         direct = direct if direct is not None else validation.get("signals")
 129         metrics = validation.get("metrics")
 130         if isinstance(metrics, dict):
 131             artifact = artifact or metrics.get("signal_artifact")
 132     if direct is not None:
 133         try:
 134             array = np.asarray(direct, dtype=float)
 135             return array if array.ndim >= 2 else None
 136         except (TypeError, ValueError):
 137             return None
 138     if not artifact:
 139         return None
 140     path = Path(str(artifact))
 141     if not path.is_absolute():
 142         path = factor_path.parent / path
 143     if not path.exists():
 144         return None
 145     try:
 146         if path.suffix == ".npy":
 147             array = np.load(path, allow_pickle=False)
 148         elif path.suffix == ".npz":
 149             with np.load(path, allow_pickle=False) as archive:
 150                 array = archive[archive.files[0]]
 151         else:
 152             array = np.asarray(json.loads(path.read_text(encoding="utf-8")), dtype=float)
 153         return array if array.ndim >= 2 else None
 154     except (OSError, ValueError, TypeError, json.JSONDecodeError):
 155         return None
