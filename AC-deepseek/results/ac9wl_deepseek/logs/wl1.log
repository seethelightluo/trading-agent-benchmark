40 # ---------------- reconstruct all 14 library signals on the full panel ----------------
41 lib = {}
42 lib["cz_rev1"] = -LRET.sub(LRET.mean(axis=1), axis=0).div(LRET.std(axis=1) + 1e-12, axis=0)
43 pk20 = np.sqrt((np.log(H / L) ** 2).rolling(20).mean() / (4 * np.log(2)))
44 lib["rev1_pk"] = -LRET / (pk20 + 1e-12)
45 ineff = (C / C.shift(20) - 1.0).abs() / (LRET.abs().rolling(20).sum() + 1e-12)
46 lib["rev1_x_inveff"] = LRET * (1 - ineff)
47 lib["id_rev_1d"] = -(C / O - 1.0)
48 lib["nbody_1d"] = -(C - O) / (H - L + 1e-12)
49 for k in (1, 2, 3, 5):
50     lib[f"nclv_{k}d"] = -(C - L.rolling(k).min()) / (H.rolling(k).max() - L.rolling(k).min() + 1e-12)
51 lib["rev_1d"] = -LRET
52 lib["rev_2d"] = -(np.log(C) - np.log(C.shift(2)))
53 lib["rev_3d"] = -(np.log(C) - np.log(C.shift(3)))
54 lib["rev_1d_vs"] = -LRET / (RET.rolling(20).std() + 1e-12)
55 lib["mom_10d_skip5"] = np.log(C / C.shift(10)) - np.log(C / C.shift(5))
56 lib_np = {k: v.to_numpy(dtype=float) for k, v in lib.items()}
