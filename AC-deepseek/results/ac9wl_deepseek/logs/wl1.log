        print(f"{name:20s} NO VALID IC")
        continue
    df = pd.DataFrame(fac, index=idx, columns=SYMS)
    ev = df.loc[ev_idx]
    cov = float(ev.notna().mean().mean())
    rk = df.rank(axis=1, pct=True)
    turn = float((rk.loc[ev_idx] - rk.loc[ev_idx].shift(10)).abs().mean().mean())
