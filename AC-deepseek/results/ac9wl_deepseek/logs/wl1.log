F['mom_120_20'] = close.shift(20) / close.shift(120) - 1          # 12-1 momentum
F['ramom_20d'] = F['mom_20d'] / ret.rolling(20).std()
F['ramom_60d'] = F['mom_60d'] / ret.rolling(60).std()
F['rev_1d'] = -ret
