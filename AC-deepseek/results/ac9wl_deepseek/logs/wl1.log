28 O = panel["open"].astype(float)
29 H = panel["high"].astype(float)
30 L = panel["low"].astype(float)
31 V = panel["vol"].astype(float)
32 SYMS = list(C.columns)
33 idx = C.index
34 assert idx.is_unique, "duplicate dates in panel"
35 LRET = np.log(C / C.shift(1))
36 RET = C.pct_change()
37 fwd1 = RET.shift(-1)
38 ev_idx = idx[(idx >= EVAL_START) & (idx <= END)]
