111 cands["streak_10"] = sign.rolling(10).sum().to_numpy(dtype=float)
112 cands["autocorr1_60"] = LRET.rolling(60).apply(lambda x: pd.Series(x).autocorr(1) if len(x) > 10 else np.nan, raw=True).to_numpy(dtype=float)
113 cands["ts_mom_60_z"] = zscore_win((np.log(C) - np.log(C.shift(60))).to_numpy(dtype=float), 250, 60)
114 cands["ts_mom_120_z"] = zscore_win((np.log(C) - np.log(C.shift(120))).to_numpy(dtype=float), 500, 120)
