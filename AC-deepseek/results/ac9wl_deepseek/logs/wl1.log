                "hit1": round(ic1["hit"], 3), "n_dates": ic1["n_dates"], "n_obs": ic1["n_obs"],
                "ic5": round(r["ic5"]["ic"], 4), "icir5": round(r["ic5"]["icir"], 3),
                "ic10": round(r["ic10"]["ic"], 4),
