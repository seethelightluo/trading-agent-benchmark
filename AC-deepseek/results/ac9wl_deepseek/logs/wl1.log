# Recompute pairwise signal correlation with proper NaN handling and update persisted JSONs.
import json, glob, os, numpy as np, pandas as pd
import sys
sys.path.insert(0, 'scripts')
from miner1_common import SYMBOLS, load_close

closes = load_close()
idx = None
for s, df in closes.items():
    idx = df.index if idx is None else idx.intersection(df.index)
idx = idx[idx >= pd.Timestamp('2021-01-01')]

# Reconstruct the panels from the expressions (exact same logic as persistence script)
CP = pd.DataFrame({s: closes[s]['close'].reindex(idx).astype(float) for s in SYMBOLS})
OP = pd.DataFrame({s: closes[s]['open'].reindex(idx).astype(float) for s in SYMBOLS})
HP = pd.DataFrame({s: closes[s]['high'].reindex(idx).astype(float) for s in SYMBOLS})
LP = pd.DataFrame({s: closes[s]['low'].reindex(idx).astype(float) for s in SYMBOLS})
RET = CP.pct_change()
panels = {}
for nd in (1,2,3,5):
    panels[f"rev_{nd}d"] = -np.log(CP / CP.shift(nd))
for nd in (1,2,3,5):
    hmax = HP.rolling(nd).max(); lmin = LP.rolling(nd).min()
    rng = (hmax-lmin).replace(0, np.nan)
    panels[f"nclv_{nd}d"] = -(CP - lmin)/rng
rng1 = (HP-LP).replace(0, np.nan)
panels["nbody_1d"] = -(CP-OP)/rng1
panels["id_rev_1d"] = -(CP/OP - 1.0)
panels["rev_1d_vs"] = -np.log(CP/CP.shift(1))/(RET.rolling(20).std()+1e-12)

def panel_corr(a, b):
    A = a.values.astype(float); B = b.values.astype(float)
    m = np.isfinite(A) & np.isfinite(B)
    n = m.sum()
    if n < 50: return np.nan
    x = A[m]; y = B[m]
    if x.std()==0 or y.std()==0: return np.nan
    return float(np.corrcoef(x,y)[0,1])

names = list(panels.keys())
corr = {}
for i in range(len(names)):
    for j in range(i+1, len(names)):
        rho = panel_corr(panels[names[i]], panels[names[j]])
        if np.isfinite(rho):
            corr[f"{names[i]}|{names[j]}"] = round(rho,3)
        else:
            corr[f"{names[i]}|{names[j]}"] = np.nan
print("pairwise correlations:")
for k,v in sorted(corr.items()):
    print(f"  {k:24s} {v:+.3f}")

# Map each factor to its panel
import re
def panel_for(expr):
    # dirty: use the factor short name from the file id
    return None

files = sorted(glob.glob('factors/miner2_20260715_*.json'))
for f in files:
    d = json.load(open(f))
    name = d['factor_id'].replace('miner2_20260715_','')
    if name in panels:
        p = panels[name]
        # max_abs_library_correlation: vs all OTHER persisted factors
        rhos = []
        for other in files:
            d2 = json.load(open(other))
            name2 = d2['factor_id'].replace('miner2_20260715_','')
            if name2 == name or name2 not in panels:
                continue
            r = panel_corr(p, panels[name2])
            if np.isfinite(r):
                rhos.append(abs(r))
        # also vs miner3 files
        for mf in glob.glob('factors/miner3_20260716_*.json'):
            d3 = json.load(open(mf))
            # miner3 factors: clv_5d = nclv_5d, rev_1d = rev_1d
            base = d3['factor_id'].replace('miner3_20260716_','')
            if base in panels and base != name:
                r = panel_corr(p, panels[base])
                if np.isfinite(r):
                    rhos.append(abs(r))
        maxrho = round(max(rhos),3) if rhos else 0.0
        # sibling corr only among the 11 persisted miner2 names
        sib = {k:v for k,v in corr.items() if name in k and k.replace(f"{name}|","").replace(f"|{name}","") in panels}
        d['validation']['metrics']['sibling_signal_corr'] = {k:(None if not np.isfinite(v) else v) for k,v in sib.items()}
        d['validation']['metrics']['max_abs_library_correlation'] = maxrho
        with open(f,'w') as fh:
            json.dump(d, fh, indent=2)
        print(f"updated {d['factor_id']}: max_abs_lib_rho={maxrho}, n_sib={len(sib)}")
