        if p.endswith(".npy") and os.path.exists(p):
            return pd.DataFrame(np.load(p), index=idx, columns=SYMBOLS)
        return None
    if isinstance(sa, dict):
        fmt = str(sa.get("format", ""))
        if "gzip" in fmt and "n_dates" in sa:
