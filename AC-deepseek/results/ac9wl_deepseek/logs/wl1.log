 127     return pd.DataFrame(out)
 128 
 129 for win in (30, 60, 120):
 130     b_dxy = roll_beta(RET, dxy_r, win)
 131     b_vix = roll_beta(RET, vix_c, win)
 132     b_cny = roll_beta(RET, usdcny_r, win)
 133     cands[f"beta_dxy_{win}"] = b_dxy
 134     cands[f"negbeta_dxy_{win}"] = -b_dxy
 135     cands[f"beta_vix_{win}"] = b_vix
 136     cands[f"negbeta_vix_{win}"] = -b_vix
 137     cands[f"beta_cny_{win}"] = b_cny
 138     # USD trend tilt: when USD trends down, favor assets with negative DXY beta
 139     dxy_trend = np.sign(dxy_r.rolling(win).mean())
 140     # NOTE: DataFrame * Series aligns Series index vs DataFrame COLUMNS (outer join)
 141     # -> 15 symbol cols + N date cols. Must broadcast row-wise with axis=0.
 142     cands[f"usd_tilt_{win}"] = -b_dxy.mul(dxy_trend, axis=0)
 143     # VIX level tilt: risk-on in low VIX regime
 144     vix_hi = (VIX > VIX.rolling(252).median()).astype(float)
 145     cands[f"risk_off_tilt_{win}"] = -b_vix.mul(vix_hi, axis=0)
 146 
 147 res = [run(n, p) for n, p in cands.items()]
 148 print(f"\nscreen done {time.time()-t0:.1f}s | {len(res)} candidates | {sum(r['passed'] for r in res)} PASSED gate")
 149 print("\n=== sorted by |IC1| ===")
 150 for r in sorted(res, key=lambda r: -abs(r["ic"][1]["ic"])):
 151     mark = "PASS" if r["passed"] else "   "
 152     print(f"[{mark}] {r['name']:22s} IC1={r['ic'][1]['ic']:+.4f} ICIR1={r['ic'][1]['icir']:+.3f} hit={r['ic'][1]['hit']:.3f}")

