  87 def _walk_dicts(
  88     value: Any, path: tuple[str, ...] = ()
  89 ) -> Iterable[tuple[tuple[str, ...], dict]]:
  90     if isinstance(value, dict):
  91         yield path, value
  92         for key, child in value.items():
  93             yield from _walk_dicts(child, path + (str(key),))
  94     elif isinstance(value, list):
  95         for index, child in enumerate(value):
  96             yield from _walk_dicts(child, path + (str(index),))
