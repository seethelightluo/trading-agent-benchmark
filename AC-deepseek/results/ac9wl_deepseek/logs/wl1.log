1 """Miner2 shared fast vectorized helpers: IC analysis on common-date panels."""
   2 import numpy as np
   3 import pandas as pd
   4 
   5 MIN_NAMES = 8
   6 
   7 
   8 def fwd_returns(closes, fwd_days=1):
   9     cols = {}
  10     for s, df in closes.items():
  11         cols[s] = df["close"].shift(-fwd_days) / df["close"] - 1.0
  12     return pd.DataFrame(cols)
  13 
  14 
  15 def fast_ic(factor_df, fwd_df, min_names=MIN_NAMES, rank=True):
  16     idx = factor_df.index.intersection(fwd_df.index)
  17     F = factor_df.reindex(idx).astype(float)
  18     R = fwd_df.reindex(idx).astype(float)
  19     if rank:
  20         F = F.rank(axis=1)
  21         R = R.rank(axis=1)
  22     Fv = F.values
  23     Rv = R.values
  24     mask = np.isfinite(Fv) & np.isfinite(Rv)
  25     n = mask.sum(axis=1)
  26     ok = n >= min_names
  27     if not ok.any():
  28         return {"n_dates": 0, "n_obs": 0, "ic": np.nan, "icir": np.nan,
  29                 "hit": np.nan, "ic_std": np.nan}
  30     Fm = np.where(mask, Fv, 0.0)
  31     Rm = np.where(mask, Rv, 0.0)
  32     sx = Fm.sum(axis=1)
  33     sy = Rm.sum(axis=1)
  34     sxx = (Fm * Fm).sum(axis=1)
  35     syy = (Rm * Rm).sum(axis=1)
  36     sxy = (Fm * Rm).sum(axis=1)
  37     with np.errstate(all="ignore"):
  38         num = n * sxy - sx * sy
  39         den = np.sqrt((n * sxx - sx * sx) * (n * syy - sy * sy))
  40         ic = num / den
  41     ic = ic[ok]
  42     ic = ic[np.isfinite(ic)]
  43     if len(ic) == 0:
  44         return {"n_dates": 0, "n_obs": 0, "ic": np.nan, "icir": np.nan,
  45                 "hit": np.nan, "ic_std": np.nan}
  46     return {"n_dates": int(len(ic)), "n_obs": int(n[ok].sum()),
  47             "ic": float(ic.mean()),
  48             "icir": float(ic.mean() / ic.std()) if ic.std() > 0 else np.nan,
  49             "hit": float((ic > 0).mean()), "ic_std": float(ic.std())}
  50 
  51 
  52 def ic_all(factor_df, closes, horizons=(1, 2, 3, 5, 10, 20, 30), min_names=MIN_NAMES):
  53     out = {}
  54     for h in horizons:
  55         fwd = fwd_returns(closes, h)
  56         out[h] = fast_ic(factor_df, fwd, min_names)
  57     return out
  58 
  59 
  60 def turnover10(factor_df, rebal=10):
  61     ranks = factor_df.rank(axis=1)
  62     chg = []
  63     for i in range(rebal, len(ranks)):
  64         prev = ranks.iloc[i - rebal].dropna()
  65         cur = ranks.iloc[i].dropna()
  66         common = prev.index.intersection(cur.index)
  67         if len(common) < 2:
  68             continue
  69         chg.append((cur[common] - prev[common]).abs().mean() / (len(common) - 1))
  70     return float(np.mean(chg)) if chg else np.nan
