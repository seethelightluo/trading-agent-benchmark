vol20 = RET.rolling(20).std()
for nd in (1, 2, 5):
    cands[f"rev_{nd}d_vs"] = -np.log(CP / CP.shift(nd)) / vol20

res = {n: run(n, p) for n, p in cands.items()}

# ---- deeper detail for rev_1d and rev_5d ----
