        a = passers[pn[i]]["panel"].stack().dropna()
        b = passers[pn[j]]["panel"].stack().dropna()
        common = a.index.intersection(b.index)
        if len(common) > 50:
            rho = np.corrcoef(a.loc[common].values, b.loc[common].values)[0, 1]
