  ▶️ shell({'command': 'python - <<\'EOF\'\nimport pandas as pd, numpy as np, glob, os\nfiles = sorted(glob.glob(\'../persistent/stock_data/*.csv\'))\nassets = [os.path.basename(f)[:-4] for f in files]\ndata = {}\nfor f in files:\n    a = os.path.basename(f)[:-4]\n    df = pd.read_csv(f)\n    df[\'date\'] = pd.to_datetime(df[\'date\'])\n    df = df[df[\'date\'] <= \'2026-07-15\'].set_index(\'date\').sort_index()\n    data[a] = df[[\'open\',\'close\',\'high\',\'low\']].astype(float)\n\n# Build factor signals (long-only cross-sectional rank z)\ndef cs_z(s):\n    return (s - s.mean())/s.std(ddof=0)\n\nsignals = {}\nfor a, d in data.items():\n    c, o, h, l = d[\'close\'], d[\'open\'], d[\'high\'], d[\'low\']\n    r1 = np.log(c/c.shift(1))\n    r2 = np.log(c/c.shift(2))\n    r3 = np.log(c/c.shift(3))\n    signals.setdefault(\'nclv_1d\', {})[a] = -(c - l) / (h - l)\n    signals.setdefault(\'nclv_2d\', {})[a] = -(c - l.rolling(2).min()) / (h.rolling(2).max() - l.rolling(2).min())\n    signals.setdefault(\'nclv_3d\', {})[a] = -(c - l.rolling(3).min()) / (h.rolling(3).max() - l.rolling(3).min())\n    signals.setdefault(\'nclv_5d\', {})[a] = -(c - l.rolling(5).min()) / (h.rolling(5).max() - l.rolling(5).min())\n    signals.setdefault(\'nbody_1d\', {})[a] = -(c - o) / (h - l)\n    signals.setdefault(\'id_rev_1d\', {})[a] = -(c/o - 1)\n    signals.setdefault(\'rev_1d\', {})[a] = -r1\n    signals.setdefault(\'rev_2d\', {})[a] = -r2\n    signals.setdefault(\'rev_3d\', {})[a] = -r3\n    signals.setdefault(\'cz_rev1\', {})[a] = -r1  # cs_z applied cross-sectionally below\n    signals.setdefault(\'rev_1d_vs\', {})[a] = -r1 / r1.rolling(20).std()\n    signals.setdefault(\'rev1_pk\', {})[a] = -r1 / np.sqrt(((np.log(h/l))**2).rolling(20).mean() / (4*np.log(2)))\n    signals.setdefault(\'x_inveff\', {})[a] = r1 * (1 - (c/c.shift(20)-1).abs() / r1.abs().rolling(20).sum())\n    signals.setdefault(\'mom_10d_skip5\', {})[a] = (np.log(c/c.shift(10)) - np.log(c/c.shift(5)))\n\n# Build cross-sectional rank-IC style series: for each date, cs rank of signal; compute pairwise corr of these series\nfrom scipy.stats import rankdata\nfacs = {}\nfor name, d in signals.items():\n    sdf = pd.DataFrame(d)\n    # cross-sectional z per date\n    zdf = sdf.apply(lambda row: (row - row.mean())/row.std(ddof=0), axis=1)\n    facs[name] = zdf\n\nnames = list(facs.keys())\n# align\naligned = {}\nfor n in names:\n    aligned[n] = facs[n].loc[\'2024-01-01\':\'2026-07-15\']\n# pairwise mean abs spearman of cross-sectional signal series (use flatten rank corr on stacked panel? simpler: correlation of mean per-date signal vectors is not right)\n# Instead compute daily cross-sectional correlation between factor i and j: for each date, corr across 15 assets, then average\ncorr_mat = pd.DataFrame(index=names, columns=names, dtype=float)\nfor i in names:\n    for j in names:\n        rs = []\n        xi, xj = aligned[i], aligned[j]\n        common = xi.index.intersection(xj.index)\n        for dt in common:\n            a = xi.loc[dt].values.astype(float); b = xj.loc[dt].values.astype(float)\n            m = np.isfinite(a) & np.isfinite(b)\n            if m.sum() >= 8:\n                rs.append(np.corrcoef(a[m], b[m])[0,1])\n        corr_mat.loc[i,j] = np.nanmean(rs) if rs else np.nan\nnp.set_printoptions(precision=2, suppress=True)\nprint("Mean cross-sectional correlation of factor signals (2024-01..2026-07):")\nprint(corr_mat.round(2).to_string())\nEOF'})
