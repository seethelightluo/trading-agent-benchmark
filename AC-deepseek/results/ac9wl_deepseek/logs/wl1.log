18:def fast_ic(factor_df, fwd_df, min_names=MIN_NAMES, rank=True):
19:    """Vectorized daily cross-sectional IC between factor and forward return."""
20:    idx = factor_df.index.intersection(fwd_df.index)
21:    F = factor_df.reindex(idx).astype(float)
22:    R = fwd_df.reindex(idx).astype(float)
23:    if rank:
24:        F = F.rank(axis=1)
25:        R = R.rank(axis=1)
26:    Fv = F.values
27:    Rv = R.values
28:    mask = np.isfinite(Fv) & np.isfinite(Rv)
29:    n = mask.sum(axis=1)
30:    ok = n >= min_names
31:    if not ok.any():
32:        return {"n_dates": 0, "n_obs": 0, "ic": np.nan, "icir": np.nan,
33:                "hit": np.nan, "ic_std": np.nan}
34:    Fm = np.where(mask, Fv, 0.0)
35:    Rm = np.where(mask, Rv, 0.0)
36:    sx = Fm.sum(axis=1)
37:    sy = Rm.sum(axis=1)
38:    sxx = (Fm * Fm).sum(axis=1)
39:    syy = (Rm * Rm).sum(axis=1)
40:    sxy = (Fm * Rm).sum(axis=1)
41:    with np.errstate(all="ignore"):
42:        num = n * sxy - sx * sy
43:        den = np.sqrt((n * sxx - sx * sx) * (n * syy - sy * sy))
44:        ic = num / den
45:    ic = ic[ok]
46:    ic = ic[np.isfinite(ic)]
47:    if len(ic) == 0:
48:        return {"n_dates": 0, "n_obs": 0, "ic": np.nan, "icir": np.nan,
49:                "hit": np.nan, "ic_std": np.nan}
50:    return {"n_dates": int(len(ic)), "n_obs": int(n[ok].sum()),
51:            "ic": float(ic.mean()),
52:            "icir": float(ic.mean() / ic.std()) if ic.std() > 0 else np.nan,
53:            "hit": float((ic > 0).mean()), "ic_std": float(ic.std())}
