                meta = json.load(f)
        except Exception:
            continue
        fid = meta.get('factor_id')
        if not fid or fid == 'factor_ensemble':
            continue
        exp = meta.get('calculation', {}).get('expression', '')
        try:
            other = compute_library_signal(exp)
        except Exception:
            continue
        if other is None:
            continue
        both = pd.concat

