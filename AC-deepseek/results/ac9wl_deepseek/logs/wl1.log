b_vix = {w: pd.DataFrame({s: roll_beta(RET[s], vix.pct_change(), w) for s in SYMS}) for w in (60, 120)}

panels["beta_spx60_x_spxtrend"] = b_spx[60] * np.sign(spx_trend)
