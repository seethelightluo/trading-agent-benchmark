def beta_to(x, y, win=60):
    """rolling beta of x on y"""
    out = {}
    for a in x.columns:
        z = pd.concat([x[a].rename('x'), y.rename('y')], axis=1).dropna()
        cov = z['x'].rolling(win).cov(z['y'])
        var = z['y'].rolling(win).var()
        out[a] = cov / var
    return pd.DataFrame(out)

