import json, glob, os, re, base64, gzip
import numpy as np, pandas as pd
import pickle

# Build calendar: union of dates across all stock csvs
cal = pd.Index([], dtype='datetime64[ns]')
for s in ["000300.SH","SPX","HSI","N225","SX5E","000688.SH","SOX","NDX","XAU","COPPER","WTI","BTC","ETH","US10Y","CN10Y"]:
    d = pd.read_csv(f'../persistent/stock_data/{s}.csv')
    dt = pd.DatetimeIndex(pd.to_datetime(d['date']))
    cal = cal.union(dt)
cal = pd.DatetimeIndex(sorted(cal))
print("calendar dates:", len(cal), cal.min().date(), cal.max().date())

files = sorted(glob.glob('factors/*.json'))
files = [f for f in files if not f.endswith('.bak')]
def is_ts(b):
    return bool(re.search(r'\.\d{8}T\d{9}\.json$', b))
canon = {}
for f in files:
    b = os.path.basename(f)
    if is_ts(b):
        continue
    d = json.load(open(f))
    canon[d.get('factor_id')] = f

sig = {}
for fid, f in sorted(canon.items()):
    d = json.load(open(f))
    sa = d.get('signal_artifact')
    if isinstance(sa, str):
        arr = np.load(f"factors/{sa}")
        idx = cal.iloc[-arr.shape[0]:]
        sig[fid] = pd.DataFrame(arr, index=idx, columns=d.get('signal_artifact') and None or None)
        # get symbols from a dict factor
        syms = None
        for f2 in canon.values():
            d2 = json.load(open(f2))
            if isinstance(d2.get('signal_artifact'), dict) and d2['signal_artifact']['symbols']:
                syms = d2['signal_artifact']['symbols']; break
        sig[fid] = pd.DataFrame(arr, index=idx, columns=syms)
        print(fid, "npy aligned", arr.shape, idx.min().date(), idx.max().date())
        continue
    syms = sa['symbols']; nd = sa['n_dates']
    de = pd.Timestamp(sa['date_end'])
    idx = cal[cal <= de].iloc[-nd:]
    raw = gzip.decompress(base64.b64decode(sa['data_b64']))
    arr = np.frombuffer(raw, dtype=np.float32).reshape(nd, len(syms))
    sig[fid] = pd.DataFrame(arr, index=idx, columns=syms)
    print(fid, arr.shape, idx.min().date(), idx.max().date())

with open('scripts/_screen_signals.pkl','wb') as fh:
    pickle.dump({'sig': sig, 'cal': cal}, fh)
print("saved", len(sig))
