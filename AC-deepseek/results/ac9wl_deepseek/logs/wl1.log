    rng = (df.iloc[:, 2] - df.iloc[:, 3])
    _p.loc[df.index, c] = (df.iloc[:, 1] - df.iloc[:, 0]) / rng.replace(0, np.nan)
body = _p

print("\n[body_pos_1d vs library] pooled spearman:")
for k, v in lib.items():
