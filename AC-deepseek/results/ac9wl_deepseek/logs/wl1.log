  ▶️ shell({'command': 'python - <<\'EOF\'\nimport pickle, numpy as np, pandas as pd\nwith open(\'scripts/_screen_signals.pkl\',\'rb\') as f:\n    d = pickle.load(f)\nsig = d[\'sig\']\nnames = list(sig.keys())\n# Align on common dates\nframes = []\nfor n in names:\n    s = sig[n]\n    frames.append(s.rename(columns={c: f"{n}|{c}" for c in s.columns}))\naligned = pd.concat(frames, axis=1)\ndates = aligned.index\nprint("dates:", len(dates), dates[0], dates[-1])\n# For each date, compute cross-sectional correlation of the 15-asset exposure vectors between factor pairs; average over dates\nn = len(names)\ncorr_sum = np.zeros((n,n))\ncnt = 0\nfor dt in dates:\n    row = aligned.loc[dt]\n    X = np.zeros((15, n))\n    ok = True\n    for j, nm in enumerate(names):\n        x = row[[f"{nm}|{c}" for c in sig[nm].columns]].values.astype(float)\n        X[:, j] = x\n    if np.isnan(X).any():\n        continue\n    # cross-sectional correlation matrix (columns = factors)\n    Xc = X - X.mean(axis=0, keepdims=True)\n    sd = X.std(axis=0)\n    if (sd==0).any():\n        continue\n    C = Xc.T @ Xc / (15-1)\n    C = C / np.outer(sd, sd)\n    corr_sum += C\n    cnt += 1\nCavg = corr_sum / cnt\nprint("avg over", cnt, "dates")\ndf = pd.DataFrame(Cavg, index=names, columns=names)\npd.set_option(\'display.width\', 250)\npd.set_option(\'display.max_columns\', 20)\nprint(df.round(2))\nEOF'})
