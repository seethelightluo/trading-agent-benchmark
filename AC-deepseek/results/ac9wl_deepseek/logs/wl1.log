# Reproduce the gate's pooled-rho computation precisely for rev5x_er_soft vs mom_10d_skip5
import numpy as np
from scipy.stats import spearmanr

A = np.load('factors/miner1_20260716_rev5x_er_soft.npy')
B = np.load('factors/miner2_20260716_mom_10d_skip5.npy')
print('shapes', A.shape, B.shape)
print('A finite:', np.isfinite(A).sum(), 'B finite:', np.isfinite(B).sum())

# Pooled overlap (both finite same position)
mask = np.isfinite(A) & np.isfinite(B)
print('both finite:', mask.sum())
rho = spearmanr(A[mask], B[mask]).statistic
print('pooled spearman (overlap positions):', rho)

# Try gate-style: maybe it align-flattens all values ignoring position? Same as above
# Try filling NaN with 0 for z-scored? 
Af = np.nan_to_num(A, nan=0.0)
Bf = np.nan_to_num(B, nan=0.0)
print('fill0 spearman:', spearmanr(Af.ravel(), Bf.ravel()).statistic)

# Try per-column (cross-sectional) correlation averaged? 
col_rhos = []
for j in range(A.shape[1]):
    a = A[:,j]; b = B[:,j]
    m = np.isfinite(a) & np.isfinite(b)
    if m.sum() > 10:
        col_rhos.append(spearmanr(a[m], b[m]).statistic)
print('n cols with data:', len(col_rhos), 'mean col rho:', np.mean(col_rhos), 'max abs:', np.max(np.abs(col_rhos)))
