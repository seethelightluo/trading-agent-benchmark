14:    sa = d.get('signal_artifact')
15:    if isinstance(sa, dict) and 'data_b64' in sa:
16:        raw = base64.b64decode(sa['data_b64'])
17:        arr = np.frombuffer(gzip.decompress(raw), dtype=np.float32).reshape(sa['n_dates'], sa['n_symbols'])
18:        return arr
19:    elif isinstance(sa, str) and sa.endswith('.npy'):
20:        return np.load(os.path.join('factors', sa))
