  ▶️ shell({'command': 'python - <<\'EOF\'\nimport pickle, numpy as np, pandas as pd\nwith open(\'scripts/_screen_signals.pkl\',\'rb\') as f:\n    d = pickle.load(f)\nsig = d[\'sig\']\nnames = list(sig.keys())\nn = len(names)\n# Pairwise: for each date where both factor vectors fully observed, compute cross-sectional corr; average over dates\ndef cs_corr(x, y):\n    m = ~(np.isnan(x) | np.isnan(y))\n    if m.sum() < 5: return np.nan\n    x = x[m]; y = y[m]\n    x = x - x.mean(); y = y - y.mean()\n    sx, sy = x.std(), y.std()\n    if sx == 0 or sy == 0: return np.nan\n    return float((x*y).mean() / (sx*sy))\ncorr = {}\nfor i in range(n):\n    for j in range(i+1, n):\n        a, b = names[i], names[j]\n        sa, sb = sig[a], sig[b]\n        common = sa.index.intersection(sb.index)\n        vals = []\n        for dt in common:\n            va = sa.loc[dt].values.astype(float)\n            vb = sb.loc[dt].values.astype(float)\n            c = cs_corr(va, vb)\n            if not np.isnan(c): vals.append(c)\n        corr[(a,b)] = (np.mean(vals) if vals else np.nan, len(vals))\nprint("Pairwise avg cross-sectional signal correlation (dates>=500):")\nfor (a,b),(c,nn) in sorted(corr.items(), key=lambda kv: -abs(kv[1][0])):\n    if nn >= 500:\n        flag = " <-- HIGH" if abs(c) > 0.7 else ""\n        print(f"{a[:28]:30s} vs {b[:28]:30s}: {c:+.3f}  (n={nn}){flag}")\nEOF'})
