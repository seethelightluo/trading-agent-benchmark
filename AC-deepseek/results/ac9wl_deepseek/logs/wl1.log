193: def evaluate_factor(payload: dict, contract: FactorContract) -> dict[str, Any]:
194:     validation = payload.get("validation") if isinstance(payload, dict) else None
195:     status = str((validation or {}).get("status", "")).upper()
196:     if status not in {"EFFECTIVE", "ACTIVE"}:
197:         raise ValueError("factor validation.status must be EFFECTIVE or ACTIVE")
198: 
199:     passing = [
200:         pair for pair in _metric_pairs(payload)
201:         if abs(pair[0]) >= contract.ic_threshold and abs(pair[1]) >= contract.icir_threshold
202:     ]
203:     if not passing:
204:         raise ValueError(
205:             "factor has no same-horizon IC/ICIR pair passing "
206:             f"|IC|>={contract.ic_threshold:.4f} and |ICIR|>={contract.icir_threshold:.4f}"
207:         )
208:     selected = max(passing, key=lambda pair: abs(pair[0]) * abs(pair[1]))
209: 
210:     # The AC Miner field is provenance/audit metadata, not the conflict gate.
211:     # The native prompt asks the model to self-report a library correlation,
212:     # but the benchmark contract must compare both real signal artifacts on a
213:     # common sample.  Rejecting a candidate here would prevent the lower/higher
214:     # quality comparison required by the worldline contract.
215:     reported_correlation, correlation_path = _find_correlation(payload)
216:     return {
217:         "ic": selected[0],
218:         "icir": selected[1],
219:         "metric_path": selected[2],
220:         "reported_max_abs_library_correlation": reported_correlation,
221:         "correlation_path": correlation_path,
222:         "quality": abs(selected[0]) * abs(selected[1]),
223:     }
