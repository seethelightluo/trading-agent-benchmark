cands["pv_corr_20d"] = RET.rolling(20, min_periods=MP(20)).corr(VOL.pct_change())

# ---------- G. drawdown ----------
cands["max_dd_60d"] = CP.rolling(60, min_periods=MP(60)).max() / CP - 1.0
