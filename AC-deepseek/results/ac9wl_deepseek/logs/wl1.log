1 """miner_3 cycle-7 screening: orthogonal factor families on FULL 2388-row panel.
2 
3 Context:
4 - Library (14 distinct effective factors) is dominated by 1-5d mean-reversion
5   signals (rev_1d/2d/3d, nclv_1d..5d, id_rev, nbody, cz_rev1, rev1_pk,
6   rev1_x_inveff, rev_1d_vs) plus mom_10d_skip5 (used negatively = reversal).
7 - Previous miner3 candidates got evicted by the post-Miner gate because pooled
8   rho vs miner2_20260716_mom_10d_skip5 exceeded 0.5 (often ~0.88 due to
9   shared short-horizon return structure).
10 - This cycle tests genuinely different families: long-horizon reversal,
11   volatility asymmetry/tail, trend structure, cross-asset beta (BTC/US10Y/XAU/
12   WTI), overnight/intraday share, volume-conditioned, and robust RSI-2.
13 
14 Gate: |IC1| >= 0.007, |ICIR1| >= 0.084 (1d forward rank IC on
15 2021-01-04..2026-07-15), max_abs_library_correlation < 0.5 (pooled spearman
16 on the full panel grid).
17 """
18 import json
19 import numpy as np
20 import pandas as pd
21 from scipy.stats import spearmanr
22 
23 EVAL_START = pd.Timestamp("2021-01-04")
24 END = pd.Timestamp("2026-07-15")
25 GATE_IC, GATE_ICIR = 0.0070, 0.0840
26 
27 panel = pd.read_pickle("scripts/panel_cache.pkl")
28 C = panel["close"].astype(float)
29 O = panel["open"].astype(float)
30 H = panel["high"].astype(float)
31 L = panel["low"].astype(float)
32 V = panel["vol"].astype(float)
33 SYMS = list(C.columns)
34 idx = C.index
35 assert idx.is_unique, "duplicate dates in panel"
36 LRET = np.log(C / C.shift(1))
37 RET = C.pct_change()
38 fwd1 = RET.shift(-1)
39 ev_idx = idx[(idx >= EVAL_START) & (idx <= END)]
40 
41 # ---------------- reconstruct all 14 library signals on the full panel ----------------
42 lib = {}
43 lib["cz_rev1"] = -LRET.sub(LRET.mean(axis=1), axis=0).div(LRET.std(axis=1) + 1e-12, axis=0)
44 pk20 = np.sqrt((np.log(H / L) ** 2).rolling(20).mean() / (4 * np.log(2)))
45 lib["rev1_pk"] = -LRET / (pk20 + 1e-12)
46 ineff = (C / C.shift(20) - 1.0).abs() / (LRET.abs().rolling(20).sum() + 1e-12)
47 lib["rev1_x_inveff"] = LRET * (1 - ineff)
48 lib["id_rev_1d"] = -(C / O - 1.0)
49 lib["nbody_1d"] = -(C - O) / (H - L + 1e-12)
50 for k in (1, 2, 3, 5):
51     lib[f"nclv_{k}d"] = -(C - L.rolling(k).min()) / (H.rolling(k).max() - L.rolling(k).min() + 1e-12)
52 lib["rev_1d"] = -LRET
53 lib["rev_2d"] = -(np.log(C) - np.log(C.shift(2)))
54 lib["rev_3d"] = -(np.log(C) - np.log(C.shift(3)))
55 lib["rev_1d_vs"] = -LRET / (RET.rolling(20).std() + 1e-12)
56 lib["mom_10d_skip5"] = np.log(C / C.shift(10)) - np.log(C / C.shift(5))
57 lib_np = {k: v.to_numpy(dtype=float) for k, v in lib.items()}
58 
59 # verify against real artifact
60 mom_art = np.load("factors/miner2_20260716_mom_10d_skip5.npy", allow_pickle=True)
61 a = lib_np["mom_10d_skip5"].ravel(); b = mom_art.astype(float).ravel()
62 m = (~np.isnan(a)) & (~np.isnan(b))
63 print("lib recon check mom_10d_skip5 pooled rho vs .npy: %.8f (%d pairs)" % (spearmanr(a[m], b[m]).statistic, m.sum()))
64 
65 
66 def pooled_rho(a, b, min_n=500):
67     a = np.asarray(a, dtype=float).ravel()
68     b = np.asarray(b, dtype=float).ravel()
69     m = (~np.isnan(a)) & (~np.isnan(b))
70     if m.sum() < min_n:
71         return float("nan")
72     return float(spearmanr(a[m], b[m]).statistic)
73 
74 
75 def zscore_win(X, win=120, minp=40):
76     df = pd.DataFrame(X, index=idx, columns=SYMS)
77     mu = df.rolling(win, min_periods=minp).mean()
78     sd = df.rolling(win, min_periods=minp).std()
79     return ((df - mu) / (sd + 1e-12)).to_numpy(dtype=float)
80 
81 
82 def zscore_full(X):
83     """per-symbol full-sample z-score (removes cross-asset level effects)"""
84     df = pd.DataFrame(X, index=idx, columns=SYMS)
85     return df.sub(df.mean()).div(df.std() + 1e-12).to_numpy(dtype=float)
86 
87 
88 # ---------------- candidates ----------------
89 cands = {}
90 
91 # A. long-horizon reversal (classic, distinct from 1-5d library)
92 cands["rev_120d_z"] = zscore_win(-(np.log(C) - np.log(C.shift(120))).to_numpy(dtype=float), 250, 60)
93 cands["rev_250d_z"] = zscore_win(-(np.log(C) - np.log(C.shift(250))).to_numpy(dtype=float), 500, 120)
94 
95 # B. volatility asymmetry / tail
96 pos = RET.where(RET > 0, 0.0)
97 neg = (-RET).where(RET < 0, 0.0)
98 cands["down_up_vol_20"] = (neg.rolling(20).std() / (pos.rolling(20).std() + 1e-12)).to_numpy(dtype=float)
99 std20 = LRET.rolling(20).std()
100 tail = (RET.abs() > 2 * std20).astype(float)
101 cands["tail_freq_60"] = tail.rolling(60).mean().to_numpy(dtype=float)
102 cands["skew_60_z"] = zscore_win(LRET.rolling(60).skew().to_numpy(dtype=float), 250, 60)
103 cands["kurt_60_z"] = zscore_win(LRET.rolling(60).kurt().to_numpy(dtype=float), 250, 60)
104 rng = (H - L) / C.shift(1)
105 rng_mean = rng.rolling(20).mean()
106 rng_sd = rng.rolling(20).std()
107 cands["range_shock_20"] = ((rng - rng_mean) / (rng_sd + 1e-12)).to_numpy(dtype=float)
108 
109 # C. trend structure
110 cands["eff_ratio_20"] = ((C - C.shift(20)).abs() / (C.diff().abs().rolling(20).sum() + 1e-12)).to_numpy(dtype=float)
111 sign = np.sign(RET)
112 cands["streak_10"] = sign.rolling(10).sum().to_numpy(dtype=float)

