    "mom_120d_skip20": mom(120, skip=20),
    "sharpe_60d": rs_mom(60),
    "ts_mom_60d": ts_mom(60),
    "ma20_60_slope": ma_slope(20, 60),
    "ma60_120_slope": ma_slope(60, 120),
    "close_vs_ma60": close_vs_ma(60),
