"""Diagnose where the miner3 volatility script is slow."""
import sys, os, time
import numpy as np
import pandas as pd
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from miner1_common import SYMBOLS, load_close, factor_panel, ic_analysis

