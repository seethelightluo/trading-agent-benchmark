81 def zscore_full(X):
82     """per-symbol full-sample z-score (removes cross-asset level effects)"""
83     df = pd.DataFrame(X, index=idx, columns=SYMS)
84     return df.sub(df.mean()).div(df.std() + 1e-12).to_numpy(dtype=float)
