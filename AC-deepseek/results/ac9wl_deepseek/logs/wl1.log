        r = ranked[name].loc[d].dropna()
        y = ret.loc[d].dropna()
        idx = r.index.intersection(y.index)
        if len(idx) >= 5:
            ics.append(spearmanr(r.loc[idx], y.loc[idx]).statistic)
    ics = [x for x in ics if x == x]
    print(f"{name:16s} ic1={np.mean(ics):+.4f} n={len(ics)}")

# recent regime stats
