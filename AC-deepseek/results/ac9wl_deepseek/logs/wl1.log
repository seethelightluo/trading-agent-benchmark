import numpy as np, pandas as pd
from scipy.stats import spearmanr
pd.set_option('display.width', 200)
panel = pd.read_pickle("scripts/panel_cache.pkl")
C = panel["close"].astype(float); O=panel["open"].astype(float)
H=panel["high"].astype(float); L=panel["low"].astype(float); V=panel["vol"].astype(float)
idx=C.index; SYMS=list(C.columns); RET=C.pct_change(); LRET=np.log(C/C.shift(1))
fwd1=RET.shift(-1)
EVAL_START=pd.Timestamp("2021-01-04"); END=pd.Timestamp("2026-07-15")
ev_idx = idx[(idx>=EVAL_START)&(idx<=END)]
mom = np.load("factors/miner2_20260716_mom_10d_skip5.npy", allow_pickle=True)
print("panel:", C.shape, "eval n:", len(ev_idx), "mom:", mom.shape)

def pooled_rho(a,b):
    m=(~np.isnan(a))&(~np.isnan(b)&~np.isnan(mom))
    if m.sum()<500: return float('nan')
    return float(spearmanr(a[m], b[m]).statistic)

def ic_stats(fac):
    df=pd.DataFrame(fac,index=idx,columns=SYMS)
    ev=df.loc[ev_idx]; fw=fwd1.loc[ev_idx]
    ics=[]
    for dt in ev.index:
        f=ev.loc[dt].dropna(); r=fw.loc[dt].reindex(f.index).dropna()
        common=f.index.intersection(r.index)
        if len(common)<8: continue
        x=f[common].astype(float).rank(); y=r[common].astype(float).rank()
        if x.std()==0 or y.std()==0: continue
        ic=np.corrcoef(x,y)[0,1]
        if np.isfinite(ic): ics.append(ic)
    ics=np.array(ics)
    if len(ics)==0: return None
    return dict(ic=float(ics.mean()), icir=float(ics.mean()/ics.std(ddof=1)) if ics.std(ddof=1)>1e-12 else 0.0, hit=float((ics>0).mean()), n=int(len(ics)))

# RSI(2)
up=RET.clip(lower=0).rolling(2).mean(); dn=(-RET.clip(upper=0)).rolling(2).mean()
rsi2 = (100-100/(1+up/(dn+1e-12))).to_numpy(dtype=float)
# negative RSI-2? The cycle6 said IC=-0.0712 (negative). If use -rsi, IC positive.
st = ic_stats(rsi2)
print("rsi2 ic:", st, "rho:", round(pooled_rho(rsi2,mom),4))
st_neg = ic_stats(-rsi2)
print("-rsi2 ic:", st_neg, "rho:", round(pooled_rho(-rsi2,mom),4))

# rev_intra_z120
intra = (1.0 - C/O).to_numpy(dtype=float)
mu = pd.DataFrame(intra,index=idx,columns=SYMS).rolling(120,min_periods=40).mean()
sd = pd.DataFrame(intra,index=idx,columns=SYMS).rolling(120,min_periods=40).std()
revz = ((pd.DataFrame(intra,index=idx,columns=SYMS)-mu)/(sd+1e-12)).to_numpy(dtype=float)
st2 = ic_stats(revz)
print("rev_intra_z120 ic:", st2, "rho:", round(pooled_rho(revz,mom),4))

# Some extra diversity candidates with low rho
# negative of CCI-20
md=(C-C.rolling(20).mean()).abs().rolling(20).mean()
cci = ((C-C.rolling(20).mean())/(0.015*md+1e-12)).to_numpy(dtype=float)
st3=ic_stats(-cci); print("-cci_20 ic:", st3, "rho:", round(pooled_rho(-cci,mom),4))

# dist_high_60 (drawdown) negative? positive distance from high
dist=(C/C.rolling(60).max()-1.0).to_numpy(dtype=float)
st4=ic_stats(dist); print("dist_high_60 ic:", st4, "rho:", round(pooled_rho(dist,mom),4))

# trend_consist_60
sma20=C.rolling(20).mean()
tc=(C>sma20).rolling(60).mean().to_numpy(dtype=float)
st5=ic_stats(tc); print("trend_consist_60 ic:", st5, "rho:", round(pooled_rho(tc,mom),4))

# slope_norm_20
std20=LRET.rolling(20).std()
sl=(sma20/sma20.shift(10)-1.0)/(std20+1e-12)
st6=ic_stats(sl.to_numpy(dtype=float)); print("slope_norm_20 ic:", st6, "rho:", round(pooled_rho(sl.to_numpy(dtype=float),mom),4))
