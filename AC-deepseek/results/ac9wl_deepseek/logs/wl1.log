import json, base64, gzip, numpy as np, glob, os

# Collect all artifact-bearing candidate files in rejected/
files = sorted(glob.glob("factors/rejected/*.json"))
files = [f for f in files if not f.endswith(".reason.json")]
print("candidate files:", len(files))
ok=[]
for f in files:
    try:
        with open(f) as fh: d=json.load(fh)
        a=d.get("signal_artifact") or {}
        b64=a.get("data_b64","")
        if not b64:
            print("  NO-ARTIFACT:", f)
            continue
        raw = base64.b64decode(b64)
        mat = np.frombuffer(gzip.decompress(raw), dtype=np.float32)
        n_dates=a.get("n_dates"); n_syms=a.get("n_symbols")
        mat = mat.reshape(n_dates, n_syms)
        ok.append((f, d, mat))
        print(f"  OK: {d['factor_id']:36s} shape={mat.shape} nan={np.isnan(mat).mean():.3f} mean={np.nanmean(mat):.4f}")
    except Exception as e:
        print("  FAIL:", f, repr(e)[:200])
print("decoded:", len(ok))
