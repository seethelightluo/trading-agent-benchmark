33     return old-new if new is not None and old is not None else None
34 
35 def capped_normalize(w, pref):
36     for _ in range(40):
37         excess=sum(max(0., x-CAP) for x in w.values())
38         w={a:min(CAP, max(0., x)) for a, x in w.items()}
39         room=[a for a,x in w.items() if x<CAP-1e-12]
40         if excess < 1e-12 or not room: break
41         den=sum(max(0.,pref.get(a,0.)) for a in room)
42         for a in room: w[a] += excess*(max(0.,pref.get(a,0.))/den if den else 1/len(room))
43     total=sum(w.values())
44     return {a:x/total for a,x in w.items()}
45 
46 @register_hook
47 def strategy_hook():
48     assets=list(get_account_dict()["watch_list"])
49     frames={a:stock(a) for a in assets}
50     closes={a:(f.close.astype(float) if f is not None and "close" in f and len(f)>=62 else None) for a,f in frames.items()}
51     usable=[c.pct_change().rename(a) for a,c in closes.items() if c is not None]
52     panel=pd.concat(usable,axis=1,join="inner").dropna().tail(100) if len(usable)>=8 else pd.DataFrame()
53     if len(panel)<61:
54         rebalance_to_weights({a:1/len(assets) for a in assets}); return
55     market=panel.mean(axis=1); mv=float(market.var())
56     residual={a:panel[a]-(float(panel[a].cov(market)/mv)*market if mv>1e-14 else 0.) for a in panel}
57     vf=index("VIX"); vix=vf.close.astype(float).pct_change() if vf is not None and "close" in vf else None
58     oil,copper=closes.get("WTI"),closes.get("COPPER")
59     infl=(oil.pct_change()+copper.pct_change())*.5 if oil is not None and copper is not None else None
60     stress=vix.reindex(infl.index).clip(lower=0)*infl if vix is not None and infl is not None else None
61     commodity_rel=oil.pct_change()-copper.pct_change() if oil is not None and copper is not None else None
62     wealth=(1+market).cumprod(); mdd=wealth/wealth.rolling(60).max()-1
63     basket=panel[[a for a in DEF if a in panel]].mean(axis=1); dispersion=panel.std(axis=1)
64     high_disp=float(dispersion.tail(20).mean()) >= float(dispersion.tail(60).median())
65     beta={}; resilience={}; recovery={}; lpm={}; draw={}; macro={}; acorr={}; conditional={}; commodity={}; trend={}; vol={}
66     for a,e in residual.items():
67         ret=panel[a]; vol[a]=float(ret.tail(20).std())
68         z=pd.concat([e.rename("e"),basket.rename("b"),market.rename("m")],axis=1).dropna()
69         def downbeta(n):
70             q=z.tail(n); q=q[q.m<0]; var=float(q.b.var())
71             return float(q.e.cov(q.b)/var) if len(q)>=5 and var>1e-14 else None
72         new,old=downbeta(20),downbeta(60); beta[a]=old-new if new is not None and old is not None else None
73         recovery[a]=float(ret.tail(20).clip(upper=0).mean())-float(ret.iloc[:-20].tail(40).clip(upper=0).mean())
74         resilience[a]=loading_contraction(e,vix.clip(lower=0)**2) if vix is not None else None
75         macro[a]=loading_contraction(e,stress) if stress is not None else None
76         oc=float(ret.iloc[:-20].tail(40).corr(mdd.iloc[:-20].tail(40))); nc=float(ret.tail(20).corr(mdd.tail(20)))
77         draw[a]=oc-nc if isfinite(oc) and isfinite(nc) else None
78         neg=ret.tail(60).clip(upper=0); lpm[a]=-float((neg*neg).mean()**.5)
79         conditional[a]=recovery[a] if (high_disp and float(market.tail(20).mean())<0) else None
80         na,oa=float(e.tail(20).autocorr(1)),float(e.iloc[:-20].tail(40).autocorr(1))
81         acorr[a]=na-oa if isfinite(na) and isfinite(oa) else None
82         commodity[a]=loading_contraction(e,commodity_rel) if commodity_rel is not None else None
83         trend[a]=float(ret.tail(20).mean())/max(vol[a],.003)
84     factors=(beta,resilience,draw,lpm,recovery,acorr,macro,commodity,trend,conditional)
85     score={a:sum(x*ranks(f,assets)[a] for x,f in zip(FW,factors)) for a in assets}
86     selected=sorted(assets,key=lambda a:(score[a],a),reverse=True)[:TOP]
87     pref={a:.4*(2-i/max(1,TOP-1))/max(vol.get(a,.03) or .03,.003)+.6 for i,a in enumerate(selected) if a not in DEF}
88     nondef=[a for a in assets if a not in DEF]; den=sum(pref.get(a,0.) for a in nondef)
89     raw={a:(DEF_W if a in DEF else .64*pref.get(a,0.)/den) for a in assets} if den else {a:1/len(assets) for a in assets}
90     weights=capped_normalize(raw,pref)
91     weights[assets[-1]] += 1-sum(weights.values())
92     rebalance_to_weights(weights)

