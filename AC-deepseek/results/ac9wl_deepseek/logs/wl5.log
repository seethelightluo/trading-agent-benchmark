def signal_rank_corr(a, b, min_valid=8):
    rs = []
    dates = a.index.intersection(b.index)
    for d in dates:
        pair = pd.concat([a.loc[d].rename("a"), b.loc[d].rename("b")], axis=1).dropna()
        if len(pair) < min_valid:
