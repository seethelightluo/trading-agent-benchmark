<｜｜DSML｜｜parameter name="content" string="true">"""miner_1 2026-07-30: Explore 'trend quality' factor family (v2, vectorized).

Same idea as v1 but use rolling moments with min_periods to be robust to
missing asset-days (crypto/non-trading calendars). Signal = slope_sign * R^2
of OLS log(price) ~ time over W days. Variants: signed and absolute R^2,
windows 30/60/90. Validation: rank IC h=10, ICIR, hit ratio, coverage,
turnover, decay, regime, max library rho.
"""
import sys, json
import numpy as np
import pandas as pd
sys.path.insert(0, 'scripts')
from factor_validate import (closes_panel, forward_returns, ic_series,
                             summary_metrics, regime_split,
                             library_ic_series_map, max_abs_library_corr)

VIS = "2026-07-29"
H = 10
close = closes_panel(VIS)
lp = np.log(close)
fr = forward_returns(close, H)

def rolling_trend_r2(df, win):
    """Vectorized signed R^2 of rolling OLS log-price ~ time.

    Uses rolling means with min_periods; slope = cov(lp,t)/var(t),
    R^2 = cov^2/(var_lp*var_t), sign from end-point diff.
    """
    mp = max(int(win * 0.6), 12)
    t = np.arange(win, dtype=float)
    t_mean = t.mean()
    t_var = ((t - t_mean) ** 2).sum() / win  # population variance
    # rolling means (skipna=True default)
    mean_y = df.rolling(win, min_periods=mp).mean()
    mean_ty = (df * t_mean)  # E[t*y] = t_mean * E[y] (t fixed)
    # Actually E[t*y] with t constant => t_mean * mean_y
    cov = t_mean * mean_y - t_mean * mean_y  # zero? No: cov = E[(y-mean_y)(t-mean_t)]
    # Direct: cov = E[y*t] - E[y]*E[t] = t_mean*E[y] - E[y]*t_mean = 0 when t is fixed.
    # WRONG because rolling mean of y * t is not t_mean*mean_y (mean of y_t * t over window)
    # => use shifted t values aligned to each window position.
    # Simpler: use rolling sums of y and y^2 and t-scored y via expanding arrays.
    # Implement via cumulative sums.
    csum = df.cumsum()
    csum2 = (df * df).cumsum()
    csum_ty = (df * t).cumsum()
    n_win = df.rolling(win, min_periods=mp).count()
    sy = csum - csum.shift(win)
    sy2 = csum2 - csum2.shift(win)
    sty = csum_ty - csum_ty.shift(win)
    n = n_win
    mean_y = sy / n
    mean_y2 = sy2 / n
    mean_ty = sty / n
    mean_t = t.mean()
    mean_t2 = (t ** 2).mean()
    cov = mean_ty - mean_y * mean_t
    var_y = mean_y2 - mean_y ** 2
    var_t = mean_t2 - mean_t ** 2
    r2 = (cov ** 2) / (var_y * var_t)
    # sign from end-point difference (robust to gaps)
    slope_sign = np.sign(df - df.shift(win))
    return (r2 * slope_sign).reindex(df.index)

results = {}
for win in (30, 60, 90):
    sig_signed = rolling_trend_r2(lp, win)
    ic_s = ic_series(sig_signed, fr, min_valid=8)
    print(f"win={win} signed: valid IC dates={len(ic_s)}, "
          f"signal valid={int(sig_signed.notna().sum().sum())}")
    m = summary_metrics(ic_s, sig_signed, fr, close, h=H)
    if m is None:
        print(f"win={win} signed: insufficient IC dates")
        continue
    lib = library_ic_series_map(close, h=H)
    ic_s2 = ic_series(sig_signed, fr, min_valid=8)
    m["max_abs_library_correlation"] = max_abs_library_corr(ic_s2, lib)
    m["regime"] = regime_split(ic_s2)
    fid = f"trend_r2_{win}_signed"
    results[fid] = m
    gate = abs(m["ic"]) >= 0.007 and abs(m["icir"] or 0) >= 0.084
    print(f"=== {fid}: ic={m['ic']} icir={m['icir']} hit={m['ic_hit_ratio']} "
          f"n={m['n_ic_dates']} cov_ad={m['coverage_asset_days']} "
          f"cov_ge8={m['coverage_dates_ge8']} turn={m['turnover_10d_rank']} "
          f"max_rho_lib={m['max_abs_library_correlation']} GATE={gate}")
    print("  decay:", m["decay_ic_by_horizon"])
    print("  regimes:", m["regime"])

    sig_abs = sig_signed.abs()
    ic_a = ic_series(sig_abs, fr, min_valid=8)
    m2 = summary_metrics(ic_a, sig_abs, fr, close, h=H)
    if m2 is not None:
        fid2 = f"trend_r2_{win}_abs"
        results[fid2] = m2
        print(f"  [{fid2}]: ic={m2['ic']} icir={m2['icir']} n={m2['n_ic_dates']}")

with open("scripts/miner_1_20260730_explore_trend_r2_results.json", "w") as f:
    json.dump(results, f, indent=1, default=str)
print("\nDONE. saved results.")
