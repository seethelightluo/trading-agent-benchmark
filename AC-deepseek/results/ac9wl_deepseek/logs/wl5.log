54:    dn = np.sqrt((np.minimum(R, 0) ** 2).rolling(20).mean())
55:    up = np.sqrt((np.maximum(R, 0) ** 2).rolling(20).mean())
56:    return (dn / up - 1.0).replace([np.inf, -np.inf], np.nan)
