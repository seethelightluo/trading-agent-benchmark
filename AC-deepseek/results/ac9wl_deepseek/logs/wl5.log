152:     sha = hashlib.sha256(b64.encode('ascii')).hexdigest()
153:     return {
154:         "format": "base64:zlib:csv",
155:         "description": "Factor signal panel: rows = dates (YYYY-MM-DD), cols = 15 watchlist symbols. Recover with zlib.decompress(base64.b64decode(data)).decode() then pd.read_csv(StringIO).",
156:         "columns": list(panel.columns),
157:         "shape": [int(panel.shape[0]), int(panel.shape[1])],
158:         "n_valid_values": int(panel.notna().sum().sum()),
159:         "sha256": sha,
160:         "data": b64,
161:     }
162: 
