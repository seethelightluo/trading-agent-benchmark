106 def decode_artifact(artifact):
107     raw = base64.b64decode(artifact['data'])
108     csv_txt = zlib.decompress(raw).decode('utf-8')
109     df = pd.read_csv(pd.io.common.StringIO(csv_txt), index_col=0)
110     df.index = pd.to_datetime(df.index)
111     df = df.sort_index()
112     return df
