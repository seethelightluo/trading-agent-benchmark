86 def coverage_turnover(factor_panel, ret_panel, horizon=10, every=10):
87     valid = factor_panel.notna()
88     cov_asset_days = float(valid.sum().sum()) / float(valid.size)
89     ge8 = valid.sum(axis=1) >= 8
90     cov_dates_ge8 = float(ge8.mean())
91     # rank turnover at decision frequency (every 10d)
92     to = []
93     idx = factor_panel.index[::every]
94     for i in range(1, len(idx)):
95         d0, d1 = idx[i - 1], idx[i]
96         r0 = factor_panel.loc[d0].rank()
97         r1 = factor_panel.loc[d1].rank()
98         m = r0.notna() & r1.notna()
99         if m.sum() >= 8:
100             to.append((r1[m] - r0[m]).abs().mean())
101     turnover = float(np.mean(to)) if to else float('nan')
102     return {"coverage_asset_days": round(cov_asset_days, 3),
103             "coverage_dates_ge8": round(cov_dates_ge8, 3),
104             "turnover_10d_rank": round(turnover, 3)}
