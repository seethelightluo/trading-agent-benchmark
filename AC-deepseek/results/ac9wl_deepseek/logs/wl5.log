def coverage_turnover(factor_panel, ret_panel, horizon=10, every=10):
    valid = factor_panel.notna()
    cov_asset_days = float(valid.sum().sum()) / float(valid.size)
    ge8 = valid.sum(axis=1) >= 8
    cov_dates_ge8 = float(ge8.mean())
