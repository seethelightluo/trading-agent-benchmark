41 def rank_ic(factor_panel, fwd_ret_panel):
42     """Daily cross-sectional Spearman IC between factor and forward returns."""
43     dates = factor_panel.index.intersection(fwd_ret_panel.index)
44     ics = []
45     for d in dates:
46         f = factor_panel.loc[d]
47         r = fwd_ret_panel.loc[d]
48         m = f.notna() & r.notna()
49         if m.sum() >= 8:
50             ic = f[m].rank().corr(r[m].rank())
51             if not math.isnan(ic):
52                 ics.append((d, ic))
53     if not ics:
54         return None
55     s = pd.Series([x[1] for x in ics], index=[x[0] for x in ics], dtype=float)
56     return s
57 
58 
59 def summarize(s, horizon, label=""):
60     ic = s.mean()
61     icir = s.mean() / s.std() if s.std() > 0 else 0.0
62     hit = (s > 0).mean()
63     n = len(s)
64     regime = {}
65     for name, lo, hi in [("2020-2022", "2020-01-01", "2022-12-31"),
66                           ("2023-2024", "2023-01-01", "2024-12-31"),
67                           ("2025-2026", "2025-01-01", "2026-12-31")]:
68         sub = s[(s.index >= lo) & (s.index <= hi)]
69         if len(sub) >= 20:
70             regime[name] = {"ic": round(sub.mean(), 4), "icir": round(sub.mean() / sub.std(), 4) if sub.std() > 0 else 0.0, "n": int(len(sub))}
71     return {"label": label, "horizon": horizon, "ic": round(ic, 4), "icir": round(icir, 4),
72             "ic_hit_ratio": round(hit, 3), "n_ic_dates": int(n), "regime": regime}
73 
74 
75 def decay_analysis(factor_panel, ret_panel, horizons=(1, 2, 3, 5, 10, 20)):
76     out = {}
77     for h in horizons:
78         fr = ret_panel.shift(-h)
79         s = rank_ic(factor_panel, fr)
80         if s is not None and len(s) >= 20:
81             out[str(h)] = round(s.mean(), 4)
82     return out
83 
