n):>15.2f}\'\n        elif j == i:\n            row += f\'{\\"—\\":>15}\'\n        else:\n            row += f\'{rank_corr(f1, f2, recent):>15.2f}\'\n    print(row)\n" 2>&1 | head -40'})
