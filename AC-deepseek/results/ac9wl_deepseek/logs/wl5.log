85 def coverage_turnover(factor_panel, ret_panel, horizon=10, every=10):
86     valid = factor_panel.notna()
87     cov_asset_days = float(valid.sum().sum()) / float(valid.size)
88     ge8 = valid.sum(axis=1) >= 8
89     cov_dates_ge8 = float(ge8.mean())
90     # rank turnover at decision frequency (every 10d)
91     to = []
92     idx = factor_panel.index[::every]
93     for i in range(1, len(idx)):
94         d0, d1 = idx[i - 1], idx[i]
95         r0 = factor_panel.loc[d0].rank()
96         r1 = factor_panel.loc[d1].rank()
97         m = r0.notna() & r1.notna()
98         if m.sum() >= 8:
99             to.append((r1[m] - r0[m]).abs().mean())
100     turnover = float(np.mean(to)) if to else float('nan')
101     return {"coverage_asset_days": round(cov_asset_days, 3),
102             "coverage_dates_ge8": round(cov_dates_ge8, 3),
103             "turnover_10d_rank": round(turnover, 3)}
104 
