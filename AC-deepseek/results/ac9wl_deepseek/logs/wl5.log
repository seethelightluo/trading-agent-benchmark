"""miner_3 2026-07-30: full gate validation + redundancy/provenance check
for candidates NDX_BETA_60, WTI_BETA_60, ETH_BETA_60, MOM_REL_EQ_20."""
import sys, json, zlib, base64, io
import numpy as np
import pandas as pd
sys.path.insert(0, "scripts")
