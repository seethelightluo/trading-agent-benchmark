163 def full_validate(factor_panel, ret_panel, horizon=10, label=""):
164     s = rank_ic(factor_panel, ret_panel.shift(-horizon))
165     summ = summarize(s, horizon, label)
166     summ['decay_ic_by_horizon'] = decay_analysis(factor_panel, ret_panel)
167     cov = coverage_turnover(factor_panel, ret_panel, horizon)
168     summ.update(cov)
169     rhos, maxrho = library_max_rho(factor_panel)
170     summ['library_rho_by_factor'] = rhos
171     summ['max_abs_library_correlation'] = round(maxrho, 3)
172     return summ

