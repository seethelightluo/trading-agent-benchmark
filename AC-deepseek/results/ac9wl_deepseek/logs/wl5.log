  ▶️ shell({'command': 'python - <<\'EOF\'\nimport pandas as pd, numpy as np, os\n\nsyms = [\'000300.SH\',\'SPX\',\'HSI\',\'N225\',\'SX5E\',\'000688.SH\',\'SOX\',\'NDX\',\'XAU\',\'COPPER\',\'WTI\',\'BTC\',\'ETH\',\'US10Y\',\'CN10Y\']\n# Load data and restrict to <= 2026-12-02 (visible through previous completed day)\ndata = {}\nfor s in syms:\n    p = f\'../persistent/stock_data/{s}.csv\'\n    df = pd.read_csv(p)\n    df[\'date\'] = pd.to_datetime(df[\'date\'])\n    df = df[df[\'date\'] <= \'2026-12-02\'].set_index(\'date\').sort_index()\n    data[s] = df[\'close\']\n\npx = pd.DataFrame(data)\nret = px.pct_change().dropna()\nprint("Price panel: %d rows, %d cols, last date %s" % (len(px), px.shape[1], px.index[-1].date()))\n\n# --- Regime assessment ---\n# 1. Overall trend: 60d return and MA20 vs MA60 slope\nma20 = px.rolling(20).mean()\nma60 = px.rolling(60).mean()\nlast = px.iloc[-1]\nprint("\\n=== Trend (last close vs MA20/MA60, 60d return) ===")\ntrend_df = pd.DataFrame({\n    \'close\': last,\n    \'MA20\': ma20.iloc[-1],\n    \'MA60\': ma60.iloc[-1],\n    \'ret60\': (px.iloc[-1]/px.iloc[-61]-1) if len(px)>61 else np.nan,\n    \'ret20\': (px.iloc[-1]/px.iloc[-21]-1) if len(px)>21 else np.nan,\n})\ntrend_df[\'above_MA20\'] = trend_df[\'close\'] > trend_df[\'MA20\']\ntrend_df[\'above_MA60\'] = trend_df[\'close\'] > trend_df[\'MA60\']\nprint(trend_df.round(4).to_string())\n\n# 2. Realized vol\nvol20 = ret.rolling(20).std().iloc[-1] * np.sqrt(252)\nvol60 = ret.rolling(60).std().iloc[-1] * np.sqrt(252)\nprint("\\n=== Volatility (annualized) ===")\nprint(pd.DataFrame({\'vol20\': vol20, \'vol60\': vol60}).round(3).to_string())\n\n# 3. Cross-sectional dispersion / correlation\ncorr60 = ret.tail(60).corr()\nprint("\\nMean pairwise correlation (60d):", round(corr60.values[np.triu_indices_from(corr60.values,1)].mean(),3))\n# dispersion of 20d returns\ndisp20 = ret.tail(20).mean().std()  # cross-sectional dispersion of daily mean returns\nprint("Cross-sectional dispersion of 20d mean daily ret:", round(disp20*100, 4), "%")\n\n# 4. Recent performance of each asset\nprint("\\n=== Recent cumulative returns ===")\ncum5 = (px.iloc[-1]/px.iloc[-6]-1)\ncum20 = (px.iloc[-1]/px.iloc[-21]-1)\ncum60 = (px.iloc[-1]/px.iloc[-61]-1)\nperf = pd.DataFrame({\'ret5\': cum5, \'ret20\': cum20, \'ret60\': cum60}).round(4)\nprint(perf.sort_values(\'ret20\').to_string())\n\n# 5. Drawdown state\nroll_max = px.cummax()\ndd = px/roll_max - 1\nprint("\\n=== Current drawdown from peak ===")\nprint((dd.iloc[-1].round(4)).to_string())\nEOF'})
