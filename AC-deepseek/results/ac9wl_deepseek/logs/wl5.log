116 def library_max_rho(new_panel, lib_dir='factors'):
117     """Flattened Pearson rho between new factor panel and each library signal artifact."""
118     rhos = {}
119     new_flat = new_panel.stack()
120     for fid in LIB_FACTORS:
121         p = os.path.join(lib_dir, fid + '.json')
122         if not os.path.exists(p):
123             continue
124         try:
125             d = json.load(open(p))
126             art = d.get('validation', {}).get('signal_artifact')
127             if not art:
128                 rhos[fid] = None
129                 continue
130             libp = decode_artifact(art)
131             common = new_panel.index.intersection(libp.index)
132             a = new_panel.loc[common].stack()
133             b = libp.loc[common].stack()
134             m = a.notna() & b.notna()
135             if m.sum() >= 200:
136                 r = float(np.corrcoef(a[m], b[m])[0, 1])
137                 rhos[fid] = round(r, 3) if not math.isnan(r) else None
138             else:
139                 rhos[fid] = None
140         except Exception as e:
141             rhos[fid] = None
142     vals = [v for v in rhos.values() if v is not None]
143     return rhos, (max(vals) if vals else 0.0)
