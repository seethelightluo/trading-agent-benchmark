  ▶️ shell({'command': 'python << \'EOF\'\nimport pandas as pd, numpy as np\n\nassets = [\'000300.SH\',\'SPX\',\'HSI\',\'N225\',\'SX5E\',\'000688.SH\',\'SOX\',\'NDX\',\'XAU\',\'COPPER\',\'WTI\',\'BTC\',\'ETH\',\'US10Y\',\'CN10Y\']\npx = {}\nfor a in assets:\n    df = pd.read_csv(f\'../persistent/stock_data/{a}.csv\')\n    df[\'date\'] = pd.to_datetime(df[\'date\'])\n    df = df.sort_values(\'date\').set_index(\'date\')\n    px[a] = df[\'close\']\nPX = pd.DataFrame(px)\nPX = PX[PX.index <= \'2026-09-09\']\nRET = PX.pct_change()\n\n# macro\ndxy = pd.read_csv(\'../persistent/index_data/DXY.csv\'); dxy[\'date\']=pd.to_datetime(dxy[\'date\']); dxy=dxy.sort_values(\'date\').set_index(\'date\')[\'close\']\nvix = pd.read_csv(\'../persistent/index_data/VIX.csv\'); vix[\'date\']=pd.to_datetime(vix[\'date\']); vix=vix.sort_values(\'date\').set_index(\'date\')[\'close\']\ndxy = dxy[dxy.index <= \'2026-09-09\']\nvix = vix[vix.index <= \'2026-09-09\']\nDXYR = dxy.pct_change(); VIXR = vix.pct_change()\nWTI = PX[\'WTI\']\n\ndef beta(x, y, w=60):\n    xr = x.pct_change(); yr = y.pct_change()\n    c = xr.rolling(w).cov(yr)\n    v = yr.rolling(w).var()\n    return c/v\n\nout = pd.DataFrame(index=assets)\nout[\'WTI_BETA_60\'] = beta(PX[\'WTI\'], PX[\'WTI\'], 60)  # beta of WTI vs itself = 1\n# compute beta of each asset to WTI\nbw = pd.DataFrame({a: beta(PX[a], WTI, 60) for a in assets})\nout[\'WTI_BETA_60\'] = bw.iloc[-1].values\nbd = pd.DataFrame({a: beta(PX[a], dxy.reindex(PX.index).ffill(), 60) for a in assets})\nout[\'dxy_beta_60\'] = bd.iloc[-1].values\n\n# semi_down_ratio_20\ndown = RET.clip(upper=0); up = RET.clip(lower=0)\nsdr = np.sqrt((down**2).rolling(20).mean()) / np.sqrt((up**2).rolling(20).mean()) - 1\nout[\'semi_down_ratio_20\'] = sdr.iloc[-1].values\n\n# time_under_water_120: days since last 120d rolling max close\ndef tuw(s, w=120):\n    rm = s.rolling(w, min_periods=w).max()\n    out_series = pd.Series(np.nan, index=s.index)\n    # iterate\n    last_max_date = pd.Series(np.nan, index=s.index)\n    cur = None\n    for i in range(len(s)):\n        if i < w-1: continue\n        win = s.iloc[i-w+1:i+1]\n        if cur is None or s.iloc[i] >= win.max():\n            cur = i\n        last_max_date.iloc[i] = i - cur\n    return last_max_date\ntuws = pd.DataFrame({a: tuw(PX[a]) for a in assets})\nout[\'time_under_water_120\'] = tuws.iloc[-1].values\n\n# trend_r2_30_signed\ndef trend_r2(s, w=30):\n    t = np.arange(w)\n    res = []\n    for i in range(len(s)):\n        if i < w-1:\n            res.append(np.nan); continue\n        y = np.log(s.iloc[i-w+1:i+1].values)\n        cov = np.cov(y, t)[0,1]\n        r2 = cov**2 / (np.var(t) * np.var(y)) if np.var(y) > 0 else 0\n        res.append(np.sign(cov)*r2)\n    return pd.Series(res, index=s.index)\ntr = pd.DataFrame({a: trend_r2(PX[a]) for a in assets})\nout[\'trend_r2_30_signed\'] = tr.iloc[-1].values\n\n# mom_120d_skip5, mom_10d_skip5\nout[\'mom_120d_skip5\'] = (PX.shift(5)/PX.shift(125)-1).iloc[-1].values\nout[\'mom_10d_skip5\'] = (PX.shift(5)/PX.shift(15)-1).iloc[-1].values\n\n# vol_of_vol20x60\nv20 = RET.rolling(20).std()\nvov = v20.rolling(60).std()\nout[\'vol_of_vol20x60\'] = vov.iloc[-1].values\n\n# kurt_20\ndef kurt(s, w=20):\n    r = s.pct_change()\n    m2 = r.rolling(w, min_periods=8).mean()  # placeholder\n    # use scipy-free: rolling moments\n    mu = r.rolling(w, min_periods=8).mean()\n    m2 = ((r - mu)**2).rolling(w, min_periods=8).mean()\n    m4 = ((r - mu)**4).rolling(w, min_periods=8).mean()\n    return m4/m2**2 - 3\nku = pd.DataFrame({a: kurt(PX[a]) for a in assets})\nout[\'kurt_20\'] = ku.iloc[-1].values\n\n# vix_beta_cond_60x20: -beta(asset, VIX, 60) * (VIX/VIX.shift(20)-1)\nvix_a = vix.reindex(PX.index).ffill()\nbv = pd.DataFrame({a: beta(PX[a], vix_a, 60) for a in assets})\nvixmove = vix_a.iloc[-1]/vix_a.iloc[-21] - 1\nout[\'vix_beta_cond_60x20\'] = (-bv.iloc[-1].values * vixmove)\n\npd.set_option(\'display.width\', 250)\npd.set_option(\'display.max_columns\', 50)\nprint("Current factor exposures (2026-09-09):")\nprint(out.round(4).to_string())\nEOF'})
