  ▶️ write_file({'file_path': 'scripts/screener_ic_analysis.py', 'content': '"""Screener: fresh cross-sectional IC analysis (data <= 2026-12-30 only).\n\nComputes rank IC of library factors vs 10d forward returns on the 15-asset\ntradable universe, over full sample and recent windows, plus regime stats.\nRead-only; does not touch account/date or run any backtest/step.\n"""\nimport json\nfrom pathlib import Path\nimport numpy as np\nimport pandas as pd\n\nCUTOFF = "2026-12-30"\nDATA = Path("../persistent/stock_data")\nIDX = Path("../persistent/index_data")\nASSETS = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX",\n          "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]\n\n\ndef load_close(path, cutoff):\n    df = pd.read_csv(path)\n    df["date"] = pd.to_datetime(df["date"])\n    df = df[df["date"] <= pd.Timestamp(cutoff)]\n    df = df.set_index("date")["close"].astype(float)\n    return df\n\n\ndef load_idx(name, cutoff):\n    return load_close(IDX / f"{name}.csv", cutoff)\n\n\ndef build_panel():\n    closes = {}\n    for a in ASSETS:\n        try:\n            s = load_close(DATA / f"{a}.csv", CUTOFF)\n        except Exception:\n            s = load_close(IDX / f"{a}.csv", CUTOFF)\n        closes[a] = s\n    return pd.DataFrame(closes).sort_index()\n\n\ndef rank_ic(panel, fvals, horizon=10):\n    """fvals: DataFrame index=date, cols=assets (factor exposures)."""\n    fwd = panel.shift(-horizon) / panel - 1.0\n    common = fvals.index.intersection(fwd.index)\n    f = fvals.loc[common]\n    r = fwd.loc[common]\n    ics = []\n    for dt in common:\n        x = f.loc[dt].astype(float)\n        y = r.loc[dt].astype(float)\n        m = x.notna() & y.notna()\n        if m.sum() >= 8:\n            ics.append((dt, np.corrcoef(x[m].rank(), y[m].rank())[0, 1]))\n    if not ics:\n        return None\n    ics = pd.DataFrame(ics, columns=["date", "ic"]).set_index("date")\n    return ics\n\n\ndef ic_stats(ics, n):\n    if ics is None or len(ics) == 0:\n        return None\n    tail = ics.iloc[-n:]\n    ic = float(tail["ic"].mean())\n    icir = ic / float(tail["ic"].std(ddof=1)) * np.sqrt(252 / 10) if tail["ic"].std(ddof=1) > 0 else 0.0\n    hit = float((tail["ic"] > 0).mean())\n    return {"ic": round(ic, 4), "icir": round(icir, 3), "hit": round(hit, 3), "n": len(tail)}\n\n\n# ---------- factor implementations (mirror strategy.py) ----------\ndef f_trend_r2(c):\n    s = c.dropna().tail(30)\n    if len(s) < 18:\n        return np.nan\n    y = np.log(s.values.astype(float))\n    x = np.arange(len(y))\n    cov = float(np.cov(y, x)[0, 1])\n    vy, vx = float(np.var(y)), float(np.var(x))\n    if vy <= 0 or vx <= 0:\n        return np.nan\n    return np.copysign(cov * cov / (vy * vx), cov)\n\n\ndef f_semi_down(r):\n    s = r.dropna().tail(20)\n    if len(s) < 10:\n        return np.nan\n    down = float((s.clip(upper=0) ** 2).mean() ** 0.5)\n    up = float((s.clip(lower=0) ** 2).mean() ** 0.5)\n    if up < 1e-12:\n        return np.nan\n    return down / up - 1.0\n\n\ndef f_mom_120(c):\n    if len(c) < 126:\n        return np.nan\n    p0 = float(c.iloc[-126])\n    if p0 <= 0:\n        return np.nan\n    return float(c.iloc[-6]) / p0 - 1.0\n\n\ndef f_mom_10(c):\n    if len(c) < 16:\n        return np.nan\n    p15 = float(c.iloc[-16])\n    p5 = float(c.iloc[-6])\n    if p15 <= 0:\n        return np.nan\n    return p5 / p15 - 1.0\n\n\ndef f_underwater(c):\n    s = c.dropna().tail(125)\n    if len(s) < 60:\n        return np.nan\n    w = s.tail(120).values.astype(float)\n    roll = np.maximum.accumulate(w)\n    mask = w == roll\n    idx = np.flatnonzero(mask)\n    return float(len(w) - 1 - idx[-1]) if len(idx) else float(len(w))\n\n\ndef f_vol_of_vol(r):\n    s = r.dropna().tail(120)\n    if len(s) < 90:\n        return np.nan\n    v = s.rolling(20).std()\n    out = v.rolling(60).std().iloc[-1]\n    return float(out) if np.isfinite(out) else np.nan\n\n\ndef f_kurt_20(r):\n    s = r.dropna().tail(40)\n    if len(s) < 20:\n        return np.nan\n    k = s.rolling(20, min_periods=8).kurt().iloc[-1]\n    return float(k) if np.isfinite(k) else np.nan\n\n\ndef f_beta(r, mkt_r, win=60):\n    z = pd.concat([r.rename("a"), mkt_r.rename("m")], axis=1).dropna().tail(win)\n    if len(z) < 30:\n        return np.nan\n    vm = float(z["m"].var())\n    if vm < 1e-14:\n        return np.nan\n    return float(z["a"].cov(z["m"]) / vm)\n\n\ndef f_vix_cond(r, vix_r, vix_level):\n    beta = f_beta(r, vix_r, 60)\n    if not np.isfinite(beta):\n        return np.nan\n    if len(vix_level) < 2:\n        return np.nan\n    vix_chg = float(vix_level.iloc[-1] / vix_level.iloc[-21] - 1.0) if len(vix_level) >= 21 else 0.0\n    return -beta * vix_chg\n\n\ndef main():\n    panel = build_panel()\n    rets = panel.pct_change()\n    mkt = panel.mean(axis=1)\n    mkt_r = mkt.pct_change()\n\n    dxy = load_idx("DXY", CUTOFF)\n    dxy_r = dxy.pct_change()\n    vix = load_idx("VIX", CUTOFF)\n    vix_r = vix.pct_change()\n    wti = panel["WTI"]\n    wti_r = wti.pct_change()\n\n    print(f"Panel dates: {panel.index.min().date()} .. {panel.index.max().date()}  n={len(panel)}")\n\n    # regime stats\n    trend20 = float(mkt.tail(20).mean()) if len(mkt) >= 20 else np.nan\n    ma60 = float(mkt.tail(60).mean()) if len(mkt) >= 60 else np.nan\n    avg_px = float(mkt.iloc[-1])\n    rv20 = float(mkt_r.tail(20).std() * np.sqrt(252))\n    rv60 = float(mkt_r.tail(60).std() * np.sqrt(252))\n    mom60 = float(mkt.iloc[-1] / mkt.iloc[-61] - 1.0) if len(mkt) >= 61 else np.nan\n    mom120 = float(mkt.iloc[-1] / mkt.iloc[-121] - 1.0) if len(mkt) >= 121 else np.nan\n    disp20 = float(rets.tail(20).std(axis=1).mean())\n    corr = rets.tail(60).corr()\n    avg_corr = float((corr.values[np.triu_indices_from(corr.values, 1)]).mean())\n    print("\\n--- REGIME ---")\n    print(f"avg_px={avg_px:.0f} ma60={ma60:.0f} trend20(mean of last20 rets)={trend20:.5f} bearish_gate={trend20<0 and avg_px<ma60}")\n    print(f"mkt mom60={mom60:.3f} mom120={mom120:.3f} rv20={rv20:.3f} rv60={rv60:.3f} disp20={disp20:.4f} avg_corr60={avg_corr:.3f}")\n    print(f"VIX last={vix.iloc[-1]:.1f} VIX 20d chg={vix.iloc[-1]/vix.iloc[-21]-1:.3f} DXY last={dxy.iloc[-1]:.2f}")\n\n    # per-asset recent stats\n    print("\\n--- per-asset 60d ret / 20d vol ---")\n    for a in ASSETS:\n        r60 = float(panel[a].iloc[-1] / panel[a].iloc[-61] - 1.0) if len(panel) >= 61 else np.nan\n        v20 = float(rets[a].tail(20).std() * np.sqrt(252))\n        print(f"  {a:10s} r60={r60:7.3f}  vol20={v20:5.3f}  last={panel[a].iloc[-1]:.1f}")\n\n    # factor time series (rolling over dates)\n    print("\\n--- building factor series ---")\n    factor_defs = {\n        "trend_r2_30_signed": (1, "close"),\n        "semi_down_ratio_20": (-1, "ret"),\n        "mom_120d_skip5": (1, "close"),\n        "mom_10d_skip5": (1, "close"),\n        "vol_of_vol20x60": (1, "ret"),\n        "kurt_20": (1, "ret"),\n        "time_under_water_120": (-1, "close"),\n        "dxy_beta_60": (1, "dxy"),\n        "WTI_BETA_60": (1, "wti"),\n        "vix_beta_cond_60x20": (-1, "vix"),\n    }\n    fseries = {}\n    for fid, (_, kind) in factor_defs.items():\n        vals = {}\n        for a in ASSETS:\n            c = panel[a]\n            r = rets[a]\n            if kind == "close":\n                v = {"trend_r2_30_signed": f_trend_r2, "mom_120d_skip5": f_mom_120,\n                     "mom_10d_skip5": f_mom_10, "time_under_water_120": f_underwater}[fid](c)\n            elif kind == "ret":\n                v = {"semi_down_ratio_20": f_semi_down, "vol_of_vol20x60": f_vol_of_vol,\n                     "kurt_20": f_kurt_20}[fid](r)\n            elif kind == "dxy":\n                v = f_beta(r, dxy_r, 60)\n            elif kind == "wti":\n                v = f_beta(r, wti_r, 60)\n            else:  # vix\n                v = f_vix_cond(r, vix_r, vix)\n            vals[a] = v\n        fseries[fid] = vals\n\n    fdf = pd.DataFrame(fseries).T  # rows=assets, cols=factors\n    print("factor coverage (assets with value):")\n    print(fdf.notna().sum(axis=1).to_string())\n\n    print("\\n--- rank IC vs 10d fwd returns (raw, pre-direction) ---")\n    ic_by_factor = {}\n    for fid, (direction, _) in factor_defs.items():\n        fv = fdf.loc[fid]\n        fpanel = pd.DataFrame({a: np.nan for a in ASSETS}, index=panel.index)\n        fpanel.loc[panel.index[-1], :] = fv.values  # single-date exposure\n        ics = rank_ic(panel, fpanel)\n        ic_by_factor[fid] = ics\n        print(f"{fid:22s} dir={direction:+d}  full={ic_stats(ics, len(ics))}  120d={ic_stats(ics, 120)}  60d={ic_stats(ics, 60)}")\n\n\nif __name__ == "__main__":\n    main()\n'})
