.rolling(20,min_periods=8).kurt().iloc[-1]\n    return np.nan if not isfinite(k) else float(k)\ndef dxy_beta(r,dxy_r):\n    z=pd.concat([r.rename('a'),dxy_r.rename('d')],axis=1).dropna().tail(60)\n    if len(z)<30: return np.nan\n    vd=float(z['d'].var())\n    return np.nan if vd<1e-14 else float(z['a'].cov(z['d'])/vd)\ndef wti_beta(r,wti_r):\n    z=pd.concat([r.rename('a'),wti_r.rename('d')],axis=1).dropna().tail(60)\n    if len(z)<30: return np.nan\n    vd=float(z['d'].var())\n    return np.nan if vd<1e-14 else float(z['a'].cov(z['d'])/vd)\ndef vix_beta_cond(r,vix_r):\n    z=pd.concat([r.rename('a'),vix_r.rename('d')],axis=1).dropna().tail(60)\n    if len(z)<30: return np.nan\n    vd=float(z['d'].var())\n    if vd<1e-14: return np.nan\n    b=float(z['a'].cov(z['d'])/vd)\n    chg = float(vix_r.iloc[-1]/vix_r.iloc[-21]-1) if len(vix_r.dropna())>21 else 0.0\n    return -b*chg\ndef mom10(c):\n    if len(c)<16: return np.nan\n    return float(c.iloc[-6])/float(c.iloc[-16])-1.0\n\nDXY = pd.read_csv('../persistent/index_data/DXY.csv'); DXY.columns=[c.strip() for c in DXY.columns]\nDXY['date']=pd.to_datetime(DXY['date']); DXY=DXY.set_index('date')['close'].astype(float)\nDXY=DXY[DXY.index<=pd.Timestamp('2026-10-21')]; dxy_r=DXY.pct_change()\nWTI_src = px['WTI']; wti_r = WTI_src.pct_change()\nVIX = pd.read_csv('../persistent/index_data/VIX.csv'); VIX.columns=[c.strip() for c in VIX.columns]\nVIX['date']=pd.to_datetime(VIX['date']); VIX=VIX.set_index('date')['close'].astype(float)\nVIX=VIX[VIX.index<=pd.Timestamp('2026-10-21')]; vix_r=VIX.pct_change()\n\n# compute factor panels on rolling basis (daily, using trailing windows)\nfnames = {'trend_r2_30_signed':(trend_r2,0),'semi_down_ratio_20':(semi_down,1),'mom_120d_skip5':(mom120,1),\n          'vol_of_vol20x60':(vol_of_vol,1),'dxy_beta_60':(dxy_beta,1),'time_under_water_120':(underwater,1),\n          'kurt_20':(kurt20,1),'mom_10d_skip5':(mom10,1)}\ndef make_panel(fn, use_dxy):\n    out={}\n    for a in assets:\n        c=PX[a].dropna(); r=rets[a].dropna()\n        vals={}\n        for dt in c.index:\n            cc=c[c.index<=dt]; rr=r[r.index<=dt]\n            try:\n                if use_dxy and fn is dxy_beta:\n                    vals[dt]=fn(rr,dxy_r[dxy_r.index<=dt])\n                else:\n                    vals[dt]=fn(cc) if fn in (trend_r2,mom120,underwater,mom10) else fn(rr)\n            except Exception:\n                vals[dt]=np.nan\n        out[a]=pd.Series(vals)\n    return pd.DataFrame(out)\n\n# rank IC vs 10d forward returns\nfwd = PX.shift(-10)/PX - 1.0\ndef rank_ic(panel, start):\n    sub = panel[panel.index>=start]\n    ics=[]\n    for dt in sub.index:\n        f = sub.loc[dt]; fw = fwd.loc[dt] if dt in fwd.index else pd.Series(dtype=float)\n        df = pd.concat([f.rename('f'), fw.rename('r')], axis=1).dropna()\n        df = df[np.isfinite(df['f']) & np.isfinite(df['r'])]\n        if len(df)>=5:\n            ics.append(df['f'].rank().corr(df['r'].rank()))\n    ics=np.array(ics)\n    return len(ics), np.nanmean(ics), (np.nanmean(ics)/np.nanstd(ics)*np.sqrt(len(ics))) if len(ics)>1 and np.nanstd(ics)>0 else np.nan\n\nfor name,(fn,ud) in fnames.items():\n    pan = make_panel(fn,ud)\n    n1,ic1,t1 = rank_ic(pan, pd.Timestamp('2026-10-21')-pd.Timedelta(days=365))\n    n2,ic2,t2 = rank_ic(pan, pd.Timestamp('2026-10-21')-pd.Timedelta(days=180))\n    print(f'{name:24s} 365d: n={n1:4d} IC={ic1:+.4f} | 180d: n={n2:4d} IC={ic2:+.4f}')\nEOF"})
