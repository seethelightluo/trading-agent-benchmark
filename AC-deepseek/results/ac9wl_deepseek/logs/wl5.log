145 def build_artifact(panel):
146     df = panel.copy()
147     df.index = df.index.strftime('%Y-%m-%d')
148     csv_txt = df.to_csv()
149     comp = zlib.compress(csv_txt.encode('utf-8'))
150     b64 = base64.b64encode(comp).decode('ascii')
151     sha = hashlib.sha256(b64.encode('ascii')).hexdigest()
152     return {
153         "format": "base64:zlib:csv",
154         "description": "Factor signal panel: rows = dates (YYYY-MM-DD), cols = 15 watchlist symbols. Recover with zlib.decompress(base64.b64decode(data)).decode() then pd.read_csv(StringIO).",
155         "columns": list(panel.columns),
156         "shape": [int(panel.shape[0]), int(panel.shape[1])],
157         "n_valid_values": int(panel.notna().sum().sum()),
158         "sha256": sha,
159         "data": b64,
160     }
