def load_ohlcv(symbol, days=4000):
    df = get_stock_daily_data(symbol=symbol, days=days)
    if df is None or len(df) == 0:
        return None
    df = df.copy()
    df['date'] = pd.to_datetime(df['date']).dt.normalize()
    df = df.set_index('date').sort_index()
    return df

