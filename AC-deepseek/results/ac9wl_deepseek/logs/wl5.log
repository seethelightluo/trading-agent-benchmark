def def_rel_mom_60(w=60):
    def_basket = LR[['XAU', 'US10Y', 'CN10Y']].mean(axis=1)
    def_cum = def_basket.rolling(w, min_periods=MP(w)).sum()
    asset_cum = LR.rolling(w, min_periods=MP(w)).sum()
    return asset_cum.sub(def_cum, axis=0)

