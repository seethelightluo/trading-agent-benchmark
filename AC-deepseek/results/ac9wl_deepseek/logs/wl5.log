    m['max_abs_library_correlation'] = max_abs_library_corr(ic_s, lib)
    m['regime'] = regime_split(ic_s)
    gate = abs(m['ic']) >= 0.007 and abs(m['icir'] or 0) >= 0.084
    m['gate_pass'] = bool(gate)
