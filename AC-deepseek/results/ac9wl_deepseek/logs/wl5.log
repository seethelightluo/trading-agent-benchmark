k, np.sign(cov) * r2, np.nan)\n    tr30.iloc[i] = signed\npanels['trend_r2_30_signed'] = tr30\nprint('reconstructed trend_r2_30_signed:', tr30.shape)\n\n# ---------- Restrict to visible window <= 2026-07-29 ----------\ncutoff = pd.Timestamp('2026-07-29')\nfor fid in list(panels):\n    panels[fid] = panels[fid][panels[fid].index <= cutoff]\n\n# ---------- Pairwise pooled Spearman on cross-sectional ranks ----------\ndef cs_ranks(df):\n    # rank assets within each date (ascending), NaN preserved\n    return df.rank(axis=1, method='average')\n\nranked = {fid: cs_ranks(df) for fid, df in panels.items()}\nfids_all = list(panels.keys())\nn = len(fids_all)\ncorr = pd.DataFrame(index=fids_all, columns=fids_all, dtype=float)\ncounts = pd.DataFrame(index=fids_all, columns=fids_all, dtype=float)\nfor i in range(n):\n    for j in range(i, n):\n        a, b = fids_all[i], fids_all[j]\n        ra = ranked[a].stack()\n        rb = ranked[b].stack()\n        common = ra.index.intersection(rb.index)\n        x = ra.loc[common].values.astype(float)\n        y = rb.loc[common].values.astype(float)\n        m = ~(np.isnan(x) | np.isnan(y))\n        x, y = x[m], y[m]\n        if len(x) > 30:\n            rho = np.corrcoef(x, y)[0,1]  # Pearson on ranks == Spearman\n        else:\n            rho = np.nan\n        corr.iloc[i,j] = corr.iloc[j,i] = rho\n        counts.iloc[i,j] = counts.iloc[j,i] = len(x)\nprint('\\nPairwise exposure correlation (pooled cross-sectional ranks):')\nprint(corr.round(3))\nprint('\\nn pairs:')\nprint(counts.astype(int))\ncorr.round(3).to_csv('scripts/screener_factor_corr_matrix.csv')\nEOF"})
