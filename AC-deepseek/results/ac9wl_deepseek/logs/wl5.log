    raw = base64.b64decode(artifact['data'])
    csv_txt = zlib.decompress(raw).decode('utf-8')
    df = pd.read_csv(pd.io.common.StringIO(csv_txt), index_col=0)
    df.index = pd.to_datetime(df.index)
    df = df.sort_index()
    return df


