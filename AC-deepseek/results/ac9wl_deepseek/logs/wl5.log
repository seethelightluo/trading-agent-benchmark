gate = (1.0 - vix_pct).reindex(close.index).ffill()
cands["mom_vixgate_20x120"] = mom20 * gate

# F7 vol acceleration: 20d/60d realized vol
cands["vol_accel_20x60"] = (ret.rolling(20, min_periods=15).std()
