def semi_down_ratio_20():
    dn = np.sqrt((np.minimum(R, 0) ** 2).rolling(20).mean())
    up = np.sqrt((np.maximum(R, 0) ** 2).rolling(20).mean())
    return (dn / up - 1.0).replace([np.inf, -np.inf], np.nan)

def mom_120d_skip5():
