 225 def stamp_admission(payload: dict, contract: FactorContract) -> tuple[dict, dict]:
 226     result = evaluate_factor(payload, contract)
 227     stamped = dict(payload)
 228     stamped["benchmark_admission"] = {
 229         "contract": contract.as_dict(),
 230         "selected_metrics": result,
 231         "admitted_at": datetime.now().isoformat(),
 232     }
 233     return stamped, result
