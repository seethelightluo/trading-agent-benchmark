  ▶️ write_file({'file_path': 'scripts/miner_1_20260730_explore_v3.py', 'content': '"""miner_1: Explore 8 NEW cross-asset factor families (2026-07-30 cycle).\n\nUniverse: 15 tradable cross-asset benchmarks, visible window through 2026-07-29.\nCandidates (distinct from quarantined library: mom10/120, vol_of_vol, vix_beta_cond,\nbreadth_cond_mom, dxy_beta, mom_vol_scaled, skew_vol_comp):\n  F1 eff_ratio_60      : Kaufman trend efficiency (signal clarity)\n  F2 mom_dvol_20x60    : 20d momentum scaled by 60d downside semi-deviation\n  F3 vol_asym_60       : down/up realized semi-deviation ratio\n  F4 acorr_shift_20x60 : AR(1) shift of daily returns (mean-reversion regime change)\n  F5 us10y_beta_60     : rolling beta of asset returns to US10Y yield changes (rate beta)\n  F6 mom_vixgate_20x120: 20d momentum gated by VIX percentile (risk-on/off conditioning)\n  F7 vol_accel_20x60   : 20d/60d realized vol ratio (recent vol acceleration)\n  F8 btc_beta_60       : rolling beta to BTC returns (crypto-sensitivity)\nGate: abs(IC10) >= 0.007 and abs(ICIR10) >= 0.084 on >=8-instrument cross-sections.\n"""\nimport sys, json\nimport numpy as np\nimport pandas as pd\nsys.path.insert(0, \'scripts\')\nfrom factor_validate import (closes_panel, macro_closes, forward_returns,\n                             ic_series, summary_metrics, regime_split, WATCH)\n\nVIS = "2026-07-29"\nH = 10\n\nclose = closes_panel(VIS)\nmacro = macro_closes(VIS)\nret = close.pct_change()\nvix = macro["VIX"]\nus10y = close["US10Y"]\nbtc = close["BTC"]\n\ndef down_semidev(s, w):\n    neg = s.clip(upper=0.0)\n    return np.sqrt((neg ** 2).rolling(w).mean())\n\ndef up_semidev(s, w):\n    pos = s.clip(lower=0.0)\n    return np.sqrt((pos ** 2).rolling(w).mean())\n\ndef rolling_beta(x, y, w):\n    """x: asset returns df, y: driver returns series -> beta df."""\n    out = {}\n    for a in x.columns:\n        pair = pd.concat([x[a].rename("a"), y.rename("y")], axis=1).dropna()\n        b = pair["a"].rolling(w).cov(pair["y"]) / pair["y"].rolling(w).var()\n        out[a] = b\n    return pd.DataFrame(out).reindex(x.index)\n\ncands = {}\n\n# F1 trend efficiency: |move| / path length\ncands["eff_ratio_60"] = (close - close.shift(60)).abs() / ret.abs().rolling(60).sum()\n\n# F2 downside-risk-scaled momentum\nmom20 = close.shift(5) / close.shift(25) - 1.0\ncands["mom_dvol_20x60"] = mom20 / down_semidev(ret, 60).clip(lower=1e-6)\n\n# F3 vol asymmetry\ncands["vol_asym_60"] = down_semidev(ret, 60) / up_semidev(ret, 60).clip(lower=1e-6)\n\n# F4 autocorrelation shift\ndef ar1_roll(s, w):\n    return s.rolling(w).apply(lambda z: pd.Series(z).autocorr(1) if len(z) >= 10 else np.nan, raw=False)\nac20 = ret.rolling(20).apply(lambda z: pd.Series(z).autocorr(1) if len(z) >= 10 else np.nan, raw=False)\nac60 = ret.rolling(60).apply(lambda z: pd.Series(z).autocorr(1) if len(z) >= 20 else np.nan, raw=False)\ncands["acorr_shift_20x60"] = ac20 - ac60\n\n# F5 US10Y rate beta (yield changes)\ncands["us10y_beta_60"] = rolling_beta(ret, us10y.pct_change(), 60)\n\n# F6 momentum gated by low-VIX percentile\nvix_pct = vix.rolling(120).rank(pct=True)\ngate = (1.0 - vix_pct).reindex(close.index).ffill()\ncands["mom_vixgate_20x120"] = mom20 * gate\n\n# F7 vol acceleration\nvol20 = ret.rolling(20).std()\nvol60 = ret.rolling(60).std()\ncands["vol_accel_20x60"] = vol20 / vol60.clip(lower=1e-9)\n\n# F8 BTC beta\ncands["btc_beta_60"] = rolling_beta(ret, btc.pct_change(), 60)\n\nfr = forward_returns(close, H)\nresults = {}\nfor fid, sig in cands.items():\n    ic = ic_series(sig, fr, min_valid=8)\n    m = summary_metrics(ic, sig, fr, close, h=H)\n    if m is None:\n        results[fid] = {"gate_pass": False, "reason": "insufficient IC dates"}\n        continue\n    m["regime"] = regime_split(ic)\n    results[fid] = m\n\n# max abs corr vs quarantined library artifacts (provenance only; active library is empty)\nqdir = "factors/quarantine"\nimport zlib, base64, io\nlib_sigs = {}\nfor fn in sorted(__import__("os").listdir(qdir)):\n    if not fn.endswith(".json") or fn.endswith(".reason.json"):\n        continue\n    d = json.load(open(f"{qdir}/{fn}"))\n    art = d.get("validation", {}).get("signal_artifact")\n    if not art:\n        continue\n    try:\n        dec = zlib.decompress(base64.b64decode(art["data"])).decode("utf-8")\n        s = pd.read_csv(io.StringIO(dec), index_col=0)\n        s.index = pd.to_datetime(s.index)\n        lib_sigs[d["factor_id"]] = s.reindex(close.index)\n    except Exception as e:\n        print("skip lib artifact", fn, e)\n\nfor fid, m in results.items():\n    if "ic" not in m:\n        continue\n    ic = None\n    # recompute IC series for rho\n    fr = forward_returns(close, H)\n    ics = ic_series(cands[fid], fr, min_valid=8)\n    best = 0.0\n    for lf, ls in lib_sigs.items():\n        lic = ic_series(ls, fr, min_valid=8)\n        pair = pd.concat([ics.rename("a"), lic.rename("b")], axis=1).dropna()\n        if len(pair) >= 30:\n            r = pair["a"].corr(pair["b"])\n            if np.isfinite(r):\n                best = max(best, abs(float(r)))\n    m["max_abs_library_correlation"] = round(best, 4)\n    m["gate_pass"] = bool(abs(m["ic"]) >= 0.007 and abs(m.get("icir") or 0) >= 0.084)\n\nprint("=" * 100)\nfor fid, m in sorted(results.items()):\n    if "ic" not in m:\n        print(f"{fid:22s} -> {m}")\n        continue\n    print(f"[{fid}] ic10={m[\'ic\']:.4f} icir10={m[\'icir\']} hit={m[\'ic_hit_ratio\']:.3f} "\n          f"n={m[\'n_ic_dates\']} cov_asset={m[\'coverage_asset_days\']:.2f} cov_ge8={m[\'coverage_dates_ge8\']:.2f} "\n          f"turn={m[\'turnover_10d_rank\']} rho_lib={m[\'max_abs_library_correlation\']} "\n          f"GATE={\'PASS\' if m[\'gate_pass\'] else \'fail\'}")\n    print(f"    decay={m[\'decay_ic_by_horizon\']}")\n    print(f"    regimes={ {k: (v[\'ic\'], v[\'icir\'], v[\'n\']) for k, v in m[\'regime\'].items()} }")\n\nwith open("scripts/miner_1_20260730_explore_v3_results.json", "w") as f:\n    json.dump({k: {kk: vv for kk, vv in v.items() if kk not in ("regime",)} for k, v in results.items()}, f, indent=1, default=str)\nprint("saved results json")\n'})
