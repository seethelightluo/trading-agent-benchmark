# 5. 10d lag-1 return autocorrelation
auto = ret.rolling(11).apply(lambda x: np.corrcoef(x[:-1], x[1:])[0, 1] if len(x) == 11 and np.std(x[:-1]) > 0 and np.std(x[1:]) > 0 else np.nan, raw=True)
cands["AUTOCORR_10"] = auto

