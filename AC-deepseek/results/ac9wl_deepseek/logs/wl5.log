  ▶️ shell({'command': 'python - <<\'EOF\'\nimport pandas as pd, numpy as np, os, glob\n\ndef load(path):\n    df = pd.read_csv(path)\n    df.columns = [c.strip().lower() for c in df.columns]\n    date_col = \'date\' if \'date\' in df.columns else df.columns[0]\n    df[date_col] = pd.to_datetime(df[date_col])\n    df = df.sort_values(date_col).reset_index(drop=True)\n    return df, date_col\n\ntrad = [\'000300.SH\',\'SPX\',\'HSI\',\'N225\',\'SX5E\',\'000688.SH\',\'SOX\',\'NDX\',\'XAU\',\'COPPER\',\'WTI\',\'BTC\',\'ETH\',\'US10Y\',\'CN10Y\']\nobs  = [\'DXY\',\'USDCNY\',\'USDJPY\',\'EURUSD\',\'VIX\']\n\npx = {}\nfor s in trad + obs:\n    d, dc = load(f\'../persistent/stock_data/{s}.csv\') if s in trad else load(f\'../persistent/index_data/{s}.csv\')\n    px[s] = d.set_index(dc)[\'close\']\n\nPX = pd.DataFrame(px).sort_index()\nPX = PX[PX.index <= \'2026-07-29\']\nprint("Last date:", PX.index[-1], "| rows:", len(PX))\n\n# 10-day and 60-day returns\nr10 = PX.pct_change(10).iloc[-1]\nr60 = PX.pct_change(60).iloc[-1]\nr5  = PX.pct_change(5).iloc[-1]\nprint("\\n=== Recent returns (last obs) ===")\nfor s in trad:\n    print(f"{s:12s} 5d:{r5[s]*100:7.2f}%  10d:{r10[s]*100:7.2f}%  60d:{r60[s]*100:8.2f}%")\n\n# Trend via 20d vs 60d MA position, and MA slope\nma20 = PX.rolling(20).mean().iloc[-1]\nma60 = PX.rolling(60).mean().iloc[-1]\nlast = PX.iloc[-1]\nprint("\\n=== Trend (close vs MA20/MA60) ===")\nfor s in trad:\n    pos = "UP" if last[s]>ma20[s]>ma60[s] else ("DOWN" if last[s]<ma20[s]<ma60[s] else "MIX")\n    print(f"{s:12s} c/ma20:{last[s]/ma20[s]-1:7.3%}  c/ma60:{last[s]/ma60[s]-1:7.3%}  {pos}")\n\n# Realized vol (annualized, 20d) and 60d\nrv20 = (PX.pct_change().rolling(20).std()*np.sqrt(252)).iloc[-1]\nrv60 = (PX.pct_change().rolling(60).std()*np.sqrt(252)).iloc[-1]\nprint("\\n=== Realized vol (annualized) ===")\nfor s in trad:\n    print(f"{s:12s} vol20:{rv20[s]*100:6.1f}%  vol60:{rv60[s]*100:6.1f}%")\n\n# Observation signals\nprint("\\n=== Obs signals (DXY, VIX, etc) ===")\nfor s in obs:\n    if s in PX.columns:\n        print(f"{s:8s} last:{PX[s].iloc[-1]:.2f}  60d chg:{PX[s].iloc[-1]/PX[s].iloc[-60]-1:+.2%}  20d chg:{PX[s].iloc[-1]/PX[s].iloc[-20]-1:+.2%}")\n\n# Cross-sectional dispersion of 10d returns\nprint("\\nCross-section 10d ret dispersion (std):", PX.pct_change(10).iloc[-1][trad].std().round(4))\n# Median correlation of 20d returns\nret20 = PX.pct_change().iloc[-60:]\nc = ret20[trad].corr()\nprint("Median pairwise corr (20d):", np.median(c.values[np.triu_indices(15,1)]).round(3))\nEOF'})
