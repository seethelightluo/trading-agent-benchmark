def ranks(values, assets):
    valid = sorted((float(v), a) for a, v in values.items() if v is not None and isfinite(float(v)))
    out = {a: .5 for a in assets}
    for i, (_, a) in enumerate(valid): out[a] = i / max(1, len(valid)-1)
