30:def trend_r2_30_signed():
31:    idx = np.arange(len(C))
32:    out = pd.DataFrame(index=C.index, columns=C.columns, dtype=float)
33:    for s in C.columns:
34:        x = np.log(C[s])
35:        win = 30
36:        vals = [np.nan] * (win - 1)
37:        for i in range(win - 1, len(x)):
38:            y = x.iloc[i - win + 1:i + 1]
39:            if y.notna().sum() < 18:
40:                vals.append(np.nan)
41:                continue
42:            yy = y.dropna().values
43:            tt = idx[i - len(yy) + 1:i + 1].astype(float)
44:            tt = tt - tt.mean()
45:            cov = np.cov(tt, yy)[0, 1]
46:            var_t = tt.var()
47:            var_y = yy.var()
48:            r2 = cov * cov / (var_t * var_y) if var_t > 0 and var_y > 0 else np.nan
49:            vals.append(np.sign(cov) * r2)
50:        out[s] = vals
51:    return out
