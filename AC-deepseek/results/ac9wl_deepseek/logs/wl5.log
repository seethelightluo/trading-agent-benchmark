47:         f = factor_panel.loc[d]
48:         r = fwd_ret_panel.loc[d]
49:         m = f.notna() & r.notna()
50:         if m.sum() >= 8:
51:             ic = f[m].rank().corr(r[m].rank())
52:             if not math.isnan(ic):
53:                 ics.append((d, ic))
54:     if not ics:
55:         return None
56:     s = pd.Series([x[1] for x in ics], index=[x[0] for x in ics], dtype=float)
57:     return s
