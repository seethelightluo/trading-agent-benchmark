23:def load_panel(symbols=WATCH, source="stock", visible_through="2026-07-29"):
24:    """Return dict symbol -> DataFrame (date, close, volume...) restricted to visible window."""
25:    d = STOCK_DIR if source == "stock" else INDEX_DIR
