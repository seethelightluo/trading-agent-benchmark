164 def full_validate(factor_panel, ret_panel, horizon=10, label=""):
165     s = rank_ic(factor_panel, ret_panel.shift(-horizon))
166     summ = summarize(s, horizon, label)
167     summ['decay_ic_by_horizon'] = decay_analysis(factor_panel, ret_panel)
168     cov = coverage_turnover(factor_panel, ret_panel, horizon)
169     summ.update(cov)
170     rhos, maxrho = library_max_rho(factor_panel)
171     summ['library_rho_by_factor'] = rhos
172     summ['max_abs_library_correlation'] = round(maxrho, 3)
173     return summ

