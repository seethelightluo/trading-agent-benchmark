        lows[s] = df['low']
        opens[s] = df['open']
    C = pd.DataFrame(closes).sort_index()
    V = pd.DataFrame(vols).sort_index()
    H = pd.DataFrame(highs).sort_index()
    L = pd.DataFrame(lows).sort_index()
    O = pd.DataFrame(opens).sort_index()
