  ▶️ shell({'command': "python - <<'EOF'\nimport pandas as pd, numpy as np, glob, os\n\nassets = ['000300.SH','SPX','HSI','N225','SX5E','000688.SH','SOX','NDX','XAU','COPPER','WTI','BTC','ETH','US10Y','CN10Y']\npx = {}\nfor a in assets:\n    df = pd.read_csv(f'../persistent/stock_data/{a}.csv')\n    df.columns = [c.strip() for c in df.columns]\n    datecol = 'date' if 'date' in df.columns else df.columns[0]\n    df[datecol] = pd.to_datetime(df[datecol])\n    df = df.sort_values(datecol).set_index(datecol)\n    col = 'close' if 'close' in df.columns else df.columns[1]\n    px[a] = df[col].astype(float)\n\nPX = pd.DataFrame(px).dropna(how='all')\nprint('date range:', PX.index.min(), '->', PX.index.max(), 'n=', len(PX))\nprint('last 3 dates:\\n', PX.tail(3).round(2).T)\n\nlast = PX.index[-1]\ndef ret(w):\n    return (PX.iloc[-1]/PX.iloc[-1-w] - 1)*100 if len(PX) > w else np.nan\n\nprint('\\n=== Returns to last date %s ===' % last.date())\nfor w in [5, 10, 21, 63]:\n    r = PX.apply(lambda s: (s.iloc[-1]/s.iloc[-1-w]-1)*100 if len(s.dropna())>w else np.nan)\n    print(f'ret_{w}d: ' + ' '.join(f'{a}:{r[a]:+.1f}%' for a in assets))\n\n# Trend vs 60d MA\nma60 = PX.rolling(60).mean()\nprint('\\n=== price vs MA60 (last) ===')\nprint((PX.iloc[-1]/ma60.iloc[-1]-1).round(3).to_dict())\n\n# 20d realized vol annualized\nrv = PX.pct_change().rolling(20).std().iloc[-1]*np.sqrt(252)*100\nprint('\\n=== 20d realized vol ann% ===')\nprint(rv.round(1).to_dict())\n\n# avg pairwise corr of 21d returns\nrc = PX.pct_change().rolling(21).corr()\nlast_corr = rc.iloc[-1]\nprint('\\navg pairwise corr (21d):', round(last_corr.values[~np.eye(15,dtype=bool)].mean(),3))\nEOF"})
