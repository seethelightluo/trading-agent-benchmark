# serial dependence, shorter window
def autocorr_1(w=40):
    def f(a):
        if len(a) < 5:
            return np.nan
        x, y = a[:-1], a[1:]
        if np.std(x) == 0 or np.std(y) == 0:
            return np.nan
        return float(np.corrcoef(x, y)[0, 1])
    return _apply_win(R, w, f)

