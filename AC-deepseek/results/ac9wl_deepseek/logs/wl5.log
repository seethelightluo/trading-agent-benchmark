f}  60d:{v60:6.1f}")\nprint("\\nAvg 20d vol last:", vol20[watch].iloc[-1].mean().round(1), "| 60d:", vol60[watch].iloc[-1].mean().round(1))\n# cross-sectional dispersion of 20d returns\ndisp = rets[watch].rolling(20).std(axis=1).dropna()\nprint("Cross-sectional dispersion of 20d rets (last):", round(disp.iloc[-1]*100,2), "| 60d avg:", round(disp.iloc[-60:].mean()*100,2))\n# correlation regime: avg pairwise corr of 20d returns\nc = rets[watch].rolling(20).corr()\navg_corr = c.groupby(level=0).apply(lambda x: (x.values[np.triu_indices_from(x.values,1)]).mean(), include_groups=False)\nprint("Avg pairwise 20d corr last:", round(avg_corr.iloc[-1],2), "| 60d avg:", round(avg_corr.iloc[-60:].mean(),2))\n# trend strength: 30d MA slope normalized, ADX-ish\nfor s in [\'SPX\',\'NDX\',\'HSI\',\'XAU\',\'BTC\']:\n    last = px[s].dropna()\n    if len(last)<60: continue\n    ma20 = last.rolling(20).mean().iloc[-1]; ma60 = last.rolling(60).mean().iloc[-1]\n    slope = (ma20/ma60-1)*100\n    print(f"Trend {s}: MA20/MA60 = {ma20/ma60:.4f} (slope {slope:+.2f}%)")\nEOF'})
