en(w))\n\n\ndef vol_of_vol(r):\n    s = r.dropna().tail(120)\n    if len(s) < 90:\n        return None\n    v = s.rolling(20).std()\n    out = v.rolling(60).std().iloc[-1]\n    return None if not math.isfinite(out) else float(out)\n\n\ndef kurt_20(r):\n    s = r.dropna().tail(40)\n    if len(s) < 20:\n        return None\n    k = s.rolling(20, min_periods=8).kurt().iloc[-1]\n    return None if not math.isfinite(k) else float(k)\n\n\ndef dxy_beta(r, dxy_r):\n    z = pd.concat([r.rename("a"), dxy_r.rename("d")], axis=1).dropna().tail(60)\n    if len(z) < 30:\n        return None\n    vd = float(z["d"].var())\n    if vd < 1e-14:\n        return None\n    return float(z["a"].cov(z["d"]) / vd)\n\n\n# ---- build panels ----\npanel = pd.DataFrame({a: load_closes(a) for a in ASSETS}).sort_index()\nrets = panel.pct_change()\n\ndxy = pd.read_csv(f"{IDX}/DXY.csv")\ndxy["date"] = pd.to_datetime(dxy["date"])\ndxy = dxy[dxy["date"] <= END].set_index("date")["close"].astype(float)\ndxy_r = dxy.pct_change()\n\nvix = pd.read_csv(f"{IDX}/VIX.csv")\nvix["date"] = pd.to_datetime(vix["date"])\nvix = vix[vix["date"] <= END].set_index("date")["close"].astype(float)\n\n# ---- factor time series (expanding windows over the panel) ----\ndef factor_panel(fn, needs_dxy=False):\n    out = {}\n    for a in ASSETS:\n        c = panel[a]\n        r = rets[a]\n        vals = {}\n        for dt in panel.index:\n            cc = c.loc[:dt]\n            rr = r.loc[:dt]\n            try:\n                if needs_dxy:\n                    v = fn(rr, dxy_r.loc[:dt])\n                else:\n                    v = fn(cc) if fn in (trend_r2, mom_120, underwater) else fn(rr)\n            except Exception:\n                v = None\n            vals[dt] = v\n        out[a] = pd.Series(vals)\n    return pd.DataFrame(out)\n\n\nFACTORS = {\n    "trend_r2_30_signed": (trend_r2, 1, False),\n    "semi_down_ratio_20": (semi_down_ratio, -1, False),\n    "mom_120d_skip5": (mom_120, 1, False),\n    "vol_of_vol20x60": (vol_of_vol, 1, False),\n    "dxy_beta_60": (dxy_beta, 1, True),\n    "time_under_water_120": (underwater, -1, False),\n    "kurt_20": (kurt_20, 1, False),\n    "mom_10d_skip5": (lambda c: None, 1, False),   # placeholder replaced below\n    "vix_beta_cond_60x20": (lambda c: None, -1, False),\n    "WTI_BETA_60": (lambda c: None, 1, False),\n}\n\n\ndef mom_10(c):\n    if len(c) < 16:\n        return None\n    p0 = float(c.iloc[-16])\n    if p0 <= 0:\n        return None\n    return float(c.iloc[-6]) / p0 - 1.0\n\n\ndef vix_beta(r, vix_r):\n    z = pd.concat([r.rename("a"), vix_r.rename("v")], axis=1).dropna().tail(60)\n    if len(z) < 30:\n        return None\n    vv = float(z["v"].var())\n    if vv < 1e-14:\n        return None\n    return float(z["a"].cov(z["v"]) / vv)\n\n\ndef wti_beta(r, wti_r):\n    z = pd.concat([r.rename("a"), wti_r.rename("w")], axis=1).dropna().tail(60)\n    if len(z) < 30:\n        return None\n    vw = float(z["w"].var())\n    if vw < 1e-14:\n        return None\n    return float(z["a"].cov(z["w"]) / vw)\n\n\n# mom_10d_skip5 (10d return skipping last 5d)\nmp = {}\nfor a in ASSETS:\n    c = panel[a]\n    mp[a] = pd.Series({dt: mom_10(c.loc[:dt]) for dt in panel.index})\nFACTORS["mom_10d_skip5"] = (lambda c: None, 1, False)\nfactor_values = {"mom_10d_skip5": pd.DataFrame(mp)}\n\nwti = load_closes("WTI")\nwti_r_full = wti.pct_change()\nvb = {}\nfor a in ASSETS:\n    r = rets[a]\n    vb[a] = pd.Series({dt: vix_beta(r.loc[:dt], vix.loc[:dt].pct_change()) for dt in panel.index})\nfactor_values["vix_beta_cond_60x20"] = pd.DataFrame(vb)\n\nwb = {}\nfor a in ASSETS:\n    r = rets[a]\n    wb[a] = pd.Series({dt: wti_beta(r.loc[:dt], wti_r_full.loc[:dt]) for dt in panel.index})\nfactor_values["WTI_BETA_60"] = pd.DataFrame(wb)\n\nfor fid, (fn, _, needs_dxy) in FACTORS.items():\n    if fid in factor_values:\n        continue\n    factor_values[fid] = factor_panel(fn, needs_dxy)\n\nfwd = panel.shift(-10) / panel - 1.0  # 10d forward return (t -> t+10)\n\n# ---- IC stats ----\ndef ic_stats(fvals, fwd_ret, start):\n    sub_f = fvals.loc[start:]\n    sub_r = fwd_ret.loc[start:]\n    ics = []\n    for dt in sub_f.index:\n        x = sub_f.loc[dt].dropna()\n        y = sub_r.loc[dt].reindex(x.index).dropna()\n        if len(x) >= 8 and len(y) >= 8:\n            ic = x.rank().corr(y.rank())\n            if math.isfinite(ic):\n                ics.append(ic)\n    ics = np.array(ics)\n    if len(ics) == 0:\n        return None\n    ic_m = ics.mean()\n    icir = ic_m / (ics.std(ddof=1) / math.sqrt(len(ics))) if ics.std(ddof=1) > 0 else 0.0\n    hit = float((ics > 0).mean())\n    return {"n": len(ics), "ic": ic_m, "icir": icir, "hit": hit}\n\nprint(f"{\'factor\':24s} | {\'lib dir\':>4s} | {\'120d ic/icir/hit\':>22s} | {\'60d ic/icir/hit\':>22s} | {\'30d ic\':>8s}")\nrows = []\nfor fid, (_, direction, _) in FACTORS.items():\n    fv = factor_values[fid]\n    r120 = ic_stats(fv, fwd, panel.index[-120])\n    r60 = ic_stats(fv, fwd, panel.index[-60])\n    r30 = ic_stats(fv, fwd, panel.index[-30])\n    def fmt(r):\n        if r is None:\n            return "  n/a  "\n        return f"{r[\'ic\']:+.3f}/{r[\'icir\']:+.2f}/{r[\'hit\']:.2f}"\n    print(f"{fid:24s} | {direction:>4d} | {fmt(r120):>22s} | {fmt(r60):>22s} | {r30[\'ic\'] if r30 else float(\'nan\'):+.3f}")\n    rows.append((fid, direction, r120, r60, r30))\n\n# ---- recent factor correlation (last 60d, cross-sectional spearman per date averaged) ----\nprint("\\nRecent 60d avg cross-sectional |spearman| correlation matrix:")\nfids = list(FACTORS.keys())\ncorr_mat = pd.DataFrame(np.eye(len(fids)), index=fids, columns=fids)\ndates = panel.index[-60:]\nfor i, f1 in enumerate(fids):\n    for j, f2 in enumerate(fids):\n        if j <= i:\n            continue\n        cs = []\n        for dt in dates:\n            x = factor_values[f1].loc[dt].dropna()\n            y = factor_values[f2].loc[dt].reindex(x.index).dropna()\n            if len(x) >= 8:\n                c = x.rank().corr(y.rank())\n                if math.isfinite(c):\n                    cs.append(c)\n        if cs:\n            corr_mat.loc[f1, f2] = corr_mat.loc[f2, f1] = float(np.mean(cs))\nprint(corr_mat.round(2).to_string())\n\n# ---- latest factor snapshot (last date) ----\nprint("\\nLatest factor snapshot (2026-11-04):")\nfor fid in fids:\n    fv = factor_values[fid]\n    last = fv.iloc[-1].dropna()\n    print(f"  {fid:24s} valid={len(last):2d}  top3={list(last.nlargest(3).index)}  bot3={list(last.nsmallest(3).index)}")\n\njson.dump({fid: {"dir": d, "ic120": (r120 and r120["ic"]), "icir120": (r120 and r120["icir"]),\n                 "ic60": (r60 and r60["ic"]), "icir60": (r60 and r60["icir"]),\n                 "ic30": (r30 and r30["ic"])}\n           for fid, d, r120, r60, r30 in rows},\n          open("scripts/screener_20261105_ic_results.json", "w"), indent=1)\nprint("\\nsaved scripts/screener_20261105_ic_results.json")\n'})
