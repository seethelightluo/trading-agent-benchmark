  ▶️ shell({'command': "python - <<'EOF'\nimport pandas as pd, numpy as np\n\nassets = ['000300.SH','000688.SH','SPX','HSI','N225','SX5E','SOX','NDX','XAU','COPPER','WTI','BTC','ETH','US10Y','CN10Y']\ncutoff = '2027-02-24'\ndef load(a):\n    df = pd.read_csv(f'../persistent/stock_data/{a}.csv')\n    df.columns = [c.strip().lower() for c in df.columns]\n    df['date'] = pd.to_datetime(df['date'])\n    df = df[df['date'] <= cutoff].sort_values('date').set_index('date')\n    return df['close'].astype(float)\n\npx = pd.DataFrame({a: load(a) for a in assets})\nret = px.pct_change()\ndxy = pd.read_csv('../persistent/index_data/DXY.csv')\ndxy.columns = [c.strip().lower() for c in dxy.columns]\ndxy['date'] = pd.to_datetime(dxy['date'])\ndxy = dxy[dxy['date'] <= cutoff].sort_values('date').set_index('date')\ndxy_ret = dxy['close'].astype(float).pct_change()\nvix = pd.read_csv('../persistent/index_data/VIX.csv')\nvix.columns = [c.strip().lower() for c in vix.columns]\nvix['date'] = pd.to_datetime(vix['date'])\nvix = vix[vix['date'] <= cutoff].sort_values('date').set_index('date')\nvix_c = vix['close'].astype(float)\n\ndef rank_ic(signal, fwd, dates):\n    ic = []\n    for d in dates:\n        s = signal.loc[d].dropna(); f = fwd.loc[d].reindex(s.index).dropna()\n        common = s.index.intersection(f.index)\n        if len(common) >= 8:\n            ic.append(np.corrcoef(s.loc[common].rank(), f.loc[common].rank())[0,1])\n    return np.array(ic)\n\n# forward 10d returns\nfwd10 = ret.shift(-10)\n# evaluation dates: last ~180 trading days\nall_dates = px.index\neval_dates = all_dates[-180:]\n\nfactors = {}\nfactors['trend_r2_30_signed'] = {}\nfor a in assets:\n    lp = np.log(px[a])\n    t = np.arange(len(lp))\n    c = lp.rolling(30).cov(pd.Series(t, index=lp.index))\n    v = lp.rolling(30).var(); vt = pd.Series(t, index=lp.index).rolling(30).var()\n    r2 = np.sign(c)*c**2/(v*vt)\n    factors['trend_r2_30_signed'][a] = r2\n\nfactors['semi_down_ratio_20'] = {}\nfor a in assets:\n    r = ret[a]\n    dn = (r.clip(upper=0)**2).rolling(20).mean().apply(np.sqrt)\n    up = (r.clip(lower=0)**2).rolling(20).mean().apply(np.sqrt)\n    factors['semi_down_ratio_20'][a] = dn/up - 1\n\nfactors['mom_120d_skip5'] = {a: px[a].shift(5)/px[a].shift(125)-1 for a in assets}\nfactors['mom_10d_skip5'] = {a: px[a].shift(5)/px[a].shift(15)-1 for a in assets}\nfactors['dxy_beta_60'] = {a: ret[a].rolling(60).cov(dxy_ret)/dxy_ret.rolling(60).var() for a in assets}\nfactors['time_under_water_120'] = {}\nfor a in assets:\n    s = px[a]\n    run_max = s.rolling(120, min_periods=20).max()\n    tuw = (s < run_max).astype(float)\n    # days since last max: cumulative count of consecutive below-max days\n    below = (s < run_max).astype(int)\n    grp = (below == 0).cumsum()\n    days = below.groupby(grp).cumsum()\n    factors['time_under_water_120'][a] = days\n\nfactors['vix_beta_cond_60x20'] = {}\nvix_ret = vix_c.pct_change()\nfor a in assets:\n    b = ret[a].rolling(60).cov(vix_ret)/vix_ret.rolling(60).var()\n    cond = (vix_c/vix_c.shift(20)-1)\n    factors['vix_beta_cond_60x20'][a] = -b * cond\n\nfactors['tail_ratio_20'] = {}\nfor a in assets:\n    r = ret[a]\n    q95 = r.rolling(20, min_periods=10).quantile(0.95)\n    q05 = r.rolling(20, min_periods=10).quantile(0.05)\n    factors['tail_ratio_20'][a] = q95 / q05.abs()\n\nfactors['vol_of_vol20x60'] = {a: ret[a].rolling(20).std().rolling(60).std() for a in assets}\nfactors['kurt_20'] = {a: ret[a].rolling(20, min_periods=8).kurt() for a in assets}\n\nres = []\nfor name, series in factors.items():\n    sig = pd.DataFrame(series)\n    ic = rank_ic(sig, fwd10, eval_dates)\n    ic60 = rank_ic(sig, fwd10, eval_dates[-60:])\n    ic120 = rank_ic(sig, fwd10, eval_dates[-120:])\n    if len(ic):\n        res.append((name, round(np.nanmean(ic),4), round(np.nanmean(ic)/ (np.nanstd(ic)/np.sqrt(len(ic))) if np.nanstd(ic)>0 else 0,3),\n                    round(np.nanmean(ic120),4), round(np.nanmean(ic60),4), len(ic)))\nres.sort(key=lambda x: -abs(x[1]))\nprint('factor | IC180 | ICIR180 | IC120 | IC60 | n')\nfor r in res: print(r)\nEOF"})
