   7 def _load_signal_artifact(payload: dict, factor_path: Path) -> np.ndarray | None:
   8     """Load a real signal matrix when the factor provides one.
   9 
  10     A summary field such as ``max_abs_library_correlation: 0`` is never a
  11     signal artifact.  Missing matrices are intentionally returned as None so
  12     the caller can quarantine the legacy factor instead of weakening rho.
  13     """
  14     direct = payload.get("signals")
  15     artifact = payload.get("signal_artifact")
  16     validation = payload.get("validation")
  17     if isinstance(validation, dict):
  18         direct = direct if direct is not None else validation.get("signals")
  19         metrics = validation.get("metrics")
  20         if isinstance(metrics, dict):
  21             artifact = artifact or metrics.get("signal_artifact")
  22     if direct is not None:
  23         try:
  24             array = np.asarray(direct, dtype=float)
  25             return array if array.ndim >= 2 else None
  26         except (TypeError, ValueError):
  27             return None
  28     if not artifact:
  29         return None
  30     path = Path(str(artifact))
  31     if not path.is_absolute():
  32         path = factor_path.parent / path
  33     if not path.exists():
  34         return None
  35     try:
  36         if path.suffix == ".npy":
  37             array = np.load(path, allow_pickle=False)
  38         elif path.suffix == ".npz":
  39             with np.load(path, allow_pickle=False) as archive:
  40                 array = archive[archive.files[0]]
  41         else:
  42             array = np.asarray(json.loads(path.read_text(encoding="utf-8")), dtype=float)
  43         return array if array.ndim >= 2 else None
  44     except (OSError, ValueError, TypeError, json.JSONDecodeError):
  45         return None
  46 
  47 
  48 def _pairwise_abs_spearman(left: np.ndarray, right: np.ndarray) -> float:
  49     """Compute mean cross-sectional absolute Spearman rho over common rows."""
  50     if left.shape != right.shape:
  51         raise ValueError(f"signal shapes differ: {left.shape} vs {right.shape}")
  52     values: list[float] = []
  53     for row_left, row_right in zip(left, right):
  54         finite = np.isfinite(row_left) & np.isfinite(row_right)
  55         if int(finite.sum()) < 2:
  56             continue
  57         rank_left = pd_rank(row_left[finite])
  58         rank_right = pd_rank(row_right[finite])
  59         if np.std(rank_left) <= 1e-12 or np.std(rank_right) <= 1e-12:
  60             continue
  61         values.append(abs(float(np.corrcoef(rank_left, rank_right)[0, 1])))
  62     if not values:
  63         raise ValueError("signal artifacts have no common valid cross-section")
  64     return float(np.mean(values))
  65 
  66 
  67 def pd_rank(values: np.ndarray) -> np.ndarray:
  68     """Small dependency-free average-rank implementation."""
  69     order = np.argsort(values, kind="mergesort")
  70     ranks = np.empty(len(values), dtype=float)
  71     sorted_values = values[order]
  72     start = 0
  73     while start < len(values):
  74         end = start + 1
  75         while end < len(values) and sorted_values[end] == sorted_values[start]:
  76             end += 1
  77         ranks[order[start:end]] = (start + end - 1) / 2.0 + 1.0
  78         start = end
  79     return ranks
  80

