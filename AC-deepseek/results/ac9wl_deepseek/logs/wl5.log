 167 def max_abs_library_corr(my_ic, lib_ics):
 168     """Max abs Pearson correlation between candidate IC series and library IC series."""
 169     if lib_ics is None or len(lib_ics) == 0:
 170         return 0.0
 171     best = 0.0
 172     for fid, s in lib_ics.items():
 173         pair = pd.concat([my_ic.rename("a"), s.rename("b")], axis=1).dropna()
 174         if len(pair) < 30:
 175             continue
 176         r = pair["a"].corr(pair["b"])
 177         if np.isfinite(r):
 178             best = max(best, abs(float(r)))
 179     return round(best, 4)
