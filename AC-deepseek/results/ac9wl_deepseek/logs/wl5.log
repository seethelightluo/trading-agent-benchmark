<｜｜DSML｜｜parameter name="content" string="true"># -*- coding: utf-8 -*-
"""miner_3 2027-03-25: explore batch 2 - additional novel factor families.
Fixes up_down_ratio_20, adds skew/kurt cross-sectional, relative strength,
vol-regime, and interaction factor candidates.
"""
import sys, json, math, glob, os
import numpy as np
import pandas as pd
sys.path.insert(0, 'scripts')
import miner3_lib as L

# --- dynamic library list ---
lib_factors = []
for p in sorted(glob.glob('factors/*.json')):
    if os.path.basename(p) == 'factor_ensemble.json':
        continue
    try:
        d = json.load(open(p))
        if d.get('validation', {}).get('status') == 'EFFECTIVE' and \
           d.get('validation', {}).get('signal_artifact'):
            lib_factors.append(d['factor_id'])
    except Exception:
        pass
L.LIB_FACTORS = lib_factors
print('Library factors for rho check (%d): %s' % (len(lib_factors), lib_factors))

C, V, H, Lw, O = L.load_close_panel(4000)
R = C.pct_change()

def load_macro(name):
    df = pd.read_csv(f'../persistent/index_data/{name}.csv', parse_dates=['date'])
    df['date'] = pd.to_datetime(df['date']).dt.normalize()
    df = df.set_index('date').sort_index()
    return df['close'].reindex(C.index).ffill()

DXY = load_macro('DXY')
VIX = load_macro('VIX')
print(f"Panel: {C.index.min().date()} -> {C.index.max().date()} | {len(C)} dates x {C.shape[1]} assets")

def build(name):
    # ---- fixed vol/return structure ----
    if name == 'up_down_ratio_20':
        up = R.clip(lower=0).rolling(20).sum()
        dn = R.clip(upper=0).rolling(20).sum().abs()
        r = up / dn
        return r.replace([np.inf, -np.inf], np.nan)
    if name == 'skew_60':
        return R.rolling(60).skew()
    if name == 'kurt_60':
        return R.rolling(60).kurt()
    if name == 'rel_strength_20':
        # relative strength: 20d return minus cross-sectional mean 20d return
        m20 = C / C.shift(20) - 1.0
        xs_mean = m20.mean(axis=1)
        return m20.sub(xs_mean, axis=0)
    if name == 'rel_strength_60':
        m60 = C / C.shift(60) - 1.0
        xs_mean = m60.mean(axis=1)
        return m60.sub(xs_mean, axis=0)
    if name == 'vol_regime_20_60':
        # vol regime: 20d vol relative to 120d vol percentile rank (rolling)
        rv20 = R.rolling(20).std()
        rv120 = R.rolling(120).std()
        return (rv20 / rv120).replace([np.inf, -np.inf], np.nan)
    if name == 'drawdown_recovery_60':
        # distance from 60d max drawdown recovery: how much already recovered
        dd = C / C.rolling(60).max() - 1.0
        return dd.rolling(5).max()
    if name == 'mom_60_20_inter':
        # momentum interaction: 60d momentum only when 20d momentum positive
        m60 = C / C.shift(60) - 1.0
        m20 = C / C.shift(20) - 1.0
        mask = (m20 > 0).astype(float)
        return m60.mul(mask)
    if name == 'vol_skew_20':
        # 20d skew scaled by 20d vol (tail asymmetry per unit risk)
        sk = R.rolling(20).skew()
        rv = R.rolling(20).std()
        return (sk / rv).replace([np.inf, -np.inf], np.nan)
    if name == 'vix_regime_mom_20':
        # 20d momentum conditioned on VIX being in low regime (below 20d median)
        mom = C / C.shift(20) - 1.0
        low_vix = (VIX < VIX.rolling(20).median()).astype(float)
        return mom.mul(low_vix, axis=0)
    if name == 'corr_mkt_60':
        mkt = R.mean(axis=1)
        out = pd.DataFrame(index=R.index, columns=R.columns, dtype=float)
        for s in R.columns:
            out[s] = R[s].rolling(60).corr(mkt)
        return out.replace([np.inf, -np.inf], np.nan)
    if name == 'profit_factor_20':
        # profit factor: gross gain / gross loss over 20d
        up = R.clip(lower=0).rolling(20).sum()
        dn = R.clip(upper=0).rolling(20).sum().abs()
        r = up / dn
        return (r - 1.0).replace([np.inf, -np.inf], np.nan)
    if name == 'streak_5':
        # consecutive up-days streak (positive if recent runs are up)
        sign = (R > 0).astype(int)
        streak = pd.DataFrame(0, index=R.index, columns=R.columns, dtype=int)
        for s in R.columns:
            x = sign[s]
            s_series = x * (x.groupby((x != x.shift()).cumsum()).cumcount() + 1)
            streak[s] = s_series
        return streak.astype(float)
    if name == 'downside_vol_20':
        # downside deviation over 20d (vol of only negative returns)
        dn = R.clip(upper=0)
        return dn.rolling(20).std()
    if name == 'ww_ratio_low_rv_20':
        # 20d momentum scaled by inverse vol (vol-normalised momentum)
        m20 = C / C.shift(20) - 1.0
        rv20 = R.rolling(20).std()
        return (m20 / rv20).replace([np.inf, -np.inf], np.nan)
    raise ValueError(name)

CANDIDATES = [
    'up_down_ratio_20', 'skew_60', 'kurt_60', 'rel_strength_20', 'rel_strength_60',
    'vol_regime_20_60', 'drawdown_recovery_60', 'mom_60_20_inter', 'vol_skew_20',
    'vix_regime_mom_20', 'corr_mkt_60', 'profit_factor_20', 'streak_5',
    'downside_vol_20', 'ww_ratio_low_rv_20',
]

out = {'visible_through': str(C.index.max().date()), 'n_dates': len(C), 'n_assets': C.shape[1],
       'library_factors': lib_factors, 'results': {}}
for fid in CANDIDATES:
    try:
        panel = build(fid)
        summ = L.full_validate(panel, R, horizon=10, label=fid)
        ic, icir = summ['ic'], summ['icir']
        gate = (abs(ic) >= 0.007) and (abs(icir) >= 0.084)
        maxrho = summ['max_abs_library_correlation']
        rho_ok = maxrho < 0.5
        summ['pass_gate'] = bool(gate)
        summ['rho_ok'] = bool(rho_ok)
        out['results'][fid] = {k: summ[k] for k in
                               ['label', 'horizon', 'ic', 'icir', 'ic_hit_ratio', 'n_ic_dates',
                                'regime', 'coverage_asset_days', 'coverage_dates_ge8',
                                'turnover_10d_rank', 'decay_ic_by_horizon',
                                'library_rho_by_factor', 'max_abs_library_correlation',
                                'pass_gate', 'rho_ok']}
        print(f"[{fid}] IC={ic:.4f} ICIR={icir:.4f} hit={summ['ic_hit_ratio']:.3f} "
              f"n={summ['n_ic_dates']} cov_ge8={summ['coverage_dates_ge8']:.3f} "
              f"to={summ['turnover_10d_rank']:.3f} maxrho={maxrho:.3f} gate={gate} rho_ok={rho_ok}")
        for name, v in summ['regime'].items():
            print(f"     {name}: IC={v['ic']:.4f} ICIR={v['icir']:.4f} n={v['n']}")
        dec = summ['decay_ic_by_horizon']
        print("     decay: " + ", ".join(f"{h}:{icv:.4f}" for h, icv in dec.items()))
        rhos = {k: v for k, v in summ['library_rho_by_factor'].items() if v is not None and abs(v) >= 0.4}
        if rhos:
            print("     rho>=0.4: " + ", ".join(f"{k}:{v}" for k, v in rhos.items()))
    except Exception as e:
        import traceback; traceback.print_exc()
        out['results'][fid] = {'error': str(e)}
        print(f"[{fid}] ERROR {e}")

with open('scripts/miner_3_20270325_explore_results_batch2.json', 'w') as f:
    json.dump(out, f, indent=1, default=str)
print("\nSaved -> scripts/miner_3_20270325_explore_results_batch2.json")
