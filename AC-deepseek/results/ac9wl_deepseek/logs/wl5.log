spread_mom = spread / spread.shift(20) - 1.0
crypto_cond = b_spread.mul(spread_mom, axis=0)
eval_factor("CRYPTO_SPREAD_BETA_60X20", crypto_cond)

# ---- Candidate 4: Rate spread (US10Y - CN10Y) beta conditional ----
