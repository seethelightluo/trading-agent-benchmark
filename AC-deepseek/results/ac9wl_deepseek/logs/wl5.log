68:                           ("2025-2026", "2025-01-01", "2026-12-31")]:
69:         sub = s[(s.index >= lo) & (s.index <= hi)]
70:         if len(sub) >= 20:
71:             regime[name] = {"ic": round(sub.mean(), 4), "icir": round(sub.mean() / sub.std(), 4) if sub.std() > 0 else 0.0, "n": int(len(sub))}
72:     return {"label": label, "horizon": horizon, "ic": round(ic, 4), "icir": round(icir, 4),
73:             "ic_hit_ratio": round(hit, 3), "n_ic_dates": int(n), "regime": regime}
