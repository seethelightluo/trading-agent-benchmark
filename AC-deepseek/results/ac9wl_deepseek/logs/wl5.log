  ▶️ write_file({'content': '# -*- coding: utf-8 -*-\n"""miner_2 2027-01-28 cycle: screen novel cross-asset factor candidates.\nVisible data through 2027-01-27 (current date 2027-01-28).\n\nAdmission gates on the 15-instrument cross-asset universe (h=10):\n|IC| >= 0.0070 and |ICIR| >= 0.0840. Novelty checked vs library rho.\n\nFamilies (novel vs library: trend_r2_30_signed, semi_down_ratio_20,\nmom_120d_skip5, mom_10d_skip5, vol_of_vol20x60, dxy_beta_60, WTI_BETA_60,\nvix_beta_cond_60x20, time_under_water_120, kurt_20):\n  A) trend consistency: kaufman_er_60, macd_slope_20x10, trend_accel_30,\n                         range_pos_60, mom_250d_skip20\n  B) defensive asymmetry: down_upside_beta_60, down_capture_60,\n                          profit_factor_60, win_rate_60\n  C) vol structure:       rv_ratio_20x60, vol_asym_60, hurst_vr_60\n  D) cross-asset:         def_rel_mom_60 (vs XAU/US10Y/CN10Y defensive basket)\n"""\nimport sys, json, math\nimport numpy as np\nimport pandas as pd\n\nsys.path.insert(0, \'scripts\')\nimport miner3_lib as L\n\nL.LIB_FACTORS = [f for f in L.LIB_FACTORS if f != \'kurt_20\'] + [\'kurt_20\']\n\nVIS = \'2027-01-28\'\nC, V, H, Lo, O = L.load_close_panel(4000)\nmask = C.index < VIS\nC, V, H, Lo, O = C[mask], V[mask], H[mask], Lo[mask], O[mask]\nR = C.pct_change()\nLR = np.log(C).diff()\nEW = LR.mean(axis=1)  # equal-weight cross-asset log-return basket\n\nprint(f"Panel dates: {C.index.min().date()} -> {C.index.max().date()}, {len(C)} rows")\n\n# ---------- A) trend consistency ----------\ndef kaufman_er(w=60):\n    num = (C - C.shift(w)).abs()\n    den = R.abs().rolling(w).sum()\n    return num / den.replace(0, np.nan)\n\ndef macd_slope(w1=12, w2=26, look=10):\n    macd = C.ewm(span=w1, adjust=False).mean() - C.ewm(span=w2, adjust=False).mean()\n    return (macd - macd.shift(look)) / C.replace(0, np.nan)\n\ndef trend_accel_30(w=30):\n    # slope of log-price linear trend, change of slope over w days (acceleration)\n    lr = np.log(C)\n    slope = (lr - lr.shift(w)) / w\n    return slope - slope.shift(w)\n\ndef range_pos_60(w=60):\n    hi = C.rolling(w).max()\n    lo = C.rolling(w).min()\n    return (C - lo) / (hi - lo).replace(0, np.nan)\n\ndef mom_250d_skip20(w=250, skip=20):\n    return C / C.shift(w + skip) - 1.0\n\n# ---------- B) defensive asymmetry ----------\ndef _cond_beta(asset_r, ref_r, cond, w=60):\n    """Rolling beta of asset_r on ref_r restricted to dates where cond(asset_r) is True."""\n    out = pd.DataFrame(index=asset_r.index, columns=asset_r.columns, dtype=float)\n    for i in range(w, len(asset_r)):\n        a = asset_r.iloc[i - w:i]\n        r = ref_r.iloc[i - w:i]\n        m = cond(a)\n        if m.sum() >= 10:\n            out.iloc[i] = a[m].cov(r[m]) / r[m].var()\n    return out\n\ndef down_upside_beta_60(w=60):\n    down_beta = _cond_beta(R, EW, lambda a: a < 0, w)\n    up_beta = _cond_beta(R, EW, lambda a: a > 0, w)\n    return down_beta - up_beta\n\ndef down_capture_60(w=60):\n    return R.rolling(w).apply(lambda a: a[a < 0].mean() if (a < 0).sum() >= 5 else np.nan, raw=True)\n\ndef profit_factor_60(w=60):\n    pos = R.rolling(w).apply(lambda a: a[a > 0].mean() if (a > 0).sum() >= 5 else np.nan, raw=True)\n    neg = R.rolling(w).apply(lambda a: a[a < 0].mean() if (a < 0).sum() >= 5 else np.nan, raw=True)\n    return pos / neg.abs().replace(0, np.nan)\n\ndef win_rate_60(w=60):\n    return (R > 0).rolling(w).mean()\n\n# ---------- C) vol structure ----------\ndef rv_ratio_20x60(w1=20, w2=60):\n    s1 = R.rolling(w1).std(ddof=0)\n    s2 = R.rolling(w2).std(ddof=0)\n    return s1 / s2.replace(0, np.nan)\n\ndef vol_asym_60(w=60):\n    ds = R.rolling(w).apply(lambda a: a[a < 0].std(ddof=0) if (a < 0).sum() >= 5 else np.nan, raw=True)\n    us = R.rolling(w).apply(lambda a: a[a > 0].std(ddof=0) if (a > 0).sum() >= 5 else np.nan, raw=True)\n    return ds / us.replace(0, np.nan)\n\ndef hurst_vr_60(w=60, k=5):\n    vr = R.rolling(w).var(ddof=0) / (R.rolling(w // k).var(ddof=0).rolling(k).mean() * k).replace(0, np.nan)\n    return np.log(vr)\n\n# ---------- D) cross-asset ----------\ndef def_rel_mom_60(w=60):\n    def_basket = LR[[\'XAU\', \'US10Y\', \'CN10Y\']].mean(axis=1)\n    def_cum = def_basket.rolling(w).sum()\n    asset_cum = LR.rolling(w).sum()\n    return asset_cum - def_cum\n\nCANDIDATES = {\n    \'kaufman_er_60\': kaufman_er,\n    \'macd_slope_20x10\': macd_slope,\n    \'trend_accel_30\': trend_accel_30,\n    \'range_pos_60\': range_pos_60,\n    \'mom_250d_skip20\': mom_250d_skip20,\n    \'down_upside_beta_60\': down_upside_beta_60,\n    \'down_capture_60\': down_capture_60,\n    \'profit_factor_60\': profit_factor_60,\n    \'win_rate_60\': win_rate_60,\n    \'rv_ratio_20x60\': rv_ratio_20x60,\n    \'vol_asym_60\': vol_asym_60,\n    \'hurst_vr_60\': hurst_vr_60,\n    \'def_rel_mom_60\': def_rel_mom_60,\n}\n\nresults = {}\nfor name, fn in CANDIDATES.items():\n    try:\n        fp = fn()\n        fp = fp.replace([np.inf, -np.inf], np.nan)\n        s = L.rank_ic(fp, R.shift(-10))\n        if s is None or len(s) < 30:\n            results[name] = {"error": f"insufficient IC dates ({0 if s is None else len(s)})"}\n            print(f"{name}: INSUFFICIENT ({0 if s is None else len(s)} dates)")\n            continue\n        summ = L.summarize(s, 10, name)\n        summ[\'decay_ic_by_horizon\'] = L.decay_analysis(fp, R)\n        cov = L.coverage_turnover(fp, R, 10)\n        summ.update(cov)\n        rhos, maxrho = L.library_max_rho(fp)\n        summ[\'library_rho_by_factor\'] = rhos\n        summ[\'max_abs_library_correlation\'] = round(maxrho, 3)\n        results[name] = summ\n        gate = abs(summ[\'ic\']) >= 0.0070 and abs(summ[\'icir\']) >= 0.0840\n        print(f"{name}: ic={summ[\'ic\']:.4f} icir={summ[\'icir\']:.4f} n={summ[\'n_ic_dates\']} "\n              f"hit={summ[\'ic_hit_ratio\']:.2f} cov_dates={summ[\'coverage_dates_ge8\']:.3f} "\n              f"rho={summ[\'max_abs_library_correlation\']:.3f} decay10={summ[\'decay_ic_by_horizon\'].get(\'10\')} "\n              f"{\'*** PASS ***\' if gate else \'fail\'}")\n    except Exception as e:\n        results[name] = {"error": str(e)}\n        print(f"{name}: ERROR {e}")\n\nwith open(\'scripts/miner_2_20270128_screen_results.json\', \'w\') as f:\n    json.dump(results, f, indent=1, default=str)\nprint("\\nSaved scripts/miner_2_20270128_screen_results.json")\n', 'file_path': 'scripts/miner_2_20270128_screen_batch.py'})
