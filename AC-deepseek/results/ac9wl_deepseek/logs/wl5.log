y:\n    vix = pd.read_csv('../persistent/index_data/VIX.csv')\n    vix['date'] = pd.to_datetime(vix['date'])\n    vix = vix.set_index('date').sort_index()\n    vix = vix[vix.index <= '2026-07-29']\n    print('\\nVIX last:', vix.iloc[-1].to_dict())\nexcept Exception as e:\n    print('VIX err', e)\nEOF"})
