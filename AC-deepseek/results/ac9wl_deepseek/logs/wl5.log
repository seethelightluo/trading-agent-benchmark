  33 # ---------------- candidate factor calculators (return pd.Series indexed by date) ----------------
  34 def rolling_beta(y, x, win):
  35     """rolling beta of y on x over trailing win (requires aligned series)."""
  36     cov = y.rolling(win).cov(x)
  37     var = x.rolling(win).var()
  38     return cov / var
  39 
  40 def factor_high_52w(df, **p):
  41     return df["close"] / df["close"].rolling(p["win"], min_periods=p["win"]//2).max() - 1.0
  42 
  43 def factor_trend_r2(df, **p):
  44     logp = np.log(df["close"])
  45     win = p["win"]
  46     out = pd.Series(np.nan, index=df.index)
  47     x = np.arange(win)
  48     xm = x.mean(); xd = ((x - xm) ** 2).sum()
  49     for i in range(win - 1, len(df)):
  50         y = logp.iloc[i - win + 1:i + 1].values
  51         slope = ((x - xm) * (y - y.mean())).sum() / xd
  52         pred = y.mean() + slope * (x - xm)
  53         ss_res = ((y - pred) ** 2).sum()
  54         ss_tot = ((y - y.mean()) ** 2).sum()
  55         out.iloc[i] = 1.0 - ss_res / ss_tot if ss_tot > 1e-14 else np.nan
  56     return out
  57 
  58 def factor_downside_vol(df, **p):
  59     neg = df["ret"].clip(upper=0)
  60     return neg.rolling(p["win"], min_periods=p["win"]//2).std()
  61 
  62 def factor_skew(df, **p):
  63     return df["ret"].rolling(p["win"], min_periods=p["win"]//2).skew()
  64 
  65 def factor_max_dd(df, **p):
  66     return df["close"] / df["close"].rolling(p["win"], min_periods=p["win"]//2).max() - 1.0
  67 
  68 def factor_eff_ratio(df, **p):
  69     num = (df["close"] - df["close"].shift(p["win"])).abs()
  70     den = df["ret"].abs().rolling(p["win"], min_periods=p["win"]//2).sum()
  71     return num / den
  72 
  73 def factor_autocorr(df, **p):
  74     return df["ret"].rolling(p["win"], min_periods=p["win"]//2).apply(
  75         lambda a: pd.Series(a).autocorr(1) if len(a) >= 8 and pd.Series(a).std() > 1e-14 else np.nan, raw=False)
  76 
  77 def factor_sharpe(df, **p):
  78     m = df["ret"].rolling(p["win"], min_periods=p["win"]//2).mean()
  79     s = df["ret"].rolling(p["win"], min_periods=p["win"]//2).std()
  80     return m / s

