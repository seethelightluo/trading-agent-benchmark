import re, glob, json, os
# Extract all factor names from scripts and results
used = set()
for fp in sorted(glob.glob('scripts/*.py')):
    try:
        txt = open(fp, encoding='utf-8').read()
    except: continue
    # candidate assignments
    for m in re.finditer(r"candidates?\['([^']+)'\]\s*=", txt):
        used.add(m.group(1))
    # also dict-style names in results files
for fp in sorted(glob.glob('scripts/*results*.json')):
    try:
        data = json.load(open(fp))
    except: continue
    def walk(d):
        if isinstance(d, dict):
            for k in d:
                if k not in ('candidates','regime','decay_ic_by_horizon'):
                    yield k
                else:
                    yield from walk(d[k])
        elif isinstance(d, list):
            for x in d: yield from walk(x)
    for k in walk(data):
        if isinstance(k, str) and re.match(r'^[a-z][a-z0-9_]{2,}$', k):
            used.add(k)
# persisted factors file names
for fn in os.listdir('factors'):
    if fn.endswith('.json') and fn != 'factor_ensemble.json':
        used.add(fn.replace('.json',''))
# panels
for fn in os.listdir('scripts/_panels'):
    if fn.endswith('.csv'):
        used.add(fn.replace('.csv',''))

print("USED FACTOR NAMES (%d):" % len(used))
for n in sorted(used):
    print(" ", n)
