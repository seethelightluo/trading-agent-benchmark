            if np.isfinite(r) and abs(float(r)) > best:
                best, best_f = abs(float(r)), lf
    print(f"  {fid}: max_abs_lib_corr={best:.4f} (vs {best_f})")

print("\n=== signal-level raw-value correlation among candidates ===")
for i in range(len(names)):
