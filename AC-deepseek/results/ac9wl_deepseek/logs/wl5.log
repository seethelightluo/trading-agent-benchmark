e=float)\nfor i in range(n):\n    for j in range(i, n):\n        a, b = fids_all[i], fids_all[j]\n        ra = ranked[a].stack(); rb = ranked[b].stack()\n        common = ra.index.intersection(rb.index)\n        x = ra.loc[common].values.astype(float); y = rb.loc[common].values.astype(float)\n        m = ~(np.isnan(x) | np.isnan(y))\n        x, y = x[m], y[m]\n        rho = np.corrcoef(x, y)[0,1] if len(x) > 30 else np.nan\n        corr.iloc[i,j] = corr.iloc[j,i] = rho\n        cnt.iloc[i,j] = cnt.iloc[j,i] = len(x)\npd.set_option('display.width', 200)\nprint('\\nPairwise exposure correlation (Spearman, pooled cross-sectional ranks):')\nprint(corr.round(3))\nprint('\\nn common obs:')\nprint(cnt.astype(int))\ncorr.round(3).to_csv('scripts/screener_factor_corr_matrix.csv')\nEOF"})
