  79 def summary_metrics(ic_ser, factor, fwd_ret, close, h=10, step=10):
  80     """Aggregate metrics for admission."""
  81     ic = ic_ser.dropna()
  82     n = len(ic)
  83     if n < 30:
  84         return None
  85     ic_mean = float(ic.mean())
  86     ic_std = float(ic.std(ddof=1)) if n > 1 else float("nan")
  87     icir = float(ic.mean() / ic.std(ddof=1)) if ic_std and np.isfinite(ic_std) and ic_std > 0 else float("nan")
  88     hit = float((ic > 0).mean()) if ic_mean >= 0 else float((ic < 0).mean())
  89     # coverage: asset-days with valid factor value
  90     valid_mask = factor.notna()
  91     coverage_asset_days = float(valid_mask.sum().sum() / (factor.shape[0] * factor.shape[1])) if factor.shape[0] else 0.0
  92     ge8 = factor.dropna(thresh=8)
  93     coverage_dates_ge8 = float(len(ge8) / len(factor)) if len(factor) else 0.0
  94     # turnover: mean abs change of normalized ranks over `step`-day gaps
  95     r = factor.rank(axis=1, pct=True)
  96     r_step = r.shift(step)
  97     turn = float((r - r_step).abs().mean().mean()) if r_step.notna().any().any() else float("nan")
  98     # decay
  99     decay = {}
 100     for hh in (1, 2, 3, 5, 10, 20):
 101         if hh == h:
 102             decay[str(hh)] = round(ic_mean, 4)
 103         else:
 104             fr = forward_returns(close, hh)
 105             ics = ic_series(factor, fr, min_valid=8)
 106             decay[str(hh)] = round(float(ics.mean()), 4) if len(ics) else None
 107     return {
 108         "ic": round(ic_mean, 4),
 109         "icir": round(icir, 4) if np.isfinite(icir) else None,
 110         "ic_hit_ratio": round(hit, 3),
 111         "n_ic_dates": int(n),
 112         "coverage_asset_days": round(coverage_asset_days, 3),
 113         "coverage_dates_ge8": round(coverage_dates_ge8, 3),
 114         "turnover_10d_rank": round(turn, 3) if np.isfinite(turn) else None,
 115         "decay_ic_by_horizon": decay,
 116     }
