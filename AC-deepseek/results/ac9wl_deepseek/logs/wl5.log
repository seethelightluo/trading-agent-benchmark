24 def load_close_panel(days=4000):
25     closes, vols, highs, lows, opens = {}, {}, {}, {}, {}
26     for s in WATCHLIST:
27         df = load_ohlcv(s, days)
28         closes[s] = df['close']
29         vols[s] = df['volume']
30         highs[s] = df['high']
31         lows[s] = df['low']
32         opens[s] = df['open']
33     C = pd.DataFrame(closes).sort_index()
34     V = pd.DataFrame(vols).sort_index()
35     H = pd.DataFrame(highs).sort_index()
36     L = pd.DataFrame(lows).sort_index()
37     O = pd.DataFrame(opens).sort_index()
38     return C, V, H, L, O
