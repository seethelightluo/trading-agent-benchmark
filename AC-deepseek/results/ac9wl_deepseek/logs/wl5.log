# -*- coding: utf-8 -*-
"""miner_3 2026-10-22: periodic re-validation of all currently EFFECTIVE factors.
Visible data through 2026-10-21. Gates: |IC|>=0.007, |ICIR|>=0.084 @10d.
Recomputes each library factor signal and runs the shared full_validate pipeline."""
import sys, json, math
import numpy as np
import pandas as pd
sys.path.insert(0, 'scripts')
import miner3_lib as L

C, V, H, Lo, O = L.load_close_panel(4000)
R = C.pct_change()

# --- macro observation-only series (DXY, VIX, WTI) for beta factors ---
def load_macro(sym, days=4000):
    df = L.load_ohlcv(sym, days)
    return df['close'] if df is not None else None

DXY = load_macro('DXY')
VIX = load_macro('VIX')

# --- signal builders for existing library factors ---
def trend_r2_30_signed():
    idx = np.arange(len(C))
    out = pd.DataFrame(index=C.index, columns=C.columns, dtype=float)
    for s in C.columns:
        x = np.log(C[s])
        win = 30
        vals = []
        for i in range(win - 1, len(x)):
            y = x.iloc[i - win + 1:i + 1]
            if y.notna().sum() < 18:
                vals.append(np.nan)
                continue
            yy = y.dropna().values
            tt = idx[i - len(yy) + 1:i + 1].astype(float)
            tt = tt - tt.mean()
            cov = np.cov(tt, yy)[0, 1]
            var_t = tt.var()
            var_y = yy.var()
            r2 = cov * cov / (var_t * var_y) if var_t > 0 and var_y > 0 else np.nan
            vals.append(np.sign(cov) * r2)
        out[s] = vals
    return out

def semi_down_ratio_20():
    dn = np.sqrt((np.minimum(R, 0) ** 2).rolling(20).mean())
    up = np.sqrt((np.maximum(R, 0) ** 2).rolling(20).mean())
    return (dn / up - 1.0).replace([np.inf, -np.inf], np.nan)

def mom_120d_skip5():
    return C.shift(5) / C.shift(125) - 1.0

def mom_10d_skip5():
    return C.shift(5) / C.shift(15) - 1.0

def vol_of_vol20x60():
    rv20 = R.rolling(20).std()
    return rv20.rolling(60).std()

def dxy_beta_60():
    rd = DXY.pct_change()
    return R.rolling(60).cov(rd) / rd.rolling(60).var()

def time_under_water_120():
    rollmax = C.rolling(120).max()
    out = pd.DataFrame(index=C.index, columns=C.columns, dtype=float)
    for s in C.columns:
        rm = rollmax[s]
        tuw = np.nan
        vals = []
        for i in range(len(C)):
            if pd.isna(rm.iloc[i]):
                vals.append(np.nan); continue
            if C[s].iloc[i] >= rm.iloc[i] - 1e-12:
                tuw = 0
            elif not pd.isna(tuw):
                tuw += 1
            vals.append(tuw)
        out[s] = vals
    return out

def kurt_20():
    return R.rolling(20, min_periods=8).kurt()

def WTI_BETA_60():
    rw = C['WTI'].pct_change()
    return R.rolling(60).cov(rw) / rw.rolling(60).var()

def vix_beta_cond_60x20():
    rv = VIX.pct_change()
    beta = R.rolling(60).cov(rv) / rv.rolling(60).var()
    vix_chg = VIX / VIX.shift(20) - 1.0
    return -beta * vix_chg

