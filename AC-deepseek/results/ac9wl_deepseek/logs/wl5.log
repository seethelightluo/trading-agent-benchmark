  51 def ic_series(factor, fwd_ret, min_valid=8):
  52     """Daily cross-sectional Spearman rank IC between factor and forward return.
  53 
  54     factor: DataFrame (dates x assets) of factor values (aligned dates).
  55     fwd_ret: DataFrame (dates x assets) of forward h-day returns.
  56     Returns Series of IC per date (NaN where < min_valid valid pairs).
  57     """
  58     dates = factor.index.intersection(fwd_ret.index)
  59     ics = {}
  60     for d in dates:
  61         f = factor.loc[d]
  62         r = fwd_ret.loc[d]
  63         pair = pd.concat([f.rename("f"), r.rename("r")], axis=1).dropna()
  64         if len(pair) < min_valid:
  65             continue
  66         if pair["f"].nunique() < 3 or pair["r"].nunique() < 2:
  67             continue
  68         ic = pair["f"].corr(pair["r"], method="spearman")
  69         if np.isfinite(ic):
  70             ics[d] = ic
  71     return pd.Series(ics, dtype=float)
  72 
  73 
  74 def forward_returns(close, h=10):
  75     """Forward h-day return: fwd_ret_t = close_{t+h}/close_t - 1 (visible-window safe)."""
  76     return close.shift(-h) / close - 1.0
  77 
