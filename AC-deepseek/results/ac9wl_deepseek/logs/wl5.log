85     factor_ids: list[str] | None = None,
86     horizon_days: int = 10,
87     bypass_gate: bool = False,
88 ) -> dict:
89     """Rebuild the portfolio at target weights using fractional asset units.
90 
91     The first allocation is free. Later rebalances charge 3 bps once on the
92     notional transferred out of overweight assets. Cash is zero afterwards.
93     """
94     account_path = Path(account_file_path)
95     account = load_json(account_path)
96     assert_current_portfolio_contract(account)
97     date_state = load_json(date_file_path)
98     current_date = str(date_state["current_date"])
99     assets = [str(asset) for asset in account.get("watch_list", [])]
100     if len(assets) != 15 or len(set(assets)) != 15:
101         raise ValueError("benchmark rebalance requires exactly 15 unique tradable assets")
102     if set(target_weights) != set(assets):
103         missing = sorted(set(assets) - set(target_weights))
104         extra = sorted(set(target_weights) - set(assets))
105         raise ValueError(
106             f"target_weights must cover all 15 assets; missing={missing}, extra={extra}"
107         )
108     weights = {asset: float(target_weights[asset]) for asset in assets}
109     if any(not math.isfinite(weight) or weight < 0.0 for weight in weights.values()):
110         raise ValueError("target weights must be finite and non-negative")
111     total_weight = sum(weights.values())
112     if abs(total_weight - 1.0) > 1e-6:
113         raise ValueError(f"target weights must sum to 1, got {total_weight}")
114     weights[assets[-1]] += 1.0 - total_weight
115 
116     dataset_dir = Path(dataset_dir_path)
117     prices = {asset: _execution_price(dataset_dir, asset, current_date) for asset in assets}
118     current_values = {asset: 0.0 for asset in assets}
119     for position in account.get("positions", []):
120         symbol = str(position["symbol"])
