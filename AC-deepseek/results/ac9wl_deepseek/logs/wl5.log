  ▶️ shell({'command': 'python << \'EOF\'\nimport pandas as pd, numpy as np, os\n\nassets = [\'000300.SH\',\'SPX\',\'HSI\',\'N225\',\'SX5E\',\'000688.SH\',\'SOX\',\'NDX\',\'XAU\',\'COPPER\',\'WTI\',\'BTC\',\'ETH\',\'US10Y\',\'CN10Y\']\ndata = {}\nfor a in assets:\n    df = pd.read_csv(f\'../persistent/stock_data/{a}.csv\')\n    df[\'date\'] = pd.to_datetime(df[\'date\'])\n    df = df.sort_values(\'date\').set_index(\'date\')\n    data[a] = df[\'close\']\n\npx = pd.DataFrame(data)\npx = px.dropna(how=\'all\')\nprint("date range:", px.index.min(), "->", px.index.max(), "rows:", len(px))\nlast = px.index[-1]\nprint("last date:", last.date())\n\nrets = px.pct_change()\n# returns over windows\nfor w in [5, 10, 21, 63]:\n    r = px.iloc[-1] / px.iloc[-1-w] - 1 if len(px) > w else np.nan\n    print(f"\\n{w}d return (%):")\n    print((r*100).round(2).to_string())\n\n# 21d realized vol (annualized)\nvol21 = rets.tail(21).std() * np.sqrt(252)\nprint("\\n21d realized vol (ann %):")\nprint((vol21*100).round(1).to_string())\n\n# Trend: 30d return vs 60d return (MA slope proxy)\nprint("\\n30d vs 60d returns (trend proxy):")\nprint(pd.DataFrame({\'r30\': (px.iloc[-1]/px.iloc[-1-30]-1)*100, \'r60\': (px.iloc[-1]/px.iloc[-1-60]-1)*100}).round(2).to_string())\n\n# Correlation of 21d returns (avg pairwise)\nc = rets.tail(21).corr()\nvals = c.values[np.triu_indices_from(c.values, k=1)]\nprint("\\navg pairwise corr 21d:", round(np.nanmean(vals),3), "max:", round(np.nanmax(vals),3))\nEOF'})
