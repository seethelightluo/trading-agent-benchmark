import pandas as pd, numpy as np

syms = ['000300.SH','SPX','HSI','N225','SX5E','000688.SH','SOX','NDX','XAU','COPPER','WTI','BTC','ETH','US10Y','CN10Y']
cut = '2026-12-02'
px = {}
for s in syms:
    df = pd.read_csv(f'../persistent/stock_data/{s}.csv')
    df['date'] = pd.to_datetime(df['date'])
    df = df[df['date'] <= cut].set_index('date').sort_index()
    px[s] = df['close']
PX = pd.DataFrame(px)
RET = PX.pct_change()

idx = {}
for s in ['DXY','VIX']:
    df = pd.read_csv(f'../persistent/index_data/{s}.csv')
    df['date'] = pd.to_datetime(df['date'])
    df = df[df['date'] <= cut].set_index('date').sort_index()
    col = 'close' if 'close' in df.columns else df.columns[1]
    idx[s] = df[col]
IDX = pd.DataFrame(idx); IDXR = IDX.pct_change()

def beta(x, y, w):
    return x.rolling(w).cov(y) / y.rolling(w).var()

lp = np.log(PX)
t = np.arange(len(PX))
def signed_r2_series(series, w=30):
    out = pd.Series(np.nan, index=series.index)
    for i in range(w-1, len(series)):
        seg = series.iloc[i-w+1:i+1]
        tt = t[i-w+1:i+1]
        valid = seg.notna().values
        if valid.sum() < 18: continue
        tt = tt[valid]; ss = seg.values[valid]
        cov = np.cov(tt, ss)[0,1]
        var_t = np.var(tt); var_s = np.var(ss)
        if var_t==0 or var_s==0: continue
        out.iloc[i] = np.sign(cov) * cov**2/(var_t*var_s)
    return out

F = {}
F['trend_r2_30_signed'] = pd.DataFrame({c: signed_r2_series(lp[c]) for c in lp.columns})
F['mom_120d_skip5'] = PX.shift(5)/PX.shift(125) - 1
F['mom_10d_skip5'] = PX.shift(5)/PX.shift(15) - 1
down = RET.clip(upper=0).pow(2).rolling(20).mean().pow(0.5)
up = RET.clip(lower=0).pow(2).rolling(20).mean().pow(0.5)
F['semi_down_ratio_20'] = down/up - 1
rollmax = PX.rolling(120, min_periods=1).max()
def days_since_max_col(px_c, rm_c):
    out = pd.Series(np.nan, index=px_c.index)
    counter = 0; vals=[]
    for i in range(len(px_c)):
        if np.isnan(rm_c.iat[i]) or np.isnan(px_c.iat[i]):
            vals.append(np.nan); continue
        counter = 0 if px_c.iat[i] >= rm_c.iat[i]-1e-12 else counter+1
        vals.append(counter)
    return pd.Series(vals, index=px_c.index)
F['time_under_water_120'] = pd.DataFrame({c: days_since_max_col(PX[c], rollmax[c]) for c in PX.columns})
F['kurt_20'] = RET.rolling(20).kurt()
rv20 = RET.rolling(20).std()
F['vol_of_vol20x60'] = rv20.rolling(60).std()
F['dxy_beta_60'] = beta(RET, IDXR['DXY'], 60)
F['WTI_BETA_60'] = beta(RET, RET['WTI'], 60)
F['vix_beta_cond_60x20'] = -beta(RET, IDXR['VIX'], 60) * (IDX['VIX']/IDX['VIX'].shift(20) - 1)

FWD = PX.shift(-10)/PX - 1

ic = {}
for name, ff in F.items():
    rows=[]
    for dt in ff.index:
        x = ff.loc[dt]; y = FWD.loc[dt]
        m = x.notna() & y.notna()
        if m.sum() >= 8:
            rows.append((dt, x[m].rank().corr(y[m].rank())))
    ic[name] = pd.Series(dict(rows))

print("=== Recent IC stats (last 120d / 60d / all) ===")
for name in F:
    s = ic[name].dropna()
    def stats(x):
        if len(x)<10: return (np.nan,np.nan,len(x))
        return (x.mean(), x.mean()/x.std()*np.sqrt(252/10), len(x))
    m120,i120,n120 = stats(s[s.index >= s.index[-1]-pd.Timedelta(days=120)])
    m60,i60,n60 = stats(s[s.index >= s.index[-1]-pd.Timedelta(days=60)])
    m_all,i_all,n_all = stats(s)
    print(f"{name:24s} ic120={m120:+.4f} icir120={i120:+.2f} n={n120} | ic60={m60:+.4f} icir60={i60:+.2f} n={n60} | ic_all={m_all:+.4f} icir_all={i_all:+.2f} n={n_all}")

print("\n=== Factor signal pairwise correlation (last 120d, cross-sectional avg) ===")
sub_idx = F['kurt_20'].index
sub_idx = sub_idx[sub_idx >= sub_idx[-1]-pd.Timedelta(days=120)]
names = list(F.keys())
corr_mat = pd.DataFrame(index=names, columns=names, dtype=float)
for a in names:
    for b in names:
        cs=[]
        for dt in sub_idx:
            xa = F[a].loc[dt]; xb = F[b].loc[dt]
            m = xa.notna() & xb.notna()
            if m.sum()>=8:
                cs.append(xa[m].rank().corr(xb[m].rank()))
        corr_mat.loc[a,b] = np.nanmean(cs) if cs else np.nan
print(corr_mat.round(2).to_string())

# Save factors for further use
import json, zlib, base64, io
for name, ff in F.items():
    ff.to_csv(f'/tmp/factor_{name}.csv')
