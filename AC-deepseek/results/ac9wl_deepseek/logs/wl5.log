c[-1]*100,2), "| 3m avg:", round(disp.iloc[-60:].mean()*100,2), "| 1y avg:", round(disp.iloc[-250:].mean()*100,2))\n# trend breadth: how many of 15 above 60d MA\nabove = []\nfor s in watch:\n    last = ser[s].dropna()\n    if len(last)>60 and last.iloc[-1] > last.rolling(60).mean().iloc[-1]: above.append(s)\nprint("Assets above 60d MA:", len(above), above)\n# drawdown check for recent max drawdown on SPX\nspx = ser[\'SPX\'].dropna()\ndd = (spx/spx.cummax()-1)\nprint("SPX max DD (3m):", round(dd.tail(60).min()*100,2), "% | current DD from peak:", round(dd.iloc[-1]*100,2), "%")\nhsi = ser[\'HSI\'].dropna()\nddh = (hsi/hsi.cummax()-1)\nprint("HSI max DD (3m):", round(ddh.tail(60).min()*100,2), "%")\nEOF'})
