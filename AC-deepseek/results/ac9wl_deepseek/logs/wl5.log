   8 def enforce_library(directory: str | Path, contract: FactorContract) -> dict[str, Any]:
   9     """Validate active factor files and retain all up to cap, then best-N above cap."""
  10     root = Path(directory)
  11     root.mkdir(parents=True, exist_ok=True)
  12     admitted: list[tuple[float, str, Path, np.ndarray]] = []
  13     rejected: list[str] = []
  14     quarantined: list[str] = []
  15     evicted: list[str] = []
  16     conflicts_audit: list[dict[str, Any]] = []
  17 
  18     for path in sorted(root.glob("*.json")):
  19         # The Screener may persist the active ensemble beside factor files.
  20         # It is a consumer artifact, not a library member and must never enter
  21         # admission, capacity sorting, or eviction.
  22         if path.name == "factor_ensemble.json":
  23             continue
  24         try:
  25             payload = json.loads(path.read_text(encoding="utf-8"))
  26             stamped, metrics = stamp_admission(payload, contract)
  27             signal = _load_signal_artifact(stamped, path)
  28             if signal is None:
  29                 raise ValueError(
  30                     "factor has no recoverable signal artifact; quarantine instead of assuming rho=0"
  31                 )
  32         except Exception as exc:
  33             bucket = "quarantine" if "signal artifact" in str(exc) else "rejected"
  34             archived = _archive(path, bucket)
  35             atomic_write_json(
  36                 archived.with_suffix(archived.suffix + ".reason.json"),
  37                 {"source": path.name, "reason": str(exc), "contract": contract.as_dict()},
  38             )
  39             (quarantined if bucket == "quarantine" else rejected).append(path.name)
  40             continue
  41         atomic_write_json(path, stamped)
  42         admitted.append((float(metrics["quality"]), str(payload.get("factor_id", path.stem)), path, signal))
  43 
  44     # Quality order makes conflict resolution deterministic: when rho >= .5,
  45     # the first factor wins and the lower-quality member is archived.
  46     ordered: list[tuple[float, str, Path, np.ndarray]] = []
  47     for candidate in sorted(admitted, key=lambda item: (-item[0], item[1], item[2].name)):
  48         conflicts = []
  49         for kept in ordered:
  50             rho = _pairwise_abs_spearman(candidate[3], kept[3])
  51             if rho >= contract.correlation_threshold:
  52                 conflicts.append((kept, rho))
  53         if conflicts:
  54             archived = _archive(candidate[2], "evicted")
  55             conflict_record = {
  56                 "source": candidate[2].name,
  57                 "factor_id": candidate[1],
  58                 "reason": "pairwise correlation conflict; lower quality",
  59                 "quality": candidate[0],
  60                 "conflicts": [
  61                     {"factor_id": item[1], "abs_spearman_rho": rho}
  62                     for item, rho in conflicts
  63                 ],
  64                 "contract": contract.as_dict(),
  65             }
  66             atomic_write_json(
  67                 archived.with_suffix(archived.suffix + ".reason.json"),
  68                 conflict_record,
  69             )
  70             conflicts_audit.append(conflict_record)
  71             evicted.append(candidate[2].name)
  72         else:
  73             ordered.append(candidate)
  74 
  75     # This is the single quality ordering for the library gate.  Reuse the
  76     # ordered list for both eviction and the audit payload; do not sort the
  77     # same library a second time just to report it.
  78     if len(ordered) > contract.library_capacity:
  79         keep = {path for _, _, path, _ in ordered[: contract.library_capacity]}
  80         for _, _, path, _ in ordered:
  81             if path not in keep:
  82                 _archive(path, "evicted")
  83                 evicted.append(path.name)
  84         ordered = [item for item in ordered if item[2] in keep]
  85 
  86     return {
  87         "kept": len(ordered),
  88         "capacity": contract.library_capacity,
  89         "rejected": rejected,
  90         "evicted": evicted,
  91         "kept_files": [path.name for _, _, path, _ in ordered],
  92         "quarantined": quarantined,
  93         "conflicts": conflicts_audit,
  94         "policy": "worldline_pairwise_signal_quality_v1",
  95     }
