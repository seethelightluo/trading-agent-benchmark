11:def fast_ic_series(factor, fwd_ret, min_valid=8):
12:    """Vectorized daily cross-sectional Spearman rank IC.
13:
14:    factor / fwd_ret: DataFrames dates x assets.
15:    Returns Series of IC per date.
16:    """
17:    factor = factor.reindex(fwd_ret.index)
18:    valid = factor.notna() & fwd_ret.notna()
19:    n = valid.sum(axis=1)
20:    f_rank = factor.rank(axis=1, pct=False).where(valid)
21:    r_rank = fwd_ret.rank(axis=1, pct=False).where(valid)
22:    mf = f_rank.sum(axis=1) / n
23:    mr = r_rank.sum(axis=1) / n
24:    cf = f_rank.sub(mf, axis=0).where(valid)
25:    cr = r_rank.sub(mr, axis=0).where(valid)
26:    cov = (cf * cr).sum(axis=1) / n
27:    sf = (cf ** 2).sum(axis=1)
28:    sr = (cr ** 2).sum(axis=1)
29:    denom = np.sqrt(sf * sr)
30:    ic = cov / denom.replace(0, np.nan)
31:    ic = ic.where(n >= min_valid)
32:    ic = ic.replace([np.inf, -np.inf], np.nan)
33:    return ic
