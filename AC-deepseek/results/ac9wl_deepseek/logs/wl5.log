    dt = time.time() - t0
    if m is None:
        print(f"{fid}: INSUFFICIENT ({len(ic_s)} ic dates) [{dt:.1f}s]", flush=True)
        results[fid] = {"gate_pass": False, "reason": "insufficient IC dates",
