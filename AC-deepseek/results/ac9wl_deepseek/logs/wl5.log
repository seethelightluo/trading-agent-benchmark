50     if name == 'up_down_ratio_20':
51         up = R.where(R > 0); dn = R.where(R < 0)
52         upm = up.rolling(20).mean(); dnm = dn.rolling(20).mean().abs()
53         return (upm / dnm).replace([np.inf, -np.inf], np.nan)
54     if name == 'pos_day_ratio_20':
55         return (R > 0).astype(float).rolling(20).mean()
56     if name == 'ac1_30':
57         # lag-1 autocorrelation of daily returns over trailing 30d (trend persistence)
58         out = pd.DataFrame(index=R.index, columns=R.columns, dtype=float)
59         for s in R.columns:
60             x = R[s]
61             out[s] = x.rolling(30).corr(x.shift(1))
62         return out
63     if name == 'cvar_20':
64         # mean of the worst 5 daily returns over 20d (tail magnitude, negative)
65         return R.rolling(20).apply(lambda a: np.mean(np.sort(a)[:5]) if len(a) >= 20 else np.nan, raw=True)
66     if name == 'mom_vol_adj_20':
67         rv20 = R.rolling(20).std()
68         return ((C / C.shift(20) - 1.0) / rv20).replace([np.inf, -np.inf], np.nan)
69     if name == 'rev_10_vol_20':
70         # short-term reversal scaled by vol: high-vol assets reverse more
