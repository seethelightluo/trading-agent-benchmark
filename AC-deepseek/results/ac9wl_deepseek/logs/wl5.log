        if not os.path.exists(fp):
            continue
        df = pd.read_csv(fp, parse_dates=["date"])
        df = df[df["date"] <= pd.Timestamp(visible_through)].reset_index(drop=True)
        if "close" in df.columns:
            out[s] = df
    return out


