72: def ic_series(fvals: pd.DataFrame, fwd: pd.DataFrame) -> pd.Series:
73:     idx = fvals.index.intersection(fwd.index)
74:     ics = {}
75:     for t in idx:
76:         x = fvals.loc[t]
77:         y = fwd.loc[t]
78:         m = x.notna() & y.notna()
79:         if m.sum() >= MIN_ASSETS:
80:             rho, _ = spearmanr(x[m], y[m])
81:             if np.isfinite(rho):
82:                 ics[t] = rho
83:     return pd.Series(ics)
