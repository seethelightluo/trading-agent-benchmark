107:def panel_correlation(a, b):
108:    """Pearson correlation of two factor panels on common (date, asset) pairs."""
109:    common = a.index.intersection(b.index)
110:    ac = a.loc[common].stack()
111:    bc = b.loc[common].stack()
112:    m = ac.notna() & bc.notna()
113:    if m.sum() < 30:
114:        return 0.0
115:    return float(ac[m].corr(bc[m]))
