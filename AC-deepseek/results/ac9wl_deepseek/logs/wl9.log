119 def library_correlation(factor_frame):
120     """Max abs Pearson correlation of candidate signal panel vs persisted library artifacts
121     (restricted to the overlapping validation window)."""
122     max_r = 0.0
123     detail = {}
124     for f in sorted(FACTOR_DIR.glob("*.json")):
125         if f.name == "factor_ensemble.json":
126             continue
127         try:
128             d = json.load(open(f))
129             art = d.get("validation", {}).get("signal_artifact")
130             if not art or "data" not in art:
131                 continue
132             csv = zlib.decompress(base64.b64decode(art["data"])).decode()
133             lib = pd.read_csv(io.StringIO(csv), index_col=0, parse_dates=True)
134         except Exception as e:
135             print(f"  [lib_corr] skip {f.name}: {e}")
136             continue
137         common_dates = factor_frame.index.intersection(lib.index)
138         if len(common_dates) < 120:
139             continue
140         a = factor_frame.loc[common_dates]
141         b = lib.loc[common_dates, factor_frame.columns]
142         pair = pd.concat([a.stack().rename("x"), b.stack().rename("y")], axis=1).dropna()
143         if len(pair) < 500:
144             continue
145         r = float(pair["x"].corr(pair["y"]))
146         detail[f.name] = round(r, 4)
147         max_r = max(max_r, abs(r))
148     return max_r, detail
