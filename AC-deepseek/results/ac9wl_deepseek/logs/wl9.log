56 def weekday_grid(closes, start=VALID_START, end=VALID_END):
57     dates = sorted({d for s in closes.values() for d in s.index})
58     dates = [d for d in dates if start <= d.strftime("%Y-%m-%d") <= end and d.weekday() < 5]
59     return pd.DatetimeIndex(dates)
