            "dependencies": ["close", "high", "low"],
            "parameters": {"window": 20},
            "tags": ["volatility", "price-structure", "cross-asset"],
            "vals_fn": lambda a: hi_lo_range_20(closes[a], highs[a], lows[a], 20),
