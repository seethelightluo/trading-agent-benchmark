81: def rank_ic(factor_frame, ret_frame, min_valid=8):
82:     """Daily cross-sectional Spearman IC between factor values and forward returns."""
83:     ics, dates = [], []
84:     for t in factor_frame.index:
85:         f = factor_frame.loc[t]
86:         r = ret_frame.loc[t]
87:         pair = pd.concat([f.rename("f"), r.rename("r")], axis=1).dropna()
88:         if len(pair) < min_valid:
89:             continue
90:         ic = pair["f"].rank().corr(pair["r"].rank())
91:         if np.isfinite(ic):
92:             ics.append(ic)
93:             dates.append(t)
94:     return pd.Series(ics, index=pd.DatetimeIndex(dates), name="ic")
95: 
96: 
97: def turnover_rank10(factor_frame):
98:     """Mean abs change in cross-sectional rank percentile between 10-trading-day-spaced dates."""
99:     dates = factor_frame.index[::10]
100:     chg = []
101:     for i in range(1, len(dates)):
102:         a = factor_frame.loc[dates[i - 1]].rank(pct=True)
103:         b = factor_frame.loc[dates[i]].rank(pct=True)
104:         pair = pd.concat([a.rename("a"), b.rename("b")], axis=1).dropna()
105:         if len(pair) >= 8:
106:             chg.append(float((pair["a"] - pair["b"]).abs().mean()))
107:     return float(np.mean(chg)) if chg else float("nan")
108: 
109: 
110: def decay_profile(closes, factor_frame, horizons=(1, 2, 3, 5, 10, 20)):
111:     prof = {}
112:     for h in horizons:
113:         rets = forward_returns(closes, h)
114:         ret_frame = pd.DataFrame({a: rets[a].reindex(factor_frame.index) for a in factor_frame.columns})
115:         ic = rank_ic(factor_frame, ret_frame)
116:         prof[str(h)] = round(float(ic.mean()), 4) if len(ic) else float("nan")
117:     return prof
118: 
119: 
120: def library_correlation(factor_frame):
121:     """Max abs Pearson correlation of candidate signal panel vs persisted library artifacts
122:     (restricted to the overlapping validation window)."""
123:     max_r = 0.0
124:     detail = {}
125:     for f in sorted(FACTOR_DIR.glob("*.json")):
126:         if f.name == "factor_ensemble.json":
127:             continue
128:         try:
129:             d = json.load(open(f))
130:             art = d.get("validation", {}).get("signal_artifact")
131:             if not art or "data" not in art:
132:                 continue
133:             csv = zlib.decompress(base64.b64decode(art["data"])).decode()
134:             lib = pd.read_csv(io.StringIO(csv), index_col=0, parse_dates=True)
135:         except Exception as e:
136:             print(f"  [lib_corr] skip {f.name}: {e}")
137:             continue
138:         common_dates = factor_frame.index.intersection(lib.index)
139:         if len(common_dates) < 120:
140:             continue
141:         a = factor_frame.loc[common_dates]
142:         b = lib.loc[common_dates, factor_frame.columns]
143:         pair = pd.concat([a.stack().rename("x"), b.stack().rename("y")], axis=1).dropna()
144:         if len(pair) < 500:
145:             continue
146:         r = float(pair["x"].corr(pair["y"]))
147:         detail[f.name] = round(r, 4)
148:         max_r = max(max_r, abs(r))
149:     return max_r, detail
150: 
151: 
152: def evaluate(closes, values, label, horizon=10, verbose=True):
153:     """Full validation pipeline for one candidate factor."""
154:     frame = to_frame(closes, values)
155:     rets = forward_returns(closes, horizon)
156:     ret_frame = pd.DataFrame({a: rets[a].reindex(frame.index) for a in frame.columns})
157:     ic = rank_ic(frame, ret_frame)
158:     n_ic = len(ic)
159:     ic_mean = float(ic.mean()) if n_ic else float("nan")
160:     ic_std = float(ic.std(ddof=1)) if n_ic > 2 else float("nan")
161:     icir = ic_mean / ic_std if ic_std and np.isfinite(ic_std) else float("nan")
162:     hit = float((np.sign(ic) == np.sign(ic_mean)).mean()) if n_ic and ic_mean != 0 else float("nan")
163:     cov_asset_days = float(frame.notna().sum().sum() / (len(frame) * len(frame.columns)))
164:     cov_dates_ge8 = float((frame.notna().sum(axis=1) >= 8).mean())
165:     to = turnover_rank10(frame)
166:     decay = decay_profile(closes, frame)
167:     max_r, lib_detail = library_correlation(frame)
168: 
169:     passed = abs(ic_mean) >= 0.0070 and abs(icir) >= 0.0840
170:     if verbose:
171:         print(f"=== {label} ===")
172:         print(f"  factor dates: {len(frame)}  assets: {len(frame.columns)}")
173:         print(f"  n_ic_dates: {n_ic}  (dates with >=8 valid)")
174:         print(f"  IC (h={horizon}): {ic_mean:.4f}  ICIR: {icir:.4f}  hit: {hit:.3f}")
175:         print(f"  coverage_asset_days: {cov_asset_days:.3f}  coverage_dates_ge8: {cov_dates_ge8:.3f}")
176:         print(f"  turnover_10d_rank: {to:.3f}")
177:         print(f"  decay_ic_by_horizon: {decay}")
178:         print(f"  max_abs_library_correlation: {max_r:.4f}  detail: {lib_detail}")
179:         print(f"  GATE (absIC>=0.0070 & absICIR>=0.0840): {'PASS' if passed else 'FAIL'}")
180:     return {
181:         "label": label, "ic": ic_mean, "icir": icir, "hit": hit, "n_ic_dates": n_ic,
182:         "coverage_asset_days": cov_asset_days, "coverage_dates_ge8": cov_dates_ge8,
183:         "turnover_10d_rank": to, "decay": decay, "max_abs_library_correlation": max_r,
184:         "passed": passed, "frame": frame, "ic_series": ic,
185:     }
186: 
