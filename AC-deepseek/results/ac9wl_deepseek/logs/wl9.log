fams = {}
fams["dxy_beta_60d"] = build(lambda s, r: beta_to(r, mret["DXY"], 60))
fams["jpy_beta_60d"] = build(lambda s, r: beta_to(r, mret["USDJPY"], 60))
fams["vix_beta_plain_60d"] = build(lambda s, r: beta_to(r, mret["VIX"], 60))
