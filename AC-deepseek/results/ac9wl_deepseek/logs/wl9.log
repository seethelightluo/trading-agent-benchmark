80 def rank_ic(factor_frame, ret_frame, min_valid=8):
81     """Daily cross-sectional Spearman IC between factor values and forward returns."""
82     ics, dates = [], []
83     for t in factor_frame.index:
84         f = factor_frame.loc[t]
85         r = ret_frame.loc[t]
86         pair = pd.concat([f.rename("f"), r.rename("r")], axis=1).dropna()
87         if len(pair) < min_valid:
88             continue
89         ic = pair["f"].rank().corr(pair["r"].rank())
90         if np.isfinite(ic):
91             ics.append(ic)
92             dates.append(t)
93     return pd.Series(ics, index=pd.DatetimeIndex(dates), name="ic")
94 
95 
96 def turnover_rank10(factor_frame):
97     """Mean abs change in cross-sectional rank percentile between 10-trading-day-spaced dates."""
98     dates = factor_frame.index[::10]
99     chg = []
100     for i in range(1, len(dates)):
101         a = factor_frame.loc[dates[i - 1]].rank(pct=True)
102         b = factor_frame.loc[dates[i]].rank(pct=True)
103         pair = pd.concat([a.rename("a"), b.rename("b")], axis=1).dropna()
104         if len(pair) >= 8:
105             chg.append(float((pair["a"] - pair["b"]).abs().mean()))
106     return float(np.mean(chg)) if chg else float("nan")
107 
108 
109 def decay_profile(closes, factor_frame, horizons=(1, 2, 3, 5, 10, 20)):
110     prof = {}
111     for h in horizons:
112         rets = forward_returns(closes, h)
113         ret_frame = pd.DataFrame({a: rets[a].reindex(factor_frame.index) for a in factor_frame.columns})
114         ic = rank_ic(factor_frame, ret_frame)
115         prof[str(h)] = round(float(ic.mean()), 4) if len(ic) else float("nan")
116     return prof
