22:
23:def load_close(symbol, root="../persistent"):
24:    for sub, name in (("stock_data", symbol), ("index_data", symbol)):
25:        p = Path(root) / sub / f"{name}.csv"
26:        if p.exists():
27:            df = pd.read_csv(p, parse_dates=["date"])
28:            df = df[df["date"] <= MAX_DATE].set_index("date")
29:            return df
30:    return None
31:
32:
33:def load_panel(symbols, root="../persistent"):
34:    closes = {}
35:    for s in symbols:
36:        df = load_close(s, root)
37:        if df is not None and "close" in df:
38:            closes[s] = df["close"].astype(float)
39:    panel = pd.DataFrame(closes).dropna(how="all").sort_index()
40:    panel = panel[panel.index >= MIN_DATE]
41:    return panel
42:
43:
44:def factor_ic_report(panel, forward_ret, min_valid=8, horizon=10):
45:    """Daily cross-sectional Spearman IC between factor panel and forward returns."""
46:    dates = panel.index
47:    ics, n_valid, hit = [], [], 0
48:    for t in dates:
49:        f = panel.loc[t]
50:        r = forward_ret.loc[t]
51:        mask = f.notna() & r.notna()
52:        n = int(mask.sum())
53:        if n < min_valid:
54:            continue
55:        ic = f[mask].rank().corr(r[mask].rank())
56:        if not np.isfinite(ic):
57:            continue
58:        ics.append(ic)
59:        n_valid.append(n)
60:    ics = np.array(ics)
61:    if len(ics) == 0:
62:        return None
63:    mean_ic = float(ics.mean())
64:    std_ic = float(ics.std(ddof=1)) if len(ics) > 1 else 0.0
65:    icir = mean_ic / std_ic if std_ic > 0 else 0.0
66:    hit_ratio = float((np.sign(ics) == np.sign(mean_ic)).mean()) if mean_ic != 0 else 0.5
67:    return {
68:        "horizon": horizon,
69:        "ic": mean_ic,
70:        "icir": icir,
71:        "ic_hit_ratio": hit_ratio,
72:        "n_ic_dates": len(ics),
73:        "mean_n_valid": float(np.mean(n_valid)),
74:    }
75:
76:
77:def factor_turnover(panel):
78:    """Average cross-sectional rank change between consecutive dates (0..1 scale)."""
79:    ranks = panel.rank(axis=1)
80:    chg = ranks.diff().abs().mean(axis=1)
81:    return float(chg.mean())
