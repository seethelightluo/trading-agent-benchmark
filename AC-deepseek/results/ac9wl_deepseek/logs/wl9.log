    "drawdown_252": {a: drawdown_252(closes[a], 252) for a in closes},
    "volz_x_skew_20d": {a: volz_x_skew(closes[a], vols[a], 20) if a in vols else pd.Series(np.nan, index=closes[a].index) for a in closes},
