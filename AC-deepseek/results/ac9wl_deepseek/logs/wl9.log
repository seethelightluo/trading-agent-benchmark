19 def kaufman_eff(close, n=60):
20     """Kaufman efficiency ratio: |close - close.shift(n)| / sum(|diff|, n).
21     Path-efficiency of the trend: high = smooth trending, low = choppy."""
22     num = (close - close.shift(n)).abs()
23     den = close.diff().abs().rolling(n).sum()
24     return num / den.replace(0, np.nan)
25 
26 
27 def sharpe_60(close, n=60):
28     """Rolling Sharpe: mean daily return / std daily return (annualization-free)."""
29     r = close.pct_change()
30     sd = r.rolling(n).std(ddof=0).replace(0, np.nan)
31     return r.rolling(n).mean() / sd
32 
33 
34 def max_dd_60(close, n=60):
35     """Trailing max drawdown (negative): close / rolling_max(close, n) - 1."""
36     return close / close.rolling(n).max() - 1.0
37 
38 
39 def rsi_14(close, n=14):
40     """Classic RSI: 100 - 100/(1 + avg_gain/avg_loss)."""
41     r = close.diff()
42     gain = r.where(r > 0, 0.0)
43     loss = (-r).where(r < 0, 0.0)
44     ag = gain.rolling(n, min_periods=max(6, n // 2)).mean()
45     al = loss.rolling(n, min_periods=max(6, n // 2)).mean()
46     rs = ag / al.replace(0, np.nan)
47     return 100.0 - 100.0 / (1.0 + rs)
48 
49 
50 def bb_width_20(close, n=20):
51     """Bollinger bandwidth: 4*std(close,n)/SMA(close,n) — volatility level."""
52     sma = close.rolling(n).mean()
53     sd = close.rolling(n).std(ddof=0)
54     return 4.0 * sd / sma.replace(0, np.nan)
55 
56 
57 def kurt_60(close, n=60):
58     """Excess kurtosis of daily returns."""
59     r = close.pct_change()
60     m = r.rolling(n).mean()
61     sd = r.rolling(n).std(ddof=0).replace(0, np.nan)
62     m4 = ((r - m) ** 4).rolling(n).mean()
63     return m4 / (sd ** 4) - 3.0
64 
65 
66 def hi_lo_range_20(close, high, low, n=20):
67     """(rolling_max(high,n)-rolling_min(low,n))/close — range width normalized."""
68     hi = high.rolling(n).max()
69     lo = low.rolling(n).min()
70     return (hi - lo) / close.replace(0, np.nan)
71 
72 
73 def streak_5(close, n=5):
74     """Consecutive up-day streak: count of last n days with r>0 (run momentum)."""
75     r = (close.diff() > 0).astype(float)
76     out = []
77     streak = 0.0
78     for v in r:
79         if v == 1:
80             streak += 1.0
81         else:
82             streak = 0.0
83         out.append(streak)
84     return pd.Series(out, index=r.index).clip(upper=n)
