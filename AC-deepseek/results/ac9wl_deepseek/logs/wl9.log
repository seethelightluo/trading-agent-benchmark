84:def coverage(panel, n_assets=15):
85:    valid = int(panel.notna().sum().sum())
86:    total = int(panel.shape[0] * n_assets)
87:    dates_ge8 = float((panel.notna().sum(axis=1) >= 8).mean())
88:    return {"coverage_asset_days": valid / total if total else 0.0,
89:            "coverage_dates_ge8": dates_ge8}
