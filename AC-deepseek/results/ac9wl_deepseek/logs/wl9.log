92:def decay_report(factor_panel, ret_panel, horizons=(1, 2, 3, 5, 10, 20)):
93:    out = {}
94:    for h in horizons:
95:        fwd = ret_panel.shift(-h).rolling(h).apply(lambda x: (1 + x).prod() - 1, raw=True)
96:        r = factor_ic_report(factor_panel, fwd, horizon=h)
97:        out[str(h)] = round(r["ic"], 4) if r else None
98:    return out
99:
100:
101:def forward_returns(ret_panel, horizon):
102:    """Cumulative forward return over `horizon` days, aligned at date t."""
103:    fwd = (1 + ret_panel).rolling(horizon).apply(np.prod, raw=True).shift(-horizon) - 1
104:    return fwd
