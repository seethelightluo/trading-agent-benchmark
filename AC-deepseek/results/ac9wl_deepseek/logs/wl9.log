85 def skew_20(close, n=20):
86     r = close.pct_change()
87     m = r.rolling(n).mean()
88     sd = r.rolling(n).std(ddof=0).replace(0, np.nan)
89     return ((r - m) ** 3).rolling(n).mean() / (sd ** 3)
90 
