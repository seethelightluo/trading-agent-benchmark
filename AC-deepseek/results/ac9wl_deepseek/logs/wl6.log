1:"""Shared factor validation utilities for miner_3.
2:
3:Data is truncated at CURRENT_DATE (no future data). Cross-section = 15 tradable
4:assets. ICIR = mean(IC)/std(IC) on daily cross-sectional Spearman rank IC.
5:"""
6:import json
7:import math
8:import numpy as np
9:import pandas as pd
10:
11:CURRENT_DATE = pd.Timestamp("2026-07-30")
12:DATA_DIR = "../persistent/stock_data"
13:INDEX_DIR = "../persistent/index_data"
14:
15:TRADABLES = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX",
16:             "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
17:OBSERVABLES = ["DXY", "USDCNY", "USDJPY", "EURUSD", "VIX"]
