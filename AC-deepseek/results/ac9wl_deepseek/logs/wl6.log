vol_ok = {}
for sym in TRADABLE:
    try:
        df = get_stock_daily_data(symbol=sym, days=4000)
        if df is not None and "volume" in df:
            v = df["volume"].dropna()
            vol_ok[sym] = (len(v) > 100 and float(v.iloc[-50:].mean()) > 0)
        else:
            vol_ok[sym] = False
    except Exception:
        vol_ok[sym] = False
