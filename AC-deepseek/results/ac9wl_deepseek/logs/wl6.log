print("\n=== SUB-PERIOD STABILITY (horizon=10 IC / ICIR) ===")
for n in names:
    row = [n]
    for lo, hi in [("2020-01-01", "2022-12-31"), ("2023-01-01", MAXD), ("2024-01-01", MAXD)]:
