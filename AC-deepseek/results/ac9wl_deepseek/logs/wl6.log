        out[f'{tag}_ic'] = float(sub.mean()) if len(sub) else np.nan
        out[f'{tag}_n'] = int(len(sub))
    if fwd is not None and factor_df is not None:
        dec = {}
        for h in sorted(fwd.keys()):
            ic_h, _ = rank_ic_series(factor_df, fwd[h])
