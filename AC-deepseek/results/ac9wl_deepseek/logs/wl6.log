    """Forward close-to-close returns over `horizon` trading days (asset x date)."""
    fwd = panel.shift(-horizon) / panel - 1.0
    return fwd


def rank_ic_series(factor: pd.DataFrame, fwd: pd.DataFrame) -> pd.Series:
