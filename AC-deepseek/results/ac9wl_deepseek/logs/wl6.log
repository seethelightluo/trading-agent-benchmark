    if len(ic) == 0:
        out.update({'ic': np.nan, 'icir': np.nan, 'hit': np.nan,
                    'n_dates': 0, 'status': 'NO_DATA'})
        return out
    out.update({
        'ic': float(ic.mean()),
        'icir': float(ic.mean() / ic.std(ddof=1)) if ic.std(ddof=1) > 0 else 0.0,
        'hit': float((ic > 0).mean()),
