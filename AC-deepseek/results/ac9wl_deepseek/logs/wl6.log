def fast_ic(f, fr):
    f = f.reindex(fr.index)
    if isinstance(f, pd.Series):
        f = f.to_frame(name='f0')
    ics = []
    for d in fr.index:
        row = pd.concat([f.loc[d].rename('f'), fr.loc[d].rename('r')], axis=1).dropna()
        if len(row) >= 8:
            ic = row['f'].rank().corr(row['r'].rank())
            if np.isfinite(ic):
                ics.append(ic)
    return np.array(ics)

