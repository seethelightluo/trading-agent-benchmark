    turn = fast_turnover(factor)
    decay = {h: (round(float(s.mean()), 4) if s.notna().any() else None)
             for h, s in ic_series.items()}
    sub = {}
    for lo, hi, tag in [('2020-01-01', '2022-12-31', '2020-2022'),
                        ('2023-01-01', '2026-07-29', '2
