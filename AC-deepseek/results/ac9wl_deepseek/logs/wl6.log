  ▶️ write_file({'content': '"""Exploration: screen several candidate factor families on the 15-asset universe.\nData truncated at 2026-07-30. Horizon-10 rank IC preview; deep validation follows\nfor promising ideas (one idea per validation script).\n"""\nimport sys\nsys.path.insert(0, "scripts")\nimport numpy as np\nimport pandas as pd\nfrom factor_utils import (load_close, load_panel, forward_returns,\n                          rank_ic_series, summarize_ic, DATA_DIR, INDEX_DIR)\n\npx, vol = load_panel()\nret = px.pct_change()\nfwd10 = forward_returns(px, 10)\n\n# ---- macro series (observation only) ----\ndxy = load_close("DXY", INDEX_DIR)["close"].astype(float)\nvix = load_close("VIX", INDEX_DIR)["close"].astype(float)\nus10y = px["US10Y"]  # tradable yield series\ncn10y = px["CN10Y"]\nusdjpy = load_close("USDJPY", INDEX_DIR)["close"].astype(float)\n\ndef beta_of(asset_ret, mkt_ret, win):\n    a = asset_ret.rolling(win).cov(mkt_ret)\n    b = mkt_ret.rolling(win).var()\n    return a / b\n\ncandidates = {}\n\n# 1. DXY beta 60d\ncandidates["dxy_beta_60d"] = beta_of(ret, dxy.pct_change(), 60)\n\n# 2. DXY beta 120d\ncandidates["dxy_beta_120d"] = beta_of(ret, dxy.pct_change(), 120)\n\n# 3. USDJPY beta 60d (risk-on currency)\ncandidates["usdjpy_beta_60d"] = beta_of(ret, usdjpy.pct_change(), 60)\n\n# 4. US10Y rate beta 60d (dPct of yield series)\ncandidates["us10y_beta_60d"] = beta_of(ret, us10y.pct_change(), 60)\n\n# 5. CN10Y rate beta 60d\ncandidates["cn10y_beta_60d"] = beta_of(ret, cn10y.pct_change(), 60)\n\n# 6. VIX level percentile (60d)\ncandidates["vix_pctile_60d"] = pd.DataFrame(\n    {a: vix.rolling(60).rank(pct=True) for a in px.columns}, index=px.index)\n\n# 7. Close location value, 20d mean (intraday strength)\nhl = (px.max(axis=0) * 0 + 1)  # placeholder to keep index\nclv = {}\nfor a in px.columns:\n    df = load_close(a)\n    rng = (df["high"] - df["low"]).replace(0, np.nan)\n    clv[a] = ((df["close"] - df["low"]) / rng).rolling(20).mean()\ncandidates["clv_20d"] = pd.DataFrame(clv).reindex(px.index)\n\n# 8. Amihud illiquidity 20d (log mean |ret|/volume)\nami = {}\nfor a in px.columns:\n    v = vol[a]\n    ami[a] = np.log((ret[a].abs() / v.replace(0, np.nan))).rolling(20).mean()\ncandidates["amihud_illiq_20d"] = pd.DataFrame(ami).reindex(px.index)\n\n# 9. Negative skewness 60d\ncandidates["skew_60d"] = ret.rolling(60).skew()\n\n# 10. Serial correlation 5d (autocorr of daily ret)\ncandidates["autocorr_5d"] = ret.rolling(6).apply(lambda x: pd.Series(x).autocorr(1) if len(x) >= 6 else np.nan, raw=False)\n\n# 11. Volume trend: 20d mean volume / 60d mean volume\ncandidates["vol_trend_20x60"] = vol.rolling(20).mean() / vol.rolling(60).mean()\n\n# 12. High-low range momentum: 20d avg range / 60d avg range\nrng_panel = {}\nfor a in px.columns:\n    df = load_close(a)\n    rng_panel[a] = (df["high"] - df["low"])\nrng = pd.DataFrame(rng_panel).reindex(px.index)\ncandidates["range_ratio_20x60"] = rng.rolling(20).mean() / rng.rolling(60).mean()\n\n# 13. Max drawdown 60d (negative)\ncandidates["mdd_60d"] = (1 + ret).cumprod().rolling(60).apply(\n    lambda x: x / np.maximum.accumulate(x) - 1, raw=True).min(axis=0) * -1  # placeholder\n\n# 14. Risk-adjusted momentum: 20d return / 20d vol\ncandidates["risk_adj_mom_20d"] = ret.rolling(20).sum() / ret.rolling(20).std()\n\n# 15. DXY conditional: asset beta to DXY * DXY 20d move\ndxy20 = dxy.pct_change(20)\ncandidates["dxy_cond_60x20"] = -beta_of(ret, dxy.pct_change(), 60) * dxy20\n\nprint(f"{\'factor\':<24}{\'ic\':>8}{\'icir\':>8}{\'hit\':>7}{\'n\':>6}  gate")\nfor name, f in candidates.items():\n    f = f.reindex(px.index)\n    s = rank_ic_series(f, fwd10)\n    res = summarize_ic(s, name, 10)\n    flag = "PASS" if res["pass_gate"] else ""\n    print(f"{name:<24}{res[\'ic\']:>8.4f}{res[\'icir\']:>8.4f}{res[\'ic_hit_ratio\']:>7.3f}{res[\'n_ic_dates\']:>6d}  {flag}")\n', 'file_path': 'scripts/miner_3_20260730_screen_candidates.py'})
