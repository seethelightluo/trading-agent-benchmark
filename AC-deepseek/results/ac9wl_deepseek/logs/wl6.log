def forward_returns(panel, horizons=(1, 2, 3, 5, 10, 20)):
    """Forward close-to-close returns per asset (fractional)."""
    fwd = {}
    for h in horizons:
        fwd[h] = panel.shift(-h) / panel - 1.0
