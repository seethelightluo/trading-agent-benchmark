19:
20:def load_close(symbol, data_dir=DATA_DIR, current_date=CURRENT_DATE):
21:    """Load close series (and OHLCV) for a symbol, truncated at current date."""
22:    df = pd.read_csv(f"{data_dir}/{symbol}.csv", parse_dates=["date"])
23:    df = df[df["date"] <= current_date].reset_index(drop=True)
24:    df = df.set_index("date").sort_index()
25:    return df
26:
27:
28:def load_panel(symbols=None):
29:    """Panel of closes for all tradables, inner-joined on dates."""
30:    if symbols is None:
31:        symbols = TRADABLES
32:    closes = {}
33:    vols = {}
34:    for s in symbols:
35:        df = load_close(s)
36:        closes[s] = df["close"].astype(float)
37:        vols[s] = df["volume"].astype(float) if "volume" in df else pd.Series(np.nan, index=df.index)
38:    px = pd.DataFrame(closes)
39:    vol = pd.DataFrame(vols)
40:    px = px.dropna(how="all")
41:    return px, vol
42:
43:
44:def forward_returns(px, horizon):
45:    """Forward return over horizon trading days (close t -> close t+h)."""
46:    return px.shift(-horizon) / px - 1.0
47:
48:
49:def rank_ic_series(factor_vals, fwd_ret, min_valid=8):
50:    """Daily cross-sectional Spearman rank IC series."""
51:    dates, ics = [], []
52:    idx = factor_vals.index.intersection(fwd_ret.index)
53:    for d in idx:
54:        f = factor_vals.loc[d]
55:        r = fwd_ret.loc[d]
56:        pair = pd.concat([f.rename("f"), r.rename("r")], axis=1).dropna()
57:        if len(pair) >= min_valid:
58:            ic = pair["f"].corr(pair["r"], method="spearman")
59:            if ic is not None and math.isfinite(ic):
60:                dates.append(d)
61:                ics.append(ic)
62:    return pd.Series(ics, index=dates)
63:
64:
65:def summarize_ic(ic_series, factor_name, horizon, n_assets=15):
66:    """Standard IC summary dict consistent with library format."""
67:    ic = float(ic_series.mean())
68:    std = float(ic_series.std())
69:    icir = ic / std if std and math.isfinite(std) and std > 0 else 0.0
70:    hit = float((ic_series > 0).mean())
71:    return {
72:        "factor": factor_name,
73:        "horizon": horizon,
74:        "n_ic_dates": int(len(ic_series)),
75:        "ic": round(ic, 4),
76:        "icir": round(icir, 4),
77:        "ic_hit_ratio": round(hit, 3),
78:        "pass_gate": abs(ic) >= 0.0070 and abs(icir) >= 0.0840,
79:    }
