def fast_ic(f, fr, min_assets=8):
    f = to_panel(f, fr.index)
    ics = []
    for d in fr.index:
        row = pd.concat([f.loc[d].rename('f'), fr.loc[d].rename('r')], axis=1).dropna()
        if len(row) >= min_assets:
            ic = row['f'].rank().corr(row['r'].rank())
            if np.isfinite(ic):
                ics.append(ic)
    return np.array(ics)

