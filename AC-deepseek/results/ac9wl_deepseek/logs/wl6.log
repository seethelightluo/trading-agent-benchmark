def clv_diff(a, b):
    """Change in intraday positioning: CLV(a) - CLV(b)."""
    def f(df):
        rng = (df["high"] - df["low"]).replace(0, np.nan)
        clv = (df["close"] - df["low"]) / rng
        return clv.rolling(a).mean() - clv.rolling(b).mean()
    return per_asset(f)


