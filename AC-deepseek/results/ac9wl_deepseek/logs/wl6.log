, K)\nprint(\'sum weights:\', sum(weights.values()))\nprint(\'min/max weight:\', min(weights.values()), max(weights.values()))\nprint(\'top weights:\', sorted(weights.items(), key=lambda kv: -kv[1])[:8])\nprint(\'zero-weight assets:\', [a for a, x in weights.items() if x <= 1e-12])\n"'})
