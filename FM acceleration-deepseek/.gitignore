# Runtime state and credentials are intentionally local-only.
runtime/.env
runtime/state/*.json
runtime/logs/*.log
runtime/pids/*.pid
runtime/exports/*
!runtime/.env.template
!runtime/state/.gitkeep
!runtime/logs/.gitkeep
!runtime/pids/.gitkeep
!runtime/exports/.gitkeep

# The deployable payload is intentionally generated locally from the verified
# repository revision and is not committed with source code.
bundle/
