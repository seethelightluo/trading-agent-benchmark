            fixed.add(s)
        rem = 1.0 - sum(w[s] for s in fixed)
        free = [s for s in UNIVERSE if s not in fixed]
        if not free:
            break
        base = sum(max(w[s], 1e-12) for s in free)
        for s in free:
            w[s] = rem * w[s] / base
    # Tiny numerical correction keeps the contract exact without violating bounds materially.
