  ▶️ write_file({'content': "import numpy as np, pandas as pd\nfrom alphacrafter.sim.utils import get_stock_daily_data\nA=['000300.SH','SPX','HSI','N225','SX5E','000688.SH','SOX','NDX','XAU','COPPER','WTI','BTC','ETH','US10Y','CN10Y']\nD={}\nfor a in A:\n    try:\n        x=get_stock_daily_data(a,days=2000)\n        if x is not None and len(x): D[a]=x.set_index('date').close.astype(float)\n    except Exception as e: print('ERR',a,e)\np=pd.concat(D,axis=1,sort=True).ffill(); r=p.pct_change(); market=r.mean(axis=1)\n# one interpretable idea: market-relative residual momentum, 20d return minus rolling beta*market return, scaled by idiosyncratic vol\nbeta=r.rolling(60).cov(market)/market.rolling(60).var()\nraw=p.pct_change(20)-beta.mul(market.rolling(20).sum(),axis=0)\nidio=r.sub(beta.mul(market,axis=0)).rolling(60).std()\nf=raw/(idio*np.sqrt(20))\nprint('assets',len(D),'dates',len(p),'factor', 'market_relative_residual_momentum_20d')\nfor h in [1,5,10,20]:\n    ic=[]\n    for i,dt in enumerate(p.index):\n        if i+h>=len(p): continue\n        q=pd.concat([f.loc[dt],(p.iloc[i+h]/p.iloc[i]-1).rename('fwd')],axis=1).dropna()\n        if len(q)>=8:\n            v=q.iloc[:,0].corr(q.fwd)\n            if np.isfinite(v): ic.append(v)\n    s=pd.Series(ic); print('h',h,'n',len(s),'IC',round(s.mean(),5),'ICIR',round(s.mean()/s.std(),5),'hit',round((s>0).mean(),4))\nrank=f.rank(axis=1,pct=True)\nprint('turn',round(rank.diff().abs().mean(axis=1).mean(),5),'coverage',round(f.notna().sum(axis=1).mean()/len(D),5))\n# regime split by sign of prior 60d market return\nreg=market.rolling(60).sum()\nfor label,mask in [('up',reg>0),('down',reg<=0)]:\n ic=[]\n for i,dt in enumerate(p.index[:-1]):\n  if not mask.loc[dt]: continue\n  q=pd.concat([f.loc[dt],r.iloc[i+1].rename('fwd')],axis=1).dropna()\n  if len(q)>=8 and np.isfinite(q.iloc[:,0].corr(q.fwd)): ic.append(q.iloc[:,0].corr(q.fwd))\n s=pd.Series(ic); print('regime',label,'n',len(s),'IC',round(s.mean(),5),'ICIR',round(s.mean()/s.std(),5) if len(s)>1 else None)\n# correlation against existing candidate formulas, contemporaneous pooled factor values\nfor name,z in [('short3',-(p/p.shift(3)-1)),('short5',-(p/p.shift(5)-1)),('ram20',(p/p.shift(20)-1)/(r.rolling(60).std()*np.sqrt(20)))]:\n q=pd.concat([f.stack().rename('f'),z.stack().rename('z')],axis=1).dropna(); print('corr',name,round(q.f.corr(q.z),5), 'n',len(q))\n", 'file_path': 'scripts/miner_2_20260716_residual_momentum.py'})
