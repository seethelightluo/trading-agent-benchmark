  ▶️ write_file({'content': 'from alphacrafter.sim.utils import register_hook, get_account_dict, get_stock_daily_data, add_order\nimport math\n\nUNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]\nDEFENSIVE = {"XAU", "US10Y", "CN10Y"}\n_last_rebalance = None\n\n\ndef _ranks(items):\n    ordered = sorted(items, key=lambda x: x[1], reverse=True)\n    n = max(1, len(ordered) - 1)\n    return {s: 1.0 - i / n for i, (s, _) in enumerate(ordered)}\n\n\n@register_hook\ndef cross_asset_strategy():\n    global _last_rebalance\n    account = get_account_dict()\n    listed = account.get("watch_list") or UNIVERSE\n    watch = [s for s in UNIVERSE if s in listed]\n    if len(watch) != 15:\n        watch = list(UNIVERSE)\n    positions = {p.get("symbol"): p for p in account.get("positions", [])\n                 if float(p.get("quantity", 0) or 0) > 0}\n    # Do not duplicate an outstanding rebalance.\n    if account.get("orders"):\n        return\n\n    data = {}\n    for symbol in watch:\n        df = get_stock_daily_data(symbol=symbol, days=75)\n        if df is None or len(df) < 30:\n            continue\n        df = df.sort_values("date").reset_index(drop=True)\n        close = [float(x) for x in df["close"].tolist() if x is not None and float(x) > 0]\n        if len(close) < 30:\n            continue\n        r5 = close[-1] / close[-6] - 1.0\n        r20 = close[-1] / close[-21] - 1.0\n        daily = [close[i] / close[i-1] - 1.0 for i in range(len(close)-20, len(close))]\n        mean = sum(daily) / len(daily)\n        vol = math.sqrt(sum((x - mean) ** 2 for x in daily) / max(1, len(daily)-1))\n        data[symbol] = {"price": close[-1], "rev": -r5,\n                        "mom": r20 / max(vol, 0.006), "vol": max(vol, 0.006)}\n    if len(data) < 12:\n        return\n\n    today = str(get_stock_daily_data("SPX", 2).sort_values("date").iloc[-1]["date"])\n    if _last_rebalance is not None:\n        dates = [str(x) for x in get_stock_daily_data("SPX", 30).sort_values("date")["date"]]\n        if str(_last_rebalance) in dates and today in dates and dates.index(today) - dates.index(str(_last_rebalance)) < 10:\n            return\n\n    rev = _ranks([(s, x["rev"]) for s, x in data.items()])\n    mom = _ranks([(s, x["mom"]) for s, x in data.items()])\n    spx = get_stock_daily_data("SPX", 70)\n    bearish = False\n    if spx is not None and len(spx) >= 45:\n        c = [float(x) for x in spx.sort_values("date")["close"]]\n        bearish = c[-1] < c[-21] and c[-1] < c[-41]\n\n    raw = {}\n    for s, x in data.items():\n        composite = 0.504 * rev[s] + 0.496 * mom[s]\n        # Broad equal-weight anchor limits rank instability in a 15-name universe.\n        score_weight = 0.60 * max(0.02, composite)\n        invvol = (1.0 / x["vol"])\n        raw[s] = score_weight + 0.40 * invvol / max(1.0, sum(1.0 / y["vol"] for y in data.values()))\n        if bearish and s in DEFENSIVE:\n            raw[s] *= 1.15\n    # Missing observations receive a small defensive/equal allocation; target remains complete.\n    for s in watch:\n        if s not in raw:\n            raw[s] = 1.0 if (bearish and s in DEFENSIVE) else 0.5\n    total = sum(max(0.0, x) for x in raw.values())\n    weights = {s: max(0.0, raw[s]) / total for s in watch}\n    assets = float(account.get("total_assets", 0) or account.get("net_assets", 0))\n    if assets <= 0:\n        return\n\n    # Submit only material migrations; aggregate target still sums to one.\n    for s in watch:\n        price = data.get(s, {}).get("price", 0.0)\n        if price <= 0:\n            continue\n        old = float(positions.get(s, {}).get("quantity", 0) or 0)\n        delta = assets * weights[s] - old * price\n        if abs(delta) < assets * 0.003:\n            continue\n        qty = int(abs(delta) / price)\n        if qty >= 1:\n            add_order(symbol=s, order_type="BUY" if delta > 0 else "SELL",\n                      price=price, quantity=qty)\n    _last_rebalance = today\n', 'file_path': 'strategy.py'})
