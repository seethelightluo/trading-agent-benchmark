lit(x,5)])\n# dispersion regime by cross-sectional rv60\nreg=r.rolling(60).std().mean(axis=1); med=reg.median(); lo=[];hi=[]\nfor i in range(len(p)-1):\n q=pd.concat([f.iloc[i].rename('f'),p.pct_change(1).iloc[i+1].rename('y')],axis=1).replace([np.inf,-np.inf],np.nan).dropna()\n if len(q)>=8 and q.f.nunique()>1 and q.y.nunique()>1:\n  (lo if reg.iloc[i]<=med else hi).append(q.f.corr(q.y))\nprint('regime low/high',round(np.mean(lo),5),len(lo),round(np.mean(hi),5),len(hi))\n", 'file_path': 'scripts/miner_3_20260716_vol_compression.py'})
