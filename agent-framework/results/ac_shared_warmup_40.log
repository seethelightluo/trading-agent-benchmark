ue\n        cur = float((positions.get(s) or {}).get("quantity", 0) or 0)\n        avail = float((positions.get(s) or {}).get("available_quantity", cur) or 0)\n        target = total*weights[s]/prices[s]\n        sell = min(max(cur-target, 0.0), max(avail, 0.0))\n        if sell > 1e-8: add_order(symbol=s, order_type="SELL", price=prices[s], quantity=sell)\n    for s in UNIVERSE:\n        if prices[s] <= 0: continue\n        cur = float((positions.get(s) or {}).get("quantity", 0) or 0)\n        target = total*weights[s]/prices[s]\n        buy = max(target-cur, 0.0)\n        if buy > 1e-8: add_order(symbol=s, order_type="BUY", price=prices[s], quantity=buy)\n', 'file_path': 'strategy.py'})Traceback (most recent call last):
