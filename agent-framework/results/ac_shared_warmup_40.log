 import numpy as np, pandas as pd
from alphacrafter.sim.utils import get_stock_daily_data
A=['000300.SH','SPX','HSI','N225','SX5E','000688.SH','SOX','NDX','XAU','COPPER','WTI','BTC','ETH','US10Y','CN10Y']; D={}
for a in A:
 try:
  x=get_stock_daily_data(a,days=2000)
  if x is not None: D[a]=x.set_index('date').close.astype(float)
 except: pass
p=pd.concat(D,axis=1,sort=True).ffill(); r=p.pct_change(); cs=r.mean(axis=1)
# residual trend: 20d asset return minus contemporaneous cross-asset average return, risk scaled
f=(p.pct_change(20).sub(cs.rolling(20).sum(),axis=0))/(r.sub(cs,axis=0).rolling(60).std()*np.sqrt(20))
print('assets',len(D),'dates',len(p),'avgN',round(f.notna().sum(axis=1).mean(),2))
for h in [1,5,10,20]:
 ic=[]
 for i,dt in enumerate(p.index):
  if i+h>=len(p): continue
  q=pd.concat([f.loc[dt],(p.iloc[i+h]/p.iloc[i]-1).rename('fwd')],axis=1).dropna()
  if len(q)>=8:
   v=q.iloc[:,0].corr(q.fwd)
   if np.isfinite(v): ic.append(v)
 s=pd.Series(ic); print('h',h,'n',len(s),'IC',round(s.mean(),5),'ICIR',round(s.mean()/s.std(),5),'hit',round((s>0).mean(),4))
print('turn',round(f.rank(axis=1,pct=True).diff().abs().mean(axis=1).mean(),5),'coverage',round(f.notna().sum(axis=1).mean()/len(D),5))
# library correlation pooled
for name,z in [('short3',-(p/p.shift(3)-1)),('short5',-(p/p.shift(5)-1)),('ram20',(p/p.shift(20)-1)/(r.rolling(60).std()*np.sqrt(20)))]:
 q=pd.concat([f.stack().rename('f'),z.stack().rename('z')],axis=1).dropna(); print('corr',name,round(q.f.corr(q.z),5),'n',len(q))


