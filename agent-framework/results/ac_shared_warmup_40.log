 import numpy as np,pandas as pd
from alphacrafter.sim.utils import get_stock_daily_data
A=['000300.SH','SPX','HSI','N225','SX5E','000688.SH','SOX','NDX','XAU','COPPER','WTI','BTC','ETH','US10Y','CN10Y']
px={}
for a in A:
 d=get_stock_daily_data(a,days=1800)
 if d is not None and len(d)>100: px[a]=d.set_index('date').close.astype(float)
p=pd.concat(px,axis=1).sort_index().ffill(); r=p.pct_change()
# Volatility compression: recent realized volatility relative to medium baseline;
# low ratio represents compressed risk and tests whether subsequent returns favor compressed assets.
rv10=r.rolling(10).std(); rv60=r.rolling(60).std(); f=-(rv10/rv60) # higher score = greater compression
for h in [1,5,10,20]:
  vals=[]
  for i in range(len(p)-h):
    q=pd.concat([f.iloc[i].rename('f'),p.pct_change(h).iloc[i+h].rename('y')],axis=1).replace([np.inf,-np.inf],np.nan).dropna()
    if len(q)>=8 and q.f.nunique()>1 and q.y.nunique()>1: vals.append(q.f.corr(q.y))
  x=np.array(vals); print('h',h,'dates',len(x),'n',len(px),'IC',round(np.nanmean(x),5),'ICIR',round(np.nanmean(x)/np.nanstd(x,ddof=1),5),'hit',round(np.mean(x>0),5))
# daily stats
vals=[]; turns=[]; cov=[]
for i in range(len(p)-1):
 q=pd.concat([f.iloc[i].rename('f'),p.pct_change(1).iloc[i+1].rename('y')],axis=1).replace([np.inf,-np.inf],np.nan).dropna()
 if len(q)>=8 and q.f.nunique()>1 and q.y.nunique()>1: vals.append(q.f.corr(q.y))
 z=f.iloc[i].dropna(); cov.append(len(z)/15)
 if i:
  a=f.iloc[i-1].rank(); b=f.iloc[i].rank(); turns.append((a!=b).mean())
x=np.array(vals); print('daily dates',len(x),'avg_n',round(np.mean([len(pd.concat([f.iloc[i],p.pct_change(1).iloc[i+1]],axis=1).dropna()) for i in range(len(p)-1)]),2),'IC',round(np.mean(x),5),'ICIR',round(np.mean(x)/np.std(x,ddof=1),5),'hit',round(np.mean(x>0),5),'coverage',round(np.mean(cov),5),'turn',round(np.mean(turns),5))
# five equal chronological blocks
print('blocks', [round(np.mean(z),5) for z in np.array_split(x,5)])
# dispersion regime by cross-sectional rv60
reg=r.rolling(60).std().mean(axis=1); med=reg.median(); lo=[];hi=[]
for i in range(len(p)-1):
 q=pd.concat([f.iloc[i].rename('f'),p.pct_change(1).iloc[i+1].rename('y')],axis=1).replace([np.inf,-np.inf],np.nan).dropna()
 if len(q)>=8 and q.f.nunique()>1 and q.y.nunique()>1:
  (lo if reg.iloc[i]<=med else hi).append(q.f.corr(q.y))
print('regime low/high',round(np.mean(lo),5),len(lo),round(np.mean(hi),5),len(hi))


