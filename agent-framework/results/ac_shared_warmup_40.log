print('daily IC %.6f ICIR %.6f hit %.4f std %.6f'%(np.nanmean(ics),np.nanmean(ics)/(np.nanstd(ics,ddof=1)+1e-12),np.mean(ics>0),np.nanstd(ics,ddof=1)))
