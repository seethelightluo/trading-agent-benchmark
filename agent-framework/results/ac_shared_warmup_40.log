 import json
import math
import numpy as np
from alphacrafter.sim.utils import register_hook, add_order, get_stock_daily_data, get_account_dict

UNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
DEFENSIVE = {"XAU", "US10Y", "CN10Y"}
REBALANCE_DAYS = 10
MIN_WEIGHT, MAX_WEIGHT = 0.015, 0.16
try:
    with open("factors/factor_ensemble.json", "r", encoding="utf-8") as f:
        _ensemble = json.load(f).get("selected_factors", [])[:10]
except Exception:
    _ensemble = []
FACTOR_WEIGHTS = {x.get("factor_id"): float(x.get("weight", 0.0)) * float(x.get("direction", 1)) for x in _ensemble}
if not FACTOR_WEIGHTS:
    FACTOR_WEIGHTS = {"peer_median_leadlag_5d": .2612, "short_term_reversal_5d": .2012,
                      "miner_2_risk_adjusted_momentum_20d": .1981, "miner_3_clv_1d": .3395}
_day = 0

def rank01(vals):
    good = [x for x in vals.values() if np.isfinite(x)]
    return {s: (sum(x <= vals[s] for x in good) / len(good) if good and np.isfinite(vals[s]) else .5) for s in UNIVERSE}

def cap_and_normalize(raw):
    w = {s: max(MIN_WEIGHT, float(raw.get(s, .5))) for s in UNIVERSE}
    for _ in range(30):
        total = sum(w.values())
        w = {s: min(MAX_WEIGHT, x / total) for s, x in w.items()}
        gap = 1.0 - sum(w.values())
        free = [s for s in UNIVERSE if w[s] < MAX_WEIGHT - 1e-10]
        if gap <= 1e-10 or not free: break
        for s in free: w[s] += gap / len(free)
    total = sum(w.values())
    return {s: w[s] / total for s in UNIVERSE}

@register_hook
def cross_asset_allocator():
    global _day
    _day += 1
    if (_day - 1) % REBALANCE_DAYS != 0: return
    account = get_account_dict()
    closes, highs, lows = {}, {}, {}
    for s in UNIVERSE:
        df = get_stock_daily_data(symbol=s, days=110)
        if df is None or len(df) < 45: continue
        df = df.sort_values("date")
        p = np.asarray(df["close"], dtype=float)
        if np.all(np.isfinite(p)) and np.all(p > 0):
            closes[s], highs[s], lows[s] = p, np.asarray(df["high"], dtype=float), np.asarray(df["low"], dtype=float)
    r5, mom, vol, clv = {}, {}, {}, {}
    for s in UNIVERSE:
        p = closes.get(s)
        if p is None or len(p) < 42:
            r5[s] = mom[s] = vol[s] = clv[s] = np.nan; continue
        daily = p[1:] / p[:-1] - 1.0
        r5[s] = p[-1] / p[-6] - 1.0
        mom[s] = .5 * (p[-1] / p[-21] - 1.0) + .5 * (p[-1] / p[-41] - 1.0)
        vol[s] = max(float(np.std(daily[-20:]) * math.sqrt(252)), .05)
        den = np.where(highs[s][-5:] > lows[s][-5:], highs[s][-5:] - lows[s][-5:], np.nan)
        clv[s] = float(np.nanmean((2*p[-5:] - highs[s][-5:] - lows[s][-5:]) / den))
    valid = [x for x in r5.values() if np.isfinite(x)]
    med = float(np.median(valid)) if valid else 0.0
    factors = {"peer_median_leadlag_5d": {s:r5[s]-med for s in UNIVERSE},
               "short_term_reversal_5d": {s:-r5[s] for s in UNIVERSE},
               "miner_2_risk_adjusted_momentum_20d": {s:mom[s]/vol[s] if np.isfinite(vol[s]) else np.nan for s in UNIVERSE},
               "miner_3_clv_1d": clv}
    ranks = {k: rank01(v) for k,v in factors.items()}
    invvol = rank01({s:1/vol[s] if np.isfinite(vol[s]) else np.nan for s in UNIVERSE})
    spx = closes.get("SPX")
    bearish = spx is not None and spx[-1]/spx[-31] < .995
    raw = {}
    for s in UNIVERSE:
        score = .78*sum(FACTOR_WEIGHTS.get(k,0)*ranks[k][s] for k in ranks) + .22*invvol[s]
        if np.isfinite(vol[s]) and vol[s] > .75: score *= .88
        if bearish and s in DEFENSIVE: score += .12
        raw[s] = max(score,0) + MIN_WEIGHT
    weights = cap_and_normalize(raw)
    positions = {p.get("symbol"):p for p in account.get("positions",[])}
    assets = float(account.get("total_assets",0) or 0)
    prices = {s:float((positions.get(s) or {}).get("current_price",0) or (closes.get(s, [0])[-1])) for s in UNIVERSE}
    targets = {s:assets*weights[s]/prices[s] for s in UNIVERSE if prices[s] > 0}
    for s,target in targets.items():
        pos=positions.get(s,{})
        current=float(pos.get("quantity",0) or 0); settled=float(pos.get("available_quantity",current) or 0)
        qty=int(min(max(current-target,0),settled))
        if qty>0: add_order(symbol=s, order_type="SELL", price=prices[s], quantity=qty)
    for s,target in targets.items():
        current=float((positions.get(s) or {}).get("quantity",0) or 0)
        qty=int(max(target-current,0))
        if qty>0: add_order(symbol=s, order_type="BUY", price=prices[s], quantity=qty)


