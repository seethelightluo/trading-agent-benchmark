neg=eq.where(eq<0)
fac=pd.DataFrame(index=p.index,columns=U,dtype=float)
for s in U:
 fac[s]=-r[s].rolling(60,min_periods=30).cov(neg)/neg.rolling(60,min_periods=30).var()
ics=[]; ns=[]; turns=[]; prev=None; dates=[]
