def rank01(values):
    good = [v for v in values.values() if np.isfinite(v)]
    if not good:
        return {s: .5 for s in UNIVERSE}
    return {s: (sum(v <= values[s] for v in good) / len(good) if np.isfinite(values[s]) else .5) for s in UNIVERSE}

def bounded_weights(scores):
    # Projection-like water filling: all names remain invested, with explicit bounds.
    w = {s: MIN_WEIGHT for s in UNIVERSE}
    remaining = 1.0 - sum(w.values())
    positive = {s: max(float(scores.get(s, .5)), 1e-6) for s in UNIVERSE}
    active = set(UNIVERSE)
    while active and remaining > 1e-12:
        z = sum(positive[s] for s in active)
        proposed = {s: remaining * positive[s] / z for s in active}
        capped = [s for s in active if proposed[s] > MAX_WEIGHT - MIN_WEIGHT]
        if not capped:
            for s in active: w[s] += proposed[s]
            break
        for s in capped:
            w[s] = MAX_WEIGHT
            remaining -= MAX_WEIGHT - MIN_WEIGHT
            active.remove(s)
    total = sum(w.values())
    return {s: w[s] / total for s in UNIVERSE}

@register_hook
def cross_asset_allocator():
    global _day
    _day += 1
    if (_day - 1) % REBALANCE_DAYS != 0:
        return
    account = get_account_dict()
    positions = {p.get("symbol"): p for p in account.get("positions", [])}
    closes, highs, lows, vols = {}, {}, {}, {}
    for s in UNIVERSE:
        df = get_stock_daily_data(symbol=s, days=115)
        if df is None or len(df) < 45:
            continue
        df = df.sort_values("date")
        p = np.asarray(df["close"], dtype=float)
        if np.all(np.isfinite(p)) and np.all(p > 0):
            closes[s] = p
            highs[s] = np.asarray(df["high"], dtype=float)
            lows[s] = np.asarray(df["low"], dtype=float)
            vols[s] = max(float(np.std(p[1:] / p[:-1] - 1)[-20:] if False else np.std(p[-21:] / p[-22:-1] - 1) * math.sqrt(252)), .05)
    r5, mom, clv = {}, {}, {}
    for s in UNIVERSE:
        p = closes.get(s)
        if p is None or len(p) < 42:
            r5[s] = mom[s] = clv[s] = np.nan
            continue
        r5[s] = p[-1] / p[-6] - 1
        mom[s] = .5 * (p[-1] / p[-21] - 1) + .5 * (p[-1] / p[-41] - 1)
        den = highs[s][-1] - lows[s][-1]
        clv[s] = (2 * p[-1] - highs[s][-1] - lows[s][-1]) / den if den > 0 else 0.0
    valid = [x for x in r5.values() if np.isfinite(x)]
    median5 = float(np.median(valid)) if valid else 0.0
    factors = {
        "miner_3_clv_1d": clv,
        "peer_median_leadlag_5d": {s: r5[s] - median5 for s in UNIVERSE},
        "short_term_reversal_5d": {s: -r5[s] for s in UNIVERSE},
        "miner_2_risk_adjusted_momentum_20d": {s: mom[s] / vols[s] if np.isfinite(mom[s]) else np.nan for s in UNIVERSE},
    }
    ranks = {k: rank01(v) for k, v in factors.items()}
    invvol = rank01({s: 1 / vols[s] if s in vols else np.nan for s in UNIVERSE})
    spx = closes.get("SPX")
    bearish = spx is not None and len(spx) >= 31 and spx[-1] / spx[-31] < .995
    raw = {}
    for s in UNIVERSE:
        signal = sum(FACTOR_WEIGHTS.get(k, 0.0) * ranks[k][s] for k in factors)
        score = .78 * signal + .22 * invvol[s]
        if s in vols and vols[s] > .75: score *= .88
        if bearish and s in DEFENSIVE: score += .12
        raw[s] = max(score, 1e-6)
    weights = bounded_weights(raw)
    assets = float(account.get("total_assets", 0) or 0)
    prices = {s: float((positions.get(s) or {}).get("current_price", 0) or (closes.get(s, np.array([0]))[-1])) for s in UNIVERSE}
    targets = {s: assets * weights[s] / prices[s] for s in UNIVERSE if prices[s] > 0}
    # Reduce first (T+1-aware), then add to the complete target vector.
    for s, target in targets.items():
        pos = positions.get(s, {})
        current = float(pos.get("quantity", 0) or 0)
        available = float(pos.get("available_quantity", current) or 0)
        qty = min(max(current - target, 0.0), max(available, 0.0))
        qty_i = int(qty)
        if qty_i > 0: add_order(symbol=s, order_type="SELL", price=prices[s], quantity=qty_i)
    for s, target in targets.items():
        current = float((positions.get(s) or {}).get("quantity", 0) or 0)
        qty = max(target - current, 0.0)
        qty_i = int(qty)
        if qty_i > 0: add_order(symbol=s, order_type="BUY", price=prices[s], quantity=qty_i)

