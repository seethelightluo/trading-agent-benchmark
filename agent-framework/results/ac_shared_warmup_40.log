  ▶️ write_file({'content': "import numpy as np,pandas as pd\nfrom alphacrafter.sim.utils import get_stock_daily_data\nA=['000300.SH','SPX','HSI','N225','SX5E','000688.SH','SOX','NDX','XAU','COPPER','WTI','BTC','ETH','US10Y','CN10Y']; px={}\nfor a in A:\n d=get_stock_daily_data(a,days=3000)\n if d is not None and len(d)>120:px[a]=d.set_index('date').close.astype(float)\np=pd.concat(px,axis=1).sort_index().ffill(); r=p.pct_change(); v=r.rolling(20,min_periods=10).std()\n# 3-day reversal, conditioned on each asset's volatility being below cross-sectional median\nraw=-p.pct_change(3); f=raw.where(v.le(v.median(axis=1),axis=0))\nobs=[]; cov=[]; turn=[]; dec=[]\nfor i in range(len(p)-1):\n q=pd.concat([f.iloc[i].rename('f'),r.iloc[i+1].rename('y')],axis=1).dropna()\n if len(q)>=8:\n  obs.append(q.f.corr(q.y));cov.append(len(q)/len(A))\n  if i:\n   z=pd.concat([f.iloc[i],f.iloc[i-1]],axis=1).dropna()\n   if len(z)>=8:turn.append((z.iloc[:,0].rank()!=z.iloc[:,1].rank()).mean())\n  q2=pd.concat([f.iloc[i].rename('f'),p.pct_change(5).iloc[i+5].rename('y')],axis=1).dropna()\n  if len(q2)>=8:dec.append(q2.f.corr(q2.y))\nx=np.asarray(obs);print('dates',len(x),'instruments',len(px),'IC',np.nanmean(x),'std',np.nanstd(x,ddof=1),'ICIR',np.nanmean(x)/np.nanstd(x,ddof=1),'hit',np.mean(x>0),'coverage',np.mean(cov),'turnover',np.mean(turn),'decay5',np.nanmean(dec),'period',p.index.min(),p.index.max())\nfor label,m in [('early',np.arange(len(x))<len(x)//2),('late',np.arange(len(x))>=len(x)//2)]:\n z=x[m];print(label,len(z),np.nanmean(z),np.nanmean(z)/np.nanstd(z,ddof=1),np.mean(z>0))\n", 'file_path': 'scripts/miner_1_20260716_conditional_lowvol_reversal.py'})
