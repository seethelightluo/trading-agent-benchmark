  ▶️ write_file({'content': 'from alphacrafter.sim.utils import register_hook, add_order, get_stock_daily_data, get_account_dict\n\n# Conservative cross-asset, long-only full-investment allocator.\nUNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]\nREBALANCE_EVERY = 10\nMAX_WEIGHT = 0.18\nMIN_WEIGHT = 0.025\n# Hook is called once per trading day; these persist for the simulation process.\n_call_count = 0\n_last_rebalance = None\n\n\ndef _rank(values, reverse=True):\n    ordered = sorted(values, key=lambda x: x[1], reverse=reverse)\n    n = len(ordered)\n    return {s: (n - 1 - i) / max(1, n - 1) for i, (s, _) in enumerate(ordered)}\n\n\n@register_hook\ndef cross_asset_strategy():\n    global _call_count, _last_rebalance\n    _call_count += 1\n    account = get_account_dict() or {}\n    # Use the specified benchmark universe, not observation-only macro series.\n    watch = [s for s in UNIVERSE if s in (account.get("watch_list") or UNIVERSE)]\n    if len(watch) != 15:\n        watch = list(UNIVERSE)\n    if _call_count != 1 and (_call_count - 1) % REBALANCE_EVERY != 0:\n        return\n\n    histories = {}\n    for symbol in watch:\n        df = get_stock_daily_data(symbol=symbol, days=75)\n        if df is None or len(df) < 25:\n            continue\n        df = df.sort_values("date")\n        closes = [float(x) for x in df["close"].tolist() if x == x and x > 0]\n        if len(closes) >= 25:\n            histories[symbol] = closes\n    if len(histories) < 10:\n        return\n\n    # Cross-sectional factor approximations, using only completed observations.\n    r5 = {s: p[-1] / p[-6] - 1.0 for s, p in histories.items() if len(p) >= 6}\n    r20 = {s: p[-1] / p[-21] - 1.0 for s, p in histories.items() if len(p) >= 21}\n    vol = {}\n    for s, p in histories.items():\n        rets = [p[i] / p[i-1] - 1.0 for i in range(max(1, len(p)-20), len(p))]\n        if len(rets) >= 10:\n            mean = sum(rets) / len(rets)\n            vv = sum((x - mean) ** 2 for x in rets) / len(rets)\n            vol[s] = max(vv ** 0.5, 0.005)\n    common = [s for s in watch if s in r5 and s in r20 and s in vol]\n    if len(common) < 10:\n        return\n    peer_median = sorted(r5[s] for s in common)[len(common)//2]\n    # Lead-lag is smoothed toward the peer median; reversal is inverse recent return.\n    lead = {s: 0.5 * r5[s] + 0.5 * peer_median for s in common}\n    reversal = {s: -r5[s] for s in common}\n    momentum = {s: r20[s] / vol[s] for s in common}\n    ranks = [_rank([(s, lead[s]) for s in common]),\n             _rank([(s, reversal[s]) for s in common]),\n             _rank([(s, momentum[s]) for s in common])]\n    signal = {s: 0.395*ranks[0][s] + 0.305*ranks[1][s] + 0.300*ranks[2][s] for s in common}\n    invvol = {s: 1.0 / vol[s] for s in common}\n    ivr = _rank([(s, invvol[s]) for s in common])\n\n    # 60% factor rank / 40% inverse-volatility, with defensive rotation in weak SPX.\n    spx_bear = "SPX" in histories and len(histories["SPX"]) >= 31 and histories["SPX"][-1] < histories["SPX"][-31]\n    raw = {}\n    for s in common:\n        raw[s] = 0.60 * signal[s] + 0.40 * ivr[s] + 0.20\n        if spx_bear and s in ("XAU", "US10Y", "CN10Y"):\n            raw[s] *= 1.15\n    total = sum(raw.values())\n    weights = {s: raw[s] / total for s in common}\n    # Give every benchmark asset a small, positive allocation and cap concentration.\n    for s in watch:\n        weights.setdefault(s, MIN_WEIGHT)\n    z = sum(weights.values())\n    weights = {s: w / z for s, w in weights.items()}\n    for _ in range(5):\n        over = sum(max(0.0, w - MAX_WEIGHT) for w in weights.values())\n        if over <= 1e-10:\n            break\n        under = [s for s, w in weights.items() if w < MAX_WEIGHT - 1e-10]\n        for s in list(weights):\n            if weights[s] > MAX_WEIGHT:\n                weights[s] = MAX_WEIGHT\n        if under:\n            add = over / len(under)\n            for s in under:\n                weights[s] += add\n    weights = {s: max(0.0, w) for s, w in weights.items()}\n    norm = sum(weights.values())\n    weights = {s: w / norm for s, w in weights.items()}\n\n    positions = {p.get("symbol"): p for p in account.get("positions", []) if p.get("quantity", 0) > 0}\n    prices = {s: histories[s][-1] for s in common}\n    assets = float(account.get("total_assets", 0) or 0)\n    if assets <= 0:\n        return\n    # Existing pending orders are left alone; avoid stacking duplicate rebalance orders.\n    if account.get("orders"):\n        return\n    for s, p in positions.items():\n        if s not in weights or s not in prices:\n            continue\n        current = float(p.get("market_value", 0) or 0)\n        target = assets * weights[s]\n        if current > target * 1.001:\n            qty = min(float(p.get("available_quantity", p.get("quantity", 0))), (current-target)/prices[s])\n            if qty > 1e-8:\n                add_order(symbol=s, order_type="SELL", price=prices[s], quantity=qty)\n    for s in common:\n        current = float(positions.get(s, {}).get("market_value", 0) or 0)\n        delta = assets * weights[s] - current\n        if delta > assets * 0.001:\n            add_order(symbol=s, order_type="BUY", price=prices[s], quantity=delta/prices[s])\n    _last_rebalance = _call_count\n', 'file_path': 'strategy.py'})Traceback (most recent call last):
