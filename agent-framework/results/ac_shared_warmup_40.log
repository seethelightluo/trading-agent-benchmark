  ▶️ write_file({'content': 'from alphacrafter.sim.utils import register_hook, get_account_dict, get_stock_daily_data, add_order\nimport math\n\nUNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]\nDEFENSIVE = {"XAU", "US10Y", "CN10Y"}\n_last_rebalance = None\n\n\ndef _rank(values, reverse=True):\n    order = sorted(values, key=lambda x: x[1], reverse=reverse)\n    out = {}\n    n = max(1, len(order) - 1)\n    for i, (s, _) in enumerate(order):\n        out[s] = 1.0 - i / n if reverse else i / n\n    return out\n\n\n@register_hook\ndef cross_asset_strategy():\n    global _last_rebalance\n    account = get_account_dict()\n    watch = [s for s in UNIVERSE if s in (account.get("watch_list") or UNIVERSE)]\n    if len(watch) != 15:\n        watch = list(UNIVERSE)\n    positions = {p.get("symbol"): p for p in account.get("positions", []) if p.get("quantity", 0) > 0}\n    pending = account.get("orders", [])\n    # Do not duplicate the initial allocation while orders are awaiting execution.\n    if not positions and pending:\n        return\n\n    data = {}\n    for symbol in watch:\n        df = get_stock_daily_data(symbol=symbol, days=75)\n        if df is None or len(df) < 30:\n            continue\n        df = df.sort_values("date").reset_index(drop=True)\n        closes = [float(x) for x in df["close"].tolist() if x is not None and float(x) > 0]\n        if len(closes) < 30:\n            continue\n        r5 = closes[-1] / closes[-6] - 1.0\n        r20 = closes[-1] / closes[-21] - 1.0\n        rets = [closes[i] / closes[i-1] - 1.0 for i in range(max(1, len(closes)-20), len(closes))]\n        vol = math.sqrt(sum((r - sum(rets)/len(rets))**2 for r in rets) / max(1, len(rets)-1))\n        data[symbol] = {"price": closes[-1], "rev": -r5, "mom": r20 / max(vol, 0.006), "vol": max(vol, 0.006)}\n    if len(data) < 12:\n        return\n\n    # Rebalance on the first online day and then at a ten-trading-day cadence.\n    current_date = str(get_stock_daily_data(symbol="SPX", days=2).sort_values("date").iloc[-1]["date"])\n    if _last_rebalance is not None:\n        spx = get_stock_daily_data(symbol="SPX", days=30)\n        dates = [str(x) for x in spx.sort_values("date")["date"].tolist()]\n        if current_date in dates and str(_last_rebalance) in dates:\n            if dates.index(current_date) - dates.index(str(_last_rebalance)) < 10:\n                return\n    rev_rank = _rank([(s, v["rev"]) for s, v in data.items()], True)\n    mom_rank = _rank([(s, v["mom"]) for s, v in data.items()], True)\n\n    # Sideways/mildly bearish regime: broad portfolio, with a modest defensive tilt.\n    spx_df = get_stock_daily_data(symbol="SPX", days=70)\n    bearish = False\n    if spx_df is not None and len(spx_df) >= 45:\n        c = [float(x) for x in spx_df.sort_values("date")["close"].tolist()]\n        bearish = c[-1] < c[-21] and c[-1] < c[-41]\n    raw = {}\n    for s, v in data.items():\n        score = 0.504 * rev_rank[s] + 0.496 * mom_rank[s]\n        # inverse volatility limits concentration without discarding the ensemble\n        raw[s] = max(0.02, score + 0.18 / (1.0 + 30.0 * v["vol"]))\n        if bearish and s in DEFENSIVE:\n            raw[s] *= 1.18\n    total = sum(raw.values())\n    weights = {s: raw.get(s, 0.0) / total for s in watch}\n    # Missing data receive a small diversified allocation; renormalize exactly.\n    z = sum(weights.values())\n    weights = {s: weights[s] / z for s in watch}\n\n    assets = float(account.get("total_assets", 0) or account.get("net_assets", 0))\n    if assets <= 0:\n        return\n    for s in watch:\n        if s not in data:\n            continue\n        price = data[s]["price"]\n        old_qty = float(positions.get(s, {}).get("quantity", 0) or 0)\n        old_value = old_qty * price\n        target_value = assets * weights[s]\n        delta = target_value - old_value\n        # Avoid churning immaterial transfers; all submitted quantities are fractional-valid.\n        if abs(delta) < assets * 0.003:\n            continue\n        qty = abs(delta) / price\n        if qty <= 0:\n            continue\n        add_order(symbol=s, order_type="BUY" if delta > 0 else "SELL", price=price, quantity=qty)\n    _last_rebalance = current_date\n', 'file_path': 'strategy.py'})
