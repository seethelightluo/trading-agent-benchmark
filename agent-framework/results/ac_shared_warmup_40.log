import numpy as np
from alphacrafter.sim.utils import register_hook, add_order, get_stock_daily_data, get_account_dict

UNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
DEFENSIVE = {"XAU", "US10Y", "CN10Y"}
REBALANCE_DAYS = 10
MAX_WEIGHT = 0.18
FACTOR_W = {"lead": 0.395, "reversal": 0.305, "momentum": 0.300}
_day = 0


def pct_rank(vals, descending=True):
    good = [x for x in vals.values() if np.isfinite(x)]
    if not good:
        return {s: 0.5 for s in vals}
    out = {}
    for s, x in vals.items():
        r = 0.5 if not np.isfinite(x) else sum(v <= x for v in good) / len(good)
        out[s] = r if descending else 1.0 - r
    return out


@register_hook
def cross_asset_allocator():
    global _day
    _day += 1
    if (_day - 1) % REBALANCE_DAYS:
        return

    account = get_account_dict()
    raw_watch = account.get("watch_list") or UNIVERSE
    supplied = set()
    for item in raw_watch:
        supplied.add(item if isinstance(item, str) else (item.get("symbol") or item.get("code") or item.get("ticker")))
    symbols = [s for s in UNIVERSE if s in supplied] or UNIVERSE

    closes = {}
    for s in symbols:
        df = get_stock_daily_data(symbol=s, days=70)
        if df is not None and len(df) >= 25:
            closes[s] = np.asarray(df.sort_values("date")["close"], dtype=float)
    if len(closes) < 8:
        return

    r5, r20, vol, lead = {}, {}, {}, {}
    peer_returns = []
    for p in closes.values():
        if len(p) >= 6 and p[-6] > 0:
            peer_returns.append(p[-1] / p[-6] - 1.0)
    peer_med = float(np.median(peer_returns)) if peer_returns else np.nan
    for s in symbols:
        p = closes.get(s)
        if p is None or len(p) < 25 or p[-21] <= 0:
            r5[s] = r20[s] = vol[s] = lead[s] = np.nan
            continue
        daily = p[1:] / p[:-1] - 1.0
