  ▶️ write_file({'content': 'import numpy as np\nfrom alphacrafter.sim.utils import register_hook, add_order, get_stock_daily_data, get_account_dict\n\nASSETS = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]\n_calls = 0\n_last_decision = -10\n\n\ndef _series(symbol, days):\n    df = get_stock_daily_data(symbol=symbol, days=days + 8)\n    if df is None or len(df) < days + 1:\n        return None\n    x = np.asarray(df.sort_values("date")["close"], dtype=float)\n    x = x[np.isfinite(x) & (x > 0)]\n    return x if len(x) >= days + 1 else None\n\n\ndef _ret(symbol, days):\n    x = _series(symbol, days)\n    if x is None:\n        return None, None\n    return float(x[-1] / x[-days - 1] - 1.0), float(x[-1])\n\n\n@register_hook\ndef cross_asset_reversal():\n    global _calls, _last_decision\n    _calls += 1\n    account = get_account_dict()\n    # Decisions are made every ten trading days; marks and pending orders continue daily.\n    if _calls - _last_decision < 10:\n        return\n    watch = account.get("watch_list", [])\n    universe = [s for s in ASSETS if s in watch] if watch else ASSETS\n    if len(universe) != 15:\n        universe = ASSETS\n\n    # Do not stack orders while an earlier rebalance is pending.\n    if account.get("orders"):\n        return\n    values, prices, vols = {}, {}, {}\n    for s in universe:\n        r, px = _ret(s, 5)\n        x = _series(s, 20)\n        if r is not None and px is not None and x is not None:\n            values[s] = -r                 # admitted +direction reversal\n            prices[s] = px\n            vols[s] = max(float(np.std(np.diff(np.log(x[-21:]))) * np.sqrt(252)), 0.05)\n    if len(values) < 12:\n        return\n\n    # Rank scores with a mild volatility risk control, retaining reversal as the signal.\n    ordered = sorted(values, key=values.get)\n    rank = {s: i / max(1, len(ordered) - 1) for i, s in enumerate(ordered)}\n    raw = {s: 0.20 + 0.80 * rank.get(s, 0.5) for s in universe}\n    median_vol = float(np.median(list(vols.values())))\n    for s in vols:\n        raw[s] *= min(1.20, max(0.75, median_vol / vols[s]))\n\n    spx30, _ = _ret("SPX", 30)\n    breadth = sum(values.get(s, 0.0) > 0 for s in universe) / float(len(values))\n    defensive = {"XAU", "US10Y", "CN10Y"}\n    risk_assets = {"BTC", "ETH", "SOX", "NDX", "WTI"}\n    if (spx30 is not None and spx30 < -0.015) or breadth < 0.35:\n        for s in universe:\n            if s in defensive:\n                raw[s] *= 1.35\n            elif s in risk_assets:\n                raw[s] *= 0.78\n    elif spx30 is not None and spx30 > 0.04 and breadth > 0.60:\n        for s in universe:\n            if s in defensive:\n                raw[s] *= 0.88\n\n    total = sum(raw.values())\n    weights = {s: raw[s] / total for s in universe}\n    assets = float(account.get("total_assets", 0.0) or 0.0)\n    positions = {p.get("symbol"): p for p in account.get("positions", [])}\n\n    # Reduce overweight positions first. Integer quantities are required by the order API.\n    for s in universe:\n        p = positions.get(s, {})\n        qty = max(0, int(float(p.get("quantity", 0) or 0)))\n        px = float(p.get("current_price", prices.get(s, 0)) or 0)\n        current = float(p.get("market_value", 0) or 0)\n        target = assets * weights[s]\n        if qty > 0 and px > 0 and current > target * 1.003:\n            q = min(qty, int((current - target) / px))\n            if q > 0:\n                add_order(symbol=s, order_type="SELL", price=px, quantity=q)\n\n    # Initial allocation is fully invested in the complete 15-asset tradable universe.\n    # Subsequent buys use current marked value; proceeds from reductions become available next decision.\n    for s in universe:\n        px = float(prices.get(s, 0) or 0)\n        if px <= 0:\n            continue\n        current = float(positions.get(s, {}).get("market_value", 0) or 0)\n        gap = assets * weights[s] - current\n        q = int(max(0.0, gap) / px)\n        if q > 0:\n            add_order(symbol=s, order_type="BUY", price=px, quantity=q)\n    _last_decision = _calls\n', 'file_path': 'strategy.py'})
