import math

UNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
DEFENSIVE = {"XAU", "US10Y", "CN10Y"}
FACTOR_WEIGHTS = {"lead": 0.395, "reversal": 0.305, "momentum": 0.300}
REBALANCE_DAYS = 10
MIGRATION_THRESHOLD = 0.001
_last_rebalance_date = None


def _prices(df):
    df = df.sort_values("date").reset_index(drop=True)
    return [float(v) for v in df["close"] if v is not None and float(v) > 0]


def _rank(values):
    ordered = sorted(values.items(), key=lambda item: item[1], reverse=True)
    denom = max(1, len(ordered) - 1)
    return {symbol: 1.0 - i / denom for i, (symbol, _) in enumerate(ordered)}


def _date(value):
    return str(value)[:10]


@register_hook
def cross_asset_strategy():
    global _last_rebalance_date
    account = get_account_dict()
    listed = set(account.get("watch_list") or [])
    if listed and listed != set(UNIVERSE):
        return
    if account.get("orders"):
        return

    data = {}
    for symbol in UNIVERSE:
        df = get_stock_daily_data(symbol=symbol, days=80)
        if df is None or len(df) < 45:
            return
        close = _prices(df)
        if len(close) < 45:
            return
        r5 = close[-1] / close[-6] - 1.0
        daily = [close[i] / close[i - 1] - 1.0 for i in range(len(close) - 20, len(close))]
        mean = sum(daily) / len(daily)
        vol = max(math.sqrt(sum((r - mean) ** 2 for r in daily) / max(1, len(daily) - 1)), 0.006)
        data[symbol] = {"price": close[-1], "r5": r5,
                        "momentum": (close[-1] / close[-21] - 1.0) / vol, "vol": vol}

    for symbol in UNIVERSE:
        peers = sorted(data[x]["r5"] for x in UNIVERSE if x != symbol)
        data[symbol]["lead"] = peers[len(peers) // 2]
    lead = _rank({s: data[s]["lead"] for s in UNIVERSE})
    reversal = _rank({s: -data[s]["r5"] for s in UNIVERSE})
    momentum = _rank({s: data[s]["momentum"] for s in UNIVERSE})

    spx_df = get_stock_daily_data(symbol="SPX", days=70)
    if spx_df is None or len(spx_df) < 45:
        return
    spx_df = spx_df.sort_values("date").reset_index(drop=True)
    spx = _prices(spx_df)
    if len(spx) < 45:
        return
    decision_date = _date(spx_df.iloc[-1]["date"])
    if _last_rebalance_date is not None:
        dates = [_date(v) for v in spx_df["date"]]
        if _last_rebalance_date in dates and dates.index(decision_date) - dates.index(_last_rebalance_date) < REBALANCE_DAYS:
            return

    bearish = spx[-1] < spx[-21] and spx[-1] < spx[-41]
    inv_vol = {s: 1.0 / data[s]["vol"] for s in UNIVERSE}
    inv_total = sum(inv_vol.values())
    raw = {}
    for s in UNIVERSE:
        signal = FACTOR_WEIGHTS["lead"] * lead[s] + FACTOR_WEIGHTS["reversal"] * reversal[s] + FACTOR_WEIGHTS["momentum"] * momentum[s]
        raw[s] = 0.60 * signal + 0.40 * inv_vol[s] / inv_total
        if bearish and s in DEFENSIVE:
            raw[s] *= 1.15
    total = sum(raw.values())
    weights = {s: raw[s] / total for s in UNIVERSE}

    assets = float(account.get("total_assets", 0) or account.get("net_assets", 0))
    if assets <= 0 or not all(math.isfinite(w) and w >= 0 for w in weights.values()):
        return
    positions = {p.get("symbol"): p for p in account.get("positions", []) if float(p.get("quantity", 0) or 0) > 0}
    initial = not positions
    for symbol in UNIVERSE:
        price = data[symbol]["price"]
        held = float(positions.get(symbol, {}).get("quantity", 0) or 0) * price
        delta = assets * weights[symbol] - held
        if not initial and abs(delta) < assets * MIGRATION_THRESHOLD:
            continue
        quantity = int(abs(delta) / price)
        if quantity > 0:
            add_order(symbol=symbol, order_type="BUY" if delta > 0 else "SELL", price=price, quantity=quantity)
    _last_rebalance_date = decision_date


