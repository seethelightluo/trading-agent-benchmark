        FACTOR_WEIGHTS = {r["factor_id"]: float(r.get("weight", 0)) * float(r.get("direction", 1)) for r in rows}
except Exception:
    pass
_day = 0

def ranks(x):
    good = [v for v in x.values() if np.isfinite(v)]
    if not good:
        return {s: 0.5 for s in UNIVERSE}
    return {s: (sum(v <= x[s] for v in good) / len(good) if np.isfinite(x[s]) else 0.5) for s in UNIVERSE}

def project(raw):
    # Simple bounded water-filling, retaining every tradable asset in the target.
    w = {s: MIN_WEIGHT for s in UNIVERSE}
    rem, active = 1 - len(UNIVERSE) * MIN_WEIGHT, set(UNIVERSE)
    while active and rem > 1e-10:
        z = sum(max(float(raw[s]), 1e-8) for s in active)
        excess = [s for s in active if rem * max(float(raw[s]), 1e-8) / z > MAX_WEIGHT - MIN_WEIGHT]
        if not excess:
            for s in active:
                w[s] += rem * max(float(raw[s]), 1e-8) / z
            break
        for s in excess:
            w[s] = MAX_WEIGHT
            rem -= MAX_WEIGHT - MIN_WEIGHT
            active.remove(s)
    z = sum(w.values())
    return {s: w[s] / z for s in UNIVERSE}

@register_hook
def cross_asset_allocator():
    global _day
    _day += 1
    if (_day - 1) % REBALANCE_DAYS:
        return
    account = get_account_dict()
    positions = {p.get("symbol"): p for p in account.get("positions", [])}
    close, high, low, vol = {}, {}, {}, {}
    for s in UNIVERSE:
        df = get_stock_daily_data(symbol=s, days=120)
        if df is None or len(df) < 45:
            continue
        df = df.sort_values("date")
        p = np.asarray(df["close"], dtype=float)
        if len(p) >= 42 and np.all(np.isfinite(p)) and np.all(p > 0):
            close[s] = p
            high[s] = np.asarray(df["high"], dtype=float)
            low[s] = np.asarray(df["low"], dtype=float)
            rr = p[1:] / p[:-1] - 1
            vol[s] = max(float(np.std(rr[-20:]) * math.sqrt(252)), 0.05)
    # Price fallbacks ensure the online vector always covers all 15 instruments.
    prices = {s: float((positions.get(s) or {}).get("current_price", 0) or (close[s][-1] if s in close else 0)) for s in UNIVERSE}
    r5, reversal, momentum, clv = {}, {}, {}, {}
    median_input = []
    for s in UNIVERSE:
        p = close.get(s)
        if p is None:
            r5[s] = reversal[s] = momentum[s] = clv[s] = np.nan
            continue
        r5[s] = p[-1] / p[-6] - 1
        reversal[s] = -r5[s]
        momentum[s] = 0.5 * (p[-1] / p[-21] - 1) + 0.5 * (p[-1] / p[-41] - 1)
        den = high[s][-1] - low[s][-1]
        clv[s] = (2 * p[-1] - high[s][-1] - low[s][-1]) / den if den > 0 else 0
        median_input.append(r5[s])
    med = float(np.median(median_input)) if median_input else 0
    factors = {
        "miner_3_clv_1d": clv,
        "peer_median_leadlag_5d": {s: r5[s] - med for s in UNIVERSE},
        "short_term_reversal_5d": reversal,
        "miner_2_risk_adjusted_momentum_20d": {s: momentum[s] / vol.get(s, 0.5) if np.isfinite(momentum[s]) else np.nan for s in UNIVERSE},
    }
    rranks = {k: ranks(v) for k, v in factors.items()}
    iranks = ranks({s: 1 / vol.get(s, 0.5) for s in UNIVERSE})
    spx = close.get("SPX")
    bearish = spx is not None and spx[-1] / spx[-31] < 0.995
    raw = {}
    for s in UNIVERSE:
        signal = sum(FACTOR_WEIGHTS.get(k, 0) * rranks[k][s] for k in factors)
        score = 0.78 * signal + 0.22 * iranks[s]
        if vol.get(s, 0) > 0.75:
            score *= 0.88
        if bearish and s in DEFENSIVE:
            score += 0.12
        raw[s] = max(score, 1e-8)
    weights = project(raw)
    assets = float(account.get("total_assets", 0) or 0)
    targets = {s: assets * weights[s] / prices[s] for s in UNIVERSE if prices[s] > 0}
    # Reduce only settled shares first (T+1); then invest proceeds into the new vector.
    for s, target in targets.items():
        p = positions.get(s, {})
        current = float(p.get("quantity", 0) or 0)
        available = float(p.get("available_quantity", current) or 0)
        sell = min(max(current - target, 0), max(available, 0))
        if int(sell) > 0:
            add_order(symbol=s, order_type="SELL", price=prices[s], quantity=int(sell))
    for s, target in targets.items():
        current = float((positions.get(s) or {}).get("quantity", 0) or 0)
        buy = max(target - current, 0)
        if int(buy) > 0:
            add_order(symbol=s, order_type="BUY", price=prices[s], quantity=int(buy))


