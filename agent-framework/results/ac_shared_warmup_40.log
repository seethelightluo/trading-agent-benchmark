  ▶️ write_file({'content': "import numpy as np, pandas as pd\nfrom alphacrafter.sim.utils import get_index_daily_data\nU=['000300.SH','SPX','HSI','N225','SX5E','000688.SH','SOX','NDX','XAU','COPPER','WTI','BTC','ETH','US10Y','CN10Y']\nframes=[]\nfor s in U:\n    d=get_index_daily_data(s, days=3000)\n    if d is None or len(d)<100: continue\n    d=d.copy(); d['date']=pd.to_datetime(d['date']); d=d.set_index('date')\n    # normalized close position and signed candle pressure, smoothed 5d\n    rng=(d.high-d.low).replace(0,np.nan)\n    clv=((d.close-d.low)/rng-0.5)*2\n    candle=(d.close-d.open)/rng\n    # idea: persistent buying/selling pressure reversal, with range normalization\n    f=(0.6*clv+0.4*candle).rolling(5,min_periods=5).mean()\n    # negative pressure score: oversold / selling pressure should rebound\n    frames.append(pd.DataFrame({'date':d.index,'symbol':s,'f':-f.values,'ret':d.close.pct_change().shift(-1).values}))\nx=pd.concat(frames,ignore_index=True).dropna()\nrows=[]\nfor dt,g in x.groupby('date'):\n    if len(g)>=8 and g.f.nunique()>1 and g.ret.nunique()>1:\n        rows.append((dt,g.f.corr(g.ret,method='spearman'),len(g)))\nr=pd.DataFrame(rows,columns=['date','ic','n']).set_index('date')\nprint('dates',len(r),'meanN',r.n.mean(),'coverage',len(x)/sum(len(pd.to_datetime(get_index_daily_data(s,days=3000))) for s in U if get_index_daily_data(s,days=3000) is not None))\nprint('meanIC %.6f std %.6f ICIR %.6f hit %.4f'%(r.ic.mean(),r.ic.std(ddof=1),r.ic.mean()/r.ic.std(ddof=1),(r.ic>0).mean()))\nfor h in [1,5,10]:\n    # recompute forward multi-day return aligned and same factor\n    allr=[]\n    for s in U:\n      d=get_index_daily_data(s,days=3000)\n      if d is None: continue\n      d=d.copy(); d.date=pd.to_datetime(d.date); d=d.set_index('date'); rng=(d.high-d.low).replace(0,np.nan)\n      f=-(0.6*((d.close-d.low)/rng-0.5)*2+0.4*(d.close-d.open)/rng).rolling(5,min_periods=5).mean()\n      rr=d.close.pct_change(h).shift(-h)\n      allr.append(pd.DataFrame({'date':d.index,'f':f,'ret':rr,'symbol':s}))\n    z=pd.concat(allr).dropna(); q=[]\n    for dt,g in z.groupby('date'):\n      if len(g)>=8 and g.f.nunique()>1: q.append(g.f.corr(g.ret,method='spearman'))\n    q=pd.Series(q).dropna(); print('h',h,'n',len(q),'IC %.6f ICIR %.6f'%(q.mean(),q.mean()/q.std(ddof=1)))\n# rough turnover rank signal\nwide=x.pivot_table(index='date',columns='symbol',values='f'); ranks=wide.rank(pct=True,axis=1); turn=(ranks-ranks.shift()).abs().mean(axis=1).dropna()\nprint('turnover',turn.mean())\n", 'file_path': 'scripts/miner_2_20260716_range_pressure_reversal.py'})
