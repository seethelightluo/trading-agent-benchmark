  ▶️ write_file({'content': 'from alphacrafter.sim.utils import register_hook, get_account_dict, get_stock_daily_data, add_order\nimport math\n\nUNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]\nDEFENSIVE = {"XAU", "US10Y", "CN10Y"}\n# Screener ensemble: lead-lag, short reversal, risk-adjusted momentum.\nFACTOR_WEIGHTS = {"lead": 0.395, "rev": 0.305, "mom": 0.300}\nREBALANCE_DAYS = 10\nMIGRATION_THRESHOLD = 0.001\n_last_rebalance_date = None\n\n\ndef _rank(items):\n    ordered = sorted(items, key=lambda x: x[1], reverse=True)\n    n = max(1, len(ordered) - 1)\n    return {s: 1.0 - i / n for i, (_, s) in enumerate([(v, k) for k, v in ordered])}\n\n\ndef _date(x):\n    return str(x)[:10]\n\n\n@register_hook\ndef cross_asset_strategy():\n    global _last_rebalance_date\n    account = get_account_dict()\n    listed = set(account.get("watch_list") or [])\n    watch = [s for s in UNIVERSE if s in listed] if listed else UNIVERSE\n    if set(watch) != set(UNIVERSE):\n        return\n    # Avoid overlapping orders; they are settled/processed by the simulator.\n    if account.get("orders"):\n        return\n\n    data = {}\n    for s in watch:\n        df = get_stock_daily_data(symbol=s, days=80)\n        if df is None or len(df) < 45:\n            return\n        df = df.sort_values("date").reset_index(drop=True)\n        close = [float(x) for x in df["close"] if x is not None and float(x) > 0]\n        if len(close) < 45:\n            return\n        r20 = [close[i] / close[i-1] - 1.0 for i in range(len(close)-20, len(close))]\n        avg = sum(r20) / len(r20)\n        vol = max(math.sqrt(sum((r-avg) ** 2 for r in r20) / 19), 0.006)\n        data[s] = {"price": close[-1], "r5": close[-1] / close[-6] - 1.0,\n                   "mom": (close[-1] / close[-21] - 1.0) / vol,\n                   "vol": vol, "ret5": close[-1] / close[-6] - 1.0}\n\n    # Leave-one-out peer median lead-lag: today\'s asset return versus peer median.\n    for s in watch:\n        peers = sorted(data[x]["ret5"] for x in watch if x != s)\n        mid = peers[len(peers)//2]\n        data[s]["lead"] = mid\n\n    def ranks(key):\n        ordered = sorted(((s, data[s][key]) for s in watch), key=lambda z: z[1], reverse=True)\n        n = max(1, len(ordered)-1)\n        return {s: 1.0 - i/n for i, (s, _) in enumerate(ordered)}\n    # Reversal is intentionally positive on negative recent returns.\n    lead_rank, rev_rank, mom_rank = ranks("lead"), ranks("r5"), ranks("mom")\n    # Correct reversal direction without changing the ensemble\'s explicit + direction.\n    rev_rank = ranks("r5")\n    rev_rank = {s: 1.0 - v for s, v in rev_rank.items()}\n    spx = get_stock_daily_data(symbol="SPX", days=70)\n    if spx is None or len(spx) < 45:\n        return\n    spx = spx.sort_values("date").reset_index(drop=True)\n    sp = [float(x) for x in spx["close"] if x is not None and float(x) > 0]\n    if len(sp) < 45:\n        return\n    bearish = sp[-1] < sp[-21] and sp[-1] < sp[-41]\n    decision = _date(spx.iloc[-1]["date"])\n    if _last_rebalance_date is not None:\n        dates = [_date(x) for x in spx["date"]]\n        if _last_rebalance_date in dates and dates.index(decision)-dates.index(_last_rebalance_date) < REBALANCE_DAYS:\n            return\n\n    inv = {s: 1.0/data[s]["vol"] for s in watch}\n    inv_total = sum(inv.values())\n    raw = {}\n    for s in watch:\n        score = (FACTOR_WEIGHTS["lead"]*lead_rank[s] +\n                 FACTOR_WEIGHTS["rev"]*rev_rank[s] +\n                 FACTOR_WEIGHTS["mom"]*mom_rank[s])\n        # 60% signal, 40% risk-balanced allocation; defensive tilt in bearish regime.\n        raw[s] = 0.60*score + 0.40*inv[s]/inv_total\n        if bearish and s in DEFENSIVE:\n            raw[s] *= 1.15\n    total = sum(raw.values())\n    weights = {s: raw[s]/total for s in watch}\n\n    assets = float(account.get("total_assets", 0) or account.get("net_assets", 0))\n    if assets <= 0:\n        return\n    positions = {p.get("symbol"): p for p in account.get("positions", [])\n                 if float(p.get("quantity", 0) or 0) > 0}\n    initial = not positions\n    for s in watch:\n        px = data[s]["price"]\n        held = float(positions.get(s, {}).get("quantity", 0) or 0)\n        delta = assets*weights[s] - held*px\n        if not initial and abs(delta) < assets*MIGRATION_THRESHOLD:\n            continue\n        qty = abs(delta) / px\n        if qty > 1e-9:\n            add_order(symbol=s, order_type="BUY" if delta > 0 else "SELL", price=px, quantity=qty)\n    _last_rebalance_date = decision\n', 'file_path': 'strategy.py'})
