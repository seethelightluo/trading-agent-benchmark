alues("date")["close"].tolist() if float(x) > 0]\n        weak = len(c) >= 21 and (c[-1] / c[-21] < 1.01 or c[-1] < sum(c[-20:]) / 20)\n    except Exception:\n        pass\n    if weak:\n        for s in score:\n            if s in DEFENSIVE: score[s] += .10\n            elif s in RISKY: score[s] -= .05\n    raw = {s: max(.02, (.55 + score[s]) * (.65 + .35 * iv[s])) for s, *_ in rows}\n    for s in UNIVERSE:\n        raw.setdefault(s, .02)\n    z = sum(raw.values())\n    target = {s: raw[s] / z for s in UNIVERSE}\n    assets = float(account.get("total_assets", account.get("net_assets", 0)) or 0)\n    if assets <= 0:\n        return\n    prices = {s: p for s, _, _, _, p in rows}\n    # Sell reductions first; fractional quantities are explicitly permitted.\n    for s in UNIVERSE:\n        p = positions.get(s, {})\n        qty = float(p.get("quantity", 0) or 0)\n        px = float(p.get("current_price", 0) or prices.get(s, 0))\n        if px <= 0: continue\n        desired = assets * target[s] / px\n        if qty - desired > 1e-8:\n            avail = float(p.get("available_quantity", qty) or 0)\n            q = min(qty - desired, avail)\n            if q > 1e-8: add_order(symbol=s, order_type="SELL", price=px, quantity=q)\n    for s in UNIVERSE:\n        p = positions.get(s, {})\n        qty = float(p.get("quantity", 0) or 0)\n        px = float(p.get("current_price", 0) or prices.get(s, 0))\n        if px <= 0: continue\n        q = assets * target[s] / px - qty\n        if q > 1e-8: add_order(symbol=s, order_type="BUY", price=px, quantity=q)\n', 'file_path': 'strategy.py'})Traceback (most recent call last):
