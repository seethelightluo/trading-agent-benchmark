  ▶️ write_file({'content': 'import math\nimport json\nfrom alphacrafter.sim.utils import register_hook, get_stock_daily_data, get_account_dict, add_order\n\nUNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]\nREBALANCE_DAYS = 10\n_last_decision = None\n\ntry:\n    with open("factors/factor_ensemble.json", "r", encoding="utf-8") as f:\n        ENSEMBLE = json.load(f).get("selected_factors", [])[:10]\nexcept Exception:\n    ENSEMBLE = []\n\n\ndef _rank(values, reverse=False):\n    keys = sorted(values, key=values.get, reverse=reverse)\n    n = max(1, len(keys) - 1)\n    return {s: i / n for i, s in enumerate(keys)}\n\n\ndef _data(symbol, days=80):\n    try:\n        return get_stock_daily_data(symbol=symbol, days=days)\n    except Exception:\n        return None\n\n\ndef _weights(series):\n    # Cross-sectional rank composite, then blend with a stable inverse-volatility overlay.\n    symbols = list(series)\n    ranks = {}\n    for fid in [x.get("factor_id") for x in ENSEMBLE]:\n        vals = {s: series[s][fid] for s in symbols if fid in series[s] and math.isfinite(series[s][fid])}\n        if not vals:\n            continue\n        rr = _rank(vals)\n        for s, v in rr.items():\n            ranks.setdefault(s, 0.5)\n            wt = next(x.get("weight", 0) for x in ENSEMBLE if x.get("factor_id") == fid)\n            ranks[s] += wt * v\n    # The defensive sleeve is a tradable tilt, not cash, in weak broad-market trend.\n    spx = series.get("SPX", {})\n    weak = spx.get("spx20", 0.0) < 0 and spx.get("spx60", 0.0) < 0\n    if weak:\n        for s in symbols:\n            if s in ("XAU", "US10Y", "CN10Y"):\n                ranks[s] = ranks.get(s, 0.5) + 0.10\n            if s in ("BTC", "ETH", "WTI"):\n                ranks[s] = ranks.get(s, 0.5) - 0.05\n    # Convert ranks to positive scores and combine with inverse volatility.\n    raw = {s: max(0.05, 0.35 + ranks.get(s, 0.5)) for s in symbols}\n    inv = {s: 1.0 / max(0.08, series[s].get("vol20", 0.25)) for s in symbols}\n    sm_inv = sum(inv.values()) or 1.0\n    sm_raw = sum(raw.values()) or 1.0\n    out = {s: 0.78 * raw[s] / sm_raw + 0.22 * inv[s] / sm_inv for s in symbols}\n    # Keep concentration sensible for a 15-asset cross-section and re-normalize.\n    out = {s: min(0.16, max(0.015, v)) for s, v in out.items()}\n    total = sum(out.values()) or 1.0\n    return {s: v / total for s, v in out.items()}\n\n\n@register_hook\ndef cross_asset_factor_strategy():\n    global _last_decision\n    account = get_account_dict() or {}\n    watch = [s for s in account.get("watch_list", []) if s in UNIVERSE]\n    if len(watch) < 15:\n        watch = list(UNIVERSE)\n    frames = {s: _data(s, 90) for s in watch}\n    dates = []\n    for df in frames.values():\n        if df is not None and len(df) > 0:\n            dates.append(str(df.iloc[-1]["date"]))\n    decision_date = max(dates) if dates else None\n    if decision_date is None or decision_date == _last_decision:\n        return\n    # Count market dates locally so the cadence survives hook calls on every day.\n    if not hasattr(cross_asset_factor_strategy, "seen"):\n        cross_asset_factor_strategy.seen = []\n    if decision_date not in cross_asset_factor_strategy.seen:\n        cross_asset_factor_strategy.seen.append(decision_date)\n    if len(cross_asset_factor_strategy.seen) > 1 and (len(cross_asset_factor_strategy.seen) - 1) % REBALANCE_DAYS != 0:\n        return\n    _last_decision = decision_date\n    ret5 = {}\n    for s, df in frames.items():\n        if df is None or len(df) < 65:\n            continue\n        close = [float(x) for x in df["close"].tolist() if x is not None and float(x) > 0]\n        if len(close) < 65:\n            continue\n        rets = [(close[i] / close[i-1] - 1.0) for i in range(1, len(close))]\n        r5 = close[-1] / close[-6] - 1.0\n        r20 = close[-1] / close[-21] - 1.0\n        r60 = close[-1] / close[-61] - 1.0\n        v20 = math.sqrt(sum(x*x for x in rets[-20:]) / 20.0) * math.sqrt(252)\n        row = {"miner_3_clv_1d": 0.5}\n        try:\n            hi, lo, cl = float(df.iloc[-1]["high"]), float(df.iloc[-1]["low"]), close[-1]\n            row["miner_3_clv_1d"] = (cl - lo) / max(1e-9, hi - lo)\n        except Exception:\n            pass\n        row["short_term_reversal_5d"] = -r5\n        row["miner_2_risk_adjusted_momentum_20d"] = r20 / max(0.08 / math.sqrt(252), v20)\n        row["ret5"] = r5\n        row["vol20"] = v20\n        row["spx20"] = r20 if s == "SPX" else 0.0\n        row["spx60"] = r60 if s == "SPX" else 0.0\n        ret5[s] = r5\n        frames[s] = row\n    if len(frames) < 15:\n        return\n    median5 = sorted(ret5.values())[len(ret5)//2]\n    for s in frames:\n        if isinstance(frames[s], dict):\n            frames[s]["peer_median_leadlag_5d"] = ret5.get(s, median5) - median5\n    # Fill any missing factor values neutrally and use broad SPX regime values.\n    spx20 = frames.get("SPX", {}).get("spx20", 0.0)\n    spx60 = frames.get("SPX", {}).get("spx60", 0.0)\n    for s in frames:\n        frames[s]["spx20"], frames[s]["spx60"] = spx20, spx60\n    target = _weights(frames)\n    positions = {p.get("symbol"): p for p in account.get("positions", [])}\n    total = float(account.get("total_assets", 0) or account.get("net_assets", 0) or 0)\n    for s in UNIVERSE:\n        pos = positions.get(s, {})\n        qty = float(pos.get("quantity", 0) or 0)\n        px = float(pos.get("current_price", 0) or 0)\n        if qty > 0 and px > 0:\n            delta_value = target.get(s, 0.0) * total - qty * px\n            if delta_value < -1.0:\n                add_order(symbol=s, order_type="SELL", price=px, quantity=min(qty, abs(delta_value) / px))\n    for s in UNIVERSE:\n        pos = positions.get(s, {})\n        qty = float(pos.get("quantity", 0) or 0)\n        px = float(pos.get("current_price", 0) or 0)\n        if px <= 0:\n            px = float(frames[s].get("close", 0) if isinstance(frames[s], dict) else 0)\n        if px <= 0:\n            continue\n        delta_value = target.get(s, 0.0) * total - qty * px\n        if delta_value > 1.0:\n            add_order(symbol=s, order_type="BUY", price=px, quantity=delta_value / px)\n', 'file_path': 'strategy.py'})
