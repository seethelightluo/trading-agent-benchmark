 import math
import json
from alphacrafter.sim.utils import register_hook, get_stock_daily_data, get_account_dict, add_order

UNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
REBALANCE_DAYS = 10
_last_decision = None
try:
    with open("factors/factor_ensemble.json", "r", encoding="utf-8") as f:
        ENSEMBLE = json.load(f).get("selected_factors", [])[:10]
except Exception:
    ENSEMBLE = []

def _rank(values):
    keys = sorted(values, key=values.get)
    n = max(1, len(keys)-1)
    return {s:i/n for i,s in enumerate(keys)}

def _weights(series):
    symbols=list(series)
    score={s:0.5 for s in symbols}
    for item in ENSEMBLE:
        fid=item.get("factor_id"); vals={s:series[s].get(fid,0.0) for s in symbols}
        rr=_rank(vals); wt=float(item.get("weight",0)); direction=float(item.get("direction",1))
        for s in symbols: score[s]+=wt*direction*rr[s]
    if series.get("SPX",{}).get("spx20",0)<0 and series.get("SPX",{}).get("spx60",0)<0:
        for s in ("XAU","US10Y","CN10Y"): score[s]+=0.10
        for s in ("BTC","ETH","WTI"): score[s]=max(0.05,score[s]-0.05)
    raw={s:max(.05,.35+score[s]) for s in symbols}
    inv={s:1/max(.08,series[s].get("vol20",.25)) for s in symbols}
    a=sum(raw.values()); b=sum(inv.values())
    out={s:.78*raw[s]/a+.22*inv[s]/b for s in symbols}
    out={s:min(.16,max(.015,v)) for s,v in out.items()}; z=sum(out.values())
    return {s:v/z for s,v in out.items()}

@register_hook
def cross_asset_factor_strategy():
    global _last_decision
    account=get_account_dict() or {}; frames={}; ret5={}; dates=[]
    for s in UNIVERSE:
        df=get_stock_daily_data(symbol=s,days=90)
        if df is None or len(df)<65: continue
