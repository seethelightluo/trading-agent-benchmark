  ▶️ write_file({'content': 'import json\nimport math\nimport numpy as np\nfrom alphacrafter.sim.utils import register_hook, add_order, get_stock_daily_data, get_account_dict\n\nUNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]\nDEFENSIVE = {"XAU", "US10Y", "CN10Y"}\nCADENCE = 10\nMIN_W, MAX_W = 0.015, 0.16\nSIGNAL_MIX, RISK_MIX = 0.78, 0.22\nFACTORS = {\n    "miner_3_clv_1d": 0.3395,\n    "peer_median_leadlag_5d": 0.2612,\n    "short_term_reversal_5d": 0.2012,\n    "miner_2_risk_adjusted_momentum_20d": 0.1981,\n}\ntry:\n    with open("factors/factor_ensemble.json", encoding="utf-8") as f:\n        selected = json.load(f).get("selected_factors", [])[:10]\n    if selected:\n        FACTORS = {x["factor_id"]: float(x.get("weight", 0.0)) * float(x.get("direction", 1)) for x in selected}\nexcept Exception:\n    pass\n\n_day = 0\n\ndef percentile(values):\n    finite = sorted(float(x) for x in values.values() if np.isfinite(x))\n    n = len(finite)\n    if not n:\n        return {s: 0.5 for s in UNIVERSE}\n    return {s: (sum(v <= float(values.get(s, np.nan)) for v in finite) / n\n                if np.isfinite(values.get(s, np.nan)) else 0.5) for s in UNIVERSE}\n\ndef bounded_weights(score):\n    weights = {s: MIN_W for s in UNIVERSE}\n    remaining = 1.0 - len(UNIVERSE) * MIN_W\n    active = set(UNIVERSE)\n    while active and remaining > 1e-10:\n        positive = {s: max(float(score[s]), 1e-8) for s in active}\n        total = sum(positive.values())\n        capped = [s for s in active if remaining * positive[s] / total > MAX_W - MIN_W]\n        if not capped:\n            for s in active:\n                weights[s] += remaining * positive[s] / total\n            break\n        for s in capped:\n            weights[s] = MAX_W\n            remaining -= MAX_W - MIN_W\n            active.remove(s)\n    norm = sum(weights.values())\n    return {s: weights[s] / norm for s in UNIVERSE}\n\n@register_hook\ndef cross_asset_allocator():\n    global _day\n    _day += 1\n    if (_day - 1) % CADENCE != 0:\n        return\n    account = get_account_dict()\n    positions = {p.get("symbol"): p for p in account.get("positions", [])}\n    prices, vols, clv, ret5, ret20, ret40 = {}, {}, {}, {}, {}, {}\n    for symbol in UNIVERSE:\n        df = get_stock_daily_data(symbol=symbol, days=130)\n        if df is None or len(df) < 45:\n            continue\n        df = df.sort_values("date")\n        p = np.asarray(df["close"], dtype=float)\n        if len(p) < 42 or not np.all(np.isfinite(p[-42:])) or np.any(p[-42:] <= 0):\n            continue\n        prices[symbol] = float(p[-1])\n        daily = p[1:] / p[:-1] - 1.0\n        vols[symbol] = max(float(np.std(daily[-20:]) * math.sqrt(252)), 0.05)\n        high, low = float(df.iloc[-1]["high"]), float(df.iloc[-1]["low"])\n        clv[symbol] = (2.0 * p[-1] - high - low) / (high - low) if high > low else 0.0\n        ret5[symbol] = p[-1] / p[-6] - 1.0\n        ret20[symbol] = p[-1] / p[-21] - 1.0\n        ret40[symbol] = p[-1] / p[-41] - 1.0\n    if not prices:\n        return\n    median5 = float(np.median(list(ret5.values())))\n    raw = {\n        "miner_3_clv_1d": clv,\n        "peer_median_leadlag_5d": {s: ret5.get(s, np.nan) - median5 for s in UNIVERSE},\n        "short_term_reversal_5d": {s: -ret5.get(s, np.nan) for s in UNIVERSE},\n        "miner_2_risk_adjusted_momentum_20d": {s: (0.5 * ret20[s] + 0.5 * ret40[s]) / vols[s] if s in prices else np.nan for s in UNIVERSE},\n    }\n    ranks = {factor: percentile(values) for factor, values in raw.items()}\n    invvol = percentile({s: 1.0 / vols.get(s, 0.5) for s in UNIVERSE})\n    spx = ret20.get("SPX", 0.0)\n    bearish = spx < -0.005\n    scores = {}\n    for s in UNIVERSE:\n        signal = sum(FACTORS.get(f, 0.0) * ranks[f][s] for f in raw)\n        risk = invvol[s] * (0.88 if vols.get(s, 0.5) > 0.75 else 1.0)\n        defensive = 0.10 if bearish and s in DEFENSIVE else 0.0\n        scores[s] = max(SIGNAL_MIX * signal + RISK_MIX * risk + defensive, 1e-8)\n    target = bounded_weights(scores)\n    total = float(account.get("total_assets", 0.0) or 0.0)\n    for s in UNIVERSE:\n        price = prices.get(s, float((positions.get(s) or {}).get("current_price", 0.0) or 0.0))\n        if price <= 0 or total <= 0:\n            continue\n        pos = positions.get(s) or {}\n        current = float(pos.get("quantity", 0.0) or 0.0)\n        available = float(pos.get("available_quantity", current) or 0.0)\n        delta = total * target[s] / price - current\n        if delta < 0 and available > 0:\n            add_order(symbol=s, order_type="SELL", price=price, quantity=min(-delta, available))\n    for s in UNIVERSE:\n        price = prices.get(s, float((positions.get(s) or {}).get("current_price", 0.0) or 0.0))\n        if price <= 0 or total <= 0:\n            continue\n        current = float((positions.get(s) or {}).get("quantity", 0.0) or 0.0)\n        delta = total * target[s] / price - current\n        if delta > 0:\n            add_order(symbol=s, order_type="BUY", price=price, quantity=delta)\n', 'file_path': 'strategy.py'})
