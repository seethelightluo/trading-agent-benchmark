/q.std(ddof=1),(q>0).mean())\n# correlations to reconstructed known factors: reversal=-5d return, risk adj momentum=20d return/20d vol, peer median 5d\nknown=pd.DataFrame(index=idx)\nknown['reversal']=-rets.rolling(5).sum().stack().groupby(level=0).transform(lambda x:x) if False else 0\n# flatten correlation by asset-date\nF=pd.DataFrame({'pressure':f.stack(), 'reversal':(-rets.rolling(5).sum()).stack(), 'ram':(rets.rolling(20).sum()/rets.rolling(20).std()).stack(), 'peer':rets.rolling(5).sum().drop(columns=[]).sub(rets.rolling(5).sum().median(axis=1),axis=0).stack()}).dropna()\nprint('CORR',F.corr().round(4).to_dict()['pressure'])\nprint('coverage',f.notna().stack().mean())\n", 'file_path': 'scripts/miner_1_20260716_validate_pressure.py'})
