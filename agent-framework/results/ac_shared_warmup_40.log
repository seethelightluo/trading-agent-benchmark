 import json
import math
import numpy as np
from alphacrafter.sim.utils import register_hook, add_order, get_stock_daily_data, get_account_dict

UNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
DEFENSIVE = {"XAU", "US10Y", "CN10Y"}
REBALANCE_DAYS = 10
MIN_WEIGHT, MAX_WEIGHT = 0.015, 0.16

# The ensemble is deliberately read from the persisted screener output.
# Only these three admitted factors are active (well below the ten-factor cap).
try:
    with open("factors/factor_ensemble.json", "r", encoding="utf-8") as f:
        _ensemble = json.load(f).get("selected_factors", [])[:10]
except Exception:
    _ensemble = []
FACTOR_WEIGHTS = {x.get("factor_id"): float(x.get("weight", 0.0)) * float(x.get("direction", 1)) for x in _ensemble}
if not FACTOR_WEIGHTS:
    FACTOR_WEIGHTS = {"peer_median_leadlag_5d": .395, "short_term_reversal_5d": .305, "miner_2_risk_adjusted_momentum_20d": .300}
_day = 0

def ranks(values):
    finite = [v for v in values.values() if np.isfinite(v)]
    if not finite:
        return {s: .5 for s in UNIVERSE}
    n = len(finite)
    return {s: (sum(v <= values[s] for v in finite) / n if np.isfinite(values[s]) else .5) for s in UNIVERSE}

def bounded_weights(scores):
    # Floors prevent an unvalidated signal from becoming a cash proxy; caps
    # control concentration in this intentionally small cross-asset universe.
    w = {s: max(MIN_WEIGHT, float(scores.get(s, MIN_WEIGHT))) for s in UNIVERSE}
    for _ in range(100):
        total = sum(w.values())
        w = {s: min(MAX_WEIGHT, x / total) for s, x in w.items()}
        gap = 1.0 - sum(w.values())
        free = [s for s in UNIVERSE if w[s] < MAX_WEIGHT - 1e-12]
        if gap <= 1e-10 or not free:
            break
        for s in free:
            w[s] += gap / len(free)
    total = sum(w.values())
    return {s: w[s] / total for s in UNIVERSE}

@register_hook
def cross_asset_allocator():
    global _day
    _day += 1
    if (_day - 1) % REBALANCE_DAYS:
        return
    account = get_account_dict()
    closes = {}
    for s in UNIVERSE:
        df = get_stock_daily_data(symbol=s, days=100)
        if df is None or len(df) < 65:
            continue
        p = np.asarray(df.sort_values("date")["close"], dtype=float)
        if len(p) >= 41 and np.all(np.isfinite(p)) and np.all(p > 0):
            closes[s] = p
    r5, mom, vol = {}, {}, {}
    for s in UNIVERSE:
        p = closes.get(s)
        if p is None:
            r5[s] = mom[s] = vol[s] = np.nan
            continue
        d = p[1:] / p[:-1] - 1.0
        r5[s] = p[-1] / p[-6] - 1.0
        mom[s] = .5 * (p[-1] / p[-21] - 1.0) + .5 * (p[-1] / p[-41] - 1.0)
        vol[s] = max(float(np.std(d[-20:]) * math.sqrt(252)), .05)
    med = float(np.nanmedian([x for x in r5.values() if np.isfinite(x)])) if any(np.isfinite(x) for x in r5.values()) else 0.0
    factors = {
        "peer_median_leadlag_5d": {s: r5[s] - med for s in UNIVERSE},
        "short_term_reversal_5d": {s: -r5[s] for s in UNIVERSE},
        "miner_2_risk_adjusted_momentum_20d": {s: mom[s] / vol[s] if np.isfinite(vol[s]) else np.nan for s in UNIVERSE},
    }
    component = {s: sum(FACTOR_WEIGHTS.get(k, 0.0) * ranks(v)[s] for k, v in factors.items()) for s in UNIVERSE}
    invvol = ranks({s: 1.0 / vol[s] if np.isfinite(vol[s]) else np.nan for s in UNIVERSE})
    spx = closes.get("SPX")
    bearish = spx is not None and spx[-1] / spx[-31] < .995
    raw = {}
    for s in UNIVERSE:
        score = .78 * component[s] + .22 * invvol[s]
        if np.isfinite(vol[s]) and vol[s] > .75:
            score *= .88
        if bearish and s in DEFENSIVE:
            score += .12
        raw[s] = max(score, 0.0) + MIN_WEIGHT
    weights = bounded_weights(raw)

    positions = {p.get("symbol"): p for p in account.get("positions", [])}
    assets = float(account.get("total_assets", 0.0) or 0.0)
    prices = {}
    for s in UNIVERSE:
        px = float((positions.get(s) or {}).get("current_price", 0) or 0)
        if px <= 0 and s in closes:
            px = float(closes[s][-1])
        if px > 0:
            prices[s] = px
    # Use settled inventory for reductions (T+1). Fractional quantities are
    # intentional: the benchmark permits them and target weights stay exact.
    targets = {s: assets * weights[s] / prices[s] for s in UNIVERSE if s in prices}
    for s, target in targets.items():
        pos = positions.get(s, {})
        current = float(pos.get("quantity", 0) or 0)
        settled = float(pos.get("available_quantity", current) or 0)
        if current > target and settled > 0:
            add_order(symbol=s, order_type="SELL", price=prices[s], quantity=max(1, int(min(current - target, settled))))
    for s, target in targets.items():
        current = float((positions.get(s) or {}).get("quantity", 0) or 0)
        if target > current:
            add_order(symbol=s, order_type="BUY", price=prices[s], quantity=max(1, int(target - current)))


