  ▶️ write_file({'content': 'from alphacrafter.sim.utils import register_hook, get_account_dict, get_stock_daily_data, add_order\nimport math\n\nUNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]\nDEFENSIVE = {"XAU", "US10Y", "CN10Y"}\nREVERSAL_WEIGHT = 0.504\nMOMENTUM_WEIGHT = 0.496\nREBALANCE_DAYS = 10\nMIGRATION_THRESHOLD = 0.001\n_last_rebalance_date = None\n\n\ndef rank_scores(items):\n    ordered = sorted(items, key=lambda x: x[1], reverse=True)\n    n = max(1, len(ordered) - 1)\n    return {symbol: 1.0 - i / n for i, (symbol, _) in enumerate(ordered)}\n\n\ndef date_key(value):\n    return str(value)[:10]\n\n\n@register_hook\ndef cross_asset_strategy():\n    global _last_rebalance_date\n    account = get_account_dict()\n    listed = set(account.get("watch_list") or UNIVERSE)\n    watch = [s for s in UNIVERSE if s in listed]\n    if len(watch) != 15 or account.get("orders"):\n        return\n\n    data = {}\n    for symbol in watch:\n        df = get_stock_daily_data(symbol=symbol, days=75)\n        if df is None or len(df) < 30:\n            continue\n        df = df.sort_values("date").reset_index(drop=True)\n        close = [float(v) for v in df["close"] if v is not None and float(v) > 0]\n        if len(close) < 22:\n            continue\n        daily = [close[i] / close[i - 1] - 1.0 for i in range(len(close) - 20, len(close))]\n        mean = sum(daily) / len(daily)\n        vol = math.sqrt(sum((r - mean) ** 2 for r in daily) / max(1, len(daily) - 1))\n        data[symbol] = {\n            "price": close[-1],\n            "reversal": -(close[-1] / close[-6] - 1.0),\n            "momentum": (close[-1] / close[-21] - 1.0) / max(vol, 0.006),\n            "vol": max(vol, 0.006),\n        }\n    # The benchmark requires a complete 15-name allocation; wait only for a\n    # genuinely unavailable market-data day rather than inventing prices.\n    if len(data) < 15:\n        return\n\n    spx = get_stock_daily_data(symbol="SPX", days=70)\n    if spx is None or len(spx) < 45:\n        return\n    spx_close = [float(v) for v in spx.sort_values("date")["close"] if float(v) > 0]\n    bearish = spx_close[-1] < spx_close[-21] and spx_close[-1] < spx_close[-41]\n    decision_date = date_key(spx.sort_values("date").iloc[-1]["date"])\n    if _last_rebalance_date is not None:\n        dates = [date_key(v) for v in spx.sort_values("date")["date"]]\n        if _last_rebalance_date in dates and dates.index(decision_date) - dates.index(_last_rebalance_date) < REBALANCE_DAYS:\n            return\n\n    rev_rank = rank_scores([(s, data[s]["reversal"]) for s in watch])\n    mom_rank = rank_scores([(s, data[s]["momentum"]) for s in watch])\n    invvol = {s: 1.0 / data[s]["vol"] for s in watch}\n    invvol_total = sum(invvol.values())\n    raw = {}\n    for s in watch:\n        composite = REVERSAL_WEIGHT * rev_rank[s] + MOMENTUM_WEIGHT * mom_rank[s]\n        raw[s] = 0.60 * composite + 0.40 * invvol[s] / invvol_total\n        if bearish and s in DEFENSIVE:\n            raw[s] *= 1.15\n    total = sum(raw.values())\n    weights = {s: raw[s] / total for s in watch}\n\n    assets = float(account.get("total_assets", 0) or account.get("net_assets", 0))\n    if assets <= 0:\n        return\n    positions = {p.get("symbol"): p for p in account.get("positions", [])\n                 if float(p.get("quantity", 0) or 0) > 0}\n    initial = not positions\n    for s in watch:\n        px = data[s]["price"]\n        held = float(positions.get(s, {}).get("quantity", 0) or 0)\n        delta = assets * weights[s] - held * px\n        if not initial and abs(delta) < assets * MIGRATION_THRESHOLD:\n            continue\n        qty = abs(delta) / px  # fractional quantities are valid in this benchmark\n        if qty > 1e-9:\n            add_order(symbol=s, order_type="BUY" if delta > 0 else "SELL",\n                      price=px, quantity=qty)\n    _last_rebalance_date = decision_date\n', 'file_path': 'strategy.py'})
