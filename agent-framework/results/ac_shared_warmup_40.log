 import math
import numpy as np
from alphacrafter.sim.utils import register_hook, add_order, get_stock_daily_data, get_account_dict

UNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
DEFENSIVE = {"XAU", "US10Y", "CN10Y"}
REBALANCE_DAYS = 10
MIN_WEIGHT, MAX_WEIGHT = 0.015, 0.16
FACTOR_WEIGHTS = (0.395, 0.305, 0.300)
_day = 0

def percentile(values):
    valid = [v for v in values.values() if np.isfinite(v)]
    n = len(valid)
    if n == 0:
        return {s: 0.5 for s in UNIVERSE}
    return {s: (sum(v <= values[s] for v in valid) / n if np.isfinite(values[s]) else 0.5) for s in UNIVERSE}

def normalize(raw):
    w = {s: max(MIN_WEIGHT, float(raw.get(s, MIN_WEIGHT))) for s in UNIVERSE}
    for _ in range(50):
        total = sum(w.values())
        w = {s: min(MAX_WEIGHT, x / total) for s, x in w.items()}
        gap = 1.0 - sum(w.values())
        free = [s for s in UNIVERSE if w[s] < MAX_WEIGHT - 1e-10]
        if gap <= 1e-10 or not free:
            break
        for s in free:
            w[s] += gap / len(free)
    total = sum(w.values())
    return {s: w[s] / total for s in UNIVERSE}

@register_hook
def cross_asset_allocator():
    global _day
    _day += 1
    if (_day - 1) % REBALANCE_DAYS != 0:
        return
    account = get_account_dict()
    closes = {}
    for s in UNIVERSE:
        df = get_stock_daily_data(symbol=s, days=100)
        if df is None or len(df) < 65:
            continue
        p = np.asarray(df.sort_values("date")["close"], dtype=float)
        if np.all(np.isfinite(p)) and np.all(p > 0):
            closes[s] = p
    r5, r20, vol = {}, {}, {}
    for s in UNIVERSE:
        p = closes.get(s)
        if p is None:
            r5[s] = r20[s] = vol[s] = np.nan
            continue
        daily = p[1:] / p[:-1] - 1.0
        r5[s] = p[-1] / p[-6] - 1.0
        # Smooth the medium-term signal to reduce one-day decay/noise.
        r20[s] = 0.5 * (p[-1] / p[-21] - 1.0) + 0.5 * (p[-1] / p[-41] - 1.0)
        vol[s] = max(float(np.std(daily[-20:]) * math.sqrt(252.0)), 0.05)
    valid5 = [x for x in r5.values() if np.isfinite(x)]
    median5 = float(np.median(valid5)) if valid5 else 0.0
    # Peer-median lead-lag: reward assets that lead the cross-section.
    leadlag = {s: r5[s] - median5 for s in UNIVERSE}
    reversal = {s: -r5[s] for s in UNIVERSE}
    momentum = {s: r20[s] / vol[s] if np.isfinite(vol[s]) else np.nan for s in UNIVERSE}
    invvol = {s: 1.0 / vol[s] if np.isfinite(vol[s]) else np.nan for s in UNIVERSE}
    a, b, c, risk = (percentile(x) for x in (leadlag, reversal, momentum, invvol))
    spx = closes.get("SPX")
    bearish = spx is not None and spx[-1] / spx[-31] < 0.995
    raw = {}
    for s in UNIVERSE:
        alpha = FACTOR_WEIGHTS[0]*a[s] + FACTOR_WEIGHTS[1]*b[s] + FACTOR_WEIGHTS[2]*c[s]
        score = 0.78 * alpha + 0.22 * risk[s]
        if np.isfinite(vol[s]) and vol[s] > 0.75:
            score *= 0.88
        if bearish and s in DEFENSIVE:
            score += 0.12
        raw[s] = max(score, 0.0) + MIN_WEIGHT
    weights = normalize(raw)
    positions = {p.get("symbol"): p for p in account.get("positions", [])}
    assets = float(account.get("total_assets", 0.0) or 0.0)
    prices = {}
    for s in UNIVERSE:
        px = float((positions.get(s) or {}).get("current_price", 0) or 0)
        if px <= 0 and s in closes:
            px = float(closes[s][-1])
        if px > 0:
            prices[s] = px
    # Submit reductions first (settled quantity only), then buys toward the
    # complete target. Fractional quantities are supported by the benchmark.
    targets = {s: assets * weights[s] / prices[s] for s in prices}
    for s, target in targets.items():
        pos = positions.get(s, {})
        current = float(pos.get("quantity", 0) or 0)
        settled = float(pos.get("available_quantity", current) or 0)
        if current > target + 1e-8 and settled > 0:
            add_order(symbol=s, order_type="SELL", price=prices[s], quantity=max(1, int(min(current-target, settled))))
    for s, target in targets.items():
        current = float((positions.get(s) or {}).get("quantity", 0) or 0)
        if target > current + 1e-8:
            add_order(symbol=s, order_type="BUY", price=prices[s], quantity=max(1, int(target-current)))
