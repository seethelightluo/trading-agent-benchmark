  ▶️ write_file({'content': 'import math\nimport numpy as np\nfrom alphacrafter.sim.utils import register_hook, add_order, get_stock_daily_data, get_account_dict\n\n# Conservative, transparent 15-asset cross-sectional allocator.\nUNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]\nDEFENSIVE = {"XAU", "US10Y", "CN10Y"}\nREBALANCE_DAYS = 10\nMAX_WEIGHT = 0.18\n_signal_weights = (0.395, 0.305, 0.300)\n_day_counter = 0\n\n\ndef _rank(values, higher_is_better=True):\n    # Cross-sectional percentile ranks; missing values receive the median.\n    keys = list(values)\n    valid = [v for v in values.values() if np.isfinite(v)]\n    if not valid:\n        return {k: 0.5 for k in keys}\n    ordered = sorted(valid)\n    out = {}\n    for k, v in values.items():\n        if not np.isfinite(v):\n            r = 0.5\n        else:\n            r = sum(x <= v for x in ordered) / len(ordered)\n        out[k] = r if higher_is_better else 1.0 - r\n    return out\n\n\n@register_hook\ndef cross_asset_allocator():\n    global _day_counter\n    account = get_account_dict()\n    watch = account.get("watch_list") or UNIVERSE\n    # The benchmark watch list may be strings or symbol records.\n    symbols = []\n    for x in watch:\n        s = x if isinstance(x, str) else x.get("symbol")\n        if s in UNIVERSE and s not in symbols:\n            symbols.append(s)\n    symbols = [s for s in UNIVERSE if s in symbols] or UNIVERSE[:]\n    _day_counter += 1\n    if (_day_counter - 1) % REBALANCE_DAYS != 0:\n        return\n\n    data = {}\n    for s in symbols:\n        df = get_stock_daily_data(symbol=s, days=70)\n        if df is not None and len(df) >= 25:\n            df = df.sort_values("date")\n            close = np.asarray(df["close"], dtype=float)\n            data[s] = close\n    if len(data) < 8:\n        return\n\n    # Signals use only completed observations returned by the simulator.\n    ret5, ret20, vol20, lead = {}, {}, {}, {}\n    for s in symbols:\n        p = data.get(s)\n        if p is None or len(p) < 25 or p[-21] <= 0:\n            ret5[s] = ret20[s] = lead[s] = np.nan\n            vol20[s] = np.nan\n            continue\n        r = p[1:] / p[:-1] - 1.0\n        ret5[s] = p[-1] / p[-6] - 1.0 if len(p) >= 6 else np.nan\n        ret20[s] = p[-1] / p[-21] - 1.0\n        vol20[s] = np.std(r[-20:]) * math.sqrt(252) if len(r) >= 20 else np.nan\n        peers = []\n        for q in data.values():\n            if len(q) >= 6 and q[-6] > 0:\n                peers.append(q[-1] / q[-6] - 1.0)\n        lead[s] = (np.median(peers) - ret5[s]) if peers and np.isfinite(ret5[s]) else np.nan\n\n    # Positive reversal means recent laggards rank higher. Lead-lag is a\n    # smoothed relative signal; momentum supplies the slower stabilizer.\n    r_lead = _rank(lead, True)\n    r_rev = _rank(ret5, False)\n    r_mom = _rank({s: ret20[s] / max(vol20[s], 0.10) if np.isfinite(ret20[s]) and np.isfinite(vol20[s]) else np.nan for s in symbols}, True)\n    invvol = {s: 1.0 / max(vol20.get(s, np.nan), 0.10) if np.isfinite(vol20.get(s, np.nan)) else 0.5 for s in symbols}\n    invvol = _rank(invvol, True)\n\n    spx = data.get("SPX")\n    bearish = bool(spx is not None and len(spx) >= 31 and spx[-1] / spx[-31] < 0.995)\n    raw = {}\n    for s in symbols:\n        signal = _signal_weights[0] * r_lead[s] + _signal_weights[1] * r_rev[s] + _signal_weights[2] * r_mom[s]\n        raw[s] = 0.45 * signal + 0.55 * invvol[s]\n        if bearish and s in DEFENSIVE:\n            raw[s] += 0.18\n        # Avoid concentrating in high-volatility crypto/commodity names.\n        if vol20.get(s, np.nan) > 0.75:\n            raw[s] *= 0.88\n\n    # Positive floor gives the required complete 15-asset vector; cap and\n    # iterate so the final vector is nonnegative and sums exactly to one.\n    floor = 0.012\n    weights = {s: floor + max(raw.get(s, 0.5), 0.0) for s in symbols}\n    for _ in range(10):\n        total = sum(weights.values())\n        weights = {s: min(MAX_WEIGHT, weights[s] / total) for s in symbols}\n        excess = 1.0 - sum(weights.values())\n        if excess <= 1e-8:\n            break\n        free = [s for s in symbols if weights[s] < MAX_WEIGHT - 1e-9]\n        if not free:\n            break\n        add = excess / len(free)\n        for s in free:\n            weights[s] += add\n    total = sum(weights.values())\n    weights = {s: max(0.0, weights[s] / total) for s in symbols}\n\n    assets = float(account.get("total_assets", 0.0))\n    positions = {p.get("symbol"): p for p in account.get("positions", [])}\n    # Submit reductions first, then additions. Fractional quantities are\n    # intentional in this benchmark contract.\n    for s in symbols:\n        pos = positions.get(s, {})\n        qty = float(pos.get("quantity", 0) or 0)\n        price = float(pos.get("current_price", 0) or 0)\n        if qty > 0 and price > 0:\n            target_qty = assets * weights[s] / price\n            delta = target_qty - qty\n            if delta < -1e-8:\n                add_order(symbol=s, order_type="SELL", price=price, quantity=float(-delta))\n    for s in symbols:\n        pos = positions.get(s, {})\n        qty = float(pos.get("quantity", 0) or 0)\n        price = float(pos.get("current_price", 0) or 0)\n        if price <= 0:\n            continue\n        target_qty = assets * weights[s] / price\n        delta = target_qty - qty\n        if delta > 1e-8:\n            add_order(symbol=s, order_type="BUY", price=price, quantity=float(delta))\n', 'file_path': 'strategy.py'})Traceback (most recent call last):
