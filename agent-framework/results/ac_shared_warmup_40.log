  ▶️ write_file({'content': 'import math\nimport json\nfrom alphacrafter.sim.utils import register_hook, get_stock_daily_data, get_account_dict, add_order\n\nUNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]\nREBALANCE_DAYS = 10\n_last_decision = None\ntry:\n    with open("factors/factor_ensemble.json", "r", encoding="utf-8") as f:\n        ENSEMBLE = json.load(f).get("selected_factors", [])[:10]\nexcept Exception:\n    ENSEMBLE = []\n\ndef _rank(values):\n    keys = sorted(values, key=values.get)\n    n = max(1, len(keys)-1)\n    return {s:i/n for i,s in enumerate(keys)}\n\ndef _weights(series):\n    symbols=list(series)\n    score={s:0.5 for s in symbols}\n    for item in ENSEMBLE:\n        fid=item.get("factor_id"); vals={s:series[s].get(fid,0.0) for s in symbols}\n        rr=_rank(vals); wt=float(item.get("weight",0)); direction=float(item.get("direction",1))\n        for s in symbols: score[s]+=wt*direction*rr[s]\n    if series.get("SPX",{}).get("spx20",0)<0 and series.get("SPX",{}).get("spx60",0)<0:\n        for s in ("XAU","US10Y","CN10Y"): score[s]+=0.10\n        for s in ("BTC","ETH","WTI"): score[s]=max(0.05,score[s]-0.05)\n    raw={s:max(.05,.35+score[s]) for s in symbols}\n    inv={s:1/max(.08,series[s].get("vol20",.25)) for s in symbols}\n    a=sum(raw.values()); b=sum(inv.values())\n    out={s:.78*raw[s]/a+.22*inv[s]/b for s in symbols}\n    out={s:min(.16,max(.015,v)) for s,v in out.items()}; z=sum(out.values())\n    return {s:v/z for s,v in out.items()}\n\n@register_hook\ndef cross_asset_factor_strategy():\n    global _last_decision\n    account=get_account_dict() or {}; frames={}; ret5={}; dates=[]\n    for s in UNIVERSE:\n        df=get_stock_daily_data(symbol=s,days=90)\n        if df is None or len(df)<65: continue\n        dates.append(str(df.iloc[-1]["date"])); c=[float(x) for x in df["close"] if x is not None and float(x)>0]\n        if len(c)<65: continue\n        r=[c[i]/c[i-1]-1 for i in range(1,len(c))]; r5=c[-1]/c[-6]-1; r20=c[-1]/c[-21]-1; r60=c[-1]/c[-61]-1\n        vol=math.sqrt(sum(x*x for x in r[-20:])/20)*math.sqrt(252)\n        hi=float(df.iloc[-1]["high"]); lo=float(df.iloc[-1]["low"])\n        frames[s]={"close":c[-1],"miner_3_clv_1d":(c[-1]-lo)/max(1e-9,hi-lo),"short_term_reversal_5d":-r5,"miner_2_risk_adjusted_momentum_20d":r20/max(.08/math.sqrt(252),vol),"vol20":vol,"spx20":0,"spx60":0}\n        ret5[s]=r5\n    if len(frames)<15: return\n    med=sorted(ret5.values())[len(ret5)//2]\n    for s in frames: frames[s]["peer_median_leadlag_5d"]=ret5[s]-med\n    if "SPX" in frames:\n        for s in frames: frames[s]["spx20"]=frames["SPX"].get("miner_2_risk_adjusted_momentum_20d",0); frames[s]["spx60"]=frames["SPX"]["close"]/float(get_stock_daily_data(symbol="SPX",days=90).iloc[-61]["close"])-1\n    date=max(dates) if dates else None\n    if date is None or date==_last_decision: return\n    if not hasattr(cross_asset_factor_strategy,"seen"): cross_asset_factor_strategy.seen=[]\n    if date not in cross_asset_factor_strategy.seen: cross_asset_factor_strategy.seen.append(date)\n    if (len(cross_asset_factor_strategy.seen)-1)%10!=0: return\n    _last_decision=date; target=_weights(frames)\n    pos={p.get("symbol"):p for p in account.get("positions",[])}; total=float(account.get("total_assets",0) or account.get("net_assets",0) or 0)\n    for s in UNIVERSE:\n        p=pos.get(s,{}); q=float(p.get("quantity",0) or 0); px=float(p.get("current_price",0) or frames[s]["close"]); delta=target[s]*total-q*px\n        if delta < -1: add_order(symbol=s,order_type="SELL",price=px,quantity=min(q,abs(delta)/px))\n    for s in UNIVERSE:\n        p=pos.get(s,{}); q=float(p.get("quantity",0) or 0); px=float(p.get("current_price",0) or frames[s]["close"]); delta=target[s]*total-q*px\n        if delta > 1: add_order(symbol=s,order_type="BUY",price=px,quantity=delta/px)\n', 'file_path': 'strategy.py'})
