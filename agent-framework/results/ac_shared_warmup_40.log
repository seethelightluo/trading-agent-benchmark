  ▶️ write_file({'content': 'from alphacrafter.sim.utils import register_hook, get_account_dict, get_stock_daily_data, add_order\nimport math\n\nUNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]\nDEFENSIVE = {"XAU", "US10Y", "CN10Y"}\nREV_W, MOM_W = 0.504, 0.496\nREBALANCE_DAYS = 10\nMIGRATION_THRESHOLD = 0.001\n_last_rebalance_date = None\n\n\ndef _rank(values):\n    ordered = sorted(values, key=lambda x: x[1], reverse=True)\n    n = max(1, len(ordered) - 1)\n    return {s: 1.0 - i / n for i, (s, _) in enumerate(ordered)}\n\n\ndef _day(x):\n    return str(x)[:10]\n\n\n@register_hook\ndef cross_asset_strategy():\n    global _last_rebalance_date\n    account = get_account_dict()\n    listed = set(account.get("watch_list") or [])\n    watch = [s for s in UNIVERSE if s in listed] if listed else UNIVERSE\n    if len(watch) != 15:\n        return\n    # Do not submit another batch while an earlier batch is pending.\n    if account.get("orders"):\n        return\n\n    features = {}\n    for s in watch:\n        df = get_stock_daily_data(symbol=s, days=75)\n        if df is None or len(df) < 45:\n            return\n        df = df.sort_values("date").reset_index(drop=True)\n        close = [float(x) for x in df["close"] if x is not None and float(x) > 0]\n        if len(close) < 45:\n            return\n        rets = [close[i] / close[i-1] - 1.0 for i in range(len(close)-20, len(close))]\n        mean = sum(rets) / len(rets)\n        vol = math.sqrt(sum((r-mean) ** 2 for r in rets) / max(1, len(rets)-1))\n        features[s] = {"price": close[-1],\n                       "rev": -(close[-1] / close[-6] - 1.0),\n                       "mom": (close[-1] / close[-21] - 1.0) / max(vol, 0.006),\n                       "vol": max(vol, 0.006)}\n\n    spx = get_stock_daily_data(symbol="SPX", days=70)\n    if spx is None or len(spx) < 45:\n        return\n    spx = spx.sort_values("date").reset_index(drop=True)\n    sp = [float(x) for x in spx["close"] if x is not None and float(x) > 0]\n    if len(sp) < 45:\n        return\n    bearish = sp[-1] < sp[-21] and sp[-1] < sp[-41]\n    decision = _day(spx.iloc[-1]["date"])\n    if _last_rebalance_date is not None:\n        dates = [_day(x) for x in spx["date"]]\n        if _last_rebalance_date in dates and dates.index(decision)-dates.index(_last_rebalance_date) < REBALANCE_DAYS:\n            return\n\n    rr = _rank([(s, features[s]["rev"]) for s in watch])\n    mr = _rank([(s, features[s]["mom"]) for s in watch])\n    inv = {s: 1.0/features[s]["vol"] for s in watch}\n    inv_total = sum(inv.values())\n    raw = {}\n    for s in watch:\n        score = REV_W*rr[s] + MOM_W*mr[s]\n        raw[s] = 0.60*score + 0.40*inv[s]/inv_total\n        if bearish and s in DEFENSIVE:\n            raw[s] *= 1.15\n    total = sum(raw.values())\n    weights = {s: raw[s]/total for s in watch}\n\n    assets = float(account.get("total_assets", 0) or account.get("net_assets", 0))\n    if assets <= 0:\n        return\n    positions = {p.get("symbol"): p for p in account.get("positions", [])\n                 if float(p.get("quantity", 0) or 0) > 0}\n    initial = not positions\n    # Integer quantities are retained for compatibility with the execution API;\n    # the resulting residual is immaterial and is not treated as a cash sleeve.\n    for s in watch:\n        px = features[s]["price"]\n        held = float(positions.get(s, {}).get("quantity", 0) or 0)\n        delta = assets*weights[s] - held*px\n        if not initial and abs(delta) < assets*MIGRATION_THRESHOLD:\n            continue\n        qty = int(abs(delta)/px)\n        if qty <= 0:\n            continue\n        add_order(symbol=s, order_type="BUY" if delta > 0 else "SELL", price=px, quantity=qty)\n    _last_rebalance_date = decision\n', 'file_path': 'strategy.py'})
