import json
from alphacrafter.sim.utils import register_hook, get_stock_daily_data, get_account_dict, add_order

UNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
CADENCE = 10
_last_date = None
try:
    with open("factors/factor_ensemble.json", encoding="utf-8") as f:
        FACTORS = json.load(f).get("selected_factors", [])[:10]
except Exception:
    FACTORS = []

def rank01(values):
    ordered = sorted(values, key=values.get)
    den = max(1, len(ordered) - 1)
    return {s: i / den for i, s in enumerate(ordered)}

def make_target(data):
    symbols = list(data)
    score = {s: 0.5 for s in symbols}
    for f in FACTORS:
        fid, direction = f.get("factor_id"), float(f.get("direction", 1))
        ranks = rank01({s: data[s].get(fid, 0.0) for s in symbols})
        for s in symbols:
            score[s] += float(f.get("weight", 0.0)) * direction * ranks[s]
    # Sideways/mildly bearish regime: modestly prefer tradable defensives.
    if data.get("SPX", {}).get("trend20", 0.0) < 0 and data.get("SPX", {}).get("trend60", 0.0) < 0:
        for s in ("XAU", "US10Y", "CN10Y"):
            if s in score: score[s] += 0.10
        for s in ("BTC", "ETH", "WTI"):
            if s in score: score[s] -= 0.05
    # 78% composite, 22% inverse realized volatility; bounded and fully invested.
    raw = {s: max(0.05, 0.35 + score[s]) for s in symbols}
    inv = {s: 1.0 / max(0.08, data[s].get("vol20", 0.25)) for s in symbols}
    sr, si = sum(raw.values()), sum(inv.values())
    w = {s: 0.78 * raw[s] / sr + 0.22 * inv[s] / si for s in symbols}
    w = {s: min(0.16, max(0.015, x)) for s, x in w.items()}
    z = sum(w.values())
    return {s: x / z for s, x in w.items()}

@register_hook
def cross_asset_factor_strategy():
    global _last_date
    account = get_account_dict() or {}
    data, five = {}, {}
    for s in UNIVERSE:
        df = get_stock_daily_data(symbol=s, days=90)
        if df is None or len(df) < 65: continue
        closes = [float(x) for x in df["close"] if x is not None and float(x) > 0]
        if len(closes) < 65: continue
        daily = [closes[i] / closes[i-1] - 1 for i in range(1, len(closes))]
        vol = math.sqrt(sum(x*x for x in daily[-20:]) / 20) * math.sqrt(252)
        hi, lo = float(df.iloc[-1]["high"]), float(df.iloc[-1]["low"])
        clv = (2 * closes[-1] - hi - lo) / max(1e-9, hi - lo)
        five[s] = closes[-1] / closes[-6] - 1
        data[s] = {"miner_3_clv_1d": clv, "short_term_reversal_5d": -five[s],
                   "miner_2_risk_adjusted_momentum_20d": (closes[-1]/closes[-21]-1) / max(0.08/math.sqrt(252), vol),
                   "vol20": vol, "trend20": closes[-1]/closes[-21]-1,
                   "trend60": closes[-1]/closes[-61]-1}
    if len(data) != 15: return
    median = sorted(five.values())[len(five)//2]
    for s in data: data[s]["peer_median_leadlag_5d"] = five[s] - median
    date = str(max(str(get_stock_daily_data(symbol=s, days=2).iloc[-1]["date"]) for s in data))
    if date == _last_date: return
    _last_date = date
    if not hasattr(cross_asset_factor_strategy, "dates"): cross_asset_factor_strategy.dates = []
    cross_asset_factor_strategy.dates.append(date)
    if (len(cross_asset_factor_strategy.dates) - 1) % CADENCE: return
    target = make_target(data)
    total = float(account.get("total_assets", 0) or account.get("net_assets", 0) or 0)
    positions = {p.get("symbol"): p for p in account.get("positions", [])}
    for s in UNIVERSE:
        p = positions.get(s, {}); q = float(p.get("quantity", 0) or 0)
        px = float(p.get("current_price", 0) or 0) or get_stock_daily_data(symbol=s, days=2).iloc[-1]["close"]
        delta = target[s] * total - q * float(px)
        if delta < -1 and q > 0:
            add_order(symbol=s, order_type="SELL", price=float(px), quantity=max(1, int(min(q, abs(delta)/float(px)))))
    for s in UNIVERSE:
        p = positions.get(s, {}); q = float(p.get("quantity", 0) or 0)
        px = float(p.get("current_price", 0) or 0) or get_stock_daily_data(symbol=s, days=2).iloc[-1]["close"]
        delta = target[s] * total - q * float(px)
        if delta > 1:
            add_order(symbol=s, order_type="BUY", price=float(px), quantity=max(1, int(delta/float(px))))


