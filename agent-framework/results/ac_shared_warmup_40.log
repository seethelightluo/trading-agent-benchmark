  ▶️ write_file({'content': 'from alphacrafter.sim.utils import register_hook, add_order, get_stock_daily_data, get_index_daily_data, get_account_dict\n\nUNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]\nDEFENSIVE = {"XAU", "US10Y", "CN10Y"}\nRISKY = {"BTC", "ETH", "SOX", "NDX", "WTI"}\n_day = 0\n\n\ndef _rank(items, reverse=True):\n    a = sorted(items, key=lambda x: x[1], reverse=reverse)\n    n = len(a)\n    return {s: (n - i) / n for i, (s, v) in enumerate(a)}\n\n\n@register_hook\ndef cross_asset_rebalance():\n    global _day\n    _day += 1\n    if _day != 1 and (_day - 1) % 10:\n        return\n    account = get_account_dict() or {}\n    positions = {p.get("symbol"): p for p in account.get("positions", [])}\n    if account.get("orders"):\n        return\n    rows = []\n    for s in UNIVERSE:\n        df = get_stock_daily_data(symbol=s, days=65)\n        if df is None or len(df) < 30: continue\n        c = [float(x) for x in df.sort_values("date")["close"].tolist() if float(x) > 0]\n        if len(c) < 25: continue\n        r5, r20 = c[-1]/c[-6]-1, c[-1]/c[-21]-1\n        dr = [c[i]/c[i-1]-1 for i in range(max(1,len(c)-21),len(c))]\n        mu = sum(dr)/len(dr)\n        vol = max((sum((x-mu)**2 for x in dr)/max(1,len(dr)-1))**.5, .004)\n        rows.append((s,r5,r20/vol,vol,c[-1]))\n    if len(rows) < 10: return\n    rev = _rank([(s,-r5) for s,r5,_,_,_ in rows])\n    mom = _rank([(s,m) for s,_,m,_,_ in rows])\n    iv = _rank([(s,-v) for s,_,_,v,_ in rows])\n    score = {s:.504*rev[s]+.496*mom[s] for s,*_ in rows}\n    weak = False\n    try:\n        d = get_index_daily_data(symbol="SPX", days=65)\n        c = [float(x) for x in d.sort_values("date")["close"].tolist() if float(x)>0]\n        weak = len(c)>=21 and (c[-1]/c[-21]<1.01 or c[-1]<sum(c[-20:])/20)\n    except Exception: pass\n    if weak:\n        for s in score:\n            if s in DEFENSIVE: score[s]+=.10\n            elif s in RISKY: score[s]-=.05\n    raw = {s:max(.02,(.55+score[s])*(.65+.35*iv[s])) for s,*_ in rows}\n    for s in UNIVERSE: raw.setdefault(s,.02)\n    target = {s:raw[s]/sum(raw.values()) for s in UNIVERSE}\n    assets = float(account.get("total_assets",account.get("net_assets",0)) or 0)\n    if assets <= 0: return\n    prices = {s:p for s,_,_,_,p in rows}\n    for s in UNIVERSE:\n        p=positions.get(s,{})\n        qty=float(p.get("quantity",0) or 0); px=float(p.get("current_price",0) or prices.get(s,0))\n        if px<=0: continue\n        q=int(min(max(qty-assets*target[s]/px,0),float(p.get("available_quantity",qty) or 0)))\n        if q>0: add_order(symbol=s,order_type="SELL",price=px,quantity=q)\n    for s in UNIVERSE:\n        p=positions.get(s,{})\n        qty=float(p.get("quantity",0) or 0); px=float(p.get("current_price",0) or prices.get(s,0))\n        if px<=0: continue\n        q=int(assets*target[s]/px-qty)\n        if q>0: add_order(symbol=s,order_type="BUY",price=px,quantity=q)\n', 'file_path': 'strategy.py'})
