 import json
import math
import numpy as np
from alphacrafter.sim.utils import register_hook, add_order, get_stock_daily_data, get_account_dict

UNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
DEFENSIVE = {"XAU", "US10Y", "CN10Y"}
MIN_WEIGHT, MAX_WEIGHT = 0.015, 0.16
REBALANCE_DAYS = 10
SIGNAL_MIX, RISK_MIX = 0.78, 0.22
FACTOR_WEIGHTS = {"miner_3_clv_1d": 0.3395, "peer_median_leadlag_5d": 0.2612, "short_term_reversal_5d": 0.2012, "miner_2_risk_adjusted_momentum_20d": 0.1981}
try:
    with open("factors/factor_ensemble.json", encoding="utf-8") as f:
        selected = json.load(f).get("selected_factors", [])[:10]
    if selected:
        FACTOR_WEIGHTS = {x["factor_id"]: float(x.get("weight", 0.0)) * float(x.get("direction", 1)) for x in selected}
except Exception:
    pass
_day = 0

def cs_rank(values):
    valid = [v for v in values.values() if np.isfinite(v)]
    return {s: (sum(v <= values[s] for v in valid) / len(valid) if np.isfinite(values[s]) and valid else 0.5) for s in UNIVERSE}

def bounded_weights(raw):
    w = {s: MIN_WEIGHT for s in UNIVERSE}
    remaining, active = 1.0 - len(UNIVERSE) * MIN_WEIGHT, set(UNIVERSE)
    while active and remaining > 1e-10:
        positive = {s: max(float(raw[s]), 1e-8) for s in active}
        total = sum(positive.values())
        capped = [s for s in active if remaining * positive[s] / total > MAX_WEIGHT - MIN_WEIGHT]
        if not capped:
            for s in active: w[s] += remaining * positive[s] / total
            break
        for s in capped:
            w[s] = MAX_WEIGHT; remaining -= MAX_WEIGHT - MIN_WEIGHT; active.remove(s)
    z = sum(w.values())
    return {s: w[s] / z for s in UNIVERSE}

@register_hook
def cross_asset_allocator():
    global _day
    _day += 1
    if (_day - 1) % REBALANCE_DAYS != 0: return
    account = get_account_dict()
    positions = {p.get("symbol"): p for p in account.get("positions", [])}
    close, bars, vol = {}, {}, {}
    for s in UNIVERSE:
        df = get_stock_daily_data(symbol=s, days=120)
        if df is None or len(df) < 45: continue
        df = df.sort_values("date")
        p = np.asarray(df["close"], dtype=float)
        if len(p) < 42 or not np.all(np.isfinite(p)) or np.any(p <= 0): continue
        close[s], bars[s] = p, df.iloc[-1]
        vol[s] = max(float(np.std((p[1:] / p[:-1] - 1.0)[-20:]) * math.sqrt(252)), 0.05)
    prices = {s: float(close[s][-1]) if s in close else float((positions.get(s) or {}).get("current_price", 0) or 0) for s in UNIVERSE}
    r5, rev, mom, clv = {}, {}, {}, {}
    for s in UNIVERSE:
        p = close.get(s)
        if p is None: r5[s] = rev[s] = mom[s] = clv[s] = np.nan; continue
        r5[s] = p[-1] / p[-6] - 1.0; rev[s] = -r5[s]
        mom[s] = 0.5 * (p[-1] / p[-21] - 1.0) + 0.5 * (p[-1] / p[-41] - 1.0)
        hi, lo = float(bars[s]["high"]), float(bars[s]["low"]); den = hi - lo
        clv[s] = (2.0 * p[-1] - hi - lo) / den if den > 0 else 0.0
    valid_r5 = [v for v in r5.values() if np.isfinite(v)]
    median = float(np.median(valid_r5)) if valid_r5 else 0.0
    factors = {"miner_3_clv_1d": clv, "peer_median_leadlag_5d": {s: r5[s] - median for s in UNIVERSE}, "short_term_reversal_5d": rev, "miner_2_risk_adjusted_momentum_20d": {s: mom[s] / vol.get(s, 0.5) if np.isfinite(mom[s]) else np.nan for s in UNIVERSE}}
    ranked = {k: cs_rank(v) for k, v in factors.items()}; invvol = cs_rank({s: 1.0 / vol.get(s, 0.5) for s in UNIVERSE})
    spx = close.get("SPX"); bearish = spx is not None and spx[-1] / spx[-31] < 0.995
    raw = {}
    for s in UNIVERSE:
        signal = sum(FACTOR_WEIGHTS.get(k, 0.0) * ranked[k][s] for k in factors)
        score = SIGNAL_MIX * signal + RISK_MIX * invvol[s]
        if vol.get(s, 0.0) > 0.75: score *= 0.88
        if bearish and s in DEFENSIVE: score += 0.12
        raw[s] = max(score, 1e-8)
    weights = bounded_weights(raw); total = float(account.get("total_assets", 0.0) or 0.0)
    targets = {s: total * weights[s] / prices[s] for s in UNIVERSE if prices[s] > 0}
    for s, target in targets.items():
        pos = positions.get(s, {}); current = float(pos.get("quantity", 0.0) or 0.0); available = float(pos.get("available_quantity", current) or 0.0)
        qty = min(max(current - target, 0.0), max(available, 0.0))
        qty_i = int(qty)
        if qty_i > 0: add_order(symbol=s, order_type="SELL", price=prices[s], quantity=qty_i)
    for s, target in targets.items():
        current = float((positions.get(s) or {}).get("quantity", 0.0) or 0.0); qty = max(target - current, 0.0)
        qty_i = int(qty)
        if qty_i > 0: add_order(symbol=s, order_type="BUY", price=prices[s], quantity=qty_i)


