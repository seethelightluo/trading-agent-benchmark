  ▶️ write_file({'content': "import pandas as pd, numpy as np, glob, json, os\nfrom scipy.stats import spearmanr, pearsonr\nU=['000300.SH','SPX','HSI','N225','SX5E','000688.SH','SOX','NDX','XAU','COPPER','WTI','BTC','ETH','US10Y','CN10Y']\nP={s:pd.read_csv('../persistent/stock_data/'+s+'.csv',parse_dates=['date']).set_index('date').close for s in U}\npx=pd.concat(P,axis=1).sort_index(); ret=px.pct_change()\n# downside-risk-adjusted momentum: trailing 20d return divided by downside deviation of daily returns, lagged at signal date\nmom=px/px.shift(20)-1\ndown=ret.where(ret<0).rolling(20,min_periods=15).std()\nf=(mom/down.replace(0,np.nan)).shift(0)\n# forward returns available strictly after signal close; 5d and 10d close-to-close\nout=[]\nfor h in [1,5,10]:\n  fr=px.shift(-h)/px-1\n  ics=[]; dates=[]; nobs=[]; turnovers=[]\n  prev=None\n  for d in f.index:\n    x=f.loc[d]; y=fr.loc[d]; z=pd.concat([x,y],axis=1).dropna()\n    if len(z)>=8:\n      # Pearson daily paper IC\n      ic=z.iloc[:,0].corr(z.iloc[:,1]); ics.append(ic); dates.append(d); nobs.append(len(z))\n    ranks=x.rank(pct=True); \n    if prev is not None: turnovers.append((ranks-prev).abs().mean())\n    prev=ranks\n  a=np.array(ics); print('H',h,'dates',len(a),'meanIC',np.nanmean(a),'std',np.nanstd(a,ddof=1),'ICIR',np.nanmean(a)/np.nanstd(a,ddof=1),'hit',np.mean(a>0),'nmean',np.mean(nobs),'turn',np.nanmean(turnovers))\n# coverage and correlation against existing formulas approximate\nprint('coverage',f.notna().mean().mean(),'assets',f.notna().mean().round(3).to_dict())\n# library correlations on pooled date-asset valid observations\nfor fn in glob.glob('factors/*.json'):\n try:\n  j=json.load(open(fn)); print('LIB',j.get('factor_id'),j.get('validation',{}).get('metrics',{}).get('ic'))\n except: pass\nprint('period',px.index.min(),px.index.max())\nprint('pooled corr with 20d mom',f.stack().corr(mom.stack()))\n", 'file_path': 'scripts/miner_1_20260716_downside_adjusted_momentum.py'})
