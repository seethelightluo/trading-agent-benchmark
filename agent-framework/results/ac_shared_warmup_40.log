 import pandas as pd,numpy as np,glob
paths=glob.glob('../persistent/stock_data/*.csv'); D={}
for p in paths:
 s=p.split('/')[-1][:-4]; x=pd.read_csv(p); x.date=pd.to_datetime(x.date); D[s]=x.set_index('date').close
px=pd.concat(D,axis=1).sort_index(); r=px.pct_change()
# Downside asymmetry: fraction of recent absolute variation occurring on negative days.
down=r.where(r<0,0).rolling(20,min_periods=15).apply(lambda x: np.abs(x[x<0]).sum(),raw=False)
absr=r.abs().rolling(20,min_periods=15).sum(); f=-(down/absr)
for h in [1,5,10]:
 fr=px.shift(-h)/px-1; vals=[]; ns=[]; dates=[]
 for dt in f.index:
  z=pd.concat([f.loc[dt],fr.loc[dt]],axis=1).dropna()
  if len(z)>=8: vals.append(z.iloc[:,0].corr(z.iloc[:,1],method='spearman'));ns.append(len(z));dates.append(dt)
 q=pd.Series(vals,index=dates).dropna()
 print('h',h,'dates',len(q),'avgN',np.mean(ns),'IC',q.mean(),'ICIR',q.mean()/q.std(ddof=1),'hit',(q>0).mean())
 if h==1:
  print('turnover',f.rank(axis=1,pct=True).diff().abs().mean(axis=1).mean(),'coverage',f.notna().mean(axis=1).mean())
 for lab,ix in [('early',q.index<'2023-01-01'),('late',q.index>='2023-01-01')]:
  z=q[ix];print(lab,len(z),z.mean(),z.mean()/z.std(ddof=1))
print('corr momentum',f.stack().corr(r.rolling(20).sum().stack()))


