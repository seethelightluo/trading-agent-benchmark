        lead[s] = peer_med - r5[s]

    lead_rank = pct_rank(lead, True)
    reversal_rank = pct_rank(r5, False)
    risk_mom = {s: (r20[s] / max(vol[s], 0.10) if np.isfinite(r20[s]) and np.isfinite(vol[s]) else np.nan) for s in symbols}
    momentum_rank = pct_rank(risk_mom, True)
    low_vol_rank = pct_rank({s: (1.0 / vol[s] if np.isfinite(vol[s]) and vol[s] > 0 else np.nan) for s in symbols}, True)

    spx = closes.get("SPX")
    bearish = spx is not None and len(spx) >= 31 and spx[-1] / spx[-31] < 0.995
    score = {}
    for s in symbols:
        signal = (FACTOR_W["lead"] * lead_rank[s] + FACTOR_W["reversal"] * reversal_rank[s] + FACTOR_W["momentum"] * momentum_rank[s])
        score[s] = 0.45 * signal + 0.55 * low_vol_rank[s]
        if bearish and s in DEFENSIVE:
            score[s] += 0.18
        if np.isfinite(vol.get(s, np.nan)) and vol[s] > 0.75:
            score[s] *= 0.88

    # Small floor and cap produce a complete, full-investment 15-asset vector.
    weights = {s: 0.012 + max(score[s], 0.0) for s in symbols}
    for _ in range(20):
        total = sum(weights.values())
        weights = {s: min(MAX_WEIGHT, weights[s] / total) for s in symbols}
        excess = 1.0 - sum(weights.values())
        free = [s for s in symbols if weights[s] < MAX_WEIGHT - 1e-10]
        if excess <= 1e-10 or not free:
            break
        for s in free:
            weights[s] += excess / len(free)
    total = sum(weights.values())
    weights = {s: weights[s] / total for s in symbols}

    assets = float(account.get("total_assets", 0.0) or 0.0)
    positions = {p.get("symbol"): p for p in account.get("positions", [])}
    prices = {s: float((positions.get(s) or {}).get("current_price", 0) or closes[s][-1]) for s in closes}
