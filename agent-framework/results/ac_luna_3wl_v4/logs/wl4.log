px=pd.concat([load(s).rename(s) for s in U]+[dxy.rename('DXY')],axis=1,sort=True).loc[:'2026-07-30']; r=px.pct_change()
beta=r[U].rolling(60,min_periods=45).cov(r.DXY).div(r.DXY.rolling(60,min_periods=45).var(),axis=0); f=-beta
def evalh(h):
 fw=px[U].pct_change(h).shift(-h); rows=[]
 for dt in f.index:
