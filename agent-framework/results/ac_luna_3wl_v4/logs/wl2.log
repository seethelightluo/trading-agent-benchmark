  ▶️ write_file({'content': "import numpy as np, pandas as pd\nfrom alphacrafter.sim.utils import get_index_daily_data\nU=['000300.SH','SPX','HSI','N225','SX5E','000688.SH','SOX','NDX','XAU','COPPER','WTI','BTC','ETH','US10Y','CN10Y']\n# Safe-haven leadership: asset's medium-term return relative to contemporaneous universe median.\n# Use only close through t; factor is relative 20d trend, intended to select defensive leaders.\nP={}\nfor s in U:\n d=get_index_daily_data(s, days=1900)\n if d is not None and len(d):\n  x=d[['date','close']].copy(); x['date']=pd.to_datetime(x.date); P[s]=x.set_index('date').close\npx=pd.DataFrame(P).sort_index(); r=px.pct_change(20)\nmed=r.median(axis=1); sig=r.sub(med,axis=0)\n# lag signal one day explicitly\nsig=sig.shift(1)\nrows=[]\nfor h in [1,5,10]:\n fwd=px.pct_change(h).shift(-h)\n ics=[]; ns=[]; dates=[]\n for dt in sig.index:\n  a=sig.loc[dt]; b=fwd.loc[dt]; z=pd.concat([a,b],axis=1).dropna()\n  if len(z)>=8:\n   ics.append(z.iloc[:,0].corr(z.iloc[:,1],method='spearman')); ns.append(len(z)); dates.append(dt)\n q=pd.Series(ics).dropna(); print('h',h,'dates',len(q),'avgN',round(np.mean(ns),2),'IC',round(q.mean(),6),'ICIR',round(q.mean()/q.std(ddof=1),6),'hit',round((q>0).mean(),4))\n for a,b in zip(['2020-2022','2023-2024','2025-2026','2027'],[('2020','2022'),('2023','2024'),('2025','2026'),('2027','2027')]):\n  z=q[[str(d)[:4]>=b[0] and str(d)[:4]<=b[1] for d in pd.to_datetime(dates)]]\n  if len(z): print(a,round(z.mean(),6),len(z))\n# coverage and turnover on valid rows\nvalid=sig.notna().sum(axis=1)/len(U)\nprint('coverage',valid.mean(),'active dates',len(sig.dropna(how='all')))\nprint('rank turnover',sig.rank(axis=1,pct=True).diff().abs().mean(axis=1).mean())\n# artifact all dates/assets\nout=sig.stack().rename('signal').reset_index(); out.columns=['date','asset','signal']; out.to_csv('../persistent/factor_signals_miner_1_20270225_safehaven_relative20.csv',index=False)\n", 'file_path': 'scripts/miner_1_20270225_safehaven_relative20.py'})
