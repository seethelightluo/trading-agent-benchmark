] for v in data.values())\n    if last_decision is not None:\n        try:\n            elapsed = (np.datetime64(decision_date, "D") - np.datetime64(last_decision, "D")) / np.timedelta64(1, "D")\n            if elapsed < CADENCE:\n                return\n        except Exception:\n            return\n\n    factors = {name: {} for name in FACTOR_WEIGHTS}\n    invvol, peer = {}, {}\n    for symbol, (c, h, lo, r, _) in data.items():\n        if len(r) < 22:\n            continue\n        vol = max(float(np.std(r[-20:])), .008)\n        invvol[symbol] = 1. / vol\n        # Smoothed CLV uses only completed bars exposed by the simulator.\n        spread = np.maximum(h[-3:] - lo[-3:], 1e-12)\n        factors["clv"][symbol] = float(np.mean((2*c[-3:] - h[-3:] - lo[-3:]) / spread))\n        peer[symbol] = c[-1] / max(c[-6], 1e-12) - 1.\n        factors["mom20"][symbol] = (c[-1] / max(c[-21], 1e-12) - 1.) / vol\n        factors["rev3"][symbol] = -float(np.mean(r[-3:]))\n        factors["rev5"][symbol] = -float(np.mean(r[-5:]))\n    if not peer:\n        return\n    peer_median = float(np.median(list(peer.values())))\n    factors["peer"] = {s: v - peer_median for s, v in peer.items()}\n    ranks = {name: xrank(values) for name, values in factors.items()}\n    score = {s: sum(FACTOR_WEIGHTS[k] * ranks[k][s] for k in FACTOR_WEIGHTS) for s in UNIVERSE}\n\n    # Sideways/mildly bearish regime: defensive assets are tradable substitutes\n    # for cash. A confirmed SPX break receives a stronger, deterministic tilt.\n    defensive = False\n    confirmed = False\n    if "SPX" in data:\n        c = data["SPX"][0]\n        defensive = c[-1] < c[-6] and c[-1] < c[-21]\n        confirmed = defensive and c[-1] < c[-31]\n    if defensive:\n        bump = .10 if not confirmed else .16\n        for s in ("XAU", "US10Y", "CN10Y"):\n            score[s] += bump\n        for s in ("BTC", "ETH", "WTI"):\n            score[s] = max(.05, score[s] - bump * .55)\n\n    avg_iv = float(np.mean(list(invvol.values()))) if invvol else 1.\n    # 75% composite signal / 25% inverse-vol overlay, full investment.\n    raw = {s: max(.01, score[s]) * (.75 + .25 * invvol.get(s, avg_iv) / avg_iv) for s in UNIVERSE}\n    weights = bounded(raw)\n    score_arr = np.asarray([score[s] for s in UNIVERSE], float)\n    sd = max(float(score_arr.std()), 1e-9)\n    forecast = {s: float(.01 * (score[s] - score_arr.mean()) / sd) for s in UNIVERSE}\n    try:\n        ensemble = json.loads((Path(__file__).parent / "factors/factor_ensemble.json").read_text())\n        factor_ids = [x["factor_id"] for x in ensemble.get("selected_factors", []) if isinstance(x, dict) and x.get("factor_id")]\n    except Exception:\n        factor_ids = []\n    rebalance_to_weights(weights, forecast_returns=forecast, factor_ids=factor_ids[:10], horizon_days=10)\n    last_decision = decision_date\n', 'file_path': 'strategy.py'})
