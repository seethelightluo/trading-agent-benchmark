 import pandas as pd,numpy as np
from scipy.stats import spearmanr
A=['000300.SH','SPX','HSI','N225','SX5E','000688.SH','SOX','NDX','XAU','COPPER','WTI','BTC','ETH','US10Y','CN10Y']
p={a:pd.read_csv('../persistent/stock_data/'+a+'.csv',parse_dates=['date']).sort_values('date').set_index('date').close for a in A}
r=pd.DataFrame({a:p[a].pct_change() for a in A}); r3=pd.DataFrame({a:p[a].pct_change(3) for a in A}); common=r3.median(axis=1); resid=r3.sub(common,axis=0)
vol=r.rolling(20,min_periods=10).std(); raw=-resid.div(vol,axis=0)
rows=[]; sig=[]
