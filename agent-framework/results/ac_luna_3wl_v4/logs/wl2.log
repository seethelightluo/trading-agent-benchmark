um().sum()/f.size,'turnover_proxy',np.mean(turnover),'decay:')\nfor h in [1,3,5,10]:\n ff=px.shift(-h)/px-1; vals=[]\n for dt in f.index:\n  z=pd.concat([f.loc[dt],ff.loc[dt]],axis=1).dropna()\n  if len(z)>=8: vals.append(z.iloc[:,0].rank().corr(z.iloc[:,1],method='spearman'))\n print(h,len(vals),np.mean(vals),np.mean(vals)/np.std(vals,ddof=1))\n# artifact full signal for audit\nout=f.reset_index().melt(id_vars='date',var_name='symbol',value_name='signal').dropna()\nout.to_csv('../persistent/factor_signals_miner_1_20270225_return_acceleration.csv',index=False)\n", 'file_path': 'scripts/miner_1_20270225_return_acceleration.py'})
