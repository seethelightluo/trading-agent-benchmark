 import json
from pathlib import Path
import numpy as np
from alphacrafter.sim.utils import (
    register_hook, get_account_dict, get_stock_daily_data, rebalance_to_weights
)

UNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
# Current Screener ensemble; five active factors, exact normalized weights.
FACTOR_WEIGHTS = {"clv": 0.3075, "peer": 0.2362, "rev5": 0.1826,
                  "mom20": 0.1797, "rev3": 0.0940}
MIN_W, MAX_W, CADENCE = 0.015, 0.16, 10
last_decision = None


def rank_map(values):
    out = {s: 0.5 for s in UNIVERSE}
    valid = sorted((s, float(v)) for s, v in values.items() if np.isfinite(v))
    if len(valid) > 1:
        for i, (s, _) in enumerate(valid):
            out[s] = (i + 1.0) / len(valid)
    return out


def capped_simplex(raw):
    # Floors/caps preserve diversification in the 15-name cross-asset universe.
    w = {s: min(MAX_W, max(MIN_W, float(raw.get(s, MIN_W)))) for s in UNIVERSE}
    for _ in range(200):
        err = 1.0 - sum(w.values())
        if abs(err) < 1e-10:
            break
        free = [s for s in UNIVERSE if MIN_W + 1e-9 < w[s] < MAX_W - 1e-9]
        if not free:
            break
        for s in free:
            w[s] = min(MAX_W, max(MIN_W, w[s] + err / len(free)))
    total = sum(w.values())
    return {s: w[s] / total for s in UNIVERSE}


@register_hook
def cross_asset_strategy():
    global last_decision
    account = get_account_dict()
    data = {}
    for symbol in UNIVERSE:
        df = get_stock_daily_data(symbol=symbol, days=100)
        if df is None or len(df) < 30:
            continue
        df = df.sort_values("date").reset_index(drop=True)
        c = np.asarray(df["close"], dtype=float)
        h = np.asarray(df["high"], dtype=float)
        lo = np.asarray(df["low"], dtype=float)
        r = c[1:] / np.maximum(c[:-1], 1e-12) - 1.0
        data[symbol] = (c, h, lo, r, str(df.iloc[-1]["date"]))
    if len(data) < 12:
        return
    decision_date = max(v[4] for v in data.values())
    if last_decision is not None:
        try:
            days = (np.datetime64(decision_date, "D") - np.datetime64(last_decision, "D")) / np.timedelta64(1, "D")
            if days < CADENCE:
                return
        except Exception:
            return

    clv, peer, rev5, mom20, rev3, invvol = {}, {}, {}, {}, {}, {}
    five_day_returns = {}
    for s, (c, h, lo, r, _) in data.items():
        if len(r) < 22:
            continue
        five_day_returns[s] = c[-1] / max(c[-6], 1e-12) - 1.0
        day_range = max(h[-1] - lo[-1], 1e-12)
        clv[s] = (2.0 * c[-1] - h[-1] - lo[-1]) / day_range
        rev5[s] = -float(np.mean(r[-5:]))
        rev3[s] = -float(np.mean(r[-3:]))
        vol = max(float(np.std(r[-20:])), 0.008)
        mom20[s] = (c[-1] / max(c[-21], 1e-12) - 1.0) / vol
        invvol[s] = 1.0 / vol
    med = float(np.median(list(five_day_returns.values())))
    peer = {s: v - med for s, v in five_day_returns.items()}
    ranked = {k: rank_map(v) for k, v in (("clv", clv), ("peer", peer),
             ("rev5", rev5), ("mom20", mom20), ("rev3", rev3))}
    score = {s: sum(FACTOR_WEIGHTS[k] * ranked[k][s] for k in FACTOR_WEIGHTS) for s in UNIVERSE}

    # High-volatility sideways/bearish regime: full investment, defensive tilt.
    bearish = False
    if "SPX" in data:
        spx = data["SPX"][0]
        bearish = bool(spx[-1] < spx[-6] or spx[-1] < spx[-21])
    if bearish:
        for s in ("XAU", "US10Y", "CN10Y"):
            score[s] += 0.12
        for s in ("BTC", "ETH", "WTI"):
            score[s] = max(0.05, score[s] - 0.07)

    avg_iv = float(np.mean(list(invvol.values()))) if invvol else 1.0
    raw = {s: max(0.01, score[s]) * (0.78 + 0.22 * invvol.get(s, avg_iv) / avg_iv)
           for s in UNIVERSE}
    weights = capped_simplex(raw)
    vals = np.array([score[s] for s in UNIVERSE], dtype=float)
    sd = max(float(vals.std()), 1e-9)
    forecast = {s: float(0.01 * (score[s] - vals.mean()) / sd) for s in UNIVERSE}

    factor_ids = []
    try:
