int(name,'dates',len(aa),'IC',round(np.mean(aa),6) if aa else None,'ICIR',round(np.mean(aa)/np.std(aa,ddof=1),6) if len(aa)>1 else None)\n# Save signal artifact for audit\nout=sig.copy();out.index.name='date';out.to_csv('../persistent/factor_signals_miner_2_20270225_defensive_overlay.csv')\n", 'file_path': 'scripts/miner_2_20270225_defensive_overlay.py'})
