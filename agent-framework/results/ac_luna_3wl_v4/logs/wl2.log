  ▶️ write_file({'content': 'import json\nfrom pathlib import Path\nimport numpy as np\nfrom alphacrafter.sim.utils import register_hook, get_account_dict, get_stock_daily_data, rebalance_to_weights\n\nUNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]\nFACTORS = {"clv": .30, "peer": .25, "reversal": .20, "momentum": .17, "intraday": .08}\nMIN_W, MAX_W, CADENCE = .015, .16, 10\nlast_decision = None\n\n\ndef rank(x):\n    out = {s: .5 for s in UNIVERSE}\n    valid = sorted((s, float(v)) for s, v in x.items() if np.isfinite(v))\n    n = len(valid)\n    if n > 1:\n        for i, (s, _) in enumerate(valid):\n            out[s] = (i + 1.) / n\n    return out\n\n\ndef project(raw):\n    # Iterative box/simplex projection: complete, long-only allocation.\n    w = {s: max(0., float(raw.get(s, 0.))) for s in UNIVERSE}\n    for _ in range(50):\n        free = [s for s in UNIVERSE if MIN_W < w[s] < MAX_W]\n        fixed = [s for s in UNIVERSE if s not in free]\n        for s in fixed:\n            w[s] = min(MAX_W, max(MIN_W, w[s]))\n        rem = 1. - sum(w[s] for s in fixed)\n        if not free:\n            break\n        base = sum(max(w[s], 1e-9) for s in free)\n        nw = {s: rem * max(w[s], 1e-9) / base for s in free}\n        if all(MIN_W <= nw[s] <= MAX_W for s in free):\n            w.update(nw)\n            break\n        w.update(nw)\n    # A final normalization is safe and keeps numerical sum exactly one.\n    z = sum(w.values())\n    return {s: w[s] / z for s in UNIVERSE}\n\n\n@register_hook\ndef cross_asset_strategy():\n    global last_decision\n    account = get_account_dict()\n    data = {}\n    for s in UNIVERSE:\n        df = get_stock_daily_data(symbol=s, days=90)\n        if df is None or len(df) < 30:\n            continue\n        df = df.sort_values("date").reset_index(drop=True)\n        c = np.asarray(df.close, dtype=float)\n        h = np.asarray(df.high, dtype=float)\n        l = np.asarray(df.low, dtype=float)\n        r = c[1:] / np.maximum(c[:-1], 1e-12) - 1.\n        data[s] = (c, h, l, r, str(df.iloc[-1].date))\n    if len(data) < 12:\n        return\n    date = max(v[4] for v in data.values())\n    if last_decision is not None:\n        try:\n            elapsed = (np.datetime64(date, "D") - np.datetime64(last_decision, "D")) / np.timedelta64(1, "D")\n            if elapsed < CADENCE:\n                return\n        except Exception:\n            return\n\n    clv, peer, reversal, momentum, intraday, invvol, five = {}, {}, {}, {}, {}, {}, {}\n    for s, (c, h, l, r, _) in data.items():\n        if len(r) < 22:\n            continue\n        clv[s] = float(np.mean((2*c[-3:] - h[-3:] - l[-3:]) / np.maximum(h[-3:] - l[-3:], 1e-12)))\n        five[s] = float(c[-1] / max(c[-6], 1e-12) - 1.)\n        reversal[s] = -float(np.mean(r[-5:]))\n        intraday[s] = -float(r[-1])\n        vol = max(float(np.std(r[-20:])), .008)\n        invvol[s] = 1. / vol\n        momentum[s] = float((c[-1] / max(c[-21], 1e-12) - 1.) / (vol + .01))\n    med = float(np.median(list(five.values())))\n    peer = {s: v - med for s, v in five.items()}\n    ranked = {k: rank(v) for k, v in (("clv", clv), ("peer", peer), ("reversal", reversal), ("momentum", momentum), ("intraday", intraday))}\n    score = {s: sum(FACTORS[k] * ranked[k][s] for k in FACTORS) for s in UNIVERSE}\n\n    # Sideways-to-bearish assessment: rotate risk toward tradable defensives.\n    if "SPX" in data:\n        c = data["SPX"][0]\n        if c[-1] < c[-21] and c[-1] < c[-6]:\n            for s in ("XAU", "US10Y", "CN10Y"):\n                score[s] += .18\n            for s in ("BTC", "ETH", "WTI"):\n                score[s] = max(.05, score[s] - .10)\n    avg_iv = float(np.mean(list(invvol.values()))) if invvol else 1.\n    raw = {s: max(.01, score[s]) * (.78 + .22 * invvol.get(s, avg_iv) / max(avg_iv, 1e-12)) for s in UNIVERSE}\n    weights = project(raw)\n    vals = np.array([score[s] for s in UNIVERSE], dtype=float)\n    sd = max(float(vals.std()), 1e-12)\n    forecast = {s: .01 * (score[s] - float(vals.mean())) / sd for s in UNIVERSE}\n\n    factor_ids = []\n    try:\n        p = Path(__file__).parent / "factors" / "factor_ensemble.json"\n        obj = json.loads(p.read_text(encoding="utf-8"))\n        factor_ids = [str(x.get("factor_id")) for x in obj.get("selected_factors", []) if isinstance(x, dict) and x.get("factor_id")]\n    except (OSError, ValueError, TypeError):\n        pass\n    rebalance_to_weights(weights, forecast_returns=forecast, factor_ids=factor_ids[:10], horizon_days=10)\n    last_decision = date\n', 'file_path': 'strategy.py'})
