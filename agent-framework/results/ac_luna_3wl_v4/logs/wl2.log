  if len(z)>=8 and z.iloc[:,0].nunique()>1:q.append(z.iloc[:,0].corr(z.iloc[:,1],method='spearman'))
 q=np.array(q);print(lo, len(q), np.mean(q) if len(q) else np.nan, np.mean(q)/np.std(q,ddof=1) if len(q)>1 else np.nan)
