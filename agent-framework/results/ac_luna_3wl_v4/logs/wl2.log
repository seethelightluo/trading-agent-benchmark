nover\n ranks=fac.rank(axis=1,pct=True); turn=ranks.diff().abs().mean(axis=1).mean(); print('turnover',turn)\n out=fac.stack().rename('signal').reset_index();out.columns=['date','symbol','signal'];out.to_csv('../persistent/factor_signals_miner_1_20270225_'+name+'.csv',index=False)\n", 'file_path': 'scripts/miner_1_20270225_yield_residual_explore.py'})
