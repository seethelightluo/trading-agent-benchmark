es',len(z),'IC',np.nanmean(z),'ICIR',np.nanmean(z)/np.nanstd(z,ddof=1),'names',np.mean(n))\n# artifacts\nout=pd.DataFrame(f); out.index.name='date';out.to_csv('../persistent/factor_signals_miner_1_20270225_vix_shock_resilience.csv')\n", 'file_path': 'scripts/miner_1_20270225_vix_shock_resilience.py'})
