  ▶️ write_file({'content': "import pandas as pd, numpy as np\nfrom scipy.stats import spearmanr\nU=['000300.SH','SPX','HSI','N225','SX5E','000688.SH','SOX','NDX','XAU','COPPER','WTI','BTC','ETH','US10Y','CN10Y']\np={s:pd.read_csv('../persistent/stock_data/'+s+'.csv',parse_dates=['date']).set_index('date').close for s in U}\np=pd.DataFrame(p).sort_index(); r=p.pct_change(); m=r.median(axis=1)\n# residualized short-horizon reversal vs rolling market beta; all inputs through date t\nfor L in [3,5,10]:\n  beta=pd.DataFrame(index=p.index,columns=U,dtype=float)\n  for s in U: beta[s]=r[s].rolling(60,min_periods=40).cov(m)/m.rolling(60,min_periods=40).var()\n  asset=r.rolling(L).sum(); market=m.rolling(L).sum()\n  f=-(asset-beta.mul(market,axis=0))\n  for h in [1,5,10]:\n    qs=[]; ns=[]; ranks=[]; prev=None\n    for i in range(65,len(p)-h):\n      z=pd.concat([f.iloc[i],p.iloc[i+h]/p.iloc[i]-1],axis=1).dropna()\n      if len(z)>=8 and z.iloc[:,0].nunique()>1:\n       q=spearmanr(z.iloc[:,0],z.iloc[:,1]).statistic; qs.append(q);ns.append(len(z))\n       ranks.append(z.iloc[:,0].rank(pct=True))\n    q=np.array(qs); turn=np.nan\n    if len(ranks)>1: turn=np.nanmean([np.mean(np.abs(ranks[j]-ranks[j-1])) for j in range(1,len(ranks))])\n    print('L',L,'h',h,'dates',len(q),'avg_names',round(np.mean(ns),2),'IC',round(q.mean(),6),'ICIR',round(q.mean()/q.std(ddof=1),6),'hit',round(np.mean(q>0),4),'turn',round(turn,4))\n    for a,b in [(2020,2022),(2023,2024),(2025,2026)]:\n      z=[]\n      for i in range(65,len(p)-h):\n       if a<=p.index[i].year<=b:\n        x=pd.concat([f.iloc[i],p.iloc[i+h]/p.iloc[i]-1],axis=1).dropna()\n        if len(x)>=8:z.append(spearmanr(x.iloc[:,0],x.iloc[:,1]).statistic)\n      print(' regime',a,b,'n',len(z),'ICIR',round(np.mean(z)/np.std(z,ddof=1),4) if len(z)>1 else None)\nprint('dates',len(p),'instruments',len(U))\n", 'file_path': 'scripts/miner_1_20261119_beta_residual_reversal.py'})
