    y=p[a].iloc[ix+h]/p[a].iloc[ix]-1
    if np.isfinite(y): fac.append(f); fwd.append(y)
  if len(fac)>=8: rows.append((dt,h,spearmanr(fac,fwd).statistic,len(fac)))
