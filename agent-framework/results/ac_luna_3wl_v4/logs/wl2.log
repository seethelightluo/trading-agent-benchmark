 import json
from pathlib import Path
import numpy as np
from alphacrafter.sim.utils import register_hook, get_account_dict, get_stock_daily_data, rebalance_to_weights

UNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
# Current Screener ensemble; no more than 10 live factors.
FACTOR_WEIGHTS = {"clv": .30, "peer": .23, "mom20": .20, "rev5": .17, "rev3": .10}
MIN_W, MAX_W, CADENCE = .02, .14, 10
last_decision = None

def xrank(values):
    out = {s: .5 for s in UNIVERSE}
    good = sorted((s, float(v)) for s, v in values.items() if np.isfinite(v))
    if len(good) > 1:
        for i, (s, _) in enumerate(good): out[s] = (i + 1.) / len(good)
    return out

def bounded(raw):
    w = {s: min(MAX_W, max(MIN_W, float(raw.get(s, MIN_W)))) for s in UNIVERSE}
    # Iterative water filling preserves both bounds and full investment.
    for _ in range(50):
        gap = 1. - sum(w.values())
        free = [s for s in UNIVERSE if MIN_W < w[s] < MAX_W]
        if abs(gap) < 1e-11 or not free: break
        for s in free: w[s] = min(MAX_W, max(MIN_W, w[s] + gap / len(free)))
    total = sum(w.values())
    return {s: w[s] / total for s in UNIVERSE}

@register_hook
def cross_asset_strategy():
    global last_decision
    account = get_account_dict()
    data = {}
    for s in UNIVERSE:
        df = get_stock_daily_data(symbol=s, days=110)
        if df is None or len(df) < 30: continue
        df = df.sort_values("date").reset_index(drop=True)
        c = np.asarray(df.close, float); h = np.asarray(df.high, float); lo = np.asarray(df.low, float)
        r = c[1:] / np.maximum(c[:-1], 1e-12) - 1.
        data[s] = (c, h, lo, r, str(df.iloc[-1].date))
    if len(data) < 12: return
    date = max(v[4] for v in data.values())
    if last_decision is not None:
        try:
            if (np.datetime64(date, 'D') - np.datetime64(last_decision, 'D')) / np.timedelta64(1, 'D') < CADENCE: return
        except Exception: return

    f = {k: {} for k in FACTOR_WEIGHTS}; iv = {}; peer_raw = {}
    for s, (c, h, lo, r, _) in data.items():
        if len(r) < 22: continue
        vol = max(float(np.std(r[-20:])), .008)
        iv[s] = 1. / vol
        # Three completed bars smooth the high-turnover CLV signal.
        clv = (2*c[-3:] - h[-3:] - lo[-3:]) / np.maximum(h[-3:] - lo[-3:], 1e-12)
        f['clv'][s] = float(np.mean(clv))
        peer_raw[s] = c[-1] / max(c[-6], 1e-12) - 1.
        f['mom20'][s] = (c[-1] / max(c[-21], 1e-12) - 1.) / vol
        f['rev5'][s] = -float(np.mean(r[-5:]))
        f['rev3'][s] = -float(np.mean(r[-3:]))
    med = float(np.median(list(peer_raw.values())))
    f['peer'] = {s: v - med for s, v in peer_raw.items()}
    ranks = {k: xrank(v) for k, v in f.items()}
    score = {s: sum(FACTOR_WEIGHTS[k] * ranks[k][s] for k in FACTOR_WEIGHTS) for s in UNIVERSE}

    # Bullish/moderate regime: retain broad participation. In a confirmed break,
    # rotate fully invested exposure toward the three defensive tradable assets.
    bearish = False
    if 'SPX' in data:
        c = data['SPX'][0]
        bearish = c[-1] < c[-6] and c[-1] < c[-21]
    if bearish:
        for s in ('XAU', 'US10Y', 'CN10Y'): score[s] += .14
        for s in ('BTC', 'ETH', 'WTI'): score[s] = max(.05, score[s] - .08)

    avg_iv = float(np.mean(list(iv.values()))) if iv else 1.
    # 75% signal / 25% inverse-vol: dampens medium-high risk without cash.
    raw = {s: max(.01, score[s]) * (.75 + .25 * iv.get(s, avg_iv) / avg_iv) for s in UNIVERSE}
    weights = bounded(raw)
    arr = np.asarray([score[s] for s in UNIVERSE]); sd = max(float(arr.std()), 1e-9)
    forecast = {s: float(.01 * (score[s] - arr.mean()) / sd) for s in UNIVERSE}
    try:
        obj = json.loads((Path(__file__).parent / 'factors/factor_ensemble.json').read_text())
        ids = [x['factor_id'] for x in obj.get('selected_factors', []) if isinstance(x, dict) and x.get('factor_id')]
    except Exception:
        ids = []
    rebalance_to_weights(weights, forecast_returns=forecast, factor_ids=ids[:10], horizon_days=10)
    last_decision = date


