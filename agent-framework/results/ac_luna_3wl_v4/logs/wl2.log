h, lo, r, str(df.iloc[-1]["date"]))\n    if len(data) < 12:\n        return\n    decision_date = max(x[5] for x in data.values())\n    if last_decision is not None:\n        try:\n            elapsed = (np.datetime64(decision_date, "D") - np.datetime64(last_decision, "D")) / np.timedelta64(1, "D")\n            if elapsed < CADENCE_DAYS:\n                return\n        except Exception:\n            return\n\n    clv, peer, mom20, rev5, shortrev3, invvol = ({}, {}, {}, {}, {}, {})\n    five = {}\n    for s, (c, o, h, lo, r, _) in data.items():\n        if len(r) < 22:\n            continue\n        vol = max(float(np.std(r[-20:])), .008)\n        invvol[s] = 1.0 / vol\n        five[s] = c[-1] / max(c[-6], 1e-12) - 1.0\n        # Smoothed CLV uses the last three completed bars to reduce turnover.\n        locs = (2*c[-3:] - h[-3:] - lo[-3:]) / np.maximum(h[-3:] - lo[-3:], 1e-12)\n        clv[s] = float(np.mean(locs))\n        rev5[s] = -float(np.mean(r[-5:]))\n        shortrev3[s] = -float(np.mean(r[-3:]))\n        mom20[s] = (c[-1] / max(c[-21], 1e-12) - 1.0) / vol\n    med = float(np.median(list(five.values())))\n    peer = {s: v - med for s, v in five.items()}\n    raw = {"clv": clv, "peer": peer, "mom20": mom20, "rev5": rev5, "shortrev3": shortrev3}\n    ranked = {k: rank(v) for k, v in raw.items()}\n    score = {s: sum(FACTOR_WEIGHTS[k] * ranked[k][s] for k in FACTOR_WEIGHTS) for s in UNIVERSE}\n\n    # Medium-high risk: confirm weakness with both short and intermediate SPX trend.\n    bearish = False\n    if "SPX" in data:\n        spx = data["SPX"][0]\n        bearish = spx[-1] < spx[-6] and spx[-1] < spx[-21]\n    if bearish:\n        for s in ("XAU", "US10Y", "CN10Y"):\n            score[s] += .14\n        for s in ("BTC", "ETH", "WTI"):\n            score[s] = max(.05, score[s] - .08)\n\n    # 75% factor score / 25% inverse volatility: fully invested, no cash sleeve.\n    avg_inv = float(np.mean(list(invvol.values()))) if invvol else 1.0\n    raw_weight = {s: max(.01, score[s]) * (.75 + .25 * invvol.get(s, avg_inv) / avg_inv) for s in UNIVERSE}\n    weights = bounded_simplex(raw_weight)\n    scores = np.asarray([score[s] for s in UNIVERSE], float)\n    sd = max(float(scores.std()), 1e-9)\n    forecast = {s: float(.01 * (score[s] - scores.mean()) / sd) for s in UNIVERSE}\n\n    factor_ids = []\n    try:\n        ensemble = json.loads((Path(__file__).parent / "factors" / "factor_ensemble.json").read_text(encoding="utf-8"))\n        factor_ids = [x["factor_id"] for x in ensemble.get("selected_factors", [])\n                      if isinstance(x, dict) and x.get("factor_id")]\n    except Exception:\n        pass\n    rebalance_to_weights(weights, forecast_returns=forecast, factor_ids=factor_ids[:10], horizon_days=10)\n    last_decision = decision_date\n', 'file_path': 'strategy.py'})
