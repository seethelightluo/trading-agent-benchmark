  ▶️ write_file({'content': "import pandas as pd,numpy as np\nfrom scipy.stats import spearmanr\nA=['000300.SH','SPX','HSI','N225','SX5E','000688.SH','SOX','NDX','XAU','COPPER','WTI','BTC','ETH','US10Y','CN10Y']\np={a:pd.read_csv('../persistent/stock_data/'+a+'.csv',parse_dates=['date']).sort_values('date').set_index('date')['close'] for a in A}; r={a:p[a].pct_change() for a in A}\n# Trend persistence: fraction of positive sessions in trailing 20 days, centered cross-sectionally.\nraw={a:r[a].gt(0).rolling(20,min_periods=15).mean() for a in A}\nidx=sorted(set().union(*[set(p[a].index) for a in A])); rows=[]; sig=[]\nfor d in idx:\n v={a:raw[a].get(d,np.nan) for a in A}; good=[x for x in v.values() if np.isfinite(x)]\n if len(good)<8:continue\n med=np.nanmedian(good)\n for a in A:sig.append((d,a,v[a]-med if np.isfinite(v[a]) else np.nan))\n for h in [1,5,10]:\n  f=[];y=[]\n  for a in A:\n   if d not in p[a].index:continue\n   i=p[a].index.get_loc(d);z=v[a]-med\n   if np.isfinite(z) and i+h<len(p[a]):f.append(z);y.append(p[a].iloc[i+h]/p[a].iloc[i]-1)\n  if len(f)>=8:rows.append((d,h,spearmanr(f,y).statistic,len(f)))\ndf=pd.DataFrame(rows,columns=['date','h','ic','n'])\nfor h in [1,5,10]:\n x=df[df.h==h];print('H',h,'dates',len(x),'avg_n',round(x.n.mean(),2),'IC',round(x.ic.mean(),6),'ICIR',round(x.ic.mean()/x.ic.std(),6),'hit',round((x.ic>0).mean(),4))\n for lo,hi in [('2020','2022'),('2023','2024'),('2025','2026'),('2026-07','2027')]:\n  z=x.set_index('date').loc[lo:hi].ic;print(lo,len(z),round(z.mean(),6),round(z.mean()/z.std(),6) if len(z)>1 else np.nan)\nw=pd.DataFrame(sig,columns=['date','asset','signal']);w.to_csv('../persistent/factor_signals_miner_2_20270225_persistence.csv',index=False);q=w.pivot(index='date',columns='asset',values='signal');print('turnover',round(q.rank(axis=1,pct=True).diff().abs().mean(axis=1).mean(),6))\n", 'file_path': 'scripts/miner_2_20270225_trend_persistence.py'})
