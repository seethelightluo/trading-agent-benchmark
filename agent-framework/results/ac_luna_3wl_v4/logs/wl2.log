 import json
from pathlib import Path
import numpy as np
from alphacrafter.sim.utils import register_hook, get_account_dict, get_stock_daily_data, rebalance_to_weights

UNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
FACTOR_WEIGHTS = {"clv": .28, "peer": .24, "mom20": .28, "range_rev": .08, "idio_rev": .07, "rev5": .05}
MIN_W, MAX_W, CADENCE = .02, .14, 10
last_decision = None

def xrank(values):
    good = {s: float(v) for s, v in values.items() if np.isfinite(v)}
    if len(good) < 2: return {s: .5 for s in UNIVERSE}
    a = np.asarray(list(good.values()))
    lo, hi = np.quantile(a, [.05, .95])
    clipped = {s: min(hi, max(lo, v)) for s, v in good.items()}
    order = sorted(clipped, key=clipped.get)
    out = {s: .5 for s in UNIVERSE}
    for i, s in enumerate(order): out[s] = (i + 1.) / len(order)
    return out

def bounded(raw):
    w = {s: min(MAX_W, max(MIN_W, float(raw.get(s, MIN_W)))) for s in UNIVERSE}
    for _ in range(100):
        gap = 1.0 - sum(w.values())
        free = [s for s in UNIVERSE if MIN_W < w[s] < MAX_W]
        if abs(gap) < 1e-10 or not free: break
        for s in free: w[s] = min(MAX_W, max(MIN_W, w[s] + gap / len(free)))
    total = sum(w.values())
    return {s: w[s] / total for s in UNIVERSE}

@register_hook
def cross_asset_strategy():
    global last_decision
    account = get_account_dict()
    data = {}
    for s in UNIVERSE:
        df = get_stock_daily_data(symbol=s, days=130)
        if df is None or len(df) < 35: continue
        df = df.sort_values("date").reset_index(drop=True)
        c, h, lo = [np.asarray(df[x], float) for x in ("close", "high", "low")]
        r = c[1:] / np.maximum(c[:-1], 1e-12) - 1.
        data[s] = (c, h, lo, r, str(df.iloc[-1]["date"]))
    if len(data) < 12: return
    decision_date = max(v[4] for v in data.values())
    if last_decision is not None and (np.datetime64(decision_date, "D") - np.datetime64(last_decision, "D")) / np.timedelta64(1, "D") < CADENCE: return
    f = {k: {} for k in FACTOR_WEIGHTS}; invvol = {}; short = {}
    for s, (c, h, lo, r, _) in data.items():
        if len(r) < 25: continue
        vol = max(float(np.std(r[-20:])), .008); invvol[s] = 1. / vol
        spread = np.maximum(h[-5:] - lo[-5:], 1e-12)
        f["clv"][s] = float(np.mean((2*c[-5:] - h[-5:] - lo[-5:]) / spread))
        short[s] = c[-1] / max(c[-6], 1e-12) - 1.
        f["mom20"][s] = (c[-1] / max(c[-21], 1e-12) - 1.) / vol
        f["range_rev"][s] = -float((c[-1] - lo[-6:].min()) / max(h[-6:].max() - lo[-6:].min(), 1e-12))
        f["idio_rev"][s] = -float(np.mean(r[-2:])); f["rev5"][s] = -float(np.mean(r[-5:]))
    if len(invvol) < 12: return
    med = float(np.median(list(short.values()))); f["peer"] = {s: v-med for s, v in short.items()}
    ranks = {k: xrank(v) for k, v in f.items()}
    score = {s: sum(FACTOR_WEIGHTS[k] * ranks[k][s] for k in FACTOR_WEIGHTS) for s in UNIVERSE}
    # Confirmed bear overlay: remain fully invested, rotating to defensive tradable assets.
    if "SPX" in data:
        c = data["SPX"][0]; bear = c[-1] < c[-6] and c[-1] < c[-21]
        confirmed = bear and c[-1] < c[-31]
        if bear:
            bump = .16 if not confirmed else .22
            for s in ("XAU", "US10Y", "CN10Y"): score[s] += bump
            for s in ("BTC", "ETH", "WTI"): score[s] = max(.05, score[s] - .75*bump)
    avg_iv = float(np.mean(list(invvol.values())))
    raw = {s: max(.02, score[s]) * (.70 + .30*invvol.get(s, avg_iv)/avg_iv) for s in UNIVERSE}
    weights = bounded(raw)
    a = np.asarray(list(score.values())); sd = max(float(a.std()), 1e-9)
    forecast = {s: float(.01*(score[s]-a.mean())/sd) for s in UNIVERSE}
    try:
        ens = json.loads((Path(__file__).parent / "factors/factor_ensemble.json").read_text())
        ids = [x["factor_id"] for x in ens.get("selected_factors", []) if isinstance(x, dict)]
    except Exception: ids = []
    rebalance_to_weights(weights, forecast_returns=forecast, factor_ids=ids[:10], horizon_days=10)
    last_decision = decision_date


