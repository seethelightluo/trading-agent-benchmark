 import json
from pathlib import Path
import numpy as np
from alphacrafter.sim.utils import register_hook, get_account_dict, get_stock_daily_data, rebalance_to_weights

UNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
# Screener's five validated active factors; quarantine factors excluded.
FACTOR_WEIGHTS = {"clv": .337, "peer": .259, "mom20": .197, "rev3": .103, "rev5": .104}
MIN_W, MAX_W, CADENCE = .02, .14, 10
last_decision = None

def xrank(values):
    out = {s: .5 for s in UNIVERSE}
    good = sorted((s, float(v)) for s, v in values.items() if np.isfinite(v))
    n = len(good)
    if n > 1:
        for i, (s, _) in enumerate(good):
            out[s] = (i + 1.) / n
    return out

def bounded(raw):
    # Water-fill between sensible cross-asset concentration limits.
    w = {s: min(MAX_W, max(MIN_W, float(raw.get(s, MIN_W)))) for s in UNIVERSE}
    for _ in range(60):
        gap = 1. - sum(w.values())
        free = [s for s in UNIVERSE if MIN_W < w[s] < MAX_W]
        if abs(gap) < 1e-11 or not free:
            break
        for s in free:
            w[s] = min(MAX_W, max(MIN_W, w[s] + gap / len(free)))
    total = sum(w.values())
    return {s: w[s] / total for s in UNIVERSE}

@register_hook
def cross_asset_strategy():
    global last_decision
    account = get_account_dict()
    data = {}
    for symbol in UNIVERSE:
        df = get_stock_daily_data(symbol=symbol, days=110)
        if df is None or len(df) < 30:
            continue
        df = df.sort_values("date").reset_index(drop=True)
        c = np.asarray(df["close"], float)
        h = np.asarray(df["high"], float)
        lo = np.asarray(df["low"], float)
        r = c[1:] / np.maximum(c[:-1], 1e-12) - 1.
        data[symbol] = (c, h, lo, r, str(df.iloc[-1]["date"]))
    if len(data) < 12:
        return
    decision_date = max(v[4] for v in data.values())
    if last_decision is not None:
        try:
            elapsed = (np.datetime64(decision_date, "D") - np.datetime64(last_decision, "D")) / np.timedelta64(1, "D")
            if elapsed < CADENCE:
                return
        except Exception:
            return

    factors = {name: {} for name in FACTOR_WEIGHTS}
    invvol, peer = {}, {}
    for symbol, (c, h, lo, r, _) in data.items():
        if len(r) < 22:
            continue
        vol = max(float(np.std(r[-20:])), .008)
        invvol[symbol] = 1. / vol
        # Smoothed CLV uses only completed bars exposed by the simulator.
        spread = np.maximum(h[-3:] - lo[-3:], 1e-12)
        factors["clv"][symbol] = float(np.mean((2*c[-3:] - h[-3:] - lo[-3:]) / spread))
        peer[symbol] = c[-1] / max(c[-6], 1e-12) - 1.
        factors["mom20"][symbol] = (c[-1] / max(c[-21], 1e-12) - 1.) / vol
        factors["rev3"][symbol] = -float(np.mean(r[-3:]))
        factors["rev5"][symbol] = -float(np.mean(r[-5:]))
    if not peer:
        return
    peer_median = float(np.median(list(peer.values())))
    factors["peer"] = {s: v - peer_median for s, v in peer.items()}
    ranks = {name: xrank(values) for name, values in factors.items()}
    score = {s: sum(FACTOR_WEIGHTS[k] * ranks[k][s] for k in FACTOR_WEIGHTS) for s in UNIVERSE}

    # Sideways/mildly bearish regime: defensive assets are tradable substitutes
    # for cash. A confirmed SPX break receives a stronger, deterministic tilt.
    defensive = False
    confirmed = False
    if "SPX" in data:
        c = data["SPX"][0]
        defensive = c[-1] < c[-6] and c[-1] < c[-21]
        confirmed = defensive and c[-1] < c[-31]
    if defensive:
        bump = .10 if not confirmed else .16
        for s in ("XAU", "US10Y", "CN10Y"):
            score[s] += bump
        for s in ("BTC", "ETH", "WTI"):
            score[s] = max(.05, score[s] - bump * .55)

    avg_iv = float(np.mean(list(invvol.values()))) if invvol else 1.
    # 75% composite signal / 25% inverse-vol overlay, full investment.
    raw = {s: max(.01, score[s]) * (.75 + .25 * invvol.get(s, avg_iv) / avg_iv) for s in UNIVERSE}
    weights = bounded(raw)
    score_arr = np.asarray([score[s] for s in UNIVERSE], float)
    sd = max(float(score_arr.std()), 1e-9)
    forecast = {s: float(.01 * (score[s] - score_arr.mean()) / sd) for s in UNIVERSE}
    try:
        ensemble = json.loads((Path(__file__).parent / "factors/factor_ensemble.json").read_text())
        factor_ids = [x["factor_id"] for x in ensemble.get("selected_factors", []) if isinstance(x, dict) and x.get("factor_id")]
    except Exception:
        factor_ids = []
    rebalance_to_weights(weights, forecast_returns=forecast, factor_ids=factor_ids[:10], horizon_days=10)
    last_decision = decision_date


