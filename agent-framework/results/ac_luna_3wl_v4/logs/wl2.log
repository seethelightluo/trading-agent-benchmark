e64(last_decision, \'D\')) / np.timedelta64(1, \'D\') < CADENCE: return\n        except Exception: return\n\n    f = {k: {} for k in FACTOR_WEIGHTS}; iv = {}; peer_raw = {}\n    for s, (c, h, lo, r, _) in data.items():\n        if len(r) < 22: continue\n        vol = max(float(np.std(r[-20:])), .008)\n        iv[s] = 1. / vol\n        # Three completed bars smooth the high-turnover CLV signal.\n        clv = (2*c[-3:] - h[-3:] - lo[-3:]) / np.maximum(h[-3:] - lo[-3:], 1e-12)\n        f[\'clv\'][s] = float(np.mean(clv))\n        peer_raw[s] = c[-1] / max(c[-6], 1e-12) - 1.\n        f[\'mom20\'][s] = (c[-1] / max(c[-21], 1e-12) - 1.) / vol\n        f[\'rev5\'][s] = -float(np.mean(r[-5:]))\n        f[\'rev3\'][s] = -float(np.mean(r[-3:]))\n    med = float(np.median(list(peer_raw.values())))\n    f[\'peer\'] = {s: v - med for s, v in peer_raw.items()}\n    ranks = {k: xrank(v) for k, v in f.items()}\n    score = {s: sum(FACTOR_WEIGHTS[k] * ranks[k][s] for k in FACTOR_WEIGHTS) for s in UNIVERSE}\n\n    # Bullish/moderate regime: retain broad participation. In a confirmed break,\n    # rotate fully invested exposure toward the three defensive tradable assets.\n    bearish = False\n    if \'SPX\' in data:\n        c = data[\'SPX\'][0]\n        bearish = c[-1] < c[-6] and c[-1] < c[-21]\n    if bearish:\n        for s in (\'XAU\', \'US10Y\', \'CN10Y\'): score[s] += .14\n        for s in (\'BTC\', \'ETH\', \'WTI\'): score[s] = max(.05, score[s] - .08)\n\n    avg_iv = float(np.mean(list(iv.values()))) if iv else 1.\n    # 75% signal / 25% inverse-vol: dampens medium-high risk without cash.\n    raw = {s: max(.01, score[s]) * (.75 + .25 * iv.get(s, avg_iv) / avg_iv) for s in UNIVERSE}\n    weights = bounded(raw)\n    arr = np.asarray([score[s] for s in UNIVERSE]); sd = max(float(arr.std()), 1e-9)\n    forecast = {s: float(.01 * (score[s] - arr.mean()) / sd) for s in UNIVERSE}\n    try:\n        obj = json.loads((Path(__file__).parent / \'factors/factor_ensemble.json\').read_text())\n        ids = [x[\'factor_id\'] for x in obj.get(\'selected_factors\', []) if isinstance(x, dict) and x.get(\'factor_id\')]\n    except Exception:\n        ids = []\n    rebalance_to_weights(weights, forecast_returns=forecast, factor_ids=ids[:10], horizon_days=10)\n    last_decision = date\n', 'file_path': 'strategy.py'})
