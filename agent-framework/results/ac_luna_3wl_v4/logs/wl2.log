from alphacrafter.sim.utils import get_index_daily_data,get_stock_daily_data
U=['000300.SH','SPX','HSI','N225','SX5E','000688.SH','SOX','NDX','XAU','COPPER','WTI','BTC','ETH','US10Y','CN10Y']; rows=[]
for s in U:
 d=None
 for fn in (get_index_daily_data,get_stock_daily_data):
  try:d=fn(s,1900)
  except:pass
  if d is not None and len(d):break
 if d is None:continue
 x=d[['date','close']].copy();x.date=pd.to_datetime(x.date);x=x.drop_duplicates('date').sort_values('date');r=x.close.pct_change();x['factor']=x.close.pct_change(60)/r.rolling(60,min_periods=40).std();x['fwd']=x.close.shift(-5)/x.close-1;x['symbol']=s;rows.append(x[['date','symbol','factor','fwd']])
df=pd.concat(rows);o=[]
