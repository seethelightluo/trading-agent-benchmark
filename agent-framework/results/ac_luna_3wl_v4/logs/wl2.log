ision is not None and (np.datetime64(decision_date, "D") - np.datetime64(last_decision, "D")) / np.timedelta64(1, "D") < CADENCE: return\n    f = {k: {} for k in FACTOR_WEIGHTS}; invvol = {}; short = {}\n    for s, (c, h, lo, r, _) in data.items():\n        if len(r) < 25: continue\n        vol = max(float(np.std(r[-20:])), .008); invvol[s] = 1. / vol\n        spread = np.maximum(h[-5:] - lo[-5:], 1e-12)\n        f["clv"][s] = float(np.mean((2*c[-5:] - h[-5:] - lo[-5:]) / spread))\n        short[s] = c[-1] / max(c[-6], 1e-12) - 1.\n        f["mom20"][s] = (c[-1] / max(c[-21], 1e-12) - 1.) / vol\n        f["range_rev"][s] = -float((c[-1] - lo[-6:].min()) / max(h[-6:].max() - lo[-6:].min(), 1e-12))\n        f["idio_rev"][s] = -float(np.mean(r[-2:])); f["rev5"][s] = -float(np.mean(r[-5:]))\n    if len(invvol) < 12: return\n    med = float(np.median(list(short.values()))); f["peer"] = {s: v-med for s, v in short.items()}\n    ranks = {k: xrank(v) for k, v in f.items()}\n    score = {s: sum(FACTOR_WEIGHTS[k] * ranks[k][s] for k in FACTOR_WEIGHTS) for s in UNIVERSE}\n    # Confirmed bear overlay: remain fully invested, rotating to defensive tradable assets.\n    if "SPX" in data:\n        c = data["SPX"][0]; bear = c[-1] < c[-6] and c[-1] < c[-21]\n        confirmed = bear and c[-1] < c[-31]\n        if bear:\n            bump = .16 if not confirmed else .22\n            for s in ("XAU", "US10Y", "CN10Y"): score[s] += bump\n            for s in ("BTC", "ETH", "WTI"): score[s] = max(.05, score[s] - .75*bump)\n    avg_iv = float(np.mean(list(invvol.values())))\n    raw = {s: max(.02, score[s]) * (.70 + .30*invvol.get(s, avg_iv)/avg_iv) for s in UNIVERSE}\n    weights = bounded(raw)\n    a = np.asarray(list(score.values())); sd = max(float(a.std()), 1e-9)\n    forecast = {s: float(.01*(score[s]-a.mean())/sd) for s in UNIVERSE}\n    try:\n        ens = json.loads((Path(__file__).parent / "factors/factor_ensemble.json").read_text())\n        ids = [x["factor_id"] for x in ens.get("selected_factors", []) if isinstance(x, dict)]\n    except Exception: ids = []\n    rebalance_to_weights(weights, forecast_returns=forecast, factor_ids=ids[:10], horizon_days=10)\n    last_decision = decision_date\n', 'file_path': 'strategy.py'})
