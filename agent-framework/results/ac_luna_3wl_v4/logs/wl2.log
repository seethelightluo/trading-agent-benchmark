  f=-resid.rolling(w,min_periods=w).sum(); y=p.shift(-1)/p-1
  rows += [(dt,s,float(f.loc[dt]),float(y.loc[dt])) for dt in p.index if pd.notna(f.loc[dt]) and pd.notna(y.loc[dt])]
