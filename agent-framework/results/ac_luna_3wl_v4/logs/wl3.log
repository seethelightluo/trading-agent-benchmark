 z=np.array(z);ds=pd.DatetimeIndex(ds); sd=z.std(ddof=1)
 print(f'h={h} dates={len(z)} meanN={np.mean(ns):.2f} IC={z.mean():.6f} ICIR={z.mean()/sd:.6f} hit={(z>0).mean():.4f}')
