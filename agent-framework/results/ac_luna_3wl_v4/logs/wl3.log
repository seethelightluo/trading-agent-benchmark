  ▶️ write_file({'content': "import numpy as np, pandas as pd\nfrom alphacrafter.sim.utils import get_index_daily_data\n\nUNIV=['000300.SH','SPX','HSI','N225','SX5E','000688.SH','SOX','NDX','XAU','COPPER','WTI','BTC','ETH','US10Y','CN10Y']\nD={}\nfor s in UNIV:\n    x=get_index_daily_data(s,days=2200)\n    if x is not None and len(x):\n        x=x.copy(); x['date']=pd.to_datetime(x['date']); x=x.set_index('date'); D[s]=x['close'].astype(float)\nP=pd.DataFrame(D).sort_index(); R=P.pct_change()\n# Candidate: volatility-normalized medium-term momentum, cross-sectionally demeaned.\n# 20d return divided by 20d realized vol; forward next-day return.\nret=P/P.shift(20)-1\nvol=R.rolling(20).std()*np.sqrt(20)\nF=ret/vol.replace(0,np.nan)\nics=[]; turnovers=[]; counts=[]; regime=[]\nfor i in range(20,len(P)-1):\n    f=F.iloc[i]; y=R.iloc[i+1]\n    z=pd.concat([f,y],axis=1).dropna()\n    if len(z)>=8:\n        ics.append(z.iloc[:,0].corr(z.iloc[:,1],method='spearman')); counts.append(len(z))\n        if i>0:\n            old=F.iloc[i-1].reindex(z.index)\n            turnovers.append(np.mean(np.sign(z.iloc[:,0])!=np.sign(old.fillna(0))))\n        regime.append((P.index[i],z.iloc[:,0].corr(z.iloc[:,1],method='spearman')))\na=np.array(ics,dtype=float); a=a[np.isfinite(a)]\nprint('candidate=vol_normalized_20d_momentum dates',len(a),'avg_names',round(float(np.mean(counts)),2),'coverage',round(float(np.sum(counts)/(len(a)*15)),4))\nprint('IC',round(float(a.mean()),6),'ICIR',round(float(a.mean()/a.std()),6),'hit',round(float(np.mean(a>0)),4),'turnover',round(float(np.nanmean(turnovers)),4))\nfor lo,hi in [('2020','2022'),('2023','2024'),('2025','2027')]:\n q=np.array([v for d,v in regime if str(d)[:4]>=lo and str(d)[:4]<=hi]); print(lo+'-'+hi,'n',len(q),'ic',round(float(np.nanmean(q)),6) if len(q) else None)\nprint('decay')\nfor h in [1,5,10]:\n z=[]\n for i in range(20,len(P)-h):\n  a1=F.iloc[i]; y=P.iloc[i+h]/P.iloc[i]-1; q=pd.concat([a1,y],axis=1).dropna()\n  if len(q)>=8:z.append