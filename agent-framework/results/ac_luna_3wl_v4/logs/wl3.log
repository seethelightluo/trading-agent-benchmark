float(np.mean(np.array(ics)>0)),'turnover':float(np.mean(turns))},indent=2))\nfor name,mask in [('2020-22',(pd.Series([x[0] for x in rows])<'2023-01-01')),('2023-24',(pd.Series([x[0] for x in rows])>='2023-01-01')&(pd.Series([x[0] for x in rows])<'2025-01-01')),('2025-27',(pd.Series([x[0] for x in rows])>='2025-01-01'))]:\n z=np.array(ics)[mask.values]; print(name, 'n',len(z),'ic',float(np.mean(z)) if len(z) else None,'icir',float(np.mean(z)/np.std(z,ddof=1)*np.sqrt(len(z))) if len(z)>1 else None)\nos.makedirs('scripts',exist_ok=True)\nout=fac.copy(); out.index=out.index.strftime('%Y-%m-%d'); out.reset_index().rename(columns={'index':'date'}).to_csv('scripts/miner_1_20270325_residual_5d_reversal_signal.csv',index=False)\n", 'file_path': 'scripts/miner_1_20270325_residual_5d_reversal.py'})
