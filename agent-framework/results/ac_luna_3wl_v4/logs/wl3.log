  ▶️ write_file({'content': 'import json\nfrom pathlib import Path\nimport numpy as np\nfrom alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights\n\nUNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]\nW = {"clv": 0.3395, "peer": 0.2612, "reversal": 0.2012, "momentum": 0.1981}\nMIN_W, MAX_W, CADENCE = 0.015, 0.16, 10\nlast_decision = None\nsmooth_score = None\n\ndef ranks(values):\n    valid = sorted((s, v) for s, v in values.items() if np.isfinite(v))\n    out = {s: 0.5 for s in UNIVERSE}\n    n = len(valid)\n    if n > 1:\n        for i, (s, _) in enumerate(valid): out[s] = (i + 1.0) / n\n    return out\n\ndef bounded_weights(raw):\n    # Water-fill projection, preserving a complete non-negative simplex.\n    w = {s: max(float(raw.get(s, 0.0)), 1e-8) for s in UNIVERSE}\n    free = set(UNIVERSE); fixed = {}\n    for _ in range(30):\n        rem = 1.0 - sum(fixed.values())\n        total = sum(w[s] for s in free)\n        trial = {s: rem * w[s] / max(total, 1e-12) for s in free}\n        low = [s for s in free if trial[s] < MIN_W]\n        high = [s for s in free if trial[s] > MAX_W]\n        if not low and not high:\n            fixed.update(trial); break\n        if low:\n            for s in low: fixed[s] = MIN_W; free.remove(s)\n        elif high:\n            for s in high: fixed[s] = MAX_W; free.remove(s)\n        if not free: break\n    if free:\n        rem = 1.0 - sum(fixed.values()); total = sum(w[s] for s in free)\n        fixed.update({s: rem*w[s]/max(total,1e-12) for s in free})\n    z = sum(fixed.values())\n    return {s: fixed.get(s, 0.0)/z for s in UNIVERSE}\n\n@register_hook\ndef cross_asset_strategy():\n    global last_decision, smooth_score\n    data = {}\n    for s in UNIVERSE:\n        df = get_stock_daily_data(symbol=s, days=90)\n        if df is None or len(df) < 30: continue\n        df = df.sort_values("date").reset_index(drop=True)\n        c = np.asarray(df["close"], float); h = np.asarray(df["high"], float); l = np.asarray(df["low"], float)\n        r = c[1:] / np.maximum(c[:-1], 1e-12) - 1\n        data[s] = (c, h, l, r, str(df.iloc[-1]["date"]))\n    if len(data) < 12: return\n    date = max(v[4] for v in data.values())\n    if last_decision is not None:\n        try:\n            if (np.datetime64(date)-np.datetime64(last_decision))/np.timedelta64(1,\'D\') < CADENCE: return\n        except Exception: return\n    clv={}; rev={}; mom={}; lead={}; iv={}\n    for s,(c,h,l,r,_) in data.items():\n        candle=(2*c-h-l)/np.maximum(h-l,1e-12)\n        vol=max(float(np.std(r[-20:])),0.008)\n        clv[s]=float(np.mean(candle[-5:]))\n        rev[s]=float(-np.mean(r[-5:]))\n        mom[s]=float((c[-1]/max(c[-21],1e-12)-1)/(vol+0.01))\n        lead[s]=float(c[-1]/max(c[-6],1e-12)-1)\n        iv[s]=1.0/vol\n    med=float(np.median(list(lead.values())))\n    lead={s:v-med for s,v in lead.items()}\n    rr={k:ranks(v) for k,v in [("clv",clv),("peer",lead),("reversal",rev),("momentum",mom)]}\n    score={s:sum(W[k]*rr[k][s] for k in W) for s in UNIVERSE}\n    if smooth_score is not None: score={s:0.6*smooth_score.get(s,score[s])+0.4*score[s] for s in UNIVERSE}\n    smooth_score=dict(score)\n    breadth=float(np.mean([data[s][0][-1]>data[s][0][-21] for s in data]))\n    bearish=False\n    if "SPX" in data:\n        c=data["SPX"][0]; bearish=(c[-1]<c[-21] and c[-1]<c[-6]) or breadth<0.40\n    if bearish:\n        for s in ("XAU","US10Y","CN10Y"): score[s]+=0.14\n        for s in ("BTC","ETH","WTI"): score[s]=max(0.05,score[s]-0.07)\n    mean_iv=float(np.mean(list(iv.values())))\n    raw={s:max(score[s],0.02)*(0.70+0.30*iv[s]/max(mean_iv,1e-12)) for s in UNIVERSE}\n    weights=bounded_weights(raw)\n    avg=float(np.mean(list(score.values()))); sd=max(float(np.std(list(score.values()))),1e-12)\n    forecast={s:0.01*(score[s]-avg)/sd for s in UNIVERSE}\n    ids=[]\n    try:\n        obj=json.loads((Path(__file__).parent/\'factors\'/\'factor_ensemble.json\').read_text())\n        ids=[x[\'factor_id\'] for x in obj.get(\'selected_factors\',[]) if isinstance(x,dict) and x.get(\'factor_id\')][:10]\n    except Exception: pass\n    rebalance_to_weights(weights, forecast_returns=forecast, factor_ids=ids, horizon_days=10)\n    last_decision=date\n\nif __name__ == \'__main__\': pass\n', 'file_path': 'strategy.py'})
