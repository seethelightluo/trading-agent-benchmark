  ▶️ write_file({'content': "import pandas as pd,numpy as np,glob,os\nfrom scipy.stats import spearmanr\ncut=pd.Timestamp('2027-03-24'); root='../persistent/stock_data'\nassets=[os.path.basename(x)[:-4] for x in glob.glob(root+'/*.csv')]\nprices={}\nfor a in assets:\n d=pd.read_csv(f'{root}/{a}.csv',parse_dates=['date']).sort_values('date').set_index('date')\n prices[a]=d.close.where(d.index<=cut)\npx=pd.DataFrame(prices).sort_index(); ret=px.pct_change()\n# Equal-weight cross-asset market return; beta and residual are estimated using only observations through t-1.\nmkt=ret.mean(axis=1); beta=ret.rolling(60,min_periods=30).cov(mkt).div(mkt.rolling(60,min_periods=30).var(),axis=0).shift(1)\n# 3-day residual return, with lagged beta and lagged market cumulative return; signal at t uses close t (as in paper daily mark).\nr3=px.pct_change(3); m3=(1+mkt).rolling(3).apply(np.prod,raw=True)-1\nresid=r3-beta.mul(m3,axis=0)\nfac=(-resid).clip(-.2,.2)\nfac.to_csv('scripts/miner_3_20270325_residual_reversal_signal.csv')\nprint('assets',len(assets),'rows',len(fac),'period',fac.index.min(),fac.index.max())\nfor h in [1,5,10]:\n fwd=px.pct_change(h).shift(-h); vals=[]; ds=[]; ns=[]\n for dt in fac.index:\n  z=pd.concat([fac.loc[dt],fwd.loc[dt]],axis=1).dropna()\n  if len(z)>=8 and z.iloc[:,0].nunique()>1 and z.iloc[:,1].nunique()>1:\n   vals.append(spearmanr(z.iloc[:,0],z.iloc[:,1]).statistic); ds.append(dt); ns.append(len(z))\n s=pd.Series(vals,index=ds); print('H',h,'dates',len(s),'avgN',round(np.mean(ns),2),'IC %.6f ICIR %.6f hit %.4f'%(s.mean(),s.mean()/s.std(ddof=1),(s>0).mean()))\n if h==1:\n  for lo,hi in [('2020','2022-12-31'),('2023','2024-12-31'),('2025','2027-03-24')]:\n   q=s[(s.index>=lo)&(s.index<=hi)]; print('regime',lo,hi,'IC %.6f ICIR %.6f n %d'%(q.mean(),q.mean()/q.std(ddof=1),len(q)))\nprint('coverage',fac.notna().sum(axis=1).mean()/len(assets),'turnover',fac.rank(axis=1,pct=True).diff().abs().mean().mean())\n", 'file_path': 'scripts/miner_3_20270325_residual_reversal.py'})
