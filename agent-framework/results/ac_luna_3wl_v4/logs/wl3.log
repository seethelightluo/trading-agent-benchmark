 import pandas as pd, numpy as np
from pathlib import Path
from scipy.stats import spearmanr
U=['000300.SH','SPX','HSI','N225','SX5E','000688.SH','SOX','NDX','XAU','COPPER','WTI','BTC','ETH','US10Y','CN10Y']; base=Path('../persistent/stock_data')
def load(p):
 d=pd.read_csv(p); d['date']=pd.to_datetime(d['date']); d=d.set_index('date'); return d['close'].astype(float)
px=pd.concat({s:load(base/(s+'.csv')) for s in U},axis=1).sort_index(); v=load(Path('../persistent/index_data/VIX.csv')).reindex(px.index).ffill()
regime=-(v.pct_change(5)).clip(-.5,.5).fillna(0); f=px.pct_change(20)*(1+regime)
def calc(h):
 y=px.shift(-h)/px-1; vals=[]; dates=[]
 for dt in f.index:
  z=pd.concat([f.loc[dt],y.loc[dt]],axis=1).dropna()
  if len(z)>=8: vals.append(spearmanr(z.iloc[:,0],z.iloc[:,1]).statistic); dates.append(dt)
 return pd.Series(vals,index=pd.DatetimeIndex(dates))
print('candidate macro_conditioned_momentum_20d'); print('range',px.index.min(),px.index.max(),'assets',len(U),'factor valid dates',f.dropna(how='all').shape[0])
for h in [1,5,10,20]:
 a=calc(h); print(h,'dates',len(a),'meanIC',round(a.mean(),6),'ICIR',round(a.mean()/a.std(ddof=1),6),'hit',round(np.mean(a>0),4))
a=calc(1); print('annual',a.groupby(a.index.year).agg(['mean','count']).round(4).to_dict()); print('coverage',round(f.notna().sum().sum()/f.size,4)); print('turnover',round(f.rank(axis=1,pct=True).diff().abs().mean().mean(),4))


