 import pandas as pd,numpy as np,glob,os
from scipy.stats import spearmanr
cut=pd.Timestamp('2027-03-24'); assets=[os.path.basename(x)[:-4] for x in glob.glob('../persistent/stock_data/*.csv')]
macro=pd.read_csv('../persistent/index_data/VIX.csv',parse_dates=['date']).sort_values('date').set_index('date'); mv=macro['close'].pct_change(); vz=(mv-mv.rolling(20,min_periods=10).median()).clip(-.5,.5)
F={}; fw={h:{} for h in [1,5,10]}
for a in assets:
 d=pd.read_csv('../persistent/stock_data/'+a+'.csv',parse_dates=['date']).sort_values('date'); d=d[d.date<=cut].set_index('date')
 r=d.close.pct_change(); lv=np.log(d.volume.replace(0,np.nan)); shock=(lv-lv.rolling(20,min_periods=10).median()).clip(-3,3)
 # VIX-shock-conditioned volume reversal: contrarian 2d return, normalized by 10d vol, with positive VIX shock increasing its weight.
 rv=r.rolling(10,min_periods=8).std(); base=(-d.close.pct_change(2)/rv).clip(-10,10)
 x=base*(1+0.75* vz.reindex(d.index).fillna(0).clip(lower=0))*(1+0.35*shock.clip(lower=0))
 F[a]=x
 for h in fw: fw[h][a]=d.close.pct_change(h).shift(-h)
fac=pd.DataFrame(F).sort_index(); fac.to_csv('scripts/miner_1_20270325_vix_volume_reversal_signal.csv')
print('assets',len(assets),'rows',len(fac),'period',fac.index.min(),fac.index.max())
for h in fw:
