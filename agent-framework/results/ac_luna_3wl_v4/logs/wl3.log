import pandas as pd,numpy as np,glob,os
from scipy.stats import spearmanr
cut=pd.Timestamp('2027-03-24'); assets=[os.path.basename(x)[:-4] for x in glob.glob('../persistent/stock_data/*.csv')]
F={}; fw={h:{} for h in [1,5,10]}
for a in assets:
 d=pd.read_csv('../persistent/stock_data/'+a+'.csv',parse_dates=['date']).sort_values('date'); d=d[d.date<=cut].set_index('date')
 r=d.close.pct_change(); vol=r.rolling(20,min_periods=10).std(); down=r.where(r<0,0).pow(2).rolling(20,min_periods=10).mean().pow(.5)
 # Defensive quality: medium-term trend rewarded, scaled by downside risk and recent volatility.
 mom=d.close.pct_change(20)
 F[a]=mom/(down*np.sqrt(20)+0.003)
 for h in fw: fw[h][a]=d.close.pct_change(h).shift(-h)
fac=pd.DataFrame(F).sort_index(); fac.to_csv('scripts/miner_1_20270325_defensive_quality_signal.csv')
