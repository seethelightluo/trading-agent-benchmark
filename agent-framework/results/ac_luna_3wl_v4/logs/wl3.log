 import json
from pathlib import Path
import numpy as np
from alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights

UNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
W = {"clv": 0.3395, "peer": 0.2612, "reversal": 0.2012, "momentum": 0.1981}
MIN_W, MAX_W, CADENCE = 0.015, 0.16, 10
last_decision = None
smooth_score = None

def ranks(values):
    valid = sorted((s, v) for s, v in values.items() if np.isfinite(v))
    out = {s: 0.5 for s in UNIVERSE}
    n = len(valid)
    if n > 1:
        for i, (s, _) in enumerate(valid): out[s] = (i + 1.0) / n
    return out

def bounded_weights(raw):
    # Water-fill projection, preserving a complete non-negative simplex.
    w = {s: max(float(raw.get(s, 0.0)), 1e-8) for s in UNIVERSE}
    free = set(UNIVERSE); fixed = {}
    for _ in range(30):
        rem = 1.0 - sum(fixed.values())
        total = sum(w[s] for s in free)
        trial = {s: rem * w[s] / max(total, 1e-12) for s in free}
        low = [s for s in free if trial[s] < MIN_W]
        high = [s for s in free if trial[s] > MAX_W]
        if not low and not high:
            fixed.update(trial); break
        if low:
            for s in low: fixed[s] = MIN_W; free.remove(s)
        elif high:
            for s in high: fixed[s] = MAX_W; free.remove(s)
        if not free: break
    if free:
        rem = 1.0 - sum(fixed.values()); total = sum(w[s] for s in free)
        fixed.update({s: rem*w[s]/max(total,1e-12) for s in free})
    z = sum(fixed.values())
    return {s: fixed.get(s, 0.0)/z for s in UNIVERSE}

@register_hook
def cross_asset_strategy():
    global last_decision, smooth_score
    data = {}
    for s in UNIVERSE:
        df = get_stock_daily_data(symbol=s, days=90)
        if df is None or len(df) < 30: continue
        df = df.sort_values("date").reset_index(drop=True)
        c = np.asarray(df["close"], float); h = np.asarray(df["high"], float); l = np.asarray(df["low"], float)
        r = c[1:] / np.maximum(c[:-1], 1e-12) - 1
        data[s] = (c, h, l, r, str(df.iloc[-1]["date"]))
    if len(data) < 12: return
    date = max(v[4] for v in data.values())
    if last_decision is not None:
        try:
            if (np.datetime64(date)-np.datetime64(last_decision))/np.timedelta64(1,'D') < CADENCE: return
        except Exception: return
    clv={}; rev={}; mom={}; lead={}; iv={}
    for s,(c,h,l,r,_) in data.items():
        candle=(2*c-h-l)/np.maximum(h-l,1e-12)
        vol=max(float(np.std(r[-20:])),0.008)
        clv[s]=float(np.mean(candle[-5:]))
        rev[s]=float(-np.mean(r[-5:]))
        mom[s]=float((c[-1]/max(c[-21],1e-12)-1)/(vol+0.01))
        lead[s]=float(c[-1]/max(c[-6],1e-12)-1)
        iv[s]=1.0/vol
    med=float(np.median(list(lead.values())))
    lead={s:v-med for s,v in lead.items()}
    rr={k:ranks(v) for k,v in [("clv",clv),("peer",lead),("reversal",rev),("momentum",mom)]}
    score={s:sum(W[k]*rr[k][s] for k in W) for s in UNIVERSE}
    if smooth_score is not None: score={s:0.6*smooth_score.get(s,score[s])+0.4*score[s] for s in UNIVERSE}
    smooth_score=dict(score)
    breadth=float(np.mean([data[s][0][-1]>data[s][0][-21] for s in data]))
    bearish=False
    if "SPX" in data:
        c=data["SPX"][0]; bearish=(c[-1]<c[-21] and c[-1]<c[-6]) or breadth<0.40
    if bearish:
        for s in ("XAU","US10Y","CN10Y"): score[s]+=0.14
        for s in ("BTC","ETH","WTI"): score[s]=max(0.05,score[s]-0.07)
    mean_iv=float(np.mean(list(iv.values())))
    raw={s:max(score[s],0.02)*(0.70+0.30*iv[s]/max(mean_iv,1e-12)) for s in UNIVERSE}
    weights=bounded_weights(raw)
    avg=float(np.mean(list(score.values()))); sd=max(float(np.std(list(score.values()))),1e-12)
    forecast={s:0.01*(score[s]-avg)/sd for s in UNIVERSE}
    ids=[]
    try:
        obj=json.loads((Path(__file__).parent/'factors'/'factor_ensemble.json').read_text())
        ids=[x['factor_id'] for x in obj.get('selected_factors',[]) if isinstance(x,dict) and x.get('factor_id')][:10]
    except Exception: pass
    rebalance_to_weights(weights, forecast_returns=forecast, factor_ids=ids, horizon_days=10)
    last_decision=date

