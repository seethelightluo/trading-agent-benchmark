  ▶️ write_file({'content': "import numpy as np, pandas as pd\nfrom alphacrafter.sim.utils import get_index_daily_data\nU=['000300.SH','SPX','HSI','N225','SX5E','000688.SH','SOX','NDX','XAU','COPPER','WTI','BTC','ETH','US10Y','CN10Y']\nframes={}\nfor s in U:\n d=get_index_daily_data(s,days=3000)\n if d is not None and len(d)>100: frames[s]=d.set_index('date').sort_index()\n# medium trend quality: 60d return, penalize recent 20d vol, with 5d skip\npx=pd.concat({s:frames[s]['close'] for s in frames},axis=1).sort_index()\nr=px.pct_change(); f=px.shift(5)/px.shift(65)-1\nvol=r.rolling(20).std()*np.sqrt(252)\nsig=f/vol\n# future close return horizons\nrows=[]\nfor dt in sig.index:\n for h in [1,5,10]:\n  y=px.shift(-h).loc[dt]/px.loc[dt]-1\n  z=pd.DataFrame({'f':sig.loc[dt],'y':y}).dropna()\n  if len(z)>=8: rows.append((dt,h,z.f.corr(z.y),len(z)))\na=pd.DataFrame(rows,columns=['date','h','ic','n'])\nfor h in [1,5,10]:\n q=a[a.h==h]; m=q.ic.mean(); sd=q.ic.std(ddof=1); print('H',h,'dates',len(q),'avgN',q.n.mean(),'IC',m,'ICIR',m/sd*np.sqrt(1) if sd else 0,'hit',(q.ic>0).mean())\n if h==1:\n  print(q.assign(reg=q.date.dt.year.map(lambda x:'2020-22' if x<=2022 else ('2023-24' if x<=2024 else '2025-27'))).groupby('reg').ic.mean())\n# daily artifact\nout=sig.stack().rename('signal').reset_index(); out.columns=['date','symbol','signal']; out.to_csv('scripts/miner_2_20270311_medium_trend_quality_signal.csv',index=False)\nprint('coverage',sig.notna().sum().sum()/(len(sig)*len(sig.columns)),'symbols',len(frames))\n# turnover mean rank changes\nranks=sig.rank(axis=1,pct=True); print('turnover',ranks.diff().abs().mean().mean())\n", 'file_path': 'scripts/miner_2_20270311_medium_trend_quality.py'})
