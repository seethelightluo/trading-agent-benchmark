  ▶️ write_file({'content': "import pandas as pd,numpy as np,glob,os\nfrom scipy.stats import spearmanr\ncut=pd.Timestamp('2026-12-30')\nassets=[os.path.basename(x)[:-4] for x in glob.glob('../persistent/stock_data/*.csv')]\nF={}; FW={h:{} for h in [1,5,10]}\nfor a in assets:\n d=pd.read_csv('../persistent/stock_data/'+a+'.csv',parse_dates=['date']).sort_values('date').set_index('date')\n d=d[d.index<=cut]; r=d.close.pct_change()\n # Volatility-scaled 10-day contrarian reversal: larger normalized recent losses rank higher.\n F[a]=-(d.close/d.close.shift(10)-1)/(r.rolling(20,min_periods=15).std()+0.005)\n for h in FW: FW[h][a]=d.close.pct_change(h).shift(-h)\nfac=pd.DataFrame(F).sort_index(); fac.to_csv('scripts/miner_1_20261231_vol_scaled_10d_reversal_signal.csv')\nprint('assets',len(assets),'rows',len(fac),'period',fac.index.min(),fac.index.max())\nfor h in [1,5,10]:\n fwd=pd.DataFrame(FW[h]).reindex(fac.index); vals=[];ds=[];ns=[]\n for dt in fac.index:\n  z=pd.concat([fac.loc[dt],fwd.loc[dt]],axis=1).dropna()\n  if len(z)>=8 and z.iloc[:,0].nunique()>1 and z.iloc[:,1].nunique()>1:\n   vals.append(spearmanr(z.iloc[:,0],z.iloc[:,1]).statistic); ds.append(dt); ns.append(len(z))\n s=pd.Series(vals,index=ds)\n print('H',h,'dates',len(s),'avgN',round(np.mean(ns),2),'IC %.6f ICIR %.6f hit %.4f cov %.4f'%(s.mean(),s.mean()/s.std(ddof=1),(s>0).mean(),fac.notna().sum(axis=1).mean()/len(assets)))\n if h==1: print('regimes',[(p,round(s[(s.index>=p[0])&(s.index<=p[1])].mean(),5),round(s[(s.index>=p[0])&(s.index<=p[1])].mean()/s[(s.index>=p[0])&(s.index<=p[1])].std(ddof=1),5),len(s[(s.index>=p[0])&(s.index<=p[1])])) for p in [('2020','2022-12-31'),('2023','2024-12-31'),('2025','2026-12-31')]])\nprint('turnover',fac.rank(axis=1,pct=True).diff().abs().mean().mean())\n", 'file_path': 'scripts/miner_1_20261231_vol_scaled_10d_reversal.py'})
