 import json
from pathlib import Path
import numpy as np
from alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights

UNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
# Current six-factor screener ensemble; all directions are positive.
FACTOR_WEIGHTS = {"clv": .24, "peer": .22, "momentum": .22,
                  "intraday": .14, "close_rev": .10, "vol_intraday": .08}
MIN_WEIGHT, MAX_WEIGHT = .02, .16
REBALANCE_DAYS = 10
last_decision = None
previous_score = None


def rank_cs(values):
    valid = sorted((s, float(v)) for s, v in values.items() if np.isfinite(v))
    out = {s: .5 for s in UNIVERSE}
    n = len(valid)
    for i, (s, _) in enumerate(valid):
        out[s] = (i + 1.0) / n if n > 1 else .5
    return out


def bounded_simplex(raw):
    """Convert positive scores into a complete, bounded 15-asset target."""
    w = {s: max(float(raw.get(s, 0.0)), 1e-12) for s in UNIVERSE}
    fixed, free = {}, set(UNIVERSE)
    for _ in range(30):
        scale = (1.0 - sum(fixed.values())) / max(sum(w[s] for s in free), 1e-12)
        low = [s for s in free if w[s] * scale < MIN_WEIGHT]
        high = [s for s in free if w[s] * scale > MAX_WEIGHT]
        if not low and not high:
            fixed.update({s: w[s] * scale for s in free})
            free.clear()
            break
        chosen, bound = (low, MIN_WEIGHT) if low else (high, MAX_WEIGHT)
        for s in chosen:
            fixed[s], _ = bound, free.remove(s)
    if free:
        rem = max(1.0 - sum(fixed.values()), 0.0)
        den = max(sum(w[s] for s in free), 1e-12)
        fixed.update({s: rem * w[s] / den for s in free})
    total = max(sum(fixed.values()), 1e-12)
    return {s: fixed.get(s, 0.0) / total for s in UNIVERSE}


@register_hook
def cross_asset_strategy():
    global last_decision, previous_score
    data = {}
    for s in UNIVERSE:
        df = get_stock_daily_data(symbol=s, days=100)
        if df is None or len(df) < 35:
            continue
        df = df.sort_values("date").reset_index(drop=True)
        c = np.asarray(df["close"], float)
        o = np.asarray(df["open"], float)
        h = np.asarray(df["high"], float)
        l = np.asarray(df["low"], float)
        v = np.asarray(df["volume"], float) if "volume" in df else np.ones(len(df))
        r = c[1:] / np.maximum(c[:-1], 1e-12) - 1.0
        data[s] = (c, o, h, l, v, r, str(df.iloc[-1]["date"]))
    if len(data) < 12:
        return
    decision_date = max(x[-1] for x in data.values())
    if last_decision is not None:
        try:
            if (np.datetime64(decision_date) - np.datetime64(last_decision)) / np.timedelta64(1, "D") < REBALANCE_DAYS:
                return
        except Exception:
            return

    raw = {k: {} for k in FACTOR_WEIGHTS}
    invvol = {}
    for s, (c, o, h, l, v, r, _) in data.items():
        vol = max(float(np.std(r[-20:])), .008)
        invvol[s] = 1.0 / vol
        candle = (2.0 * c - h - l) / np.maximum(h - l, 1e-12)
        raw["clv"][s] = float(candle[-1])
        raw["momentum"][s] = float((c[-1] / max(c[-21], 1e-12) - 1.0) / vol)
        raw["intraday"][s] = float(-(c[-1] / max(o[-1], 1e-12) - 1.0) / vol)
        raw["close_rev"][s] = float(-r[-1] / vol)
        medv = np.median(v[-20:])
        volume_ratio = np.clip(v[-1] / max(medv, 1e-12) - 1.0, -1.0, 3.0)
        raw["vol_intraday"][s] = float(-(c[-1] / max(o[-1], 1e-12) - 1.0) * (1.0 + volume_ratio))
        raw["peer"][s] = float(c[-1] / max(c[-6], 1e-12) - 1.0)
    med_peer = float(np.median(list(raw["peer"].values())))
    raw["peer"] = {s: x - med_peer for s, x in raw["peer"].items()}
    ranks = {k: rank_cs(x) for k, x in raw.items()}
    score = {s: sum(FACTOR_WEIGHTS[k] * ranks[k].get(s, .5) for k in FACTOR_WEIGHTS) for s in UNIVERSE}
    # Persistence reduces turnover from the reversal cluster.
    if previous_score is not None:
        score = {s: .70 * previous_score.get(s, score[s]) + .30 * score[s] for s in UNIVERSE}
    previous_score = dict(score)

    breadth = np.mean([c[-1] > c[-21] for c, *_ in data.values()])
    market_vol = np.mean([np.std(x[5][-20:]) for x in data.values()])
    # High-risk/bearish regime: remain fully invested but favor defensive tradable assets.
    if breadth < .55 or market_vol > .025:
        for s in ("XAU", "US10Y", "CN10Y"):
            if s in score:
                score[s] += .18
        for s in ("BTC", "ETH", "WTI"):
            if s in score:
                score[s] -= .08

    mean_iv = np.mean(list(invvol.values()))
    raw_weight = {s: max(score[s], .05) * (.65 + .35 * invvol[s] / max(mean_iv, 1e-12)) for s in UNIVERSE}
    weights = bounded_simplex(raw_weight)
    avg, sd = np.mean(list(score.values())), max(np.std(list(score.values())), 1e-12)
    forecast = {s: .01 * (score[s] - avg) / sd for s in UNIVERSE}
    try:
        ens = json.loads((Path(__file__).parent / "factors" / "factor_ensemble.json").read_text())
        ids = [x["factor_id"] for x in ens.get("selected_factors", []) if x.get("factor_id")][:10]
    except Exception:
        ids = []
    rebalance_to_weights(weights, forecast_returns=forecast, factor_ids=ids, horizon_days=10)
    last_decision = decision_date

if __name__ == "__main__":
    pass


