 import pandas as pd, numpy as np, glob, os
from scipy.stats import spearmanr
cut=pd.Timestamp('2027-03-24'); assets=[os.path.basename(x)[:-4] for x in glob.glob('../persistent/stock_data/*.csv')]
prices={}
for a in assets:
 d=pd.read_csv('../persistent/stock_data/'+a+'.csv',parse_dates=['date']).sort_values('date'); prices[a]=d[d.date<=cut].set_index('date').close
px=pd.DataFrame(prices).sort_index(); ret=px.pct_change(); bench=ret.median(axis=1)
fac=pd.DataFrame(index=px.index,columns=assets,dtype=float)
for a in assets:
 beta=ret[a].rolling(60,min_periods=30).cov(bench)/bench.rolling(60,min_periods=30).var()
 residual=ret[a]-beta*bench
 fac[a]=-residual.rolling(10,min_periods=8).sum()/ret[a].rolling(20,min_periods=15).std()
fac=fac.replace([np.inf,-np.inf],np.nan); fac.to_csv('scripts/miner_2_20270325_residual_reversal_signal.csv')
def calc(fw):
 vals=[]; ds=[]; ns=[]
 for dt in fac.index:
  z=pd.concat([fac.loc[dt],fw.loc[dt]],axis=1).dropna()
  if len(z)>=8 and z.iloc[:,0].nunique()>1 and z.iloc[:,1].nunique()>1: vals.append(spearmanr(z.iloc[:,0],z.iloc[:,1]).statistic); ds.append(dt); ns.append(len(z))
 return pd.Series(vals,index=ds),ns
s,ns=calc(ret.shift(-1)); print('assets',len(assets),'dates',len(s),'avgN',round(np.mean(ns),2),'IC %.6f ICIR %.6f hit %.4f coverage %.4f turnover %.6f'%(s.mean(),s.mean()/s.std(ddof=1),(s>0).mean(),fac.notna().sum(axis=1).mean()/len(assets),fac.rank(axis=1,pct=True).diff().abs().mean().mean()))
for lo,hi in [('2020','2022-12-31'),('2023','2024-12-31'),('2025','2027-03-24')]:
 q=s[(s.index>=lo)&(s.index<=hi)]; print('regime',lo,hi,'IC %.6f ICIR %.6f dates %d'%(q.mean(),q.mean()/q.std(ddof=1),len(q)))
for h in [5,10]:
 ss,_=calc(px.pct_change(h).shift(-h)); print('horizon',h,'IC %.6f ICIR %.6f dates %d'%(ss.mean(),ss.mean()/ss.std(ddof=1),len(ss)))
print('period',s.index.min(),s.index.max())


