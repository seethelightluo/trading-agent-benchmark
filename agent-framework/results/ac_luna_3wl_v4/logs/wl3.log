for a in assets:
 d=pd.read_csv('../persistent/stock_data/'+a+'.csv',parse_dates=['date']).sort_values('date'); d=d[d.date<=cut].set_index('date')
 R[a]=d.close.pct_change(20)
 for h in fw: fw[h][a]=d.close.pct_change(h).shift(-h)
r=pd.DataFrame(R).sort_index(); med=r.median(axis=1); fac=r.sub(med,axis=0) # relative 20d strength versus contemporaneous cross-section
fac.to_csv('scripts/miner_3_20270325_relative_strength_signal.csv')
