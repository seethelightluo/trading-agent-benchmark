 eff=r.rolling(10,min_periods=10).sum()/r.abs().rolling(10,min_periods=10).sum()
 F[a]=c.pct_change(20)*eff
 for h in fw: fw[h][a]=c.pct_change(h).shift(-h)
raw=pd.DataFrame(F).sort_index()
