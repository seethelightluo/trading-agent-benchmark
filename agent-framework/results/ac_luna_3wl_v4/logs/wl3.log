  ▶️ write_file({'content': "import pandas as pd, numpy as np, glob, os\nfrom scipy.stats import spearmanr\ncut=pd.Timestamp('2027-03-24')\nassets=[os.path.basename(x)[:-4] for x in glob.glob('../persistent/stock_data/*.csv')]\npx={}\nfor a in assets:\n d=pd.read_csv('../persistent/stock_data/'+a+'.csv',parse_dates=['date']).sort_values('date').set_index('date')\n px[a]=d.close[d.index<=cut]\nclose=pd.DataFrame(px).sort_index().ffill(); r=close.pct_change()\nvol=r.rolling(20,min_periods=10).std()\n# Cross-sectional market dispersion: average asset realized volatility, known at date t.\ndisp=vol.mean(axis=1); threshold=disp.rolling(252,min_periods=60).median()\nstress=(disp>threshold).astype(float).values[:,None]\nF=-(close.pct_change(5))/(vol*np.sqrt(5)+1e-8)*(1+0.5*stress)\nF.to_csv('scripts/miner_2_20270325_dispersion_reversal_signal.csv')\nprint('assets',len(assets),'rows',len(F),'period',F.index.min(),F.index.max())\nfor h in [1,5,10]:\n fwd=close.pct_change(h).shift(-h); vals=[]; ds=[]; ns=[]\n for dt in F.index:\n  z=pd.concat([F.loc[dt],fwd.loc[dt]],axis=1).dropna()\n  if len(z)>=8 and z.iloc[:,0].nunique()>1 and z.iloc[:,1].nunique()>1:\n   vals.append(spearmanr(z.iloc[:,0],z.iloc[:,1]).statistic);ds.append(dt);ns.append(len(z))\n s=pd.Series(vals,index=ds)\n print('H',h,'dates',len(s),'avgN',round(np.mean(ns),2),'IC %.6f ICIR %.6f hit %.4f'%(s.mean(),s.mean()/s.std(ddof=1),(s>0).mean()))\n if h==1:\n  print('coverage',F.notna().sum(axis=1).mean()/len(assets))\n  for lo,hi in [('2020','2022-12-31'),('2023','2024-12-31'),('2025','2027-03-24')]:\n   q=s[(s.index>=lo)&(s.index<=hi)]; print('regime',lo,hi,'IC %.6f n %d'%(q.mean(),len(q)))\nprint('turnover',F.rank(axis=1,pct=True).diff().abs().mean().mean())\n", 'file_path': 'scripts/miner_2_20270325_dispersion_reversal.py'})
