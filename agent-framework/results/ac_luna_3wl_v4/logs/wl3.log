 d=pd.read_csv('../persistent/stock_data/'+a+'.csv',parse_dates=['date']).sort_values('date'); d=d[d.date<=cut].set_index('date')
 r=d.close.pct_change(); lv=np.log(d.volume.replace(0,np.nan)); base=lv.rolling(30,min_periods=15).median(); mad=(lv-base).abs().rolling(30,min_periods=15).median()
 shock=((lv-base)/(mad+1e-6)).clip(-4,4)
 # A short rolling accumulation of volume-confirmed reversal, with robust volume surprise.
 F[a]=(-r*shock).rolling(3,min_periods=2).mean().clip(-0.15,0.15)
 for h in fw: fw[h][a]=d.close.pct_change(h).shift(-h)
fac=pd.DataFrame(F).sort_index(); fac.to_csv('scripts/miner_3_20270325_robust_volume_reversal_signal.csv')
