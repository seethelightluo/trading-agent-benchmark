 # Reward momentum by path quality: return divided by realized downside deviation, with a small scale floor.
 down=r.where(r<0,0.0).rolling(20,min_periods=20).std()
 F[a]=c.pct_change(20)/(down*np.sqrt(20)+0.002)
 for h in fw: fw[h][a]=c.pct_change(h).shift(-h)
fac=pd.DataFrame(F).sort_index(); fac.to_csv('scripts/miner_3_20270225_downside_adjusted_momentum_signal.csv')
