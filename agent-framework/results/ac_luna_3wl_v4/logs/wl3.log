   q=z[mask];print(f'{lab} dates={len(q)} IC={q.mean():.6f} ICIR={q.mean()/q.std(ddof=1):.6f}')
out=f.copy();out.index=out.index.strftime('%Y-%m-%d');out.to_csv('scripts/miner_3_20261008_persistence_signal.csv');print('period',p.index.min(),p.index.max(),'assets',p.shape[1]);print('signal_artifact scripts/miner_3_20261008_persistence_signal.csv')


