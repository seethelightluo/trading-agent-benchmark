  ▶️ write_file({'content': 'import numpy as np\nfrom alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights\n\nUNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]\nFACTORS = {\n    "miner_3_clv_1d": (0.27, "clv"),\n    "peer_median_leadlag_5d": (0.25, "peer"),\n    "miner_2_risk_adjusted_momentum_20d": (0.23, "mom"),\n    "miner_2_relative_reversal_3d_vol": (0.15, "rev3"),\n    "miner_3_range_adjusted_intraday_reversal_1d": (0.10, "irev"),\n}\nMIN_W, MAX_W = 0.025, 0.15\nlast_date = None\nprior_score = None\n\n\ndef rank(values):\n    good = sorted((s, v) for s, v in values.items() if np.isfinite(v))\n    out = {s: 0.5 for s in UNIVERSE}\n    n = len(good)\n    for i, (s, _) in enumerate(good):\n        out[s] = (i + 1) / n if n > 1 else 0.5\n    return out\n\n\ndef bounded(raw):\n    # Iterative water filling gives a complete, non-negative, full-investment vector.\n    free, result = set(UNIVERSE), {}\n    while free:\n        remain = 1.0 - sum(result.values())\n        denom = sum(max(raw[s], 1e-9) for s in free)\n        trial = {s: remain * max(raw[s], 1e-9) / denom for s in free}\n        low = [s for s in free if trial[s] < MIN_W]\n        high = [s for s in free if trial[s] > MAX_W]\n        if not low and not high:\n            result.update(trial)\n            break\n        chosen, value = (low, MIN_W) if low else (high, MAX_W)\n        for s in chosen:\n            result[s] = value\n            free.remove(s)\n    total = sum(result.values())\n    return {s: result.get(s, 0.0) / total for s in UNIVERSE}\n\n\n@register_hook\ndef cross_asset_strategy():\n    global last_date, prior_score\n    data = {}\n    for symbol in UNIVERSE:\n        df = get_stock_daily_data(symbol=symbol, days=110)\n        if df is None or len(df) < 35:\n            continue\n        df = df.sort_values("date").reset_index(drop=True)\n        c = np.asarray(df["close"], float)\n        o = np.asarray(df["open"], float)\n        h = np.asarray(df["high"], float)\n        lo = np.asarray(df["low"], float)\n        r = c[1:] / np.maximum(c[:-1], 1e-12) - 1.0\n        data[symbol] = (c, o, h, lo, r, str(df.iloc[-1]["date"]))\n    if len(data) < 12:\n        return\n    decision_date = max(x[-1] for x in data.values())\n    if last_date is not None:\n        try:\n            if (np.datetime64(decision_date) - np.datetime64(last_date)) / np.timedelta64(1, "D") < 13:\n                return\n        except Exception:\n            return\n\n    values = {key: {} for _, key in FACTORS.values()}\n    invvol = {}\n    for s, (c, o, h, lo, r, _) in data.items():\n        vol = max(float(np.std(r[-20:])), 0.008)\n        invvol[s] = 1.0 / vol\n        values["clv"][s] = float(((2*c[-1] - h[-1] - lo[-1]) / max(h[-1] - lo[-1], 1e-12)))\n        values["peer"][s] = float(c[-1] / max(c[-6], 1e-12) - 1.0)\n        values["mom"][s] = float((c[-1] / max(c[-21], 1e-12) - 1.0) / vol)\n        values["rev3"][s] = float(-(c[-1] / max(c[-4], 1e-12) - 1.0) / vol)\n        # Range adjustment reduces the influence of very wide candles.\n        intraday = -(c[-1] / max(o[-1], 1e-12) - 1.0)\n        values["irev"][s] = float(intraday / max((h[-1] - lo[-1]) / max(c[-1], 1e-12), 0.005))\n\n    median_peer = float(np.median(list(values["peer"].values())))\n    values["peer"] = {s: v - median_peer for s, v in values["peer"].items()}\n    ranks = {key: rank(v) for key, v in values.items()}\n    score = {s: sum(weight * ranks[key].get(s, 0.5) for weight, key in FACTORS.values()) for s in UNIVERSE}\n    if prior_score is not None:\n        score = {s: 0.75 * prior_score.get(s, score[s]) + 0.25 * score[s] for s in UNIVERSE}\n    prior_score = dict(score)\n\n    breadth = float(np.mean([c[-1] > c[-21] for c, *_ in data.values()]))\n    market_vol = float(np.mean([np.std(x[4][-20:]) for x in data.values()]))\n    # High-risk or weak-breadth conditions use tradable defensive assets, never cash.\n    if breadth < 0.55 or market_vol > 0.025:\n        for s in ("XAU", "US10Y", "CN10Y"):\n            score[s] += 0.16\n        for s in ("BTC", "ETH", "WTI"):\n            score[s] -= 0.06\n    mean_iv = max(float(np.mean(list(invvol.values()))), 1e-12)\n    raw = {s: max(score[s], 0.05) * (0.70 + 0.30 * invvol.get(s, mean_iv) / mean_iv) for s in UNIVERSE}\n    weights = bounded(raw)\n    mean_score = float(np.mean(list(score.values())))\n    std_score = max(float(np.std(list(score.values()))), 1e-12)\n    forecast = {s: float(0.01 * (score[s] - mean_score) / std_score) for s in UNIVERSE}\n    rebalance_to_weights(weights, forecast_returns=forecast, factor_ids=list(FACTORS), horizon_days=10)\n    last_date = decision_date\n\nif __name__ == "__main__":\n    pass\n', 'file_path': 'strategy.py'})
