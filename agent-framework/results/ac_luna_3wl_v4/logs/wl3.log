 import numpy as np
from alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights

UNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
FACTORS = {
    "miner_3_clv_1d": (0.27, "clv"),
    "peer_median_leadlag_5d": (0.25, "peer"),
    "miner_2_risk_adjusted_momentum_20d": (0.23, "mom"),
    "miner_2_relative_reversal_3d_vol": (0.15, "rev3"),
    "miner_3_range_adjusted_intraday_reversal_1d": (0.10, "irev"),
}
MIN_W, MAX_W = 0.025, 0.15
last_date = None
prior_score = None


def rank(values):
    good = sorted((s, v) for s, v in values.items() if np.isfinite(v))
    out = {s: 0.5 for s in UNIVERSE}
    n = len(good)
    for i, (s, _) in enumerate(good):
        out[s] = (i + 1) / n if n > 1 else 0.5
    return out


def bounded(raw):
    # Iterative water filling gives a complete, non-negative, full-investment vector.
    free, result = set(UNIVERSE), {}
    while free:
        remain = 1.0 - sum(result.values())
        denom = sum(max(raw[s], 1e-9) for s in free)
        trial = {s: remain * max(raw[s], 1e-9) / denom for s in free}
        low = [s for s in free if trial[s] < MIN_W]
        high = [s for s in free if trial[s] > MAX_W]
        if not low and not high:
            result.update(trial)
            break
        chosen, value = (low, MIN_W) if low else (high, MAX_W)
        for s in chosen:
            result[s] = value
            free.remove(s)
    total = sum(result.values())
    return {s: result.get(s, 0.0) / total for s in UNIVERSE}


@register_hook
def cross_asset_strategy():
    global last_date, prior_score
    data = {}
    for symbol in UNIVERSE:
        df = get_stock_daily_data(symbol=symbol, days=110)
        if df is None or len(df) < 35:
            continue
        df = df.sort_values("date").reset_index(drop=True)
        c = np.asarray(df["close"], float)
        o = np.asarray(df["open"], float)
        h = np.asarray(df["high"], float)
        lo = np.asarray(df["low"], float)
        r = c[1:] / np.maximum(c[:-1], 1e-12) - 1.0
        data[symbol] = (c, o, h, lo, r, str(df.iloc[-1]["date"]))
    if len(data) < 12:
        return
    decision_date = max(x[-1] for x in data.values())
    if last_date is not None:
        try:
            if (np.datetime64(decision_date) - np.datetime64(last_date)) / np.timedelta64(1, "D") < 13:
                return
        except Exception:
            return

    values = {key: {} for _, key in FACTORS.values()}
    invvol = {}
    for s, (c, o, h, lo, r, _) in data.items():
        vol = max(float(np.std(r[-20:])), 0.008)
        invvol[s] = 1.0 / vol
        values["clv"][s] = float(((2*c[-1] - h[-1] - lo[-1]) / max(h[-1] - lo[-1], 1e-12)))
        values["peer"][s] = float(c[-1] / max(c[-6], 1e-12) - 1.0)
        values["mom"][s] = float((c[-1] / max(c[-21], 1e-12) - 1.0) / vol)
        values["rev3"][s] = float(-(c[-1] / max(c[-4], 1e-12) - 1.0) / vol)
        # Range adjustment reduces the influence of very wide candles.
        intraday = -(c[-1] / max(o[-1], 1e-12) - 1.0)
        values["irev"][s] = float(intraday / max((h[-1] - lo[-1]) / max(c[-1], 1e-12), 0.005))

    median_peer = float(np.median(list(values["peer"].values())))
    values["peer"] = {s: v - median_peer for s, v in values["peer"].items()}
    ranks = {key: rank(v) for key, v in values.items()}
    score = {s: sum(weight * ranks[key].get(s, 0.5) for weight, key in FACTORS.values()) for s in UNIVERSE}
    if prior_score is not None:
        score = {s: 0.75 * prior_score.get(s, score[s]) + 0.25 * score[s] for s in UNIVERSE}
    prior_score = dict(score)

    breadth = float(np.mean([c[-1] > c[-21] for c, *_ in data.values()]))
    market_vol = float(np.mean([np.std(x[4][-20:]) for x in data.values()]))
    # High-risk or weak-breadth conditions use tradable defensive assets, never cash.
    if breadth < 0.55 or market_vol > 0.025:
        for s in ("XAU", "US10Y", "CN10Y"):
            score[s] += 0.16
        for s in ("BTC", "ETH", "WTI"):
            score[s] -= 0.06
    mean_iv = max(float(np.mean(list(invvol.values()))), 1e-12)
    raw = {s: max(score[s], 0.05) * (0.70 + 0.30 * invvol.get(s, mean_iv) / mean_iv) for s in UNIVERSE}
    weights = bounded(raw)
    mean_score = float(np.mean(list(score.values())))
    std_score = max(float(np.std(list(score.values()))), 1e-12)
    forecast = {s: float(0.01 * (score[s] - mean_score) / std_score) for s in UNIVERSE}
    rebalance_to_weights(weights, forecast_returns=forecast, factor_ids=list(FACTORS), horizon_days=10)
    last_date = decision_date

if __name__ == "__main__":
    pass


