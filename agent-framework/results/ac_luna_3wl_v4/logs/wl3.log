 rng=(d.high-d.low).replace(0,np.nan); clv=((2*d.close-d.high-d.low)/rng).clip(-1,1)
 F[a]=-clv.rolling(5,min_periods=3).mean(); R[a]=d.close.pct_change().shift(-1)
