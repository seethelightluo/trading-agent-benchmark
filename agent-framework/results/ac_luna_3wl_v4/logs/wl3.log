from scipy.stats import spearmanr
cut=pd.Timestamp('2027-03-24'); assets=[os.path.basename(x)[:-4] for x in glob.glob('../persistent/stock_data/*.csv')]
F={}; P={}
for a in assets:
 d=pd.read_csv('../persistent/stock_data/'+a+'.csv',parse_dates=['date']).sort_values('date'); d=d[d.date<=cut].set_index('date')
 r=d.close.pct_change(); rv=r.rolling(10,min_periods=8).std()
 lv=np.log(d.volume.replace(0,np.nan)); shock=(lv-lv.rolling(20,min_periods=10).median())/(lv.rolling(20,min_periods=10).std()+1e-8)
 # Smooth abnormal-volume confirmation over 3 sessions; contrarian 2-day move.
 sm=shock.rolling(3,min_periods=2).mean().clip(lower=0,upper=2)
 F[a]=(-r.rolling(2).sum()/(rv*np.sqrt(2)+1e-8)*(1+0.4*sm)).clip(-10,10); P[a]=d.close
fac=pd.DataFrame(F).sort_index(); p=pd.DataFrame(P).sort_index(); fac.to_csv('scripts/miner_3_20270325_smoothed_volume_reversal_signal.csv')
print('assets',len(assets),'rows',len(fac),'period',fac.index.min(),fac.index.max())
for h in [1,5,10]:
