  ▶️ write_file({'content': 'import json\nfrom pathlib import Path\nimport numpy as np\nfrom alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights\n\nUNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]\nFACTOR_WEIGHTS = {"clv": 0.3395, "peer": 0.2612, "reversal": 0.2012, "momentum": 0.1981}\nMIN_WEIGHT, MAX_WEIGHT, REBALANCE_DAYS = 0.015, 0.16, 10\nlast_decision = None\nprevious_score = None\n\ndef rank_cross_section(values):\n    valid = sorted((s, float(v)) for s, v in values.items() if np.isfinite(v))\n    result = {s: 0.5 for s in UNIVERSE}\n    if len(valid) > 1:\n        for i, (s, _) in enumerate(valid):\n            result[s] = (i + 1.0) / len(valid)\n    return result\n\ndef project_weights(raw):\n    """Project positive scores to a fully invested vector with simple bounds."""\n    free, fixed = set(UNIVERSE), {}\n    raw = {s: max(float(raw.get(s, 0.0)), 1e-8) for s in UNIVERSE}\n    for _ in range(20):\n        if not free:\n            break\n        remainder = 1.0 - sum(fixed.values())\n        scale = remainder / max(sum(raw[s] for s in free), 1e-12)\n        low = [s for s in free if raw[s] * scale < MIN_WEIGHT]\n        high = [s for s in free if raw[s] * scale > MAX_WEIGHT]\n        if not low and not high:\n            fixed.update({s: raw[s] * scale for s in free})\n            break\n        if low:\n            for s in low:\n                fixed[s] = MIN_WEIGHT\n                free.remove(s)\n        else:\n            for s in high:\n                fixed[s] = MAX_WEIGHT\n                free.remove(s)\n    if free:\n        remainder = 1.0 - sum(fixed.values())\n        total = sum(raw[s] for s in free)\n        fixed.update({s: remainder * raw[s] / max(total, 1e-12) for s in free})\n    total = sum(fixed.values())\n    return {s: fixed.get(s, 0.0) / max(total, 1e-12) for s in UNIVERSE}\n\n@register_hook\ndef cross_asset_strategy():\n    global last_decision, previous_score\n    series = {}\n    for symbol in UNIVERSE:\n        df = get_stock_daily_data(symbol=symbol, days=100)\n        if df is None or len(df) < 35:\n            continue\n        df = df.sort_values("date").reset_index(drop=True)\n        close = np.asarray(df["close"], dtype=float)\n        high = np.asarray(df["high"], dtype=float)\n        low = np.asarray(df["low"], dtype=float)\n        ret = close[1:] / np.maximum(close[:-1], 1e-12) - 1.0\n        series[symbol] = (close, high, low, ret, str(df.iloc[-1]["date"]))\n    if len(series) < 12:\n        return\n    decision_date = max(x[4] for x in series.values())\n    if last_decision is not None:\n        try:\n            if (np.datetime64(decision_date) - np.datetime64(last_decision)) / np.timedelta64(1, "D") < REBALANCE_DAYS:\n                return\n        except Exception:\n            return\n\n    clv, peer, reversal, momentum, invvol = {}, {}, {}, {}, {}\n    for s, (c, h, l, r, _) in series.items():\n        candle = (2.0 * c - h - l) / np.maximum(h - l, 1e-12)\n        volatility = max(float(np.std(r[-20:])), 0.008)\n        clv[s] = float(np.mean(candle[-5:]))       # smoothed one-day pressure\n        reversal[s] = float(-np.mean(r[-5:]))\n        momentum[s] = float((c[-1] / max(c[-21], 1e-12) - 1.0) / (volatility + 0.01))\n        peer[s] = float(c[-1] / max(c[-6], 1e-12) - 1.0)\n        invvol[s] = 1.0 / volatility\n    median_peer = float(np.median(list(peer.values())))\n    peer = {s: v - median_peer for s, v in peer.items()}\n    ranked = {k: rank_cross_section(v) for k, v in\n              (("clv", clv), ("peer", peer), ("reversal", reversal), ("momentum", momentum))}\n    score = {s: sum(FACTOR_WEIGHTS[k] * ranked[k][s] for k in FACTOR_WEIGHTS) for s in UNIVERSE}\n    # Damp short-horizon score changes to control turnover, without using future data.\n    if previous_score is not None:\n        score = {s: 0.60 * previous_score.get(s, score[s]) + 0.40 * score[s] for s in UNIVERSE}\n    previous_score = dict(score)\n\n    breadth = float(np.mean([series[s][0][-1] > series[s][0][-21] for s in series]))\n    bearish = False\n    if "SPX" in series:\n        spx = series["SPX"][0]\n        bearish = (spx[-1] < spx[-31] and spx[-1] < spx[-11] and breadth < 0.50)\n    # In a bullish/moderate regime retain trend exposure. In a confirmed bear regime,\n    # rotate toward tradable defensive benchmarks while remaining fully invested.\n    if bearish:\n        for s in ("XAU", "US10Y", "CN10Y"):\n            score[s] += 0.12\n        for s in ("BTC", "ETH", "WTI"):\n            score[s] = max(0.05, score[s] - 0.06)\n\n    mean_iv = float(np.mean(list(invvol.values())))\n    raw = {s: max(score[s], 0.02) * (0.70 + 0.30 * invvol[s] / max(mean_iv, 1e-12)) for s in UNIVERSE}\n    weights = project_weights(raw)\n    avg, sd = float(np.mean(list(score.values()))), max(float(np.std(list(score.values()))), 1e-12)\n    forecast = {s: 0.01 * (score[s] - avg) / sd for s in UNIVERSE}\n    try:\n        ensemble = json.loads((Path(__file__).parent / "factors" / "factor_ensemble.json").read_text())\n        factor_ids = [x["factor_id"] for x in ensemble.get("selected_factors", [])\n                      if isinstance(x, dict) and x.get("factor_id")][:10]\n    except Exception:\n        factor_ids = []\n    # Complete 15-asset target; helper handles fractional quantities and 3bp gate.\n    rebalance_to_weights(weights, forecast_returns=forecast, factor_ids=factor_ids, horizon_days=10)\n    last_decision = decision_date\n\nif __name__ == "__main__":\n    pass\n', 'file_path': 'strategy.py'})
