  ▶️ write_file({'content': "import pandas as pd, numpy as np, glob\nfrom scipy.stats import spearmanr\nfrom pathlib import Path\nCUT=pd.Timestamp('2027-03-25')\nfiles=glob.glob('../persistent/stock_data/*.csv')\nsyms=['000300.SH','SPX','HSI','N225','SX5E','000688.SH','SOX','NDX','XAU','COPPER','WTI','BTC','ETH','US10Y','CN10Y']\npx={}\nfor s in syms:\n p=f'../persistent/stock_data/{s}.csv'\n d=pd.read_csv(p,parse_dates=['date']).set_index('date').sort_index()\n px[s]=d.loc[d.index<=CUT,'close'].astype(float)\nwide=pd.DataFrame(px).sort_index(); ret=wide.pct_change()\n# downside-risk-adjusted medium momentum: 20d return divided by RMS of negative daily returns\nmom=wide.shift(1)/wide.shift(21)-1\nneg=ret.where(ret<0,0).rolling(20,min_periods=15).apply(lambda x: np.sqrt(np.mean(x*x)),raw=True).shift(1)\nf=mom/neg.replace(0,np.nan)\n# rank cross section to reduce scale differences\nf=f.rank(axis=1,pct=True)\nfor h in [1,5,10]:\n fr=wide.shift(-h)/wide-1\n ics=[]; dates=[]; nobs=[]\n for dt in f.index:\n  x=f.loc[dt]; y=fr.loc[dt]\n  z=pd.concat([x,y],axis=1).dropna()\n  if len(z)>=8:\n   ics.append(spearmanr(z.iloc[:,0],z.iloc[:,1]).statistic); dates.append(dt); nobs.append(len(z))\n a=np.array(ics); print('H',h,'dates',len(a),'meanIC',a.mean(),'ICIR',a.mean()/a.std(ddof=1),'hit',(a>0).mean(),'medianN',np.median(nobs))\n# turnover and coverage\nturn=f.diff().abs().mean(axis=1).mean(); cov=f.notna().mean(axis=1).mean()\nprint('coverage',cov,'turnover',turn,'period',f.index.min(),f.index.max(),'instruments',len(syms))\n# artifact with raw signal, one row per date/symbol\nout=f.stack().rename('signal').reset_index(); out.columns=['date','symbol','signal']; out.to_csv('scripts/miner_2_20270325_downside_momentum_signal.csv',index=False)\n", 'file_path': 'scripts/miner_2_20270325_downside_momentum.py'})
