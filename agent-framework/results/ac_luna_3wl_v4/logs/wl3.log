import pandas as pd,numpy as np,glob,os
from scipy.stats import spearmanr
cut=pd.Timestamp('2027-03-24'); assets=[os.path.basename(x)[:-4] for x in glob.glob('../persistent/stock_data/*.csv')]
prices={}
for a in assets:
 d=pd.read_csv('../persistent/stock_data/'+a+'.csv',parse_dates=['date']).sort_values('date'); prices[a]=d[d.date<=cut].set_index('date').close
P=pd.DataFrame(prices).sort_index(); R=P.pct_change(); downside=R.where(R<0).rolling(20,min_periods=15).std(); fac=(P.pct_change(20)/(downside*np.sqrt(20)+.002)).clip(-20,20); fac.to_csv('scripts/miner_1_20270325_downside_momentum_signal.csv')
def run(h):
 fwd=P.pct_change(h).shift(-h); vals=[];ds=[];ns=[]
 for dt in fac.index:
  z=pd.concat([fac.loc[dt],fwd.loc[dt]],axis=1).dropna()
  if len(z)>=8 and z.iloc[:,0].nunique()>1 and z.iloc[:,1].nunique()>1: vals.append(spearmanr(z.iloc[:,0],z.iloc[:,1]).statistic);ds.append(dt);ns.append(len(z))
 s=pd.Series(vals,index=ds); print(h,'dates',len(s),'avgN',round(np.mean(ns),3),'IC',round(s.mean(),6),'ICIR',round(s.mean()/s.std(ddof=1),6),'hit',round((s>0).mean(),4)); return s
s=run(1); print('coverage',round(fac.notna().sum(axis=1).mean()/15,4),'turnover',round(fac.rank(axis=1,pct=True).diff().abs().mean().mean(),6))
for name,lo,hi in [('2020-22','2020','2022-12-31'),('2023-24','2023','2024-12-31'),('2025-27','2025','2027-03-24')]:
 q=s[(s.index>=lo)&(s.index<=hi)]; print(name,'n',len(q),'IC',round(q.mean(),6),'ICIR',round(q.mean()/q.std(ddof=1),6) if len(q)>1 else None)
run(5);run(10);print('signal_artifact scripts/miner_1_20270325_downside_momentum_signal.csv')

