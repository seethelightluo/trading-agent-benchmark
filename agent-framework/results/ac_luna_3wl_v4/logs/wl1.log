disp=R.rolling(5,min_periods=5).std().mean(axis=1); q=disp.rolling(120,min_periods=60).apply(lambda x:(x<=x[-1]).mean(),raw=True)
F=-R.rolling(5,min_periods=5).sum().mul((0.5+q).clip(.5,1.5),axis=0)
