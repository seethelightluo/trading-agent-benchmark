 import json
from pathlib import Path
import numpy as np
from alphacrafter.sim.utils import (
    register_hook, get_account_dict, get_stock_daily_data, rebalance_to_weights,
)

UNIVERSE = [
    "000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX",
    "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y",
]
FACTOR_WEIGHTS = {"clv": 0.3395, "peer": 0.2612, "reversal": 0.2012, "momentum": 0.1981}
MIN_W, MAX_W = 0.015, 0.16
REBALANCE_EVERY = 10
_seen_date = None
_bars_since_rebalance = REBALANCE_EVERY


def cross_rank(values):
    out = {s: 0.5 for s in UNIVERSE}
    good = sorted((s, float(v)) for s, v in values.items() if np.isfinite(v))
    if len(good) < 2:
        return out
    n = len(good)
    for i, (s, _) in enumerate(good):
        out[s] = (i + 1.0) / n
    return out


def simplex_box(raw):
    """Deterministic full-investment projection into [MIN_W, MAX_W]."""
    w = {s: max(0.0, float(raw.get(s, 0.0))) for s in UNIVERSE}
    z = sum(w.values()) or 1.0
    w = {s: x / z for s, x in w.items()}
    # Repeatedly fix violations and proportionally distribute the remainder.
    fixed = {}
    for _ in range(20):
        changed = False
        for s in UNIVERSE:
            if s in fixed:
                continue
            if w[s] < MIN_W:
                fixed[s] = MIN_W; w[s] = MIN_W; changed = True
            elif w[s] > MAX_W:
                fixed[s] = MAX_W; w[s] = MAX_W; changed = True
        free = [s for s in UNIVERSE if s not in fixed]
        rem = 1.0 - sum(fixed.values())
        if not free:
            break
        base = sum(max(w[s], 1e-12) for s in free)
        for s in free:
            w[s] = rem * w[s] / base
        if not changed:
            break
    z = sum(w.values())
    return {s: float(w[s] / z) for s in UNIVERSE}


@register_hook
def cross_asset_strategy():
    global _seen_date, _bars_since_rebalance
    account = get_account_dict()
    market = {}
    for symbol in UNIVERSE:
        df = get_stock_daily_data(symbol=symbol, days=90)
        if df is None or len(df) < 25:
            continue
        df = df.sort_values("date").reset_index(drop=True)
        close = np.asarray(df["close"], dtype=float)
        high = np.asarray(df["high"], dtype=float)
        low = np.asarray(df["low"], dtype=float)
        ret = close[1:] / np.maximum(close[:-1], 1e-12) - 1.0
        market[symbol] = (close, high, low, ret, str(df.iloc[-1]["date"]))
    if len(market) < 12:
        return

    date = max(v[4] for v in market.values())
    if date != _seen_date:
        _bars_since_rebalance += 1
        _seen_date = date
    if _bars_since_rebalance < REBALANCE_EVERY:
        return

    clv, peer_raw, reversal, momentum, invvol = {}, {}, {}, {}, {}
    five_day = {}
    for symbol, (c, h, l, r, _) in market.items():
        vol = max(float(np.std(r[-20:])), 0.008)
        daily_clv = (2.0 * c - h - l) / np.maximum(h - l, 1e-12)
        clv[symbol] = float(np.mean(daily_clv[-3:]))
        reversal[symbol] = float(-np.mean(r[-5:]))
        momentum[symbol] = float((c[-1] / max(c[-21], 1e-12) - 1.0) / (vol + 0.01))
        five_day[symbol] = float(c[-1] / max(c[-6], 1e-12) - 1.0)
        invvol[symbol] = 1.0 / vol
    peer_median = float(np.median(list(five_day.values())))
    peer_raw = {s: v - peer_median for s, v in five_day.items()}
    ranked = {k: cross_rank(v) for k, v in (
        ("clv", clv), ("peer", peer_raw), ("reversal", reversal), ("momentum", momentum)
    )}
    score = {s: sum(FACTOR_WEIGHTS[k] * ranked[k].get(s, 0.5) for k in FACTOR_WEIGHTS)
             for s in UNIVERSE}

    # Bullish/moderate regime stays diversified. In a confirmed SPX drawdown,
    # rotate toward tradable defensive benchmarks rather than cash.
    spx = market.get("SPX")
    if spx is not None:
        c = spx[0]
        if c[-1] < c[-21] and c[-1] < c[-6]:
            for s in ("XAU", "US10Y", "CN10Y"):
                score[s] += 0.18
            for s in ("BTC", "ETH", "WTI"):
                score[s] = max(0.05, score[s] - 0.10)

    avg_iv = float(np.mean(list(invvol.values()))) or 1.0
    raw = {s: max(0.01, score[s]) * (0.78 + 0.22 * invvol.get(s, avg_iv) / avg_iv)
           for s in UNIVERSE}
    weights = simplex_box(raw)

    values = np.array([score[s] for s in UNIVERSE], dtype=float)
    forecast = {s: float(0.01 * (score[s] - values.mean()) / max(values.std(), 1e-12))
                for s in UNIVERSE}
    factor_ids = []
    try:
        ensemble_path = Path(__file__).parent / "factors" / "factor_ensemble.json"
        ensemble = json.loads(ensemble_path.read_text(encoding="utf-8"))
        factor_ids = [str(x["factor_id"]) for x in ensemble.get("selected_factors", [])
                      if isinstance(x, dict) and x.get("factor_id")][:10]
    except (OSError, ValueError, TypeError, KeyError):
        factor_ids = ["miner_3_clv_1d", "peer_median_leadlag_5d",
                      "short_term_reversal_5d", "miner_2_risk_adjusted_momentum_20d"]

    rebalance_to_weights(weights, forecast_returns=forecast,
                         factor_ids=factor_ids, horizon_days=10)
    _bars_since_rebalance = 0


