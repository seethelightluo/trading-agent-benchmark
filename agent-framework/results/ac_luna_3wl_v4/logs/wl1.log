print('corr_simple_reversal',pd.concat([f.stack(),(-p.pct_change(5)).stack()],axis=1).dropna().corr().iloc[0,1])\n", 'file_path': 'scripts/miner_1_20261217_volnorm_reversal_corrected.py'})
