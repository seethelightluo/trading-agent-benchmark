  ▶️ write_file({'content': 'import json\nfrom pathlib import Path\nimport numpy as np\nfrom alphacrafter.sim.utils import register_hook, get_account_dict, get_stock_daily_data, rebalance_to_weights\n\nUNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]\nCADENCE = 10\nMIN_W, MAX_W = 0.025, 0.12\n_seen_date = None\n_days_since = CADENCE\n\n\ndef rank_cs(values):\n    out = {s: 0.5 for s in UNIVERSE}\n    valid = sorted((s, float(v)) for s, v in values.items() if np.isfinite(v))\n    if len(valid) > 1:\n        for i, (s, _) in enumerate(valid):\n            out[s] = (i + 1.0) / len(valid)\n    elif valid:\n        out[valid[0][0]] = 1.0\n    return out\n\n\ndef project_weights(raw):\n    # Full-investment bounded projection; all 15 tradable assets remain present.\n    w = {s: max(1e-12, float(raw.get(s, 0.0))) for s in UNIVERSE}\n    for _ in range(100):\n        total = sum(w.values())\n        w = {s: v / total for s, v in w.items()}\n        clipped = {s: min(MAX_W, max(MIN_W, v)) for s, v in w.items()}\n        if max(abs(clipped[s] - w[s]) for s in UNIVERSE) < 1e-10:\n            w = clipped\n            break\n        fixed = {s for s in UNIVERSE if clipped[s] in (MIN_W, MAX_W)}\n        free = [s for s in UNIVERSE if s not in fixed]\n        w = clipped\n        if not free:\n            break\n        rem = 1.0 - sum(w[s] for s in fixed)\n        z = sum(w[s] for s in free)\n        for s in free:\n            w[s] *= rem / max(z, 1e-12)\n    total = sum(w.values())\n    return {s: float(w[s] / total) for s in UNIVERSE}\n\n\n@register_hook\ndef cross_asset_strategy():\n    global _seen_date, _days_since\n    get_account_dict()\n    data = {}\n    for symbol in UNIVERSE:\n        df = get_stock_daily_data(symbol=symbol, days=100)\n        if df is None or len(df) < 35:\n            continue\n        df = df.sort_values("date").reset_index(drop=True)\n        close = np.asarray(df["close"], dtype=float)\n        high = np.asarray(df["high"], dtype=float)\n        low = np.asarray(df["low"], dtype=float)\n        ret = close[1:] / np.maximum(close[:-1], 1e-12) - 1.0\n        data[symbol] = (close, high, low, ret, str(df.iloc[-1]["date"]))\n    if len(data) < 12:\n        return\n\n    date = max(x[4] for x in data.values())\n    if date != _seen_date:\n        _seen_date, _days_since = date, _days_since + 1\n    if _days_since < CADENCE:\n        return\n\n    aliases = {\n        "miner_3_clv_1d": "clv",\n        "peer_median_leadlag_5d": "peer",\n        "miner_2_risk_adjusted_momentum_20d": "momentum",\n        "short_term_reversal_5d": "reversal",\n    }\n    default = {"clv": 0.30, "peer": 0.28, "momentum": 0.27, "reversal": 0.15}\n    try:\n        ensemble = json.loads((Path(__file__).parent / "factors" / "factor_ensemble.json").read_text())\n        selected = ensemble.get("selected_factors", [])[:10]\n    except Exception:\n        selected = []\n    weights, factor_ids = {k: 0.0 for k in default}, []\n    for item in selected:\n        key = aliases.get(str(item.get("factor_id", "")))\n        if key:\n            direction = 1.0 if int(item.get("direction", 1)) >= 0 else -1.0\n            weights[key] += max(0.0, float(item.get("weight", 0.0))) * direction\n            factor_ids.append(str(item["factor_id"]))\n    if not any(abs(v) > 0 for v in weights.values()):\n        weights, factor_ids = default.copy(), list(aliases)\n    norm = sum(abs(v) for v in weights.values()) or 1.0\n    weights = {k: v / norm for k, v in weights.items()}\n\n    factors = {k: {} for k in default}\n    invvol = {}\n    for symbol, (c, h, l, r, _) in data.items():\n        vol = max(float(np.std(r[-20:])), 0.008)\n        invvol[symbol] = 1.0 / vol\n        # CLV is deliberately one-day, while reversal and momentum are slower.\n        factors["clv"][symbol] = float((2*c[-1] - h[-1] - l[-1]) / max(h[-1] - l[-1], 1e-12))\n        factors["reversal"][symbol] = -float(np.mean(r[-5:]))\n        factors["momentum"][symbol] = float((c[-1] / max(c[-21], 1e-12) - 1.0) / (vol + 0.01))\n        factors["peer"][symbol] = float(c[-1] / max(c[-6], 1e-12) - 1.0)\n    med = float(np.median(list(factors["peer"].values())))\n    factors["peer"] = {s: v - med for s, v in factors["peer"].items()}\n    ranks = {k: rank_cs(v) for k, v in factors.items()}\n    score = {s: sum(weights[k] * ranks[k].get(s, 0.5) for k in weights) for s in UNIVERSE}\n\n    # High-risk regime: rotate only after both short and medium SPX trends confirm weakness.\n    spx = data.get("SPX")\n    if spx is not None and spx[0][-1] < spx[0][-21] and spx[0][-1] < spx[0][-6]:\n        for s in ("XAU", "US10Y", "CN10Y"):\n            score[s] += 0.22\n        for s in ("BTC", "ETH", "WTI"):\n            score[s] -= 0.14\n\n    mean_iv = float(np.mean(list(invvol.values())))\n    raw = {s: max(0.08, score[s]) * (0.65 + 0.35 * invvol.get(s, mean_iv) / max(mean_iv, 1e-12)) for s in UNIVERSE}\n    target = project_weights(raw)\n    score_arr = np.array([score[s] for s in UNIVERSE], dtype=float)\n    scale = max(float(np.std(score_arr)), 1e-8)\n    center = float(np.mean(score_arr))\n    forecast = {s: float(0.006 * (score[s] - center) / scale) for s in UNIVERSE}\n    rebalance_to_weights(target, forecast_returns=forecast, factor_ids=factor_ids, horizon_days=CADENCE)\n    _days_since = 0\n', 'file_path': 'strategy.py'})
