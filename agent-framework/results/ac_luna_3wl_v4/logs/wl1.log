R=pd.concat(D,axis=1).sort_index(); rows=[]
for w in [10,20,40,60]:
 F=-R.rolling(w,min_periods=max(5,w//2)).std()
 for h in [1,5,10]:
  Y=R.shift(-1).rolling(h).sum().shift(-(h-1)); vals=[]
