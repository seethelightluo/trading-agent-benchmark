 pass\nprint('max_abs_library_correlation',max(cs)[0] if cs else None,sorted(cs,reverse=True)[:5]); print('period',F.index.min().date(),F.index.max().date())\n", 'file_path': 'scripts/miner_3_20261217_gap_reversal.py'})
