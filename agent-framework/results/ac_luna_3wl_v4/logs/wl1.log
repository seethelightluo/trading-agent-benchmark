  ▶️ write_file({'content': 'import json\nfrom pathlib import Path\nimport numpy as np\nfrom alphacrafter.sim.utils import register_hook, get_account_dict, get_stock_daily_data, rebalance_to_weights\n\nUNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]\nCADENCE = 10\nMIN_W, MAX_W = 0.025, 0.12\n_seen_date = None\n_days_since = CADENCE\n\n\ndef cs_rank(values):\n    out = {s: 0.5 for s in UNIVERSE}\n    valid = sorted((s, float(v)) for s, v in values.items() if np.isfinite(v))\n    n = len(valid)\n    if n > 1:\n        for i, (s, _) in enumerate(valid):\n            out[s] = (i + 1.0) / n\n    elif n == 1:\n        out[valid[0][0]] = 1.0\n    return out\n\n\ndef bounded_full_weights(raw):\n    # Iterative water-filling projection: every tradable asset remains invested.\n    w = {s: max(0.0, float(raw.get(s, 0.0))) for s in UNIVERSE}\n    if sum(w.values()) <= 0:\n        w = {s: 1.0 for s in UNIVERSE}\n    for _ in range(100):\n        total = sum(w.values())\n        w = {s: v / total for s, v in w.items()}\n        clipped = {s: min(MAX_W, max(MIN_W, v)) for s, v in w.items()}\n        if max(abs(clipped[s] - w[s]) for s in UNIVERSE) < 1e-10:\n            w = clipped\n            break\n        w = clipped\n        fixed = {s for s in UNIVERSE if w[s] <= MIN_W + 1e-10 or w[s] >= MAX_W - 1e-10}\n        free = [s for s in UNIVERSE if s not in fixed]\n        if not free:\n            break\n        rem = 1.0 - sum(w[s] for s in fixed)\n        z = sum(w[s] for s in free)\n        if z <= 0:\n            break\n        for s in free:\n            w[s] = w[s] * rem / z\n    total = sum(w.values())\n    return {s: float(w[s] / total) for s in UNIVERSE}\n\n\n@register_hook\ndef cross_asset_strategy():\n    global _seen_date, _days_since\n    get_account_dict()  # keeps the hook compatible with online and backtest contexts\n    data = {}\n    for s in UNIVERSE:\n        df = get_stock_daily_data(symbol=s, days=100)\n        if df is None or len(df) < 35:\n            continue\n        df = df.sort_values("date").reset_index(drop=True)\n        c = np.asarray(df["close"], dtype=float)\n        h = np.asarray(df["high"], dtype=float)\n        l = np.asarray(df["low"], dtype=float)\n        r = c[1:] / np.maximum(c[:-1], 1e-12) - 1.0\n        data[s] = (c, h, l, r, str(df.iloc[-1]["date"]))\n    if len(data) < 12:\n        return\n    date = max(v[4] for v in data.values())\n    if date != _seen_date:\n        _seen_date = date\n        _days_since += 1\n    if _days_since < CADENCE:\n        return\n\n    aliases = {"peer_median_leadlag_5d": "peer", "miner_2_risk_adjusted_momentum_20d": "momentum", "miner_3_clv_1d": "clv", "short_term_reversal_5d": "reversal"}\n    default = {"peer": 0.30, "momentum": 0.27, "clv": 0.28, "reversal": 0.15}\n    try:\n        selected = json.loads((Path(__file__).parent / "factors" / "factor_ensemble.json").read_text()).get("selected_factors", [])[:10]\n    except Exception:\n        selected = []\n    fw = {k: 0.0 for k in default}\n    factor_ids = []\n    for item in selected:\n        k = aliases.get(str(item.get("factor_id", "")))\n        if k:\n            fw[k] += max(0.0, float(item.get("weight", 0.0))) * (1.0 if int(item.get("direction", 1)) >= 0 else -1.0)\n            factor_ids.append(str(item["factor_id"]))\n    if sum(abs(v) for v in fw.values()) == 0:\n        fw = default\n        factor_ids = list(aliases)\n    norm = sum(abs(v) for v in fw.values()) or 1.0\n    fw = {k: v / norm for k, v in fw.items()}\n\n    factors = {k: {} for k in default}\n    invvol = {}\n    for s, (c, h, l, r, _) in data.items():\n        vol = max(float(np.std(r[-20:])), 0.008)\n        invvol[s] = 1.0 / vol\n        ranges = np.maximum(h[-3:] - l[-3:], 1e-12)\n        factors["clv"][s] = float(np.mean((2.0 * c[-3:] - h[-3:] - l[-3:]) / ranges))\n        factors["reversal"][s] = -float(np.mean(r[-5:]))\n        factors["momentum"][s] = float((c[-1] / max(c[-21], 1e-12) - 1.0) / (vol + 0.01))\n        factors["peer"][s] = float(c[-1] / max(c[-6], 1e-12) - 1.0)\n    if factors["peer"]:\n        med = float(np.median(list(factors["peer"].values())))\n        factors["peer"] = {s: v - med for s, v in factors["peer"].items()}\n    ranked = {k: cs_rank(v) for k, v in factors.items()}\n    score = {s: sum(fw[k] * ranked[k].get(s, 0.5) for k in fw) for s in UNIVERSE}\n\n    # High-risk bullish consolidation: only rotate defensively after confirmation\n    # from both medium and short SPX trends; never create a cash sleeve.\n    spx = data.get("SPX")\n    if spx is not None and spx[0][-1] < spx[0][-21] and spx[0][-1] < spx[0][-6]:\n        for s in ("XAU", "US10Y", "CN10Y"):\n            score[s] += 0.22\n        for s in ("BTC", "ETH", "WTI"):\n            score[s] -= 0.14\n    mean_inv = float(np.mean(list(invvol.values()))) if invvol else 1.0\n    raw = {s: max(0.08, score[s]) * (0.65 + 0.35 * invvol.get(s, mean_inv) / max(mean_inv, 1e-12)) for s in UNIVERSE}\n    target = bounded_full_weights(raw)\n    arr = np.array([score[s] for s in UNIVERSE], dtype=float)\n    sd = max(float(np.std(arr)), 1e-8)\n    forecast = {s: float(0.006 * (score[s] - float(np.mean(arr))) / sd) for s in UNIVERSE}\n    rebalance_to_weights(target, forecast_returns=forecast, factor_ids=factor_ids, horizon_days=CADENCE)\n    _days_since = 0\n', 'file_path': 'strategy.py'})
