  ▶️ write_file({'content': 'import json\nfrom pathlib import Path\nimport numpy as np\nfrom alphacrafter.sim.utils import register_hook, get_account_dict, get_stock_daily_data, rebalance_to_weights\n\nUNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]\nREBALANCE_EVERY = 10\nMIN_W, MAX_W = 0.015, 0.16\n_seen_date = None\n_bars_since_rebalance = REBALANCE_EVERY\n\n\ndef rank(x):\n    out = {s: 0.5 for s in UNIVERSE}\n    good = sorted((s, float(v)) for s, v in x.items() if np.isfinite(v))\n    if len(good) > 1:\n        for i, (s, _) in enumerate(good):\n            out[s] = (i + 1.0) / len(good)\n    return out\n\n\ndef project(raw):\n    # Projection onto a full-investment simplex with conservative per-asset bounds.\n    w = {s: max(0.0, float(raw.get(s, 0.0))) for s in UNIVERSE}\n    for _ in range(30):\n        free = [s for s in UNIVERSE if MIN_W < w[s] < MAX_W]\n        fixed = {s: w[s] for s in UNIVERSE if s not in free}\n        if not free:\n            break\n        remainder = 1.0 - sum(fixed.values())\n        total = sum(w[s] for s in free) or 1.0\n        nw = dict(fixed)\n        nw.update({s: remainder * w[s] / total for s in free})\n        w = nw\n        if all(MIN_W - 1e-9 <= w[s] <= MAX_W + 1e-9 for s in UNIVERSE):\n            break\n        for s in UNIVERSE:\n            w[s] = min(MAX_W, max(MIN_W, w[s]))\n    z = sum(w.values()) or 1.0\n    return {s: w[s] / z for s in UNIVERSE}\n\n\n@register_hook\ndef cross_asset_strategy():\n    global _seen_date, _bars_since_rebalance\n    account = get_account_dict()\n    market = {}\n    for s in UNIVERSE:\n        df = get_stock_daily_data(symbol=s, days=90)\n        if df is None or len(df) < 25:\n            continue\n        df = df.sort_values("date").reset_index(drop=True)\n        c = np.asarray(df.close, dtype=float)\n        h = np.asarray(df.high, dtype=float)\n        l = np.asarray(df.low, dtype=float)\n        r = c[1:] / np.maximum(c[:-1], 1e-12) - 1.0\n        market[s] = (c, h, l, r, str(df.iloc[-1].date))\n    if len(market) < 12:\n        return\n    date = max(v[4] for v in market.values())\n    if date != _seen_date:\n        _bars_since_rebalance += 1\n        _seen_date = date\n    if _bars_since_rebalance < REBALANCE_EVERY:\n        return\n\n    # Read the persisted ensemble; fallback is only for a missing/invalid file.\n    fallback = {"miner_3_clv_1d": (0.3395, "clv"), "peer_median_leadlag_5d": (0.2612, "peer"),\n                "short_term_reversal_5d": (0.2012, "reversal"), "miner_2_risk_adjusted_momentum_20d": (0.1981, "momentum")}\n    try:\n        data = json.loads((Path(__file__).parent / "factors" / "factor_ensemble.json").read_text())\n        selected = data.get("selected_factors", [])[:10]\n        factors = [(str(x["factor_id"]), float(x.get("weight", 0)), int(x.get("direction", 1))) for x in selected]\n    except Exception:\n        factors = [(k, v[0], 1) for k, v in fallback.items()]\n    aliases = {k: v[1] for k, v in fallback.items()}\n    weights = {aliases.get(fid, fid): w * direction for fid, w, direction in factors if aliases.get(fid, fid) in ("clv", "peer", "reversal", "momentum")}\n    if not weights:\n        weights = {v[1]: v[0] for v in fallback.values()}\n    total = sum(abs(v) for v in weights.values()) or 1.0\n    weights = {k: v / total for k, v in weights.items()}\n\n    clv, reversal, momentum, five, invvol = {}, {}, {}, {}, {}\n    for s, (c, h, l, r, _) in market.items():\n        vol = max(float(np.std(r[-20:])), 0.008)\n        clv[s] = float(np.mean((2*c - h - l)[-3:] / np.maximum((h-l)[-3:], 1e-12)))\n        reversal[s] = -float(np.mean(r[-5:]))\n        momentum[s] = float((c[-1] / max(c[-21], 1e-12) - 1) / (vol + 0.01))\n        five[s] = c[-1] / max(c[-6], 1e-12) - 1\n        invvol[s] = 1.0 / vol\n    median = float(np.median(list(five.values())))\n    peer = {s: v - median for s, v in five.items()}\n    rawf = {"clv": clv, "peer": peer, "reversal": reversal, "momentum": momentum}\n    ranked = {k: rank(v) for k, v in rawf.items()}\n    score = {s: sum(weights.get(k, 0) * ranked[k].get(s, 0.5) for k in ranked) for s in UNIVERSE}\n\n    # Medium-risk bullish posture; only a confirmed two-horizon SPX decline gets defensive.\n    spx = market.get("SPX")\n    if spx is not None and spx[0][-1] < spx[0][-21] and spx[0][-1] < spx[0][-6]:\n        for s in ("XAU", "US10Y", "CN10Y"): score[s] += 0.18\n        for s in ("BTC", "ETH", "WTI"): score[s] = max(0.05, score[s] - 0.10)\n    avg = np.mean(list(invvol.values())) or 1.0\n    raw = {s: max(0.01, score[s]) * (0.78 + 0.22 * invvol.get(s, avg) / avg) for s in UNIVERSE}\n    target = project(raw)\n    vals = np.array([score[s] for s in UNIVERSE])\n    scale = max(float(vals.std()), 1e-12)\n    forecast = {s: float(0.01 * (score[s] - vals.mean()) / scale) for s in UNIVERSE}\n    ids = [fid for fid, _, _ in factors]\n    rebalance_to_weights(target, forecast_returns=forecast, factor_ids=ids, horizon_days=10)\n    _bars_since_rebalance = 0\n', 'file_path': 'strategy.py'})
