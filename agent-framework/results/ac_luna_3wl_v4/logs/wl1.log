l',values='factor').rank(axis=1,pct=True);print('coverage',len(v)/len(x),'turnover',ranks.diff().abs().mean(axis=1).mean())\nv[['date','symbol','factor']].to_csv('scripts/miner_3_20261217_vix_gated_residual_signal.csv',index=False)\n", 'file_path': 'scripts/miner_3_20261217_vix_gated_residual.py'})
