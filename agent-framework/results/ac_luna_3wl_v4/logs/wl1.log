P=pd.DataFrame({s:pd.read_csv('../persistent/stock_data/'+s+'.csv',parse_dates=['date']).set_index('date')['close'] for s in U}).sort_index().ffill();P=P[P.index<=cut];R=P.pct_change();r3=R.rolling(3,min_periods=3).sum();disp=R.std(axis=1).rolling(20,min_periods=15).mean();gate=disp>disp.rolling(120,min_periods=60).median();F=-r3.where(gate,0.0);F=F.sub(F.median(axis=1),axis=0);F.to_csv('scripts/miner_3_20261217_dispersion_conditioned_reversal_signal.csv',index_label='date')
for h in [1,5,10]:
 Y=P.pct_change(h).shift(-h);a=[];ns=[]
 for d in F.index:
  z=pd.concat([F.loc[d].rename('f'),Y.loc[d].rename('y')],axis=1).dropna()
  if len(z)>=8 and z.f.nunique()>1 and z.y.nunique()>1:a.append(spearmanr(z.f,z.y).statistic);ns.append(len(z))
 a=pd.Series(a);print('H',h,'dates',len(a),'avg_names',round(np.mean(ns),2),'IC',round(a.mean(),8),'ICIR',round(a.mean()/a.std(ddof=1),8),'hit',round((a>0).mean(),4))
print('coverage',round(F.notna().sum().sum()/F.size,6),'turnover',round(F.rank(axis=1,pct=True).diff().abs().mean().mean(),6),'period',F.index.min().date(),F.index.max().date())

