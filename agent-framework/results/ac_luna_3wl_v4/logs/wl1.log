  ▶️ write_file({'content': "import numpy as np, pandas as pd\nfrom alphacrafter.sim.utils import get_index_daily_data\nU=['000300.SH','SPX','HSI','N225','SX5E','000688.SH','SOX','NDX','XAU','COPPER','WTI','BTC','ETH','US10Y','CN10Y']\n# One candidate: VIX-regime conditioned short reversal, all signals lagged one day\npx={}\nfor s in U:\n d=get_index_daily_data(s, days=3000)\n if d is not None and len(d):\n  x=d[['date','close']].copy(); x['date']=pd.to_datetime(x.date); px[s]=x.set_index('date').close\np=pd.DataFrame(px).sort_index().ffill()\nv=pd.read_csv('../persistent/index_data/VIX.csv',parse_dates=['date']).set_index('date')['close'].reindex(p.index).ffill()\n# VIX percentile based only through t, then factor available t+1 by shift\nvp=v.rolling(126,min_periods=63).rank(pct=True)\nr3=p.pct_change(3); disp=r3.mad(axis=1) if hasattr(r3,'mad') else r3.sub(r3.median(axis=1),axis=0).abs().mean(axis=1)\n# high VIX amplification, smooth bounded, factor is negative recent return\nf=(-r3).mul((0.5+vp).clip(0.5,1.5),axis=0).shift(1)\n# forward returns\nrows=[]\nfor h in [1,5,10]:\n fr=p.shift(-h)/p-1\n ics=[]; dates=[]; n=[]; turnover=[]; prev=None\n for dt in f.index:\n  a=f.loc[dt]; b=fr.loc[dt]; ok=a.notna()&b.notna()\n  if ok.sum()>=8:\n   ic=a[ok].rank().corr(b[ok].rank()); ics.append(ic); dates.append(dt); n.append(ok.sum())\n   ranks=a[ok].rank(pct=True)\n   if prev is not None: turnover.append(np.mean(abs(ranks-prev)))\n   prev=ranks\n x=np.array(ics); print('horizon',h,'dates',len(x),'avg_n',np.mean(n),'IC',np.mean(x),'ICIR',np.mean(x)/(np.std(x,ddof=1)+1e-12),'hit',np.mean(x>0),'turn',np.mean(turnover) if turnover else np.nan)\nprint('period',p.index.min(),p.index.max(),'assets',len(p.columns),'coverage',f.notna().sum(axis=1).mean()/len(U))\n# save artifact for provenance\nout=f.stack().rename('signal').reset_index(); out.columns=['date','symbol','signal']; out.to_csv('scripts/miner_1_20261217_vix_reversal_signal.csv',index=False)\n", 'file_path': 'scripts/miner_1_20261217_vix_reversal.py'})
