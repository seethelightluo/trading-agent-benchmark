 x=np.array(ic);print('w',w,'dates',len(x),'N',round(np.mean(ns),2),'cov',round(np.mean(ns)/15,3),'IC',round(x.mean(),5),'ICIR',round(x.mean()/x.std(ddof=1),5),'hit',round((x>0).mean(),4),'turn',round(np.nanmean(np.abs(f.rank(pct=True,axis=1).diff()).mean(axis=1)),4))
