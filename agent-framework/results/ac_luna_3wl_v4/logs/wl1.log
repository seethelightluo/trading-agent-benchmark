  ▶️ write_file({'content': "import pandas as pd, numpy as np\nfrom scipy.stats import spearmanr\nfrom pathlib import Path\nU=['000300.SH','SPX','HSI','N225','SX5E','000688.SH','SOX','NDX','XAU','COPPER','WTI','BTC','ETH','US10Y','CN10Y']\nend=pd.Timestamp('2026-12-16')\nseries={}\nfor s in U:\n d=pd.read_csv('../persistent/stock_data/'+s+'.csv',parse_dates=['date']).sort_values('date')\n d=d[d.date<=end].set_index('date'); r=d.close.pct_change()\n # Trend efficiency: directional 20d return divided by path length; damp with 5d return sign\n net=d.close.pct_change(20)\n path=r.abs().rolling(20).sum()\n eff=net/path\n # factor is signed efficiency, with recent 5d confirmation (interpretable)\n fac=eff * np.sign(d.close.pct_change(5))\n fwd=d.close.shift(-1)/d.close-1\n series[s]=pd.DataFrame({'f':fac,'y':fwd})\n# aligned cross-sectional IC\nrows=[]\nfor dt in sorted(set().union(*[x.index for x in series.values()])):\n a=pd.DataFrame({s:series[s].loc[dt] for s in U if dt in series[s].index}).T.dropna()\n if len(a)>=8: rows.append((dt,spearmanr(a.f,a.y).statistic,len(a)))\nq=pd.DataFrame(rows,columns=['date','ic','n']).set_index('date')\nprint('candidate=confirmed_trend_efficiency; end',end.date(),'dates',len(q),'avg_n',q.n.mean(),'coverage',q.n.sum()/(len(q)*15))\nfor h in [1,5,10]:\n rows=[]\n for dt in sorted(set().union(*[x.index for x in series.values()])):\n  vals={}\n  for s in U:\n   if dt not in series[s].index: continue\n   d=pd.read_csv('../persistent/stock_data/'+s+'.csv',parse_dates=['date']).sort_values('date').set_index('date')\n   if dt not in d.index or dt>end: continue\n   f=series[s].loc[dt,'f']; y=d.close.shift(-h).get(dt)/d.close.get(dt)-1\n   if pd.notna(f) and pd.notna(y): vals[s]=(f,y)\n  if len(vals)>=8: rows.append(spearmanr([v[0] for v in vals.values()],[v[1] for v in vals.values()]).statistic)\n z=pd.Series(rows).dropna(); print('horizon',h,'dates',len(z),'IC',z.mean(),'ICIR',z.mean()/z.std(ddof=1),'hit', (z>0).mean())\nprint('year ICIR')\nprint(q.groupby(q.index.year).ic.agg(['mean','std']).assign(icir=lambda x:x['mean']/x['std']).round(4))\n# turnover rank\nmat=pd.DataFrame({s:series[s].f for s in U}).loc[q.index]; ranks=mat.rank(axis=1,pct=True); print('turnover',ranks.diff().abs().mean(axis=1).mean())\n", 'file_path': 'scripts/miner_1_20261217_trend_efficiency.py'})
