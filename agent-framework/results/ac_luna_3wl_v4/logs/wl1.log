(drop=True)\n        c = np.asarray(df.close, dtype=float)\n        h = np.asarray(df.high, dtype=float)\n        l = np.asarray(df.low, dtype=float)\n        r = c[1:] / np.maximum(c[:-1], 1e-12) - 1.0\n        data[s] = (c, h, l, r, str(df.iloc[-1].date))\n    if len(data) < 12:\n        return\n    d = max(x[4] for x in data.values())\n    if d != _last_date:\n        _last_date, _days = d, _days + 1\n    if _days < CADENCE:\n        return\n\n    aliases = {"miner_3_clv_1d":"clv", "peer_median_leadlag_5d":"peer",\n               "miner_2_risk_adjusted_momentum_20d":"momentum", "short_term_reversal_5d":"reversal"}\n    ens = {"selected_factors": []}\n    try:\n        ens = json.loads((Path(__file__).parent / "factors" / "factor_ensemble.json").read_text())\n    except Exception:\n        pass\n    fw = {k: 0.0 for k in aliases.values()}\n    ids = []\n    for item in ens.get("selected_factors", [])[:10]:\n        k = aliases.get(str(item.get("factor_id", "")))\n        if k:\n            fw[k] += max(0.0, float(item.get("weight", 0.0))) * (1 if int(item.get("direction", 1)) >= 0 else -1)\n            ids.append(str(item.get("factor_id")))\n    if sum(abs(v) for v in fw.values()) == 0:\n        fw = {"clv": .378, "peer": .291, "momentum": .221, "reversal": .110}\n        ids = list(aliases)\n    z = sum(abs(v) for v in fw.values())\n    fw = {k: v / z for k, v in fw.items()}\n\n    f = {k: {} for k in fw}\n    iv = {}\n    for s, (c, h, l, r, _) in data.items():\n        vol = max(float(np.std(r[-20:])), 0.008)\n        iv[s] = 1.0 / vol\n        f["clv"][s] = (2*c[-1] - h[-1] - l[-1]) / max(h[-1] - l[-1], 1e-12)\n        f["peer"][s] = c[-1] / max(c[-6], 1e-12) - 1.0\n        f["momentum"][s] = (c[-1] / max(c[-21], 1e-12) - 1.0) / (vol + .01)\n        f["reversal"][s] = -float(np.mean(r[-5:]))\n    med = float(np.median(list(f["peer"].values())))\n    f["peer"] = {s: v - med for s, v in f["peer"].items()}\n    ranks = {k: cs_rank(v) for k, v in f.items()}\n    score = {s: sum(fw[k] * ranks[k].get(s, .5) for k in fw) for s in UNIVERSE}\n\n    # Elevated-risk bullish consolidation: defensive tilt only on confirmed dual-horizon weakness.\n    spx = data.get("SPX")\n    if spx and spx[0][-1] < spx[0][-6] and spx[0][-1] < spx[0][-21]:\n        for s in ("XAU", "US10Y", "CN10Y"): score[s] += .22\n        for s in ("BTC", "ETH", "WTI"): score[s] -= .14\n    mean_iv = float(np.mean(list(iv.values())))\n    raw = {s: max(.08, score[s]) * (.65 + .35 * iv.get(s, mean_iv) / max(mean_iv, 1e-12)) for s in UNIVERSE}\n    target = bounded_weights(raw)\n    arr = np.array([score[s] for s in UNIVERSE])\n    scale = max(float(np.std(arr)), 1e-8)\n    center = float(np.mean(arr))\n    forecast = {s: float(.006 * (score[s] - center) / scale) for s in UNIVERSE}\n    rebalance_to_weights(target, forecast_returns=forecast, factor_ids=ids, horizon_days=CADENCE)\n    _days = 0\n', 'file_path': 'strategy.py'})
