  ▶️ write_file({'content': "import numpy as np,pandas as pd\nU=['000300.SH','SPX','HSI','N225','SX5E','000688.SH','SOX','NDX','XAU','COPPER','WTI','BTC','ETH','US10Y','CN10Y']\ncut=pd.Timestamp('2026-12-17'); base='../persistent/stock_data'\n# Intraday reversal: fade prior session open-to-close move, scaled by prior true range relative to lagged 20d median range.\nframes={}\nfor s in U:\n d=pd.read_csv(f'{base}/{s}.csv',parse_dates=['date']).set_index('date').sort_index().loc[:cut]\n frames[s]=d\nO=pd.DataFrame({s:frames[s].open for s in U}); C=pd.DataFrame({s:frames[s].close for s in U}); H=pd.DataFrame({s:frames[s].high for s in U}); L=pd.DataFrame({s:frames[s].low for s in U})\nintra=O/C*0 # align\nintra=C/O-1\nrng=(H-L)/C.shift(1)\nmed=rng.shift(1).rolling(20,min_periods=10).median()\n# lag all inputs one day: signal at d uses d-1 data via shift\nf=-(intra.shift(1))*((rng.shift(1)/med).clip(.5,2.0))\n# Winsorize cross-section to reduce crypto extremes\nf=f.clip(f.quantile(.05,axis=1),f.quantile(.95,axis=1),axis=0)\nfor h in [1,5,10]:\n y=C.shift(-h)/C-1; rows=[]\n for d in C.index:\n  q=pd.concat([f.loc[d].rename('f'),y.loc[d].rename('y')],axis=1).dropna()\n  if len(q)>=8: rows.append((d,q.f.corr(q.y),len(q)))\n a=pd.DataFrame(rows,columns=['date','ic','n']).set_index('date'); ic=a.ic\n print('H',h,'dates',len(ic),'avgN',a.n.mean(),'IC',ic.mean(),'ICIR',ic.mean()/ic.std(ddof=1),'hit',(ic>0).mean())\n if h==1:\n  for yr,g in ic.groupby(ic.index.year): print('YR',yr,len(g),round(g.mean(),5),round(g.mean()/g.std(ddof=1),4))\nprint('coverage',f.notna().sum().sum()/f.size,'turnover',f.rank(axis=1,pct=True).diff().abs().mean().mean())\nf.to_csv('scripts/miner_2_20261217_intraday_range_reversal_signal.csv',index_label='date')\nprint('ARTIFACT scripts/miner_2_20261217_intraday_range_reversal_signal.csv')\n", 'file_path': 'scripts/miner_2_20261217_intraday_range_reversal.py'})
