  q=pd.Series(vals).dropna(); print('w,h',w,h,'IC %.5f ICIR %.5f hit %.3f dates %d'%(q.mean(),q.mean()/q.std(ddof=1), (q>0).mean(),len(q)))
print('cut',R.index.max(),'instruments',len(U))


