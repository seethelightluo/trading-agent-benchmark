for label,fac in [('lowvol',f),('shock_resilience',r.rolling(20,min_periods=15).quantile(.2))]:
 for h in [1,5,10]:
  q=[]; ns=[]
  yy=p.pct_change(h).shift(-h)
  for i in range(30,len(p)-h):
   z=pd.concat([fac.iloc[i],yy.iloc[i]],axis=1).dropna()
