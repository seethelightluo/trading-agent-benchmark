from alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights

UNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
FACTORS = {"volstate_rev": 0.32, "peer": 0.20, "lowvol_rev": 0.18,
           "resid20": 0.10, "idio_rev": 0.08, "eq_resid40": 0.06,
           "clv": 0.06}
REBALANCE_DAYS = 10
MIN_W, MAX_W = 0.03, 0.15
_previous = None
_day = 0


def rank_factor(values):
    valid = sorted((s, float(v)) for s, v in values.items() if np.isfinite(v))
    out = {s: 0.5 for s in UNIVERSE}
    n = len(valid)
    for i, (s, _) in enumerate(valid):
        out[s] = (i + 1.0) / n
    return out


def project_weights(raw):
    # Euclidean-free capped proportional projection; all 15 assets remain invested.
    active, fixed = set(UNIVERSE), {}
    for _ in range(30):
        left = 1.0 - sum(fixed.values())
        denom = sum(max(float(raw.get(s, 0.05)), 1e-9) for s in active)
        trial = {s: left * max(float(raw.get(s, 0.05)), 1e-9) / denom for s in active}
        clipped = False
        for s, w in list(trial.items()):
            if w < MIN_W:
                fixed[s] = MIN_W; active.remove(s); clipped = True
            elif w > MAX_W:
                fixed[s] = MAX_W; active.remove(s); clipped = True
        if not clipped:
            fixed.update(trial)
            break
    total = sum(fixed.values())
    return {s: max(0.0, fixed.get(s, 0.0) / total) for s in UNIVERSE}


@register_hook
def cross_asset_strategy():
    global _day, _previous
    _day += 1
    if _day != 1 and (_day - 1) % REBALANCE_DAYS != 0:
        return

    ret, vol, bar = {}, {}, {}
    for s in UNIVERSE:
        df = get_stock_daily_data(symbol=s, days=230)
        if df is None or len(df) < 70:
            continue
        df = df.sort_values("date")
        c = np.asarray(df["close"], dtype=float)
        if np.any(~np.isfinite(c[-70:])) or np.any(c[-70:] <= 0):
            continue
        r = c[1:] / c[:-1] - 1.0
        ret[s] = r
        vol[s] = max(float(np.std(r[-20:])), 0.006)
        bar[s] = df.iloc[-1]
    if len(ret) < 10:
        return

    r1 = {s: r[-1] for s, r in ret.items()}
    r5 = {s: float(np.prod(1 + r[-5:]) - 1) for s, r in ret.items()}
    r10 = {s: float(np.prod(1 + r[-10:]) - 1) for s, r in ret.items()}
    r20 = {s: float(np.prod(1 + r[-20:]) - 1) for s, r in ret.items()}
    r40 = {s: float(np.prod(1 + r[-40:]) - 1) for s, r in ret.items()}
    peer = list(ret)
    eq = [s for s in UNIVERSE[:8] if s in ret]
    eq_median = float(np.median([r40[s] for s in eq])) if eq else 0.0
    breadth = float(np.mean([r20[s] > 0 for s in ret]))
    stress = breadth < 0.50 or float(np.median(list(r10.values()))) < 0.0 or float(np.median(list(vol.values()))) > 0.018

    f = {k: {} for k in FACTORS}
    for s in ret:
        v = vol[s]
        peer5 = float(np.median([r5[t] for t in peer if t != s]))
        reversal = -r1[s] / (v + 0.006)
        f["lowvol_rev"][s] = reversal
        f["volstate_rev"][s] = reversal * (1.0 + min(v / 0.02, 1.0))
        f["peer"][s] = r5[s] - peer5
        f["resid20"][s] = (r20[s] - peer5) / (v * np.sqrt(20.0) + 0.01)
        f["eq_resid40"][s] = (r40[s] - eq_median) / (v * np.sqrt(40.0) + 0.02)
        f["idio_rev"][s] = reversal - (r5[s] - peer5) / (v + 0.01)
        h, lo, cl = float(bar[s].get("high", 0)), float(bar[s].get("low", 0)), float(bar[s]["close"])
        f["clv"][s] = (2.0 * cl - h - lo) / (h - lo) if h > lo else 0.0

    score = {s: sum(w * rank_factor(f[k])[s] for k, w in FACTORS.items()) for s in UNIVERSE}
    if _previous is not None:
        score = {s: 0.50 * score[s] + 0.50 * _previous.get(s, 0.5) for s in UNIVERSE}
    _previous = score.copy()

    defensive = {"XAU", "US10Y", "CN10Y"}
    invmean = float(np.mean([1.0 / v for v in vol.values()]))
    raw = {}
    for s in UNIVERSE:
        invvol = min((1.0 / vol.get(s, 0.02)) / invmean, 1.20)
        raw[s] = max(score[s], 0.05) * (0.90 + 0.10 * invvol)
        if stress and s in defensive:
            raw[s] *= 1.85
        elif stress and r20.get(s, 0.0) < -0.08:
            raw[s] *= 0.75
    target = project_weights(raw)
    if len(target) == 15 and abs(sum(target.values()) - 1.0) < 1e-8:
        rebalance_to_weights(target)


