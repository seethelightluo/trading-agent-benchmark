 import numpy as np
from alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights

UNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
# Current Screener ensemble (five active factors, all positive direction).
FACTORS = {"lowvol_rev1": 0.28, "clv": 0.25, "peer": 0.20, "momentum20": 0.17, "reversal5": 0.10}
REBALANCE_EVERY = 10
MIN_WEIGHT, MAX_WEIGHT = 0.02, 0.14
_calls = 0

def rank(values):
    valid = sorted((s, float(v)) for s, v in values.items() if np.isfinite(v))
    out = {s: 0.5 for s in UNIVERSE}
    n = len(valid)
    for i, (s, _) in enumerate(valid):
        out[s] = (i + 1.0) / n if n > 1 else 0.5
    return out

def bounded_simplex(raw):
    # Box-constrained, full-investment projection; fractional weights are deliberate.
    w = {s: max(float(raw.get(s, 1.0)), 1e-10) for s in UNIVERSE}
    fixed = {}
    free = set(UNIVERSE)
    for _ in range(40):
        left = 1.0 - sum(fixed.values())
        scale = left / max(sum(w[s] for s in free), 1e-12)
        clipped = []
        for s in list(free):
            q = w[s] * scale
            if q < MIN_WEIGHT:
                fixed[s] = MIN_WEIGHT; clipped.append(s)
            elif q > MAX_WEIGHT:
                fixed[s] = MAX_WEIGHT; clipped.append(s)
            else:
                w[s] = q
        if not clipped:
            break
        free -= set(clipped)
    if free:
        left = 1.0 - sum(fixed.values())
        z = sum(w[s] for s in free)
        for s in free:
            w[s] = left * w[s] / max(z, 1e-12)
    w.update(fixed)
    z = sum(w.values())
    return {s: w[s] / z for s in UNIVERSE}

@register_hook
def cross_asset_strategy():
    global _calls
    _calls += 1
    if _calls > 1 and (_calls - 1) % REBALANCE_EVERY != 0:
        return
    one_day, clv, peer, mom, rev5, vol = {}, {}, {}, {}, {}, {}
    for symbol in UNIVERSE:
        df = get_stock_daily_data(symbol=symbol, days=90)
        if df is None or len(df) < 26:
            continue
        df = df.sort_values("date").reset_index(drop=True)
        c = np.asarray(df["close"], dtype=float)
        h = np.asarray(df["high"], dtype=float)
        l = np.asarray(df["low"], dtype=float)
        if not np.all(np.isfinite(c[-26:])) or c[-1] <= 0:
            continue
        d = c[1:] / np.maximum(c[:-1], 1e-12) - 1.0
        sigma = max(float(np.std(d[-20:])), 0.008)
        one_day[symbol] = float(d[-1])
        vol[symbol] = sigma
        # CLV is neutralized by cross-sectional ranking; bad/missing ranges are neutral.
        span = h[-1] - l[-1]
        clv[symbol] = float((c[-1] - l[-1]) / span) if np.isfinite(span) and span > 0 else 0.5
        rev5[symbol] = -float(c[-1] / max(c[-6], 1e-12) - 1.0)
        # Volatility-scaled one-day reversal, damped to avoid noisy extremes.
        lowvol_rev = -float(d[-1]) / sigma
        one_day[symbol] = lowvol_rev
        mom[symbol] = float((c[-1] / max(c[-21], 1e-12) - 1.0) / (sigma + 0.01))
    if len(vol) < 8:
        return
    # Leave-one-out peer lead-lag proxy, using only completed daily observations.
    rets = {s: mom[s] * (vol[s] + 0.01) for s in vol}
    for s in vol:
        others = [rets[t] for t in vol if t != s]
        peer[s] = rets[s] - float(np.median(others)) if others else 0.0
    ranks_all = {"lowvol_rev1": rank(one_day), "clv": rank(clv),
                 "peer": rank(peer), "momentum20": rank(mom), "reversal5": rank(rev5)}
    score = {s: sum(FACTORS[k] * ranks_all[k][s] for k in FACTORS) for s in vol}
    # Bullish but medium-high risk: retain cyclicals, add only a modest defensive overlay
    # when breadth deteriorates. Full investment is maintained in all regimes.
    breadth = float(np.mean([rets[s] > 0 for s in vol]))
    defensive = {"XAU", "US10Y", "CN10Y"}
    cyclical = set(UNIVERSE) - defensive
    tilt = {s: 1.0 for s in UNIVERSE}
    if breadth < 0.40:
        for s in cyclical: tilt[s] = 0.88
        for s in defensive: tilt[s] = 1.35
    elif breadth < 0.55:
        for s in cyclical: tilt[s] = 0.95
        for s in defensive: tilt[s] = 1.15
    avg_inv = np.mean([1.0 / vol[s] for s in vol])
    raw = {}
    for s in UNIVERSE:
        base = max(score.get(s, 0.5), 0.05)
        iv = (1.0 / vol[s]) / max(avg_inv, 1e-12) if s in vol else 1.0
        raw[s] = base * tilt[s] * (0.90 + 0.10 * min(iv, 2.0))
    rebalance_to_weights(bounded_simplex(raw))


