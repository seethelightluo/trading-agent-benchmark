  ▶️ write_file({'content': 'import numpy as np\nfrom alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights\n\nUNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]\nFACTORS = {"smooth_rev5": 0.28, "intraday_rev": 0.18, "medium_rev10": 0.16,\n           "momentum120": 0.16, "volume_rev": 0.12, "downside_rev": 0.10}\nCADENCE = 10\nMIN_W, MAX_W = 0.035, 0.14\nDEFENSIVE = {"XAU", "US10Y", "CN10Y"}\n_day = 0\n_previous = None\n\n\ndef rank_cross(x):\n    good = sorted((s, float(v)) for s, v in x.items() if np.isfinite(v))\n    out = {s: 0.5 for s in UNIVERSE}\n    n = len(good)\n    for i, (s, _) in enumerate(good):\n        out[s] = (i + 1.0) / n\n    return out\n\n\ndef bounded(raw):\n    fixed, active = {}, set(UNIVERSE)\n    for _ in range(50):\n        left = 1.0 - sum(fixed.values())\n        denom = sum(max(float(raw.get(s, 0.01)), 1e-8) for s in active)\n        trial = {s: left * max(float(raw.get(s, 0.01)), 1e-8) / denom for s in active}\n        changed = False\n        for s, w in list(trial.items()):\n            if w < MIN_W:\n                fixed[s] = MIN_W; active.remove(s); changed = True\n            elif w > MAX_W:\n                fixed[s] = MAX_W; active.remove(s); changed = True\n        if not changed:\n            fixed.update(trial)\n            break\n    z = sum(fixed.get(s, 0.0) for s in UNIVERSE)\n    return {s: fixed.get(s, 0.0) / z for s in UNIVERSE}\n\n\n@register_hook\ndef cross_asset_strategy():\n    global _day, _previous\n    _day += 1\n    if _day != 1 and (_day - 1) % CADENCE != 0:\n        return\n\n    data = {}\n    for s in UNIVERSE:\n        df = get_stock_daily_data(symbol=s, days=250)\n        if df is None or len(df) < 145:\n            continue\n        df = df.sort_values("date")\n        c = np.asarray(df["close"], dtype=float)\n        if np.any(~np.isfinite(c)) or np.any(c <= 0):\n            continue\n        r = c[1:] / c[:-1] - 1.0\n        hi = np.asarray(df["high"], dtype=float)\n        lo = np.asarray(df["low"], dtype=float)\n        op = np.asarray(df["open"], dtype=float)\n        volu = np.asarray(df["volume"], dtype=float) if "volume" in df else np.ones(len(df))\n        rv = max(float(np.std(r[-30:])), 0.006)\n        downside = max(float(np.std(np.minimum(r[-40:], 0.0))), 0.004)\n        # All signals use completed observations only (the final row is the latest completed bar).\n        h5 = float(np.prod(1 + r[-5:]) - 1)\n        h10 = float(np.prod(1 + r[-10:]) - 1)\n        h120 = float(np.prod(1 + r[-120:]) - 1)\n        intraday = float(np.nanmean((c[-5:] - op[-5:]) / np.maximum(op[-5:], 1e-12)))\n        vr = float(np.nanmean(volu[-5:]) / max(np.nanmean(volu[-30:]), 1e-9))\n        data[s] = {"r": r, "rv": rv, "down": downside, "h5": h5, "h10": h10,\n                   "h120": h120, "intraday": intraday, "vr": vr}\n    if len(data) < 10:\n        return\n\n    syms = list(data)\n    fac = {k: {} for k in FACTORS}\n    med5 = np.median([data[s]["h5"] for s in syms])\n    med10 = np.median([data[s]["h10"] for s in syms])\n    for s in syms:\n        d = data[s]\n        # Reversal is volatility-scaled and deliberately smooth/cadence-compatible.\n        fac["smooth_rev5"][s] = (med5 - d["h5"]) / (d["rv"] * np.sqrt(5) + 0.01)\n        fac["intraday_rev"][s] = -d["intraday"] / (d["rv"] + 0.01)\n        fac["medium_rev10"][s] = (med10 - d["h10"]) / (d["rv"] * np.sqrt(10) + 0.01)\n        fac["momentum120"][s] = d["h120"] / (d["rv"] * np.sqrt(120) + 0.03)\n        fac["volume_rev"][s] = (med5 - d["h5"]) / (d["rv"] * np.sqrt(5) + 0.01) * (0.8 + 0.2 * np.clip(d["vr"], 0, 2))\n        fac["downside_rev"][s] = (med5 - d["h5"]) / (d["down"] * np.sqrt(5) + 0.01)\n\n    score = {s: sum(w * rank_cross(fac[k]).get(s, 0.5) for k, w in FACTORS.items()) for s in UNIVERSE}\n    if _previous is not None:\n        score = {s: 0.40 * score[s] + 0.60 * _previous.get(s, 0.5) for s in UNIVERSE}\n    _previous = score.copy()\n\n    breadth = np.mean([data[s]["h120"] > 0 for s in syms])\n    high_risk = breadth < 0.50 or np.median([d["rv"] for d in data.values()]) > 0.018\n    inv_mean = np.mean([1.0 / d["rv"] for d in data.values()])\n    raw = {}\n    for s in UNIVERSE:\n        d = data.get(s, {"rv": 0.02, "h120": 0.0})\n        invvol = (1.0 / d["rv"]) / inv_mean\n        raw[s] = max(score[s], 0.08) * (0.90 + 0.10 * min(invvol, 1.25))\n        if high_risk and s in DEFENSIVE:\n            raw[s] *= 2.70\n        elif high_risk and d["h120"] < -0.10:\n            raw[s] *= 0.60\n    target = bounded(raw)\n    if all(np.isfinite(target[s]) and target[s] >= 0 for s in UNIVERSE) and abs(sum(target.values()) - 1.0) < 1e-8:\n        rebalance_to_weights(target)\n', 'file_path': 'strategy.py'})
