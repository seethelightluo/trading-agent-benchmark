  ▶️ write_file({'content': 'import numpy as np\nfrom alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights\n\nUNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]\nFACTORS = {"peer5": 0.20, "mom20": 0.16, "clv": 0.16, "lowvol": 0.16,\n           "stress": 0.10, "beta5": 0.10, "rev3": 0.07, "beta2": 0.05}\nREBALANCE_EVERY = 10\nMIN_WEIGHT, MAX_WEIGHT = 0.02, 0.14\n_calls = 0\n\n\ndef xrank(values):\n    valid = sorted((s, float(v)) for s, v in values.items() if np.isfinite(v))\n    out = {s: 0.5 for s in UNIVERSE}\n    if not valid:\n        return out\n    for i, (s, _) in enumerate(valid):\n        out[s] = (i + 1.0) / len(valid)\n    return out\n\n\ndef bounded(raw):\n    # Water-filling keeps every tradable asset represented and sums exactly to one.\n    base = {s: max(float(raw.get(s, 0.0)), 1e-9) for s in UNIVERSE}\n    fixed, active = {}, set(UNIVERSE)\n    for _ in range(40):\n        left = 1.0 - sum(fixed.values())\n        den = sum(base[s] for s in active)\n        trial = {s: left * base[s] / den for s in active}\n        clipped = False\n        for s, w in list(trial.items()):\n            if w < MIN_WEIGHT:\n                fixed[s] = MIN_WEIGHT; active.remove(s); clipped = True\n            elif w > MAX_WEIGHT:\n                fixed[s] = MAX_WEIGHT; active.remove(s); clipped = True\n        if not clipped:\n            fixed.update(trial)\n            break\n    z = sum(fixed.values())\n    return {s: fixed.get(s, 0.0) / z for s in UNIVERSE}\n\n\n@register_hook\ndef cross_asset_strategy():\n    global _calls\n    _calls += 1\n    if _calls != 1 and (_calls - 1) % REBALANCE_EVERY != 0:\n        return\n\n    raw = {k: {} for k in FACTORS}\n    returns, vols, mom = {}, {}, {}\n    for s in UNIVERSE:\n        df = get_stock_daily_data(symbol=s, days=130)\n        if df is None or len(df) < 35:\n            continue\n        df = df.sort_values("date").reset_index(drop=True)\n        c = np.asarray(df["close"], dtype=float)\n        o = np.asarray(df["open"], dtype=float)\n        h = np.asarray(df["high"], dtype=float)\n        l = np.asarray(df["low"], dtype=float)\n        if np.any(~np.isfinite(c[-35:])) or np.any(c[-35:] <= 0):\n            continue\n        r = c[1:] / c[:-1] - 1.0\n        v = max(float(np.nanstd(r[-20:])), 0.008)\n        returns[s], vols[s] = r, v\n        mom[s] = c[-1] / c[-21] - 1.0\n        span = h[-1] - l[-1]\n        raw["clv"][s] = -(c[-1] - o[-1]) / span if np.isfinite(span) and span > 0 else 0.0\n        shock = np.clip(abs(r[-1]) / v, 0.5, 2.0)\n        raw["lowvol"][s] = -r[-1] / v\n        raw["stress"][s] = -r[-1] / v * shock\n        raw["mom20"][s] = mom[s] / (v * np.sqrt(20.0) + 0.01)\n\n    if len(returns) < 8:\n        return\n    for s, r in returns.items():\n        peers = [t for t in returns if t != s]\n        def cum(t, n):\n            return np.prod(1.0 + returns[t][-n:]) - 1.0\n        med5 = float(np.median([cum(t, 5) for t in peers]))\n        med3 = float(np.median([cum(t, 3) for t in peers]))\n        med2 = float(np.median([cum(t, 2) for t in peers]))\n        own5, own3, own2 = cum(s, 5), cum(s, 3), cum(s, 2)\n        # Lead-lag rewards relative leadership; residual factors mean-revert it.\n        raw["peer5"][s] = own5 - med5\n        raw["beta5"][s] = -(own5 - med5) / (vols[s] * np.sqrt(5.0) + 0.005)\n        raw["rev3"][s] = -(own3 - med3) / (vols[s] * np.sqrt(3.0) + 0.005)\n        raw["beta2"][s] = -(own2 - med2) / (vols[s] * np.sqrt(2.0) + 0.005)\n\n    ranks = {k: xrank(v) for k, v in raw.items()}\n    score = {s: sum(FACTORS[k] * ranks[k][s] for k in FACTORS) for s in UNIVERSE}\n    breadth = np.mean([mom[s] > 0 for s in mom])\n    market_vol = float(np.median(list(vols.values())))\n    risk = market_vol > 0.018 or breadth < 0.45\n    avg_inv = np.mean([1.0 / v for v in vols.values()])\n    defensive = {"XAU", "US10Y", "CN10Y"}\n    target = {}\n    for s in UNIVERSE:\n        inv = min((1.0 / vols.get(s, market_vol)) / avg_inv, 1.5)\n        tilt = 1.12 if risk and s in defensive else 1.0\n        target[s] = max(score[s], 0.05) * (0.85 + 0.15 * inv) * tilt\n    rebalance_to_weights(bounded(target))\n', 'file_path': 'strategy.py'})Traceback (most recent call last):
