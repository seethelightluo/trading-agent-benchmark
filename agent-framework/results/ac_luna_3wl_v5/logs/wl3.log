  ▶️ write_file({'content': "import numpy as np, pandas as pd\nfrom alphacrafter.sim.utils import get_stock_daily_data, get_index_daily_data, get_account_dict\nU=['000300.SH','SPX','HSI','N225','SX5E','000688.SH','SOX','NDX','XAU','COPPER','WTI','BTC','ETH','US10Y','CN10Y']\ndef fetch(s):\n d=get_stock_daily_data(s,4000)\n if d is None or len(d)==0: d=get_index_daily_data(s,4000)\n return d\nrows=[]\nfor s in U:\n d=fetch(s)\n if d is None: continue\n d=d.copy(); d['date']=pd.to_datetime(d['date']); d=d.set_index('date').sort_index()\n # Intraday candle pressure: close location within range, scaled by true range history; lagged\n rng=(d.high-d.low).replace(0,np.nan)\n atr=(d.high-d.low).rolling(20,min_periods=10).mean()\n pressure=((d.close-d.open)/rng).clip(-3,3) * (rng/atr).clip(0,4)\n # Factor available at t, tested vs t+1 return\n fr=d.close.shift(-1)/d.close-1\n for dt,v in pd.concat([pressure.rename('f'),fr.rename('r')],axis=1).dropna().itertuples(): rows.append((dt,s,v[0],v[1]))\nx=pd.DataFrame(rows,columns=['date','symbol','f','r'])\nics=[]\nfor dt,g in x.groupby('date'):\n if len(g)>=8 and g.f.nunique()>1 and g.r.nunique()>1: ics.append(g.f.corr(g.r,method='spearman'))\na=pd.Series(ics).dropna(); print('dates',len(a),'avg instruments',x.groupby('date').size().mean(),'coverage',len(x)/((x.date.nunique())*15),'IC %.8f ICIR %.5f hit %.4f'%(a.mean(),a.mean()/a.std(),(a>0).mean()))\nfor lo,hi in [('2020','2022-12-31'),('2023','2025-12-31'),('2026','2027-12-31'),('2028','2028-12-31')]:\n z=a[(a.index>=pd.Timestamp(lo))&(a.index<=pd.Timestamp(hi))]; print(lo,hi,len(z),z.mean(),z.mean()/z.std() if len(z)>1 else np.nan)\nfor h in [1,3,5,10]:\n rr=[]\n for s in U:\n  d=fetch(s)\n  if d is None: continue\n  d=d.copy(); d['date']=pd.to_datetime(d.date);d=d.set_index('date').sort_index(); rng=(d.high-d.low).replace(0,np.nan);atr=(d.high-d.low).rolling(20,min_periods=10).mean();f=((d.close-d.open)/rng).clip(-3,3)*(rng/atr).clip(0,4)\n  fr=d.close.shift(-h)/d.close-1\n  q=pd.DataFrame({'f':f,'r':fr}).dropna(); q['date']=q.index; rr.append(q)\n q=pd.concat(rr); ii=[]\n for dt,g in q.groupby('date'):\n  if len(g)>=8: ii.append(g.f.corr(g.r,method='spearman'))\n ii=pd.Series(ii).dropna(); print('h',h,'IC',ii.mean(),'ICIR',ii.mean()/ii.std(),'n',len(ii))\n# save artifact\nx.to_csv('scripts/miner_3_20281116_candle_pressure_signal.csv',index=False)\n", 'file_path': 'scripts/miner_3_20281116_candle_pressure.py'})
