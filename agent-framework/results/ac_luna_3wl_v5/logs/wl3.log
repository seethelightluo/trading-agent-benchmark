 import pandas as pd, numpy as np
U=['000300.SH','SPX','HSI','N225','SX5E','000688.SH','SOX','NDX','XAU','COPPER','WTI','BTC','ETH','US10Y','CN10Y']; cut='2026-07-15'
D={s:pd.read_csv('../persistent/stock_data/'+s+'.csv',parse_dates=['date']).query('date <= @cut').set_index('date').sort_index() for s in U}
rows=[]
for s,x in D.items():
 r=x.close.pct_change(); vol=r.rolling(20,min_periods=15).std()
 # 3-day reversal orthogonalized to same-day cross-sectional volatility: stronger signal for stable assets
 rev=-r.rolling(3,min_periods=3).sum()/vol
 rows.append(pd.DataFrame({'date':x.index,'symbol':s,'f':rev,'fwd':x.close.shift(-1)/x.close-1}))
a=pd.concat(rows,ignore_index=True).dropna()
# winsorize per date, sufficient cross-section
out=[]
for dt,g in a.groupby('date'):
 if len(g)>=8:
  lo,hi=g.f.quantile(.05),g.f.quantile(.95); q=g.f.clip(lo,hi)
  c=q.corr(g.fwd,method='spearman')
  if pd.notna(c): out.append((dt,c,len(g)))
z=pd.DataFrame(out,columns=['date','ic','n']).set_index('date')
ranks=a.assign(rank=a.groupby('date').f.rank(pct=True)).pivot(index='date',columns='symbol',values='rank').sort_index()
print('factor winsorized_volscaled_3d_reversal cutoff',cut,'dates',len(z),'avg_n',z.n.mean(),'coverage',len(a)/sum(len(x) for x in D.values()),'IC',z.ic.mean(),'ICIR',z.ic.mean()/z.ic.std(ddof=1),'hit',(z.ic>0).mean(),'turnover',ranks.diff().abs().mean(axis=1).mean())
for lo,hi in [('2020','2022-12-31'),('2023','2024-12-31'),('2025','2026-07-15')]:
 q=z.loc[lo:hi].ic; print('regime',lo,hi,len(q),q.mean(),q.mean()/q.std(ddof=1))
for h in [5,10]:
 vals=[]
 for s,x in D.items():
  r=x.close.pct_change(); vol=r.rolling(20,min_periods=15).std(); f=-r.rolling(3,min_periods=3).sum()/vol
  vals.append(pd.DataFrame({'date':x.index,'f':f,'r':x.close.shift(-h)/x.close-1}))
 b=pd.concat(vals,ignore_index=True).dropna(); vv=[]
 for dt,g in b.groupby('date'):
  if len(g)>=8:
   c=g.f.clip(g.f.quantile(.05),g.f.quantile(.95)).corr(g.r,method='spearman')
   if pd.notna(c): vv.append(c)
 print('decay',h,len(vv),np.mean(vv),np.mean(vv)/np.std(vv,ddof=1))


