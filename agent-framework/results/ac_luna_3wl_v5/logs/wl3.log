mom=cl.pct_change(20); breadth=(mom>0).mean(axis=1)
f=(mom.mul((breadth-0.5),axis=0)).shift(1)
for h in [1,3,5,10]:
 a=[]
 for dt in cl.index:
  q=pd.concat([f.loc[dt],cl.shift(-h).loc[dt]/cl.loc[dt]-1],axis=1).dropna()
  if len(q)>=8:
