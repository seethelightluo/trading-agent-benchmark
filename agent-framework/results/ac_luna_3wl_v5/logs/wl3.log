     df = df.sort_values("date")\n        close = np.asarray(df["close"], dtype=float)\n        if np.any(~np.isfinite(close)) or np.any(close <= 0):\n            continue\n        r = close[1:] / close[:-1] - 1.0\n        ret[s] = r\n        vol[s] = max(float(np.std(r[-30:])), 0.006)\n        vv = np.asarray(df["volume"], dtype=float) if "volume" in df else np.ones(len(df))\n        volume[s] = float(np.nanmean(vv[-5:]) / max(np.nanmean(vv[-30:]), 1e-9))\n    if len(ret) < 10:\n        return\n\n    def horizon(r, n):\n        return float(np.prod(1.0 + r[-n:]) - 1.0)\n\n    h = {n: {s: horizon(r, n) for s, r in ret.items()} for n in (3, 5, 10, 20)}\n    syms = list(ret)\n    dispersion = float(np.std([h[3][s] for s in syms]))\n    fac = {k: {} for k in FACTORS}\n    for s in syms:\n        peer3 = np.median([h[3][t] for t in syms if t != s])\n        peer5 = np.median([h[5][t] for t in syms if t != s])\n        scale5 = vol[s] * np.sqrt(5.0) + 0.01\n        fac["disp_rev"][s] = (peer3 - h[3][s]) / (vol[s] * np.sqrt(3.0) + 0.01) * min(dispersion / 0.025, 1.0)\n        fac["vol_rev"][s] = -h[5][s] / scale5\n        # Volume is only a modest amplifier, preventing noisy volume spikes dominating.\n        fac["volume_rev"][s] = -h[5][s] / scale5 * (0.75 + 0.25 * np.clip(volume[s], 0.0, 2.0))\n        fac["medium_rev"][s] = -h[10][s] / (vol[s] * np.sqrt(10.0) + 0.01)\n        fac["peer"][s] = peer5 / scale5\n        fac["momentum"][s] = np.prod(1.0 + ret[s][-135:-15]) - 1.0\n\n    # Rank normalization and temporal smoothing reduce unstable reversal crowding.\n    score = {s: sum(w * cross_rank(fac[k])[s] for k, w in FACTORS.items()) for s in UNIVERSE}\n    if _previous is not None:\n        score = {s: 0.60 * score[s] + 0.40 * _previous.get(s, 0.5) for s in UNIVERSE}\n    _previous = score.copy()\n\n    breadth = np.mean([h[20][s] > 0 for s in syms])\n    high_risk = breadth < 0.50 or np.median(list(h[10].values())) < 0 or np.median(list(vol.values())) > 0.018\n    inv