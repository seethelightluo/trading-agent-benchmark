 import numpy as np
from alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights

UNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
# Current Screener ensemble; all directions are positive as supplied.
FACTORS = {"peer5": .20, "mom20": .16, "clv": .15, "lowvol1": .14,
           "stress": .09, "beta5": .09, "rev3": .07, "lagmix": .05, "beta2": .05}
MIN_W, MAX_W, CADENCE = .02, .14, 10
_day = 0

def rank(x):
    good = sorted((s, float(v)) for s, v in x.items() if np.isfinite(v))
    out = {s: .5 for s in UNIVERSE}
    for i, (s, _) in enumerate(good):
        out[s] = (i + 1.) / len(good)
    return out

def bounded(raw):
    # Iterative water filling enforces a complete, finite, long-only vector.
    w = {s: max(float(raw.get(s, 0)), 1e-8) for s in UNIVERSE}
    fixed, active = {}, set(UNIVERSE)
    for _ in range(30):
        left = 1 - sum(fixed.values()); den = sum(w[s] for s in active)
        trial = {s: left*w[s]/den for s in active}
        clipped = False
        for s, q in list(trial.items()):
            if q < MIN_W: fixed[s] = MIN_W; active.remove(s); clipped = True
            elif q > MAX_W: fixed[s] = MAX_W; active.remove(s); clipped = True
        if not clipped:
            fixed.update(trial); break
    z = sum(fixed.values())
    return {s: fixed.get(s, 0.)/z for s in UNIVERSE}

@register_hook
def cross_asset_strategy():
    global _day
    _day += 1
    if _day != 1 and (_day - 1) % CADENCE:
        return
    series, vol, mom = {}, {}, {}
    raw = {k: {} for k in FACTORS}
    for s in UNIVERSE:
        d = get_stock_daily_data(symbol=s, days=135)
        if d is None or len(d) < 35: continue
        d = d.sort_values("date").reset_index(drop=True)
        c, o, h, l = [np.asarray(d[k], dtype=float) for k in ("close", "open", "high", "low")]
        r = c[1:]/c[:-1]-1
        if len(r) < 30 or not np.all(np.isfinite(c[-35:])) or np.any(c[-35:] <= 0): continue
        v = max(float(np.nanstd(r[-20:])), .008)
        series[s], vol[s] = r, v; mom[s] = c[-1]/c[-21]-1
        span = h[-1]-l[-1]
        raw["clv"][s] = -(c[-1]-o[-1])/span if np.isfinite(span) and span > 0 else 0
        raw["lowvol1"][s] = -r[-1]/v
        shock = np.clip(abs(r[-1])/v, .5, 2.)
        raw["stress"][s] = -r[-1]/v * shock
        raw["mom20"][s] = mom[s]/(v*np.sqrt(20)+.01)
    if len(series) < 8: return
    def cum(r, n): return float(np.prod(1+r[-n:])-1)
    for s, r in series.items():
        peers = [cum(series[t], 5) for t in series if t != s]
        med5 = np.median(peers); med3 = np.median([cum(series[t],3) for t in series if t != s]); med2 = np.median([cum(series[t],2) for t in series if t != s])
        own5, own3, own2 = cum(r,5), cum(r,3), cum(r,2)
        raw["peer5"][s] = own5-med5
        raw["beta5"][s] = -(own5-med5)/(vol[s]*np.sqrt(5)+.005)
        raw["rev3"][s] = -(own3-med3)/(vol[s]*np.sqrt(3)+.005)
        raw["beta2"][s] = -(own2-med2)/(vol[s]*np.sqrt(2)+.005)
        # Small lag mixture reduces reliance on a single one-day reversal.
        raw["lagmix"][s] = .6*(-r[-1]/vol[s]) + .4*(-(own2-med2)/(vol[s]*np.sqrt(2)+.005))
    ranks = {k: rank(v) for k,v in raw.items()}
    score = {s: sum(FACTORS[k]*ranks[k][s] for k in FACTORS) for s in UNIVERSE}
    breadth = np.mean([mom[s] > 0 for s in mom])
    medv = float(np.median(list(vol.values())))
    high_risk = medv > .018 or breadth < .45
    inv_mean = np.mean([1/v for v in vol.values()])
    defensive = {"XAU", "US10Y", "CN10Y"}
    raw_target = {}
    for s in UNIVERSE:
        iv = min((1/vol.get(s, medv))/inv_mean, 1.5)
        tilt = 1.12 if high_risk and s in defensive else 1.
        raw_target[s] = max(score[s], .05) * (.85+.15*iv) * tilt
    rebalance_to_weights(bounded(raw_target))


