 import numpy as np
from alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights

UNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
# Screener ensemble: capped at five active factors, all with positive direction.
FACTORS = {"rev1": 0.50, "clv": 0.18, "peer": 0.14, "mom20": 0.12, "rev5": 0.06}
REBALANCE_EVERY = 10
MIN_WEIGHT, MAX_WEIGHT = 0.02, 0.14
_calls = 0

def cs_rank(values):
    valid = sorted((s, float(v)) for s, v in values.items() if np.isfinite(v))
    out = {s: 0.5 for s in UNIVERSE}
    n = len(valid)
    if n:
        for i, (s, _) in enumerate(valid):
            out[s] = (i + 1.0) / n if n > 1 else 0.5
    return out

def project_weights(raw):
    # Simple bounded full-investment projection. Fractional weights are intentional.
    w = {s: max(float(raw.get(s, 1.0)), 1e-9) for s in UNIVERSE}
    for _ in range(20):
        z = sum(w.values())
        q = {s: w[s] / z for s in UNIVERSE}
        low = [s for s in UNIVERSE if q[s] < MIN_WEIGHT]
        high = [s for s in UNIVERSE if q[s] > MAX_WEIGHT]
        if not low and not high:
            return q
        for s in low: w[s] = MIN_WEIGHT
        for s in high: w[s] = MAX_WEIGHT
        # Rescale only unconstrained names on the next pass; fixed bounds remain valid.
        fixed = set(low + high)
        free = [s for s in UNIVERSE if s not in fixed]
        rem = 1.0 - sum(w[s] for s in fixed)
        if free and rem > 0:
            zfree = sum(w[s] for s in free)
            for s in free: w[s] = rem * w[s] / max(zfree, 1e-12)
    z = sum(w.values())
    return {s: w[s] / z for s in UNIVERSE}

@register_hook
def cross_asset_strategy():
    global _calls
    _calls += 1
    if _calls > 1 and (_calls - 1) % REBALANCE_EVERY != 0:
        return
    rev1, clv, peer, mom20, rev5, vols, returns = {}, {}, {}, {}, {}, {}, {}
    for symbol in UNIVERSE:
        df = get_stock_daily_data(symbol=symbol, days=90)
        if df is None or len(df) < 26:
            continue
        df = df.sort_values("date").reset_index(drop=True)
        c = np.asarray(df["close"], dtype=float)
        h = np.asarray(df["high"], dtype=float)
        l = np.asarray(df["low"], dtype=float)
        if not np.all(np.isfinite(c[-26:])) or c[-1] <= 0:
            continue
        r = c[1:] / np.maximum(c[:-1], 1e-12) - 1.0
        sigma = max(float(np.std(r[-20:])), 0.008)
        vols[symbol] = sigma
        returns[symbol] = r[-1]
        rev1[symbol] = -r[-1] / sigma
        rev5[symbol] = -(c[-1] / max(c[-6], 1e-12) - 1.0)
        mom20[symbol] = (c[-1] / max(c[-21], 1e-12) - 1.0) / (sigma + 0.01)
        span = h[-1] - l[-1]
        clv[symbol] = (c[-1] - l[-1]) / span if np.isfinite(span) and span > 0 else 0.5
    if len(vols) < 8:
        return
    # Leave-one-out cross-sectional lead-lag proxy, using only the completed history.
    for s in vols:
        peer[s] = returns[s] - np.median([returns[t] for t in vols if t != s])
    ranks = {"rev1": cs_rank(rev1), "clv": cs_rank(clv), "peer": cs_rank(peer),
             "mom20": cs_rank(mom20), "rev5": cs_rank(rev5)}
    score = {s: sum(FACTORS[k] * ranks[k][s] for k in FACTORS) for s in vols}
    # Moderate bull/sideways regime: full investment, inverse-volatility damped.
    breadth = float(np.mean([mom20[s] > 0 for s in vols]))
    defensive = {"XAU", "US10Y", "CN10Y"}
    tilt = {s: 1.0 for s in UNIVERSE}
    if breadth < 0.40:
        for s in UNIVERSE:
            tilt[s] = 1.30 if s in defensive else 0.88
    elif breadth < 0.55:
        for s in UNIVERSE:
            tilt[s] = 1.12 if s in defensive else 0.96
    avg_inv = np.mean([1.0 / v for v in vols.values()])
    raw = {}
    for s in UNIVERSE:
        iv = (1.0 / vols[s]) / avg_inv if s in vols else 1.0
        raw[s] = max(score.get(s, 0.5), 0.05) * tilt[s] * (0.92 + 0.08 * min(iv, 2.0))
    rebalance_to_weights(project_weights(raw))


