  ▶️ write_file({'content': 'import numpy as np\nfrom alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights\n\nUNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]\nDEFENSIVE = {"XAU", "US10Y", "CN10Y"}\nCADENCE = 10\nMIN_W, MAX_W = 0.035, 0.16\nFACTOR_W = {\n    "cluster": .20, "volume_shock": .14, "intraday": .12,\n    "volshock": .12, "volscaled": .10, "vixstress": .10,\n    "macro": .09, "volume_disp": .08, "momentum": .05\n}\nCLUSTERS = {\n    "equity": {"000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX"},\n    "commodity": {"XAU", "COPPER", "WTI"}, "crypto": {"BTC", "ETH"},\n    "rates": {"US10Y", "CN10Y"}}\n_day = 0\n_previous = None\n\n\ndef cs_rank(values):\n    out = {s: .5 for s in UNIVERSE}\n    good = sorted((s, float(v)) for s, v in values.items() if np.isfinite(v))\n    if not good:\n        return out\n    for i, (s, _) in enumerate(good):\n        out[s] = (i + 1.) / len(good)\n    return out\n\n\ndef bounded(raw):\n    # Projection onto the full-investment simplex with practical concentration bounds.\n    w = {s: max(float(raw.get(s, 1.0)), 1e-12) for s in UNIVERSE}\n    fixed = set()\n    for _ in range(30):\n        free = [s for s in UNIVERSE if s not in fixed]\n        rem = 1.0 - sum(w[s] for s in fixed)\n        total = sum(w[s] for s in free)\n        for s in free:\n            w[s] = rem * w[s] / max(total, 1e-12)\n        hit = {s for s in free if w[s] < MIN_W or w[s] > MAX_W}\n        if not hit:\n            break\n        for s in hit:\n            w[s] = MIN_W if w[s] < MIN_W else MAX_W\n        fixed |= hit\n    z = sum(w.values())\n    return {s: w[s] / z for s in UNIVERSE}\n\n\n@register_hook\ndef cross_asset_strategy():\n    global _day, _previous\n    _day += 1\n    if _day != 1 and (_day - 1) % CADENCE != 0:\n        return\n\n    data = {}\n    for symbol in UNIVERSE:\n        df = get_stock_daily_data(symbol=symbol, days=270)\n        if df is None or len(df) < 160:\n            continue\n        df = df.sort_values("date")\n        close = np.asarray(df["close"], dtype=float)\n        open_ = np.asarray(df["open"], dtype=float)\n        volume = np.nan_to_num(np.asarray(df["volume"], dtype=float), nan=0.0)\n        if len(close) < 160 or np.any(~np.isfinite(close)) or np.any(close <= 0):\n            continue\n        ret = close[1:] / close[:-1] - 1.0\n        overnight = close[1:] / np.maximum(open_[1:], 1e-12) - 1.0\n        data[symbol] = {"r": ret, "on": overnight,\n                        "h3": np.prod(1 + ret[-3:]) - 1,\n                        "h5": np.prod(1 + ret[-5:]) - 1,\n                        "h10": np.prod(1 + ret[-10:]) - 1,\n                        "h20": np.prod(1 + ret[-20:]) - 1,\n                        "h120": np.prod(1 + ret[-120:]) - 1,\n                        "v5": max(np.std(ret[-5:]), .006),\n                        "v20": max(np.std(ret[-20:]), .006),\n                        "v60": max(np.std(ret[-60:]), .006),\n                        "vr": np.mean(volume[-5:]) / max(np.mean(volume[-20:]), 1e-12)}\n    if len(data) < 10:\n        return\n\n    symbols = list(data)\n    med = {k: np.median([data[s][k] for s in symbols]) for k in ("h3", "h5", "h10", "h20")}\n    factors = {k: {} for k in FACTOR_W}\n    for s in symbols:\n        x = data[s]\n        scale = x["v20"] * np.sqrt(20) + .015\n        cluster = next((name for name, members in CLUSTERS.items() if s in members), None)\n        peers = [data[t]["r"] for t in symbols if t in CLUSTERS.get(cluster, set())]\n        n = min(3, len(x["r"]))\n        peer = np.median([a[-n:] for a in peers], axis=0) if peers else np.zeros(n)\n        factors["cluster"][s] = -np.sum(x["r"][-n:] - peer) / (x["v20"] + 1e-5)\n        factors["volume_shock"][s] = (med["h3"] - x["h3"]) / (x["v5"] + .01) * np.clip(x["vr"], .5, 2.)\n        # Intraday-normalized reversal, using the latest completed sessions only.\n        intraday = np.mean(x["on"][-3:])\n        factors["intraday"][s] = -intraday / (x["v5"] + .01)\n        factors["volshock"][s] = (med["h3"] - x["h3"]) / (x["v5"] + .01) * np.clip(x["v5"] / x["v60"], .6, 1.7)\n        factors["volscaled"][s] = (med["h5"] - x["h5"]) / scale\n        factors["vixstress"][s] = (med["h10"] - x["h10"]) / (x["v20"] * np.sqrt(10) + .02)\n        factors["volume_disp"][s] = (med["h20"] - x["h20"]) / scale * np.clip(x["vr"], .6, 1.6)\n        factors["momentum"][s] = x["h20"] / (x["v20"] * np.sqrt(20) + .02)\n\n    bench = data.get("SPX", {}).get("r")\n    for s in symbols:\n        x = data[s]\n        if bench is not None and s != "SPX":\n            n = min(60, len(x["r"]), len(bench))\n            beta = np.cov(x["r"][-n:], bench[-n:])[0, 1] / max(np.var(bench[-n:]), 1e-8)\n            residual = np.sum(x["r"][-10:] - beta * bench[-10:])\n        else:\n            residual = 0.0\n        factors["macro"][s] = -residual / (x["v20"] * np.sqrt(10) + .015)\n\n    ranks = {k: cs_rank(v) for k, v in factors.items()}\n    breadth = np.mean([data[s]["h120"] > 0 for s in symbols])\n    if breadth < .50:\n        ranks["momentum"] = {s: .5 for s in UNIVERSE}\n    score = {s: sum(FACTOR_W[k] * ranks[k].get(s, .5) for k in FACTOR_W) for s in UNIVERSE}\n    if _previous is not None:\n        score = {s: .5 * score[s] + .5 * _previous[s] for s in UNIVERSE}\n    _previous = score.copy()\n\n    high_risk = np.median([data[s]["v20"] for s in symbols]) > .018 or breadth < .50\n    inv_mean = np.mean([1.0 / data[s]["v20"] for s in symbols])\n    raw = {}\n    for s in UNIVERSE:\n        x = data.get(s, {"v20": .02, "h120": 0.0})\n        invvol = (1.0 / x["v20"]) / max(inv_mean, 1e-12) if s in data else 1.0\n        raw[s] = max(score[s], .12) * (.90 + .10 * min(invvol, 1.25))\n        if high_risk and s in DEFENSIVE:\n            raw[s] *= 2.0\n        if high_risk and x["h120"] < -.10:\n            raw[s] *= .75\n    rebalance_to_weights(bounded(raw))\n', 'file_path': 'strategy.py'})
