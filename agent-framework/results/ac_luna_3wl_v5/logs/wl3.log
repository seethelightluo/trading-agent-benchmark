 import numpy as np
from alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights

UNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
DEFENSIVE = {"XAU", "US10Y", "CN10Y"}
CADENCE = 10
MIN_W, MAX_W = 0.04, 0.18
# Current screener ensemble (8 factors; weights sum to 1).
FACTORS = ("volstate", "failure", "downside", "residual", "dispersion", "lowvolrev", "consistency", "breakout120")
FACTOR_W = (0.20, 0.17, 0.15, 0.12, 0.12, 0.10, 0.08, 0.06)
_day = 0
_previous = None


def cs_rank(vals):
    out = {s: 0.5 for s in UNIVERSE}
    good = sorted((s, v) for s, v in vals.items() if np.isfinite(v))
    for i, (s, _) in enumerate(good):
        out[s] = (i + 1.0) / max(len(good), 1)
    return out


def project(raw):
    # Simple bounded simplex projection; all 15 instruments remain invested.
    w = {s: max(float(raw.get(s, 0.0)), 1e-9) for s in UNIVERSE}
    fixed = {}
    for _ in range(40):
        free = [s for s in UNIVERSE if s not in fixed]
        left = 1.0 - sum(fixed.values())
        z = sum(w[s] for s in free)
        for s in free:
            w[s] = left * w[s] / max(z, 1e-12)
        hit = [s for s in free if w[s] < MIN_W or w[s] > MAX_W]
        if not hit:
            break
        for s in hit:
            fixed[s] = MIN_W if w[s] < MIN_W else MAX_W
            w[s] = fixed[s]
    total = sum(w.values())
    return {s: w[s] / total for s in UNIVERSE}


@register_hook
def cross_asset_strategy():
    global _day, _previous
    _day += 1
    if _day != 1 and (_day - 1) % CADENCE:
        return

    feats, rets = {}, {}
    for s in UNIVERSE:
        df = get_stock_daily_data(symbol=s, days=195)
        if df is None or len(df) < 135:
            continue
        close = np.asarray(df.sort_values("date")["close"], dtype=float)[:-1]
        if len(close) < 125 or np.any(~np.isfinite(close)) or np.any(close <= 0):
            continue
        r = close[1:] / close[:-1] - 1.0
        v20 = max(float(np.std(r[-20:])), 0.006)
        r3 = np.prod(1 + r[-3:]) - 1
        r5 = np.prod(1 + r[-5:]) - 1
        r20 = np.prod(1 + r[-20:]) - 1
        r30 = np.prod(1 + r[-30:]) - 1
        h20, h120 = max(close[-21:]), max(close[-121:])
        dn = max(float(np.sqrt(np.mean(np.minimum(r[-20:], 0) ** 2))), 0.006)
        # Positive scores mean preferred: reversals are negative recent return.
        feats[s] = {
            "volstate": np.clip(-r3 / v20, -3, 3),
            "failure": np.clip((-r5) * max(0, 1 - close[-1] / h20) / v20, -3, 3),
            "downside": r20 / dn,
            "residual": r20 / max(v20 * np.sqrt(20), .01),
            "dispersion": np.clip(-r5 / max(v20 * np.sqrt(5), .01), -3, 3),
            "lowvolrev": (-r3) / v20 / (1 + 8 * v20),
            "consistency": r30 / max(v20 * np.sqrt(30), .01) * (.5 + np.mean(r[-30:] > 0)),
            "breakout120": (close[-1] / h120 - 1) / max(v20 * np.sqrt(120), .01),
            "vol": v20,
        }
        rets[s] = r
    if len(feats) < 10:
        return

    # Remove broad-market beta from residual momentum using only lagged data.
    market = rets.get("SPX")
    if market is not None:
        for s, r in rets.items():
            n = min(60, len(r), len(market))
            if n >= 30:
                beta = np.cov(r[-n:], market[-n:], ddof=1)[0, 1] / max(np.var(market[-n:], ddof=1), 1e-8)
                feats[s]["residual"] -= beta * np.prod(1 + market[-20:]) - beta

    ranks = [cs_rank({s: feats[s][f] for s in feats}) for f in FACTORS]
    score = {s: sum(FACTOR_W[i] * ranks[i][s] for i in range(8)) for s in UNIVERSE}
    if _previous is not None:
        score = {s: .75 * score[s] + .25 * _previous[s] for s in UNIVERSE}
    _previous = score.copy()

    medv = float(np.median([x["vol"] for x in feats.values()]))
    breadth = float(np.mean([x["breakout120"] > 0 for x in feats.values()]))
    stressed = medv > .018 or breadth < .45
    invmean = np.mean([1 / x["vol"] for x in feats.values()])
    raw = {}
    for s in UNIVERSE:
        x = feats.get(s, {"vol": medv, "breakout120": 0})
        damp = np.clip((1 / x["vol"]) / max(invmean, 1e-12), .70, 1.20)
        raw[s] = max(score[s], .06) * (.86 + .14 * damp)
        if stressed:
            raw[s] *= 1.35 if s in DEFENSIVE else (.88 if x["breakout120"] < 0 else .78)
    target = project(raw)
    if abs(sum(target.values()) - 1) < 1e-8 and all(np.isfinite(v) and v >= 0 for v in target.values()):
        rebalance_to_weights(target)


