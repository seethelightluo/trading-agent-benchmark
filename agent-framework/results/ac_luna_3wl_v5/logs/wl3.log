 import numpy as np
from alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights

UNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
DEFENSIVE = {"XAU", "US10Y", "CN10Y"}
CADENCE = 10
MIN_W, MAX_W = 0.04, 0.20
# Screener ensemble (six active factors; all direction +1).
FACTOR_NAMES = ("breakout", "consistency", "residual", "downside", "upday", "medium")
FACTOR_W = (0.30, 0.22, 0.16, 0.14, 0.12, 0.06)
_day = 0
_previous = None

def rank_map(values):
    good = sorted((s, float(v)) for s, v in values.items() if np.isfinite(v))
    out = {s: 0.5 for s in UNIVERSE}
    n = len(good)
    if n:
        for i, (s, _) in enumerate(good):
            out[s] = (i + 1.0) / n
    return out

def capped_simplex(raw):
    w = {s: max(float(raw.get(s, 1.0)), 1e-10) for s in UNIVERSE}
    fixed = set()
    for _ in range(60):
        free = [s for s in UNIVERSE if s not in fixed]
        remaining = 1.0 - sum(w[s] for s in fixed)
        total = sum(w[s] for s in free)
        for s in free:
            w[s] = remaining * w[s] / max(total, 1e-12)
        hit = [s for s in free if w[s] < MIN_W or w[s] > MAX_W]
        if not hit:
            break
        for s in hit:
            w[s] = MIN_W if w[s] < MIN_W else MAX_W
        fixed.update(hit)
    total = sum(w.values())
    return {s: w[s] / total for s in UNIVERSE}

@register_hook
def cross_asset_strategy():
    global _day, _previous
    _day += 1
    if _day != 1 and (_day - 1) % CADENCE != 0:
        return
    data = {}
    for symbol in UNIVERSE:
        df = get_stock_daily_data(symbol=symbol, days=180)
        if df is None or len(df) < 80:
            continue
        close = np.asarray(df.sort_values("date")["close"], dtype=float)
        if np.any(~np.isfinite(close)) or np.any(close <= 0):
            continue
        ret = close[1:] / close[:-1] - 1.0
        vol20 = max(float(np.std(ret[-20:])), 0.006)
        downside = max(float(np.sqrt(np.mean(np.minimum(ret[-20:], 0.0) ** 2))), 0.006)
        r20 = float(np.prod(1.0 + ret[-20:]) - 1.0)
        r30 = float(np.prod(1.0 + ret[-30:]) - 1.0)
        r60 = float(np.prod(1.0 + ret[-60:]) - 1.0)
        prior60 = close[-61:-1]
        high60 = max(np.max(prior60), 1e-12)
        data[symbol] = {
            "vol": vol20,
            "breakout": (close[-1] / high60 - 1.0) / max(vol20 * np.sqrt(60), .01),
            "consistency": (r30 / max(vol20 * np.sqrt(30), .01)) * (0.5 + float(np.mean(ret[-30:] > 0))),
            "residual": r20,
            "downside": r20 / downside,
            "upday": float(np.mean(ret[-30:] > 0)),
            "medium": r60 / max(vol20 * np.sqrt(60), .01),
        }
    if len(data) < 10:
        return
    med = float(np.median([x["residual"] for x in data.values()]))
    for x in data.values():
        x["residual"] -= med
    ranks = [rank_map({s: x[f] for s, x in data.items()}) for f in FACTOR_NAMES]
    score = {s: sum(FACTOR_W[i] * ranks[i][s] for i in range(len(FACTOR_NAMES))) for s in UNIVERSE}
    if _previous is not None:
        score = {s: 0.75 * score[s] + 0.25 * _previous[s] for s in UNIVERSE}
    _previous = score.copy()
    median_vol = float(np.median([x["vol"] for x in data.values()]))
    breadth = float(np.mean([x["medium"] > 0 for x in data.values()]))
    spx = data.get("SPX", {})
    # High-risk if breadth is weak, volatility elevated, or SPX is below both trend horizons.
    high_risk = (median_vol > 0.018 or breadth < 0.45 or spx.get("medium", 0) < -0.10)
    inv_avg = float(np.mean([1.0 / x["vol"] for x in data.values()]))
    raw = {}
    for s in UNIVERSE:
        x = data.get(s, {"vol": median_vol, "medium": 0.0})
        vol_damp = np.clip((1.0 / x["vol"]) / max(inv_avg, 1e-12), 0.65, 1.25)
        raw[s] = max(score[s], 0.05) * (0.82 + 0.18 * vol_damp)
        if high_risk:
            if s in DEFENSIVE:
                raw[s] *= 3.0
            elif x["medium"] < -0.08:
                raw[s] *= 0.65
    # Complete 15-asset, long-only, full-investment target; fractional sizing is helper-owned.
    rebalance_to_weights(capped_simplex(raw))


