import numpy as np
from alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights

UNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
# Screener ensemble (2026-08-27), capped at five active factors.
FACTOR_W = {"mom20": .25, "peer5": .22, "resid40": .20, "conditional": .18, "volume_rev": .15}
REBALANCE_DAYS = 10
MIN_W, MAX_W = .03, .15
_day = 0
_last_score = None


def rank_cs(x):
    good = sorted((s, v) for s, v in x.items() if np.isfinite(v))
    out = {s: .5 for s in UNIVERSE}
    n = len(good)
    if n:
        for i, (s, _) in enumerate(good):
            out[s] = (i + 1.) / n
    return out


def ret(r, n):
    return float(np.prod(1. + r[-n:]) - 1.) if len(r) >= n else np.nan


def bounded_weights(raw):
    # Iterative capped-simplex projection; preserves full investment and all assets.
    active = set(UNIVERSE); fixed = {}; base = {s: max(float(raw.get(s, .1)), 1e-8) for s in UNIVERSE}
    for _ in range(30):
        left = 1. - sum(fixed.values()); den = sum(base[s] for s in active)
        trial = {s: left * base[s] / den for s in active}
        clipped = False
        for s, v in list(trial.items()):
            if v < MIN_W: fixed[s] = MIN_W; active.remove(s); clipped = True
            elif v > MAX_W: fixed[s] = MAX_W; active.remove(s); clipped = True
        if not clipped:
            fixed.update(trial); break
    z = sum(fixed.values())
    return {s: fixed.get(s, 0.) / z for s in UNIVERSE}


@register_hook
def cross_asset_strategy():
    global _day, _last_score
    _day += 1
    if _day != 1 and (_day - 1) % REBALANCE_DAYS:
        return

    data, rets, vols = {}, {}, {}
    for s in UNIVERSE:
        df = get_stock_daily_data(symbol=s, days=230)
        if df is None or len(df) < 70:
            continue
        df = df.sort_values("date")
        c = np.asarray(df["close"], dtype=float)
        if np.any(~np.isfinite(c[-70:])) or np.any(c[-70:] <= 0):
            continue
        data[s] = df; rets[s] = c[1:] / c[:-1] - 1.
        vols[s] = max(float(np.std(rets[s][-20:])), .006)
    if len(rets) < 10:
        return

    r5 = {s: ret(r, 5) for s, r in rets.items()}
    r20 = {s: ret(r, 20) for s, r in rets.items()}
    r40 = {s: ret(r, 40) for s, r in rets.items()}
    equity = {s for s in UNIVERSE[:8] if s in rets}
    med5 = float(np.median(list(r5.values())))
    med40eq = float(np.median([r40[s] for s in equity])) if equity else float(np.median(list(r40.values())))
    breadth = float(np.mean([v > 0 for v in r5.values()]))
    stress = med5 < 0 or breadth < .45 or float(np.median(list(vols.values()))) > .018

    f = {k: {} for k in FACTOR_W}
    for s, r in rets.items():
        v = vols[s]
        # Risk-adjusted 20-day momentum, volatility window is the available trailing 60 days.
        f["mom20"][s] = r20[s] / (max(float(np.std(r[-60:])), .006) * np.sqrt(20.) + .01)
        # Leave-one-out peer-median five-day lead/lag signal.
        peers = [r5[t] for t in rets if t != s]
        f["peer5"][s] = float(np.median(peers)) if peers else r5[s]
        # Slow equity-relative residual proxy.
        f["resid40"][s] = (r40[s] - med40eq) / (v * np.sqrt(40.) + .02)
        r3 = ret(r, 3)
        med3 = float(np.median([ret(rets[t], 3) for t in rets]))
        f["conditional"][s] = (-(r3 - med3) if stress else r3) / (v * np.sqrt(3.) + .012)
        vol = np.asarray(data[s]["volume"], dtype=float) if "volume" in data[s] else np.array([])
        vz = 0.
        if len(vol) >= 20 and np.all(np.isfinite(vol[-20:])) and np.all(vol[-20:] > 0):
            lv = np.log(vol[-20:]); vz = np.clip((lv[-1] - np.mean(lv)) / (np.std(lv) + 1e-9), -1., 2.)
        f["volume_rev"][s] = -r[-1] * (1. + .5 * vz)

    ranked = {k: rank_cs(v) for k, v in f.items()}
    scores = {s: sum(FACTOR_W[k] * ranked[k].get(s, .5) for k in FACTOR_W) for s in rets}
    if _last_score is not None:
        for s in scores:
            scores[s] = .65 * scores[s] + .35 * _last_score.get(s, scores[s])
    _last_score = scores.copy()

    mean_inv = np.mean([1. / v for v in vols.values()])
    defensive = {"XAU", "US10Y", "CN10Y"}
    raw = {}
    for s in UNIVERSE:
        inv = min((1. / vols.get(s, .02)) / mean_inv, 1.25)
        raw[s] = max(scores.get(s, .5), .05) * (.88 + .12 * inv)
        if stress and s in defensive:
            raw[s] *= 1.35
    target = bounded_weights(raw)
    if set(target) == set(UNIVERSE) and all(np.isfinite(v) and v >= 0 for v in target.values()) and abs(sum(target.values()) - 1.) < 1e-8:
        rebalance_to_weights(target)
