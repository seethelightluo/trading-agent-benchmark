ol=s, days=130)\n        if df is None or len(df) < 35:\n            continue\n        df = df.sort_values("date").reset_index(drop=True)\n        c = np.asarray(df.close, float); o = np.asarray(df.open, float)\n        h = np.asarray(df.high, float); l = np.asarray(df.low, float)\n        if np.any(~np.isfinite(c[-35:])) or np.any(c[-35:] <= 0):\n            continue\n        dr = c[1:] / c[:-1] - 1.0\n        v = max(float(np.std(dr[-20:])), 0.008)\n        vols[s] = v; returns[s] = dr; r20[s] = c[-1] / c[-21] - 1.0\n        raw["lowvol"][s] = -dr[-1] / v\n        raw["mom20"][s] = r20[s] / (v * np.sqrt(20.0) + 0.01)\n        span = h[-1] - l[-1]\n        raw["clv"][s] = -(c[-1] - o[-1]) / span if np.isfinite(span) and span > 0 else 0.0\n        stress = np.clip(abs(dr[-1]) / v, 0.5, 2.0)\n        # Stress weighting is capped to avoid one abnormal print dominating ranks.\n        raw["stress"][s] = (-dr[-1] / v) * stress\n        if "volume" in df.columns:\n            vv = np.asarray(df.volume, float); med = np.nanmedian(vv[-21:])\n            amp = vv[-1] / med if np.isfinite(vv[-1]) and vv[-1] > 0 and med > 0 else 1.0\n            raw["volume"][s] = (-dr[-1] / v) * np.clip(amp, 0.75, 1.5)\n        else:\n            raw["volume"][s] = 0.0\n    if len(vols) < 8:\n        return\n    # Cross-sectional peer residuals, using only the observed prior-day returns.\n    for s in vols:\n        peer = [returns[t][-1] for t in vols if t != s]\n        med1 = float(np.median(peer)) if peer else 0.0\n        peer3 = [np.prod(1.0 + returns[t][-3:]) - 1.0 for t in vols if t != s and len(returns[t]) >= 3]\n        med3 = float(np.median(peer3)) if peer3 else 0.0\n        own3 = np.prod(1.0 + returns[s][-3:]) - 1.0\n        own5 = np.prod(1.0 + returns[s][-5:]) - 1.0\n        peer5 = [np.prod(1.0 + returns[t][-5:]) - 1.0 for t in vols if t != s and len(returns[t]) >= 5]\n        med5 = float(np.median(peer5)) if peer5 else 0.0\n        raw["res3"][s] = -(own3 - med3) / (vols[s] * np.sqrt(3.0) + 0.005)\n        raw["res5"][s] = -(own5 - med5) / (vols[s] * np.sqrt(5.0) + 0.005)\n        raw["peer5"][s] = own5 - med5\n    rr = {k: rank(v) for k, v in raw.items()}\n    score = {s: sum(FACTORS[k] * rr[k][s] for k in FACTORS) for s in UNIVERSE}\n    breadth = np.mean([r20[s] > 0 for s in r20])\n    market_vol = float(np.median(list(vols.values())))\n    defensive = {"XAU", "US10Y", "CN10Y"}\n    risk = market_vol > 0.018 or breadth < 0.45\n    avg_inv = np.mean([1.0 / v for v in vols.values()])\n    target = {}\n    for s in UNIVERSE:\n        inv = min((1.0 / vols.get(s, market_vol)) / avg_inv, 1.5)\n        tilt = 1.12 if risk and s in defensive else (0.96 if risk else 1.0)\n        target[s] = max(score[s], 0.05) * (0.85 + 0.15 * inv) * tilt\n    rebalance_to_weights(bounded(target))\n', 'file_path': 'strategy.py'})
