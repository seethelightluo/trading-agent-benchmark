  ▶️ write_file({'content': 'import numpy as np\nfrom alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights\n\nUNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]\n# Current Screener ensemble; all directions are positive as supplied.\nFACTORS = {"peer5": .20, "mom20": .16, "clv": .15, "lowvol1": .14,\n           "stress": .09, "beta5": .09, "rev3": .07, "lagmix": .05, "beta2": .05}\nMIN_W, MAX_W, CADENCE = .02, .14, 10\n_day = 0\n\ndef rank(x):\n    good = sorted((s, float(v)) for s, v in x.items() if np.isfinite(v))\n    out = {s: .5 for s in UNIVERSE}\n    for i, (s, _) in enumerate(good):\n        out[s] = (i + 1.) / len(good)\n    return out\n\ndef bounded(raw):\n    # Iterative water filling enforces a complete, finite, long-only vector.\n    w = {s: max(float(raw.get(s, 0)), 1e-8) for s in UNIVERSE}\n    fixed, active = {}, set(UNIVERSE)\n    for _ in range(30):\n        left = 1 - sum(fixed.values()); den = sum(w[s] for s in active)\n        trial = {s: left*w[s]/den for s in active}\n        clipped = False\n        for s, q in list(trial.items()):\n            if q < MIN_W: fixed[s] = MIN_W; active.remove(s); clipped = True\n            elif q > MAX_W: fixed[s] = MAX_W; active.remove(s); clipped = True\n        if not clipped:\n            fixed.update(trial); break\n    z = sum(fixed.values())\n    return {s: fixed.get(s, 0.)/z for s in UNIVERSE}\n\n@register_hook\ndef cross_asset_strategy():\n    global _day\n    _day += 1\n    if _day != 1 and (_day - 1) % CADENCE:\n        return\n    series, vol, mom = {}, {}, {}\n    raw = {k: {} for k in FACTORS}\n    for s in UNIVERSE:\n        d = get_stock_daily_data(symbol=s, days=135)\n        if d is None or len(d) < 35: continue\n        d = d.sort_values("date").reset_index(drop=True)\n        c, o, h, l = [np.asarray(d[k], dtype=float) for k in ("close", "open", "high", "low")]\n        r = c[1:]/c[:-1]-1\n        if len(r) < 30 or not np.all(np.isfinite(c[-35:])) or np.any(c[-35:] <= 0): continue\n        v = max(float(np.nanstd(r[-20:])), .008)\n        series[s], vol[s] = r, v; mom[s] = c[-1]/c[-21]-1\n        span = h[-1]-l[-1]\n        raw["clv"][s] = -(c[-1]-o[-1])/span if np.isfinite(span) and span > 0 else 0\n        raw["lowvol1"][s] = -r[-1]/v\n        shock = np.clip(abs(r[-1])/v, .5, 2.)\n        raw["stress"][s] = -r[-1]/v * shock\n        raw["mom20"][s] = mom[s]/(v*np.sqrt(20)+.01)\n    if len(series) < 8: return\n    def cum(r, n): return float(np.prod(1+r[-n:])-1)\n    for s, r in series.items():\n        peers = [cum(series[t], 5) for t in series if t != s]\n        med5 = np.median(peers); med3 = np.median([cum(series[t],3) for t in series if t != s]); med2 = np.median([cum(series[t],2) for t in series if t != s])\n        own5, own3, own2 = cum(r,5), cum(r,3), cum(r,2)\n        raw["peer5"][s] = own5-med5\n        raw["beta5"][s] = -(own5-med5)/(vol[s]*np.sqrt(5)+.005)\n        raw["rev3"][s] = -(own3-med3)/(vol[s]*np.sqrt(3)+.005)\n        raw["beta2"][s] = -(own2-med2)/(vol[s]*np.sqrt(2)+.005)\n        # Small lag mixture reduces reliance on a single one-day reversal.\n        raw["lagmix"][s] = .6*(-r[-1]/vol[s]) + .4*(-(own2-med2)/(vol[s]*np.sqrt(2)+.005))\n    ranks = {k: rank(v) for k,v in raw.items()}\n    score = {s: sum(FACTORS[k]*ranks[k][s] for k in FACTORS) for s in UNIVERSE}\n    breadth = np.mean([mom[s] > 0 for s in mom])\n    medv = float(np.median(list(vol.values())))\n    high_risk = medv > .018 or breadth < .45\n    inv_mean = np.mean([1/v for v in vol.values()])\n    defensive = {"XAU", "US10Y", "CN10Y"}\n    raw_target = {}\n    for s in UNIVERSE:\n        iv = min((1/vol.get(s, medv))/inv_mean, 1.5)\n        tilt = 1.12 if high_risk and s in defensive else 1.\n        raw_target[s] = max(score[s], .05) * (.85+.15*iv) * tilt\n    rebalance_to_weights(bounded(raw_target))\n', 'file_path': 'strategy.py'})
