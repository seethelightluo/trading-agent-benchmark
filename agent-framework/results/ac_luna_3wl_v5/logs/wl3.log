  ▶️ write_file({'content': 'import numpy as np\nfrom alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights\n\nUNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]\n# Screener ensemble, capped at six active factors and aligned to positive ranks.\nFACTORS = {"peer5": 0.22, "volstate_rev1": 0.22, "mom20": 0.18,\n           "idio_rev1": 0.16, "resid40": 0.12, "risk_rev1": 0.10}\nREBALANCE_DAYS = 10\nMIN_W, MAX_W = 0.03, 0.15\n_day = 0\n_last_score = None\n\n\ndef cs_rank(values):\n    valid = sorted((s, float(v)) for s, v in values.items() if np.isfinite(v))\n    out = {s: 0.5 for s in UNIVERSE}\n    n = len(valid)\n    if n:\n        for i, (s, _) in enumerate(valid):\n            out[s] = (i + 1.0) / n\n    return out\n\n\ndef bounded_weights(raw):\n    # Capped simplex projection: complete, long-only, 15-asset target.\n    base = {s: max(float(raw.get(s, 0.05)), 1e-12) for s in UNIVERSE}\n    active, fixed = set(UNIVERSE), {}\n    for _ in range(50):\n        left = 1.0 - sum(fixed.values())\n        denom = sum(base[s] for s in active)\n        trial = {s: left * base[s] / denom for s in active} if denom else {}\n        changed = False\n        for s, w in list(trial.items()):\n            if w < MIN_W:\n                fixed[s] = MIN_W; active.remove(s); changed = True\n            elif w > MAX_W:\n                fixed[s] = MAX_W; active.remove(s); changed = True\n        if not changed:\n            fixed.update(trial); break\n    ans = {s: fixed.get(s, 0.0) for s in UNIVERSE}\n    total = sum(ans.values())\n    return {s: ans[s] / total for s in UNIVERSE} if total > 0 else {s: 1/15 for s in UNIVERSE}\n\n\n@register_hook\ndef cross_asset_strategy():\n    global _day, _last_score\n    _day += 1\n    if _day != 1 and (_day - 1) % REBALANCE_DAYS != 0:\n        return\n    data, returns, vols = {}, {}, {}\n    for s in UNIVERSE:\n        df = get_stock_daily_data(symbol=s, days=230)\n        if df is None or len(df) < 70:\n            continue\n        close = np.asarray(df.sort_values("date")["close"], dtype=float)\n        if np.any(~np.isfinite(close[-70:])) or np.any(close[-70:] <= 0):\n            continue\n        r = close[1:] / close[:-1] - 1.0\n        data[s], returns[s] = df, r\n        vols[s] = max(float(np.std(r[-20:])), 0.006)\n    if len(returns) < 10:\n        return\n\n    r1 = {s: r[-1] for s, r in returns.items()}\n    r3 = {s: float(np.prod(1+r[-3:])-1) for s, r in returns.items()}\n    r5 = {s: float(np.prod(1+r[-5:])-1) for s, r in returns.items()}\n    r20 = {s: float(np.prod(1+r[-20:])-1) for s, r in returns.items()}\n    r40 = {s: float(np.prod(1+r[-40:])-1) for s, r in returns.items()}\n    eq = [s for s in UNIVERSE[:8] if s in returns]\n    eq_med = np.median([r40[s] for s in eq]) if eq else np.median(list(r40.values()))\n    med5, med3 = np.median(list(r5.values())), np.median(list(r3.values()))\n    breadth = np.mean([x > 0 for x in r20.values()])\n    stress = breadth < .45 or med5 < 0 or np.median(list(vols.values())) > .018\n\n    f = {k: {} for k in FACTORS}\n    for s, r in returns.items():\n        v = vols[s]\n        # Proxies preserve the submitted factor directions and use only lagged prices.\n        f["peer5"][s] = r5[s] - np.median([r5[t] for t in returns if t != s])\n        f["volstate_rev1"][s] = -r1[s] / (v + .006) * (1.0 + min(v/.02, 1.0))\n        f["mom20"][s] = r20[s] / (v*np.sqrt(20) + .01)\n        f["idio_rev1"][s] = -r1[s] / (v + .004)\n        f["resid40"][s] = (r40[s] - eq_med) / (v*np.sqrt(40) + .02)\n        f["risk_rev1"][s] = -r1[s] / (v + .006)\n    ranks = {k: cs_rank(x) for k, x in f.items()}\n    scores = {s: sum(FACTORS[k] * ranks[k].get(s, .5) for k in FACTORS) for s in returns}\n    if _last_score is not None:\n        scores = {s: .65*x + .35*_last_score.get(s, x) for s, x in scores.items()}\n    _last_score = scores.copy()\n\n    defensive = {"XAU", "US10Y", "CN10Y"}\n    mean_inv = np.mean([1/v for v in vols.values()])\n    raw = {}\n    for s in UNIVERSE:\n        damp = min((1/vols.get(s, .02))/mean_inv, 1.25)\n        raw[s] = max(scores.get(s, .5), .05) * (.88 + .12*damp)\n        if stress and s in defensive:\n            raw[s] *= 1.35\n    target = bounded_weights(raw)\n    if abs(sum(target.values())-1) < 1e-8 and all(np.isfinite(x) and x >= 0 for x in target.values()):\n        rebalance_to_weights(target)\n', 'file_path': 'strategy.py'})
