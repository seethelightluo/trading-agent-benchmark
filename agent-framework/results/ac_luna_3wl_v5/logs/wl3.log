ior = c[-61:-1] if len(c) >= 61 else c[:-1]\n        d[s] = {\n            "vol": vol,\n            # downside-adjusted 20-session momentum\n            "dm": (np.prod(1+r[-20:])-1.0) / dn,\n            # volatility-normalized distance above/below prior 60d high\n            "bo": (c[-1]/max(np.max(prior),1e-12)-1.0) / max(vol*np.sqrt(60), .01),\n            # up-day dominance, mildly smoothed by the 30d window\n            "up": float(np.mean(r[-30:] > 0)),\n            # additional medium horizon risk-adjusted momentum\n            "m60": (np.prod(1+r[-60:])-1.0) / max(vol*np.sqrt(60), .01),\n        }\n    if len(d) < 10: return\n    rr = [ranks({s:x[k] for s,x in d.items()}) for k in ("dm","bo","up","m60")]\n    score = {s: sum(FACTOR_W[j]*rr[j][s] for j in range(4)) for s in UNIVERSE}\n    if _previous is not None:\n        score = {s: .70*score[s] + .30*_previous[s] for s in UNIVERSE}\n    _previous = score.copy()\n    medvol = float(np.median([x["vol"] for x in d.values()]))\n    breadth = float(np.mean([x["m60"] > 0 for x in d.values()]))\n    high_risk = medvol > .018 or breadth < .45\n    invmean = float(np.mean([1.0/x["vol"] for x in d.values()]))\n    raw = {}\n    for s in UNIVERSE:\n        x = d.get(s, {"vol":medvol, "m60":0.0})\n        damp = np.clip((1/x["vol"])/max(invmean,1e-12), .65, 1.35)\n        raw[s] = max(score[s], .08) * (.86 + .14*damp)\n        # In a high-risk sideways regime, express defense with tradable assets.\n        if high_risk and s in DEFENSIVE: raw[s] *= 1.8\n        if high_risk and s not in DEFENSIVE and x["m60"] < -.08: raw[s] *= .80\n    rebalance_to_weights(bounded(raw))\n', 'file_path': 'strategy.py'})
