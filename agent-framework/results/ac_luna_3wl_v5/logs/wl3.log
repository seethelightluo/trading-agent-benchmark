 import numpy as np
from alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights

UNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
# Screener 2026-07-30 ensemble (8 active factors, quality-IC tilt).
FACTOR_W = {"volstate_rev": .16, "peer_leadlag": .16, "ram20": .15,
            "total_rev": .14, "rev5": .12, "cross_resid": .11,
            "equity_resid": .09, "stress_rev": .07}
REBALANCE_DAYS = 10
MIN_W, MAX_W = .02, .14
_day = 0


def rank(x):
    good = [(s, v) for s, v in x.items() if np.isfinite(v)]
    out = {s: .5 for s in UNIVERSE}
    if not good:
        return out
    good.sort(key=lambda z: z[1])
    for i, (s, _) in enumerate(good):
        out[s] = (i + 1.) / len(good)
    return out


def bounded(raw):
    # Iterative capped-simplex projection; guarantees a complete, cash-free target.
    w = {s: max(float(raw.get(s, 1e-6)), 1e-9) for s in UNIVERSE}
    fixed, active = {}, set(UNIVERSE)
    for _ in range(30):
        left = 1. - sum(fixed.values())
        den = sum(w[s] for s in active)
        if left <= 0 or den <= 0:
            return {s: 1. / len(UNIVERSE) for s in UNIVERSE}
        trial = {s: left * w[s] / den for s in active}
        clipped = False
        for s, v in list(trial.items()):
            if v < MIN_W:
                fixed[s] = MIN_W; active.remove(s); clipped = True
            elif v > MAX_W:
                fixed[s] = MAX_W; active.remove(s); clipped = True
        if not clipped:
            fixed.update(trial); break
    total = sum(fixed.values())
    return {s: fixed.get(s, 0.) / total for s in UNIVERSE}


def ret(r, n):
    return float(np.prod(1. + r[-n:]) - 1.) if len(r) >= n else np.nan


@register_hook
def cross_asset_strategy():
    global _day
    _day += 1
    if _day != 1 and (_day - 1) % REBALANCE_DAYS != 0:
        return

    rets, vols, closes = {}, {}, {}
    for s in UNIVERSE:
        df = get_stock_daily_data(symbol=s, days=180)
        if df is None or len(df) < 50:
            continue
        c = np.asarray(df.sort_values("date")["close"], dtype=float)
        if np.any(~np.isfinite(c[-50:])) or np.any(c[-50:] <= 0):
            continue
        r = c[1:] / c[:-1] - 1.
        rets[s], closes[s] = r, c
        vols[s] = max(float(np.std(r[-20:])), .006)
    if len(rets) < 10:
        return

    # Proxies use only completed daily observations.  Cross-sectional ranks preserve
    # the screener's positive factor directions without introducing observation-only orders.
    f = {k: {} for k in FACTOR_W}
    r1 = {s: r[-1] for s, r in rets.items()}
    r3 = {s: ret(r, 3) for s, r in rets.items()}
    r5 = {s: ret(r, 5) for s, r in rets.items()}
    r20 = {s: ret(r, 20) for s, r in rets.items()}
    med5 = float(np.median(list(r5.values())))
    med20 = float(np.median(list(r20.values())))
    for s, r in rets.items():
        v = vols[s]
        # Volatility-state and total overnight/intraday reversal are damped by risk.
        f["volstate_rev"][s] = -r1[s] / (v * (1. + 2. * v) + .004)
        f["total_rev"][s] = -r1[s] / (v * np.sqrt(20.) + .005)
        f["rev5"][s] = -r5[s] / (v * np.sqrt(5.) + .005)
        f["ram20"][s] = r20[s] / (v * np.sqrt(20.) + .01)
        f["peer_leadlag"][s] = r5[s] - np.median([r5[t] for t in rets if t != s])
        # Residual-style signals relative to broad cross-sectional benchmarks.
        f["cross_resid"][s] = r3[s] - np.median([r3[t] for t in rets if t != s])
        f["equity_resid"][s] = r20[s] - med20
        f["stress_rev"][s] = -r3[s] / (v + .01)

    scores = {s: sum(FACTOR_W[k] * rank(f[k])[s] for k in FACTOR_W) for s in rets}
    breadth = np.mean([r20[s] > 0 for s in rets])
    stressed = np.median(list(vols.values())) > .018 or breadth < .45
    invmean = np.mean([1. / v for v in vols.values()])
    raw = {}
    for s in UNIVERSE:
        sc = scores.get(s, .5)
        risk_damp = min((1. / vols.get(s, .02)) / invmean, 1.35)
        raw[s] = max(sc, .05) * (.88 + .12 * risk_damp)
        if stressed and s in {"XAU", "US10Y", "CN10Y"}:
            raw[s] *= 1.15
    target = bounded(raw)
    if set(target) == set(UNIVERSE) and all(np.isfinite(v) and v >= 0 for v in target.values()):
        rebalance_to_weights(target)


