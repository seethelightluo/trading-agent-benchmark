 import numpy as np
from alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights

UNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
DEFENSIVE = {"XAU", "US10Y", "CN10Y"}
CADENCE = 10
MIN_W, MAX_W = 0.04, 0.20
# Screener ensemble, capped at eight active factors.
FACTORS = ("failure", "residual", "downside", "volstate", "consistency", "short_breakout", "breakout120", "dispersion")
FACTOR_W = (0.18, 0.18, 0.14, 0.12, 0.10, 0.10, 0.10, 0.08)
_day = 0
_previous = None


def rank_cs(values):
    valid = sorted((s, float(v)) for s, v in values.items() if np.isfinite(v))
    out = {s: 0.5 for s in UNIVERSE}
    n = len(valid)
    for i, (s, _) in enumerate(valid):
        out[s] = (i + 1.0) / max(n, 1)
    return out


def bounded_weights(raw):
    # Iterative projection keeps every tradable asset invested and bounded.
    w = {s: max(float(raw.get(s, 1.0)), 1e-12) for s in UNIVERSE}
    fixed = {}
    for _ in range(30):
        free = [s for s in UNIVERSE if s not in fixed]
        remain = 1.0 - sum(fixed.values())
        denom = sum(w[s] for s in free)
        for s in free:
            w[s] = remain * w[s] / max(denom, 1e-12)
        hits = [s for s in free if w[s] < MIN_W or w[s] > MAX_W]
        if not hits:
            break
        for s in hits:
            fixed[s] = MIN_W if w[s] < MIN_W else MAX_W
            w[s] = fixed[s]
    total = sum(w.values())
    return {s: w[s] / total for s in UNIVERSE}


@register_hook
def cross_asset_strategy():
    global _day, _previous
    _day += 1
    if _day != 1 and (_day - 1) % CADENCE != 0:
        return

    feats, returns = {}, {}
    for symbol in UNIVERSE:
        df = get_stock_daily_data(symbol=symbol, days=195)
        if df is None or len(df) < 135:
            continue
        close = np.asarray(df.sort_values("date")["close"], dtype=float)[:-1]
        if len(close) < 125 or np.any(~np.isfinite(close)) or np.any(close <= 0):
            continue
        r = close[1:] / close[:-1] - 1.0
        vol = max(float(np.std(r[-20:])), 0.006)
        r3 = np.prod(1.0 + r[-3:]) - 1.0
        r5 = np.prod(1.0 + r[-5:]) - 1.0
        r20 = np.prod(1.0 + r[-20:]) - 1.0
        r30 = np.prod(1.0 + r[-30:]) - 1.0
        h20, h120 = max(close[-21:]), max(close[-121:])
        downvol = max(float(np.sqrt(np.mean(np.minimum(r[-20:], 0.0) ** 2))), 0.006)
        feats[symbol] = {
            "vol": vol,
            "failure": np.clip((-r5) * max(0.0, 1.0 - close[-1] / h20) / vol, -3, 3),
            "residual": r20 / max(vol * np.sqrt(20.0), 0.01),
            "downside": r20 / downvol,
            "volstate": np.clip(-r3 / vol, -3, 3),
            "consistency": r30 / max(vol * np.sqrt(30.0), 0.01) * (0.5 + np.mean(r[-30:] > 0)),
            "short_breakout": (close[-1] / h20 - 1.0) / max(vol * np.sqrt(20.0), 0.01),
            "breakout120": (close[-1] / h120 - 1.0) / max(vol * np.sqrt(120.0), 0.01),
            "dispersion": np.clip(-r5 / max(vol * np.sqrt(5.0), 0.01), -3, 3),
        }
        returns[symbol] = r

    if len(feats) < 10:
        return
    market = returns.get("SPX")
    if market is not None:
        for symbol, r in returns.items():
            n = min(60, len(r), len(market))
            if n >= 30:
                cov = np.cov(r[-n:], market[-n:], ddof=1)[0, 1]
                beta = cov / max(np.var(market[-n:], ddof=1), 1e-8)
                m20 = np.prod(1.0 + market[-20:]) - 1.0
                feats[symbol]["residual"] -= beta * m20 / max(np.std(market[-20:]) * np.sqrt(20.0), 0.01)

    ranks = [rank_cs({s: feats[s][f] for s in feats}) for f in FACTORS]
    score = {s: sum(FACTOR_W[i] * ranks[i][s] for i in range(len(FACTORS))) for s in UNIVERSE}
    if _previous is not None:
        score = {s: 0.75 * score[s] + 0.25 * _previous[s] for s in UNIVERSE}
    _previous = score.copy()

    median_vol = float(np.median([x["vol"] for x in feats.values()]))
    breadth = float(np.mean([x["breakout120"] > 0 for x in feats.values()]))
    stressed = median_vol > 0.018 or breadth < 0.45
    inv_vol_mean = float(np.mean([1.0 / x["vol"] for x in feats.values()]))
    raw = {}
    for symbol in UNIVERSE:
        x = feats.get(symbol, {"vol": median_vol, "breakout120": 0.0})
        damp = np.clip((1.0 / x["vol"]) / max(inv_vol_mean, 1e-12), 0.70, 1.20)
        raw[symbol] = max(score[symbol], 0.08) * (0.84 + 0.16 * damp)
        if stressed:
            raw[symbol] *= 2.0 if symbol in DEFENSIVE else (0.72 if x["breakout120"] < -0.10 else 0.84)

    target = bounded_weights(raw)
    if all(np.isfinite(target[s]) and target[s] >= 0 for s in UNIVERSE) and abs(sum(target.values()) - 1.0) < 1e-8:
        rebalance_to_weights(target)


