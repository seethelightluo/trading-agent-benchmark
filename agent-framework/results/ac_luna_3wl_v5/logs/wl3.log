      if df is None or len(df) < 45:\n            continue\n        df = df.sort_values("date").reset_index(drop=True)\n        c = np.asarray(df["close"], float)\n        h = np.asarray(df["high"], float)\n        l = np.asarray(df["low"], float)\n        v = np.asarray(df["volume"], float)\n        if np.any(~np.isfinite(c[-45:])) or np.any(c[-45:] <= 0):\n            continue\n        r = c[1:] / c[:-1] - 1.0\n        vol = max(float(np.nanstd(r[-20:])), .008)\n        returns[symbol], vols[symbol] = r, vol\n        span = h[-1] - l[-1]\n        signals["clv"][symbol] = (2*c[-1]-h[-1]-l[-1])/span if span > 0 else 0.0\n        signals["mom"][symbol] = compound(r, 20)/(vol*np.sqrt(20)+.01)\n        signals["rev5"][symbol] = -compound(r, 5)/(vol*np.sqrt(5)+.005)\n        downside = max(float(np.std(np.minimum(r[-10:], 0.0))), .004)\n        signals["downrev"][symbol] = -compound(r, 3)/(downside*np.sqrt(3)+.005)\n        signals["dispersion"][symbol] = -compound(r, 3)  # completed-day relative dispersion below\n        medv = np.nanmedian(v[-21:-1])\n        boost = np.clip(v[-1]/medv, .75, 1.5) if np.isfinite(medv) and medv > 0 else 1.0\n        signals["volrev"][symbol] = (-r[-1]/vol) * (1.0 + .20*max(boost-1.0, 0.0))\n\n    if len(returns) < 8:\n        return\n    r5 = {s: compound(r, 5) for s, r in returns.items()}\n    r20 = {s: compound(r, 20) for s, r in returns.items()}\n    r3 = {s: compound(r, 3) for s, r in returns.items()}\n    med5, med3 = np.median(list(r5.values())), np.median(list(r3.values()))\n    for s in returns:\n        # Peer-median lead-lag: favor recent relative leaders (positive direction).\n        signals["peer"][s] = r5[s] - np.median([r5[t] for t in returns if t != s])\n        # Relative-dispersion reversal: fade unusually weak/strong 3-day moves.\n        signals["dispersion"][s] = -(r3[s] - med3)\n        # Macro residual proxy: remove the common cross-sectional move; DXY is\n        # observation-only and is deliberately never included in the portfolio.\n        signals["macrorev"][s] = -(r3[s] - med3) / (vols[s] + .01)\n        signals["residual"] = {}  # no orderable macro asset is ever added\n\n    ranks = {f: rank(signals[f]) for f in FACTORS}\n    score = {s: sum(FACTORS[f] * ranks[f][s] for f in FACTORS) for s in UNIVERSE}\n    medvol = float(np.median(list(vols.values())))\n    breadth = float(np.mean([r20[s] > 0 for s in returns]))\n    stress = medvol > .018 or breadth < .45\n    invmean = float(np.mean([1.0/v for v in vols.values()]))\n    raw = {}\n    for s in UNIVERSE:\n        risk_scale = min((1.0/vols.get(s, medvol))/invmean, 1.5)\n        raw[s] = max(score[s], .05) * (.85 + .15*risk_scale)\n        if stress and s in {"XAU", "US10Y", "CN10Y"}:\n            raw[s] *= 1.15\n    target = bounded_weights(raw)\n    if (not np.isfinite(sum(target.values())) or abs(sum(target.values())-1.0) > 1e-8):\n        return\n    rebalance_to_weights(target)\n', 'file_path': 'strategy.py'})Traceback (most recent call last):
