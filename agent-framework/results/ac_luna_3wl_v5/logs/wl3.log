 import numpy as np
from alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights

UNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
# Current screener ensemble: emphasize robust medium-term trend and peer lead-lag;
# keep short-horizon reversal signals deliberately small after recent live losses.
FACTORS = {"leadlag": .22, "mom20": .24, "volstate": .10, "mom10": .16,
           "idio": .05, "residual": .10, "dxy_resid": .03,
           "shortrev": .03, "dispersion": .07}
MIN_W, MAX_W, REBALANCE_DAYS = .03, .15, 10
_day = 0
_previous = None


def ranks(values):
    good = sorted((s, float(v)) for s, v in values.items() if np.isfinite(v))
    out = {s: .5 for s in UNIVERSE}
    if not good:
        return out
    for i, (s, _) in enumerate(good):
        out[s] = (i + 1.) / len(good)
    return out


def bounded(raw):
    # Water filling enforces the complete 15-asset, long-only target contract.
    fixed, active = {}, set(UNIVERSE)
    for _ in range(40):
        rem = 1. - sum(fixed.values())
        den = sum(max(raw[s], 1e-8) for s in active)
        trial = {s: rem * max(raw[s], 1e-8) / den for s in active}
        moved = False
        for s, w in list(trial.items()):
            if w < MIN_W:
                fixed[s] = MIN_W; active.remove(s); moved = True
            elif w > MAX_W:
                fixed[s] = MAX_W; active.remove(s); moved = True
        if not moved:
            fixed.update(trial); break
    z = sum(fixed.values())
    return {s: fixed.get(s, 0.) / z for s in UNIVERSE}


@register_hook
def cross_asset_strategy():
    global _day, _previous
    _day += 1
    if _day != 1 and (_day - 1) % REBALANCE_DAYS != 0:
        return

    returns, vols = {}, {}
    for s in UNIVERSE:
        df = get_stock_daily_data(symbol=s, days=230)
        if df is None or len(df) < 70:
            continue
        c = np.asarray(df.sort_values("date")["close"], dtype=float)
        if np.any(~np.isfinite(c[-70:])) or np.any(c[-70:] <= 0):
            continue
        r = c[1:] / c[:-1] - 1.
        returns[s] = r
        vols[s] = max(float(np.std(r[-20:])), .006)
    if len(returns) < 10:
        return

    r1 = {s: r[-1] for s, r in returns.items()}
    r3 = {s: float(np.prod(1 + r[-3:]) - 1) for s, r in returns.items()}
    r5 = {s: float(np.prod(1 + r[-5:]) - 1) for s, r in returns.items()}
    r10 = {s: float(np.prod(1 + r[-10:]) - 1) for s, r in returns.items()}
    r20 = {s: float(np.prod(1 + r[-20:]) - 1) for s, r in returns.items()}
    r40 = {s: float(np.prod(1 + r[-40:]) - 1) for s, r in returns.items()}
    dispersion = float(np.std(list(r1.values())))
    breadth = float(np.mean([x > 0 for x in r20.values()]))
    high_risk = breadth < .50 or np.median(list(vols.values())) > .018 or np.median(list(r10.values())) < 0
    eq = [s for s in UNIVERSE[:8] if s in returns]
    bench = float(np.median([r40[s] for s in eq])) if eq else float(np.median(list(r40.values())))
    risk_complex = np.median([r3[t] for t in returns if t in UNIVERSE[:8]])

    fac = {k: {} for k in FACTORS}
    for s, r in returns.items():
        v = vols[s]
        peer = np.median([r5[t] for t in returns if t != s])
        fac["leadlag"][s] = r5[s] - peer
        fac["mom20"][s] = r20[s] / (v * np.sqrt(20) + .01)
        fac["mom10"][s] = r10[s] / (v * np.sqrt(10) + .008) + .25 * np.sign(r3[s]) * np.sign(r10[s])
        # Reversal factors are retained only as small diversifiers.
        fac["volstate"][s] = -r1[s] / (v + .006) * (1 + min(v / .02, 1))
        fac["idio"][s] = -r1[s] / (v + .004)
        fac["shortrev"][s] = -r1[s] / (v + .006)
        fac["dispersion"][s] = -r1[s] / (v + .006) * min(dispersion / .012, 1.5)
        fac["residual"][s] = (r40[s] - bench) / (v * np.sqrt(40) + .02)
        fac["dxy_resid"][s] = -(r3[s] - risk_complex) / (v * np.sqrt(3) + .01)

    rr = {k: ranks(v) for k, v in fac.items()}
    score = {s: sum(FACTORS[k] * rr[k].get(s, .5) for k in FACTORS) for s in returns}
    if _previous is not None:
        score = {s: .65 * score[s] + .35 * _previous.get(s, .5) for s in score}
    _previous = score.copy()

    invmean = np.mean([1. / v for v in vols.values()])
    defensive = {"XAU", "US10Y", "CN10Y"}
    raw = {}
    for s in UNIVERSE:
        inv = min((1. / vols.get(s, .02)) / invmean, 1.25)
        raw[s] = max(score.get(s, .5), .05) * (.88 + .12 * inv)
        if high_risk and s in defensive:
            raw[s] *= 1.55
    target = bounded(raw)
    if abs(sum(target.values()) - 1.0) < 1e-8 and all(np.isfinite(v) and v >= 0 for v in target.values()):
        rebalance_to_weights(target)


