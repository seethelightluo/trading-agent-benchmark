 import numpy as np
from alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights

UNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
DEFENSIVE = {"XAU", "US10Y", "CN10Y"}
CADENCE = 10
MIN_W, MAX_W = 0.04, 0.14
FACTOR_W = {"volstate": .20, "shock": .18, "cluster": .16, "intraday": .12, "dispersion": .11, "volscaled": .10, "macro": .07, "smooth": .06}
CLUSTERS = {"equity": {"000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX"}, "commodity": {"XAU", "COPPER", "WTI"}, "crypto": {"BTC", "ETH"}, "rates": {"US10Y", "CN10Y"}}
_day = 0
_previous = None

def rank(x):
    out = {s: .5 for s in UNIVERSE}
    good = sorted((s, float(v)) for s, v in x.items() if np.isfinite(v))
    for i, (s, _) in enumerate(good): out[s] = (i + 1.) / len(good)
    return out

def bounded(raw):
    w = {s: max(float(raw.get(s, 1.)), 1e-12) for s in UNIVERSE}; fixed = set()
    for _ in range(40):
        free = [s for s in UNIVERSE if s not in fixed]; rem = 1. - sum(w[s] for s in fixed); z = sum(w[s] for s in free)
        for s in free: w[s] = rem * w[s] / max(z, 1e-12)
        hit = [s for s in free if w[s] < MIN_W or w[s] > MAX_W]
        if not hit: break
        for s in hit: w[s] = MIN_W if w[s] < MIN_W else MAX_W
        fixed.update(hit)
    z = sum(w.values()); return {s: w[s] / z for s in UNIVERSE}

@register_hook
def cross_asset_strategy():
    global _day, _previous
    _day += 1
    if _day != 1 and (_day - 1) % CADENCE != 0: return
    data = {}
    for s in UNIVERSE:
        df = get_stock_daily_data(symbol=s, days=270)
        if df is None or len(df) < 160: continue
        c = np.asarray(df.sort_values("date")["close"], dtype=float)
        if np.any(~np.isfinite(c)) or np.any(c <= 0): continue
        r = c[1:] / c[:-1] - 1.
        data[s] = {"r": r, "h3": np.prod(1+r[-3:])-1, "h5": np.prod(1+r[-5:])-1, "h10": np.prod(1+r[-10:])-1, "h20": np.prod(1+r[-20:])-1, "h60": np.prod(1+r[-60:])-1, "h120": np.prod(1+r[-120:])-1, "v5": max(np.std(r[-5:]), .006), "v20": max(np.std(r[-20:]), .006), "v60": max(np.std(r[-60:]), .006)}
    if len(data) < 10: return
    syms = list(data); med = {k: np.median([data[s][k] for s in syms]) for k in ("h5", "h10", "h20", "v5", "v20", "v60")}; fac = {k: {} for k in FACTOR_W}
    for s in syms:
        x = data[s]; cluster = next((k for k, m in CLUSTERS.items() if s in m), None); peers = [data[t]["r"][-5:] for t in syms if t in CLUSTERS.get(cluster, set())]; peer = np.median(peers, axis=0) if peers else np.zeros(5)
        fac["volstate"][s] = (med["v5"] / med["v60"] - x["v5"] / x["v60"]) / (x["v20"] + .01)
        fac["shock"][s] = -x["h3"] / (x["v5"] * np.sqrt(3) + .02); fac["cluster"][s] = -np.sum(x["r"][-5:] - peer) / (x["v20"] + .01)
        fac["intraday"][s] = -x["h5"] / (x["v5"] * np.sqrt(5) + .02); fac["dispersion"][s] = (med["h10"] - x["h10"]) / (x["v20"] * np.sqrt(10) + .02)
        fac["volscaled"][s] = (med["h5"] - x["h5"]) / (x["v20"] * np.sqrt(5) + .02); fac["macro"][s] = (med["h20"] - x["h20"]) / (x["v60"] * np.sqrt(20) + .02)
        fac["smooth"][s] = -(x["h5"]*.5 + x["h10"]*.3 + x["h20"]*.2) / (x["v20"] * np.sqrt(20) + .02)
    rr = {k: rank(v) for k, v in fac.items()}; score = {s: sum(FACTOR_W[k] * rr[k].get(s, .5) for k in FACTOR_W) for s in UNIVERSE}
    if _previous is not None: score = {s: .55*score[s] + .45*_previous[s] for s in UNIVERSE}
    _previous = score.copy(); breadth = np.mean([data[s]["h120"] > 0 for s in syms]); high_risk = np.median([data[s]["v20"] for s in syms]) > .018 or breadth < .50; invmean = np.mean([1./data[s]["v20"] for s in syms]); raw = {}
    for s in UNIVERSE:
        x = data.get(s, {"v20": .02, "h120": 0.}); invvol = (1./x["v20"]) / max(invmean, 1e-12) if s in data else 1.; raw[s] = max(score[s], .15) * (.94 + .06*np.clip(invvol, .7, 1.3))
        if high_risk and s in DEFENSIVE: raw[s] *= 2.0
        if high_risk and x["h120"] < -.12: raw[s] *= .85
    rebalance_to_weights(bounded(raw))


