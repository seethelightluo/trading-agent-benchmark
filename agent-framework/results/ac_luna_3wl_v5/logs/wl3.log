  ▶️ write_file({'content': 'import numpy as np\nfrom alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights\n\nUNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]\nDEFENSIVE = {"XAU", "US10Y", "CN10Y"}\nCADENCE = 10\nMIN_W, MAX_W = 0.04, 0.14\n# Screener 2027-12-30 ensemble, capped at eight active factors.\nFACTOR_W = {"volstate": .20, "shock": .18, "cluster": .16, "intraday": .12,\n            "dispersion": .11, "volscaled": .10, "macro": .07, "smooth": .06}\nCLUSTERS = {\n    "equity": {"000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX"},\n    "commodity": {"XAU", "COPPER", "WTI"}, "crypto": {"BTC", "ETH"},\n    "rates": {"US10Y", "CN10Y"}}\n_day = 0\n_previous = None\n\n\ndef rank(x):\n    out = {s: .5 for s in UNIVERSE}\n    good = sorted((s, float(v)) for s, v in x.items() if np.isfinite(v))\n    for i, (s, _) in enumerate(good):\n        out[s] = (i + 1.) / len(good)\n    return out\n\n\ndef bounded(raw):\n    # Iterative projection keeps every tradable asset invested and bounded.\n    w = {s: max(float(raw.get(s, 1.)), 1e-12) for s in UNIVERSE}\n    fixed = set()\n    for _ in range(40):\n        free = [s for s in UNIVERSE if s not in fixed]\n        rem = 1. - sum(w[s] for s in fixed)\n        z = sum(w[s] for s in free)\n        for s in free:\n            w[s] = rem * w[s] / max(z, 1e-12)\n        hit = [s for s in free if w[s] < MIN_W or w[s] > MAX_W]\n        if not hit:\n            break\n        for s in hit:\n            w[s] = MIN_W if w[s] < MIN_W else MAX_W\n        fixed.update(hit)\n    z = sum(w.values())\n    return {s: w[s] / z for s in UNIVERSE}\n\n\n@register_hook\ndef cross_asset_strategy():\n    global _day, _previous\n    _day += 1\n    if _day != 1 and (_day - 1) % CADENCE != 0:\n        return\n    data = {}\n    for s in UNIVERSE:\n        df = get_stock_daily_data(symbol=s, days=270)\n        if df is None or len(df) < 160:\n            continue\n        c = np.asarray(df.sort_values("date")["close"], dtype=float)\n        if np.any(~np.isfinite(c)) or np.any(c <= 0):\n            continue\n        r = c[1:] / c[:-1] - 1.\n        data[s] = {"r": r, "h3": np.prod(1+r[-3:])-1, "h5": np.prod(1+r[-5:])-1,\n                   "h10": np.prod(1+r[-10:])-1, "h20": np.prod(1+r[-20:])-1,\n                   "h60": np.prod(1+r[-60:])-1, "h120": np.prod(1+r[-120:])-1,\n                   "v5": max(np.std(r[-5:]), .006), "v20": max(np.std(r[-20:]), .006),\n                   "v60": max(np.std(r[-60:]), .006)}\n    if len(data) < 10:\n        return\n    syms = list(data)\n    med = {k: np.median([data[s][k] for s in syms]) for k in ("h5", "h10", "h20", "v20", "v60")}\n    fac = {k: {} for k in FACTOR_W}\n    for s in syms:\n        x = data[s]\n        cluster = next((k for k, m in CLUSTERS.items() if s in m), None)\n        peers = [data[t]["r"][-5:] for t in syms if t in CLUSTERS.get(cluster, set())]\n        peer = np.median(peers, axis=0) if peers else np.zeros(5)\n        # Higher score means more attractive; reversal factors use negative recent moves.\n        fac["volstate"][s] = (med["v5"] / med["v60"] - x["v5"] / x["v60"]) / (x["v20"] + .01)\n        fac["shock"][s] = -x["h3"] / (x["v5"] * np.sqrt(3) + .02)\n        fac["cluster"][s] = -np.sum(x["r"][-5:] - peer) / (x["v20"] + .01)\n        fac["intraday"][s] = -x["h5"] / (x["v5"] * np.sqrt(5) + .02)\n        fac["dispersion"][s] = (med["h10"] - x["h10"]) / (x["v20"] * np.sqrt(10) + .02)\n        fac["volscaled"][s] = (med["h5"] - x["h5"]) / (x["v20"] * np.sqrt(5) + .02)\n        fac["macro"][s] = (med["h20"] - x["h20"]) / (x["v60"] * np.sqrt(20) + .02)\n        fac["smooth"][s] = -(x["h5"]*.5 + x["h10"]*.3 + x["h20"]*.2) / (x["v20"] * np.sqrt(20) + .02)\n    rr = {k: rank(v) for k, v in fac.items()}\n    score = {s: sum(FACTOR_W[k] * rr[k].get(s, .5) for k in FACTOR_W) for s in UNIVERSE}\n    if _previous is not None:\n        score = {s: .55*score[s] + .45*_previous[s] for s in UNIVERSE}\n    _previous = score.copy()\n    breadth = np.mean([data[s]["h120"] > 0 for s in syms])\n    high_risk = np.median([data[s]["v20"] for s in syms]) > .018 or breadth < .50\n    invmean = np.mean([1./data[s]["v20"] for s in syms])\n    raw = {}\n    for s in UNIVERSE:\n        x = data.get(s, {"v20": .02, "h120": 0.})\n        invvol = (1./x["v20"]) / max(invmean, 1e-12) if s in data else 1.\n        raw[s] = max(score[s], .15) * (.94 + .06*np.clip(invvol, .7, 1.3))\n        if high_risk and s in DEFENSIVE:\n            raw[s] *= 2.0\n        if high_risk and x["h120"] < -.12:\n            raw[s] *= .85\n    rebalance_to_weights(bounded(raw))\n', 'file_path': 'strategy.py'})
