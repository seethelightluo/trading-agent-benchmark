  a=pd.DataFrame({'f':f.loc[d],'y':yy.loc[d]}).dropna()
  if len(a)>=8 and a.f.nunique()>1 and a.y.nunique()>1: vals.append(spearmanr(a.f,a.y).statistic);ns.append(len(a))
 return np.array(vals),ns
