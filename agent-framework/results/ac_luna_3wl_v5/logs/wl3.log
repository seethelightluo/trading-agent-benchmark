  ▶️ write_file({'content': 'import numpy as np\nfrom alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights\n\nUNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]\n# Current Screener ensemble (five active factors, all positive direction).\nFACTORS = {"lowvol_rev1": 0.28, "clv": 0.25, "peer": 0.20, "momentum20": 0.17, "reversal5": 0.10}\nREBALANCE_EVERY = 10\nMIN_WEIGHT, MAX_WEIGHT = 0.02, 0.14\n_calls = 0\n\ndef rank(values):\n    valid = sorted((s, float(v)) for s, v in values.items() if np.isfinite(v))\n    out = {s: 0.5 for s in UNIVERSE}\n    n = len(valid)\n    for i, (s, _) in enumerate(valid):\n        out[s] = (i + 1.0) / n if n > 1 else 0.5\n    return out\n\ndef bounded_simplex(raw):\n    # Box-constrained, full-investment projection; fractional weights are deliberate.\n    w = {s: max(float(raw.get(s, 1.0)), 1e-10) for s in UNIVERSE}\n    fixed = {}\n    free = set(UNIVERSE)\n    for _ in range(40):\n        left = 1.0 - sum(fixed.values())\n        scale = left / max(sum(w[s] for s in free), 1e-12)\n        clipped = []\n        for s in list(free):\n            q = w[s] * scale\n            if q < MIN_WEIGHT:\n                fixed[s] = MIN_WEIGHT; clipped.append(s)\n            elif q > MAX_WEIGHT:\n                fixed[s] = MAX_WEIGHT; clipped.append(s)\n            else:\n                w[s] = q\n        if not clipped:\n            break\n        free -= set(clipped)\n    if free:\n        left = 1.0 - sum(fixed.values())\n        z = sum(w[s] for s in free)\n        for s in free:\n            w[s] = left * w[s] / max(z, 1e-12)\n    w.update(fixed)\n    z = sum(w.values())\n    return {s: w[s] / z for s in UNIVERSE}\n\n@register_hook\ndef cross_asset_strategy():\n    global _calls\n    _calls += 1\n    if _calls > 1 and (_calls - 1) % REBALANCE_EVERY != 0:\n        return\n    one_day, clv, peer, mom, rev5, vol = {}, {}, {}, {}, {}, {}\n    for symbol in UNIVERSE:\n        df = get_stock_daily_data(symbol=symbol, days=90)\n        if df is None or len(df) < 26:\n            continue\n        df = df.sort_values("date").reset_index(drop=True)\n        c = np.asarray(df["close"], dtype=float)\n        h = np.asarray(df["high"], dtype=float)\n        l = np.asarray(df["low"], dtype=float)\n        if not np.all(np.isfinite(c[-26:])) or c[-1] <= 0:\n            continue\n        d = c[1:] / np.maximum(c[:-1], 1e-12) - 1.0\n        sigma = max(float(np.std(d[-20:])), 0.008)\n        one_day[symbol] = float(d[-1])\n        vol[symbol] = sigma\n        # CLV is neutralized by cross-sectional ranking; bad/missing ranges are neutral.\n        span = h[-1] - l[-1]\n        clv[symbol] = float((c[-1] - l[-1]) / span) if np.isfinite(span) and span > 0 else 0.5\n        rev5[symbol] = -float(c[-1] / max(c[-6], 1e-12) - 1.0)\n        # Volatility-scaled one-day reversal, damped to avoid noisy extremes.\n        lowvol_rev = -float(d[-1]) / sigma\n        one_day[symbol] = lowvol_rev\n        mom[symbol] = float((c[-1] / max(c[-21], 1e-12) - 1.0) / (sigma + 0.01))\n    if len(vol) < 8:\n        return\n    # Leave-one-out peer lead-lag proxy, using only completed daily observations.\n    rets = {s: mom[s] * (vol[s] + 0.01) for s in vol}\n    for s in vol:\n        others = [rets[t] for t in vol if t != s]\n        peer[s] = rets[s] - float(np.median(others)) if others else 0.0\n    ranks_all = {"lowvol_rev1": rank(one_day), "clv": rank(clv),\n                 "peer": rank(peer), "momentum20": rank(mom), "reversal5": rank(rev5)}\n    score = {s: sum(FACTORS[k] * ranks_all[k][s] for k in FACTORS) for s in vol}\n    # Bullish but medium-high risk: retain cyclicals, add only a modest defensive overlay\n    # when breadth deteriorates. Full investment is maintained in all regimes.\n    breadth = float(np.mean([rets[s] > 0 for s in vol]))\n    defensive = {"XAU", "US10Y", "CN10Y"}\n    cyclical = set(UNIVERSE) - defensive\n    tilt = {s: 1.0 for s in UNIVERSE}\n    if breadth < 0.40:\n        for s in cyclical: tilt[s] = 0.88\n        for s in defensive: tilt[s] = 1.35\n    elif breadth < 0.55:\n        for s in cyclical: tilt[s] = 0.95\n        for s in defensive: tilt[s] = 1.15\n    avg_inv = np.mean([1.0 / vol[s] for s in vol])\n    raw = {}\n    for s in UNIVERSE:\n        base = max(score.get(s, 0.5), 0.05)\n        iv = (1.0 / vol[s]) / max(avg_inv, 1e-12) if s in vol else 1.0\n        raw[s] = base * tilt[s] * (0.90 + 0.10 * min(iv, 2.0))\n    rebalance_to_weights(bounded_simplex(raw))\n', 'file_path': 'strategy.py'})
