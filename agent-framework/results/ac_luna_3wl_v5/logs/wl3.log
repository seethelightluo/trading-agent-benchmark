 import numpy as np
from alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights

UNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
# Current screener ensemble; weights sum to one and remain capped at six factors.
FACTORS = {
    "resid40": .20, "volume_rev": .20, "peer5": .20,
    "mom20": .24, "conditional": .11, "vol_rev3": .05,
}
REBALANCE_DAYS = 10
MIN_W, MAX_W = .03, .15
_day = 0
_last_score = None


def cs_rank(values):
    valid = sorted((s, x) for s, x in values.items() if np.isfinite(x))
    out = {s: .5 for s in UNIVERSE}
    n = len(valid)
    for i, (s, _) in enumerate(valid):
        out[s] = (i + 1.) / n
    return out


def cumulative(r, n):
    return float(np.prod(1. + r[-n:]) - 1.) if len(r) >= n else np.nan


def capped_simplex(raw):
    # Projection onto the complete, long-only portfolio with sensible bounds.
    active, fixed = set(UNIVERSE), {}
    base = {s: max(float(raw.get(s, .1)), 1e-10) for s in UNIVERSE}
    for _ in range(40):
        left = 1. - sum(fixed.values())
        denom = sum(base[s] for s in active)
        trial = {s: left * base[s] / denom for s in active}
        changed = False
        for s, x in list(trial.items()):
            if x < MIN_W:
                fixed[s] = MIN_W; active.remove(s); changed = True
            elif x > MAX_W:
                fixed[s] = MAX_W; active.remove(s); changed = True
        if not changed:
            fixed.update(trial); break
    total = sum(fixed.values())
    return {s: fixed.get(s, 0.) / total for s in UNIVERSE}


@register_hook
def cross_asset_strategy():
    global _day, _last_score
    _day += 1
    if _day != 1 and (_day - 1) % REBALANCE_DAYS != 0:
        return

    prices, returns, vol = {}, {}, {}
    for symbol in UNIVERSE:
        df = get_stock_daily_data(symbol=symbol, days=230)
        if df is None or len(df) < 70:
            continue
        df = df.sort_values("date")
        close = np.asarray(df["close"], dtype=float)
        if np.any(~np.isfinite(close[-70:])) or np.any(close[-70:] <= 0):
            continue
        prices[symbol], returns[symbol] = df, close[1:] / close[:-1] - 1.
        vol[symbol] = max(float(np.std(returns[symbol][-20:])), .006)
    if len(returns) < 10:
        return

    r5 = {s: cumulative(r, 5) for s, r in returns.items()}
    r20 = {s: cumulative(r, 20) for s, r in returns.items()}
    r40 = {s: cumulative(r, 40) for s, r in returns.items()}
    equity = [s for s in UNIVERSE[:8] if s in returns]
    med5 = float(np.median(list(r5.values())))
    med40 = float(np.median([r40[s] for s in equity])) if equity else med5
    breadth = float(np.mean([x > 0 for x in r5.values()]))
    market_vol = float(np.median(list(vol.values())))
    stress = breadth < .45 or med5 < 0 or market_vol > .018

    raw_f = {k: {} for k in FACTORS}
    all3 = {s: cumulative(r, 3) for s, r in returns.items()}
    med3 = float(np.median(list(all3.values())))
    for s, r in returns.items():
        v = vol[s]
        raw_f["mom20"][s] = r20[s] / (max(float(np.std(r[-60:])), .006) * np.sqrt(20.) + .01)
        # Cross-sectional lead/lag: asset's recent move relative to the other assets.
        peer = np.median([r5[t] for t in returns if t != s])
        raw_f["peer5"][s] = r5[s] - peer
        raw_f["resid40"][s] = (r40[s] - med40) / (v * np.sqrt(40.) + .02)
        # Conditional reversal is damped in stress rather than allowed to dominate.
        raw_f["conditional"][s] = ((-(cumulative(r, 3) - med3)) if stress else cumulative(r, 3)) / (v * np.sqrt(3.) + .012)
        volume = np.asarray(prices[s]["volume"], dtype=float)
        vz = 0.
        if len(volume) >= 20 and np.all(np.isfinite(volume[-20:])) and np.all(volume[-20:] > 0):
            lv = np.log(volume[-20:])
            vz = np.clip((lv[-1] - np.mean(lv)) / (np.std(lv) + 1e-9), -1., 2.)
        raw_f["volume_rev"][s] = -r[-1] * (1. + .5 * vz)
        raw_f["vol_rev3"][s] = -(cumulative(r, 3) - med3) / (v * np.sqrt(3.) + .012)

    ranks = {k: cs_rank(v) for k, v in raw_f.items()}
    scores = {s: sum(FACTORS[k] * ranks[k].get(s, .5) for k in FACTORS) for s in returns}
    if _last_score is not None:
        scores = {s: .65 * x + .35 * _last_score.get(s, x) for s, x in scores.items()}
    _last_score = scores.copy()

    defensive = {"XAU", "US10Y", "CN10Y"}
    mean_inv = np.mean([1. / x for x in vol.values()])
    raw = {}
    for s in UNIVERSE:
        inv = min((1. / vol.get(s, .02)) / mean_inv, 1.25)
        raw[s] = max(scores.get(s, .5), .05) * (.88 + .12 * inv)
        if stress and s in defensive:
            raw[s] *= 1.35
    target = capped_simplex(raw)
    if abs(sum(target.values()) - 1.) < 1e-8 and all(np.isfinite(x) and x >= 0 for x in target.values()):
        rebalance_to_weights(target)


