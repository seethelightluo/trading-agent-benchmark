  ▶️ write_file({'content': 'import numpy as np\nfrom alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights\n\nUNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]\nDEFENSIVE = {"XAU", "US10Y", "CN10Y"}\nCADENCE = 10\nMIN_W, MAX_W = .04, .18\n# Screener ensemble: eight active factors, quality/IC tilt weights sum to one.\nFACTORS = ("residual", "consistency", "short_breakout", "breakout120", "failure", "volstate", "dispersion", "relative")\nFACTOR_W = (.20, .16, .15, .10, .18, .08, .07, .06)\n_day = 0\n_previous = None\n\ndef rank_values(values):\n    valid = sorted((s, float(v)) for s, v in values.items() if np.isfinite(v))\n    out = {s: .5 for s in UNIVERSE}\n    for i, (s, _) in enumerate(valid):\n        out[s] = (i + 1.) / max(1, len(valid))\n    return out\n\ndef bounded(raw):\n    # Projection to a complete long-only vector with 4%-18% asset bounds.\n    w = {s: max(float(raw.get(s, 0.0)), 1e-10) for s in UNIVERSE}\n    fixed = {}\n    for _ in range(60):\n        free = [s for s in UNIVERSE if s not in fixed]\n        left = 1. - sum(fixed.values())\n        total = sum(w[s] for s in free)\n        for s in free:\n            w[s] = left * w[s] / max(total, 1e-12)\n        hit = [s for s in free if w[s] < MIN_W or w[s] > MAX_W]\n        if not hit:\n            break\n        for s in hit:\n            fixed[s] = MIN_W if w[s] < MIN_W else MAX_W\n            w[s] = fixed[s]\n    z = sum(w.values())\n    return {s: w[s] / max(z, 1e-12) for s in UNIVERSE}\n\n@register_hook\ndef cross_asset_strategy():\n    global _day, _previous\n    _day += 1\n    if _day != 1 and (_day - 1) % CADENCE != 0:\n        return\n\n    feat, returns = {}, {}\n    for symbol in UNIVERSE:\n        df = get_stock_daily_data(symbol=symbol, days=210)\n        if df is None or len(df) < 140:\n            continue\n        # The last row is the in-progress/current observation: deliberately exclude it.\n        close = np.asarray(df.sort_values("date")["close"], dtype=float)[:-1]\n        if len(close) < 125 or np.any(~np.isfinite(close)) or np.any(close <= 0):\n            continue\n        r = close[1:] / close[:-1] - 1.\n        v20 = max(float(np.std(r[-20:])), .006)\n        neg = r[-20:][r[-20:] < 0]\n        downvol = max(float(np.std(neg)) if len(neg) > 1 else v20, .006)\n        r3 = np.prod(1 + r[-3:]) - 1\n        r5 = np.prod(1 + r[-5:]) - 1\n        r20 = np.prod(1 + r[-20:]) - 1\n        r30 = np.prod(1 + r[-30:]) - 1\n        feat[symbol] = {\n            "residual": np.clip(r20 / (v20*np.sqrt(20)), -3, 3),\n            "consistency": np.clip(r30/(v20*np.sqrt(30)) * (.5 + np.mean(r[-30:] > 0)), -3, 3),\n            "short_breakout": np.clip(r20/(v20*np.sqrt(20)), -3, 3),\n            "breakout120": np.clip(close[-1]/max(close[-121:-1]) - 1, -3, 3),\n            "failure": np.clip(-r5/v20, -3, 3),\n            "volstate": np.clip(-r3/v20, -3, 3),\n            "relative": np.clip(r20/(v20*np.sqrt(20)), -3, 3),\n            "vol": v20,\n        }\n        returns[symbol] = r\n\n    if len(feat) < 10:\n        return\n    benchmark = returns.get("SPX")\n    if benchmark is not None:\n        for symbol, r in returns.items():\n            n = min(60, len(r), len(benchmark))\n            if n >= 30:\n                cov = np.cov(r[-n:], benchmark[-n:], ddof=1)[0, 1]\n                beta = cov / max(np.var(benchmark[-n:], ddof=1), 1e-8)\n                feat[symbol]["residual"] = np.clip(feat[symbol]["residual"] - beta * (np.prod(1+benchmark[-20:])-1), -3, 3)\n    # Dispersion reversal: favor names that recently lagged their cross-section,\n    # while rank normalization and the modest weight limit crowding/turnover.\n    cross_r20 = np.median([np.prod(1 + returns[s][-20:]) - 1 for s in feat])\n    for s in feat:\n        feat[s]["dispersion"] = np.clip(-(np.prod(1+returns[s][-20:])-1-cross_r20) / max(feat[s]["vol"]*np.sqrt(20), .01), -3, 3)\n\n    ranked = {f: rank_values({s: feat[s][f] for s in feat}) for f in FACTORS}\n    score = {s: sum(FACTOR_W[i]*ranked[FACTORS[i]][s] for i in range(len(FACTORS))) for s in UNIVERSE}\n    if _previous is not None:\n        score = {s: .70*score[s] + .30*_previous[s] for s in UNIVERSE}\n    _previous = score.copy()\n\n    median_vol = float(np.median([x["vol"] for x in feat.values()]))\n    breadth = float(np.mean([x["breakout120"] > 0 for x in feat.values()]))\n    stressed = median_vol > .018 or breadth < .40\n    inv_mean = float(np.mean([1./x["vol"] for x in feat.values()]))\n    raw = {}\n    for s in UNIVERSE:\n        x = feat.get(s, {"vol": median_vol, "breakout120": 0.})\n        damp = np.clip((1./x["vol"])/max(inv_mean, 1e-12), .80, 1.12)\n        raw[s] = max(score[s], .05) * (.90 + .10*damp)\n        if stressed:\n            raw[s] *= 1.22 if s in DEFENSIVE else (.88 if x["breakout120"] < 0 else .80)\n    target = bounded(raw)\n    if all(np.isfinite(v) and v >= 0 for v in target.values()) and abs(sum(target.values())-1.) < 1e-8:\n        rebalance_to_weights(target)\n\n# Full investment and fractional quantities are handled by rebalance_to_weights.\n', 'file_path': 'strategy.py'})
