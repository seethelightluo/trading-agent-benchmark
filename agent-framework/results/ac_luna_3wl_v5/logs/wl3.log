type=float)\n        if np.any(~np.isfinite(c[-70:])) or np.any(c[-70:] <= 0):\n            continue\n        r = c[1:] / c[:-1] - 1.\n        data[s], rets[s] = df, r\n        vols[s] = max(float(np.std(r[-20:])), .006)\n    if len(rets) < 10:\n        return\n\n    r1 = {s: r[-1] for s, r in rets.items()}\n    r5 = {s: float(np.prod(1 + r[-5:]) - 1) for s, r in rets.items()}\n    r10 = {s: float(np.prod(1 + r[-10:]) - 1) for s, r in rets.items()}\n    r20 = {s: float(np.prod(1 + r[-20:]) - 1) for s, r in rets.items()}\n    r40 = {s: float(np.prod(1 + r[-40:]) - 1) for s, r in rets.items()}\n    eq = [s for s in UNIVERSE[:8] if s in rets]\n    eq20 = float(np.median([r20[s] for s in eq]))\n    eq40 = float(np.median([r40[s] for s in eq]))\n    breadth = np.mean([x > 0 for x in r20.values()])\n    stress = breadth < .50 or np.median(list(r10.values())) < 0 or np.median(list(vols.values())) > .018\n    dispersion = max(float(np.std(list(r1.values()))), .006)\n\n    f = {k: {} for k in FACTORS}\n    for s, r in rets.items():\n        v = vols[s]\n        peer = np.median([r5[t] for t in rets if t != s])\n        # Proxies preserve the screener directions while damping noisy one-day signals.\n        f["lowvol_rev"][s] = -r1[s] / (v + .006)\n        f["peer"][s] = r5[s] - peer\n        f["mom20"][s] = r20[s] / (v * np.sqrt(20) + .01)\n        f["resid20"][s] = (r20[s] - peer) / (v * np.sqrt(20) + .01)\n        f["eq_resid40"][s] = (r40[s] - eq40) / (v * np.sqrt(40) + .02)\n        row = data[s].iloc[-1]\n        hi, lo, cl = float(row.get("high", 0)), float(row.get("low", 0)), float(row["close"])\n        f["clv"][s] = (2 * cl - hi - lo) / (hi - lo) if hi > lo else 0.\n        f["volstate_rev"][s] = -r1[s] / (v + .006) * (1. + min(v / .02, 1.))\n\n    rr = {k: rank(v) for k, v in f.items()}\n    score = {s: sum(FACTORS[k] * rr[k].get(s, .5) for k in FACTORS) for s in UNIVERSE}\n    if _previous is not None:\n        score = {s: .65 * score[s] + .35 * _previous.get(s, .5) for s in UNIVERSE}\n    _previous = score.copy()\n\n    invmean = np.mean([1. / v for v in vols.values()])\n    defensive = {"XAU", "US10Y", "CN10Y"}\n    raw = {}\n    for s in UNIVERSE:\n        invvol = min((1. / vols.get(s, .02)) / invmean, 1.20)\n        raw[s] = max(score[s], .05) * (.90 + .10 * invvol)\n        if stress and s in defensive:\n            raw[s] *= 1.85\n        # In a strong selloff, avoid rewarding assets whose 20-day trend is deeply negative.\n        if stress and s not in defensive and r20.get(s, 0.) < -0.08:\n            raw[s] *= .75\n    target = bounded(raw)\n    if all(np.isfinite(target[s]) and target[s] >= 0 for s in UNIVERSE) and abs(sum(target.values()) - 1.) < 1e-8:\n        rebalance_to_weights(target)\n', 'file_path': 'strategy.py'})
