 import numpy as np
from alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights

UNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
DEFENSIVE = {"XAU", "US10Y", "CN10Y"}
CADENCE = 10
MIN_W, MAX_W = 0.04, 0.14
# Current Screener ensemble (eight active factors; weights sum to one).
FACTOR_W = {"cluster": .17, "medium": .16, "volstate": .15, "volscaled": .13,
            "dispersion": .12, "stress": .10, "smooth": .09, "momentum": .08}
CLUSTERS = {
    "equity": {"000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX"},
    "commodity": {"XAU", "COPPER", "WTI"}, "crypto": {"BTC", "ETH"},
    "rates": {"US10Y", "CN10Y"}}
_day = 0
_previous = None


def ranks(values):
    out = {s: .5 for s in UNIVERSE}
    good = sorted((s, float(v)) for s, v in values.items() if np.isfinite(v))
    if not good:
        return out
    for i, (s, _) in enumerate(good):
        out[s] = (i + 1.) / len(good)
    return out


def cap_weights(raw):
    # Projection to a full-investment, non-negative, bounded 15-asset vector.
    w = {s: max(float(raw.get(s, 1.)), 1e-9) for s in UNIVERSE}
    fixed = set()
    for _ in range(30):
        free = [s for s in UNIVERSE if s not in fixed]
        rem = 1. - sum(w[s] for s in fixed)
        total = sum(w[s] for s in free)
        for s in free:
            w[s] = rem * w[s] / max(total, 1e-12)
        hit = {s for s in free if w[s] < MIN_W or w[s] > MAX_W}
        if not hit:
            break
        for s in hit:
            w[s] = MIN_W if w[s] < MIN_W else MAX_W
        fixed.update(hit)
    z = sum(w.values())
    return {s: w[s] / z for s in UNIVERSE}


@register_hook
def cross_asset_strategy():
    global _day, _previous
    _day += 1
    if _day != 1 and (_day - 1) % CADENCE:
        return
    data = {}
    for s in UNIVERSE:
        df = get_stock_daily_data(symbol=s, days=270)
        if df is None or len(df) < 160:
            continue
        df = df.sort_values("date")
        c = np.asarray(df["close"], dtype=float)
        if np.any(~np.isfinite(c)) or np.any(c <= 0):
            continue
        r = c[1:] / c[:-1] - 1.
        v5, v20, v60 = max(np.std(r[-5:]), .006), max(np.std(r[-20:]), .006), max(np.std(r[-60:]), .006)
        data[s] = {"r": r, "h3": np.prod(1+r[-3:])-1, "h5": np.prod(1+r[-5:])-1,
                   "h10": np.prod(1+r[-10:])-1, "h20": np.prod(1+r[-20:])-1,
                   "h60": np.prod(1+r[-60:])-1, "h120": np.prod(1+r[-120:])-1,
                   "v5": v5, "v20": v20, "v60": v60, "stress": v5 / v60}
    if len(data) < 10:
        return
    syms = list(data)
    med = {k: np.median([data[s][k] for s in syms]) for k in ("h3", "h5", "h10", "h20", "v20", "stress")}
    f = {k: {} for k in FACTOR_W}
    for s in syms:
        x = data[s]
        cluster = next((k for k, members in CLUSTERS.items() if s in members), None)
        peers = [data[t]["r"] for t in syms if t in CLUSTERS.get(cluster, set())]
        peer = np.median([a[-5:] for a in peers], axis=0) if peers else np.zeros(5)
        f["cluster"][s] = -np.sum(x["r"][-5:] - peer) / (x["v20"] + .01)
        f["medium"][s] = -(x["h10"] - med["h10"]) / (x["v20"]*np.sqrt(10) + .02)
        f["volstate"][s] = (med["stress"] - x["stress"]) / (x["v20"] + .01)
        f["volscaled"][s] = (med["h5"] - x["h5"]) / (x["v20"]*np.sqrt(5) + .02)
        f["dispersion"][s] = (med["h20"] - x["h20"]) / (x["v20"]*np.sqrt(20) + .02)
        f["stress"][s] = (med["stress"] - x["stress"]) / (x["v60"] + .01)
        f["smooth"][s] = -(0.5*x["h5"] + .3*x["h10"] + .2*x["h20"]) / (x["v20"]*np.sqrt(20) + .02)
        f["momentum"][s] = x["h20"] / (x["v20"]*np.sqrt(20) + .02)
    rr = {k: ranks(v) for k, v in f.items()}
    breadth = np.mean([data[s]["h120"] > 0 for s in syms])
    if breadth < .45:
        rr["momentum"] = {s: .5 for s in UNIVERSE}
    score = {s: sum(FACTOR_W[k]*rr[k].get(s, .5) for k in FACTOR_W) for s in UNIVERSE}
    if _previous is not None:
        score = {s: .55*score[s] + .45*_previous[s] for s in UNIVERSE}
    _previous = score.copy()
    high_risk = np.median([data[s]["v20"] for s in syms]) > .018 or breadth < .50
    invmean = np.mean([1./data[s]["v20"] for s in syms])
    raw = {}
    for s in UNIVERSE:
        x = data.get(s, {"v20": .02, "h120": 0.})
        invvol = (1./x["v20"])/max(invmean, 1e-12) if s in data else 1.
        raw[s] = max(score[s], .15) * (.94 + .06*np.clip(invvol, .7, 1.3))
        if high_risk and s in DEFENSIVE:
            raw[s] *= 2.0
        if high_risk and x["h120"] < -.12:
            raw[s] *= .85
    rebalance_to_weights(cap_weights(raw))
