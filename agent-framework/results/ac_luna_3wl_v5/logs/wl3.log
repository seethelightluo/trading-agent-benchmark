len(close) < 125 or np.any(~np.isfinite(close)) or np.any(close <= 0):\n            continue\n        r = close[1:] / close[:-1] - 1.0\n        vol = max(float(np.std(r[-20:])), 0.006)\n        r3 = np.prod(1 + r[-3:]) - 1.0\n        r5 = np.prod(1 + r[-5:]) - 1.0\n        r20 = np.prod(1 + r[-20:]) - 1.0\n        r30 = np.prod(1 + r[-30:]) - 1.0\n        h20, h120 = max(close[-21:]), max(close[-121:])\n        downvol = max(float(np.sqrt(np.mean(np.minimum(r[-20:], 0.0) ** 2))), 0.006)\n        feats[symbol] = {\n            "vol": vol,\n            # failure/reversal is active mainly after a recent failed high\n            "failure": np.clip((-r5) * max(0.0, close[-1] / h20 - 0.985) / vol, -3, 3),\n            "volstate": np.clip(-r3 / vol, -3, 3),\n            "dispersion": np.clip(-r5 / max(vol * np.sqrt(5), 0.01), -3, 3),\n            "residual": r20 / max(vol * np.sqrt(20), 0.01),\n            "consistency": r30 / max(vol * np.sqrt(30), 0.01) * (0.5 + np.mean(r[-30:] > 0)),\n            "short_breakout": (close[-1] / h20 - 1.0) / max(vol * np.sqrt(20), 0.01),\n            "breakout120": (close[-1] / h120 - 1.0) / max(vol * np.sqrt(120), 0.01),\n            "downside": r20 / downvol,\n        }\n        rets[symbol] = r\n    if len(feats) < 10:\n        return\n\n    # Remove common SPX beta from residual momentum using only recent history.\n    market = rets.get("SPX")\n    if market is not None:\n        for s, r in rets.items():\n            n = min(60, len(r), len(market))\n            if n >= 30:\n                beta = np.cov(r[-n:], market[-n:], ddof=1)[0, 1] / max(np.var(market[-n:], ddof=1), 1e-8)\n                m20 = np.prod(1 + market[-20:]) - 1.0\n                feats[s]["residual"] -= beta * m20 / max(np.std(market[-20:]) * np.sqrt(20), 0.01)\n\n    ranks = [rank_cs({s: feats[s][f] for s in feats}) for f in FACTORS]\n    score = {s: sum(FACTOR_W[i] * ranks[i][s] for i in range(len(FACTORS))) for s in UNIVERSE}\n    if _previous is not None:\n        score = {s: 0.75 * score[s] + 0.25 * _previous[s] for s in UNIVERSE}\n    _previous = score.copy()\n\n    medvol = float(np.median([x["vol"] for x in feats.values()]))\n    breadth = float(np.mean([x["breakout120"] > 0 for x in feats.values()]))\n    stressed = medvol > 0.018 or breadth < 0.45\n    invmean = float(np.mean([1.0 / x["vol"] for x in feats.values()]))\n    raw = {}\n    for s in UNIVERSE:\n        x = feats.get(s, {"vol": medvol, "breakout120": 0.0})\n        damp = np.clip((1.0 / x["vol"]) / max(invmean, 1e-12), 0.70, 1.20)\n        raw[s] = max(score[s], 0.08) * (0.84 + 0.16 * damp)\n        if stressed:\n            raw[s] *= 2.0 if s in DEFENSIVE else (0.72 if x["breakout120"] < -0.10 else 0.84)\n    target = bounded_weights(raw)\n    if all(np.isfinite(target[s]) and target[s] >= 0 for s in UNIVERSE) and abs(sum(target.values()) - 1.0) < 1e-8:\n        rebalance_to_weights(target)\n', 'file_path': 'strategy.py'})
