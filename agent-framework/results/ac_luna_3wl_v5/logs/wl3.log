 import numpy as np
from alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights

UNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
# Current screener ensemble: eight active, rank-normalized, direction=+1.
FACTORS = {"volstate": .20, "leadlag": .17, "mom20": .16, "idio": .13,
           "mom10": .12, "residual": .10, "shortrev": .08, "dispersion": .04}
MIN_W, MAX_W, REBALANCE_DAYS = .03, .15, 10
_day = 0
_previous = None


def rank_map(x):
    good = sorted((s, float(v)) for s, v in x.items() if np.isfinite(v))
    out = {s: .5 for s in UNIVERSE}
    if good:
        n = len(good)
        for i, (s, _) in enumerate(good): out[s] = (i + 1.) / n
    return out


def cap_weights(raw):
    fixed, active = {}, set(UNIVERSE)
    base = {s: max(float(raw.get(s, .01)), 1e-8) for s in UNIVERSE}
    for _ in range(30):
        rem = 1. - sum(fixed.values())
        den = sum(base[s] for s in active)
        trial = {s: rem * base[s] / den for s in active}
        changed = False
        for s, w in list(trial.items()):
            if w < MIN_W: fixed[s] = MIN_W; active.remove(s); changed = True
            elif w > MAX_W: fixed[s] = MAX_W; active.remove(s); changed = True
        if not changed:
            fixed.update(trial); break
    z = sum(fixed.values())
    return {s: fixed.get(s, 0.) / z for s in UNIVERSE}


@register_hook
def cross_asset_strategy():
    global _day, _previous
    _day += 1
    if _day != 1 and (_day - 1) % REBALANCE_DAYS != 0: return
    ret, vol = {}, {}
    for s in UNIVERSE:
        df = get_stock_daily_data(symbol=s, days=230)
        if df is None or len(df) < 70: continue
        c = np.asarray(df.sort_values("date")["close"], dtype=float)
        if len(c) < 70 or np.any(~np.isfinite(c[-70:])) or np.any(c[-70:] <= 0): continue
        r = c[1:] / c[:-1] - 1.
        ret[s] = r; vol[s] = max(float(np.std(r[-20:])), .006)
    if len(ret) < 10: return
    r1 = {s: r[-1] for s, r in ret.items()}
    r3 = {s: float(np.prod(1+r[-3:])-1) for s, r in ret.items()}
    r5 = {s: float(np.prod(1+r[-5:])-1) for s, r in ret.items()}
    r10 = {s: float(np.prod(1+r[-10:])-1) for s, r in ret.items()}
    r20 = {s: float(np.prod(1+r[-20:])-1) for s, r in ret.items()}
    r40 = {s: float(np.prod(1+r[-40:])-1) for s, r in ret.items()}
    dispersion = float(np.std(list(r1.values())))
    breadth = float(np.mean([x > 0 for x in r20.values()]))
    high_risk = breadth < .45 or np.median(list(vol.values())) > .018 or np.median(list(r5.values())) < 0
    eq = [s for s in UNIVERSE[:8] if s in ret]
    bench = float(np.median([r40[s] for s in eq])) if eq else float(np.median(list(r40.values())))
    f = {k: {} for k in FACTORS}
    for s in ret:
        v = vol[s]
        f["volstate"][s] = -r1[s] / (v+.006) * (1+min(v/.02, 1))
        f["idio"][s] = -r1[s] / (v+.004)
        f["shortrev"][s] = -r1[s] / (v+.006)
        f["mom20"][s] = r20[s] / (v*np.sqrt(20)+.01)
        # trend-confirmed momentum: require agreement of 10d and 3d direction
        f["mom10"][s] = (r10[s] / (v*np.sqrt(10)+.008)) + .25*np.sign(r3[s])*np.sign(r10[s])
        peers = [r5[t] for t in ret if t != s]
        f["leadlag"][s] = r5[s] - (np.median(peers) if peers else 0.)
        f["residual"][s] = (r40[s]-bench) / (v*np.sqrt(40)+.02)
        f["dispersion"][s] = -r1[s]/(v+.006) * min(dispersion/.012, 1.5)
    ranks = {k: rank_map(v) for k, v in f.items()}
    score = {s: sum(FACTORS[k]*ranks[k].get(s,.5) for k in FACTORS) for s in ret}
    if _previous is not None: score = {s: .65*score[s]+.35*_previous.get(s,.5) for s in score}
    _previous = score.copy()
    invmean = np.mean([1./v for v in vol.values()])
    defensive = {"XAU", "US10Y", "CN10Y"}
    raw = {}
    for s in UNIVERSE:
        inv = min((1./vol.get(s,.02))/invmean, 1.25)
        raw[s] = max(score.get(s,.5), .05) * (.88+.12*inv)
        if high_risk and s in defensive: raw[s] *= 1.35
    target = cap_weights(raw)
    if len(target) == 15 and all(np.isfinite(v) and v >= 0 for v in target.values()):
        rebalance_to_weights(target)


