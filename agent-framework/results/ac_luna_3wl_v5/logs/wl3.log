 import numpy as np
from alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights

UNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
# Screener ensemble: capped at seven active factors, long aligned.
FACTORS = {"volstate": .22, "peer": .18, "momentum": .16, "idio": .16,
           "short_rev": .10, "residual": .10, "dispersion": .08}
MIN_W, MAX_W = .03, .15
REBALANCE_DAYS = 10
_day = 0
_previous = None


def ranks(values):
    good = [(s, float(v)) for s, v in values.items() if np.isfinite(v)]
    good.sort(key=lambda z: z[1])
    out = {s: .5 for s in UNIVERSE}
    n = len(good)
    for i, (s, _) in enumerate(good):
        out[s] = (i + 1.) / n
    return out


def capped_simplex(raw):
    # Projection by fixing values outside the permitted interval.
    fixed, active = {}, set(UNIVERSE)
    base = {s: max(float(raw.get(s, 1e-6)), 1e-6) for s in UNIVERSE}
    for _ in range(40):
        remain = 1. - sum(fixed.values())
        denom = sum(base[s] for s in active)
        trial = {s: remain * base[s] / denom for s in active}
        changed = False
        for s, w in list(trial.items()):
            if w < MIN_W:
                fixed[s] = MIN_W; active.remove(s); changed = True
            elif w > MAX_W:
                fixed[s] = MAX_W; active.remove(s); changed = True
        if not changed:
            fixed.update(trial)
            break
    ans = {s: fixed.get(s, 0.) for s in UNIVERSE}
    z = sum(ans.values())
    return {s: ans[s] / z for s in UNIVERSE}


@register_hook
def cross_asset_strategy():
    global _day, _previous
    _day += 1
    if _day != 1 and (_day - 1) % REBALANCE_DAYS:
        return

    returns, vols = {}, {}
    for symbol in UNIVERSE:
        df = get_stock_daily_data(symbol=symbol, days=230)
        if df is None or len(df) < 70:
            continue
        close = np.asarray(df.sort_values("date")["close"], dtype=float)
        if len(close) < 70 or np.any(~np.isfinite(close[-70:])) or np.any(close[-70:] <= 0):
            continue
        r = close[1:] / close[:-1] - 1.
        returns[symbol] = r
        vols[symbol] = max(float(np.std(r[-20:])), .006)
    if len(returns) < 10:
        return

    r1 = {s: r[-1] for s, r in returns.items()}
    r3 = {s: float(np.prod(1 + r[-3:]) - 1) for s, r in returns.items()}
    r5 = {s: float(np.prod(1 + r[-5:]) - 1) for s, r in returns.items()}
    r20 = {s: float(np.prod(1 + r[-20:]) - 1) for s, r in returns.items()}
    r40 = {s: float(np.prod(1 + r[-40:]) - 1) for s, r in returns.items()}
    dispersion = float(np.std(list(r1.values())))
    breadth = float(np.mean([x > 0 for x in r20.values()]))
    high_risk = breadth < .45 or np.median(list(vols.values())) > .018 or np.median(list(r5.values())) < 0
    # Residual benchmark is the equity-index subset of the tradable universe.
    eq = [s for s in UNIVERSE[:8] if s in returns]
    benchmark = float(np.median([r40[s] for s in eq])) if eq else float(np.median(list(r40.values())))
    factor = {k: {} for k in FACTORS}
    for s in returns:
        v = vols[s]
        reversal = -r1[s] / (v + .006)
        factor["volstate"][s] = reversal * (1. + min(v / .02, 1.))
        factor["idio"][s] = -r1[s] / (v + .004)
        factor["short_rev"][s] = reversal
        factor["dispersion"][s] = reversal * min(dispersion / .012, 1.5)
        peers = [r5[t] for t in returns if t != s]
        factor["peer"][s] = r5[s] - np.median(peers) if peers else 0.
        factor["momentum"][s] = r20[s] / (v * np.sqrt(20.) + .01)
        factor["residual"][s] = (r40[s] - benchmark) / (v * np.sqrt(40.) + .02)

    rr = {k: ranks(v) for k, v in factor.items()}
    score = {s: sum(FACTORS[k] * rr[k].get(s, .5) for k in FACTORS) for s in returns}
    if _previous is not None:
        score = {s: .65 * score[s] + .35 * _previous.get(s, .5) for s in score}
    _previous = score.copy()

    defensive = {"XAU", "US10Y", "CN10Y"}
    mean_inv = np.mean([1. / v for v in vols.values()])
    raw = {}
    for s in UNIVERSE:
        inv = min((1. / vols.get(s, .02)) / mean_inv, 1.25)
        raw[s] = max(score.get(s, .5), .05) * (.88 + .12 * inv)
        if high_risk and s in defensive:
            raw[s] *= 1.35
    target = capped_simplex(raw)
    if len(target) == 15 and abs(sum(target.values()) - 1.) < 1e-8:
        rebalance_to_weights(target)


