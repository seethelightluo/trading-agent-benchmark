 import numpy as np
from alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights

UNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
# Current screener ensemble; directions are positive as supplied.
FACTORS = {"rev1": 0.45, "clv": 0.25, "peer5": 0.14, "mom20": 0.12, "rev2": 0.04}
REBALANCE_EVERY = 10
MIN_WEIGHT, MAX_WEIGHT = 0.02, 0.14
_calls = 0

def ranks(x):
    valid = sorted((s, v) for s, v in x.items() if np.isfinite(v))
    out = {s: 0.5 for s in UNIVERSE}
    n = len(valid)
    for i, (s, _) in enumerate(valid):
        out[s] = (i + 1) / n if n > 1 else 0.5
    return out

def bounded(raw):
    # Iterative water-filling projection to the required complete target.
    active = set(UNIVERSE)
    w = {s: max(float(raw.get(s, 0.5)), 1e-8) for s in UNIVERSE}
    fixed = {}
    for _ in range(20):
        rem = 1.0 - sum(fixed.values())
        free = [s for s in UNIVERSE if s not in fixed]
        z = sum(w[s] for s in free)
        trial = {s: (rem * w[s] / z if z else rem / len(free)) for s in free}
        changed = False
        for s, q in trial.items():
            if q < MIN_WEIGHT:
                fixed[s] = MIN_WEIGHT; changed = True
            elif q > MAX_WEIGHT:
                fixed[s] = MAX_WEIGHT; changed = True
        if not changed:
            out = dict(fixed); out.update(trial)
            z = sum(out.values())
            return {s: out[s] / z for s in UNIVERSE}
    out = {s: fixed.get(s, MIN_WEIGHT) for s in UNIVERSE}
    z = sum(out.values())
    return {s: v / z for s, v in out.items()}

@register_hook
def cross_asset_strategy():
    global _calls
    _calls += 1
    if _calls != 1 and (_calls - 1) % REBALANCE_EVERY:
        return
    f = {k: {} for k in FACTORS}
    vol, r1, mom = {}, {}, {}
    for s in UNIVERSE:
        df = get_stock_daily_data(symbol=s, days=90)
        if df is None or len(df) < 26:
            continue
        df = df.sort_values("date").reset_index(drop=True)
        c = np.asarray(df.close, dtype=float); h = np.asarray(df.high, dtype=float); l = np.asarray(df.low, dtype=float)
        if not np.all(np.isfinite(c[-26:])) or np.any(c[-26:] <= 0):
            continue
        ret = c[1:] / c[:-1] - 1.0
        sig = max(float(np.std(ret[-20:])), 0.008)
        vol[s] = sig; r1[s] = ret[-1]; mom[s] = (c[-1] / c[-21] - 1.0) / (sig + 0.01)
        f["rev1"][s] = -ret[-1] / sig
        f["rev2"][s] = -float(np.mean(ret[-2:])) / sig
        f["mom20"][s] = mom[s]
        span = h[-1] - l[-1]
        f["clv"][s] = (c[-1] - l[-1]) / span if np.isfinite(span) and span > 0 else 0.5
    if len(vol) < 8:
        return
    # Cross-sectional five-day peer lead-lag, with leave-one-out median.
    five = {s: r1[s] for s in vol}
    for s in vol:
        f["peer5"][s] = five[s] - np.median([five[t] for t in vol if t != s])
    rr = {k: ranks(v) for k, v in f.items()}
    score = {s: sum(FACTORS[k] * rr[k][s] for k in FACTORS) for s in UNIVERSE}
    breadth = np.mean([mom[s] > 0 for s in mom])
    defensive = {"XAU", "US10Y", "CN10Y"}
    raw = {}
