  ▶️ write_file({'content': 'import numpy as np\nfrom alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights\n\nUNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]\nFACTORS = {"lowvol": 0.50, "clv": 0.18, "peer": 0.13, "momentum": 0.10, "volume_rev": 0.05, "total_rev": 0.04}\nREBALANCE_EVERY = 10\nMIN_WEIGHT, MAX_WEIGHT = 0.02, 0.14\n_calls = 0\n\n\ndef rank_cross(values):\n    valid = sorted((s, float(v)) for s, v in values.items() if np.isfinite(v))\n    result = {s: 0.5 for s in UNIVERSE}\n    if len(valid) == 1:\n        result[valid[0][0]] = 0.5\n    elif valid:\n        for i, (s, _) in enumerate(valid):\n            result[s] = (i + 1.0) / len(valid)\n    return result\n\n\ndef bounded_weights(raw):\n    # Iterative water filling keeps all 15 assets invested and within bounds.\n    active = set(UNIVERSE)\n    out = {}\n    for _ in range(30):\n        remaining = 1.0 - sum(out.values())\n        denom = sum(max(raw[s], 1e-9) for s in active)\n        trial = {s: remaining * max(raw[s], 1e-9) / denom for s in active}\n        clipped = False\n        for s, w in list(trial.items()):\n            if w < MIN_WEIGHT:\n                out[s] = MIN_WEIGHT; active.remove(s); clipped = True\n            elif w > MAX_WEIGHT:\n                out[s] = MAX_WEIGHT; active.remove(s); clipped = True\n        if not clipped:\n            out.update(trial)\n            break\n    if active:\n        out.update({s: (1.0 - sum(out.values())) / len(active) for s in active})\n    total = sum(out.values())\n    return {s: out.get(s, MIN_WEIGHT) / total for s in UNIVERSE}\n\n\n@register_hook\ndef cross_asset_strategy():\n    global _calls\n    _calls += 1\n    if _calls != 1 and (_calls - 1) % REBALANCE_EVERY != 0:\n        return\n\n    raw_factors = {k: {} for k in FACTORS}\n    vol, momentum = {}, {}\n    five_day = {}\n    for symbol in UNIVERSE:\n        df = get_stock_daily_data(symbol=symbol, days=90)\n        if df is None or len(df) < 30:\n            continue\n        df = df.sort_values("date").reset_index(drop=True)\n        c = np.asarray(df["close"], dtype=float)\n        o = np.asarray(df["open"], dtype=float)\n        h = np.asarray(df["high"], dtype=float)\n        l = np.asarray(df["low"], dtype=float)\n        if np.any(~np.isfinite(c[-30:])) or np.any(c[-30:] <= 0):\n            continue\n        ret = c[1:] / c[:-1] - 1.0\n        sigma = max(float(np.std(ret[-20:])), 0.008)\n        vol[symbol] = sigma\n        one_day = ret[-1]\n        raw_factors["lowvol"][symbol] = -one_day / sigma\n        raw_factors["momentum"][symbol] = (c[-1] / c[-21] - 1.0) / (sigma + 0.01)\n        momentum[symbol] = raw_factors["momentum"][symbol]\n        span = h[-1] - l[-1]\n        raw_factors["clv"][symbol] = (c[-1] - l[-1]) / span if np.isfinite(span) and span > 0 else 0.5\n        overnight = o[-1] / c[-2] - 1.0\n        intraday = c[-1] / o[-1] - 1.0 if o[-1] > 0 else 0.0\n        total_rev = -(overnight + intraday) / sigma\n        raw_factors["total_rev"][symbol] = total_rev\n        # Missing/zero volume is neutral, per screener guidance.\n        if "volume" in df.columns:\n            vv = np.asarray(df["volume"], dtype=float)\n            if len(vv) >= 21 and np.isfinite(vv[-1]) and vv[-1] > 0 and np.nanmedian(vv[-21:]) > 0:\n                confirmation = min(max(vv[-1] / np.nanmedian(vv[-21:]), 0.25), 2.0)\n                raw_factors["volume_rev"][symbol] = (-one_day / sigma) * (0.75 + 0.25 * confirmation)\n            else:\n                raw_factors["volume_rev"][symbol] = 0.0\n        else:\n            raw_factors["volume_rev"][symbol] = 0.0\n        if len(c) >= 6:\n            five_day[symbol] = c[-1] / c[-6] - 1.0\n\n    if len(vol) < 8:\n        return\n    for symbol in vol:\n        peers = [five_day[s] for s in vol if s != symbol and s in five_day]\n        raw_factors["peer"][symbol] = five_day.get(symbol, 0.0) - (float(np.median(peers)) if peers else 0.0)\n\n    ranks = {k: rank_cross(v) for k, v in raw_factors.items()}\n    score = {s: sum(FACTORS[k] * ranks[k][s] for k in FACTORS) for s in UNIVERSE}\n    breadth = np.mean([momentum[s] > 0 for s in momentum]) if momentum else 0.5\n    avg_inv_vol = np.mean([1.0 / v for v in vol.values()])\n    defensive = {"XAU", "US10Y", "CN10Y"}\n    raw = {}\n    for s in UNIVERSE:\n        inv = min((1.0 / vol[s]) / avg_inv_vol, 1.8) if s in vol else 1.0\n        risk_tilt = 1.16 if breadth < 0.50 and s in defensive else (0.94 if breadth < 0.50 else 1.0)\n        raw[s] = max(score[s], 0.05) * (0.94 + 0.06 * inv) * risk_tilt\n    rebalance_to_weights(bounded_weights(raw))\n', 'file_path': 'strategy.py'})
