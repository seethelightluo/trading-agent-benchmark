        if np.any(~np.isfinite(c)) or np.any(c <= 0):
            continue
        r = c[1:] / c[:-1] - 1.
        data[s] = {"r": r, "h3": np.prod(1+r[-3:])-1, "h5": np.prod(1+r[-5:])-1,
                   "h10": np.prod(1+r[-10:])-1, "h20": np.prod(1+r[-20:])-1,
                   "h120": np.prod(1+r[-120:])-1, "v5": max(np.std(r[-5:]), .006),
                   "v20": max(np.std(r[-20:]), .006), "v60": max(np.std(r[-60:]), .006),
                   "vr": np.mean(vol[-5:]) / max(np.mean(vol[-20:]), 1e-9),
                   "intra": np.nanmean((c[-5:] - o[-5:]) / np.maximum(o[-5:], 1e-12)),
                   "pressure": np.nanmean((c[-3:] - o[-3:]) / np.maximum(o[-3:], 1e-12)),
                   "range": np.nanmean((hi[-5:] - lo[-5:]) / np.maximum(c[-5:], 1e-12))}
    if len(data) < 10:
        return
    syms = list(data)
    med = {k: np.median([data[s][k] for s in syms]) for k in ("h3", "h5", "h10", "h20")}
    factors = {k: {} for k in FACTOR_W}
    bench = data.get("SPX", {}).get("r")
    for s in syms:
        x = data[s]; scale = x["v20"] * np.sqrt(20) + .015
        if bench is not None and s != "SPX":
