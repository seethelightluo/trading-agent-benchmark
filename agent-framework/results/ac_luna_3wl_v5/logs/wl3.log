        factors["dispersion"][s] = (med["h20"]-x["h20"]) / scale
        factors["intraday_norm"][s] = -x["intra"] / (x["v5"]+.01)
        factors["stress"][s] = (med["h10"]-x["h10"]) / (x["v20"]*np.sqrt(10)+.02)
        factors["volscaled"][s] = (med["h5"]-x["h5"]) / (x["v20"]+.01)
        factors["breadth_momentum"][s] = x["h20"] / (x["v20"]*np.sqrt(20)+.02)
        factors["reversal10"][s] = (med["h10"]-x["h10"]) / (x["v20"]*np.sqrt(10)+.01)
        factors["intraday_pressure"][s] = -x["pressure"] / (x["v5"]+.01)
        factors["macro_residual"][s] = -resid / (x["v20"]*np.sqrt(10)+.015)
    breadth = np.mean([data[s]["h120"] > 0 for s in syms])
    ranks = {k: cs_rank(v) for k, v in factors.items()}
    if breadth < .50:
        ranks["breadth_momentum"] = {s: .5 for s in UNIVERSE}
    score = {s: sum(FACTOR_W[k] * ranks[k].get(s, .5) for k in FACTOR_W) for s in UNIVERSE}
    if _previous is not None:
        score = {s: .5 * score[s] + .5 * _previous[s] for s in UNIVERSE}
    _previous = score.copy()
    high_risk = np.median([data[s]["v20"] for s in syms]) > .018 or breadth < .50
    invmean = np.mean([1. / data[s]["v20"] for s in syms])
    raw = {}
    for s in UNIVERSE:
        x = data.get(s, {"v20": .02, "h120": 0.})
        invvol = (1. / x["v20"]) / max(invmean, 1e-9) if s in data else 1.
        raw[s] = max(score[s], .12) * (.90 + .10 * min(invvol, 1.25))
        if high_risk and s in DEFENSIVE: raw[s] *= 2.2
        if high_risk and x["h120"] < -.10: raw[s] *= .75
    rebalance_to_weights(bounded(raw))


