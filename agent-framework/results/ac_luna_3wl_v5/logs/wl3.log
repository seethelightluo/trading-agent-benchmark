 import numpy as np
from alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights

UNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
# Current screener ensemble (six active factors; positive direction ranks).
FACTORS = {"resid40": 0.20, "peer5": 0.20, "mom20": 0.20,
           "reversal1": 0.20, "volume_rev1": 0.12, "vol_rev3": 0.08}
REBALANCE_DAYS = 10
MIN_W, MAX_W = 0.03, 0.15
_day = 0
_last_score = None


def rank_cs(values):
    valid = sorted((s, float(v)) for s, v in values.items() if np.isfinite(v))
    out = {s: 0.5 for s in UNIVERSE}
    if not valid:
        return out
    for i, (s, _) in enumerate(valid):
        out[s] = (i + 1.0) / len(valid)
    return out


def ret_n(r, n):
    return float(np.prod(1.0 + r[-n:]) - 1.0) if len(r) >= n else np.nan


def bounded_weights(raw):
    # Iterative capped-simplex projection; always returns a complete portfolio.
    base = {s: max(float(raw.get(s, 0.1)), 1e-12) for s in UNIVERSE}
    active, fixed = set(UNIVERSE), {}
    for _ in range(40):
        left = 1.0 - sum(fixed.values())
        denom = sum(base[s] for s in active)
        if denom <= 0:
            break
        trial = {s: left * base[s] / denom for s in active}
        changed = False
        for s, w in list(trial.items()):
            if w < MIN_W:
                fixed[s] = MIN_W; active.remove(s); changed = True
            elif w > MAX_W:
                fixed[s] = MAX_W; active.remove(s); changed = True
        if not changed:
            fixed.update(trial)
            break
    # Numerical normalization preserves non-negative full investment.
    ans = {s: fixed.get(s, 0.0) for s in UNIVERSE}
    total = sum(ans.values())
    return {s: ans[s] / total for s in UNIVERSE} if total > 0 else {s: 1.0 / len(UNIVERSE) for s in UNIVERSE}


@register_hook
def cross_asset_strategy():
    global _day, _last_score
    _day += 1
    if _day != 1 and (_day - 1) % REBALANCE_DAYS != 0:
        return

    data, rets, vols = {}, {}, {}
    for symbol in UNIVERSE:
        df = get_stock_daily_data(symbol=symbol, days=230)
        if df is None or len(df) < 70:
            continue
        df = df.sort_values("date")
        close = np.asarray(df["close"], dtype=float)
        if np.any(~np.isfinite(close[-70:])) or np.any(close[-70:] <= 0):
            continue
        r = close[1:] / close[:-1] - 1.0
        data[symbol], rets[symbol] = df, r
        vols[symbol] = max(float(np.std(r[-20:])), 0.006)
    if len(rets) < 10:
        return

    r1 = {s: r[-1] for s, r in rets.items()}
    r3 = {s: ret_n(r, 3) for s, r in rets.items()}
    r5 = {s: ret_n(r, 5) for s, r in rets.items()}
    r20 = {s: ret_n(r, 20) for s, r in rets.items()}
    r40 = {s: ret_n(r, 40) for s, r in rets.items()}
    median3 = float(np.median(list(r3.values())))
    equity = [s for s in UNIVERSE[:8] if s in rets]
    equity_med40 = float(np.median([r40[s] for s in equity])) if equity else float(np.median(list(r40.values())))
    breadth = float(np.mean([x > 0 for x in r20.values()]))
    stress = breadth < 0.45 or float(np.median(list(r5.values()))) < 0 or float(np.median(list(vols.values()))) > 0.018

    factors = {k: {} for k in FACTORS}
    for s, r in rets.items():
        v = vols[s]
        scale20 = v * np.sqrt(20.0) + 0.01
        scale3 = v * np.sqrt(3.0) + 0.012
        factors["mom20"][s] = r20[s] / scale20
        factors["peer5"][s] = r5[s] - np.median([r5[t] for t in rets if t != s])
        factors["resid40"][s] = (r40[s] - equity_med40) / (v * np.sqrt(40.0) + 0.02)
        # Reversal is deliberately damped in stress and scaled by volatility.
        factors["reversal1"][s] = -r1[s] / (v + 0.006)
        factors["vol_rev3"][s] = -(r3[s] - median3) / scale3
        volume = np.asarray(data[s]["volume"], dtype=float)
        vz = 0.0
        if len(volume) >= 20 and np.all(np.isfinite(volume[-20:])) and np.all(volume[-20:] > 0):
            lv = np.log(volume[-20:])
            vz = np.clip((lv[-1] - np.mean(lv)) / (np.std(lv) + 1e-9), -1.0, 2.0)
        factors["volume_rev1"][s] = -r1[s] * (1.0 + 0.5 * vz)

    ranks = {k: rank_cs(v) for k, v in factors.items()}
    scores = {s: sum(FACTORS[k] * ranks[k].get(s, 0.5) for k in FACTORS) for s in rets}
    # 35% lagged score smoothing limits migration from noisy reversal signals.
    if _last_score is not None:
        scores = {s: 0.65 * x + 0.35 * _last_score.get(s, x) for s, x in scores.items()}
    _last_score = scores.copy()

    defensive = {"XAU", "US10Y", "CN10Y"}
    mean_inv = float(np.mean([1.0 / v for v in vols.values()]))
    raw = {}
    for s in UNIVERSE:
        inv_damp = min((1.0 / vols.get(s, 0.02)) / mean_inv, 1.25)
        raw[s] = max(scores.get(s, 0.5), 0.05) * (0.88 + 0.12 * inv_damp)
        if stress and s in defensive:
            raw[s] *= 1.35
    target = bounded_weights(raw)
    if set(target) == set(UNIVERSE) and all(np.isfinite(w) and w >= 0 for w in target.values()) and abs(sum(target.values()) - 1.0) < 1e-8:
        rebalance_to_weights(target)


