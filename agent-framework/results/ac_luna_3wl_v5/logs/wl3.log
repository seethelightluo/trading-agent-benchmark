  ▶️ write_file({'content': 'import numpy as np\nfrom alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights\n\nUNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]\nDEFENSIVE = {"XAU", "US10Y", "CN10Y"}\nRISKY = {"COPPER", "WTI", "BTC", "ETH"}\nCADENCE = 10\nMIN_W, MAX_W = 0.04, 0.18\n# Current screener ensemble: capped at eight active factors.\nFACTORS = ("residual", "consistency", "breakout120", "downside_mom", "short_breakout", "failure", "dispersion", "volstate")\nFACTOR_W = (0.20, 0.18, 0.16, 0.12, 0.08, 0.12, 0.07, 0.07)\n_day = 0\n_previous = None\n\ndef ranks(values):\n    valid = sorted((s, float(v)) for s, v in values.items() if np.isfinite(v))\n    out = {s: 0.5 for s in UNIVERSE}\n    for i, (s, _) in enumerate(valid):\n        out[s] = (i + 1.0) / max(1, len(valid))\n    return out\n\ndef bounded(raw):\n    # Project to a complete long-only portfolio with 4%-18% asset bounds.\n    w = {s: max(float(raw.get(s, 0.0)), 1e-12) for s in UNIVERSE}\n    fixed = {}\n    for _ in range(60):\n        free = [s for s in UNIVERSE if s not in fixed]\n        left = 1.0 - sum(fixed.values())\n        total = sum(w[s] for s in free)\n        for s in free:\n            w[s] = left * w[s] / max(total, 1e-12)\n        hit = [s for s in free if w[s] < MIN_W or w[s] > MAX_W]\n        if not hit:\n            break\n        for s in hit:\n            fixed[s] = MIN_W if w[s] < MIN_W else MAX_W\n            w[s] = fixed[s]\n    z = sum(w.values())\n    return {s: w[s] / max(z, 1e-12) for s in UNIVERSE}\n\n@register_hook\ndef cross_asset_strategy():\n    global _day, _previous\n    _day += 1\n    if _day != 1 and (_day - 1) % CADENCE != 0:\n        return\n\n    feat, returns = {}, {}\n    for symbol in UNIVERSE:\n        df = get_stock_daily_data(symbol=symbol, days=210)\n        if df is None or len(df) < 140:\n            continue\n        close = np.asarray(df.sort_values("date")["close"], dtype=float)[:-1]\n        if len(close) < 125 or np.any(~np.isfinite(close)) or np.any(close <= 0):\n            continue\n        r = close[1:] / close[:-1] - 1.0\n        vol20 = max(float(np.std(r[-20:])), 0.006)\n        vol60 = max(float(np.std(r[-60:])), 0.006)\n        r3 = np.prod(1 + r[-3:]) - 1.0\n        r5 = np.prod(1 + r[-5:]) - 1.0\n        r20 = np.prod(1 + r[-20:]) - 1.0\n        r30 = np.prod(1 + r[-30:]) - 1.0\n        downside = np.std(np.minimum(r[-60:], 0.0))\n        feat[symbol] = {\n            "residual": np.clip(r20 / (vol20*np.sqrt(20)), -3, 3),\n            "consistency": np.clip(r30/(vol30 := max(vol60, .006))/np.sqrt(30) * (0.5 + np.mean(r[-30:] > 0)), -3, 3),\n            "breakout120": np.clip(close[-1] / max(close[-121:-1]) - 1, -3, 3),\n            "downside_mom": np.clip(r20 / max(downside*np.sqrt(20), .02), -3, 3),\n            "short_breakout": np.clip(r20/(vol20*np.sqrt(20)), -3, 3),\n            "failure": np.clip(-r5/vol20, -3, 3),\n            "volstate": np.clip(-r3/vol20, -3, 3),\n            "vol": vol20,\n        }\n        returns[symbol] = r\n\n    if len(feat) < 10:\n        return\n    benchmark = returns.get("SPX")\n    if benchmark is not None:\n        for symbol, r in returns.items():\n            n = min(60, len(r), len(benchmark))\n            if n >= 30:\n                beta = np.cov(r[-n:], benchmark[-n:], ddof=1)[0, 1] / max(np.var(benchmark[-n:], ddof=1), 1e-8)\n                feat[symbol]["residual"] = np.clip(feat[symbol]["residual"] - beta * (np.prod(1 + benchmark[-20:]) - 1), -3, 3)\n\n    median_r20 = np.median([np.prod(1 + returns[s][-20:]) - 1 for s in feat])\n    for s in feat:\n        feat[s]["dispersion"] = np.clip(-(np.prod(1 + returns[s][-20:]) - 1 - median_r20) / max(feat[s]["vol"]*np.sqrt(20), .01), -3, 3)\n    ranked = {f: ranks({s: feat[s][f] for s in feat}) for f in FACTORS}\n    score = {s: sum(FACTOR_W[i] * ranked[FACTORS[i]][s] for i in range(len(FACTORS))) for s in UNIVERSE}\n    if _previous is not None:\n        score = {s: 0.70 * score[s] + 0.30 * _previous[s] for s in UNIVERSE}\n    _previous = score.copy()\n\n    median_vol = float(np.median([x["vol"] for x in feat.values()]))\n    breadth = float(np.mean([x["breakout120"] > 0 for x in feat.values()]))\n    stressed = median_vol > 0.018 or breadth < 0.40\n    inv_mean = float(np.mean([1.0 / x["vol"] for x in feat.values()]))\n    raw = {}\n    for s in UNIVERSE:\n        x = feat.get(s, {"vol": median_vol, "breakout120": 0.0})\n        damp = np.clip((1.0 / x["vol"]) / max(inv_mean, 1e-12), 0.80, 1.12)\n        raw[s] = max(score[s], 0.05) * (0.90 + 0.10 * damp)\n        if stressed:\n            raw[s] *= 1.35 if s in DEFENSIVE else (0.68 if s in RISKY else (0.86 if x["breakout120"] < 0 else 0.80))\n        elif s in RISKY:\n            raw[s] *= 0.92\n    target = bounded(raw)\n    if all(np.isfinite(v) and v >= 0 for v in target.values()) and abs(sum(target.values()) - 1.0) < 1e-8:\n        rebalance_to_weights(target)\n\n# Full investment and fractional quantities are handled by rebalance_to_weights.\n', 'file_path': 'strategy.py'})
