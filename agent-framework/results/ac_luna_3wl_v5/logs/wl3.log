  ▶️ write_file({'content': 'import numpy as np\nfrom alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights\n\nUNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]\n# Current screener ensemble (six active factors; positive direction ranks).\nFACTORS = {"resid40": 0.20, "peer5": 0.20, "mom20": 0.20,\n           "reversal1": 0.20, "volume_rev1": 0.12, "vol_rev3": 0.08}\nREBALANCE_DAYS = 10\nMIN_W, MAX_W = 0.03, 0.15\n_day = 0\n_last_score = None\n\n\ndef rank_cs(values):\n    valid = sorted((s, float(v)) for s, v in values.items() if np.isfinite(v))\n    out = {s: 0.5 for s in UNIVERSE}\n    if not valid:\n        return out\n    for i, (s, _) in enumerate(valid):\n        out[s] = (i + 1.0) / len(valid)\n    return out\n\n\ndef ret_n(r, n):\n    return float(np.prod(1.0 + r[-n:]) - 1.0) if len(r) >= n else np.nan\n\n\ndef bounded_weights(raw):\n    # Iterative capped-simplex projection; always returns a complete portfolio.\n    base = {s: max(float(raw.get(s, 0.1)), 1e-12) for s in UNIVERSE}\n    active, fixed = set(UNIVERSE), {}\n    for _ in range(40):\n        left = 1.0 - sum(fixed.values())\n        denom = sum(base[s] for s in active)\n        if denom <= 0:\n            break\n        trial = {s: left * base[s] / denom for s in active}\n        changed = False\n        for s, w in list(trial.items()):\n            if w < MIN_W:\n                fixed[s] = MIN_W; active.remove(s); changed = True\n            elif w > MAX_W:\n                fixed[s] = MAX_W; active.remove(s); changed = True\n        if not changed:\n            fixed.update(trial)\n            break\n    # Numerical normalization preserves non-negative full investment.\n    ans = {s: fixed.get(s, 0.0) for s in UNIVERSE}\n    total = sum(ans.values())\n    return {s: ans[s] / total for s in UNIVERSE} if total > 0 else {s: 1.0 / len(UNIVERSE) for s in UNIVERSE}\n\n\n@register_hook\ndef cross_asset_strategy():\n    global _day, _last_score\n    _day += 1\n    if _day != 1 and (_day - 1) % REBALANCE_DAYS != 0:\n        return\n\n    data, rets, vols = {}, {}, {}\n    for symbol in UNIVERSE:\n        df = get_stock_daily_data(symbol=symbol, days=230)\n        if df is None or len(df) < 70:\n            continue\n        df = df.sort_values("date")\n        close = np.asarray(df["close"], dtype=float)\n        if np.any(~np.isfinite(close[-70:])) or np.any(close[-70:] <= 0):\n            continue\n        r = close[1:] / close[:-1] - 1.0\n        data[symbol], rets[symbol] = df, r\n        vols[symbol] = max(float(np.std(r[-20:])), 0.006)\n    if len(rets) < 10:\n        return\n\n    r1 = {s: r[-1] for s, r in rets.items()}\n    r3 = {s: ret_n(r, 3) for s, r in rets.items()}\n    r5 = {s: ret_n(r, 5) for s, r in rets.items()}\n    r20 = {s: ret_n(r, 20) for s, r in rets.items()}\n    r40 = {s: ret_n(r, 40) for s, r in rets.items()}\n    median3 = float(np.median(list(r3.values())))\n    equity = [s for s in UNIVERSE[:8] if s in rets]\n    equity_med40 = float(np.median([r40[s] for s in equity])) if equity else float(np.median(list(r40.values())))\n    breadth = float(np.mean([x > 0 for x in r20.values()]))\n    stress = breadth < 0.45 or float(np.median(list(r5.values()))) < 0 or float(np.median(list(vols.values()))) > 0.018\n\n    factors = {k: {} for k in FACTORS}\n    for s, r in rets.items():\n        v = vols[s]\n        scale20 = v * np.sqrt(20.0) + 0.01\n        scale3 = v * np.sqrt(3.0) + 0.012\n        factors["mom20"][s] = r20[s] / scale20\n        factors["peer5"][s] = r5[s] - np.median([r5[t] for t in rets if t != s])\n        factors["resid40"][s] = (r40[s] - equity_med40) / (v * np.sqrt(40.0) + 0.02)\n        # Reversal is deliberately damped in stress and scaled by volatility.\n        factors["reversal1"][s] = -r1[s] / (v + 0.006)\n        factors["vol_rev3"][s] = -(r3[s] - median3) / scale3\n        volume = np.asarray(data[s]["volume"], dtype=float)\n        vz = 0.0\n        if len(volume) >= 20 and np.all(np.isfinite(volume[-20:])) and np.all(volume[-20:] > 0):\n            lv = np.log(volume[-20:])\n            vz = np.clip((lv[-1] - np.mean(lv)) / (np.std(lv) + 1e-9), -1.0, 2.0)\n        factors["volume_rev1"][s] = -r1[s] * (1.0 + 0.5 * vz)\n\n    ranks = {k: rank_cs(v) for k, v in factors.items()}\n    scores = {s: sum(FACTORS[k] * ranks[k].get(s, 0.5) for k in FACTORS) for s in rets}\n    # 35% lagged score smoothing limits migration from noisy reversal signals.\n    if _last_score is not None:\n        scores = {s: 0.65 * x + 0.35 * _last_score.get(s, x) for s, x in scores.items()}\n    _last_score = scores.copy()\n\n    defensive = {"XAU", "US10Y", "CN10Y"}\n    mean_inv = float(np.mean([1.0 / v for v in vols.values()]))\n    raw = {}\n    for s in UNIVERSE:\n        inv_damp = min((1.0 / vols.get(s, 0.02)) / mean_inv, 1.25)\n        raw[s] = max(scores.get(s, 0.5), 0.05) * (0.88 + 0.12 * inv_damp)\n        if stress and s in defensive:\n            raw[s] *= 1.35\n    target = bounded_weights(raw)\n    if set(target) == set(UNIVERSE) and all(np.isfinite(w) and w >= 0 for w in target.values()) and abs(sum(target.values()) - 1.0) < 1e-8:\n        rebalance_to_weights(target)\n', 'file_path': 'strategy.py'})
