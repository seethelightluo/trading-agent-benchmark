   vals.append(pd.DataFrame({'date':x.index,'f':f,'y':x.close.shift(-h)/x.close-1}).reset_index(drop=True))
  b=pd.concat(vals,ignore_index=True).dropna();q=[]
  for dt,g in b.groupby('date'):
