 import numpy as np
from alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights

UNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
# Screener 2027-06-17 ensemble. Reversal cluster is deliberately damped in construction.
FACTORS = {"disp_rev": 0.26, "vol_rev": 0.18, "volume_rev": 0.14,
           "medium_rev": 0.12, "peer": 0.16, "momentum": 0.14}
CADENCE = 10
MIN_W, MAX_W = 0.035, 0.14
DEFENSIVE = {"XAU", "US10Y", "CN10Y"}
_day = 0
_previous = None


def cross_rank(values):
    good = sorted((s, float(v)) for s, v in values.items() if np.isfinite(v))
    out = {s: 0.5 for s in UNIVERSE}
    if not good:
        return out
    n = len(good)
    for i, (s, _) in enumerate(good):
        out[s] = (i + 1.0) / n
    return out


def bound_weights(raw):
    fixed, active = {}, set(UNIVERSE)
    for _ in range(50):
        left = 1.0 - sum(fixed.values())
        denom = sum(max(float(raw.get(s, 0.01)), 1e-8) for s in active)
        trial = {s: left * max(float(raw.get(s, 0.01)), 1e-8) / denom for s in active}
        changed = False
        for s, w in list(trial.items()):
            if w < MIN_W:
                fixed[s] = MIN_W; active.remove(s); changed = True
            elif w > MAX_W:
                fixed[s] = MAX_W; active.remove(s); changed = True
        if not changed:
            fixed.update(trial)
            break
    ans = {s: fixed.get(s, 0.0) for s in UNIVERSE}
    z = sum(ans.values())
    return {s: ans[s] / z for s in UNIVERSE}


@register_hook
def cross_asset_strategy():
    global _day, _previous
    _day += 1
    if _day != 1 and (_day - 1) % CADENCE != 0:
        return

    ret, vol, volume = {}, {}, {}
    for s in UNIVERSE:
        df = get_stock_daily_data(symbol=s, days=240)
        if df is None or len(df) < 140:
            continue
        df = df.sort_values("date")
        close = np.asarray(df["close"], dtype=float)
        if np.any(~np.isfinite(close)) or np.any(close <= 0):
            continue
        r = close[1:] / close[:-1] - 1.0
        ret[s] = r
        vol[s] = max(float(np.std(r[-30:])), 0.006)
        vv = np.asarray(df["volume"], dtype=float) if "volume" in df else np.ones(len(df))
        volume[s] = float(np.nanmean(vv[-5:]) / max(np.nanmean(vv[-30:]), 1e-9))
    if len(ret) < 10:
        return

    def horizon(r, n):
        return float(np.prod(1.0 + r[-n:]) - 1.0)

    h = {n: {s: horizon(r, n) for s, r in ret.items()} for n in (3, 5, 10, 20)}
    syms = list(ret)
    dispersion = float(np.std([h[3][s] for s in syms]))
    fac = {k: {} for k in FACTORS}
    for s in syms:
        peer3 = np.median([h[3][t] for t in syms if t != s])
        peer5 = np.median([h[5][t] for t in syms if t != s])
        scale5 = vol[s] * np.sqrt(5.0) + 0.01
        fac["disp_rev"][s] = (peer3 - h[3][s]) / (vol[s] * np.sqrt(3.0) + 0.01) * min(dispersion / 0.025, 1.0)
        fac["vol_rev"][s] = -h[5][s] / scale5
        # Volume is only a modest amplifier, preventing noisy volume spikes dominating.
        fac["volume_rev"][s] = -h[5][s] / scale5 * (0.75 + 0.25 * np.clip(volume[s], 0.0, 2.0))
        fac["medium_rev"][s] = -h[10][s] / (vol[s] * np.sqrt(10.0) + 0.01)
        fac["peer"][s] = peer5 / scale5
        fac["momentum"][s] = np.prod(1.0 + ret[s][-135:-15]) - 1.0

    # Rank normalization and temporal smoothing reduce unstable reversal crowding.
    score = {s: sum(w * cross_rank(fac[k])[s] for k, w in FACTORS.items()) for s in UNIVERSE}
    if _previous is not None:
        score = {s: 0.60 * score[s] + 0.40 * _previous.get(s, 0.5) for s in UNIVERSE}
    _previous = score.copy()

    breadth = np.mean([h[20][s] > 0 for s in syms])
    high_risk = breadth < 0.50 or np.median(list(h[10].values())) < 0 or np.median(list(vol.values())) > 0.018
    inv_mean = np.mean([1.0 / v for v in vol.values()])
    raw = {}
    for s in UNIVERSE:
        invvol = (1.0 / vol.get(s, 0.02)) / inv_mean
        raw[s] = max(score[s], 0.08) * (0.92 + 0.08 * min(invvol, 1.25))
        if high_risk and s in DEFENSIVE:
            raw[s] *= 2.40
        elif high_risk and h[20].get(s, 0.0) < -0.08:
            raw[s] *= 0.65
    target = bound_weights(raw)
    if all(np.isfinite(target[s]) and target[s] >= 0 for s in UNIVERSE) and abs(sum(target.values()) - 1.0) < 1e-8:
        rebalance_to_weights(target)


