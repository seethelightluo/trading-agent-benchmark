 import numpy as np
from alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights

UNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
# Current Screener ensemble (7 active factors; directions are long-aligned).
FACTORS = {"peer5": 0.20, "mom20": 0.18, "volstate_rev1": 0.18,
           "idio_rev1": 0.12, "resid40": 0.12, "disp_rev1": 0.10,
           "risk_rev1": 0.10}
REBALANCE_DAYS = 10
MIN_W, MAX_W = 0.03, 0.15
_day = 0
_last_score = None


def cs_rank(values):
    valid = sorted((s, float(v)) for s, v in values.items() if np.isfinite(v))
    out = {s: 0.5 for s in UNIVERSE}
    if valid:
        n = len(valid)
        for i, (s, _) in enumerate(valid):
            out[s] = (i + 1.0) / n
    return out


def bounded_weights(raw):
    # Projection onto a complete long-only capped simplex.
    base = {s: max(float(raw.get(s, 0.05)), 1e-12) for s in UNIVERSE}
    active, fixed = set(UNIVERSE), {}
    for _ in range(50):
        left = 1.0 - sum(fixed.values())
        denom = sum(base[s] for s in active)
        trial = {s: left * base[s] / denom for s in active} if denom else {}
        changed = False
        for s, w in list(trial.items()):
            if w < MIN_W:
                fixed[s] = MIN_W; active.remove(s); changed = True
            elif w > MAX_W:
                fixed[s] = MAX_W; active.remove(s); changed = True
        if not changed:
            fixed.update(trial)
            break
    ans = {s: fixed.get(s, 0.0) for s in UNIVERSE}
    total = sum(ans.values())
    return {s: ans[s] / total for s in UNIVERSE} if total > 0 else {s: 1.0 / 15 for s in UNIVERSE}


@register_hook
def cross_asset_strategy():
    global _day, _last_score
    _day += 1
    if _day != 1 and (_day - 1) % REBALANCE_DAYS != 0:
        return

    returns, vols = {}, {}
    for s in UNIVERSE:
        df = get_stock_daily_data(symbol=s, days=230)
        if df is None or len(df) < 70:
            continue
        close = np.asarray(df.sort_values("date")["close"], dtype=float)
        if np.any(~np.isfinite(close[-70:])) or np.any(close[-70:] <= 0):
            continue
        r = close[1:] / close[:-1] - 1.0
        returns[s] = r
        vols[s] = max(float(np.std(r[-20:])), 0.006)
    if len(returns) < 10:
        return

    r1 = {s: r[-1] for s, r in returns.items()}
    r3 = {s: float(np.prod(1 + r[-3:]) - 1) for s, r in returns.items()}
    r5 = {s: float(np.prod(1 + r[-5:]) - 1) for s, r in returns.items()}
    r20 = {s: float(np.prod(1 + r[-20:]) - 1) for s, r in returns.items()}
    r40 = {s: float(np.prod(1 + r[-40:]) - 1) for s, r in returns.items()}
    eq = [s for s in UNIVERSE[:8] if s in returns]
    eq_med = np.median([r40[s] for s in eq]) if eq else np.median(list(r40.values()))
    med5, med3 = np.median(list(r5.values())), np.median(list(r3.values()))
    dispersion = float(np.std(list(r1.values())))
    breadth = float(np.mean([x > 0 for x in r20.values()]))
    stress = breadth < 0.45 or med5 < 0 or np.median(list(vols.values())) > 0.018
    elevated_dispersion = dispersion > 0.012

    f = {k: {} for k in FACTORS}
    for s, r in returns.items():
        v = vols[s]
        others5 = [r5[t] for t in returns if t != s]
        f["peer5"][s] = r5[s] - np.median(others5) if others5 else 0.0
        f["volstate_rev1"][s] = -r1[s] / (v + .006) * (1.0 + min(v / .02, 1.0))
        f["mom20"][s] = r20[s] / (v * np.sqrt(20) + .01)
        f["idio_rev1"][s] = -r1[s] / (v + .004)
        f["resid40"][s] = (r40[s] - eq_med) / (v * np.sqrt(40) + .02)
        f["risk_rev1"][s] = -r1[s] / (v + .006)
        # Conditional dispersion reversal is inactive in quiet cross-sections.
        f["disp_rev1"][s] = (-r1[s] / (v + .006)) if elevated_dispersion else 0.0

    ranks = {k: cs_rank(x) for k, x in f.items()}
    scores = {s: sum(FACTORS[k] * ranks[k].get(s, .5) for k in FACTORS) for s in returns}
    if _last_score is not None:
        scores = {s: 0.65 * x + 0.35 * _last_score.get(s, x) for s, x in scores.items()}
    _last_score = scores.copy()

    defensive = {"XAU", "US10Y", "CN10Y"}
    mean_inv = np.mean([1.0 / v for v in vols.values()])
    raw = {}
    for s in UNIVERSE:
        damp = min((1.0 / vols.get(s, .02)) / mean_inv, 1.25)
        raw[s] = max(scores.get(s, 0.5), 0.05) * (0.88 + 0.12 * damp)
        if stress and s in defensive:
            raw[s] *= 1.35
    target = bounded_weights(raw)
    if (abs(sum(target.values()) - 1.0) < 1e-8 and
            all(np.isfinite(x) and x >= 0 for x in target.values())):
        rebalance_to_weights(target)


