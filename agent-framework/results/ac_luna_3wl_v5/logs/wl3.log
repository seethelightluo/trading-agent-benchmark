\n        v = max(float(np.std(r[-20:])), 0.006)\n        down = np.sqrt(np.mean(np.minimum(r[-20:], 0.0) ** 2))\n        mom20 = np.prod(1.0 + r[-20:]) - 1.0\n        # Breakout is measured against the prior 60-session high, excluding today.\n        prior = c[-61:-1] if len(c) >= 61 else c[:-1]\n        breakout = (c[-1] / max(np.max(prior), 1e-12) - 1.0) / max(v * np.sqrt(60), .01)\n        data[s] = {"v": v, "down": max(down, .006),\n                   "dm": mom20 / max(down, .006), "bo": breakout,\n                   "up": float(np.mean(r[-30:] > 0)),\n                   "h60": float(np.prod(1.0 + r[-60:]) - 1.0)}\n    if len(data) < 10:\n        return\n    dm = cross_rank({s: x["dm"] for s, x in data.items()})\n    bo = cross_rank({s: x["bo"] for s, x in data.items()})\n    up = cross_rank({s: x["up"] for s, x in data.items()})\n    score = {s: FACTOR_W[0]*dm[s] + FACTOR_W[1]*bo[s] + FACTOR_W[2]*up[s] for s in UNIVERSE}\n    # Smooth only the composite score to reduce ten-day reversal turnover.\n    if _previous is not None:\n        score = {s: 0.70*score[s] + 0.30*_previous[s] for s in UNIVERSE}\n    _previous = score.copy()\n    medvol = float(np.median([x["v"] for x in data.values()]))\n    breadth = float(np.mean([x["h60"] > 0 for x in data.values()]))\n    high_risk = medvol > 0.018 or breadth < 0.45\n    invmean = float(np.mean([1.0/x["v"] for x in data.values()]))\n    raw = {}\n    for s in UNIVERSE:\n        x = data.get(s, {"v": medvol, "h60": 0.0})\n        iv = (1.0/x["v"])/max(invmean, 1e-12) if s in data else 1.0\n        raw[s] = max(score[s], 0.08) * (0.90 + 0.10*np.clip(iv, .65, 1.35))\n        if high_risk and s in DEFENSIVE:\n            raw[s] *= 2.0\n        if high_risk and s not in DEFENSIVE and x["h60"] < -.08:\n            raw[s] *= .82\n    rebalance_to_weights(project(raw))\n', 'file_path': 'strategy.py'})
