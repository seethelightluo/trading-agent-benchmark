  ▶️ write_file({'content': "import numpy as np,pandas as pd\nfrom scipy.stats import spearmanr\nfrom alphacrafter.sim.utils import get_stock_daily_data,get_index_daily_data\nU=['000300.SH','SPX','HSI','N225','SX5E','000688.SH','SOX','NDX','XAU','COPPER','WTI','BTC','ETH','US10Y','CN10Y']\nrows=[]\nfor s in U:\n d=get_stock_daily_data(s,3000)\n if d is None or len(d)<200: d=get_index_daily_data(s,3000)\n if d is not None and len(d):\n  x=d[['date','open','close']].drop_duplicates('date');x['symbol']=s;rows.append(x)\nx=pd.concat(rows).pivot(index='date',columns='symbol',values=['open','close']).sort_index().ffill()\nopen_,close=x['open'],x['close']\n# Lagged cross-sectional overnight/intraday shock reversal: yesterday's close-to-open move\nintraday=(close/open-1)\nf=(-intraday).shift(1)\n\ndef calc(h,mask=None):\n a=[]; ix=close.index if mask is None else close.index[mask]\n future=close.shift(-h)/close-1\n for dt in ix:\n  q=pd.concat([f.loc[dt],future.loc[dt]],axis=1).dropna()\n  if len(q)>=8:\n   r=spearmanr(q.iloc[:,0],q.iloc[:,1]).statistic\n   if np.isfinite(r):a.append(r)\n q=pd.Series(a);return len(q),q.mean(),q.mean()/q.std(ddof=1)*np.sqrt(len(q)),(q>0).mean()\nfor h in [1,3,5,10]: print('horizon',h,'obs IC ICIR hit',calc(h))\nprint('cutoff',close.index.max().date(),'dates',len(close),'instruments',len(close.columns),'avgN',f.notna().sum(axis=1).mean(),'coverage',f.notna().mean().mean(),'turnover',f.rank(axis=1,pct=True).diff().abs().mean(axis=1).mean())\nfor name,mask in [('2020-22',close.index<'2023-01-01'),('2023-25',(close.index>='2023-01-01')&(close.index<'2026-01-01')),('2026+',close.index>='2026-01-01'),('recent120',close.index>=close.index[-120])]: print('regime',name,calc(1,mask))\nout=f.stack().rename('signal').reset_index();out.columns=['date','symbol','signal'];out.to_csv('scripts/miner_2_20281019_intraday_gap_reversal_signal.csv',index=False)\n", 'file_path': 'scripts/miner_2_20281019_intraday_gap_reversal.py'})
