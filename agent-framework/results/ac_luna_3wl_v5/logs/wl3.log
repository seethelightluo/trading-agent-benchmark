UNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
DEFENSIVE = {"XAU", "US10Y", "CN10Y"}
CADENCE = 10
MIN_W, MAX_W = 0.035, 0.16
# Exact current Screener ensemble (ten active factors, all positive direction).
FACTOR_W = {"volstate": .14, "volume_shock": .12, "dispersion": .12,
            "intraday_norm": .10, "stress": .10, "volscaled": .10,
            "breadth_momentum": .10, "reversal10": .08,
            "intraday_pressure": .08, "macro_residual": .06}
_day, _previous = 0, None


def cs_rank(values):
    out = {s: .5 for s in UNIVERSE}
    good = sorted((s, float(v)) for s, v in values.items() if np.isfinite(v))
    if not good:
        return out
    for i, (s, _) in enumerate(good):
        out[s] = (i + 1.) / len(good)
    return out


def bounded(raw):
    # Iterative water filling enforces complete, long-only, bounded allocation.
    w = {s: max(float(raw.get(s, 1.)), 1e-12) for s in UNIVERSE}
    fixed = set()
    for _ in range(50):
        free = [s for s in UNIVERSE if s not in fixed]
        remain = 1. - sum(w[s] for s in fixed)
        total = sum(w[s] for s in free)
        for s in free:
            w[s] = remain * w[s] / max(total, 1e-12)
        hit = {s for s in free if w[s] < MIN_W or w[s] > MAX_W}
        if not hit:
            break
        for s in hit:
            w[s] = MIN_W if w[s] < MIN_W else MAX_W
        fixed.update(hit)
    total = sum(w.values())
    return {s: w[s] / total for s in UNIVERSE}


@register_hook
