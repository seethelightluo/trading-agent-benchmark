 import numpy as np
from alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights

UNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
# 2027-05-20 Screener ensemble: capped reversal cluster, with slower trend and peer diversification.
FACTORS = {
    "volstate3": 0.18, "scaled_rev5": 0.18, "medium_rev10": 0.12,
    "trend10": 0.14, "skip120": 0.12, "vol_rev3": 0.10,
    "disp_rev3": 0.08, "peer5": 0.08,
}
CADENCE = 10
MIN_W, MAX_W = 0.03, 0.15
DEFENSIVE = {"XAU", "US10Y", "CN10Y"}
_previous = None
_day = 0


def rank_factor(values):
    valid = sorted((s, v) for s, v in values.items() if np.isfinite(v))
    out = {s: 0.5 for s in UNIVERSE}
    n = len(valid)
    if n:
        for i, (s, _) in enumerate(valid):
            out[s] = (i + 1.0) / n
    return out


def bounded(raw):
    # Iterative water filling: exact full investment and sensible 3%-15% limits.
    fixed, active = {}, set(UNIVERSE)
    for _ in range(30):
        left = 1.0 - sum(fixed.values())
        den = sum(max(float(raw.get(s, 1e-6)), 1e-6) for s in active)
        trial = {s: left * max(float(raw.get(s, 1e-6)), 1e-6) / den for s in active}
        changed = False
        for s, w in list(trial.items()):
            if w < MIN_W:
                fixed[s] = MIN_W; active.remove(s); changed = True
            elif w > MAX_W:
                fixed[s] = MAX_W; active.remove(s); changed = True
        if not changed:
            fixed.update(trial); break
    # Bounds are feasible for 15 assets; normalize only numerical residue.
    ans = {s: fixed.get(s, 0.0) for s in UNIVERSE}
    z = sum(ans.values())
    return {s: ans[s] / z for s in UNIVERSE}


@register_hook
def cross_asset_strategy():
    global _day, _previous
    _day += 1
    if _day != 1 and (_day - 1) % CADENCE != 0:
        return

    rets, vols = {}, {}
    for s in UNIVERSE:
        df = get_stock_daily_data(symbol=s, days=240)
        if df is None or len(df) < 140:
            continue
        c = np.asarray(df.sort_values("date")["close"], dtype=float)
        if len(c) < 140 or np.any(~np.isfinite(c)) or np.any(c <= 0):
            continue
        r = c[1:] / c[:-1] - 1.0
        rets[s] = r
        vols[s] = max(float(np.std(r[-30:])), 0.006)
    if len(rets) < 10:
        return

    def cr(r, n):
        return float(np.prod(1.0 + r[-n:]) - 1.0)
    h = {n: {s: cr(r, n) for s, r in rets.items()} for n in (1, 3, 5, 10, 15, 20)}
    syms = list(rets)
    dispersion = float(np.std([h[3][s] for s in syms]))
    f = {k: {} for k in FACTORS}
    for s in syms:
        v = vols[s]
        peer5 = np.median([h[5][t] for t in syms if t != s])
        peer3 = np.median([h[3][t] for t in syms if t != s])
        peer15 = np.median([h[15][t] for t in syms if t != s])
        f["scaled_rev5"][s] = np.clip(-h[5][s] / (v * np.sqrt(30) + 1e-6), -6, 6)
        rev3 = -h[3][s] / (v * np.sqrt(3) + .01)
        f["volstate3"][s] = rev3 * (1.0 + min(v / .02, 1.0))
        f["vol_rev3"][s] = rev3 / (1.0 + 3.0 * v)
        f["medium_rev10"][s] = -h[10][s] / (v * np.sqrt(10) + .01)
        f["trend10"][s] = h[10][s] / (v * np.sqrt(10) + .01)
        f["skip120"][s] = np.prod(1.0 + rets[s][-135:-15]) - 1.0
        f["disp_rev3"][s] = (peer3 - h[3][s]) / (v * np.sqrt(3) + .01) * min(dispersion / .025, 1.0)
        f["peer5"][s] = peer5 / (v * np.sqrt(5) + .01)

    score = {s: sum(w * rank_factor(f[k])[s] for k, w in FACTORS.items()) for s in UNIVERSE}
    if _previous is not None:
        score = {s: .50 * score[s] + .50 * _previous.get(s, .5) for s in UNIVERSE}
    _previous = score.copy()

    breadth = np.mean([h[20][s] > 0 for s in syms])
    stress = breadth < .50 or np.median(list(h[10].values())) < 0 or np.median(list(vols.values())) > .018
    inv_mean = np.mean([1.0 / v for v in vols.values()])
    raw = {}
    for s in UNIVERSE:
        invvol = (1.0 / vols.get(s, .02)) / inv_mean
        raw[s] = max(score[s], .05) * (.90 + .10 * min(invvol, 1.20))
        if stress and s in DEFENSIVE:
            raw[s] *= 2.10
        elif stress and h[20].get(s, 0.0) < -.08:
            raw[s] *= .70
    target = bounded(raw)
    if all(np.isfinite(target[s]) for s in UNIVERSE) and abs(sum(target.values()) - 1.0) < 1e-8:
        rebalance_to_weights(target)


