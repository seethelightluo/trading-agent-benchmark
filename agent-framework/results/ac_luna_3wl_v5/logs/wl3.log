for s in UNIVERSE}\n    breadth = np.mean([mom[s] > 0 for s in mom])\n    defensive = {"XAU", "US10Y", "CN10Y"}\n    avg_inv = np.mean([1.0 / v for v in vols.values()])\n    raw = {}\n    for symbol in UNIVERSE:\n        invtilt = min((1.0 / vols[symbol]) / avg_inv, 1.8) if symbol in vols else 1.0\n        # Medium-high risk / weak breadth: tilt, rather than reduce gross exposure.\n        risk_tilt = 1.18 if breadth < 0.50 and symbol in defensive else (0.93 if breadth < 0.50 else 1.0)\n        raw[symbol] = max(score[symbol], 0.05) * (0.94 + 0.06 * invtilt) * risk_tilt\n    rebalance_to_weights(project(raw))\n', 'file_path': 'strategy.py'})Traceback (most recent call last):
