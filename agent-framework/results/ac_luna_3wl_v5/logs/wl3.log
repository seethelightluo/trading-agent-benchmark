  ▶️ write_file({'content': 'import numpy as np\nfrom alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights\n\nUNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]\n# 2026-07-30 screener ensemble; eight active factors, all long-only ranks.\nFACTORS = {"clv": 0.20, "peer": 0.18, "mom": 0.18, "volrev": 0.13,\n           "rev5": 0.12, "dispersion": 0.08, "macrorev": 0.06, "downrev": 0.05}\nMIN_W, MAX_W, REBALANCE_DAYS = 0.02, 0.14, 10\n_day = 0\n\n\ndef cross_rank(values):\n    valid = sorted((s, float(x)) for s, x in values.items() if np.isfinite(x))\n    out = {s: 0.5 for s in UNIVERSE}\n    for i, (s, _) in enumerate(valid):\n        out[s] = (i + 1.0) / len(valid)\n    return out\n\n\ndef bounded_simplex(raw):\n    # Projection onto the full-investment simplex with practical 2%-14% bounds.\n    out = {s: max(float(raw.get(s, 1.0 / len(UNIVERSE))), 1e-12) for s in UNIVERSE}\n    fixed, active = {}, set(UNIVERSE)\n    for _ in range(50):\n        remaining = 1.0 - sum(fixed.values())\n        denom = sum(out[s] for s in active)\n        if denom <= 0 or remaining < 0:\n            return {s: 1.0 / len(UNIVERSE) for s in UNIVERSE}\n        trial = {s: remaining * out[s] / denom for s in active}\n        clipped = False\n        for s, x in list(trial.items()):\n            if x < MIN_W:\n                fixed[s], clipped = MIN_W, True; active.remove(s)\n            elif x > MAX_W:\n                fixed[s], clipped = MAX_W, True; active.remove(s)\n        if not clipped:\n            fixed.update(trial)\n            break\n    total = sum(fixed.values())\n    return {s: fixed.get(s, 0.0) / total for s in UNIVERSE}\n\n\ndef compound(r, n):\n    return float(np.prod(1.0 + r[-n:]) - 1.0) if len(r) >= n else np.nan\n\n\n@register_hook\ndef cross_asset_strategy():\n    global _day\n    _day += 1\n    # One proposal per ten-trading-day block; preserve actual holdings between decisions.\n    if _day != 1 and (_day - 1) % REBALANCE_DAYS != 0:\n        return\n\n    returns, volatility, signal = {}, {}, {f: {} for f in FACTORS}\n    for symbol in UNIVERSE:\n        df = get_stock_daily_data(symbol=symbol, days=160)\n        if df is None or len(df) < 45:\n            continue\n        df = df.sort_values("date").reset_index(drop=True)\n        close = np.asarray(df["close"], dtype=float)\n        high = np.asarray(df["high"], dtype=float)\n        low = np.asarray(df["low"], dtype=float)\n        volume = np.asarray(df["volume"], dtype=float)\n        if np.any(~np.isfinite(close[-45:])) or np.any(close[-45:] <= 0):\n            continue\n        r = close[1:] / close[:-1] - 1.0\n        vol = max(float(np.nanstd(r[-20:])), 0.008)\n        returns[symbol], volatility[symbol] = r, vol\n        span = high[-1] - low[-1]\n        signal["clv"][symbol] = (2 * close[-1] - high[-1] - low[-1]) / span if span > 0 else 0.0\n        signal["mom"][symbol] = compound(r, 20) / (vol * np.sqrt(20) + 0.01)\n        signal["rev5"][symbol] = -compound(r, 5) / (vol * np.sqrt(5) + 0.005)\n        downside = max(float(np.std(np.minimum(r[-10:], 0.0))), 0.004)\n        signal["downrev"][symbol] = -compound(r, 3) / (downside * np.sqrt(3) + 0.005)\n        medvol = np.nanmedian(volume[-21:-1])\n        boost = np.clip(volume[-1] / medvol, 0.75, 1.5) if medvol > 0 else 1.0\n        signal["volrev"][symbol] = (-r[-1] / vol) * (1 + 0.20 * max(boost - 1, 0))\n\n    # Small cross-section is intentional: use all available tradable benchmarks.\n    if len(returns) < 8:\n        return\n    r5 = {s: compound(r, 5) for s, r in returns.items()}\n    r3 = {s: compound(r, 3) for s, r in returns.items()}\n    med5, med3 = np.median(list(r5.values())), np.median(list(r3.values()))\n    for s in returns:\n        peers = [r5[t] for t in returns if t != s]\n        signal["peer"][s] = r5[s] - (np.median(peers) if peers else med5)\n        # Tradable cross-asset residual proxies; observation-only macro series are not ordered.\n        signal["dispersion"][s] = -(r3[s] - med3)\n        signal["macrorev"][s] = -(r3[s] - med3) / (volatility[s] + 0.01)\n\n    ranks = {f: cross_rank(signal[f]) for f in FACTORS}\n    score = {s: sum(FACTORS[f] * ranks[f][s] for f in FACTORS) for s in UNIVERSE}\n    median_vol = float(np.median(list(volatility.values())))\n    breadth = float(np.mean([compound(returns[s], 20) > 0 for s in returns]))\n    stressed = median_vol > 0.018 or breadth < 0.45\n    inv_mean = float(np.mean([1.0 / v for v in volatility.values()]))\n    raw = {}\n    for s in UNIVERSE:\n        risk_scale = min((1.0 / volatility[s]) / inv_mean, 1.5)\n        raw[s] = max(score[s], 0.05) * (0.85 + 0.15 * risk_scale)\n        if stressed and s in {"XAU", "US10Y", "CN10Y"}:\n            raw[s] *= 1.15\n    target = bounded_simplex(raw)\n    if all(np.isfinite(target[s]) and target[s] >= 0 for s in UNIVERSE) and abs(sum(target.values()) - 1) < 1e-8:\n        rebalance_to_weights(target)\n', 'file_path': 'strategy.py'})Traceback (most recent call last):
