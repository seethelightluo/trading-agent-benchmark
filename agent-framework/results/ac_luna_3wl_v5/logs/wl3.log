  ▶️ write_file({'content': 'import numpy as np\nfrom alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights\n\nUNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]\nDEFENSIVE = {"XAU", "US10Y", "CN10Y"}\n# Current screener ensemble: nine active factors, all directions positive as specified.\nFACTORS = {\n    "volume": .16, "stress": .15, "dispersion": .15, "rev3": .12,\n    "range": .12, "rev10": .10, "rev15": .08, "residual": .07,\n    "intraday": .05,\n}\nCADENCE = 10\nMIN_W, MAX_W = .035, .16\n_day = 0\n_previous = None\n\n\ndef pct_rank(values):\n    out = {s: .5 for s in UNIVERSE}\n    good = sorted((s, float(v)) for s, v in values.items() if np.isfinite(v))\n    if not good:\n        return out\n    for i, (s, _) in enumerate(good):\n        out[s] = (i + 1.0) / len(good)\n    return out\n\n\ndef bounded_weights(raw):\n    # Iterative water-filling keeps all 15 assets invested and within sensible bounds.\n    w = {s: max(float(raw.get(s, 1.0)), 1e-10) for s in UNIVERSE}\n    fixed = set()\n    for _ in range(30):\n        free = [s for s in UNIVERSE if s not in fixed]\n        rem = 1.0 - sum(w[s] for s in fixed)\n        base = sum(w[s] for s in free)\n        if base <= 0 or not free:\n            break\n        for s in free:\n            w[s] = rem * w[s] / base\n        newly = {s for s in free if w[s] < MIN_W or w[s] > MAX_W}\n        if not newly:\n            break\n        for s in newly:\n            w[s] = MIN_W if w[s] < MIN_W else MAX_W\n        fixed |= newly\n    total = sum(w.values())\n    return {s: w[s] / total for s in UNIVERSE}\n\n\n@register_hook\ndef cross_asset_strategy():\n    global _day, _previous\n    _day += 1\n    if _day != 1 and (_day - 1) % CADENCE != 0:\n        return\n\n    data = {}\n    for s in UNIVERSE:\n        df = get_stock_daily_data(symbol=s, days=270)\n        if df is None or len(df) < 160:\n            continue\n        df = df.sort_values("date")\n        c = np.asarray(df["close"], float)\n        o = np.asarray(df["open"], float)\n        if np.any(~np.isfinite(c)) or np.any(c <= 0):\n            continue\n        r = c[1:] / c[:-1] - 1.0\n        vol = max(float(np.std(r[-30:])), .006)\n        down = max(float(np.std(np.minimum(r[-40:], 0))), .004)\n        volume = np.asarray(df["volume"], float) if "volume" in df else np.ones(len(c))\n        volume[~np.isfinite(volume)] = 0\n        data[s] = {\n            "r": r, "vol": vol, "down": down,\n            "h3": float(np.prod(1+r[-3:])-1), "h5": float(np.prod(1+r[-5:])-1),\n            "h10": float(np.prod(1+r[-10:])-1), "h15": float(np.prod(1+r[-15:])-1),\n            "h20": float(np.prod(1+r[-20:])-1), "h120": float(np.prod(1+r[-120:])-1),\n            "intraday": float(np.nanmean((c[-5:] - o[-5:]) / np.maximum(o[-5:], 1e-12))),\n            "vr": float(np.mean(volume[-5:]) / max(np.mean(volume[-20:]), 1e-9)),\n            "range": float(np.nanmean((np.asarray(df["high"])[-5:] - np.asarray(df["low"])[-5:]) / c[-5:])),\n        }\n    if len(data) < 10:\n        return\n\n    syms = list(data)\n    med = {n: np.median([data[s][n] for s in syms]) for n in ("h3", "h5", "h10", "h15", "h20")}\n    f = {k: {} for k in FACTORS}\n    for s in syms:\n        d = data[s]\n        f["volume"][s] = (med["h5"]-d["h5"])/(d["vol"]*np.sqrt(5)+.01) * (.75+.25*np.clip(d["vr"], .5, 1.5))\n        f["stress"][s] = (med["h20"]-d["h20"])/(d["down"]*np.sqrt(20)+.02)\n        f["dispersion"][s] = (med["h20"]-d["h20"])/(d["vol"]*np.sqrt(20)+.015)\n        f["rev3"][s] = (med["h3"]-d["h3"])/(d["vol"]*np.sqrt(3)+.008)\n        f["range"][s] = (med["h5"]-d["h5"])/(d["range"]+.01)\n        f["rev10"][s] = (med["h10"]-d["h10"])/(d["vol"]*np.sqrt(10)+.01)\n        f["rev15"][s] = (med["h15"]-d["h15"])/(d["vol"]*np.sqrt(15)+.012)\n        f["residual"][s] = .7*f["stress"][s] + .3*f["dispersion"][s]\n        f["intraday"][s] = -d["intraday"]/(d["vol"]+.01)\n    ranks = {k: pct_rank(v) for k, v in f.items()}\n    score = {s: sum(FACTORS[k]*ranks[k].get(s, .5) for k in FACTORS) for s in UNIVERSE}\n    if _previous is not None:\n        score = {s: .35*score[s] + .65*_previous.get(s, .5) for s in UNIVERSE}\n    _previous = score.copy()\n\n    breadth = np.mean([data[s]["h120"] > 0 for s in syms])\n    median_vol = np.median([data[s]["vol"] for s in syms])\n    high_risk = median_vol > .018 or breadth < .50\n    inv_mean = np.mean([1.0/data[s]["vol"] for s in syms])\n    raw = {}\n    for s in UNIVERSE:\n        d = data.get(s, {"vol": .02, "h120": 0.0})\n        inv = (1.0/d["vol"]) / max(inv_mean, 1e-9)\n        raw[s] = max(score[s], .10) * (.88 + .12*min(inv, 1.25))\n        if high_risk and s in DEFENSIVE:\n            raw[s] *= 3.0\n        if high_risk and d["h120"] < -.10:\n            raw[s] *= .60\n    target = bounded_weights(raw)\n    if abs(sum(target.values())-1.0) < 1e-8 and all(np.isfinite(x) and x >= 0 for x in target.values()):\n        rebalance_to_weights(target)\n', 'file_path': 'strategy.py'})
