 import numpy as np
from alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights

UNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
FACTORS = {"smooth_rev5": 0.28, "intraday_rev": 0.18, "medium_rev10": 0.16,
           "momentum120": 0.16, "volume_rev": 0.12, "downside_rev": 0.10}
CADENCE = 10
MIN_W, MAX_W = 0.035, 0.14
DEFENSIVE = {"XAU", "US10Y", "CN10Y"}
_day = 0
_previous = None


def rank_cross(x):
    good = sorted((s, float(v)) for s, v in x.items() if np.isfinite(v))
    out = {s: 0.5 for s in UNIVERSE}
    n = len(good)
    for i, (s, _) in enumerate(good):
        out[s] = (i + 1.0) / n
    return out


def bounded(raw):
    fixed, active = {}, set(UNIVERSE)
    for _ in range(50):
        left = 1.0 - sum(fixed.values())
        denom = sum(max(float(raw.get(s, 0.01)), 1e-8) for s in active)
        trial = {s: left * max(float(raw.get(s, 0.01)), 1e-8) / denom for s in active}
        changed = False
        for s, w in list(trial.items()):
            if w < MIN_W:
                fixed[s] = MIN_W; active.remove(s); changed = True
            elif w > MAX_W:
                fixed[s] = MAX_W; active.remove(s); changed = True
        if not changed:
            fixed.update(trial)
            break
    z = sum(fixed.get(s, 0.0) for s in UNIVERSE)
    return {s: fixed.get(s, 0.0) / z for s in UNIVERSE}


@register_hook
def cross_asset_strategy():
    global _day, _previous
    _day += 1
    if _day != 1 and (_day - 1) % CADENCE != 0:
        return

    data = {}
    for s in UNIVERSE:
        df = get_stock_daily_data(symbol=s, days=250)
        if df is None or len(df) < 145:
            continue
        df = df.sort_values("date")
        c = np.asarray(df["close"], dtype=float)
        if np.any(~np.isfinite(c)) or np.any(c <= 0):
            continue
        r = c[1:] / c[:-1] - 1.0
        hi = np.asarray(df["high"], dtype=float)
        lo = np.asarray(df["low"], dtype=float)
        op = np.asarray(df["open"], dtype=float)
        volu = np.asarray(df["volume"], dtype=float) if "volume" in df else np.ones(len(df))
        rv = max(float(np.std(r[-30:])), 0.006)
        downside = max(float(np.std(np.minimum(r[-40:], 0.0))), 0.004)
        # All signals use completed observations only (the final row is the latest completed bar).
        h5 = float(np.prod(1 + r[-5:]) - 1)
        h10 = float(np.prod(1 + r[-10:]) - 1)
        h120 = float(np.prod(1 + r[-120:]) - 1)
        intraday = float(np.nanmean((c[-5:] - op[-5:]) / np.maximum(op[-5:], 1e-12)))
        vr = float(np.nanmean(volu[-5:]) / max(np.nanmean(volu[-30:]), 1e-9))
        data[s] = {"r": r, "rv": rv, "down": downside, "h5": h5, "h10": h10,
                   "h120": h120, "intraday": intraday, "vr": vr}
    if len(data) < 10:
        return

    syms = list(data)
    fac = {k: {} for k in FACTORS}
    med5 = np.median([data[s]["h5"] for s in syms])
    med10 = np.median([data[s]["h10"] for s in syms])
    for s in syms:
        d = data[s]
        # Reversal is volatility-scaled and deliberately smooth/cadence-compatible.
        fac["smooth_rev5"][s] = (med5 - d["h5"]) / (d["rv"] * np.sqrt(5) + 0.01)
        fac["intraday_rev"][s] = -d["intraday"] / (d["rv"] + 0.01)
        fac["medium_rev10"][s] = (med10 - d["h10"]) / (d["rv"] * np.sqrt(10) + 0.01)
        fac["momentum120"][s] = d["h120"] / (d["rv"] * np.sqrt(120) + 0.03)
        fac["volume_rev"][s] = (med5 - d["h5"]) / (d["rv"] * np.sqrt(5) + 0.01) * (0.8 + 0.2 * np.clip(d["vr"], 0, 2))
        fac["downside_rev"][s] = (med5 - d["h5"]) / (d["down"] * np.sqrt(5) + 0.01)

    score = {s: sum(w * rank_cross(fac[k]).get(s, 0.5) for k, w in FACTORS.items()) for s in UNIVERSE}
    if _previous is not None:
        score = {s: 0.40 * score[s] + 0.60 * _previous.get(s, 0.5) for s in UNIVERSE}
    _previous = score.copy()

    breadth = np.mean([data[s]["h120"] > 0 for s in syms])
    high_risk = breadth < 0.50 or np.median([d["rv"] for d in data.values()]) > 0.018
    inv_mean = np.mean([1.0 / d["rv"] for d in data.values()])
    raw = {}
    for s in UNIVERSE:
        d = data.get(s, {"rv": 0.02, "h120": 0.0})
        invvol = (1.0 / d["rv"]) / inv_mean
        raw[s] = max(score[s], 0.08) * (0.90 + 0.10 * min(invvol, 1.25))
        if high_risk and s in DEFENSIVE:
            raw[s] *= 2.70
        elif high_risk and d["h120"] < -0.10:
            raw[s] *= 0.60
    target = bounded(raw)
    if all(np.isfinite(target[s]) and target[s] >= 0 for s in UNIVERSE) and abs(sum(target.values()) - 1.0) < 1e-8:
        rebalance_to_weights(target)


