 import numpy as np
from alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights

UNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
# Screener ensemble: nine factors, all in the supplied positive direction.
FACTORS = {
    "volstate": .25, "leadlag": .18, "lowvol": .15, "medium10": .10,
    "conditional15": .08, "residual20": .08, "idio": .06,
    "clv": .05, "eqresid40": .05
}
CADENCE = 10
MIN_W, MAX_W = .03, .15
_previous = None
_day = 0


def rank(values):
    valid = sorted((s, float(v)) for s, v in values.items() if np.isfinite(v))
    out = {s: .5 for s in UNIVERSE}
    if valid:
        for i, (s, _) in enumerate(valid):
            out[s] = (i + 1.0) / len(valid)
    return out


def bounded_weights(raw):
    # Water-filling enforces a complete, long-only, full-investment vector.
    fixed, active = {}, set(UNIVERSE)
    for _ in range(40):
        left = 1.0 - sum(fixed.values())
        denom = sum(max(float(raw.get(s, .01)), 1e-9) for s in active)
        trial = {s: left * max(float(raw.get(s, .01)), 1e-9) / denom for s in active}
        changed = False
        for s, w in list(trial.items()):
            if w < MIN_W:
                fixed[s] = MIN_W; active.remove(s); changed = True
            elif w > MAX_W:
                fixed[s] = MAX_W; active.remove(s); changed = True
        if not changed:
            fixed.update(trial); break
    total = sum(fixed.values())
    return {s: fixed.get(s, 0.0) / total for s in UNIVERSE}


@register_hook
def cross_asset_strategy():
    global _day, _previous
    _day += 1
    if _day != 1 and (_day - 1) % CADENCE != 0:
        return
    returns, vols, bars = {}, {}, {}
    for s in UNIVERSE:
        df = get_stock_daily_data(symbol=s, days=230)
        if df is None or len(df) < 70:
            continue
        df = df.sort_values("date")
        close = np.asarray(df["close"], dtype=float)
        if np.any(~np.isfinite(close[-70:])) or np.any(close[-70:] <= 0):
            continue
        r = close[1:] / close[:-1] - 1.0
        returns[s] = r
        vols[s] = max(float(np.std(r[-20:])), .006)
        bars[s] = df.iloc[-1]
    if len(returns) < 10:
        return

    def cum(r, n):
        return float(np.prod(1.0 + r[-n:]) - 1.0)
    r1 = {s: r[-1] for s, r in returns.items()}
    r5 = {s: cum(r, 5) for s, r in returns.items()}
    r10 = {s: cum(r, 10) for s, r in returns.items()}
    r15 = {s: cum(r, 15) for s, r in returns.items()}
    r20 = {s: cum(r, 20) for s, r in returns.items()}
    r40 = {s: cum(r, 40) for s, r in returns.items()}
    symbols = list(returns)
    eq = [s for s in UNIVERSE[:8] if s in returns]
    eq_med = float(np.median([r40[s] for s in eq])) if eq else 0.0
    factors = {k: {} for k in FACTORS}
    for s, r in returns.items():
        v = vols[s]
        peer5 = np.median([r5[t] for t in symbols if t != s])
        peer15 = np.median([r15[t] for t in symbols if t != s])
        rev1 = -r1[s] / (v + .006)
        factors["volstate"][s] = rev1 * (1.0 + min(v / .02, 1.0))
        factors["leadlag"][s] = peer5 / (v * np.sqrt(5.0) + .01)
        factors["lowvol"][s] = rev1 / (1.0 + 2.0 * v)
        factors["medium10"][s] = -r10[s] / (v * np.sqrt(10.0) + .01)
        # Conditional medium reversal: activate only when the peer backdrop is weak.
        factors["conditional15"][s] = (-r15[s] / (v * np.sqrt(15.0) + .01)) if peer15 < 0 else 0.0
        factors["residual20"][s] = -(r20[s] - peer5) / (v * np.sqrt(20.0) + .01)
        factors["idio"][s] = rev1 - (r5[s] - peer5) / (v + .01)
        b = bars[s]
        hi, lo, c = float(b.get("high", 0)), float(b.get("low", 0)), float(b["close"])
        factors["clv"][s] = (2.0*c - hi - lo) / (hi-lo) if hi > lo else 0.0
        factors["eqresid40"][s] = -(r40[s] - eq_med) / (v * np.sqrt(40.0) + .02)
    score = {s: sum(w * rank(factors[k])[s] for k, w in FACTORS.items()) for s in UNIVERSE}
    if _previous is not None:
        score = {s: .50 * score[s] + .50 * _previous.get(s, .5) for s in UNIVERSE}
    _previous = score.copy()

    breadth = float(np.mean([r20[s] > 0 for s in returns]))
    stress = breadth < .50 or float(np.median(list(r10.values()))) < 0.0 or float(np.median(list(vols.values()))) > .018
    defensive = {"XAU", "US10Y", "CN10Y"}
    mean_invvol = float(np.mean([1.0 / v for v in vols.values()]))
    raw = {}
    for s in UNIVERSE:
        relative_iv = (1.0 / vols.get(s, .02)) / mean_invvol
        raw[s] = max(score[s], .05) * (.90 + .10 * min(relative_iv, 1.20))
        if stress and s in defensive:
            raw[s] *= 1.85
        elif stress and r20.get(s, 0.0) < -.08:
            raw[s] *= .75
    target = bounded_weights(raw)
    if np.isfinite(sum(target.values())) and abs(sum(target.values()) - 1.0) < 1e-8:
        rebalance_to_weights(target)


