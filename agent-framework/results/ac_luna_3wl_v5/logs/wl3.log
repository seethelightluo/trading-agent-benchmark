  ▶️ write_file({'content': 'import numpy as np\nfrom alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights\n\nUNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]\nDEFENSIVE = {"XAU", "US10Y", "CN10Y"}\nCADENCE = 10\nMIN_W, MAX_W = 0.04, 0.20\n# Screener ensemble: all directions are positive and ranks are lagged.\nFACTORS = ("failure", "volstate", "dispersion", "residual", "consistency", "short_breakout", "breakout120", "downside")\nFACTOR_W = (0.24, 0.18, 0.14, 0.14, 0.11, 0.07, 0.06, 0.06)\n_day = 0\n_previous = None\n\n\ndef rank_cs(vals):\n    valid = sorted((s, v) for s, v in vals.items() if np.isfinite(v))\n    out = {s: 0.5 for s in UNIVERSE}\n    for i, (s, _) in enumerate(valid):\n        out[s] = (i + 1.0) / max(1, len(valid))\n    return out\n\n\ndef bounded(raw):\n    # Iterative projection onto the complete, long-only 4%-20% portfolio.\n    w = {s: max(float(raw.get(s, 1.0)), 1e-10) for s in UNIVERSE}\n    fixed = set()\n    for _ in range(50):\n        free = [s for s in UNIVERSE if s not in fixed]\n        rem = 1.0 - sum(w[s] for s in fixed)\n        den = sum(w[s] for s in free)\n        for s in free:\n            w[s] = rem * w[s] / max(den, 1e-12)\n        hit = [s for s in free if w[s] < MIN_W or w[s] > MAX_W]\n        if not hit:\n            break\n        for s in hit:\n            w[s] = MIN_W if w[s] < MIN_W else MAX_W\n        fixed.update(hit)\n    total = sum(w.values())\n    return {s: w[s] / total for s in UNIVERSE}\n\n\n@register_hook\ndef cross_asset_strategy():\n    global _day, _previous\n    _day += 1\n    if _day != 1 and (_day - 1) % CADENCE != 0:\n        return\n\n    feats, rets = {}, {}\n    for symbol in UNIVERSE:\n        df = get_stock_daily_data(symbol=symbol, days=195)\n        if df is None or len(df) < 135:\n            continue\n        close = np.asarray(df.sort_values("date")["close"], dtype=float)[:-1]\n        if len(close) < 125 or np.any(~np.isfinite(close)) or np.any(close <= 0):\n            continue\n        r = close[1:] / close[:-1] - 1.0\n        vol = max(float(np.std(r[-20:])), 0.006)\n        r3 = float(np.prod(1 + r[-3:]) - 1)\n        r5 = float(np.prod(1 + r[-5:]) - 1)\n        r20 = float(np.prod(1 + r[-20:]) - 1)\n        r30 = float(np.prod(1 + r[-30:]) - 1)\n        h20, h60, h120 = max(close[-21:]), max(close[-61:]), max(close[-121:])\n        downvol = max(float(np.sqrt(np.mean(np.minimum(r[-20:], 0) ** 2))), 0.006)\n        # Reversal and risk-state terms are deliberately bounded to avoid\n        # extreme weights during the stressed regime.\n        feats[symbol] = {\n            "vol": vol,\n            "failure": np.clip((-r5) * max(0., close[-1] / h20 - .985) / vol, -3, 3),\n            "volstate": np.clip((-r3) / vol, -3, 3),\n            "dispersion": np.clip((-r5) / max(vol * np.sqrt(5), .01), -3, 3),\n            "residual": r20 / max(vol * np.sqrt(20), .01),\n            "consistency": r30 / max(vol * np.sqrt(30), .01) * (.5 + np.mean(r[-30:] > 0)),\n            "short_breakout": (close[-1] / h20 - 1.) / max(vol * np.sqrt(20), .01),\n            "breakout120": (close[-1] / h120 - 1.) / max(vol * np.sqrt(120), .01),\n            "downside": r20 / downvol,\n        }\n        rets[symbol] = r\n    if len(feats) < 10:\n        return\n\n    # Remove broad market beta from the residual trend signal.\n    market = rets.get("SPX")\n    if market is not None:\n        for s, r in rets.items():\n            n = min(60, len(r), len(market))\n            if n >= 30:\n                beta = np.cov(r[-n:], market[-n:], ddof=1)[0, 1] / max(np.var(market[-n:], ddof=1), 1e-8)\n                m20 = np.prod(1 + market[-20:]) - 1\n                feats[s]["residual"] -= beta * m20 / max(np.std(market[-20:]) * np.sqrt(20), .01)\n\n    ranks = [rank_cs({s: feats[s][f] for s in feats}) for f in FACTORS]\n    score = {s: sum(FACTOR_W[i] * ranks[i][s] for i in range(len(FACTORS))) for s in UNIVERSE}\n    if _previous is not None:\n        score = {s: .75 * score[s] + .25 * _previous[s] for s in UNIVERSE}\n    _previous = score.copy()\n\n    vols = [x["vol"] for x in feats.values()]\n    medvol = float(np.median(vols))\n    breadth = float(np.mean([x["breakout120"] > 0 for x in feats.values()]))\n    stressed = medvol > .018 or breadth < .45\n    invmean = float(np.mean([1. / x["vol"] for x in feats.values()]))\n    raw = {}\n    for s in UNIVERSE:\n        x = feats.get(s, {"vol": medvol, "breakout120": 0.})\n        risk_damp = np.clip((1. / x["vol"]) / max(invmean, 1e-12), .70, 1.20)\n        raw[s] = max(score[s], .08) * (.84 + .16 * risk_damp)\n        if stressed:\n            # Defensive rotation, but less aggressive than the prior 5x tilt\n            # so one correlated hedge cannot dominate the bounded portfolio.\n            raw[s] *= 2.25 if s in DEFENSIVE else (.68 if x["breakout120"] < -.10 else .80)\n    target = bounded(raw)\n    if all(np.isfinite(target[s]) for s in UNIVERSE) and abs(sum(target.values()) - 1.) < 1e-8:\n        rebalance_to_weights(target)\n', 'file_path': 'strategy.py'})
