  ▶️ write_file({'content': 'import numpy as np\nfrom alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights\n\nUNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]\n# Screener ensemble (maximum five active factors; all directions positive).\nFACTORS = {"lowvol_rev1": 0.55, "clv": 0.18, "peer5": 0.13, "mom20": 0.10, "overnight_intraday_rev": 0.04}\nREBALANCE_EVERY = 10\nMIN_WEIGHT, MAX_WEIGHT = 0.02, 0.14\n_calls = 0\n\ndef cross_rank(values):\n    valid = sorted((s, v) for s, v in values.items() if np.isfinite(v))\n    out = {s: 0.5 for s in UNIVERSE}\n    n = len(valid)\n    for i, (s, _) in enumerate(valid):\n        out[s] = (i + 1) / n if n > 1 else 0.5\n    return out\n\ndef project(raw):\n    # Bounded water-filling; produces a complete, non-negative, unit-sum target.\n    fixed = {}\n    w = {s: max(float(raw.get(s, 0.5)), 1e-8) for s in UNIVERSE}\n    for _ in range(30):\n        free = [s for s in UNIVERSE if s not in fixed]\n        rem = 1.0 - sum(fixed.values())\n        z = sum(w[s] for s in free)\n        trial = {s: rem * w[s] / z if z else rem / len(free) for s in free}\n        changed = False\n        for s, q in trial.items():\n            if q < MIN_WEIGHT:\n                fixed[s] = MIN_WEIGHT; changed = True\n            elif q > MAX_WEIGHT:\n                fixed[s] = MAX_WEIGHT; changed = True\n        if not changed:\n            result = dict(fixed); result.update(trial)\n            z = sum(result.values())\n            return {s: result[s] / z for s in UNIVERSE}\n    result = {s: fixed.get(s, MIN_WEIGHT) for s in UNIVERSE}\n    z = sum(result.values())\n    return {s: v / z for s, v in result.items()}\n\n@register_hook\ndef cross_asset_strategy():\n    global _calls\n    _calls += 1\n    if _calls != 1 and (_calls - 1) % REBALANCE_EVERY != 0:\n        return\n    factors = {k: {} for k in FACTORS}\n    vols, mom = {}, {}