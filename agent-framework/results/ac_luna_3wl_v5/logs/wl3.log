# decay horizons
for h in [1,3,5]:
 z=[]
 for s in U:
  d=get_stock_daily_data(s,4000)
  if d is None or len(d)==0:d=get_index_daily_data(s,4000)
  if d is None or len(d)==0:continue
  d=d.sort_values('date'); c=d.close.astype(float); r=c.pct_change(); f=(-c.pct_change(3)/r.rolling(10).std()).rolling(3,min_periods=2).mean(); fw=c.shift(-h)/c-1
  z.append(pd.DataFrame({'date':pd.to_datetime(d.date),'symbol':s,'x':f,'y':fw}))
 z=pd.concat(z); ii=[]
 for dt,g in z.groupby('date'):
