 import numpy as np
from alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights

UNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
FACTORS = {
    "lowvol": 0.28, "volume": 0.13, "res3": 0.12, "stress": 0.12,
    "res5": 0.10, "clv": 0.09, "peer5": 0.08, "mom20": 0.08
}
REBALANCE_EVERY = 10
MIN_WEIGHT, MAX_WEIGHT = 0.02, 0.14
_calls = 0


def rank(x):
    good = sorted((s, float(v)) for s, v in x.items() if np.isfinite(v))
    out = {s: 0.5 for s in UNIVERSE}
    for i, (s, _) in enumerate(good):
        out[s] = (i + 1.0) / len(good)
    return out


def bounded(raw):
    # Iterative water filling enforces the complete, long-only target contract.
    fixed, active = {}, set(UNIVERSE)
    base = {s: max(float(raw.get(s, 0.0)), 1e-8) for s in UNIVERSE}
    for _ in range(30):
        left = 1.0 - sum(fixed.values())
        den = sum(base[s] for s in active)
        trial = {s: left * base[s] / den for s in active}
        clipped = False
        for s, v in list(trial.items()):
            if v < MIN_WEIGHT:
                fixed[s] = MIN_WEIGHT; active.remove(s); clipped = True
            elif v > MAX_WEIGHT:
                fixed[s] = MAX_WEIGHT; active.remove(s); clipped = True
        if not clipped:
            fixed.update(trial); break
    if active:
        left = 1.0 - sum(fixed.values())
        den = sum(base[s] for s in active)
        fixed.update({s: left * base[s] / den for s in active})
    z = sum(fixed.values())
    return {s: fixed.get(s, 0.0) / z for s in UNIVERSE}


@register_hook
def cross_asset_strategy():
    global _calls
    _calls += 1
    if _calls != 1 and (_calls - 1) % REBALANCE_EVERY != 0:
        return
    raw = {k: {} for k in FACTORS}
    returns, vols, r20 = {}, {}, {}
    for s in UNIVERSE:
        df = get_stock_daily_data(symbol=s, days=130)
        if df is None or len(df) < 35:
            continue
        df = df.sort_values("date").reset_index(drop=True)
        c = np.asarray(df.close, float); o = np.asarray(df.open, float)
        h = np.asarray(df.high, float); l = np.asarray(df.low, float)
        if np.any(~np.isfinite(c[-35:])) or np.any(c[-35:] <= 0):
            continue
        dr = c[1:] / c[:-1] - 1.0
        v = max(float(np.std(dr[-20:])), 0.008)
        vols[s] = v; returns[s] = dr; r20[s] = c[-1] / c[-21] - 1.0
        raw["lowvol"][s] = -dr[-1] / v
        raw["mom20"][s] = r20[s] / (v * np.sqrt(20.0) + 0.01)
        span = h[-1] - l[-1]
        raw["clv"][s] = -(c[-1] - o[-1]) / span if np.isfinite(span) and span > 0 else 0.0
        stress = np.clip(abs(dr[-1]) / v, 0.5, 2.0)
        # Stress weighting is capped to avoid one abnormal print dominating ranks.
        raw["stress"][s] = (-dr[-1] / v) * stress
        if "volume" in df.columns:
            vv = np.asarray(df.volume, float); med = np.nanmedian(vv[-21:])
            amp = vv[-1] / med if np.isfinite(vv[-1]) and vv[-1] > 0 and med > 0 else 1.0
            raw["volume"][s] = (-dr[-1] / v) * np.clip(amp, 0.75, 1.5)
        else:
            raw["volume"][s] = 0.0
    if len(vols) < 8:
        return
    # Cross-sectional peer residuals, using only the observed prior-day returns.
    for s in vols:
        peer = [returns[t][-1] for t in vols if t != s]
        med1 = float(np.median(peer)) if peer else 0.0
        peer3 = [np.prod(1.0 + returns[t][-3:]) - 1.0 for t in vols if t != s and len(returns[t]) >= 3]
        med3 = float(np.median(peer3)) if peer3 else 0.0
        own3 = np.prod(1.0 + returns[s][-3:]) - 1.0
        own5 = np.prod(1.0 + returns[s][-5:]) - 1.0
        peer5 = [np.prod(1.0 + returns[t][-5:]) - 1.0 for t in vols if t != s and len(returns[t]) >= 5]
        med5 = float(np.median(peer5)) if peer5 else 0.0
        raw["res3"][s] = -(own3 - med3) / (vols[s] * np.sqrt(3.0) + 0.005)
        raw["res5"][s] = -(own5 - med5) / (vols[s] * np.sqrt(5.0) + 0.005)
        raw["peer5"][s] = own5 - med5
    rr = {k: rank(v) for k, v in raw.items()}
    score = {s: sum(FACTORS[k] * rr[k][s] for k in FACTORS) for s in UNIVERSE}
    breadth = np.mean([r20[s] > 0 for s in r20])
    market_vol = float(np.median(list(vols.values())))
    defensive = {"XAU", "US10Y", "CN10Y"}
    risk = market_vol > 0.018 or breadth < 0.45
    avg_inv = np.mean([1.0 / v for v in vols.values()])
    target = {}
    for s in UNIVERSE:
        inv = min((1.0 / vols.get(s, market_vol)) / avg_inv, 1.5)
        tilt = 1.12 if risk and s in defensive else (0.96 if risk else 1.0)
        target[s] = max(score[s], 0.05) * (0.85 + 0.15 * inv) * tilt
    rebalance_to_weights(bounded(target))


