in vols.values()])\n    raw = {}\n    for s in UNIVERSE:\n        sc = scores.get(s, .5)\n        risk_damp = min((1. / vols.get(s, .02)) / invmean, 1.35)\n        raw[s] = max(sc, .05) * (.88 + .12 * risk_damp)\n        if stressed and s in {"XAU", "US10Y", "CN10Y"}:\n            raw[s] *= 1.15\n    target = bounded(raw)\n    if set(target) == set(UNIVERSE) and all(np.isfinite(v) and v >= 0 for v in target.values()):\n        rebalance_to_weights(target)\n', 'file_path': 'strategy.py'})
