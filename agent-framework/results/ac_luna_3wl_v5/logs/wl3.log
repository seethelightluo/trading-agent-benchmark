)).corr(g.r,method='spearman')\n   if pd.notna(c): vv.append(c)\n print('decay',h,len(vv),np.mean(vv),np.mean(vv)/np.std(vv,ddof=1))\n", 'file_path': 'scripts/miner_3_20260730_winsorized_volscaled_reversal.py'})
