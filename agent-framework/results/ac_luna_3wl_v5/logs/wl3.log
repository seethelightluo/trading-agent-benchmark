',np.mean(turnover),'cutoff',cut.date())\nfor h in [5,10]:\n    yy=px.pct_change(h).shift(-h)/1 # forward cumulative pct change already\n    rr=[]\n    for dt in sig.index:\n      z=pd.concat([sig.loc[dt],yy.loc[dt]],axis=1).dropna()\n      if len(z)>=8: rr.append(spearmanr(z.iloc[:,0],z.iloc[:,1]).statistic)\n    a=pd.Series(rr); print('decay',h,len(a),a.mean(),a.mean()/a.std(ddof=1))\n# artifact for reproducibility\nout='scripts/miner_3_20260730_volume_confirmed_1d_research.csv'\nq.to_csv(out)\nprint('artifact',out)\n", 'file_path': 'scripts/miner_3_20260730_volume_confirmed_1d_research.py'})
