UNIVERSE:\n        df = get_stock_daily_data(symbol=s, days=230)\n        if df is None or len(df) < 70:\n            continue\n        close = np.asarray(df.sort_values("date")["close"], dtype=float)\n        if np.any(~np.isfinite(close[-70:])) or np.any(close[-70:] <= 0):\n            continue\n        r = close[1:] / close[:-1] - 1.0\n        ret[s] = r\n        vol[s] = max(float(np.std(r[-20:])), 0.006)\n    if len(ret) < 10:\n        return\n\n    r1 = {s: r[-1] for s, r in ret.items()}\n    r3 = {s: float(np.prod(1 + r[-3:]) - 1) for s, r in ret.items()}\n    r5 = {s: float(np.prod(1 + r[-5:]) - 1) for s, r in ret.items()}\n    r20 = {s: float(np.prod(1 + r[-20:]) - 1) for s, r in ret.items()}\n    r40 = {s: float(np.prod(1 + r[-40:]) - 1) for s, r in ret.items()}\n    eq = [s for s in UNIVERSE[:8] if s in ret]\n    eq_med = np.median([r40[s] for s in eq]) if eq else np.median(list(r40.values()))\n    dispersion = float(np.std(list(r1.values())))\n    breadth = float(np.mean([x > 0 for x in r20.values()]))\n    high_risk = breadth < 0.45 or np.median(list(vol.values())) > 0.018 or np.median(list(r5.values())) < 0\n    high_disp = dispersion > 0.012\n\n    f = {k: {} for k in FACTORS}\n    for s in ret:\n        v = vol[s]\n        rev = -r1[s] / (v + 0.006)\n        f["volstate"][s] = rev * (1.0 + min(v / 0.02, 1.0))\n        f["idio"][s] = -r1[s] / (v + 0.004)\n        f["short_rev"][s] = rev\n        f["disp_cond"][s] = rev if high_disp else 0.0\n        # Continuous dispersion score is a smooth, non-binary version of reversal.\n        f["disp_cont"][s] = rev * min(dispersion / 0.012, 1.5)\n        peer = [r5[t] for t in ret if t != s]\n        f["peer"][s] = r5[s] - np.median(peer) if peer else 0.0\n        f["momentum"][s] = r20[s] / (v * np.sqrt(20.0) + 0.01)\n        f["residual"][s] = (r40[s] - eq_med) / (v * np.sqrt(40.0) + 0.02)\n\n    ranks = {k: rank_cs(v) for k, v in f.items()}\n    score = {s: sum(FACTORS[k] * ranks[k].get(s, 0.5) for k in FACTORS) for s in ret}\n    # Smooth one-day signal changes to respect the 10-day holding horizon.\n    if _last_score is not None:\n        score = {s: 0.65 * x + 0.35 * _last_score.get(s, x) for s, x in score.items()}\n    _last_score = score.copy()\n\n    defensive = {"XAU", "US10Y", "CN10Y"}\n    mean_inv = np.mean([1.0 / x for x in vol.values()])\n    raw = {}\n    for s in UNIVERSE:\n        inv_damp = min((1.0 / vol.get(s, 0.02)) / mean_inv, 1.25)\n        raw[s] = max(score.get(s, 0.5), 0.05) * (0.88 + 0.12 * inv_damp)\n        # Bear/high-vol regime: remain fully invested but favor defensive tradables.\n        if high_risk and s in defensive:\n            raw[s] *= 1.35\n    target = bounded_weights(raw)\n    if len(target) == 15 and abs(sum(target.values()) - 1.0) < 1e-8 and all(np.isfinite(x) and x >= 0 for x in target.values()):\n        rebalance_to_weights(target)\n', 'file_path': 'strategy.py'})
