  ▶️ write_file({'content': 'import numpy as np\nfrom alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights\n\nUNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]\n# Screener ensemble: CLV, peer lead-lag, 5d reversal, risk-adjusted momentum.\nFACTOR_WEIGHTS = {"clv": 0.3395, "peer": 0.2612, "reversal": 0.2012, "momentum": 0.1981}\nREBALANCE_EVERY = 10\nMIN_W, MAX_W = 0.02, 0.14\n_calls = 0\n\n\ndef ranks(x):\n    out = {s: 0.5 for s in UNIVERSE}\n    a = sorted((s, float(v)) for s, v in x.items() if np.isfinite(v))\n    n = len(a)\n    if n > 1:\n        for i, (s, _) in enumerate(a):\n            out[s] = (i + 1.0) / n\n    return out\n\n\ndef box_simplex(raw):\n    # Iterative projection gives a complete, long-only, no-cash vector.\n    w = {s: max(float(raw.get(s, 0.0)), 1e-8) for s in UNIVERSE}\n    fixed = {}\n    for _ in range(50):\n        free = [s for s in UNIVERSE if s not in fixed]\n        left = 1.0 - sum(fixed.values())\n        scale = left / max(sum(w[s] for s in free), 1e-12)\n        bad = []\n        for s in free:\n            v = w[s] * scale\n            if v < MIN_W:\n                fixed[s] = MIN_W; bad.append(s)\n            elif v > MAX_W:\n                fixed[s] = MAX_W; bad.append(s)\n            else:\n                w[s] = v\n        if not bad:\n            break\n    w.update(fixed)\n    total = sum(w.values())\n    return {s: w[s] / total for s in UNIVERSE}\n\n\n@register_hook\ndef cross_asset_strategy():\n    global _calls\n    _calls += 1\n    # Decisions are made only on the first day of each 10-trading-day block.\n    if _calls > 1 and (_calls - 1) % REBALANCE_EVERY:\n        return\n\n    data = {}\n    for s in UNIVERSE:\n        df = get_stock_daily_data(symbol=s, days=90)\n        if df is None or len(df) < 26:\n            continue\n        df = df.sort_values("date").reset_index(drop=True)\n        c = np.asarray(df["close"], dtype=float)\n        h = np.asarray(df["high"], dtype=float)\n        l = np.asarray(df["low"], dtype=float)\n        r = c[1:] / np.maximum(c[:-1], 1e-12) - 1.0\n        if np.all(np.isfinite(c[-26:])):\n            data[s] = (c, h, l, r)\n    if len(data) < 12:\n        return\n\n    clv, peer_raw, rev, mom, invvol = {}, {}, {}, {}, {}\n    five = {}\n    for s, (c, h, l, r) in data.items():\n        # Standard close-location value: higher close within the day is positive.\n        loc = (c - l) / np.maximum(h - l, 1e-12)\n        clv[s] = float(np.mean(loc[-3:]))\n        rev[s] = -float(np.mean(r[-5:]))\n        five[s] = float(c[-1] / max(c[-6], 1e-12) - 1.0)\n        sigma = max(float(np.std(r[-20:])), 0.008)\n        invvol[s] = 1.0 / sigma\n        mom[s] = float((c[-1] / max(c[-21], 1e-12) - 1.0) / (sigma + 0.01))\n    med = float(np.median(list(five.values())))\n    peer_raw = {s: v - med for s, v in five.items()}\n    rr = {k: ranks(v) for k, v in (("clv", clv), ("peer", peer_raw), ("reversal", rev), ("momentum", mom))}\n    score = {s: sum(FACTOR_WEIGHTS[k] * rr[k][s] for k in rr) for s in UNIVERSE}\n\n    # Bullish but medium-high risk: keep full investment, cap concentration and\n    # add only a modest defensive tilt if the broad trend is actually bearish.\n    if "SPX" in data:\n        spx = data["SPX"][0]\n        if spx[-1] < spx[-6] and spx[-1] < spx[-21]:\n            for s in ("XAU", "US10Y", "CN10Y"):\n                score[s] += 0.12\n            for s in ("BTC", "ETH", "WTI"):\n                score[s] = max(0.05, score[s] - 0.06)\n\n    avg_iv = max(float(np.mean(list(invvol.values()))), 1e-12)\n    raw = {s: max(score[s], 0.02) * (0.82 + 0.18 * invvol.get(s, avg_iv) / avg_iv) for s in UNIVERSE}\n    rebalance_to_weights(box_simplex(raw))\n', 'file_path': 'strategy.py'})
