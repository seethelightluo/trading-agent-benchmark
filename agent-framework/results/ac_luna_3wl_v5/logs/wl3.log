  ▶️ write_file({'content': 'import numpy as np\nfrom alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights\n\nUNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]\nDEFENSIVE = {"XAU", "US10Y", "CN10Y"}\nCADENCE = 10\nMIN_W, MAX_W = 0.04, 0.20\n# Current screener ensemble: low-turnover trend signals, all direction +1.\nFACTOR_NAMES = ("breakout120", "breakout60", "residual", "downside", "consistency", "medium")\nFACTOR_W = (0.28, 0.25, 0.18, 0.14, 0.10, 0.05)\n_day = 0\n_previous = None\n\n\ndef rank_map(values):\n    good = sorted((s, float(v)) for s, v in values.items() if np.isfinite(v))\n    out = {s: 0.5 for s in UNIVERSE}\n    for i, (s, _) in enumerate(good):\n        out[s] = (i + 1.0) / max(len(good), 1)\n    return out\n\n\ndef capped_simplex(raw):\n    # Iterative capped proportional allocation; preserves a complete target.\n    w = {s: max(float(raw.get(s, 1.0)), 1e-12) for s in UNIVERSE}\n    fixed = set()\n    for _ in range(60):\n        free = [s for s in UNIVERSE if s not in fixed]\n        rem = 1.0 - sum(w[s] for s in fixed)\n        den = sum(w[s] for s in free)\n        for s in free:\n            w[s] = rem * w[s] / max(den, 1e-12)\n        hit = [s for s in free if w[s] < MIN_W or w[s] > MAX_W]\n        if not hit:\n            break\n        for s in hit:\n            w[s] = MIN_W if w[s] < MIN_W else MAX_W\n        fixed.update(hit)\n    total = sum(w.values())\n    return {s: w[s] / total for s in UNIVERSE}\n\n\n@register_hook\ndef cross_asset_strategy():\n    global _day, _previous\n    _day += 1\n    if _day != 1 and (_day - 1) % CADENCE != 0:\n        return\n    series, feats = {}, {}\n    for symbol in UNIVERSE:\n        df = get_stock_daily_data(symbol=symbol, days=190)\n        if df is None or len(df) < 130:\n            continue\n        close = np.asarray(df.sort_values("date")["close"], dtype=float)\n        if len(close) < 130 or np.any(~np.isfinite(close)) or np.any(close <= 0):\n            continue\n        r = close[1:] / close[:-1] - 1.0\n        vol = max(float(np.std(r[-20:])), 0.006)\n        r20 = float(np.prod(1 + r[-20:]) - 1)\n        r30 = float(np.prod(1 + r[-30:]) - 1)\n        r60 = float(np.prod(1 + r[-60:]) - 1)\n        # Prior highs exclude the last observation, avoiding look-ahead.\n        high60 = max(np.max(close[-61:-1]), 1e-12)\n        high120 = max(np.max(close[-121:-1]), 1e-12)\n        feats[symbol] = {\n            "vol": vol,\n            "breakout60": (close[-1] / high60 - 1) / max(vol * np.sqrt(60), .01),\n            "breakout120": (close[-1] / high120 - 1) / max(vol * np.sqrt(120), .01),\n            "downside": r20 / max(float(np.sqrt(np.mean(np.minimum(r[-20:], 0)**2))), .006),\n            "consistency": (r30 / max(vol * np.sqrt(30), .01)) * (0.5 + float(np.mean(r[-30:] > 0))),\n            "medium": r60 / max(vol * np.sqrt(60), .01),\n        }\n        series[symbol] = r\n    if len(feats) < 10:\n        return\n    market = series.get("SPX")\n    for s, r in series.items():\n        n = min(60, len(r), len(market) if market is not None else 0)\n        if market is None or n < 30:\n            feats[s]["residual"] = float(np.prod(1 + r[-20:]) - 1)\n        else:\n            a, b = r[-n:], market[-n:]\n            beta = float(np.cov(a, b, ddof=1)[0, 1] / max(np.var(b, ddof=1), 1e-8))\n            feats[s]["residual"] = float(np.prod(1 + r[-20:]) - 1) - beta * float(np.prod(1 + b[-20:]) - 1)\n    ranks = [rank_map({s: x.get(f, 0.0) for s, x in feats.items()}) for f in FACTOR_NAMES]\n    score = {s: sum(FACTOR_W[i] * ranks[i][s] for i in range(6)) for s in UNIVERSE}\n    if _previous is not None:\n        score = {s: 0.75 * score[s] + 0.25 * _previous[s] for s in UNIVERSE}\n    _previous = score.copy()\n    median_vol = float(np.median([x["vol"] for x in feats.values()]))\n    breadth = float(np.mean([x["medium"] > 0 for x in feats.values()]))\n    high_risk = median_vol > 0.018 or breadth < 0.45 or feats.get("SPX", {}).get("medium", 0) < -0.10\n    inv_mean = float(np.mean([1 / x["vol"] for x in feats.values()]))\n    raw = {}\n    for s in UNIVERSE:\n        x = feats.get(s, {"vol": median_vol, "medium": 0})\n        damp = np.clip((1 / x["vol"]) / max(inv_mean, 1e-12), 0.65, 1.25)\n        raw[s] = max(score[s], 0.05) * (0.82 + 0.18 * damp)\n        if high_risk:\n            if s in DEFENSIVE:\n                raw[s] *= 3.0\n            elif x["medium"] < -0.08:\n                raw[s] *= 0.65\n    rebalance_to_weights(capped_simplex(raw))\n', 'file_path': 'strategy.py'})
