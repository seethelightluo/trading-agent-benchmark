at the last completed bar supplied by the simulator.\n        series[s] = {\n            "r": r, "h5": np.prod(1+r[-5:])-1, "h10": np.prod(1+r[-10:])-1,\n            "h20": np.prod(1+r[-20:])-1, "h60": np.prod(1+r[-60:])-1,\n            "h120": np.prod(1+r[-120:])-1, "v20": max(np.std(r[-20:]), .006)\n        }\n    if len(series) < 10:\n        return\n    med20 = np.median([x["h20"] for x in series.values()])\n    med60 = np.median([x["h60"] for x in series.values()])\n    breadth = np.mean([x["h20"] > 0 for x in series.values()])\n    f1, f2, f3 = {}, {}, {}\n    for s, x in series.items():\n        # Excess momentum is deliberately medium horizon, not a 1-day timer.\n        f1[s] = (x["h20"] - med20) / (x["v20"] * np.sqrt(20) + .02)\n        # Consistency rewards positive returns on most of the last 20 sessions.\n        f2[s] = np.mean(x["r"][-20:] > 0) + .25 * np.tanh(x["h60"] / (x["v20"] * 3 + .02))\n        # Breadth confirmation scales medium momentum by market breadth.\n        f3[s] = x["h20"] * (0.65 + 0.70 * breadth) + 0.35 * (x["h60"] - med60)\n    ranks = [rank(f1), rank(f2), rank(f3)]\n    score = {s: sum(w * q[s] for w, q in zip(FACTOR_W, ranks)) for s in UNIVERSE}\n    if _previous is not None:\n        score = {s: .65 * score[s] + .35 * _previous[s] for s in UNIVERSE}\n    _previous = score.copy()\n    median_vol = np.median([x["v20"] for x in series.values()])\n    high_risk = median_vol > .018 or breadth < .45\n    inv_avg = np.mean([1.0 / x["v20"] for x in series.values()])\n    raw = {}\n    for s in UNIVERSE:\n        x = series.get(s, {"v20": median_vol, "h60": 0.0, "h120": 0.0})\n        iv = (1.0 / x["v20"]) / max(inv_avg, 1e-12) if s in series else 1.0\n        raw[s] = max(score[s], .12) * (.90 + .10 * np.clip(iv, .65, 1.35))\n        if high_risk and s in DEFENSIVE:\n            raw[s] *= 2.0\n        # Do not chase weak momentum in an unstable regime; defensive assets remain eligible.\n        if high_risk and s not in DEFENSIVE and x["h60"] < -.08:\n            raw[s] *= .82\n    rebalance_to_weights(bounded(raw))\n', 'file_path': 'strategy.py'})
