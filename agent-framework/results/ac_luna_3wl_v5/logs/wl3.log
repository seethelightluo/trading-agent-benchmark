  ▶️ write_file({'content': 'import numpy as np\nfrom alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights\n\nUNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]\nDEFENSIVE = {"XAU", "US10Y", "CN10Y"}\nCADENCE = 10\nMIN_W, MAX_W = 0.035, 0.16\n# Screener ensemble: exact normalized weights, capped at ten active factors.\nWEIGHTS = {\n    "volstate": 0.14, "volume": 0.12, "intraday": 0.11,\n    "dispersion": 0.11, "stress": 0.10, "volscaled": 0.10,\n    "breadth_momentum": 0.10, "reversal10": 0.08,\n    "reversal15": 0.07, "macro_residual": 0.07,\n}\n_day = 0\n_previous = None\n\n\ndef rank_cs(vals):\n    out = {s: 0.5 for s in UNIVERSE}\n    good = [(s, float(v)) for s, v in vals.items() if np.isfinite(v)]\n    good.sort(key=lambda z: z[1])\n    n = len(good)\n    for i, (s, _) in enumerate(good):\n        out[s] = (i + 1.0) / n\n    return out\n\n\ndef bounded(raw):\n    w = {s: max(float(raw.get(s, 1.0)), 1e-12) for s in UNIVERSE}\n    fixed = set()\n    for _ in range(40):\n        free = [s for s in UNIVERSE if s not in fixed]\n        rem = 1.0 - sum(w[s] for s in fixed)\n        z = sum(w[s] for s in free)\n        for s in free:\n            w[s] = rem * w[s] / max(z, 1e-12)\n        hit = {s for s in free if w[s] < MIN_W or w[s] > MAX_W}\n        if not hit:\n            break\n        for s in hit:\n            w[s] = MIN_W if w[s] < MIN_W else MAX_W\n        fixed |= hit\n    z = sum(w.values())\n    return {s: w[s] / z for s in UNIVERSE}\n\n\n@register_hook\ndef cross_asset_strategy():\n    global _day, _previous\n    _day += 1\n    if _day != 1 and (_day - 1) % CADENCE != 0:\n        return\n\n    data = {}\n    for s in UNIVERSE:\n        df = get_stock_daily_data(symbol=s, days=270)\n        if df is None or len(df) < 160:\n            continue\n        df = df.sort_values("date")\n        c = np.asarray(df["close"], float)\n        o = np.asarray(df["open"], float)\n        hi = np.asarray(df["high"], float)\n        lo = np.asarray(df["low"], float)\n        if np.any(~np.isfinite(c)) or np.any(c <= 0):\n            continue\n        r = c[1:] / c[:-1] - 1.0\n        vol = np.nan_to_num(np.asarray(df["volume"], float), nan=0.0)\n        data[s] = {\n            "r": r, "h3": np.prod(1+r[-3:])-1, "h5": np.prod(1+r[-5:])-1,\n            "h10": np.prod(1+r[-10:])-1, "h15": np.prod(1+r[-15:])-1,\n            "h20": np.prod(1+r[-20:])-1, "h120": np.prod(1+r[-120:])-1,\n            "v5": max(np.std(r[-5:]), 0.006), "v20": max(np.std(r[-20:]), 0.006),\n            "v60": max(np.std(r[-60:]), 0.006),\n            "vr": np.mean(vol[-5:]) / max(np.mean(vol[-20:]), 1e-9),\n            "intra": np.nanmean((c[-5:] - o[-5:]) / np.maximum(o[-5:], 1e-12)),\n            "range": np.nanmean((hi[-5:] - lo[-5:]) / c[-5:]),\n        }\n    if len(data) < 10:\n        return\n\n    syms = list(data)\n    med = {k: np.median([data[s][k] for s in syms]) for k in ("h3", "h5", "h10", "h15", "h20")}\n    bench = data.get("SPX", {}).get("r", np.zeros(269))\n    factors = {k: {} for k in WEIGHTS}\n    for s in syms:\n        x = data[s]\n        scale = x["v20"] * np.sqrt(20) + 0.015\n        beta = np.cov(x["r"][-60:], bench[-60:])[0, 1] / max(np.var(bench[-60:]), 1e-8) if s != "SPX" else 1.0\n        resid = np.sum(x["r"][-10:] - beta * bench[-10:])\n        factors["volstate"][s] = (med["h5"] - x["h5"]) / scale * np.clip(x["v5"]/x["v60"], .6, 1.7)\n        factors["volume"][s] = (med["h3"] - x["h3"]) / (x["v5"] + .01) * np.clip(x["vr"], .5, 2.0)\n        factors["intraday"][s] = -x["intra"] / (x["v5"] + .01)\n        factors["dispersion"][s] = (med["h20"] - x["h20"]) / scale\n        factors["stress"][s] = (med["h10"] - x["h10"]) / (x["v20"]*np.sqrt(10) + .02)\n        factors["volscaled"][s] = (med["h5"] - x["h5"]) / (x["v20"] + .01)\n        factors["breadth_momentum"][s] = x["h20"] / (x["v20"]*np.sqrt(20) + .02)\n        factors["reversal10"][s] = (med["h10"] - x["h10"]) / (x["v20"]*np.sqrt(10) + .01)\n        factors["reversal15"][s] = (med["h15"] - x["h15"]) / (x["v20"]*np.sqrt(15) + .012)\n        factors["macro_residual"][s] = -resid / (x["v20"]*np.sqrt(10) + .015)\n\n    breadth = np.mean([data[s]["h120"] > 0 for s in syms])\n    ranks = {k: rank_cs(v) for k, v in factors.items()}\n    if breadth < 0.50:\n        ranks["breadth_momentum"] = {s: 0.5 for s in UNIVERSE}\n    score = {s: sum(WEIGHTS[k] * ranks[k].get(s, .5) for k in WEIGHTS) for s in UNIVERSE}\n    if _previous is not None:\n        score = {s: 0.5*score[s] + 0.5*_previous[s] for s in UNIVERSE}\n    _previous = score.copy()\n\n    high_risk = np.median([data[s]["v20"] for s in syms]) > 0.018 or breadth < 0.50\n    invmean = np.mean([1.0/data[s]["v20"] for s in syms])\n    raw = {}\n    for s in UNIVERSE:\n        x = data.get(s, {"v20": .02, "h120": 0.0})\n        invvol = (1.0/x["v20"]) / max(invmean, 1e-9) if s in data else 1.0\n        raw[s] = max(score[s], .12) * (.90 + .10*min(invvol, 1.25))\n        if high_risk and s in DEFENSIVE:\n            raw[s] *= 2.2\n        if high_risk and x["h120"] < -0.10:\n            raw[s] *= .75\n    rebalance_to_weights(bounded(raw))\n', 'file_path': 'strategy.py'})
