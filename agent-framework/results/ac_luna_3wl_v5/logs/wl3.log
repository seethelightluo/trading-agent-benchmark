        tilt = 1.20 if breadth < 0.40 and s in defensive else (0.90 if breadth < 0.40 else 1.0)
        raw[s] = max(score[s], 0.05) * tilt * (0.94 + 0.06 * min(iv, 2.0))
    rebalance_to_weights(bounded(raw))


