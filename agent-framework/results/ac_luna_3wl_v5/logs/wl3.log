  ▶️ write_file({'content': 'import numpy as np\nfrom alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights\n\nUNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]\nDEFENSIVE = {"XAU", "US10Y", "CN10Y"}\n# Screener ensemble, capped at eight active factors.\nFACTORS = {"mom120": .25, "disp_rev": .14, "rev5": .15, "volume_rev": .12,\n           "stress_rev": .12, "rev10": .12, "intraday_rev": .05, "vol_rev10": .05}\nCADENCE = 10\nMIN_W, MAX_W = .035, .16\n_day = 0\n_previous = None\n\n\ndef rank(x):\n    good = sorted((s, float(v)) for s, v in x.items() if np.isfinite(v))\n    out = {s: .5 for s in UNIVERSE}\n    for i, (s, _) in enumerate(good):\n        out[s] = (i + 1.) / len(good)\n    return out\n\n\ndef project(raw):\n    # Simple capped proportional projection; guarantees a complete long-only vector.\n    w = {s: max(float(raw.get(s, .1)), 1e-8) for s in UNIVERSE}\n    for _ in range(20):\n        total = sum(w.values())\n        w = {s: x / total for s, x in w.items()}\n        low = [s for s in UNIVERSE if w[s] < MIN_W]\n        high = [s for s in UNIVERSE if w[s] > MAX_W]\n        if not low and not high:\n            break\n        for s in low: w[s] = MIN_W\n        for s in high: w[s] = MAX_W\n        fixed = sum(w[s] for s in low + high)\n        free = [s for s in UNIVERSE if s not in set(low + high)]\n        if free:\n            rem = max(1. - fixed, 1e-8)\n            base = sum(max(raw.get(s, .1), 1e-8) for s in free)\n            for s in free: w[s] = rem * max(raw.get(s, .1), 1e-8) / base\n    z = sum(w.values())\n    return {s: w[s] / z for s in UNIVERSE}\n\n\n@register_hook\ndef cross_asset_strategy():\n    global _day, _previous\n    _day += 1\n    if _day != 1 and (_day - 1) % CADENCE:\n        return\n    data = {}\n    for s in UNIVERSE:\n        df = get_stock_daily_data(symbol=s, days=260)\n        if df is None or len(df) < 145: continue\n        df = df.sort_values("date")\n        c, o = np.asarray(df.close, float), np.asarray(df.open, float)\n        if np.any(~np.isfinite(c)) or np.any(c <= 0): continue\n        r = c[1:] / c[:-1] - 1.\n        v = np.asarray(df.volume, float) if "volume" in df else np.ones(len(c))\n        vol = max(float(np.std(r[-30:])), .006)\n        down = max(float(np.std(np.minimum(r[-40:], 0.))), .004)\n        data[s] = dict(r=r, vol=vol, down=down,\n            h5=float(np.prod(1+r[-5:])-1), h10=float(np.prod(1+r[-10:])-1),\n            h20=float(np.prod(1+r[-20:])-1), h120=float(np.prod(1+r[-120:])-1),\n            intra=float(np.nanmean((c[-5:]-o[-5:]) / np.maximum(o[-5:], 1e-12))),\n            vr=float(np.mean(v[-5:]) / max(np.mean(v[-20:]), 1e-9)),\n            vd=float(np.std(v[-20:]) / max(np.mean(v[-20:]), 1e-9)))\n    if len(data) < 10: return\n    syms = list(data); med5 = np.median([data[s][\'h5\'] for s in syms]); med10 = np.median([data[s][\'h10\'] for s in syms]); med20 = np.median([data[s][\'h20\'] for s in syms])\n    f = {k: {} for k in FACTORS}\n    for s in syms:\n        d = data[s]; scale5=d[\'vol\']*np.sqrt(5)+.01; scale10=d[\'vol\']*np.sqrt(10)+.01\n        f[\'mom120\'][s] = d[\'h120\']/(d[\'vol\']*np.sqrt(120)+.03)\n        f[\'rev5\'][s] = (med5-d[\'h5\'])/scale5\n        f[\'rev10\'][s] = (med10-d[\'h10\'])/scale10\n        # Relative dispersion and stress overlays are deliberately damped.\n        f[\'disp_rev\'][s] = (med20-d[\'h20\'])/(d[\'vol\']*np.sqrt(20)+.015)\n        f[\'stress_rev\'][s] = .65*(med20-d[\'h20\'])/(d[\'down\']*np.sqrt(20)+.02)\n        f[\'volume_rev\'][s] = f[\'rev5\'][s] * (.75 + .25*np.clip(d[\'vr\'], .5, 1.5))\n        f[\'intraday_rev\'][s] = -d[\'intra\']/(d[\'vol\']+.01)\n        f[\'vol_rev10\'][s] = f[\'rev10\'][s]/(1+8*d[\'vol\'])\n    rr = {k: rank(x) for k,x in f.items()}\n    score = {s: sum(FACTORS[k]*rr[k].get(s,.5) for k in FACTORS) for s in UNIVERSE}\n    if _previous is not None: score = {s:.35*score[s]+.65*_previous.get(s,.5) for s in UNIVERSE}\n    _previous = score.copy()\n    breadth = np.mean([data[s][\'h120\'] > 0 for s in syms]); medvol=np.median([data[s][\'vol\'] for s in syms])\n    high_risk = breadth < .50 or medvol > .018\n    invmean=np.mean([1/data[s][\'vol\'] for s in syms]); raw={}\n    for s in UNIVERSE:\n        d=data.get(s, {\'vol\':.02,\'h120\':0.})\n        inv=(1/d[\'vol\'])/max(invmean,1e-9)\n        raw[s]=max(score[s],.10)*(.88+.12*min(inv,1.25))\n        if high_risk and s in DEFENSIVE: raw[s]*=3.0\n        elif high_risk and d[\'h120\'] < -.10: raw[s]*=.60\n    target=project(raw)\n    if abs(sum(target.values())-1.) < 1e-8 and all(np.isfinite(x) and x>=0 for x in target.values()): rebalance_to_weights(target)\n', 'file_path': 'strategy.py'})
