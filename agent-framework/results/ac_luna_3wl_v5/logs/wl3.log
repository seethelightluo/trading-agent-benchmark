 import numpy as np
from alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights

UNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
FACTORS = {
    "lowvol_rev": 0.32, "volume_rev": 0.14, "residual_rev": 0.12,
    "stress_rev": 0.10, "clv_rev": 0.10, "peer_lead": 0.09,
    "momentum": 0.08, "smooth_rev": 0.05,
}
REBALANCE_EVERY = 10
MIN_WEIGHT, MAX_WEIGHT = 0.02, 0.14
_calls = 0


def ranks(values):
    good = sorted((s, float(v)) for s, v in values.items() if np.isfinite(v))
    out = {s: 0.5 for s in UNIVERSE}
    n = len(good)
    if n:
        for i, (s, _) in enumerate(good):
            out[s] = (i + 1.0) / n
    return out


def bounded(raw):
    # Water-fill bounds while retaining an exact, non-negative sum of one.
    w = {s: max(float(raw.get(s, 0.0)), 1e-9) for s in UNIVERSE}
    fixed, active = {}, set(UNIVERSE)
    for _ in range(40):
        left = 1.0 - sum(fixed.values())
        den = sum(w[s] for s in active)
        trial = {s: left * w[s] / den for s in active}
        clipped = False
        for s, x in list(trial.items()):
            if x < MIN_WEIGHT:
                fixed[s] = MIN_WEIGHT; active.remove(s); clipped = True
            elif x > MAX_WEIGHT:
                fixed[s] = MAX_WEIGHT; active.remove(s); clipped = True
        if not clipped:
            fixed.update(trial); break
    if active:
        left = 1.0 - sum(fixed.values())
        den = sum(w[s] for s in active)
        fixed.update({s: left * w[s] / den for s in active})
    z = sum(fixed.values())
    return {s: fixed[s] / z for s in UNIVERSE}


@register_hook
def cross_asset_strategy():
    global _calls
    _calls += 1
    if _calls != 1 and (_calls - 1) % REBALANCE_EVERY != 0:
        return
    raw = {k: {} for k in FACTORS}
    vol, r1, r5, r20 = {}, {}, {}, {}
    for s in UNIVERSE:
        df = get_stock_daily_data(symbol=s, days=100)
        if df is None or len(df) < 35:
            continue
        df = df.sort_values("date").reset_index(drop=True)
        c = np.asarray(df.close, float); o = np.asarray(df.open, float)
        h = np.asarray(df.high, float); l = np.asarray(df.low, float)
        if np.any(~np.isfinite(c[-35:])) or np.any(c[-35:] <= 0):
            continue
        dr = c[1:] / c[:-1] - 1.0
        v = max(float(np.std(dr[-20:])), 0.008)
        vol[s] = v; r1[s] = dr[-1]; r5[s] = c[-1] / c[-6] - 1.0; r20[s] = c[-1] / c[-21] - 1.0
        raw["lowvol_rev"][s] = -dr[-1] / v
        raw["smooth_rev"][s] = -float(np.mean(dr[-2:])) / v
        raw["momentum"][s] = r20[s] / (v * np.sqrt(20.0) + 0.01)
        span = h[-1] - l[-1]
        raw["clv_rev"][s] = -(c[-1] - o[-1]) / span if np.isfinite(span) and span > 0 else 0.0
        stress = np.clip(abs(dr[-1]) / v, 0.5, 2.0)
        raw["stress_rev"][s] = (-dr[-1] / v) * stress
        if "volume" in df.columns:
            vv = np.asarray(df.volume, float); med = np.nanmedian(vv[-21:])
            amp = vv[-1] / med if np.isfinite(vv[-1]) and vv[-1] > 0 and med > 0 else 1.0
            raw["volume_rev"][s] = (-dr[-1] / v) * np.clip(amp, 0.75, 1.5)
        else:
            raw["volume_rev"][s] = 0.0
    if len(vol) < 8:
        return
    median5 = float(np.median(list(r5.values())))
    median1 = float(np.median(list(r1.values())))
    for s in vol:
        raw["peer_lead"][s] = r5[s] - median5
        raw["residual_rev"][s] = -(r1[s] - median1) / vol[s]
    rr = {k: ranks(v) for k, v in raw.items()}
    score = {s: sum(FACTORS[k] * rr[k][s] for k in FACTORS) for s in UNIVERSE}
    breadth = np.mean([r20[s] > 0 for s in r20])
    market_vol = np.median(list(vol.values()))
    defensive = {"XAU", "US10Y", "CN10Y"}
    # Weak breadth and elevated dispersion favor defensive tradable assets, never cash.
    high_risk = market_vol > 0.018
    target = {}
    avg_inv = np.mean([1.0 / x for x in vol.values()])
    for s in UNIVERSE:
        inv = min((1.0 / vol.get(s, market_vol)) / avg_inv, 1.5)
        tilt = 1.12 if (breadth < 0.45 or high_risk) and s in defensive else 0.96 if (breadth < 0.45 or high_risk) else 1.0
        target[s] = max(score[s], 0.05) * (0.85 + 0.15 * inv) * tilt
    rebalance_to_weights(bounded(target))
