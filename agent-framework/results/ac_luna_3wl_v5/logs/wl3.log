  ▶️ write_file({'content': "import numpy as np, pandas as pd\nfrom scipy.stats import spearmanr\nfrom alphacrafter.sim.utils import get_stock_daily_data,get_index_daily_data\nU=['000300.SH','SPX','HSI','N225','SX5E','000688.SH','SOX','NDX','XAU','COPPER','WTI','BTC','ETH','US10Y','CN10Y']\nrows=[]\nfor s in U:\n d=get_stock_daily_data(s,2400)\n if d is None or len(d)<200: d=get_index_daily_data(s,2400)\n if d is not None and len(d):\n  x=d[['date','close']].drop_duplicates('date'); x['symbol']=s; rows.append(x)\np=pd.concat(rows); w=p.pivot(index='date',columns='symbol',values='close').sort_index().ffill(); r=w.pct_change()\n# Broad, interpretable downside-risk-adjusted trend. Reward 60d trend, penalize only\n# negative daily observations; all inputs are lagged one day at evaluation.\ndown=r.where(r<0,0.0)\ndownvol=down.rolling(40,min_periods=25).std()*np.sqrt(252)\ntrend=w.pct_change(60)\n# mild confirmation: positive 20d trend receives a 20% boost, negative trend a 20% penalty\nconfirm=np.where(w.pct_change(20)>0,1.2,0.8)\nf=(trend/(downvol+1e-8)*confirm).clip(-10,10)\n\ndef calc(h,a=None,b=None):\n fut=w.shift(-h)/w-1; vals=[]; ns=[]; idx=w.index\n if a: idx=idx[(idx>=a)&(idx<=b)]\n for dt in idx:\n  z=pd.concat([f.loc[dt],fut.loc[dt]],axis=1).dropna()\n  if len(z)>=8:\n   q=spearmanr(z.iloc[:,0],z.iloc[:,1]).statistic\n   if np.isfinite(q): vals.append(q); ns.append(len(z))\n q=pd.Series(vals); return len(q),q.mean(),q.std(ddof=1),q.mean()/q.std(ddof=1)*np.sqrt(len(q)),(q>0).mean(),np.mean(ns)\nprint('cutoff',w.index.max().date(),'dates',len(w),'instruments',len(w.columns))\nfor h in [1,3,5,10]: print('H',h,calc(h))\nfor a,b in [('2020-01-01','2022-12-31'),('2023-01-01','2024-12-31'),('2025-01-01','2027-03-24')]: print('REG',a,b,calc(1,a,b))\nprint('coverage',f.notna().mean().mean(),'rank_turnover',f.rank(axis=1,pct=True).diff().abs().mean(axis=1).mean())\nout=f.stack().rename('signal').reset_index(); out.columns=['date','symbol','signal']; out.to_csv('scripts/miner_2_20270325_downside_trend_signal.csv',index=False)\nprint('max_abs_library_correlation',None)\n", 'file_path': 'scripts/miner_2_20270325_downside_trend.py'})
