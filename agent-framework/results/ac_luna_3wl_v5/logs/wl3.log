  ▶️ write_file({'content': 'import numpy as np\nfrom alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights\n\nUNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]\n# Screener ensemble (2026-08-27), capped at five active factors.\nFACTOR_W = {"mom20": .25, "peer5": .22, "resid40": .20, "conditional": .18, "volume_rev": .15}\nREBALANCE_DAYS = 10\nMIN_W, MAX_W = .03, .15\n_day = 0\n_last_score = None\n\n\ndef rank_cs(x):\n    good = sorted((s, v) for s, v in x.items() if np.isfinite(v))\n    out = {s: .5 for s in UNIVERSE}\n    n = len(good)\n    if n:\n        for i, (s, _) in enumerate(good):\n            out[s] = (i + 1.) / n\n    return out\n\n\ndef ret(r, n):\n    return float(np.prod(1. + r[-n:]) - 1.) if len(r) >= n else np.nan\n\n\ndef bounded_weights(raw):\n    # Iterative capped-simplex projection; preserves full investment and all assets.\n    active = set(UNIVERSE); fixed = {}; base = {s: max(float(raw.get(s, .1)), 1e-8) for s in UNIVERSE}\n    for _ in range(30):\n        left = 1. - sum(fixed.values()); den = sum(base[s] for s in active)\n        trial = {s: left * base[s] / den for s in active}\n        clipped = False\n        for s, v in list(trial.items()):\n            if v < MIN_W: fixed[s] = MIN_W; active.remove(s); clipped = True\n            elif v > MAX_W: fixed[s] = MAX_W; active.remove(s); clipped = True\n        if not clipped:\n            fixed.update(trial); break\n    z = sum(fixed.values())\n    return {s: fixed.get(s, 0.) / z for s in UNIVERSE}\n\n\n@register_hook\ndef cross_asset_strategy():\n    global _day, _last_score\n    _day += 1\n    if _day != 1 and (_day - 1) % REBALANCE_DAYS:\n        return\n\n    data, rets, vols = {}, {}, {}\n    for s in UNIVERSE:\n        df = get_stock_daily_data(symbol=s, days=230)\n        if df is None or len(df) < 70:\n            continue\n        df = df.sort_values("date")\n        c = np.asarray(df["close"], dtype=float)\n        if np.any(~np.isfinite(c[-70:])) or np.any(c[-70:] <= 0):\n            continue\n        data[s] = df; rets[s] = c[1:] / c[:-1] - 1.\n        vols[s] = max(float(np.std(rets[s][-20:])), .006)\n    if len(rets) < 10:\n        return\n\n    r5 = {s: ret(r, 5) for s, r in rets.items()}\n    r20 = {s: ret(r, 20) for s, r in rets.items()}\n    r40 = {s: ret(r, 40) for s, r in rets.items()}\n    equity = {s for s in UNIVERSE[:8] if s in rets}\n    med5 = float(np.median(list(r5.values())))\n    med40eq = float(np.median([r40[s] for s in equity])) if equity else float(np.median(list(r40.values())))\n    breadth = float(np.mean([v > 0 for v in r5.values()]))\n    stress = med5 < 0 or breadth < .45 or float(np.median(list(vols.values()))) > .018\n\n    f = {k: {} for k in FACTOR_W}\n    for s, r in rets.items():\n        v = vols[s]\n        # Risk-adjusted 20-day momentum, volatility window is the available trailing 60 days.\n        f["mom20"][s] = r20[s] / (max(float(np.std(r[-60:])), .006) * np.sqrt(20.) + .01)\n        # Leave-one-out peer-median five-day lead/lag signal.\n        peers = [r5[t] for t in rets if t != s]\n        f["peer5"][s] = float(np.median(peers)) if peers else r5[s]\n        # Slow equity-relative residual proxy.\n        f["resid40"][s] = (r40[s] - med40eq) / (v * np.sqrt(40.) + .02)\n        r3 = ret(r, 3)\n        med3 = float(np.median([ret(rets[t], 3) for t in rets]))\n        f["conditional"][s] = (-(r3 - med3) if stress else r3) / (v * np.sqrt(3.) + .012)\n        vol = np.asarray(data[s]["volume"], dtype=float) if "volume" in data[s] else np.array([])\n        vz = 0.\n        if len(vol) >= 20 and np.all(np.isfinite(vol[-20:])) and np.all(vol[-20:] > 0):\n            lv = np.log(vol[-20:]); vz = np.clip((lv[-1] - np.mean(lv)) / (np.std(lv) + 1e-9), -1., 2.)\n        f["volume_rev"][s] = -r[-1] * (1. + .5 * vz)\n\n    ranked = {k: rank_cs(v) for k, v in f.items()}\n    scores = {s: sum(FACTOR_W[k] * ranked[k].get(s, .5) for k in FACTOR_W) for s in rets}\n    if _last_score is not None:\n        for s in scores:\n            scores[s] = .65 * scores[s] + .35 * _last_score.get(s, scores[s])\n    _last_score = scores.copy()\n\n    mean_inv = np.mean([1. / v for v in vols.values()])\n    defensive = {"XAU", "US10Y", "CN10Y"}\n    raw = {}\n    for s in UNIVERSE:\n        inv = min((1. / vols.get(s, .02)) / mean_inv, 1.25)\n        raw[s] = max(scores.get(s, .5), .05) * (.88 + .12 * inv)\n        if stress and s in defensive:\n            raw[s] *= 1.35\n    target = bounded_weights(raw)\n    if set(target) == set(UNIVERSE) and all(np.isfinite(v) and v >= 0 for v in target.values()) and abs(sum(target.values()) - 1.) < 1e-8:\n        rebalance_to_weights(target)\n', 'file_path': 'strategy.py'})
