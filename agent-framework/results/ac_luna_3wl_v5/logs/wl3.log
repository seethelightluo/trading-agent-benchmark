 import numpy as np
from alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights

UNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
# Screener 2027-05-06 ensemble; nine active factors, all positive direction.
FACTORS = {"rev3": .24, "volstate3": .16, "lowvol1": .14, "medium10": .12,
           "conditional15": .10, "dispersion3": .08, "leadlag5": .08,
           "trend10": .05, "skip120": .03}
CADENCE = 10
MIN_W, MAX_W = .03, .15
_previous = None
_day = 0


def _rank(vals):
    good = sorted((s, float(v)) for s, v in vals.items() if np.isfinite(v))
    out = {s: .5 for s in UNIVERSE}
    if not good:
        return out
    for i, (s, _) in enumerate(good):
        out[s] = (i + 1.0) / len(good)
    return out


def _bounded(raw):
    # Water-filling bounds preserve a complete, long-only, fully invested target.
    fixed, active = {}, set(UNIVERSE)
    for _ in range(50):
        left = 1.0 - sum(fixed.values())
        den = sum(max(float(raw.get(s, .01)), 1e-9) for s in active)
        trial = {s: left * max(float(raw.get(s, .01)), 1e-9) / den for s in active}
        changed = False
        for s, w in list(trial.items()):
            if w < MIN_W:
                fixed[s] = MIN_W; active.remove(s); changed = True
            elif w > MAX_W:
                fixed[s] = MAX_W; active.remove(s); changed = True
        if not changed:
            fixed.update(trial); break
    total = sum(fixed.values())
    return {s: fixed.get(s, 0.0) / total for s in UNIVERSE}


@register_hook
def cross_asset_strategy():
    global _day, _previous
    _day += 1
    if _day != 1 and (_day - 1) % CADENCE != 0:
        return

    returns, vols = {}, {}
    for s in UNIVERSE:
        df = get_stock_daily_data(symbol=s, days=240)
        if df is None or len(df) < 130:
            continue
        close = np.asarray(df.sort_values("date")["close"], dtype=float)
        if np.any(~np.isfinite(close)) or np.any(close <= 0):
            continue
        r = close[1:] / close[:-1] - 1.0
        returns[s] = r
        vols[s] = max(float(np.std(r[-20:])), .006)
    if len(returns) < 10:
        return

    def cum(r, n):
        return float(np.prod(1.0 + r[-n:]) - 1.0)
    hs = {n: {s: cum(r, n) for s, r in returns.items()} for n in (1, 3, 5, 10, 15, 20, 40)}
    symbols = list(returns)
    dispersion = float(np.std([hs[3][s] for s in symbols]))
    fac = {k: {} for k in FACTORS}
    for s in symbols:
        v = vols[s]
        peer3 = np.median([hs[3][t] for t in symbols if t != s])
        peer5 = np.median([hs[5][t] for t in symbols if t != s])
        peer15 = np.median([hs[15][t] for t in symbols if t != s])
        scaled_rev3 = -hs[3][s] / (v * np.sqrt(3) + .01)
        fac["rev3"][s] = scaled_rev3
        fac["volstate3"][s] = scaled_rev3 * (1.0 + min(v / .02, 1.0))
        fac["lowvol1"][s] = -hs[1][s] / (v + .006) / (1.0 + 2.0 * v)
        fac["medium10"][s] = -hs[10][s] / (v * np.sqrt(10) + .01)
        fac["conditional15"][s] = (-hs[15][s] / (v * np.sqrt(15) + .01)) if peer15 < 0 else 0.0
        fac["dispersion3"][s] = (peer3 - hs[3][s]) / (v * np.sqrt(3) + .01) * min(dispersion / .025, 1.0)
        fac["leadlag5"][s] = peer5 / (v * np.sqrt(5) + .01)
        fac["trend10"][s] = hs[10][s] / (v * np.sqrt(10) + .01)
        # 120d skip momentum: exclude the most recent 15 sessions.
        fac["skip120"][s] = np.prod(1.0 + returns[s][-135:-15]) - 1.0

    score = {s: sum(w * _rank(fac[k])[s] for k, w in FACTORS.items()) for s in UNIVERSE}
    if _previous is not None:
        score = {s: .50 * score[s] + .50 * _previous.get(s, .5) for s in UNIVERSE}
    _previous = score.copy()

    breadth = np.mean([hs[20][s] > 0 for s in symbols])
    stress = breadth < .50 or np.median(list(hs[10].values())) < 0 or np.median(list(vols.values())) > .018
    defensive = {"XAU", "US10Y", "CN10Y"}
    mean_iv = np.mean([1.0 / v for v in vols.values()])
    raw = {}
    for s in UNIVERSE:
        iv = (1.0 / vols.get(s, .02)) / mean_iv
        raw[s] = max(score[s], .05) * (.90 + .10 * min(iv, 1.20))
        if stress and s in defensive:
            raw[s] *= 2.10
        elif stress and hs[20].get(s, 0.0) < -.08:
            raw[s] *= .70
    target = _bounded(raw)
    if all(np.isfinite(target[s]) for s in UNIVERSE) and abs(sum(target.values()) - 1.0) < 1e-8:
        rebalance_to_weights(target)


