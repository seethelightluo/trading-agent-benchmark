import numpy as np
from alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights

UNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
DEFENSIVE = {"XAU", "US10Y", "CN10Y"}
CADENCE = 10
MIN_W, MAX_W = 0.04, 0.18
# Screener ensemble: six active factors, all positive direction.
FACTORS = ("failure", "volstate", "dispersion", "residual", "breakout", "consistency")
FACTOR_W = (0.24, 0.22, 0.18, 0.14, 0.12, 0.10)
_day = 0
_previous = None


def rank_cs(vals):
    good = sorted((s, float(v)) for s, v in vals.items() if np.isfinite(v))
    out = {s: 0.5 for s in UNIVERSE}
    for i, (s, _) in enumerate(good):
        out[s] = (i + 1.0) / max(1, len(good))
    return out


def bounded(raw):
    # Iterative projection to a complete, long-only, full-investment vector.
    w = {s: max(float(raw.get(s, 0.0)), 1e-12) for s in UNIVERSE}
    fixed = {}
    for _ in range(30):
        free = [s for s in UNIVERSE if s not in fixed]
        left = 1.0 - sum(fixed.values())
        z = sum(w[s] for s in free)
        for s in free:
            w[s] = left * w[s] / max(z, 1e-12)
        hit = [s for s in free if w[s] < MIN_W or w[s] > MAX_W]
        if not hit:
            break
        for s in hit:
            fixed[s] = MIN_W if w[s] < MIN_W else MAX_W
            w[s] = fixed[s]
    z = sum(w.values())
    return {s: w[s] / max(z, 1e-12) for s in UNIVERSE}


@register_hook
def cross_asset_strategy():
    global _day, _previous
    _day += 1
    if _day != 1 and (_day - 1) % CADENCE != 0:
        return

    feat, returns = {}, {}
    for s in UNIVERSE:
        df = get_stock_daily_data(symbol=s, days=200)
        if df is None or len(df) < 135:
            continue
        close = np.asarray(df.sort_values("date")["close"], dtype=float)[:-1]
        if len(close) < 125 or np.any(~np.isfinite(close)) or np.any(close <= 0):
            continue
        r = close[1:] / close[:-1] - 1.0
        vol = max(float(np.std(r[-20:])), 0.006)
        down = max(float(np.sqrt(np.mean(np.minimum(r[-20:], 0.0) ** 2))), 0.006)
        h60, h120 = max(close[-61:]), max(close[-121:])
        r3 = np.prod(1 + r[-3:]) - 1
        r5 = np.prod(1 + r[-5:]) - 1
        r20 = np.prod(1 + r[-20:]) - 1
        r30 = np.prod(1 + r[-30:]) - 1
        feat[s] = {
            "failure": np.clip(-r5 / vol, -3, 3),
            "volstate": np.clip(-r3 / vol, -3, 3),
            "dispersion": np.clip(-r5 / (vol * np.sqrt(5)), -3, 3),
            "residual": np.clip(r20 / max(vol * np.sqrt(20), .01), -3, 3),
            "breakout": np.clip((close[-1] / h120 - 1) / max(vol * np.sqrt(120), .01), -3, 3),
            "consistency": np.clip(r30 / max(vol * np.sqrt(30), .01) * (.5 + np.mean(r[-30:] > 0)), -3, 3),
            "vol": vol,
        }
        returns[s] = r

    if len(feat) < 10:
        return
    market = returns.get("SPX")
    if market is not None:
        for s, r in returns.items():
            n = min(60, len(r), len(market))
            if n >= 30:
                beta = np.cov(r[-n:], market[-n:], ddof=1)[0, 1] / max(np.var(market[-n:], ddof=1), 1e-8)
                m20 = np.prod(1 + market[-20:]) - 1
                feat[s]["residual"] = np.clip(feat[s]["residual"] - beta * m20 / max(feat[s]["vol"], .006), -3, 3)

    ranks = {f: rank_cs({s: feat[s][f] for s in feat}) for f in FACTORS}
    score = {s: sum(FACTOR_W[i] * ranks[FACTORS[i]][s] for i in range(len(FACTORS))) for s in UNIVERSE}
    if _previous is not None:
        score = {s: .70 * score[s] + .30 * _previous[s] for s in UNIVERSE}
    _previous = score.copy()

    medvol = float(np.median([x["vol"] for x in feat.values()]))
    breadth = float(np.mean([x["breakout"] > 0 for x in feat.values()]))
    stressed = medvol > .018 or breadth < .40
    invmean = float(np.mean([1 / x["vol"] for x in feat.values()]))
    raw = {}
    for s in UNIVERSE:
        x = feat.get(s, {"vol": medvol, "breakout": 0})
        invdamp = np.clip((1 / x["vol"]) / max(invmean, 1e-12), .78, 1.12)
        raw[s] = max(score[s], .06) * (.90 + .10 * invdamp)
        if stressed:
            raw[s] *= 1.35 if s in DEFENSIVE else (.82 if x["breakout"] < 0 else .74)
    target = bounded(raw)
    if all(np.isfinite(target[s]) for s in UNIVERSE) and abs(sum(target.values()) - 1) < 1e-8:
        rebalance_to_weights(target)


