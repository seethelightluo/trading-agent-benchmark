import numpy as np
from alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights

UNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
# Current Screener ensemble: no more than 10 active factors.
FACTORS = {"clv": .215, "peer": .165, "volume": .145, "mom": .125,
           "blend": .148, "rev3": .075, "rev5": .127}
MIN_W, MAX_W, CADENCE = .02, .14, 10
_day = 0

def ranks(x):
    good = [(s, v) for s, v in x.items() if np.isfinite(v)]
    out = {s: .5 for s in UNIVERSE}
    if not good: return out
    good.sort(key=lambda z: z[1])
    for i, (s, _) in enumerate(good): out[s] = (i + 1.) / len(good)
    return out

def bounded(raw):
    # Simple bounded simplex projection; preserves a complete 15-asset target.
    w = {s: max(float(raw.get(s, 0.1)), 1e-12) for s in UNIVERSE}
    fixed = {}
    active = set(UNIVERSE)
    for _ in range(30):
        remain = 1.0 - sum(fixed.values())
        z = sum(w[s] for s in active)
        trial = {s: remain*w[s]/z for s in active}
        clipped = False
        for s, x in list(trial.items()):
            if x < MIN_W:
                fixed[s] = MIN_W; active.remove(s); clipped = True
            elif x > MAX_W:
                fixed[s] = MAX_W; active.remove(s); clipped = True
        if not clipped:
            fixed.update(trial); break
    total = sum(fixed.values())
    return {s: fixed.get(s, 0.0)/total for s in UNIVERSE}

@register_hook
def cross_asset_strategy():
    global _day
    _day += 1
    if _day != 1 and (_day - 1) % CADENCE != 0: return
    returns, vol, raw = {}, {}, {k: {} for k in FACTORS}
    for s in UNIVERSE:
        df = get_stock_daily_data(symbol=s, days=150)
        if df is None or len(df) < 35: continue
        df = df.sort_values("date").reset_index(drop=True)
        try:
            c = np.asarray(df.close, float); o = np.asarray(df.open, float)
            h = np.asarray(df.high, float); l = np.asarray(df.low, float)
            volume = np.asarray(df.volume, float)
        except Exception: continue
        if len(c) < 35 or np.any(~np.isfinite(c[-35:])) or np.any(c[-35:] <= 0): continue
        r = c[1:]/c[:-1]-1
        sig = max(float(np.nanstd(r[-20:])), .008)
        returns[s], vol[s] = r, sig
        # Positive CLV is buying pressure; use the Screener direction (+1).
        span = h[-1]-l[-1]
        raw["clv"][s] = (2*c[-1]-h[-1]-l[-1])/span if span > 0 else 0.
        raw["mom"][s] = (c[-1]/c[-21]-1)/(sig*np.sqrt(20)+.01)
        med = np.nanmedian(volume[-21:-1])
        boost = np.clip(volume[-1]/med, .75, 1.75) if np.isfinite(med) and med > 0 else 1.
        raw["volume"][s] = (-r[-1]/sig)*(1+.35*max(boost-1, 0))
        raw["rev3"][s] = -(np.prod(1+r[-3:])-1)/(sig*np.sqrt(3)+.005)
        raw["rev5"][s] = -(np.prod(1+r[-5:])-1)/(sig*np.sqrt(5)+.005)
    if len(returns) < 8: return
    def cum(x, n): return float(np.prod(1+x[-n:])-1)
    med5 = float(np.median([cum(x, 5) for x in returns.values()]))
    for s, r in returns.items():
        others = [cum(returns[t], 5) for t in returns if t != s]
        # Lead-lag proxy: assets outperforming their leave-one-out peer median.
        raw["peer"][s] = cum(r, 5)-float(np.median(others))
        # Conditional blend: reversal in stress, momentum in calm conditions.
        raw["blend"][s] = raw["rev3"][s] if med5 < 0 else raw["mom"][s]
    rr = {k: ranks(v) for k, v in raw.items()}
    score = {s: sum(FACTORS[k]*rr[k][s] for k in FACTORS) for s in UNIVERSE}
    medvol = float(np.median(list(vol.values())))
    breadth = float(np.mean([cum(r, 20) > 0 for r in returns.values()]))
    stress = medvol > .018 or breadth < .45
    invavg = float(np.mean([1/x for x in vol.values()]))
    defensives = {"XAU", "US10Y", "CN10Y"}
    raw_target = {}
    for s in UNIVERSE:
        damp = min((1/vol.get(s, medvol))/invavg, 1.5)
        raw_target[s] = max(score[s], .05)*(.85+.15*damp)
        if stress and s in defensives: raw_target[s] *= 1.15
    rebalance_to_weights(bounded(raw_target))

