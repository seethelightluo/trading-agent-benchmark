  ▶️ write_file({'content': 'import numpy as np\nfrom alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights\n\nUNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]\n# Screener 2027-05-06 ensemble; nine active factors, all positive direction.\nFACTORS = {"rev3": .24, "volstate3": .16, "lowvol1": .14, "medium10": .12,\n           "conditional15": .10, "dispersion3": .08, "leadlag5": .08,\n           "trend10": .05, "skip120": .03}\nCADENCE = 10\nMIN_W, MAX_W = .03, .15\n_previous = None\n_day = 0\n\n\ndef _rank(vals):\n    good = sorted((s, float(v)) for s, v in vals.items() if np.isfinite(v))\n    out = {s: .5 for s in UNIVERSE}\n    if not good:\n        return out\n    for i, (s, _) in enumerate(good):\n        out[s] = (i + 1.0) / len(good)\n    return out\n\n\ndef _bounded(raw):\n    # Water-filling bounds preserve a complete, long-only, fully invested target.\n    fixed, active = {}, set(UNIVERSE)\n    for _ in range(50):\n        left = 1.0 - sum(fixed.values())\n        den = sum(max(float(raw.get(s, .01)), 1e-9) for s in active)\n        trial = {s: left * max(float(raw.get(s, .01)), 1e-9) / den for s in active}\n        changed = False\n        for s, w in list(trial.items()):\n            if w < MIN_W:\n                fixed[s] = MIN_W; active.remove(s); changed = True\n            elif w > MAX_W:\n                fixed[s] = MAX_W; active.remove(s); changed = True\n        if not changed:\n            fixed.update(trial); break\n    total = sum(fixed.values())\n    return {s: fixed.get(s, 0.0) / total for s in UNIVERSE}\n\n\n@register_hook\ndef cross_asset_strategy():\n    global _day, _previous\n    _day += 1\n    if _day != 1 and (_day - 1) % CADENCE != 0:\n        return\n\n    returns, vols = {}, {}\n    for s in UNIVERSE:\n        df = get_stock_daily_data(symbol=s, days=240)\n        if df is None or len(df) < 130:\n            continue\n        close = np.asarray(df.sort_values("date")["close"], dtype=float)\n        if np.any(~np.isfinite(close)) or np.any(close <= 0):\n            continue\n        r = close[1:] / close[:-1] - 1.0\n        returns[s] = r\n        vols[s] = max(float(np.std(r[-20:])), .006)\n    if len(returns) < 10:\n        return\n\n    def cum(r, n):\n        return float(np.prod(1.0 + r[-n:]) - 1.0)\n    hs = {n: {s: cum(r, n) for s, r in returns.items()} for n in (1, 3, 5, 10, 15, 20, 40)}\n    symbols = list(returns)\n    dispersion = float(np.std([hs[3][s] for s in symbols]))\n    fac = {k: {} for k in FACTORS}\n    for s in symbols:\n        v = vols[s]\n        peer3 = np.median([hs[3][t] for t in symbols if t != s])\n        peer5 = np.median([hs[5][t] for t in symbols if t != s])\n        peer15 = np.median([hs[15][t] for t in symbols if t != s])\n        scaled_rev3 = -hs[3][s] / (v * np.sqrt(3) + .01)\n        fac["rev3"][s] = scaled_rev3\n        fac["volstate3"][s] = scaled_rev3 * (1.0 + min(v / .02, 1.0))\n        fac["lowvol1"][s] = -hs[1][s] / (v + .006) / (1.0 + 2.0 * v)\n        fac["medium10"][s] = -hs[10][s] / (v * np.sqrt(10) + .01)\n        fac["conditional15"][s] = (-hs[15][s] / (v * np.sqrt(15) + .01)) if peer15 < 0 else 0.0\n        fac["dispersion3"][s] = (peer3 - hs[3][s]) / (v * np.sqrt(3) + .01) * min(dispersion / .025, 1.0)\n        fac["leadlag5"][s] = peer5 / (v * np.sqrt(5) + .01)\n        fac["trend10"][s] = hs[10][s] / (v * np.sqrt(10) + .01)\n        # 120d skip momentum: exclude the most recent 15 sessions.\n        fac["skip120"][s] = np.prod(1.0 + returns[s][-135:-15]) - 1.0\n\n    score = {s: sum(w * _rank(fac[k])[s] for k, w in FACTORS.items()) for s in UNIVERSE}\n    if _previous is not None:\n        score = {s: .50 * score[s] + .50 * _previous.get(s, .5) for s in UNIVERSE}\n    _previous = score.copy()\n\n    breadth = np.mean([hs[20][s] > 0 for s in symbols])\n    stress = breadth < .50 or np.median(list(hs[10].values())) < 0 or np.median(list(vols.values())) > .018\n    defensive = {"XAU", "US10Y", "CN10Y"}\n    mean_iv = np.mean([1.0 / v for v in vols.values()])\n    raw = {}\n    for s in UNIVERSE:\n        iv = (1.0 / vols.get(s, .02)) / mean_iv\n        raw[s] = max(score[s], .05) * (.90 + .10 * min(iv, 1.20))\n        if stress and s in defensive:\n            raw[s] *= 2.10\n        elif stress and hs[20].get(s, 0.0) < -.08:\n            raw[s] *= .70\n    target = _bounded(raw)\n    if all(np.isfinite(target[s]) for s in UNIVERSE) and abs(sum(target.values()) - 1.0) < 1e-8:\n        rebalance_to_weights(target)\n', 'file_path': 'strategy.py'})
