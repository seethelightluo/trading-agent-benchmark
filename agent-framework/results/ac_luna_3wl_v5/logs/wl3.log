  ▶️ write_file({'content': 'import numpy as np\nfrom alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights\n\nUNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]\nDEFENSIVE = {"XAU", "US10Y", "CN10Y"}\nRISKY = {"COPPER", "WTI", "BTC", "ETH"}\nCADENCE, MIN_W, MAX_W = 10, 0.04, 0.18\nFACTORS = ("consistency", "breakout120", "residual", "downside_mom", "short_breakout", "failure", "volstate", "dispersion")\nFACTOR_W = (0.25, 0.22, 0.17, 0.12, 0.10, 0.08, 0.03, 0.03)\n_day = 0\n_previous = None\n\ndef rank_factor(values):\n    valid = sorted((s, float(v)) for s, v in values.items() if np.isfinite(v))\n    out = {s: 0.5 for s in UNIVERSE}\n    for i, (s, _) in enumerate(valid):\n        out[s] = (i + 1.0) / max(len(valid), 1)\n    return out\n\ndef project(raw):\n    # Full investment with 4%-18% per-asset bounds.\n    w = {s: max(float(raw.get(s, 0.05)), 1e-12) for s in UNIVERSE}\n    fixed = {}\n    for _ in range(60):\n        free = [s for s in UNIVERSE if s not in fixed]\n        left = 1.0 - sum(fixed.values())\n        z = sum(w[s] for s in free)\n        for s in free:\n            w[s] = left * w[s] / max(z, 1e-12)\n        hits = [s for s in free if w[s] < MIN_W or w[s] > MAX_W]\n        if not hits:\n            break\n        for s in hits:\n            fixed[s] = MIN_W if w[s] < MIN_W else MAX_W\n            w[s] = fixed[s]\n    z = sum(w.values())\n    return {s: w[s] / max(z, 1e-12) for s in UNIVERSE}\n\n@register_hook\ndef cross_asset_strategy():\n    global _day, _previous\n    _day += 1\n    if _day != 1 and (_day - 1) % CADENCE:\n        return\n    feat, rets = {}, {}\n    for s in UNIVERSE:\n        df = get_stock_daily_data(symbol=s, days=210)\n        if df is None or len(df) < 140:\n            continue\n        close = np.asarray(df.sort_values("date")["close"], dtype=float)[:-1]\n        if len(close) < 125 or np.any(~np.isfinite(close)) or np.any(close <= 0):\n            continue\n        r = close[1:] / close[:-1] - 1.0\n        v20, v60 = max(np.std(r[-20:]), .006), max(np.std(r[-60:]), .006)\n        r3 = np.prod(1+r[-3:])-1\n        r5 = np.prod(1+r[-5:])-1\n        r20 = np.prod(1+r[-20:])-1\n        r60 = np.prod(1+r[-60:])-1\n        down = max(np.std(np.minimum(r[-60:], 0)), .004)\n        feat[s] = {\n            "consistency": np.clip(np.mean(r[-60:] > 0) * (.5 + np.mean(r[-60:])) / v60, -3, 3),\n            "breakout120": np.clip(close[-1] / max(close[-121:-1]) - 1, -3, 3),\n            "residual": np.clip(r20/(v20*np.sqrt(20)), -3, 3),\n            "downside_mom": np.clip(r20/(down*np.sqrt(20)), -3, 3),\n            "short_breakout": np.clip(close[-1] / max(close[-21:-1]) - 1, -3, 3),\n            "failure": np.clip(-r5/v20, -3, 3),\n            "volstate": np.clip(-r3/v20, -3, 3),\n            "vol": v20,\n        }\n        rets[s] = r\n    if len(feat) < 10:\n        return\n    bm = rets.get("SPX")\n    if bm is not None:\n        for s, r in rets.items():\n            n = min(60, len(r), len(bm))\n            if n >= 30:\n                beta = np.cov(r[-n:], bm[-n:], ddof=1)[0, 1] / max(np.var(bm[-n:], ddof=1), 1e-8)\n                feat[s]["residual"] = np.clip(feat[s]["residual"] - beta * (np.prod(1+bm[-20:])-1), -3, 3)\n    med20 = np.median([np.prod(1+rets[s][-20:])-1 for s in feat])\n    for s in feat:\n        feat[s]["dispersion"] = np.clip(-(np.prod(1+rets[s][-20:])-1-med20) / max(feat[s]["vol"]*np.sqrt(20), .01), -3, 3)\n    ranked = {f: rank_factor({s: feat[s][f] for s in feat}) for f in FACTORS}\n    score = {s: sum(FACTOR_W[i] * ranked[FACTORS[i]][s] for i in range(len(FACTORS))) for s in UNIVERSE}\n    if _previous is not None:\n        score = {s: .70 * score[s] + .30 * _previous[s] for s in UNIVERSE}\n    _previous = score.copy()\n    medvol = float(np.median([x["vol"] for x in feat.values()]))\n    breadth = float(np.mean([x["breakout120"] > 0 for x in feat.values()]))\n    stressed = medvol > .015 or breadth < .45\n    mean_inv = np.mean([1/x["vol"] for x in feat.values()])\n    raw = {}\n    for s in UNIVERSE:\n        x = feat.get(s, {"vol": medvol})\n        damp = np.clip((1/max(x["vol"], .006))/max(mean_inv, 1e-12), .78, 1.10)\n        raw[s] = max(score[s], .05) * (.88 + .12*damp)\n        if stressed:\n            raw[s] *= 1.75 if s in DEFENSIVE else (.50 if s in RISKY else .86)\n        elif s in RISKY:\n            raw[s] *= .90\n    target = project(raw)\n    if all(np.isfinite(v) and v >= 0 for v in target.values()) and abs(sum(target.values()) - 1.0) < 1e-8:\n        rebalance_to_weights(target)\n', 'file_path': 'strategy.py'})
