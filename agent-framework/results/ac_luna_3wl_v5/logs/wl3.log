 import numpy as np
from alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights

UNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
# Current screener ensemble (9 active factors; all supplied directions are +1).
FACTORS = {
    "volstate": .22, "lowvol": .16, "medium": .12, "leadlag": .12,
    "dispersion": .10, "conditional": .10, "idio": .08,
    "skipmom": .06, "eqresid": .04
}
CADENCE = 10
MIN_W, MAX_W = .03, .15
_previous = None
_day = 0


def _rank(vals):
    valid = sorted((s, float(v)) for s, v in vals.items() if np.isfinite(v))
    out = {s: .5 for s in UNIVERSE}
    for i, (s, _) in enumerate(valid):
        out[s] = (i + 1.0) / len(valid)
    return out


def _bounded(raw):
    # Iterative water-filling: always emits all 15 assets, long-only, sum exactly 1.
    fixed, active = {}, set(UNIVERSE)
    for _ in range(50):
        left = 1.0 - sum(fixed.values())
        den = sum(max(float(raw.get(s, .01)), 1e-9) for s in active)
        trial = {s: left * max(float(raw.get(s, .01)), 1e-9) / den for s in active}
        changed = False
        for s, w in list(trial.items()):
            if w < MIN_W:
                fixed[s] = MIN_W; active.remove(s); changed = True
            elif w > MAX_W:
                fixed[s] = MAX_W; active.remove(s); changed = True
        if not changed:
            fixed.update(trial); break
    total = sum(fixed.values())
    return {s: fixed.get(s, 0.0) / total for s in UNIVERSE}


@register_hook
def cross_asset_strategy():
    global _day, _previous
    _day += 1
    if _day != 1 and (_day - 1) % CADENCE != 0:
        return

    rets, vols, lastbar = {}, {}, {}
    for s in UNIVERSE:
        df = get_stock_daily_data(symbol=s, days=240)
        if df is None or len(df) < 130:
            continue
        df = df.sort_values("date")
        close = np.asarray(df["close"], dtype=float)
        if np.any(~np.isfinite(close)) or np.any(close <= 0):
            continue
        r = close[1:] / close[:-1] - 1.0
        rets[s] = r
        vols[s] = max(float(np.std(r[-20:])), .006)
        lastbar[s] = df.iloc[-1]
    if len(rets) < 10:
        return

    def cum(r, n):
        return float(np.prod(1.0 + r[-n:]) - 1.0)
    symbols = list(rets)
    r1 = {s: rets[s][-1] for s in symbols}
    horizons = {n: {s: cum(rets[s], n) for s in symbols} for n in (3, 5, 10, 15, 20, 40)}
    # Skip momentum uses only the 90-day window ending 15 sessions before today.
    skip = {s: float(np.prod(1.0 + rets[s][-105:-15]) - 1.0) for s in symbols}
    eq = [s for s in UNIVERSE[:8] if s in rets]
    eqmed = float(np.median([horizons[40][s] for s in eq]))
    fac = {k: {} for k in FACTORS}
    dispersion = float(np.std([horizons[5][s] for s in symbols]))
    for s in symbols:
        v = vols[s]
        peer5 = np.median([horizons[5][t] for t in symbols if t != s])
        peer15 = np.median([horizons[15][t] for t in symbols if t != s])
        rev = -r1[s] / (v + .006)
        fac["volstate"][s] = rev * (1.0 + min(v / .02, 1.0))
        fac["lowvol"][s] = rev / (1.0 + 2.0 * v)
        fac["medium"][s] = -horizons[10][s] / (v * np.sqrt(10) + .01)
        fac["leadlag"][s] = peer5 / (v * np.sqrt(5) + .01)
        fac["dispersion"][s] = (peer5 - horizons[5][s]) / (v * np.sqrt(5) + .01) * min(dispersion / .025, 1.0)
        fac["conditional"][s] = (-horizons[15][s] / (v * np.sqrt(15) + .01)) if peer15 < 0 else 0.0
        fac["idio"][s] = rev - (horizons[5][s] - peer5) / (v + .01)
        fac["skipmom"][s] = skip[s] / (v * np.sqrt(75) + .02)
        fac["eqresid"][s] = -(horizons[40][s] - eqmed) / (v * np.sqrt(40) + .02)
    score = {s: sum(w * _rank(fac[k])[s] for k, w in FACTORS.items()) for s in UNIVERSE}
    if _previous is not None:
        score = {s: .50 * score[s] + .50 * _previous.get(s, .5) for s in UNIVERSE}
    _previous = score.copy()

    breadth = np.mean([horizons[20][s] > 0 for s in symbols])
    stress = breadth < .50 or np.median(list(horizons[10].values())) < 0 or np.median(list(vols.values())) > .018
    defensive = {"XAU", "US10Y", "CN10Y"}
    mean_iv = np.mean([1.0 / v for v in vols.values()])
    raw = {}
    for s in UNIVERSE:
        iv = (1.0 / vols.get(s, .02)) / mean_iv
        raw[s] = max(score[s], .05) * (.90 + .10 * min(iv, 1.20))
        if stress and s in defensive:
            raw[s] *= 2.10
        elif stress and horizons[20].get(s, 0.0) < -.08:
            raw[s] *= .70
    target = _bounded(raw)
    if all(np.isfinite(target[s]) for s in UNIVERSE) and abs(sum(target.values()) - 1.0) < 1e-8:
        rebalance_to_weights(target)


