rt_values("date").reset_index(drop=True)\n        c = np.asarray(df.close, dtype=float); h = np.asarray(df.high, dtype=float); l = np.asarray(df.low, dtype=float)\n        if not np.all(np.isfinite(c[-26:])) or c[-1] <= 0: continue\n        daily = c[1:] / np.maximum(c[:-1], 1e-12) - 1.0\n        sigma = max(float(np.std(daily[-20:])), 0.008)\n        ret20[s] = c[-1] / max(c[-21], 1e-12) - 1.0\n        clv[s] = (c[-1] - l[-1]) / max(h[-1] - l[-1], abs(c[-1]) * 1e-8)\n        rev[s] = -float(np.mean(daily[-5:]))\n        vol[s] = sigma\n        mom[s] = ret20[s] / (sigma + 0.01)\n    if len(ret20) < 8: return\n    peer = {s: ret20[s] - np.median([ret20[t] for t in ret20 if t != s]) for s in ret20}\n    ranks = {"clv": percentile(clv), "peer": percentile(peer), "reversal": percentile(rev), "momentum": percentile(mom)}\n    score = {s: sum(FACTORS[k] * ranks[k][s] for k in FACTORS) for s in ret20}\n    breadth = np.mean([v > 0 for v in ret20.values()])\n    risk = {"000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "COPPER", "WTI", "BTC", "ETH"}\n    defensive = {"XAU", "US10Y", "CN10Y"}\n    overlay = {s: 1.0 for s in ret20}\n    if breadth < 0.40:\n        for s in risk: \n            if s in overlay: overlay[s] = 0.82\n        for s in defensive:\n            if s in overlay: overlay[s] = 1.55\n    elif breadth < 0.55:\n        for s in risk:\n            if s in overlay: overlay[s] = 0.93\n        for s in defensive:\n            if s in overlay: overlay[s] = 1.20\n    mean_inv = np.mean([1.0 / v for v in vol.values()])\n    raw = {s: max(score.get(s, 0.5), 0.05) * overlay.get(s, 1.0) * (0.85 + 0.15 * (1.0 / vol[s]) / max(mean_inv, 1e-12)) for s in ret20}\n    # Missing series receive neutral, small allocations rather than breaking the contract.\n    for s in UNIVERSE:\n        raw.setdefault(s, 0.5)\n    rebalance_to_weights(bounded(raw))\n', 'file_path': 'strategy.py'})Traceback (most recent call last):
