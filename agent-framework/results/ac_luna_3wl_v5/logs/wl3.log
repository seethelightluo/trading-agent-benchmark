  ▶️ write_file({'content': "import pandas as pd, numpy as np\nfrom scipy.stats import spearmanr\nU=['000300.SH','SPX','HSI','N225','SX5E','000688.SH','SOX','NDX','XAU','COPPER','WTI','BTC','ETH','US10Y','CN10Y']; CUT=pd.Timestamp('2026-07-15')\nmacro_names=['VIX','USDJPY','EURUSD','USDCNY']\nD={s:pd.read_csv('../persistent/stock_data/'+s+'.csv',parse_dates=['date']).set_index('date').sort_index().loc[:CUT] for s in U}\nfor mn in macro_names:\n try:\n  m=pd.read_csv('../persistent/index_data/'+mn+'.csv',parse_dates=['date']).set_index('date').sort_index().loc[:CUT].close.pct_change()\n except Exception as e: print('missing',mn,e); continue\n rows=[]\n for s,x in D.items():\n  r=x.close.pct_change(); cov=r.rolling(60,min_periods=30).cov(m); var=m.rolling(60,min_periods=30).var()\n  resid=r-(cov/var)*m.reindex(r.index)\n  f=-resid.rolling(3,min_periods=3).sum()/(resid.rolling(20,min_periods=15).std()*np.sqrt(3)+1e-12)\n  y=x.close.shift(-1)/x.close-1\n  rows.append(pd.DataFrame({'date':x.index,'f':f,'y':y}))\n a=pd.concat(rows).dropna(); out=[]\n for dt,g in a.groupby('date'):\n  if len(g)>=8 and g.f.nunique()>1: out.append((dt,spearmanr(g.f,g.y).statistic,len(g)))\n z=pd.DataFrame(out,columns=['date','ic','n']); q=z.ic\n print(mn,'dates',len(q),'avgN',z.n.mean(),'coverage',len(a)/(sum(len(x) for x in D.values())),'IC',q.mean(),'ICIR',q.mean()/q.std(ddof=1),'hit',(q>0).mean(),'turn',q.size)\n for lo,hi in [(2020,2022),(2023,2024),(2025,2026)]:\n  w=z[(z.date.dt.year>=lo)&(z.date.dt.year<=hi)].ic; print('reg',lo,len(w),w.mean(),w.mean()/w.std(ddof=1))\n for h in [5,10]:\n  yy=[]\n  for s,x in D.items(): yy.append(pd.DataFrame({'date':x.index,'f':a[(a.date.isin(x.index)) & (a.index*0==0)] if False else 0}))\n  vals=[]\n  for s,x in D.items():\n   r=x.close.pct_change(); cov=r.rolling(60,min_periods=30).cov(m); var=m.rolling(60,min_periods=30).var(); res=r-(cov/var)*m.reindex(r.index); f=-res.rolling(3,min_periods=3).sum()/(res.rolling(20,min_periods=15).std()*np.sqrt(3)+1e-12); y=x.close.shift(-h)/x.close-1\n   for dt in f.index:\n    vals.append((dt,f.loc[dt],y.loc[dt]))\n  b=pd.DataFrame(vals,columns=['date','f','y']).dropna(); ic=[spearmanr(g.f,g.y).statistic for _,g in b.groupby('date') if len(g)>=8]\n  print('decay',h,np.mean(ic),np.mean(ic)/np.std(ic,ddof=1),len(ic))\n", 'file_path': 'scripts/miner_3_20260730_fx_vix_residual_reversal.py'})
