        c = np.asarray(df["close"], float); o = np.asarray(df["open"], float)\n            h = np.asarray(df["high"], float); l = np.asarray(df["low"], float)\n            v = np.asarray(df["volume"], float)\n        except Exception:\n            continue\n        if np.any(~np.isfinite(c[-35:])) or np.any(c[-35:] <= 0):\n            continue\n        r = c[1:] / c[:-1] - 1\n        if len(r) < 30: continue\n        sigma = max(float(np.nanstd(r[-20:])), .008)\n        ret[symbol], vol[symbol] = r, sigma\n        span = h[-1] - l[-1]\n        # Conventional CLV reversal: buy assets closing near the bottom of range.\n        raw["clv"][symbol] = -(2*c[-1] - h[-1] - l[-1]) / span if span > 0 else 0.\n        raw["mom20"][symbol] = (c[-1]/c[-21]-1) / (sigma*np.sqrt(20)+.01)\n        vol_med = np.nanmedian(v[-21:-1])\n        boost = np.clip(v[-1]/vol_med, .75, 1.75) if np.isfinite(vol_med) and vol_med > 0 else 1.\n        raw["volume1"][symbol] = (-r[-1]/sigma) * (1.0 + .35*max(boost-1., 0.))\n        raw["rev3"][symbol] = -(np.prod(1+r[-3:])-1) / (sigma*np.sqrt(3)+.005)\n\n    if len(ret) < 8: return\n    def cumulative(x, n): return float(np.prod(1+x[-n:])-1)\n    for s, r in ret.items():\n        peer = [cumulative(ret[t], 5) for t in ret if t != s]\n        raw["peer5"][s] = cumulative(r, 5) - float(np.median(peer))\n\n    ranks = {k: cross_rank(x) for k, x in raw.items()}\n    score = {s: sum(FACTORS[k] * ranks[k][s] for k in FACTORS) for s in UNIVERSE}\n    median_vol = float(np.median(list(vol.values())))\n    breadth = float(np.mean([(r[-20:].sum() > 0) for r in ret.values()]))\n    risk = median_vol > .018 or breadth < .45\n    inv_mean = float(np.mean([1/x for x in vol.values()]))\n    defensives = {"XAU", "US10Y", "CN10Y"}\n    target = {}\n    for s in UNIVERSE:\n        iv = min((1/vol.get(s, median_vol))/inv_mean, 1.5)\n        tilt = 1.12 if risk and s in defensives else 1.0\n        target[s] = max(score[s], .05) * (.85 + .15*iv) * tilt\n    rebalance_to_weights(bound_weights(target))\n', 'file_path': 'strategy.py'})Traceback (most recent call last):
