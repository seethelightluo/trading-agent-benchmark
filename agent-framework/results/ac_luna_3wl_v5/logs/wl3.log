 import numpy as np
from alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights

UNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
# Screener ensemble, capped at eight active factors (2026-07-30).
FACTORS = {"clv": 0.22, "peer": 0.18, "mom": 0.17, "volrev": 0.14,
           "rev5": 0.11, "macrorev": 0.08, "dispersion": 0.06, "downrev": 0.04}
MIN_W, MAX_W, REBALANCE_DAYS = 0.02, 0.14, 10
_day = 0


def cross_rank(values):
    valid = sorted((s, float(x)) for s, x in values.items() if np.isfinite(x))
    result = {s: 0.5 for s in UNIVERSE}
    if valid:
        for i, (s, _) in enumerate(valid):
            result[s] = (i + 1.0) / len(valid)
    return result


def bounded_simplex(raw):
    # Iterative projection keeps every tradable asset invested and bounds concentration.
    result = {s: max(float(raw.get(s, 1.0 / len(UNIVERSE))), 1e-12) for s in UNIVERSE}
    fixed = {}
    active = set(UNIVERSE)
    for _ in range(40):
        remaining = 1.0 - sum(fixed.values())
        denom = sum(result[s] for s in active)
        trial = {s: remaining * result[s] / denom for s in active}
        clipped = False
        for s, x in list(trial.items()):
            if x < MIN_W:
                fixed[s] = MIN_W; active.remove(s); clipped = True
            elif x > MAX_W:
                fixed[s] = MAX_W; active.remove(s); clipped = True
        if not clipped:
            fixed.update(trial)
            break
    total = sum(fixed.values())
    return {s: fixed.get(s, 0.0) / total for s in UNIVERSE}


def compound(r, n):
    return float(np.prod(1.0 + r[-n:]) - 1.0) if len(r) >= n else np.nan


@register_hook
def cross_asset_strategy():
    global _day
    _day += 1
    if _day != 1 and (_day - 1) % REBALANCE_DAYS != 0:
        return

    returns, volatility, signal = {}, {}, {f: {} for f in FACTORS}
    for symbol in UNIVERSE:
        df = get_stock_daily_data(symbol=symbol, days=160)
        if df is None or len(df) < 45:
            continue
        df = df.sort_values("date").reset_index(drop=True)
        close = np.asarray(df["close"], dtype=float)
        high = np.asarray(df["high"], dtype=float)
        low = np.asarray(df["low"], dtype=float)
        volume = np.asarray(df["volume"], dtype=float)
        if np.any(~np.isfinite(close[-45:])) or np.any(close[-45:] <= 0):
            continue
        r = close[1:] / close[:-1] - 1.0
        vol = max(float(np.nanstd(r[-20:])), 0.008)
        returns[symbol], volatility[symbol] = r, vol
        span = high[-1] - low[-1]
        signal["clv"][symbol] = (2.0 * close[-1] - high[-1] - low[-1]) / span if span > 0 else 0.0
        signal["mom"][symbol] = compound(r, 20) / (vol * np.sqrt(20.0) + 0.01)
        signal["rev5"][symbol] = -compound(r, 5) / (vol * np.sqrt(5.0) + 0.005)
        downside = max(float(np.std(np.minimum(r[-10:], 0.0))), 0.004)
        signal["downrev"][symbol] = -compound(r, 3) / (downside * np.sqrt(3.0) + 0.005)
        median_volume = np.nanmedian(volume[-21:-1])
        volume_boost = np.clip(volume[-1] / median_volume, 0.75, 1.5) if median_volume > 0 else 1.0
        signal["volrev"][symbol] = (-r[-1] / vol) * (1.0 + 0.20 * max(volume_boost - 1.0, 0.0))

    if len(returns) < 8:
        return
    r5 = {s: compound(r, 5) for s, r in returns.items()}
    r3 = {s: compound(r, 3) for s, r in returns.items()}
    median5, median3 = np.median(list(r5.values())), np.median(list(r3.values()))
    for s in returns:
        peers = [r5[t] for t in returns if t != s]
        signal["peer"][s] = r5[s] - (np.median(peers) if peers else median5)
        # Cross-asset residual proxies: only tradable assets enter orders.
        signal["dispersion"][s] = -(r3[s] - median3)
        signal["macrorev"][s] = -(r3[s] - median3) / (volatility[s] + 0.01)

    ranks = {f: cross_rank(signal[f]) for f in FACTORS}
    score = {s: sum(FACTORS[f] * ranks[f][s] for f in FACTORS) for s in UNIVERSE}
    median_vol = float(np.median(list(volatility.values())))
    breadth = float(np.mean([compound(returns[s], 20) > 0 for s in returns]))
