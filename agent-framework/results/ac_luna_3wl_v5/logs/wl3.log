 import numpy as np
from alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights

UNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
DEFENSIVE = {"XAU", "US10Y", "CN10Y"}
CADENCE = 10
MIN_W, MAX_W = 0.04, 0.16
# Screener ensemble: eight active factors, all direction +1.
FACTORS = ("volstate", "failure", "lowvolrev", "dispersion", "consistency", "downside", "residual", "breakout120")
FACTOR_W = (0.21, 0.17, 0.14, 0.12, 0.11, 0.10, 0.08, 0.07)
_day = 0
_previous = None


def rank_cs(values):
    good = sorted((s, v) for s, v in values.items() if np.isfinite(v))
    out = {s: 0.5 for s in UNIVERSE}
    n = len(good)
    for i, (s, _) in enumerate(good):
        out[s] = (i + 1.0) / max(n, 1)
    return out


def bounded_simplex(raw):
    # Iterative clipping keeps every tradable invested and preserves bounds.
    w = {s: max(float(raw.get(s, 0.0)), 1e-12) for s in UNIVERSE}
    fixed = {}
    for _ in range(30):
        free = [s for s in UNIVERSE if s not in fixed]
        left = 1.0 - sum(fixed.values())
        z = sum(w[s] for s in free)
        for s in free:
            w[s] = left * w[s] / max(z, 1e-12)
        hit = [s for s in free if w[s] < MIN_W or w[s] > MAX_W]
        if not hit:
            break
        for s in hit:
            fixed[s] = MIN_W if w[s] < MIN_W else MAX_W
            w[s] = fixed[s]
    z = sum(w.values())
    return {s: w[s] / z for s in UNIVERSE}


@register_hook
def cross_asset_strategy():
    global _day, _previous
    _day += 1
    if _day != 1 and (_day - 1) % CADENCE != 0:
        return

    feat, returns = {}, {}
    for s in UNIVERSE:
        df = get_stock_daily_data(symbol=s, days=195)
        if df is None or len(df) < 135:
            continue
        # The final row is the current/incomplete observation; use completed data only.
        close = np.asarray(df.sort_values("date")["close"], dtype=float)[:-1]
        if len(close) < 125 or np.any(~np.isfinite(close)) or np.any(close <= 0):
            continue
        r = close[1:] / close[:-1] - 1.0
        v20 = max(float(np.std(r[-20:])), 0.006)
        dn20 = max(float(np.sqrt(np.mean(np.minimum(r[-20:], 0.0) ** 2))), 0.006)
        r3 = np.prod(1 + r[-3:]) - 1.0
        r5 = np.prod(1 + r[-5:]) - 1.0
        r20 = np.prod(1 + r[-20:]) - 1.0
        r30 = np.prod(1 + r[-30:]) - 1.0
        h20, h120 = max(close[-21:]), max(close[-121:])
        # Reversal signals dominate, while medium trend signals are deliberately damped.
        feat[s] = {
            "volstate": np.clip(-r3 / v20, -3, 3),
            "failure": np.clip((-r5) * max(0.0, 1.0 - close[-1] / h20) / v20, -3, 3),
            "lowvolrev": np.clip((-r3) / (v20 * (1.0 + 8.0 * v20)), -3, 3),
            "dispersion": np.clip(-r5 / max(v20 * np.sqrt(5), 0.01), -3, 3),
            "consistency": r30 / max(v20 * np.sqrt(30), 0.01) * (0.5 + np.mean(r[-30:] > 0)),
            "downside": r20 / dn20,
            "residual": r20 / max(v20 * np.sqrt(20), 0.01),
            "breakout120": (close[-1] / h120 - 1.0) / max(v20 * np.sqrt(120), 0.01),
            "vol": v20,
        }
        returns[s] = r
    if len(feat) < 10:
        return

    # Beta residualization uses only the trailing completed observations.
    market = returns.get("SPX")
    if market is not None:
        for s, r in returns.items():
            n = min(60, len(r), len(market))
            if n >= 30:
                cov = np.cov(r[-n:], market[-n:], ddof=1)[0, 1]
                beta = cov / max(np.var(market[-n:], ddof=1), 1e-8)
                feat[s]["residual"] -= beta * np.prod(1 + market[-20:]) - beta

    ranks = {f: rank_cs({s: feat[s][f] for s in feat}) for f in FACTORS}
    score = {s: sum(FACTOR_W[i] * ranks[FACTORS[i]][s] for i in range(len(FACTORS))) for s in UNIVERSE}
    if _previous is not None:
        score = {s: 0.70 * score[s] + 0.30 * _previous[s] for s in UNIVERSE}
    _previous = score.copy()

    median_vol = float(np.median([x["vol"] for x in feat.values()]))
    breadth = float(np.mean([x["breakout120"] > 0 for x in feat.values()]))
    stressed = median_vol > 0.018 or breadth < 0.45
    mean_invvol = float(np.mean([1.0 / x["vol"] for x in feat.values()]))
    raw = {}
    for s in UNIVERSE:
        x = feat.get(s, {"vol": median_vol, "breakout120": 0.0})
        damp = np.clip((1.0 / x["vol"]) / max(mean_invvol, 1e-12), 0.75, 1.15)
        raw[s] = max(score[s], 0.08) * (0.88 + 0.12 * damp)
        if stressed:
            # Defensive substitution, never a cash sleeve.
            raw[s] *= 1.28 if s in DEFENSIVE else (0.86 if x["breakout120"] < 0 else 0.78)
    target = bounded_simplex(raw)
    if all(np.isfinite(target[s]) and target[s] >= 0 for s in UNIVERSE) and abs(sum(target.values()) - 1.0) < 1e-8:
        rebalance_to_weights(target)


