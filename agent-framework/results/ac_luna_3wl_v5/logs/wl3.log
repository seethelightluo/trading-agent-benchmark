= df.sort_values("date")\n        close = np.asarray(df["close"], dtype=float)\n        if np.any(~np.isfinite(close[-70:])) or np.any(close[-70:] <= 0):\n            continue\n        r = close[1:] / close[:-1] - 1.0\n        returns[s] = r\n        vols[s] = max(float(np.std(r[-20:])), 0.006)\n        last[s] = df.iloc[-1]\n    if len(returns) < 10:\n        return\n\n    r1 = {s: r[-1] for s, r in returns.items()}\n    r5 = {s: float(np.prod(1 + r[-5:]) - 1) for s, r in returns.items()}\n    r10 = {s: float(np.prod(1 + r[-10:]) - 1) for s, r in returns.items()}\n    r20 = {s: float(np.prod(1 + r[-20:]) - 1) for s, r in returns.items()}\n    r40 = {s: float(np.prod(1 + r[-40:]) - 1) for s, r in returns.items()}\n    peers = list(returns)\n    equities = [s for s in UNIVERSE[:8] if s in returns]\n    eq40 = float(np.median([r40[s] for s in equities])) if equities else 0.0\n    breadth = float(np.mean([r20[s] > 0 for s in returns]))\n    stress = breadth < 0.50 or float(np.median(list(r10.values()))) < 0 or float(np.median(list(vols.values()))) > 0.018\n\n    factors = {k: {} for k in FACTORS}\n    for s, r in returns.items():\n        v = vols[s]\n        peer5 = float(np.median([r5[t] for t in peers if t != s]))\n        rev = -r1[s] / (v + 0.006)\n        factors["lowvol_rev"][s] = rev\n        factors["volstate_rev"][s] = rev * (1.0 + min(v / 0.02, 1.0))\n        factors["peer"][s] = r5[s] - peer5\n        factors["resid20"][s] = (r20[s] - peer5) / (v * np.sqrt(20) + 0.01)\n        factors["eq_resid40"][s] = (r40[s] - eq40) / (v * np.sqrt(40) + 0.02)\n        factors["idio_rev"][s] = rev - (r5[s] - peer5) / (v + 0.01)\n        hi, lo, cl = float(last[s].get("high", 0)), float(last[s].get("low", 0)), float(last[s]["close"])\n        factors["clv"][s] = (2.0 * cl - hi - lo) / (hi - lo) if hi > lo else 0.0\n\n    score = {s: sum(FACTORS[k] * ranks(factors[k])[s] for k in FACTORS) for s in UNIVERSE}\n    if _previous is not None:\n        score = {s: 0.50 * score[s] + 0.50 * _previous.get(s, 0.5) for s in UNIVERSE}\n    _previous = score.copy()\n\n    defensive = {"XAU", "US10Y", "CN10Y"}\n    invmean = float(np.mean([1.0 / v for v in vols.values()]))\n    raw = {}\n    for s in UNIVERSE:\n        invvol = min((1.0 / vols.get(s, 0.02)) / invmean, 1.20)\n        raw[s] = max(score[s], 0.05) * (0.90 + 0.10 * invvol)\n        if stress and s in defensive:\n            raw[s] *= 1.85\n        elif stress and r20.get(s, 0.0) < -0.08:\n            raw[s] *= 0.75\n    target = bounded(raw)\n    if abs(sum(target.values()) - 1.0) < 1e-8 and all(np.isfinite(v) and v >= 0 for v in target.values()):\n        rebalance_to_weights(target)\n', 'file_path': 'strategy.py'})
