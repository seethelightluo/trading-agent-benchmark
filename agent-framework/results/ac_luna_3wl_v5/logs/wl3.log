 import numpy as np
from alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights

UNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
# Screener 2026-07-30 ensemble: eight validated, positively directed factors.
FACTORS = {"clv": .18, "peer": .15, "mom": .18, "res20": .12,
           "rev5": .10, "volrev": .09, "lowvolrev": .10, "macrorev": .08}
MIN_W, MAX_W, CADENCE = .02, .14, 10
_day = 0


def rank(values):
    valid = sorted((s, float(v)) for s, v in values.items() if np.isfinite(v))
    out = {s: .5 for s in UNIVERSE}
    if valid:
        for i, (s, _) in enumerate(valid):
            out[s] = (i + 1.0) / len(valid)
    return out


def bounded_weights(raw):
    # Iterative bounded simplex projection; preserves a complete target vector.
    w = {s: max(float(raw.get(s, .05)), 1e-12) for s in UNIVERSE}
    fixed, active = {}, set(UNIVERSE)
    for _ in range(30):
        left = 1.0 - sum(fixed.values())
        z = sum(w[s] for s in active)
        trial = {s: left * w[s] / z for s in active}
        clipped = False
        for s, x in list(trial.items()):
            if x < MIN_W:
                fixed[s] = MIN_W; active.remove(s); clipped = True
            elif x > MAX_W:
                fixed[s] = MAX_W; active.remove(s); clipped = True
        if not clipped:
            fixed.update(trial)
            break
    total = sum(fixed.values())
    return {s: fixed.get(s, 0.0) / total for s in UNIVERSE}


def compound(r, n):
    return float(np.prod(1.0 + r[-n:]) - 1.0)


@register_hook
def cross_asset_strategy():
    global _day
    _day += 1
    if _day != 1 and (_day - 1) % CADENCE != 0:
        return

    returns, vols, signals = {}, {}, {k: {} for k in FACTORS}
    for symbol in UNIVERSE:
        df = get_stock_daily_data(symbol=symbol, days=160)
        if df is None or len(df) < 45:
            continue
        df = df.sort_values("date").reset_index(drop=True)
        close = np.asarray(df["close"], float)
        high = np.asarray(df["high"], float)
        low = np.asarray(df["low"], float)
        open_ = np.asarray(df["open"], float)
        volume = np.asarray(df["volume"], float)
        if np.any(~np.isfinite(close[-45:])) or np.any(close[-45:] <= 0):
            continue
        r = close[1:] / close[:-1] - 1.0
        vol = max(float(np.nanstd(r[-20:])), .008)
        returns[symbol], vols[symbol] = r, vol
        span = high[-1] - low[-1]
        signals["clv"][symbol] = (2 * close[-1] - high[-1] - low[-1]) / span if span > 0 else 0.0
        signals["mom"][symbol] = compound(r, 20) / (vol * np.sqrt(20) + .01)
        signals["rev5"][symbol] = -compound(r, 5) / (vol * np.sqrt(5) + .005)
        signals["lowvolrev"][symbol] = -compound(r, 3) / (vol * np.sqrt(3) + .005)
        downside = max(float(np.std(np.minimum(r[-10:], 0.0))), .004)
        signals["macrorev"][symbol] = -compound(r, 3) / (downside * np.sqrt(3) + .005)
        median_volume = np.nanmedian(volume[-21:-1])
        boost = np.clip(volume[-1] / median_volume, .75, 1.5) if np.isfinite(median_volume) and median_volume > 0 else 1.0
        signals["volrev"][symbol] = (-r[-1] / vol) * (1.0 + .20 * max(boost - 1.0, 0.0))

    if len(returns) < 8:
        return
    r5 = {s: compound(r, 5) for s, r in returns.items()}
    r20 = {s: compound(r, 20) for s, r in returns.items()}
    for s in returns:
        signals["peer"][s] = r5[s] - np.median([r5[t] for t in returns if t != s])
        signals["res20"][s] = -(r20[s] - np.median([r20[t] for t in returns if t != s]))

    ranks = {factor: rank(values) for factor, values in signals.items()}
    score = {s: sum(FACTORS[f] * ranks[f][s] for f in FACTORS) for s in UNIVERSE}
    median_vol = float(np.median(list(vols.values())))
    breadth = float(np.mean([r20[s] > 0 for s in returns]))
    stress = median_vol > .018 or breadth < .45
    mean_inverse_vol = float(np.mean([1.0 / v for v in vols.values()]))
    raw = {}
    for s in UNIVERSE:
        risk_scale = min((1.0 / vols.get(s, median_vol)) / mean_inverse_vol, 1.5)
        raw[s] = max(score[s], .05) * (.85 + .15 * risk_scale)
        # Sideways/high-risk regime: modest defensive tilt, while staying fully invested.
        if stress and s in {"XAU", "US10Y", "CN10Y"}:
            raw[s] *= 1.15
    rebalance_to_weights(bounded_weights(raw))


