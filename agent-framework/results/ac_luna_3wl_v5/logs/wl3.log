 import numpy as np
from alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights

UNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
DEFENSIVE = {"XAU", "US10Y", "CN10Y"}
CADENCE = 10
MIN_W, MAX_W = 0.04, 0.16
# Current screener ensemble (eight active, direction +1).
FACTORS = ("failure", "consistency", "residual", "downside", "volstate", "short_breakout", "breakout120", "dispersion")
FACTOR_W = (0.20, 0.16, 0.14, 0.12, 0.11, 0.10, 0.09, 0.08)
_day = 0
_previous = None


def cs_rank(values):
    good = sorted((s, float(v)) for s, v in values.items() if np.isfinite(v))
    out = {s: 0.5 for s in UNIVERSE}
    for i, (s, _) in enumerate(good):
        out[s] = (i + 1.0) / max(len(good), 1)
    return out


def bounded_simplex(raw):
    # Projection-like clipping, retaining a complete 15-asset target.
    w = {s: max(float(raw.get(s, 0.0)), 1e-10) for s in UNIVERSE}
    fixed = {}
    for _ in range(40):
        free = [s for s in UNIVERSE if s not in fixed]
        left = 1.0 - sum(fixed.values())
        total = sum(w[s] for s in free)
        for s in free:
            w[s] = left * w[s] / max(total, 1e-12)
        hit = [s for s in free if w[s] < MIN_W or w[s] > MAX_W]
        if not hit:
            break
        for s in hit:
            fixed[s] = MIN_W if w[s] < MIN_W else MAX_W
            w[s] = fixed[s]
    z = sum(w.values())
    return {s: w[s] / max(z, 1e-12) for s in UNIVERSE}


@register_hook
def cross_asset_strategy():
    global _day, _previous
    _day += 1
    if _day != 1 and (_day - 1) % CADENCE != 0:
        return

    feat, rets = {}, {}
    for s in UNIVERSE:
        df = get_stock_daily_data(symbol=s, days=200)
        if df is None or len(df) < 135:
            continue
        close = np.asarray(df.sort_values("date")["close"], dtype=float)[:-1]
        if len(close) < 125 or np.any(~np.isfinite(close)) or np.any(close <= 0):
            continue
        r = close[1:] / close[:-1] - 1.0
        v20 = max(float(np.std(r[-20:])), 0.006)
        dn20 = max(float(np.sqrt(np.mean(np.minimum(r[-20:], 0.0) ** 2))), 0.006)
        h20, h60, h120 = max(close[-21:]), max(close[-61:]), max(close[-121:])
        r3 = np.prod(1 + r[-3:]) - 1.0
        r5 = np.prod(1 + r[-5:]) - 1.0
        r20 = np.prod(1 + r[-20:]) - 1.0
        r30 = np.prod(1 + r[-30:]) - 1.0
        r60 = np.prod(1 + r[-60:]) - 1.0
        feat[s] = {
            # Failure/reversal is only rewarded near a recent high, limiting blind dip buying.
            "failure": np.clip((-r5) * max(0.0, 1.0 - close[-1] / h20) / v20, -3, 3),
            "consistency": np.clip(r30 / max(v20 * np.sqrt(30), .01) * (.5 + np.mean(r[-30:] > 0)), -3, 3),
            "residual": np.clip(r20 / max(v20 * np.sqrt(20), .01), -3, 3),
            "downside": np.clip(r20 / dn20, -3, 3),
            "volstate": np.clip(-r3 / v20, -3, 3),
            "short_breakout": np.clip((close[-1] / h60 - 1.0) / max(v20 * np.sqrt(60), .01), -3, 3),
            "breakout120": np.clip((close[-1] / h120 - 1.0) / max(v20 * np.sqrt(120), .01), -3, 3),
            "dispersion": np.clip(-r5 / max(v20 * np.sqrt(5), .01), -3, 3),
            "vol": v20,
        }
        rets[s] = r
    if len(feat) < 10:
        return

    # Residual momentum: trailing data only, with SPX as the common benchmark.
    market = rets.get("SPX")
    if market is not None:
        for s, r in rets.items():
            n = min(60, len(r), len(market))
            if n >= 30:
                beta = np.cov(r[-n:], market[-n:], ddof=1)[0, 1] / max(np.var(market[-n:], ddof=1), 1e-8)
                feat[s]["residual"] = np.clip(feat[s]["residual"] - beta * np.prod(1 + market[-20:]) / max(v20 if (v20 := feat[s]["vol"]) else .006, .006), -3, 3)

    ranks = {f: cs_rank({s: feat[s][f] for s in feat}) for f in FACTORS}
    score = {s: sum(FACTOR_W[i] * ranks[FACTORS[i]][s] for i in range(len(FACTORS))) for s in UNIVERSE}
    if _previous is not None:
        score = {s: .70 * score[s] + .30 * _previous[s] for s in UNIVERSE}
    _previous = score.copy()

    median_vol = float(np.median([x["vol"] for x in feat.values()]))
    breadth = float(np.mean([x["breakout120"] > 0 for x in feat.values()]))
    stressed = median_vol > .018 or breadth < .45
    mean_invvol = float(np.mean([1.0 / x["vol"] for x in feat.values()]))
    raw = {}
    for s in UNIVERSE:
        x = feat.get(s, {"vol": median_vol, "breakout120": 0.0})
        damp = np.clip((1.0 / x["vol"]) / max(mean_invvol, 1e-12), .75, 1.15)
        raw[s] = max(score[s], .08) * (.88 + .12 * damp)
        if stressed:
            raw[s] *= 1.28 if s in DEFENSIVE else (.86 if x["breakout120"] < 0 else .78)
    target = bounded_simplex(raw)
    if abs(sum(target.values()) - 1.0) < 1e-8:
        rebalance_to_weights(target)


