 import numpy as np
from alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights

UNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
FACTORS = {"lowvol": 0.60, "clv": 0.12, "peer": 0.10, "momentum": 0.08, "volume": 0.06, "residual": 0.04}
REBALANCE_EVERY = 10
MIN_WEIGHT, MAX_WEIGHT = 0.02, 0.14
_calls = 0


def ranks(values):
    valid = sorted((s, v) for s, v in values.items() if np.isfinite(v))
    out = {s: 0.5 for s in UNIVERSE}
    n = len(valid)
    if n > 1:
        for i, (s, _) in enumerate(valid):
            out[s] = (i + 1.0) / n
    elif n == 1:
        out[valid[0][0]] = 1.0
    return out


def bounded(raw):
    # Water-fill a complete, long-only target without a cash sleeve.
    w = {s: max(float(raw.get(s, 0.0)), 1e-9) for s in UNIVERSE}
    fixed = {}
    active = set(UNIVERSE)
    for _ in range(20):
        left = 1.0 - sum(fixed.values())
        den = sum(w[s] for s in active)
        trial = {s: left * w[s] / den for s in active}
        clipped = False
        for s, x in list(trial.items()):
            if x < MIN_WEIGHT:
                fixed[s] = MIN_WEIGHT; active.remove(s); clipped = True
            elif x > MAX_WEIGHT:
                fixed[s] = MAX_WEIGHT; active.remove(s); clipped = True
        if not clipped:
            fixed.update(trial); break
    if active:
        left = 1.0 - sum(fixed.values())
        den = sum(w[s] for s in active)
        fixed.update({s: left * w[s] / den for s in active})
    total = sum(fixed.values())
    return {s: fixed[s] / total for s in UNIVERSE}


@register_hook
def cross_asset_strategy():
    global _calls
    _calls += 1
    if _calls != 1 and (_calls - 1) % REBALANCE_EVERY != 0:
        return

    raw = {k: {} for k in FACTORS}
    vol, ret1, ret5, mom = {}, {}, {}, {}
    for symbol in UNIVERSE:
        df = get_stock_daily_data(symbol=symbol, days=90)
        if df is None or len(df) < 30:
            continue
        df = df.sort_values("date").reset_index(drop=True)
        c = np.asarray(df["close"], float); o = np.asarray(df["open"], float)
        h = np.asarray(df["high"], float); l = np.asarray(df["low"], float)
        if np.any(~np.isfinite(c[-30:])) or np.any(c[-30:] <= 0):
            continue
        r = c[1:] / c[:-1] - 1.0
        sig = max(float(np.std(r[-20:])), 0.008)
        vol[symbol] = sig; ret1[symbol] = r[-1]
        ret5[symbol] = c[-1] / c[-6] - 1.0
        raw["lowvol"][symbol] = -r[-1] / sig
        raw["momentum"][symbol] = (c[-1] / c[-21] - 1.0) / (sig + 0.01)
        span = h[-1] - l[-1]
        raw["clv"][symbol] = -(c[-1] - o[-1]) / span if np.isfinite(span) and span > 0 else 0.0
        if "volume" in df.columns:
            v = np.asarray(df["volume"], float)
            med = np.nanmedian(v[-21:])
            amp = min(max(v[-1] / med, 0.25), 2.0) if np.isfinite(v[-1]) and v[-1] > 0 and med > 0 else 1.0
            raw["volume"][symbol] = (-r[-1] / sig) * (0.75 + 0.25 * amp)
        else:
            raw["volume"][symbol] = 0.0
    if len(vol) < 8:
        return
    peer_med = float(np.median(list(ret5.values())))
    day_med = float(np.median(list(ret1.values())))
    for s in vol:
        raw["peer"][s] = ret5[s] - peer_med
        raw["residual"][s] = -(ret1[s] - day_med) / vol[s]
    rr = {k: ranks(v) for k, v in raw.items()}
    score = {s: sum(FACTORS[k] * rr[k][s] for k in FACTORS) for s in UNIVERSE}
    breadth = np.mean([mom[s] > 0 for s in mom]) if mom else 0.5
    # In a weak, choppy regime, modestly favor tradable defensive assets.
    defensive = {"XAU", "US10Y", "CN10Y"}
    inv_mean = np.mean([1.0 / x for x in vol.values()])
    target_raw = {}
    for s in UNIVERSE:
        inv_tilt = min((1.0 / vol[s]) / inv_mean, 1.6)
        posture = 1.12 if breadth < 0.45 and s in defensive else (0.96 if breadth < 0.45 else 1.0)
        target_raw[s] = max(score[s], 0.05) * (0.96 + 0.04 * inv_tilt) * posture
    rebalance_to_weights(bounded(target_raw))
