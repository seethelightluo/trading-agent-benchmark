  ▶️ write_file({'content': 'import numpy as np\nfrom alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights\n\nUNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]\n# Current screener ensemble: capped at seven active factors.\nFACTORS = {\n    "rev5": 0.24, "mom120": 0.24, "rev10": 0.15,\n    "volume_rev": 0.11, "intraday_rev": 0.10,\n    "downside_rev": 0.10, "volscaled_rev10": 0.06,\n}\nDEFENSIVE = {"XAU", "US10Y", "CN10Y"}\nCADENCE = 10\nMIN_W, MAX_W = 0.035, 0.14\n_day = 0\n_previous = None\n\n\ndef ranks(values):\n    """Cross-sectional percentile ranks; unavailable names receive neutral rank."""\n    good = sorted((s, float(v)) for s, v in values.items() if np.isfinite(v))\n    out = {s: 0.5 for s in UNIVERSE}\n    if not good:\n        return out\n    n = len(good)\n    for i, (s, _) in enumerate(good):\n        out[s] = (i + 1.0) / n\n    return out\n\n\ndef bounded(raw):\n    """Project positive scores to a complete portfolio with explicit bounds."""\n    fixed, active = {}, set(UNIVERSE)\n    for _ in range(30):\n        remain = 1.0 - sum(fixed.values())\n        denom = sum(max(float(raw.get(s, 0.1)), 1e-9) for s in active)\n        trial = {s: remain * max(float(raw.get(s, 0.1)), 1e-9) / denom for s in active}\n        changed = False\n        for s, w in list(trial.items()):\n            if w < MIN_W:\n                fixed[s] = MIN_W; active.remove(s); changed = True\n            elif w > MAX_W:\n                fixed[s] = MAX_W; active.remove(s); changed = True\n        if not changed:\n            fixed.update(trial)\n            break\n    total = sum(fixed.get(s, 0.0) for s in UNIVERSE)\n    return {s: fixed.get(s, 0.0) / total for s in UNIVERSE}\n\n\n@register_hook\ndef cross_asset_strategy():\n    global _day, _previous\n    _day += 1\n    if _day != 1 and (_day - 1) % CADENCE != 0:\n        return\n\n    data = {}\n    for symbol in UNIVERSE:\n        df = get_stock_daily_data(symbol=symbol, days=260)\n        if df is None or len(df) < 145:\n            continue\n        df = df.sort_values("date")\n        c = np.asarray(df["close"], dtype=float)\n        o = np.asarray(df["open"], dtype=float)\n        if np.any(~np.isfinite(c)) or np.any(c <= 0):\n            continue\n        r = c[1:] / c[:-1] - 1.0\n        v = np.asarray(df["volume"], dtype=float) if "volume" in df else np.ones(len(df))\n        rv = max(float(np.std(r[-30:])), 0.006)\n        down = max(float(np.std(np.minimum(r[-40:], 0.0))), 0.004)\n        h5 = float(np.prod(1.0 + r[-5:]) - 1.0)\n        h10 = float(np.prod(1.0 + r[-10:]) - 1.0)\n        h120 = float(np.prod(1.0 + r[-120:]) - 1.0)\n        intraday = float(np.nanmean((c[-5:] - o[-5:]) / np.maximum(o[-5:], 1e-12)))\n        vmean5 = max(float(np.mean(v[-5:])), 1e-9)\n        vmean20 = max(float(np.mean(v[-20:])), 1e-9)\n        vdisp = float(np.std(v[-20:]) / vmean20)\n        data[symbol] = {"rv": rv, "down": down, "h5": h5, "h10": h10,\n                        "h120": h120, "intraday": intraday,\n                        "vdisp": vdisp, "vr": vmean5 / vmean20}\n    if len(data) < 10:\n        return\n\n    syms = list(data)\n    med5 = float(np.median([data[s]["h5"] for s in syms]))\n    med10 = float(np.median([data[s]["h10"] for s in syms]))\n    rawf = {k: {} for k in FACTORS}\n    for s in syms:\n        d = data[s]\n        # Reversal signals are damped by volatility and volume dispersion.\n        base5 = (med5 - d["h5"]) / (d["rv"] * np.sqrt(5.0) + 0.01)\n        base10 = (med10 - d["h10"]) / (d["rv"] * np.sqrt(10.0) + 0.01)\n        rawf["rev5"][s] = base5\n        rawf["mom120"][s] = d["h120"] / (d["rv"] * np.sqrt(120.0) + 0.03)\n        rawf["rev10"][s] = base10\n        rawf["volume_rev"][s] = base5 * (0.8 + 0.2 * np.clip(d["vdisp"], 0.0, 2.0))\n        rawf["intraday_rev"][s] = -d["intraday"] / (d["rv"] + 0.01)\n        rawf["downside_rev"][s] = (med5 - d["h5"]) / (d["down"] * np.sqrt(5.0) + 0.01)\n        rawf["volscaled_rev10"][s] = base10 / (1.0 + 8.0 * d["rv"])\n\n    rr = {k: ranks(v) for k, v in rawf.items()}\n    score = {s: sum(w * rr[k].get(s, 0.5) for k, w in FACTORS.items()) for s in UNIVERSE}\n    # Strong temporal smoothing is intentional at the 10-session cadence.\n    if _previous is not None:\n        score = {s: 0.40 * score[s] + 0.60 * _previous.get(s, 0.5) for s in UNIVERSE}\n    _previous = score.copy()\n\n    breadth = np.mean([data[s]["h120"] > 0.0 for s in syms])\n    median_rv = float(np.median([data[s]["rv"] for s in syms]))\n    high_risk = breadth < 0.50 or median_rv > 0.018\n    inv_mean = float(np.mean([1.0 / data[s]["rv"] for s in syms]))\n    raw = {}\n    for s in UNIVERSE:\n        d = data.get(s, {"rv": 0.02, "h120": 0.0})\n        invvol = (1.0 / d["rv"]) / max(inv_mean, 1e-9)\n        raw[s] = max(score[s], 0.12) * (0.90 + 0.10 * min(invvol, 1.25))\n        if high_risk and s in DEFENSIVE:\n            raw[s] *= 2.70\n        elif high_risk and d["h120"] < -0.10:\n            raw[s] *= 0.60\n    target = bounded(raw)\n    if all(np.isfinite(target[s]) and target[s] >= 0 for s in UNIVERSE) and abs(sum(target.values()) - 1.0) < 1e-8:\n        rebalance_to_weights(target)\n', 'file_path': 'strategy.py'})
