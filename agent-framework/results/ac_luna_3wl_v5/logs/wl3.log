ny(~np.isfinite(c[-70:])) or np.any(c[-70:] <= 0):\n            continue\n        r = c[1:] / c[:-1] - 1.\n        returns[s] = r\n        vols[s] = max(float(np.std(r[-20:])), .006)\n    if len(returns) < 10:\n        return\n\n    r1 = {s: r[-1] for s, r in returns.items()}\n    r3 = {s: float(np.prod(1+r[-3:])-1) for s, r in returns.items()}\n    r5 = {s: float(np.prod(1+r[-5:])-1) for s, r in returns.items()}\n    r10 = {s: float(np.prod(1+r[-10:])-1) for s, r in returns.items()}\n    r20 = {s: float(np.prod(1+r[-20:])-1) for s, r in returns.items()}\n    r40 = {s: float(np.prod(1+r[-40:])-1) for s, r in returns.items()}\n    dispersion = float(np.std(list(r1.values())))\n    breadth = float(np.mean([x > 0 for x in r20.values()]))\n    high_risk = breadth < .45 or np.median(list(vols.values())) > .018 or np.median(list(r5.values())) < 0\n    eq = [s for s in UNIVERSE[:8] if s in returns]\n    bench = float(np.median([r40[s] for s in eq])) if eq else float(np.median(list(r40.values())))\n\n    fac = {k: {} for k in FACTORS}\n    for s, r in returns.items():\n        v = vols[s]\n        fac["leadlag"][s] = r5[s] - np.median([r5[t] for t in returns if t != s])\n        fac["mom20"][s] = r20[s] / (v*np.sqrt(20) + .01)\n        fac["mom10"][s] = r10[s] / (v*np.sqrt(10) + .008) + .25*np.sign(r3[s])*np.sign(r10[s])\n        fac["volstate"][s] = -r1[s] / (v+.006) * (1 + min(v/.02, 1))\n        fac["idio"][s] = -r1[s] / (v+.004)\n        fac["shortrev"][s] = -r1[s] / (v+.006)\n        fac["dispersion"][s] = -r1[s] / (v+.006) * min(dispersion/.012, 1.5)\n        fac["residual"][s] = (r40[s] - bench) / (v*np.sqrt(40) + .02)\n        # Proxy for the newly admitted macro-residual signal: short-term\n        # relative reversal versus the broad equity/risk complex.\n        risk = np.median([r3[t] for t in returns if t in UNIVERSE[:8]])\n        fac["dxy_resid"][s] = -(r3[s] - risk) / (v*np.sqrt(3) + .01)\n    rr = {k: ranks(v) for k, v in fac.items()}\n    score = {s: sum(FACTORS[k] * rr[k].get(s, .5) for k in FACTORS) for s in returns}\n    if _previous is not None:\n        score = {s: .50*score[s] + .50*_previous.get(s, .5) for s in score}\n    _previous = score.copy()\n\n    invmean = np.mean([1./v for v in vols.values()])\n    defensive = {"XAU", "US10Y", "CN10Y"}\n    raw = {}\n    for s in UNIVERSE:\n        inv = min((1./vols.get(s, .02))/invmean, 1.25)\n        raw[s] = max(score.get(s, .5), .05) * (.88 + .12*inv)\n        if high_risk and s in defensive:\n            raw[s] *= 1.45\n    target = bounded(raw)\n    if len(target) == 15 and abs(sum(target.values()) - 1.) < 1e-8:\n        rebalance_to_weights(target)\n', 'file_path': 'strategy.py'})
