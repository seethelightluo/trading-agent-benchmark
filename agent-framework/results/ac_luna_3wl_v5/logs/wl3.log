 import numpy as np
from alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights

UNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
DEFENSIVE = {"XAU", "US10Y", "CN10Y"}
CADENCE = 10
MIN_W, MAX_W = 0.04, 0.18
# Current admitted screener ensemble; all factors have positive portfolio direction.
FACTORS = ("volstate", "residual", "consistency", "failure", "short_breakout", "dispersion", "breakout120", "lowvol")
FACTOR_W = (0.16, 0.16, 0.14, 0.14, 0.12, 0.10, 0.10, 0.08)
_day = 0
_previous = None


def rank_cs(values):
    valid = sorted((s, float(v)) for s, v in values.items() if np.isfinite(v))
    out = {s: 0.5 for s in UNIVERSE}
    for i, (s, _) in enumerate(valid):
        out[s] = (i + 1.0) / max(len(valid), 1)
    return out


def bounded_weights(raw):
    w = {s: max(float(raw.get(s, 0.0)), 1e-9) for s in UNIVERSE}
    fixed = {}
    for _ in range(60):
        free = [s for s in UNIVERSE if s not in fixed]
        left = 1.0 - sum(fixed.values())
        total = sum(w[s] for s in free)
        for s in free:
            w[s] = left * w[s] / max(total, 1e-12)
        hits = [s for s in free if w[s] < MIN_W or w[s] > MAX_W]
        if not hits:
            break
        for s in hits:
            fixed[s] = MIN_W if w[s] < MIN_W else MAX_W
            w[s] = fixed[s]
    total = sum(w.values())
    return {s: w[s] / max(total, 1e-12) for s in UNIVERSE}


@register_hook
def cross_asset_strategy():
    global _day, _previous
    _day += 1
    if _day != 1 and (_day - 1) % CADENCE != 0:
        return

    features, returns = {}, {}
    for symbol in UNIVERSE:
        df = get_stock_daily_data(symbol=symbol, days=210)
        if df is None or len(df) < 140:
            continue
        df = df.sort_values("date")
        close = np.asarray(df["close"], dtype=float)[:-1]  # no current-day lookahead
        volume = np.asarray(df["volume"], dtype=float)[:-1]
        if len(close) < 125 or np.any(~np.isfinite(close)) or np.any(close <= 0):
            continue
        r = close[1:] / close[:-1] - 1.0
        v20 = max(float(np.std(r[-20:])), 0.006)
        v60 = max(float(np.std(r[-60:])), v20)
        down = max(float(np.sqrt(np.mean(np.minimum(r[-20:], 0.0) ** 2))), 0.006)
        r3 = np.prod(1 + r[-3:]) - 1.0
        r5 = np.prod(1 + r[-5:]) - 1.0
        r20 = np.prod(1 + r[-20:]) - 1.0
        r30 = np.prod(1 + r[-30:]) - 1.0
        vol_ratio = 1.0
        if len(volume) >= 25 and np.all(np.isfinite(volume[-25:])):
            vol_ratio = volume[-5:].mean() / max(volume[-25:-5].mean(), 1e-12)
        features[symbol] = {
            "volstate": np.clip(-r3 / v20, -3, 3),
            "failure": np.clip(-r5 / v20, -3, 3),
            "dispersion": np.clip(-r5 / (v20 * np.sqrt(5)), -3, 3),
            "lowvol": np.clip(-v20 / v60, -3, 3),
            "residual": np.clip(r20 / max(v20 * np.sqrt(20), .01), -3, 3),
            "consistency": np.clip(r30 / max(v20 * np.sqrt(30), .01) * (.5 + np.mean(r[-30:] > 0)), -3, 3),
            "short_breakout": np.clip(r20 / max(v20 * np.sqrt(20), .01), -3, 3),
            "breakout120": np.clip(close[-1] / max(close[-121:]) - 1.0, -3, 3),
            "vol": v20,
        }
        returns[symbol] = r

    if len(features) < 10:
        return
    market = returns.get("SPX")
    if market is not None:
        for symbol, r in returns.items():
            n = min(60, len(r), len(market))
            if n >= 30:
                cov = np.cov(r[-n:], market[-n:], ddof=1)[0, 1]
                beta = cov / max(np.var(market[-n:], ddof=1), 1e-8)
                m20 = np.prod(1 + market[-20:]) - 1.0
                features[symbol]["residual"] = np.clip(features[symbol]["residual"] - beta * m20 / max(features[symbol]["vol"], .006), -3, 3)

    ranks = {f: rank_cs({s: features[s][f] for s in features}) for f in FACTORS}
    score = {s: sum(FACTOR_W[i] * ranks[FACTORS[i]][s] for i in range(len(FACTORS))) for s in UNIVERSE}
    if _previous is not None:
        score = {s: 0.70 * score[s] + 0.30 * _previous[s] for s in UNIVERSE}
    _previous = score.copy()

    median_vol = float(np.median([x["vol"] for x in features.values()]))
    breadth = float(np.mean([x["breakout120"] > 0 for x in features.values()]))
    stressed = median_vol > .018 or breadth < .40
    mean_invvol = float(np.mean([1.0 / x["vol"] for x in features.values()]))
    raw = {}
    for symbol in UNIVERSE:
        x = features.get(symbol, {"vol": median_vol, "breakout120": 0.0})
        inv_damp = np.clip((1.0 / x["vol"]) / max(mean_invvol, 1e-12), .80, 1.12)
        raw[symbol] = max(score[symbol], .05) * (.90 + .10 * inv_damp)
        if stressed:
            # Remain fully invested but rotate toward defensive tradable benchmarks.
            raw[symbol] *= 1.32 if symbol in DEFENSIVE else (.84 if x["breakout120"] < 0 else .76)
    target = bounded_weights(raw)
    if all(np.isfinite(target[s]) for s in UNIVERSE) and abs(sum(target.values()) - 1.0) < 1e-8:
        rebalance_to_weights(target)


