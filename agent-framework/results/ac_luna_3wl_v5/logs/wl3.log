 import numpy as np
from alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights

UNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
DEFENSIVE = {"XAU", "US10Y", "CN10Y"}
CADENCE = 10
MIN_W, MAX_W = 0.04, 0.16
FACTOR_W = {"cluster": .24, "medium_cluster": .18, "dispersion": .16,
            "macro": .14, "smooth": .10, "momentum": .10, "medium_reversal": .08}
CLUSTERS = {
    "equity": {"000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX"},
    "commodity": {"XAU", "COPPER", "WTI"}, "crypto": {"BTC", "ETH"},
    "rates": {"US10Y", "CN10Y"}}
_day = 0
_previous = None

def rank(x):
    out = {s: .5 for s in UNIVERSE}
    good = sorted((s, float(v)) for s, v in x.items() if np.isfinite(v))
    if not good: return out
    for i, (s, _) in enumerate(good): out[s] = (i + 1.) / len(good)
    return out

def bounded(raw):
    w = {s: max(float(raw.get(s, 1.)), 1e-12) for s in UNIVERSE}
    fixed = set()
    for _ in range(50):
        free = [s for s in UNIVERSE if s not in fixed]
        rem = 1. - sum(w[s] for s in fixed)
        z = sum(w[s] for s in free)
        for s in free: w[s] = rem * w[s] / max(z, 1e-12)
        hit = [s for s in free if w[s] < MIN_W or w[s] > MAX_W]
        if not hit: break
        for s in hit: w[s] = MIN_W if w[s] < MIN_W else MAX_W
        fixed.update(hit)
    z = sum(w.values())
    return {s: w[s] / z for s in UNIVERSE}

@register_hook
def cross_asset_strategy():
    global _day, _previous
    _day += 1
    if _day != 1 and (_day - 1) % CADENCE != 0: return
    data = {}
    for s in UNIVERSE:
        df = get_stock_daily_data(symbol=s, days=270)
        if df is None or len(df) < 160: continue
        c = np.asarray(df.sort_values("date")["close"], dtype=float)
        if len(c) < 160 or np.any(~np.isfinite(c)) or np.any(c <= 0): continue
        r = c[1:] / c[:-1] - 1.
        data[s] = {"r": r, "h5": np.prod(1+r[-5:])-1, "h10": np.prod(1+r[-10:])-1,
                   "h20": np.prod(1+r[-20:])-1, "h60": np.prod(1+r[-60:])-1,
                   "h120": np.prod(1+r[-120:])-1, "v20": max(np.std(r[-20:]), .006),
                   "v60": max(np.std(r[-60:]), .006)}
    if len(data) < 10: return
    med = {k: np.median([x[k] for x in data.values()]) for k in ("h10", "h20")}
    fac = {k: {} for k in FACTOR_W}
    for s, x in data.items():
        cl = next((k for k, v in CLUSTERS.items() if s in v), None)
        peers = [data[t]["r"][-20:] for t in data if t in CLUSTERS.get(cl, set())]
        peer = np.median(peers, axis=0) if peers else np.zeros(20)
        fac["cluster"][s] = -np.mean(x["r"][-5:] - peer[-5:]) / (x["v20"] + .01)
        fac["medium_cluster"][s] = -np.mean(x["r"][-20:] - peer) / (2*x["v20"] + .02)
        fac["dispersion"][s] = (med["h10"] - x["h10"]) / (x["v20"]*np.sqrt(10) + .02)
        fac["macro"][s] = (med["h20"] - x["h20"]) / (x["v60"]*np.sqrt(20) + .02)
        fac["smooth"][s] = -(x["h5"]*.5 + x["h10"]*.3 + x["h20"]*.2) / (x["v20"]*np.sqrt(20) + .02)
        fac["medium_reversal"][s] = -x["h20"] / (x["v60"]*np.sqrt(20) + .02)
        fac["momentum"][s] = .6*x["h60"]/(x["v60"]+.01) + .4*x["h120"]/(x["v60"]+.01)
    rr = {k: rank(v) for k, v in fac.items()}
    score = {s: sum(FACTOR_W[k]*rr[k].get(s, .5) for k in FACTOR_W) for s in UNIVERSE}
    if _previous is not None: score = {s: .55*score[s] + .45*_previous[s] for s in UNIVERSE}
    _previous = score.copy()
    breadth = np.mean([x["h120"] > 0 for x in data.values()])
    high_risk = np.median([x["v20"] for x in data.values()]) > .018 or breadth < .50
    invmean = np.mean([1./x["v20"] for x in data.values()])
    raw = {}
    for s in UNIVERSE:
        x = data.get(s, {"v20": .02, "h60": 0., "h120": 0.})
        iv = (1./x["v20"])/max(invmean, 1e-12) if s in data else 1.
        raw[s] = max(score[s], .15) * (.94 + .06*np.clip(iv, .7, 1.3))
        if high_risk and s in DEFENSIVE: raw[s] *= 1.8
        if high_risk and s not in DEFENSIVE and x["h60"] < -.08: raw[s] *= .86
        if high_risk and s not in DEFENSIVE and x["h120"] < -.12: raw[s] *= .90
    rebalance_to_weights(bounded(raw))


