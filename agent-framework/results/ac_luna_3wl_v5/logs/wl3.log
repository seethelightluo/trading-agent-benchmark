  ▶️ write_file({'content': 'import numpy as np\nfrom alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights\n\nUNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]\n# 2027-05-20 Screener ensemble: capped reversal cluster, with slower trend and peer diversification.\nFACTORS = {\n    "volstate3": 0.18, "scaled_rev5": 0.18, "medium_rev10": 0.12,\n    "trend10": 0.14, "skip120": 0.12, "vol_rev3": 0.10,\n    "disp_rev3": 0.08, "peer5": 0.08,\n}\nCADENCE = 10\nMIN_W, MAX_W = 0.03, 0.15\nDEFENSIVE = {"XAU", "US10Y", "CN10Y"}\n_previous = None\n_day = 0\n\n\ndef rank_factor(values):\n    valid = sorted((s, v) for s, v in values.items() if np.isfinite(v))\n    out = {s: 0.5 for s in UNIVERSE}\n    n = len(valid)\n    if n:\n        for i, (s, _) in enumerate(valid):\n            out[s] = (i + 1.0) / n\n    return out\n\n\ndef bounded(raw):\n    # Iterative water filling: exact full investment and sensible 3%-15% limits.\n    fixed, active = {}, set(UNIVERSE)\n    for _ in range(30):\n        left = 1.0 - sum(fixed.values())\n        den = sum(max(float(raw.get(s, 1e-6)), 1e-6) for s in active)\n        trial = {s: left * max(float(raw.get(s, 1e-6)), 1e-6) / den for s in active}\n        changed = False\n        for s, w in list(trial.items()):\n            if w < MIN_W:\n                fixed[s] = MIN_W; active.remove(s); changed = True\n            elif w > MAX_W:\n                fixed[s] = MAX_W; active.remove(s); changed = True\n        if not changed:\n            fixed.update(trial); break\n    # Bounds are feasible for 15 assets; normalize only numerical residue.\n    ans = {s: fixed.get(s, 0.0) for s in UNIVERSE}\n    z = sum(ans.values())\n    return {s: ans[s] / z for s in UNIVERSE}\n\n\n@register_hook\ndef cross_asset_strategy():\n    global _day, _previous\n    _day += 1\n    if _day != 1 and (_day - 1) % CADENCE != 0:\n        return\n\n    rets, vols = {}, {}\n    for s in UNIVERSE:\n        df = get_stock_daily_data(symbol=s, days=240)\n        if df is None or len(df) < 140:\n            continue\n        c = np.asarray(df.sort_values("date")["close"], dtype=float)\n        if len(c) < 140 or np.any(~np.isfinite(c)) or np.any(c <= 0):\n            continue\n        r = c[1:] / c[:-1] - 1.0\n        rets[s] = r\n        vols[s] = max(float(np.std(r[-30:])), 0.006)\n    if len(rets) < 10:\n        return\n\n    def cr(r, n):\n        return float(np.prod(1.0 + r[-n:]) - 1.0)\n    h = {n: {s: cr(r, n) for s, r in rets.items()} for n in (1, 3, 5, 10, 15, 20)}\n    syms = list(rets)\n    dispersion = float(np.std([h[3][s] for s in syms]))\n    f = {k: {} for k in FACTORS}\n    for s in syms:\n        v = vols[s]\n        peer5 = np.median([h[5][t] for t in syms if t != s])\n        peer3 = np.median([h[3][t] for t in syms if t != s])\n        peer15 = np.median([h[15][t] for t in syms if t != s])\n        f["scaled_rev5"][s] = np.clip(-h[5][s] / (v * np.sqrt(30) + 1e-6), -6, 6)\n        rev3 = -h[3][s] / (v * np.sqrt(3) + .01)\n        f["volstate3"][s] = rev3 * (1.0 + min(v / .02, 1.0))\n        f["vol_rev3"][s] = rev3 / (1.0 + 3.0 * v)\n        f["medium_rev10"][s] = -h[10][s] / (v * np.sqrt(10) + .01)\n        f["trend10"][s] = h[10][s] / (v * np.sqrt(10) + .01)\n        f["skip120"][s] = np.prod(1.0 + rets[s][-135:-15]) - 1.0\n        f["disp_rev3"][s] = (peer3 - h[3][s]) / (v * np.sqrt(3) + .01) * min(dispersion / .025, 1.0)\n        f["peer5"][s] = peer5 / (v * np.sqrt(5) + .01)\n\n    score = {s: sum(w * rank_factor(f[k])[s] for k, w in FACTORS.items()) for s in UNIVERSE}\n    if _previous is not None:\n        score = {s: .50 * score[s] + .50 * _previous.get(s, .5) for s in UNIVERSE}\n    _previous = score.copy()\n\n    breadth = np.mean([h[20][s] > 0 for s in syms])\n    stress = breadth < .50 or np.median(list(h[10].values())) < 0 or np.median(list(vols.values())) > .018\n    inv_mean = np.mean([1.0 / v for v in vols.values()])\n    raw = {}\n    for s in UNIVERSE:\n        invvol = (1.0 / vols.get(s, .02)) / inv_mean\n        raw[s] = max(score[s], .05) * (.90 + .10 * min(invvol, 1.20))\n        if stress and s in DEFENSIVE:\n            raw[s] *= 2.10\n        elif stress and h[20].get(s, 0.0) < -.08:\n            raw[s] *= .70\n    target = bounded(raw)\n    if all(np.isfinite(target[s]) for s in UNIVERSE) and abs(sum(target.values()) - 1.0) < 1e-8:\n        rebalance_to_weights(target)\n', 'file_path': 'strategy.py'})
