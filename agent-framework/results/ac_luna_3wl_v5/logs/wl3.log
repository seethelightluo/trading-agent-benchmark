["close"], dtype=float)\n        if np.any(~np.isfinite(c[-70:])) or np.any(c[-70:] <= 0):\n            continue\n        r = c[1:] / c[:-1] - 1.0\n        ret[s] = r\n        vol[s] = max(float(np.std(r[-20:])), 0.006)\n        bar[s] = df.iloc[-1]\n    if len(ret) < 10:\n        return\n\n    r1 = {s: r[-1] for s, r in ret.items()}\n    r5 = {s: float(np.prod(1 + r[-5:]) - 1) for s, r in ret.items()}\n    r10 = {s: float(np.prod(1 + r[-10:]) - 1) for s, r in ret.items()}\n    r20 = {s: float(np.prod(1 + r[-20:]) - 1) for s, r in ret.items()}\n    r40 = {s: float(np.prod(1 + r[-40:]) - 1) for s, r in ret.items()}\n    peer = list(ret)\n    eq = [s for s in UNIVERSE[:8] if s in ret]\n    eq_median = float(np.median([r40[s] for s in eq])) if eq else 0.0\n    breadth = float(np.mean([r20[s] > 0 for s in ret]))\n    stress = breadth < 0.50 or float(np.median(list(r10.values()))) < 0.0 or float(np.median(list(vol.values()))) > 0.018\n\n    f = {k: {} for k in FACTORS}\n    for s in ret:\n        v = vol[s]\n        peer5 = float(np.median([r5[t] for t in peer if t != s]))\n        reversal = -r1[s] / (v + 0.006)\n        f["lowvol_rev"][s] = reversal\n        f["volstate_rev"][s] = reversal * (1.0 + min(v / 0.02, 1.0))\n        f["peer"][s] = r5[s] - peer5\n        f["resid20"][s] = (r20[s] - peer5) / (v * np.sqrt(20.0) + 0.01)\n        f["eq_resid40"][s] = (r40[s] - eq_median) / (v * np.sqrt(40.0) + 0.02)\n        f["idio_rev"][s] = reversal - (r5[s] - peer5) / (v + 0.01)\n        h, lo, cl = float(bar[s].get("high", 0)), float(bar[s].get("low", 0)), float(bar[s]["close"])\n        f["clv"][s] = (2.0 * cl - h - lo) / (h - lo) if h > lo else 0.0\n\n    score = {s: sum(w * rank_factor(f[k])[s] for k, w in FACTORS.items()) for s in UNIVERSE}\n    if _previous is not None:\n        score = {s: 0.50 * score[s] + 0.50 * _previous.get(s, 0.5) for s in UNIVERSE}\n    _previous = score.copy()\n\n    defensive = {"XAU", "US10Y", "CN10Y"}\n    invmean = float(np.mean([1.0 / v for