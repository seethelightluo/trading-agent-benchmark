  ▶️ write_file({'content': 'import numpy as np\nfrom alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights\n\nUNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]\n# Current Screener ensemble: no more than 10 active factors.\nFACTORS = {"clv": .215, "peer": .165, "volume": .145, "mom": .125,\n           "blend": .148, "rev3": .075, "rev5": .127}\nMIN_W, MAX_W, CADENCE = .02, .14, 10\n_day = 0\n\ndef ranks(x):\n    good = [(s, v) for s, v in x.items() if np.isfinite(v)]\n    out = {s: .5 for s in UNIVERSE}\n    if not good: return out\n    good.sort(key=lambda z: z[1])\n    for i, (s, _) in enumerate(good): out[s] = (i + 1.) / len(good)\n    return out\n\ndef bounded(raw):\n    # Simple bounded simplex projection; preserves a complete 15-asset target.\n    w = {s: max(float(raw.get(s, 0.1)), 1e-12) for s in UNIVERSE}\n    fixed = {}\n    active = set(UNIVERSE)\n    for _ in range(30):\n        remain = 1.0 - sum(fixed.values())\n        z = sum(w[s] for s in active)\n        trial = {s: remain*w[s]/z for s in active}\n        clipped = False\n        for s, x in list(trial.items()):\n            if x < MIN_W:\n                fixed[s] = MIN_W; active.remove(s); clipped = True\n            elif x > MAX_W:\n                fixed[s] = MAX_W; active.remove(s); clipped = True\n        if not clipped:\n            fixed.update(trial); break\n    total = sum(fixed.values())\n    return {s: fixed.get(s, 0.0)/total for s in UNIVERSE}\n\n@register_hook\ndef cross_asset_strategy():\n    global _day\n    _day += 1\n    if _day != 1 and (_day - 1) % CADENCE != 0: return\n    returns, vol, raw = {}, {}, {k: {} for k in FACTORS}\n    for s in UNIVERSE:\n        df = get_stock_daily_data(symbol=s, days=150)\n        if df is None or len(df) < 35: continue\n        df = df.sort_values("date").reset_index(drop=True)\n        try:\n            c = np.asarray(df.close, float); o = np.asarray(df.open, float)\n            h = np.asarray(df.high, float); l = np.asarray(df.low, float)\n            volume = np.asarray(df.volume, float)\n        except Exception: continue\n        if len(c) < 35 or np.any(~np.isfinite(c[-35:])) or np.any(c[-35:] <= 0): continue\n        r = c[1:]/c[:-1]-1\n        sig = max(float(np.nanstd(r[-20:])), .008)\n        returns[s], vol[s] = r, sig\n        # Positive CLV is buying pressure; use the Screener direction (+1).\n        span = h[-1]-l[-1]\n        raw["clv"][s] = (2*c[-1]-h[-1]-l[-1])/span if span > 0 else 0.\n        raw["mom"][s] = (c[-1]/c[-21]-1)/(sig*np.sqrt(20)+.01)\n        med = np.nanmedian(volume[-21:-1])\n        boost = np.clip(volume[-1]/med, .75, 1.75) if np.isfinite(med) and med > 0 else 1.\n        raw["volume"][s] = (-r[-1]/sig)*(1+.35*max(boost-1, 0))\n        raw["rev3"][s] = -(np.prod(1+r[-3:])-1)/(sig*np.sqrt(3)+.005)\n        raw["rev5"][s] = -(np.prod(1+r[-5:])-1)/(sig*np.sqrt(5)+.005)\n    if len(returns) < 8: return\n    def cum(x, n): return float(np.prod(1+x[-n:])-1)\n    med5 = float(np.median([cum(x, 5) for x in returns.values()]))\n    for s, r in returns.items():\n        others = [cum(returns[t], 5) for t in returns if t != s]\n        # Lead-lag proxy: assets outperforming their leave-one-out peer median.\n        raw["peer"][s] = cum(r, 5)-float(np.median(others))\n        # Conditional blend: reversal in stress, momentum in calm conditions.\n        raw["blend"][s] = raw["rev3"][s] if med5 < 0 else raw["mom"][s]\n    rr = {k: ranks(v) for k, v in raw.items()}\n    score = {s: sum(FACTORS[k]*rr[k][s] for k in FACTORS) for s in UNIVERSE}\n    medvol = float(np.median(list(vol.values())))\n    breadth = float(np.mean([cum(r, 20) > 0 for r in returns.values()]))\n    stress = medvol > .018 or breadth < .45\n    invavg = float(np.mean([1/x for x in vol.values()]))\n    defensives = {"XAU", "US10Y", "CN10Y"}\n    raw_target = {}\n    for s in UNIVERSE:\n        damp = min((1/vol.get(s, medvol))/invavg, 1.5)\n        raw_target[s] = max(score[s], .05)*(.85+.15*damp)\n        if stress and s in defensives: raw_target[s] *= 1.15\n    rebalance_to_weights(bounded(raw_target))\n', 'file_path': 'strategy.py'})
