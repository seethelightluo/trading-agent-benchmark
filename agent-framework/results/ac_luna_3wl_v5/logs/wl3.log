  ▶️ write_file({'content': 'import numpy as np\nfrom alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights\n\nUNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]\nDEFENSIVE = {"XAU", "US10Y", "CN10Y"}\nCADENCE = 10\nMIN_W, MAX_W = 0.035, 0.18\n# Screener 2028-04-20: up-day dominance, vol-normalized breakout, excess momentum.\nFACTOR_W = (0.615, 0.292, 0.093)\n_day = 0\n_previous = None\n\ndef ranks(vals):\n    valid = sorted((s, v) for s, v in vals.items() if np.isfinite(v))\n    out = {s: 0.5 for s in UNIVERSE}\n    n = len(valid)\n    if n:\n        for i, (s, _) in enumerate(valid):\n            out[s] = (i + 1.0) / n\n    return out\n\ndef bounded(raw):\n    # Iterative projection preserves a complete, long-only, fully invested target.\n    w = {s: max(float(raw.get(s, 1.0)), 1e-12) for s in UNIVERSE}\n    fixed = set()\n    for _ in range(30):\n        free = [s for s in UNIVERSE if s not in fixed]\n        rem = 1.0 - sum(w[s] for s in fixed)\n        denom = sum(w[s] for s in free)\n        for s in free:\n            w[s] = rem * w[s] / max(denom, 1e-12)\n        hit = [s for s in free if w[s] < MIN_W or w[s] > MAX_W]\n        if not hit:\n            break\n        for s in hit:\n            w[s] = MIN_W if w[s] < MIN_W else MAX_W\n        fixed.update(hit)\n    z = sum(w.values())\n    return {s: w[s] / z for s in UNIVERSE}\n\n@register_hook\ndef cross_asset_strategy():\n    global _day, _previous\n    _day += 1\n    if _day != 1 and (_day - 1) % CADENCE:\n        return\n    obs = {}\n    for s in UNIVERSE:\n        df = get_stock_daily_data(symbol=s, days=260)\n        if df is None or len(df) < 140:\n            continue\n        c = np.asarray(df.sort_values("date")["close"], dtype=float)\n        if len(c) < 140 or np.any(~np.isfinite(c)) or np.any(c <= 0):\n            continue\n        r = c[1:] / c[:-1] - 1.0\n        v = max(float(np.std(r[-20:])), 0.006)\n        # Use completed observations only; the simulator supplies data through yesterday.\n        obs[s] = {"r": r, "v": v,\n                  "h20": float(np.prod(1 + r[-20:]) - 1),\n                  "h60": float(np.prod(1 + r[-60:]) - 1),\n                  "up30": float(np.mean(r[-30:] > 0))}\n    if len(obs) < 10:\n        return\n    med20 = float(np.median([x["h20"] for x in obs.values()]))\n    med60 = float(np.median([x["h60"] for x in obs.values()]))\n    breadth = float(np.mean([x["h60"] > 0 for x in obs.values()]))\n    dominance = {s: x["up30"] + .20 * np.tanh(x["h60"] / (3*x["v"] + .02)) for s, x in obs.items()}\n    breakout = {s: (x["h60"] - med60) / (x["v"] * np.sqrt(60) + .03) for s, x in obs.items()}\n    excess = {s: (x["h20"] - med20) / (x["v"] * np.sqrt(20) + .02) for s, x in obs.items()}\n    rd, rb, re = map(ranks, (dominance, breakout, excess))\n    score = {s: FACTOR_W[0]*rd[s] + FACTOR_W[1]*rb[s] + FACTOR_W[2]*re[s] for s in UNIVERSE}\n    # Moderate turnover and avoid reacting to one noisy ten-day block.\n    if _previous is not None:\n        score = {s: .70*score[s] + .30*_previous[s] for s in UNIVERSE}\n    _previous = score.copy()\n    medvol = float(np.median([x["v"] for x in obs.values()]))\n    high_risk = medvol > .018 or breadth < .45\n    invmean = float(np.mean([1/x["v"] for x in obs.values()]))\n    raw = {}\n    for s in UNIVERSE:\n        x = obs.get(s, {"v": medvol, "h60": 0.0})\n        iv = (1/x["v"])/max(invmean, 1e-12) if s in obs else 1.0\n        raw[s] = max(score[s], .10) * (.90 + .10*np.clip(iv, .65, 1.35))\n        if high_risk and s in DEFENSIVE:\n            raw[s] *= 2.0\n        if high_risk and s not in DEFENSIVE and x["h60"] < -.08:\n            raw[s] *= .82\n    rebalance_to_weights(bounded(raw))\n', 'file_path': 'strategy.py'})
