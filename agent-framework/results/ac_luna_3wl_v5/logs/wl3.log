  ▶️ write_file({'content': "import pandas as pd,numpy as np\nfrom scipy.stats import spearmanr\nU=['000300.SH','SPX','HSI','N225','SX5E','000688.SH','SOX','NDX','XAU','COPPER','WTI','BTC','ETH','US10Y','CN10Y']\ndef dat(s):\n d=pd.read_csv('../persistent/stock_data/'+s+'.csv');d.date=pd.to_datetime(d.date);return d[d.date<='2026-07-15'].set_index('date').close\nP=pd.DataFrame({s:dat(s) for s in U}).sort_index();R=P.pct_change()\n# Per-asset next-observation return avoids leaking through global-calendar shifts.\nFWD=pd.DataFrame({s:P[s].shift(-1)/P[s]-1 for s in U})\nfor look in [3,5]:\n vol=R.rolling(20,min_periods=15).std()\n rr=R.rolling(look,min_periods=look).sum(); rel=rr.sub(rr.median(axis=1),axis=0)\n F=-rel/vol\n rows=[]\n for dt in R.index:\n  z=pd.concat([F.loc[dt],FWD.loc[dt]],axis=1).dropna();z.columns=['f','y']\n  if len(z)>=8 and z.f.nunique()>1:rows.append((dt,spearmanr(z.f,z.y).statistic,len(z)))\n q=pd.DataFrame(rows,columns=['date','ic','n']).set_index('date');ic=q.ic\n print('look',look,'dates',len(ic),'avgN',q.n.mean(),'coverage',q.n.sum()/(len(ic)*15),'IC',ic.mean(),'ICIR',ic.mean()/ic.std(),'hit',(ic>0).mean())\n for a,b in [('2020','2022'),('2023','2024'),('2025','2026')]:\n  x=ic.loc[a:b];print('regime',a,b,'IC',x.mean(),'ICIR',x.mean()/x.std(),'n',len(x))\n for h in [5,10]:\n  # forward cumulative next h valid observations for each asset\n  fh=pd.DataFrame({s:P[s].shift(-h)/P[s]-1 for s in U}); vals=[]\n  for dt in R.index:\n   z=pd.concat([F.loc[dt],fh.loc[dt]],axis=1).dropna()\n   if len(z)>=8 and z.iloc[:,0].nunique()>1:vals.append(spearmanr(z.iloc[:,0],z.iloc[:,1]).statistic)\n  x=pd.Series(vals).dropna();print('decay',h,x.mean(),x.mean()/x.std(),len(x))\n", 'file_path': 'scripts/miner_1_20260730_relative_vol_dispersion.py'})
