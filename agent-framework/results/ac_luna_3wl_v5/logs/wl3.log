 import numpy as np
from alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights

UNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
# 2026-07-30 screener ensemble; eight active factors, all long-only ranks.
FACTORS = {"clv": 0.20, "peer": 0.18, "mom": 0.18, "volrev": 0.13,
           "rev5": 0.12, "dispersion": 0.08, "macrorev": 0.06, "downrev": 0.05}
MIN_W, MAX_W, REBALANCE_DAYS = 0.02, 0.14, 10
_day = 0


def cross_rank(values):
    valid = sorted((s, float(x)) for s, x in values.items() if np.isfinite(x))
    out = {s: 0.5 for s in UNIVERSE}
    for i, (s, _) in enumerate(valid):
        out[s] = (i + 1.0) / len(valid)
    return out


def bounded_simplex(raw):
    # Projection onto the full-investment simplex with practical 2%-14% bounds.
    out = {s: max(float(raw.get(s, 1.0 / len(UNIVERSE))), 1e-12) for s in UNIVERSE}
    fixed, active = {}, set(UNIVERSE)
    for _ in range(50):
        remaining = 1.0 - sum(fixed.values())
        denom = sum(out[s] for s in active)
        if denom <= 0 or remaining < 0:
            return {s: 1.0 / len(UNIVERSE) for s in UNIVERSE}
        trial = {s: remaining * out[s] / denom for s in active}
        clipped = False
        for s, x in list(trial.items()):
            if x < MIN_W:
                fixed[s], clipped = MIN_W, True; active.remove(s)
            elif x > MAX_W:
                fixed[s], clipped = MAX_W, True; active.remove(s)
        if not clipped:
            fixed.update(trial)
            break
    total = sum(fixed.values())
    return {s: fixed.get(s, 0.0) / total for s in UNIVERSE}


def compound(r, n):
    return float(np.prod(1.0 + r[-n:]) - 1.0) if len(r) >= n else np.nan


@register_hook
def cross_asset_strategy():
    global _day
    _day += 1
    # One proposal per ten-trading-day block; preserve actual holdings between decisions.
    if _day != 1 and (_day - 1) % REBALANCE_DAYS != 0:
        return

    returns, volatility, signal = {}, {}, {f: {} for f in FACTORS}
    for symbol in UNIVERSE:
        df = get_stock_daily_data(symbol=symbol, days=160)
        if df is None or len(df) < 45:
            continue
        df = df.sort_values("date").reset_index(drop=True)
        close = np.asarray(df["close"], dtype=float)
        high = np.asarray(df["high"], dtype=float)
        low = np.asarray(df["low"], dtype=float)
        volume = np.asarray(df["volume"], dtype=float)
        if np.any(~np.isfinite(close[-45:])) or np.any(close[-45:] <= 0):
            continue
        r = close[1:] / close[:-1] - 1.0
        vol = max(float(np.nanstd(r[-20:])), 0.008)
        returns[symbol], volatility[symbol] = r, vol
        span = high[-1] - low[-1]
        signal["clv"][symbol] = (2 * close[-1] - high[-1] - low[-1]) / span if span > 0 else 0.0
        signal["mom"][symbol] = compound(r, 20) / (vol * np.sqrt(20) + 0.01)
        signal["rev5"][symbol] = -compound(r, 5) / (vol * np.sqrt(5) + 0.005)
        downside = max(float(np.std(np.minimum(r[-10:], 0.0))), 0.004)
        signal["downrev"][symbol] = -compound(r, 3) / (downside * np.sqrt(3) + 0.005)
        medvol = np.nanmedian(volume[-21:-1])
        boost = np.clip(volume[-1] / medvol, 0.75, 1.5) if medvol > 0 else 1.0
        signal["volrev"][symbol] = (-r[-1] / vol) * (1 + 0.20 * max(boost - 1, 0))

    # Small cross-section is intentional: use all available tradable benchmarks.
    if len(returns) < 8:
        return
    r5 = {s: compound(r, 5) for s, r in returns.items()}
    r3 = {s: compound(r, 3) for s, r in returns.items()}
    med5, med3 = np.median(list(r5.values())), np.median(list(r3.values()))
    for s in returns:
        peers = [r5[t] for t in returns if t != s]
        signal["peer"][s] = r5[s] - (np.median(peers) if peers else med5)
        # Tradable cross-asset residual proxies; observation-only macro series are not ordered.
        signal["dispersion"][s] = -(r3[s] - med3)
        signal["macrorev"][s] = -(r3[s] - med3) / (volatility[s] + 0.01)

    ranks = {f: cross_rank(signal[f]) for f in FACTORS}
    score = {s: sum(FACTORS[f] * ranks[f][s] for f in FACTORS) for s in UNIVERSE}
    median_vol = float(np.median(list(volatility.values())))
    breadth = float(np.mean([compound(returns[s], 20) > 0 for s in returns]))
    stressed = median_vol > 0.018 or breadth < 0.45
    inv_mean = float(np.mean([1.0 / v for v in volatility.values()]))
    raw = {}
    for s in UNIVERSE:
        risk_scale = min((1.0 / volatility[s]) / inv_mean, 1.5)
        raw[s] = max(score[s], 0.05) * (0.85 + 0.15 * risk_scale)
        if stressed and s in {"XAU", "US10Y", "CN10Y"}:
            raw[s] *= 1.15
    target = bounded_simplex(raw)
    if all(np.isfinite(target[s]) and target[s] >= 0 for s in UNIVERSE) and abs(sum(target.values()) - 1) < 1e-8:
        rebalance_to_weights(target)


