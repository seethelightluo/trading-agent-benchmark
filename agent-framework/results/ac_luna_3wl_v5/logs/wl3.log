 d=get_stock_daily_data(s,days=3000)
 if d is not None:
  d=d[pd.to_datetime(d.date)<=END]
  if len(d)>120: px[s]=d.set_index('date').close.astype(float)
p=pd.concat(px,axis=1).sort_index().ffill(); r=p.pct_change(); vol=r.rolling(20,min_periods=10).std()
# Candidate: medium-term momentum, volatility-normalized and excluding the most recent 5 days.
f=p.pct_change(60).subtract(p.pct_change(5),axis=0)/vol
ics=[]; cov=[]; turnovers=[]; d5=[]; d10=[]
for i in range(len(p)-11):
 q=pd.concat([f.iloc[i].rename('f'),r.iloc[i+1].rename('y')],axis=1).dropna()
 if len(q)>=8 and q.f.nunique()>1 and q.y.nunique()>1:
  ics.append(spearmanr(q.f,q.y).statistic); cov.append(len(q)/len(U))
  for h,out in [(5,d5),(10,d10)]:
   qh=pd.concat([f.iloc[i].rename('f'),p.pct_change(h).iloc[i+h].rename('y')],axis=1).dropna()
   if len(qh)>=8 and qh.f.nunique()>1 and qh.y.nunique()>1: out.append(spearmanr(qh.f,qh.y).statistic)
  if i:
   z=pd.concat([f.iloc[i],f.iloc[i-1]],axis=1).dropna()
   if len(z)>=8: turnovers.append((z.iloc[:,0].rank()!=z.iloc[:,1].rank()).mean())
x=np.array(ics)
print('candidate=volscaled_medium_momentum dates',len(x),'avg_names',np.mean(cov)*len(U),'coverage',np.mean(cov),'IC %.8f ICIR %.8f hit %.5f turnover %.5f decay5 %.8f decay10 %.8f'%(x.mean(),x.mean()/x.std(ddof=1),(x>0).mean(),np.mean(turnovers),np.mean(d5),np.mean(d10)))
for label,z in [('2020-22',x[:len(x)//3]),('2023-24',x[len(x)//3:2*len(x)//3]),('2025-26',x[2*len(x)//3:]),('recent250',x[-250:])]: print(label,'dates',len(z),'IC %.8f ICIR %.8f hit %.5f'%(z.mean(),z.mean()/z.std(ddof=1),(z>0).mean()))
