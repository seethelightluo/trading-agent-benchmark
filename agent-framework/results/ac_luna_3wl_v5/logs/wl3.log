  ▶️ write_file({'content': 'import numpy as np\nfrom alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights\n\nUNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]\n# Current screener ensemble (9 active factors; all supplied directions are +1).\nFACTORS = {\n    "volstate": .22, "lowvol": .16, "medium": .12, "leadlag": .12,\n    "dispersion": .10, "conditional": .10, "idio": .08,\n    "skipmom": .06, "eqresid": .04\n}\nCADENCE = 10\nMIN_W, MAX_W = .03, .15\n_previous = None\n_day = 0\n\n\ndef _rank(vals):\n    valid = sorted((s, float(v)) for s, v in vals.items() if np.isfinite(v))\n    out = {s: .5 for s in UNIVERSE}\n    for i, (s, _) in enumerate(valid):\n        out[s] = (i + 1.0) / len(valid)\n    return out\n\n\ndef _bounded(raw):\n    # Iterative water-filling: always emits all 15 assets, long-only, sum exactly 1.\n    fixed, active = {}, set(UNIVERSE)\n    for _ in range(50):\n        left = 1.0 - sum(fixed.values())\n        den = sum(max(float(raw.get(s, .01)), 1e-9) for s in active)\n        trial = {s: left * max(float(raw.get(s, .01)), 1e-9) / den for s in active}\n        changed = False\n        for s, w in list(trial.items()):\n            if w < MIN_W:\n                fixed[s] = MIN_W; active.remove(s); changed = True\n            elif w > MAX_W:\n                fixed[s] = MAX_W; active.remove(s); changed = True\n        if not changed:\n            fixed.update(trial); break\n    total = sum(fixed.values())\n    return {s: fixed.get(s, 0.0) / total for s in UNIVERSE}\n\n\n@register_hook\ndef cross_asset_strategy():\n    global _day, _previous\n    _day += 1\n    if _day != 1 and (_day - 1) % CADENCE != 0:\n        return\n\n    rets, vols, lastbar = {}, {}, {}\n    for s in UNIVERSE:\n        df = get_stock_daily_data(symbol=s, days=240)\n        if df is None or len(df) < 130:\n            continue\n        df = df.sort_values("date")\n        close = np.asarray(df["close"], dtype=float)\n        if np.any(~np.isfinite(close)) or np.any(close <= 0):\n            continue\n        r = close[1:] / close[:-1] - 1.0\n        rets[s] = r\n        vols[s] = max(float(np.std(r[-20:])), .006)\n        lastbar[s] = df.iloc[-1]\n    if len(rets) < 10:\n        return\n\n    def cum(r, n):\n        return float(np.prod(1.0 + r[-n:]) - 1.0)\n    symbols = list(rets)\n    r1 = {s: rets[s][-1] for s in symbols}\n    horizons = {n: {s: cum(rets[s], n) for s in symbols} for n in (3, 5, 10, 15, 20, 40)}\n    # Skip momentum uses only the 90-day window ending 15 sessions before today.\n    skip = {s: float(np.prod(1.0 + rets[s][-105:-15]) - 1.0) for s in symbols}\n    eq = [s for s in UNIVERSE[:8] if s in rets]\n    eqmed = float(np.median([horizons[40][s] for s in eq]))\n    fac = {k: {} for k in FACTORS}\n    dispersion = float(np.std([horizons[5][s] for s in symbols]))\n    for s in symbols:\n        v = vols[s]\n        peer5 = np.median([horizons[5][t] for t in symbols if t != s])\n        peer15 = np.median([horizons[15][t] for t in symbols if t != s])\n        rev = -r1[s] / (v + .006)\n        fac["volstate"][s] = rev * (1.0 + min(v / .02, 1.0))\n        fac["lowvol"][s] = rev / (1.0 + 2.0 * v)\n        fac["medium"][s] = -horizons[10][s] / (v * np.sqrt(10) + .01)\n        fac["leadlag"][s] = peer5 / (v * np.sqrt(5) + .01)\n        fac["dispersion"][s] = (peer5 - horizons[5][s]) / (v * np.sqrt(5) + .01) * min(dispersion / .025, 1.0)\n        fac["conditional"][s] = (-horizons[15][s] / (v * np.sqrt(15) + .01)) if peer15 < 0 else 0.0\n        fac["idio"][s] = rev - (horizons[5][s] - peer5) / (v + .01)\n        fac["skipmom"][s] = skip[s] / (v * np.sqrt(75) + .02)\n        fac["eqresid"][s] = -(horizons[40][s] - eqmed) / (v * np.sqrt(40) + .02)\n    score = {s: sum(w * _rank(fac[k])[s] for k, w in FACTORS.items()) for s in UNIVERSE}\n    if _previous is not None:\n        score = {s: .50 * score[s] + .50 * _previous.get(s, .5) for s in UNIVERSE}\n    _previous = score.copy()\n\n    breadth = np.mean([horizons[20][s] > 0 for s in symbols])\n    stress = breadth < .50 or np.median(list(horizons[10].values())) < 0 or np.median(list(vols.values())) > .018\n    defensive = {"XAU", "US10Y", "CN10Y"}\n    mean_iv = np.mean([1.0 / v for v in vols.values()])\n    raw = {}\n    for s in UNIVERSE:\n        iv = (1.0 / vols.get(s, .02)) / mean_iv\n        raw[s] = max(score[s], .05) * (.90 + .10 * min(iv, 1.20))\n        if stress and s in defensive:\n            raw[s] *= 2.10\n        elif stress and horizons[20].get(s, 0.0) < -.08:\n            raw[s] *= .70\n    target = _bounded(raw)\n    if all(np.isfinite(target[s]) for s in UNIVERSE) and abs(sum(target.values()) - 1.0) < 1e-8:\n        rebalance_to_weights(target)\n', 'file_path': 'strategy.py'})
