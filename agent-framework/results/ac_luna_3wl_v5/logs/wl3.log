 import numpy as np
from alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights

UNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
# Screener ensemble, capped at eight active factors.
FACTORS = {"clv": .18, "peer": .16, "res20": .14, "volrev": .12,
           "mom": .14, "blend": .10, "rev5": .10, "downrev3": .06}
MIN_W, MAX_W, CADENCE = .02, .14, 10
_day = 0

def rank(values):
    valid = sorted((s, v) for s, v in values.items() if np.isfinite(v))
    out = {s: .5 for s in UNIVERSE}
    n = len(valid)
    if n:
        for i, (s, _) in enumerate(valid):
            out[s] = (i + 1.0) / n
    return out

def bounded(raw):
    # Iterative projection onto the non-negative, bounded unit simplex.
    w = {s: max(float(raw.get(s, .05)), 1e-12) for s in UNIVERSE}
    fixed, active = {}, set(UNIVERSE)
    for _ in range(40):
        left = 1.0 - sum(fixed.values())
        z = sum(w[s] for s in active)
        trial = {s: left * w[s] / z for s in active}
        clipped = False
        for s, x in list(trial.items()):
            if x < MIN_W:
                fixed[s] = MIN_W; active.remove(s); clipped = True
            elif x > MAX_W:
                fixed[s] = MAX_W; active.remove(s); clipped = True
        if not clipped:
            fixed.update(trial); break
    total = sum(fixed.values())
    return {s: fixed.get(s, 0.0) / total for s in UNIVERSE}

def cumulative(r, n):
    return float(np.prod(1.0 + r[-n:]) - 1.0)

@register_hook
def cross_asset_strategy():
    global _day
    _day += 1
    if _day != 1 and (_day - 1) % CADENCE != 0:
        return
    ret, vol, sigs = {}, {}, {k: {} for k in FACTORS}
    for s in UNIVERSE:
        df = get_stock_daily_data(symbol=s, days=160)
        if df is None or len(df) < 45:
            continue
        df = df.sort_values("date").reset_index(drop=True)
        try:
            c, o = np.asarray(df.close, float), np.asarray(df.open, float)
            h, l = np.asarray(df.high, float), np.asarray(df.low, float)
            q = np.asarray(df.volume, float)
        except Exception:
            continue
        if np.any(~np.isfinite(c[-45:])) or np.any(c[-45:] <= 0):
            continue
        r = c[1:] / c[:-1] - 1.0
        v = max(float(np.nanstd(r[-20:])), .008)
        ret[s], vol[s] = r, v
        span = h[-1] - l[-1]
        sigs["clv"][s] = (2*c[-1]-h[-1]-l[-1]) / span if span > 0 else 0.0
        sigs["peer"][s] = 0.0  # filled after the cross-section is assembled
        sigs["res20"][s] = 0.0
        sigs["mom"][s] = cumulative(r, 20) / (v*np.sqrt(20)+.01)
        sigs["rev5"][s] = -cumulative(r, 5) / (v*np.sqrt(5)+.005)
        downside = max(float(np.std(np.minimum(r[-10:], 0.0))), .004)
        sigs["downrev3"][s] = -cumulative(r, 3) / (downside*np.sqrt(3)+.005)
        medq = np.nanmedian(q[-21:-1]) if len(q) >= 21 else np.nan
        boost = np.clip(q[-1]/medq, .75, 1.75) if np.isfinite(medq) and medq > 0 else 1.0
        sigs["volrev"][s] = (-r[-1]/v) * (1.0 + .25*max(boost-1.0, 0.0))
    if len(ret) < 8:
        return
    r5 = {s: cumulative(x, 5) for s, x in ret.items()}
    r20 = {s: cumulative(x, 20) for s, x in ret.items()}
    for s in ret:
        peers = [r5[t] for t in ret if t != s]
        peers20 = [r20[t] for t in ret if t != s]
        sigs["peer"][s] = r5[s] - float(np.median(peers))
        sigs["res20"][s] = -(r20[s] - float(np.median(peers20)))
    median5 = float(np.median(list(r5.values())))
    for s in ret:
        sigs["blend"][s] = sigs["rev5"][s] if median5 < 0 else sigs["mom"][s]
    ranks = {k: rank(v) for k, v in sigs.items()}
    score = {s: sum(FACTORS[k] * ranks[k][s] for k in FACTORS) for s in UNIVERSE}
    median_vol = float(np.median(list(vol.values())))
    breadth = float(np.mean([r20[s] > 0 for s in ret]))
    stress = median_vol > .018 or breadth < .45
    inv_mean = float(np.mean([1.0/x for x in vol.values()]))
    raw = {}
    for s in UNIVERSE:
        vv = vol.get(s, median_vol)
        risk_scale = min((1.0/vv)/inv_mean, 1.5)
        raw[s] = max(score[s], .05) * (.85 + .15*risk_scale)
        if stress and s in {"XAU", "US10Y", "CN10Y"}:
            raw[s] *= 1.15
    rebalance_to_weights(bounded(raw))
