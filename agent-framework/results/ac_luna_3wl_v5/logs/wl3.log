(),'coverage',len(a)/(len(U)*a.date.nunique()))\nfor lo,hi in [('2020','2022-12-31'),('2023','2024-12-31'),('2025','2026-09-09')]:\n v=z.loc[lo:hi].ic; print('regime_period',lo,hi,'n',len(v),'IC',v.mean(),'ICIR',v.mean()/v.std(ddof=1))\nfor h in [3,5,10]:\n prices=pd.concat([load(s).close.rename(s) for s in U],axis=1); f=prices.shift(-h).div(prices)-1\n b=a[['date','symbol','signal']].merge(f.stack().rename('fwd').reset_index().rename(columns={0:'fwd'}),on=['date','symbol']).dropna(); zz,nn=ev(b); print('decay',h,'n',len(zz),'IC',zz.ic.mean(),'ICIR',zz.ic.mean()/zz.ic.std(ddof=1))\na.to_csv('scripts/miner_1_20260910_conditional_dispersion_signal.csv',index=False)\n", 'file_path': 'scripts/miner_1_20260910_conditional_dispersion.py'})
