:-1] - 1.\n        ret[s] = r; vol[s] = max(float(np.std(r[-20:])), .006)\n    if len(ret) < 10: return\n    r1 = {s: r[-1] for s, r in ret.items()}\n    r3 = {s: float(np.prod(1+r[-3:])-1) for s, r in ret.items()}\n    r5 = {s: float(np.prod(1+r[-5:])-1) for s, r in ret.items()}\n    r10 = {s: float(np.prod(1+r[-10:])-1) for s, r in ret.items()}\n    r20 = {s: float(np.prod(1+r[-20:])-1) for s, r in ret.items()}\n    r40 = {s: float(np.prod(1+r[-40:])-1) for s, r in ret.items()}\n    dispersion = float(np.std(list(r1.values())))\n    breadth = float(np.mean([x > 0 for x in r20.values()]))\n    high_risk = breadth < .45 or np.median(list(vol.values())) > .018 or np.median(list(r5.values())) < 0\n    eq = [s for s in UNIVERSE[:8] if s in ret]\n    bench = float(np.median([r40[s] for s in eq])) if eq else float(np.median(list(r40.values())))\n    f = {k: {} for k in FACTORS}\n    for s in ret:\n        v = vol[s]\n        f["volstate"][s] = -r1[s] / (v+.006) * (1+min(v/.02, 1))\n        f["idio"][s] = -r1[s] / (v+.004)\n        f["shortrev"][s] = -r1[s] / (v+.006)\n        f["mom20"][s] = r20[s] / (v*np.sqrt(20)+.01)\n        # trend-confirmed momentum: require agreement of 10d and 3d direction\n        f["mom10"][s] = (r10[s] / (v*np.sqrt(10)+.008)) + .25*np.sign(r3[s])*np.sign(r10[s])\n        peers = [r5[t] for t in ret if t != s]\n        f["leadlag"][s] = r5[s] - (np.median(peers) if peers else 0.)\n        f["residual"][s] = (r40[s]-bench) / (v*np.sqrt(40)+.02)\n        f["dispersion"][s] = -r1[s]/(v+.006) * min(dispersion/.012, 1.5)\n    ranks = {k: rank_map(v) for k, v in f.items()}\n    score = {s: sum(FACTORS[k]*ranks[k].get(s,.5) for k in FACTORS) for s in ret}\n    if _previous is not None: score = {s: .65*score[s]+.35*_previous.get(s,.5) for s in score}\n    _previous = score.copy()\n    invmean = np.mean([1./v for v in vol.values()])\n    defensive = {"XAU", "US10Y", "CN10Y"}\n    raw = {}\n    for s in UNIVERSE:\n        inv = min((1./vol.get(s,.02))/invmean, 1.25)\n        raw[s] = max(score.get(s,.5), .05) * (.88+.12*inv)\n        if high_risk and s in defensive: raw[s] *= 1.35\n    target = cap_weights(raw)\n    if len(target) == 15 and all(np.isfinite(v) and v >= 0 for v in target.values()):\n        rebalance_to_weights(target)\n', 'file_path': 'strategy.py'})
