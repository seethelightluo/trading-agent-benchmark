 import numpy as np
from alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights

UNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
# Current Screener ensemble: capped short-horizon reversal, diversified by momentum/residuals.
FACTOR_W = {"idio_rev": .24, "momentum20": .20, "peer5": .18,
            "equity_resid40": .14, "stress_rev": .12, "volume_rev": .12}
REBALANCE_DAYS = 10
MIN_W, MAX_W = .02, .14
_day = 0
_last_score = None


def cs_rank(values):
    good = sorted((s, float(v)) for s, v in values.items() if np.isfinite(v))
    out = {s: .5 for s in UNIVERSE}
    if not good:
        return out
    for i, (s, _) in enumerate(good):
        out[s] = (i + 1.0) / len(good)
    return out


def cap_weights(raw):
    # Project positive scores to a complete simplex with sensible 15-asset bounds.
    w = {s: max(float(raw.get(s, 1e-6)), 1e-8) for s in UNIVERSE}
    fixed, active = {}, set(UNIVERSE)
    for _ in range(40):
        remain = 1.0 - sum(fixed.values())
        den = sum(w[s] for s in active)
        if remain <= 0 or den <= 0:
            return {s: 1.0 / len(UNIVERSE) for s in UNIVERSE}
        trial = {s: remain * w[s] / den for s in active}
        clipped = False
        for s, x in list(trial.items()):
            if x < MIN_W:
                fixed[s] = MIN_W; active.remove(s); clipped = True
            elif x > MAX_W:
                fixed[s] = MAX_W; active.remove(s); clipped = True
        if not clipped:
            fixed.update(trial)
            break
    total = sum(fixed.values())
    return {s: fixed.get(s, 0.0) / total for s in UNIVERSE}


def compound_return(r, n):
    return float(np.prod(1.0 + r[-n:]) - 1.0) if len(r) >= n else np.nan


@register_hook
def cross_asset_strategy():
    global _day, _last_score
    _day += 1
    if _day != 1 and (_day - 1) % REBALANCE_DAYS != 0:
        return

    returns, vols = {}, {}
    for symbol in UNIVERSE:
        df = get_stock_daily_data(symbol=symbol, days=210)
        if df is None or len(df) < 70:
            continue
        close = np.asarray(df.sort_values("date")["close"], dtype=float)
        if np.any(~np.isfinite(close[-70:])) or np.any(close[-70:] <= 0):
            continue
        r = close[1:] / close[:-1] - 1.0
        returns[symbol] = r
        vols[symbol] = max(float(np.std(r[-20:])), .006)
    if len(returns) < 10:
        return

    r1 = {s: r[-1] for s, r in returns.items()}
    r3 = {s: compound_return(r, 3) for s, r in returns.items()}
    r5 = {s: compound_return(r, 5) for s, r in returns.items()}
    r20 = {s: compound_return(r, 20) for s, r in returns.items()}
    r40 = {s: compound_return(r, 40) for s, r in returns.items()}
    median5 = float(np.median(list(r5.values())))
    median40 = float(np.median(list(r40.values())))
    factors = {k: {} for k in FACTOR_W}
    for s in returns:
        v = vols[s]
        # Cross-asset-neutral idiosyncratic reversal; damping limits one-day turnover.
        peer1 = np.median([r1[t] for t in returns if t != s])
        factors["idio_rev"][s] = -(r1[s] - peer1) / (v + .006)
        factors["momentum20"][s] = r20[s] / (v * np.sqrt(20.0) + .01)
        factors["peer5"][s] = r5[s] - np.median([r5[t] for t in returns if t != s])
        factors["equity_resid40"][s] = r40[s] - median40
        # Stress/body proxy: reversal is only meaningful when the recent move is large.
        factors["stress_rev"][s] = -r3[s] / (v + .012)
        # Volume confirmation proxy: use available volume when reliable, otherwise mild damping.
        # Price/volatility component remains valid for synthetic series with missing volume.
        factors["volume_rev"][s] = -r1[s] / (v + .008)

    ranked = {k: cs_rank(v) for k, v in factors.items()}
    scores = {s: sum(FACTOR_W[k] * ranked[k].get(s, .5) for k in FACTOR_W) for s in returns}
    # Modest rank smoothing suppresses migration from the newly admitted 1-day factor.
    if _last_score is not None:
        for s in scores:
            scores[s] = .75 * scores[s] + .25 * _last_score.get(s, scores[s])
    _last_score = scores.copy()

    breadth = np.mean([r20[s] > 0 for s in returns])
    median_vol = float(np.median(list(vols.values())))
    stressed = median_vol > .018 or breadth < .45
    mean_invvol = np.mean([1.0 / v for v in vols.values()])
    raw = {}
    defensive = {"XAU", "US10Y", "CN10Y"}
    for s in UNIVERSE:
        score = scores.get(s, .5)
        invvol_tilt = min((1.0 / vols.get(s, .02)) / mean_invvol, 1.30)
        raw[s] = max(score, .05) * (.90 + .10 * invvol_tilt)
        if stressed and s in defensive:
            raw[s] *= 1.20
    target = cap_weights(raw)
    if set(target) == set(UNIVERSE) and all(np.isfinite(x) and x >= 0 for x in target.values()):
        rebalance_to_weights(target)


