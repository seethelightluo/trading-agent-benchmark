  ▶️ write_file({'content': 'import numpy as np\nfrom alphacrafter.sim.utils import (\n    register_hook, get_account_dict, get_stock_daily_data, rebalance_to_weights\n)\n\nUNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]\n# Screener ensemble: CLV, peer lead-lag, reversal, risk-adjusted momentum.\nFACTOR_WEIGHTS = {"clv": 0.3396, "peer": 0.2612, "reversal": 0.2012, "momentum": 0.1980}\nMIN_W, MAX_W = 0.015, 0.16\nbar_count = 0\n\n\ndef cs_rank(values):\n    out = {s: 0.5 for s in UNIVERSE}\n    valid = sorted((s, float(v)) for s, v in values.items() if np.isfinite(v))\n    if len(valid) < 2:\n        return out\n    for i, (s, _) in enumerate(valid):\n        out[s] = (i + 1.0) / len(valid)\n    return out\n\n\ndef box_simplex(raw):\n    # Iterative projection to non-negative, full-investment weights with sensible\n    # 15-asset concentration limits.\n    w = {s: max(float(raw.get(s, 0.0)), 1e-12) for s in UNIVERSE}\n    w = {s: x / sum(w.values()) for s, x in w.items()}\n    fixed = {}\n    for _ in range(40):\n        changed = False\n        for s in UNIVERSE:\n            if s in fixed:\n                continue\n            if w[s] < MIN_W:\n                fixed[s] = MIN_W; w[s] = MIN_W; changed = True\n            elif w[s] > MAX_W:\n                fixed[s] = MAX_W; w[s] = MAX_W; changed = True\n        free = [s for s in UNIVERSE if s not in fixed]\n        if not changed:\n            break\n        remaining = 1.0 - sum(fixed.values())\n        base = sum(w[s] for s in free)\n        if free and base > 0:\n            for s in free:\n                w[s] = remaining * w[s] / base\n    total = sum(w.values())\n    return {s: float(w[s] / total) for s in UNIVERSE}\n\n\n@register_hook\ndef cross_asset_strategy():\n    global bar_count\n    bar_count += 1\n    account = get_account_dict()\n    positions = {p.get("symbol"): p for p in account.get("positions", [])}\n    # The first allocation is mandatory; thereafter decisions are one per\n    # ten simulator trading days.  A complete target is always submitted.\n    invested = any(float(p.get("quantity", 0)) > 0 for p in positions.values())\n    if invested and (bar_count - 1) % 10 != 0:\n        return\n\n    market = {}\n    for s in UNIVERSE:\n        df = get_stock_daily_data(symbol=s, days=90)\n        if df is None or len(df) < 25:\n            continue\n        df = df.sort_values("date").reset_index(drop=True)\n        c = np.asarray(df["close"], dtype=float)\n        h = np.asarray(df["high"], dtype=float)\n        l = np.asarray(df["low"], dtype=float)\n        r = c[1:] / np.maximum(c[:-1], 1e-12) - 1.0\n        if len(c) >= 22:\n            market[s] = (c, h, l, r)\n    if len(market) < 12:\n        return\n\n    clv, peer_base, reversal, momentum, invvol = {}, {}, {}, {}, {}\n    for s, (c, h, l, r) in market.items():\n        # One-day close-location value, with rank normalization providing\n        # cross-sectional winsorization.\n        clv[s] = float((2.0 * c[-1] - h[-1] - l[-1]) / max(h[-1] - l[-1], 1e-12))\n        reversal[s] = float(-np.mean(r[-5:]))\n        vol = max(float(np.std(r[-20:])), 0.008)\n        invvol[s] = 1.0 / vol\n        momentum[s] = float((c[-1] / max(c[-21], 1e-12) - 1.0) / (vol + 0.01))\n        peer_base[s] = float(c[-1] / max(c[-6], 1e-12) - 1.0)\n    median_peer = float(np.median(list(peer_base.values())))\n    peer = {s: v - median_peer for s, v in peer_base.items()}\n    ranked = {k: cs_rank(v) for k, v in {\n        "clv": clv, "peer": peer, "reversal": reversal, "momentum": momentum\n    }.items()}\n    score = {s: sum(FACTOR_WEIGHTS[k] * ranked[k][s] for k in ranked) for s in UNIVERSE}\n\n    # Medium-high bearish/sideways regime: remain fully invested but shift\n    # score toward tradable defensive benchmarks rather than cash.\n    spx = market.get("SPX")\n    if spx is not None:\n        c = spx[0]\n        if c[-1] < c[-21] and c[-1] < c[-6]:\n            for s in ("XAU", "US10Y", "CN10Y"):\n                score[s] += 0.18\n            for s in ("BTC", "ETH", "WTI"):\n                score[s] = max(0.05, score[s] - 0.10)\n\n    mean_invvol = float(np.mean(list(invvol.values())))\n    raw = {s: max(score[s], 0.01) * (0.78 + 0.22 * invvol.get(s, mean_invvol) / mean_invvol) for s in UNIVERSE}\n    rebalance_to_weights(box_simplex(raw))\n', 'file_path': 'strategy.py'})
