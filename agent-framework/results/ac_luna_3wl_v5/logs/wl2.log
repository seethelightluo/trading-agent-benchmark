 import numpy as np
from alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights

ASSETS = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
FACTORS = {
    "breadth_trend": 0.18, "relative_mom": 0.16, "consistency_mom": 0.14,
    "recovery": 0.14, "switch": 0.12, "recovery_accel": 0.09,
    "persistence": 0.08, "downvol": 0.05, "downbreadth": 0.04
}
REBALANCE_DAYS = 10
MIN_W, MAX_W = 0.04, 0.14
_day = 0


def ranks(values):
    out = {s: 0.5 for s in ASSETS}
    good = sorted((s, v) for s, v in values.items() if np.isfinite(v))
    if good:
        for i, (s, _) in enumerate(good):
            out[s] = (i + 1.0) / len(good)
    return out


def bounded(raw):
    raw = {s: max(float(raw.get(s, 0.01)), 1e-8) for s in ASSETS}
    w = {s: MIN_W + (1 - len(ASSETS) * MIN_W) * raw[s] / sum(raw.values()) for s in ASSETS}
    for _ in range(30):
        over = [s for s in ASSETS if w[s] > MAX_W + 1e-12]
        if not over:
            break
        excess = sum(w[s] - MAX_W for s in over)
        for s in over:
            w[s] = MAX_W
        rest = [s for s in ASSETS if s not in over]
        den = sum(raw[s] for s in rest)
        if den <= 0:
            break
        for s in rest:
            w[s] += excess * raw[s] / den
    z = sum(w.values())
    return {s: w[s] / z for s in ASSETS}


@register_hook
def cross_asset_strategy():
    global _day
    _day += 1
    if (_day - 1) % REBALANCE_DAYS != 0:
        return
    data = {}
    for s in ASSETS:
        df = get_stock_daily_data(symbol=s, days=230)
        if df is None or len(df) < 100:
            continue
        c = np.asarray(df.sort_values("date").iloc[:-1]["close"], dtype=float)
        if len(c) < 65 or np.any(~np.isfinite(c[-65:])) or np.any(c[-65:] <= 0):
            continue
        r = c[1:] / c[:-1] - 1.0
        vol = max(float(np.std(r[-20:])), 0.006)
        neg = r[-30:][r[-30:] < 0]
        t5, t10 = c[-1] / c[-6] - 1, c[-1] / c[-11] - 1
        t20, t30, t60 = c[-1] / c[-21] - 1, c[-1] / c[-31] - 1, c[-1] / c[-61] - 1
        consistency = float(np.mean(r[-20:] > 0))
        breadth = float(np.mean(r[-20:] > 0))
        data[s] = {
            "breadth_trend": t30 / (vol + .01) * (.35 + .65 * breadth),
            "relative_mom": t20 / vol * (.4 + .6 * consistency),
            "consistency_mom": t20 / vol * consistency,
            "recovery": t5 - .30 * min(t30, 0),
            "switch": t10 / (vol + .01) if t30 >= 0 else -t5 / (vol + .01),
            "recovery_accel": (t10 - t30) / (vol + .01),
            "persistence": t30 / (vol + .01) * (.4 + .6 * consistency),
            "downvol": -(float(np.std(neg)) if len(neg) > 1 else vol),
            "downbreadth": -(0.6 * np.mean(r[-20:] < 0) + 0.4 * np.mean(r[-60:] < 0)),
            "vol": vol, "t30": t30
        }
    if len(data) < 10:
        return
    rr = {f: ranks({s: x[f] for s, x in data.items()}) for f in FACTORS}
    score = {s: sum(FACTORS[f] * rr[f][s] for f in FACTORS) for s in ASSETS}
    medvol = float(np.median([x["vol"] for x in data.values()]))
    market_breadth = float(np.mean([x["t30"] > 0 for x in data.values()]))
    # High-risk sideways/bear regime: defensive tradables replace cash.
    stressed = medvol > 0.018 or market_breadth < 0.60
    if stressed:
        for s in ("XAU", "US10Y", "CN10Y"):
            score[s] += 0.28
        for s in ("BTC", "ETH", "WTI"):
            score[s] *= 0.55
    raw = {s: (max(score[s], 0.03) * np.clip(medvol / data[s]["vol"], .70, 1.25)
               if s in data else 0.03) for s in ASSETS}
    target = bounded(raw)
    if all(np.isfinite(target[s]) and target[s] >= 0 for s in ASSETS) and abs(sum(target.values()) - 1.0) < 1e-8:
        rebalance_to_weights(target)


def strategy():
    return cross_asset_strategy()


