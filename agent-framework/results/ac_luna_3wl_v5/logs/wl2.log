import numpy as np
from alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights

ASSETS = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
FACTORS = {"clv1": .240, "leadlag5": .210, "rev5": .170, "mom20": .160, "down20": .085, "rev3": .075, "clvtrend15": .060}
MIN_W, MAX_W = .02, .15
_day = 0

def cs_rank(values):
    out = {s: .5 for s in ASSETS}
    good = sorted((s, float(v)) for s, v in values.items() if np.isfinite(v))
    if len(good) > 1:
        for i, (s, _) in enumerate(good): out[s] = (i + 1.0) / len(good)
    return out

def make_weights(scores):
    w = {s: MIN_W for s in ASSETS}
    free, active = 1.0 - MIN_W * len(ASSETS), set(ASSETS)
    while active and free > 1e-12:
        q = {s: max(float(scores.get(s, .5)), .01) for s in active}
        total = sum(q.values())
        capped = [s for s in active if free * q[s] / total > MAX_W - MIN_W]
        if not capped:
            for s in active: w[s] += free * q[s] / total
            break
        for s in capped:
            w[s] = MAX_W; free -= MAX_W - MIN_W; active.remove(s)
    z = sum(w.values())
    return {s: w[s] / z for s in ASSETS}

@register_hook
def cross_asset_strategy():
    global _day
    _day += 1
    if (_day - 1) % 10 != 0: return
    data = {}
    for s in ASSETS:
        df = get_stock_daily_data(symbol=s, days=100)
        if df is None or len(df) < 35: continue
        df = df.sort_values("date")
        c, h, l = (np.asarray(df[x], float) for x in ("close", "high", "low"))
        if len(c) < 32 or not np.all(np.isfinite(c[-32:])) or c[-1] <= 0: continue
        r = c[1:] / np.maximum(c[:-1], 1e-12) - 1
        vol, dvol = max(float(np.std(r[-20:])), .008), max(float(np.std(np.minimum(r[-20:], 0))), .004)
        clv = (2*c[-1] - h[-1] - l[-1]) / max(h[-1] - l[-1], 1e-12)
        clv_hist = (2*c[-15:] - h[-15:] - l[-15:]) / np.maximum(h[-15:] - l[-15:], 1e-12)
        data[s] = dict(clv=clv, r5=c[-1]/c[-6]-1, rev5=-float(np.mean(r[-5:])), rev3=-float(np.mean(r[-3:])), mom20=(c[-1]/c[-21]-1)/(vol+.01), down20=(c[-1]/c[-21]-1)/(dvol+.01), clvtrend15=float(np.mean(clv_hist)), trend=c[-1]/c[-31]-1, invvol=1/vol)
    if len(data) < 10: return
