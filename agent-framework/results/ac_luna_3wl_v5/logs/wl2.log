 import numpy as np
from alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights

ASSETS = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
# Screener 2028-06-15 ensemble: quiet trend, acceleration, relative-risk trend, downside trend.
FACTORS = {"quiet": 0.38, "accel": 0.24, "risk20": 0.20, "down60": 0.18}
REBALANCE_DAYS = 10
MIN_W, MAX_W = 0.04, 0.14
_day = 0

def cross_rank(values):
    valid = sorted((s, v) for s, v in values.items() if np.isfinite(v))
    out = {s: 0.5 for s in ASSETS}
    if valid:
        n = len(valid)
        for i, (s, _) in enumerate(valid):
            out[s] = (i + 1.0) / n
    return out

def bounded_weights(raw):
    raw = {s: max(1e-6, float(raw.get(s, 1e-6))) for s in ASSETS}
    w = {s: MIN_W + (1 - len(ASSETS) * MIN_W) * raw[s] / sum(raw.values()) for s in ASSETS}
    for _ in range(20):
        over = [s for s in ASSETS if w[s] > MAX_W]
        if not over:
            break
        excess = sum(w[s] - MAX_W for s in over)
        for s in over:
            w[s] = MAX_W
        rest = [s for s in ASSETS if s not in over]
        den = sum(raw[s] for s in rest)
        for s in rest:
            w[s] += excess * raw[s] / den
    total = sum(w.values())
    return {s: w[s] / total for s in ASSETS}

@register_hook
def cross_asset_strategy():
    global _day
    _day += 1
    if (_day - 1) % REBALANCE_DAYS != 0:
        return
    feat = {}
    for s in ASSETS:
        df = get_stock_daily_data(symbol=s, days=220)
        if df is None or len(df) < 90:
            continue
        d = df.sort_values("date")
        # The final row is not used: decisions use only completed historical bars.
        c = np.asarray(d.iloc[:-1]["close"], dtype=float)
        if len(c) < 65 or np.any(~np.isfinite(c[-65:])) or np.any(c[-65:] <= 0):
            continue
        r = c[1:] / c[:-1] - 1.0
        r10, r20, r30, r60 = r[-10:], r[-20:], r[-30:], r[-60:]
        vol = max(float(np.std(r20)), 0.006)
        downside = r60[r60 < 0]
        dvol = max(float(np.std(downside)) if len(downside) > 1 else float(np.std(r60)), 0.006)
        t10 = c[-1] / c[-11] - 1.0
        t20 = c[-1] / c[-21] - 1.0
        t30 = c[-1] / c[-31] - 1.0
        t60 = c[-1] / c[-61] - 1.0
        consistency = float(np.mean(r30 > 0))
        feat[s] = {"quiet": t30 / (vol + 0.01) * (0.5 + 0.5 * consistency),
                   "accel": (t10 - t20) / (vol + 0.01),
                   "risk20": t20 / vol,
                   "down60": t60 / dvol, "t30": t30, "vol": vol}
    if len(feat) < 10:
        return
    ranks = {k: cross_rank({s: x[k] for s, x in feat.items()}) for k in FACTORS}
    score = {s: sum(FACTORS[k] * ranks[k][s] for k in FACTORS) for s in ASSETS}
    breadth = np.mean([x["t30"] > 0 for x in feat.values()])
    medvol = float(np.median([x["vol"] for x in feat.values()]))
    # Strong bearish/high-volatility overlay: remain fully invested in defensives.
    if breadth < 0.60 or medvol > 0.018:
        for s in ("XAU", "US10Y", "CN10Y"):
            score[s] += 0.45
        for s in ("BTC", "ETH", "WTI"):
            score[s] *= 0.45
    invvol = {s: medvol / feat[s]["vol"] for s in feat}
    raw = {s: max(0.05, score[s]) * np.clip(invvol.get(s, 1.0), 0.65, 1.35) for s in ASSETS}
    target = bounded_weights(raw)
    if abs(sum(target.values()) - 1.0) < 1e-8 and all(np.isfinite(v) and v >= 0 for v in target.values()):
        rebalance_to_weights(target)

def strategy():
    return cross_asset_strategy()


