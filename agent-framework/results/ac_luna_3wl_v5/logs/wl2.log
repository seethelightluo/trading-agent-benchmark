ASSETS = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
# Current screener ensemble; all factors are implemented as lagged price/volatility proxies.
FACTORS = {"quiet": .21, "compression": .18, "relative": .15, "residual": .12,
           "stress": .10, "accel": .10, "breadth": .08, "downside": .06}
CADENCE = 10
_day = 0

def rank_cs(values):
    valid = [(s, float(v)) for s, v in values.items() if np.isfinite(v)]
    out = {s: .5 for s in ASSETS}
    if not valid:
        return out
    valid.sort(key=lambda x: x[1])
    n = len(valid)
    for i, (s, _) in enumerate(valid):
        out[s] = (i + 1.0) / n
    return out

def make_weights(score):
    # Full investment, modest diversification, and no integer/lot constraints.
    floor, cap = .02, .22
    x = {s: max(float(score.get(s, .5)), 1e-8) for s in ASSETS}
    w = {s: floor + (1-floor*len(ASSETS))*x[s]/sum(x.values()) for s in ASSETS}
    for _ in range(30):
        high = [s for s in ASSETS if w[s] > cap + 1e-12]
        if not high:
            break
        excess = sum(w[s]-cap for s in high)
        for s in high:
            w[s] = cap
        rest = [s for s in ASSETS if s not in high]
        den = sum(x[s] for s in rest)
        for s in rest:
            w[s] += excess*x[s]/max(den, 1e-12)
    total = sum(w.values())
    return {s: w[s]/total for s in ASSETS}

@register_hook
def cross_asset_strategy():
    global _day
    _day += 1
    if (_day - 1) % CADENCE != 0:
        return
    feat = {}
    for s in ASSETS:
        df = get_stock_daily_data(symbol=s, days=270)
        if df is None or len(df) < 100:
            continue
        close = np.asarray(df.sort_values("date").iloc[:-1]["close"], dtype=float)
        close = close[np.isfinite(close) & (close > 0)]
        if len(close) < 80:
            continue
        r = close[1:]/close[:-1]-1.0
        v10=max(float(np.std(r[-10:])), .003)
        v20=max(float(np.std(r[-20:])), .003)
        v60=max(float(np.std(r[-60:])), .003)
        t5=close[-1]/close[-6]-1; t10=close[-1]/close[-11]-1
        t20=close[-1]/close[-21]-1; t30=close[-1]/close[-31]-1
        t60=close[-1]/close[-61]-1
        neg=r[-30:][r[-30:] < 0]
        dn=max(float(np.std(neg)) if len(neg)>2 else v20, .003)
        feat[s] = {"t5":t5,"t10":t10,"t20":t20,"t30":t30,"t60":t60,
                   "v10":v10,"v20":v20,"v60":v60,"dn":dn}
    if len(feat) < 10:
        return
    # Market-relative 5-day residual, with a trend-agreement gate.
    market5=float(np.mean([d["t5"] for d in feat.values()]))
    raw={}
    for s,d in feat.items():
        agree=np.mean([d["t10"]>0, d["t20"]>0, d["t60"]>0])
        raw[s] = {
          "quiet": (d["t20"]/(d["v60"]+.01))*abs(d["t20"])/(np.sum(abs(r[-20:]))+1e-9) if False else (d["t20"]/(d["v60"]+.01))*abs(d["t20"]),
          "compression": -d["v10"]/(d["v60"]+.003),
          "relative": d["t20"]/(d["v20"]+.01),
          "residual": (-((d["t5"]-market5))/(d["v20"]+.01)) * (0.5+0.5*agree),
          "stress": (d["t10"] if d["t30"] >= 0 else -d["t10"])/(d["v20"]+.01),
          "accel": d["t10"]/(d["v10"]+.01)-d["t20"]/(d["v20"]+.01),
          "breadth": d["t30"]/(d["v60"]+.01),
          "downside": -d["dn"]/(d["v20"]+.01)}
    ranks={f:rank_cs({s:raw[s][f] for s in raw}) for f in FACTORS}
    score={s:sum(FACTORS[f]*ranks[f][s] for f in FACTORS) for s in ASSETS}
    breadth=float(np.mean([d["t30"]>0 for d in feat.values()]))
    spx30=feat.get("SPX",{}).get("t30",0.0)
    bear=breadth < .45 or spx30 < -.05
    if bear:
        intensity=min(1.0, max(0.0,(.45-breadth)*1.8)+max(0.0,(-spx30-.02)/.18))
        for s in ("XAU","US10Y","CN10Y"):
            score[s] *= 1.0 + .9*intensity
        for s in ("BTC","ETH","WTI","SOX","NDX","COPPER"):
            score[s] *= max(.18, 1.0-.70*intensity)
    med=float(np.median([d["v20"] for d in feat.values()]))
    for s in ASSETS:
        score[s]=max(.01,score[s])*np.clip(med/max(feat.get(s,{}).get("v20",med),.003),.70,1.25)
    target=make_weights(score)
    if set(target)==set(ASSETS) and all(np.isfinite(v) and v>=0 for v in target.values()) and abs(sum(target.values())-1)<1e-8:
        rebalance_to_weights(target)

def strategy():
    return cross_asset_strategy()


