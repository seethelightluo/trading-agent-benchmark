 import numpy as np
from alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights

ASSETS = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
FACTORS = {"quiet": .24, "down60": .16, "risk20": .14, "consistency": .12,
           "switch": .12, "breadth": .12, "highvol": .10}
REBALANCE_DAYS = 10
MIN_W, MAX_W = .04, .14
_day = 0

def ranks(vals):
    good = sorted((s, v) for s, v in vals.items() if np.isfinite(v))
    out = {s: .5 for s in ASSETS}
    for i, (s, _) in enumerate(good):
        out[s] = (i + 1.) / len(good)
    return out

def bounded(raw):
    raw = {s: max(float(raw.get(s, .01)), 1e-8) for s in ASSETS}
    free = 1.0 - len(ASSETS) * MIN_W
    w = {s: MIN_W + free * raw[s] / sum(raw.values()) for s in ASSETS}
    for _ in range(20):
        over = [s for s in ASSETS if w[s] > MAX_W + 1e-12]
        if not over: break
        excess = sum(w[s] - MAX_W for s in over)
        for s in over: w[s] = MAX_W
        rest = [s for s in ASSETS if s not in over]
        den = sum(raw[s] for s in rest)
        for s in rest: w[s] += excess * raw[s] / den
    z = sum(w.values())
    return {s: w[s] / z for s in ASSETS}

@register_hook
def cross_asset_strategy():
    global _day
    _day += 1
    if (_day - 1) % REBALANCE_DAYS: return
    feat = {}
    for s in ASSETS:
        df = get_stock_daily_data(symbol=s, days=220)
        if df is None or len(df) < 90: continue
        c = np.asarray(df.sort_values("date").iloc[:-1]["close"], dtype=float)
        if len(c) < 65 or np.any(~np.isfinite(c[-65:])) or np.any(c[-65:] <= 0): continue
        r = c[1:] / c[:-1] - 1
        vol20 = max(float(np.std(r[-20:])), .006)
        vol60 = max(float(np.std(r[-60:])), .006)
        neg = r[-60:][r[-60:] < 0]
        dvol = max(float(np.std(neg)) if len(neg) > 1 else vol60, .006)
        t10, t20, t30, t60 = c[-1]/c[-11]-1, c[-1]/c[-21]-1, c[-1]/c[-31]-1, c[-1]/c[-61]-1
        cons = float(np.mean(r[-30:] > 0))
        feat[s] = {"quiet": t30/(vol20+.01) * (.5+.5*cons),
                   "down60": t60/dvol, "risk20": t20/vol20,
                   "consistency": t30/(vol20+.01)*cons,
                   "trend10": t10/(vol20+.01), "breadth": float(np.mean(r[-20:] > 0)),
                   # persistent volatility is deliberately capped in the score
                   "highvol": min(vol20/(vol60+.006), 2.0),
                   "t30": t30, "vol": vol20}
    if len(feat) < 10: return
    medvol = float(np.median([x["vol"] for x in feat.values()]))
    breadth = float(np.mean([x["t30"] > 0 for x in feat.values()]))
    stressed = medvol > .018 or breadth < .45
    # In stress, switch factor rewards stable/defensive short-term leadership;
    # it is not a short position or a cash substitute.
    for x in feat.values(): x["switch"] = -x["trend10"] if stressed else x["trend10"]
    rr = {k: ranks({s: x[k] for s, x in feat.items()}) for k in FACTORS}
    score = {s: sum(FACTORS[k] * rr[k][s] for k in FACTORS) for s in ASSETS}
    if stressed or breadth < .60:
        for s in ("XAU", "US10Y", "CN10Y"): score[s] += .45
        for s in ("BTC", "ETH", "WTI"): score[s] *= .45
    invvol = {s: np.clip(medvol/x["vol"], .65, 1.35) for s, x in feat.items()}
    raw = {s: max(.05, score[s]) * invvol.get(s, 1.) for s in ASSETS}
    target = bounded(raw)
    if all(np.isfinite(v) and v >= 0 for v in target.values()) and abs(sum(target.values())-1) < 1e-8:
        rebalance_to_weights(target)

def strategy():
    return cross_asset_strategy()


