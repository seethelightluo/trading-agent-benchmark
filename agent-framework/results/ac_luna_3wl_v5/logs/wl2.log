 import numpy as np
from alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights

ASSETS = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
# Screener ensemble (nine active factors; all are lagged at the decision date).
FACTORS = {
    "eff20": .20, "mom30": .15, "down20": .15, "rev1": .12,
    "mom20c": .10, "resid30": .10, "ram20": .08,
    "persist30": .07, "clv1": .03
}
REBALANCE_DAYS = 10
POSITION_SCALING = .45
MIN_W, MAX_W = .04, .14
_day = 0


def cs_rank(values):
    valid = sorted((s, float(v)) for s, v in values.items() if np.isfinite(v))
    out = {s: .5 for s in ASSETS}
    if not valid:
        return out
    n = len(valid)
    for i, (s, _) in enumerate(valid):
        out[s] = (i + 1.0) / n
    return out


def bounded_weights(score, invvol):
    raw = {s: max(.10, .5 + POSITION_SCALING * (score[s] - .5)) *
              np.clip(invvol.get(s, 1.), .70, 1.30) for s in ASSETS}
    w = {s: MIN_W + (1 - len(ASSETS) * MIN_W) * raw[s] / sum(raw.values()) for s in ASSETS}
    # Iterative capped redistribution; preserves a complete, long-only vector.
    for _ in range(20):
        over = [s for s in ASSETS if w[s] > MAX_W + 1e-10]
        if not over:
            break
        excess = sum(w[s] - MAX_W for s in over)
        for s in over:
            w[s] = MAX_W
        free = [s for s in ASSETS if s not in over]
        den = sum(raw[s] for s in free)
        if not free or den <= 0:
            break
        for s in free:
            w[s] += excess * raw[s] / den
    z = sum(w.values())
    return {s: max(0., w[s] / z) for s in ASSETS}


@register_hook
def cross_asset_strategy():
    global _day
    _day += 1
    if (_day - 1) % REBALANCE_DAYS != 0:
        return

    features = {}
    for s in ASSETS:
        df = get_stock_daily_data(symbol=s, days=190)
        if df is None or len(df) < 70:
            continue
        df = df.sort_values("date")
        # Exclude the still-forming/current bar: no look-ahead.
        c = np.asarray(df["close"], dtype=float)[:-1]
        hi = np.asarray(df["high"], dtype=float)[:-1]
        lo = np.asarray(df["low"], dtype=float)[:-1]
        if len(c) < 65 or np.any(c[-65:] <= 0):
            continue
        r = c[1:] / c[:-1] - 1.
        vol20 = max(float(np.std(r[-20:])), .006)
        downside = max(float(np.std(np.minimum(r[-20:], 0.0))), .003)
        t20, t30 = c[-1] / c[-21] - 1., c[-1] / c[-31] - 1.
        p30 = float(np.mean(r[-30:] > 0))
        bar = np.maximum(hi[-30:] - lo[-30:], c[-30:] * .001) / c[-30:]
        rng = max(float(np.mean(bar)), .002)
        # Three-session averaging dampens the admitted high-turnover 1D reversal.
        rev1 = float(np.mean(-r[-3:]) / vol20)
        clv = float(np.mean((2*c[-3:] - hi[-3:] - lo[-3:]) /
                            np.maximum(hi[-3:] - lo[-3:], c[-3:] * .001)))
        features[s] = {
            "eff20": t20 / (downside + .015),
            "mom30": t30 / (vol20 + .01) * (.5 + p30),
            "down20": t20 / (downside + .01),
            "rev1": rev1, "mom20c": t20 / (vol20 + .01) * (.5 + np.mean(r[-20:] > 0)),
            "ram20": t20 / (vol20 + .01),
            "persist30": t30 / (rng + .01) * (.5 + p30),
            "clv1": clv, "vol": vol20, "t30": t30
        }
    if len(features) < 10:
        return

    # Residual momentum: remove the contemporaneous equity-benchmark cross-section.
    eq = [s for s in ("000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX") if s in features]
    benchmark = float(np.median([features[s]["t30"] for s in eq])) if eq else 0.
    for v in features.values():
        v["resid30"] = v["t30"] - benchmark
    ranks = {k: cs_rank({s: v.get(k, np.nan) for s, v in features.items()}) for k in FACTORS}
    score = {s: sum(FACTORS[k] * ranks[k][s] for k in FACTORS) for s in ASSETS}
    breadth = float(np.mean([features[s]["t30"] > 0 for s in eq])) if eq else .5
    market_vol = float(np.median([v["vol"] for v in features.values()]))
    # Bear/high-risk posture: defensive tradable assets replace cash; risk assets are capped indirectly.
    if breadth < .50 or market_vol > .018:
        for s in ("XAU", "US10Y", "CN10Y"):
            if s in score:
                score[s] += .12
        for s in ("BTC", "ETH", "WTI"):
            if s in score:
                score[s] -= .06
    invvol = {s: np.clip(market_vol / max(v["vol"], .006), .70, 1.30) for s, v in features.items()}
    rebalance_to_weights(bounded_weights(score, invvol))


def strategy():
    return cross_asset_strategy()


