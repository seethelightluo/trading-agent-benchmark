 import numpy as np
from alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights

ASSETS = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
# Screener ensemble, capped at six active factors.
FACTORS = {"clv": .270, "leadlag": .220, "rev5": .170, "mom20": .170, "rev3": .090, "down20": .080}
MIN_WEIGHT, MAX_WEIGHT = .020, .150
_day = 0


def cs_rank(vals):
    result = {s: .5 for s in ASSETS}
    good = sorted((s, v) for s, v in vals.items() if np.isfinite(v))
    if len(good) > 1:
        for i, (s, _) in enumerate(good):
            result[s] = (i + 1.) / len(good)
    return result


def bounded_weights(scores):
    w = {s: MIN_WEIGHT for s in ASSETS}
    active = set(ASSETS)
    left = 1. - MIN_WEIGHT * len(ASSETS)
    while active and left > 1e-12:
        denom = sum(max(scores[s], .01) for s in active)
        capped = [s for s in active if left * max(scores[s], .01) / denom > MAX_WEIGHT - MIN_WEIGHT]
        if not capped:
            for s in active:
                w[s] += left * max(scores[s], .01) / denom
            break
        for s in capped:
            w[s] = MAX_WEIGHT
            left -= MAX_WEIGHT - MIN_WEIGHT
            active.remove(s)
    total = sum(w.values())
    return {s: w[s] / total for s in ASSETS}


@register_hook
def cross_asset_strategy():
    global _day
    _day += 1
    # One proposal per ten-trading-day block; the helper handles no-trade gates.
    if (_day - 1) % 10:
        return
    data = {}
    for s in ASSETS:
        df = get_stock_daily_data(symbol=s, days=95)
        if df is None or len(df) < 35:
            continue
        df = df.sort_values("date").reset_index(drop=True)
        c = df["close"].to_numpy(float)
        h = df["high"].to_numpy(float)
        l = df["low"].to_numpy(float)
        if len(c) < 32 or not np.all(np.isfinite(c[-32:])) or c[-1] <= 0:
            continue
        r = c[1:] / np.maximum(c[:-1], 1e-12) - 1.
        vol = max(float(np.std(r[-20:])), .008)
        dvol = max(float(np.std(np.minimum(r[-20:], 0.))), .004)
        data[s] = {
            "clv": (2*c[-1]-h[-1]-l[-1]) / max(h[-1]-l[-1], 1e-12),
            "r5": c[-1] / max(c[-6], 1e-12)-1.,
            "rev5": -float(np.mean(r[-5:])),
            "rev3": -float(np.mean(r[-3:])),
            "mom20": (c[-1]/max(c[-21],1e-12)-1.)/(vol+.01),
            "down20": (c[-1]/max(c[-21],1e-12)-1.)/(dvol+.01),
            "invvol": 1./vol,
            "trend": c[-1]/max(c[-31],1e-12)-1.
        }
    # Small missing-data gaps receive neutral ranks; still submit all 15 assets.
    if len(data) < 10:
        return
    median5 = float(np.median([x["r5"] for x in data.values()]))
    raw = {
        "clv": {s:x["clv"] for s,x in data.items()},
        "leadlag": {s:x["r5"]-median5 for s,x in data.items()},
        "rev5": {s:x["rev5"] for s,x in data.items()},
        "mom20": {s:x["mom20"] for s,x in data.items()},
        "rev3": {s:x["rev3"] for s,x in data.items()},
        "down20": {s:x["down20"] for s,x in data.items()}
    }
    ranks = {f:cs_rank(v) for f,v in raw.items()}
    score = {s:sum(FACTORS[f]*ranks[f][s] for f in FACTORS) for s in ASSETS}

    eq = [data[s] for s in ("000300.SH","SPX","HSI","N225","SX5E","NDX") if s in data]
    breadth = sum(x["trend"] < 0 for x in eq) / max(1, len(eq))
    if breadth >= .5 or (data.get("SPX",{}).get("trend",0) < 0 and data.get("SPX",{}).get("r5",0) < 0):
        # Defensive tradable assets substitute for cash in the bearish regime.
        for s in ("XAU", "US10Y", "CN10Y"):
            score[s] += .10
        for s in ("BTC", "ETH", "WTI"):
            score[s] = max(.02, score[s]-.05)

    med_iv = float(np.median([x["invvol"] for x in data.values()]))
    for s in ASSETS:
        iv = data.get(s, {}).get("invvol", med_iv)
        score[s] = max(.02, score[s]) * (.92 + .08*iv/max(med_iv,1e-12))
    target = bounded_weights(score)
    if all(np.isfinite(target[s]) and target[s] >= 0 for s in ASSETS) and abs(sum(target.values())-1.) < 1e-8:
        rebalance_to_weights(target)


