 import numpy as np
from alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights

ASSETS = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
FACTORS = {"quiet": .24, "relative": .18, "accel": .15, "compression": .16,
           "stress": .10, "breadth": .08, "downside": .05, "agreement": .04}
CADENCE = 10
_day = 0

def cs_rank(vals):
    good = sorted((s, float(v)) for s, v in vals.items() if np.isfinite(v))
    out = {s: .5 for s in ASSETS}
    if not good: return out
    for i, (s, _) in enumerate(good): out[s] = (i + 1.) / len(good)
    return out

def bounded(score):
    floor, cap = .015, .25
    x = {s: max(float(score.get(s, .5)), 1e-8) for s in ASSETS}
    free = 1. - floor * len(ASSETS)
    w = {s: floor + free*x[s]/sum(x.values()) for s in ASSETS}
    for _ in range(20):
        hi = [s for s in ASSETS if w[s] > cap]
        if not hi: break
        excess = sum(w[s] - cap for s in hi)
        for s in hi: w[s] = cap
        rest = [s for s in ASSETS if s not in hi]
        den = sum(x[s] for s in rest)
        for s in rest: w[s] += excess*x[s]/max(den, 1e-12)
    z = sum(w.values())
    return {s: w[s]/z for s in ASSETS}

@register_hook
def cross_asset_strategy():
    global _day
    _day += 1
    if (_day - 1) % CADENCE: return
    features = {}
    for s in ASSETS:
        df = get_stock_daily_data(symbol=s, days=260)
        if df is None or len(df) < 90: continue
        c = np.asarray(df.sort_values("date").iloc[:-1]["close"], dtype=float)
        c = c[np.isfinite(c) & (c > 0)]
        if len(c) < 80: continue
        r = c[1:] / c[:-1] - 1.
        v10=max(np.std(r[-10:]), .003); v20=max(np.std(r[-20:]), .003); v60=max(np.std(r[-60:]), .003)
        t5=c[-1]/c[-6]-1.; t10=c[-1]/c[-11]-1.; t20=c[-1]/c[-21]-1.; t30=c[-1]/c[-31]-1.; t60=c[-1]/c[-61]-1.
        down=r[-30:][r[-30:] < 0]
        downvol=max(np.std(down) if len(down)>2 else v30 if False else v20, .003)
        features[s] = {
          "quiet": (t20/(v60+.01)) * abs(t20)/(np.sum(abs(r[-20:]))+1e-9),
          "relative": t20/(v20+.01),
          "accel": t10/(v10+.01) - t20/(v20+.01),
          "compression": -v10/v60,
          "stress": (t10 if t30 >= 0 else -t10)/(v20+.01),
          "breadth": t30/(v60+.01),
          "downside": -downvol/(v20+.01),
          "agreement": np.mean([t10 > 0, t20 > 0, t60 > 0]),
          "vol": v20, "t30": t30
        }
    if len(features) < 10: return
    ranks = {f: cs_rank({s: d[f] for s,d in features.items()}) for f in FACTORS}
    score = {s: sum(FACTORS[f] * ranks[f][s] for f in FACTORS) for s in ASSETS}
    breadth = np.mean([d["t30"] > 0 for d in features.values()])
    spx30 = features.get("SPX", {}).get("t30", 0.)
    bear = breadth < .45 or spx30 < -.05
    if bear:
        intensity=min(1., max(0., (.45-breadth)*1.8) + max(0., (-spx30-.02)/.18))
        for s in ("XAU", "US10Y", "CN10Y"): score[s] *= 1. + .75*intensity
        for s in ("BTC", "ETH", "WTI", "SOX", "NDX", "COPPER"): score[s] *= max(.20, 1. - .65*intensity)
    med=np.median([d["vol"] for d in features.values()])
    for s in ASSETS:
        score[s]=max(.01, score[s]) * np.clip(med/max(features.get(s,{}).get("vol", med), .003), .65, 1.30)
    target=bounded(score)
    if set(target) == set(ASSETS) and all(np.isfinite(v) and v >= 0 for v in target.values()):
        rebalance_to_weights(target)

def strategy():
    return cross_asset_strategy()


