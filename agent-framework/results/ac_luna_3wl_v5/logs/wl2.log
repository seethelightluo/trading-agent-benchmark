c[1:] / np.maximum(c[:-1], 1e-12) - 1.0\n        vol = max(float(np.std(r[-20:])), 0.008)\n        vals[s] = {\n            "clv": (2*c[-1]-h[-1]-l[-1]) / max(h[-1]-l[-1], 1e-12),\n            "leadlag": c[-1] / max(c[-6], 1e-12) - 1.0,\n            "reversal": -float(np.mean(r[-5:])),\n            "momentum": (c[-1] / max(c[-21], 1e-12)-1.0) / (vol + 0.01),\n            "invvol": 1.0 / vol,\n        }\n    if len(vals) < 12:\n        return\n\n    ranks = {f: rank_cs({s: v[f] for s, v in vals.items()}) for f in FACTORS}\n    score = {s: sum(FACTORS[f] * ranks[f][s] for f in FACTORS) for s in ASSETS}\n    if "SPX" in vals:\n        # Bear regime uses tradable defensive assets, never cash.\n        spx = get_stock_daily_data(symbol="SPX", days=90).sort_values("date")["close"].to_numpy(dtype=float)\n        if spx[-1] < spx[-6] and spx[-1] < spx[-21]:\n            for s in ("XAU", "US10Y", "CN10Y"):\n                score[s] += 0.16\n            for s in ("BTC", "ETH", "WTI"):\n                score[s] = max(0.02, score[s] - 0.08)\n    mean_iv = float(np.mean([v["invvol"] for v in vals.values()]))\n    raw = {s: max(score[s], 0.01) * (0.85 + 0.15 * vals.get(s, {"invvol": mean_iv})["invvol"] / mean_iv) for s in ASSETS}\n    rebalance_to_weights(bounded(raw))\n', 'file_path': 'strategy.py'})
