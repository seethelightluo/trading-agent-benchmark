bol=s, days=160)\n        if df is None or len(df) < 75:\n            continue\n        d = df.sort_values("date").iloc[:-1]  # no current/incomplete bar\n        c = np.asarray(d["close"], float)\n        if len(c) < 65 or np.any(~np.isfinite(c[-65:])) or np.any(c[-65:] <= 0):\n            continue\n        r = c[1:] / c[:-1] - 1.\n        r5, r20, r30 = r[-5:], r[-20:], r[-30:]\n        vol = max(float(np.std(r20)), .006)\n        t20, t30 = c[-1] / c[-21] - 1., c[-1] / c[-31] - 1.\n        consistency20 = float(np.mean(r20 > 0))\n        clv = 0.\n        if all(k in d.columns for k in ("high", "low", "close")):\n            hi, lo, cc = [np.asarray(d[k].iloc[-10:], float) for k in ("high", "low", "close")]\n            clv = float(np.mean(np.where(hi > lo, (2 * cc - hi - lo) / (hi - lo), 0.)))\n        data[s] = {"downtrend20": t20 / (vol + .01) * (.5 + .5 * consistency20),\n                   "lead5": float(np.sum(r5)), "mom30": t30 / (vol + .01),\n                   "rev5": -float(np.sum(r5)), "clv": clv,\n                   "cons20": consistency20, "mom20": t20 / (vol + .01),\n                   "mktres": t30, "dxyres": t30, "t30": t30, "vol": vol}\n        rets[s] = r[-30:]\n    if len(data) < 10:\n        return\n    med5 = np.median([x["lead5"] for x in data.values()])\n    med30 = np.median([x["t30"] for x in data.values()])\n    for x in data.values():\n        x["lead5"] -= med5\n        x["mktres"] -= med30\n\n    dxy = get_index_daily_data(symbol="DXY", days=160)\n    if dxy is not None and len(dxy) > 35:\n        dc = np.asarray(dxy.sort_values("date")["close"], float)[:-1]\n        if len(dc) >= 31 and np.all(np.isfinite(dc[-31:])) and np.all(dc[-31:] > 0):\n            dr = dc[1:] / dc[:-1] - 1.\n            for s, x in data.items():\n                q, ar = dr[-30:], rets[s]\n                var = np.var(q)\n                beta = np.cov(ar, q, ddof=0)[0, 1] / var if var > 1e-10 else 0.\n                x["dxyres"] = x["t30"] - beta * np.sum(q)\n\n    ranks = {k: rank_cs({s: x[k] for s, x in data.items()}) for k in FACTORS}\n    score = {s: sum(w * ranks[k][s] for k, w in FACTORS.items()) for s in ASSETS}\n    breadth = np.mean([x["t30"] > 0 for x in data.values()])\n    stress = breadth < .50 or np.median([x["vol"] for x in data.values()]) > .018\n    if stress:\n        # Defensive tradable assets replace cash in a bearish/high-volatility regime.\n        for s in ("XAU", "US10Y", "CN10Y"):\n            score[s] += .38\n        for s in ("BTC", "ETH", "WTI"):\n            score[s] -= .25\n    medvol = np.median([x["vol"] for x in data.values()])\n    invvol = {s: medvol / x["vol"] for s, x in data.items()}\n    rebalance_to_weights(make_weights(score, invvol))\n\n\ndef strategy():\n    return cross_asset_strategy()\n', 'file_path': 'strategy.py'})
