   z=pd.concat([F.iloc[i],Y[1].iloc[i]],axis=1).dropna()
   if len(z)>=8:
    q=z.iloc[:,0].corr(z.iloc[:,1]);
    if pd.notna(q):a.append(q)
 print('regime',yr,'dates',len(a),'IC',round(np.mean(a),6) if a else None)


