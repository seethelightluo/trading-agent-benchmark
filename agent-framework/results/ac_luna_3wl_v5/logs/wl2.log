e final row is not used: decisions see only the prior completed day.\n        d = df.iloc[:-1]\n        c = np.asarray(d["close"], float)\n        if len(c) < 70 or np.any(~np.isfinite(c[-70:])) or np.any(c[-70:] <= 0): continue\n        r = c[1:] / c[:-1] - 1.\n        r20, r30 = r[-20:], r[-30:]\n        vol = max(float(np.std(r20)), .006)\n        downside = max(float(np.std(np.minimum(r20, 0.))), .003)\n        t20, t30 = c[-1]/c[-21]-1., c[-1]/c[-31]-1.\n        # Positive reversal scores favor recent stress selloffs, not persistent winners.\n        shock = -float(np.sum(r[-3:])) / (vol + .01)\n        rev5 = -float(np.sum(r[-5:])) / (vol + .01)\n        p20, p30 = np.mean(r20 > 0), np.mean(r30 > 0)\n        f[s] = {"shock": shock, "mom30": t30/(vol+.01) * (.5+.5*max(0,2*p30-1)),\n                "mom20": t20/(vol+.01) * (.5+.5*max(0,2*p20-1)),\n                "rev5": rev5, "downmom": t20/(downside+.01),\n                "eff": t20/(np.sum(np.abs(r20))+.00001), "t30": t30, "vol": vol}\n        # CLV is a pressure measure averaged over recent available bars.\n        if all(k in d.columns for k in ("high", "low", "close", "open")):\n            hi, lo, op = np.asarray(d["high"][-10:],float), np.asarray(d["low"][-10:],float), np.asarray(d["open"][-10:],float)\n            cl = np.where(hi > lo, (2*np.asarray(d["close"][-10:],float)-hi-lo)/(hi-lo), 0.)\n            f[s]["clv"] = float(np.mean(cl))\n        else: f[s]["clv"] = 0.\n        rets[s] = r[-30:]\n    if len(f) < 10: return\n    med_t = float(np.median([x["t30"] for x in f.values()]))\n    dxy = get_index_daily_data(symbol="DXY", days=130)\n    dx = None\n    if dxy is not None and len(dxy) > 35:\n        dc = np.asarray(dxy.sort_values("date")["close"], float)[:-1]\n        if len(dc) >= 31 and np.all(np.isfinite(dc[-31:])) and np.all(dc[-31:] > 0): dx = dc[1:]/dc[:-1]-1.\n    for s, x in f.items():\n        x["mktres"] = x["t30"] - med_t\n        x["dxyres"] = x["t30"]\n        if dx is not None and len(dx) >= 30:\n            ar, dr = rets[s][-30:], dx[-30:]\n            var = float(np.var(dr))\n            beta = float(np.cov(ar, dr, ddof=0)[0,1]/var) if var > 1e-10 else 0.\n            x["dxyres"] = x["t30"] - beta*float(np.sum(dr))\n    ranks = {k: rank({s:x[k] for s,x in f.items()}) for k in FACTORS}\n    score = {s: sum(FACTORS[k]*ranks[k][s] for k in FACTORS) for s in ASSETS}\n    breadth = np.mean([x["t30"] > 0 for x in f.values()])\n    medvol = np.median([x["vol"] for x in f.values()])\n    # Bear/high-risk: express risk-off view only through tradable defensives.\n    if breadth < .50 or medvol > .018:\n        for s in ("XAU", "US10Y", "CN10Y"): score[s] += .24\n        for s in ("BTC", "ETH", "WTI"): score[s] -= .18\n    invvol = {s: np.clip(medvol/max(x["vol"], .006), .75, 1.25) for s,x in f.items()}\n    rebalance_to_weights(weights(score, invvol))\n\n\ndef strategy():\n    return cross_asset_strategy()\n', 'file_path': 'strategy.py'})
