for label,a in [('early',z[:len(z)//2]),('late',z[len(z)//2:]),('recent250',z[-250:])]: print(label,a.mean(),a.mean()/a.std(ddof=1),len(a))
print('corr rev5',f.stack().corr((-p.pct_change(5)).stack()))


