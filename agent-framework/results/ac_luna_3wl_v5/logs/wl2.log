 import numpy as np
from alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights

ASSETS = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
# Screener ensemble, preserving its directions and weights.
FACTORS = {"quiet": 0.32, "accel": 0.27, "risk20": 0.22, "down60": 0.15, "resid": 0.04}
REBALANCE_DAYS = 10
MIN_W, MAX_W = 0.045, 0.13
_day = 0

def rank_map(values):
    valid = sorted((s, v) for s, v in values.items() if np.isfinite(v))
    out = {s: 0.5 for s in ASSETS}
    n = len(valid)
    if n:
        for i, (s, _) in enumerate(valid): out[s] = (i + 1.0) / n
    return out

def bounded_weights(score, invvol):
    raw = {s: max(0.08, score[s]) * np.clip(invvol.get(s, 1.0), 0.70, 1.30) for s in ASSETS}
    w = {s: MIN_W + (1 - len(ASSETS)*MIN_W) * raw[s] / sum(raw.values()) for s in ASSETS}
    for _ in range(50):
        high = [s for s in ASSETS if w[s] > MAX_W + 1e-10]
        if not high: break
        excess = sum(w[s] - MAX_W for s in high)
        for s in high: w[s] = MAX_W
        rest = [s for s in ASSETS if s not in high]
        denom = sum(raw[s] for s in rest)
        if not rest or denom <= 0: break
        for s in rest: w[s] += excess * raw[s] / denom
    total = sum(w.values())
    return {s: max(0.0, w[s] / total) for s in ASSETS}

@register_hook
def cross_asset_strategy():
    global _day
    _day += 1
    if (_day - 1) % REBALANCE_DAYS != 0: return
    feat = {}
    for s in ASSETS:
        df = get_stock_daily_data(symbol=s, days=220)
        if df is None or len(df) < 90: continue
        d = df.sort_values("date").iloc[:-1]  # no look-ahead
        c = np.asarray(d["close"], dtype=float)
        if len(c) < 65 or np.any(c[-65:] <= 0): continue
        r = c[1:] / c[:-1] - 1.0
        r20, r30, r60 = r[-20:], r[-30:], r[-60:]
        vol = max(float(np.std(r20)), 0.006)
        t20, t30, t60 = c[-1]/c[-21]-1, c[-1]/c[-31]-1, c[-1]/c[-61]-1
        cons20, cons30 = float(np.mean(r20 > 0)), float(np.mean(r30 > 0))
        downside = np.std(r60[r60 < 0]) if np.any(r60 < 0) else max(float(np.std(r60)), .006)
        feat[s] = {"quiet": t30/(vol+.01)*(0.5+.5*cons30),
                   "accel": (t20-t30)/(vol+.01)*(0.5+.5*cons20),
                   "risk20": t20/vol, "down60": t60/max(float(downside), .006),
                   "t30": t30, "vol": vol}
    if len(feat) < 10: return
    ranks = {k: rank_map({s: x[k] for s,x in feat.items()}) for k in FACTORS if k != "resid"}
    median_return = float(np.median([x["t30"] for x in feat.values()]))
    ranks["resid"] = rank_map({s: x["t30"] - median_return for s,x in feat.items()})
    score = {s: sum(FACTORS[k] * ranks[k][s] for k in FACTORS) for s in ASSETS}
    breadth = float(np.mean([x["t30"] > 0 for x in feat.values()]))
    median_vol = float(np.median([x["vol"] for x in feat.values()]))
    # High-risk sideways/bear regime: remain fully invested but use defensive assets.
    if breadth < 0.60 or median_vol > 0.018:
        for s in ("XAU", "US10Y", "CN10Y"): score[s] += 0.38
        for s in ("BTC", "ETH", "WTI"): score[s] -= 0.24
    invvol = {s: median_vol / x["vol"] for s,x in feat.items()}
    target = bounded_weights(score, invvol)
    if set(target) == set(ASSETS) and all(np.isfinite(v) and v >= 0 for v in target.values()) and abs(sum(target.values())-1) < 1e-8:
        rebalance_to_weights(target)

def strategy():
    return cross_asset_strategy()


