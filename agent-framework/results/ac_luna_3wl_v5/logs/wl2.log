  ▶️ write_file({'content': 'import numpy as np\nfrom alphacrafter.sim.utils import register_hook, get_stock_daily_data, get_index_daily_data, rebalance_to_weights\n\nASSETS = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]\n# Current seven-factor screener ensemble; all factors have positive direction.\nFACTORS = {"mom30": .24, "mom20": .20, "clv": .20, "persist30": .12,\n           "dxyres": .10, "mktres": .08, "cons20": .06}\nREBALANCE_DAYS = 10\nPOSITION_SCALING = .055\nMIN_W, MAX_W = .04, .14\n_day = 0\n\n\ndef cs_rank(vals):\n    out = {s: .5 for s in ASSETS}\n    usable = sorted((s, v) for s, v in vals.items() if np.isfinite(v))\n    if not usable:\n        return out\n    for i, (s, _) in enumerate(usable):\n        out[s] = (i + 1.0) / len(usable)\n    return out\n\n\ndef bounded_weights(score, invvol):\n    raw = {s: (0.5 + POSITION_SCALING * (score[s] - 0.5)) *\n              np.clip(invvol.get(s, 1.0), .75, 1.25) for s in ASSETS}\n    w = {s: MIN_W + (1 - len(ASSETS) * MIN_W) * raw[s] / sum(raw.values()) for s in ASSETS}\n    # Redistribute any cap excess without violating the full-investment contract.\n    for _ in range(20):\n        high = [s for s in ASSETS if w[s] > MAX_W + 1e-10]\n        if not high:\n            break\n        excess = sum(w[s] - MAX_W for s in high)\n        for s in high:\n            w[s] = MAX_W\n        rest = [s for s in ASSETS if s not in high]\n        z = sum(raw[s] for s in rest)\n        if not rest or z <= 0:\n            break\n        for s in rest:\n            w[s] += excess * raw[s] / z\n    z = sum(w.values())\n    return {s: max(0.0, w[s] / z) for s in ASSETS}\n\n\n@register_hook\ndef cross_asset_strategy():\n    global _day\n    _day += 1\n    if (_day - 1) % REBALANCE_DAYS != 0:\n        return\n    features, returns = {}, {}\n    for s in ASSETS:\n        df = get_stock_daily_data(symbol=s, days=160)\n        if df is None or len(df) < 75:\n            continue\n        d = df.sort_values("date").iloc[:-1]  # only completed bars\n        c = np.asarray(d["close"], float)\n        if len(c) < 65 or np.any(~np.isfinite(c[-65:])) or np.any(c[-65:] <= 0):\n            continue\n        r = c[1:] / c[:-1] - 1.0\n        r20, r30 = r[-20:], r[-30:]\n        vol = max(float(np.std(r20)), .006)\n        t20, t30 = c[-1] / c[-21] - 1.0, c[-1] / c[-31] - 1.0\n        clv = 0.0\n        if all(k in d.columns for k in ("high", "low", "close")):\n            hi, lo, cc = [np.asarray(d[k].iloc[-10:], float) for k in ("high", "low", "close")]\n            clv = float(np.mean(np.where(hi > lo, (2*cc-hi-lo)/(hi-lo), 0.0)))\n        features[s] = {\n            "mom30": t30/(vol+.01), "mom20": t20/(vol+.01),\n            "clv": clv, "persist30": t30/(vol+.01) * (.5+.5*np.mean(r30 > 0)),\n            "dxyres": t30, "mktres": t30, "cons20": float(np.mean(r20 > 0)),\n            "t30": t30, "lead": float(np.sum(r[-5:])), "vol": vol}\n        returns[s] = r[-30:]\n    if len(features) < 10:\n        return\n\n    # Cross-sectional residualization avoids treating common moves as alpha.\n    med30 = np.median([x["t30"] for x in features.values()])\n    med5 = np.median([x["lead"] for x in features.values()])\n    for s, x in features.items():\n        x["mktres"] = x["t30"] - med30\n        x["lead"] -= med5\n\n    dxy = get_index_daily_data(symbol="DXY", days=160)\n    if dxy is not None and len(dxy) > 35:\n        dc = np.asarray(dxy.sort_values("date")["close"], float)[:-1]\n        if len(dc) >= 31 and np.all(np.isfinite(dc[-31:])) and np.all(dc[-31:] > 0):\n            q = dc[1:] / dc[:-1] - 1.0\n            q = q[-30:]\n            var = np.var(q)\n            for s, x in features.items():\n                ar = returns[s]\n                n = min(len(ar), len(q))\n                beta = np.cov(ar[-n:], q[-n:], ddof=0)[0, 1] / var if var > 1e-10 else 0.0\n                x["dxyres"] = x["t30"] - beta * np.sum(q)\n\n    ranks = {k: cs_rank({s: x[k] for s, x in features.items()}) for k in FACTORS}\n    score = {s: sum(w * ranks[k][s] for k, w in FACTORS.items()) for s in ASSETS}\n    breadth = float(np.mean([x["t30"] > 0 for x in features.values()]))\n    medvol = float(np.median([x["vol"] for x in features.values()]))\n    stress = breadth < .50 or medvol > .018\n    if stress:\n        for s in ("XAU", "US10Y", "CN10Y"):\n            score[s] += .42\n        for s in ("BTC", "ETH", "WTI"):\n            score[s] -= .30\n    invvol = {s: medvol / x["vol"] for s, x in features.items()}\n    rebalance_to_weights(bounded_weights(score, invvol))\n\n\ndef strategy():\n    return cross_asset_strategy()\n', 'file_path': 'strategy.py'})
