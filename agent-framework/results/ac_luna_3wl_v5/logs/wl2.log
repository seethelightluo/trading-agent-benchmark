ax(c[-21], 1e-12) - 1.0) / (vol + 0.01),\n            "invvol": 1.0 / vol,\n        }\n    if len(data) < 12:\n        return\n    # Peer-median lead-lag proxy: relative five-day return versus the available cross-section.\n    median5 = float(np.median([v["ret5"] for v in data.values()]))\n    factors = {\n        "clv": {s: v["clv"] for s, v in data.items()},\n        "leadlag": {s: v["ret5"] - median5 for s, v in data.items()},\n        "momentum": {s: v["mom20"] for s, v in data.items()},\n        "reversal": {s: v["rev5"] for s, v in data.items()},\n    }\n    rr = {f: ranks(x) for f, x in factors.items()}\n    score = {s: sum(FACTORS[f] * rr[f][s] for f in FACTORS) for s in ASSETS}\n    # Moderate bearish regime: express risk reduction through defensive tradable assets.\n    spx = data.get("SPX")\n    if spx and spx["ret5"] < 0 and spx["mom20"] < 0:\n        for s in ("XAU", "US10Y", "CN10Y"):\n            score[s] += 0.14\n        for s in ("BTC", "ETH", "WTI"):\n            score[s] = max(0.02, score[s] - 0.07)\n    mean_iv = float(np.mean([v["invvol"] for v in data.values()]))\n    raw = {s: max(score[s], 0.02) * (0.88 + 0.12 * data.get(s, {"invvol": mean_iv})["invvol"] / mean_iv) for s in ASSETS}\n    rebalance_to_weights(bounded(raw))\n', 'file_path': 'strategy.py'})
