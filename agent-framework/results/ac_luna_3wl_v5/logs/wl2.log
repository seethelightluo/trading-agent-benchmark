  ▶️ write_file({'content': 'import numpy as np\nfrom alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights\n\nASSETS = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]\nFACTORS = {"clv": 0.280, "leadlag": 0.240, "reversal": 0.160, "momentum": 0.220, "downside": 0.100}\nMIN_WEIGHT, MAX_WEIGHT = 0.015, 0.16\n_day = 0\n\n\ndef rank_cs(values):\n    out = {s: 0.5 for s in ASSETS}\n    valid = sorted((s, float(v)) for s, v in values.items() if np.isfinite(v))\n    n = len(valid)\n    if n > 1:\n        for i, (s, _) in enumerate(valid):\n            out[s] = (i + 1.0) / n\n    return out\n\n\ndef cap_weights(score):\n    weights = {s: MIN_WEIGHT for s in ASSETS}\n    active = set(ASSETS)\n    remaining = 1.0 - MIN_WEIGHT * len(ASSETS)\n    while active and remaining > 1e-12:\n        denom = sum(max(score[s], 1e-8) for s in active)\n        over = [s for s in active if remaining * max(score[s], 1e-8) / denom > MAX_WEIGHT - MIN_WEIGHT]\n        if not over:\n            for s in active:\n                weights[s] += remaining * max(score[s], 1e-8) / denom\n            break\n        for s in over:\n            weights[s] = MAX_WEIGHT\n            remaining -= MAX_WEIGHT - MIN_WEIGHT\n            active.remove(s)\n    total = sum(weights.values())\n    return {s: weights[s] / total for s in ASSETS}\n\n\n@register_hook\ndef cross_asset_strategy():\n    global _day\n    _day += 1\n    if (_day - 1) % 10 != 0:\n        return\n\n    obs = {}\n    for symbol in ASSETS:\n        df = get_stock_daily_data(symbol=symbol, days=90)\n        if df is None or len(df) < 35:\n            continue\n        df = df.sort_values("date").reset_index(drop=True)\n        close = df["close"].to_numpy(dtype=float)\n        high = df["high"].to_numpy(dtype=float)\n        low = df["low"].to_numpy(dtype=float)\n        if not np.all(np.isfinite(close[-31:])) or close[-1] <= 0:\n            continue\n        ret = close[1:] / np.maximum(close[:-1], 1e-12) - 1.0\n        vol = max(float(np.std(ret[-20:])), 0.008)\n        downside_vol = max(float(np.std(np.minimum(ret[-20:], 0.0))), 0.004)\n        obs[symbol] = {\n            "clv": (2.0 * close[-1] - high[-1] - low[-1]) / max(high[-1] - low[-1], 1e-12),\n            "ret5": close[-1] / max(close[-6], 1e-12) - 1.0,\n            "reversal": -float(np.mean(ret[-5:])),\n            "momentum": (close[-1] / max(close[-21], 1e-12) - 1.0) / (vol + 0.01),\n            "downside": (close[-1] / max(close[-21], 1e-12) - 1.0) / (downside_vol + 0.01),\n            "invvol": 1.0 / vol,\n            "trend30": close[-1] / max(close[-31], 1e-12) - 1.0,\n        }\n    if len(obs) < 10:\n        return\n\n    peer_median = float(np.median([x["ret5"] for x in obs.values()]))\n    raw = {\n        "clv": {s: x["clv"] for s, x in obs.items()},\n        "leadlag": {s: x["ret5"] - peer_median for s, x in obs.items()},\n        "reversal": {s: x["reversal"] for s, x in obs.items()},\n        "momentum": {s: x["momentum"] for s, x in obs.items()},\n        "downside": {s: x["downside"] for s, x in obs.items()},\n    }\n    ranks = {factor: rank_cs(values) for factor, values in raw.items()}\n    score = {s: sum(FACTORS[f] * ranks[f][s] for f in FACTORS) for s in ASSETS}\n\n    # Bearish/range-bound overlay: rotate toward defensive tradable benchmarks.\n    equities = [obs[s] for s in ("000300.SH", "SPX", "HSI", "N225", "SX5E", "NDX") if s in obs]\n    breadth = sum(x["trend30"] < 0 for x in equities) / max(len(equities), 1)\n    spx = obs.get("SPX", {})\n    if breadth >= 0.5 or (spx.get("trend30", 0.0) < 0 and spx.get("ret5", 0.0) < 0):\n        for s in ("XAU", "US10Y", "CN10Y"):\n            score[s] += 0.12\n        for s in ("BTC", "ETH", "WTI"):\n            score[s] = max(0.02, score[s] - 0.06)\n\n    # Modest inverse-volatility risk moderation; remain fully invested.\n    median_invvol = float(np.median([x["invvol"] for x in obs.values()]))\n    for s in ASSETS:\n        iv = obs.get(s, {}).get("invvol", median_invvol)\n        score[s] = max(score[s], 0.02) * (0.90 + 0.10 * iv / max(median_invvol, 1e-12))\n    target = cap_weights(score)\n    if all(np.isfinite(target[s]) and target[s] >= 0 for s in ASSETS) and abs(sum(target.values()) - 1.0) < 1e-8:\n        rebalance_to_weights(target)\n', 'file_path': 'strategy.py'})
