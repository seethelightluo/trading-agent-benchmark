 = r[-20:], r[-30:], r[-60:]\n        v20 = max(float(np.std(r20)), 0.006)\n        t20, t30, t60 = c[-1]/c[-21]-1, c[-1]/c[-31]-1, c[-1]/c[-61]-1\n        cons30 = float(np.mean(r30 > 0)); cons20 = float(np.mean(r20 > 0))\n        quiet = t30/(v20+0.01) * (0.5+0.5*cons30)\n        accel = (t20-t30)/(v20+0.01) * (0.5+0.5*cons20)\n        down = np.std(r60[r60 < 0]) if np.any(r60 < 0) else max(float(np.std(r60)), .006)\n        feat[s] = {"quiet":quiet, "accel":accel, "risk20":t20/v20,\n                   "down60":t60/max(float(down),.006), "t30":t30, "vol":v20}\n    if len(feat) < 10: return\n    rr = {k: ranks({s:x[k] for s,x in feat.items()}) for k in FACTORS if k != "resid"}\n    # Small market-residual proxy: asset return minus equal-panel median return.\n    panel = {s: x["t30"] for s,x in feat.items()}\n    med = float(np.median(list(panel.values())))\n    rr["resid"] = ranks({s: panel[s]-med for s in feat})\n    score = {s: sum(FACTORS[k]*rr[k][s] for k in FACTORS) for s in ASSETS}\n    breadth = float(np.mean([x["t30"] > 0 for x in feat.values()]))\n    medvol = float(np.median([x["vol"] for x in feat.values()]))\n    # High-risk, uncertain breadth: defensive tradable assets replace cash.\n    if breadth < 0.60 or medvol > 0.018:\n        for s in ("XAU", "US10Y", "CN10Y"): score[s] += 0.38\n        for s in ("BTC", "ETH", "WTI"): score[s] -= 0.24\n    invvol = {s: medvol/x["vol"] for s,x in feat.items()}\n    target = make_weights(score, invvol)\n    if set(target) == set(ASSETS) and all(np.isfinite(v) and v >= 0 for v in target.values()):\n        rebalance_to_weights(target)\n\ndef strategy():\n    return cross_asset_strategy()\n', 'file_path': 'strategy.py'})
