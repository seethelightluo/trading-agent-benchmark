 import numpy as np
from alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights

ASSETS = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
# Current screener ensemble; all directions are positive.
FACTORS = {"mom20": .24, "mom30": .18, "resid30": .14, "downmom": .12,
           "eff": .11, "persist": .09, "lead": .07, "rev": .05}
MIN_W, MAX_W = .02, .14
_day = 0

def rank(values):
    good = sorted((s, v) for s, v in values.items() if np.isfinite(v))
    out = {s: .5 for s in ASSETS}
    n = len(good)
    if n > 1:
        for i, (s, _) in enumerate(good):
            out[s] = (i + 1.) / n
    return out

def bounded(raw):
    # Floors and caps prevent correlated momentum from creating concentration.
    raw = {s: max(float(raw.get(s, .5)), .05) for s in ASSETS}
    w = {s: MIN_W + (1 - MIN_W*len(ASSETS))*raw[s]/sum(raw.values()) for s in ASSETS}
    for _ in range(10):
        excess = sum(max(0., w[s]-MAX_W) for s in ASSETS)
        if excess < 1e-10: break
        capped = {s for s in ASSETS if w[s] >= MAX_W-1e-10}
        for s in capped: w[s] = MAX_W
        free = [s for s in ASSETS if s not in capped]
        if not free: break
        z = sum(raw[s] for s in free)
        for s in free: w[s] += excess*raw[s]/z
    z = sum(w.values())
    return {s: w[s]/z for s in ASSETS}

@register_hook
def cross_asset_strategy():
    global _day
    _day += 1
    if (_day - 1) % 10 != 0:
        return
    data = {}
    for s in ASSETS:
        df = get_stock_daily_data(symbol=s, days=180)
        if df is None or len(df) < 65: continue
        df = df.sort_values("date")
        c = np.asarray(df["close"], float)
        hi = np.asarray(df["high"], float); lo = np.asarray(df["low"], float)
        if not np.all(np.isfinite(c[-65:])) or c[-1] <= 0: continue
        r = c[1:] / np.maximum(c[:-1], 1e-12) - 1.
        v20 = max(float(np.std(r[-20:])), .008)
        dn = max(float(np.std(np.minimum(r[-20:], 0.))), .004)
        r5, r20, r30 = c[-1]/c[-6]-1., c[-1]/c[-21]-1., c[-1]/c[-31]-1.
        p20, p30 = np.mean(r[-20:] > 0), np.mean(r[-30:] > 0)
        # Simple price-only proxies for the persisted factor definitions.
        data[s] = {"mom20": r20/(v20+.01)*(.5+p20),
                   "mom30": r30/(v20+.01)*(.5+p30),
                   "downmom": r20/(dn+.01), "eff": r20/(dn+.015),
                   "persist": r30/(v20+.01)*p30, "lead": r5,
                   "rev": -float(np.mean(r[-5:])), "trend": r30,
                   "vol": v20}
    if len(data) < 10: return
    # Market-residual momentum: remove the equal-weight cross-sectional 30d move.
    market30 = float(np.median([x["trend"] for x in data.values()]))
    for x in data.values(): x["resid30"] = x["trend"] - market30
    ranks = {f: rank({s: data[s][f] for s in data}) for f in FACTORS}
    score = {s: sum(FACTORS[f]*ranks[f][s] for f in FACTORS) for s in ASSETS}
    eq = [data[s] for s in ["000300.SH", "SPX", "HSI", "N225", "SX5E", "NDX"] if s in data]
    breadth = sum(x["trend"] > 0 for x in eq) / max(len(eq), 1)
    medvol = float(np.median([x["vol"] for x in data.values()]))
    high_risk = medvol > .018 or breadth < .67
    bear = len(eq) >= 3 and (breadth <= .50 or (data.get("SPX", {}).get("trend", 0) < 0 and data.get("SPX", {}).get("lead", 0) < 0))
    if high_risk or bear:
        bump = .14 if bear else .09
        for s in ("XAU", "US10Y", "CN10Y"):
            score[s] += bump
        for s in ("BTC", "ETH", "WTI"):
            score[s] = max(.05, score[s] - (.07 if bear else .04))
    # Small inverse-volatility overlay, deliberately not a cash sleeve.
    med = float(np.median([x["vol"] for x in data.values()]))
    for s in ASSETS:
        if s in data:
            score[s] *= .97 + .03*med/data[s]["vol"]
    target = bounded(score)
    if abs(sum(target.values())-1.) < 1e-8 and all(np.isfinite(v) and v >= 0 for v in target.values()):
        rebalance_to_weights(target)


