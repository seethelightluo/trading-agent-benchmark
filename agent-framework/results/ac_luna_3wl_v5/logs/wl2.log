r s in ("BTC", "ETH", "WTI"):\n            score[s] = max(0.05, score[s] - 0.035)\n\n    # Mild inverse-volatility scaling limits concentration without changing\n    # factor direction; rank score remains the primary signal.\n    for s in ASSETS:\n        if s in data:\n            score[s] *= 0.99 + 0.01 * medvol / max(data[s]["vol"], 0.004)\n    rebalance_to_weights(bounded(score))\n\n\ndef strategy():\n    return cross_asset_strategy()\n', 'file_path': 'strategy.py'})
