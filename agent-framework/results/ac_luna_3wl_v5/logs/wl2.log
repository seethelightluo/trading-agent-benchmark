import numpy as np
from alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights

ASSETS = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
# Current screener ensemble: eight active factors, preserving its normalized tilts.
FACTORS = {"cons30": .28, "cons20": .20, "clv1": .16, "lead5": .12,
           "persist30": .08, "rev5": .07, "down20": .06, "eff20": .03}
MIN_W, MAX_W = .02, .15
_day = 0

def rank(values):
    out = {s: .5 for s in ASSETS}
    good = sorted((s, float(v)) for s, v in values.items() if np.isfinite(v))
    n = len(good)
    if n > 1:
        for i, (s, _) in enumerate(good): out[s] = (i + 1.) / n
    return out

def make_weights(score):
    # Full investment with a modest concentration ceiling; no cash sleeve.
    w = {s: MIN_W for s in ASSETS}
    extra = 1.0 - MIN_W * len(ASSETS)
    raw = {s: max(float(score.get(s, .5)), .01) for s in ASSETS}
    for s in ASSETS:
        w[s] += extra * raw[s] / sum(raw.values())
    # Iterative cap and redistribute excess.
    for _ in range(3):
        excess = sum(max(0., w[s] - MAX_W) for s in ASSETS)
        capped = {s for s in ASSETS if w[s] > MAX_W}
        for s in capped: w[s] = MAX_W
        free = [s for s in ASSETS if s not in capped]
        if not free or excess <= 1e-12: break
        z = sum(raw[s] for s in free)
        for s in free: w[s] += excess * raw[s] / max(z, 1e-12)
    z = sum(w.values())
    return {s: w[s] / z for s in ASSETS}

@register_hook
def cross_asset_strategy():
