  if len(z)<30 or z.iloc[:,1].var()<=1e-12:continue
  b=z.iloc[:,0].cov(z.iloc[:,1])/z.iloc[:,1].var();vol=z.iloc[:,0].std();res=(R[s].iloc[t-2:t+1]-b*m.iloc[t-2:t+1]).sum()
  if vol>1e-8:v[s]=-res/vol*gate
 q=pd.concat([pd.Series(v),R.iloc[t+1].reindex(v)],axis=1).dropna()
 if len(q)>=8:rows.append((P.index[t],len(q),q.iloc[:,0].corr(q.iloc[:,1])));signals.append(pd.Series(v,name=P.index[t]))
