  if len(z)>=8:
   q=z.iloc[:,0].corr(z.iloc[:,1],method='spearman');
   if np.isfinite(q):a.append(q);n.append(len(z))
 a=np.array(a);return len(a),round(np.mean(n),2),round(np.mean(a),6),round(np.mean(a)/np.std(a,ddof=1),6),round(np.mean(a>0),4)
