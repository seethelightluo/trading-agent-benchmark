]-1; t30=c[-1]/c[-31]-1\n        eff=abs(t20)/(np.sum(abs(r[-20:]))+1e-9)\n        neg=r[-30:][r[-30:]<0]\n        dvol=np.std(neg) if len(neg)>1 else v20\n        obs[s]={"quiet":t20/v60*eff, "compression":-v10/v60,\n                "stress":(t10 if t30>=0 else -t10)/(v20+.01),\n                "breadth":t30/(v60+.01), "relative":t20/(v20+.01),\n                "breadth_mom":(t10+t20)/(v20+.01), "reversal":-t5/(v10+.01),\n                "down":-dvol/(v20+.01), "vol":v20, "t30":t30}\n    if len(obs) < 10: return\n    ranks={f:cs_rank({s:v[f] for s,v in obs.items()}) for f in FACTORS}\n    score={s:sum(FACTORS[f]*ranks[f][s] for f in FACTORS) for s in ASSETS}\n    breadth=float(np.mean([v["t30"]>0 for v in obs.values()]))\n    spx30=obs.get("SPX",{}).get("t30",0.0)\n    bear=(breadth < .45 or spx30 < -.05)\n    if bear:\n        # Defensive tradable assets replace cash in liquidation regimes.\n        strength=min(1.0, max(0.0, (-spx30-.02)/.18) + max(0.0, .45-breadth))\n        for s in ("XAU","US10Y","CN10Y"): score[s] *= 1.0 + .55*strength\n        for s in ("BTC","ETH","WTI","SOX","NDX","COPPER"): score[s] *= max(.18, 1.0-.70*strength)\n    medvol=float(np.median([v["vol"] for v in obs.values()]))\n    for s in ASSETS:\n        score[s]=max(.01,score[s])*np.clip(medvol/max(obs.get(s,{}).get("vol",medvol),.003),.65,1.25)\n    target=bounded_weights(score)\n    if set(target)==set(ASSETS) and all(np.isfinite(v) and v>=0 for v in target.values()) and abs(sum(target.values())-1)<1e-8:\n        rebalance_to_weights(target)\n\ndef strategy():\n    return cross_asset_strategy()\n', 'file_path': 'strategy.py'})
