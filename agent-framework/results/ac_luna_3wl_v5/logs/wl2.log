 import numpy as np
from alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights

ASSETS = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
FACTORS = {"clv": 0.309, "leadlag": 0.238, "reversal": 0.183, "momentum": 0.180, "downside": 0.090}
MIN_WEIGHT, MAX_WEIGHT = 0.015, 0.16
_day = 0


def pct_rank(values):
    out = {s: 0.5 for s in ASSETS}
    valid = sorted((s, float(v)) for s, v in values.items() if np.isfinite(v))
    if len(valid) > 1:
        for i, (s, _) in enumerate(valid):
            out[s] = (i + 1.0) / len(valid)
    return out


def allocate(scores):
    # Equal floor plus capped score-proportional remainder: full investment.
    w = {s: MIN_WEIGHT for s in ASSETS}
    active = set(ASSETS)
    remaining = 1.0 - MIN_WEIGHT * len(ASSETS)
    while active and remaining > 1e-12:
        denom = sum(max(float(scores[s]), 1e-8) for s in active)
        capped = [s for s in active if remaining * max(float(scores[s]), 1e-8) / denom > MAX_WEIGHT - MIN_WEIGHT]
        if not capped:
            for s in active:
                w[s] += remaining * max(float(scores[s]), 1e-8) / denom
            break
        for s in capped:
            w[s] = MAX_WEIGHT
            remaining -= MAX_WEIGHT - MIN_WEIGHT
            active.remove(s)
    total = sum(w.values())
    return {s: w[s] / total for s in ASSETS}


@register_hook
def cross_asset_strategy():
    global _day
    _day += 1
    if (_day - 1) % 10 != 0:
        return

    data = {}
    for symbol in ASSETS:
        df = get_stock_daily_data(symbol=symbol, days=90)
        if df is None or len(df) < 30:
            continue
        df = df.sort_values("date").reset_index(drop=True)
        c = df["close"].to_numpy(float)
        h = df["high"].to_numpy(float)
        l = df["low"].to_numpy(float)
        if c[-1] <= 0 or not np.all(np.isfinite(c[-25:])):
            continue
        r = c[1:] / np.maximum(c[:-1], 1e-12) - 1.0
        vol = max(float(np.std(r[-20:])), 0.008)
        dvol = max(float(np.std(np.minimum(r[-20:], 0.0))), 0.004)
        data[symbol] = {
            "clv": (2*c[-1] - h[-1] - l[-1]) / max(h[-1] - l[-1], 1e-12),
            "ret5": c[-1] / max(c[-6], 1e-12) - 1.0,
            "reversal": -float(np.mean(r[-5:])),
            "momentum": (c[-1] / max(c[-21], 1e-12) - 1.0) / (vol + 0.01),
            "downside": (c[-1] / max(c[-21], 1e-12) - 1.0) / (dvol + 0.01),
            "invvol": 1.0 / vol,
        }
    if len(data) < 10:
        return

    peer = float(np.median([x["ret5"] for x in data.values()]))
    raw = {
        "clv": {s: x["clv"] for s, x in data.items()},
        "leadlag": {s: x["ret5"] - peer for s, x in data.items()},
        "reversal": {s: x["reversal"] for s, x in data.items()},
        "momentum": {s: x["momentum"] for s, x in data.items()},
        "downside": {s: x["downside"] for s, x in data.items()},
    }
    ranked = {f: pct_rank(v) for f, v in raw.items()}
    score = {s: sum(FACTORS[f] * ranked[f][s] for f in FACTORS) for s in ASSETS}

    # Bearish overlay uses only tradable defensive benchmarks; no cash or shorts.
    broad = [data[s]["ret5"] for s in ("000300.SH", "SPX", "HSI", "N225", "SX5E", "NDX") if s in data]
    breadth = sum(v < 0 for v in broad) / max(len(broad), 1)
    spx = data.get("SPX", {})
    if breadth >= 0.5 or (spx.get("ret5", 0.0) < 0 and spx.get("momentum", 0.0) < 0):
        for s in ("XAU", "US10Y", "CN10Y"):
            score[s] += 0.12
