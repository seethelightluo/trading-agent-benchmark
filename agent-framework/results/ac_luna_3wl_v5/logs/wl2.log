 import numpy as np
from alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights

ASSETS = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
FACTORS = {
    "breadth_mom": .20, "consistency_mom": .16, "recovery": .14,
    "switch": .13, "recovery_accel": .10, "persistence": .10,
    "downvol": .07, "downbreadth": .05, "smooth_trend": .05
}
REBALANCE_DAYS = 10
MIN_W, MAX_W = .04, .14
_day = 0


def cross_rank(vals):
    out = {s: .5 for s in ASSETS}
    good = sorted((s, v) for s, v in vals.items() if np.isfinite(v))
    for i, (s, _) in enumerate(good):
        out[s] = (i + 1.0) / len(good)
    return out


def bounded_weights(raw):
    raw = {s: max(float(raw.get(s, .01)), 1e-8) for s in ASSETS}
    w = {s: MIN_W + (1 - len(ASSETS) * MIN_W) * raw[s] / sum(raw.values()) for s in ASSETS}
    for _ in range(20):
        over = [s for s in ASSETS if w[s] > MAX_W]
        if not over:
            break
        excess = sum(w[s] - MAX_W for s in over)
        for s in over:
            w[s] = MAX_W
        rest = [s for s in ASSETS if s not in over]
        den = sum(raw[s] for s in rest)
        for s in rest:
            w[s] += excess * raw[s] / den
    z = sum(w.values())
    return {s: w[s] / z for s in ASSETS}


@register_hook
def cross_asset_strategy():
    global _day
    _day += 1
    if (_day - 1) % REBALANCE_DAYS:
        return
    data = {}
    for s in ASSETS:
        df = get_stock_daily_data(symbol=s, days=230)
        if df is None or len(df) < 100:
            continue
        close = np.asarray(df.sort_values("date").iloc[:-1]["close"], dtype=float)
        if len(close) < 65 or np.any(~np.isfinite(close[-65:])) or np.any(close[-65:] <= 0):
            continue
        ret = close[1:] / close[:-1] - 1.0
        vol = max(float(np.std(ret[-20:])), .006)
        neg = ret[-30:][ret[-30:] < 0]
        t5 = close[-1] / close[-6] - 1
        t10 = close[-1] / close[-11] - 1
        t20 = close[-1] / close[-21] - 1
        t30 = close[-1] / close[-31] - 1
        t60 = close[-1] / close[-61] - 1
        consistency = float(np.mean(ret[-20:] > 0))
        data[s] = {
            "breadth_mom": t20 / vol * (.35 + .65 * consistency),
            "consistency_mom": t20 / vol * consistency,
            "recovery": t5 - .30 * min(t30, 0),
            "switch": (t10 / (vol + .01)) if t30 >= 0 else (-t5 / (vol + .01)),
            "recovery_accel": (t10 - t30) / (vol + .01),
            "persistence": t30 / (vol + .01) * (.4 + .6 * consistency),
            "downvol": -(float(np.std(neg)) if len(neg) > 1 else vol),
            "downbreadth": -(0.6 * np.mean(ret[-20:] < 0) + 0.4 * np.mean(ret[-60:] < 0)),
            "smooth_trend": t30 / (vol + .01) * (.5 + .5 * consistency),
            "vol": vol, "t30": t30
        }
    if len(data) < 10:
        return
    ranks = {f: cross_rank({s: x[f] for s, x in data.items()}) for f in FACTORS}
    score = {s: sum(FACTORS[f] * ranks[f][s] for f in FACTORS) for s in ASSETS}
    median_vol = float(np.median([x["vol"] for x in data.values()]))
    breadth = float(np.mean([x["t30"] > 0 for x in data.values()]))
    # Bear/high-risk posture: remain fully invested but use defensive tradables.
    if median_vol > .018 or breadth < .60:
        for s in ("XAU", "US10Y", "CN10Y"):
            score[s] += .24
        for s in ("BTC", "ETH", "WTI"):
            score[s] *= .60
    raw = {s: (max(score[s], .03) * np.clip(median_vol / data[s]["vol"], .70, 1.25)
               if s in data else .03) for s in ASSETS}
    target = bounded_weights(raw)
    if all(np.isfinite(target[s]) and target[s] >= 0 for s in ASSETS) and abs(sum(target.values()) - 1) < 1e-8:
        rebalance_to_weights(target)


def strategy():
    return cross_asset_strategy()


