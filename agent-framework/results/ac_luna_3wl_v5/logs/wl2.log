 import pandas as pd, numpy as np, glob
from scipy.stats import spearmanr
U=['000300.SH','SPX','HSI','N225','SX5E','000688.SH','SOX','NDX','XAU','COPPER','WTI','BTC','ETH','US10Y','CN10Y']
D={s:pd.read_csv('../persistent/stock_data/'+s+'.csv',parse_dates=['date']).set_index('date') for s in U}
# Relative 10-session momentum: asset return minus contemporaneous cross-sectional median,
# lagged by one session; intended to capture intermediate relative strength.
px=pd.DataFrame({s:D[s].close for s in U}).sort_index(); ret=px.pct_change(10)
rel=ret.sub(ret.median(axis=1),axis=0).shift(1)
fwd=px.pct_change().shift(-1)
rows=[]; dates=sorted(set(rel.index)&set(fwd.index))
for dt in dates:
 x=rel.loc[dt]; y=fwd.loc[dt]; z=pd.concat([x,y],axis=1).dropna()
 if len(z)>=8:
  rows.append((dt,len(z),spearmanr(z.iloc[:,0],z.iloc[:,1]).statistic))
r=pd.DataFrame(rows,columns=['date','n','ic']).set_index('date')
mean=r.ic.mean(); sd=r.ic.std(ddof=1); icir=mean/sd*np.sqrt(252) if sd else np.nan
# rank turnover among consecutive valid dates
rank=rel.rank(axis=1,pct=True); turn=[]
for a,b in zip(rank.index[:-1],rank.index[1:]):
 if a in r.index and b in r.index:
  q=pd.concat([rank.loc[a],rank.loc[b]],axis=1).dropna(); turn.append((q.iloc[:,0]-q.iloc[:,1]).abs().mean())
print('dates',len(r),'avg_names',r.n.mean(),'coverage',r.n.mean()/15,'IC',mean,'ICIR',icir,'hit', (r.ic>0).mean(),'turnover',np.mean(turn))
for h in [1,5,10]:
 ff=px.pct_change(h).shift(-h)
 a=[]
 for dt in rel.index:
  z=pd.concat([rel.loc[dt],ff.loc[dt]],axis=1).dropna()
  if len(z)>=8:a.append(spearmanr(z.iloc[:,0],z.iloc[:,1]).statistic)
 print('h',h,'ic',np.mean(a),'icir',np.mean(a)/np.std(a,ddof=1)*np.sqrt(252),'n',len(a))
for yr in range(2020,2027):
 q=r[r.index.year==yr].ic
 if len(q): print(yr,len(q),q.mean(),q.mean()/q.std(ddof=1)*np.sqrt(252) if len(q)>1 else np.nan)
for w in [252,504,756]:
 q=r.tail(w).ic;print('recent',w,len(q),q.mean(),q.mean()/q.std(ddof=1)*np.sqrt(252))


