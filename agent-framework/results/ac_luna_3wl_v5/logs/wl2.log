 import numpy as np
from alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights

ASSETS = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
FACTORS = {"risktrend": .28, "quiet": .22, "accel": .18, "cons30": .12, "persist30": .10, "mktres": .05, "rev5": .05}
REBALANCE_DAYS = 10
MIN_W, MAX_W = .04, .14
_day = 0

def cs_rank(values):
    valid = sorted((s, v) for s, v in values.items() if np.isfinite(v))
    out = {s: .5 for s in ASSETS}
    n = len(valid)
    if n:
        for i, (s, _) in enumerate(valid): out[s] = (i + 1.) / n
    return out

def make_weights(score, invvol):
    raw = {s: max(.05, .5 + .045 * (score[s] - .5)) * np.clip(invvol.get(s, 1.), .7, 1.3) for s in ASSETS}
    w = {s: MIN_W + (1 - len(ASSETS) * MIN_W) * raw[s] / sum(raw.values()) for s in ASSETS}
    for _ in range(20):
        high = [s for s in ASSETS if w[s] > MAX_W + 1e-10]
        if not high: break
        excess = sum(w[s] - MAX_W for s in high)
        for s in high: w[s] = MAX_W
        rest = [s for s in ASSETS if s not in high]
        z = sum(raw[s] for s in rest)
        for s in rest: w[s] += excess * raw[s] / z
    z = sum(w.values())
    return {s: w[s] / z for s in ASSETS}

@register_hook
def cross_asset_strategy():
    global _day
    _day += 1
    if (_day - 1) % REBALANCE_DAYS != 0: return
    feat = {}
    for s in ASSETS:
        df = get_stock_daily_data(symbol=s, days=190)
        if df is None or len(df) < 80: continue
        d = df.sort_values("date").iloc[:-1]  # completed bars only
        c = np.asarray(d.close, float); h = np.asarray(d.high, float); lo = np.asarray(d.low, float)
        if len(c) < 65 or np.any(c[-65:] <= 0): continue
        r = c[1:] / c[:-1] - 1.; r20, r30 = r[-20:], r[-30:]
        vol = max(float(np.std(r20)), .006); scale = vol + .01
        t20, t30 = c[-1]/c[-21]-1., c[-1]/c[-31]-1.
        cons30, cons20 = np.mean(r30 > 0), np.mean(r20 > 0)
        rng = np.maximum(h[-20:] - lo[-20:], 1e-12)
        quiet = (t30 / scale) * (.5 + .5 * cons30)
        accel = ((t20 - t30) / scale) * (.5 + .5 * cons20)
        # Range-adjusted persistence: trend relative to realized range.
        persist = t30 / max(float(np.mean(rng / c[-20:])), .005) * (.5 + .5*cons30)
        feat[s] = {"risktrend": t20/scale, "quiet": quiet, "accel": accel,
                   "cons30": cons30, "persist30": persist, "rev5": -np.sum(r[-5:])/scale,
                   "t30": t30, "vol": vol}
    if len(feat) < 10: return
    med = np.median([x["t30"] for x in feat.values()])
    for x in feat.values(): x["mktres"] = x["t30"] - med
    ranks = {k: cs_rank({s: x[k] for s,x in feat.items()}) for k in FACTORS}
    score = {s: sum(FACTORS[k] * ranks[k][s] for k in FACTORS) for s in ASSETS}
    breadth = np.mean([x["t30"] > 0 for x in feat.values()]); medvol = np.median([x["vol"] for x in feat.values()])
    # High-risk, uneven recovery: retain full investment but rotate toward defensives.
    if breadth < .60 or medvol > .018:
        for s in ("XAU", "US10Y", "CN10Y"): score[s] += .55
        for s in ("BTC", "ETH", "WTI"): score[s] -= .40
    invvol = {s: medvol/x["vol"] for s,x in feat.items()}
    target = make_weights(score, invvol)
    if set(target) == set(ASSETS) and all(np.isfinite(v) and v >= 0 for v in target.values()): rebalance_to_weights(target)

def strategy(): return cross_asset_strategy()


