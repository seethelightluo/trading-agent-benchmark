 import numpy as np
from alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights

ASSETS = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
# Current screener ensemble: six slower/downside-aware factors, all positive direction.
FACTORS = {"downmom": .30, "eff": .26, "cons30": .15,
           "cons20": .12, "resid": .10, "lead": .07}
MIN_W, MAX_W = .03, .15
_day = 0


def rank_cs(vals):
    out = {s: .5 for s in ASSETS}
    good = sorted((s, v) for s, v in vals.items() if np.isfinite(v))
    n = len(good)
    if n == 0:
        return out
    for i, (s, _) in enumerate(good):
        out[s] = (i + 1) / n if n > 1 else .5
    return out


def bounded_weights(score):
    # Floors maintain diversification; caps prevent defensive clustering.
    raw = {s: max(.10, float(score.get(s, .5))) for s in ASSETS}
    w = {s: MIN_W + (1 - MIN_W * len(ASSETS)) * raw[s] / sum(raw.values()) for s in ASSETS}
    for _ in range(30):
        over = [s for s in ASSETS if w[s] > MAX_W + 1e-12]
        if not over:
            break
        excess = sum(w[s] - MAX_W for s in over)
        for s in over:
            w[s] = MAX_W
        free = [s for s in ASSETS if s not in over]
        den = sum(raw[s] for s in free)
        if not free or den <= 0:
            break
        for s in free:
            w[s] += excess * raw[s] / den
    z = sum(w.values())
    return {s: max(0.0, w[s] / z) for s in ASSETS}


@register_hook
def cross_asset_strategy():
    global _day
    _day += 1
    if (_day - 1) % 10:
        return

    data = {}
    for s in ASSETS:
        df = get_stock_daily_data(symbol=s, days=190)
        if df is None or len(df) < 65:
            continue
        c = np.asarray(df.sort_values("date")["close"], dtype=float)
        if np.any(~np.isfinite(c[-65:])) or np.any(c[-65:] <= 0):
            continue
        r = c[1:] / c[:-1] - 1.0
        v20 = max(float(np.std(r[-20:])), .006)
        dn20 = max(float(np.std(np.minimum(r[-20:], 0))), .003)
        t5 = c[-1] / c[-6] - 1.0
        t20 = c[-1] / c[-21] - 1.0
        t30 = c[-1] / c[-31] - 1.0
        p20 = float(np.mean(r[-20:] > 0))
        p30 = float(np.mean(r[-30:] > 0))
        data[s] = {"downmom": t20 / (dn20 + .01),
                   "eff": t20 / (dn20 + .015),
                   "cons20": t20 / (v20 + .01) * (.5 + p20),
                   "cons30": t30 / (v20 + .01) * (.5 + p30),
                   "t30": t30, "lead_raw": t5, "vol": v20}
    if len(data) < 10:
        return

    med5 = float(np.median([x["lead_raw"] for x in data.values()]))
    med30 = float(np.median([x["t30"] for x in data.values()]))
    for x in data.values():
        x["lead"] = x["lead_raw"] - med5
        x["resid"] = x["t30"] - med30
    ranks = {f: rank_cs({s: x[f] for s, x in data.items()}) for f in FACTORS}
    score = {s: sum(FACTORS[f] * ranks[f][s] for f in FACTORS) for s in ASSETS}

    eq = [data[s] for s in ("000300.SH", "SPX", "HSI", "N225", "SX5E", "NDX") if s in data]
    breadth = float(np.mean([x["t30"] > 0 for x in eq])) if eq else .5
    medvol = float(np.median([x["vol"] for x in data.values()]))
    spx = data.get("SPX", {})
    bear = breadth <= .50 or (spx.get("t30", 0.0) < 0 and spx.get("lead", 0.0) < 0)
    highrisk = medvol > .018 or breadth < .67
    if bear or highrisk:
        boost = .12 if bear else .07
        for s in ("XAU", "US10Y", "CN10Y"):
            score[s] += boost
        for s in ("BTC", "ETH", "WTI"):
            score[s] = max(.10, score[s] - (.06 if bear else .03))
    # Mild inverse-volatility scaling, retaining the full long-only allocation.
    for s in ASSETS:
        if s in data:
            score[s] *= .99 + .01 * medvol / max(data[s]["vol"], .004)
    rebalance_to_weights(bounded_weights(score))


def strategy():
    return cross_asset_strategy()


