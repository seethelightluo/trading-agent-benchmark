 import numpy as np
from alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights

ASSETS = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
# Current Screener ensemble; all directions are positive.
FACTORS = {"quiet": 0.34, "accel": 0.29, "risk20": 0.23, "down60": 0.11, "cons": 0.03}
REBALANCE_DAYS = 10
MIN_W, MAX_W = 0.045, 0.13
_day = 0

def ranks(vals):
    good = sorted((s, v) for s, v in vals.items() if np.isfinite(v))
    out = {s: 0.5 for s in ASSETS}
    n = len(good)
    for i, (s, _) in enumerate(good):
        out[s] = (i + 1.0) / n
    return out

def make_weights(score, invvol):
    raw = {s: max(0.05, score[s]) * np.clip(invvol.get(s, 1.0), .72, 1.28) for s in ASSETS}
    base = 1.0 - len(ASSETS) * MIN_W
    w = {s: MIN_W + base * raw[s] / sum(raw.values()) for s in ASSETS}
    # Iterative upper-cap redistribution preserves full investment.
    for _ in range(30):
        high = [s for s in ASSETS if w[s] > MAX_W + 1e-10]
        if not high:
            break
        excess = sum(w[s] - MAX_W for s in high)
        for s in high:
            w[s] = MAX_W
        rest = [s for s in ASSETS if s not in high]
        den = sum(raw[s] for s in rest)
        if not rest or den <= 0:
            break
        for s in rest:
            w[s] += excess * raw[s] / den
    total = sum(w.values())
    return {s: max(0.0, w[s] / total) for s in ASSETS}

@register_hook
def cross_asset_strategy():
    global _day
    _day += 1
    if (_day - 1) % REBALANCE_DAYS != 0:
        return
    feat = {}
    for s in ASSETS:
        df = get_stock_daily_data(symbol=s, days=220)
        if df is None or len(df) < 90:
            continue
        d = df.sort_values("date").iloc[:-1]  # completed bars only
        c = np.asarray(d["close"], dtype=float)
        if len(c) < 65 or np.any(c[-65:] <= 0):
            continue
        r = c[1:] / c[:-1] - 1.0
        r20, r30, r60 = r[-20:], r[-30:], r[-60:]
        vol = max(float(np.std(r20)), .006)
        t10 = c[-1] / c[-11] - 1.0
        t20 = c[-1] / c[-21] - 1.0
        t30 = c[-1] / c[-31] - 1.0
        t60 = c[-1] / c[-61] - 1.0
        cons30 = float(np.mean(r30 > 0))
        neg = r60[r60 < 0]
        dvol = max(float(np.std(neg)) if len(neg) else float(np.std(r60)), .006)
        feat[s] = {"quiet": t30 / (vol + .01) * (.5 + .5 * cons30),
                   "accel": (t10 - t20) / (vol + .01),
                   "risk20": t20 / vol,
                   "down60": t60 / dvol,
                   "cons": cons30,
                   "t30": t30, "vol": vol}
    if len(feat) < 10:
        return
    rr = {k: ranks({s: x[k] for s, x in feat.items()}) for k in FACTORS}
    score = {s: sum(FACTORS[k] * rr[k][s] for k in FACTORS) for s in ASSETS}
    breadth = float(np.mean([x["t30"] > 0 for x in feat.values()]))
    medvol = float(np.median([x["vol"] for x in feat.values()]))
    # High-risk sideways/bear posture: defensive tradable assets, never cash.
    if breadth < .60 or medvol > .018:
        for s in ("XAU", "US10Y", "CN10Y"):
            score[s] += .34
        for s in ("BTC", "ETH", "WTI"):
            score[s] *= .55
    invvol = {s: medvol / x["vol"] for s, x in feat.items()}
    target = make_weights(score, invvol)
    if abs(sum(target.values()) - 1.0) < 1e-8 and all(np.isfinite(v) and v >= 0 for v in target.values()):
        rebalance_to_weights(target)

def strategy():
    return cross_asset_strategy()


