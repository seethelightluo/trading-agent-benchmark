  ▶️ write_file({'content': "import numpy as np,pandas as pd\nfrom alphacrafter.sim.utils import get_account_dict,get_stock_daily_data,get_index_daily_data\nU=get_account_dict().get('watch_list') or ['000300.SH','SPX','HSI','N225','SX5E','000688.SH','SOX','NDX','XAU','COPPER','WTI','BTC','ETH','US10Y','CN10Y']\npx={}\nfor s in U:\n d=get_stock_daily_data(s,1800)\n if d is None or len(d)<100:d=get_index_daily_data(s,1800)\n if d is not None:px[s]=d.set_index('date').close.astype(float)\nP=pd.DataFrame(px).sort_index(); R=P.pct_change(); m=R.mean(axis=1)\n# One idea: smoothed beta-neutral residual reversal. All inputs end-of-day lagged.\nfor bw,lh,smooth in [(40,3,3),(40,5,5),(60,5,3),(60,5,5)]:\n rows=[]\n for t in range(bw+lh+smooth,len(P)-1):\n  sig=[]\n  for j in range(t-smooth+1,t+1):\n   vals={}\n   for s in P:\n    z=pd.concat([R[s].iloc[j-bw+1:j+1],m.iloc[j-bw+1:j+1]],axis=1).dropna()\n    if len(z)<25 or z.iloc[:,1].var()<=1e-12: continue\n    beta=z.iloc[:,0].cov(z.iloc[:,1])/z.iloc[:,1].var(); vol=z.iloc[:,0].std()\n    resid=(R[s].iloc[j-lh+1:j+1]-beta*m.iloc[j-lh+1:j+1]).sum()\n    if vol>1e-8: vals[s]=-resid/(vol*np.sqrt(bw))\n   sig.append(pd.Series(vals))\n  f=pd.concat(sig,axis=1).mean(axis=1).dropna()\n  q=pd.concat([f,R.iloc[t+1].reindex(f.index)],axis=1).dropna()\n  if len(q)>=8: rows.append((P.index[t],q.iloc[:,0].corr(q.iloc[:,1]),len(q)))\n a=np.array([x[1] for x in rows]); ns=np.array([x[2] for x in rows])\n print('PARAM',bw,lh,smooth,'dates',len(a),'avgN',round(ns.mean(),2),'coverage',round(ns.mean()/len(P.columns),4),'IC %.6f ICIR %.6f hit %.4f turnover_proxy %.4f'%(a.mean(),a.mean()/a.std(ddof=1),np.mean(a>0),np.mean(np.abs(np.diff(a)))))\n for lab,cut in [('pre2027',pd.Timestamp('2027-01-01')),('2027+',pd.Timestamp('2027-01-01')),('2029+',pd.Timestamp('2029-01-01'))]:\n  b=a[[x[0]>=cut for x in rows]] if lab!='pre2027' else a[[x[0]<cut for x in rows]]\n  print(lab,'dates',len(b),'IC %.6f ICIR %.6f'%(b.mean(),b.mean()/b.std(ddof=1)) if len(b)>2 else 'NA')\nprint('UNIVERSE',len(P.columns),'START',P.index.min(),'END',P.index.max())\n", 'file_path': 'scripts/miner_2_20290809_smoothed_residual_reversal.py'})
