oat(np.std(r[-20:])), 0.006)\n        neg = r[-60:][r[-60:] < 0]\n        dvol = max(float(np.std(neg)) if len(neg) > 1 else float(np.std(r[-60:])), 0.006)\n        t10 = c[-1] / c[-11] - 1.0\n        t20 = c[-1] / c[-21] - 1.0\n        t30 = c[-1] / c[-31] - 1.0\n        t60 = c[-1] / c[-61] - 1.0\n        consistency = float(np.mean(r[-30:] > 0))\n        feat[s] = {"quiet": t30 / (vol + 0.01) * (0.5 + 0.5 * consistency),\n                   "accel": (t10 - t20) / (vol + 0.01),\n                   "risk20": t20 / vol, "down60": t60 / dvol,\n                   "t30": t30, "vol": vol}\n    if len(feat) < 10:\n        return\n    ranks = {k: cross_rank({s: x[k] for s, x in feat.items()}) for k in FACTORS}\n    score = {s: sum(FACTORS[k] * ranks[k][s] for k in FACTORS) for s in ASSETS}\n    breadth = float(np.mean([x["t30"] > 0 for x in feat.values()]))\n    medvol = float(np.median([x["vol"] for x in feat.values()]))\n    # Bear/high-risk posture: full investment is retained, but defensives lead.\n    if breadth < 0.60 or medvol > 0.018:\n        for s in ("XAU", "US10Y", "CN10Y"):\n            score[s] += 0.45\n        for s in ("BTC", "ETH", "WTI"):\n            score[s] *= 0.45\n    invvol = {s: medvol / feat[s]["vol"] for s in feat}\n    raw = {s: max(0.05, score[s]) * np.clip(invvol.get(s, 1.0), 0.65, 1.35) for s in ASSETS}\n    target = bounded_weights(raw)\n    if len(target) == 15 and abs(sum(target.values()) - 1.0) < 1e-8:\n        rebalance_to_weights(target)\n\ndef strategy():\n    return cross_asset_strategy()\n', 'file_path': 'strategy.py'})
