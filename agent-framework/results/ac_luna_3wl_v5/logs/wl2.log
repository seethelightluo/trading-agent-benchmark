  ▶️ write_file({'content': 'import numpy as np\nfrom alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights\n\nASSETS = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]\n# Screener ensemble (directions all positive), capped at ten active factors.\nFACTORS = {"clv1": .16, "leadlag5": .15, "cons_mom30": .15,\n           "mom20": .13, "persist30": .10, "rev5": .09,\n           "down20": .09, "cons_mom20": .05, "clvtrend15": .05,\n           "eff20": .03}\nMIN_W, MAX_W = .02, .15\n_day = 0\n\ndef ranks(x):\n    out = {s: .5 for s in ASSETS}\n    a = sorted((s, v) for s, v in x.items() if np.isfinite(v))\n    if len(a) > 1:\n        for i, (s, _) in enumerate(a): out[s] = (i + 1.) / len(a)\n    return out\n\ndef bounded(score):\n    w = {s: MIN_W for s in ASSETS}; free = 1. - MIN_W * len(ASSETS)\n    active = set(ASSETS)\n    while active and free > 1e-12:\n        total = sum(max(float(score.get(s, .5)), .01) for s in active)\n        cap = [s for s in active if free * max(float(score.get(s, .5)), .01) / total > MAX_W-MIN_W]\n        if not cap:\n            for s in active: w[s] += free * max(float(score.get(s, .5)), .01) / total\n            break\n        for s in cap:\n            w[s] = MAX_W; free -= MAX_W-MIN_W; active.remove(s)\n    z = sum(w.values())\n    return {s: w[s]/z for s in ASSETS}\n\n@register_hook\ndef cross_asset_strategy():\n    global _day\n    _day += 1\n    if (_day - 1) % 10: return\n    data = {}\n    for s in ASSETS:\n        df = get_stock_daily_data(symbol=s, days=140)\n        if df is None or len(df) < 45: continue\n        c = np.asarray(df.sort_values(\'date\')[\'close\'], float)\n        h = np.asarray(df.sort_values(\'date\')[\'high\'], float)\n        lo = np.asarray(df.sort_values(\'date\')[\'low\'], float)\n        if len(c) < 35 or not np.all(np.isfinite(c[-35:])): continue\n        r = c[1:]/np.maximum(c[:-1], 1e-12)-1\n        v20 = max(float(np.std(r[-20:])), .008)\n        dv = max(float(np.std(np.minimum(r[-20:], 0))), .004)\n        clv = (2*c-h-lo)/np.maximum(h-lo, 1e-12)\n        r5, r20, r30 = c[-1]/c[-6]-1, c[-1]/c[-21]-1, c[-1]/c[-31]-1\n        data[s] = {\'clv1\': clv[-1], \'leadlag5\': r5, \'rev5\': -np.mean(r[-5:]),\n          \'mom20\': r20/(v20+.01), \'down20\': r20/(dv+.01),\n          \'cons_mom20\': r20/(v20+.01)*(.5+np.mean(r[-20:]>0)),\n          \'cons_mom30\': r30/(v20+.01)*(.5+np.mean(r[-30:]>0)),\n          \'persist30\': r30/(v20+.01)*np.mean(r[-30:]>0),\n          \'eff20\': r20/(dv+.015), \'clvtrend15\': np.mean(clv[-15:]),\n          \'trend\': r30, \'vol\': v20, \'invvol\': 1/v20}\n    if len(data) < 10: return\n    med5 = np.median([v[\'leadlag5\'] for v in data.values()])\n    raw = {f: {s: (v[\'leadlag5\']-med5 if f==\'leadlag5\' else v[f]) for s,v in data.items()} for f in FACTORS}\n    rr = {f: ranks(raw[f]) for f in FACTORS}\n    score = {s: sum(FACTORS[f]*rr[f][s] for f in FACTORS) for s in ASSETS}\n    eq = [data[s] for s in ("000300.SH","SPX","HSI","N225","SX5E","NDX") if s in data]\n    breadth = sum(v[\'trend\'] > 0 for v in eq)/max(len(eq),1)\n    medvol = np.median([v[\'vol\'] for v in data.values()])\n    unstable = medvol > .018 or breadth < .67\n    bear = len(eq)>=3 and (breadth <= .50 or (data.get(\'SPX\',{}).get(\'trend\',0)<0 and data.get(\'SPX\',{}).get(\'leadlag5\',0)<0))\n    if unstable or bear:\n        bump = .10 if bear else .06\n        for s in (\'XAU\',\'US10Y\',\'CN10Y\'): score[s] += bump\n        for s in (\'BTC\',\'ETH\',\'WTI\'): score[s] = max(.02, score[s]-(.05 if bear else .025))\n    medinv = np.median([v[\'invvol\'] for v in data.values()])\n    for s in ASSETS:\n        score[s] = max(.02, score[s])*(.97+.03*data.get(s,{}).get(\'invvol\',medinv)/max(medinv,1e-12))\n    target = bounded(score)\n    if len(target)==15 and abs(sum(target.values())-1)<1e-8: rebalance_to_weights(target)\n', 'file_path': 'strategy.py'})
