import numpy as np
from alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights

ASSETS = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
FACTORS = {"clv": 0.30, "leadlag": 0.25, "momentum": 0.24, "reversal": 0.21}
MIN_WEIGHT, MAX_WEIGHT = 0.015, 0.16
_day = 0


def ranks(values):
    valid = sorted((s, v) for s, v in values.items() if np.isfinite(v))
    out = {s: 0.5 for s in ASSETS}
    n = len(valid)
    if n > 1:
        for i, (s, _) in enumerate(valid):
            out[s] = (i + 1.0) / n
    return out


def bounded(raw):
    w = {s: max(float(raw.get(s, 1.0)), 1e-10) for s in ASSETS}
    for _ in range(30):
        total = sum(w.values())
        w = {s: v / total for s, v in w.items()}
        low = [s for s in ASSETS if w[s] < MIN_WEIGHT]
        high = [s for s in ASSETS if w[s] > MAX_WEIGHT]
        if not low and not high:
            break
        for s in low: w[s] = MIN_WEIGHT
        for s in high: w[s] = MAX_WEIGHT
    total = sum(w.values())
    return {s: w[s] / total for s in ASSETS}


@register_hook
def cross_asset_strategy():
    global _day
    _day += 1
    if (_day - 1) % 10 != 0:
        return
    data = {}
    for s in ASSETS:
        df = get_stock_daily_data(symbol=s, days=90)
        if df is None or len(df) < 30:
            continue
        df = df.sort_values("date").reset_index(drop=True)
        c = df["close"].to_numpy(dtype=float)
        h = df["high"].to_numpy(dtype=float)
        l = df["low"].to_numpy(dtype=float)
        r = c[1:] / np.maximum(c[:-1], 1e-12) - 1.0
        vol = max(float(np.std(r[-20:])), 0.008)
        data[s] = {
            "clv": (2*c[-1] - h[-1] - l[-1]) / max(h[-1] - l[-1], 1e-12),
            "ret5": c[-1] / max(c[-6], 1e-12) - 1.0,
            "rev5": -float(np.mean(r[-5:])),
            "mom20": (c[-1] / max(c[-21], 1e-12) - 1.0) / (vol + 0.01),
            "invvol": 1.0 / vol,
        }
    if len(data) < 12:
        return
    # Peer-median lead-lag proxy: relative five-day return versus the available cross-section.
    median5 = float(np.median([v["ret5"] for v in data.values()]))
    factors = {
        "clv": {s: v["clv"] for s, v in data.items()},
        "leadlag": {s: v["ret5"] - median5 for s, v in data.items()},
        "momentum": {s: v["mom20"] for s, v in data.items()},
        "reversal": {s: v["rev5"] for s, v in data.items()},
    }
    rr = {f: ranks(x) for f, x in factors.items()}
    score = {s: sum(FACTORS[f] * rr[f][s] for f in FACTORS) for s in ASSETS}
    # Moderate bearish regime: express risk reduction through defensive tradable assets.
    spx = data.get("SPX")
    if spx and spx["ret5"] < 0 and spx["mom20"] < 0:
        for s in ("XAU", "US10Y", "CN10Y"):
            score[s] += 0.14
        for s in ("BTC", "ETH", "WTI"):
            score[s] = max(0.02, score[s] - 0.07)
    mean_iv = float(np.mean([v["invvol"] for v in data.values()]))
    raw = {s: max(score[s], 0.02) * (0.88 + 0.12 * data.get(s, {"invvol": mean_iv})["invvol"] / mean_iv) for s in ASSETS}
    rebalance_to_weights(bounded(raw))
