 import numpy as np
from alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights

ASSETS = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
# Screener ensemble (directions all positive), capped at ten active factors.
FACTORS = {"clv1": .16, "leadlag5": .15, "cons_mom30": .15,
           "mom20": .13, "persist30": .10, "rev5": .09,
           "down20": .09, "cons_mom20": .05, "clvtrend15": .05,
           "eff20": .03}
MIN_W, MAX_W = .02, .15
_day = 0

def ranks(x):
    out = {s: .5 for s in ASSETS}
    a = sorted((s, v) for s, v in x.items() if np.isfinite(v))
    if len(a) > 1:
        for i, (s, _) in enumerate(a): out[s] = (i + 1.) / len(a)
    return out

def bounded(score):
    w = {s: MIN_W for s in ASSETS}; free = 1. - MIN_W * len(ASSETS)
    active = set(ASSETS)
    while active and free > 1e-12:
        total = sum(max(float(score.get(s, .5)), .01) for s in active)
        cap = [s for s in active if free * max(float(score.get(s, .5)), .01) / total > MAX_W-MIN_W]
        if not cap:
            for s in active: w[s] += free * max(float(score.get(s, .5)), .01) / total
            break
        for s in cap:
            w[s] = MAX_W; free -= MAX_W-MIN_W; active.remove(s)
    z = sum(w.values())
    return {s: w[s]/z for s in ASSETS}

@register_hook
def cross_asset_strategy():
    global _day
    _day += 1
    if (_day - 1) % 10: return
    data = {}
    for s in ASSETS:
        df = get_stock_daily_data(symbol=s, days=140)
        if df is None or len(df) < 45: continue
        c = np.asarray(df.sort_values('date')['close'], float)
        h = np.asarray(df.sort_values('date')['high'], float)
        lo = np.asarray(df.sort_values('date')['low'], float)
        if len(c) < 35 or not np.all(np.isfinite(c[-35:])): continue
        r = c[1:]/np.maximum(c[:-1], 1e-12)-1
        v20 = max(float(np.std(r[-20:])), .008)
        dv = max(float(np.std(np.minimum(r[-20:], 0))), .004)
        clv = (2*c-h-lo)/np.maximum(h-lo, 1e-12)
        r5, r20, r30 = c[-1]/c[-6]-1, c[-1]/c[-21]-1, c[-1]/c[-31]-1
        data[s] = {'clv1': clv[-1], 'leadlag5': r5, 'rev5': -np.mean(r[-5:]),
          'mom20': r20/(v20+.01), 'down20': r20/(dv+.01),
          'cons_mom20': r20/(v20+.01)*(.5+np.mean(r[-20:]>0)),
          'cons_mom30': r30/(v20+.01)*(.5+np.mean(r[-30:]>0)),
          'persist30': r30/(v20+.01)*np.mean(r[-30:]>0),
          'eff20': r20/(dv+.015), 'clvtrend15': np.mean(clv[-15:]),
          'trend': r30, 'vol': v20, 'invvol': 1/v20}
    if len(data) < 10: return
    med5 = np.median([v['leadlag5'] for v in data.values()])
    raw = {f: {s: (v['leadlag5']-med5 if f=='leadlag5' else v[f]) for s,v in data.items()} for f in FACTORS}
    rr = {f: ranks(raw[f]) for f in FACTORS}
    score = {s: sum(FACTORS[f]*rr[f][s] for f in FACTORS) for s in ASSETS}
    eq = [data[s] for s in ("000300.SH","SPX","HSI","N225","SX5E","NDX") if s in data]
    breadth = sum(v['trend'] > 0 for v in eq)/max(len(eq),1)
    medvol = np.median([v['vol'] for v in data.values()])
    unstable = medvol > .018 or breadth < .67
    bear = len(eq)>=3 and (breadth <= .50 or (data.get('SPX',{}).get('trend',0)<0 and data.get('SPX',{}).get('leadlag5',0)<0))
    if unstable or bear:
        bump = .10 if bear else .06
        for s in ('XAU','US10Y','CN10Y'): score[s] += bump
        for s in ('BTC','ETH','WTI'): score[s] = max(.02, score[s]-(.05 if bear else .025))
    medinv = np.median([v['invvol'] for v in data.values()])
    for s in ASSETS:
        score[s] = max(.02, score[s])*(.97+.03*data.get(s,{}).get('invvol',medinv)/max(medinv,1e-12))
    target = bounded(score)
    if len(target)==15 and abs(sum(target.values())-1)<1e-8: rebalance_to_weights(target)


