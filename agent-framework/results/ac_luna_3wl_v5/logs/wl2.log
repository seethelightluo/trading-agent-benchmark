 import numpy as np
from alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights

ASSETS = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
# Screener ensemble (nine active factors; weights sum to one).
FACTORS = {
    "invvol": .20, "downbreadth": .15, "recovery": .12,
    "acceleration": .12, "highvol": .10, "switch": .10,
    "quiet": .11, "residual": .05, "range": .05,
}
REBALANCE_DAYS = 10
MIN_W, MAX_W = .03, .15
_day = 0


def xrank(vals):
    good = [(s, float(v)) for s, v in vals.items() if np.isfinite(v)]
    good.sort(key=lambda z: z[1])
    out = {s: .5 for s in ASSETS}
    if good:
        for i, (s, _) in enumerate(good):
            out[s] = (i + 1.) / len(good)
    return out


def bounded(raw):
    # Deterministic capped simplex projection, retaining full investment.
    raw = {s: max(float(raw.get(s, .01)), 1e-8) for s in ASSETS}
    base = len(ASSETS) * MIN_W
    w = {s: MIN_W + (1-base) * raw[s] / sum(raw.values()) for s in ASSETS}
    for _ in range(50):
        over = [s for s in ASSETS if w[s] > MAX_W + 1e-12]
        if not over:
            break
        excess = sum(w[s] - MAX_W for s in over)
        for s in over:
            w[s] = MAX_W
        rest = [s for s in ASSETS if s not in over]
        den = sum(raw[s] for s in rest)
        if not rest or den <= 0:
            break
        for s in rest:
            w[s] += excess * raw[s] / den
    z = sum(w.values())
    return {s: max(0., w[s] / z) for s in ASSETS}


@register_hook
def cross_asset_strategy():
    global _day
    _day += 1
    if (_day - 1) % REBALANCE_DAYS:
        return

    features = {}
    for s in ASSETS:
        df = get_stock_daily_data(symbol=s, days=230)
        if df is None or len(df) < 95:
            continue
        close = np.asarray(df.sort_values("date").iloc[:-1]["close"], dtype=float)
        if len(close) < 65 or np.any(~np.isfinite(close[-65:])) or np.any(close[-65:] <= 0):
            continue
        ret = close[1:] / close[:-1] - 1.
        v20 = max(float(np.std(ret[-20:])), .006)
        v60 = max(float(np.std(ret[-60:])), .006)
        neg = ret[-60:][ret[-60:] < 0]
        dvol = max(float(np.std(neg)) if len(neg) > 1 else v60, .006)
        t5 = close[-1] / close[-6] - 1
        t10 = close[-1] / close[-11] - 1
        t20 = close[-1] / close[-21] - 1
        t30 = close[-1] / close[-31] - 1
        t60 = close[-1] / close[-61] - 1
        path20 = np.sum(np.abs(ret[-20:])) + .02
        efficiency = abs(t20) / path20
        # Slow, lagged proxies for the persisted screener factors.
        features[s] = {
            "invvol": 1.0 / (.7*v20 + .3*v60),
            "downbreadth": -float(np.mean(ret[-60:] < 0)),
            "recovery": t5 - .35 * min(t30, 0.),
            "acceleration": (t10 - t30/3.) / (v20 + .01),
            "highvol": min(v20 / (v60 + .006), 2.),
            "switch": (-t10 / (v20 + .01)) if (t30 < 0 or v20 > .018) else (t10 / (v20 + .01)),
            "quiet": t30 / (v20 + .01) * (.5 + .5 * float(np.mean(ret[-30:] > 0))),
            "residual": (t20 - t20),  # filled after the cross-sectional median is known
            "range": t20 / (path20 + .02),
            "vol": v20, "t30": t30,
        }
    if len(features) < 10:
        return

    median_t20 = float(np.median([x["t20"] if "t20" in x else 0. for x in []])) if False else None
    # Market-residual trend: subtract the contemporaneous cross-sectional median return.
    # (The explicit t20 field is kept local to avoid using any future observation.)
    t20s = {}
    for s in features:
        df = get_stock_daily_data(symbol=s, days=230)
        c = np.asarray(df.sort_values("date").iloc[:-1]["close"], dtype=float)
        t20s[s] = c[-1] / c[-21] - 1.
    med = float(np.median(list(t20s.values())))
    for s in features:
        features[s]["residual"] = (t20s[s] - med) / (features[s]["vol"] + .01)

    ranks = {k: xrank({s: x[k] for s, x in features.items()}) for k in FACTORS}
    score = {s: sum(FACTORS[k] * ranks[k][s] for k in FACTORS) for s in ASSETS}
    median_vol = float(np.median([x["vol"] for x in features.values()]))
    breadth = float(np.mean([x["t30"] > 0 for x in features.values()]))
    stressed = median_vol > .018 or breadth < .45
    # High-risk sideways/rebound posture: defensive tradable assets, never cash.
    if stressed or breadth < .60:
        for s in ("XAU", "US10Y", "CN10Y"):
            score[s] += .35
        for s in ("BTC", "ETH", "WTI"):
            score[s] *= .55
    inv_risk = {s: np.clip(median_vol / x["vol"], .65, 1.35) for s, x in features.items()}
    raw = {s: max(score[s], .02) * inv_risk.get(s, 1.) for s in ASSETS}
    target = bounded(raw)
    if abs(sum(target.values()) - 1.) < 1e-8 and all(np.isfinite(target[s]) and target[s] >= 0 for s in ASSETS):
        rebalance_to_weights(target)

def strategy():
    return cross_asset_strategy()


