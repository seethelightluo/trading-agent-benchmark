))\n   pd.DataFrame({'date':dates,'ic':z}).to_csv('scripts/miner_1_20290419_residual_trend_signal.csv',index=False)\nprint('period',P.index[0],P.index[-1],'assets',len(A))\n", 'file_path': 'scripts/miner_1_20290419_residual_trend.py'})
