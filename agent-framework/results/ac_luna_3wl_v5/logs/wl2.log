           "eff20": .11, "down20": .10, "ram20": .08, "mktres30": .07, "peer5": .02}
REBALANCE_DAYS = 10
POSITION_SCALING = .22
MIN_W, MAX_W = .04, .13
_day = 0


def cs_rank(vals):
    out = {s: .5 for s in ASSETS}
    good = sorted((s, float(v)) for s, v in vals.items() if np.isfinite(v))
    if not good:
        return out
    for i, (s, _) in enumerate(good):
        out[s] = (i + 1.0) / len(good)
    return out


def make_weights(score, invvol):
    raw = {}
    for s in ASSETS:
        # Mild score tilt and inverse-volatility moderation avoid concentration.
        raw[s] = max(.35, .5 + POSITION_SCALING * (score[s] - .5)) * np.clip(invvol.get(s, 1.), .75, 1.25)
    base = 1.0 - len(ASSETS) * MIN_W
    w = {s: MIN_W + base * raw[s] / sum(raw.values()) for s in ASSETS}
    for _ in range(20):
        high = [s for s in ASSETS if w[s] > MAX_W]
        if not high:
            break
        excess = sum(w[s] - MAX_W for s in high)
        for s in high:
            w[s] = MAX_W
        free = [s for s in ASSETS if s not in high]
        den = sum(raw[s] for s in free)
        if not free or den <= 0:
            break
        for s in free:
            w[s] += excess * raw[s] / den
    z = sum(w.values())
    return {s: max(0., w[s] / z) for s in ASSETS}


