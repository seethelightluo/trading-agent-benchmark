import numpy as np
from alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights

ASSETS = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
# Current screener ensemble; all signals are ranked cross-sectionally.
FACTORS = {"mom30": .18, "mom20": .15, "ram20": .10, "eff20": .18,
           "down20": .15, "resid30": .10, "persist30": .08, "negclv1": .06}
REBALANCE_DAYS = 10
POSITION_SCALING = .55
MIN_W, MAX_W = .04, .14
_day = 0


def rank(x):
    good = sorted((s, v) for s, v in x.items() if np.isfinite(v))
    out = {s: .5 for s in ASSETS}
    if not good:
        return out
    for i, (s, _) in enumerate(good):
        out[s] = (i + 1.) / len(good)
    return out


def make_weights(score, invvol):
    raw = {}
    for s in ASSETS:
        raw[s] = max(.05, .5 + POSITION_SCALING * (score[s] - .5)) * np.clip(invvol.get(s, 1.), .70, 1.30)
    w = {s: MIN_W + (1 - len(ASSETS) * MIN_W) * raw[s] / sum(raw.values()) for s in ASSETS}
    # Enforce bounds while retaining a complete, fully invested vector.
    for _ in range(30):
        over = [s for s in ASSETS if w[s] > MAX_W + 1e-10]
        if not over:
            break
        excess = sum(w[s] - MAX_W for s in over)
        for s in over:
            w[s] = MAX_W
        free = [s for s in ASSETS if s not in over]
        den = sum(raw[s] for s in free)
        if not free or den <= 0:
            break
        for s in free:
            w[s] += excess * raw[s] / den
    z = sum(w.values())
    return {s: max(0., w[s] / z) for s in ASSETS}


@register_hook
def cross_asset_strategy():
    global _day
    _day += 1
    if (_day - 1) % REBALANCE_DAYS != 0:
        return
    f = {}
    for s in ASSETS:
        df = get_stock_daily_data(symbol=s, days=190)
        if df is None or len(df) < 70:
            continue
        df = df.sort_values("date")
        c = np.asarray(df["close"], float)[:-1]
        hi = np.asarray(df["high"], float)[:-1]
        lo = np.asarray(df["low"], float)[:-1]
        if len(c) < 65 or np.any(c[-65:] <= 0):
            continue
        r = c[1:] / c[:-1] - 1.
        v20 = max(float(np.std(r[-20:])), .006)
        dn = max(float(np.std(np.minimum(r[-20:], 0))), .003)
        t20, t30 = c[-1] / c[-21] - 1., c[-1] / c[-31] - 1.
        p20, p30 = np.mean(r[-20:] > 0), np.mean(r[-30:] > 0)
        bar = np.maximum(hi[-30:] - lo[-30:], c[-30:] * .001) / c[-30:]
        rng = max(float(np.mean(bar)), .002)
        # Negative close-location value is a reversal/defensive signal: lower CLV ranks higher.
        clv = (2. * c[-1] - hi[-1] - lo[-1]) / max(hi[-1] - lo[-1], c[-1] * .001)
        f[s] = {"mom30": t30 / (v20 + .01) * (.5 + p30),
                "mom20": t20 / (v20 + .01) * (.5 + p20),
                "ram20": t20 / (v20 + .01),
                "eff20": t20 / (dn + .015),
                "down20": t20 / (dn + .01),
                "persist30": t30 / (rng + .01) * (.5 + p30),
                "negclv1": -clv, "resid30": t30, "vol": v20, "t30": t30}
    if len(f) < 10:
        return
    med = np.median([v["t30"] for v in f.values()])
    for v in f.values():
        v["resid30"] -= med
    ranks = {k: rank({s: v[k] for s, v in f.items()}) for k in FACTORS}
    score = {s: sum(FACTORS[k] * ranks[k][s] for k in FACTORS) for s in ASSETS}
    eq = [s for s in ("000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX") if s in f]
    breadth = np.mean([f[s]["t30"] > 0 for s in eq]) if eq else .5
    market_vol = float(np.median([v["vol"] for v in f.values()]))
    # Bear/high-vol regime: full investment is retained, but defensives gain weight.
    if breadth < .50 or market_vol > .018:
        for s in ("XAU", "US10Y", "CN10Y"):
            if s in score: score[s] += .08
        for s in ("BTC", "ETH", "WTI"):
            if s in score: score[s] -= .04
