import numpy as np
from alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights

ASSETS = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
# Screener ensemble, eight active factors; all signals use completed bars only.
FACTORS = {
    "compression": 0.18,
    "dispersion_reversal": 0.16,
    "quiet_trend": 0.16,
    "down_asym": 0.12,
    "recovery": 0.10,
    "relative_risk_trend": 0.10,
    "stress_risk_trend": 0.10,
    "peer_leadlag": 0.08,
}
MIN_W, MAX_W, CADENCE = 0.04, 0.14, 10
_day = 0


def cross_rank(vals):
    out = {s: 0.5 for s in ASSETS}
    good = sorted((s, float(v)) for s, v in vals.items() if np.isfinite(v))
    for i, (s, _) in enumerate(good):
        out[s] = (i + 1.0) / len(good)
    return out


def bounded_weights(raw):
    raw = {s: max(float(raw.get(s, 0.05)), 1e-9) for s in ASSETS}
    w = {s: MIN_W + (1 - len(ASSETS) * MIN_W) * raw[s] / sum(raw.values()) for s in ASSETS}
    for _ in range(40):
        high = [s for s in ASSETS if w[s] > MAX_W + 1e-10]
        if not high:
            break
        excess = sum(w[s] - MAX_W for s in high)
        for s in high:
            w[s] = MAX_W
        rest = [s for s in ASSETS if s not in high]
        den = sum(raw[s] for s in rest)
        if not rest or den <= 0:
            break
        for s in rest:
            w[s] += excess * raw[s] / den
    total = sum(w.values())
    return {s: w[s] / total for s in ASSETS}


@register_hook
def cross_asset_strategy():
    global _day
    _day += 1
    if (_day - 1) % CADENCE != 0:
        return
    data = {}
    for s in ASSETS:
        df = get_stock_daily_data(symbol=s, days=230)
        if df is None or len(df) < 110:
            continue
        c = np.asarray(df.sort_values("date").iloc[:-1]["close"], dtype=float)
        if len(c) < 70 or np.any(~np.isfinite(c[-70:])) or np.any(c[-70:] <= 0):
            continue
        r = c[1:] / c[:-1] - 1.0
        v20 = max(float(np.std(r[-20:])), 0.004)
        v60 = max(float(np.std(r[-60:])), 0.004)
        t5, t10 = c[-1] / c[-6] - 1.0, c[-1] / c[-11] - 1.0
        t20, t30, t60 = c[-1] / c[-21] - 1.0, c[-1] / c[-31] - 1.0, c[-1] / c[-61] - 1.0
        neg = r[-30:][r[-30:] < 0]
        down = float(np.std(neg)) if len(neg) > 1 else v20
        eff = abs(t20) / (np.sum(np.abs(r[-20:])) + 1e-6)
        data[s] = {"compression": v60 / v20, "dispersion_reversal": -t5 / (v20 + .01),
                   "quiet_trend": t20 / (v60 + .01) * eff, "down_asym": -down / (v20 + .01),
                   "recovery": (t10 - t60) / (v60 + .01), "relative_risk_trend": t20 / (v20 + .01),
                   "stress_risk_trend": (t10 if t30 >= 0 else -t10) / (v20 + .01),
                   "vol": v20, "t30": t30}
    if len(data) < 10:
        return
    # Peer-median lead-lag: recent five-day relative return versus the cross-sectional peer median.
    peer5 = float(np.median([d["dispersion_reversal"] for d in data.values()]))
    for s, d in data.items():
        d["peer_leadlag"] = d["dispersion_reversal"] - peer5
    ranks = {f: cross_rank({s: d[f] for s, d in data.items()}) for f in FACTORS}
    score = {s: sum(FACTORS[f] * ranks[f][s] for f in FACTORS) for s in ASSETS}
    medvol = float(np.median([d["vol"] for d in data.values()]))
    breadth = float(np.mean([d["t30"] > 0 for d in data.values()]))
    stressed = medvol > 0.018 or breadth < 0.50
    if stressed:
        for s in ("XAU", "US10Y", "CN10Y"):
            score[s] += 0.18
        for s in ("BTC", "ETH", "WTI"):
            score[s] *= 0.65
    raw = {}
    for s in ASSETS:
        v = data[s]["vol"] if s in data else medvol
        raw[s] = max(score[s], 0.02) * np.clip(medvol / max(v, 0.004), 0.75, 1.20)
    target = bounded_weights(raw)
    if all(np.isfinite(target[s]) and target[s] >= 0 for s in ASSETS) and abs(sum(target.values()) - 1.0) < 1e-8:
        rebalance_to_weights(target)


def strategy():
    return cross_asset_strategy()
