et(ASSETS) and all(np.isfinite(v) and v >= 0 for v in target.values()) and abs(sum(target.values())-1.) < 1e-8:\n        rebalance_to_weights(target)\n\ndef strategy():\n    return cross_asset_strategy()\n', 'file_path': 'strategy.py'})
