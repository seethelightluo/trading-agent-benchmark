import numpy as np
from alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights

ASSETS = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
FACTORS = {"mom20": .18, "mom30": .12, "resid30": .10, "downmom": .18,
           "eff": .16, "persist": .06, "lead": .10, "rev": .10}
MIN_W, MAX_W = .025, .16
_day = 0

def ranks(vals):
    good = sorted((s, v) for s, v in vals.items() if np.isfinite(v))
    out = {s: .5 for s in ASSETS}
    if len(good) > 1:
        for i, (s, _) in enumerate(good): out[s] = (i + 1.) / len(good)
    return out

def make_weights(score):
    raw = {s: max(.05, float(score.get(s, .5))) for s in ASSETS}
    base = 1. - MIN_W * len(ASSETS)
    w = {s: MIN_W + base * raw[s] / sum(raw.values()) for s in ASSETS}
    # Iterative cap redistribution; always returns a complete, invested vector.
    for _ in range(20):
        over = sum(max(0., w[s] - MAX_W) for s in ASSETS)
        if over < 1e-10: break
        capped = {s for s in ASSETS if w[s] >= MAX_W - 1e-10}
        for s in capped: w[s] = MAX_W
        free = [s for s in ASSETS if s not in capped]
        if not free: break
        z = sum(raw[s] for s in free)
        for s in free: w[s] += over * raw[s] / z
    z = sum(w.values())
    return {s: max(0., w[s] / z) for s in ASSETS}

@register_hook
def cross_asset_strategy():
    global _day
    _day += 1
    if (_day - 1) % 10: return
    data = {}
    for s in ASSETS:
        df = get_stock_daily_data(symbol=s, days=180)
        if df is None or len(df) < 65: continue
        c = np.asarray(df.sort_values("date")["close"], float)
        if not np.all(np.isfinite(c[-65:])) or c[-1] <= 0: continue
        r = c[1:] / np.maximum(c[:-1], 1e-12) - 1.
        v = max(float(np.std(r[-20:])), .008)
        dn = max(float(np.std(np.minimum(r[-20:], 0.))), .004)
        t20, t30 = c[-1]/c[-21]-1., c[-1]/c[-31]-1.
        data[s] = {"mom20": t20/(v+.01)*(0.5+np.mean(r[-20:] > 0)),
                   "mom30": t30/(v+.01)*(0.5+np.mean(r[-30:] > 0)),
                   "downmom": t20/(dn+.01), "eff": t20/(dn+.015),
                   "persist": t30/(v+.01)*np.mean(r[-30:] > 0),
                   "lead": c[-1]/c[-6]-1., "rev": -float(np.mean(r[-5:])),
                   "trend": t30, "vol": v}
    if len(data) < 10: return
    market = float(np.median([x["trend"] for x in data.values()]))
    for x in data.values(): x["resid30"] = x["trend"] - market
    rr = {f: ranks({s: data[s][f] for s in data}) for f in FACTORS}
    score = {s: sum(FACTORS[f] * rr[f][s] for f in FACTORS) for s in ASSETS}
    eq = [data[s] for s in ("000300.SH", "SPX", "HSI", "N225", "SX5E", "NDX") if s in data]
    breadth = sum(x["trend"] > 0 for x in eq) / max(1, len(eq))
    medvol = float(np.median([x["vol"] for x in data.values()]))
    bear = len(eq) >= 3 and (breadth <= .50 or (data.get("SPX", {}).get("trend", 0) < 0 and data.get("SPX", {}).get("lead", 0) < 0))
    high = medvol > .018 or breadth < .67
    if high or bear:
        bump = .16 if bear else .10
        for s in ("XAU", "US10Y", "CN10Y"): score[s] += bump
        for s in ("BTC", "ETH", "WTI"): score[s] = max(.05, score[s] - (.08 if bear else .04))
    # Mild volatility scaling, retaining the complete 15-asset long-only target.
    med = float(np.median([x["vol"] for x in data.values()]))
    for s in ASSETS:
        if s in data: score[s] *= .985 + .015 * med / data[s]["vol"]
    target = make_weights(score)
    if len(target) == 15 and abs(sum(target.values()) - 1.) < 1e-8:
        rebalance_to_weights(target)
