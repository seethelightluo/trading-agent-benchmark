 import numpy as np
from alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights

ASSETS = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
FACTORS = {"quiet": .20, "compression": .19, "stress": .18, "breadth": .16, "relative": .10, "breadth_mom": .08, "reversal": .07, "down": .02}
CADENCE = 10
_day = 0

def cs_rank(vals):
    good = sorted((s, float(v)) for s, v in vals.items() if np.isfinite(v))
    out = {s: .5 for s in ASSETS}
    if not good: return out
    for i, (s, _) in enumerate(good): out[s] = (i + 1.0) / len(good)
    return out

def bounded_weights(score):
    # Full investment, modest 1% floor and 22% cap for a 15-asset universe.
    floor, cap = .01, .22
    x = {s: max(float(score.get(s, .5)), 1e-8) for s in ASSETS}
    w = {s: floor + (1-floor*len(ASSETS))*x[s]/sum(x.values()) for s in ASSETS}
    for _ in range(30):
        high = [s for s in ASSETS if w[s] > cap + 1e-12]
        if not high: break
        excess = sum(w[s]-cap for s in high)
        for s in high: w[s] = cap
        rest = [s for s in ASSETS if s not in high]
        den = sum(x[s] for s in rest)
        for s in rest: w[s] += excess*x[s]/max(den, 1e-12)
    z = sum(w.values())
    return {s: w[s]/z for s in ASSETS}

@register_hook
def cross_asset_strategy():
    global _day
    _day += 1
    if (_day - 1) % CADENCE != 0: return
    obs = {}
    for s in ASSETS:
        df = get_stock_daily_data(symbol=s, days=260)
        if df is None or len(df) < 75: continue
        c = np.asarray(df.sort_values("date").iloc[:-1]["close"], dtype=float)
        c = c[np.isfinite(c) & (c > 0)]
        if len(c) < 70: continue
        r = c[1:]/c[:-1]-1.0
        v10=max(np.std(r[-10:]), .003); v20=max(np.std(r[-20:]), .003); v60=max(np.std(r[-60:]), .003)
        t5=c[-1]/c[-6]-1; t10=c[-1]/c[-11]-1; t20=c[-1]/c[-21]-1; t30=c[-1]/c[-31]-1
        eff=abs(t20)/(np.sum(abs(r[-20:]))+1e-9)
        neg=r[-30:][r[-30:]<0]
        dvol=np.std(neg) if len(neg)>1 else v20
        obs[s]={"quiet":t20/v60*eff, "compression":-v10/v60,
                "stress":(t10 if t30>=0 else -t10)/(v20+.01),
                "breadth":t30/(v60+.01), "relative":t20/(v20+.01),
                "breadth_mom":(t10+t20)/(v20+.01), "reversal":-t5/(v10+.01),
                "down":-dvol/(v20+.01), "vol":v20, "t30":t30}
    if len(obs) < 10: return
    ranks={f:cs_rank({s:v[f] for s,v in obs.items()}) for f in FACTORS}
    score={s:sum(FACTORS[f]*ranks[f][s] for f in FACTORS) for s in ASSETS}
    breadth=float(np.mean([v["t30"]>0 for v in obs.values()]))
    spx30=obs.get("SPX",{}).get("t30",0.0)
    bear=(breadth < .45 or spx30 < -.05)
    if bear:
        # Defensive tradable assets replace cash in liquidation regimes.
        strength=min(1.0, max(0.0, (-spx30-.02)/.18) + max(0.0, .45-breadth))
        for s in ("XAU","US10Y","CN10Y"): score[s] *= 1.0 + .55*strength
        for s in ("BTC","ETH","WTI","SOX","NDX","COPPER"): score[s] *= max(.18, 1.0-.70*strength)
    medvol=float(np.median([v["vol"] for v in obs.values()]))
    for s in ASSETS:
        score[s]=max(.01,score[s])*np.clip(medvol/max(obs.get(s,{}).get("vol",medvol),.003),.65,1.25)
    target=bounded_weights(score)
    if set(target)==set(ASSETS) and all(np.isfinite(v) and v>=0 for v in target.values()) and abs(sum(target.values())-1)<1e-8:
        rebalance_to_weights(target)

def strategy():
    return cross_asset_strategy()


