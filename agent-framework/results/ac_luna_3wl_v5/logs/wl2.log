rng=(high-low).replace(0,np.nan); clv=((close-low)/rng-0.5).clip(-1,1); f=clv.rolling(3,min_periods=3).mean(); f=f.sub(f.mean(axis=1),axis=0).div(f.std(axis=1).replace(0,np.nan),axis=0)
out=[]; allvals={}
for h in [1,3,5,10]:
