 import numpy as np
from alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights

ASSETS = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
# Screener quality-IC ensemble; all signals are calculated from completed bars only.
FACTORS = {
    "vol_compression": 0.22, "recovery_accel": 0.14, "switch": 0.14,
    "breadth_trend": 0.12, "consistency_mom": 0.10, "quiet_trend": 0.08,
    "mom_accel": 0.08, "down_asym": 0.06, "reversal3": 0.06,
}
MIN_W, MAX_W, CADENCE = 0.04, 0.14, 10
_day = 0


def ranks(vals):
    out = {s: .5 for s in ASSETS}
    good = sorted((s, float(v)) for s, v in vals.items() if np.isfinite(v))
    n = len(good)
    for i, (s, _) in enumerate(good):
        out[s] = (i + 1.) / n
    return out


def capped_weights(raw):
    # Capped simplex projection by iterative redistribution; never creates cash.
    raw = {s: max(float(raw.get(s, .05)), 1e-8) for s in ASSETS}
    w = {s: MIN_W + (1 - 15 * MIN_W) * raw[s] / sum(raw.values()) for s in ASSETS}
    for _ in range(30):
        high = [s for s in ASSETS if w[s] > MAX_W + 1e-10]
        if not high:
            break
        excess = sum(w[s] - MAX_W for s in high)
        for s in high:
            w[s] = MAX_W
        rest = [s for s in ASSETS if s not in high]
        den = sum(raw[s] for s in rest)
        for s in rest:
            w[s] += excess * raw[s] / den
    total = sum(w.values())
    return {s: w[s] / total for s in ASSETS}


@register_hook
def cross_asset_strategy():
    global _day
    _day += 1
    if (_day - 1) % CADENCE:
        return
    data = {}
    for s in ASSETS:
        df = get_stock_daily_data(symbol=s, days=230)
        if df is None or len(df) < 100:
            continue
        close = np.asarray(df.sort_values("date").iloc[:-1]["close"], dtype=float)
        if len(close) < 65 or np.any(~np.isfinite(close[-65:])) or np.any(close[-65:] <= 0):
            continue
        ret = close[1:] / close[:-1] - 1
        v20 = max(float(np.std(ret[-20:])), .004)
        v60 = max(float(np.std(ret[-60:])), .004)
        t3 = close[-1] / close[-4] - 1
        t5 = close[-1] / close[-6] - 1
        t10 = close[-1] / close[-11] - 1
        t20 = close[-1] / close[-21] - 1
        t30 = close[-1] / close[-31] - 1
        neg20 = ret[-20:][ret[-20:] < 0]
        downside = float(np.std(neg20)) if len(neg20) > 1 else v20
        cons = float(np.mean(ret[-20:] > 0))
        data[s] = {
            "vol_compression": v60 / v20,
            "recovery_accel": (t5 - t20) / (v20 + .01),
            "switch": (t10 / (v20 + .01)) if t30 >= 0 else (-t5 / (v20 + .01)),
            "breadth_trend": t30 / (v20 + .01) * (.35 + .65 * cons),
            "consistency_mom": t20 / (v20 + .01) * cons,
            "quiet_trend": t30 / (v60 + .01),
            "mom_accel": (t10 - t30) / (v20 + .01),
            "down_asym": -downside / (v20 + .01),
            "reversal3": -t3 / (v20 + .01),
            "vol": v20, "t30": t30,
        }
    if len(data) < 10:
        return
    rr = {f: ranks({s: x[f] for s, x in data.items()}) for f in FACTORS}
    score = {s: sum(FACTORS[f] * rr[f][s] for f in FACTORS) for s in ASSETS}
    median_vol = float(np.median([x["vol"] for x in data.values()]))
    breadth = float(np.mean([x["t30"] > 0 for x in data.values()]))
    stressed = median_vol > .018 or breadth < .55
    if stressed:
        for s in ("XAU", "US10Y", "CN10Y"):
            score[s] += .22
        for s in ("BTC", "ETH", "WTI"):
            score[s] *= .60
    raw = {}
    for s in ASSETS:
        # inverse risk is a sizing adjustment, not a cash or leverage sleeve
        vol = data[s]["vol"] if s in data else median_vol
        raw[s] = max(score[s], .03) * np.clip(median_vol / max(vol, .004), .70, 1.25)
    target = capped_weights(raw)
    if abs(sum(target.values()) - 1.0) < 1e-8 and all(np.isfinite(v) and v >= 0 for v in target.values()):
        rebalance_to_weights(target)


def strategy():
    return cross_asset_strategy()


