  ▶️ write_file({'content': "import pandas as pd, numpy as np, os\nfrom scipy.stats import spearmanr\nU=['000300.SH','SPX','HSI','N225','SX5E','000688.SH','SOX','NDX','XAU','COPPER','WTI','BTC','ETH','US10Y','CN10Y']\nD={s:pd.read_csv('../persistent/stock_data/'+s+'.csv',parse_dates=['date']).set_index('date') for s in U}\n# one idea: lagged intraday reversal normalized by prior true range\nrows=[]\nfor s,d in D.items():\n d=d.loc[:'2027-07-28'].copy(); prev=d.shift(1)\n # signal known at t: prior session close/open return, scaled by prior range/close\n intr=(prev['close']/prev['open']-1)\n rng=(prev['high']-prev['low'])/prev['close']\n fac= -intr/(rng.replace(0,np.nan)+0.002)\n fwd=d['close'].shift(-1)/d['close']-1\n z=pd.DataFrame({'f':fac,'r':fwd,'s':s},index=d.index).dropna(); rows.append(z)\nX=pd.concat(rows)\nics=[]; ns=[]\nfor dt,g in X.groupby(level=0):\n if len(g)>=8:\n  ics.append(spearmanr(g.f,g.r).statistic); ns.append(len(g))\nics=np.array(ics)\nprint('dates',len(ics),'avgN',np.mean(ns),'IC %.6f ICIR %.6f hit %.4f coverage %.4f'%(np.nanmean(ics),np.nanmean(ics)/np.nanstd(ics,ddof=1),np.mean(ics>0),len(X)/(len(ics)*15)))\nfor a,b in [('2020','2021'),('2022','2023'),('2024','2025'),('2026','2027')]:\n q=X.loc[a:b]; z=[]\n for _,g in q.groupby(level=0):\n  if len(g)>=8:z.append(spearmanr(g.f,g.r).statistic)\n z=np.array(z); print(a,b,len(z),np.mean(z),np.mean(z)/np.std(z,ddof=1))\n# horizons decay\nfor h in [1,3,5,10]:\n vals=[]\n for s,d in D.items():\n  d=d.loc[:'2027-07-28']; p=d.shift(1); fac=-(p.close/p.open-1)/(((p.high-p.low)/p.close)+.002)\n  r=d.close.shift(-h)/d.close-1; vals.append(pd.DataFrame({'f':fac,'r':r},index=d.index))\n q=pd.concat(vals); z=[]\n for _,g in q.dropna().groupby(level=0):\n  if len(g)>=8:z.append(spearmanr(g.f,g.r).statistic)\n z=np.array(z);print('h',h,'IC',np.mean(z),'ICIR',np.mean(z)/np.std(z,ddof=1))\nPY\npython scripts/miner_2_20270729_intraday_reversal.py", 'file_path': 'scripts/miner_2_20270729_intraday_reversal.py'})
