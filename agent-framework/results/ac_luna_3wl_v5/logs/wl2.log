  ▶️ write_file({'content': "import numpy as np, pandas as pd\nfrom scipy.stats import spearmanr\nfrom alphacrafter.sim.utils import get_index_daily_data\n\nU=['000300.SH','SPX','HSI','N225','SX5E','000688.SH','SOX','NDX','XAU','COPPER','WTI','BTC','ETH','US10Y','CN10Y']\nframes={}\nfor s in U:\n    d=get_index_daily_data(s, days=4000)\n    if d is not None and len(d)>100:\n        d=d.copy(); d['date']=pd.to_datetime(d['date']); d=d.drop_duplicates('date').set_index('date').sort_index()\n        frames[s]=d\nclose=pd.DataFrame({s:d['close'] for s,d in frames.items()})\nret=np.log(close).diff()\n# Defensive persistence: medium trend rewarded only when path is smooth and drawdown contained.\n# factor available at date t uses data through t-1; 60d log return divided by vol, times recovery from trailing drawdown.\nrollret=ret.rolling(60).sum()\nvol=ret.rolling(40).std()*np.sqrt(252)\npath=ret.abs().rolling(60).sum()\neff=rollret.abs()/path.replace(0,np.nan)\n# drawdown penalty: current close relative to trailing 80d high, bounded [0,1]\nhigh=close.rolling(80).max(); dd=(close/high-1).clip(-1,0)\n# preserve direction, favor positive trends, penalize deep drawdowns\nfactor=(rollret/(vol+1e-8))*((1+dd).clip(.25,1))* (0.5+0.5*eff)\n# lag one bar; next-day log return\nf=factor.shift(1); y=ret.shift(-0) # at row date, return date->next? diff is close date / prior. use next return\n# forward return from close t to close t+1\nf=f.iloc[:-1]; y=ret.shift(-1).iloc[:-1]\nics=[]; ns=[]; turnovers=[]\nprev=None\nfor dt in f.index:\n    x=f.loc[dt]; z=y.loc[dt]; ok=x.notna()&z.notna()\n    if ok.sum()>=8:\n        ic=spearmanr(x[ok],z[ok]).statistic\n        if np.isfinite(ic):\n            ics.append(ic); ns.append(int(ok.sum()))\n            ranks=x[ok].rank(pct=True)\n            if prev is not None:\n                common=ranks.index.intersection(prev.index)\n                turnovers.append(np.mean(np.abs(ranks[common]-prev[common])))\n            prev=ranks\nics=np.array(ics)\nprint('symbols',len(frames),'dates',len(ics),'avgN',np.mean(ns),'coverage',np.mean(ns)/len(frames))\nprint('daily IC %.6f ICIR %.6f hit %.4f turnover %.4f' %(ics.mean(),ics.mean()/(ics.std(ddof=1)+1e-12),np.mean(ics>0),np.mean(turnovers)))\nfor a,b in [('2020-01-01','2022-12-31'),('2023-01-01','2025-12-31'),('2026-01-01','2028-08-09')]:\n q=ics[[d>=pd.Timestamp(a) and d<=pd.Timestamp(b) for d in f.index[:len(ics)] ]]\n print(a,b,'n',len(q),'IC %.6f ICIR %.6f hit %.3f'%(q.mean(),q.mean()/(q.std(ddof=1)+1e-12),np.mean(q>0)))\nfor h in [5,10,20]:\n yy=np.log(close).diff(h).shift(-h)\n ii=[]\n for dt in f.index:\n  x=f.loc[dt]; z=yy.loc[dt]; ok=x.notna()&z.notna()\n  if ok.sum()>=8: ii.append(spearmanr(x[ok],z[ok]).statistic)\n print('h',h,'n',len(ii),'IC %.6f ICIR %.6f'%(np.nanmean(ii),np.nanmean(ii)/(np.nanstd(ii,ddof=1)+1e-12)))\n# artifact\nout=f.copy(); out.index.name='date'; out.to_csv('scripts/miner_2_20280810_drawdown_recovery_signal.csv')\n", 'file_path': 'scripts/miner_2_20280810_drawdown_recovery.py'})
