 import numpy as np
from alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights

ASSETS = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
# Screener ensemble, capped at seven active factors.
FACTORS = {"clv1": .255, "leadlag5": .205, "rev5": .160, "mom20": .155,
           "rev3": .085, "down20": .080, "clvtrend15": .060}
MIN_W, MAX_W = .02, .15
_day = 0

def cs_rank(values):
    out = {s: .5 for s in ASSETS}
    good = sorted((s, float(v)) for s, v in values.items() if np.isfinite(v))
    if len(good) > 1:
        for i, (s, _) in enumerate(good): out[s] = (i + 1.0) / len(good)
    return out

def weights(scores):
    # A 2% floor and 15% cap gives diversified, fully invested long-only exposure.
    w = {s: MIN_W for s in ASSETS}
    free = 1.0 - MIN_W * len(ASSETS)
    active = set(ASSETS)
    while active and free > 1e-12:
        q = {s: max(float(scores.get(s, .5)), .01) for s in active}
        total = sum(q.values())
        capped = [s for s in active if free*q[s]/total > MAX_W-MIN_W]
        if not capped:
            for s in active: w[s] += free*q[s]/total
            break
        for s in capped:
            w[s] = MAX_W; free -= MAX_W-MIN_W; active.remove(s)
    z = sum(w.values())
    return {s: w[s]/z for s in ASSETS}

@register_hook
def cross_asset_strategy():
    global _day
    _day += 1
    if (_day - 1) % 10 != 0: return
    data = {}
    for s in ASSETS:
        df = get_stock_daily_data(symbol=s, days=100)
        if df is None or len(df) < 35: continue
        df = df.sort_values("date")
        c = np.asarray(df["close"], float); h = np.asarray(df["high"], float); l = np.asarray(df["low"], float)
        if len(c) < 32 or not np.all(np.isfinite(c[-32:])) or c[-1] <= 0: continue
        r = c[1:]/np.maximum(c[:-1], 1e-12)-1
        vol = max(float(np.std(r[-20:])), .008)
        dvol = max(float(np.std(np.minimum(r[-20:], 0))), .004)
        data[s] = dict(clv=(2*c[-1]-h[-1]-l[-1])/max(h[-1]-l[-1],1e-12),
          r5=c[-1]/c[-6]-1, rev5=-float(np.mean(r[-5:])), rev3=-float(np.mean(r[-3:])),
          mom20=(c[-1]/c[-21]-1)/(vol+.01), down20=(c[-1]/c[-21]-1)/(dvol+.01),
          clvtrend15=float(np.mean((2*c[-15:]-h[-15:]-l[-15:])/np.maximum(h[-15:]-l[-15:],1e-12))),
          trend=c[-1]/c[-31]-1, invvol=1/vol)
    if len(data) < 10: return
    med5 = float(np.median([v['r5'] for v in data.values()]))
    raw = {f:{} for f in FACTORS}
    for s,v in data.items():
        raw['clv1'][s]=v['clv']; raw['leadlag5'][s]=v['r5']-med5
        raw['rev5'][s]=v['rev5']; raw['mom20'][s]=v['mom20']; raw['rev3'][s]=v['rev3']
        raw['down20'][s]=v['down20']; raw['clvtrend15'][s]=v['clvtrend15']
    ranks = {f:cs_rank(x) for f,x in raw.items()}
    score = {s:sum(FACTORS[f]*ranks[f][s] for f in FACTORS) for s in ASSETS}
    equities=[data[s] for s in ('000300.SH','SPX','HSI','N225','SX5E','NDX') if s in data]
    bear = len(equities)>=3 and sum(v['trend']<0 for v in equities)/len(equities)>=.5
    bear = bear or (data.get('SPX',{}).get('trend',0)<0 and data.get('SPX',{}).get('r5',0)<0)
    if bear:
        for s in ('XAU','US10Y','CN10Y'): score[s] += .10
        for s in ('BTC','ETH','WTI'): score[s] = max(.02, score[s]-.05)
    med_iv=float(np.median([v['invvol'] for v in data.values()]))
    for s in ASSETS:
        score[s]=max(.02,score[s])*(.94+.06*data.get(s,{}).get('invvol',med_iv)/max(med_iv,1e-12))
    target=weights(score)
    if abs(sum(target.values())-1)<1e-8 and all(np.isfinite(x) and x>=0 for x in target.values()): rebalance_to_weights(target)


