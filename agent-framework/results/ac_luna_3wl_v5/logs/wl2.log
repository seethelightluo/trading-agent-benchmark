import numpy as np
from alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights

ASSETS = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
# Current Screener ensemble: persistence and downside-aware trend, capped lead-lag.
FACTORS = {"cg20": .24, "cg30": .17, "persist30": .13, "eff20": .12,
           "down20": .12, "ram20": .10, "mktres30": .08, "peer5": .04}
REBALANCE_DAYS = 10
POSITION_SCALING = .28
MIN_W, MAX_W = .04, .14
_day = 0


def rank_cs(values):
    good = sorted((s, v) for s, v in values.items() if np.isfinite(v))
    out = {s: .5 for s in ASSETS}
    if not good:
        return out
    n = len(good)
    for i, (s, _) in enumerate(good):
        out[s] = (i + 1.0) / n
    return out


def bounded_weights(score, invvol):
    raw = {s: max(.25, .5 + POSITION_SCALING * (score[s] - .5)) *
           np.clip(invvol.get(s, 1.0), .70, 1.30) for s in ASSETS}
    w = {s: MIN_W + (1 - len(ASSETS) * MIN_W) * raw[s] / sum(raw.values()) for s in ASSETS}
    for _ in range(30):
        over = [s for s in ASSETS if w[s] > MAX_W + 1e-12]
        if not over:
            break
        excess = sum(w[s] - MAX_W for s in over)
        for s in over:
            w[s] = MAX_W
        free = [s for s in ASSETS if s not in over]
        den = sum(raw[s] for s in free)
        if not free or den <= 0:
            break
        for s in free:
            w[s] += excess * raw[s] / den
    z = sum(w.values())
    return {s: max(0.0, w[s] / z) for s in ASSETS}


@register_hook
def cross_asset_strategy():
    global _day
    _day += 1
    if (_day - 1) % REBALANCE_DAYS != 0:
        return
    data = {}
    for s in ASSETS:
        df = get_stock_daily_data(symbol=s, days=120)
        if df is None or len(df) < 75:
            continue
        df = df.sort_values("date")
        # Only completed bars are used; the final returned row can be current-day.
        c = np.asarray(df["close"], dtype=float)[:-1]
        if len(c) < 65 or np.any(~np.isfinite(c[-65:])) or np.any(c[-65:] <= 0):
            continue
        r = c[1:] / c[:-1] - 1.0
        v20 = max(float(np.std(r[-20:])), .006)
        dn20 = max(float(np.std(np.minimum(r[-20:], 0.0))), .003)
        t5 = c[-1] / c[-6] - 1.0
        t20 = c[-1] / c[-21] - 1.0
        t30 = c[-1] / c[-31] - 1.0
        p20, p30 = np.mean(r[-20:] > 0), np.mean(r[-30:] > 0)
        gate20 = .5 + .5 * max(0.0, 2.0 * p20 - 1.0)
        gate30 = .5 + .5 * max(0.0, 2.0 * p30 - 1.0)
        path30 = np.sum(np.abs(r[-30:])) + 1e-6
        data[s] = {"cg20": t20 / (v20 + .01) * gate20,
                   "cg30": t30 / (v20 + .01) * gate30,
                   "persist30": t30 / path30,
                   "eff20": t20 / (dn20 + .015),
                   "down20": t20 / (dn20 + .01),
                   "ram20": t20 / (v20 + .01),
                   "peer5": t5, "t30": t30, "v": v20}
    if len(data) < 10:
        return
    med30 = float(np.median([x["t30"] for x in data.values()]))
    for x in data.values():
        # Market-residual proxy: cross-sectional residual, with no future data.
        x["mktres30"] = x["t30"] - med30
    ranks = {k: rank_cs({s: x[k] for s, x in data.items()}) for k in FACTORS}
    score = {s: sum(FACTORS[k] * ranks[k][s] for k in FACTORS) for s in ASSETS}
    breadth = float(np.mean([x["t30"] > 0 for x in data.values()]))
    medvol = float(np.median([x["v"] for x in data.values()]))
    # Bear/high-volatility posture: remain fully invested but use tradable defensives.
    if breadth < .50 or medvol > .018:
        for s in ("XAU", "US10Y", "CN10Y"):
            score[s] += .16
        for s in ("BTC", "ETH", "WTI"):
            score[s] -= .10
    invvol = {s: np.clip(medvol / max(x["v"], .006), .70, 1.30) for s, x in data.items()}
    # Complete 15-asset vector; missing assets retain neutral score and unit risk proxy.
    rebalance_to_weights(bounded_weights(score, invvol))


def strategy():
    return cross_asset_strategy()
