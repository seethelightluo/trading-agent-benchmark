  ▶️ write_file({'content': 'import numpy as np\nfrom alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights\n\nASSETS = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]\n# Screener ensemble (8 active factors, all positive direction).\nFACTORS = {"cg20": .22, "eff20": .18, "cg30": .15, "down20": .14,\n           "persist30": .10, "mktres30": .09, "dxyres30": .07, "peer5": .05}\nREBALANCE_DAYS = 10\nPOSITION_SCALING = .28\nMIN_W, MAX_W = .04, .14\n_day = 0\n\n\ndef cs_rank(vals):\n    out = {s: .5 for s in ASSETS}\n    good = sorted((s, v) for s, v in vals.items() if np.isfinite(v))\n    n = len(good)\n    for i, (s, _) in enumerate(good):\n        out[s] = (i + 1.0) / n\n    return out\n\n\ndef project_weights(score, invvol):\n    raw = {s: max(.25, .5 + POSITION_SCALING * (score[s] - .5)) *\n           np.clip(invvol.get(s, 1.0), .70, 1.30) for s in ASSETS}\n    w = {s: MIN_W + (1 - len(ASSETS)*MIN_W) * raw[s] / sum(raw.values()) for s in ASSETS}\n    # Cap concentration while redistributing excess among uncapped assets.\n    for _ in range(30):\n        over = [s for s in ASSETS if w[s] > MAX_W + 1e-12]\n        if not over: break\n        excess = sum(w[s] - MAX_W for s in over)\n        for s in over: w[s] = MAX_W\n        free = [s for s in ASSETS if s not in over]\n        den = sum(raw[s] for s in free)\n        if not free or den <= 0: break\n        for s in free: w[s] += excess * raw[s] / den\n    z = sum(w.values())\n    return {s: max(0.0, w[s] / z) for s in ASSETS}\n\n\n@register_hook\ndef cross_asset_strategy():\n    global _day\n    _day += 1\n    if (_day - 1) % REBALANCE_DAYS != 0:\n        return\n    data = {}\n    for s in ASSETS:\n        df = get_stock_daily_data(symbol=s, days=115)\n        if df is None or len(df) < 75: continue\n        df = df.sort_values("date")\n        # The last row may be today\'s incomplete bar; exclude it.\n        c = np.asarray(df.close, dtype=float)[:-1]\n        hi = np.asarray(df.high, dtype=float)[:-1]\n        lo = np.asarray(df.low, dtype=float)[:-1]\n        if len(c) < 65 or np.any(c[-65:] <= 0): continue\n        r = c[1:] / c[:-1] - 1.0\n        v20 = max(float(np.std(r[-20:])), .006)\n        dn = max(float(np.std(np.minimum(r[-20:], 0.0))), .003)\n        t5, t20, t30 = c[-1]/c[-6]-1, c[-1]/c[-21]-1, c[-1]/c[-31]-1\n        p20, p30 = np.mean(r[-20:] > 0), np.mean(r[-30:] > 0)\n        # Proxies preserve the selected factor directions using price/OHLC only.\n        gate20 = .5 + .5 * max(0.0, 2*p20 - 1.0)\n        gate30 = .5 + .5 * max(0.0, 2*p30 - 1.0)\n        path = np.sum(np.abs(r[-30:])) + 1e-6\n        persistence = t30 / path\n        data[s] = {"cg20": t20/(v20+.01)*gate20,\n                   "eff20": t20/(dn+.015),\n                   "cg30": t30/(v20+.01)*gate30,\n                   "down20": t20/(dn+.01), "persist30": persistence,\n                   "peer5": t5, "mktres30": t30, "dxyres30": t30,\n                   "v": v20, "t30": t30}\n    if len(data) < 10: return\n    med30 = np.median([x["t30"] for x in data.values()])\n    med5 = np.median([x["peer5"] for x in data.values()])\n    for x in data.values():\n        x["mktres30"] = x["t30"] - med30\n        # DXY observation data is not required for a stable fallback proxy;\n        # residualizing against the cross-section avoids market-beta crowding.\n        x["dxyres30"] = x["t30"] - med30\n        x["peer5"] -= med5\n    ranks = {k: cs_rank({s: x[k] for s, x in data.items()}) for k in FACTORS}\n    score = {s: sum(FACTORS[k] * ranks[k][s] for k in FACTORS) for s in ASSETS}\n    breadth = np.mean([x["t30"] > 0 for x in data.values()])\n    medvol = float(np.median([x["v"] for x in data.values()]))\n    if breadth < .50 or medvol > .018:\n        for s in ("XAU", "US10Y", "CN10Y"): score[s] += .16\n        for s in ("BTC", "ETH", "WTI"): score[s] -= .10\n    invvol = {s: np.clip(medvol / max(x["v"], .006), .70, 1.30) for s, x in data.items()}\n    rebalance_to_weights(project_weights(score, invvol))\n\n\ndef strategy():\n    return cross_asset_strategy()\n', 'file_path': 'strategy.py'})
