:])) or c[-1] <= 0:\n            continue\n        ret = c[1:] / np.maximum(c[:-1], 1e-12) - 1.0\n        vol = max(float(np.std(ret[-20:])), 0.008)\n        dvol = max(float(np.std(np.minimum(ret[-20:], 0.0))), 0.004)\n        data[symbol] = {\n            "clv": (2*c[-1] - h[-1] - l[-1]) / max(h[-1] - l[-1], 1e-12),\n            "ret5": c[-1] / max(c[-6], 1e-12) - 1.0,\n            "reversal": -float(np.mean(ret[-5:])),\n            "momentum": (c[-1] / max(c[-21], 1e-12) - 1.0) / (vol + 0.01),\n            "downside": (c[-1] / max(c[-21], 1e-12) - 1.0) / (dvol + 0.01),\n            "invvol": 1.0 / vol,\n        }\n    if len(data) < 10:\n        return\n\n    peer_median = float(np.median([x["ret5"] for x in data.values()]))\n    raw = {\n        "clv": {s: x["clv"] for s, x in data.items()},\n        "leadlag": {s: x["ret5"] - peer_median for s, x in data.items()},\n        "reversal": {s: x["reversal"] for s, x in data.items()},\n        "momentum": {s: x["momentum"] for s, x in data.items()},\n        "downside": {s: x["downside"] for s, x in data.items()},\n    }\n    ranked = {f: rank(v) for f, v in raw.items()}\n    score = {s: sum(FACTORS[f] * ranked[f][s] for f in FACTORS) for s in ASSETS}\n\n    # Medium-high-risk overlay: use tradable defensive series, never cash.\n    spx = data.get("SPX", {})\n    if spx.get("ret5", 0.0) < 0 and spx.get("momentum", 0.0) < 0:\n        for s in ("XAU", "US10Y", "CN10Y"):\n            score[s] += 0.12\n        for s in ("BTC", "ETH", "WTI"):\n            score[s] = max(0.02, score[s] - 0.06)\n\n    median_invvol = float(np.median([x["invvol"] for x in data.values()]))\n    for s in ASSETS:\n        invvol = data.get(s, {}).get("invvol", median_invvol)\n        score[s] = max(score[s], 0.02) * (0.90 + 0.10 * invvol / max(median_invvol, 1e-12))\n    target = bounded_allocate(score)\n    if len(target) == 15 and all(np.isfinite(v) and v >= 0 for v in target.values()):\n        rebalance_to_weights(target)\n', 'file_path': 'strategy.py'})Traceback (most recent call last):
