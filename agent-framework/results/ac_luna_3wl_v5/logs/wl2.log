 import numpy as np
from alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights

ASSETS = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
# Current screener ensemble; all signals use completed daily bars only.
FACTORS = {"quiet": .27, "accel": .25, "risk20": .22, "down60": .20, "cons30": .06}
REBALANCE_DAYS = 10
MIN_W, MAX_W = .04, .14
_day = 0

def rank_cs(vals):
    good = sorted((s, v) for s, v in vals.items() if np.isfinite(v))
    out = {s: .5 for s in ASSETS}
    n = len(good)
    for i, (s, _) in enumerate(good):
        out[s] = (i + 1.0) / n
    return out

def bounded_weights(score, invvol):
    raw = {s: max(.10, score[s]) * np.clip(invvol.get(s, 1.0), .65, 1.35) for s in ASSETS}
    w = {s: MIN_W + (1 - len(ASSETS)*MIN_W) * raw[s] / sum(raw.values()) for s in ASSETS}
    for _ in range(25):
        high = [s for s in ASSETS if w[s] > MAX_W + 1e-10]
        if not high: break
        excess = sum(w[s] - MAX_W for s in high)
        for s in high: w[s] = MAX_W
        rest = [s for s in ASSETS if s not in high]
        z = sum(raw[s] for s in rest)
        if not rest or z <= 0: break
        for s in rest: w[s] += excess * raw[s] / z
    z = sum(w.values())
    return {s: w[s] / z for s in ASSETS}

@register_hook
def cross_asset_strategy():
    global _day
    _day += 1
    if (_day - 1) % REBALANCE_DAYS != 0:
        return
    feat = {}
    for s in ASSETS:
        df = get_stock_daily_data(symbol=s, days=210)
        if df is None or len(df) < 85:
            continue
        d = df.sort_values("date").iloc[:-1]
        c = np.asarray(d["close"], float); hi = np.asarray(d["high"], float); lo = np.asarray(d["low"], float)
        if len(c) < 65 or np.any(c[-65:] <= 0): continue
        r = c[1:] / c[:-1] - 1.0
        r20, r30, r60 = r[-20:], r[-30:], r[-60:]
        v20 = max(float(np.std(r20)), .006); v60 = max(float(np.std(r60)), .006)
        t20 = c[-1] / c[-21] - 1.0; t30 = c[-1] / c[-31] - 1.0; t60 = c[-1] / c[-61] - 1.0
        cons30 = float(np.mean(r30 > 0)); cons20 = float(np.mean(r20 > 0))
        # Quiet trend and acceleration are risk-scaled; downside trend penalizes losses.
        quiet = (t30 / (v20 + .01)) * (.5 + .5*cons30)
        accel = ((t20 - t30) / (v20 + .01)) * (.5 + .5*cons20)
        downside = np.std(r60[r60 < 0]) if np.any(r60 < 0) else v60
        down60 = t60 / max(float(downside), .006)
        feat[s] = {"quiet": quiet, "accel": accel, "risk20": t20/max(v20, .006),
                   "down60": down60, "cons30": cons30, "t30": t30, "vol": v20}
    if len(feat) < 10: return
    ranks = {k: rank_cs({s: x[k] for s, x in feat.items()}) for k in FACTORS}
    score = {s: sum(FACTORS[k] * ranks[k][s] for k in FACTORS) for s in ASSETS}
    breadth = float(np.mean([x["t30"] > 0 for x in feat.values()]))
    medvol = float(np.median([x["vol"] for x in feat.values()]))
    # Screener identifies high risk and uncertain breadth: defensive tradables, never cash.
    if breadth < .60 or medvol > .018:
        for s in ("XAU", "US10Y", "CN10Y"): score[s] += .42
        for s in ("BTC", "ETH", "WTI"): score[s] -= .28
    invvol = {s: medvol / x["vol"] for s, x in feat.items()}
    target = bounded_weights(score, invvol)
    if set(target) == set(ASSETS) and all(np.isfinite(v) and v >= 0 for v in target.values()):
        rebalance_to_weights(target)

def strategy():
    return cross_asset_strategy()


