  ▶️ write_file({'content': "import pandas as pd,numpy as np\nfrom scipy.stats import spearmanr\nU=['000300.SH','SPX','HSI','N225','SX5E','000688.SH','SOX','NDX','XAU','COPPER','WTI','BTC','ETH','US10Y','CN10Y']\nD={s:pd.read_csv('../persistent/stock_data/'+s+'.csv',parse_dates=['date']).set_index('date').sort_index() for s in U}\nend=min(max(x.index.max() for x in D.values()),pd.Timestamp('2028-05-03'))\ndates=D['SPX'].index[(D['SPX'].index>='2020-01-01')&(D['SPX'].index<=end)]\nC=pd.DataFrame({s:D[s].close.reindex(dates) for s in U}); r=C.pct_change()\n# Trend-agreement signal: medium trend scaled by risk, with a directional confirmation from longer trend.\nm20=C/C.shift(20)-1; m60=C/C.shift(60)-1; v20=r.rolling(20,min_periods=15).std()\nraw=(m20/v20.replace(0,np.nan))*np.where(np.sign(m20)==np.sign(m60),1.0,0.35)\nF=raw.shift(1).clip(-20,20)\nfor h in [1,3,5,10]:\n y=C.shift(-h).div(C)-1; a=[]; ds=[]; ns=[]\n for dt in dates:\n  z=pd.concat([F.loc[dt].rename('f'),y.loc[dt].rename('y')],axis=1).dropna()\n  if len(z)>=8:\n   q=spearmanr(z.f,z.y).statistic\n   if np.isfinite(q): a.append(q);ds.append(dt);ns.append(len(z))\n a=np.array(a); print('H',h,'dates',len(a),'avgN',round(np.mean(ns),2),'IC',round(a.mean(),6),'ICIR',round(a.mean()/a.std(ddof=1),6),'hit',round((a>0).mean(),4))\n for lo,hi in [(2020,2022),(2023,2025),(2026,2027),(2028,2028)]:\n  z=a[[lo<=d.year<=hi for d in ds]]; print('regime',lo,hi,'n',len(z),'IC',round(z.mean(),6) if len(z) else None,'ICIR',round(z.mean()/z.std(ddof=1),6) if len(z)>1 else None)\nprint('coverage',round(F.notna().sum().sum()/F.size,4),'turnover',round(F.rank(axis=1,pct=True).diff().abs().mean(axis=1).mean(),4),'end',end.date())\n", 'file_path': 'scripts/miner_3_20280504_trend_agreement.py'})
