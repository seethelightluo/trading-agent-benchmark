 import numpy as np
from alphacrafter.sim.utils import (
    register_hook, get_stock_daily_data, rebalance_to_weights
)

ASSETS = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX",
          "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
# Screener ensemble, represented by causal price-based proxies.
FACTORS = {"mom20": .22, "mom30": .18, "persist30": .14, "mktres": .12,
           "cons20": .10, "rev5": .11, "volrev1": .05, "shock1": .08}
REBALANCE_DAYS = 10
POSITION_SCALING = .045
MIN_W, MAX_W = .04, .14
_day = 0


def cs_rank(values):
    out = {s: .5 for s in ASSETS}
    valid = sorted((s, v) for s, v in values.items() if np.isfinite(v))
    n = len(valid)
    for i, (s, _) in enumerate(valid):
        out[s] = (i + 1.) / n
    return out


def weights(score, invvol):
    raw = {s: max(.05, .5 + POSITION_SCALING * (score[s] - .5)) *
              np.clip(invvol.get(s, 1.), .70, 1.30) for s in ASSETS}
    # A small floor preserves diversification across the deliberately small universe.
    w = {s: MIN_W + (1. - len(ASSETS) * MIN_W) * raw[s] / sum(raw.values())
         for s in ASSETS}
    for _ in range(20):
        high = [s for s in ASSETS if w[s] > MAX_W + 1e-10]
        if not high:
            break
        excess = sum(w[s] - MAX_W for s in high)
        for s in high:
            w[s] = MAX_W
        rest = [s for s in ASSETS if s not in high]
        z = sum(raw[s] for s in rest)
        if not rest or z <= 0:
            break
        for s in rest:
            w[s] += excess * raw[s] / z
    z = sum(w.values())
    return {s: max(0., w[s] / z) for s in ASSETS}


@register_hook
def cross_asset_strategy():
    global _day
    _day += 1
    if (_day - 1) % REBALANCE_DAYS != 0:
        return

    feat = {}
    for s in ASSETS:
        df = get_stock_daily_data(symbol=s, days=180)
        if df is None or len(df) < 75:
            continue
        d = df.sort_values("date").iloc[:-1]  # never use the in-progress bar
        c = np.asarray(d["close"], dtype=float)
        if len(c) < 65 or np.any(~np.isfinite(c[-65:])) or np.any(c[-65:] <= 0):
            continue
        r = c[1:] / c[:-1] - 1.
        r20, r30 = r[-20:], r[-30:]
        vol = max(float(np.std(r20)), .006)
        t20, t30 = c[-1] / c[-21] - 1., c[-1] / c[-31] - 1.
        denom = vol + .01
        feat[s] = {
            "mom20": t20 / denom, "mom30": t30 / denom,
            "persist30": t30 / denom * (.5 + .5 * float(np.mean(r30 > 0))),
            "cons20": float(np.mean(r20 > 0)),
            "rev5": -float(np.sum(r[-5:])) / denom,
            "volrev1": -float(r[-1]) / (vol + .005),
            "shock1": -float(r[-1]) / denom,
            "t30": t30, "vol": vol,
        }
    if len(feat) < 10:
        return

    median_trend = float(np.median([x["t30"] for x in feat.values()]))
    for x in feat.values():
        x["mktres"] = x["t30"] - median_trend
    ranks = {k: cs_rank({s: x[k] for s, x in feat.items()}) for k in FACTORS}
    score = {s: sum(w * ranks[k][s] for k, w in FACTORS.items()) for s in ASSETS}

    breadth = float(np.mean([x["t30"] > 0 for x in feat.values()]))
    medvol = float(np.median([x["vol"] for x in feat.values()]))
    high_risk = breadth < .50 or medvol > .018
    if high_risk:
        # Full investment is retained; risk is expressed through tradable defensives.
        for s in ("XAU", "US10Y", "CN10Y"):
            score[s] += .55
        for s in ("BTC", "ETH", "WTI"):
            score[s] -= .40

    invvol = {s: medvol / x["vol"] for s, x in feat.items()}
    target = weights(score, invvol)
    if set(target) == set(ASSETS) and all(np.isfinite(v) and v >= 0 for v in target.values()):
        rebalance_to_weights(target)


def strategy():
    return cross_asset_strategy()


