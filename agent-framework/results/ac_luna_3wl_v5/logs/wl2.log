 import numpy as np
from alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights

ASSETS = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
# Current Screener ensemble; all signals are lagged one completed bar.
FACTORS = {
    "invvol": .22, "downbreadth": .16, "recovery": .12,
    "highvol": .10, "quiet": .12, "downtrend": .08,
    "efftrend": .06, "directional": .10, "dasym": .04,
}
REBALANCE_DAYS = 10
MIN_W, MAX_W = .03, .15
_day = 0


def rank(values):
    good = [(s, float(v)) for s, v in values.items() if np.isfinite(v)]
    out = {s: .5 for s in ASSETS}
    good.sort(key=lambda z: z[1])
    for i, (s, _) in enumerate(good):
        out[s] = (i + 1.0) / len(good)
    return out


def capped_simplex(raw):
    raw = {s: max(float(raw.get(s, .01)), 1e-8) for s in ASSETS}
    w = {s: MIN_W + (1 - len(ASSETS) * MIN_W) * raw[s] / sum(raw.values()) for s in ASSETS}
    for _ in range(30):
        over = [s for s in ASSETS if w[s] > MAX_W]
        if not over:
            break
        excess = sum(w[s] - MAX_W for s in over)
        for s in over:
            w[s] = MAX_W
        rest = [s for s in ASSETS if s not in over]
        den = sum(raw[s] for s in rest)
        for s in rest:
            w[s] += excess * raw[s] / den
    total = sum(w.values())
    return {s: w[s] / total for s in ASSETS}


@register_hook
def cross_asset_strategy():
    global _day
    _day += 1
    if (_day - 1) % REBALANCE_DAYS != 0:
        return

    f = {}
    for s in ASSETS:
        df = get_stock_daily_data(symbol=s, days=230)
        if df is None or len(df) < 95:
            continue
        c = np.asarray(df.sort_values("date").iloc[:-1]["close"], dtype=float)
        if len(c) < 65 or np.any(~np.isfinite(c[-65:])) or np.any(c[-65:] <= 0):
            continue
        r = c[1:] / c[:-1] - 1.0
        v20 = max(float(np.std(r[-20:])), .006)
        v60 = max(float(np.std(r[-60:])), .006)
        neg = r[-60:][r[-60:] < 0]
        dvol = max(float(np.std(neg)) if len(neg) > 1 else v60, .006)
        t5, t10 = c[-1]/c[-6]-1, c[-1]/c[-11]-1
        t20, t30, t60 = c[-1]/c[-21]-1, c[-1]/c[-31]-1, c[-1]/c[-61]-1
        path20 = np.sum(np.abs(r[-20:])) + .02
        eff = abs(t10) / path20
        # Proxies retain the specified factor directions and are deliberately slow.
        f[s] = {
            "invvol": 1/(.7*v20 + .3*v60),
            "downbreadth": -np.mean(r[-60:] < 0),
            "recovery": t5 - .35*min(t30, 0),
            "highvol": min(v20/(v60+.006), 2),
            "quiet": t30/(v20+.01) * (.5+.5*np.mean(r[-30:] > 0)),
            "downtrend": -t60/(v60+.01),
            "efftrend": t10/(v20+.01) * eff,
            "directional": np.sign(t10) * eff/(v20+.01),
            "dasym": (np.std(r[-30:][r[-30:] < 0]) if np.sum(r[-30:] < 0)>1 else v20) / v20,
            "vol": v20, "t30": t30, "t20": t20, "dvol": dvol,
        }
    if len(f) < 10:
        return
    ranks = {k: rank({s: x[k] for s, x in f.items()}) for k in FACTORS}
    score = {s: sum(FACTORS[k] * ranks[k][s] for k in FACTORS) for s in ASSETS}
    medvol = float(np.median([x["vol"] for x in f.values()]))
    breadth = float(np.mean([x["t30"] > 0 for x in f.values()]))
    # Bear/high-risk overlay: full investment, with defensive tradables as the hedge.
    stressed = medvol > .018 or breadth < .45
    if stressed or breadth < .60:
        for s in ("XAU", "US10Y", "CN10Y"):
            score[s] += .35
        for s in ("BTC", "ETH", "WTI"):
            score[s] *= .55
    raw = {s: max(score[s], .02) * np.clip(medvol / f[s]["vol"], .65, 1.35) if s in f else .02 for s in ASSETS}
    target = capped_simplex(raw)
    if all(np.isfinite(target[s]) and target[s] >= 0 for s in ASSETS) and abs(sum(target.values())-1) < 1e-8:
        rebalance_to_weights(target)


def strategy():
    return cross_asset_strategy()


