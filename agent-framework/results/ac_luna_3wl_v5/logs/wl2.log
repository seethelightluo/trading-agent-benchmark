eg = ret[-30:][ret[-30:] < 0]\n        t5 = close[-1] / close[-6] - 1\n        t10 = close[-1] / close[-11] - 1\n        t20 = close[-1] / close[-21] - 1\n        t30 = close[-1] / close[-31] - 1\n        t60 = close[-1] / close[-61] - 1\n        consistency = float(np.mean(ret[-20:] > 0))\n        data[s] = {\n            "breadth_mom": t20 / vol * (.35 + .65 * consistency),\n            "consistency_mom": t20 / vol * consistency,\n            "recovery": t5 - .30 * min(t30, 0),\n            "switch": (t10 / (vol + .01)) if t30 >= 0 else (-t5 / (vol + .01)),\n            "recovery_accel": (t10 - t30) / (vol + .01),\n            "persistence": t30 / (vol + .01) * (.4 + .6 * consistency),\n            "downvol": -(float(np.std(neg)) if len(neg) > 1 else vol),\n            "downbreadth": -(0.6 * np.mean(ret[-20:] < 0) + 0.4 * np.mean(ret[-60:] < 0)),\n            "smooth_trend": t30 / (vol + .01) * (.5 + .5 * consistency),\n            "vol": vol, "t30": t30\n        }\n    if len(data) < 10:\n        return\n    ranks = {f: cross_rank({s: x[f] for s, x in data.items()}) for f in FACTORS}\n    score = {s: sum(FACTORS[f] * ranks[f][s] for f in FACTORS) for s in ASSETS}\n    median_vol = float(np.median([x["vol"] for x in data.values()]))\n    breadth = float(np.mean([x["t30"] > 0 for x in data.values()]))\n    # Bear/high-risk posture: remain fully invested but use defensive tradables.\n    if median_vol > .018 or breadth < .60:\n        for s in ("XAU", "US10Y", "CN10Y"):\n            score[s] += .24\n        for s in ("BTC", "ETH", "WTI"):\n            score[s] *= .60\n    raw = {s: (max(score[s], .03) * np.clip(median_vol / data[s]["vol"], .70, 1.25)\n               if s in data else .03) for s in ASSETS}\n    target = bounded_weights(raw)\n    if all(np.isfinite(target[s]) and target[s] >= 0 for s in ASSETS) and abs(sum(target.values()) - 1) < 1e-8:\n        rebalance_to_weights(target)\n\n\ndef strategy():\n    return cross_asset_strategy()\n', 'file_path': 'strategy.py'})
