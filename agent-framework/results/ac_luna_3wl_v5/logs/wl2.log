 = np.asarray(df["close"], dtype=float)[:-1]\n        hi = np.asarray(df["high"], dtype=float)[:-1]\n        lo = np.asarray(df["low"], dtype=float)[:-1]\n        if len(c) < 65 or np.any(c[-65:] <= 0):\n            continue\n        r = c[1:] / c[:-1] - 1.\n        v20 = max(float(np.std(r[-20:])), .006)\n        dn20 = max(float(np.std(np.minimum(r[-20:], 0))), .003)\n        t5 = c[-1] / c[-6] - 1.\n        t20 = c[-1] / c[-21] - 1.\n        t30 = c[-1] / c[-31] - 1.\n        p20, p30 = np.mean(r[-20:] > 0), np.mean(r[-30:] > 0)\n        # Smoothed one-day reversal and close-location value.\n        rev = float(np.mean(-r[-3:]) / (v20 + .01))\n        clv = float(np.mean((2*c[-3:] - hi[-3:] - lo[-3:]) /\n                            np.maximum(hi[-3:] - lo[-3:], c[-3:] * .001)))\n        f[s] = {"peer": t5, "eff": t20 / (dn20 + .015),\n                "mom20": t20 / (v20 + .01) * (.5 + p20),\n                "down": t20 / (dn20 + .01), "rev": rev,\n                "mom30": t30 / (v20 + .01) * (.5 + p30),\n                "clv": clv, "v": v20, "t30": t30}\n    if len(f) < 10:\n        return\n    # Peer-median lead-lag: favor assets leading their cross-asset peers over 5 days.\n    med5 = float(np.median([v["peer"] for v in f.values()]))\n    # Market-residual momentum removes the equity-benchmark component.\n    eq = [s for s in ("000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX") if s in f]\n    med30 = float(np.median([f[s]["t30"] for s in eq])) if eq else 0.\n    for v in f.values():\n        v["peer"] -= med5\n        v["resid"] = v["t30"] - med30\n    ranks = {k: rank_cs({s: v.get(k, np.nan) for s, v in f.items()}) for k in FACTORS}\n    score = {s: sum(FACTORS[k] * ranks[k][s] for k in FACTORS) for s in ASSETS}\n    breadth = np.mean([f[s]["t30"] > 0 for s in eq]) if eq else .5\n    market_vol = float(np.median([v["v"] for v in f.values()]))\n    # Bear/high-risk expression uses defensive tradable instruments, never cash.\n    if breadth < .50 or market_vol > .018:\n        for s in ("XAU", "US10Y", "CN10Y"):\n            score[s] += .12\n        for s in ("BTC", "ETH", "WTI"):\n            score[s] -= .06\n    invvol = {s: np.clip(market_vol / max(v["v"], .006), .72, 1.28) for s, v in f.items()}\n    rebalance_to_weights(make_weights(score, invvol))\n\n\ndef strategy():\n    return cross_asset_strategy()\n', 'file_path': 'strategy.py'})
