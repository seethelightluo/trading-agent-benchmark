            "ret5": c[-1] / max(c[-6], 1e-12) - 1.0,
            "reversal": -float(np.mean(ret[-5:])),
            "momentum": (c[-1] / max(c[-21], 1e-12) - 1.0) / (vol + 0.01),
            "downside": (c[-1] / max(c[-21], 1e-12) - 1.0) / (dvol + 0.01),
            "invvol": 1.0 / vol,
        }
    if len(data) < 10:
        return

    peer_median = float(np.median([x["ret5"] for x in data.values()]))
    raw = {
        "clv": {s: x["clv"] for s, x in data.items()},
        "leadlag": {s: x["ret5"] - peer_median for s, x in data.items()},
        "reversal": {s: x["reversal"] for s, x in data.items()},
        "momentum": {s: x["momentum"] for s, x in data.items()},
        "downside": {s: x["downside"] for s, x in data.items()},
    }
    ranked = {f: rank(v) for f, v in raw.items()}
    score = {s: sum(FACTORS[f] * ranked[f][s] for f in FACTORS) for s in ASSETS}

    # Medium-high-risk overlay: use tradable defensive series, never cash.
    spx = data.get("SPX", {})
    if spx.get("ret5", 0.0) < 0 and spx.get("momentum", 0.0) < 0:
        for s in ("XAU", "US10Y", "CN10Y"):
            score[s] += 0.12
        for s in ("BTC", "ETH", "WTI"):
            score[s] = max(0.02, score[s] - 0.06)

    median_invvol = float(np.median([x["invvol"] for x in data.values()]))
    for s in ASSETS:
        invvol = data.get(s, {}).get("invvol", median_invvol)
        score[s] = max(score[s], 0.02) * (0.90 + 0.10 * invvol / max(median_invvol, 1e-12))
    target = bounded_allocate(score)
    if len(target) == 15 and all(np.isfinite(v) and v >= 0 for v in target.values()):
        rebalance_to_weights(target)


