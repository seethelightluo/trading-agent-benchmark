 import numpy as np
from alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights

ASSETS = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
FACTORS = {"clv": 0.280, "leadlag": 0.240, "reversal": 0.160, "momentum": 0.220, "downside": 0.100}
MIN_WEIGHT, MAX_WEIGHT = 0.015, 0.16
_day = 0


def rank_cs(values):
    out = {s: 0.5 for s in ASSETS}
    valid = sorted((s, float(v)) for s, v in values.items() if np.isfinite(v))
    n = len(valid)
    if n > 1:
        for i, (s, _) in enumerate(valid):
            out[s] = (i + 1.0) / n
    return out


def cap_weights(score):
    weights = {s: MIN_WEIGHT for s in ASSETS}
    active = set(ASSETS)
    remaining = 1.0 - MIN_WEIGHT * len(ASSETS)
    while active and remaining > 1e-12:
        denom = sum(max(score[s], 1e-8) for s in active)
        over = [s for s in active if remaining * max(score[s], 1e-8) / denom > MAX_WEIGHT - MIN_WEIGHT]
        if not over:
            for s in active:
                weights[s] += remaining * max(score[s], 1e-8) / denom
            break
        for s in over:
            weights[s] = MAX_WEIGHT
            remaining -= MAX_WEIGHT - MIN_WEIGHT
            active.remove(s)
    total = sum(weights.values())
    return {s: weights[s] / total for s in ASSETS}


@register_hook
def cross_asset_strategy():
    global _day
    _day += 1
    if (_day - 1) % 10 != 0:
        return

    obs = {}
    for symbol in ASSETS:
        df = get_stock_daily_data(symbol=symbol, days=90)
        if df is None or len(df) < 35:
            continue
        df = df.sort_values("date").reset_index(drop=True)
        close = df["close"].to_numpy(dtype=float)
        high = df["high"].to_numpy(dtype=float)
        low = df["low"].to_numpy(dtype=float)
        if not np.all(np.isfinite(close[-31:])) or close[-1] <= 0:
            continue
        ret = close[1:] / np.maximum(close[:-1], 1e-12) - 1.0
        vol = max(float(np.std(ret[-20:])), 0.008)
        downside_vol = max(float(np.std(np.minimum(ret[-20:], 0.0))), 0.004)
        obs[symbol] = {
            "clv": (2.0 * close[-1] - high[-1] - low[-1]) / max(high[-1] - low[-1], 1e-12),
            "ret5": close[-1] / max(close[-6], 1e-12) - 1.0,
            "reversal": -float(np.mean(ret[-5:])),
            "momentum": (close[-1] / max(close[-21], 1e-12) - 1.0) / (vol + 0.01),
            "downside": (close[-1] / max(close[-21], 1e-12) - 1.0) / (downside_vol + 0.01),
            "invvol": 1.0 / vol,
            "trend30": close[-1] / max(close[-31], 1e-12) - 1.0,
        }
    if len(obs) < 10:
        return

    peer_median = float(np.median([x["ret5"] for x in obs.values()]))
    raw = {
        "clv": {s: x["clv"] for s, x in obs.items()},
        "leadlag": {s: x["ret5"] - peer_median for s, x in obs.items()},
        "reversal": {s: x["reversal"] for s, x in obs.items()},
        "momentum": {s: x["momentum"] for s, x in obs.items()},
        "downside": {s: x["downside"] for s, x in obs.items()},
    }
    ranks = {factor: rank_cs(values) for factor, values in raw.items()}
    score = {s: sum(FACTORS[f] * ranks[f][s] for f in FACTORS) for s in ASSETS}

    # Bearish/range-bound overlay: rotate toward defensive tradable benchmarks.
    equities = [obs[s] for s in ("000300.SH", "SPX", "HSI", "N225", "SX5E", "NDX") if s in obs]
    breadth = sum(x["trend30"] < 0 for x in equities) / max(len(equities), 1)
    spx = obs.get("SPX", {})
    if breadth >= 0.5 or (spx.get("trend30", 0.0) < 0 and spx.get("ret5", 0.0) < 0):
        for s in ("XAU", "US10Y", "CN10Y"):
            score[s] += 0.12
        for s in ("BTC", "ETH", "WTI"):
            score[s] = max(0.02, score[s] - 0.06)

    # Modest inverse-volatility risk moderation; remain fully invested.
    median_invvol = float(np.median([x["invvol"] for x in obs.values()]))
    for s in ASSETS:
        iv = obs.get(s, {}).get("invvol", median_invvol)
        score[s] = max(score[s], 0.02) * (0.90 + 0.10 * iv / max(median_invvol, 1e-12))
    target = cap_weights(score)
    if all(np.isfinite(target[s]) and target[s] >= 0 for s in ASSETS) and abs(sum(target.values()) - 1.0) < 1e-8:
        rebalance_to_weights(target)


