 import numpy as np
from alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights

ASSETS = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
# Current Screener ensemble; nine active factors, weights sum to 1.
FACTORS = {"quiet": .16, "relative": .14, "downtrend": .13,
           "compression": .13, "stress": .12, "breadth": .10,
           "residual": .10, "agreement_residual": .07, "asymmetry": .05}
CADENCE = 10
_day = 0

def cs_rank(values):
    good = [(s, float(v)) for s, v in values.items() if np.isfinite(v)]
    out = {s: .5 for s in ASSETS}
    if not good:
        return out
    good.sort(key=lambda z: z[1])
    for i, (s, _) in enumerate(good):
        out[s] = (i + 1.0) / len(good)
    return out

def bounded_weights(score):
    # Complete, long-only, full-investment vector. Fractional units are handled downstream.
    floor, cap = .02, .22
    x = {s: max(float(score.get(s, .5)), .01) for s in ASSETS}
    w = {s: floor + (1 - floor * len(ASSETS)) * x[s] / sum(x.values()) for s in ASSETS}
    for _ in range(30):
        high = [s for s in ASSETS if w[s] > cap]
        if not high:
            break
        excess = sum(w[s] - cap for s in high)
        for s in high:
            w[s] = cap
        rest = [s for s in ASSETS if s not in high]
        den = sum(x[s] for s in rest)
        for s in rest:
            w[s] += excess * x[s] / max(den, 1e-12)
    total = sum(w.values())
    return {s: w[s] / total for s in ASSETS}

@register_hook
def cross_asset_strategy():
    global _day
    _day += 1
    if (_day - 1) % CADENCE:
        return
    data = {}
    for s in ASSETS:
        df = get_stock_daily_data(symbol=s, days=270)
        if df is None or len(df) < 100:
            continue
        c = np.asarray(df.sort_values("date").iloc[:-1]["close"], dtype=float)
        c = c[np.isfinite(c) & (c > 0)]
        if len(c) < 80:
            continue
        r = c[1:] / c[:-1] - 1
        data[s] = {
            "t10": c[-1] / c[-11] - 1, "t20": c[-1] / c[-21] - 1,
            "t30": c[-1] / c[-31] - 1, "t60": c[-1] / c[-61] - 1,
            "v10": max(float(np.std(r[-10:])), .003),
            "v20": max(float(np.std(r[-20:])), .003),
            "v60": max(float(np.std(r[-60:])), .003),
            "downv": max(float(np.std(r[-30:][r[-30:] < 0])) if np.sum(r[-30:] < 0) > 2 else float(np.std(r[-20:])), .003)
        }
    if len(data) < 10:
        return
    market5 = float(np.mean([d["t10"] for d in data.values()]))
    raw = {}
    for s, d in data.items():
        agree = np.mean([d["t10"] > 0, d["t20"] > 0, d["t60"] > 0])
        raw[s] = {
            "quiet": d["t20"] / (d["v60"] + .01) * abs(d["t20"]),
            "relative": d["t20"] / (d["v20"] + .01),
            "downtrend": d["t60"] / (d["downv"] + .01),
            "compression": -d["v10"] / (d["v60"] + .003),
            "stress": (d["t10"] if d["t30"] >= 0 else -d["t10"]) / (d["v20"] + .01),
            "breadth": d["t30"] / (d["v60"] + .01),
            "residual": -(d["t10"] - market5) / (d["v20"] + .01),
            "agreement_residual": -(d["t10"] - market5) / (d["v20"] + .01) * (.5 + .5 * agree),
            "asymmetry": -d["downv"] / (d["v20"] + .01)
        }
    ranks = {f: cs_rank({s: raw[s][f] for s in raw}) for f in FACTORS}
    score = {s: sum(FACTORS[f] * ranks[f][s] for f in FACTORS) for s in ASSETS}
    breadth = np.mean([d["t30"] > 0 for d in data.values()])
    spx30 = data.get("SPX", {}).get("t30", 0)
    # High-risk sideways/bear regime: rotate risk into tradable defensive assets.
    bear = breadth < .45 or spx30 < -.05
    intensity = min(1., max(0., (.45 - breadth) * 1.8) + max(0., (-spx30 - .02) / .18)) if bear else 0.
    for s in ("XAU", "US10Y", "CN10Y"):
        score[s] *= 1 + .9 * intensity
    for s in ("BTC", "ETH", "WTI", "SOX", "NDX", "COPPER"):
        score[s] *= max(.18, 1 - .70 * intensity)
    medv = np.median([d["v20"] for d in data.values()])
    for s in ASSETS:
        score[s] = max(.01, score[s]) * np.clip(medv / max(data.get(s, {}).get("v20", medv), .003), .70, 1.25)
    target = bounded_weights(score)
    if abs(sum(target.values()) - 1) < 1e-8 and all(np.isfinite(v) and v >= 0 for v in target.values()):
        rebalance_to_weights(target)

def strategy():
    return cross_asset_strategy()


