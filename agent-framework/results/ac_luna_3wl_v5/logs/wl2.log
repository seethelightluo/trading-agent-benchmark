 import numpy as np
from alphacrafter.sim.utils import register_hook, get_stock_daily_data, get_index_daily_data, rebalance_to_weights

ASSETS = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
# 2027-11-18 screener ensemble: persistence reduced; shock rebound added.
FACTORS = {"cg20": .18, "cg30": .10, "persist30": .08, "trend20": .10,
           "eff20": .12, "down20": .10, "mktres30": .07, "dxyres30": .07,
           "shock3": .18}
REBALANCE_DAYS = 10
POSITION_SCALING = .18
MIN_W, MAX_W = .04, .13
_day = 0


def cs_rank(vals):
    out = {s: .5 for s in ASSETS}
    good = sorted((s, float(v)) for s, v in vals.items() if np.isfinite(v))
    n = len(good)
    if n:
        for i, (s, _) in enumerate(good):
            out[s] = (i + 1.) / n
    return out


def make_weights(score, invvol):
    raw = {s: max(.35, .5 + POSITION_SCALING * (score[s] - .5)) *
              np.clip(invvol.get(s, 1.), .75, 1.25) for s in ASSETS}
    base = 1. - len(ASSETS) * MIN_W
    w = {s: MIN_W + base * raw[s] / sum(raw.values()) for s in ASSETS}
    for _ in range(30):
        high = [s for s in ASSETS if w[s] > MAX_W + 1e-12]
        if not high:
            break
        excess = sum(w[s] - MAX_W for s in high)
        for s in high:
            w[s] = MAX_W
        free = [s for s in ASSETS if s not in high]
        den = sum(raw[s] for s in free)
        if not free or den <= 0:
            break
        for s in free:
            w[s] += excess * raw[s] / den
    z = sum(w.values())
    return {s: w[s] / z for s in ASSETS}


@register_hook
def cross_asset_strategy():
    global _day
    _day += 1
    if (_day - 1) % REBALANCE_DAYS:
        return
    features, returns = {}, {}
    for s in ASSETS:
        df = get_stock_daily_data(symbol=s, days=120)
        if df is None or len(df) < 70:
            continue
        c = np.asarray(df.sort_values("date")["close"], dtype=float)[:-1]
        if len(c) < 65 or np.any(~np.isfinite(c[-65:])) or np.any(c[-65:] <= 0):
            continue
        r = c[1:] / c[:-1] - 1.
        r20, r30 = r[-20:], r[-30:]
        v20 = max(float(np.std(r20)), .006)
        dn = max(float(np.std(np.minimum(r20, 0.))), .003)
        t5, t20, t30 = c[-1]/c[-6]-1., c[-1]/c[-21]-1., c[-1]/c[-31]-1.
        p20, p30 = np.mean(r20 > 0), np.mean(r30 > 0)
        g20 = .5 + .5 * max(0., 2.*p20 - 1.)
        g30 = .5 + .5 * max(0., 2.*p30 - 1.)
        path = np.sum(np.abs(r30)) + 1e-6
        features[s] = {"cg20": t20/(v20+.01)*g20, "cg30": t30/(v20+.01)*g30,
          "persist30": t30/path, "trend20": t20/(v20+.01)*g20,
          "eff20": t20/(dn+.015), "down20": t20/(dn+.01),
          # Positive score means a recent selloff with a potential rebound.
          "shock3": -float(np.sum(r[-3:]))/(v20+.01), "t30": t30, "v": v20}
        returns[s] = r[-30:]
    if len(features) < 10:
        return
    # DXY is observation-only and is used only as a macro residual signal.
    dxy = get_index_daily_data(symbol="DXY", days=120)
    dx = None
    if dxy is not None and len(dxy) > 35:
        dc = np.asarray(dxy.sort_values("date")["close"], dtype=float)[:-1]
        if len(dc) >= 31 and np.all(np.isfinite(dc[-31:])) and np.all(dc[-31:] > 0):
            dx = dc[1:] / dc[:-1] - 1.
    for s, x in features.items():
        x["mktres30"] = x["t30"] - float(np.median([y["t30"] for y in features.values()]))
        x["dxyres30"] = x["t30"]
        if dx is not None and len(returns[s]) >= 30 and len(dx) >= 30:
            ar, dr = returns[s][-30:], dx[-30:]
            var = float(np.var(dr))
            beta = float(np.cov(ar, dr, ddof=0)[0, 1] / var) if var > 1e-10 else 0.
            x["dxyres30"] = x["t30"] - beta * float(np.sum(dr))
    ranks = {k: cs_rank({s: x[k] for s, x in features.items()}) for k in FACTORS}
    score = {s: sum(FACTORS[k] * ranks[k][s] for k in FACTORS) for s in ASSETS}
    breadth = float(np.mean([x["t30"] > 0 for x in features.values()]))
    medvol = float(np.median([x["v"] for x in features.values()]))
    # Bear/high-risk posture: full investment is retained in defensive tradables.
    if breadth < .50 or medvol > .018:
        for s in ("XAU", "US10Y", "CN10Y"):
            score[s] += .20
        for s in ("BTC", "ETH", "WTI"):
            score[s] -= .16
    invvol = {s: np.clip(medvol / max(x["v"], .006), .75, 1.25) for s, x in features.items()}
    rebalance_to_weights(make_weights(score, invvol))


def strategy():
    return cross_asset_strategy()


