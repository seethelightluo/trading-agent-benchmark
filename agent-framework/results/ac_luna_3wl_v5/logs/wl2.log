 import numpy as np
from alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights

ASSETS = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
# Current screener ensemble (five active factors, sum = 1).
FACTORS = {"clv": 0.30, "leadlag": 0.25, "reversal": 0.17, "momentum": 0.19, "downside": 0.09}
MIN_WEIGHT, MAX_WEIGHT = 0.015, 0.16
_day = 0


def rank_cross_section(values):
    valid = sorted((s, float(v)) for s, v in values.items() if np.isfinite(v))
    result = {s: 0.5 for s in ASSETS}
    n = len(valid)
    if n > 1:
        for i, (symbol, _) in enumerate(valid):
            result[symbol] = (i + 1.0) / n
    return result


def bounded_full_investment(score):
    # Start with a small diversified floor, then distribute the remainder by score.
    weights = {s: MIN_WEIGHT for s in ASSETS}
    remaining = 1.0 - MIN_WEIGHT * len(ASSETS)
    active = set(ASSETS)
    while active and remaining > 1e-12:
        denom = sum(max(float(score.get(s, 0.0)), 1e-9) for s in active)
        capped = []
        for s in active:
            extra = remaining * max(float(score.get(s, 0.0)), 1e-9) / denom
            if extra > MAX_WEIGHT - MIN_WEIGHT:
                capped.append(s)
        if not capped:
            for s in active:
                weights[s] += remaining * max(float(score.get(s, 0.0)), 1e-9) / denom
            break
        for s in capped:
            weights[s] = MAX_WEIGHT
            remaining -= MAX_WEIGHT - MIN_WEIGHT
            active.remove(s)
    total = sum(weights.values())
    return {s: weights[s] / total for s in ASSETS}


@register_hook
def cross_asset_strategy():
    global _day
    _day += 1
    # The simulator calls the hook daily; proposals are made every ten days.
    if (_day - 1) % 10 != 0:
        return

    observations = {}
    for symbol in ASSETS:
        df = get_stock_daily_data(symbol=symbol, days=90)
        if df is None or len(df) < 30:
            continue
        df = df.sort_values("date").reset_index(drop=True)
        close = df["close"].to_numpy(dtype=float)
        high = df["high"].to_numpy(dtype=float)
        low = df["low"].to_numpy(dtype=float)
        if not np.all(np.isfinite(close[-25:])):
            continue
        daily = close[1:] / np.maximum(close[:-1], 1e-12) - 1.0
        vol20 = max(float(np.std(daily[-20:])), 0.008)
        downvol = max(float(np.std(np.minimum(daily[-20:], 0.0))), 0.004)
        observations[symbol] = {
            "clv": (2.0 * close[-1] - high[-1] - low[-1]) / max(high[-1] - low[-1], 1e-12),
            "ret5": close[-1] / max(close[-6], 1e-12) - 1.0,
            "reversal": -float(np.mean(daily[-5:])),
            "momentum": (close[-1] / max(close[-21], 1e-12) - 1.0) / (vol20 + 0.01),
            "downside": (close[-1] / max(close[-21], 1e-12) - 1.0) / (downvol + 0.01),
            "invvol": 1.0 / vol20,
        }

    # A complete target is required; missing observations receive neutral ranks.
    if len(observations) < 10:
        return
    median_ret5 = float(np.median([x["ret5"] for x in observations.values()]))
    raw_factors = {
        "clv": {s: x["clv"] for s, x in observations.items()},
        "leadlag": {s: x["ret5"] - median_ret5 for s, x in observations.items()},
        "reversal": {s: x["reversal"] for s, x in observations.items()},
        "momentum": {s: x["momentum"] for s, x in observations.items()},
        "downside": {s: x["downside"] for s, x in observations.items()},
    }
    ranks = {f: rank_cross_section(v) for f, v in raw_factors.items()}
    score = {s: sum(FACTORS[f] * ranks[f][s] for f in FACTORS) for s in ASSETS}

    # Bearish/high-volatility posture: remain fully invested but favor defensives.
    spx = observations.get("SPX")
    if spx is not None and spx["ret5"] < 0 and spx["momentum"] < 0:
        for symbol in ("XAU", "US10Y", "CN10Y"):
            score[symbol] += 0.12
        for symbol in ("BTC", "ETH", "WTI"):
            score[symbol] = max(0.02, score[symbol] - 0.06)

    median_invvol = float(np.median([x["invvol"] for x in observations.values()]))
    target_score = {}
    for symbol in ASSETS:
        iv = observations.get(symbol, {}).get("invvol", median_invvol)
        # Mild inverse-volatility modulation limits unstable concentration.
        target_score[symbol] = max(score[symbol], 0.02) * (0.90 + 0.10 * iv / max(median_invvol, 1e-12))
    rebalance_to_weights(bounded_full_investment(target_score))


