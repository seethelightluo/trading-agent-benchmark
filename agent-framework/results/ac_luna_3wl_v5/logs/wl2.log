[-21]-1., c[-1]/c[-31]-1.\n        cons30, cons20 = np.mean(r30 > 0), np.mean(r20 > 0)\n        rng = np.maximum(h[-20:] - lo[-20:], 1e-12)\n        quiet = (t30 / scale) * (.5 + .5 * cons30)\n        accel = ((t20 - t30) / scale) * (.5 + .5 * cons20)\n        # Range-adjusted persistence: trend relative to realized range.\n        persist = t30 / max(float(np.mean(rng / c[-20:])), .005) * (.5 + .5*cons30)\n        feat[s] = {"risktrend": t20/scale, "quiet": quiet, "accel": accel,\n                   "cons30": cons30, "persist30": persist, "rev5": -np.sum(r[-5:])/scale,\n                   "t30": t30, "vol": vol}\n    if len(feat) < 10: return\n    med = np.median([x["t30"] for x in feat.values()])\n    for x in feat.values(): x["mktres"] = x["t30"] - med\n    ranks = {k: cs_rank({s: x[k] for s,x in feat.items()}) for k in FACTORS}\n    score = {s: sum(FACTORS[k] * ranks[k][s] for k in FACTORS) for s in ASSETS}\n    breadth = np.mean([x["t30"] > 0 for x in feat.values()]); medvol = np.median([x["vol"] for x in feat.values()])\n    # High-risk, uneven recovery: retain full investment but rotate toward defensives.\n    if breadth < .60 or medvol > .018:\n        for s in ("XAU", "US10Y", "CN10Y"): score[s] += .55\n        for s in ("BTC", "ETH", "WTI"): score[s] -= .40\n    invvol = {s: medvol/x["vol"] for s,x in feat.items()}\n    target = make_weights(score, invvol)\n    if set(target) == set(ASSETS) and all(np.isfinite(v) and v >= 0 for v in target.values()): rebalance_to_weights(target)\n\ndef strategy(): return cross_asset_strategy()\n', 'file_path': 'strategy.py'})
