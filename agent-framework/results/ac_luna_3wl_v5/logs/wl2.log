 import numpy as np
from alphacrafter.sim.utils import register_hook, get_stock_daily_data, get_index_daily_data, rebalance_to_weights

ASSETS = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
# Screener ensemble: ranks are deliberately moderated in the high-risk regime.
FACTORS = {"downtrend20": .18, "lead5": .15, "mom30": .14, "rev5": .12,
           "clv": .10, "cons20": .10, "mom20": .09, "dxyres": .06,
           "mktres": .06}
REBALANCE_DAYS = 10
POSITION_SCALING = .065
MIN_W, MAX_W = .04, .14
_day = 0


def rank_cs(values):
    good = sorted((s, float(v)) for s, v in values.items() if np.isfinite(v))
    out = {s: .5 for s in ASSETS}
    n = len(good)
    if n:
        for i, (s, _) in enumerate(good):
            out[s] = (i + 1.) / n
    return out


def make_weights(score, invvol):
    # A complete, long-only target: minimum diversification plus mild score tilt.
    raw = {s: (.5 + POSITION_SCALING * (score.get(s, .5) - .5)) *
              np.clip(invvol.get(s, 1.), .72, 1.28) for s in ASSETS}
    base = len(ASSETS) * MIN_W
    w = {s: MIN_W + (1. - base) * raw[s] / sum(raw.values()) for s in ASSETS}
    for _ in range(20):
        over = [s for s in ASSETS if w[s] > MAX_W]
        if not over:
            break
        excess = sum(w[s] - MAX_W for s in over)
        for s in over:
            w[s] = MAX_W
        rest = [s for s in ASSETS if s not in over]
        den = sum(raw[s] for s in rest)
        if not rest or den <= 0:
            break
        for s in rest:
            w[s] += excess * raw[s] / den
    total = sum(w.values())
    return {s: max(0., w[s] / total) for s in ASSETS}


@register_hook
def cross_asset_strategy():
    global _day
    _day += 1
    if (_day - 1) % REBALANCE_DAYS:
        return
    data, rets = {}, {}
    for s in ASSETS:
        df = get_stock_daily_data(symbol=s, days=160)
        if df is None or len(df) < 75:
            continue
        d = df.sort_values("date").iloc[:-1]  # no current/incomplete bar
        c = np.asarray(d["close"], float)
        if len(c) < 65 or np.any(~np.isfinite(c[-65:])) or np.any(c[-65:] <= 0):
            continue
        r = c[1:] / c[:-1] - 1.
        r5, r20, r30 = r[-5:], r[-20:], r[-30:]
        vol = max(float(np.std(r20)), .006)
        t20, t30 = c[-1] / c[-21] - 1., c[-1] / c[-31] - 1.
        consistency20 = float(np.mean(r20 > 0))
        clv = 0.
        if all(k in d.columns for k in ("high", "low", "close")):
            hi, lo, cc = [np.asarray(d[k].iloc[-10:], float) for k in ("high", "low", "close")]
            clv = float(np.mean(np.where(hi > lo, (2 * cc - hi - lo) / (hi - lo), 0.)))
        data[s] = {"downtrend20": t20 / (vol + .01) * (.5 + .5 * consistency20),
                   "lead5": float(np.sum(r5)), "mom30": t30 / (vol + .01),
                   "rev5": -float(np.sum(r5)), "clv": clv,
                   "cons20": consistency20, "mom20": t20 / (vol + .01),
                   "mktres": t30, "dxyres": t30, "t30": t30, "vol": vol}
        rets[s] = r[-30:]
    if len(data) < 10:
        return
    med5 = np.median([x["lead5"] for x in data.values()])
    med30 = np.median([x["t30"] for x in data.values()])
    for x in data.values():
        x["lead5"] -= med5
        x["mktres"] -= med30

    dxy = get_index_daily_data(symbol="DXY", days=160)
    if dxy is not None and len(dxy) > 35:
        dc = np.asarray(dxy.sort_values("date")["close"], float)[:-1]
        if len(dc) >= 31 and np.all(np.isfinite(dc[-31:])) and np.all(dc[-31:] > 0):
            dr = dc[1:] / dc[:-1] - 1.
            for s, x in data.items():
                q, ar = dr[-30:], rets[s]
                var = np.var(q)
                beta = np.cov(ar, q, ddof=0)[0, 1] / var if var > 1e-10 else 0.
                x["dxyres"] = x["t30"] - beta * np.sum(q)

    ranks = {k: rank_cs({s: x[k] for s, x in data.items()}) for k in FACTORS}
    score = {s: sum(w * ranks[k][s] for k, w in FACTORS.items()) for s in ASSETS}
    breadth = np.mean([x["t30"] > 0 for x in data.values()])
    stress = breadth < .50 or np.median([x["vol"] for x in data.values()]) > .018
    if stress:
        # Defensive tradable assets replace cash in a bearish/high-volatility regime.
        for s in ("XAU", "US10Y", "CN10Y"):
            score[s] += .38
        for s in ("BTC", "ETH", "WTI"):
            score[s] -= .25
    medvol = np.median([x["vol"] for x in data.values()])
    invvol = {s: medvol / x["vol"] for s, x in data.items()}
    rebalance_to_weights(make_weights(score, invvol))


def strategy():
    return cross_asset_strategy()


