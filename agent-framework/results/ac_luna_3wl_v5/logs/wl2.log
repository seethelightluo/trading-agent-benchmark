 import pandas as pd, numpy as np
from scipy.stats import spearmanr
A=['000300.SH','SPX','HSI','N225','SX5E','000688.SH','SOX','NDX','XAU','COPPER','WTI','BTC','ETH','US10Y','CN10Y']; cut=pd.Timestamp('2026-12-30')
p=pd.DataFrame({a:pd.read_csv('../persistent/stock_data/'+a+'.csv',parse_dates=['date']).query('date<=@cut').set_index('date').close for a in A}).sort_index(); r=p.pct_change()
# Breakout persistence: distance from prior 60d high/low, scaled by recent ATR; lagged, interpretable.
F={1:[],3:[],5:[],10:[]}; D={h:[] for h in F}; N={h:[] for h in F}; sig=[]
for i in range(65,len(r)-10):
  atr=r.iloc[i-20:i].abs().mean(); hi=p.iloc[i-60:i].max(); lo=p.iloc[i-60:i].min()
  f=((p.iloc[i-1]-lo)/(hi-lo).replace(0,np.nan)-.5)/(atr.replace(0,np.nan))
  sig.append((r.index[i],f))
  for h in F:
    y=r.iloc[i+1:i+1+h].sum(); z=pd.concat([f,y],axis=1).dropna()
    if len(z)>=8: F[h].append(spearmanr(z.iloc[:,0],z.iloc[:,1]).statistic); D[h].append(r.index[i]); N[h].append(len(z))
for h in F:
 ic=pd.Series(F[h],index=D[h]); print('H',h,'dates',len(ic),'avgN',round(np.mean(N[h]),2),'IC',round(ic.mean(),6),'ICIR',round(ic.mean()/ic.std(ddof=1),6),'hit',round((ic>0).mean(),4))
 for lo,hi in [(2020,2021),(2022,2023),(2024,2025),(2026,2026)]:
  z=ic[(ic.index.year>=lo)&(ic.index.year<=hi)]; print('regime',lo,hi,len(z),round(z.mean(),6),round(z.mean()/z.std(ddof=1),6) if len(z)>1 else None)
q=pd.DataFrame({d:f for d,f in sig}).T.rank(axis=1,pct=True); print('turnover',round(q.diff().abs().mean().mean(),4),'coverage',round(q.notna().mean().mean(),4),'last',q.index[-1])
for h in [1,3,5,10]:
 ic=pd.Series(F[h],index=D[h]); z=ic.iloc[-252:]; print('recent',h,'252',round(z.mean(),6),round(z.mean()/z.std(ddof=1),6))


