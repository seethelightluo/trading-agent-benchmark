 import numpy as np
from alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights

ASSETS = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX",
          "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
# Current screener ensemble; all signals use completed daily bars only.
FACTORS = {
    "quiet": .25, "mom30": .16, "mom20": .12, "persist30": .12,
    "mktres": .10, "cons20": .08, "rev5": .07, "lead5": .05,
    "clvtrend": .03, "shock1": .02,
}
REBALANCE_DAYS = 10
POSITION_SCALING = .045
MIN_W, MAX_W = .04, .14
_day = 0


def rank_cs(vals):
    out = {s: .5 for s in ASSETS}
    good = sorted((s, float(v)) for s, v in vals.items() if np.isfinite(v))
    if good:
        for i, (s, _) in enumerate(good):
            out[s] = (i + 1.0) / len(good)
    return out


def bounded_weights(score, invvol):
    raw = {s: max(.12, .5 + POSITION_SCALING * (score[s] - .5)) *
              np.clip(invvol.get(s, 1.), .70, 1.30) for s in ASSETS}
    w = {s: MIN_W + (1 - len(ASSETS) * MIN_W) * raw[s] / sum(raw.values()) for s in ASSETS}
    # Iterative capped redistribution, retaining the full-investment contract.
    for _ in range(30):
        high = [s for s in ASSETS if w[s] > MAX_W + 1e-10]
        if not high:
            break
        excess = sum(w[s] - MAX_W for s in high)
        for s in high:
            w[s] = MAX_W
        rest = [s for s in ASSETS if s not in high]
        z = sum(raw[s] for s in rest)
        if not rest or z <= 0:
            break
        for s in rest:
            w[s] += excess * raw[s] / z
    z = sum(w.values())
    return {s: max(0.0, w[s] / z) for s in ASSETS}


@register_hook
def cross_asset_strategy():
    global _day
    _day += 1
    if (_day - 1) % REBALANCE_DAYS:
        return

    feat = {}
    for s in ASSETS:
        df = get_stock_daily_data(symbol=s, days=190)
        if df is None or len(df) < 80:
            continue
        d = df.sort_values("date").iloc[:-1]  # completed-bar lag
        c = np.asarray(d["close"], dtype=float)
        h = np.asarray(d["high"], dtype=float)
        lo = np.asarray(d["low"], dtype=float)
        if len(c) < 65 or np.any(~np.isfinite(c[-65:])) or np.any(c[-65:] <= 0):
            continue
        r = c[1:] / c[:-1] - 1.0
        r20, r30 = r[-20:], r[-30:]
        vol = max(float(np.std(r20)), .006)
        t20, t30 = c[-1] / c[-21] - 1., c[-1] / c[-31] - 1.
        # Quiet trend rewards return persistence while penalizing noisy paths.
        quiet = (t30 / (vol + .01)) * (.5 + .5 * np.mean(r30 > 0))
        persist = (t30 / (vol + .01)) * (.5 + .5 * np.mean(r30 > 0))
        # CLV trend proxy, safely using available OHLC.
        rng = np.maximum(h[-16:] - lo[-16:], 1e-12)
        clv = np.mean((2*c[-16:] - h[-16:] - lo[-16:]) / rng)
        oldrng = np.maximum(h[-31:-15] - lo[-31:-15], 1e-12)
        oldclv = np.mean((2*c[-31:-15] - h[-31:-15] - lo[-31:-15]) / oldrng)
        feat[s] = {"quiet": quiet, "mom30": t30/(vol+.01), "mom20": t20/(vol+.01),
                   "persist30": persist, "cons20": np.mean(r20 > 0),
                   "rev5": -np.sum(r[-5:])/(vol+.01), "shock1": -r[-1]/(vol+.01),
                   "clvtrend": clv-oldclv, "t30": t30, "vol": vol,
                   "r5": np.sum(r[-5:])}
    if len(feat) < 10:
        return
    medtrend = np.median([x["t30"] for x in feat.values()])
    medr5 = np.median([x["r5"] for x in feat.values()])
    for x in feat.values():
        x["mktres"] = x["t30"] - medtrend
        x["lead5"] = x["r5"] - medr5
    ranks = {k: rank_cs({s: x[k] for s, x in feat.items()}) for k in FACTORS}
    score = {s: sum(FACTORS[k] * ranks[k][s] for k in FACTORS) for s in ASSETS}

    breadth = np.mean([x["t30"] > 0 for x in feat.values()])
    medvol = np.median([x["vol"] for x in feat.values()])
    if breadth < .50 or medvol > .018:
        for s in ("XAU", "US10Y", "CN10Y"):
            score[s] += .55
        for s in ("BTC", "ETH", "WTI"):
            score[s] -= .40
    invvol = {s: medvol / x["vol"] for s, x in feat.items()}
    target = bounded_weights(score, invvol)
    if set(target) == set(ASSETS) and abs(sum(target.values()) - 1.) < 1e-8:
        rebalance_to_weights(target)


def strategy():
    return cross_asset_strategy()


