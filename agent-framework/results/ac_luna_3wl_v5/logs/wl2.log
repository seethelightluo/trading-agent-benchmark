import numpy as np
from alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights

ASSETS = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
# Screener ensemble, capped at six active factors.
FACTORS = {"clv": 0.25, "leadlag": 0.22, "mom20": 0.18, "rev5": 0.16, "down20": 0.12, "rev3": 0.07}
MIN_W, MAX_W = 0.02, 0.15
_day = 0

def cs_rank(values):
    out = {s: 0.5 for s in ASSETS}
    good = sorted((s, float(v)) for s, v in values.items() if np.isfinite(v))
    if len(good) > 1:
        for i, (s, _) in enumerate(good):
            out[s] = (i + 1.0) / len(good)
    return out

def bounded_weights(score):
    w = {s: MIN_W for s in ASSETS}
    active = set(ASSETS)
    residual = 1.0 - MIN_W * len(ASSETS)
    while active and residual > 1e-12:
        q = {s: max(float(score.get(s, 0.5)), 0.01) for s in active}
        total = sum(q.values())
        capped = [s for s in active if residual * q[s] / total > MAX_W - MIN_W]
        if not capped:
            for s in active:
                w[s] += residual * q[s] / total
            break
        for s in capped:
            w[s] = MAX_W
            residual -= MAX_W - MIN_W
            active.remove(s)
    z = sum(w.values())
    return {s: w[s] / z for s in ASSETS}

