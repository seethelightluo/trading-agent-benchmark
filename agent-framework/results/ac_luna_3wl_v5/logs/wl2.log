<= 0):\n            continue\n        r = c[1:] / c[:-1] - 1.0\n        v10 = max(float(np.std(r[-10:])), 0.004)\n        v20 = max(float(np.std(r[-20:])), 0.004)\n        v60 = max(float(np.std(r[-60:])), 0.004)\n        t5 = c[-1] / c[-6] - 1\n        t10 = c[-1] / c[-11] - 1\n        t20 = c[-1] / c[-21] - 1\n        t30 = c[-1] / c[-31] - 1\n        t60 = c[-1] / c[-61] - 1\n        neg = r[-30:][r[-30:] < 0]\n        down = float(np.std(neg)) if len(neg) > 1 else v20\n        efficiency = abs(t20) / (np.sum(np.abs(r[-20:])) + 1e-8)\n        data[s] = {\n            "quiet_trend": t20 / (v60 + .01) * efficiency,\n            "relative_risk_trend": t20 / (v20 + .01),\n            "compression": -(v10 / v60),  # lower recent volatility ranks better\n            "dispersion_reversal": -t5 / (v10 + .01),\n            "stress_risk_trend": (t10 if t30 >= 0 else -t10) / (v20 + .01),\n            "breadth_trend": t30 / (v60 + .01),\n            "down_asym": -down / (v20 + .01),\n            "recovery": (t10 - t60) / (v60 + .01),\n            "vol": v20, "t30": t30,\n        }\n    if len(data) < 10:\n        return\n    # Cross-sectional rank composite over the complete tradable universe.\n    rr = {f: ranks({s: d[f] for s, d in data.items()}) for f in FACTORS}\n    score = {s: sum(FACTORS[f] * rr[f][s] for f in FACTORS) for s in ASSETS}\n    medvol = float(np.median([d["vol"] for d in data.values()]))\n    breadth = float(np.mean([d["t30"] > 0 for d in data.values()]))\n    stressed = medvol > 0.018 or breadth < 0.50\n    if stressed:\n        for s in ("XAU", "US10Y", "CN10Y"):\n            score[s] += 0.16\n        for s in ("BTC", "ETH", "WTI"):\n            score[s] *= 0.65\n    raw = {}\n    for s in ASSETS:\n        vol = data[s]["vol"] if s in data else medvol\n        raw[s] = max(score[s], 0.02) * np.clip(medvol / max(vol, 0.004), 0.75, 1.20)\n    target = bounded(raw)\n    if all(np.isfinite(target[s]) and target[s] >= 0 for s in ASSETS) and abs(sum(target.values()) - 1.0) < 1e-8:\n        rebalance_to_weights(target)\n\n\ndef strategy():\n    return cross_asset_strategy()\n', 'file_path': 'strategy.py'})
