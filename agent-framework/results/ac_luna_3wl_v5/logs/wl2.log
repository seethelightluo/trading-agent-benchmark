 import numpy as np
from alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights

ASSETS = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
FACTORS = {"clv": 0.30, "leadlag": 0.27, "momentum": 0.25, "reversal": 0.18}
MIN_WEIGHT, MAX_WEIGHT = 0.015, 0.16
_day = 0


def cross_rank(values):
    valid = sorted((s, float(v)) for s, v in values.items() if np.isfinite(v))
    out = {s: 0.5 for s in ASSETS}
    if len(valid) > 1:
        for i, (s, _) in enumerate(valid):
            out[s] = (i + 1.0) / len(valid)
    return out


def bounded_weights(raw):
    """Allocate exactly one, with a small floor and concentration cap."""
    w = {s: MIN_WEIGHT for s in ASSETS}
    free = 1.0 - MIN_WEIGHT * len(ASSETS)
    active = set(ASSETS)
    positive = {s: max(float(raw.get(s, 0.0)), 1e-12) for s in ASSETS}
    while active and free > 1e-12:
        denom = sum(positive[s] for s in active)
        proposed = {s: free * positive[s] / denom for s in active}
        capped = [s for s in active if proposed[s] > MAX_WEIGHT - MIN_WEIGHT]
        if not capped:
            for s in active:
                w[s] += proposed[s]
            break
        for s in capped:
            w[s] = MAX_WEIGHT
            free -= MAX_WEIGHT - MIN_WEIGHT
            active.remove(s)
        if free < 0:
            break
    total = sum(w.values())
    return {s: w[s] / total for s in ASSETS}


@register_hook
def cross_asset_strategy():
    global _day
    _day += 1
    if (_day - 1) % 10 != 0:
        return

    data = {}
    for symbol in ASSETS:
        df = get_stock_daily_data(symbol=symbol, days=90)
        if df is None or len(df) < 30:
            continue
        df = df.sort_values("date").reset_index(drop=True)
        close = df["close"].to_numpy(dtype=float)
        high = df["high"].to_numpy(dtype=float)
        low = df["low"].to_numpy(dtype=float)
        ret = close[1:] / np.maximum(close[:-1], 1e-12) - 1.0
        vol = max(float(np.std(ret[-20:])), 0.008)
        data[symbol] = {
            "clv": (2.0 * close[-1] - high[-1] - low[-1]) / max(high[-1] - low[-1], 1e-12),
            "ret5": close[-1] / max(close[-6], 1e-12) - 1.0,
            "reversal": -float(np.mean(ret[-5:])),
            "momentum": (close[-1] / max(close[-21], 1e-12) - 1.0) / (vol + 0.01),
            "invvol": 1.0 / vol,
        }

    # Missing names remain in the portfolio at neutral rank; the benchmark has 15 tradable assets.
    if len(data) < 10:
        return
    median5 = float(np.median([v["ret5"] for v in data.values()]))
    factor_values = {
        "clv": {s: v["clv"] for s, v in data.items()},
        "leadlag": {s: v["ret5"] - median5 for s, v in data.items()},
        "momentum": {s: v["momentum"] for s, v in data.items()},
        "reversal": {s: v["reversal"] for s, v in data.items()},
    }
    ranks = {f: cross_rank(vals) for f, vals in factor_values.items()}
    score = {s: sum(FACTORS[f] * ranks[f][s] for f in FACTORS) for s in ASSETS}

    # Bearish regime: remain fully invested but rotate toward defensive tradable assets.
    spx = data.get("SPX")
    if spx is not None and spx["ret5"] < 0.0 and spx["momentum"] < 0.0:
        for s in ("XAU", "US10Y", "CN10Y"):
            score[s] += 0.12
        for s in ("BTC", "ETH", "WTI"):
            score[s] = max(0.02, score[s] - 0.06)

    invvol = [v["invvol"] for v in data.values()]
    median_invvol = float(np.median(invvol)) if invvol else 1.0
    raw = {s: max(score[s], 0.02) * (0.90 + 0.10 * data.get(s, {}).get("invvol", median_invvol) / median_invvol) for s in ASSETS}
    rebalance_to_weights(bounded_weights(raw))


