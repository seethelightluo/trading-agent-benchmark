 import numpy as np
from alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights

ASSETS = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
FACTORS = {
    "compression": 0.24,
    "stress_trend": 0.18,
    "breadth_trend": 0.15,
    "quiet_trend": 0.15,
    "relative_risk": 0.10,
    "dispersion_reversal": 0.13,
    "down_asym": 0.05,
}
MIN_W, MAX_W, CADENCE = 0.04, 0.14, 10
_day = 0


def cs_rank(vals):
    out = {s: 0.5 for s in ASSETS}
    good = sorted((s, float(v)) for s, v in vals.items() if np.isfinite(v))
    for i, (s, _) in enumerate(good):
        out[s] = (i + 1.0) / len(good)
    return out


def bounded(raw):
    raw = {s: max(float(raw.get(s, 0.01)), 1e-8) for s in ASSETS}
    w = {s: MIN_W + (1 - len(ASSETS) * MIN_W) * raw[s] / sum(raw.values()) for s in ASSETS}
    for _ in range(30):
        high = [s for s in ASSETS if w[s] > MAX_W + 1e-12]
        if not high:
            break
        excess = sum(w[s] - MAX_W for s in high)
        for s in high:
            w[s] = MAX_W
        rest = [s for s in ASSETS if s not in high]
        den = sum(raw[s] for s in rest)
        for s in rest:
            w[s] += excess * raw[s] / max(den, 1e-12)
    z = sum(w.values())
    return {s: w[s] / z for s in ASSETS}


@register_hook
def cross_asset_strategy():
    global _day
    _day += 1
    if (_day - 1) % CADENCE:
        return
    data = {}
    for s in ASSETS:
        df = get_stock_daily_data(symbol=s, days=230)
        if df is None or len(df) < 110:
            continue
        c = np.asarray(df.sort_values("date").iloc[:-1]["close"], dtype=float)
        if len(c) < 70 or np.any(~np.isfinite(c[-70:])) or np.any(c[-70:] <= 0):
            continue
        r = c[1:] / c[:-1] - 1.0
        v10 = max(float(np.std(r[-10:])), 0.004)
        v20 = max(float(np.std(r[-20:])), 0.004)
        v60 = max(float(np.std(r[-60:])), 0.004)
        t5 = c[-1] / c[-6] - 1.0
        t10 = c[-1] / c[-11] - 1.0
        t20 = c[-1] / c[-21] - 1.0
        t30 = c[-1] / c[-31] - 1.0
        neg = r[-30:][r[-30:] < 0]
        down = float(np.std(neg)) if len(neg) > 1 else v20
        eff = abs(t20) / (np.sum(np.abs(r[-20:])) + 1e-8)
        data[s] = {"compression": -(v10 / v60),
                   "stress_trend": (t10 if t30 >= 0 else -t10) / (v20 + .01),
                   "breadth_trend": t30 / (v60 + .01),
                   "quiet_trend": t20 / (v60 + .01) * eff,
                   "relative_risk": t20 / (v20 + .01),
                   "dispersion_reversal": -t5 / (v10 + .01),
                   "down_asym": -down / (v20 + .01),
                   "vol": v20, "t30": t30}
    if len(data) < 10:
        return
    ranks = {f: cs_rank({s: x[f] for s, x in data.items()}) for f in FACTORS}
    score = {s: sum(FACTORS[f] * ranks[f][s] for f in FACTORS) for s in ASSETS}
    medvol = float(np.median([x["vol"] for x in data.values()]))
    breadth = float(np.mean([x["t30"] > 0 for x in data.values()]))
    # High-risk regime: defensive tradable assets replace a cash sleeve.
    stressed = medvol > 0.018 or breadth < 0.50
    if stressed:
        for s in ("XAU", "US10Y", "CN10Y"):
            score[s] += 0.24
        for s in ("BTC", "ETH", "WTI", "SOX", "NDX"):
            score[s] *= 0.50
    raw = {}
    for s in ASSETS:
        vol = data[s]["vol"] if s in data else medvol
        raw[s] = max(score[s], 0.02) * np.clip(medvol / max(vol, .004), .65, 1.15)
    target = bounded(raw)
    if all(np.isfinite(target[s]) and target[s] >= 0 for s in ASSETS) and abs(sum(target.values()) - 1) < 1e-8:
        rebalance_to_weights(target)


def strategy():
    return cross_asset_strategy()


