np.asarray(df["low"], float)\n        if len(c) < 35 or not np.all(np.isfinite(c[-35:])): continue\n        r = c[1:] / np.maximum(c[:-1], 1e-12) - 1.\n        v20 = max(float(np.std(r[-20:])), .008)\n        down = max(float(np.std(np.minimum(r[-20:], 0.))), .004)\n        clv = (2*c - h - lo) / np.maximum(h-lo, 1e-12)\n        r5, r20, r30 = c[-1]/c[-6]-1., c[-1]/c[-21]-1., c[-1]/c[-31]-1.\n        pos20, pos30 = np.mean(r[-20:] > 0), np.mean(r[-30:] > 0)\n        d[s] = {"cons30": r30/(v20+.01)*(.5+pos30),\n                "cons20": r20/(v20+.01)*(.5+pos20),\n                "clv1": clv[-1], "lead5": r5, "persist30": r30/(v20+.01)*pos30,\n                "rev5": -np.mean(r[-5:]), "down20": r20/(down+.01),\n                "eff20": r20/(down+.015), "trend": r30, "vol": v20}\n    if len(d) < 10: return\n    lead_med = np.median([v["lead5"] for v in d.values()])\n    ranks = {}\n    for f in FACTORS:\n        vals = {s: (v[f] - lead_med if f == "lead5" else v[f]) for s, v in d.items()}\n        ranks[f] = rank(vals)\n    score = {s: sum(FACTORS[f] * ranks[f][s] for f in FACTORS) for s in ASSETS}\n    eq = [d[s] for s in ("000300.SH", "SPX", "HSI", "N225", "SX5E", "NDX") if s in d]\n    breadth = sum(v["trend"] > 0 for v in eq) / max(len(eq), 1)\n    high_risk = np.median([v["vol"] for v in d.values()]) > .018 or breadth < .67\n    bear = len(eq) >= 3 and (breadth <= .50 or (d.get("SPX", {}).get("trend", 0) < 0 and d.get("SPX", {}).get("lead5", 0) < 0))\n    if high_risk or bear:\n        bump = .10 if bear else .06\n        for s in ("XAU", "US10Y", "CN10Y"): score[s] += bump\n        for s in ("BTC", "ETH", "WTI"): score[s] = max(.02, score[s] - (.05 if bear else .025))\n    # Small inverse-volatility adjustment limits unstable concentration.\n    med = np.median([1./v["vol"] for v in d.values()])\n    for s in ASSETS:\n        inv = 1./d[s]["vol"] if s in d else med\n        score[s] *= .97 + .03 * inv / max(med, 1e-12)\n    target = make_weights(score)\n    if set(target) == set(ASSETS) and all(np.isfinite(v) and v >= 0 for v in target.values()):\n        rebalance_to_weights(target)\n', 'file_path': 'strategy.py'})
