q=pd.DataFrame({d:f for d,f in sig}).T.rank(axis=1,pct=True); print('turnover',round(q.diff().abs().mean().mean(),4),'coverage',round(r.loc[q.index].notna().mean().mean(),4),'last',q.index[-1])
