 import numpy as np
from alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights

ASSETS = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
FACTORS = {"clv": 0.309, "leadlag": 0.238, "reversal": 0.183, "momentum": 0.180, "downside": 0.090}
MIN_WEIGHT, MAX_WEIGHT = 0.015, 0.16
_day = 0


def rank_cs(values):
    out = {s: 0.5 for s in ASSETS}
    valid = sorted((s, float(v)) for s, v in values.items() if np.isfinite(v))
    n = len(valid)
    if n > 1:
        for i, (s, _) in enumerate(valid):
            out[s] = (i + 1.0) / n
    return out


def capped_weights(score):
    # Positive floor and cap provide diversification while always investing 100%.
    w = {s: MIN_WEIGHT for s in ASSETS}
    active = set(ASSETS)
    rem = 1.0 - MIN_WEIGHT * len(ASSETS)
    while active and rem > 1e-12:
        denom = sum(max(score[s], 1e-8) for s in active)
        hit = [s for s in active if rem * max(score[s], 1e-8) / denom > MAX_WEIGHT - MIN_WEIGHT]
        if not hit:
            for s in active:
                w[s] += rem * max(score[s], 1e-8) / denom
            break
        for s in hit:
            w[s] = MAX_WEIGHT
            rem -= MAX_WEIGHT - MIN_WEIGHT
            active.remove(s)
    z = sum(w.values())
    return {s: w[s] / z for s in ASSETS}


@register_hook
def cross_asset_strategy():
    global _day
    _day += 1
    if (_day - 1) % 10:
        return

    obs = {}
    for s in ASSETS:
        df = get_stock_daily_data(symbol=s, days=90)
        if df is None or len(df) < 30:
            continue
        df = df.sort_values("date").reset_index(drop=True)
        c = df.close.to_numpy(float)
        h = df.high.to_numpy(float)
        l = df.low.to_numpy(float)
        if c[-1] <= 0 or not np.all(np.isfinite(c[-25:])):
            continue
        r = c[1:] / np.maximum(c[:-1], 1e-12) - 1.0
        vol = max(float(np.std(r[-20:])), 0.008)
        dvol = max(float(np.std(np.minimum(r[-20:], 0.0))), 0.004)
        obs[s] = {
            "clv": (2*c[-1]-h[-1]-l[-1]) / max(h[-1]-l[-1], 1e-12),
            "ret5": c[-1]/max(c[-6], 1e-12)-1.0,
            "reversal": -float(np.mean(r[-5:])),
            "momentum": (c[-1]/max(c[-21], 1e-12)-1.0)/(vol+0.01),
            "downside": (c[-1]/max(c[-21], 1e-12)-1.0)/(dvol+0.01),
            "invvol": 1.0/vol,
        }
    if len(obs) < 10:
        return

    peer = float(np.median([v["ret5"] for v in obs.values()]))
    raw = {
        "clv": {s:v["clv"] for s,v in obs.items()},
        "leadlag": {s:v["ret5"]-peer for s,v in obs.items()},
        "reversal": {s:v["reversal"] for s,v in obs.items()},
        "momentum": {s:v["momentum"] for s,v in obs.items()},
        "downside": {s:v["downside"] for s,v in obs.items()},
    }
    ranks = {f: rank_cs(x) for f,x in raw.items()}
    score = {s:sum(FACTORS[f]*ranks[f][s] for f in FACTORS) for s in ASSETS}

    # Bear regime: rotate within tradable defensive benchmarks, never to cash.
    eq = [obs[s]["ret5"] for s in ("000300.SH","SPX","HSI","N225","SX5E","NDX") if s in obs]
    breadth = sum(x < 0 for x in eq) / max(len(eq), 1)
    if breadth >= 0.5 or (obs.get("SPX",{}).get("ret5",0) < 0 and obs.get("SPX",{}).get("momentum",0) < 0):
        for s in ("XAU","US10Y","CN10Y"):
            score[s] += 0.12
        for s in ("BTC","ETH","WTI"):
            score[s] = max(0.02, score[s]-0.06)

    med_iv = float(np.median([v["invvol"] for v in obs.values()]))
    for s in ASSETS:
        iv = obs.get(s, {}).get("invvol", med_iv)
        score[s] = max(score[s], 0.02) * (0.90 + 0.10*iv/max(med_iv, 1e-12))
    target = capped_weights(score)
    if len(target) == len(ASSETS) and all(np.isfinite(v) and v >= 0 for v in target.values()) and abs(sum(target.values())-1.0) < 1e-8:
        rebalance_to_weights(target)


