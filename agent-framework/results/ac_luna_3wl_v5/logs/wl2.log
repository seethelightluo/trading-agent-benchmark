  ▶️ write_file({'content': 'import numpy as np\nfrom alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights\n\nASSETS = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]\n# Current screener ensemble: ten factors, directions are all positive.\nFACTORS = {"clv1": .178, "leadlag5": .167, "mom20": .144,\n           "cons_mom30": .133, "rev5": .100, "down20": .089,\n           "clvtrend15": .067, "cons_mom20": .056, "eff20": .033,\n           "rev3": .033}\nMIN_W, MAX_W = .02, .15\n_day = 0\n\ndef rank_cs(vals):\n    out = {s: .5 for s in ASSETS}\n    good = sorted((s, v) for s, v in vals.items() if np.isfinite(v))\n    n = len(good)\n    if n > 1:\n        for i, (s, _) in enumerate(good):\n            out[s] = (i + 1.0) / n\n    return out\n\ndef bounded(score):\n    # Start at the required floor, then distribute the remaining capital.\n    w = {s: MIN_W for s in ASSETS}\n    free, active = 1.0 - MIN_W * len(ASSETS), set(ASSETS)\n    while active and free > 1e-12:\n        q = {s: max(float(score.get(s, .5)), .01) for s in active}\n        total = sum(q.values())\n        capped = [s for s in active if free * q[s] / total > MAX_W - MIN_W]\n        if not capped:\n            for s in active:\n                w[s] += free * q[s] / total\n            break\n        for s in capped:\n            w[s] = MAX_W\n            free -= MAX_W - MIN_W\n            active.remove(s)\n    z = sum(w.values())\n    return {s: w[s] / z for s in ASSETS}\n\n@register_hook\ndef cross_asset_strategy():\n    global _day\n    _day += 1\n    if (_day - 1) % 10 != 0:\n        return\n    data = {}\n    for s in ASSETS:\n        df = get_stock_daily_data(symbol=s, days=130)\n        if df is None or len(df) < 45:\n            continue\n        df = df.sort_values("date")\n        c = np.asarray(df["close"], dtype=float)\n        h = np.asarray(df["high"], dtype=float)\n        lo = np.asarray(df["low"], dtype=float)\n        if len(c) < 35 or not np.all(np.isfinite(c[-35:])) or c[-1] <= 0:\n            continue\n        r = c[1:] / np.maximum(c[:-1], 1e-12) - 1.0\n        vol20 = max(float(np.std(r[-20:])), .008)\n        downvol = max(float(np.std(np.minimum(r[-20:], 0.0))), .004)\n        clv = (2*c[-20:] - h[-20:] - lo[-20:]) / np.maximum(h[-20:] - lo[-20:], 1e-12)\n        r3 = c[-1] / c[-4] - 1.0\n        r5 = c[-1] / c[-6] - 1.0\n        r20 = c[-1] / c[-21] - 1.0\n        r30 = c[-1] / c[-31] - 1.0\n        consistency = float(np.mean(r[-20:] > 0))\n        consistency30 = float(np.mean(r[-30:] > 0))\n        data[s] = {\n            "clv1": float(clv[-1]), "r5": r5, "rev5": -float(np.mean(r[-5:])),\n            "rev3": -float(np.mean(r[-3:])), "mom20": r20/(vol20+.01),\n            "cons_mom20": r20/(vol20+.01) * (.5+consistency),\n            "cons_mom30": r30/(vol20+.01) * (.5+consistency30),\n            "down20": r20/(downvol+.01), "eff20": r20/(downvol+.015),\n            "clvtrend15": float(np.mean(clv[-15:])),\n            "trend": r30, "vol": vol20, "invvol": 1.0/vol20}\n    if len(data) < 10:\n        return\n    median_r5 = float(np.median([v["r5"] for v in data.values()]))\n    raw = {f: {} for f in FACTORS}\n    for s, v in data.items():\n        for f in FACTORS:\n            raw[f][s] = v["r5"] - median_r5 if f == "leadlag5" else v[f]\n    ranks = {f: rank_cs(raw[f]) for f in FACTORS}\n    score = {s: sum(FACTORS[f] * ranks[f][s] for f in FACTORS) for s in ASSETS}\n\n    # Sideways/high-risk regime: remain fully invested, but favor defensive\n    # tradable benchmarks and penalize the most volatile risk assets.\n    eq = [data[s] for s in ("000300.SH", "SPX", "HSI", "N225", "SX5E", "NDX") if s in data]\n    breadth = sum(v["trend"] > 0 for v in eq) / max(len(eq), 1)\n    medvol = float(np.median([v["vol"] for v in data.values()]))\n    unstable = medvol > .018 or breadth < .67\n    bear = len(eq) >= 3 and (breadth <= .50 or (data.get("SPX", {}).get("trend", 0) < 0 and data.get("SPX", {}).get("r5", 0) < 0))\n    if unstable or bear:\n        bump = .10 if bear else .05\n        for s in ("XAU", "US10Y", "CN10Y"):\n            score[s] += bump\n        for s in ("BTC", "ETH", "WTI"):\n            score[s] = max(.02, score[s] - (.05 if bear else .02))\n    medinv = float(np.median([v["invvol"] for v in data.values()]))\n    for s in ASSETS:\n        score[s] = max(.02, score[s]) * (.96 + .04 * data.get(s, {}).get("invvol", medinv) / max(medinv, 1e-12))\n    target = bounded(score)\n    if abs(sum(target.values()) - 1.0) < 1e-8 and all(np.isfinite(x) and x >= 0 for x in target.values()):\n        rebalance_to_weights(target)\n', 'file_path': 'strategy.py'})
