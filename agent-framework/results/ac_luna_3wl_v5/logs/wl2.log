  ▶️ write_file({'content': 'import numpy as np\nfrom alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights\n\nASSETS = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]\n# Screener ensemble: capped at seven active factors and normalized to one.\nFACTORS = {"clv1": .240, "leadlag5": .210, "rev5": .170, "mom20": .160,\n           "down20": .085, "rev3": .075, "clvtrend15": .060}\nMIN_W, MAX_W = .02, .15\n_day = 0\n\n\ndef rank_cs(vals):\n    out = {s: .5 for s in ASSETS}\n    good = sorted((s, float(v)) for s, v in vals.items() if np.isfinite(v))\n    n = len(good)\n    if n > 1:\n        for i, (s, _) in enumerate(good):\n            out[s] = (i + 1.0) / n\n    return out\n\n\ndef bounded_weights(score):\n    # Positive score transform, with a small universal allocation and 15% cap.\n    w = {s: MIN_W for s in ASSETS}\n    free, active = 1.0 - MIN_W * len(ASSETS), set(ASSETS)\n    while active:\n        q = {s: max(float(score.get(s, .5)), .01) for s in active}\n        total = sum(q.values())\n        hit = [s for s in active if free * q[s] / total > MAX_W - MIN_W]\n        if not hit:\n            for s in active:\n                w[s] += free * q[s] / total\n            break\n        for s in hit:\n            w[s] = MAX_W\n            free -= MAX_W - MIN_W\n            active.remove(s)\n        if free <= 1e-12:\n            break\n    z = sum(w.values())\n    return {s: w[s] / z for s in ASSETS}\n\n\n@register_hook\ndef cross_asset_strategy():\n    global _day\n    _day += 1\n    # Decisions are made only on the first day of each ten-trading-day block.\n    if (_day - 1) % 10:\n        return\n\n    data = {}\n    for symbol in ASSETS:\n        df = get_stock_daily_data(symbol=symbol, days=100)\n        if df is None or len(df) < 35:\n            continue\n        df = df.sort_values("date")\n        c = np.asarray(df["close"], dtype=float)\n        h = np.asarray(df["high"], dtype=float)\n        lo = np.asarray(df["low"], dtype=float)\n        if len(c) < 32 or not np.all(np.isfinite(c[-32:])) or c[-1] <= 0:\n            continue\n        ret = c[1:] / np.maximum(c[:-1], 1e-12) - 1.0\n        vol = max(float(np.std(ret[-20:])), .008)\n        downside = max(float(np.std(np.minimum(ret[-20:], 0.0))), .004)\n        rng = np.maximum(h[-15:] - lo[-15:], 1e-12)\n        clv_hist = (2.0 * c[-15:] - h[-15:] - lo[-15:]) / rng\n        clv = (2.0 * c[-1] - h[-1] - lo[-1]) / max(h[-1] - lo[-1], 1e-12)\n        data[symbol] = {\n            "clv1": clv, "r5": c[-1] / c[-6] - 1.0,\n            "rev5": -float(np.mean(ret[-5:])), "rev3": -float(np.mean(ret[-3:])),\n            "mom20": (c[-1] / c[-21] - 1.0) / (vol + .01),\n            "down20": (c[-1] / c[-21] - 1.0) / (downside + .01),\n            "clvtrend15": float(np.mean(clv_hist)), "trend": c[-1] / c[-31] - 1.0,\n            "invvol": 1.0 / vol,\n        }\n    if len(data) < 10:\n        return\n\n    # Robust cross-sectional proxies for the persisted factor definitions.\n    peer_median = float(np.median([v["r5"] for v in data.values()]))\n    raw = {f: {} for f in FACTORS}\n    for s, v in data.items():\n        raw["clv1"][s] = v["clv1"]\n        raw["leadlag5"][s] = v["r5"] - peer_median\n        raw["rev5"][s], raw["mom20"], raw["down20"] = v["rev5"], v["mom20"], v["down20"]\n        raw["rev3"][s], raw["clvtrend15"] = v["rev3"], v["clvtrend15"]\n    ranks = {f: rank_cs(raw[f]) for f in FACTORS}\n    score = {s: sum(FACTORS[f] * ranks[f][s] for f in FACTORS) for s in ASSETS}\n\n    # Medium-high risk regime: use tradable defensive assets, never cash.\n    eq = [data[s] for s in ("000300.SH", "SPX", "HSI", "N225", "SX5E", "NDX") if s in data]\n    spx = data.get("SPX", {})\n    bear = (len(eq) >= 3 and sum(x["trend"] < 0 for x in eq) / len(eq) >= .5) or (spx.get("trend", 0) < 0 and spx.get("r5", 0) < 0)\n    if bear:\n        for s in ("XAU", "US10Y", "CN10Y"):\n            score[s] = score.get(s, .5) + .10\n        for s in ("BTC", "ETH", "WTI"):\n            score[s] = max(.02, score.get(s, .5) - .05)\n\n    # Mild inverse-volatility tilt limits unstable-asset concentration.\n    median_invvol = float(np.median([v["invvol"] for v in data.values()]))\n    for s in ASSETS:\n        iv = data.get(s, {}).get("invvol", median_invvol)\n        score[s] = max(.02, score[s]) * (.94 + .06 * iv / max(median_invvol, 1e-12))\n    target = bounded_weights(score)\n    if abs(sum(target.values()) - 1.0) < 1e-8 and all(np.isfinite(v) and v >= 0 for v in target.values()):\n        rebalance_to_weights(target)\n', 'file_path': 'strategy.py'})
