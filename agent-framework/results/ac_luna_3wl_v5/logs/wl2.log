 import numpy as np
from alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights

ASSETS = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
# Current screener ensemble; capped at eight active factors.
FACTORS = {"invvol": .20, "downbreadth": .16, "recovery": .14, "highvol": .10,
           "quiet": .14, "downtrend": .10, "efftrend": .08, "switch": .08}
REBALANCE_DAYS = 10
MIN_W, MAX_W = .035, .14
_day = 0

def rank(values):
    valid = [(s, v) for s, v in values.items() if np.isfinite(v)]
    valid.sort(key=lambda z: z[1])
    out = {s: .5 for s in ASSETS}
    n = len(valid)
    for i, (s, _) in enumerate(valid):
        out[s] = (i + 1.) / n
    return out

def bounded(raw):
    raw = {s: max(float(raw.get(s, .01)), 1e-9) for s in ASSETS}
    w = {s: MIN_W + (1-len(ASSETS)*MIN_W)*raw[s]/sum(raw.values()) for s in ASSETS}
    for _ in range(30):
        over = [s for s in ASSETS if w[s] > MAX_W]
        if not over: break
        excess = sum(w[s]-MAX_W for s in over)
        for s in over: w[s] = MAX_W
        rest = [s for s in ASSETS if s not in over]
        den = sum(raw[s] for s in rest)
        for s in rest: w[s] += excess*raw[s]/den
    z = sum(w.values())
    return {s: w[s]/z for s in ASSETS}

@register_hook
def cross_asset_strategy():
    global _day
    _day += 1
    if (_day - 1) % REBALANCE_DAYS != 0:
        return
    f = {}
    for s in ASSETS:
        df = get_stock_daily_data(symbol=s, days=220)
        if df is None or len(df) < 90: continue
        c = np.asarray(df.sort_values('date').iloc[:-1]['close'], dtype=float)
        if len(c) < 65 or np.any(~np.isfinite(c[-65:])) or np.any(c[-65:] <= 0): continue
        r = c[1:]/c[:-1]-1
        v20 = max(float(np.std(r[-20:])), .006)
        v60 = max(float(np.std(r[-60:])), .006)
        neg = r[-60:][r[-60:] < 0]
        dvol = max(float(np.std(neg)) if len(neg)>1 else v60, .006)
        t5, t10, t20, t30, t60 = (c[-1]/c[-k-1]-1 for k in (5,10,20,30,60))
        # Path efficiency rewards persistent movement rather than noisy trend.
        efficiency = abs(t20) / (np.sum(np.abs(r[-20:])) + .02)
        f[s] = {
            'invvol': 1/(.7*v20+.3*v60),
            # Lower persistent downside incidence is defensive; rank is inverted.
            'downbreadth': -float(np.mean(r[-60:] < 0)),
            # Contrarian recovery: rebound from a recent low, moderated by drawdown.
            'recovery': t5 - .35*min(t30, 0),
            'highvol': min(v20/(v60+.006), 2.),
            'quiet': t30/(v20+.01)*(0.5+0.5*float(np.mean(r[-30:]>0))),
            'downtrend': t60/dvol,
            'efftrend': (t20/(v20+.01))*efficiency,
            'switch': (-t10/(v20+.01)) if (t30 < 0 or v20 > .018) else (t10/(v20+.01)),
            'vol': v20, 't30': t30
        }
    if len(f) < 10: return
    rr = {k: rank({s:x[k] for s,x in f.items()}) for k in FACTORS}
    score = {s: sum(FACTORS[k]*rr[k][s] for k in FACTORS) for s in ASSETS}
    median_vol = float(np.median([x['vol'] for x in f.values()]))
    breadth = float(np.mean([x['t30'] > 0 for x in f.values()]))
    stressed = median_vol > .018 or breadth < .45
    if stressed or breadth < .60:
        for s in ('XAU','US10Y','CN10Y'): score[s] += .38
        for s in ('BTC','ETH','WTI'): score[s] *= .50
    inv = {s: np.clip(median_vol/x['vol'], .65, 1.35) for s,x in f.items()}
    raw = {s: max(score[s], .03)*inv.get(s, 1.) for s in ASSETS}
    target = bounded(raw)
    if all(np.isfinite(target[s]) and target[s] >= 0 for s in ASSETS) and abs(sum(target.values())-1) < 1e-8:
        rebalance_to_weights(target)

def strategy():
    return cross_asset_strategy()


