c[:-1], 1e-12) - 1.\n        v20 = max(float(np.std(r[-20:])), .008)\n        dn = max(float(np.std(np.minimum(r[-20:], 0.))), .004)\n        r5, r20, r30 = c[-1]/c[-6]-1., c[-1]/c[-21]-1., c[-1]/c[-31]-1.\n        p20, p30 = np.mean(r[-20:] > 0), np.mean(r[-30:] > 0)\n        # Simple price-only proxies for the persisted factor definitions.\n        data[s] = {"mom20": r20/(v20+.01)*(.5+p20),\n                   "mom30": r30/(v20+.01)*(.5+p30),\n                   "downmom": r20/(dn+.01), "eff": r20/(dn+.015),\n                   "persist": r30/(v20+.01)*p30, "lead": r5,\n                   "rev": -float(np.mean(r[-5:])), "trend": r30,\n                   "vol": v20}\n    if len(data) < 10: return\n    # Market-residual momentum: remove the equal-weight cross-sectional 30d move.\n    market30 = float(np.median([x["trend"] for x in data.values()]))\n    for x in data.values(): x["resid30"] = x["trend"] - market30\n    ranks = {f: rank({s: data[s][f] for s in data}) for f in FACTORS}\n    score = {s: sum(FACTORS[f]*ranks[f][s] for f in FACTORS) for s in ASSETS}\n    eq = [data[s] for s in ["000300.SH", "SPX", "HSI", "N225", "SX5E", "NDX"] if s in data]\n    breadth = sum(x["trend"] > 0 for x in eq) / max(len(eq), 1)\n    medvol = float(np.median([x["vol"] for x in data.values()]))\n    high_risk = medvol > .018 or breadth < .67\n    bear = len(eq) >= 3 and (breadth <= .50 or (data.get("SPX", {}).get("trend", 0) < 0 and data.get("SPX", {}).get("lead", 0) < 0))\n    if high_risk or bear:\n        bump = .14 if bear else .09\n        for s in ("XAU", "US10Y", "CN10Y"):\n            score[s] += bump\n        for s in ("BTC", "ETH", "WTI"):\n            score[s] = max(.05, score[s] - (.07 if bear else .04))\n    # Small inverse-volatility overlay, deliberately not a cash sleeve.\n    med = float(np.median([x["vol"] for x in data.values()]))\n    for s in ASSETS:\n        if s in data:\n            score[s] *= .97 + .03*med/data[s]["vol"]\n    target = bounded(score)\n    if abs(sum(target.values())-1.) < 1e-8 and all(np.isfinite(v) and v >= 0 for v in target.values()):\n        rebalance_to_weights(target)\n', 'file_path': 'strategy.py'})
