# Current screener ensemble (six active factors, all long direction).
FACTORS = {"cons20": 0.30, "cons30": 0.20, "persist30": 0.16,
           "downmom": 0.14, "eff": 0.10, "resid": 0.10}
MIN_W, MAX_W = 0.03, 0.15
_day = 0


def rank_cs(values):
    out = {s: 0.5 for s in ASSETS}
    good = sorted((s, float(v)) for s, v in values.items() if np.isfinite(v))
    n = len(good)
    if n > 1:
        for i, (s, _) in enumerate(good):
            out[s] = (i + 1.0) / n
    elif n == 1:
        out[good[0][0]] = 0.5
    return out


def bounded(raw_score):
    raw = {s: max(0.05, float(raw_score.get(s, 0.5))) for s in ASSETS}
    base = 1.0 - MIN_W * len(ASSETS)
    w = {s: MIN_W + base * raw[s] / sum(raw.values()) for s in ASSETS}
    # Iterative cap redistribution preserves non-negative full investment.
    for _ in range(30):
        over = [s for s in ASSETS if w[s] > MAX_W + 1e-10]
        if not over:
            break
        excess = sum(w[s] - MAX_W for s in over)
        for s in over:
            w[s] = MAX_W
        free = [s for s in ASSETS if s not in over]
        den = sum(raw[s] for s in free)
        if not free or den <= 0:
            break
        for s in free:
            w[s] += excess * raw[s] / den
    z = sum(w.values())
    return {s: max(0.0, w[s] / z) for s in ASSETS}


@register_hook
