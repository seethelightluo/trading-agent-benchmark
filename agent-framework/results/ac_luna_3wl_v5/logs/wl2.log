finite(c[-65:])) or np.any(c[-65:] <= 0):\n            continue\n        r = c[1:] / c[:-1] - 1.\n        v10 = max(float(np.std(r[-10:])), .006)\n        v20 = max(float(np.std(r[-20:])), .006)\n        v60 = max(float(np.std(r[-60:])), .006)\n        neg20 = r[-20:][r[-20:] < 0]\n        neg60 = r[-60:][r[-60:] < 0]\n        down20 = float(np.mean(r[-20:] < 0))\n        down60 = float(np.mean(r[-60:] < 0))\n        t1, t5, t10 = r[-1], c[-1]/c[-6]-1, c[-1]/c[-11]-1\n        t20, t30, t60 = c[-1]/c[-21]-1, c[-1]/c[-31]-1, c[-61] and c[-1]/c[-61]-1\n        path20 = np.sum(np.abs(r[-20:])) + .02\n        eff10 = abs(t10) / (np.sum(np.abs(r[-10:])) + .012)\n        consistency = float(np.mean(r[-20:] > 0))\n        data[s] = {\n            "downbreadth": -(0.6 * down20 + 0.4 * down60),\n            "recovery": t5 - .30 * min(t30, 0),\n            "breadth_mom": t20 / v20 * (0.35 + 0.65 * consistency),\n            "consistency_mom": t20 / v20 * consistency,\n            "recovery_accel": (t10 - t30) / (v20 + .01),\n            "switch": (t10 / (v20 + .01)) if t30 >= 0 else (-t5 / (v20 + .01)),\n            "efficiency": t10 / (v10 + .01) * eff10,\n            "shock_reversal": -t1 / (v20 + .01) if abs(t1) > 1.25*v20 else 0.,\n            "persistence": t30 / (v20 + .01) * (0.4 + .6 * consistency),\n            "vol": v20, "t30": t30, "t60": t60,\n            "downvol": float(np.std(neg20)) if len(neg20) > 1 else v20,\n        }\n    if len(data) < 10:\n        return\n    rr = {k: ranks({s: x[k] for s, x in data.items()}) for k in FACTORS}\n    score = {s: sum(FACTORS[k] * rr[k][s] for k in FACTORS) for s in ASSETS}\n    medvol = float(np.median([x["vol"] for x in data.values()]))\n    breadth = float(np.mean([x["t30"] > 0 for x in data.values()]))\n    stressed = medvol > .018 or breadth < .45\n    if stressed or breadth < .60:\n        for s in ("XAU", "US10Y", "CN10Y"):\n            score[s] += .30\n        for s in ("BTC", "ETH", "WTI"):\n            score[s] *= .55\n    raw = {}\n    for s in ASSETS:\n        if s not in data:\n            raw[s] = .02\n        else:\n            # Inverse-vol moderation limits unstable crypto/commodity concentration.\n            raw[s] = max(score[s], .03) * np.clip(medvol / data[s]["vol"], .65, 1.30)\n    target = capped_weights(raw)\n    if all(np.isfinite(target[s]) and target[s] >= 0 for s in ASSETS) and abs(sum(target.values()) - 1.) < 1e-8:\n        rebalance_to_weights(target)\n\n\ndef strategy():\n    return cross_asset_strategy()\n', 'file_path': 'strategy.py'})
