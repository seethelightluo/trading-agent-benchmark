 import numpy as np
from alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights

ASSETS = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
FACTORS = {"clv": 0.3395, "leadlag": 0.2613, "reversal": 0.2012, "momentum": 0.1980}
MIN_WEIGHT, MAX_WEIGHT = 0.015, 0.16
_day = 0


def rank_cs(x):
    good = sorted((s, v) for s, v in x.items() if np.isfinite(v))
    out = {s: 0.5 for s in ASSETS}
    if len(good) > 1:
        for i, (s, _) in enumerate(good):
            out[s] = (i + 1.0) / len(good)
    return out


def bounded(raw):
    # Simple bounded rescaling; all 15 names remain invested.
    w = {s: max(float(raw.get(s, 1.0)), 1e-12) for s in ASSETS}
    w = {s: v / sum(w.values()) for s, v in w.items()}
    fixed = {}
    for _ in range(40):
        free = [s for s in ASSETS if s not in fixed]
        rem = 1.0 - sum(fixed.values())
        base = sum(w[s] for s in free)
        hits = False
        for s in free:
            x = rem * w[s] / base
            if x < MIN_WEIGHT:
                fixed[s] = MIN_WEIGHT; hits = True
            elif x > MAX_WEIGHT:
                fixed[s] = MAX_WEIGHT; hits = True
        if not hits:
            for s in free:
                w[s] = rem * w[s] / base
            break
    w.update(fixed)
    z = sum(w.values())
    return {s: w[s] / z for s in ASSETS}


@register_hook
def cross_asset_strategy():
    global _day
    _day += 1
    if (_day - 1) % 10 != 0:
        return

    vals = {}
    for s in ASSETS:
        df = get_stock_daily_data(symbol=s, days=90)
        if df is None or len(df) < 30:
            continue
        df = df.sort_values("date").reset_index(drop=True)
        c = np.asarray(df["close"], dtype=float)
        h = np.asarray(df["high"], dtype=float)
        l = np.asarray(df["low"], dtype=float)
        r = c[1:] / np.maximum(c[:-1], 1e-12) - 1.0
        vol = max(float(np.std(r[-20:])), 0.008)
        vals[s] = {
            "clv": (2*c[-1]-h[-1]-l[-1]) / max(h[-1]-l[-1], 1e-12),
            "leadlag": c[-1] / max(c[-6], 1e-12) - 1.0,
            "reversal": -float(np.mean(r[-5:])),
            "momentum": (c[-1] / max(c[-21], 1e-12)-1.0) / (vol + 0.01),
            "invvol": 1.0 / vol,
        }
    if len(vals) < 12:
        return

    ranks = {f: rank_cs({s: v[f] for s, v in vals.items()}) for f in FACTORS}
    score = {s: sum(FACTORS[f] * ranks[f][s] for f in FACTORS) for s in ASSETS}
    if "SPX" in vals:
        # Bear regime uses tradable defensive assets, never cash.
        spx = get_stock_daily_data(symbol="SPX", days=90).sort_values("date")["close"].to_numpy(dtype=float)
        if spx[-1] < spx[-6] and spx[-1] < spx[-21]:
            for s in ("XAU", "US10Y", "CN10Y"):
                score[s] += 0.16
            for s in ("BTC", "ETH", "WTI"):
                score[s] = max(0.02, score[s] - 0.08)
    mean_iv = float(np.mean([v["invvol"] for v in vals.values()]))
    raw = {s: max(score[s], 0.01) * (0.85 + 0.15 * vals.get(s, {"invvol": mean_iv})["invvol"] / mean_iv) for s in ASSETS}
    rebalance_to_weights(bounded(raw))


