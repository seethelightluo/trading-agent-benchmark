import numpy as np
from alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights

ASSETS = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
FACTORS = {"clv": 0.315, "leadlag": 0.242, "reversal": 0.187, "momentum": 0.184, "downside": 0.072}
MIN_WEIGHT, MAX_WEIGHT = 0.015, 0.16
_day = 0


def ranks(values):
    out = {s: 0.5 for s in ASSETS}
    valid = sorted((s, float(v)) for s, v in values.items() if np.isfinite(v))
    if len(valid) > 1:
        for i, (s, _) in enumerate(valid):
            out[s] = (i + 1.0) / len(valid)
    return out


def allocate(score):
    # Floors diversify the small cross-section; caps prevent regime concentration.
    w = {s: MIN_WEIGHT for s in ASSETS}
    rem, active = 1.0 - MIN_WEIGHT * len(ASSETS), set(ASSETS)
    while active and rem > 1e-12:
        denom = sum(max(float(score[s]), 1e-6) for s in active)
        capped = [s for s in active if rem * max(float(score[s]), 1e-6) / denom > MAX_WEIGHT - MIN_WEIGHT]
        if not capped:
            for s in active:
                w[s] += rem * max(float(score[s]), 1e-6) / denom
            break
        for s in capped:
            w[s] = MAX_WEIGHT
            rem -= MAX_WEIGHT - MIN_WEIGHT
            active.remove(s)
    total = sum(w.values())
    return {s: w[s] / total for s in ASSETS}


@register_hook
def cross_asset_strategy():
    global _day
    _day += 1
    if (_day - 1) % 10 != 0:
        return
    obs = {}
    for symbol in ASSETS:
        df = get_stock_daily_data(symbol=symbol, days=90)
        if df is None or len(df) < 30:
            continue
        df = df.sort_values("date").reset_index(drop=True)
        c = df["close"].to_numpy(float)
        h = df["high"].to_numpy(float)
        l = df["low"].to_numpy(float)
        if not np.all(np.isfinite(c[-25:])):
            continue
        r = c[1:] / np.maximum(c[:-1], 1e-12) - 1.0
        vol = max(float(np.std(r[-20:])), 0.008)
        dvol = max(float(np.std(np.minimum(r[-20:], 0.0))), 0.004)
        obs[symbol] = {
            "clv": (2*c[-1]-h[-1]-l[-1]) / max(h[-1]-l[-1], 1e-12),
            "ret5": c[-1] / max(c[-6], 1e-12) - 1.0,
            "reversal": -float(np.mean(r[-5:])),
            "momentum": (c[-1] / max(c[-21], 1e-12)-1.0) / (vol+0.01),
            "downside": (c[-1] / max(c[-21], 1e-12)-1.0) / (dvol+0.01),
            "invvol": 1.0 / vol,
        }
    if len(obs) < 10:
        return
    med = float(np.median([x["ret5"] for x in obs.values()]))
    raw = {
        "clv": {s:x["clv"] for s,x in obs.items()},
        "leadlag": {s:x["ret5"]-med for s,x in obs.items()},
        "reversal": {s:x["reversal"] for s,x in obs.items()},
        "momentum": {s:x["momentum"] for s,x in obs.items()},
        "downside": {s:x["downside"] for s,x in obs.items()},
    }
    rr = {f:ranks(v) for f,v in raw.items()}
    score = {s:sum(FACTORS[f]*rr[f][s] for f in FACTORS) for s in ASSETS}
    spx = obs.get("SPX", {})
    if spx.get("ret5", 0.0) < 0 and spx.get("momentum", 0.0) < 0:
        for s in ("XAU", "US10Y", "CN10Y"):
            score[s] += 0.12
        for s in ("BTC", "ETH", "WTI"):
            score[s] = max(0.02, score[s] - 0.06)
    med_iv = float(np.median([x["invvol"] for x in obs.values()]))
    for s in ASSETS:
        iv = obs.get(s, {}).get("invvol", med_iv)
        score[s] = max(score[s], 0.02) * (0.90 + 0.10 * iv / max(med_iv, 1e-12))
    target = allocate(score)
    if len(target) == 15 and all(np.isfinite(v) and v >= 0 for v in target.values()):
        rebalance_to_weights(target)

