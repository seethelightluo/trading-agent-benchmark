 import numpy as np
from alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights

ASSETS = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
# Screener ensemble, lagged one completed bar; capped at nine active factors.
FACTORS = {
    "downbreadth": .18, "recovery": .14, "breadth_mom": .14,
    "consistency_mom": .12, "recovery_accel": .12, "switch": .10,
    "efficiency": .08, "shock_reversal": .06, "persistence": .06,
}
REBALANCE_DAYS = 10
MIN_W, MAX_W = .035, .14
_day = 0


def ranks(vals):
    good = [(s, float(v)) for s, v in vals.items() if np.isfinite(v)]
    out = {s: .5 for s in ASSETS}
    good.sort(key=lambda z: z[1])
    for i, (s, _) in enumerate(good):
        out[s] = (i + 1.) / len(good)
    return out


def capped_weights(raw):
    raw = {s: max(float(raw.get(s, .01)), 1e-8) for s in ASSETS}
    base = 1.0 - len(ASSETS) * MIN_W
    w = {s: MIN_W + base * raw[s] / sum(raw.values()) for s in ASSETS}
    for _ in range(40):
        over = [s for s in ASSETS if w[s] > MAX_W]
        if not over:
            break
        excess = sum(w[s] - MAX_W for s in over)
        for s in over:
            w[s] = MAX_W
        rest = [s for s in ASSETS if s not in over]
        den = sum(raw[s] for s in rest)
        if not rest or den <= 0:
            break
        for s in rest:
            w[s] += excess * raw[s] / den
    z = sum(w.values())
    return {s: w[s] / z for s in ASSETS}


@register_hook
def cross_asset_strategy():
    global _day
    _day += 1
    if (_day - 1) % REBALANCE_DAYS:
        return
    data = {}
    for s in ASSETS:
        df = get_stock_daily_data(symbol=s, days=230)
        if df is None or len(df) < 100:
            continue
        c = np.asarray(df.sort_values("date").iloc[:-1]["close"], dtype=float)
        if len(c) < 65 or np.any(~np.isfinite(c[-65:])) or np.any(c[-65:] <= 0):
            continue
        r = c[1:] / c[:-1] - 1.
        v10 = max(float(np.std(r[-10:])), .006)
        v20 = max(float(np.std(r[-20:])), .006)
        v60 = max(float(np.std(r[-60:])), .006)
        neg20 = r[-20:][r[-20:] < 0]
        neg60 = r[-60:][r[-60:] < 0]
        down20 = float(np.mean(r[-20:] < 0))
        down60 = float(np.mean(r[-60:] < 0))
        t1, t5, t10 = r[-1], c[-1]/c[-6]-1, c[-1]/c[-11]-1
        t20, t30, t60 = c[-1]/c[-21]-1, c[-1]/c[-31]-1, c[-61] and c[-1]/c[-61]-1
        path20 = np.sum(np.abs(r[-20:])) + .02
        eff10 = abs(t10) / (np.sum(np.abs(r[-10:])) + .012)
        consistency = float(np.mean(r[-20:] > 0))
        data[s] = {
            "downbreadth": -(0.6 * down20 + 0.4 * down60),
            "recovery": t5 - .30 * min(t30, 0),
            "breadth_mom": t20 / v20 * (0.35 + 0.65 * consistency),
            "consistency_mom": t20 / v20 * consistency,
            "recovery_accel": (t10 - t30) / (v20 + .01),
            "switch": (t10 / (v20 + .01)) if t30 >= 0 else (-t5 / (v20 + .01)),
            "efficiency": t10 / (v10 + .01) * eff10,
            "shock_reversal": -t1 / (v20 + .01) if abs(t1) > 1.25*v20 else 0.,
            "persistence": t30 / (v20 + .01) * (0.4 + .6 * consistency),
            "vol": v20, "t30": t30, "t60": t60,
            "downvol": float(np.std(neg20)) if len(neg20) > 1 else v20,
        }
    if len(data) < 10:
        return
    rr = {k: ranks({s: x[k] for s, x in data.items()}) for k in FACTORS}
    score = {s: sum(FACTORS[k] * rr[k][s] for k in FACTORS) for s in ASSETS}
    medvol = float(np.median([x["vol"] for x in data.values()]))
    breadth = float(np.mean([x["t30"] > 0 for x in data.values()]))
    stressed = medvol > .018 or breadth < .45
    if stressed or breadth < .60:
        for s in ("XAU", "US10Y", "CN10Y"):
            score[s] += .30
        for s in ("BTC", "ETH", "WTI"):
            score[s] *= .55
    raw = {}
    for s in ASSETS:
        if s not in data:
            raw[s] = .02
        else:
            # Inverse-vol moderation limits unstable crypto/commodity concentration.
            raw[s] = max(score[s], .03) * np.clip(medvol / data[s]["vol"], .65, 1.30)
    target = capped_weights(raw)
    if all(np.isfinite(target[s]) and target[s] >= 0 for s in ASSETS) and abs(sum(target.values()) - 1.) < 1e-8:
        rebalance_to_weights(target)


def strategy():
    return cross_asset_strategy()


