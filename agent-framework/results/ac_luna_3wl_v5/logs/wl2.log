  ▶️ write_file({'content': "import numpy as np, pandas as pd\nfrom alphacrafter.sim.utils import get_account_dict,get_stock_daily_data,get_index_daily_data\nacct=get_account_dict(); u=acct.get('watch_list',[]) or ['000300.SH','SPX','HSI','N225','SX5E','000688.SH','SOX','NDX','XAU','COPPER','WTI','BTC','ETH','US10Y','CN10Y']\npx={}\nfor s in u:\n d=get_stock_daily_data(s,1800)\n if d is None or len(d)==0: d=get_index_daily_data(s,1800)\n if d is not None and len(d): px[s]=d.set_index('date')['close'].astype(float)\np=pd.DataFrame(px).sort_index(); r=p.pct_change(); rows=[]; signals=[]\n# Choppy/inefficient markets tend to mean-revert: risk-scaled 5d reversal,\n# activated only when cross-asset average path efficiency is historically low.\nfor t in range(65,len(p)-1):\n    rr=r.iloc[t-19:t+1]\n    eff=(rr.sum().abs()/(rr.abs().sum()+1e-12)).replace([np.inf,-np.inf],np.nan)\n    market_eff=eff.mean()\n    prior=[]\n    for j in range(65,t):\n        x=r.iloc[j-19:j+1]\n        prior.append((x.sum().abs()/(x.abs().sum()+1e-12)).mean())\n    if not np.isfinite(market_eff) or len(prior)<30 or market_eff>np.quantile(prior,0.30): continue\n    f=(-r.iloc[t-4:t+1].sum()/r.iloc[t-19:t+1].std()).replace([np.inf,-np.inf],np.nan)\n    y=r.iloc[t+1].reindex(f.index); z=pd.concat([f,y],axis=1).dropna()\n    if len(z)>=8:\n        ic=z.iloc[:,0].corr(z.iloc[:,1]); rows.append((p.index[t],ic,len(z),market_eff))\n        for s,v in f.items(): signals.append({'date':p.index[t],'symbol':s,'signal':v})\na=np.array([x[1] for x in rows]); n=np.array([x[2] for x in rows])\nprint('dates',len(a),'avgN',round(n.mean(),2) if len(n) else 0,'coverage',round(n.mean()/len(u),4) if len(n) else 0)\nif len(a):\n print('daily IC %.6f ICIR %.6f hit %.4f'%(a.mean(),a.mean()/a.std(ddof=1),np.mean(a>0)))\n for lab,cut in [('2028+',pd.Timestamp('2028-01-01')),('2029+',pd.Timestamp('2029-01-01'))]:\n  q=a[[x[0]>=cut for x in rows]]\n  print(lab,'dates',len(q),'IC %.6f ICIR %.6f'%(q.mean(),q.mean()/q.std(ddof=1)) if len(q)>1 else 'insufficient')\n sig=pd.DataFrame(signals); sig.to_csv('scripts/miner_3_20290628_choppy_reversal_signal.csv',index=False)\n print('signal_artifact','scripts/miner_3_20290628_choppy_reversal_signal.csv')\nelse: print('no observations')\n", 'file_path': 'scripts/miner_3_20290628_choppy_reversal.py'})
