           "rev3": .077, "down20": .074, "clvtrend15": .053, "eff20": .049}
MIN_W, MAX_W = .02, .15
_day = 0

def rank_cs(values):
    out = {s: .5 for s in ASSETS}
    good = sorted((s, float(v)) for s, v in values.items() if np.isfinite(v))
    n = len(good)
    if n > 1:
        for i, (s, _) in enumerate(good):
            out[s] = (i + 1.0) / n
    return out

def bounded_weights(score):
    # Full investment, with sensible diversification for a 15-name universe.
    w = {s: MIN_W for s in ASSETS}
    free, active = 1.0 - MIN_W * len(ASSETS), set(ASSETS)
    while active and free > 1e-12:
        q = {s: max(float(score.get(s, .5)), .01) for s in active}
        tot = sum(q.values())
        hit = [s for s in active if free*q[s]/tot > MAX_W-MIN_W]
        if not hit:
            for s in active: w[s] += free*q[s]/tot
            break
        for s in hit:
            w[s] = MAX_W
            free -= MAX_W-MIN_W
            active.remove(s)
    z = sum(w.values())
    return {s: w[s]/z for s in ASSETS}

