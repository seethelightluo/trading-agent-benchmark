 import numpy as np
from alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights

ASSETS = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
# Current screener ensemble: capped at five active, lagged trend signals.
FACTORS = {"quiet": 0.30, "accel": 0.28, "risk20": 0.24, "down60": 0.13, "resid": 0.05}
REBALANCE_DAYS = 10
MIN_W, MAX_W = 0.045, 0.13
_day = 0

def ranks(values):
    good = sorted((s, v) for s, v in values.items() if np.isfinite(v))
    out = {s: 0.5 for s in ASSETS}
    n = len(good)
    for i, (s, _) in enumerate(good):
        out[s] = (i + 1.0) / n
    return out

def make_weights(score, invvol):
    raw = {s: max(0.08, score[s]) * np.clip(invvol.get(s, 1.0), 0.70, 1.30) for s in ASSETS}
    base = 1.0 - len(ASSETS) * MIN_W
    w = {s: MIN_W + base * raw[s] / sum(raw.values()) for s in ASSETS}
    # Redistribute any cap excess without creating a cash sleeve.
    for _ in range(30):
        high = [s for s in ASSETS if w[s] > MAX_W + 1e-10]
        if not high: break
        excess = sum(w[s] - MAX_W for s in high)
        for s in high: w[s] = MAX_W
        rest = [s for s in ASSETS if s not in high]
        z = sum(raw[s] for s in rest)
        if not rest or z <= 0: break
        for s in rest: w[s] += excess * raw[s] / z
    z = sum(w.values())
    return {s: w[s] / z for s in ASSETS}

@register_hook
def cross_asset_strategy():
    global _day
    _day += 1
    if (_day - 1) % REBALANCE_DAYS != 0:
        return
    feat = {}
    for s in ASSETS:
        df = get_stock_daily_data(symbol=s, days=220)
        if df is None or len(df) < 90: continue
        d = df.sort_values("date").iloc[:-1]  # completed bars only
        c = np.asarray(d["close"], float)
        if len(c) < 65 or np.any(c[-65:] <= 0): continue
        r = c[1:] / c[:-1] - 1.0
        r20, r30, r60 = r[-20:], r[-30:], r[-60:]
        v20 = max(float(np.std(r20)), 0.006)
        t20, t30, t60 = c[-1]/c[-21]-1, c[-1]/c[-31]-1, c[-1]/c[-61]-1
        cons30 = float(np.mean(r30 > 0)); cons20 = float(np.mean(r20 > 0))
        quiet = t30/(v20+0.01) * (0.5+0.5*cons30)
        accel = (t20-t30)/(v20+0.01) * (0.5+0.5*cons20)
        down = np.std(r60[r60 < 0]) if np.any(r60 < 0) else max(float(np.std(r60)), .006)
        feat[s] = {"quiet":quiet, "accel":accel, "risk20":t20/v20,
                   "down60":t60/max(float(down),.006), "t30":t30, "vol":v20}
    if len(feat) < 10: return
    rr = {k: ranks({s:x[k] for s,x in feat.items()}) for k in FACTORS if k != "resid"}
    # Small market-residual proxy: asset return minus equal-panel median return.
    panel = {s: x["t30"] for s,x in feat.items()}
    med = float(np.median(list(panel.values())))
    rr["resid"] = ranks({s: panel[s]-med for s in feat})
    score = {s: sum(FACTORS[k]*rr[k][s] for k in FACTORS) for s in ASSETS}
    breadth = float(np.mean([x["t30"] > 0 for x in feat.values()]))
    medvol = float(np.median([x["vol"] for x in feat.values()]))
    # High-risk, uncertain breadth: defensive tradable assets replace cash.
    if breadth < 0.60 or medvol > 0.018:
        for s in ("XAU", "US10Y", "CN10Y"): score[s] += 0.38
        for s in ("BTC", "ETH", "WTI"): score[s] -= 0.24
    invvol = {s: medvol/x["vol"] for s,x in feat.items()}
    target = make_weights(score, invvol)
    if set(target) == set(ASSETS) and all(np.isfinite(v) and v >= 0 for v in target.values()):
        rebalance_to_weights(target)

def strategy():
    return cross_asset_strategy()


