 import numpy as np
from alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights

ASSETS = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
FACTORS = {"quiet": 0.30, "down60": 0.20, "risk20": 0.20, "switch": 0.20, "consistency": 0.10}
REBALANCE_DAYS = 10
MIN_W, MAX_W = 0.04, 0.14
_day = 0

def cross_rank(values):
    valid = sorted((s, v) for s, v in values.items() if np.isfinite(v))
    out = {s: 0.5 for s in ASSETS}
    for i, (s, _) in enumerate(valid):
        out[s] = (i + 1.0) / len(valid)
    return out

def bounded_weights(raw):
    raw = {s: max(1e-8, float(raw.get(s, 1e-8))) for s in ASSETS}
    w = {s: MIN_W + (1 - len(ASSETS)*MIN_W) * raw[s] / sum(raw.values()) for s in ASSETS}
    for _ in range(40):
        over = [s for s in ASSETS if w[s] > MAX_W + 1e-12]
        if not over: break
        excess = sum(w[s] - MAX_W for s in over)
        for s in over: w[s] = MAX_W
        rest = [s for s in ASSETS if s not in over]
        den = sum(raw[s] for s in rest)
        if not rest or den <= 0: break
        for s in rest: w[s] += excess * raw[s] / den
    z = sum(w.values())
    return {s: w[s] / z for s in ASSETS}

@register_hook
def cross_asset_strategy():
    global _day
    _day += 1
    if (_day - 1) % REBALANCE_DAYS: return
    feat = {}
    for s in ASSETS:
        df = get_stock_daily_data(symbol=s, days=220)
        if df is None or len(df) < 90: continue
        c = np.asarray(df.sort_values("date").iloc[:-1]["close"], dtype=float)
        if len(c) < 65 or np.any(~np.isfinite(c[-65:])) or np.any(c[-65:] <= 0): continue
        r = c[1:] / c[:-1] - 1.0
        vol = max(float(np.std(r[-20:])), 0.006)
        neg = r[-60:][r[-60:] < 0]
        dvol = max(float(np.std(neg)) if len(neg) > 1 else np.std(r[-60:]), 0.006)
        t10, t20 = c[-1]/c[-11]-1, c[-1]/c[-21]-1
        t30, t60 = c[-1]/c[-31]-1, c[-1]/c[-61]-1
        consistency = float(np.mean(r[-30:] > 0))
        feat[s] = {"quiet": t30/(vol+.01)*(.5+.5*consistency), "down60": t60/dvol,
                   "risk20": t20/vol, "trend10": t10/(vol+.01),
                   "consistency": t30/(vol+.01)*consistency, "t30": t30, "vol": vol}
    if len(feat) < 10: return
    medvol = float(np.median([x["vol"] for x in feat.values()]))
    # Elevated-volatility switch is explicitly reversal-oriented and lagged.
    for x in feat.values(): x["switch"] = -x["trend10"] if medvol > .018 else x["trend10"]
    ranks = {k: cross_rank({s: x[k] for s, x in feat.items()}) for k in FACTORS}
    score = {s: sum(FACTORS[k] * ranks[k][s] for k in FACTORS) for s in ASSETS}
    breadth = float(np.mean([x["t30"] > 0 for x in feat.values()]))
    if breadth < .60 or medvol > .018:
        for s in ("XAU", "US10Y", "CN10Y"): score[s] += .55
        for s in ("BTC", "ETH", "WTI"): score[s] *= .40
    invvol = {s: np.clip(medvol/x["vol"], .65, 1.35) for s, x in feat.items()}
    raw = {s: max(.05, score[s]) * invvol.get(s, 1.0) for s in ASSETS}
    target = bounded_weights(raw)
    if all(np.isfinite(list(target.values()))) and abs(sum(target.values())-1) < 1e-8:
        rebalance_to_weights(target)

def strategy(): return cross_asset_strategy()


