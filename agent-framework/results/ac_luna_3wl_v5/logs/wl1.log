for s in free:\n            w[s] *= scale\n        if all(0.015 - 1e-10 <= w[s] <= 0.16 + 1e-10 for s in UNIVERSE):\n            break\n    total = sum(w.values())\n    return {s: w[s] / total for s in UNIVERSE}\n\n\n@register_hook\ndef cross_asset_strategy():\n    global _last_decision_date\n    prices = {}\n    for symbol in UNIVERSE:\n        df = get_stock_daily_data(symbol=symbol, days=130)\n        if df is not None and len(df) >= 45:\n            prices[symbol] = np.asarray(df.sort_values("date")["close"], dtype=float)\n    if len(prices) < 12:\n        return\n\n    # Only completed observations are used; the final returned bar is the latest visible close.\n    dates = []\n    for symbol in prices:\n        d = get_stock_daily_data(symbol=symbol, days=2)\n        if d is not None and len(d):\n            dates.append(str(d.sort_values("date").iloc[-1]["date"]))\n    if not dates:\n        return\n    decision_date = max(dates)\n    if _last_decision_date is not None:\n        try:\n            if (np.datetime64(decision_date) - np.datetime64(_last_decision_date)) / np.timedelta64(1, "D") < 10:\n                return\n        except Exception:\n            return\n\n    def ret(c, n):\n        return c[-1] / max(c[-n-1], 1e-12) - 1.0\n\n    r5 = {s: ret(c, 5) for s, c in prices.items()}\n    r10 = {s: ret(c, 10) for s, c in prices.items()}\n    peer5, peer10 = np.median(list(r5.values())), np.median(list(r10.values()))\n    factors = {k: {} for k in FACTOR_WEIGHTS}\n    vols = {}\n    for s, c in prices.items():\n        daily = c[1:] / np.maximum(c[:-1], 1e-12) - 1.0\n        vol = max(float(np.std(daily[-20:])), 0.008)\n        downvol = max(float(np.std(np.minimum(daily[-30:], 0.0))), 0.006)\n        vols[s] = vol\n        reversal = -float(np.mean(daily[-5:]))\n        shock = -float(daily[-1]) * np.clip(abs(float(daily[-1])) / (vol + .002), 0., 3.)\n        factors["vix"][s] = reversal * np.clip(vol / .018, .5, 2.)\n        factors["clv"][s] = -float(daily[-1]) * np.clip(vol / .018, .5, 2.)\n        factors["rvolmom"][s] = (r10[s] - peer10) / vol\n        factors["path"][s] = np.sign(r10[s]) * abs(r10[s]) / max(float(np.sum(abs(daily[-10:]))), .01)\n        factors["resid"][s] = r10[s] - peer10\n        factors["peer"][s] = (r5[s] - peer5) + .5 * (r10[s] - peer10)\n        factors["shock"][s] = .6 * (r10[s] - peer10) + .4 * shock\n        factors["highvol"][s] = reversal * np.clip(vol / .020, .5, 2.5)\n        factors["downmom"][s] = ret(c, 20) / downvol\n\n    score = {s: sum(FACTOR_WEIGHTS[k] * ranks(factors[k])[s] for k in FACTOR_WEIGHTS) for s in UNIVERSE}\n    breadth = float(np.mean([c[-1] > c[-21] for c in prices.values()]))\n    spx = prices.get("SPX")\n    bear = spx is not None and spx[-1] < spx[-21] and spx[-1] < spx[-6]\n    # Moderate bullish regime: broaden only when breadth confirms. Bear/risk-off uses tradable defensives.\n    if bear or breadth < .40:\n        for s in ("XAU", "US10Y", "CN10Y"):\n            score[s] += .12\n        for s in ("BTC", "ETH", "WTI"):\n            score[s] -= .05\n    elif breadth > .67:\n        for s in ("SPX", "NDX", "SOX", "000300.SH"):\n            score[s] += .035\n\n    mean_vol = float(np.mean(list(vols.values())))\n    raw = {s: max(score[s], .03) * (.85 + .15 * mean_vol / max(vols[s], .008)) for s in UNIVERSE}\n    targets = project_weights(raw)\n    forecasts = {s: 0.06 * (score[s] - 0.5) for s in UNIVERSE}\n    rebalance_to_weights(targets, forecast_returns=forecasts, factor_ids=FACTOR_IDS, horizon_days=10)\n    _last_decision_date = decision_date\n', 'file_path': 'strategy.py'})
