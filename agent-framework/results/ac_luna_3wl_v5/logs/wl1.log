at(np.sum(abs(d[-20:]))), .01)\n        dd = close[s][-1] / max(float(np.max(close[s][-61:-1])), close[s][-1]) - 1.0\n        recovery = (r20[s] - r60[s] / 3.0) * (1.0 + min(max(-dd, 0.0), .35))\n        accel = (r20[s] - r60[s] / 3.0) / max(vol[s], .01)\n        fs[0][s] = (.35*r10[s] + .65*r20[s]) * efficiency * (1.0 + max(vix, 0.0))\n        fs[1][s] = (.55*r20[s] + .45*r60[s]/3.0) / max(vol[s], .01)\n        fs[2][s] = r20[s] / downside\n        fs[3][s] = residual * (1.0 + .7*max(vix, 0.0))\n        fs[4][s] = residual / max(vol[s] * (1.0 + max(beta, 0.0)), .01)\n        fs[5][s] = accel / (1.0 + max(-r20[s], 0.0))\n        fs[6][s] = recovery\n        fs[7][s] = .45*r20[s] + .35*r60[s] + .20*r10[s]\n        fs[8][s] = abs(r20[s]) / max(float(np.sum(abs(d[-10:]))), .01)\n    ranks = [_rank(f, names) for f in fs]\n    score = {s: sum(float(w)*r[s] for w, r in zip(FACTOR_WEIGHTS, ranks)) for s in UNIVERSE}\n    if stress:\n        for s, add in (("XAU", .16), ("US10Y", .13), ("CN10Y", .10)): score[s] += add\n        for s in ("BTC", "ETH", "WTI", "COPPER"): score[s] -= .10\n    target = _weights(score, vol, stress)\n\n    account = get_account_dict()\n    old = {s: 0.0 for s in UNIVERSE}\n    for p in account.get("positions", []):\n        if p.get("symbol") in old and float(p.get("quantity", 0)) > 0:\n            old[p["symbol"]] = max(0.0, float(p.get("market_value", 0)) / max(float(account.get("total_assets", 1)), 1.0))\n    if sum(old.values()) > .001:\n        # Damp migrations to reduce repeated costly rotations in unstable regimes.\n        target = {s: .40*target[s] + .60*old[s] for s in UNIVERSE}\n        z = sum(target.values()); target = {s: target[s] / z for s in UNIVERSE}\n    forecast = {s: .008 * (score[s] - .5) for s in UNIVERSE}\n    rebalance_to_weights(target, forecast_returns=forecast, factor_ids=FACTOR_IDS, horizon_days=10)\n    _days_to_rebalance = 9\n', 'file_path': 'strategy.py'})
