  ▶️ write_file({'content': 'import numpy as np\nfrom alphacrafter.sim.utils import register_hook, get_account_dict, get_stock_daily_data, rebalance_to_weights\n\nUNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]\nFACTOR_WEIGHTS = {\n    "downside_momentum": .20, "peer": .16, "clv": .15,\n    "vix_reversal": .13, "vix_clv": .10, "breadth_reversal": .09,\n    "highvol_reversal": .07, "shock": .06, "reversal": .04,\n}\nFACTOR_IDS = [\n    "miner_3_20260730_downside_risk_adjusted_momentum_10d",\n    "peer_median_leadlag_5d", "miner_3_clv_1d",\n    "miner_1_20260730_vix_state_reversal_5d",\n    "miner_3_20260730_vix_conditioned_clv_1d",\n    "miner_1_breadth_stress_reversal_5d",\n    "miner_2_20260730_highvol_amplified_reversal_3d",\n    "miner_3_range_shock_exhaustion_1d", "short_term_reversal_5d",\n]\nMIN_W, MAX_W, REBALANCE_DAYS = .015, .16, 10\nlast_decision = None\n\ndef rank(values):\n    good = sorted((s, float(v)) for s, v in values.items() if np.isfinite(v))\n    out = {s: .5 for s in UNIVERSE}\n    for i, (s, _) in enumerate(good):\n        out[s] = (i + 1.) / len(good) if good else .5\n    return out\n\ndef bounded(raw):\n    # Iterative capped simplex projection, retaining a complete 15-asset target.\n    w = {s: max(float(raw.get(s, .03)), 1e-12) for s in UNIVERSE}\n    for _ in range(30):\n        low = {s for s in UNIVERSE if w[s] < MIN_W}\n        high = {s for s in UNIVERSE if w[s] > MAX_W}\n        for s in low: w[s] = MIN_W\n        for s in high: w[s] = MAX_W\n        free = [s for s in UNIVERSE if s not in low and s not in high]\n        gap = 1. - sum(w[s] for s in low | high)\n        if not free: break\n        total = sum(w[s] for s in free)\n        for s in free: w[s] = gap * w[s] / max(total, 1e-12)\n        if all(MIN_W - 1e-9 <= w[s] <= MAX_W + 1e-9 for s in UNIVERSE): break\n    z = sum(w.values())\n    return {s: w[s] / z for s in UNIVERSE}\n\n@register_hook\ndef cross_asset_strategy():\n    global last_decision\n    account = get_account_dict()\n    data = {}\n    for s in UNIVERSE:\n        df = get_stock_daily_data(symbol=s, days=90)\n        if df is None or len(df) < 35: continue\n        df = df.sort_values("date").reset_index(drop=True)\n        c = np.asarray(df.close, dtype=float)\n        h, l = np.asarray(df.high, dtype=float), np.asarray(df.low, dtype=float)\n        r = c[1:] / np.maximum(c[:-1], 1e-12) - 1.\n        data[s] = (c, h, l, r, str(df.iloc[-1].date))\n    if len(data) < 12: return\n    decision = max(x[4] for x in data.values())\n    if last_decision is not None:\n        try:\n            age = (np.datetime64(decision, "D") - np.datetime64(last_decision, "D")) / np.timedelta64(1, "D")\n            if age < REBALANCE_DAYS: return\n        except Exception: return\n\n    ret5 = {s: float(x[0][-1] / max(x[0][-6], 1e-12) - 1.) for s, x in data.items()}\n    med5 = float(np.median(list(ret5.values())))\n    f = {k: {} for k in FACTOR_WEIGHTS}\n    invvol = {}\n    for s, (c, h, l, r, _) in data.items():\n        vol = max(float(np.std(r[-20:])), .008)\n        downside = max(float(np.std(np.minimum(r[-20:], 0.0))), .006)\n        clv1 = float((2*c[-1] - h[-1] - l[-1]) / max(h[-1]-l[-1], 1e-12))\n        clv5 = float(np.mean((2*c[-5:] - h[-5:] - l[-5:]) / np.maximum(h[-5:]-l[-5:], 1e-12)))\n        rev5 = -float(np.mean(r[-5:]))\n        highvol = min(max(vol / .018, .5), 2.0)\n        peer_vals = [v for k, v in ret5.items() if k != s]\n        peer = float(np.median(peer_vals)) if peer_vals else 0.\n        f["downside_momentum"][s] = (c[-1] / max(c[-11], 1e-12) - 1.) / downside\n        f["peer"][s] = peer\n        f["clv"][s] = clv1\n        f["vix_reversal"][s] = rev5 * highvol\n        f["vix_clv"][s] = clv5 * highvol\n        f["breadth_reversal"][s] = rev5 * (1.5 if med5 < 0 else .35)\n        f["highvol_reversal"][s] = -float(r[-1]) * min(abs(float(r[-1])/(vol+.002)), 3.)\n        f["shock"][s] = f["highvol_reversal"][s]\n        f["reversal"][s] = rev5\n        invvol[s] = 1. / vol\n    ranked = {k: rank(v) for k, v in f.items()}\n    score = {s: sum(FACTOR_WEIGHTS[k] * ranked[k][s] for k in FACTOR_WEIGHTS) for s in UNIVERSE}\n    breadth = float(np.mean([data[s][0][-1] > data[s][0][-21] for s in data]))\n    spx = data.get("SPX")\n    bear = spx is not None and spx[0][-1] < spx[0][-21] and spx[0][-1] < spx[0][-6]\n    if bear or breadth < .40:\n        for s in ("XAU", "US10Y", "CN10Y"): score[s] += .14\n        for s in ("BTC", "ETH", "WTI"): score[s] -= .06\n    elif breadth > .67:\n        for s in ("SPX", "NDX", "SOX", "000300.SH"): score[s] += .04\n    mean_iv = float(np.mean(list(invvol.values())))\n    raw = {s: max(.03, score[s]) * (.80 + .20 * invvol.get(s, mean_iv) / max(mean_iv, 1e-12)) for s in UNIVERSE}\n    weights = bounded(raw)\n    # Deterministic 10-session forecasts are required by the execution gate.\n    forecasts = {s: float(0.06 * (score[s] - .5)) for s in UNIVERSE}\n    if set(weights) == set(UNIVERSE) and abs(sum(weights.values())-1.) < 1e-7:\n        rebalance_to_weights(weights, forecast_returns=forecasts, factor_ids=FACTOR_IDS, horizon_days=10)\n        last_decision = decision\n', 'file_path': 'strategy.py'})Traceback (most recent call last):
