1e-12)\n    z = sum(w.values())\n    return {s: w[s] / z for s in UNIVERSE}\n\n@register_hook\ndef cross_asset_strategy():\n    global _gate\n    if _gate:\n        _gate -= 1\n        return\n    close, daily, vol = {}, {}, {}\n    for s in UNIVERSE:\n        df = get_stock_daily_data(symbol=s, days=240)\n        if df is None or len(df) < 90: continue\n        c = np.asarray(df.sort_values("date")["close"], dtype=float)\n        if len(c) >= 70 and np.all(np.isfinite(c)) and np.all(c > 0):\n            close[s] = c; daily[s] = c[1:] / c[:-1] - 1\n            vol[s] = max(float(np.std(daily[s][-30:])), .008)\n    names = [s for s in UNIVERSE if s in close]\n    if len(names) < 12: return\n    rr = {s: {k: close[s][-1] / close[s][-(k + 1)] - 1 for k in (5, 10, 20, 30, 60)} for s in names}\n    peer = np.mean([daily[s][-20:] for s in names], axis=0)\n    breadth = np.mean([rr[s][20] > 0 for s in names])\n    market = rr.get("SPX", {20: np.median([rr[s][20] for s in names])})[20]\n    vx = 0.\n    vdf = get_index_daily_data(symbol="VIX", days=45)\n    if vdf is not None and len(vdf) >= 22:\n        vc = np.asarray(vdf.sort_values("date")["close"], dtype=float)\n        vx = vc[-1] / max(float(np.median(vc[-21:])), 1e-9) - 1\n    stress = market < -.05 or breadth < .40 or np.mean(list(vol.values())) > .022 or vx > .15\n    f = [dict() for _ in FACTOR_IDS]\n    for s in names:\n        d = daily[s]; down = max(float(np.std(np.minimum(d[-40:], 0))), .006)\n        beta = float(np.cov(d[-20:], peer)[0, 1] / max(np.var(peer), 1e-8))\n        residual = rr[s][20] - beta * float(np.median([rr[t][20] for t in names if t != s]))\n        trend = .35 * rr[s][10] + .65 * rr[s][20]\n        efficiency = abs(rr[s][20]) / max(float(np.sum(abs(d[-20:]))), .01)\n        f[0][s] = trend * efficiency * (1 + max(vx, 0))\n        f[1][s] = trend / vol[s]\n        f[2][s] = rr[s][20] / down\n        f[3][s] = residual * (1 + .7 * max(vx, 0))\n        f[4][s] = residual / max(vol[s] * (1 + max(beta, 0)), .01)\n        f[5][s] = (rr[s][5] - rr[s][20] / 4) / max(vol[s], .01)\n        f[6][s] = (rr[s][10] - rr[s][20] / 2) / max(vol[s], .01)\n        peak = max(close[s][-61:-1]); trough = min(close[s][-61:-1])\n        recovery = (close[s][-1] - trough) / max(peak - trough, 1e-9)\n        f[7][s] = .5 * rr[s][20] + .3 * rr[s][10] + .2 * recovery\n        f[8][s] = (.45 * rr[s][20] + .35 * rr[s][60] + .20 * rr[s][10]) / max(vol[s], .01)\n        pos, neg = np.maximum(d[-30:], 0), np.minimum(d[-30:], 0)\n        f[9][s] = (float(np.mean(pos)) + 1e-6) / (abs(float(np.mean(neg))) + 1e-4) * (.5 + .5 * recovery)\n    rk = [ranks(x, names) for x in f]\n    score = {s: sum(w * r[s] for w, r in zip(FACTOR_WEIGHTS, rk)) for s in UNIVERSE}\n    if stress:\n        for s, a in (("XAU", .16), ("US10Y", .13), ("CN10Y", .10)): score[s] += a\n        for s in ("BTC", "ETH", "WTI", "COPPER"): score[s] -= .10\n    target = allocate(score, vol, stress)\n    account = get_account_dict(); assets = max(float(account.get("total_assets", 0)), 1.)\n    old = {s: 0. for s in UNIVERSE}\n    for p in account.get("positions", []):\n        s = p.get("symbol")\n        if s in old and float(p.get("quantity", 0)) > 0:\n            old[s] = max(float(p.get("market_value", 0)), 0.) / assets\n    if sum(old.values()) > .001:\n        target = {s: .40 * target[s] + .60 * old[s] for s in UNIVERSE}\n        z = sum(target.values()); target = {s: target[s] / z for s in UNIVERSE}\n    forecast = {s: .008 * (score[s] - .5) for s in UNIVERSE}\n    rebalance_to_weights(target, forecast_returns=forecast, factor_ids=FACTOR_IDS, horizon_days=10)\n    _gate = 9\n', 'file_path': 'strategy.py'})
