dict()\n    data = {}\n    for s in UNIVERSE:\n        df = get_stock_daily_data(symbol=s, days=90)\n        if df is None or len(df) < 35: continue\n        df = df.sort_values("date").reset_index(drop=True)\n        c = np.asarray(df["close"], float)\n        h, l = np.asarray(df["high"], float), np.asarray(df["low"], float)\n        r = c[1:] / np.maximum(c[:-1], 1e-12) - 1.\n        data[s] = (c, h, l, r, str(df.iloc[-1]["date"]))\n    if len(data) < 12: return\n    decision = max(v[4] for v in data.values())\n    if last_decision is not None:\n        try:\n            age = (np.datetime64(decision, "D") - np.datetime64(last_decision, "D")) / np.timedelta64(1, "D")\n            if age < CADENCE: return\n        except Exception: return\n\n    ret5 = {s: v[0][-1] / max(v[0][-6], 1e-12) - 1. for s, v in data.items()}\n    ret10 = {s: v[0][-1] / max(v[0][-11], 1e-12) - 1. for s, v in data.items()}\n    median10 = float(np.median(list(ret10.values())))\n    breadth = float(np.mean([v[0][-1] > v[0][-21] for v in data.values()]))\n    f = {k: {} for k in WEIGHTS}\n    vol = {}\n    for s, (c, h, l, r, _) in data.items():\n        v = max(float(np.std(r[-20:])), .008)\n        down = max(float(np.std(np.minimum(r[-20:], 0.))), .006)\n        clv1 = float((2*c[-1]-h[-1]-l[-1]) / max(h[-1]-l[-1], 1e-12))\n        clv5 = float(np.mean((2*c[-5:]-h[-5:]-l[-5:]) / np.maximum(h[-5:]-l[-5:], 1e-12)))\n        rev5 = -float(np.mean(r[-5:]))\n        shock = -float(r[-1]) * min(abs(float(r[-1])) / (v + .002), 3.)\n        # Residual momentum removes the asset\'s trailing beta to the cross-section median.\n        residual = ret10[s] - median10\n        peer = float(np.median([x for k, x in ret5.items() if k != s]))\n        dispersion = float(np.std(list(ret5.values())))\n        f["downside_mom"][s] = ret10[s] / down\n        f["residual_mom"][s] = residual / max(v, .008)\n        f["peer"][s] = peer\n        f["vix_rev"][s] = rev5 * min(max(v / .018, .5), 2.)\n        f["vix_clv"][s] = clv5 * min(max(v / .018, .5), 2.)\n        f["disp_rev"][s] = rev5 * min(max(dispersion / .015, .5), 2.)\n        f["breadth_rev"][s] = rev5 * (1.5 if breadth < .5 else .35)\n        f["clv"][s] = clv1\n        f["shock"][s] = shock\n        vol[s] = v\n    score = {s: sum(WEIGHTS[k] * ranks(f[k])[s] for k in WEIGHTS) for s in UNIVERSE}\n    spx = data.get("SPX")\n    bear = spx is not None and spx[0][-1] < spx[0][-21] and spx[0][-1] < spx[0][-6]\n    # Bullish/moderate trend: modest equity tilt; stressed trend: defensive tradable tilt.\n    if bear or breadth < .40:\n        for s in ("XAU", "US10Y", "CN10Y"): score[s] += .14\n        for s in ("BTC", "ETH", "WTI"): score[s] -= .06\n    elif breadth > .67:\n        for s in ("SPX", "NDX", "SOX", "000300.SH"): score[s] += .04\n    avg = float(np.mean(list(vol.values())))\n    raw = {s: max(score[s], .03) * (.80 + .20 * (avg / max(vol[s], .008))) for s in UNIVERSE}\n    weights = capped_simplex(raw)\n    forecasts = {s: float(.06 * (score[s] - .5)) for s in UNIVERSE}\n    if set(weights) == set(UNIVERSE) and abs(sum(weights.values()) - 1.) < 1e-7:\n        rebalance_to_weights(weights, forecast_returns=forecasts, factor_ids=FACTOR_IDS, horizon_days=10)\n        last_decision = decision\n', 'file_path': 'strategy.py'})
