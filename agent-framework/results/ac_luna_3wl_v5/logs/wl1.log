  ▶️ write_file({'content': 'import numpy as np\nfrom alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights\n\nUNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]\nFACTOR_IDS = ["miner_1_20260730_vix_state_reversal_5d", "miner_3_20260730_vix_conditioned_clv_1d", "miner_1_20260730_residual_vol_scaled_momentum_10d", "miner_3_20260730_vol_adjusted_momentum_10d", "miner_3_20260730_trend_efficiency_10d", "miner_2_20260730_residual_momentum_10d", "miner_1_20260730_downside_quality_momentum_10d", "miner_1_20260730_path_efficiency_10d", "miner_1_20260730_residual_shock_blend_10d", "miner_1_20260730_dispersion_conditioned_reversal_1d"]\nWEIGHTS = {"rev": .26, "mom": .27, "trend": .22, "down": .10, "shock": .08, "disp": .07}\n_days = 0\n\ndef ranks(x):\n    a = sorted((s, float(v)) for s, v in x.items() if np.isfinite(v))\n    out = {s: .5 for s in UNIVERSE}\n    for i, (s, _) in enumerate(a): out[s] = (i + 1.) / max(len(a), 1)\n    return out\n\ndef cap_weights(raw, lo=.025, hi=.14):\n    # Water-fill from the lower bound, capping high scores; guaranteed feasible.\n    vals = {s: max(float(raw.get(s, 1/15)), 1e-6) if np.isfinite(raw.get(s, 1/15)) else 1/15 for s in UNIVERSE}\n    w = {s: lo for s in UNIVERSE}; free = set(UNIVERSE); remaining = 1. - lo * len(UNIVERSE)\n    for _ in range(30):\n        if not free or remaining <= 1e-12: break\n        z = sum(vals[s] for s in free)\n        newly = set()\n        for s in free:\n            add = remaining * vals[s] / max(z, 1e-12)\n            if add >= hi - lo: w[s] = hi; newly.add(s)\n            else: w[s] = lo + add\n        if not newly: break\n        remaining = 1. - sum(w[s] for s in UNIVERSE if s not in free or s in newly)\n        free -= newly\n    if free:\n        z = sum(vals[s] for s in free); rem = 1. - sum(w[s] for s in UNIVERSE if s not in free)\n        for s in free: w[s] = rem * vals[s] / max(z, 1e-12)\n    z = sum(w.values())\n    return {s: max(0., float(w[s] / z)) for s in UNIVERSE}\n\n@register_hook\ndef cross_asset_strategy():\n    global _days\n    if _days: _days -= 1; return\n    px = {}\n    for s in UNIVERSE:\n        df = get_stock_daily_data(symbol=s, days=180)\n        if df is not None and len(df) >= 70:\n            px[s] = np.nan_to_num(np.asarray(df.sort_values("date")["close"], dtype=float), nan=0., posinf=0., neginf=0.)\n    if len(px) < 12: return\n    r10, r20, r60, vol = {}, {}, {}, {}\n    for s, c in px.items():\n        d = c[1:] / np.maximum(c[:-1], 1e-12) - 1.\n        r10[s], r20[s], r60[s] = c[-1]/max(c[-11],1e-12)-1., c[-1]/max(c[-21],1e-12)-1., c[-1]/max(c[-61],1e-12)-1.\n        vol[s] = max(float(np.nanstd(d[-30:])), .008)\n    med10, med20 = np.median(list(r10.values())), np.median(list(r20.values()))\n    rev, mom, trend, down, shock, disp = ({s: 0. for s in UNIVERSE} for _ in range(6)); dispersion = max(float(np.std(list(r10.values()))), .002)\n    for s, c in px.items():\n        d = c[1:] / np.maximum(c[:-1], 1e-12) - 1.; v = vol[s]\n        rev[s] = (-.35*np.mean(d[-3:])-.65*np.mean(d[-5:]))/v\n        mom[s] = .65*(r10[s]-med10)/v + .35*(r20[s]-med20)/v\n        trend[s] = .55*r20[s]/max(np.sum(np.abs(d[-20:])),.02) + .45*r60[s]/max(np.sum(np.abs(d[-60:])),.06)\n        down[s] = r20[s]/max(float(np.std(np.minimum(d[-40:],0.))),.006)\n        shock[s] = .6*(r10[s]-med10)/v - .4*d[-1]*min(abs(d[-1])/v,2.)\n        disp[s] = -d[-1]*dispersion/v\n    rr = {k:ranks(v) for k,v in [("rev",rev),("mom",mom),("trend",trend),("down",down),("shock",shock),("disp",disp)]}\n    score = {s: sum(WEIGHTS[k]*rr[k][s] for k in WEIGHTS) for s in UNIVERSE}\n    breadth = np.mean([r20[s] > 0 for s in px]); spx = px.get("SPX"); bear = spx is not None and spx[-1] < spx[-21] and spx[-1] < spx[-6]\n    if bear or breadth < .45:\n        for s in ("XAU","US10Y","CN10Y"): score[s] += .18\n        for s in ("BTC","ETH","WTI"): score[s] -= .10\n    elif breadth > .67:\n        for s in ("SPX","NDX","SOX","000300.SH"): score[s] += .04\n    avgv = np.mean(list(vol.values())); raw = {s:max(score[s],.04)*(.9+.1*avgv/vol[s]) for s in UNIVERSE}\n    targets = cap_weights(raw); forecasts = {s: max(0., float(.05*(score[s]-.5))) for s in UNIVERSE}\n    rebalance_to_weights(targets, forecast_returns=forecasts, factor_ids=FACTOR_IDS, horizon_days=10); _days = 9\n', 'file_path': 'strategy.py'})
