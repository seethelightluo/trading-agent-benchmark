  ▶️ write_file({'content': "import numpy as np, pandas as pd\nfrom alphacrafter.sim.utils import get_index_daily_data\nU=['000300.SH','SPX','HSI','N225','SX5E','000688.SH','SOX','NDX','XAU','COPPER','WTI','BTC','ETH','US10Y','CN10Y']\nD={}\nfor s in U:\n    x=get_index_daily_data(s, days=2400)\n    if x is not None and len(x):\n        x=x.copy(); x['date']=pd.to_datetime(x['date']); x=x.sort_values('date').drop_duplicates('date').set_index('date')\n        D[s]=x['close'].astype(float)\np=pd.DataFrame(D).sort_index(); r=p.pct_change()\n# Candidate: volatility-normalized short reversal, with range/volume-independent robust denominator\n# factor high means recent losers, but dampens noisy moves: -ret(3)/sqrt(sum squared daily returns 20)\nvol=np.sqrt(r.pow(2).rolling(20).sum())\nf=-r.rolling(3).sum().div(vol.replace(0,np.nan))\n# restrict to dates with enough names; forward return is close[t+h]/close[t]-1\nfor h in [1,3,5,10]:\n    vals=[]\n    for i in range(len(p)-h):\n        dt=p.index[i]; nxt=p.index[i+h]\n        a=f.iloc[i]; y=p.iloc[i+h]/p.iloc[i]-1\n        z=pd.concat([a,y],axis=1).dropna()\n        if len(z)>=8: vals.append((dt,z.iloc[:,0].corr(z.iloc[:,1]),len(z)))\n    q=pd.DataFrame(vals,columns=['date','ic','n']).set_index('date')\n    print('H',h,'dates',len(q),'avg_n',round(q.n.mean(),2),'IC',round(q.ic.mean(),6),'ICIR',round(q.ic.mean()/q.ic.std(),6),'hit',round((q.ic>0).mean(),4))\n    if h==5:\n      for yr,g in q.groupby(q.index.year): print('YR',yr,round(g.ic.mean(),6),len(g))\n# rank turnover at 10d decision sampling\nranks=f.rank(axis=1,pct=True); sampled=ranks.iloc[::10].diff().abs().mean(axis=1).dropna()\nprint('coverage',round(f.notna().sum(axis=1).mean()/15,4),'turnover',round(sampled.mean(),4))\nprint('period',p.index.min(),p.index.max(),'n',len(p))\n", 'file_path': 'scripts/miner_2_20260730_volnorm_reversal_3d.py'})
