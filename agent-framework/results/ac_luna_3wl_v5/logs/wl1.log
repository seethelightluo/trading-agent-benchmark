  ▶️ write_file({'content': 'import numpy as np\nfrom alphacrafter.sim.utils import register_hook, get_stock_daily_data, get_index_daily_data, rebalance_to_weights\n\nUNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]\nFACTOR_IDS = ["miner_1_20260730_vix_state_reversal_5d", "miner_3_20261105_downside_risk_adjusted_momentum", "miner_3_20261119_stress_conditioned_residual_20d", "miner_2_20261217_residual_beta_volscaled_20d", "miner_3_20260730_vix_conditioned_clv_1d", "miner_3_20270128_downside_asymmetry_30d", "miner_2_20261203_drawdown_recovery_20d"]\n# Reduce unstable short-horizon reversal and overlapping residual exposure after weak live blocks.\nFACTOR_WEIGHTS = np.array([.12, .20, .14, .12, .08, .20, .14])\n_gate = 0\n\ndef rank(x, syms):\n    a = sorted((float(x[s]), s) for s in syms if np.isfinite(x.get(s, np.nan)))\n    out = {s: .5 for s in syms}\n    for i, (_, s) in enumerate(a): out[s] = (i + 1) / len(a) if a else .5\n    return out\n\ndef weights(score, vol, defensive):\n    raw = {}\n    for s in UNIVERSE:\n        tilt = 1.0\n        if defensive and s in ("XAU", "US10Y", "CN10Y"): tilt = 2.0\n        if defensive and s in ("BTC", "ETH", "WTI"): tilt = .35\n        raw[s] = max(.002, (.30 + score.get(s, .5)) * tilt / max(vol.get(s, .02), .01))\n    w = {s: raw[s] / sum(raw.values()) for s in UNIVERSE}\n    cap = .12 if defensive else .14\n    for _ in range(30):\n        fixed = {s for s in UNIVERSE if w[s] > cap}\n        if not fixed: break\n        excess = sum(w[s] - cap for s in fixed)\n        for s in fixed: w[s] = cap\n        free = [s for s in UNIVERSE if s not in fixed]\n        base = sum(w[s] for s in free)\n        for s in free: w[s] += excess * w[s] / max(base, 1e-12)\n    z = sum(w.values())\n    return {s: w[s] / z for s in UNIVERSE}\n\n@register_hook\ndef cross_asset_strategy():\n    global _gate\n    if _gate:\n        _gate -= 1\n        return\n    px, ret, vol = {}, {}, {}\n    for s in UNIVERSE:\n        df = get_stock_daily_data(symbol=s, days=230)\n        if df is None or len(df) < 80: continue\n        c = np.asarray(df.sort_values("date")["close"], dtype=float)\n        if len(c) >= 80 and np.all(np.isfinite(c)) and np.all(c > 0):\n            px[s] = c; ret[s] = c[1:] / c[:-1] - 1; vol[s] = max(float(np.std(ret[s][-30:])), .008)\n    syms = [s for s in UNIVERSE if s in px]\n    if len(syms) < 12: return\n    r5 = {s: px[s][-1] / px[s][-6] - 1 for s in syms}\n    r20 = {s: px[s][-1] / px[s][-21] - 1 for s in syms}\n    r60 = {s: px[s][-1] / px[s][-61] - 1 for s in syms}\n    breadth = np.mean([r20[s] > 0 for s in syms])\n    vix_level = 0.0; vix_jump = 0.0\n    vd = get_index_daily_data(symbol="VIX", days=35)\n    if vd is not None and len(vd) >= 22:\n        v = np.asarray(vd.sort_values("date")["close"], dtype=float)\n        vix_level = v[-1] / max(np.median(v[-21:]), 1e-9) - 1\n        vix_jump = v[-1] / max(v[-6], 1e-9) - 1\n    defensive = (r20.get("SPX", 0) < 0 and r5.get("SPX", 0) < 0) or breadth < .45 or np.mean(list(vol.values())) > .022\n    fs = [dict() for _ in FACTOR_WEIGHTS]\n    for s in syms:\n        d = ret[s]; downside = max(float(np.std(np.minimum(d[-40:], 0))), .006)\n        peer = np.mean([ret[x][-20:] for x in syms if x != s], axis=0)\n        beta = float(np.cov(d[-20:], peer)[0, 1] / max(np.var(peer), 1e-8))\n        resid = r20[s] - beta * np.median([r20[x] for x in syms if x != s])\n        fs[0][s] = -r5[s] * (1 + max(vix_level, 0)) / vol[s]\n        fs[1][s] = r20[s] / downside\n        fs[2][s] = resid / vol[s]\n        fs[3][s] = resid / max(vol[s], .01)\n        clv = (px[s][-1] - np.min(px[s][-20:])) / max(np.ptp(px[s][-20:]), 1e-9) - .5\n        fs[4][s] = clv * (1 + max(vix_jump, 0)) / vol[s]\n        fs[5][s] = (np.mean(np.maximum(d[-30:], 0)) - np.mean(np.minimum(d[-30:], 0))) / downside\n        fs[6][s] = (r20[s] - r60[s]) / vol[s]\n    score = {s: sum(w * rank(f, syms)[s] for w, f in zip(FACTOR_WEIGHTS, fs)) for s in syms}\n    # Explicit regime anchor prevents a noisy reversal composite from becoming risk-on in stress.\n    if defensive:\n        for s in ("XAU", "US10Y", "CN10Y"): score[s] = score.get(s, .5) + .18\n        for s in ("BTC", "ETH", "WTI"): score[s] = score.get(s, .5) - .12\n    target = weights(score, vol, defensive)\n    forecast = {s: max(.0001, .035 * (score.get(s, .5) - .5)) for s in UNIVERSE}\n    rebalance_to_weights(target, forecast_returns=forecast, factor_ids=FACTOR_IDS, horizon_days=10)\n    _gate = 9\n', 'file_path': 'strategy.py'})
