  ▶️ write_file({'content': 'import numpy as np\nfrom alphacrafter.sim.utils import register_hook, get_stock_daily_data, get_index_daily_data, rebalance_to_weights\n\nUNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]\nFACTOR_IDS = [\n    "miner_2_20271007_reversal5_vol40",\n    "miner_1_20271202_trend_acceleration_20d",\n    "miner_3_20261105_downside_risk_adjusted_momentum",\n    "miner_3_20261119_stress_conditioned_residual_20d",\n    "miner_2_20261217_residual_beta_volscaled_20d",\n    "miner_3_20270603_common_beta_40d",\n    "miner_1_20270325_vix_beta_penalized_momentum_20d",\n    "miner_1_20270729_compression_confirmed_trend_20d",\n]\nFACTOR_WEIGHTS = np.array([.17, .15, .14, .13, .13, .11, .10, .07])\n_days_to_rebalance = 0\n\n\ndef rank_factor(values, available):\n    good = sorted((float(values[s]), s) for s in available if np.isfinite(values.get(s, np.nan)))\n    out = {s: .5 for s in UNIVERSE}\n    for i, (_, s) in enumerate(good):\n        out[s] = (i + 1.0) / max(len(good), 1)\n    return out\n\n\ndef make_weights(score, vol, defensive):\n    raw = {}\n    for s in UNIVERSE:\n        tilt = 1.0\n        if defensive and s in ("XAU", "US10Y", "CN10Y"):\n            tilt = 1.55\n        elif defensive and s in ("BTC", "ETH", "WTI"):\n            tilt = .38\n        raw[s] = max(.015, (.70 + score[s]) ** 1.25 * tilt / max(vol.get(s, .02), .012) ** .45)\n    cap = .12 if defensive else .15\n    w = {s: raw[s] / sum(raw.values()) for s in UNIVERSE}\n    for _ in range(40):\n        over = [s for s in UNIVERSE if w[s] > cap]\n        if not over: break\n        excess = sum(w[s] - cap for s in over)\n        for s in over: w[s] = cap\n        free = [s for s in UNIVERSE if s not in over]\n        denom = sum(w[s] for s in free)\n        for s in free: w[s] += excess * w[s] / max(denom, 1e-12)\n    z = sum(w.values())\n    return {s: max(0., w[s] / z) for s in UNIVERSE}\n\n\n@register_hook\ndef cross_asset_strategy():\n    global _days_to_rebalance\n    if _days_to_rebalance:\n        _days_to_rebalance -= 1\n        return\n    closes, rets, vols = {}, {}, {}\n    for s in UNIVERSE:\n        df = get_stock_daily_data(symbol=s, days=230)\n        if df is None or len(df) < 80: continue\n        c = np.asarray(df.sort_values("date")["close"], dtype=float)\n        if len(c) >= 65 and np.all(np.isfinite(c)) and np.all(c > 0):\n            closes[s] = c; rets[s] = c[1:] / c[:-1] - 1.\n            vols[s] = max(float(np.std(rets[s][-30:])), .008)\n    available = [s for s in UNIVERSE if s in closes]\n    if len(available) < 12: return\n    r5 = {s: closes[s][-1] / closes[s][-6] - 1. for s in available}\n    r20 = {s: closes[s][-1] / closes[s][-21] - 1. for s in available}\n    r40 = {s: closes[s][-1] / closes[s][-41] - 1. for s in available}\n    r60 = {s: closes[s][-1] / closes[s][-61] - 1. for s in available}\n    peer = np.mean([rets[s][-20:] for s in available], axis=0)\n    vix_state = 0.\n    vd = get_index_daily_data(symbol="VIX", days=45)\n    if vd is not None and len(vd) >= 22:\n        vc = np.asarray(vd.sort_values("date")["close"], dtype=float)\n        vix_state = vc[-1] / max(float(np.median(vc[-21:])), 1e-9) - 1.\n    breadth = np.mean([r20[s] > 0 for s in available])\n    market = r20.get("SPX", float(np.median(list(r20.values()))))\n    defensive = market < 0 or breadth < .45 or np.mean(list(vols.values())) > .022 or vix_state > .15\n    factors = [dict() for _ in FACTOR_IDS]\n    for s in available:\n        d = rets[s]\n        downside = max(float(np.std(np.minimum(d[-40:], 0.))), .006)\n        beta = float(np.cov(d[-20:], peer)[0, 1] / max(np.var(peer), 1e-8))\n        peer20 = np.median([r20[x] for x in available if x != s])\n        residual = r20[s] - beta * peer20\n        shortvol = max(float(np.std(d[-10:])), .006)\n        # reversal, trend acceleration, downside momentum, stress residual,\n        # residual-beta momentum, common beta, VIX-beta momentum, compression trend\n        factors[0][s] = -r5[s] / shortvol\n        factors[1][s] = (r20[s] - r40[s] / 2.) / max(vols[s], .01)\n        factors[2][s] = r20[s] / downside\n        factors[3][s] = residual * (1. + .5 * max(vix_state, 0.))\n        factors[4][s] = residual / max(vols[s] * (1. + abs(beta)), .01)\n        factors[5][s] = (-beta if defensive else beta) + .25 * r40[s] / max(vols[s], .01)\n        factors[6][s] = r20[s] / max(vols[s] * (1. + max(beta, 0.) * max(vix_state, 0.)), .01)\n        factors[7][s] = (r20[s] - .5 * r60[s]) / max(vols[s] * (1. + abs(beta)), .01)\n    ranks = [rank_factor(x, available) for x in factors]\n    score = {s: sum(w * q[s] for w, q in zip(FACTOR_WEIGHTS, ranks)) for s in UNIVERSE}\n    if defensive:\n        for s in ("XAU", "US10Y", "CN10Y"): score[s] += .075\n        for s in ("BTC", "ETH", "WTI"): score[s] -= .06\n    target = make_weights(score, vols, defensive)\n    forecast = {s: .012 * (score[s] - .5) for s in UNIVERSE}\n    rebalance_to_weights(target, forecast_returns=forecast, factor_ids=FACTOR_IDS, horizon_days=10)\n    _days_to_rebalance = 9\n\nassert len(UNIVERSE) == 15 and len(FACTOR_IDS) <= 10\nassert not set(UNIVERSE).intersection({"DXY", "USDCNY", "USDJPY", "EURUSD", "VIX"})\nassert abs(sum(make_weights({s: .5 for s in UNIVERSE}, {}, True).values()) - 1.) < 1e-8\n', 'file_path': 'strategy.py'})
