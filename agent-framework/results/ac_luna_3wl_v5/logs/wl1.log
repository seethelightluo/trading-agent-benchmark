  ▶️ write_file({'content': "import numpy as np, pandas as pd\nfrom alphacrafter.sim.utils import get_stock_daily_data\nU=['000300.SH','SPX','HSI','N225','SX5E','000688.SH','SOX','NDX','XAU','COPPER','WTI','BTC','ETH','US10Y','CN10Y']\n# Novel candidate: volatility-of-volatility conditioned trend. Trend is 20d return / 20d vol,\n# multiplied by a persistence ratio (recent 10d vol / prior 10d vol), clipped: favors trends\n# whose volatility is stable/falling, avoiding unstable breakouts.\nD={}\nfor s in U:\n d=get_stock_daily_data(symbol=s,days=310)\n if d is not None:\n  d=d.sort_values('date'); c=np.asarray(d.close,float); r=c[1:]/c[:-1]-1\n  if len(c)>100: D[s]=(d.date.iloc[1:].values,r,c[1:])\ncommon=max((x[0][0] for x in D.values()),default=None)\n# align by date using maps\nmaps={s:{pd.Timestamp(dt): (float(r[i]),float(c[i])) for i,dt in enumerate(x[0])} for s,x in D.items()}\ndates=sorted(set.intersection(*[set(m.keys()) for m in maps.values()])) if len(maps)==15 else []\nics={5:[],10:[],20:[]}; turns=[]; cov=[]; sigrows=[]\nprev=None\nfor j,dt in enumerate(dates):\n if j<65: continue\n vals={}; fw={h:{} for h in ics}\n for s,m in maps.items():\n  hist=[m[dates[k]][0] for k in range(j-65,j+1)]\n  px=[m[dates[k]][1] for k in range(j-65,j+1)]\n  r20=px[-1]/px[-21]-1; v20=np.std(hist[-20:]); v20=max(v20,.002)\n  recent=np.std(hist[-10:]); prior=np.std(hist[-20:-10]); persist=np.clip(prior/max(recent,.002),.5,1.5)\n  vals[s]=(r20/v20)*persist\n  for h in ics: fw[h][s]=m[dates[j+h]][1]/px[-1]-1 if j+h<len(dates) else np.nan\n good=[s for s,v in vals.items() if np.isfinite(v)]\n if len(good)>=8:\n  for h in ics:\n   pairs=[(vals[s],fw[h][s]) for s in good if np.isfinite(fw[h][s])]\n   if len(pairs)>=8: ics[h].append(pd.Series([x[0] for x in pairs]).corr(pd.Series([x[1] for x in pairs]),method='spearman'))\n  ranks=pd.Series(vals).rank(pct=True); turns.append(np.mean(np.abs(ranks-(prev if prev is not None else ranks)))) ; prev=ranks\n  cov.append(len(good)/15)\n  if len(sigrows)<1: sigrows.append((dt,vals))\nprint('dates',len(dates),'usable',len(cov),'avgN',np.mean([15 for _ in cov]),'coverage',np.mean(cov),'turnover',np.mean(turns))\nfor h,a in ics.items():\n a=np.array(a); print(h,'IC',np.nanmean(a),'ICIR',np.nanmean(a)/np.nanstd(a,ddof=1),'hit',np.mean(a>0),'n',len(a))\nfor label,mask in [('2026+', [pd.Timestamp(x)>=pd.Timestamp('2026-01-01') for x in dates[65:]]),('2027+', [pd.Timestamp(x)>=pd.Timestamp('2027-01-01') for x in dates[65:]]),('2028YTD',[pd.Timestamp(x)>=pd.Timestamp('2028-01-01') for x in dates[65:]])]:\n print(label)\n for h,a in ics.items():\n  # alignment excludes future tail; approximate use date index and truncate corresponding h\n  aa=np.array(a); mm=np.array(mask[:len(aa)])\n  z=aa[mm]; print(h,round(np.nanmean(z),6),round(np.nanmean(z)/np.nanstd(z,ddof=1),6),len(z))\n# signal artifact (all dates/symbol values) regenerate compact\nrows=[]\nfor dt in dates[65:-20]:\n j=dates.index(dt); row={'date':str(dt)}\n for s,m in maps.items():\n  hist=[m[dates[k]][0] for k in range(j-65,j+1)]; px=[m[dates[k]][1] for k in range(j-65,j+1)]\n  row[s]=(px[-1]/px[-21]-1)/max(np.std(hist[-20:]),.002)*np.clip(np.std(hist[-20:-10])/max(np.std(hist[-10:]),.002),.5,1.5)\n rows.append(row)\npd.DataFrame(rows).to_csv('scripts/miner_1_20280629_stable_voltrend_signal.csv',index=False)\n", 'file_path': 'scripts/miner_1_20280629_stable_voltrend.py'})

