sal factor is used.\n        factors[0][s] = r20[s] / downside\n        factors[1][s] = residual / max(vol[s] * (1 + abs(beta)), .01)\n        factors[2][s] = residual * (1 + .7 * max(vix, 0))\n        factors[3][s] = r20[s] / max(vol[s] * (1 + max(beta, 0) * max(vix, 0)), .01)\n        factors[4][s] = r20[s] * (1 + max(vix, 0)) / max(vol[s], .01)\n        factors[5][s] = (-beta if stress else beta) + .15 * r40[s] / max(vol[s], .01)\n        factors[6][s] = (r20[s] - r40[s] / 2) / max(vol[s], .01)\n        factors[7][s] = r20[s] / max(vol[s], .01) if r20[s] * r40[s] > 0 else .5 * r20[s] / max(vol[s], .01)\n    ranks = [rank_cs(f, names) for f in factors]\n    score = {s: sum(w * q[s] for w, q in zip(FACTOR_WEIGHTS, ranks)) for s in UNIVERSE}\n    if stress:\n        for s, a in (("XAU", .22), ("US10Y", .18), ("CN10Y", .14)):\n            score[s] += a\n        for s in ("BTC", "ETH", "WTI", "COPPER"): score[s] -= .18\n    target = capped_weights(score, vol, stress)\n    account = get_account_dict(); assets = max(float(account.get("total_assets", 0)), 1.0)\n    old = {s: 0.0 for s in UNIVERSE}\n    for p in account.get("positions", []):\n        s = p.get("symbol")\n        if s in old and p.get("quantity", 0) > 0: old[s] = max(float(p.get("market_value", 0)), 0) / assets\n    if sum(old.values()) > .05:\n        z = sum(old.values()); old = {s: old[s] / z for s in UNIVERSE}\n        target = {s: .25 * target[s] + .75 * old[s] for s in UNIVERSE}\n    z = sum(target.values()); target = {s: max(0, target[s] / z) for s in UNIVERSE}\n    forecast = {s: .004 * (score[s] - .5) for s in UNIVERSE}\n    rebalance_to_weights(target, forecast_returns=forecast, factor_ids=FACTOR_IDS, horizon_days=10)\n    _days_to_rebalance = 9\n\nassert len(UNIVERSE) == 15 and len(FACTOR_IDS) <= 10\nassert not set(UNIVERSE).intersection({"DXY", "USDCNY", "USDJPY", "EURUSD", "VIX"})\n', 'file_path': 'strategy.py'})
