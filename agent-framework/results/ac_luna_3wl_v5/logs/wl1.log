  ▶️ write_file({'content': 'import numpy as np\nfrom alphacrafter.sim.utils import (register_hook, get_stock_daily_data,\n    get_index_daily_data, get_account_dict, rebalance_to_weights)\n\nUNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]\nFACTOR_IDS = [\n    "miner_1_20281116_defensive_relative_lead_20d",\n    "miner_3_20290628_residual_momentum_volscaled_20",\n    "miner_3_20280907_downside_asymmetry_quality_30d",\n    "breadth_vol_quality_40d",\n    "miner_1_20281005_vix_shock_resilient_momentum_20d",\n    "miner_1_20280629_stable_volatility_trend_20d",\n    "downside_persistence_quality_20_30",\n    "miner_3_20290712_residual_momentum_volscaled_40",\n]\nFACTOR_WEIGHTS = np.array([.22, .20, .16, .15, .08, .07, .07, .05])\n_gate = 0\n\n\ndef rank(x, names):\n    good = sorted((float(x[s]), s) for s in names if np.isfinite(x.get(s, np.nan)))\n    out = {s: .5 for s in UNIVERSE}\n    for i, (_, s) in enumerate(good):\n        out[s] = (i + 1.0) / len(good)\n    return out\n\n\ndef capped_weights(score, vol, stress):\n    tilt = {s: 1.0 for s in UNIVERSE}\n    if stress:\n        tilt.update({"XAU": 2.7, "US10Y": 2.25, "CN10Y": 2.05,\n                     "BTC": .25, "ETH": .25, "WTI": .55, "COPPER": .62})\n    raw = {s: tilt[s] * (.25 + score[s]) / max(vol.get(s, .02), .008) ** .30 for s in UNIVERSE}\n    cap = .16 if stress else .19\n    w = {s: max(raw[s], .001) for s in UNIVERSE}\n    # Iterative capped redistribution keeps the complete portfolio invested.\n    for _ in range(20):\n        over = [s for s in UNIVERSE if w[s] > cap]\n        if not over:\n            break\n        excess = sum(w[s] - cap for s in over)\n        for s in over:\n            w[s] = cap\n        free = [s for s in UNIVERSE if s not in over]\n        z = sum(w[s] for s in free)\n        if not free or z <= 0:\n            break\n        for s in free:\n            w[s] += excess * w[s] / z\n    z = sum(w.values())\n    return {s: w[s] / max(z, 1e-12) for s in UNIVERSE}\n\n\n@register_hook\ndef cross_asset_strategy():\n    global _gate\n    if _gate:\n        _gate -= 1\n        return\n    close, daily, vol = {}, {}, {}\n    for s in UNIVERSE:\n        df = get_stock_daily_data(symbol=s, days=280)\n        if df is None or len(df) < 100:\n            continue\n        c = np.asarray(df.sort_values("date")["close"], dtype=float)[:-1]\n        if len(c) >= 80 and np.all(np.isfinite(c)) and np.all(c > 0):\n            close[s] = c\n            daily[s] = c[1:] / c[:-1] - 1.0\n            vol[s] = max(float(np.std(daily[s][-40:])), .008)\n    names = [s for s in UNIVERSE if s in close]\n    if len(names) < 12:\n        return\n    ret = {s: {k: close[s][-1] / close[s][-(k + 1)] - 1.0 for k in (10, 20, 30, 40)} for s in names}\n    peer = np.mean([daily[s][-20:] for s in names], axis=0)\n    breadth = np.mean([ret[s][20] > 0 for s in names])\n    market20 = ret.get("SPX", {20: np.median([ret[s][20] for s in names])})[20]\n    vlevel, vx = 0.0, 0.0\n    vd = get_index_daily_data(symbol="VIX", days=55)\n    if vd is not None and len(vd) >= 23:\n        vc = np.asarray(vd.sort_values("date")["close"], dtype=float)[:-1]\n        if len(vc) >= 22 and np.all(np.isfinite(vc)):\n            vlevel = float(vc[-1]); vx = vlevel / max(float(np.median(vc[-21:])), 1e-9) - 1.0\n    stress = market20 < -.05 or breadth < .40 or np.mean(list(vol.values())) > .022 or vx > .15 or vlevel >= 20.0\n\n    fs = [{} for _ in FACTOR_IDS]\n    for s in names:\n        d = daily[s]\n        peer20 = np.median([ret[t][20] for t in names if t != s])\n        peer40 = np.median([ret[t][40] for t in names if t != s])\n        beta = float(np.cov(d[-20:], peer)[0, 1] / max(np.var(peer), 1e-8))\n        r20 = (ret[s][20] - beta * peer20) / max(vol[s], .01)\n        r40 = (ret[s][40] - beta * peer40) / max(vol[s], .01)\n        neg = d[-30:][d[-30:] < 0]\n        downside = max(float(np.std(neg)) if len(neg) > 2 else .01, .006)\n        downmean = float(np.mean(neg)) if len(neg) else 0.0\n        path = max(float(np.sum(np.abs(d[-30:]))), .01)\n        fs[0][s] = ret[s][20] - peer20\n        fs[1][s] = r20\n        fs[2][s] = (ret[s][30] - beta * np.median([ret[t][30] for t in names if t != s])) / downside - downmean / downside\n        fs[3][s] = (.45 * ret[s][40] + .35 * ret[s][20] + .20 * ret[s][10]) / max(vol[s], .01)\n        fs[4][s] = r20 * (1.0 + max(vx, 0.0))\n        fs[5][s] = (.5 * ret[s][20] + .5 * ret[s][40]) / max(vol[s], .01) ** .75\n        fs[6][s] = (.55 * ret[s][20] + .45 * ret[s][40]) / downside\n        fs[7][s] = r40\n    ranks = [rank(f, names) for f in fs]\n    score = {s: sum(w * r[s] for w, r in zip(FACTOR_WEIGHTS, ranks)) for s in UNIVERSE}\n    if stress:\n        for s, a in (("XAU", .10), ("US10Y", .08), ("CN10Y", .06)):\n            score[s] += a\n        for s in ("BTC", "ETH", "WTI", "COPPER"):\n            score[s] -= .045\n    target = capped_weights(score, vol, stress)\n\n    account = get_account_dict()\n    assets = max(float(account.get("total_assets", 0.0)), 1.0)\n    old = {s: 0.0 for s in UNIVERSE}\n    for p in account.get("positions", []):\n        s = p.get("symbol")\n        if s in old and float(p.get("quantity", 0)) > 0:\n            old[s] = max(float(p.get("market_value", 0.0)), 0.0) / assets\n    if sum(old.values()) > .001:\n        target = {s: (.40 * target[s] + .60 * old[s]) for s in UNIVERSE}\n        z = sum(target.values()); target = {s: target[s] / z for s in UNIVERSE}\n    forecast = {s: .01 * (score[s] - .5) for s in UNIVERSE}\n    rebalance_to_weights(target, forecast_returns=forecast, factor_ids=FACTOR_IDS, horizon_days=10)\n    _gate = 9\n\ncross_asset_strategy\n', 'file_path': 'strategy.py'})
