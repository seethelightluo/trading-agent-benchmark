 import numpy as np
from alphacrafter.sim.utils import register_hook, get_stock_daily_data, get_index_daily_data, rebalance_to_weights

UNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
FACTOR_IDS = [
    "miner_2_20261217_residual_beta_volscaled_20d",
    "miner_3_20261105_downside_risk_adjusted_momentum",
    "miner_1_20260730_vix_state_reversal_5d",
    "miner_3_20261119_stress_conditioned_residual_20d",
    "miner_2_20261203_drawdown_recovery_20d",
    "miner_3_20260730_shock_exhaustion_range_weighted_reversal_1d",
    "miner_3_20260730_vix_conditioned_clv_1d",
]
FACTOR_W = np.array([.20, .18, .15, .12, .10, .13, .12])
_gate = 0


def _rank(values, symbols):
    good = sorted((float(v), s) for s, v in values.items() if np.isfinite(v))
    out = {s: .5 for s in symbols}
    n = len(good)
    for i, (_, s) in enumerate(good):
        out[s] = (i + 1.0) / n
    return out


def _make_weights(score, vol, defensive):
    raw = {}
    for s in UNIVERSE:
        tilt = 1.0
        if defensive and s in ("XAU", "US10Y", "CN10Y"):
            tilt = 1.60
        elif defensive and s in ("BTC", "ETH", "WTI"):
            tilt = .42
        raw[s] = max(.0005, (.40 + score.get(s, .5)) * tilt / max(vol.get(s, .02), .009))
    w = {s: x / sum(raw.values()) for s, x in raw.items()}
    cap = .12 if defensive else .14
    for _ in range(40):
        excess = sum(max(0., x - cap) for x in w.values())
        if excess < 1e-10:
            break
        free = [s for s in UNIVERSE if w[s] < cap - 1e-12]
        for s in UNIVERSE:
            w[s] = min(w[s], cap)
        base = sum(w[s] for s in free)
        for s in free:
            w[s] += excess * w[s] / max(base, 1e-12)
    total = sum(w.values())
    return {s: max(0., w[s] / total) for s in UNIVERSE}


@register_hook
def cross_asset_strategy():
    global _gate
    if _gate:
        _gate -= 1
        return
    prices, frames = {}, {}
    for s in UNIVERSE:
        df = get_stock_daily_data(symbol=s, days=230)
        if df is None or len(df) < 80:
            continue
        df = df.sort_values("date").reset_index(drop=True)
        c = np.asarray(df["close"], dtype=float)
        if np.all(np.isfinite(c)) and np.all(c > 0):
            prices[s], frames[s] = c, df
    symbols = [s for s in UNIVERSE if s in prices]
    if len(symbols) < 12:
        return
    daily = {s: prices[s][1:] / prices[s][:-1] - 1.0 for s in symbols}
    r5 = {s: prices[s][-1] / prices[s][-6] - 1. for s in symbols}
    r20 = {s: prices[s][-1] / prices[s][-21] - 1. for s in symbols}
    r60 = {s: prices[s][-1] / prices[s][-61] - 1. for s in symbols}
    vol = {s: max(float(np.std(daily[s][-30:])), .008) for s in symbols}
    peer = {s: np.median([r20[x] for x in symbols if x != s]) for s in symbols}
    dispersion = max(np.std(list(r20.values())), .005)
    breadth = np.mean([r20[s] > 0 for s in symbols])
    defensive = (r20.get("SPX", 0.) < 0 and r5.get("SPX", 0.) < 0) or breadth < .45 or np.mean(list(vol.values())) > .022
    # Observation-only VIX is used only as a state variable, never as a target.
    vix = get_index_daily_data(symbol="VIX", days=35)
    vix_level = 0.; vix_jump = 0.
    if vix is not None and len(vix) >= 7:
        vc = np.asarray(vix.sort_values("date")["close"], dtype=float)
        vix_level = vc[-1] / max(np.median(vc[-21:]), 1e-9) - 1.
        vix_jump = vc[-1] / max(vc[-6], 1e-9) - 1.
    stress = min(2.0, max(.5, dispersion / .025))
    f = [{} for _ in FACTOR_W]
    for s in symbols:
        d, v = daily[s], vol[s]
        downside = max(float(np.std(np.minimum(d[-40:], 0.))), .006)
        path = max(float(np.sum(np.abs(d[-20:]))), .03)
        peak = max(prices[s][-61:-1])
        high = float(frames[s]["high"].iloc[-1]); low = float(frames[s]["low"].iloc[-1])
        clv = (prices[s][-1] - low) / max(high - low, 1e-9) - .5
        beta = np.cov(d[-20:], np.array([daily[x][-20:] for x in symbols if x != s]).mean(axis=0))[0, 1] / max(np.var(np.array([daily[x][-20:] for x in symbols if x != s]).mean(axis=0)), 1e-8)
        residual = r20[s] - beta * np.mean([r20[x] for x in symbols if x != s])
        f[0][s] = residual / v
        f[1][s] = r20[s] / downside
        f[2][s] = -r5[s] * (1. + max(vix_level, 0.)) / v
        f[3][s] = stress * (r20[s] - peer[s]) / v
        f[4][s] = (prices[s][-1] / peak - 1.) / v
        shock = float(np.min(d[-6:-1]))
        f[5][s] = (-shock if shock < 0 else -abs(d[-1])) / v
        f[6][s] = clv * (1. + max(vix_jump, 0.)) / v
    score = {s: sum(w * _rank(x, symbols)[s] for w, x in zip(FACTOR_W, f)) for s in symbols}
    targets = _make_weights(score, vol, defensive)
    forecasts = {s: max(.0001, .04 * (score.get(s, .5) - .5)) for s in UNIVERSE}
    rebalance_to_weights(targets, forecast_returns=forecasts, factor_ids=FACTOR_IDS, horizon_days=10)
    _gate = 9


