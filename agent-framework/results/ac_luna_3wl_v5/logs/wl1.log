f=(r.rolling(20,min_periods=10).sum()/vol).shift(1); f=f.sub(f.mean(axis=1),axis=0)
print('factor vol_adjusted_momentum_20_40 universe',len(U),'dates',len(px),'cutoff',px.index.max().date())
for h in [5,10,20]:
 I=[];N=[];D=[]
 for i in range(len(px)-h):
