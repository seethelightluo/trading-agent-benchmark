IVERSE}\n\n\n@register_hook\ndef cross_asset_strategy():\n    global _gate\n    if _gate:\n        _gate -= 1\n        return\n    close, high, low, ret = {}, {}, {}, {}\n    for s in UNIVERSE:\n        df = get_stock_daily_data(symbol=s, days=230)\n        if df is None or len(df) < 80: continue\n        df = df.sort_values("date")\n        c = np.asarray(df["close"], dtype=float)\n        if np.all(np.isfinite(c)) and np.all(c > 0):\n            close[s] = c; high[s] = float(df["high"].iloc[-1]); low[s] = float(df["low"].iloc[-1])\n            ret[s] = c[1:] / c[:-1] - 1.\n    symbols = [s for s in UNIVERSE if s in close]\n    if len(symbols) < 12: return\n    r5 = {s: close[s][-1] / close[s][-6] - 1. for s in symbols}\n    r20 = {s: close[s][-1] / close[s][-21] - 1. for s in symbols}\n    r60 = {s: close[s][-1] / close[s][-61] - 1. for s in symbols}\n    vol = {s: max(float(np.std(ret[s][-30:])), .008) for s in symbols}\n    peer20 = {s: np.median([r20[x] for x in symbols if x != s]) for s in symbols}\n    dispersion = max(float(np.std(list(r20.values()))), .005)\n    breadth = float(np.mean([r20[s] > 0 for s in symbols]))\n    vix_level = vix_jump = 0.\n    vix = get_index_daily_data(symbol="VIX", days=35)\n    if vix is not None and len(vix) >= 22:\n        vc = np.asarray(vix.sort_values("date")["close"], dtype=float)\n        vix_level = vc[-1] / max(np.median(vc[-21:]), 1e-9) - 1.\n        vix_jump = vc[-1] / max(vc[-6], 1e-9) - 1.\n    defensive = (r20.get("SPX", 0) < 0 and r5.get("SPX", 0) < 0) or breadth < .45 or np.mean(list(vol.values())) > .022\n    stress = min(2., max(.5, dispersion / .025))\n    fs = [{} for _ in FACTOR_W]\n    for s in symbols:\n        d, v = ret[s], vol[s]\n        downside = max(float(np.std(np.minimum(d[-40:], 0))), .006)\n        peer_ret = np.mean([ret[x][-20:] for x in symbols if x != s], axis=0)\n        beta = float(np.cov(d[-20:], peer_ret)[0, 1] / max(np.var(peer_ret), 1e-8))\n        residual = r20[s] - beta * peer20[s]\n        clv = (close[s][-1] - low[s]) / max(high[s] - low[s], 1e-9) - .5\n        peak = max(close[s][-61:-1])\n        shock = float(np.min(d[-6:-1]))\n        # Directions follow the persisted ensemble; all signals are lag-safe.\n        fs[0][s] = -r5[s] * (1. + max(vix_level, 0.)) / v\n        fs[1][s] = r20[s] / downside\n        fs[2][s] = stress * residual / v\n        fs[3][s] = residual / v\n        fs[4][s] = (-shock if shock < 0 else -abs(d[-1])) / v\n        fs[5][s] = clv * (1. + max(vix_jump, 0.)) / v\n        fs[6][s] = (r20[s] - beta * peer20[s]) / v\n        fs[7][s] = (close[s][-1] / peak - 1.) / v\n    score = {s: sum(w * ranker(f, symbols)[s] for w, f in zip(FACTOR_W, fs)) for s in symbols}\n    targets = make_targets(score, vol, defensive)\n    forecasts = {s: max(.0001, .04 * (score.get(s, .5) - .5)) for s in UNIVERSE}\n    rebalance_to_weights(targets, forecast_returns=forecasts, factor_ids=FACTOR_IDS, horizon_days=10)\n    _gate = 9\n', 'file_path': 'strategy.py'})
