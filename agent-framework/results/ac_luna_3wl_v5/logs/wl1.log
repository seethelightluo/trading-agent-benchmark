 import numpy as np
from alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights

UNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
FACTOR_IDS = [
    "miner_3_20260827_momentum_acceleration_20d_20d",
    "miner_1_20260730_vix_state_reversal_5d",
    "miner_2_20260730_volscaled_momentum_cycle_20d",
    "miner_1_20260813_downside_sortino_momentum_20d",
    "miner_1_20260827_medium_downside_momentum_30d",
    "miner_1_20260730_residual_vol_scaled_momentum_10d",
    "miner_3_20260730_trend_efficiency_10d",
    "miner_2_20260827_path_consistency_momentum_20d",
    "miner_1_20260730_downside_quality_momentum_10d",
    "miner_1_20260730_residual_shock_blend_10d",
]
W = dict(accel=.18, reversal=.14, cycle=.13, sortino=.11, medium=.10,
         residual=.09, efficiency=.08, path=.07, quality=.06, shock=.04)
_day_gate = 0

def ranks(x):
    good = sorted((s, v) for s, v in x.items() if np.isfinite(v))
    out = {s: .5 for s in UNIVERSE}
    for i, (s, _) in enumerate(good):
        out[s] = (i + 1.0) / max(1, len(good))
    return out

def make_weights(score):
    # Full-investment, long-only, modest 2.5%-14% bounds for a 15-asset universe.
    lo, hi = .025, .14
    raw = {s: max(.08, score.get(s, .5)) for s in UNIVERSE}
    w = {s: lo + (hi - lo) * raw[s] / max(raw.values()) for s in UNIVERSE}
    for _ in range(30):
        over = [s for s in UNIVERSE if w[s] > hi]
        if not over:
            break
        w = {s: min(hi, w[s]) for s in UNIVERSE}
        rem = 1.0 - sum(w.values())
        eligible = [s for s in UNIVERSE if w[s] < hi - 1e-12]
        z = sum(raw[s] for s in eligible)
        for s in eligible:
            w[s] += rem * raw[s] / max(z, 1e-12)
    z = sum(w.values())
    return {s: max(0., float(w[s] / z)) for s in UNIVERSE}

@register_hook
def cross_asset_strategy():
    global _day_gate
    if _day_gate:
        _day_gate -= 1
        return
    px = {}
    for s in UNIVERSE:
        df = get_stock_daily_data(symbol=s, days=190)
        if df is None or len(df) < 70:
            continue
        c = np.asarray(df.sort_values("date")["close"], dtype=float)
        if np.all(np.isfinite(c)) and np.all(c > 0):
            px[s] = c
    if len(px) < 12:
        return
    rr = {s: px[s][1:] / px[s][:-1] - 1. for s in px}
    r5 = {s: px[s][-1] / px[s][-6:] [0] - 1. for s in px}
    r10 = {s: px[s][-1] / px[s][-11] - 1. for s in px}
    r20 = {s: px[s][-1] / px[s][-21] - 1. for s in px}
    r30 = {s: px[s][-1] / px[s][-31] - 1. for s in px}
    r40 = {s: px[s][-1] / px[s][-41] - 1. for s in px}
    r60 = {s: px[s][-1] / px[s][-61] - 1. for s in px}
    vol = {s: max(np.std(rr[s][-30:]), .008) for s in px}
    med10, med20 = np.median(list(r10.values())), np.median(list(r20.values()))
    f = {k: {} for k in W}
    for s in px:
        d, v = rr[s], vol[s]
        down = max(np.std(np.minimum(d[-40:], 0.)), .006)
        path = r20[s] * (np.mean(np.sign(d[-20:])) + 1.) / 2.
        f['accel'][s] = (r20[s] - r40[s]) / v
        f['reversal'][s] = (-.65*np.mean(d[-5:]) - .35*np.mean(d[-2:])) / v
        f['cycle'][s] = (.65*r20[s] + .35*r60[s]) / v
        f['sortino'][s] = r20[s] / down
        f['medium'][s] = r30[s] / max(np.std(np.minimum(d[-60:], 0.)), .006)
        f['residual'][s] = (r10[s] - med10) / v
        f['efficiency'][s] = r10[s] / max(np.sum(np.abs(d[-10:])), .02)
        f['path'][s] = path / v
        f['quality'][s] = r20[s] / max(np.std(np.minimum(d[-30:], 0.)), .006)
        f['shock'][s] = .6*(r10[s]-med10)/v - .4*d[-1]*min(abs(d[-1])/v, 2.)
    score = {s: sum(W[k] * ranks(f[k])[s] for k in W) for s in UNIVERSE}
    breadth = np.mean([r20[s] > 0 for s in px])
    spx = px.get('SPX')
    bear = spx is not None and spx[-1] < spx[-21] and spx[-1] < spx[-6]
    if bear or breadth < .45:
        for s in ('XAU', 'US10Y', 'CN10Y'):
            score[s] += .16
        for s in ('BTC', 'ETH', 'WTI'):
            score[s] -= .08
    # Inverse volatility is only a sizing overlay; all 15 targets remain funded.
    avgvol = np.mean(list(vol.values()))
    score = {s: max(.05, score[s]) * (.9 + .1 * avgvol / vol[s]) for s in UNIVERSE}
    targets = make_weights(score)
    forecasts = {s: max(0., .04 * (score[s] - .5)) for s in UNIVERSE}
    rebalance_to_weights(targets, forecast_returns=forecasts, factor_ids=FACTOR_IDS, horizon_days=10)
    _day_gate = 9


