 import numpy as np
from alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights

UNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
# Screener ensemble (10 factors; weights sum to one).
FACTOR_WEIGHTS = {"vix": .16, "clv": .10, "rvolmom": .14, "trend": .14,
                  "resid": .11, "downmom": .09, "path": .11, "shock": .07,
                  "disp": .05, "highvol": .03}
FACTOR_IDS = [
    "miner_1_20260730_vix_state_reversal_5d",
    "miner_3_20260730_vix_conditioned_clv_1d",
    "miner_1_20260730_residual_vol_scaled_momentum_10d",
    "miner_3_20260730_trend_efficiency_10d",
    "miner_2_20260730_residual_momentum_10d",
    "miner_1_20260730_downside_quality_momentum_10d",
    "miner_1_20260730_path_efficiency_10d",
    "miner_1_20260730_residual_shock_blend_10d",
    "miner_1_20260730_dispersion_conditioned_reversal_1d",
    "miner_2_20260730_highvol_reversal_1d",
]
_decided = False

def rank_factor(values):
    good = sorted((s, v) for s, v in values.items() if np.isfinite(v))
    out = {s: .5 for s in UNIVERSE}
    for i, (s, _) in enumerate(good):
        out[s] = (i + 1.0) / max(len(good), 1)
    return out

def bounded_weights(raw):
    # Apply 1.5%-16% bounds and renormalize, retaining exact full investment.
    w = {s: max(float(raw.get(s, 1/15)), .015) for s in UNIVERSE}
    for _ in range(30):
        capped = {s for s in UNIVERSE if w[s] > .16}
        for s in capped: w[s] = .16
        free = [s for s in UNIVERSE if s not in capped]
        if not free: break
        remainder = 1.0 - sum(w[s] for s in capped)
        scale = remainder / sum(w[s] for s in free)
        for s in free: w[s] *= scale
        if not any(w[s] > .1600001 for s in free): break
    total = sum(w.values())
    return {s: w[s] / total for s in UNIVERSE}

@register_hook
def cross_asset_strategy():
    global _decided
    # One proposal per 10-trading-day block; preserve the prior target otherwise.
    if _decided:
        return
    prices = {}
    for s in UNIVERSE:
        df = get_stock_daily_data(symbol=s, days=150)
        if df is not None and len(df) >= 45:
            prices[s] = np.asarray(df.sort_values("date")["close"], dtype=float)
    if len(prices) < 12:
        return

    ret10 = {s: c[-1] / max(c[-11], 1e-12) - 1.0 for s, c in prices.items()}
    median10 = float(np.median(list(ret10.values())))
    factors = {k: {} for k in FACTOR_WEIGHTS}
    vols = {}
    dispersion = max(float(np.std(list(ret10.values()))), .001)
    for s, c in prices.items():
        d = c[1:] / np.maximum(c[:-1], 1e-12) - 1.0
        vol = max(float(np.std(d[-20:])), .008)
        vols[s] = vol
        last = float(d[-1]); rev5 = -float(np.mean(d[-5:]))
        factors["vix"][s] = rev5 * np.clip(vol/.018, .5, 2.)
        factors["clv"][s] = -.65*last*np.clip(vol/.018, .5, 2.) - .35*rev5
        factors["rvolmom"][s] = (ret10[s] - median10) / vol
        # Trend efficiency is directional return divided by total path length.
        factors["trend"][s] = ret10[s] / max(float(np.sum(np.abs(d[-10:]))), .01)
        factors["resid"][s] = ret10[s] - median10
        downside = max(float(np.std(np.minimum(d[-30:], 0.))), .006)
        factors["downmom"][s] = (c[-1]/max(c[-21], 1e-12)-1.) / downside
        factors["path"][s] = factors["trend"][s]
        shock = -last*np.clip(abs(last)/(vol+.002), 0., 3.)
        factors["shock"][s] = .6*(ret10[s]-median10) + .4*shock
        factors["disp"][s] = -last*dispersion/max(vol, .008)
        factors["highvol"][s] = rev5*np.clip(vol/.020, .5, 2.5)

    score = {s: sum(FACTOR_WEIGHTS[k] * rank_factor(factors[k])[s]
                    for k in FACTOR_WEIGHTS) for s in UNIVERSE}
    breadth = float(np.mean([c[-1] > c[-21] for c in prices.values()]))
    spx = prices.get("SPX")
    bear = spx is not None and spx[-1] < spx[-21] and spx[-1] < spx[-6]
    if bear or breadth < .40:
        for s in ("XAU", "US10Y", "CN10Y"): score[s] += .12
        for s in ("BTC", "ETH", "WTI"): score[s] -= .05
    elif breadth > .67:
        for s in ("SPX", "NDX", "SOX", "000300.SH"): score[s] += .035

    avgvol = float(np.mean(list(vols.values())))
    raw = {s: max(score[s], .03) * (.85 + .15*avgvol/max(vols[s], .008)) for s in UNIVERSE}
    targets = bounded_weights(raw)
    forecasts = {s: .06 * (score[s] - .5) for s in UNIVERSE}
    rebalance_to_weights(targets, forecast_returns=forecasts,
                         factor_ids=FACTOR_IDS, horizon_days=10)
    _decided = True


