  ▶️ write_file({'content': 'import numpy as np\nfrom alphacrafter.sim.utils import (register_hook, get_stock_daily_data,\n    get_index_daily_data, get_account_dict, rebalance_to_weights)\n\nUNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]\nFACTOR_IDS = [\n    "miner_1_20280323_vix_conditioned_efficiency_trend",\n    "miner_3_20280601_downside_adjusted_acceleration_20_60",\n    "miner_3_20261105_downside_risk_adjusted_momentum",\n    "miner_3_20261119_stress_conditioned_residual_20d",\n    "miner_2_20261217_residual_beta_volscaled_20d",\n    "miner_3_20280210_drawdown_recovery_acceleration_20d",\n    "miner_1_20260730_long_recovery_20d",\n    "miner_1_20260730_path_efficiency_10d",\n]\nFACTOR_WEIGHTS = np.array([.16, .14, .14, .14, .12, .11, .10, .09])\n_days_to_rebalance = 0\n\n\ndef ranks(x, names):\n    valid = sorted((float(x[s]), s) for s in names if np.isfinite(x.get(s, np.nan)))\n    out = {s: .5 for s in UNIVERSE}\n    for i, (_, s) in enumerate(valid):\n        out[s] = (i + 1) / max(1, len(valid))\n    return out\n\n\ndef make_weights(score, vol, stress):\n    # Defensive assets are the fully-invested substitute for cash in stress.\n    tilt = {s: 1.0 for s in UNIVERSE}\n    if stress:\n        tilt.update({"XAU": 3.4, "US10Y": 3.0, "CN10Y": 2.6,\n                     "BTC": .04, "ETH": .04, "WTI": .12, "COPPER": .35})\n    raw = {s: tilt[s] * (.40 + score[s]) / max(vol.get(s, .02), .008)**.30 for s in UNIVERSE}\n    w = {s: max(float(raw[s]), .001) for s in UNIVERSE}\n    w = {s: w[s] / sum(w.values()) for s in UNIVERSE}\n    cap = .12 if stress else .16\n    for _ in range(50):\n        over = [s for s in UNIVERSE if w[s] > cap]\n        if not over: break\n        excess = sum(w[s] - cap for s in over)\n        for s in over: w[s] = cap\n        free = [s for s in UNIVERSE if s not in over]\n        den = sum(w[s] for s in free)\n        if not free or den <= 0: break\n        for s in free: w[s] += excess * w[s] / den\n    z = sum(w.values())\n    return {s: max(0., w[s] / z) for s in UNIVERSE}\n\n\n@register_hook\ndef cross_asset_strategy():\n    global _days_to_rebalance\n    if _days_to_rebalance:\n        _days_to_rebalance -= 1\n        return\n    close, daily, vol = {}, {}, {}\n    for s in UNIVERSE:\n        df = get_stock_daily_data(symbol=s, days=230)\n        if df is None or len(df) < 80: continue\n        c = np.asarray(df.sort_values("date")["close"], dtype=float)\n        if len(c) >= 65 and np.all(np.isfinite(c)) and np.all(c > 0):\n            close[s] = c; daily[s] = c[1:] / c[:-1] - 1.\n            vol[s] = max(float(np.std(daily[s][-30:])), .008)\n    names = [s for s in UNIVERSE if s in close]\n    if len(names) < 12: return\n    r10 = {s: close[s][-1] / close[s][-11] - 1. for s in names}\n    r20 = {s: close[s][-1] / close[s][-21] - 1. for s in names}\n    r60 = {s: close[s][-1] / close[s][-61] - 1. for s in names}\n    peer = np.mean([daily[s][-20:] for s in names], axis=0)\n    vd = get_index_daily_data(symbol="VIX", days=45)\n    vix = 0.\n    if vd is not None and len(vd) >= 22:\n        vc = np.asarray(vd.sort_values("date")["close"], dtype=float)\n        vix = vc[-1] / max(float(np.median(vc[-21:])), 1e-9) - 1.\n    breadth = np.mean([r20[s] > 0 for s in names])\n    market = r20.get("SPX", float(np.median(list(r20.values()))))\n    stress = market < -.05 or breadth < .40 or np.mean(list(vol.values())) > .022 or vix > .15\n    fs = [dict() for _ in FACTOR_IDS]\n    for s in names:\n        d = daily[s]\n        down = max(float(np.std(np.minimum(d[-40:], 0))), .006)\n        beta = float(np.cov(d[-20:], peer)[0, 1] / max(np.var(peer), 1e-8))\n        peer20 = float(np.median([r20[x] for x in names if x != s]))\n        residual = r20[s] - beta * peer20\n        efficiency = abs(r20[s]) / max(float(np.sum(abs(d[-20:]))), .01)\n        dd = close[s][-1] / max(np.max(close[s][-61:-1]), close[s][-1]) - 1.\n        recovery = (r20[s] - r60[s] / 3.) * (1. + min(max(-dd, 0.), .35))\n        accel = (r20[s] - r60[s] / 3.) / max(vol[s], .01)\n        fs[0][s] = (.35*r10[s] + .65*r20[s]) * efficiency * (1 + max(vix, 0.))\n        fs[1][s] = accel / (1 + max(-r20[s], 0.))\n        fs[2][s] = r20[s] / down\n        fs[3][s] = residual * (1 + .7*max(vix, 0.))\n        fs[4][s] = residual / max(vol[s]*(1 + max(beta, 0.)), .01)\n        fs[5][s] = recovery\n        fs[6][s] = .45*r20[s] + .35*r60[s] + .20*r10[s]\n        fs[7][s] = abs(r20[s]) / max(float(np.sum(abs(d[-10:]))), .01)\n    rr = [ranks(f, names) for f in fs]\n    score = {s: sum(w*r[s] for w, r in zip(FACTOR_WEIGHTS, rr)) for s in UNIVERSE}\n    if stress:\n        for s, b in (("XAU", .20), ("US10Y", .16), ("CN10Y", .12)): score[s] += b\n        for s in ("BTC", "ETH", "WTI", "COPPER"): score[s] -= .16\n    target = make_weights(score, vol, stress)\n    account = get_account_dict(); assets = max(float(account.get("total_assets", 0)), 1.)\n    old = {s: 0. for s in UNIVERSE}\n    for p in account.get("positions", []):\n        s = p.get("symbol")\n        if s in old and float(p.get("quantity", 0)) > 0:\n            old[s] = max(float(p.get("market_value", 0)), 0.) / assets\n    if sum(old.values()) > .05:\n        z = sum(old.values()); old = {s: old[s]/z for s in UNIVERSE}\n        target = {s: .10*target[s] + .90*old[s] for s in UNIVERSE}\n    z = sum(target.values()); target = {s: target[s]/z for s in UNIVERSE}\n    forecast = {s: .004*(score[s] - .5) for s in UNIVERSE}\n    rebalance_to_weights(target, forecast_returns=forecast, factor_ids=FACTOR_IDS, horizon_days=10)\n    _days_to_rebalance = 9\n\nassert len(UNIVERSE) == 15 and len(FACTOR_IDS) <= 10\nassert not set(UNIVERSE).intersection({"DXY", "USDCNY", "USDJPY", "EURUSD", "VIX"})\n', 'file_path': 'strategy.py'})
