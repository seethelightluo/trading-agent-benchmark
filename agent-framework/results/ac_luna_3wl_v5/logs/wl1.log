E if s not in over]\n        den = sum(w[s] for s in free)\n        if not free or den <= 0:\n            break\n        for s in free:\n            w[s] += excess * w[s] / den\n    z = sum(w.values())\n    return {s: w[s] / z for s in UNIVERSE}\n\n\n@register_hook\ndef cross_asset_strategy():\n    global _days_to_rebalance\n    if _days_to_rebalance:\n        _days_to_rebalance -= 1\n        return\n    closes, rets, vols = {}, {}, {}\n    for s in UNIVERSE:\n        df = get_stock_daily_data(symbol=s, days=230)\n        if df is None or len(df) < 80:\n            continue\n        c = np.asarray(df.sort_values("date")["close"], dtype=float)\n        if len(c) >= 65 and np.all(np.isfinite(c)) and np.all(c > 0):\n            closes[s] = c\n            rets[s] = c[1:] / c[:-1] - 1.0\n            vols[s] = max(float(np.std(rets[s][-30:])), .008)\n    names = [s for s in UNIVERSE if s in closes]\n    if len(names) < 12:\n        return\n    r5 = {s: closes[s][-1] / closes[s][-6] - 1 for s in names}\n    r20 = {s: closes[s][-1] / closes[s][-21] - 1 for s in names}\n    r40 = {s: closes[s][-1] / closes[s][-41] - 1 for s in names}\n    peer = np.mean([rets[s][-20:] for s in names], axis=0)\n    vix_state = 0.0\n    vd = get_index_daily_data(symbol="VIX", days=45)\n    if vd is not None and len(vd) >= 22:\n        vc = np.asarray(vd.sort_values("date")["close"], dtype=float)\n        vix_state = vc[-1] / max(float(np.median(vc[-21:])), 1e-9) - 1\n    breadth = np.mean([r20[s] > 0 for s in names])\n    market = r20.get("SPX", float(np.median(list(r20.values()))))\n    stress = market < 0 or breadth < .45 or np.mean(list(vols.values())) > .022 or vix_state > .15\n    factors = [dict() for _ in FACTOR_IDS]\n    for s in names:\n        d = rets[s]\n        downside = max(float(np.std(np.minimum(d[-40:], 0))), .006)\n        beta = float(np.cov(d[-20:], peer)[0, 1] / max(np.var(peer), 1e-8))\n        peer20 = float(np.median([r20[x] for x in names if x != s]))\n        residual = r20[s] - beta * peer20\n        factors[0][s] = r20[s] / downside\n        factors[1][s] = residual / max(vols[s] * (1 + abs(beta)), .01)\n        factors[2][s] = r20[s] / max(vols[s] * (1 + max(beta, 0) * max(vix_state, 0)), .01)\n        factors[3][s] = residual * (1 + .7 * max(vix_state, 0))\n        factors[4][s] = (-beta if stress else beta) + .20 * r40[s] / max(vols[s], .01)\n        factors[5][s] = -r5[s] / max(float(np.std(d[-10:])), .006)\n        factors[6][s] = (r20[s] - r40[s] / 2) / max(vols[s], .01)\n        factors[7][s] = (r20[s] - min(r40[s], 0)) / max(vols[s], .01)\n    ranks = [cs_rank(f, names) for f in factors]\n    score = {s: sum(w * q[s] for w, q in zip(FACTOR_WEIGHTS, ranks)) for s in UNIVERSE}\n    if stress:\n        for s, add in (("XAU", .16), ("US10Y", .12), ("CN10Y", .09)):\n            score[s] += add\n        for s in ("BTC", "ETH", "WTI"):\n            score[s] -= .16\n    target = make_weights(score, vols, stress)\n\n    account = get_account_dict()\n    assets = max(float(account.get("total_assets", 0)), 1.0)\n    old = {s: 0.0 for s in UNIVERSE}\n    for p in account.get("positions", []):\n        s = p.get("symbol")\n        if s in old and p.get("quantity", 0) > 0:\n            old[s] += max(float(p.get("market_value", 0)), 0.0) / assets\n    if sum(old.values()) > .05:\n        z = sum(old.values())\n        old = {s: old[s] / z for s in UNIVERSE}\n        # 35% migration prevents rank churn in stressed correlation regimes.\n        target = {s: .35 * target[s] + .65 * old[s] for s in UNIVERSE}\n    z = sum(target.values())\n    target = {s: max(0.0, target[s] / z) for s in UNIVERSE}\n    forecast = {s: .006 * (score[s] - .5) for s in UNIVERSE}\n    rebalance_to_weights(target, forecast_returns=forecast, factor_ids=FACTOR_IDS, horizon_days=10)\n    _days_to_rebalance = 9\n\nassert len(UNIVERSE) == 15 and len(FACTOR_IDS) <= 10\nassert abs(sum(make_weights({s: .5 for s in UNIVERSE}, {}, True).values()) - 1) < 1e-8\nassert no