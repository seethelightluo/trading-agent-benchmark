 import numpy as np
from alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights

UNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
# Current screener ensemble; exactly ten active factors.
FACTOR_WEIGHTS = {"vix": .16, "clv": .11, "rvolmom": .14, "path": .12, "resid": .10,
                  "downmom": .09, "shock": .07, "disp": .09, "persist": .07, "highvol": .05}
FACTOR_IDS = [
 "miner_1_20260730_vix_state_reversal_5d", "miner_3_20260730_vix_conditioned_clv_1d",
 "miner_1_20260730_residual_vol_scaled_momentum_10d", "miner_1_20260730_path_efficiency_10d",
 "miner_2_20260730_residual_momentum_10d", "miner_1_20260730_downside_quality_momentum_10d",
 "miner_1_20260730_residual_shock_blend_10d", "miner_1_20260730_dispersion_conditioned_reversal_1d",
 "miner_2_20260730_slow_rank_persistence_20d", "miner_2_20260730_highvol_reversal_1d"
]
_last_decision = None

def _rank(x):
    good = sorted((k, v) for k, v in x.items() if np.isfinite(v))
    out = {s: .5 for s in UNIVERSE}
    n = len(good)
    for i, (s, _) in enumerate(good): out[s] = (i + 1.) / max(n, 1)
    return out

def _weights(raw):
    # 1.5%-16% bounds, followed by an exact normalization.
    w = {s: max(float(raw.get(s, 1/15)), .015) for s in UNIVERSE}
    for _ in range(20):
        clipped = {s for s in UNIVERSE if w[s] >= .16}
        for s in clipped: w[s] = .16
        free = [s for s in UNIVERSE if s not in clipped]
        rem = 1. - sum(w[s] for s in clipped)
        if not free: break
        scale = rem / sum(w[s] for s in free)
        for s in free: w[s] *= scale
        if max(w.values()) <= .1600001: break
    z = sum(w.values())
    return {s: w[s] / z for s in UNIVERSE}

@register_hook
def cross_asset_strategy():
    global _last_decision
    data = {}
    for s in UNIVERSE:
        df = get_stock_daily_data(symbol=s, days=150)
        if df is not None and len(df) >= 45:
            data[s] = np.asarray(df.sort_values("date")["close"], dtype=float)
    if len(data) < 12: return
    # The hook sees only completed bars.  Rebalance at most once per ten days.
    if _last_decision is not None:
        # Persisting the date in process state is sufficient for the simulator hook.
        # The first call in a new process is the allocation/restart point.
        return
    r10 = {s: c[-1] / max(c[-11], 1e-12) - 1. for s, c in data.items()}
    med = float(np.median(list(r10.values())))
    fac = {k: {} for k in FACTOR_WEIGHTS}; vols = {}
    dispersion = max(float(np.std(list(r10.values()))), .001)
    for s, c in data.items():
        d = c[1:] / np.maximum(c[:-1], 1e-12) - 1.
        v = max(float(np.std(d[-20:])), .008); vols[s] = v
        rev5 = -float(np.mean(d[-5:])); last = float(d[-1])
        fac["vix"][s] = rev5 * np.clip(v/.018, .5, 2.)
        fac["clv"][s] = -.65*last*np.clip(v/.018,.5,2.) - .35*rev5
        fac["rvolmom"][s] = (r10[s]-med)/v
        fac["path"][s] = np.sign(r10[s])*abs(r10[s])/max(float(np.sum(abs(d[-10:]))),.01)
        down = max(float(np.std(np.minimum(d[-30:], 0.))), .006)
        fac["resid"][s] = r10[s]-med; fac["downmom"][s] = (c[-1]/max(c[-21],1e-12)-1.)/down
        shock = -last*np.clip(abs(last)/(v+.002),0.,3.)
        fac["shock"][s] = .6*(r10[s]-med)+.4*shock
        fac["disp"][s] = -last*dispersion/max(v,.008)
        fac["persist"][s] = sum((c[-1]/max(c[-1-5*j],1e-12)-1.) > 0 for j in range(1,5)) + .25*np.sign(c[-1]/max(c[-21],1e-12)-1.)
        fac["highvol"][s] = rev5*np.clip(v/.020,.5,2.5)
    score = {s: sum(FACTOR_WEIGHTS[k]*_rank(fac[k])[s] for k in FACTOR_WEIGHTS) for s in UNIVERSE}
    breadth = np.mean([c[-1] > c[-21] for c in data.values()])
    spx = data.get("SPX")
    bear = spx is not None and spx[-1] < spx[-21] and spx[-1] < spx[-6]
    if bear or breadth < .40:
        for s in ("XAU", "US10Y", "CN10Y"): score[s] += .12
        for s in ("BTC", "ETH", "WTI"): score[s] -= .05
    elif breadth > .67:
        for s in ("SPX", "NDX", "SOX", "000300.SH"): score[s] += .035
    avgvol = float(np.mean(list(vols.values())))
    raw = {s: max(score[s], .03) * (.85 + .15*avgvol/max(vols[s],.008)) for s in UNIVERSE}
    targets = _weights(raw)
    forecasts = {s: .06*(score[s]-.5) for s in UNIVERSE}
    rebalance_to_weights(targets, forecast_returns=forecasts, factor_ids=FACTOR_IDS, horizon_days=10)
    _last_decision = True


