  ▶️ write_file({'content': "import pandas as pd, numpy as np\nfrom scipy.stats import spearmanr\nU=['000300.SH','SPX','HSI','N225','SX5E','000688.SH','SOX','NDX','XAU','COPPER','WTI','BTC','ETH','US10Y','CN10Y']\ncut=pd.Timestamp('2026-07-15')\nP={s:pd.read_csv('../persistent/stock_data/'+s+'.csv',parse_dates=['date']).set_index('date').sort_index().close.loc[:cut] for s in U}\nidx=sorted(set().union(*[set(v.index) for v in P.values()]))\np=pd.DataFrame({s:v.reindex(idx) for s,v in P.items()}).ffill()\nr=p.pct_change()\n# Breadth-transition factor: short-term asset return, amplified when the cross-asset\n# 20d breadth confirms the direction; centered breadth avoids a market-wide level bias.\nret5=p/p.shift(5)-1\nbreadth=(ret5>0).sum(axis=1)/p.notna().sum(axis=1)\n# use lagged breadth, and smooth it to avoid same-day information leakage\nstate=(breadth.shift(1).rolling(5,min_periods=3).mean()-0.5)*2\nf=ret5.mul(state,axis=0)\nprint('universe',len(U),'dates',len(p),'cutoff',p.index.max().date())\nfor h in [5,10,20]:\n I=[]; Ns=[]; ds=[]\n for i in range(len(p)-h):\n  q=pd.concat([f.iloc[i].rename('f'),(p.iloc[i+h]/p.iloc[i]-1).rename('y')],axis=1).dropna()\n  if len(q)>=8 and q.f.nunique()>1 and q.y.nunique()>1:\n   I.append(spearmanr(q.f,q.y).statistic);Ns.append(len(q));ds.append(p.index[i])\n a=np.array(I); print('h',h,'valid_dates',len(a),'avgN',round(np.mean(Ns),2),'coverage',round(np.mean(Ns)/15,4),'IC',round(a.mean(),6),'ICIR',round(a.mean()/a.std(ddof=1),6),'hit',round(np.mean(a>0),4))\n if h==10: print('annual10',{y:round(a[[d.year==y for d in ds]].mean(),6) for y in sorted(set(d.year for d in ds))})\n# rank turnover and state conditioning\nrank=f.rank(axis=1,pct=True); turn=(rank-rank.shift(1)).abs().stack().groupby(level=0).mean().dropna()\nprint('turnover',round(turn.mean(),6),'factor_coverage_dates',int(f.notna().sum(axis=1).ge(8).sum()))\nprint('breadth_mean',round(breadth.mean(),4),'state_positive',round((state>0).mean(),4))\n", 'file_path': 'scripts/miner_3_20261008_breadth_transition.py'})
