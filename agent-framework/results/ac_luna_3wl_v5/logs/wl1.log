 import pandas as pd, numpy as np, os
from scipy.stats import spearmanr
U=['000300.SH','SPX','HSI','N225','SX5E','000688.SH','SOX','NDX','XAU','COPPER','WTI','BTC','ETH','US10Y','CN10Y']
cut='2026-07-15'
def load(s):
 p='../persistent/stock_data/'+s+'.csv'
 x=pd.read_csv(p,parse_dates=['date']).drop_duplicates('date').set_index('date').sort_index()
 return x.close.loc[:cut]
p=pd.concat({s:load(s) for s in U},axis=1).sort_index(); r=p.pct_change()
# Equity basket excludes non-equities; stress is lagged breadth/return weakness
E=['000300.SH','SPX','HSI','N225','SX5E','000688.SH','SOX','NDX']
eq=r[E].mean(axis=1); breadth=(r[E]>0).mean(axis=1)
stress=((eq.rolling(10,min_periods=8).sum()<0) & (breadth.rolling(10,min_periods=8).mean()<0.5)).astype(float)
# defensive relative-strength: asset trailing return less equity trailing return, activated during lagged stress
rel=p.pct_change(20).sub(p.pct_change(20)[E].mean(axis=1),axis=0)
f=rel.mul(stress.shift(1),axis=0).replace(0,np.nan).shift(1)
# fill inactive dates with zero (neutral); retain complete coverage
f=f.fillna(0)
for h in [5,10,20]:
