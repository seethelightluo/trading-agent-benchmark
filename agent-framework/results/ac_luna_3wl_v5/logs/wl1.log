s = sum(w[s] - cap for s in over)\n        for s in over: w[s] = cap\n        free = [s for s in UNIVERSE if s not in over]\n        den = sum(w[s] for s in free)\n        if not free or den <= 0: break\n        for s in free: w[s] += excess * w[s] / den\n    total = sum(w.values())\n    return {s: max(0.0, w[s] / total) for s in UNIVERSE}\n\n\n@register_hook\ndef cross_asset_strategy():\n    global _days_to_rebalance\n    if _days_to_rebalance:\n        _days_to_rebalance -= 1\n        return\n\n    closes, rets, vol = {}, {}, {}\n    for s in UNIVERSE:\n        df = get_stock_daily_data(symbol=s, days=230)\n        if df is None or len(df) < 80: continue\n        c = np.asarray(df.sort_values("date")["close"], dtype=float)\n        if len(c) >= 65 and np.all(np.isfinite(c)) and np.all(c > 0):\n            closes[s] = c\n            rets[s] = c[1:] / c[:-1] - 1.0\n            vol[s] = max(float(np.std(rets[s][-30:])), .008)\n    names = [s for s in UNIVERSE if s in closes]\n    if len(names) < 12: return\n\n    r5 = {s: closes[s][-1] / closes[s][-6] - 1.0 for s in names}\n    r20 = {s: closes[s][-1] / closes[s][-21] - 1.0 for s in names}\n    r40 = {s: closes[s][-1] / closes[s][-41] - 1.0 for s in names}\n    peer = np.mean([rets[s][-20:] for s in names], axis=0)\n    vix_state = 0.0\n    vd = get_index_daily_data(symbol="VIX", days=45)\n    if vd is not None and len(vd) >= 22:\n        vc = np.asarray(vd.sort_values("date")["close"], dtype=float)\n        vix_state = vc[-1] / max(float(np.median(vc[-21:])), 1e-9) - 1.0\n    breadth = np.mean([r20[s] > 0 for s in names])\n    market = r20.get("SPX", float(np.median(list(r20.values()))))\n    avg_vol = float(np.mean(list(vol.values())))\n    defensive = market < 0 or breadth < .45 or avg_vol > .022 or vix_state > .15\n\n    factors = [dict() for _ in FACTOR_IDS]\n    for s in names:\n        d = rets[s]\n        downside = max(float(np.std(np.minimum(d[-40:], 0.0))), .006)\n        beta = float(np.cov(d[-20:], peer)[0, 1] / max(np.var(peer), 1e-8))\n        peer20 = float(np.median([r20[x] for x in names if x != s]))\n        residual = r20[s] - beta * peer20\n        accel = r20[s] - r40[s] / 2.0\n        # Ordered to match FACTOR_IDS and preserve each factor\'s positive direction.\n        factors[0][s] = -r5[s] / max(float(np.std(d[-10:])), .006)\n        factors[1][s] = r20[s] / downside\n        factors[2][s] = residual / max(vol[s] * (1.0 + abs(beta)), .01)\n        factors[3][s] = r20[s] / max(vol[s] * (1.0 + max(beta, 0.0) * max(vix_state, 0.0)), .01)\n        factors[4][s] = accel / max(vol[s], .01)\n        factors[5][s] = accel / max(vol[s] * np.sqrt(20.0), .02)\n        factors[6][s] = residual * (1.0 + .5 * max(vix_state, 0.0))\n        factors[7][s] = (-beta if defensive else beta) + .20 * r40[s] / max(vol[s], .01)\n\n    ranks = [cs_rank(x, names) for x in factors]\n    score = {s: sum(w * q[s] for w, q in zip(FACTOR_WEIGHTS, ranks)) for s in UNIVERSE}\n    if defensive:\n        for s, add in (("XAU", .14), ("US10Y", .10), ("CN10Y", .08)):\n            score[s] += add\n        for s in ("BTC", "ETH", "WTI"):\n            score[s] -= .12\n    target = make_weights(score, vol, defensive)\n    forecast = {s: .008 * (score[s] - .5) for s in UNIVERSE}\n    rebalance_to_weights(target, forecast_returns=forecast, factor_ids=FACTOR_IDS, horizon_days=10)\n    _days_to_rebalance = 9\n\n\nassert len(UNIVERSE) == 15 and len(FACTOR_IDS) <= 10\nassert not set(UNIVERSE).intersection({"DXY", "USDCNY", "USDJPY", "EURUSD", "VIX"})\nassert abs(sum(make_weights({s: .5 for s in UNIVERSE}, {}, True).values()) - 1.0) < 1e-8\n', 'file_path': 'strategy.py'})
