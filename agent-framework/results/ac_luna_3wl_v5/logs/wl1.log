  ▶️ write_file({'content': 'import numpy as np\nfrom alphacrafter.sim.utils import (\n    register_hook, get_stock_daily_data, get_account_dict, rebalance_to_weights\n)\n\nUNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]\n# Current Screener ensemble: eight factors, all positive direction.\nFACTOR_WEIGHTS = {\n    "vix_rev": .17, "vix_clv": .12, "downside_mom": .14,\n    "residual_mom": .14, "peer": .13, "mom20": .12,\n    "shock": .09, "disp_rev": .09,\n}\nFACTOR_IDS = [\n    "miner_1_20260730_vix_state_reversal_5d",\n    "miner_3_20260730_vix_conditioned_clv_1d",\n    "miner_3_20260730_downside_risk_adjusted_momentum_10d",\n    "miner_2_20260730_residual_momentum_10d",\n    "miner_1_20260716_peer_median_leadlag_5d",\n    "miner_2_20260716_risk_adjusted_momentum_20d",\n    "miner_1_20260730_smoothed_shock_exhaustion_reversal_1d",\n    "miner_1_dispersion_conditioned_reversal_3d",\n]\nCADENCE, MIN_W, MAX_W = 10, .015, .16\nlast_decision = None\n\ndef rank_map(vals):\n    good = sorted((s, float(v)) for s, v in vals.items() if np.isfinite(v))\n    out = {s: .5 for s in UNIVERSE}\n    n = len(good)\n    for i, (s, _) in enumerate(good):\n        out[s] = (i + 1.) / n\n    return out\n\ndef project(raw):\n    # Iterative capped simplex projection; preserves a complete, cash-free target.\n    w = {s: max(float(raw.get(s, 1/15)), 1e-8) for s in UNIVERSE}\n    for _ in range(30):\n        lo = [s for s in UNIVERSE if w[s] < MIN_W]\n        hi = [s for s in UNIVERSE if w[s] > MAX_W]\n        fixed = set(lo + hi)\n        for s in lo: w[s] = MIN_W\n        for s in hi: w[s] = MAX_W\n        free = [s for s in UNIVERSE if s not in fixed]\n        if not free: break\n        remainder = 1. - sum(w[s] for s in fixed)\n        scale = remainder / max(sum(w[s] for s in free), 1e-12)\n        for s in free: w[s] *= scale\n        if not any(w[s] < MIN_W-1e-9 or w[s] > MAX_W+1e-9 for s in UNIVERSE): break\n    z = sum(w.values())\n    return {s: w[s] / z for s in UNIVERSE}\n\n@register_hook\ndef cross_asset_strategy():\n    global last_decision\n    account = get_account_dict()\n    series = {}\n    for s in UNIVERSE:\n        df = get_stock_daily_data(symbol=s, days=110)\n        if df is None or len(df) < 35: continue\n        df = df.sort_values("date").reset_index(drop=True)\n        c = np.asarray(df.close, dtype=float)\n        h = np.asarray(df.high, dtype=float)\n        l = np.asarray(df.low, dtype=float)\n        r = c[1:] / np.maximum(c[:-1], 1e-12) - 1.\n        series[s] = (c, h, l, r, str(df.iloc[-1].date))\n    if len(series) < 12: return\n    decision = max(v[4] for v in series.values())\n    if last_decision is not None:\n        try:\n            if (np.datetime64(decision) - np.datetime64(last_decision)) / np.timedelta64(1, "D") < CADENCE: return\n        except Exception: return\n\n    ret = lambda c, n: c[-1] / max(c[-n-1], 1e-12) - 1.\n    r5 = {s: ret(v[0], 5) for s, v in series.items()}\n    r10 = {s: ret(v[0], 10) for s, v in series.items()}\n    r20 = {s: ret(v[0], 20) for s, v in series.items()}\n    median5 = float(np.median(list(r5.values())))\n    dispersion = float(np.std(list(r5.values())))\n    breadth = float(np.mean([v[0][-1] > v[0][-21] for v in series.values()]))\n    f = {k: {} for k in FACTOR_WEIGHTS}; vol = {}\n    for s, (c, h, l, r, _) in series.items():\n        v = max(float(np.std(r[-20:])), .008); vol[s] = v\n        down = max(float(np.std(np.minimum(r[-20:], 0.))), .006)\n        rng = np.maximum(h[-5:] - l[-5:], 1e-12)\n        clv = float(np.mean((2*c[-5:] - h[-5:] - l[-5:]) / rng))\n        rev5, rev3 = -float(np.mean(r[-5:])), -float(np.mean(r[-3:]))\n        amp = min(max(v/.018, .5), 2.5)\n        f["vix_rev"][s] = rev5 * amp\n        f["vix_clv"][s] = clv * amp\n        f["downside_mom"][s] = r10[s] / down\n        f["residual_mom"][s] = r10[s] - median5\n        f["peer"][s] = median5 - r5[s]  # relative lead/lag, conservative reversal form\n        f["mom20"][s] = r20[s] / v\n        f["shock"][s] = -float(r[-1]) * min(abs(float(r[-1]))/(v+.002), 3.)\n        f["disp_rev"][s] = rev3 * min(max(dispersion/.015, .5), 2.)\n    score = {s: sum(w * rank_map(f[k])[s] for k, w in FACTOR_WEIGHTS.items()) for s in UNIVERSE}\n    spx = series.get("SPX")\n    bear = spx is not None and spx[0][-1] < spx[0][-21] and spx[0][-1] < spx[0][-6]\n    if bear or breadth < .40:\n        for s in ("XAU", "US10Y", "CN10Y"): score[s] += .14\n        for s in ("BTC", "ETH", "WTI"): score[s] -= .06\n    elif breadth > .67:\n        for s in ("SPX", "NDX", "SOX", "000300.SH"): score[s] += .04\n    avg = float(np.mean(list(vol.values())))\n    raw = {s: max(score[s], .03) * (.8 + .2*avg/max(vol[s], .008)) for s in UNIVERSE}\n    targets = project(raw)\n    forecasts = {s: .06 * (score[s] - .5) for s in UNIVERSE}\n    if abs(sum(targets.values())-1.) < 1e-8 and all(np.isfinite(x) and x >= 0 for x in targets.values()):\n        rebalance_to_weights(targets, forecast_returns=forecasts, factor_ids=FACTOR_IDS, horizon_days=10)\n        last_decision = decision\n', 'file_path': 'strategy.py'})
