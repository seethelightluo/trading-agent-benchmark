  ▶️ write_file({'content': 'import numpy as np\nfrom alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights\n\nUNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]\n# 2026-07-30 Screener quality_ic_tilt ensemble; eight active factors.\nFACTOR_WEIGHTS = {"vix": .20, "resid": .17, "down": .15, "path": .14,\n                  "shock": .12, "highvol": .10, "range": .07, "peer": .05}\nFACTOR_IDS = [\n "miner_1_20260730_vix_state_reversal_5d",\n "miner_3_20260730_residual_momentum_10d",\n "miner_3_20260730_downside_risk_adjusted_momentum_10d",\n "miner_1_20260730_path_efficiency_10d",\n "miner_1_20260730_residual_shock_blend_10d",\n "miner_2_20260730_highvol_reversal_5d",\n "miner_3_20260730_range_shock_exhaustion_1d",\n "peer_median_leadlag_5d"]\nCADENCE = 10\n_last_date = None\n\ndef ranks(values):\n    good = sorted((s, v) for s, v in values.items() if np.isfinite(v))\n    out = {s: .5 for s in UNIVERSE}\n    for i, (s, _) in enumerate(good): out[s] = (i + 1.) / max(len(good), 1)\n    return out\n\ndef bounded(raw):\n    # Full investment, mild 1.5%-16% bounds, suitable for exactly 15 assets.\n    w = {s: max(float(raw.get(s, 1/15)), .000001) for s in UNIVERSE}\n    for _ in range(30):\n        low = [s for s in UNIVERSE if w[s] < .015]\n        high = [s for s in UNIVERSE if w[s] > .16]\n        for s in low: w[s] = .015\n        for s in high: w[s] = .16\n        fixed = set(low + high); free = [s for s in UNIVERSE if s not in fixed]\n        rem = 1 - sum(w[s] for s in fixed)\n        if not free: break\n        scale = rem / max(sum(w[s] for s in free), 1e-12)\n        for s in free: w[s] *= scale\n        if not low and not high: break\n    z = sum(w.values())\n    return {s: w[s] / z for s in UNIVERSE}\n\n@register_hook\ndef cross_asset_strategy():\n    global _last_date\n    data = {}\n    for s in UNIVERSE:\n        df = get_stock_daily_data(symbol=s, days=130)\n        if df is None or len(df) < 45: continue\n        c = np.asarray(df.sort_values("date")["close"], dtype=float)\n        data[s] = c\n    if len(data) < 12: return\n    date = max(str(get_stock_daily_data(symbol=s, days=2).iloc[-1]["date"]) for s in data)\n    if _last_date is not None:\n        try:\n            if (np.datetime64(date)-np.datetime64(_last_date))/np.timedelta64(1, "D") < CADENCE: return\n        except Exception: return\n    def ret(c, n): return c[-1] / max(c[-n-1], 1e-12) - 1\n    r5 = {s: ret(c, 5) for s,c in data.items()}; r10 = {s: ret(c,10) for s,c in data.items()}\n    med5, med10 = np.median(list(r5.values())), np.median(list(r10.values()))\n    f = {k:{} for k in FACTOR_WEIGHTS}; vol = {}\n    for s,c in data.items():\n        r = c[1:] / np.maximum(c[:-1], 1e-12) - 1\n        v = max(float(np.std(r[-20:])), .008); vol[s] = v\n        downside = max(float(np.std(np.minimum(r[-20:], 0))), .006)\n        path = abs(r10[s]) / max(float(np.sum(abs(r[-10:]))), .01)\n        f["path"][s] = np.sign(r10[s]) * path\n        f["resid"][s] = r10[s] - med10\n        f["down"][s] = ret(c,20) / downside\n        rev = -float(np.mean(r[-5:]))\n        f["vix"][s] = rev * min(max(v/.018,.5),2)\n        shock = -float(r[-1]) * min(abs(float(r[-1]))/(v+.002),3)\n        f["shock"][s] = .6*(r10[s]-med10) + .4*shock\n        f["highvol"][s] = rev * min(max(v/.02,.5),2.5)\n        f["range"][s] = -float(r[-1]) * min(abs(float(r[-1]))/(v+.002),2)\n        f["peer"][s] = r5[s] - med5\n    score = {s: sum(w*ranks(f[k])[s] for k,w in FACTOR_WEIGHTS.items()) for s in UNIVERSE}\n    breadth = np.mean([c[-1] > c[-21] for c in data.values()])\n    spx = data.get("SPX"); bear = spx is not None and spx[-1] < spx[-21] and spx[-1] < spx[-6]\n    if bear or breadth < .40:\n        for s in ("XAU", "US10Y", "CN10Y"): score[s] += .12\n        for s in ("BTC", "ETH", "WTI"): score[s] -= .05\n    elif breadth > .67:\n        for s in ("SPX", "NDX", "SOX", "000300.SH"): score[s] += .035\n    avg = np.mean(list(vol.values()))\n    raw = {s: max(score[s], .03) * (.85 + .15*avg/max(vol[s],.008)) for s in UNIVERSE}\n    targets = bounded(raw)\n    forecasts = {s: .06*(score[s]-.5) for s in UNIVERSE}\n    if abs(sum(targets.values())-1) < 1e-8:\n        rebalance_to_weights(targets, forecast_returns=forecasts, factor_ids=FACTOR_IDS, horizon_days=10)\n        _last_date = date\n', 'file_path': 'strategy.py'})
