       c = np.asarray(df.sort_values(\'date\')[\'close\'], dtype=float)\n        if len(c) >= 80 and np.all(np.isfinite(c)) and np.all(c > 0): prices[s]=c\n    if len(prices) < 12: return\n    rets = {s: prices[s][1:]/prices[s][:-1]-1 for s in prices}\n    def r(s,n): return prices[s][-1]/prices[s][-n-1]-1\n    r10={s:r(s,10) for s in prices}; r20={s:r(s,20) for s in prices}\n    r30={s:r(s,30) for s in prices}; r40={s:r(s,40) for s in prices}; r60={s:r(s,60) for s in prices}\n    vol={s:max(float(np.std(rets[s][-30:])),.008) for s in prices}\n    med10=float(np.median(list(r10.values()))); med20=float(np.median(list(r20.values())))\n    stress=float(np.mean(list(vol.values())))>.022 or float(np.std(list(r20.values())))>.10\n    factors=[{} for _ in FACTOR_W]\n    for s in prices:\n        d=rets[s]; v=vol[s]\n        downside20=max(float(np.std(np.minimum(d[-40:],0))),.006)\n        downside60=max(float(np.std(np.minimum(d[-60:],0))),.006)\n        path=max(float(np.sum(np.abs(d[-40:]))),.03)\n        factors[0][s]=(-r20[s] if stress else r20[s])/v\n        factors[1][s]=(r40[s]/v)*abs(r40[s])/path\n        factors[2][s]=(-.7*np.mean(d[-5:])-.3*np.mean(d[-2:]))/v\n        factors[3][s]=(.65*r20[s]+.35*r60[s])/v\n        factors[4][s]=r20[s]/downside20\n        factors[5][s]=r30[s]/downside60\n        factors[6][s]=(r10[s]-med10)/v\n        factors[7][s]=r10[s]/path\n        factors[8][s]=r20[s]*(np.mean(np.sign(d[-20:]))+1)/ (2*v)\n        factors[9][s]=.6*(r20[s]-med20)/v+.4*(r10[s]-med10)/v\n    score={s:sum(w*rank(f)[s] for w,f in zip(FACTOR_W,factors)) for s in UNIVERSE}\n    breadth=float(np.mean([r20[s]>0 for s in prices]))\n    if ("SPX" in prices and r20["SPX"]<0 and r10["SPX"]<0) or breadth<.50 or stress:\n        for s in ("XAU","US10Y","CN10Y"): score[s]+=.12\n        for s in ("BTC","ETH","WTI"): score[s]-=.05\n    # modest inverse-volatility risk adjustment, while retaining factor ranking\n    avg=np.mean(list(vol.values()))\n    score={s:max(.02,score[s])*(.92+.08*avg/vol.get(s,avg)) for s in UNIVERSE}\n    targets=bounded_weights(score)\n    forecasts={s:max(0.,.03*(score[s]-.5)) for s in UNIVERSE}\n    rebalance_to_weights(targets, forecast_returns=forecasts, factor_ids=FACTOR_IDS, horizon_days=10)\n    _gate=9\n', 'file_path': 'strategy.py'})
