  ▶️ write_file({'content': 'import numpy as np\nfrom alphacrafter.sim.utils import register_hook, get_account_dict, get_stock_daily_data, rebalance_to_weights\n\nUNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]\n# Current screener ensemble (9 factors; weights sum to 1).\nFACTOR_WEIGHTS = {\n    "vix_rev": .16, "vix_clv": .13, "downside_mom": .14,\n    "mom20": .12, "peer": .12, "disp_rev": .10,\n    "highvol_rev": .10, "shock": .08, "breadth_rev": .05,\n}\nFACTOR_IDS = [\n    "miner_1_20260730_vix_state_reversal_5d",\n    "miner_3_20260730_vix_conditioned_clv_1d",\n    "miner_3_20260730_downside_risk_adjusted_momentum_10d",\n    "miner_2_20260716_risk_adjusted_momentum_20d",\n    "miner_1_20260716_peer_median_leadlag_5d",\n    "miner_1_dispersion_conditioned_reversal_3d",\n    "miner_2_20260730_highvol_amplified_reversal_3d",\n    "shock_exhaustion_range_weighted_reversal_1d",\n    "miner_1_breadth_stress_reversal_5d",\n]\nMIN_W, MAX_W, CADENCE = 0.015, 0.16, 10\nlast_decision = None\n\ndef ranks(values):\n    valid = sorted((s, float(v)) for s, v in values.items() if np.isfinite(v))\n    out = {s: 0.5 for s in UNIVERSE}\n    for i, (s, _) in enumerate(valid):\n        out[s] = (i + 1.0) / len(valid)\n    return out\n\ndef capped_simplex(raw):\n    # Keep every tradable instrument in the complete, fully invested target.\n    w = {s: max(float(raw.get(s, 1.0 / len(UNIVERSE))), 1e-9) for s in UNIVERSE}\n    for _ in range(40):\n        low = [s for s in UNIVERSE if w[s] < MIN_W]\n        high = [s for s in UNIVERSE if w[s] > MAX_W]\n        fixed = set(low + high)\n        for s in low: w[s] = MIN_W\n        for s in high: w[s] = MAX_W\n        free = [s for s in UNIVERSE if s not in fixed]\n        if not free: break\n        rem = 1.0 - sum(w[s] for s in fixed)\n        scale = rem / max(sum(w[s] for s in free), 1e-12)\n        for s in free: w[s] *= scale\n        if all(MIN_W - 1e-8 <= w[s] <= MAX_W + 1e-8 for s in UNIVERSE): break\n    total = sum(w.values())\n    return {s: w[s] / total for s in UNIVERSE}\n\n@register_hook\ndef cross_asset_strategy():\n    global last_decision\n    account = get_account_dict()\n    data = {}\n    for symbol in UNIVERSE:\n        df = get_stock_daily_data(symbol=symbol, days=100)\n        if df is None or len(df) < 35:\n            continue\n        df = df.sort_values("date").reset_index(drop=True)\n        c = np.asarray(df["close"], dtype=float)\n        h = np.asarray(df["high"], dtype=float)\n        l = np.asarray(df["low"], dtype=float)\n        r = c[1:] / np.maximum(c[:-1], 1e-12) - 1.0\n        data[symbol] = (c, h, l, r, str(df.iloc[-1]["date"]))\n    if len(data) < 12:\n        return\n    decision = max(x[4] for x in data.values())\n    if last_decision is not None:\n        try:\n            age = (np.datetime64(decision, "D") - np.datetime64(last_decision, "D")) / np.timedelta64(1, "D")\n            if age < CADENCE:\n                return\n        except Exception:\n            return\n\n    ret3 = {s: v[0][-1] / max(v[0][-4], 1e-12) - 1.0 for s, v in data.items()}\n    ret5 = {s: v[0][-1] / max(v[0][-6], 1e-12) - 1.0 for s, v in data.items()}\n    ret10 = {s: v[0][-1] / max(v[0][-11], 1e-12) - 1.0 for s, v in data.items()}\n    ret20 = {s: v[0][-1] / max(v[0][-21], 1e-12) - 1.0 for s, v in data.items()}\n    med10 = float(np.median(list(ret10.values())))\n    dispersion = float(np.std(list(ret5.values())))\n    breadth = float(np.mean([v[0][-1] > v[0][-21] for v in data.values()]))\n    factors = {k: {} for k in FACTOR_WEIGHTS}\n    vols = {}\n    for s, (c, h, l, r, _) in data.items():\n        vol = max(float(np.std(r[-20:])), 0.008)\n        downside = max(float(np.std(np.minimum(r[-20:], 0.0))), 0.006)\n        clv = (2*c[-1] - h[-1] - l[-1]) / max(h[-1] - l[-1], 1e-12)\n        clv5 = float(np.mean((2*c[-5:] - h[-5:] - l[-5:]) / np.maximum(h[-5:] - l[-5:], 1e-12)))\n        reversal = -float(np.mean(r[-5:]))\n        short_reversal = -float(np.mean(r[-3:]))\n        factors["vix_rev"][s] = reversal * min(max(vol / .018, .5), 2.0)\n        factors["vix_clv"][s] = clv5 * min(max(vol / .018, .5), 2.0)\n        factors["downside_mom"][s] = ret10[s] / downside\n        factors["mom20"][s] = ret20[s] / vol\n        factors["peer"][s] = float(np.median([x for k, x in ret5.items() if k != s]))\n        factors["disp_rev"][s] = reversal * min(max(dispersion / .015, .5), 2.0)\n        factors["highvol_rev"][s] = short_reversal * min(max(vol / .018, .5), 2.5)\n        factors["shock"][s] = -float(r[-1]) * min(abs(float(r[-1])) / (vol + .002), 3.0)\n        factors["breadth_rev"][s] = -ret3[s] if breadth < .5 else -0.5 * ret3[s]\n        vols[s] = vol\n\n    scores = {s: sum(w * ranks(factors[k])[s] for k, w in FACTOR_WEIGHTS.items()) for s in UNIVERSE}\n    spx = data.get("SPX")\n    bear = spx is not None and spx[0][-1] < spx[0][-21] and spx[0][-1] < spx[0][-6]\n    if bear or breadth < .40:\n        for s in ("XAU", "US10Y", "CN10Y"):\n            scores[s] += .14\n        for s in ("BTC", "ETH", "WTI"):\n            scores[s] -= .06\n    elif breadth > .67:\n        for s in ("SPX", "NDX", "SOX", "000300.SH"):\n            scores[s] += .04\n    avg_vol = float(np.mean(list(vols.values())))\n    raw = {s: max(scores[s], .03) * (.80 + .20 * avg_vol / max(vols[s], .008)) for s in UNIVERSE}\n    targets = capped_simplex(raw)\n    forecasts = {s: float(.06 * (scores[s] - .5)) for s in UNIVERSE}\n    if set(targets) == set(UNIVERSE) and all(np.isfinite(v) and v >= 0 for v in targets.values()) and abs(sum(targets.values()) - 1.0) < 1e-8:\n        rebalance_to_weights(targets, forecast_returns=forecasts, factor_ids=FACTOR_IDS, horizon_days=10)\n        last_decision = decision\n', 'file_path': 'strategy.py'})Traceback (most recent call last):
