    "miner_3_20270603_common_beta_40d",
    "miner_1_20260910_vix_regime_conditioned_momentum_20d",
]
FACTOR_WEIGHTS = np.array([.30, .16, .15, .14, .11, .08, .06])
_days_to_rebalance = 0


def cs_rank(x, names):
    valid = sorted((float(x[s]), s) for s in names if np.isfinite(x.get(s, np.nan)))
    ans = {s: .5 for s in UNIVERSE}
    n = len(valid)
    for i, (_, s) in enumerate(valid):
        ans[s] = (i + 1) / max(n, 1)
    return ans


def make_weights(score, vol, stress):
    # Full investment is required. In stress, defensive tradable proxies are
    # favored and high-beta commodities/crypto are explicitly capped by tilts.
    tilt = {s: 1.0 for s in UNIVERSE}
    if stress:
        tilt.update({"XAU": 3.0, "US10Y": 2.6, "CN10Y": 2.2,
                     "COPPER": .35, "WTI": .08, "BTC": .05, "ETH": .05})
    raw = {s: tilt[s] * (.45 + score[s]) / max(vol.get(s, .02), .008) ** .30
           for s in UNIVERSE}
    raw = {s: max(float(v), .001) for s, v in raw.items()}
    w = {s: raw[s] / sum(raw.values()) for s in UNIVERSE}
    cap = .12 if stress else .16
    for _ in range(40):
        over = [s for s in UNIVERSE if w[s] > cap + 1e-12]
        if not over:
            break
        excess = sum(w[s] - cap for s in over)
        for s in over:
            w[s] = cap
        free = [s for s in UNIVERSE if s not in over]
        den = sum(w[s] for s in free)
        if not free or den <= 0:
            break
        for s in free:
            w[s] += excess * w[s] / den
    z = sum(w.values())
    return {s: max(0.0, w[s] / z) for s in UNIVERSE}


@register_hook
def cross_asset_strategy():
    global _days_to_rebalance
    if _days_to_rebalance:
        _days_to_rebalance -= 1
        return

    close, returns, vol = {}, {}, {}
    for s in UNIVERSE:
        df = get_stock_daily_data(symbol=s, days=230)
        if df is None or len(df) < 80:
            continue
        c = np.asarray(df.sort_values("date")["close"], dtype=float)
        if len(c) >= 65 and np.all(np.isfinite(c)) and np.all(c > 0):
            close[s] = c
            returns[s] = c[1:] / c[:-1] - 1.0
            vol[s] = max(float(np.std(returns[s][-30:])), .008)
    names = [s for s in UNIVERSE if s in close]
    if len(names) < 12:
        return

    r10 = {s: close[s][-1] / close[s][-11] - 1 for s in names}
    r20 = {s: close[s][-1] / close[s][-21] - 1 for s in names}
    r40 = {s: close[s][-1] / close[s][-41] - 1 for s in names}
    peer = np.mean([returns[s][-20:] for s in names], axis=0)
    vix_state = 0.0
    vd = get_index_daily_data(symbol="VIX", days=45)
    if vd is not None and len(vd) >= 22:
        vc = np.asarray(vd.sort_values("date")["close"], dtype=float)
        vix_state = vc[-1] / max(float(np.median(vc[-21:])), 1e-9) - 1
    breadth = np.mean([r20[s] > 0 for s in names])
    market = r20.get("SPX", float(np.median(list(r20.values()))))
    stress = market < -.05 or breadth < .40 or np.mean(list(vol.values())) > .022 or vix_state > .15

    factors = [dict() for _ in FACTOR_IDS]
    for s in names:
        d = returns[s]
        downside = max(float(np.std(np.minimum(d[-40:], 0))), .006)
        beta = float(np.cov(d[-20:], peer)[0, 1] / max(np.var(peer), 1e-8))
        peer20 = float(np.median([r20[x] for x in names if x != s]))
        residual = r20[s] - beta * peer20
        # Efficient trend combines persistent 10/20-day direction with a
        # penalty for choppy paths; all features use completed data only.
        path_eff = abs(r20[s]) / max(float(np.sum(np.abs(d[-20:]))), .01)
        factors[0][s] = (0.35 * r10[s] + 0.65 * r20[s]) * path_eff * (1 + max(vix_state, 0))
        factors[1][s] = r20[s] / downside
        factors[2][s] = residual * (1 + .7 * max(vix_state, 0))
        factors[3][s] = residual / max(vol[s] * (1 + abs(beta)), .01)
        factors[4][s] = r20[s] / max(vol[s] * (1 + max(beta, 0) * max(vix_state, 0)), .01)
        factors[5][s] = (-beta if stress else beta) + .15 * r40[s] / max(vol[s], .01)
        factors[6][s] = r20[s] * (1 + max(vix_state, 0)) / max(vol[s], .01)
    ranks = [cs_rank(f, names) for f in factors]
    score = {s: sum(w * rank[s] for w, rank in zip(FACTOR_WEIGHTS, ranks)) for s in UNIVERSE}
    if stress:
        for s, boost in (("XAU", .20), ("US10Y", .16), ("CN10Y", .12)):
            score[s] += boost
        for s in ("BTC", "ETH", "WTI", "COPPER"):
            score[s] -= .16
    target = make_weights(score, vol, stress)

    account = get_account_dict()
    assets = max(float(account.get("total_assets", 0)), 1.0)
    old = {s: 0.0 for s in UNIVERSE}
    for p in account.get("positions", []):
        s = p.get("symbol")
        if s in old and float(p.get("quantity", 0)) > 0:
            old[s] = max(float(p.get("market_value", 0)), 0.0) / assets
    if sum(old.values()) > .05:
        z = sum(old.values())
        old = {s: old[s] / z for s in UNIVERSE}
        # Migration damping controls turnover while preserving a complete target.
        target = {s: .30 * target[s] + .70 * old[s] for s in UNIVERSE}
    z = sum(target.values())
    target = {s: target[s] / z for s in UNIVERSE}
    forecast = {s: .004 * (score[s] - .5) for s in UNIVERSE}
    rebalance_to_weights(target, forecast_returns=forecast, factor_ids=FACTOR_IDS, horizon_days=10)
    _days_to_rebalance = 9


assert len(UNIVERSE) == 15 and len(FACTOR_IDS) <= 10
assert not set(UNIVERSE).intersection({"DXY", "USDCNY", "USDJPY", "EURUSD", "VIX"})


