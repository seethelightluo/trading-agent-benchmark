  ▶️ write_file({'content': 'import numpy as np\nfrom alphacrafter.sim.utils import (register_hook, get_stock_daily_data,\n    get_index_daily_data, get_account_dict, rebalance_to_weights)\n\nUNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]\n# Current screener ensemble: capped at ten active factors, all direction +1.\nFACTOR_IDS = [\n "miner_1_20280629_stable_volatility_trend_20d",\n "miner_1_20280323_vix_conditioned_efficiency_trend",\n "miner_3_20261119_stress_conditioned_residual_20d",\n "miner_2_20261217_residual_beta_volscaled_20d",\n "miner_1_20260730_vix_state_reversal_5d",\n "miner_3_20261105_downside_risk_adjusted_momentum",\n "miner_3_20280210_drawdown_recovery_acceleration_20d",\n "miner_3_20280727_multihorizon_consistency_20d",\n "miner_1_20281005_vix_shock_resilient_momentum_20d",\n "miner_3_20280907_downside_asymmetry_quality_30d"]\nFACTOR_WEIGHTS = np.array([.20,.16,.15,.14,.12,.10,.07,.04,.01,.01])\n_gate = 0\n\ndef rank(values, names):\n    good = sorted((float(values[s]), s) for s in names if np.isfinite(values.get(s, np.nan)))\n    out = {s:.5 for s in UNIVERSE}\n    for i,(_,s) in enumerate(good): out[s] = (i+1)/max(len(good),1)\n    return out\n\ndef weights(score, vol, stress):\n    tilt = {s:1.0 for s in UNIVERSE}\n    if stress:\n        tilt.update({"XAU":3.0,"US10Y":2.7,"CN10Y":2.3,"BTC":.10,"ETH":.10,"WTI":.28,"COPPER":.45})\n    raw = {s: tilt[s]*(.20+score[s])/max(vol.get(s,.02),.008)**.25 for s in UNIVERSE}\n    w = {s:max(raw[s],.001) for s in UNIVERSE}; cap = .15 if stress else .18\n    for _ in range(30):\n        over=[s for s in UNIVERSE if w[s]>cap]\n        if not over: break\n        excess=sum(w[s]-cap for s in over)\n        for s in over: w[s]=cap\n        free=[s for s in UNIVERSE if s not in over]; z=sum(w[s] for s in free)\n        for s in free: w[s]+=excess*w[s]/max(z,1e-12)\n    z=sum(w.values()); return {s:w[s]/z for s in UNIVERSE}\n\n@register_hook\ndef cross_asset_strategy():\n    global _gate\n    if _gate:\n        _gate -= 1; return\n    close={}; daily={}; vol={}\n    for s in UNIVERSE:\n        df=get_stock_daily_data(symbol=s, days=240)\n        if df is None or len(df)<90: continue\n        c=np.asarray(df.sort_values("date")["close"],dtype=float)\n        if len(c)>=70 and np.all(np.isfinite(c)) and np.all(c>0):\n            close[s]=c; daily[s]=c[1:]/c[:-1]-1; vol[s]=max(float(np.std(daily[s][-30:])),.008)\n    names=[s for s in UNIVERSE if s in close]\n    if len(names)<12: return\n    ret={s:{k:close[s][-1]/close[s][-(k+1)]-1 for k in (5,10,20,60)} for s in names}\n    peer=np.mean([daily[s][-20:] for s in names],axis=0)\n    breadth=np.mean([ret[s][20]>0 for s in names]); market=ret.get("SPX",{20:np.median([ret[s][20] for s in names])})[20]\n    vx=0.; vdf=get_index_daily_data(symbol="VIX",days=45)\n    if vdf is not None and len(vdf)>=22:\n        vc=np.asarray(vdf.sort_values("date")["close"],dtype=float); vx=vc[-1]/max(float(np.median(vc[-21:])),1e-9)-1\n    stress=market<-.05 or breadth<.40 or np.mean(list(vol.values()))>.022 or vx>.15\n    f=[{} for _ in FACTOR_IDS]\n    for s in names:\n        d=daily[s]; down=max(float(np.std(np.minimum(d[-40:],0))),.006)\n        beta=float(np.cov(d[-20:],peer)[0,1]/max(np.var(peer),1e-8))\n        residual=ret[s][20]-beta*np.median([ret[t][20] for t in names if t!=s])\n        trend=.35*ret[s][10]+.65*ret[s][20]; eff=abs(ret[s][20])/max(float(np.sum(abs(d[-20:]))),.01)\n        f[0][s]=trend/max(vol[s],.01); f[1][s]=trend*eff*(1+max(vx,0))\n        f[2][s]=residual*(1+.7*max(vx,0)); f[3][s]=residual/max(vol[s]*(1+max(beta,0)),.01)\n        f[4][s]=(ret[s][5]-ret[s][20]/4)/max(vol[s],.01); f[5][s]=ret[s][20]/down\n        peak=max(close[s][-61:-1]); trough=min(close[s][-61:-1]); rec=(close[s][-1]-trough)/max(peak-trough,1e-9)\n        f[6][s]=.5*ret[s][20]+.3*ret[s][10]+.2*rec; f[7][s]=(.45*ret[s][20]+.35*ret[s][60]+.2*ret[s][10])/max(vol[s],.01)\n        f[8][s]=trend/max(vol[s],.01); pos=np.maximum(d[-30:],0); neg=np.minimum(d[-30:],0)\n        f[9][s]=(float(np.mean(pos))+1e-6)/(abs(float(np.mean(neg)))+1e-4)*(.5+.5*rec)\n    rk=[rank(x,names) for x in f]; score={s:sum(w*r[s] for w,r in zip(FACTOR_WEIGHTS,rk)) for s in UNIVERSE}\n    if stress:\n        for s,a in (("XAU",.16),("US10Y",.13),("CN10Y",.10)): score[s]+=a\n        for s in ("BTC","ETH","WTI","COPPER"): score[s]-=.10\n    target=weights(score,vol,stress); account=get_account_dict(); assets=max(float(account.get("total_assets",0)),1.)\n    old={s:0. for s in UNIVERSE}\n    for p in account.get("positions",[]):\n        s=p.get("symbol")\n        if s in old and float(p.get("quantity",0))>0: old[s]=max(float(p.get("market_value",0)),0.)/assets\n    if sum(old.values())>.001:\n        target={s:.40*target[s]+.60*old[s] for s in UNIVERSE}; z=sum(target.values()); target={s:target[s]/z for s in UNIVERSE}\n    forecast={s:.008*(score[s]-.5) for s in UNIVERSE}\n    rebalance_to_weights(target,forecast_returns=forecast,factor_ids=FACTOR_IDS,horizon_days=10); _gate=9\n', 'file_path': 'strategy.py'})
