excess * w[s] / max(denom, 1e-12)\n    total = sum(w.values())\n    return {s: max(0., w[s] / total) for s in UNIVERSE}\n\n\n@register_hook\ndef cross_asset_strategy():\n    global _days_to_rebalance\n    if _days_to_rebalance:\n        _days_to_rebalance -= 1\n        return\n\n    prices, rets, vol = {}, {}, {}\n    for s in UNIVERSE:\n        df = get_stock_daily_data(symbol=s, days=230)\n        if df is None or len(df) < 80:\n            continue\n        close = np.asarray(df.sort_values("date")["close"], dtype=float)\n        if np.all(np.isfinite(close)) and np.all(close > 0):\n            prices[s] = close\n            rets[s] = close[1:] / close[:-1] - 1.\n            vol[s] = max(float(np.std(rets[s][-30:])), .008)\n    symbols = [s for s in UNIVERSE if s in prices]\n    if len(symbols) < 12:\n        return\n\n    r5 = {s: prices[s][-1] / prices[s][-6] - 1. for s in symbols}\n    r20 = {s: prices[s][-1] / prices[s][-21] - 1. for s in symbols}\n    r60 = {s: prices[s][-1] / prices[s][-61] - 1. for s in symbols}\n    peer = np.mean([rets[s][-20:] for s in symbols], axis=0)\n    vix_state = 0.\n    vix = get_index_daily_data(symbol="VIX", days=40)\n    if vix is not None and len(vix) >= 22:\n        vc = np.asarray(vix.sort_values("date")["close"], dtype=float)\n        vix_state = vc[-1] / max(np.median(vc[-21:]), 1e-9) - 1.\n    breadth = np.mean([r20[s] > 0 for s in symbols])\n    defensive = ((r20.get("SPX", 0.) < 0 and r5.get("SPX", 0.) < 0) or\n                 breadth < .45 or np.mean(list(vol.values())) > .022 or vix_state > .15)\n\n    factors = [dict() for _ in FACTOR_WEIGHTS]\n    for s in symbols:\n        d = rets[s]\n        downside = max(float(np.std(np.minimum(d[-40:], 0.))), .006)\n        beta = float(np.cov(d[-20:], peer)[0, 1] / max(np.var(peer), 1e-8))\n        peer_med = np.median([r20[x] for x in symbols if x != s])\n        residual = r20[s] - beta * peer_med\n        stress = 1. + max(vix_state, 0.)\n        factors[0][s] = -r5[s] * stress / vol[s]                 # VIX reversal\n        factors[1][s] = r20[s] / downside                     # downside momentum\n        factors[2][s] = residual / vol[s]                      # stress residual\n        factors[3][s] = residual / max(vol[s], .01)             # residual vol-scaled\n        factors[4][s] = r20[s] / vol[s] / (1. + max(vix_state, 0.) * max(beta, 0.))\n        factors[5][s] = -r5[s] * stress                         # conditioned CLV proxy\n        factors[6][s] = (r20[s] - .5 * r60[s]) / vol[s]\n        peak = max(prices[s][-61:-1])\n        factors[7][s] = r20[s] - .5 * (prices[s][-1] / peak - 1.)\n    ranks = [rank_factor(f) for f in factors]\n    score = {s: sum(w * r[s] for w, r in zip(FACTOR_WEIGHTS, ranks)) for s in UNIVERSE}\n    if defensive:\n        for s in ("XAU", "US10Y", "CN10Y"): score[s] += .18\n        for s in ("BTC", "ETH", "WTI"): score[s] -= .10\n    target = capped_weights(score, vol, defensive)\n    forecast = {s: max(.0001, .025 * (score[s] - .5)) for s in UNIVERSE}\n    rebalance_to_weights(target, forecast_returns=forecast, factor_ids=FACTOR_IDS, horizon_days=10)\n    _days_to_rebalance = 9\n', 'file_path': 'strategy.py'})
