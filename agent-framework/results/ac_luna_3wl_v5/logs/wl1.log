 / total for s in UNIVERSE}\n\n@register_hook\ndef cross_asset_strategy():\n    global _days_to_decision\n    if _days_to_decision > 0:\n        _days_to_decision -= 1\n        return\n\n    prices = {}\n    for s in UNIVERSE:\n        df = get_stock_daily_data(symbol=s, days=150)\n        if df is not None and len(df) >= 45:\n            prices[s] = np.asarray(df.sort_values("date")["close"], dtype=float)\n    if len(prices) < 12:\n        return\n\n    ret10 = {s: c[-1] / max(c[-11], 1e-12) - 1.0 for s, c in prices.items()}\n    median10 = float(np.median(list(ret10.values())))\n    factors = {k: {} for k in FACTOR_WEIGHTS}\n    vols = {}\n    dispersion = max(float(np.std(list(ret10.values()))), .001)\n    for s, c in prices.items():\n        d = c[1:] / np.maximum(c[:-1], 1e-12) - 1.0\n        vol = max(float(np.std(d[-20:])), .008)\n        vols[s] = vol\n        last = float(d[-1])\n        rev5 = -float(np.mean(d[-5:]))\n        stress = np.clip(vol / .018, .5, 2.0)\n        factors["vix"][s] = rev5 * stress\n        factors["clv"][s] = -.65 * last * stress - .35 * rev5\n        factors["rvolmom"][s] = (ret10[s] - median10) / vol\n        factors["volmom"][s] = ret10[s] / vol\n        path = max(float(np.sum(np.abs(d[-10:]))), .01)\n        factors["trend"][s] = ret10[s] / path\n        factors["resid"][s] = ret10[s] - median10\n        downside = max(float(np.std(np.minimum(d[-30:], 0.))), .006)\n        factors["downmom"][s] = (c[-1] / max(c[-21], 1e-12) - 1.0) / downside\n        factors["path"][s] = factors["trend"][s]\n        shock = -last * np.clip(abs(last) / (vol + .002), 0., 3.)\n        factors["shock"][s] = .6 * (ret10[s] - median10) + .4 * shock\n        factors["disp"][s] = -last * dispersion / max(vol, .008)\n\n    score = {s: sum(FACTOR_WEIGHTS[k] * rank_factor(factors[k])[s]\n                    for k in FACTOR_WEIGHTS) for s in UNIVERSE}\n    breadth = float(np.mean([c[-1] > c[-21] for c in prices.values()]))\n    spx = prices.get("SPX")\n    bear = spx is not None and spx[-1] < spx[-21] and spx[-1] < spx[-6]\n    if bear or breadth < .40:\n        for s in ("XAU", "US10Y", "CN10Y"):\n            score[s] += .12\n        for s in ("BTC", "ETH", "WTI"):\n            score[s] -= .05\n    elif breadth > .67:\n        for s in ("SPX", "NDX", "SOX", "000300.SH"):\n            score[s] += .035\n\n    avgvol = float(np.mean(list(vols.values())))\n    raw = {s: max(score[s], .03) * (.85 + .15 * avgvol / max(vols[s], .008))\n           for s in UNIVERSE}\n    targets = bounded_weights(raw)\n    forecasts = {s: .06 * (score[s] - .5) for s in UNIVERSE}\n    rebalance_to_weights(targets, forecast_returns=forecasts,\n                         factor_ids=FACTOR_IDS, horizon_days=10)\n    _days_to_decision = 9\n', 'file_path': 'strategy.py'})Traceback (most recent call last):
