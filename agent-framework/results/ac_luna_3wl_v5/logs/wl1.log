  ▶️ write_file({'content': 'import numpy as np\nfrom alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights\n\nUNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]\nFACTOR_IDS = [\n    "miner_1_20260910_vix_regime_conditioned_momentum_20d",\n    "miner_3_20260827_momentum_acceleration_20d_20d",\n    "miner_1_20260730_vix_state_reversal_5d",\n    "miner_2_20260730_volscaled_momentum_cycle_20d",\n    "miner_1_20260813_downside_sortino_momentum_20d",\n    "miner_1_20260827_medium_downside_momentum_30d",\n    "miner_1_20260730_residual_vol_scaled_momentum_10d",\n    "miner_3_20260730_trend_efficiency_10d",\n    "miner_2_20260827_path_consistency_momentum_20d",\n    "miner_2_20260910_relative_strength_persistence_20d",\n]\nFACTOR_W = (.16, .15, .12, .12, .10, .10, .09, .07, .05, .04)\n_gate = 0\n\ndef rank(vals):\n    good = sorted((s, v) for s, v in vals.items() if np.isfinite(v))\n    out = {s: .5 for s in UNIVERSE}\n    n = max(1, len(good))\n    for i, (s, _) in enumerate(good):\n        out[s] = (i + 1.) / n\n    return out\n\ndef bounded_weights(score):\n    # Keep diversification meaningful in a 15-asset universe: 3%-14% bounds.\n    lo, hi = .03, .14\n    raw = {s: max(.05, float(score.get(s, .5))) for s in UNIVERSE}\n    w = {s: lo + (hi - lo) * raw[s] for s in UNIVERSE}\n    for _ in range(20):\n        fixed = [s for s in UNIVERSE if w[s] >= hi - 1e-10]\n        if not fixed:\n            break\n        for s in fixed: w[s] = hi\n        free = [s for s in UNIVERSE if s not in fixed]\n        rem = 1. - sum(w[s] for s in fixed) - lo * 0\n        base = sum(w[s] for s in free)\n        if base <= 0: break\n        for s in free: w[s] *= max(0., (1. - sum(w[x] for x in fixed)) / base)\n    z = sum(w.values())\n    return {s: max(0., w[s] / z) for s in UNIVERSE}\n\n@register_hook\ndef cross_asset_strategy():\n    global _gate\n    if _gate:\n        _gate -= 1\n        return\n    px = {}\n    for s in UNIVERSE:\n        df = get_stock_daily_data(symbol=s, days=190)\n        if df is None or len(df) < 70: continue\n        c = np.asarray(df.sort_values("date")["close"], dtype=float)\n        if len(c) >= 70 and np.all(np.isfinite(c)) and np.all(c > 0): px[s] = c\n    if len(px) < 12: return\n    ret = {s: px[s][1:] / px[s][:-1] - 1. for s in px}\n    r = lambda s, n: px[s][-1] / px[s][-n-1] - 1.\n    r10 = {s:r(s,10) for s in px}; r20 = {s:r(s,20) for s in px}\n    r30 = {s:r(s,30) for s in px}; r60 = {s:r(s,60) for s in px}\n    vol = {s:max(float(np.std(ret[s][-30:])), .008) for s in px}\n    med10, med20 = np.median(list(r10.values())), np.median(list(r20.values()))\n    fs = [{ } for _ in FACTOR_W]\n    for s in px:\n        d, v = ret[s], vol[s]\n        downside = max(float(np.std(np.minimum(d[-40:], 0.))), .006)\n        # Stress proxy: broad dispersion/high volatility. Reverse short-term momentum then.\n        stress = np.mean(list(vol.values())) > .022 or np.std(list(r20.values())) > .10\n        fs[0][s] = (-r20[s] if stress else r20[s]) / v\n        fs[1][s] = (r20[s] - r60[s] / 3.) / v\n        fs[2][s] = (-.7*np.mean(d[-5:]) - .3*np.mean(d[-2:])) / v\n        fs[3][s] = (.65*r20[s] + .35*r60[s]) / v\n        fs[4][s] = r20[s] / downside\n        fs[5][s] = r30[s] / max(float(np.std(np.minimum(d[-60:], 0.))), .006)\n        fs[6][s] = (r10[s] - med10) / v\n        fs[7][s] = r10[s] / max(float(np.sum(np.abs(d[-10:]))), .02)\n        fs[8][s] = r20[s] * (np.mean(np.sign(d[-20:])) + 1.) / (2.*v)\n        fs[9][s] = .6*(r20[s] - med20)/v + .4*(r10[s] - med10)/v\n    score = {s:sum(w*rank(f)[s] for w, f in zip(FACTOR_W, fs)) for s in UNIVERSE}\n    breadth = np.mean([r20[s] > 0 for s in px])\n    bear = "SPX" in px and r("SPX",20) < 0 and r("SPX",10) < 0\n    if bear or breadth < .45:\n        for s in ("XAU", "US10Y", "CN10Y"): score[s] += .14\n        for s in ("BTC", "ETH", "WTI"): score[s] -= .07\n    # Volatility-aware sizing, but retain full investment and defensive assets.\n    av = np.mean(list(vol.values()))\n    score = {s:max(.05, score[s]) * (.90 + .10*av/max(vol.get(s, av), .008)) for s in UNIVERSE}\n    targets = bounded_weights(score)\n    forecasts = {s:max(0., .03*(score[s]-.5)) for s in UNIVERSE}\n    rebalance_to_weights(targets, forecast_returns=forecasts, factor_ids=FACTOR_IDS, horizon_days=10)\n    _gate = 9\n', 'file_path': 'strategy.py'})
