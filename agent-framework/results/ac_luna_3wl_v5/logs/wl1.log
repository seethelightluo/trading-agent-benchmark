ICIR',a.mean()/a.std(ddof=1),'hit',np.mean(a>0))\nprint('turnover',np.mean(turns))\nfor y in sorted(set(d.year for d in dates[10])):\n    a=np.array([v for v,d in zip(rows[10],dates[10]) if d.year==y]); print(y,round(a.mean(),6),len(a))\n", 'file_path': 'scripts/miner_2_20261105_downside_volatility.py'})
