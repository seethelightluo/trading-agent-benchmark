  ▶️ write_file({'content': 'import numpy as np\nfrom alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights\n\nUNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]\n# Exactly the ten factors supplied by the screener; calculations below are deliberately\n# compact proxies using only completed daily bars.\nFACTOR_IDS = [\n "miner_1_20260730_volatility_scaled_momentum_cycle_20d",\n "miner_1_20260730_residual_vol_scaled_momentum_10d",\n "miner_1_20260813_downside_sortino_momentum_20d",\n "miner_3_20260730_vol_adjusted_momentum_10d",\n "miner_1_20260730_vix_state_reversal_5d",\n "miner_3_20260730_trend_efficiency_10d",\n "miner_2_20260730_residual_momentum_10d",\n "miner_1_20260730_downside_quality_momentum_10d",\n "miner_1_20260730_residual_shock_blend_10d",\n "miner_1_20260730_dispersion_conditioned_reversal_1d"]\n# Screener weights, grouped only to reduce redundant implementation noise.\nW = {"cycle":.16, "rvm":.13, "sortino":.12, "vam":.12, "rev":.11,\n     "eff":.10, "rm":.09, "dqm":.08, "shock":.06, "disp":.03}\n_next = 0\n\ndef rank(values):\n    good = sorted((s, v) for s, v in values.items() if np.isfinite(v))\n    out = {s:.5 for s in UNIVERSE}\n    n = len(good)\n    for i, (s, _) in enumerate(good): out[s] = (i + 1.) / max(n, 1)\n    return out\n\ndef bounded_weights(score, lo=.025, hi=.14):\n    # Rank scores into a positive, fully invested portfolio, then clip and\n    # redistribute excess. This is stable with the 15-name benchmark universe.\n    raw = {s: max(0.05, float(score.get(s, .5))) for s in UNIVERSE}\n    w = {s: lo + (hi-lo) * raw[s] / max(max(raw.values()), 1e-12) for s in UNIVERSE}\n    for _ in range(20):\n        excess = sum(max(0., x-hi) for x in w.values()) + sum(min(0., x-lo) for x in w.values())\n        over = [s for s in UNIVERSE if w[s] > hi+1e-12]\n        under = [s for s in UNIVERSE if w[s] < hi-1e-12]\n        if not over: break\n        w = {s: min(hi, w[s]) for s in UNIVERSE}\n        rem = 1.-sum(w.values())\n        z = sum(raw[s] for s in under)\n        for s in under: w[s] += rem*raw[s]/max(z,1e-12)\n    z = sum(w.values())\n    return {s: float(max(lo, w[s]/z)) for s in UNIVERSE}\n\n@register_hook\ndef cross_asset_strategy():\n    global _next\n    if _next > 0:\n        _next -= 1\n        return\n    prices = {}\n    for s in UNIVERSE:\n        df = get_stock_daily_data(symbol=s, days=180)\n        if df is not None and len(df) >= 65:\n            c = np.asarray(df.sort_values("date")["close"], dtype=float)\n            if np.all(np.isfinite(c)) and np.all(c > 0): prices[s] = c\n    if len(prices) < 12:\n        return\n    ret = {s: c[1:]/c[:-1]-1. for s,c in prices.items()}\n    r10 = {s:c[-1]/c[-11]-1. for s,c in prices.items()}\n    r20 = {s:c[-1]/c[-21]-1. for s,c in prices.items()}\n    r60 = {s:c[-1]/c[-61]-1. for s,c in prices.items()}\n    vol = {s:max(np.std(ret[s][-30:]), .008) for s in prices}\n    med10, med20 = np.median(list(r10.values())), np.median(list(r20.values()))\n    dispersion = max(np.std(list(r10.values())), .002)\n    fac = {k:{} for k in W}\n    for s in prices:\n        d, v = ret[s], vol[s]\n        neg = np.minimum(d[-40:], 0.)\n        downvol = max(np.std(neg), .006)\n        efficiency = r20[s]/max(np.sum(np.abs(d[-20:])), .02)\n        fac["cycle"][s] = (.6*r20[s]+.4*r60[s])/v\n        fac["rvm"][s] = (r10[s]-med10)/v\n        fac["sortino"][s] = r20[s]/downvol\n        fac["vam"][s] = (.65*r10[s]+.35*r20[s])/v\n        fac["rev"][s] = (-.35*np.mean(d[-3:])-.65*np.mean(d[-5:]))/v\n        fac["eff"][s] = efficiency\n        fac["rm"][s] = (.5*r10[s]+.5*r20[s]-.25*med20)/v\n        fac["dqm"][s] = r20[s]/max(np.std(np.minimum(d[-30:],0.)), .006)\n        fac["shock"][s] = .6*(r10[s]-med10)/v - .4*d[-1]*min(abs(d[-1])/v, 2.)\n        fac["disp"][s] = -d[-1]*dispersion/v\n    ranks = {k:rank(x) for k,x in fac.items()}\n    score = {s:sum(W[k]*ranks[k][s] for k in W) for s in UNIVERSE}\n    breadth = np.mean([r20[s] > 0 for s in prices])\n    spx = prices.get("SPX")\n    bear = spx is not None and spx[-1] < spx[-21] and spx[-1] < spx[-6]\n    if bear or breadth < .45:\n        for s in ("XAU", "US10Y", "CN10Y"): score[s] += .16\n        for s in ("BTC", "ETH", "WTI"): score[s] -= .08\n    # Mild inverse-volatility overlay, not a cash sleeve.\n    avgvol = np.mean(list(vol.values()))\n    raw = {s: max(.05, score[s])*(.9+.1*avgvol/vol[s]) for s in UNIVERSE}\n    targets = bounded_weights(raw)\n    forecasts = {s:max(0., .04*(score[s]-.5)) for s in UNIVERSE}\n    rebalance_to_weights(targets, forecast_returns=forecasts, factor_ids=FACTOR_IDS, horizon_days=10)\n    _next = 9\n', 'file_path': 'strategy.py'})
