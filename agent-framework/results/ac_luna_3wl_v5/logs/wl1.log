        f[5][s] = (.55 * ret[s][20] + .45 * ret[s][40]) / max(downside, .006)
        f[6][s] = (.35 * ret[s][10] + .65 * ret[s][20]) / max(vol[s], .01)
        # Breadth-volatility quality favors persistent, efficient advances.
        f[7][s] = (.5 * ret[s][40] + .5 * ret[s][20]) * efficiency / max(vol[s], .01)
        f[8][s] = -ret[s][5] / max(vol[s], .01)

