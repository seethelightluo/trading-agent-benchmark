  ▶️ write_file({'content': "import os, sys\nimport numpy as np, pandas as pd\nfrom alphacrafter.sim.utils import get_index_daily_data\n\nU=['000300.SH','SPX','HSI','N225','SX5E','000688.SH','SOX','NDX','XAU','COPPER','WTI','BTC','ETH','US10Y','CN10Y']\n# Defensive relative-strength: medium horizon excess return, discounted by downside participation\nraw={}\nfor s in U:\n    d=get_index_daily_data(s, days=2600)\n    if d is not None and len(d):\n        x=d[['date','close']].copy(); x['date']=pd.to_datetime(x.date); x=x.drop_duplicates('date').set_index('date').close.astype(float)\n        raw[s]=x\np=pd.DataFrame(raw).sort_index()\nr=p.pct_change()\n# signal at t: 20d excess return over cross-sectional median, divided by downside deviation\nmom=p.pct_change(20)\ndown=r.where(r<0).rolling(40,min_periods=15).std()\n# lower downside risk improves score; retain directional excess momentum\nsig=(mom.sub(mom.median(axis=1),axis=0) / (down*np.sqrt(252)+0.02))\n# lag to ensure completed data, and cross-sectional zscore\nsig=sig.shift(1)\nrows=[]\nfor h in [1,5,10,20]:\n    f=sig\n    fr=p.pct_change(h).shift(-h)\n    ics=[]\n    for dt in f.index:\n        a=pd.concat([f.loc[dt],fr.loc[dt]],axis=1).dropna()\n        if len(a)>=8:\n            ics.append((dt,a.iloc[:,0].corr(a.iloc[:,1]),len(a)))\n    z=pd.DataFrame(ics,columns=['date','ic','n']).set_index('date')\n    print(f'H={h} dates={len(z)} avg_n={z.n.mean():.2f} IC={z.ic.mean():.6f} ICIR={z.ic.mean()/z.ic.std(ddof=1):.6f} hit={((z.ic>0).mean()):.3f}')\n    for label, mask in [('2020-25',z.index<'2026-01-01'),('2026+',z.index>='2026-01-01'),('2028+',z.index>='2028-01-01'),('2029YTD',z.index>='2029-01-01')]:\n        q=z.loc[mask]\n        if len(q): print(f'  {label}: n={len(q)} IC={q.ic.mean():.6f} ICIR={q.ic.mean()/q.ic.std(ddof=1):.6f}')\n    if h==1: daily=z\n# artifact for daily admission signal\nout=sig.stack().rename('signal').reset_index(); out.columns=['date','symbol','signal']; out.to_csv('scripts/miner_2_20291018_defensive_relative_strength_signal.csv',index=False)\nprint('coverage=',sig.notna().mean().mean(),'dates=',len(sig),'instruments=',len(U))\n# rank turnover\nrank=sig.rank(axis=1,pct=True); print('turnover=',rank.diff().abs().mean().mean())\nprint('signal_artifact=scripts/miner_2_20291018_defensive_relative_strength_signal.csv')\n", 'file_path': 'scripts/miner_2_20291018_defensive_relative_strength.py'})
