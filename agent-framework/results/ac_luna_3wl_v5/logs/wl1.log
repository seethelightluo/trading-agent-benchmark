bs(beta)), .01)\n        f[3][s] = r20[s] / max(vol[s] * (1 + max(beta, 0) * max(vix_state, 0)), .01)\n        f[4][s] = (r20[s] - r40[s] / 2) / max(vol[s], .01)\n        f[5][s] = residual * (1 + .5 * max(vix_state, 0))\n        f[6][s] = (-beta if defensive else beta) + .20 * r40[s] / max(vol[s], .01)\n        f[7][s] = recovery / max(vol[s], .01)\n    ranks = [rank_cs(x, names) for x in f]\n    score = {s: sum(w * q[s] for w, q in zip(FACTOR_WEIGHTS, ranks)) for s in UNIVERSE}\n    if defensive:\n        for s, add in (("XAU", .15), ("US10Y", .11), ("CN10Y", .08)): score[s] += add\n        for s in ("BTC", "ETH", "WTI"): score[s] -= .14\n    target = capped_weights(score, vol, defensive)\n    account = get_account_dict(); assets = max(float(account.get("total_assets", 0)), 1.0)\n    old = {s: 0.0 for s in UNIVERSE}\n    for p in account.get("positions", []):\n        if p.get("symbol") in old and p.get("quantity", 0) > 0:\n            old[p["symbol"]] += max(float(p.get("market_value", 0)), 0.0) / assets\n    if sum(old.values()) > .05:\n        z = sum(old.values()); old = {s: old[s] / z for s in UNIVERSE}\n        target = {s: .35 * target[s] + .65 * old[s] for s in UNIVERSE}\n    z = sum(target.values()); target = {s: max(0.0, target[s] / z) for s in UNIVERSE}\n    forecast = {s: .006 * (score[s] - .5) for s in UNIVERSE}\n    rebalance_to_weights(target, forecast_returns=forecast, factor_ids=FACTOR_IDS, horizon_days=10)\n    _days_to_rebalance = 9\n\nassert len(UNIVERSE) == 15 and len(FACTOR_IDS) <= 10\nassert not set(UNIVERSE).intersection({"DXY", "USDCNY", "USDJPY", "EURUSD", "VIX"})\nassert abs(sum(capped_weights({s: .5 for s in UNIVERSE}, {}, True).values()) - 1) < 1e-8\n', 'file_path': 'strategy.py'})
