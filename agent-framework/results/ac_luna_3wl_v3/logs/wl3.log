  ▶️ write_file({'content': "import pandas as pd, numpy as np, glob, os\nfrom scipy.stats import spearmanr\nroot='../persistent/index_data'\nsyms=['000300.SH','SPX','HSI','N225','SX5E','000688.SH','SOX','NDX','XAU','COPPER','WTI','BTC','ETH','US10Y','CN10Y']\ndef load(s):\n f=f'{root}/{s}.csv'\n if not os.path.exists(f): return None\n d=pd.read_csv(f); d.date=pd.to_datetime(d.date); return d.set_index('date').close.sort_index()\npx={s:load(s) for s in syms}; dxy=load('DXY')\nrets=pd.DataFrame({s:v.pct_change() for s,v in px.items()}).join(dxy.pct_change().rename('DXY'),how='inner')\n# residual 20d return: trailing regression beta of asset returns to DXY, then residual cumulative return\nrows=[]; ics={h:[] for h in [1,5,10]}; dates={h:[] for h in ics}; vals=[]\nfor i in range(70,len(rets)-10):\n dt=rets.index[i]; hist=rets.iloc[i-60:i]\n for s in syms:\n  x=hist.DXY; y=hist[s]; ok=x.notna()&y.notna()\n  if ok.sum()<45: continue\n  beta=np.cov(y[ok],x[ok],ddof=1)[0,1]/np.var(x[ok],ddof=1) if np.var(x[ok],ddof=1)>1e-12 else 0\n  # residual daily returns, compounded over trailing 20 completed sessions\n  rr=(hist[s]-beta*hist.DXY).iloc[-20:]\n  fac=(1+rr.fillna(0)).prod()-1\n  fut=(1+rets[s].iloc[i+1:i+1+h].fillna(0)).prod()-1\n  vals.append((dt,s,fac)); ics[h].append((dt,s,fac,fut)); dates[h].append(dt)\nfor h in ics:\n df=pd.DataFrame(ics[h],columns=['date','s','f','r'])\n by=df.groupby('date').filter(lambda z:len(z)>=8).groupby('date').apply(lambda z:spearmanr(z.f,z.r).statistic)\n print(h,'dates',len(by),'avgN',df.groupby('date').size().mean(),'IC',by.mean(),'ICIR',by.mean()/by.std(ddof=1),'hit',(by>0).mean())\n# coverage, rank turnover\nv=pd.DataFrame(vals,columns=['date','s','f']).pivot(index='date',columns='s',values='f')\nrank=v.rank(pct=True); turn=(rank-rank.shift()).abs().mean().mean()\nprint('coverage',v.notna().mean().mean(),'turnover',turn,'span',v.index.min(),v.index.max())\n# correlation to existing rough signals: residual momentum vs regular momentum and reversal\nreg=pd.DataFrame({s:px[s].pct_change(20) for s in syms}); rev=-pd.DataFrame({s:px[s].pct_change(5) for s in syms})\na=v.stack(); print('corr regular momentum',a.corr(reg.reindex(v.index).stack()),'corr reversal',a.corr(rev.reindex(v.index).stack()))\n", 'file_path': 'scripts/miner_2_20260730_residual_dxy_momentum.py'})
