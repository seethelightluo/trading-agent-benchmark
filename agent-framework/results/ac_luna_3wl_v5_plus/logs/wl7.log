import json
from pathlib import Path
import numpy as np
from alphacrafter.sim.utils import register_hook, get_stock_daily_data, get_index_daily_data, rebalance_to_weights

UNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
ENSEMBLE = Path(__file__).parent / "factors" / "factor_ensemble.json"
last_decision = None

def load_factors():
    try:
        return json.loads(ENSEMBLE.read_text(encoding="utf-8")).get("selected_factors", [])[:10]
    except Exception:
        return []

def rank(values):
    out = {s: 0.5 for s in UNIVERSE}
    good = sorted((s, v) for s, v in values.items() if np.isfinite(v))
    for i, (s, _) in enumerate(good):
        out[s] = (i + 0.5) / len(good)
    return out

def bounded_weights(raw):
    w = {s: max(float(raw.get(s, 1/15)), 1e-8) for s in UNIVERSE}
    # Iterative 2%-14% bounds, then exact normalization.
    for _ in range(20):
        z = sum(w.values()); w = {s: x/z for s, x in w.items()}
        low = [s for s in UNIVERSE if w[s] < .02]
        high = [s for s in UNIVERSE if w[s] > .14]
        if not low and not high: break
        fixed = set(low + high)
        for s in low: w[s] = .02
        for s in high: w[s] = .14
        free = [s for s in UNIVERSE if s not in fixed]
        rem = 1 - sum(w[s] for s in fixed)
        if free and rem > 0:
            scale = rem / sum(w[s] for s in free)
            for s in free: w[s] *= scale
    z = sum(w.values())
    return {s: w[s]/z for s in UNIVERSE}

@register_hook
def cross_asset_strategy():
    global last_decision
    factors = load_factors()
    if not factors: return
    feats, vols, stamps = {}, {}, {}
    for s in UNIVERSE:
        d = get_stock_daily_data(symbol=s, days=190)
        if d is None or len(d) < 80: continue
        d = d.sort_values("date"); c = np.asarray(d.close, dtype=float)
        if np.any(~np.isfinite(c)) or np.any(c <= 0): continue
        # Every feature ends at t-1; the current incomplete session is excluded.
        r = c[1:] / c[:-1] - 1
        r5, r20, r40 = r[-6:-1], r[-21:-1], r[-41:-1]
        m3, m20 = c[-2]/c[-5]-1, c[-2]/c[-22]-1
        v5 = max(float(np.std(r5)), .008); v20 = max(float(np.std(r20)), .008)
        downside = max(float(np.std(r20[r20 < 0])) if np.sum(r20 < 0)>1 else .008, .008)
        consistency = float(np.mean(r40 > 0)); efficiency = abs(float(np.sum(r20))) / max(float(np.sum(abs(r20))), .008)
        state = np.clip(float(np.std(r40))/v20, .5, 2.)
        feats[s] = {"volstate":m20/v20*state, "breadth":consistency*m20/v20,
                    "trend":consistency*m20/v20, "downside":m20/downside,
                    "range3":m3/v5, "efficiency":m20/v20*efficiency,
                    "asym":-m3/v5}
        vols[s] = max(float(np.std(r[-26:-1])), .008); stamps[s] = str(d.iloc[-1].date)
    if len(feats) < 12: return
    stamp = max(stamps.values())
    if last_decision is not None and (np.datetime64(stamp)-np.datetime64(last_decision))/np.timedelta64(1,'D') < 10: return
    mapping = {"vol_state_momentum":"volstate", "signed_breadth_momentum":"breadth", "trend_consistency_risk_adjusted":"trend", "downside_sortino_momentum":"downside", "range_normalized_3d_reversal":"range3", "range_efficiency_momentum":"efficiency", "asymmetric_volatility_reversal":"asym"}
    score = {s: .5 for s in UNIVERSE}
    for f in factors:
        fid = f.get("factor_id", ""); key = next((v for k,v in mapping.items() if k in fid), None)
        if key is None: continue
        rr = rank({s: f.get("direction",1)*feats[s][key] for s in feats})
        for s in UNIVERSE: score[s] += float(f.get("weight",0))* (rr[s]-.5)
    vd = get_index_daily_data(symbol="VIX", days=65)
    stress = False
    if vd is not None and len(vd)>=32:
        vc=np.asarray(vd.sort_values("date").close,dtype=float); stress=float(vc[-2]/max(np.median(vc[-32:-2]),1e-9))>1.2
    spx = feats.get("SPX")
    if stress or (spx is not None and feats["SPX"]["trend"] < 0):
        for s in ("XAU","US10Y","CN10Y"): score[s] += .10
        for s in ("BTC","ETH","WTI"): score[s] -= .07
    invmean=np.mean([1/vols.get(s,.02) for s in UNIVERSE])
    raw={s:max(score[s],.05)*(.78+.22*(1/vols.get(s,.02))/invmean) for s in UNIVERSE}
    target=bounded_weights(raw); avg=np.mean(list(score.values())); sd=max(float(np.std(list(score.values()))),1e-9)
    forecast={s:float(.01*(score[s]-avg)/sd) for s in UNIVERSE}
    rebalance_to_weights(target, forecast_returns=forecast, factor_ids=[f["factor_id"] for f in factors], horizon_days=10)
    last_decision=stamp

# factor_ensemble.json is read at each hook invocation; no future data is used.

