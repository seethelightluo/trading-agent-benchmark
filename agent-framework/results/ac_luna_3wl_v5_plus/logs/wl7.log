at); vh=bool(q[-2]>1.2*np.median(q[-32:-2]))\n    F={f:{} for f in specs}; lead={}\n    for s,c in C.items():\n        p=c[:-1]; r=R[s][:-1]\n        if len(p)<35:continue\n        r5=p[-1]/p[-6]-1;r10=p[-1]/p[-11]-1;r20=p[-1]/p[-21]-1;r30=p[-1]/p[-31]-1;q=r[-21:];v=max(float(np.std(q)),.008);br=np.mean(q>0); dn=max(float(np.std(q[q<0])),.008) if np.any(q<0) else .008\n        lead[s]=r5; b={'eff':r20/max(np.sum(np.abs(q)),.02),'cons':br*(.5+r20/v),'down':r20/dn,'persist':(.5*r20+.3*r10+.2*r30)/v,'break':(r30+r20)/v,'vix':r20/v*(.7 if vh else 1),'range':r20/max(np.sum(np.abs(q)),.02),'rel':r30/v}\n        for f in specs:\n            key='cons'\n            for needle,k in [('efficiency_trend','eff'),('trend_consistency','cons'),('downside_risk_adjusted_trend','down'),('persistent_trend_quality','persist'),('breakout_persistence','break'),('vix_conditioned_momentum','vix'),('range_efficiency_momentum','range'),('relative_momentum','rel')]:\n                if needle in f:key=k\n            F[f][s]=b[key]\n    med=np.median(list(lead.values())) if lead else 0\n    for f in specs:\n        if 'peer_median_leadlag' in f:F[f]={s:(v-med)/max(V.get(s,.02),.008) for s,v in lead.items()}\n    score={s:.5 for s in U}\n    for f,(wt,di) in specs.items():\n        rr=ranks({s:di*v for s,v in F[f].items()})\n        for s in U:score[s]+=wt*(rr[s]-.5)\n    sp=C.get('SPX'); off=vh or (sp is not None and (sp[-2]<sp[-22] or np.mean(R['SPX'][-7:-2])<0))\n    if off:\n        for s in ['XAU','US10Y','CN10Y']:score[s]+=.10\n        for s in ['BTC','ETH','WTI']:score[s]-=.06\n    im=np.mean([1/max(V.get(s,.02),.008) for s in U]); raw={s:max(score[s],.02)*(.78+.22*(1/max(V.get(s,.02),.008))/im) for s in U}; target=bounded(raw)\n    m=np.mean(list(score.values())); sd=max(float(np.std(list(score.values()))),1e-12); fc={s:float(.01*(score[s]-m)/sd) for s in U}\n    rebalance_to_weights(target,forecast_returns=fc,factor_ids=list(specs),horizon_days=10);last=dec\n\nif __name__=='__main__': print(len(ens()))\n", 'file_path': 'strategy.py'})
