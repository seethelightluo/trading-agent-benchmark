 import json
from pathlib import Path
import numpy as np
from alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights

UNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
ENSEMBLE_PATH = Path(__file__).parent / "factors" / "factor_ensemble.json"
_last_date = None


def _ensemble():
    try:
        return json.loads(ENSEMBLE_PATH.read_text(encoding="utf-8")).get("selected_factors", [])[:10]
    except Exception:
        return []


def _rank(values):
    out = {s: 0.5 for s in UNIVERSE}
    good = sorted((s, v) for s, v in values.items() if np.isfinite(v))
    for i, (s, _) in enumerate(good):
        out[s] = (i + 1) / max(len(good), 1)
    return out


def _bounded(raw):
    # Full investment, diversified 2%-14% asset bounds.
    w = {s: max(float(raw.get(s, 0.0)), 0.0) for s in UNIVERSE}
    z = sum(w.values()) or 1.0
    w = {s: v / z for s, v in w.items()}
    for _ in range(20):
        low = [s for s in UNIVERSE if w[s] < .02]
        high = [s for s in UNIVERSE if w[s] > .14]
        if not low and not high:
            break
        for s in low: w[s] = .02
        for s in high: w[s] = .14
        z = sum(w.values())
        w = {s: v / z for s, v in w.items()}
    # Correct floating point residue without introducing cash.
    w[UNIVERSE[-1]] += 1.0 - sum(w.values())
    return w


@register_hook
def cross_asset_strategy():
    global _last_date
    selected = _ensemble()
    if not selected:
        return
    specs = {x["factor_id"]: (float(x["weight"]), int(x.get("direction", 1))) for x in selected}
    data = {}
    for s in UNIVERSE:
        df = get_stock_daily_data(symbol=s, days=130)
        if df is None or len(df) < 65:
            continue
        df = df.sort_values("date").reset_index(drop=True)
        c = np.asarray(df["close"], dtype=float)
        r = c[1:] / np.maximum(c[:-1], 1e-12) - 1.0
        data[s] = (c, r, str(df.iloc[-1]["date"]))
    if len(data) < 12:
        return
    date = max(x[2] for x in data.values())
    if _last_date is not None and (np.datetime64(date) - np.datetime64(_last_date)) / np.timedelta64(1, "D") < 10:
        return

    vals = {f: {} for f in specs}
    vol = {}
    for s, (c, r, _) in data.items():
        v = max(float(np.std(r[-20:])), .008)
        down = max(float(np.sqrt(np.mean(np.minimum(r[-20:], 0.0) ** 2))), .003)
        ret2, ret5, ret20, ret60 = c[-1]/c[-3]-1, c[-1]/c[-6]-1, c[-1]/c[-21]-1, c[-1]/c[-61]-1
        breadth = float(np.mean(r[-20:] > 0))
        efficiency = ret20 / max(float(np.sum(np.abs(r[-20:]))), 1e-12)
        conditioned = (ret20 / v) * (1.0 + .8*np.sign(ret60)*(breadth-.5))
        features = {
            "miner_3_20261102_conditioned_momentum": conditioned,
            "miner_2_20260827_range_efficiency_momentum": efficiency,
            "miner_1_20270111_breakout_persistence": max(ret20, 0.0) / v + .5*max(ret60, 0.0)/v,
            "miner_3_20270108_trend_consistency_risk_scaled": (ret20 / v) * (0.5 + breadth),
            "miner_1_20270108_persistent_trend_quality_20d": ret20 / v * (0.5 + breadth),
            "miner_3_20261214_relative_momentum_vol_scaled": ret20 / v,
            "miner_2_20261102_downside_risk_adjusted_trend_20d": ret20 / down,
            "miner_3_20261130_asymmetric_volatility_reversal_2d_revalidated": -ret2 / v,
            "miner_3_20261022_smoothed_range_reversal_1d": -(ret2 + ret5/2.0) / v,
        }
        vol[s] = v
        for f in specs:
            vals[f][s] = features.get(f, 0.0)

    score = {s: 0.5 for s in UNIVERSE}
    for f, (weight, direction) in specs.items():
        rr = _rank({s: direction*v for s, v in vals[f].items()})
        for s in UNIVERSE:
            score[s] += weight * (rr[s] - .5)
    spx = data.get("SPX")
    risk_off = spx is not None and (spx[0][-1] < spx[0][-21] or np.mean(spx[1][-5:]) < 0)
    if risk_off:
        for s in ("XAU", "US10Y", "CN10Y"): score[s] += .10
        for s in ("BTC", "ETH", "WTI"): score[s] -= .06
    inv = {s: 1.0 / max(vol.get(s, .02), .008) for s in UNIVERSE}
    avg_inv = np.mean(list(inv.values()))
    raw = {s: max(score[s], .02) * (.78 + .22 * inv[s] / avg_inv) for s in UNIVERSE}
    weights = _bounded(raw)
    mean, stdev = np.mean(list(score.values())), max(float(np.std(list(score.values()))), 1e-12)
    forecast = {s: float(.01 * (score[s] - mean) / stdev) for s in UNIVERSE}
    rebalance_to_weights(weights, forecast_returns=forecast,
                         factor_ids=[x["factor_id"] for x in selected], horizon_days=10)
    _last_date = date

if __name__ == "__main__":
    cross_asset_strategy()

