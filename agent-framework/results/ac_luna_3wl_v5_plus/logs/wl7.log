 import json
from pathlib import Path
import numpy as np
from alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights

UNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
ENSEMBLE_PATH = Path(__file__).parent / "factors" / "factor_ensemble.json"
_last_decision = None


def load_ensemble():
    return json.loads(ENSEMBLE_PATH.read_text(encoding="utf-8")).get("selected_factors", [])[:10]


def rank(values):
    out = {s: 0.5 for s in UNIVERSE}
    good = sorted([(s, float(v)) for s, v in values.items() if np.isfinite(v)], key=lambda z: z[1])
    for i, (s, _) in enumerate(good):
        out[s] = (i + 1) / max(len(good), 1)
    return out


def bounded(raw):
    # High dispersion regime: diversified full investment with moderate caps.
    lo, hi = 0.02, 0.14
    w = {s: max(float(raw.get(s, lo)), 1e-12) for s in UNIVERSE}
    for _ in range(80):
        clipped = {s: min(max(w[s], lo), hi) for s in UNIVERSE}
        fixed = [s for s in UNIVERSE if clipped[s] != w[s]]
        free = [s for s in UNIVERSE if s not in fixed]
        rem = 1.0 - sum(clipped[s] for s in fixed)
        scale = rem / max(sum(w[s] for s in free), 1e-12)
        nw = dict(clipped)
        for s in free: nw[s] = w[s] * scale
        if max(abs(nw[s] - w[s]) for s in UNIVERSE) < 1e-10:
            w = nw
            break
        w = nw
    total = sum(w.values())
    return {s: float(w[s] / total) for s in UNIVERSE}


@register_hook
def cross_asset_strategy():
    global _last_decision
    selected = load_ensemble()
    if not selected:
        return
    specs = {x["factor_id"]: (float(x["weight"]), int(x.get("direction", 1))) for x in selected}
    data = {}
    for s in UNIVERSE:
        df = get_stock_daily_data(symbol=s, days=130)
        if df is None or len(df) < 65:
            continue
        df = df.sort_values("date").reset_index(drop=True)
        c, h, l, v = [np.asarray(df[x], float) for x in ("close", "high", "low", "volume")]
        r = c[1:] / np.maximum(c[:-1], 1e-12) - 1.0
        data[s] = (c, h, l, v, r, str(df.iloc[-1]["date"]))
    if len(data) < 12:
        return
    date = max(x[5] for x in data.values())
    if _last_decision is not None and (np.datetime64(date) - np.datetime64(_last_decision)) / np.timedelta64(1, "D") < 12:
        return

    vals = {fid: {} for fid in specs}
    recent5 = {}
    for s, (c, h, l, v, r, _) in data.items():
        vol = max(float(np.std(r[-20:])), 0.008)
        ret1 = float(r[-1]); ret3 = float(c[-1] / c[-4] - 1); ret5 = float(c[-1] / c[-6] - 1)
        ret20 = float(c[-1] / c[-21] - 1); ret60 = float(c[-1] / c[-61] - 1)
        downside = max(float(np.sqrt(np.mean(np.minimum(r[-20:], 0.0) ** 2))), 0.003)
        efficiency = ret20 / max(float(np.sum(np.abs(r[-20:]))), 1e-12)
        breadth = float(np.mean(r[-20:] > 0))
        clv = (2*c[-1] - h[-1] - l[-1]) / max(h[-1] - l[-1], 1e-12)
        values = {
            "miner_2_20260827_range_efficiency_momentum": efficiency,
            "miner_3_20261102_conditioned_momentum": (ret20 / vol) * (1.0 + 0.8 * np.sign(ret60) * (breadth - .5)),
            "downside_risk_adjusted_trend_20d": ret20 / downside,
            "miner_3_20260716_clv_1d": clv,
            "miner_1_20260716_peer_median_leadlag_5d": ret5,
            "miner_2_20260716_risk_adjusted_momentum_20d": ret20 / vol,
        }
        for fid in specs:
            if fid in values:
                vals[fid][s] = values[fid]
        recent5[s] = ret5
    if "miner_1_20260716_peer_median_leadlag_5d" in vals:
        for s, x in recent5.items():
            peer = [y for t, y in recent5.items() if t != s]
            vals["miner_1_20260716_peer_median_leadlag_5d"][s] = x - np.median(peer)

    score = {s: 0.5 for s in UNIVERSE}
    for fid, (weight, direction) in specs.items():
        ranked = rank({s: direction * x for s, x in vals.get(fid, {}).items()})
        for s in UNIVERSE:
            score[s] += weight * (ranked[s] - .5)

    spx = data.get("SPX")
    risk_off = spx is not None and (spx[0][-1] < spx[0][-21] or np.mean(spx[4][-5:]) < 0)
    if risk_off:
        for s in ("XAU", "US10Y", "CN10Y"):
            score[s] += .10
        for s in ("BTC", "ETH", "WTI"):
            score[s] -= .06

    inv_vol = {s: 1.0 / max(float(np.std(data[s][4][-20:])), .008) for s in data}
    avg_inv = float(np.mean(list(inv_vol.values())))
    raw = {s: max(score[s], .02) * (.78 + .22 * inv_vol.get(s, avg_inv) / max(avg_inv, 1e-12)) for s in UNIVERSE}
    weights = bounded(raw)
    mean, sd = float(np.mean(list(score.values()))), max(float(np.std(list(score.values()))), 1e-12)
    forecast = {s: float(.01 * (score[s] - mean) / sd) for s in UNIVERSE}
    rebalance_to_weights(weights, forecast_returns=forecast, factor_ids=[x["factor_id"] for x in selected], horizon_days=10)
    _last_decision = date


