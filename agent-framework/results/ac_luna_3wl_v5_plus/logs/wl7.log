t(index='date',columns='asset',values='f').rank(axis=1,pct=True)\nprint('turnover',round(float(r.diff().abs().mean().mean()),5))\nq1.to_csv('scripts/miner_1_20270302_range_efficiency_signal.csv',index=False)\n", 'file_path': 'scripts/miner_1_20270302_range_efficiency.py'})
