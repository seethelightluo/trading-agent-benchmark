te.dt.year>=a)&(q.date.dt.year<=b)]))\nr=q.pivot(index='date',columns='asset',values='f').rank(axis=1,pct=True); print('turnover',r.diff().abs().mean().mean()); q.to_csv('scripts/miner_2_20270319_asymmetric_reversal_signal.csv',index=False)\n", 'file_path': 'scripts/miner_2_20270319_asymmetric_reversal.py'})
