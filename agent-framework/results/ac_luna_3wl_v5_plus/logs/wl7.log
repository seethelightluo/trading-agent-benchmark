  ▶️ write_file({'content': "import pandas as pd,numpy as np,os\nfrom scipy.stats import spearmanr\nwatch=['000300.SH','SPX','HSI','N225','SX5E','000688.SH','SOX','NDX','XAU','COPPER','WTI','BTC','ETH','US10Y','CN10Y']; data={}\nfor s in watch:\n p='../persistent/stock_data/'+s+'.csv'\n if os.path.exists(p):\n  d=pd.read_csv(p); d.date=pd.to_datetime(d.date); data[s]=d.set_index('date').sort_index()\nrows=[]\nfor s,d in data.items():\n c=d.close; r=c.pct_change()\n # Recovery velocity: medium-term return rewarded when the asset has recovered\n # promptly from its trailing 60-day low; all inputs are lagged one day.\n low=c.rolling(60).min(); dd=c/low-1\n since_low=c.rolling(60).apply(lambda z: len(z)-1-np.argmin(z),raw=True)\n sig=((c/c.shift(20)-1)/(1+since_low/20.0) * (1+dd).clip(0.5,2.0)).shift(1)\n fwd=c.shift(-10)/c-1\n rows.append(pd.DataFrame({'date':d.index,'s':s,'sig':sig,'fwd':fwd}).dropna())\nx=pd.concat(rows); vals=[]\nfor dt,g in x.groupby('date'):\n if len(g)>=8: vals.append((dt,spearmanr(g.sig,g.fwd).statistic,len(g)))\na=pd.DataFrame(vals,columns=['date','ic','n']).set_index('date')\nprint('dates',len(a),'avg_n',a.n.mean(),'assets',len(data),'coverage',len(x)/sum(len(d) for d in data.values()))\nprint('IC',a.ic.mean(),'ICIR',a.ic.mean()/a.ic.std(ddof=1),'hit',(a.ic>0).mean())\nprint('turnover',x.pivot(index='date',columns='s',values='sig').rank(axis=1,pct=True).diff().abs().mean().mean())\nfor lo,hi in [('2020','2022'),('2023','2024'),('2025','2027')]:\n q=a.loc[lo:hi].ic; print('regime',lo,len(q),q.mean(),q.mean()/q.std(ddof=1) if len(q)>1 else np.nan)\nfor h in [1,5,10,20]:\n z=[]\n for s,d in data.items():\n  c=d.close; low=c.rolling(60).min(); dd=c/low-1; sl=c.rolling(60).apply(lambda q: len(q)-1-np.argmin(q),raw=True)\n  sg=((c/c.shift(20)-1)/(1+sl/20.0)*(1+dd).clip(.5,2)).shift(1); z.append(pd.DataFrame({'date':d.index,'sig':sg,'fwd':c.shift(-h)/c-1}).dropna())\n xx=pd.concat(z); ii=[]\n for dt,g in xx.groupby('date'):\n  if len(g)>=8: ii.append(spearmanr(g.sig,g.fwd).statistic)\n print('decay',h,np.nanmean(ii),len(ii))\nx.pivot(index='date',columns='s',values='sig').to_csv('scripts/miner_1_20270706_recovery_velocity_signal.csv')\n", 'file_path': 'scripts/miner_1_20270706_recovery_velocity.py'})
