);print('horizon',h,'ICIR',a.mean()/a.std(),'IC',a.mean())\nfor lo,hi in [('2020','2022'),('2023','2024'),('2025','2026')]:\n a=ics.loc[lo:hi];print('regime',lo,hi,len(a),a.mean(),a.mean()/a.std())\n", 'file_path': 'scripts/miner_2_20261008_volume_confirmed_momentum.py'})
