")<10:return\n        except Exception:return\n    sig={}\n    for s,(c,_) in data.items():\n        r=c[1:]/c[:-1]-1;r10=r[-11:-1];r20=r[-21:-1];v10=max(float(np.std(r10)),.008);v20=max(float(np.std(r20)),.008);v60=max(float(np.std(r[-61:-1])),.008);neg=r20[r20<0];down=max(float(np.std(neg)) if len(neg)>1 else .008,.008);m20=c[-2]/c[-22]-1;pos=float(np.mean(r20>0))\n        sig[s]={"range":-(c[-2]/c[-3]-1)/v10,"asym":-(c[-2]/c[-4]-1)/v10*(1+max(0.,-m20)/v20),"volume":-(c[-2]/c[-5]-1)/v20,"stress":-(c[-2]/c[-6]-1)/v10,"down":m20/down,"mom":m20/v20*(.5+pos),"volstate":m20/v20*min(2.,v60/v20),"accel":(c[-2]/c[-7]-c[-7]/c[-27])/v20}\n    vix=get_index_daily_data(symbol="VIX",days=65);stress=False\n    if vix is not None and len(vix)>=32:\n        vc=np.asarray(vix.sort_values("date")["close"],float);stress=bool(vc[-2]>1.2*np.median(vc[-32:-2]))\n    score={s:.5 for s in UNIVERSE}\n    for f in selected:\n        fid=f.get("factor_id","");wt=float(f.get("weight",0));direction=int(f.get("direction",1))\n        key=next((k for token,k in [("range_weighted_intraday_reversal","range"),("asymmetric_volatility_reversal","asym"),("volume_confirmed_reversal","volume"),("vix_stress_reversal","stress"),("downside_risk_adjusted_trend","down"),("conditioned_momentum","mom"),("vol_state_momentum","volstate"),("trend_acceleration_vol_scaled","accel")] if token in fid),None)\n        if key:\n            rr=ranks({s:direction*sig[s][key] for s in sig})\n            for s in UNIVERSE:score[s]+=wt*(rr[s]-.5)\n    spx=data.get("SPX",(None,))[0];riskoff=stress or (spx is not None and (spx[-2]<spx[-22] or np.mean(spx[-8:-2]/spx[-9:-3]-1)<0))\n    if riskoff:\n        for s in ("XAU","US10Y","CN10Y"):score[s]+=.10\n        for s in ("BTC","ETH","WTI"):score[s]-=.07\n    inv=np.mean([1/vols.get(s,.02) for s in UNIVERSE]);raw={s:max(score[s],.05)*(.78+.22*(1/vols.get(s,.02))/inv) for s in UNIVERSE};target=cap(raw);mu=np.mean(list(score.values()));sd=max(float(np.std(list(score.values()))),1e-9);forecast={s:float(.01*(score[s]-mu)/sd) for s in UNIVERSE}\n    rebalance_to_weights(target,forecast_returns=forecast,factor_ids=[f["factor_id"] for f in selected],horizon_days=10);last_decision=decision\nif __name__=="__main__":print([f["factor_id"] for f in ensemble()])\n', 'file_path': 'strategy.py'})
