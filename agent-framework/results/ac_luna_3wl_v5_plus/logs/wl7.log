 import json
from pathlib import Path
import numpy as np
from alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights

UNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
ENSEMBLE_PATH = Path(__file__).parent / "factors" / "factor_ensemble.json"
_last_date = None


def _ensemble():
    try:
        x = json.loads(ENSEMBLE_PATH.read_text(encoding="utf-8"))
        return x.get("selected_factors", [])[:10]
    except Exception:
        return []


def _rank(x):
    out = {s: 0.5 for s in UNIVERSE}
    a = sorted((s, v) for s, v in x.items() if np.isfinite(v))
    for i, (s, _) in enumerate(a):
        out[s] = (i + 1.0) / max(len(a), 1)
    return out


def _bounded(raw):
    # Full investment, with a 2%-14% asset range to limit crowded exposures.
    w = {s: max(float(raw.get(s, 0.0)), 0.0) for s in UNIVERSE}
    w = {s: v / (sum(w.values()) or 1.0) for s, v in w.items()}
    for _ in range(20):
        low = [s for s in UNIVERSE if w[s] < .02]
        high = [s for s in UNIVERSE if w[s] > .14]
        if not low and not high:
            break
        for s in low: w[s] = .02
        for s in high: w[s] = .14
        fixed = set(low + high)
        free = [s for s in UNIVERSE if s not in fixed]
        remain = 1.0 - sum(w[s] for s in fixed)
        base = sum(w[s] for s in free) or 1.0
        for s in free: w[s] *= remain / base
    z = sum(w.values()) or 1.0
    return {s: w[s] / z for s in UNIVERSE}


@register_hook
def cross_asset_strategy():
    global _last_date
    selected = _ensemble()
    if not selected:
        return
    specs = {x["factor_id"]: (float(x["weight"]), int(x.get("direction", 1))) for x in selected}
    data, vol = {}, {}
    for s in UNIVERSE:
        df = get_stock_daily_data(symbol=s, days=140)
        if df is None or len(df) < 70: continue
        c = np.asarray(df.sort_values("date")["close"], dtype=float)
        r = c[1:] / np.maximum(c[:-1], 1e-12) - 1.0
        date = str(df.sort_values("date").iloc[-1]["date"])
        data[s] = (c, r, date)
        vol[s] = max(float(np.std(r[-21:-1])), .008)
    if len(data) < 12: return
    decision_date = max(v[2] for v in data.values())
    if _last_date is not None:
        try:
            if (np.datetime64(decision_date)-np.datetime64(_last_date))/np.timedelta64(1, "D") < 10: return
        except Exception: return

    vals = {f: {} for f in specs}
    for s, (c, r, _) in data.items():
        # All inputs end at the prior completed bar. These compact proxies preserve
        # the persisted factor directions while avoiding future information.
        r20 = c[-2] / c[-22] - 1.0
        r30 = c[-2] / c[-32] - 1.0
        r15 = c[-2] / c[-17] - 1.0
        tr = r[-21:-1]
        v20 = max(float(np.std(tr)), .008)
        down = max(float(np.sqrt(np.mean(np.minimum(tr, 0.0)**2))), .003)
        breadth = float(np.mean(tr > 0))
        efficiency = r20 / max(float(np.sum(np.abs(tr))), 1e-12)
        f = {
          "miner_3_20270208_breadth_confirmed_momentum": (r20/v20) * (0.5+breadth),
          "miner_2_20260827_range_efficiency_momentum": efficiency,
          "miner_1_20270108_persistent_trend_quality_20d": (r20/v20) * (0.5+breadth),
          "miner_2_20270111_trend_consistency_risk_adjusted": (r20/(v20*np.sqrt(20))) * (0.5+breadth),
          "miner_3_20261102_conditioned_momentum": (r20/v20) * (1+0.8*np.sign(r20)*(breadth-.5)),
          "miner_3_20270125_relative_momentum_30d_vol_scaled": r30/v20,
          "miner_1_20270208_downside_trend_15d": r15/down,
          "miner_1_20270111_breakout_persistence": r20/(v20*np.sqrt(20)),
        }
        for name in specs: vals[name][s] = f.get(name, 0.0)

    score = {s: .5 for s in UNIVERSE}
    for name, (wt, direction) in specs.items():
        rr = _rank({s: direction*v for s, v in vals[name].items()})
        for s in UNIVERSE: score[s] += wt*(rr[s]-.5)
    spx = data.get("SPX")
    risk_off = spx is not None and (spx[0][-2] < spx[0][-22] or np.mean(spx[1][-6:-1]) < 0)
    if risk_off:
        for s in ("XAU", "US10Y", "CN10Y"): score[s] += .10
        for s in ("BTC", "ETH", "WTI"): score[s] -= .06
    mean_inv = np.mean([1/max(vol.get(s,.02),.008) for s in UNIVERSE])
    raw = {s: max(score[s], .02)*(0.78+0.22*(1/max(vol.get(s,.02),.008))/mean_inv) for s in UNIVERSE}
    weights = _bounded(raw)
    mu, sd = np.mean(list(score.values())), max(float(np.std(list(score.values()))), 1e-12)
    forecast = {s: float(.01*(score[s]-mu)/sd) for s in UNIVERSE}
    rebalance_to_weights(weights, forecast_returns=forecast,
                         factor_ids=list(specs.keys()), horizon_days=10)
    _last_date = decision_date

if __name__ == "__main__":
    cross_asset_strategy()



