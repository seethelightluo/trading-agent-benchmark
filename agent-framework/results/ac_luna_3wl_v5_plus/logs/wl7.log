  ▶️ write_file({'content': 'import json\nfrom pathlib import Path\nimport numpy as np\nfrom alphacrafter.sim.utils import register_hook, get_stock_daily_data, get_index_daily_data, rebalance_to_weights\n\nUNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]\nENSEMBLE_PATH = Path(__file__).parent / "factors" / "factor_ensemble.json"\n_last_decision = None\n\ndef _selected():\n    try:\n        return json.loads(ENSEMBLE_PATH.read_text(encoding="utf-8")).get("selected_factors", [])[:10]\n    except Exception:\n        return []\n\ndef _rank(x):\n    good = sorted((s, v) for s, v in x.items() if np.isfinite(v))\n    out = {s: .5 for s in UNIVERSE}\n    for i, (s, _) in enumerate(good): out[s] = (i + 1) / max(len(good), 1)\n    return out\n\ndef _bounded(raw):\n    w = {s: max(float(raw.get(s, 0.0)), 0.0) for s in UNIVERSE}\n    z = sum(w.values()) or 1.0\n    w = {s: v / z for s, v in w.items()}\n    # 15-asset universe: broad, full-investment portfolio with 2%-14% bounds.\n    for _ in range(10):\n        low = [s for s in UNIVERSE if w[s] < .02]; high = [s for s in UNIVERSE if w[s] > .14]\n        if not low and not high: break\n        fixed = set(low + high)\n        for s in low: w[s] = .02\n        for s in high: w[s] = .14\n        free = [s for s in UNIVERSE if s not in fixed]\n        rem = 1.0 - sum(w[s] for s in fixed); base = sum(w[s] for s in free) or 1.0\n        for s in free: w[s] *= rem / base\n    z = sum(w.values())\n    return {s: w[s] / z for s in UNIVERSE}\n\n@register_hook\ndef cross_asset_strategy():\n    global _last_decision\n    selected = _selected()\n    if not selected: return\n    specs = {x["factor_id"]: (float(x["weight"]), int(x.get("direction", 1))) for x in selected}\n    data, vols = {}, {}\n    for s in UNIVERSE:\n        df = get_stock_daily_data(symbol=s, days=150)\n        if df is None or len(df) < 70: continue\n        c = np.asarray(df.sort_values("date")["close"], dtype=float)\n        r = c[1:] / np.maximum(c[:-1], 1e-12) - 1.0\n        data[s] = (c, r, str(df.sort_values("date").iloc[-1]["date"]))\n        vols[s] = max(float(np.std(r[-21:-1])), .008)\n    if len(data) < 12: return\n    decision = max(x[2] for x in data.values())\n    if _last_decision is not None:\n        try:\n            if (np.datetime64(decision)-np.datetime64(_last_decision))/np.timedelta64(1,\'D\') < 10: return\n        except Exception: return\n    vix_scale = 1.0\n    vdf = get_index_daily_data(symbol="VIX", days=80)\n    if vdf is not None and len(vdf) >= 30:\n        vc = np.asarray(vdf.sort_values("date")["close"], dtype=float)\n        if vc[-2] > np.median(vc[-31:-1]): vix_scale = .75\n    vals = {f:{} for f in specs}\n    for s, (c, r, _) in data.items():\n        vol = max(float(np.std(r[-21:-1])), .008); tr = r[-21:-1]\n        r2, r10, r15, r20, r30 = c[-2]/c[-4]-1, c[-2]/c[-12]-1, c[-2]/c[-17]-1, c[-2]/c[-22]-1, c[-2]/c[-32]-1\n        breadth = float(np.mean(tr > 0)); consistency = r20/vol*(.5+breadth)\n        breakout = (c[-2]/max(float(np.max(c[-22:-2])),1e-12)-1)/vol\n        dispersion = np.std([x[0][-2]/x[0][-22]-1 for x in data.values()])\n        f = {\n          "miner_2_20270225_dispersion_conditioned_momentum": r20/vol*(.5+breadth)*(1+min(dispersion*8,.5)),\n          "miner_2_20270111_trend_consistency_risk_adjusted": consistency,\n          "miner_1_20270108_persistent_trend_quality_20d": consistency*.9 + r10/vol*.1,\n          "miner_2_20260827_range_efficiency_momentum": r15/vol*(.5+breadth),\n          "miner_3_20270125_relative_momentum_30d_vol_scaled": r30/vol,\n          "miner_1_20270111_breakout_persistence": breakout,\n          "miner_2_20261102_downside_risk_adjusted_trend_20d": r20/max(float(np.sqrt(np.mean(np.minimum(tr,0)**2))),.003),\n          "miner_3_20270128_vol_state_momentum": r20/vol*(.5+breadth)*vix_scale,\n          "miner_2_20270128_vix_conditioned_momentum": r15/vol*vix_scale,\n        }\n        for f_id in specs: vals[f_id][s] = f.get(f_id, 0.0)\n    score = {s:.5 for s in UNIVERSE}\n    for f_id,(wt,direction) in specs.items():\n        rr = _rank({s: direction*v for s,v in vals[f_id].items()})\n        for s in UNIVERSE: score[s] += wt*(rr[s]-.5)\n    spx = data.get("SPX")\n    risk_off = spx is not None and (spx[0][-2] < spx[0][-22] or np.mean(spx[1][-6:-1]) < 0)\n    if risk_off:\n        for s in ("XAU","US10Y","CN10Y"): score[s] += .10\n        for s in ("BTC","ETH","WTI"): score[s] -= .06\n    inv = {s:1/max(vols.get(s,.02),.008) for s in UNIVERSE}; avg=np.mean(list(inv.values()))\n    raw = {s:max(score[s],.02)*(.78+.22*inv[s]/avg) for s in UNIVERSE}\n    weights = _bounded(raw)\n    mu=np.mean(list(score.values())); sd=max(float(np.std(list(score.values()))),1e-12)\n    forecast={s:float(.01*(score[s]-mu)/sd) for s in UNIVERSE}\n    rebalance_to_weights(weights, forecast_returns=forecast, factor_ids=list(specs), horizon_days=10)\n    _last_decision = decision\n', 'file_path': 'strategy.py'})
