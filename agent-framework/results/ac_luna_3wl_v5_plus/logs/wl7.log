    return obj.get("selected_factors", [])[:10]

def rank(vals, direction=1):
    out = {s: .5 for s in UNIVERSE}
    a = sorted([(s, direction * float(v)) for s, v in vals.items() if np.isfinite(v)], key=lambda x:x[1])
    for i, (s, _) in enumerate(a): out[s] = (i + 1) / max(len(a), 1)
    return out

def bounded(raw):
    lo, hi = .015, .16
    w = {s: max(float(raw.get(s, 0.01)), 1e-8) for s in UNIVERSE}
    for _ in range(30):
        fixed = {s for s in UNIVERSE if w[s] <= lo or w[s] >= hi}
        free = [s for s in UNIVERSE if s not in fixed]
        total_fixed = sum(min(max(w[s], lo), hi) for s in fixed)
        scale = (1-total_fixed) / max(sum(w[s] for s in free), 1e-12)
        changed = False
        for s in free:
            w[s] *= scale
            if w[s] < lo: w[s] = lo; changed = True
            if w[s] > hi: w[s] = hi; changed = True
        for s in fixed: w[s] = min(max(w[s], lo), hi)
        if not changed: break
    z = sum(w.values())
    return {s:w[s]/z for s in UNIVERSE}

@register_hook
def cross_asset_strategy():
    global _last_decision
    selected = load_ensemble()
    if not selected: return
    specs = {x["factor_id"]:(float(x["weight"]), int(x.get("direction",1))) for x in selected}
    data = {}
    for s in UNIVERSE:
        df = get_stock_daily_data(symbol=s, days=110)
        if df is None or len(df) < 35: continue
        df = df.sort_values("date").reset_index(drop=True)
        c=np.asarray(df.close,float); h=np.asarray(df.high,float); l=np.asarray(df.low,float); v=np.asarray(df.volume,float)
        r=c[1:]/np.maximum(c[:-1],1e-12)-1
        data[s]=(c,h,l,v,r,str(df.iloc[-1].date))
    if len(data) < 12: return
    date=max(x[5] for x in data.values())
    if _last_decision is not None and (np.datetime64(date)-np.datetime64(_last_decision))/np.timedelta64(1,'D') < 10: return
    vals={fid:{} for fid in specs}; ret5={}
    for s,(c,h,l,v,r,_) in data.items():
        vol=max(float(np.std(r[-20:])),.008); ret20=c[-1]/c[-21]-1; ret5[s]=c[-1]/c[-6]-1; ret3=c[-1]/c[-4]-1
        eff=ret20/max(float(np.sum(np.abs(r[-20:]))),1e-12)
        clv=(2*c[-1]-h[-1]-l[-1])/max(h[-1]-l[-1],1e-12)
        rng=max(h[-1]-l[-1],1e-12)/max(float(np.mean(h[-20:]-l[-20:])),1e-12)
        vz=(v[-1]-np.mean(v[-21:-1]))/max(float(np.std(v[-21:-1])),1e-12)
        proxy={
          'miner_2_20260827_range_efficiency_momentum':eff,
          'miner_2_20260716_risk_adjusted_momentum_20d':ret20/vol,
          'miner_1_20260716_peer_median_leadlag_5d':ret5[s],
          'miner_3_20260827_range_weighted_intraday_reversal':-r[-1]*rng,
          'miner_3_20260716_clv_1d':clv,
          'miner_1_20260924_relative_volnorm_reversal_5d':-ret5[s]/vol,
          'miner_3_volume_confirmed_reversal_3d':(-ret3/vol)*(1+min(max(vz,0),2)/2),
          'miner_3_20261008_asymmetric_volatility_reversal_2d':-r[-1]/vol if r[-1]<0 else -0.5*r[-1]/vol}
        for fid in specs:
            if fid in proxy: vals[fid][s]=proxy[fid]
    if 'miner_1_20260716_peer_median_leadlag_5d' in vals:
        vals['miner_1_20260716_peer_median_leadlag_5d']={s:x-np.median([y for t,y in ret5.items() if t!=s]) for s,x in ret5.items()}
    score={s:.5 for s in UNIVERSE}
    for fid,(wt,direction) in specs.items():
        rr=rank(vals.get(fid,{}),direction)
        for s in UNIVERSE: score[s]+=wt*(rr[s]-.5)
    # Consolidating bullish regime: inverse volatility controls crypto/commodity risk.
    if 'SPX' in data and data['SPX'][0][-1] < data['SPX'][0][-21]:
        for s in ('XAU','US10Y','CN10Y'): score[s]+=.10
        for s in ('BTC','ETH','WTI'): score[s]-=.06
    inv={s:1/max(float(np.std(data[s][4][-20:])),.008) for s in data}; avg=np.mean(list(inv.values()))
    raw={s:max(score[s],.02)*(.78+.22*inv.get(s,avg)/max(avg,1e-12)) for s in UNIVERSE}
    weights=bounded(raw); mean=np.mean(list(score.values())); sd=max(np.std(list(score.values())),1e-12)
    forecast={s:float(.01*(score[s]-mean)/sd) for s in UNIVERSE}
    rebalance_to_weights(weights, forecast_returns=forecast, factor_ids=[x['factor_id'] for x in selected], horizon_days=10)
    _last_decision=date



