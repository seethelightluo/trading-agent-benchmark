{
  "factor_id": "miner_3_20261130_asymmetric_volatility_reversal_2d_revalidated",
  "factor_name": "Downside-Volatility Shock Two-Day Reversal",
  "version": "1.1",
  "calculation": {
    "expression": "shift1((-pct_change(close,2)/(rolling_std(pct_change(close),20)+eps))*(1+0.5*clip((downside_vol20-median(downside_vol20,60))/(std(downside_vol20,60)+eps),0,2)))",
