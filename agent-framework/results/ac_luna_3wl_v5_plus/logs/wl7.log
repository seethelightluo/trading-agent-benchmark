        fs = json.loads(ENSEMBLE.read_text(encoding="utf-8")).get("selected_factors", [])
        return fs[:10]
    except Exception:
        return []


def rank(values):
    good = sorted((s, v) for s, v in values.items() if np.isfinite(v))
    out = {s: 0.5 for s in UNIVERSE}
    for i, (s, _) in enumerate(good):
        out[s] = (i + 0.5) / len(good)
    return out


def bounded_weights(raw):
    # Full-investment, long-only, sensible bounds for a 15-asset universe.
    w = {s: max(float(raw.get(s, 1 / 15)), 1e-9) for s in UNIVERSE}
    for _ in range(40):
        z = sum(w.values())
        w = {s: x / z for s, x in w.items()}
        low = [s for s in UNIVERSE if w[s] < .02]
        high = [s for s in UNIVERSE if w[s] > .14]
        if not low and not high:
            break
        fixed = set(low + high)
        for s in low: w[s] = .02
        for s in high: w[s] = .14
        free = [s for s in UNIVERSE if s not in fixed]
        rem = 1.0 - sum(w[s] for s in fixed)
        if free and rem > 0:
            z = sum(w[s] for s in free)
            for s in free: w[s] *= rem / z
    z = sum(w.values())
    return {s: w[s] / z for s in UNIVERSE}


@register_hook
def cross_asset_strategy():
    global last_decision
    fs = load_factors()
    if not fs or len(fs) > 10:
        return
    # These are deliberately simple price-only proxies for the persisted factor IDs.
    feature = {
        "miner_1_20270609_quality_momentum": "quality",
        "miner_3_20270604_risk_adjusted_20d_momentum": "risk20",
        "miner_3_20270526_risk_adjusted_10d_momentum": "risk10",
        "miner_3_20270128_vol_state_momentum": "volstate",
        "miner_2_20270111_trend_consistency_risk_adjusted": "consistency",
        "miner_3_20270310_downside_risk_momentum": "downside",
        "miner_3_20270609_efficiency_momentum": "efficiency",
        "miner_3_20261130_asymmetric_volatility_reversal_2d_revalidated": "asymrev",
        "miner_3_20270506_continuous_stress_reversal": "stress",
        "miner_2_20270506_dispersion_reversal": "dispersion",
    }
    data, vol, stamps = {}, {}, {}
    for s in UNIVERSE:
        d = get_stock_daily_data(symbol=s, days=190)
        if d is None or len(d) < 80:
            continue
        d = d.sort_values("date")
        c = np.asarray(d["close"], dtype=float)
        if np.any(~np.isfinite(c)) or np.any(c <= 0):
            continue
        r = c[1:] / c[:-1] - 1
        r10, r20, r40 = r[-11:-1], r[-21:-1], r[-41:-1]
        m10, m20 = c[-2] / c[-12] - 1, c[-2] / c[-22] - 1
        v10, v20 = max(np.std(r10), .008), max(np.std(r20), .008)
        v40 = max(np.std(r[-41:-1]), .008)
        downside = max(np.std(r20[r20 < 0]) if np.sum(r20 < 0) > 1 else .008, .008)
        cons = np.mean(r40 > 0)
        eff = abs(np.sum(r20)) / max(np.sum(abs(r20)), .008)
        data[s] = {"quality": (m20 / v20) * np.clip(1 - .25 * v20 / v40, .5, 1.25),
                   "risk20": m20 / v20, "risk10": m10 / v10,
                   "volstate": (m20 / v20) * np.clip(v40 / v20, .5, 2),
                   "consistency": cons * m20 / v20, "downside": m20 / downside,
                   "efficiency": (m20 / v20) * eff,
                   "asymrev": -np.sign(m10) * abs(m10) / v10,
                   "stress": -m10 / v10, "dispersion": -abs(m10) / v10}
        vol[s] = max(float(np.std(r[-26:-1])), .008)
        stamps[s] = str(d.iloc[-1]["date"])
    if len(data) < 12:
        return
    stamp = max(stamps.values())
    if last_decision is not None and (np.datetime64(stamp) - np.datetime64(last_decision)) / np.timedelta64(1, "D") < 10:
        return
    score = {s: .5 for s in UNIVERSE}
    for f in fs:
        key = feature.get(f.get("factor_id"))
        if key is None:
            continue
        rr = rank({s: float(f.get("direction", 1)) * data[s][key] for s in data})
        for s in UNIVERSE:
            score[s] += float(f.get("weight", 0)) * (rr[s] - .5)
    vd = get_index_daily_data(symbol="VIX", days=65)
    stressed = False
    if vd is not None and len(vd) >= 32:
        vc = np.asarray(vd.sort_values("date")["close"], dtype=float)
        stressed = vc[-2] > 1.20 * max(np.median(vc[-32:-2]), 1e-9)
    bear = data.get("SPX", {}).get("consistency", 0) < 0
    if stressed or bear:
        for s in ("XAU", "US10Y", "CN10Y"): score[s] += .10
        for s in ("BTC", "ETH", "WTI"): score[s] -= .07
    inv = np.mean([1 / vol.get(s, .02) for s in UNIVERSE])
    raw = {s: max(score[s], .05) * (.78 + .22 * (1 / vol.get(s, .02)) / inv) for s in UNIVERSE}
    target = bounded_weights(raw)
    avg, sd = np.mean(list(score.values())), max(np.std(list(score.values())), 1e-9)
    forecast = {s: float(.01 * (score[s] - avg) / sd) for s in UNIVERSE}
    rebalance_to_weights(target, forecast_returns=forecast,
                         factor_ids=[f["factor_id"] for f in fs], horizon_days=10)
    last_decision = stamp

strategy = cross_asset_strategy

