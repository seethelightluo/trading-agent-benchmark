  ▶️ write_file({'content': 'import json\nfrom pathlib import Path\nimport numpy as np\nfrom alphacrafter.sim.utils import register_hook, get_stock_daily_data, get_index_daily_data, rebalance_to_weights\n\nUNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]\nENSEMBLE = Path(__file__).parent / "factors" / "factor_ensemble.json"\nlast_decision = None\n\ndef factors():\n    try:\n        return json.loads(ENSEMBLE.read_text()).get("selected_factors", [])[:10]\n    except Exception:\n        return []\n\ndef rank(x):\n    out = {s: .5 for s in UNIVERSE}\n    a = sorted((s, v) for s, v in x.items() if np.isfinite(v))\n    for i, (s, _) in enumerate(a): out[s] = (i + .5) / len(a)\n    return out\n\ndef bounded(raw):\n    w = {s: max(float(raw.get(s, 1/15)), 1e-9) for s in UNIVERSE}\n    for _ in range(50):\n        w = {s: v / sum(w.values()) for s, v in w.items()}\n        lo = {s for s in UNIVERSE if w[s] < .02}\n        hi = {s for s in UNIVERSE if w[s] > .14}\n        if not lo and not hi: break\n        fixed = lo | hi\n        for s in lo: w[s] = .02\n        for s in hi: w[s] = .14\n        free = [s for s in UNIVERSE if s not in fixed]\n        rem = 1 - sum(w[s] for s in fixed)\n        if free and rem >= 0:\n            scale = rem / sum(w[s] for s in free)\n            for s in free: w[s] *= scale\n    z = sum(w.values())\n    return {s: w[s] / z for s in UNIVERSE}\n\n@register_hook\ndef cross_asset_strategy():\n    global last_decision\n    fs = factors()\n    if not fs: return\n    series, vols = {}, {}\n    for s in UNIVERSE:\n        d = get_stock_daily_data(symbol=s, days=190)\n        if d is None or len(d) < 80: continue\n        c = np.asarray(d.sort_values("date")["close"], dtype=float)\n        if np.all(np.isfinite(c)) and np.all(c > 0):\n            series[s] = c\n            vols[s] = max(float(np.std(c[1:][-26:-1] / c[:-1][-26:-1] - 1)), .008)\n    if len(series) < 12: return\n    # Decisions are based on the last completed observation, with a 10-day gate.\n    dates = []\n    for s in series:\n        d = get_stock_daily_data(symbol=s, days=190)\n        dates.append(str(d.sort_values("date").iloc[-1]["date"]))\n    stamp = max(dates)\n    if last_decision is not None and (np.datetime64(stamp)-np.datetime64(last_decision))/np.timedelta64(1, "D") < 10: return\n    med20 = np.median([series[s][-2]/series[s][-22]-1 for s in series])\n    sig = {}\n    for s, c in series.items():\n        r = c[1:] / c[:-1] - 1\n        r5, r20 = r[-6:-1], r[-21:-1]\n        v5, v20 = max(float(np.std(r5)), .008), max(float(np.std(r20)), .008)\n        m5, m20 = c[-2]/c[-7]-1, c[-2]/c[-22]-1\n        down = max(float(np.std(r20[r20 < 0])) if np.sum(r20 < 0)>1 else .008, .008)\n        consistency = float(np.mean(r[-41:-1] > 0))\n        efficiency = abs(np.mean(r[-20:])) / max(np.mean(np.abs(r[-20:])), .008)\n        dispersion = abs(m20-med20) / v20\n        sig[s] = {\n          "breadth": consistency*m20/v20, "conditioned": m20/v20,\n          "downside": m20/down, "efficiency": m20/v20*efficiency,\n          "volstate": m20/v20*min(2., max(.5, np.std(r[-61:-1])/v20)),\n          "stress": -m5/v5, "volume": -m5/v5,\n          "dispersion": -np.sign(m20-med20)*dispersion\n        }\n    keys = {\n      "signed_breadth_momentum":"breadth", "conditioned_momentum":"conditioned",\n      "downside_adjusted_trend":"downside", "range_efficiency_momentum":"efficiency",\n      "vol_state_momentum":"volstate", "continuous_stress_reversal":"stress",\n      "volume_confirmed_reversal_3d":"volume", "dispersion_reversal":"dispersion"\n    }\n    score = {s: .5 for s in UNIVERSE}\n    for f in fs:\n        key = next((v for k,v in keys.items() if k in f.get("factor_id", "")), None)\n        if key is None: continue\n        rr = rank({s: f.get("direction",1)*sig[s][key] for s in sig})\n        for s in UNIVERSE: score[s] += float(f.get("weight",0))* (rr[s]-.5)\n    vix = get_index_daily_data(symbol="VIX", days=65)\n    stress = False\n    if vix is not None and len(vix) >= 32:\n        vc = np.asarray(vix.sort_values("date")["close"], dtype=float)\n        stress = vc[-2] > 1.2*np.median(vc[-32:-2])\n    spx = series.get("SPX")\n    riskoff = stress or (spx is not None and spx[-2] < spx[-22])\n    if riskoff:\n        for s in ("XAU", "US10Y", "CN10Y"): score[s] += .10\n        for s in ("BTC", "ETH", "WTI"): score[s] -= .07\n    invmean = np.mean([1/vols.get(s,.02) for s in UNIVERSE])\n    raw = {s: max(score[s], .05)*(.78+.22*(1/vols.get(s,.02))/invmean) for s in UNIVERSE}\n    target = bounded(raw)\n    mu, sd = np.mean(list(score.values())), max(np.std(list(score.values())), 1e-9)\n    forecast = {s: float(.01*(score[s]-mu)/sd) for s in UNIVERSE}\n    rebalance_to_weights(target, forecast_returns=forecast, factor_ids=[f["factor_id"] for f in fs], horizon_days=10)\n    last_decision = stamp\n', 'file_path': 'strategy.py'})
