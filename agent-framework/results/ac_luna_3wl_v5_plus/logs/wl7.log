  ▶️ write_file({'content': 'import json\nfrom pathlib import Path\nimport numpy as np\nfrom alphacrafter.sim.utils import register_hook, get_stock_daily_data, get_index_daily_data, rebalance_to_weights\n\nUNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]\nENSEMBLE_PATH = Path(__file__).parent / "factors" / "factor_ensemble.json"\nlast_decision = None\n\n\ndef ensemble():\n    try:\n        return json.loads(ENSEMBLE_PATH.read_text(encoding="utf-8")).get("selected_factors", [])[:10]\n    except Exception:\n        return []\n\n\ndef ranks(x):\n    good = sorted((s, v) for s, v in x.items() if np.isfinite(v))\n    out = {s: .5 for s in UNIVERSE}\n    for i, (s, _) in enumerate(good):\n        out[s] = (i + .5) / len(good)\n    return out\n\n\ndef cap_weights(raw):\n    w = {s: max(float(raw.get(s, 0.0)), 1e-9) for s in UNIVERSE}\n    for _ in range(30):\n        z = sum(w.values()); w = {s: v / z for s, v in w.items()}\n        low = {s for s in UNIVERSE if w[s] < .02}\n        high = {s for s in UNIVERSE if w[s] > .14}\n        if not low and not high: break\n        fixed = low | high\n        for s in low: w[s] = .02\n        for s in high: w[s] = .14\n        free = [s for s in UNIVERSE if s not in fixed]\n        rem = 1.0 - sum(w[s] for s in fixed)\n        scale = rem / max(sum(w[s] for s in free), 1e-12)\n        for s in free: w[s] *= scale\n    z = sum(w.values())\n    return {s: w[s] / z for s in UNIVERSE}\n\n\n@register_hook\ndef cross_asset_strategy():\n    global last_decision\n    selected = ensemble()\n    if not selected: return\n    data, vols = {}, {}\n    for s in UNIVERSE:\n        d = get_stock_daily_data(symbol=s, days=190)\n        if d is None or len(d) < 80: continue\n        d = d.sort_values("date")\n        c = np.asarray(d["close"], dtype=float)\n        if np.all(np.isfinite(c)) and np.all(c > 0):\n            data[s] = (c, str(d.iloc[-1]["date"]))\n            vols[s] = max(float(np.std(c[1:] / c[:-1] - 1)[-23:-1]), .008)\n    if len(data) < 12: return\n    decision = max(x[1] for x in data.values())\n    if last_decision is not None:\n        try:\n            if (np.datetime64(decision) - np.datetime64(last_decision)) / np.timedelta64(1, "D") < 10: return\n        except Exception: return\n\n    sig = {}\n    for s, (c, _) in data.items():\n        r = c[1:] / c[:-1] - 1\n        r3, r5, r10, r20 = r[-4:-1], r[-6:-1], r[-11:-1], r[-21:-1]\n        v10 = max(float(np.std(r10)), .008); v20 = max(float(np.std(r20)), .008)\n        v60 = max(float(np.std(r[-61:-1])), .008)\n        neg = r20[r20 < 0]; down = max(float(np.std(neg)) if len(neg) > 1 else .008, .008)\n        m20 = c[-2] / c[-22] - 1; pos = float(np.mean(r20 > 0))\n        # Every input is lagged through the last completed session.\n        sig[s] = {\n            "range_reversal": -(c[-2] / c[-3] - 1) / v10,\n            "asym_reversal": -(c[-2] / c[-4] - 1) / v10 * (1 + max(0., -m20) / v20),\n            "volume_reversal": -(c[-2] / c[-5] - 1) / v20,\n            "stress_reversal": -(c[-2] / c[-6] - 1) / v10,\n            "downtrend": m20 / down,\n            "momentum": m20 / v20 * (.5 + pos),\n            "volstate": (m20 / v20) * min(2., v60 / v20),\n            "acceleration": (c[-2] / c[-7] - c[-7] / c[-27]) / v20,\n        }\n    vix = get_index_daily_data(symbol="VIX", days=65)\n    high_stress = False\n    if vix is not None and len(vix) >= 32:\n        vc = np.asarray(vix.sort_values("date")["close"], float)\n        high_stress = bool(vc[-2] > 1.2 * np.median(vc[-32:-2]))\n\n    score = {s: .5 for s in UNIVERSE}\n    for f in selected:\n        fid = f.get("factor_id", ""); direction = int(f.get("direction", 1)); wt = float(f.get("weight", 0))\n        if "range_weighted_intraday_reversal" in fid: key = "range_reversal"\n        elif "asymmetric_volatility_reversal" in fid: key = "asym_reversal"\n        elif "volume_confirmed_reversal" in fid: key = "volume_reversal"\n        elif "vix_stress_reversal" in fid: key = "stress_reversal"\n        elif "downside_risk_adjusted_trend" in fid: key = "downtrend"\n        elif "conditioned_momentum" in fid: key = "momentum"\n        elif "vol_state_momentum" in fid: key = "volstate"\n        elif "trend_acceleration_vol_scaled" in fid: key = "acceleration"\n        else: continue\n        rr = ranks({s: direction * sig[s][key] for s in sig})\n        for s in UNIVERSE: score[s] += wt * (rr[s] - .5)\n\n    spx = data.get("SPX", (None,))[0]\n    risk_off = high_stress or (spx is not None and (spx[-2] < spx[-22] or np.mean(spx[-8:-2] / spx[-9:-3] - 1) < 0))\n    if risk_off:\n        for s in ("XAU", "US10Y", "CN10Y"): score[s] += .10\n        for s in ("BTC", "ETH", "WTI"): score[s] -= .07\n    invmean = np.mean([1 / vols.get(s, .02) for s in UNIVERSE])\n    raw = {s: max(score[s], .05) * (.78 + .22 * (1 / vols.get(s, .02)) / invmean) for s in UNIVERSE}\n    target = cap_weights(raw)\n    mean = np.mean(list(score.values())); sd = max(float(np.std(list(score.values()))), 1e-9)\n    forecast = {s: float(.01 * (score[s] - mean) / sd) for s in UNIVERSE}\n    rebalance_to_weights(target, forecast_returns=forecast,\n                         factor_ids=[f["factor_id"] for f in selected], horizon_days=10)\n    last_decision = decision\n\nif __name__ == "__main__":\n    print([f["factor_id"] for f in ensemble()])\n', 'file_path': 'strategy.py'})
