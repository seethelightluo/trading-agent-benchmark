("date").reset_index(drop=True)\n        c = np.asarray(df["close"], float); h = np.asarray(df["high"], float)\n        l = np.asarray(df["low"], float); o = np.asarray(df["open"], float)\n        v = np.asarray(df["volume"], float)\n        series[s] = (c, h, l, o, v, np.diff(c) / np.maximum(c[:-1], 1e-12), str(df.iloc[-1]["date"]))\n    if len(series) < 12:\n        return\n    date = max(x[6] for x in series.values())\n    if _last_date is not None and (np.datetime64(date) - np.datetime64(_last_date)) / np.timedelta64(1, "D") < 10:\n        return\n\n    vals = {f: {} for f in specs}\n    five = {}\n    for s, (c, h, l, o, v, r, _) in series.items():\n        sd = max(float(np.std(r[-20:])), 0.008)\n        r1 = c[-1] / c[-2] - 1; r3 = c[-1] / c[-4] - 1; r5 = c[-1] / c[-6] - 1; r20 = c[-1] / c[-21] - 1\n        five[s] = r5\n        avg_range = max(float(np.mean(h[-20:] - l[-20:])), 1e-9)\n        day_range = max(h[-1] - l[-1], 1e-9)\n        intraday = (c[-1] - o[-1]) / day_range\n        vol_z = (v[-1] - np.mean(v[-21:-1])) / max(float(np.std(v[-21:-1])), 1e-9)\n        efficiency = r20 / max(float(np.sum(np.abs(r[-20:]))), 1e-9)\n        # Exact ensemble IDs are retained; short-horizon proxies are capped and rank-normalized.\n        raw = {\n            "miner_3_range_weighted_intraday_reversal_1d": -intraday * day_range / avg_range,\n            "miner_2_20260827_range_efficiency_momentum": efficiency * r20 / sd,\n            "miner_3_volume_confirmed_reversal_3d": -r3 / sd * (1 + 0.25 * min(max(vol_z, 0), 2)),\n            "miner_3_20261008_asymmetric_volatility_reversal_2d": -(c[-1] / c[-3] - 1) / sd * (1 + 0.25 * min(max(-r1 / sd, 0), 2)),\n            "miner_1_20260716_peer_median_leadlag_5d": r5,\n            "miner_2_20260716_risk_adjusted_momentum_20d": r20 / sd,\n            "miner_1_20261022_dispersion_conditional_reversal": -r1 / sd * min(2.0, 1 + abs(r1) / sd),\n            "miner_3_20261022_smoothed_range_reversal_1d": -0.5 * r1 / sd - 0.5 * intraday * day_range / avg_range,\n        }\n        for f in specs:\n            if f in raw:\n                vals[f][s] = raw[f]\n    vals.get("miner_1_20260716_peer_median_leadlag_5d", {}).update({s: x - np.median([y for t, y in five.items() if t != s]) for s, x in five.items()})\n\n    score = {s: 0.5 for s in UNIVERSE}\n    for f, (weight, direction) in specs.items():\n        rr = _rank(vals[f], direction)\n        for s in UNIVERSE:\n            score[s] += weight * (rr[s] - 0.5)\n    # High-risk sideways/bear posture: defensive tradable assets, never cash.\n    spx = series.get("SPX")\n    bearish = spx is not None and spx[0][-1] < spx[0][-21]\n    if bearish:\n        for s in ("XAU", "US10Y", "CN10Y"): score[s] += 0.12\n        for s in ("BTC", "ETH", "WTI"): score[s] -= 0.08\n    inv = {s: 1 / max(float(np.std(series[s][5][-20:])), 0.008) for s in series}\n    avg_inv = float(np.mean(list(inv.values())))\n    raww = {s: max(score[s], 0.02) * (0.72 + 0.28 * inv.get(s, avg_inv) / avg_inv) for s in UNIVERSE}\n    weights = _bounded(raww)\n    mean = float(np.mean(list(score.values()))); st = max(float(np.std(list(score.values()))), 1e-9)\n    forecast = {s: float(0.01 * (score[s] - mean) / st) for s in UNIVERSE}\n    rebalance_to_weights(weights, forecast_returns=forecast, factor_ids=list(specs), horizon_days=10)\n    _last_date = date\n', 'file_path': 'strategy.py'})
