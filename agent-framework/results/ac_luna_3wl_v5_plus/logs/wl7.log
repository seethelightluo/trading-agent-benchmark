  ▶️ write_file({'content': 'import json\nfrom pathlib import Path\nimport numpy as np\nfrom alphacrafter.sim.utils import register_hook, get_stock_daily_data, get_index_daily_data, rebalance_to_weights\n\nUNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]\nENSEMBLE = Path(__file__).parent / "factors" / "factor_ensemble.json"\nlast_decision = None\n\ndef load_factors():\n    try:\n        return json.loads(ENSEMBLE.read_text(encoding="utf-8")).get("selected_factors", [])[:10]\n    except Exception:\n        return []\n\ndef ranks(vals):\n    out = {s: .5 for s in UNIVERSE}\n    good = sorted((s, v) for s, v in vals.items() if np.isfinite(v))\n    for i, (s, _) in enumerate(good): out[s] = (i + .5) / len(good)\n    return out\n\ndef bounded(raw):\n    w = {s: max(float(raw.get(s, 1/15)), 1e-9) for s in UNIVERSE}\n    for _ in range(20):\n        z = sum(w.values()); w = {s: x/z for s,x in w.items()}\n        lo = [s for s in UNIVERSE if w[s] < .02]; hi = [s for s in UNIVERSE if w[s] > .14]\n        if not lo and not hi: break\n        fixed = set(lo + hi)\n        for s in lo: w[s] = .02\n        for s in hi: w[s] = .14\n        free = [s for s in UNIVERSE if s not in fixed]\n        rem = 1 - sum(w[s] for s in fixed)\n        if free and rem > 0:\n            z = sum(w[s] for s in free)\n            for s in free: w[s] *= rem/z\n    z = sum(w.values())\n    return {s: w[s]/z for s in UNIVERSE}\n\n@register_hook\ndef cross_asset_strategy():\n    global last_decision\n    factors = load_factors()\n    if not factors or len(factors) > 10: return\n    feat, vol, stamps = {}, {}, {}\n    for s in UNIVERSE:\n        df = get_stock_daily_data(symbol=s, days=190)\n        if df is None or len(df) < 80: continue\n        c = np.asarray(df.sort_values("date")["close"], float)\n        if np.any(~np.isfinite(c)) or np.any(c <= 0): continue\n        r = c[1:]/c[:-1]-1\n        r10, r20, r40 = r[-11:-1], r[-21:-1], r[-41:-1]\n        m10, m20 = c[-2]/c[-12]-1, c[-2]/c[-22]-1\n        v10, v20, v40 = max(np.std(r10),.008), max(np.std(r20),.008), max(np.std(r40),.008)\n        down = max(np.std(r20[r20 < 0]) if np.sum(r20 < 0)>1 else .008, .008)\n        q = (m20/v20)*np.clip(1-.25*v20/v40,.5,1.25)*(.5+np.mean(r20>0))\n        feat[s] = {"multi": .5*q+.3*m20/v20+.2*m10/v10, "quality":q, "risk20":m20/(np.sqrt(20)*v20),\n                   "risk10":m10/(np.sqrt(10)*v10), "consistency":np.mean(r40>0),\n                   "sortino":m20/down, "breakout":m10/v10, "vixrev":-m10/v10,\n                   "stress":-m10/v20, "disp":-abs(m10)/v10}\n        vol[s] = max(float(np.std(r[-26:-1])), .008)\n        stamps[s] = str(df.sort_values("date").iloc[-1]["date"])\n    if len(feat) < 12: return\n    stamp = max(stamps.values())\n    if last_decision is not None and (np.datetime64(stamp)-np.datetime64(last_decision))/np.timedelta64(1,"D") < 10: return\n    vd = get_index_daily_data(symbol="VIX", days=65); vz = 0.\n    if vd is not None and len(vd)>=32:\n        vc=np.asarray(vd.sort_values("date")["close"],float); base=vc[-62:-2]\n        vz=(vc[-2]-np.mean(base))/max(np.std(base),1e-8)\n    mapping = {\n      "miner_1_20270622_multihorizon_agreement":"multi", "miner_1_20270609_quality_momentum":"quality",\n      "miner_3_20270604_risk_adjusted_20d_momentum":"risk20", "miner_3_20270526_risk_adjusted_10d_momentum":"risk10",\n      "miner_2_20270111_trend_consistency_risk_adjusted":"consistency", "miner_2_20270324_downside_sortino_momentum":"sortino",\n      "miner_3_20270302_vix_conditioned_reversal":"vixrev", "miner_2_20270615_compression_breakout":"breakout",\n      "miner_3_20270506_continuous_stress_reversal":"stress", "miner_2_20270506_dispersion_reversal":"disp"}\n    score={s:.5 for s in UNIVERSE}\n    for f in factors:\n        key=mapping.get(f.get("factor_id"));\n        if key is None: continue\n        vals={s:feat[s][key] for s in feat}\n        if key in ("vixrev","stress") and vz <= .75: vals={s:0. for s in vals}\n        rr=ranks({s:float(f.get("direction",1))*v for s,v in vals.items()})\n        for s in UNIVERSE: score[s]+=float(f.get("weight",0))*(rr[s]-.5)\n    risk_off = vz>.75 or feat.get("SPX",{}).get("quality",0)<0\n    if risk_off:\n        for s in ("XAU","US10Y","CN10Y"): score[s]+=.08\n        for s in ("BTC","ETH","WTI"): score[s]-=.05\n    inv=np.mean([1/vol.get(s,.02) for s in UNIVERSE])\n    raw={s:max(score[s],.05)*(.78+.22*(1/vol.get(s,.02))/inv) for s in UNIVERSE}\n    target=bounded(raw); mean=np.mean(list(score.values())); sd=max(np.std(list(score.values())),1e-8)\n    forecast={s:float(.01*(score[s]-mean)/sd) for s in UNIVERSE}\n    rebalance_to_weights(target, forecast_returns=forecast, factor_ids=[f["factor_id"] for f in factors], horizon_days=10)\n    last_decision=stamp\n\nstrategy = cross_asset_strategy\n', 'file_path': 'strategy.py'})

