  ▶️ write_file({'content': 'import json\nfrom pathlib import Path\nimport numpy as np\nfrom alphacrafter.sim.utils import (\n    register_hook, get_stock_daily_data, get_index_daily_data,\n    rebalance_to_weights,\n)\n\nUNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]\nENSEMBLE = Path(__file__).parent / "factors" / "factor_ensemble.json"\nlast_decision = None\n\n\ndef load_factors():\n    try:\n        fs = json.loads(ENSEMBLE.read_text(encoding="utf-8")).get("selected_factors", [])\n        return fs[:10]\n    except Exception:\n        return []\n\n\ndef rank(values):\n    out = {s: 0.5 for s in UNIVERSE}\n    good = sorted((s, float(v)) for s, v in values.items() if np.isfinite(v))\n    n = len(good)\n    for i, (s, _) in enumerate(good):\n        out[s] = (i + 0.5) / n\n    return out\n\n\ndef bounded(raw):\n    # 15-asset, long-only, fully invested; no board-lot rounding.\n    w = {s: max(float(raw.get(s, 1 / 15)), 1e-10) for s in UNIVERSE}\n    for _ in range(50):\n        z = sum(w.values())\n        w = {s: x / z for s, x in w.items()}\n        low = [s for s in UNIVERSE if w[s] < .02]\n        high = [s for s in UNIVERSE if w[s] > .14]\n        if not low and not high:\n            break\n        fixed = set(low + high)\n        for s in low: w[s] = .02\n        for s in high: w[s] = .14\n        free = [s for s in UNIVERSE if s not in fixed]\n        rem = 1 - sum(w[s] for s in fixed)\n        if free and rem > 0:\n            z = sum(w[s] for s in free)\n            for s in free: w[s] *= rem / z\n    z = sum(w.values())\n    return {s: float(w[s] / z) for s in UNIVERSE}\n\n\n@register_hook\ndef cross_asset_strategy():\n    global last_decision\n    factors = load_factors()\n    if len(factors) == 0 or len(factors) > 10:\n        return\n\n    # Simple price-only proxies for the persisted ensemble, lagged one bar.\n    feat, vol, dates = {}, {}, {}\n    for s in UNIVERSE:\n        df = get_stock_daily_data(symbol=s, days=190)\n        if df is None or len(df) < 80:\n            continue\n        df = df.sort_values("date")\n        c = np.asarray(df["close"], dtype=float)[:-1]\n        if len(c) < 65 or np.any(~np.isfinite(c)) or np.any(c <= 0):\n            continue\n        r = c[1:] / c[:-1] - 1\n        r10, r20, r40 = r[-10:], r[-20:], r[-40:]\n        v10, v20, v40 = max(np.std(r10), .008), max(np.std(r20), .008), max(np.std(r40), .008)\n        downside = max(np.std(r20[r20 < 0]) if np.sum(r20 < 0) > 1 else .008, .008)\n        m5, m10, m20, m40 = c[-1]/c[-6]-1, c[-1]/c[-11]-1, c[-1]/c[-21]-1, c[-1]/c[-41]-1\n        feat[s] = {\n            "quality": m20/(np.sqrt(20)*v20) * (.5 + np.mean(r20 > 0)),\n            "risk20": m20/(np.sqrt(20)*v20),\n            "multi": (m10/(np.sqrt(10)*v10)+m20/(np.sqrt(20)*v20)+m40/(np.sqrt(40)*v40))/3,\n            "risk10": m10/(np.sqrt(10)*v10),\n            "volume_mom": m10/(np.sqrt(10)*v10) * (1 + .25*np.tanh(np.log1p(np.mean(np.asarray(df["volume"], float)[-21:-1])))),\n            "recovery": (m5+m10)/(2*v10),\n            "asym_rev": -m10/v10,\n            "volume_rev": -m5/max(v10, .008),\n            "stress": -m10/v10,\n            "breakout": m20/v20 + m10/v10 - .5*v20/v40,\n        }\n        vol[s] = max(float(np.std(r[-25:])), .008)\n        dates[s] = str(df.iloc[-1]["date"])\n    if len(feat) < 12:\n        return\n    stamp = max(dates.values())\n    if last_decision is not None and (np.datetime64(stamp)-np.datetime64(last_decision))/np.timedelta64(1, "D") < 10:\n        return\n\n    mapping = {\n        "miner_1_20270609_quality_momentum": "quality",\n        "miner_3_20270604_risk_adjusted_20d_momentum": "risk20",\n        "miner_1_20270622_multihorizon_agreement": "multi",\n        "miner_3_20270526_risk_adjusted_10d_momentum": "risk10",\n        "miner_1_20270707_volume_confirmed_momentum": "volume_mom",\n        "miner_1_20270707_recovery_efficiency_10d": "recovery",\n        "miner_3_20261130_asymmetric_volatility_reversal_2d_revalidated": "asym_rev",\n        "miner_3_volume_confirmed_reversal_3d": "volume_rev",\n        "miner_3_20270506_continuous_stress_reversal": "stress",\n        "miner_2_20270615_compression_breakout": "breakout",\n    }\n    score = {s: .5 for s in UNIVERSE}\n    for f in factors:\n        key = mapping.get(f.get("factor_id"))\n        if key is None: continue\n        rr = rank({s: float(f.get("direction", 1)) * feat[s][key] for s in feat})\n        for s in UNIVERSE: score[s] += float(f.get("weight", 0)) * (rr[s]-.5)\n\n    vix_z = 0.0\n    vix = get_index_daily_data(symbol="VIX", days=65)\n    if vix is not None and len(vix) >= 32:\n        vc = np.asarray(vix.sort_values("date")["close"], float)\n        base = vc[-62:-2] if len(vc) >= 62 else vc[:-2]\n        vix_z = (vc[-2]-np.mean(base))/max(np.std(base), 1e-8)\n    risk_off = vix_z > .75 or feat.get("SPX", {}).get("multi", 0) < 0\n    if risk_off:\n        for s in ("XAU", "US10Y", "CN10Y"): score[s] += .08\n        for s in ("BTC", "ETH", "WTI"): score[s] -= .05\n    inv_mean = np.mean([1/max(vol.get(s, .02), .008) for s in UNIVERSE])\n    raw = {s: max(score[s], .05) * (.78 + .22*(1/max(vol.get(s, .02), .008))/inv_mean) for s in UNIVERSE}\n    target = bounded(raw)\n    mu, sd = np.mean(list(score.values())), max(np.std(list(score.values())), 1e-8)\n    forecast = {s: float(.01*(score[s]-mu)/sd) for s in UNIVERSE}\n    factor_ids = [f["factor_id"] for f in factors]\n    rebalance_to_weights(target, forecast_returns=forecast, factor_ids=factor_ids, horizon_days=10)\n    last_decision = stamp\n\n\nstrategy = cross_asset_strategy\n', 'file_path': 'strategy.py'})
