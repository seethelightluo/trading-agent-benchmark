    spx = closes.get("SPX")
    risk_off = high_vix or (spx is not None and (spx[-2] < spx[-22] or np.mean(returns["SPX"][-7:-2]) < 0))
    if risk_off:
        for s in ("XAU", "US10Y", "CN10Y"): score[s] += 0.10
        for s in ("BTC", "ETH", "WTI"): score[s] -= 0.07
    invmean = np.mean([1.0 / vol.get(s, .02) for s in UNIVERSE])
    raw = {s: max(score[s], .05) * (0.78 + 0.22 * (1.0/vol.get(s,.02))/invmean) for s in UNIVERSE}
    target = bounded_weights(raw)
    mean, sd = np.mean(list(score.values())), max(float(np.std(list(score.values()))), 1e-9)
    # Complete deterministic 10-day forecast, including every tradable asset.
    forecast = {s: float(0.01 * (score[s] - mean) / sd) for s in UNIVERSE}
    rebalance_to_weights(target, forecast_returns=forecast, factor_ids=[x[0] for x in specs], horizon_days=10)
    _last_decision = decision

factor_ensemble = ensemble

