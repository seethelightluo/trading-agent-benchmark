import json
from pathlib import Path
import numpy as np
from alphacrafter.sim.utils import register_hook, get_stock_daily_data, get_index_daily_data, rebalance_to_weights

UNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
ENSEMBLE = Path(__file__).parent / "factor_ensemble.json"
last_decision = None


def load_factors():
    try:
        return json.loads(ENSEMBLE.read_text(encoding="utf-8")).get("selected_factors", [])[:10]
    except Exception:
        return []


def percentile(values):
    out = {s: 0.5 for s in UNIVERSE}
    valid = sorted((s, float(v)) for s, v in values.items() if np.isfinite(v))
    if not valid:
        return out
    n = len(valid)
    for i, (s, _) in enumerate(valid):
        out[s] = (i + 0.5) / n
    return out


def bounded_weights(raw):
    # 15 assets, fully invested, fractional quantities, and sensible concentration.
    w = {s: max(float(raw.get(s, 1.0 / len(UNIVERSE))), 1e-12) for s in UNIVERSE}
    for _ in range(50):
        z = sum(w.values())
        w = {s: v / z for s, v in w.items()}
        low = {s for s in UNIVERSE if w[s] < 0.02}
        high = {s for s in UNIVERSE if w[s] > 0.14}
        if not low and not high:
            break
        fixed = low | high
        for s in low: w[s] = 0.02
        for s in high: w[s] = 0.14
        free = [s for s in UNIVERSE if s not in fixed]
        remaining = 1.0 - sum(w[s] for s in fixed)
        if free and remaining > 0:
            scale = remaining / sum(w[s] for s in free)
            for s in free: w[s] *= scale
    z = sum(w.values())
    return {s: w[s] / z for s in UNIVERSE}


@register_hook
def cross_asset_strategy():
    global last_decision
    factors = load_factors()
    if not factors:
        return

    prices, vols, sig = {}, {}, {}
    for s in UNIVERSE:
        d = get_stock_daily_data(symbol=s, days=190)
        if d is None or len(d) < 80:
            continue
        c = np.asarray(d.sort_values("date")["close"], dtype=float)
        if not np.all(np.isfinite(c)) or np.any(c <= 0):
            continue
        prices[s] = c
        r = c[1:] / c[:-1] - 1.0
        vols[s] = max(float(np.std(r[-26:-1])), 0.008)
        # All features stop at -2, avoiding use of the current incomplete bar.
        r5, r20, r40 = r[-6:-1], r[-21:-1], r[-41:-1]
        m5, m20 = c[-2] / c[-7] - 1.0, c[-2] / c[-22] - 1.0
        v5, v20 = max(float(np.std(r5)), .008), max(float(np.std(r20)), .008)
        downside = max(float(np.std(r20[r20 < 0])) if np.sum(r20 < 0) > 1 else .008, .008)
        consistency = float(np.mean(r40 > 0))
        efficiency = abs(float(np.sum(r20))) / max(float(np.sum(abs(r20))), .008)
        vol_state = np.clip(float(np.std(r40)) / v20, .5, 2.0)
        sig[s] = {
            "asym": -m5 / v5,
            "breadth": consistency * m20 / v20,
            "trend": consistency * m20 / v20,
            "volstate": m20 / v20 * vol_state,
            "range": m20 / v20 * efficiency,
            "stress": -m5 / v5,
            "vix": -m5 / v5,
            "downside": m20 / downside,
        }
    if len(prices) < 12:
        return

    stamp = max(str(get_stock_daily_data(symbol=s, days=190).sort_values("date").iloc[-1]["date"]) for s in prices)
    if last_decision is not None and (np.datetime64(stamp) - np.datetime64(last_decision)) / np.timedelta64(1, "D") < 10:
        return

    vix_ratio = 1.0
    vd = get_index_daily_data(symbol="VIX", days=65)
    if vd is not None and len(vd) >= 32:
        vc = np.asarray(vd.sort_values("date")["close"], dtype=float)
        vix_ratio = max(1.0, float(vc[-2] / max(np.median(vc[-32:-2]), 1e-9)))
    for s in sig:
        sig[s]["vix"] *= vix_ratio

    # Explicit mapping keeps the implementation synchronized with factor_ensemble.json.
    mapping = {
        "asymmetric_volatility_reversal": "asym",
        "signed_breadth_momentum": "breadth",
        "trend_consistency_risk_adjusted": "trend",
        "vol_state_momentum": "volstate",
        "range_efficiency_momentum": "range",
        "continuous_stress_reversal": "stress",
        "vix_stress_reversal_5d": "vix",
    }
    score = {s: 0.5 for s in UNIVERSE}
    for f in factors:
        fid = f.get("factor_id", "")
        key = next((v for k, v in mapping.items() if k in fid), None)
        if key is None:
            continue
        ranked = percentile({s: float(f.get("direction", 1)) * sig[s][key] for s in sig})
        for s in UNIVERSE:
            score[s] += float(f.get("weight", 0.0)) * (ranked[s] - 0.5)

    spx = prices.get("SPX")
    riskoff = vix_ratio > 1.20 or (spx is not None and spx[-2] < spx[-22])
    if riskoff:
        for s in ("XAU", "US10Y", "CN10Y"): score[s] += .10
        for s in ("BTC", "ETH", "WTI"): score[s] -= .07
    inv_mean = np.mean([1.0 / vols.get(s, .02) for s in UNIVERSE])
    raw = {s: max(score[s], .05) * (.78 + .22 * (1.0 / vols.get(s, .02)) / inv_mean) for s in UNIVERSE}
    target = bounded_weights(raw)
    mean = np.mean(list(score.values()))
    sd = max(float(np.std(list(score.values()))), 1e-9)
    forecast = {s: float(.01 * (score[s] - mean) / sd) for s in UNIVERSE}
    rebalance_to_weights(target, forecast_returns=forecast,
                         factor_ids=[f["factor_id"] for f in factors], horizon_days=10)
    last_decision = stamp
