  ▶️ write_file({'content': 'import json\nfrom pathlib import Path\nimport numpy as np\nfrom alphacrafter.sim.utils import register_hook, get_stock_daily_data, get_index_daily_data, rebalance_to_weights\n\nUNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]\nENSEMBLE = Path(__file__).parent / "factors" / "factor_ensemble.json"\nlast_decision = None\n\n\ndef load_factors():\n    try:\n        return json.loads(ENSEMBLE.read_text(encoding="utf-8")).get("selected_factors", [])[:10]\n    except Exception:\n        return []\n\n\ndef ranks(x):\n    out = {s: 0.5 for s in UNIVERSE}\n    a = sorted((s, v) for s, v in x.items() if np.isfinite(v))\n    if not a:\n        return out\n    for i, (s, _) in enumerate(a):\n        out[s] = (i + .5) / len(a)\n    return out\n\n\ndef bound_weights(raw):\n    w = {s: max(float(raw.get(s, 1/15)), 1e-8) for s in UNIVERSE}\n    # Sensible diversification bounds for a small 15-asset universe.\n    for _ in range(30):\n        z = sum(w.values()); w = {s: v/z for s, v in w.items()}\n        lo = [s for s in UNIVERSE if w[s] < .02]\n        hi = [s for s in UNIVERSE if w[s] > .14]\n        if not lo and not hi: break\n        fixed = set(lo + hi)\n        for s in lo: w[s] = .02\n        for s in hi: w[s] = .14\n        free = [s for s in UNIVERSE if s not in fixed]\n        rem = 1 - sum(w[s] for s in fixed)\n        if free and rem > 0:\n            z = sum(w[s] for s in free)\n            for s in free: w[s] *= rem/z\n    z = sum(w.values())\n    return {s: float(w[s]/z) for s in UNIVERSE}\n\n\n@register_hook\ndef cross_asset_strategy():\n    global last_decision\n    factors = load_factors()\n    if not factors or len(factors) > 10: return\n    # All features use the last completed bar; cross-sectional ranks avoid scale issues.\n    feat, vol, dates = {}, {}, {}\n    for s in UNIVERSE:\n        df = get_stock_daily_data(symbol=s, days=190)\n        if df is None or len(df) < 80: continue\n        df = df.sort_values("date")\n        c = np.asarray(df["close"], float)[:-1]\n        if len(c) < 65 or np.any(~np.isfinite(c)) or np.any(c <= 0): continue\n        r = c[1:]/c[:-1]-1\n        v10, v20, v30, v40 = [max(float(np.std(r[-n:])), .008) for n in (10,20,30,40)]\n        m5, m10, m20, m30, m40 = [c[-1]/c[-(n+1)]-1 for n in (5,10,20,30,40)]\n        vol[s] = max(float(np.std(r[-25:])), .008)\n        feat[s] = {\n            "quality": m20/(np.sqrt(20)*v20) * (.5 + np.mean(r[-20:] > 0)),\n            "risk20": m20/(np.sqrt(20)*v20),\n            "risk30": m30/(np.sqrt(30)*v30),\n            "multi": np.mean([m10/(np.sqrt(10)*v10), m20/(np.sqrt(20)*v20), m40/(np.sqrt(40)*v40)]),\n            "risk10": m10/(np.sqrt(10)*v10),\n            "asym_rev": -m10/v10,\n            "volume_rev": -m5/v10,\n            "stress": -m10/v10,\n            "volume_mom": m10/(np.sqrt(10)*v10) * (1 + .25*np.tanh(np.log1p(np.mean(np.asarray(df["volume"], float)[-21:-1])))),\n            "recovery": (m5+m10)/(2*v10),\n        }\n        dates[s] = str(df.iloc[-1]["date"])\n    if len(feat) < 12: return\n    stamp = max(dates.values())\n    if last_decision is not None and (np.datetime64(stamp)-np.datetime64(last_decision))/np.timedelta64(1,"D") < 10: return\n    mapping = {\n      "miner_1_20270609_quality_momentum":"quality",\n      "miner_3_20270604_risk_adjusted_20d_momentum":"risk20",\n      "miner_1_20270723_risk_adjusted_momentum30":"risk30",\n      "miner_1_20270622_multihorizon_agreement":"multi",\n      "miner_3_20270526_risk_adjusted_10d_momentum":"risk10",\n      "miner_3_20261130_asymmetric_volatility_reversal_2d_revalidated":"asym_rev",\n      "miner_3_volume_confirmed_reversal_3d":"volume_rev",\n      "miner_3_20270218_continuous_stress_reversal":"stress",\n      "miner_1_20270707_volume_confirmed_momentum":"volume_mom",\n      "miner_1_20270707_recovery_efficiency_10d":"recovery",\n    }\n    score = {s: .5 for s in UNIVERSE}\n    for f in factors:\n        key = mapping.get(f.get("factor_id"))\n        if key is None: continue\n        rr = ranks({s: float(f.get("direction",1))*feat[s][key] for s in feat})\n        for s in UNIVERSE: score[s] += float(f.get("weight",0))*(rr[s]-.5)\n    vix_z = 0.0\n    vix = get_index_daily_data(symbol="VIX", days=65)\n    if vix is not None and len(vix) >= 32:\n        vc = np.asarray(vix.sort_values("date")["close"], float)\n        base = vc[-62:-2] if len(vc) >= 62 else vc[:-2]\n        vix_z = (vc[-2]-np.mean(base))/max(np.std(base),1e-8)\n    risk_off = vix_z > .75 or feat.get("SPX",{}).get("multi",0) < 0\n    if risk_off:\n        for s in ("XAU","US10Y","CN10Y"): score[s] += .08\n        for s in ("BTC","ETH","WTI"): score[s] -= .05\n    inv = np.mean([1/max(vol.get(s,.02),.008) for s in UNIVERSE])\n    raw = {s: max(score[s],.05)*(.78+.22*(1/max(vol.get(s,.02),.008))/inv) for s in UNIVERSE}\n    target = bound_weights(raw)\n    mu, sd = np.mean(list(score.values())), max(np.std(list(score.values())),1e-8)\n    forecast = {s: float(.01*(score[s]-mu)/sd) for s in UNIVERSE}\n    rebalance_to_weights(target, forecast_returns=forecast, factor_ids=[f["factor_id"] for f in factors], horizon_days=10)\n    last_decision = stamp\n\nstrategy = cross_asset_strategy\n', 'file_path': 'strategy.py'})

