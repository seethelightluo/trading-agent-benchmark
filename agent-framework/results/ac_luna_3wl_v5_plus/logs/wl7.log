  ▶️ write_file({'content': "import numpy as np, pandas as pd\nfrom alphacrafter.sim.utils import get_index_daily_data\nU=['000300.SH','SPX','HSI','N225','SX5E','000688.SH','SOX','NDX','XAU','COPPER','WTI','BTC','ETH','US10Y','CN10Y']\n# residual 20d momentum: trailing asset return minus rolling beta to cross-asset equal-weight return times market return\nraw={}\nfor s in U:\n d=get_index_daily_data(s,days=3000)\n if d is not None and len(d): raw[s]=d[['date','close']].drop_duplicates('date').set_index('date').close\np=pd.DataFrame(raw).sort_index(); r=p.pct_change(); m=r.mean(axis=1)\nvals={}; fwd={}\nfor s in U:\n x=pd.DataFrame({'r':r[s],'m':m}).dropna()\n beta=x.r.rolling(60,min_periods=40).cov(x.m)/x.m.rolling(60,min_periods=40).var()\n # use 20d residual cumulative return; beta is prior-day rolling available in construction\n res=r[s]-beta*m\n vals[s]=res.rolling(20,min_periods=15).sum()\n fwd[s]=p[s].shift(-1)/p[s]-1\nF=pd.DataFrame(vals); R=pd.DataFrame(fwd)\nics=[]; ic5=[]; ic10=[]; turnovers=[]; nms=[]\nfor dt in F.index:\n a=F.loc[dt]; b=R.loc[dt]\n z=pd.concat([a,b],axis=1).dropna()\n if len(z)>=8: ics.append(z.iloc[:,0].corr(z.iloc[:,1])); nms.append(len(z))\n # forward non-overlapping-ish horizon return from t to t+h\n for h,out in [(5,ic5),(10,ic10)]:\n  q=pd.concat([a,(p.shift(-h)/p-1).loc[dt]],axis=1).dropna()\n  if len(q)>=8: out.append(q.iloc[:,0].corr(q.iloc[:,1]))\n# rank turnover daily\nrank=F.rank(axis=1,pct=True); turnovers=rank.diff().abs().mean(axis=1).dropna()\na=np.array(ics); print('dates',len(a),'avg_names',np.mean(nms),'coverage',np.mean(nms)/15,'IC',np.nanmean(a),'ICIR',np.nanmean(a)/np.nanstd(a,ddof=1),'hit',np.mean(a>0),'turnover',turnovers.mean(),'IC5',np.nanmean(ic5),'ICIR5',np.nanmean(ic5)/np.nanstd(ic5,ddof=1),'IC10',np.nanmean(ic10),'ICIR10',np.nanmean(ic10)/np.nanstd(ic10,ddof=1))\nfor y in range(2020,2027):\n q=[ics[i] for i,dt in enumerate(F.index) if i<len(ics) and dt.year==y] # approximate\n if q: print(y,len(q),np.mean(q),np.mean(q)/np.std(q,ddof=1) if len(q)>1 else 0)\n", 'file_path': 'scripts/miner_2_20260813_residual_momentum.py'})

