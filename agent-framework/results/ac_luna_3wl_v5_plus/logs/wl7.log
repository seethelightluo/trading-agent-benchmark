  ▶️ write_file({'content': 'import json\nfrom pathlib import Path\nimport numpy as np\nfrom alphacrafter.sim.utils import register_hook, get_stock_daily_data, get_index_daily_data, rebalance_to_weights\n\nUNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]\nENSEMBLE_PATH = Path(__file__).parent / "factor_ensemble.json"\n_last_decision = None\n\ndef ensemble():\n    try:\n        x = json.loads(ENSEMBLE_PATH.read_text(encoding="utf-8"))\n        return x.get("selected_factors", [])[:10]\n    except Exception:\n        return []\n\ndef percentile(values):\n    out = {s: 0.5 for s in UNIVERSE}\n    good = [(s, float(v)) for s, v in values.items() if np.isfinite(v)]\n    if not good: return out\n    good.sort(key=lambda x: x[1])\n    for i, (s, _) in enumerate(good): out[s] = (i + 1) / len(good)\n    return out\n\ndef bounded_weights(raw, low=0.02, high=0.14):\n    w = {s: max(float(raw.get(s, 0.0)), 1e-9) for s in UNIVERSE}\n    for _ in range(20):\n        z = sum(w.values())\n        w = {s: v / z for s, v in w.items()}\n        lowset = {s for s in UNIVERSE if w[s] < low}\n        hiset = {s for s in UNIVERSE if w[s] > high}\n        if not lowset and not hiset: break\n        fixed = lowset | hiset\n        for s in lowset: w[s] = low\n        for s in hiset: w[s] = high\n        free = [s for s in UNIVERSE if s not in fixed]\n        rem = 1.0 - sum(w[s] for s in fixed)\n        free_sum = sum(w[s] for s in free) or 1.0\n        for s in free: w[s] *= rem / free_sum\n    z = sum(w.values())\n    return {s: w[s] / z for s in UNIVERSE}\n\n@register_hook\ndef cross_asset_strategy():\n    global _last_decision\n    selected = ensemble()\n    if not selected: return\n    specs = [(str(x["factor_id"]), float(x["weight"]), int(x.get("direction", 1))) for x in selected]\n    closes, returns, vol = {}, {}, {}\n    for s in UNIVERSE:\n        d = get_stock_daily_data(symbol=s, days=180)\n        if d is None or len(d) < 70: continue\n        c = np.asarray(d.sort_values("date")["close"], dtype=float)\n        if np.all(np.isfinite(c)) and np.all(c > 0):\n            closes[s] = c\n            returns[s] = c[1:] / c[:-1] - 1.0\n            vol[s] = max(float(np.std(returns[s][-22:-1])), 0.008)\n    if len(closes) < 12: return\n    # Decision uses completed data only; rebalance at most once per ten trading days.\n    decision = max(str(get_stock_daily_data(symbol=s, days=180).sort_values("date").iloc[-1]["date"]) for s in closes)\n    if _last_decision is not None:\n        try:\n            if (np.datetime64(decision) - np.datetime64(_last_decision)) / np.timedelta64(1, "D") < 10: return\n        except Exception: return\n\n    feat = {s: {} for s in closes}\n    for s, c in closes.items():\n        p = c[:-1]; r = returns[s][:-1]\n        q = r[-20:]\n        r5, r10, r20, r30 = p[-1]/p[-6]-1, p[-1]/p[-11]-1, p[-1]/p[-21]-1, p[-1]/p[-31]-1\n        v = max(float(np.std(q)), .008)\n        downside = max(float(np.std(q[q < 0])) if np.any(q < 0) else .008, .008)\n        breadth = float(np.mean(q > 0))\n        path = max(float(np.sum(np.abs(q))), .02)\n        feat[s] = {"breadth": breadth * (0.5 + r20 / v),\n                   "dispersion": r20 / v,\n                   "conditioned": breadth * r20 / v,\n                   "volstate": r20 / v,\n                   "consistency": breadth * (0.5 + r20 / v),\n                   "persistent": (0.5*r20 + 0.3*r10 + 0.2*r30) / v,\n                   "range": r20 / path,\n                   "reversal": -r5 / v,\n                   "downside": r20 / downside}\n    score = {s: 0.5 for s in UNIVERSE}\n    for fid, wt, direction in specs:\n        if "signed_breadth" in fid: key = "breadth"\n        elif "dispersion_conditioned" in fid: key = "dispersion"\n        elif "conditioned_momentum" in fid: key = "conditioned"\n        elif "vol_state" in fid: key = "volstate"\n        elif "trend_consistency" in fid: key = "consistency"\n        elif "persistent_trend" in fid: key = "persistent"\n        elif "range_efficiency" in fid: key = "range"\n        elif "asymmetric_volatility_reversal" in fid: key = "reversal"\n        else: key = "conditioned"\n        rr = percentile({s: direction * feat[s][key] for s in feat})\n        for s in UNIVERSE: score[s] += wt * (rr[s] - 0.5)\n\n    # Fragile/risk-off regime: express defense with tradable assets, never cash.\n    vix = get_index_daily_data(symbol="VIX", days=65)\n    high_vix = False\n    if vix is not None and len(vix) >= 32:\n        vc = np.asarray(vix.sort_values("date")["close"], float)\n        high_vix = bool(vc[-2] > 1.2 * np.median(vc[-32:-2]))\n    spx = closes.get("SPX")\n    risk_off = high_vix or (spx is not None and (spx[-2] < spx[-22] or np.mean(returns["SPX"][-7:-2]) < 0))\n    if risk_off:\n        for s in ("XAU", "US10Y", "CN10Y"): score[s] += 0.10\n        for s in ("BTC", "ETH", "WTI"): score[s] -= 0.07\n    invmean = np.mean([1.0 / vol.get(s, .02) for s in UNIVERSE])\n    raw = {s: max(score[s], .05) * (0.78 + 0.22 * (1.0/vol.get(s,.02))/invmean) for s in UNIVERSE}\n    target = bounded_weights(raw)\n    mean, sd = np.mean(list(score.values())), max(float(np.std(list(score.values()))), 1e-9)\n    # Complete deterministic 10-day forecast, including every tradable asset.\n    forecast = {s: float(0.01 * (score[s] - mean) / sd) for s in UNIVERSE}\n    rebalance_to_weights(target, forecast_returns=forecast, factor_ids=[x[0] for x in specs], horizon_days=10)\n    _last_decision = decision\n\nfactor_ensemble = ensemble\n\nif __name__ == "__main__":\n    print(json.dumps({"factors": [x["factor_id"] for x in ensemble()], "assets": len(UNIVERSE)}))\n', 'file_path': 'strategy.py'})
