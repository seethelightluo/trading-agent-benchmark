  ▶️ write_file({'content': "import numpy as np, pandas as pd\nfrom alphacrafter.sim.utils import get_index_daily_data, get_stock_daily_data, get_account_dict\nU=get_account_dict()['watch_list']\nframes={}\nfor s in U:\n    d=get_index_daily_data(s, days=2600)\n    if d is None or len(d)<150: d=get_stock_daily_data(s, days=2600)\n    if d is not None:\n        x=d[['date','close']].copy(); x['date']=pd.to_datetime(x.date); x=x.drop_duplicates('date').set_index('date').close\n        frames[s]=x\np=pd.concat(frames,axis=1).sort_index().ffill()\nr=p.pct_change()\n# cross-asset relative trend: asset 20d return less contemporaneous cross-sectional median, scaled by own vol; lag all inputs\nmom=p.pct_change(20); med=mom.median(axis=1); vol=r.rolling(30).std()*np.sqrt(20)\nf=(mom.sub(med,axis=0)/vol).shift(1)\n# evaluate forward 1,5,10 trading-day returns, cross sectional spearman\nfor h in [1,5,10,20]:\n    fr=p.shift(-h)/p-1\n    vals=[]\n    for dt in f.index:\n        a=f.loc[dt]; b=fr.loc[dt]; z=pd.concat([a,b],axis=1).dropna()\n        if len(z)>=8: vals.append(z.iloc[:,0].corr(z.iloc[:,1],method='spearman'))\n    q=pd.Series(vals).dropna()\n    print('h',h,'dates',len(q),'avg_n',round(p.shape[1],2),'IC',q.mean(),'ICIR',q.mean()/q.std(ddof=1)*np.sqrt(len(q)),'hit',(q>0).mean())\n# turnover and coverage\nrank=f.rank(axis=1,pct=True); turn=(rank.diff().abs().mean(axis=1)).mean(); print('coverage',f.notna().sum().sum()/f.size,'rank_turnover',turn,'period',p.index.min(),p.index.max())\nfor a,b in [('2020','2022'),('2023','2024'),('2025','2027')]:\n q=[]\n fr=p.shift(-1)/p-1\n for dt in f.loc[a:b].index:\n  z=pd.concat([f.loc[dt],fr.loc[dt]],axis=1).dropna()\n  if len(z)>=8:q.append(z.iloc[:,0].corr(z.iloc[:,1],method='spearman'))\n print(a,b,len(q),np.nanmean(q),np.nanmean(q)/np.nanstd(q,ddof=1)*np.sqrt(len(q)))\n# artifact\nout=f.stack().rename('signal').reset_index(); out.columns=['date','symbol','signal']; out.to_csv('scripts/miner_1_20270319_relative_trend_signal.csv',index=False)\n", 'file_path': 'scripts/miner_1_20270319_relative_trend.py'})
