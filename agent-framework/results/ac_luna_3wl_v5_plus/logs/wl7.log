px=pd.DataFrame(frames).sort_index().ffill(); rets=px.pct_change()
vol=rets.rolling(30,min_periods=25).std()*np.sqrt(252)
sig=(1/(vol+0.01)).shift(1).rank(axis=1,pct=True)
for h in [1,5,10,20]:
