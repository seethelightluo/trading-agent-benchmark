 import json
from pathlib import Path
import numpy as np
from alphacrafter.sim.utils import register_hook, get_stock_daily_data, get_index_daily_data, rebalance_to_weights

UNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
ENSEMBLE = Path(__file__).parent / "factors" / "factor_ensemble.json"
last_decision = None


def load_factors():
    try:
        return json.loads(ENSEMBLE.read_text(encoding="utf-8")).get("selected_factors", [])[:10]
    except Exception:
        return []


def percentile(values):
    out = {s: 0.5 for s in UNIVERSE}
    good = sorted((s, float(v)) for s, v in values.items() if np.isfinite(v))
    if not good:
        return out
    n = len(good)
    for i, (s, _) in enumerate(good):
        out[s] = (i + 0.5) / n
    return out


def bounded(raw):
    # Diversified full-investment portfolio; fractional quantities are handled by helper.
    w = {s: max(float(raw.get(s, 1.0 / 15.0)), 1e-10) for s in UNIVERSE}
    for _ in range(40):
        z = sum(w.values())
        w = {s: x / z for s, x in w.items()}
        lo = [s for s in UNIVERSE if w[s] < 0.02]
        hi = [s for s in UNIVERSE if w[s] > 0.14]
        if not lo and not hi:
            break
        fixed = set(lo + hi)
        for s in lo: w[s] = 0.02
        for s in hi: w[s] = 0.14
        free = [s for s in UNIVERSE if s not in fixed]
        rem = 1.0 - sum(w[s] for s in fixed)
        if free and rem > 0:
            z = sum(w[s] for s in free)
            for s in free: w[s] *= rem / z
    z = sum(w.values())
    return {s: float(w[s] / z) for s in UNIVERSE}


@register_hook
def cross_asset_strategy():
    global last_decision
    factors = load_factors()
    if len(factors) == 0 or len(factors) > 10:
        return

    feat, vol, stamps = {}, {}, {}
    for symbol in UNIVERSE:
        df = get_stock_daily_data(symbol=symbol, days=190)
        if df is None or len(df) < 80:
            continue
        df = df.sort_values("date")
        close = np.asarray(df["close"], dtype=float)
        if len(close) < 65 or np.any(~np.isfinite(close)) or np.any(close <= 0):
            continue
        # Lag one completed bar: the current day's bar is never used.
        c = close[:-1]
        r = c[1:] / c[:-1] - 1.0
        m5, m10, m20, m40 = c[-1]/c[-6]-1, c[-1]/c[-11]-1, c[-1]/c[-21]-1, c[-1]/c[-41]-1
        r10, r20, r40 = r[-10:], r[-20:], r[-40:]
        v10, v20, v40 = max(np.std(r10), .008), max(np.std(r20), .008), max(np.std(r40), .008)
        neg = r20[r20 < 0]
        down = max(np.std(neg) if len(neg) > 1 else .008, .008)
        feat[symbol] = {
            "multi": (m10/(np.sqrt(10)*v10) + m20/(np.sqrt(20)*v20) + m40/(np.sqrt(40)*v40))/3,
            "persistence": np.mean(r20 > 0) + .35*np.mean(r40 > 0) + .25*m20/(np.sqrt(20)*v20),
            "quality": m20/(np.sqrt(20)*v20) * (.5 + np.mean(r20 > 0)),
            "volume": m10/(np.sqrt(10)*v10) * (1 + .25*np.tanh(np.log1p(float(np.mean(np.asarray(df["volume"], float)[-21:-1]))))),
            "recovery": (m5 + m10) / (2*max(v10, .008)),
            "breakout": m20/max(v20,.008) + m10/max(v10,.008) - .5*v20/v40,
            "sortino": m20/(np.sqrt(20)*down),
            "vixrev": -m10/v10,
            "stress": -m10/v10,
            "dispersion": -abs(m10 - m20/2)/v20,
        }
        vol[symbol] = max(float(np.std(r[-25:])), .008)
        stamps[symbol] = str(df.iloc[-1]["date"])
    if len(feat) < 12:
        return
    stamp = max(stamps.values())
    if last_decision is not None and (np.datetime64(stamp)-np.datetime64(last_decision))/np.timedelta64(1, "D") < 10:
        return

    vix_z = 0.0
    vix = get_index_daily_data(symbol="VIX", days=65)
    if vix is not None and len(vix) >= 32:
        vc = np.asarray(vix.sort_values("date")["close"], dtype=float)
        base = vc[-62:-2] if len(vc) >= 62 else vc[:-2]
        vix_z = (vc[-2]-np.mean(base))/max(np.std(base), 1e-8)

    mapping = {
        "miner_1_20270622_multihorizon_agreement": "multi",
        "miner_2_20270609_persistence_momentum": "persistence",
        "miner_1_20270609_quality_momentum": "quality",
        "miner_1_20270707_volume_confirmed_momentum": "volume",
        "miner_1_20270707_recovery_efficiency_10d": "recovery",
        "miner_3_20270615_compression_breakout": "breakout",
        "miner_2_20270324_downside_sortino_momentum": "sortino",
        "miner_3_20270302_vix_conditioned_reversal": "vixrev",
        "miner_3_20270506_continuous_stress_reversal": "stress",
        "miner_2_20270506_dispersion_reversal": "dispersion",
    }
    score = {s: 0.5 for s in UNIVERSE}
    for factor in factors:
        key = mapping.get(factor.get("factor_id"))
        if key is None:
            continue
        vals = {s: feat[s][key] for s in feat}
        if key == "vixrev" and vix_z <= 0.75:
            vals = {s: 0.0 for s in vals}
        rr = percentile({s: float(factor.get("direction", 1)) * v for s, v in vals.items()})
        for s in UNIVERSE:
            score[s] += float(factor.get("weight", 0.0)) * (rr[s] - 0.5)

    risk_off = vix_z > 0.75 or feat.get("SPX", {}).get("multi", 0.0) < 0
    if risk_off:
        for s in ("XAU", "US10Y", "CN10Y"): score[s] += 0.08
        for s in ("BTC", "ETH", "WTI"): score[s] -= 0.05
    inv_avg = np.mean([1.0 / vol.get(s, .02) for s in UNIVERSE])
    raw = {s: max(score[s], 0.05) * (.78 + .22*(1.0/vol.get(s,.02))/inv_avg) for s in UNIVERSE}
    target = bounded(raw)
    mean_score = np.mean(list(score.values()))
    scale = max(np.std(list(score.values())), 1e-8)
    forecast = {s: float(0.01*(score[s]-mean_score)/scale) for s in UNIVERSE}
    rebalance_to_weights(target, forecast_returns=forecast,
                         factor_ids=[f["factor_id"] for f in factors], horizon_days=10)
    last_decision = stamp


strategy = cross_asset_strategy

