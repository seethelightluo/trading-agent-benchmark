 import json
from pathlib import Path
import numpy as np
from alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights

UNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
ENSEMBLE_PATH = Path(__file__).parent / "factors" / "factor_ensemble.json"
_last_date = None


def ranks(vals, direction=1):
    out = {s: 0.5 for s in UNIVERSE}
    good = [(s, direction * v) for s, v in vals.items() if np.isfinite(v)]
    good.sort(key=lambda x: x[1])
    for i, (s, _) in enumerate(good):
        out[s] = (i + 1) / max(len(good), 1)
    return out


def project(raw):
    # Full investment, sensible bounds for a 15-name cross-section.
    lo, hi = 0.015, 0.16
    w = {s: max(float(raw.get(s, 0.01)), 1e-8) for s in UNIVERSE}
    for _ in range(20):
        z = sum(w.values())
        w = {s: x / z for s, x in w.items()}
        low = [s for s in UNIVERSE if w[s] < lo]
        high = [s for s in UNIVERSE if w[s] > hi]
        if not low and not high:
            break
        for s in low: w[s] = lo
        for s in high: w[s] = hi
    z = sum(w.values())
    return {s: w[s] / z for s in UNIVERSE}


@register_hook
def cross_asset_strategy():
    global _last_date
    obj = json.loads(ENSEMBLE_PATH.read_text(encoding="utf-8"))
    selected = obj.get("selected_factors", [])[:10]
    if not selected:
        return
    specs = {x["factor_id"]: (float(x["weight"]), int(x.get("direction", 1))) for x in selected}
    data = {}
    for s in UNIVERSE:
        df = get_stock_daily_data(symbol=s, days=110)
        if df is None or len(df) < 35:
            continue
        df = df.sort_values("date").reset_index(drop=True)
        c, h, l, o = [np.asarray(df[x], float) for x in ("close", "high", "low", "open")]
        volu = np.asarray(df["volume"], float)
        r = c[1:] / np.maximum(c[:-1], 1e-12) - 1
        data[s] = (c, h, l, o, volu, r, str(df.iloc[-1]["date"]))
    if len(data) < 12:
        return
    date = max(x[6] for x in data.values())
    if _last_date is not None and (np.datetime64(date) - np.datetime64(_last_date)) / np.timedelta64(1, "D") < 10:
        return

    vals = {f: {} for f in specs}
    ret5 = {}
    for s, (c, h, l, o, vu, r, _) in data.items():
        sd20 = max(float(np.std(r[-20:])), 0.008)
        r5, r3, r20 = c[-1]/c[-6]-1, c[-1]/c[-4]-1, c[-1]/c[-21]-1
        efficiency = r20 / max(float(np.sum(np.abs(r[-20:]))), 1e-9)
        clv = (2*c[-1]-h[-1]-l[-1]) / max(h[-1]-l[-1], 1e-9)
        range20 = np.maximum(h[-20:]-l[-20:], 1e-9)
        # Intraday reversal, volatility-normalized reversal, and shock reversal.
        intraday = (c[-1]-o[-1]) / max(range20[-1], 1e-9)
        vz = (vu[-1]-np.mean(vu[-21:-1])) / max(float(np.std(vu[-21:-1])), 1e-9)
        ret5[s] = r5
        raw = {
          "miner_2_20260827_range_efficiency_momentum": efficiency*r20/sd20,
          "miner_2_20260716_risk_adjusted_momentum_20d": r20/sd20,
          "miner_1_20260716_peer_median_leadlag_5d": r5,
          "miner_3_20260827_range_weighted_intraday_reversal": -intraday*range20[-1]/max(float(np.mean(range20)),1e-9),
          "miner_3_20260716_clv_1d": clv,
          "miner_1_20260924_relative_volnorm_reversal_5d": -r5/sd20,
          "miner_3_20261008_asymmetric_volatility_reversal_2d": -(c[-1]/c[-3]-1)/sd20 * (1 + min(max(-r[-1]/sd20,0),2)*0.25),
          "miner_3_volume_confirmed_reversal_3d": -(c[-1]/c[-4]-1)/sd20 * (1 + min(max(vz,0),2)*0.25)
        }
        for f in specs:
            if f in raw: vals[f][s] = raw[f]
    if "miner_1_20260716_peer_median_leadlag_5d" in vals:
        vals["miner_1_20260716_peer_median_leadlag_5d"] = {s: v-np.median([x for t,x in ret5.items() if t != s]) for s,v in ret5.items()}

    score = {s: 0.5 for s in UNIVERSE}
    for f, (wt, direction) in specs.items():
        rr = ranks(vals[f], direction)
