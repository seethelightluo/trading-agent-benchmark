 import json
from pathlib import Path
import numpy as np
from alphacrafter.sim.utils import (
    register_hook, get_stock_daily_data, get_index_daily_data,
    rebalance_to_weights,
)

UNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
ENSEMBLE = Path(__file__).parent / "factors" / "factor_ensemble.json"
last_decision = None


def load_factors():
    try:
        return json.loads(ENSEMBLE.read_text(encoding="utf-8")).get("selected_factors", [])[:10]
    except Exception:
        return []


def percentile(values):
    out = {s: 0.5 for s in UNIVERSE}
    good = sorted((s, v) for s, v in values.items() if np.isfinite(v))
    if good:
        for i, (s, _) in enumerate(good):
            out[s] = (i + 0.5) / len(good)
    return out


def bounded_weights(raw):
    # 15-asset, fully invested, long-only portfolio; no cash sleeve.
    w = {s: max(float(raw.get(s, 1.0 / 15.0)), 1e-8) for s in UNIVERSE}
    for _ in range(50):
        z = sum(w.values())
        w = {s: x / z for s, x in w.items()}
        low = [s for s in UNIVERSE if w[s] < 0.02]
        high = [s for s in UNIVERSE if w[s] > 0.14]
        if not low and not high:
            break
        fixed = set(low + high)
        for s in low: w[s] = 0.02
        for s in high: w[s] = 0.14
        free = [s for s in UNIVERSE if s not in fixed]
        rem = 1.0 - sum(w[s] for s in fixed)
        if free and rem > 0:
            z = sum(w[s] for s in free)
            for s in free: w[s] *= rem / z
    z = sum(w.values())
    return {s: w[s] / z for s in UNIVERSE}


@register_hook
def cross_asset_strategy():
    global last_decision
    factors = load_factors()
    if not factors or len(factors) > 10:
        return

    # All inputs end one completed session before the decision (lagged bars).
    features, vols, dates = {}, {}, {}
    for symbol in UNIVERSE:
        df = get_stock_daily_data(symbol=symbol, days=190)
        if df is None or len(df) < 80:
            continue
        close = np.asarray(df.sort_values("date")["close"], dtype=float)
        if np.any(~np.isfinite(close)) or np.any(close <= 0):
            continue
        ret = close[1:] / close[:-1] - 1.0
        r10, r20, r40 = ret[-11:-1], ret[-21:-1], ret[-41:-1]
        m10, m20 = close[-2] / close[-12] - 1.0, close[-2] / close[-22] - 1.0
        v10, v20 = max(np.std(r10), .008), max(np.std(r20), .008)
        v40 = max(np.std(r40), .008)
        down = max(np.std(r20[r20 < 0]) if np.sum(r20 < 0) > 1 else .008, .008)
        consistency = np.mean(r40 > 0)
        features[symbol] = {
            "quality": (m20 / v20) * np.clip(1 - .25 * v20 / v40, .5, 1.25) * (.5 + np.mean(r20 > 0)),
            "risk20": m20 / (np.sqrt(20) * v20),
            "risk10": m10 / (np.sqrt(10) * v20),
            "asymrev": -np.sign(m10) * abs(m10) / v20,
            "stress": -m10 / v20,
            "vixrev": -m10 / v20,
        }
        vols[symbol] = max(float(np.std(ret[-26:-1])), .008)
        dates[symbol] = str(df.sort_values("date").iloc[-1]["date"])
    if len(features) < 12:
        return
    stamp = max(dates.values())
    if last_decision is not None and (np.datetime64(stamp) - np.datetime64(last_decision)) / np.timedelta64(1, "D") < 10:
        return

    vix = get_index_daily_data(symbol="VIX", days=65)
    vix_z = 0.0
    if vix is not None and len(vix) >= 32:
        vc = np.asarray(vix.sort_values("date")["close"], dtype=float)
        base = vc[-62:-2]
        vix_z = (vc[-2] - np.mean(base)) / max(np.std(base), 1e-8)
    mapping = {
        "miner_1_20270609_quality_momentum": "quality",
        "miner_3_20270604_risk_adjusted_20d_momentum": "risk20",
        "miner_3_20270526_risk_adjusted_10d_momentum": "risk10",
        "miner_3_20261130_asymmetric_volatility_reversal_2d_revalidated": "asymrev",
        "miner_3_20270506_continuous_stress_reversal": "stress",
        "miner_3_20270503_vix_stress_reversal": "vixrev",
    }
    score = {s: 0.5 for s in UNIVERSE}
    for factor in factors:
        key = mapping.get(factor.get("factor_id"))
        if key is None:
            continue
        vals = {s: features[s][key] for s in features}
        # Stress factors are explicitly inactive outside their validated VIX regime.
        if key in ("stress", "vixrev") and vix_z <= 0.75:
            vals = {s: 0.0 for s in vals}
        ranks = percentile({s: float(factor.get("direction", 1)) * v for s, v in vals.items()})
        for s in UNIVERSE:
            score[s] += float(factor.get("weight", 0.0)) * (ranks[s] - 0.5)

    risk_off = vix_z > 0.75 or features.get("SPX", {}).get("quality", 0.0) < 0
    if risk_off:
        for s in ("XAU", "US10Y", "CN10Y"): score[s] += 0.08
        for s in ("BTC", "ETH", "WTI"): score[s] -= 0.05
    inv_avg = np.mean([1.0 / vols.get(s, .02) for s in UNIVERSE])
    raw = {s: max(score[s], .05) * (.78 + .22 * (1.0 / vols.get(s, .02)) / inv_avg) for s in UNIVERSE}
    target = bounded_weights(raw)
    mean_score, sd_score = np.mean(list(score.values())), max(np.std(list(score.values())), 1e-8)
    forecast = {s: float(.01 * (score[s] - mean_score) / sd_score) for s in UNIVERSE}
    rebalance_to_weights(target, forecast_returns=forecast,
                         factor_ids=[f["factor_id"] for f in factors], horizon_days=10)
    last_decision = stamp


strategy = cross_asset_strategy

