  ▶️ write_file({'content': "import numpy as np, pandas as pd\nfrom alphacrafter.sim.utils import get_index_daily_data\n\nU=['000300.SH','SPX','HSI','N225','SX5E','000688.SH','SOX','NDX','XAU','COPPER','WTI','BTC','ETH','US10Y','CN10Y']\nraw={s:get_index_daily_data(s,days=2200) for s in U}\npx=pd.DataFrame({s:(d.set_index('date')['close'] if d is not None else pd.Series(dtype=float)) for s,d in raw.items()}).sort_index().ffill()\n# Candidate: range-normalized 3-day reversal. Close-to-close reversal, scaled by prior 20d range,\n# with a mild close-location shock term; all inputs lagged one session.\nret=px.pct_change()\nvol=ret.rolling(20,min_periods=15).std()\nrng=((px.rolling(20,min_periods=15).max()-px.rolling(20,min_periods=15).min())/px)\nbase=-ret.rolling(3,min_periods=3).sum()\nfactor=(base/(vol*np.sqrt(3)+1e-12))/(1+rng)\nfactor=factor.shift(1)\nfwd=px.pct_change().shift(-1)\nrows=[]; by=[]\nfor dt in factor.index:\n x=factor.loc[dt]; y=fwd.loc[dt]; ok=x.notna()&y.notna()\n if ok.sum()>=8:\n  ic=x[ok].corr(y[ok]); rows.append((dt,ic,ok.sum()))\n  by.append((dt,ic))\nr=pd.DataFrame(rows,columns=['date','ic','n']).set_index('date')\nprint('candidate=range_normalized_3d_reversal')\nprint('dates',len(r),'avg_n',round(r.n.mean(),2),'coverage_pct',round(100*factor.notna().sum().sum()/(factor.size),2))\nprint('IC',round(r.ic.mean(),8),'ICIR',round(r.ic.mean()/r.ic.std(ddof=1)*np.sqrt(252),6),'hit',round((r.ic>0).mean(),4),'turnover',round(factor.rank(axis=1,pct=True).diff().abs().mean(axis=1).mean(),6))\nfor h in [5,10,20]:\n yy=px.pct_change(h).shift(-h)\n z=[]\n for dt in factor.index:\n  a=factor.loc[dt]; b=yy.loc[dt]; ok=a.notna()&b.notna()\n  if ok.sum()>=8:z.append(a[ok].corr(b[ok]))\n z=pd.Series(z).dropna();print('h',h,'dates',len(z),'IC',round(z.mean(),8),'ICIR',round(z.mean()/z.std(ddof=1)*np.sqrt(252),6))\nfor a,b in [('2020','2022'),('2023','2024'),('2025','2027')]:\n z=r.loc[a:b].ic; print(a,b,'n',len(z),'IC',round(z.mean(),8) if len(z) else None)\n# artifact for provenance\nout=factor.stack().rename('signal').reset_index(); out.columns=['date','symbol','signal'];out.to_csv('scripts/miner_1_20270303_range_reversal_signal.csv',index=False)\n", 'file_path': 'scripts/miner_1_20270303_range_reversal.py'})
