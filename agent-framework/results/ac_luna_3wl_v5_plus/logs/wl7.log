:] < 0]\n        dn = max(np.std(neg) if len(neg) > 1 else v30, .008)\n        volser = np.asarray(df.volume, float)[:-1] if "volume" in df else np.ones(len(c))\n        vr = (volser[-1] / max(np.mean(volser[-20:]), 1e-9) - 1) if len(volser) >= 20 else 0\n        features[s] = {\n            "breadth": .6*ret(20)/v20 + .4*ret(5)/v10,\n            "range_reversal": -ret(1)/v5,\n            "asym_reversal": -ret(2)/v5,\n            "volume_reversal": -ret(3)/v10 * (1 + .25*np.tanh(vr)),\n            "residual": ret(20)/v20 - .35*ret(5)/v10,\n            "stress_trend": ret(30)/v30 / (1 + max(0, v30/max(np.std(r[-100:]),.008)-1)),\n            "risk_momentum": ret(20)/max(v20, .01),\n        }\n        vols[s] = max(np.std(r[-25:]), .008)\n        stamps[s] = str(df.iloc[-1].date)\n    stamp = max(stamps.values())\n    if last_decision is not None:\n        try:\n            if (np.datetime64(stamp)-np.datetime64(last_decision))/np.timedelta64(1,"D") < 10: return\n        except Exception: return\n    key = {\n      "miner_1_20270827_breadth_defensive_trend":"breadth",\n      "miner_3_range_weighted_intraday_reversal_1d":"range_reversal",\n      "miner_3_20261130_asymmetric_volatility_reversal_2d_revalidated":"asym_reversal",\n      "miner_3_volume_confirmed_reversal_3d":"volume_reversal",\n      "miner_2_20270823_residual_momentum_20d":"residual",\n      "miner_1_20270830_stress_conditional_trend":"stress_trend",\n      "miner_3_20270604_risk_adjusted_20d_momentum":"risk_momentum"\n    }\n    score = {s:.5 for s in UNIVERSE}\n    for f in fs:\n        k = key.get(f.get("factor_id"))\n        if k:\n            rr = rank({s: float(f.get("direction",1))*features[s][k] for s in UNIVERSE})\n            for s in UNIVERSE: score[s] += float(f.get("weight",0))* (rr[s]-.5)\n    vix = get_index_daily_data(symbol="VIX", days=70)\n    stressed = False\n    if vix is not None and len(vix)>35:\n        x=np.asarray(vix.sort_values("date").close,float)[:-1]\n        stressed = x[-1] > np.mean(x[-30:]) + .5*np.std(x[-30:])\n    bear = features["SPX"]["breadth"] < 0 and features["SPX"]["stress_trend"] < 0\n    if bear or stressed:\n        for s in ("XAU","US10Y","CN10Y"): score[s] += .08\n        for s in ("BTC","ETH","WTI"): score[s] -= .05\n    inv = {s:1/vols[s] for s in UNIVERSE}; avg=np.mean(list(inv.values()))\n    raw={s:max(score[s],.05)*(.78+.22*inv[s]/avg) for s in UNIVERSE}\n    mu=np.mean(list(score.values())); sd=max(np.std(list(score.values())),1e-8)\n    forecast={s:float(.01*(score[s]-mu)/sd) for s in UNIVERSE}\n    rebalance_to_weights(cap_weights(raw), forecast_returns=forecast, factor_ids=[f["factor_id"] for f in fs], horizon_days=10)\n    last_decision=stamp\n\nstrategy = cross_asset_strategy\n', 'file_path': 'strategy.py'})

