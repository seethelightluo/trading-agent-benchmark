 import json
from pathlib import Path
import numpy as np
from alphacrafter.sim.utils import register_hook, get_stock_daily_data, get_index_daily_data, rebalance_to_weights

UNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
ENSEMBLE = Path(__file__).parent / "factor_ensemble.json"
last_decision = None

def load_factors():
    try:
        return json.loads(ENSEMBLE.read_text(encoding="utf-8")).get("selected_factors", [])[:10]
    except Exception:
        return []

def rank(x):
    out = {s: .5 for s in UNIVERSE}
    good = sorted((s, float(v)) for s, v in x.items() if np.isfinite(v))
    n = len(good)
    for i, (s, _) in enumerate(good): out[s] = (i + .5) / n
    return out

def bounded_weights(raw):
    # Full investment, modest 2%-14% bounds, suitable for a 15-name universe.
    w = {s: max(float(raw.get(s, 1/15)), 1e-9) for s in UNIVERSE}
    for _ in range(30):
        total = sum(w.values()); w = {s: v / total for s, v in w.items()}
        lo = {s for s in UNIVERSE if w[s] < .02}
        hi = {s for s in UNIVERSE if w[s] > .14}
        if not lo and not hi: break
        fixed = lo | hi
        for s in lo: w[s] = .02
        for s in hi: w[s] = .14
        free = [s for s in UNIVERSE if s not in fixed]
        rem = 1.0 - sum(w[s] for s in fixed)
        if free and rem > 0:
            scale = rem / sum(w[s] for s in free)
            for s in free: w[s] *= scale
    z = sum(w.values())
    return {s: w[s] / z for s in UNIVERSE}

@register_hook
def cross_asset_strategy():
    global last_decision
    factors = load_factors()
    if not factors: return
    prices, vols = {}, {}
    for s in UNIVERSE:
        d = get_stock_daily_data(symbol=s, days=190)
        if d is None or len(d) < 80: continue
        c = np.asarray(d.sort_values("date")["close"], dtype=float)
        if np.all(np.isfinite(c)) and np.all(c > 0):
            prices[s] = c
            r = c[1:] / c[:-1] - 1
            vols[s] = max(float(np.std(r[-26:-1])), .008)
    if len(prices) < 12: return
    dates = [str(get_stock_daily_data(symbol=s, days=190).sort_values("date").iloc[-1]["date"]) for s in prices]
    stamp = max(dates)
    if last_decision is not None and (np.datetime64(stamp) - np.datetime64(last_decision)) / np.timedelta64(1, "D") < 10: return

    # Every statistic ends at -2: the latest completed observation is deliberately lagged.
    signals = {}
    for s, c in prices.items():
        r = c[1:] / c[:-1] - 1
        r5, r20, r40 = r[-6:-1], r[-21:-1], r[-41:-1]
        m5, m20 = c[-2] / c[-7] - 1, c[-2] / c[-22] - 1
        v5, v20 = max(float(np.std(r5)), .008), max(float(np.std(r20)), .008)
        down = max(float(np.std(r20[r20 < 0])) if np.sum(r20 < 0) > 1 else .008, .008)
        consistency = float(np.mean(r40 > 0))
        efficiency = abs(float(np.sum(r20))) / max(float(np.sum(abs(r20))), .008)
        vol_state = min(2., max(.5, float(np.std(r40)) / v20))
        peak = max(c[-42:-1]); trough = min(c[-42:-1])
        recovery = (c[-2] / max(trough, 1e-9) - 1) * efficiency
        signals[s] = {
            "downside": m20 / down, "range": m20 / v20 * efficiency,
            "consistency": consistency * m20 / v20,
            "volstate": m20 / v20 * vol_state,
            "stress": -m5 / v5, "recovery": recovery / v20,
        }

    vix_ratio = 1.0
    vd = get_index_daily_data(symbol="VIX", days=65)
    if vd is not None and len(vd) >= 32:
        vc = np.asarray(vd.sort_values("date")["close"], dtype=float)
        vix_ratio = max(1., float(vc[-2] / max(np.median(vc[-32:-2]), 1e-9)))
    for s in signals: signals[s]["vix"] = signals[s]["stress"] * vix_ratio

    keymap = {
        "downside_risk_momentum": "downside", "range_efficiency_momentum": "range",
        "trend_consistency_risk_adjusted": "consistency", "vol_state_momentum": "volstate",
        "continuous_stress_reversal": "stress", "vix_amplified_reversal": "vix",
        "recovery_efficiency": "recovery",
    }
    score = {s: .5 for s in UNIVERSE}
    for f in factors:
        key = next((v for k, v in keymap.items() if k in f.get("factor_id", "")), None)
        if key is None: continue
        rr = rank({s: f.get("direction", 1) * signals[s][key] for s in signals})
        for s in UNIVERSE: score[s] += float(f.get("weight", 0)) * (rr[s] - .5)

    spx = prices.get("SPX")
    riskoff = vix_ratio > 1.2 or (spx is not None and spx[-2] < spx[-22])
    if riskoff:
        for s in ("XAU", "US10Y", "CN10Y"): score[s] += .10
        for s in ("BTC", "ETH", "WTI"): score[s] -= .07
    invmean = np.mean([1 / vols.get(s, .02) for s in UNIVERSE])
    raw = {s: max(score[s], .05) * (.78 + .22 * (1 / vols.get(s, .02)) / invmean) for s in UNIVERSE}
    target = bounded_weights(raw)
    mean, sd = np.mean(list(score.values())), max(float(np.std(list(score.values()))), 1e-9)
    forecast = {s: float(.01 * (score[s] - mean) / sd) for s in UNIVERSE}
    rebalance_to_weights(target, forecast_returns=forecast,
                         factor_ids=[f["factor_id"] for f in factors], horizon_days=10)
    last_decision = stamp

