 import json
from pathlib import Path
import numpy as np
from alphacrafter.sim.utils import (
    register_hook, get_stock_daily_data, get_index_daily_data,
    rebalance_to_weights,
)

UNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
ENSEMBLE_PATH = Path(__file__).parent / "factors" / "factor_ensemble.json"
_last_decision = None


def get_ensemble():
    try:
        obj = json.loads(ENSEMBLE_PATH.read_text(encoding="utf-8"))
        return obj.get("selected_factors", [])[:10]
    except Exception:
        return []


def xrank(values):
    valid = sorted((s, v) for s, v in values.items() if np.isfinite(v))
    result = {s: 0.5 for s in UNIVERSE}
    n = len(valid)
    for i, (s, _) in enumerate(valid):
        result[s] = (i + 1) / n if n else 0.5
    return result


def bounded_weights(raw):
    w = {s: max(float(raw.get(s, 0.0)), 0.0) for s in UNIVERSE}
    total = sum(w.values()) or 1.0
    w = {s: v / total for s, v in w.items()}
    # Moderate concentration while retaining a signal-driven allocation.
    for _ in range(10):
        low = [s for s in UNIVERSE if w[s] < 0.02]
        high = [s for s in UNIVERSE if w[s] > 0.14]
        if not low and not high:
            break
        for s in low: w[s] = 0.02
        for s in high: w[s] = 0.14
        fixed = set(low + high)
        free = [s for s in UNIVERSE if s not in fixed]
        remainder = 1.0 - sum(w[s] for s in fixed)
        free_sum = sum(w[s] for s in free) or 1.0
        for s in free: w[s] *= remainder / free_sum
    z = sum(w.values())
    return {s: w[s] / z for s in UNIVERSE}


@register_hook
def cross_asset_strategy():
    global _last_decision
    selected = get_ensemble()
    if not selected:
        return
    specs = {f["factor_id"]: (float(f["weight"]), int(f.get("direction", 1))) for f in selected}
    prices, returns, vols, dates = {}, {}, {}, {}
    for symbol in UNIVERSE:
        df = get_stock_daily_data(symbol=symbol, days=160)
        if df is None or len(df) < 80:
            continue
        df = df.sort_values("date")
        close = np.asarray(df["close"], dtype=float)
        ret = close[1:] / np.maximum(close[:-1], 1e-12) - 1.0
        prices[symbol], returns[symbol] = close, ret
        vols[symbol] = max(float(np.std(ret[-22:-1])), 0.008)
        dates[symbol] = str(df.iloc[-1]["date"])
    if len(prices) < 12:
        return
    decision = max(dates.values())
    if _last_decision is not None:
        if (np.datetime64(decision) - np.datetime64(_last_decision)) / np.timedelta64(1, "D") < 10:
            return

    vix = get_index_daily_data(symbol="VIX", days=80)
    vix_high = False
    if vix is not None and len(vix) >= 32:
        vc = np.asarray(vix.sort_values("date")["close"], dtype=float)
        vix_high = bool(vc[-2] > 1.2 * np.median(vc[-32:-2]))

    factor_values = {f: {} for f in specs}
    for symbol, close in prices.items():
        ret = returns[symbol]
        # Last observation is excluded: decisions use the previous completed bar.
        p = close[:-1]
        rr = ret[:-1]
        if len(p) < 35: continue
        r5, r10, r20, r30 = p[-1]/p[-6]-1, p[-1]/p[-11]-1, p[-1]/p[-21]-1, p[-1]/p[-31]-1
        recent = rr[-21:]
        vol = max(float(np.std(recent)), 0.008)
        breadth = float(np.mean(recent > 0))
        consistency = breadth * (0.5 + max(r20, -0.5) / max(vol, 0.008))
        efficiency = r20 / max(float(np.sum(np.abs(recent))), 0.02)
        downside = max(float(np.std(recent[recent < 0])), 0.008) if np.any(recent < 0) else 0.008
        vals = {
            "breadth": r20 / vol * (0.5 + breadth),
            "dispersion": r20 / vol,
            "consistency": consistency,
            "volstate": r20 / vol * (0.75 if vix_high else 1.0),
            "persistent": (0.5*r20 + 0.3*r10 + 0.2*r30) / vol,
            "downside": r20 / downside,
            "breakout": (r30 + r20) / max(vol, 0.008),
            "vixmomentum": r20 / vol * (0.7 if vix_high else 1.0),
        }
        for factor in specs:
            if "signed_breadth" in factor: key = "breadth"
            elif "dispersion_conditioned" in factor: key = "dispersion"
            elif "trend_consistency" in factor: key = "consistency"
            elif "vol_state" in factor: key = "volstate"
            elif "persistent_trend" in factor: key = "persistent"
            elif "downside_trend" in factor: key = "downside"
            elif "breakout_persistence" in factor: key = "breakout"
            elif "vix_conditioned" in factor: key = "vixmomentum"
            else: key = "dispersion"
            factor_values[factor][symbol] = vals[key]

    score = {s: 0.5 for s in UNIVERSE}
    for factor, (weight, direction) in specs.items():
        ranked = xrank({s: direction*v for s, v in factor_values[factor].items()})
        for s in UNIVERSE: score[s] += weight * (ranked[s] - 0.5)

    spx = prices.get("SPX")
    risk_off = vix_high or (spx is not None and (spx[-2] < spx[-22] or np.mean(returns["SPX"][-7:-2]) < 0))
    if risk_off:
        for s in ("XAU", "US10Y", "CN10Y"): score[s] += 0.10
        for s in ("BTC", "ETH", "WTI"): score[s] -= 0.06

    inv_mean = np.mean([1.0 / max(vols.get(s, 0.02), 0.008) for s in UNIVERSE])
    raw = {s: max(score[s], 0.02) * (0.78 + 0.22*(1.0/max(vols.get(s, 0.02), 0.008))/inv_mean) for s in UNIVERSE}
    target = bounded_weights(raw)
    mean, std = np.mean(list(score.values())), max(float(np.std(list(score.values()))), 1e-12)
    forecast = {s: float(0.01 * (score[s] - mean) / std) for s in UNIVERSE}
    rebalance_to_weights(target, forecast_returns=forecast, factor_ids=list(specs), horizon_days=10)
    _last_decision = decision


