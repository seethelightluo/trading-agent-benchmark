@register_hook
def cross_asset_strategy():
    global _last_decision
    selected = ensemble()
    if not selected: return
    specs = [(str(x["factor_id"]), float(x["weight"]), int(x.get("direction", 1))) for x in selected]
    closes, returns, vol = {}, {}, {}
    for s in UNIVERSE:
        d = get_stock_daily_data(symbol=s, days=180)
        if d is None or len(d) < 70: continue
        c = np.asarray(d.sort_values("date")["close"], dtype=float)
        if np.all(np.isfinite(c)) and np.all(c > 0):
            closes[s] = c
            returns[s] = c[1:] / c[:-1] - 1.0
            vol[s] = max(float(np.std(returns[s][-22:-1])), 0.008)
    if len(closes) < 12: return
    # Decision uses completed data only; rebalance at most once per ten trading days.
    decision = max(str(get_stock_daily_data(symbol=s, days=180).sort_values("date").iloc[-1]["date"]) for s in closes)
    if _last_decision is not None:
        try:
            if (np.datetime64(decision) - np.datetime64(_last_decision)) / np.timedelta64(1, "D") < 10: return
        except Exception: return

    feat = {s: {} for s in closes}
    for s, c in closes.items():
        p = c[:-1]; r = returns[s][:-1]
        q = r[-20:]
        r5, r10, r20, r30 = p[-1]/p[-6]-1, p[-1]/p[-11]-1, p[-1]/p[-21]-1, p[-1]/p[-31]-1
        v = max(float(np.std(q)), .008)
        downside = max(float(np.std(q[q < 0])) if np.any(q < 0) else .008, .008)
        breadth = float(np.mean(q > 0))
        path = max(float(np.sum(np.abs(q))), .02)
        feat[s] = {"breadth": breadth * (0.5 + r20 / v),
                   "dispersion": r20 / v,
                   "conditioned": breadth * r20 / v,
                   "volstate": r20 / v,
                   "consistency": breadth * (0.5 + r20 / v),
                   "persistent": (0.5*r20 + 0.3*r10 + 0.2*r30) / v,
                   "range": r20 / path,
                   "reversal": -r5 / v,
                   "downside": r20 / downside}
    score = {s: 0.5 for s in UNIVERSE}
    for fid, wt, direction in specs:
        if "signed_breadth" in fid: key = "breadth"
        elif "dispersion_conditioned" in fid: key = "dispersion"
        elif "conditioned_momentum" in fid: key = "conditioned"
        elif "vol_state" in fid: key = "volstate"
        elif "trend_consistency" in fid: key = "consistency"
        elif "persistent_trend" in fid: key = "persistent"
        elif "range_efficiency" in fid: key = "range"
        elif "asymmetric_volatility_reversal" in fid: key = "reversal"
        else: key = "conditioned"
        rr = percentile({s: direction * feat[s][key] for s in feat})
        for s in UNIVERSE: score[s] += wt * (rr[s] - 0.5)

    # Fragile/risk-off regime: express defense with tradable assets, never cash.
    vix = get_index_daily_data(symbol="VIX", days=65)
    high_vix = False
    if vix is not None and len(vix) >= 32:
