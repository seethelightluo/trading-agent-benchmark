 import json
from pathlib import Path
import numpy as np
from alphacrafter.sim.utils import (
    register_hook, get_account_dict, get_stock_daily_data, rebalance_to_weights,
)

UNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
ENSEMBLE_PATH = Path(__file__).parent / "factors" / "factor_ensemble.json"
REBALANCE_DAYS = 10
MIN_WEIGHT, MAX_WEIGHT = 0.015, 0.16
_last_decision = None


def _rank(values, direction=1):
    valid = sorted((s, direction * float(v)) for s, v in values.items() if np.isfinite(v))
    out = {s: 0.5 for s in UNIVERSE}
    if valid:
        n = len(valid)
        for i, (s, _) in enumerate(valid):
            out[s] = (i + 1.0) / n
    return out


def _box_simplex(raw):
    # Iterative capped/floored normalization; guarantees a complete target.
    w = {s: max(float(raw.get(s, 0.0)), 1e-12) for s in UNIVERSE}
    fixed = set()
    for _ in range(40):
        free = [s for s in UNIVERSE if s not in fixed]
        total_fixed = sum(w[s] for s in fixed)
        scale = (1.0 - total_fixed) / max(sum(w[s] for s in free), 1e-12)
        changed = False
        for s in free:
            w[s] *= scale
            if w[s] < MIN_WEIGHT:
                w[s] = MIN_WEIGHT; fixed.add(s); changed = True
            elif w[s] > MAX_WEIGHT:
                w[s] = MAX_WEIGHT; fixed.add(s); changed = True
        if not changed:
            break
    z = sum(w.values())
    return {s: w[s] / z for s in UNIVERSE}


def _ensemble():
    try:
        obj = json.loads(ENSEMBLE_PATH.read_text(encoding="utf-8"))
        selected = obj.get("selected_factors", [])
        selected = [x for x in selected if isinstance(x, dict) and x.get("factor_id")][:10]
        weights = {str(x["factor_id"]): float(x.get("weight", 0.0)) for x in selected}
        directions = {str(x["factor_id"]): int(x.get("direction", 1)) for x in selected}
        return selected, weights, directions
    except (OSError, ValueError, TypeError, KeyError):
        return [], {}, {}


@register_hook
def cross_asset_strategy():
    global _last_decision
    selected, factor_weights, directions = _ensemble()
    if not selected:
        return

    data = {}
    for symbol in UNIVERSE:
        df = get_stock_daily_data(symbol=symbol, days=90)
        if df is None or len(df) < 25:
            continue
        df = df.sort_values("date").reset_index(drop=True)
        c = np.asarray(df["close"], dtype=float)
        h = np.asarray(df["high"], dtype=float)
        l = np.asarray(df["low"], dtype=float)
        r = c[1:] / np.maximum(c[:-1], 1e-12) - 1.0
        data[symbol] = (c, h, l, r, str(df.iloc[-1]["date"]))
    if len(data) < 12:
        return
    decision = max(v[4] for v in data.values())
    if _last_decision is not None:
        try:
            elapsed = (np.datetime64(decision) - np.datetime64(_last_decision)) / np.timedelta64(1, "D")
            if elapsed < REBALANCE_DAYS:
                return
        except Exception:
            return

    clv, peer, reversal, momentum, invvol, ret5 = {}, {}, {}, {}, {}, {}
    for s, (c, h, l, r, _) in data.items():
        if len(c) < 22:
            continue
        clv[s] = float(np.mean((2*c[-3:] - h[-3:] - l[-3:]) / np.maximum(h[-3:] - l[-3:], 1e-12)))
        reversal[s] = -float(np.mean(r[-5:]))
        vol = max(float(np.std(r[-20:])), 0.008)
        invvol[s] = 1.0 / vol
        momentum[s] = float((c[-1] / max(c[-21], 1e-12) - 1.0) / (vol + 0.01))
        ret5[s] = float(c[-1] / max(c[-6], 1e-12) - 1.0)
    median5 = float(np.median(list(ret5.values())))
    peer = {s: v - median5 for s, v in ret5.items()}
    raw_factor = {"miner_3_20260716_clv_1d": clv, "miner_1_20260716_peer_median_leadlag_5d": peer,
                  "short_term_reversal_5d": reversal, "miner_2_20260716_risk_adjusted_momentum_20d": momentum}
    ranks = {fid: _rank(raw_factor.get(fid, {}), directions.get(fid, 1)) for fid in factor_weights}
    score = {s: sum(factor_weights[fid] * ranks[fid].get(s, 0.5) for fid in factor_weights) for s in UNIVERSE}

    # Sideways/mildly bullish baseline. In a clearly weak SPX trend, rotate within
    # the tradable universe toward defensive assets rather than using cash.
    if "SPX" in data:
        spx = data["SPX"][0]
        if spx[-1] < spx[-21] and spx[-1] < spx[-6]:
            for s in ("XAU", "US10Y", "CN10Y"):
                score[s] += 0.18
            for s in ("BTC", "ETH", "WTI"):
                score[s] = max(0.05, score[s] - 0.10)
    avg_iv = float(np.mean(list(invvol.values()))) if invvol else 1.0
    raw = {s: max(score[s], 0.01) * (0.78 + 0.22 * invvol.get(s, avg_iv) / max(avg_iv, 1e-12)) for s in UNIVERSE}
    weights = _box_simplex(raw)
    mean_score = float(np.mean(list(score.values())))
    sd_score = max(float(np.std(list(score.values()))), 1e-12)
    forecast_returns = {s: 0.01 * (score[s] - mean_score) / sd_score for s in UNIVERSE}
    factor_ids = [str(x["factor_id"]) for x in selected]
    rebalance_to_weights(weights, forecast_returns=forecast_returns, factor_ids=factor_ids, horizon_days=10)
    _last_decision = decision


