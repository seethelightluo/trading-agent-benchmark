  ▶️ write_file({'content': 'import json\nfrom pathlib import Path\nimport numpy as np\nfrom alphacrafter.sim.utils import (\n    register_hook, get_stock_daily_data, get_index_daily_data,\n    rebalance_to_weights,\n)\n\nUNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]\nENSEMBLE = Path(__file__).parent / "factors" / "factor_ensemble.json"\nlast_decision = None\n\n\ndef factors():\n    try:\n        return json.loads(ENSEMBLE.read_text(encoding="utf-8")).get("selected_factors", [])[:10]\n    except Exception:\n        return []\n\n\ndef ranks(x):\n    good = sorted((s, v) for s, v in x.items() if np.isfinite(v))\n    out = {s: .5 for s in UNIVERSE}\n    if good:\n        for i, (s, _) in enumerate(good):\n            out[s] = (i + .5) / len(good)\n    return out\n\n\ndef project(raw):\n    # Full investment with modest cross-asset diversification.\n    w = {s: max(float(raw.get(s, 1 / 15)), 1e-8) for s in UNIVERSE}\n    for _ in range(30):\n        z = sum(w.values()); w = {s: v / z for s, v in w.items()}\n        lo = [s for s in UNIVERSE if w[s] < .02]\n        hi = [s for s in UNIVERSE if w[s] > .14]\n        if not lo and not hi: break\n        fixed = set(lo + hi)\n        for s in lo: w[s] = .02\n        for s in hi: w[s] = .14\n        free = [s for s in UNIVERSE if s not in fixed]\n        rem = 1.0 - sum(w[s] for s in fixed)\n        if free and rem > 0:\n            z = sum(w[s] for s in free)\n            for s in free: w[s] *= rem / z\n    z = sum(w.values())\n    return {s: w[s] / z for s in UNIVERSE}\n\n\n@register_hook\ndef cross_asset_strategy():\n    global last_decision\n    fs = factors()\n    if not fs or len(fs) > 10: return\n    feats, vol, dates = {}, {}, {}\n    for s in UNIVERSE:\n        d = get_stock_daily_data(symbol=s, days=190)\n        if d is None or len(d) < 80: continue\n        d = d.sort_values("date")\n        c = np.asarray(d["close"], dtype=float)\n        if np.any(~np.isfinite(c)) or np.any(c <= 0): continue\n        r = c[1:] / c[:-1] - 1\n        # Exclude the current/incomplete session; all inputs are lagged.\n        r5, r20, r40 = r[-6:-1], r[-21:-1], r[-41:-1]\n        m5, m20 = c[-2] / c[-7] - 1, c[-2] / c[-22] - 1\n        v5, v20 = max(np.std(r5), .008), max(np.std(r20), .008)\n        down = max(np.std(r20[r20 < 0]) if np.sum(r20 < 0) > 1 else .008, .008)\n        consistency = np.mean(r40 > 0)\n        efficiency = abs(np.sum(r20)) / max(np.sum(abs(r20)), .008)\n        feats[s] = {\n            "risk20": m20 / v20,\n            "volstate": (m20 / v20) * np.clip(np.std(r40) / v20, .5, 2.),\n            "downside": m20 / down,\n            "consistency": consistency * m20 / v20,\n            "breadth": consistency * m20 / v20,\n            "dispersion": -abs(m5) / v5,\n            "stress": -m5 / v5,\n            "range": (m20 / v20) * efficiency,\n        }\n        vol[s] = max(float(np.std(r[-26:-1])), .008)\n        dates[s] = str(d.iloc[-1]["date"])\n    if len(feats) < 12: return\n    stamp = max(dates.values())\n    if last_decision is not None and (np.datetime64(stamp) - np.datetime64(last_decision)) / np.timedelta64(1, "D") < 10: return\n\n    keys = {\n        "miner_3_20270604_risk_adjusted_20d_momentum": "risk20",\n        "miner_3_20270128_vol_state_momentum": "volstate",\n        "miner_3_20270310_downside_risk_momentum": "downside",\n        "miner_2_20270111_trend_consistency_risk_adjusted": "consistency",\n        "miner_3_20270222_signed_breadth_momentum": "breadth",\n        "miner_2_20270506_dispersion_reversal": "dispersion",\n        "miner_3_20270506_continuous_stress_reversal": "stress",\n        "miner_3_20270311_range_efficiency_momentum": "range",\n    }\n    score = {s: .5 for s in UNIVERSE}\n    for f in fs:\n        k = keys.get(f.get("factor_id"))\n        if k is None: continue\n        rr = ranks({s: float(f.get("direction", 1)) * feats[s][k] for s in feats})\n        for s in UNIVERSE: score[s] += float(f.get("weight", 0)) * (rr[s] - .5)\n\n    vd = get_index_daily_data(symbol="VIX", days=65)\n    stressed = False\n    if vd is not None and len(vd) >= 32:\n        vc = np.asarray(vd.sort_values("date")["close"], dtype=float)\n        stressed = vc[-2] > 1.20 * max(np.median(vc[-32:-2]), 1e-9)\n    bear = feats.get("SPX", {}).get("consistency", 0) < 0\n    if stressed or bear:\n        for s in ("XAU", "US10Y", "CN10Y"): score[s] += .10\n        for s in ("BTC", "ETH", "WTI"): score[s] -= .07\n\n    inv = np.mean([1 / vol.get(s, .02) for s in UNIVERSE])\n    raw = {s: max(score[s], .05) * (.78 + .22 * (1 / vol.get(s, .02)) / inv) for s in UNIVERSE}\n    target = project(raw)\n    avg, sd = np.mean(list(score.values())), max(np.std(list(score.values())), 1e-9)\n    forecast = {s: float(.01 * (score[s] - avg) / sd) for s in UNIVERSE}\n    rebalance_to_weights(target, forecast_returns=forecast,\n                         factor_ids=[f["factor_id"] for f in fs], horizon_days=10)\n    last_decision = stamp\n\n\nstrategy = cross_asset_strategy\n', 'file_path': 'strategy.py'})
