5,2027)]: print('regime',a,b,stats(q[(q.date.dt.year>=a)&(q.date.dt.year<=b)]))\nr=q.pivot(index='date',columns='asset',values='f').rank(axis=1,pct=True);print('turnover',float(r.diff().abs().mean().mean()));q.to_csv('scripts/miner_2_20270609_persistence_momentum_signal.csv',index=False)\n", 'file_path': 'scripts/miner_2_20270609_persistence_momentum.py'})
