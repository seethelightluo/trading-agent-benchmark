bol, value in five_day.items():\n        peers = [x for other, x in five_day.items() if other != symbol]\n        peer[symbol] = value - float(np.median(peers)) if peers else 0.0\n    if "miner_1_20260716_peer_median_leadlag_5d" in factor_values:\n        factor_values["miner_1_20260716_peer_median_leadlag_5d"] = peer\n\n    score = {s: 0.5 for s in UNIVERSE}\n    for fid, (weight, direction) in specs.items():\n        ranks = percentile(factor_values.get(fid, {}), direction)\n        for s in UNIVERSE:\n            score[s] += weight * (ranks[s] - 0.5)\n\n    # High-risk consolidation: rotate modestly toward defensive tradable assets.\n    if "SPX" in data:\n        spx = data["SPX"][0]\n        if spx[-1] < spx[-21]:\n            for s in ("XAU", "US10Y", "CN10Y"): score[s] += 0.10\n            for s in ("BTC", "ETH", "WTI"): score[s] -= 0.06\n    invvol = {s: 1.0 / max(float(np.std(data[s][4][-20:])), 0.008) for s in data}\n    avg_invvol = float(np.mean(list(invvol.values())))\n    raw = {s: max(score[s], 0.02) * (0.78 + 0.22 * invvol.get(s, avg_invvol) / max(avg_invvol, 1e-12)) for s in UNIVERSE}\n    weights = project_weights(raw)\n    mean_score = float(np.mean(list(score.values())))\n    score_sd = max(float(np.std(list(score.values()))), 1e-12)\n    forecast = {s: float(0.01 * (score[s] - mean_score) / score_sd) for s in UNIVERSE}\n    rebalance_to_weights(weights, forecast_returns=forecast,\n                         factor_ids=[x["factor_id"] for x in selected], horizon_days=10)\n    _last_date = decision_date\n', 'file_path': 'strategy.py'})
