  ▶️ write_file({'content': 'import json\nfrom pathlib import Path\nimport numpy as np\nfrom alphacrafter.sim.utils import register_hook, get_stock_daily_data, get_index_daily_data, rebalance_to_weights\n\nUNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]\nENSEMBLE = Path(__file__).parent / "factors" / "factor_ensemble.json"\nlast_decision = None\n\n\ndef load_factors():\n    try:\n        x = json.loads(ENSEMBLE.read_text(encoding="utf-8"))\n        return x.get("selected_factors", [])[:10]\n    except Exception:\n        return []\n\n\ndef ranks(values):\n    good = sorted((s, v) for s, v in values.items() if np.isfinite(v))\n    out = {s: .5 for s in UNIVERSE}\n    if not good:\n        return out\n    for i, (s, _) in enumerate(good):\n        out[s] = (i + .5) / len(good)\n    return out\n\n\ndef bounded_weights(raw):\n    # 2% floor and 14% cap, with iterative simplex projection.\n    w = {s: max(float(raw.get(s, 1.0)), 1e-10) for s in UNIVERSE}\n    fixed = {}\n    for _ in range(20):\n        free = [s for s in UNIVERSE if s not in fixed]\n        rem = 1.0 - sum(fixed.values())\n        z = sum(w[s] for s in free)\n        for s in free:\n            w[s] = rem * w[s] / z\n        changed = False\n        for s in free:\n            if w[s] < .02:\n                fixed[s] = .02; changed = True\n            elif w[s] > .14:\n                fixed[s] = .14; changed = True\n        if not changed: break\n    z = sum(w.values())\n    return {s: w[s] / z for s in UNIVERSE}\n\n\n@register_hook\ndef cross_asset_strategy():\n    global last_decision\n    fs = load_factors()\n    if not fs:\n        return\n    data, feat, vol, stamps = {}, {}, {}, {}\n    for s in UNIVERSE:\n        df = get_stock_daily_data(symbol=s, days=260)\n        if df is None or len(df) < 100:\n            continue\n        df = df.sort_values("date")\n        # Last completed bar only; the current session is not used.\n        c = np.asarray(df["close"], float)[:-1]\n        if len(c) < 80 or np.any(~np.isfinite(c)) or np.any(c <= 0):\n            continue\n        r = c[1:] / c[:-1] - 1.0\n        def ret(n): return c[-1] / c[-n-1] - 1.0\n        v10 = max(np.std(r[-10:]), .008)\n        v20 = max(np.std(r[-20:]), .008)\n        v30 = max(np.std(r[-30:]), .008)\n        v60 = max(np.std(r[-60:]), .008)\n        neg = r[-30:][r[-30:] < 0]\n        dn = max(np.std(neg) if len(neg) > 1 else v30, .008)\n        agreement = np.mean([np.sign(ret(n)) for n in (10, 20, 30, 60)])\n        recent = ret(5)\n        draw = (c[-1] / np.max(c[-30:])) - 1.0\n        recovery = ret(20) / max(np.std(r[-20:]), .008) + max(0.0, draw)\n        feat[s] = {\n            "quality": ret(60) / v60,\n            "mom20": ret(20) / v20,\n            "mom30": ret(30) / v30,\n            "sortino": ret(30) / dn,\n            "agreement": agreement + .25 * (ret(30) / v30),\n            "asym": -recent / v10,\n            "vixrev": -ret(10) / v20,\n            "stress": -ret(20) / v30,\n            "recovery": recovery,\n        }\n        vol[s] = max(np.std(r[-25:]), .008)\n        stamps[s] = str(df.iloc[-1]["date"])\n    if len(feat) < len(UNIVERSE):\n        return\n    stamp = max(stamps.values())\n    if last_decision is not None:\n        try:\n            if (np.datetime64(stamp) - np.datetime64(last_decision)) / np.timedelta64(1, "D") < 10:\n                return\n        except Exception:\n            return\n    keys = {\n        "miner_1_20270609_quality_momentum": "quality",\n        "miner_3_20270604_risk_adjusted_20d_momentum": "mom20",\n        "miner_1_20270723_risk_adjusted_momentum30": "mom30",\n        "miner_3_20270716_downside_sortino_momentum_30d": "sortino",\n        "miner_1_20270622_multihorizon_agreement": "agreement",\n        "miner_3_20261130_asymmetric_volatility_reversal_2d_revalidated": "asym",\n        "miner_3_20270503_vix_stress_reversal": "vixrev",\n        "miner_3_20270506_continuous_stress_reversal": "stress",\n        "miner_2_20270830_recovery_efficiency_20d": "recovery",\n    }\n    score = {s: 0.5 for s in UNIVERSE}\n    for f in fs:\n        k = keys.get(f.get("factor_id"))\n        if k is None: continue\n        rr = ranks({s: float(f.get("direction", 1)) * feat[s][k] for s in feat})\n        for s in UNIVERSE:\n            score[s] += float(f.get("weight", 0.0)) * (rr[s] - .5)\n    # High-risk regime: defensive tradable benchmarks replace a cash sleeve.\n    spx_bear = feat["SPX"]["mom20"] < 0 and feat["SPX"]["mom30"] < 0\n    vix = get_index_daily_data(symbol="VIX", days=70)\n    stressed = False\n    if vix is not None and len(vix) > 35:\n        x = np.asarray(vix.sort_values("date")["close"], float)[:-1]\n        stressed = x[-1] > np.mean(x[-30:]) + .5 * np.std(x[-30:])\n    if spx_bear or stressed:\n        for s in ("XAU", "US10Y", "CN10Y"): score[s] += .08\n        for s in ("BTC", "ETH", "WTI"): score[s] -= .05\n    inv = {s: 1.0 / vol[s] for s in UNIVERSE}\n    mean_inv = np.mean(list(inv.values()))\n    raw = {s: max(score[s], .05) * (.78 + .22 * inv[s] / mean_inv) for s in UNIVERSE}\n    mu, sd = np.mean(list(score.values())), max(np.std(list(score.values())), 1e-8)\n    forecast = {s: float(.01 * (score[s] - mu) / sd) for s in UNIVERSE}\n    target = bounded_weights(raw)\n    rebalance_to_weights(target, forecast_returns=forecast,\n                         factor_ids=[f["factor_id"] for f in fs], horizon_days=10)\n    last_decision = stamp\n\nstrategy = cross_asset_strategy\n', 'file_path': 'strategy.py'})
