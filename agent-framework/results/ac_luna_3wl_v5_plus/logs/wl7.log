 import json
from pathlib import Path
import numpy as np
from alphacrafter.sim.utils import register_hook, get_stock_daily_data, get_index_daily_data, rebalance_to_weights

UNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
ENSEMBLE_PATH = Path(__file__).parent / "factors" / "factor_ensemble.json"
_last_decision = None


def ensemble():
    try:
        return json.loads(ENSEMBLE_PATH.read_text(encoding="utf-8"))["selected_factors"][:10]
    except Exception:
        return []


def ranks(x):
    out = {s: 0.5 for s in UNIVERSE}
    a = sorted((s, v) for s, v in x.items() if np.isfinite(v))
    for i, (s, _) in enumerate(a):
        out[s] = (i + .5) / len(a)
    return out


def weights(raw):
    # 15 assets, full investment, 2% floor and 14% ceiling.
    w = {s: max(float(raw.get(s, 0.0)), 1e-8) for s in UNIVERSE}
    for _ in range(40):
        total = sum(w.values())
        w = {s: v / total for s, v in w.items()}
        lo = {s for s in UNIVERSE if w[s] < .02}
        hi = {s for s in UNIVERSE if w[s] > .14}
        if not lo and not hi:
            break
        fixed = lo | hi
        for s in lo: w[s] = .02
        for s in hi: w[s] = .14
        free = [s for s in UNIVERSE if s not in fixed]
        rem = 1 - sum(w[s] for s in fixed)
        scale = rem / (sum(w[s] for s in free) or 1)
        for s in free: w[s] *= scale
    z = sum(w.values())
    return {s: w[s] / z for s in UNIVERSE}


@register_hook
def cross_asset_strategy():
    global _last_decision
    selected = ensemble()
    if not selected:
        return
    data, vols = {}, {}
    for s in UNIVERSE:
        d = get_stock_daily_data(symbol=s, days=190)
        if d is None or len(d) < 80:
            continue
        d = d.sort_values("date")
        c = np.asarray(d["close"], dtype=float)
        if np.all(np.isfinite(c)) and np.all(c > 0):
            data[s] = (c, d.iloc[-1]["date"])
            r = c[1:] / c[:-1] - 1
            vols[s] = max(float(np.std(r[-23:-1])), .008)
    if len(data) < 12:
        return
    decision = str(max(v[1] for v in data.values()))
    if _last_decision is not None:
        try:
            if (np.datetime64(decision)-np.datetime64(_last_decision))/np.timedelta64(1, "D") < 10:
                return
        except Exception:
            return

    # Every input is lagged one completed session. Features match the selected
    # factor intent while remaining robust for this deliberately small universe.
    f = {}
    for s, (c, _) in data.items():
        r = c[1:] / c[:-1] - 1
        q20 = r[-21:-1]
        v20 = max(float(np.std(q20)), .008)
        v10 = max(float(np.std(r[-11:-1])), .008)
        v60 = max(float(np.std(r[-61:-1])), .008)
        neg = q20[q20 < 0]
        down = max(float(np.std(neg)) if len(neg) > 1 else .008, .008)
        m20 = c[-2] / c[-22] - 1
        posfrac = float(np.mean(q20 > 0))
        f[s] = {
            "vix": -(c[-2]/c[-7]-1) / v20,
            "asym": -(c[-2]/c[-4]-1) / v20 * (1 + .5 * min(2, down / v20)),
            "disp": -(c[-2]/c[-7]-1) / v20,
            "shock": -(c[-2]/c[-5]-1) / v10 * (v10 / v60),
            "downtrend": m20 / down,
            "breadth": posfrac * (.5 + m20 / v20),
            "persistent": (m20 / v20) * (.5 + posfrac),
            "volstate": (m20 / v20) * min(2., v60 / v20),
        }

    score = {s: .5 for s in UNIVERSE}
    for spec in selected:
        fid, wt, direction = spec["factor_id"], float(spec["weight"]), int(spec.get("direction", 1))
        if "vix_stress_reversal" in fid or "continuous_stress_reversal" in fid: key = "vix"
        elif "asymmetric_volatility_reversal" in fid: key = "asym"
        elif "dispersion_reversal" in fid: key = "disp"
        elif "vol_shock_reversal" in fid: key = "shock"
        elif "downside_risk_adjusted_trend" in fid: key = "downtrend"
        elif "signed_breadth_momentum" in fid: key = "breadth"
        elif "persistent_trend_quality" in fid: key = "persistent"
        elif "vol_state_momentum" in fid: key = "volstate"
        else: continue
        rr = ranks({s: direction * f[s][key] for s in f})
        for s in UNIVERSE: score[s] += wt * (rr[s] - .5)

    vix = get_index_daily_data(symbol="VIX", days=65)
    high_vix = False
    if vix is not None and len(vix) >= 32:
        vc = np.asarray(vix.sort_values("date")["close"], float)
        high_vix = bool(vc[-2] > 1.2 * np.median(vc[-32:-2]))
    spx = data.get("SPX", (None,))[0]
    risk_off = high_vix or (spx is not None and (spx[-2] < spx[-22] or np.mean(spx[-8:-2]/spx[-9:-3]-1) < 0))
    if risk_off:
        for s in ("XAU", "US10Y", "CN10Y"): score[s] += .10
        for s in ("BTC", "ETH", "WTI"): score[s] -= .07

    invmean = np.mean([1 / vols.get(s, .02) for s in UNIVERSE])
    raw = {s: max(score[s], .05) * (.78 + .22 * (1 / vols.get(s, .02)) / invmean) for s in UNIVERSE}
    target = weights(raw)
    mu, sd = np.mean(list(score.values())), max(float(np.std(list(score.values()))), 1e-9)
    forecast = {s: float(.01 * (score[s] - mu) / sd) for s in UNIVERSE}
    rebalance_to_weights(target, forecast_returns=forecast,
                         factor_ids=[x["factor_id"] for x in selected], horizon_days=10)
    _last_decision = decision


if __name__ == "__main__":
    print(json.dumps({"factors": [x["factor_id"] for x in ensemble()], "assets": len(UNIVERSE)}))


