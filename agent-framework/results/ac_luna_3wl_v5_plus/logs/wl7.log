 import json
from pathlib import Path
import numpy as np
from alphacrafter.sim.utils import (
    register_hook, get_stock_daily_data, get_index_daily_data,
    rebalance_to_weights,
)

UNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
ENSEMBLE_PATH = Path(__file__).parent / "factors" / "factor_ensemble.json"
_last_decision = None


def _selected():
    try:
        return json.loads(ENSEMBLE_PATH.read_text(encoding="utf-8")).get("selected_factors", [])[:10]
    except Exception:
        return []


def _rank(x):
    valid = sorted((s, v) for s, v in x.items() if np.isfinite(v))
    out = {s: .5 for s in UNIVERSE}
    n = len(valid)
    for i, (s, _) in enumerate(valid):
        out[s] = (i + 1) / max(n, 1)
    return out


def _weights(raw):
    w = {s: max(float(raw.get(s, 0)), 0) for s in UNIVERSE}
    z = sum(w.values()) or 1
    w = {s: v / z for s, v in w.items()}
    # Full investment with sensible diversification for a 15-asset universe.
    for _ in range(20):
        low = {s for s in UNIVERSE if w[s] < .02}
        high = {s for s in UNIVERSE if w[s] > .14}
        if not low and not high:
            break
        fixed = low | high
        for s in low: w[s] = .02
        for s in high: w[s] = .14
        free = [s for s in UNIVERSE if s not in fixed]
        rem = 1 - sum(w[s] for s in fixed)
        base = sum(w[s] for s in free) or 1
        for s in free: w[s] *= rem / base
    z = sum(w.values())
    return {s: w[s] / z for s in UNIVERSE}


@register_hook
def cross_asset_strategy():
    global _last_decision
    selected = _selected()
    if not selected:
        return
    specs = {x["factor_id"]: (float(x["weight"]), int(x.get("direction", 1))) for x in selected}
    series, vols = {}, {}
    for s in UNIVERSE:
        df = get_stock_daily_data(symbol=s, days=140)
        if df is None or len(df) < 70:
            continue
        df = df.sort_values("date")
        close = np.asarray(df["close"], dtype=float)
        ret = close[1:] / np.maximum(close[:-1], 1e-12) - 1
        series[s] = (close, ret, str(df.iloc[-1]["date"]))
        vols[s] = max(float(np.std(ret[-21:-1])), .008)
    if len(series) < 12:
        return
    decision = max(v[2] for v in series.values())
    if _last_decision is not None:
        try:
            if (np.datetime64(decision) - np.datetime64(_last_decision)) / np.timedelta64(1, "D") < 10:
                return
        except Exception:
            return

    # Observation-only VIX is used only as a conditioning signal.
    vix_level, vix_med = 0., 0.
    vdf = get_index_daily_data(symbol="VIX", days=80)
    if vdf is not None and len(vdf) >= 30:
        vc = np.asarray(vdf.sort_values("date")["close"], dtype=float)
        vix_level, vix_med = vc[-2], float(np.median(vc[-31:-1]))
    vix_scale = 1.0 if vix_level <= 0 or vix_level <= vix_med else .75

    vals = {f: {} for f in specs}
    for s, (c, r, _) in series.items():
        # All observations end at -2: the last completed session is -2.
        r2 = c[-2] / c[-4] - 1
        r10 = c[-2] / c[-12] - 1
        r15 = c[-2] / c[-17] - 1
        r20 = c[-2] / c[-22] - 1
        tr = r[-21:-1]
        vol = max(float(np.std(tr)), .008)
        breadth = float(np.mean(tr > 0))
        consistency = (r20 / vol) * (.5 + breadth)
        breakout = (c[-2] / max(float(np.max(c[-22:-2])), 1e-12) - 1) / vol
        # Small reversal sleeve: reward a recent asymmetric pullback, not raw chasing.
        down = max(float(np.sqrt(np.mean(np.minimum(tr, 0) ** 2))), .003)
        reversal = -r2 / down if r2 < 0 else -.25 * r2 / vol
        f = {
            "miner_2_20270111_trend_consistency_risk_adjusted": consistency,
            "miner_3_20270128_vol_state_momentum": (r20 / vol) * (.5 + breadth) * vix_scale,
            "miner_2_20270128_vix_conditioned_momentum": (r15 / vol) * vix_scale,
            "miner_1_20270108_persistent_trend_quality_20d": consistency,
            "miner_1_20270111_breakout_persistence": breakout,
            "miner_3_20270111_relative_momentum_15d_vol_scaled": r15 / vol,
            "miner_3_20261130_asymmetric_volatility_reversal_2d_revalidated": reversal,
        }
        for name in specs:
            vals[name][s] = f.get(name, 0.)

    score = {s: .5 for s in UNIVERSE}
    for name, (weight, direction) in specs.items():
        ranks = _rank({s: direction * v for s, v in vals[name].items()})
        for s in UNIVERSE:
            score[s] += weight * (ranks[s] - .5)

    # Moderate bullish regime: retain broad risk exposure; only add defense if trend breaks.
    spx = series.get("SPX")
    risk_off = spx is not None and (spx[0][-2] < spx[0][-22] or np.mean(spx[1][-6:-1]) < 0)
    if risk_off:
        for s in ("XAU", "US10Y", "CN10Y"): score[s] += .10
        for s in ("BTC", "ETH", "WTI"): score[s] -= .06
    inv = {s: 1 / max(vols.get(s, .02), .008) for s in UNIVERSE}
    mean_inv = np.mean(list(inv.values()))
    raw = {s: max(score[s], .02) * (.78 + .22 * inv[s] / mean_inv) for s in UNIVERSE}
    weights = _weights(raw)
    mu = np.mean(list(score.values()))
    sd = max(float(np.std(list(score.values()))), 1e-12)
    forecast = {s: float(.01 * (score[s] - mu) / sd) for s in UNIVERSE}
    rebalance_to_weights(weights, forecast_returns=forecast, factor_ids=list(specs), horizon_days=10)
    _last_decision = decision


