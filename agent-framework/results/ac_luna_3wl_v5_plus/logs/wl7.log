 import numpy as np,pandas as pd
from alphacrafter.sim.utils import get_index_daily_data,get_stock_daily_data
U=['000300.SH','SPX','HSI','N225','SX5E','000688.SH','SOX','NDX','XAU','COPPER','WTI','BTC','ETH','US10Y','CN10Y']; CUT=pd.Timestamp('2027-06-08')
def load(s):
 for fn in (get_index_daily_data,get_stock_daily_data):
  try:
   d=fn(s,3000)
   if d is not None and len(d):
    d=d.copy(); d.date=pd.to_datetime(d.date).dt.normalize(); return d.drop_duplicates('date').set_index('date').sort_index().loc[:CUT]
  except Exception: pass
D={s:load(s) for s in U}; D={s:d for s,d in D.items() if d is not None}; rows=[]
# Rebound quality: lagged 5d recovery, scaled by distance below 60d high and 20d volatility.
for s,d in D.items():
 c=d.close.astype(float); ret=c.pct_change(); rebound=c/c.shift(5)-1; dd=(c/c.rolling(60,min_periods=40).max()-1).clip(upper=0); vol=ret.rolling(20,min_periods=15).std()
 f=(rebound*(-dd))/(vol+1e-12); rows.append(pd.DataFrame({'date':c.index,'asset':s,'f':f.shift(1),'fr':c.shift(-10)/c-1}))
q=pd.concat(rows,ignore_index=True).replace([np.inf,-np.inf],np.nan).dropna()
def stats(x):
 z=[]; ns=[]
 for _,g in x.groupby('date'):
  if len(g)>=8 and g.f.nunique()>1 and g.fr.nunique()>1:
   z.append(g.f.corr(g.fr,method='spearman')); ns.append(len(g))
 z=pd.Series(z).dropna(); return len(z),float(np.mean(ns)),float(z.mean()),float(z.mean()/z.std(ddof=1)*np.sqrt(252)),float((z>0).mean())
print('assets',len(D),'dates',q.date.nunique(),'avg_n',q.groupby('date').size().mean(),'coverage',len(q)/(q.date.nunique()*15)); print('10d',stats(q))
for h in [1,5,10,20]:
 rr=[]
 for s,d in D.items():
  c=d.close.astype(float); ret=c.pct_change(); rebound=c/c.shift(5)-1; dd=(c/c.rolling(60,min_periods=40).max()-1).clip(upper=0); vol=ret.rolling(20,min_periods=15).std(); f=(rebound*(-dd))/(vol+1e-12)
  rr.append(pd.DataFrame({'date':c.index,'asset':s,'f':f.shift(1),'fr':c.shift(-h)/c-1}))
 print('horizon',h,stats(pd.concat(rr,ignore_index=True).dropna()))
for a,b in [(2020,2022),(2023,2024),(2025,2027)]: print('regime',a,b,stats(q[(q.date.dt.year>=a)&(q.date.dt.year<=b)]))
r=q.pivot(index='date',columns='asset',values='f').rank(axis=1,pct=True); print('turnover',float(r.diff().abs().mean().mean()))
q.to_csv('scripts/miner_3_20270609_recovery_quality_signal.csv',index=False)


