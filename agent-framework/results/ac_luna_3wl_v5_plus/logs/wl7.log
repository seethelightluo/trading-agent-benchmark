turns, vols, dates = {}, {}, {}, {}\n    for symbol in UNIVERSE:\n        df = get_stock_daily_data(symbol=symbol, days=160)\n        if df is None or len(df) < 80:\n            continue\n        df = df.sort_values("date")\n        close = np.asarray(df["close"], dtype=float)\n        ret = close[1:] / np.maximum(close[:-1], 1e-12) - 1.0\n        prices[symbol], returns[symbol] = close, ret\n        vols[symbol] = max(float(np.std(ret[-22:-1])), 0.008)\n        dates[symbol] = str(df.iloc[-1]["date"])\n    if len(prices) < 12:\n        return\n    decision = max(dates.values())\n    if _last_decision is not None:\n        if (np.datetime64(decision) - np.datetime64(_last_decision)) / np.timedelta64(1, "D") < 10:\n            return\n\n    vix = get_index_daily_data(symbol="VIX", days=80)\n    vix_high = False\n    if vix is not None and len(vix) >= 32:\n        vc = np.asarray(vix.sort_values("date")["close"], dtype=float)\n        vix_high = bool(vc[-2] > 1.2 * np.median(vc[-32:-2]))\n\n    factor_values = {f: {} for f in specs}\n    for symbol, close in prices.items():\n        ret = returns[symbol]\n        # Last observation is excluded: decisions use the previous completed bar.\n        p = close[:-1]\n        rr = ret[:-1]\n        if len(p) < 35: continue\n        r5, r10, r20, r30 = p[-1]/p[-6]-1, p[-1]/p[-11]-1, p[-1]/p[-21]-1, p[-1]/p[-31]-1\n        recent = rr[-21:]\n        vol = max(float(np.std(recent)), 0.008)\n        breadth = float(np.mean(recent > 0))\n        consistency = breadth * (0.5 + max(r20, -0.5) / max(vol, 0.008))\n        efficiency = r20 / max(float(np.sum(np.abs(recent))), 0.02)\n        downside = max(float(np.std(recent[recent < 0])), 0.008) if np.any(recent < 0) else 0.008\n        vals = {\n            "breadth": r20 / vol * (0.5 + breadth),\n            "dispersion": r20 / vol,\n            "consistency": consistency,\n            "volstate": r20 / vol * (0.75 if vix_high else 1.0),\n            "persistent": (0.5*r20 + 0.3*r10