s='asset',values='f').rank(axis=1,pct=True); print('turnover',p.diff().abs().mean(axis=1).mean())\nfor a,b in [('2020','2022'),('2023','2024'),('2025','2026')]:\n z=I.loc[a:b,'ic']; print('regime',a,b,len(z),z.mean(),z.mean()/z.std(ddof=1)*np.sqrt(252))\n", 'file_path': 'scripts/miner_3_20260827_intraday_reversal.py'})
