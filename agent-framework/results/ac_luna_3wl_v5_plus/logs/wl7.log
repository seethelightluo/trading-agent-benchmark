    if market is not None and market[0][-1] < market[0][-21]:
        for s in ("XAU", "US10Y", "CN10Y"): score[s] += 0.12
        for s in ("BTC", "ETH", "WTI"): score[s] -= 0.08
    inv = {s: 1/max(float(np.std(data[s][5][-20:])), .008) for s in data}
    av = np.mean(list(inv.values()))
    raww = {s: max(score[s], .02) * (.72 + .28*inv.get(s,av)/av) for s in UNIVERSE}
    weights = project(raww)
    mean, st = np.mean(list(score.values())), max(np.std(list(score.values())), 1e-9)
    forecast = {s: float(0.01*(score[s]-mean)/st) for s in UNIVERSE}
    rebalance_to_weights(weights, forecast_returns=forecast, factor_ids=list(specs), horizon_days=10)
    _last_date = date


