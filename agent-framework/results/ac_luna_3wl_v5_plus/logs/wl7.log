 import json
from pathlib import Path
import numpy as np
from alphacrafter.sim.utils import register_hook, get_stock_daily_data, get_index_daily_data, rebalance_to_weights

UNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
ENSEMBLE = Path(__file__).parent / "factors" / "factor_ensemble.json"
last_decision = None


def load_ensemble():
    try:
        return json.loads(ENSEMBLE.read_text(encoding="utf-8")).get("selected_factors", [])[:10]
    except Exception:
        return []


def ranks(values):
    out = {s: .5 for s in UNIVERSE}
    good = sorted((s, float(v)) for s, v in values.items() if np.isfinite(v))
    if not good:
        return out
    n = len(good)
    for i, (s, _) in enumerate(good):
        out[s] = (i + .5) / n
    return out


def bounded(raw):
    w = {s: max(float(raw.get(s, 1 / 15)), 1e-12) for s in UNIVERSE}
    for _ in range(50):
        z = sum(w.values())
        w = {s: x / z for s, x in w.items()}
        low = {s for s in UNIVERSE if w[s] < .02}
        high = {s for s in UNIVERSE if w[s] > .14}
        if not low and not high:
            break
        fixed = low | high
        for s in low: w[s] = .02
        for s in high: w[s] = .14
        free = [s for s in UNIVERSE if s not in fixed]
        rem = 1 - sum(w[s] for s in fixed)
        if free and rem > 0:
            scale = rem / sum(w[s] for s in free)
            for s in free: w[s] *= scale
    z = sum(w.values())
    return {s: w[s] / z for s in UNIVERSE}


@register_hook
def cross_asset_strategy():
    global last_decision
    factors = load_ensemble()
    if not factors:
        return
    feat, vol, stamp_by_symbol = {}, {}, {}
    for s in UNIVERSE:
        d = get_stock_daily_data(symbol=s, days=190)
        if d is None or len(d) < 80:
            continue
        d = d.sort_values("date")
        c = np.asarray(d["close"], dtype=float)
        if len(c) < 65 or np.any(~np.isfinite(c)) or np.any(c <= 0):
            continue
        # Every feature uses completed bars through t-1, never today's bar.
        x = c[:-1]
        r = x[1:] / x[:-1] - 1
        r5, r20, r60 = r[-5:], r[-20:], r[-60:]
        m3, m5, m20 = x[-1] / x[-4] - 1, x[-1] / x[-6] - 1, x[-1] / x[-21] - 1
        v20 = max(float(np.std(r20)), .008)
        down = max(float(np.std(r20[r20 < 0])) if np.sum(r20 < 0) > 1 else .008, .008)
        path = max(float(np.sum(np.abs(r20))), .01)
        hi, lo = np.max(x[-21:]), np.min(x[-21:])
        rng = max((hi - lo) / x[-1], .01)
        feat[s] = {
            "vol_state": m20 / v20 * np.clip(np.std(r60) / v20, .5, 2),
            "breadth": np.sign(m20) * (0.5 + 0.5 * np.mean(r20 > 0)) * abs(m20) / v20,
            "consistency": np.mean(r60 > 0) * m20 / v20,
            "sortino": m20 / down,
            "downside": m20 / down - .25 * max(0, -m5) / v20,
            "efficiency": m20 / path,
            "dispersion_rev": -m5 / v20,
            "range_rev": -m3 / rng,
        }
        vol[s] = max(float(np.std(r[-26:])), .008)
        stamp_by_symbol[s] = str(d.iloc[-1]["date"])
    if len(feat) < 12:
        return
    stamp = max(stamp_by_symbol.values())
    if last_decision is not None and (np.datetime64(stamp) - np.datetime64(last_decision)) / np.timedelta64(1, "D") < 10:
        return

    vd = get_index_daily_data(symbol="VIX", days=65)
    stress = False
    if vd is not None and len(vd) >= 32:
        vc = np.asarray(vd.sort_values("date")["close"], dtype=float)
        stress = bool(vc[-2] > 1.20 * max(np.median(vc[-32:-2]), 1e-9))
    broad = np.mean([feat[s]["consistency"] > 0 for s in feat])
    risk_off = stress or broad < .45

    key_by_fragment = {
        "vol_state_momentum": "vol_state",
        "signed_breadth_momentum": "breadth",
        "trend_consistency_risk_adjusted": "consistency",
        "downside_sortino_momentum": "sortino",
        "downside_risk_momentum": "downside",
        "range_efficiency_momentum": "efficiency",
        "dispersion_reversal": "dispersion_rev",
        "range_normalized_3d_reversal": "range_rev",
    }
    score = {s: 0.0 for s in UNIVERSE}
    for f in factors:
        fid = f.get("factor_id", "")
        key = next((v for k, v in key_by_fragment.items() if k in fid), None)
        if key is None:
            continue
        rr = ranks({s: f.get("direction", 1) * feat[s][key] for s in feat})
        for s in UNIVERSE:
            score[s] += float(f.get("weight", 0)) * (rr[s] - .5)
    if risk_off:
        for s in ("XAU", "US10Y", "CN10Y"):
            score[s] += .10
        for s in ("BTC", "ETH", "WTI"):
            score[s] -= .07
    inv = np.mean([1 / vol.get(s, .02) for s in UNIVERSE])
    raw = {s: max(.05, .5 + score[s]) * (.80 + .20 * (1 / vol.get(s, .02)) / inv) for s in UNIVERSE}
    target = bounded(raw)
    mean, sd = np.mean(list(score.values())), max(float(np.std(list(score.values()))), 1e-9)
    forecast = {s: float(.01 * (score[s] - mean) / sd) for s in UNIVERSE}
    rebalance_to_weights(target, forecast_returns=forecast,
                         factor_ids=[f["factor_id"] for f in factors], horizon_days=10)
    last_decision = stamp


