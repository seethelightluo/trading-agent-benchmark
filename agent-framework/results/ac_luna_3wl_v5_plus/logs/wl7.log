 import json
from pathlib import Path
import numpy as np
from alphacrafter.sim.utils import register_hook, get_stock_daily_data, get_index_daily_data, rebalance_to_weights

UNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
ENSEMBLE = Path(__file__).parent / "factors" / "factor_ensemble.json"
last_decision = None


def load_factors():
    try:
        return json.loads(ENSEMBLE.read_text()).get("selected_factors", [])[:10]
    except Exception:
        return []


def cross_rank(values):
    out = {s: 0.5 for s in UNIVERSE}
    valid = sorted((s, float(v)) for s, v in values.items() if np.isfinite(v))
    if valid:
        for i, (s, _) in enumerate(valid):
            out[s] = (i + 0.5) / len(valid)
    return out


def project_weights(raw):
    # Full investment, long-only, sensible bounds for a 15-asset universe.
    w = {s: max(float(raw.get(s, 1.0 / 15)), 1e-8) for s in UNIVERSE}
    for _ in range(30):
        z = sum(w.values())
        w = {s: v / z for s, v in w.items()}
        low = {s for s in UNIVERSE if w[s] < .02}
        high = {s for s in UNIVERSE if w[s] > .14}
        if not low and not high:
            break
        fixed = low | high
        for s in low: w[s] = .02
        for s in high: w[s] = .14
        free = [s for s in UNIVERSE if s not in fixed]
        residual = max(0.0, 1.0 - sum(w[s] for s in fixed))
        denom = sum(w[s] for s in free)
        if denom > 0:
            for s in free: w[s] *= residual / denom
    z = sum(w.values())
    return {s: w[s] / z for s in UNIVERSE}


@register_hook
def cross_asset_strategy():
    global last_decision
    factors = load_factors()
    if not factors:
        return
    data, vol = {}, {}
    for s in UNIVERSE:
        d = get_stock_daily_data(symbol=s, days=190)
        if d is None or len(d) < 80:
            continue
        d = d.sort_values("date")
        c = np.asarray(d["close"], dtype=float)
        if np.all(np.isfinite(c)) and np.all(c > 0):
            data[s] = (c, str(d.iloc[-1]["date"]))
            r = c[1:] / c[:-1] - 1
            vol[s] = max(float(np.std(r[-26:-1])), .008)
    if len(data) < 12:
        return
    stamp = max(x[1] for x in data.values())
    if last_decision is not None and (np.datetime64(stamp) - np.datetime64(last_decision)) / np.timedelta64(1, "D") < 10:
        return

    signals = {}
    for s, (c, _) in data.items():
        r = c[1:] / c[:-1] - 1
        r10, r20, r60 = r[-11:-1], r[-21:-1], r[-61:-1]
        v10 = max(float(np.std(r10)), .008)
        v20 = max(float(np.std(r20)), .008)
        v60 = max(float(np.std(r60)), .008)
        m5 = c[-2] / c[-7] - 1
        m20 = c[-2] / c[-22] - 1
        m60 = c[-2] / c[-62] - 1
        downside = max(float(np.std(r20[r20 < 0])) if np.sum(r20 < 0) > 1 else .008, .008)
        consistency = float(np.mean(r[-41:-1] > 0))
        signals[s] = {
            "asym": -m5 / v10 * (1 + max(0., -m20) / v20),
            "conditioned": m20 / v20,
            "breadth": consistency * m20 / v20,
            "dispersion": m20 / v20 * (1 + abs(m20 - np.median([data[x][0][-2] / data[x][0][-22] - 1 for x in data])) / v20),
            "volstate": m20 / v20 * min(2., max(.5, v60 / v20)),
            "downside": m20 / downside,
            "efficiency": m20 / v20 * (abs(np.mean(r[-20:])) / max(np.mean(np.abs(r[-20:])), .008)),
        }

    score = {s: 0.5 for s in UNIVERSE}
    for f in factors:
        fid = f.get("factor_id", "")
        if "asymmetric_volatility_reversal" in fid: key = "asym"
        elif "conditioned_momentum" in fid and "dispersion" not in fid: key = "conditioned"
        elif "signed_breadth_momentum" in fid: key = "breadth"
        elif "dispersion_conditioned_momentum" in fid: key = "dispersion"
        elif "vol_state_momentum" in fid: key = "volstate"
        elif "downside_risk_momentum" in fid: key = "downside"
        elif "range_efficiency_momentum" in fid: key = "efficiency"
        else: continue
        ranked = cross_rank({s: f.get("direction", 1) * signals[s][key] for s in signals})
        for s in UNIVERSE:
            score[s] += float(f.get("weight", 0.0)) * (ranked[s] - .5)

    # Defensive assets retain full-investment capital in elevated stress.
    vix = get_index_daily_data(symbol="VIX", days=65)
    stress = False
    if vix is not None and len(vix) >= 32:
        vc = np.asarray(vix.sort_values("date")["close"], dtype=float)
        stress = bool(vc[-2] > 1.2 * np.median(vc[-32:-2]))
    spx = data.get("SPX", (None,))[0]
    riskoff = stress or (spx is not None and spx[-2] < spx[-22])
    if riskoff:
        for s in ("XAU", "US10Y", "CN10Y"): score[s] += .10
        for s in ("BTC", "ETH", "WTI"): score[s] -= .07

    inv_avg = np.mean([1.0 / vol.get(s, .02) for s in UNIVERSE])
    raw = {s: max(score[s], .05) * (.78 + .22 * (1.0 / vol.get(s, .02)) / inv_avg) for s in UNIVERSE}
    target = project_weights(raw)
    mean, stdev = np.mean(list(score.values())), max(np.std(list(score.values())), 1e-9)
    forecast = {s: float(.01 * (score[s] - mean) / stdev) for s in UNIVERSE}
    rebalance_to_weights(target, forecast_returns=forecast, factor_ids=[f["factor_id"] for f in factors], horizon_days=10)
    last_decision = stamp


