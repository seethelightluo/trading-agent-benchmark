 import json
from pathlib import Path
import numpy as np
from alphacrafter.sim.utils import register_hook, get_stock_daily_data, get_index_daily_data, rebalance_to_weights

UNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
ENSEMBLE = Path(__file__).parent / "factors" / "factor_ensemble.json"
last_decision = None


def ensemble():
    try:
        return json.loads(ENSEMBLE.read_text()).get("selected_factors", [])[:10]
    except Exception:
        return []


def rank(x):
    out = {s: .5 for s in UNIVERSE}
    a = sorted((s, v) for s, v in x.items() if np.isfinite(v))
    for i, (s, _) in enumerate(a):
        out[s] = (i + .5) / len(a)
    return out


def bounded(raw):
    w = {s: max(float(raw.get(s, .01)), 1e-8) for s in UNIVERSE}
    for _ in range(20):
        z = sum(w.values()); w = {s: v / z for s, v in w.items()}
        lo = {s for s in UNIVERSE if w[s] < .02}
        hi = {s for s in UNIVERSE if w[s] > .14}
        if not lo and not hi: break
        fixed = lo | hi
        for s in lo: w[s] = .02
        for s in hi: w[s] = .14
        free = [s for s in UNIVERSE if s not in fixed]
        rem = max(0., 1. - sum(w[s] for s in fixed))
        scale = rem / max(sum(w[s] for s in free), 1e-12)
        for s in free: w[s] *= scale
    z = sum(w.values())
    return {s: w[s] / z for s in UNIVERSE}


@register_hook
def cross_asset_strategy():
    global last_decision
    fs = ensemble()
    if not fs: return
    data, vols = {}, {}
    for s in UNIVERSE:
        d = get_stock_daily_data(symbol=s, days=190)
        if d is None or len(d) < 80: continue
        c = np.asarray(d.sort_values("date")["close"], dtype=float)
        if np.all(np.isfinite(c)) and np.all(c > 0):
            data[s] = (c, str(d.sort_values("date").iloc[-1]["date"]))
            vols[s] = max(float(np.std(c[-26:-1] / c[-27:-2] - 1)), .008)
    if len(data) < 12: return
    stamp = max(v[1] for v in data.values())
    if last_decision is not None and (np.datetime64(stamp) - np.datetime64(last_decision)) / np.timedelta64(1, "D") < 10: return

    sig = {}
    for s, (c, _) in data.items():
        r = c[1:] / c[:-1] - 1
        r10, r20 = r[-11:-1], r[-21:-1]
        v10, v20, v60 = max(np.std(r10), .008), max(np.std(r20), .008), max(np.std(r[-61:-1]), .008)
        m20, m60 = c[-2] / c[-22] - 1, c[-2] / c[-62] - 1
        down = max(float(np.std(r20[r20 < 0])) if np.sum(r20 < 0) > 1 else .008, .008)
        consistency = float(np.mean(r[-41:-1] > 0))
        sig[s] = {"asym": -(c[-2] / c[-4] - 1) / v10 * (1 + max(0., -m20) / v20),
                  "compressed": m20 / v20 * min(2., max(.5, v60 / v20)),
                  "breadth": consistency * m20 / v20, "conditioned": m20 / v20,
                  "persistent": m60 / v60 * (.5 + consistency), "volstate": m20 / v20 * min(2., v60 / v20),
                  "consistency": m60 / v60 * (.5 + consistency), "down": m20 / down}
    keys = {"asymmetric_volatility_reversal_2d":"asym", "downside_compressed_momentum":"compressed", "signed_breadth_momentum":"breadth", "conditioned_momentum":"conditioned", "persistent_trend_quality":"persistent", "vol_state_momentum":"volstate", "trend_consistency_risk_adjusted":"consistency", "downside_risk_momentum":"down"}
    score = {s: .5 for s in UNIVERSE}
    for f in fs:
        k = next((v for name, v in keys.items() if name in f.get("factor_id", "")), None)
        if k is None: continue
        rr = rank({s: f.get("direction", 1) * sig[s][k] for s in sig})
        for s in UNIVERSE: score[s] += float(f.get("weight", 0)) * (rr[s] - .5)

    vix = get_index_daily_data(symbol="VIX", days=65)
    stress = False
    if vix is not None and len(vix) >= 32:
        vc = np.asarray(vix.sort_values("date")["close"], dtype=float)
        stress = bool(vc[-2] > 1.2 * np.median(vc[-32:-2]))
    spx = data.get("SPX", (None,))[0]
    riskoff = stress or (spx is not None and (spx[-2] < spx[-22] or np.mean(spx[-8:-2] / spx[-9:-3] - 1) < 0))
    if riskoff:
        for s in ("XAU", "US10Y", "CN10Y"): score[s] += .10
        for s in ("BTC", "ETH", "WTI"): score[s] -= .07
    inv = np.mean([1 / vols.get(s, .02) for s in UNIVERSE])
    raw = {s: max(score[s], .05) * (.78 + .22 * (1 / vols.get(s, .02)) / inv) for s in UNIVERSE}
    target = bounded(raw)
    mu, sd = np.mean(list(score.values())), max(np.std(list(score.values())), 1e-9)
    forecast = {s: float(.01 * (score[s] - mu) / sd) for s in UNIVERSE}
    rebalance_to_weights(target, forecast_returns=forecast, factor_ids=[f["factor_id"] for f in fs], horizon_days=10)
    last_decision = stamp


