  ▶️ write_file({'content': "import pandas as pd, numpy as np, glob, os\nfrom scipy.stats import spearmanr\nassets=['000300.SH','SPX','HSI','N225','SX5E','000688.SH','SOX','NDX','XAU','COPPER','WTI','BTC','ETH','US10Y','CN10Y']\nbase='../persistent/stock_data'\npx={a:pd.read_csv(f'{base}/{a}.csv',parse_dates=['date']).set_index('date')['close'] for a in assets}\nwide=pd.DataFrame(px).sort_index(); rets=wide.pct_change()\nvix=pd.read_csv('../persistent/index_data/VIX.csv',parse_dates=['date']).set_index('date')['close'].reindex(wide.index).ffill()\n# prior completed-day VIX stress percentile, deliberately lagged\nvp=vix.shift(1).rolling(252,min_periods=60).rank(pct=True).clip(0,1)\n# factor: relative 3d reversal, volatility scaled, amplified only as stress rises\nr3=wide.pct_change(3).shift(1); vol=rets.shift(1).rolling(20,min_periods=15).std()\nres=r3.sub(r3.mean(axis=1),axis=0)\nf=-res/vol*(0.5+vp.fillna(.5))\nf=f.replace([np.inf,-np.inf],np.nan)\nfwd=wide.pct_change().shift(-1)\nrows=[]\nfor d in f.index:\n x=f.loc[d]; y=fwd.loc[d]; ok=x.notna()&y.notna()\n if ok.sum()>=8: rows.append((d,spearmanr(x[ok],y[ok]).statistic,ok.sum()))\nz=pd.DataFrame(rows,columns=['date','ic','n']).set_index('date')\nfor end in [z.index.max(),pd.Timestamp('2027-05-18')]:\n q=z.loc[:end]\n if len(q)==0: continue\n print('END',end.date(),'dates',len(q),'avg_n',q.n.mean(),'IC',q.ic.mean(),'ICIR',q.ic.mean()/q.ic.std(ddof=1),'hit', (q.ic>0).mean(),'coverage',q.n.mean()/15)\n for lo,hi in [('2020-01-01','2022-12-31'),('2023-01-01','2024-12-31'),('2025-01-01','2027-05-18')]:\n  a=q.loc[lo:hi]; print('REG',lo, len(a), a.ic.mean() if len(a) else np.nan)\n# decay\nfor h in [1,5,10]:\n yy=wide.pct_change(h).shift(-h); rr=[]\n for d in f.index:\n  ok=f.loc[d].notna()&yy.loc[d].notna()\n  if ok.sum()>=8: rr.append(spearmanr(f.loc[d][ok],yy.loc[d][ok]).statistic)\n print('DECAY',h,np.nanmean(rr),len(rr))\n# signal artifact\nout=f.reset_index().melt(id_vars='date',var_name='symbol',value_name='signal'); out.to_csv('scripts/miner_1_20270518_vix_stress_residual_signal.csv',index=False)\n", 'file_path': 'scripts/miner_1_20270518_vix_stress_residual.py'})
