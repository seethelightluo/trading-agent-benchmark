  ▶️ write_file({'content': "import numpy as np,pandas as pd\nfrom alphacrafter.sim.utils import get_index_daily_data,get_stock_daily_data\nU=['000300.SH','SPX','HSI','N225','SX5E','000688.SH','SOX','NDX','XAU','COPPER','WTI','BTC','ETH','US10Y','CN10Y']; CUT=pd.Timestamp('2027-04-21')\ndef fetch(s):\n for fn in (get_index_daily_data,get_stock_daily_data):\n  try:\n   d=fn(s,3000)\n   if d is not None and len(d):\n    d=d.copy(); d.date=pd.to_datetime(d.date).dt.normalize(); return d.drop_duplicates('date').set_index('date').sort_index().loc[:CUT]\n  except Exception: pass\n return None\nD={s:fetch(s) for s in U}; D={s:d for s,d in D.items() if d is not None}\ndef make(h):\n rows=[]; raw={}\n for s,d in D.items(): raw[s]=d.close.astype(float).pct_change(10)\n cross=pd.concat(raw,axis=1,sort=True).median(axis=1)\n for s,d in D.items():\n  c=d.close.astype(float); r=c.pct_change(); vol=r.rolling(30,min_periods=20).std()\n  rel=raw[s].reindex(c.index)-cross.reindex(c.index)\n  breadth=(cross.reindex(c.index)>0).rolling(20,min_periods=12).mean()-0.5\n  f=(rel/(vol+1e-12)*(1+0.8*breadth)).shift(1); fr=c.shift(-h)/c-1\n  rows.append(pd.DataFrame({'date':c.index,'asset':s,'f':f.to_numpy(),'fr':fr.to_numpy()}))\n return pd.concat(rows,ignore_index=True).replace([np.inf,-np.inf],np.nan).dropna()\ndef stats(x):\n z=[]; ns=[]\n for _,g in x.groupby('date'):\n  if len(g)>=8 and g.f.nunique()>1 and g.fr.nunique()>1: z.append(g.f.corr(g.fr,method='spearman')); ns.append(len(g))\n z=pd.Series(z)\n return len(z),float(np.mean(ns)),float(z.mean()),float(z.mean()/z.std(ddof=1)*np.sqrt(252)),float((z>0).mean())\nq=make(1); print('assets',len(D),'rows',len(q),'dates',q.date.nunique(),'avg_instruments',q.groupby('date').size().mean())\nfor h in [1,5,10,20]: print('horizon',h,stats(make(h)))\nfor a,b in [(2020,2022),(2023,2024),(2025,2027)]: print('regime',a,b,stats(q[(q.date.dt.year>=a)&(q.date.dt.year<=b)]))\nr=q.pivot(index='date',columns='asset',values='f').rank(axis=1,pct=True); print('rank_turnover',r.diff().abs().mean().mean(),'coverage',len(q)/(q.date.nunique()*15)); q.to_csv('scripts/miner_1_20270421_breadth_residual_signal.csv',index=False)\n", 'file_path': 'scripts/miner_1_20270421_breadth_residual.py'})
