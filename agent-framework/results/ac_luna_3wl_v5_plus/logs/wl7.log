 import json
from pathlib import Path
import numpy as np
from alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights

UNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
ENSEMBLE_PATH = Path(__file__).parent / "factors" / "factor_ensemble.json"
_last_decision = None


def load_ensemble():
    obj = json.loads(ENSEMBLE_PATH.read_text(encoding="utf-8"))
    return obj.get("selected_factors", [])[:10]


def rank(values):
    out = {s: 0.5 for s in UNIVERSE}
    valid = sorted([(s, float(v)) for s, v in values.items() if np.isfinite(v)], key=lambda x: x[1])
    for i, (s, _) in enumerate(valid):
        out[s] = (i + 1) / max(len(valid), 1)
    return out


def bounded(raw):
    # A diversified full-investment book: no asset below 1.5% or above 16%.
    lo, hi = 0.015, 0.16
    w = {s: max(float(raw.get(s, lo)), 1e-12) for s in UNIVERSE}
    for _ in range(40):
        clipped = {s: min(max(w[s], lo), hi) for s in UNIVERSE}
        free = [s for s in UNIVERSE if lo < w[s] < hi]
        residual = 1.0 - sum(clipped[s] for s in UNIVERSE if s not in free)
        scale = residual / max(sum(w[s] for s in free), 1e-12)
        nw = {s: clipped[s] for s in UNIVERSE}
        for s in free: nw[s] = w[s] * scale
        if max(abs(nw[s] - w[s]) for s in UNIVERSE) < 1e-10:
            w = nw
            break
        w = nw
    z = sum(w.values())
    return {s: w[s] / z for s in UNIVERSE}


@register_hook
def cross_asset_strategy():
    global _last_decision
    selected = load_ensemble()
    if not selected:
        return
    specs = {x["factor_id"]: (float(x["weight"]), int(x.get("direction", 1))) for x in selected}
    data = {}
    for s in UNIVERSE:
        df = get_stock_daily_data(symbol=s, days=120)
        if df is None or len(df) < 35:
            continue
        df = df.sort_values("date").reset_index(drop=True)
        c = np.asarray(df.close, float); h = np.asarray(df.high, float)
        l = np.asarray(df.low, float); v = np.asarray(df.volume, float)
        r = c[1:] / np.maximum(c[:-1], 1e-12) - 1
        data[s] = (c, h, l, v, r, str(df.iloc[-1].date))
    if len(data) < 12:
        return
    date = max(x[5] for x in data.values())
    # Daily hook, but only one proposal per ten trading-day block.
    if _last_decision is not None and (np.datetime64(date) - np.datetime64(_last_decision)) / np.timedelta64(1, "D") < 12:
        return

    vals = {fid: {} for fid in specs}
    recent5 = {}
    for s, (c, h, l, v, r, _) in data.items():
        vol = max(float(np.std(r[-20:])), 0.008)
        ret1, ret3 = r[-1], c[-1] / c[-4] - 1
        ret5 = c[-1] / c[-6] - 1; ret20 = c[-1] / c[-21] - 1
        recent5[s] = ret5
        eff = ret20 / max(float(np.sum(np.abs(r[-20:]))), 1e-12)
        clv = (2*c[-1] - h[-1] - l[-1]) / max(h[-1] - l[-1], 1e-12)
        range_ratio = max(h[-1]-l[-1], 1e-12) / max(float(np.mean(h[-20:]-l[-20:])), 1e-12)
        vz = (v[-1] - np.mean(v[-21:-1])) / max(float(np.std(v[-21:-1])), 1e-12)
        # Deterministic proxies preserve the ensemble's intended directions.
        proxy = {
            "miner_2_20261008_residual_short_reversal_3d": -ret3 / vol,
            "miner_2_20260827_range_efficiency_momentum": eff,
            "miner_2_20260716_risk_adjusted_momentum_20d": ret20 / vol,
            "miner_1_20260716_peer_median_leadlag_5d": ret5,
            "miner_3_20260827_range_weighted_intraday_reversal": -ret1 * range_ratio,
            "miner_3_20261022_smoothed_range_reversal_1d": -float(np.mean(r[-3:])) / vol,
            "miner_3_volume_confirmed_reversal_3d": (-ret3 / vol) * (1 + min(max(vz, 0), 2) / 2),
            "miner_3_20261008_asymmetric_volatility_reversal_2d": -ret1 / vol if ret1 < 0 else -0.5 * ret1 / vol,
            "miner_3_20260716_clv_1d": clv,
        }
        for fid in specs:
            if fid in proxy: vals[fid][s] = proxy[fid]
    if "miner_1_20260716_peer_median_leadlag_5d" in vals:
        for s, x in recent5.items():
            peers = [y for t, y in recent5.items() if t != s]
            vals["miner_1_20260716_peer_median_leadlag_5d"][s] = x - np.median(peers)

    score = {s: 0.5 for s in UNIVERSE}
    for fid, (wt, direction) in specs.items():
        rr = rank({s: direction * x for s, x in vals.get(fid, {}).items()})
        for s in UNIVERSE: score[s] += wt * (rr[s] - 0.5)

    # High-risk sideways/bearish regime: make the defensive tradable assets anchors.
    spx = data.get("SPX")
    bearish = spx is not None and (spx[0][-1] < spx[0][-21] or np.mean(spx[4][-5:]) < 0)
    if bearish:
        for s in ("XAU", "US10Y", "CN10Y"): score[s] += 0.10
        for s in ("BTC", "ETH", "WTI"): score[s] -= 0.06
    inv = {s: 1 / max(float(np.std(data[s][4][-20:])), 0.008) for s in data}
    avg_inv = float(np.mean(list(inv.values())))
    raw = {s: max(score[s], 0.02) * (0.78 + 0.22 * inv.get(s, avg_inv) / max(avg_inv, 1e-12)) for s in UNIVERSE}
    weights = bounded(raw)
    mean, sd = float(np.mean(list(score.values()))), max(float(np.std(list(score.values()))), 1e-12)
    forecast = {s: float(0.01 * (score[s] - mean) / sd) for s in UNIVERSE}
    rebalance_to_weights(weights, forecast_returns=forecast,
                         factor_ids=[x["factor_id"] for x in selected], horizon_days=10)
    _last_decision = date


