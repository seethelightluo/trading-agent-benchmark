='date',columns='asset',values='f').rank(axis=1,pct=True); print('turnover',float(p.diff().abs().mean().mean()))\nq.to_csv('scripts/miner_3_20270622_recovery_velocity_signal.csv',index=False)\n", 'file_path': 'scripts/miner_3_20270622_recovery_velocity.py'})
