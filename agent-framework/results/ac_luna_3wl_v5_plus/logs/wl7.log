  ▶️ write_file({'content': 'import json\nfrom pathlib import Path\nimport numpy as np\nfrom alphacrafter.sim.utils import register_hook, get_stock_daily_data, get_index_daily_data, rebalance_to_weights\n\nUNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]\nENSEMBLE = Path(__file__).parent / "factors" / "factor_ensemble.json"\nlast_decision = None\n\n\ndef load_ensemble():\n    try:\n        return json.loads(ENSEMBLE.read_text(encoding="utf-8")).get("selected_factors", [])[:10]\n    except Exception:\n        return []\n\n\ndef percentile(vals):\n    out = {s: .5 for s in UNIVERSE}\n    good = sorted((s, float(v)) for s, v in vals.items() if np.isfinite(v))\n    if not good:\n        return out\n    for i, (s, _) in enumerate(good):\n        out[s] = (i + .5) / len(good)\n    return out\n\n\ndef bounded(raw):\n    # Full investment, with modest diversification for this 15-asset universe.\n    w = {s: max(float(raw.get(s, 1 / 15)), 1e-12) for s in UNIVERSE}\n    for _ in range(50):\n        z = sum(w.values())\n        w = {s: x / z for s, x in w.items()}\n        low = {s for s in UNIVERSE if w[s] < .02}\n        high = {s for s in UNIVERSE if w[s] > .14}\n        if not low and not high:\n            break\n        fixed = low | high\n        for s in low: w[s] = .02\n        for s in high: w[s] = .14\n        free = [s for s in UNIVERSE if s not in fixed]\n        rem = 1.0 - sum(w[s] for s in fixed)\n        if free and rem > 0:\n            scale = rem / sum(w[s] for s in free)\n            for s in free: w[s] *= scale\n    z = sum(w.values())\n    return {s: w[s] / z for s in UNIVERSE}\n\n\n@register_hook\ndef cross_asset_strategy():\n    global last_decision\n    factors = load_ensemble()\n    if not factors:\n        return\n    feat, vol, stamps = {}, {}, {}\n    for s in UNIVERSE:\n        d = get_stock_daily_data(symbol=s, days=190)\n        if d is None or len(d) < 80:\n            continue\n        d = d.sort_values("date")\n        c = np.asarray(d["close"], dtype=float)\n        if len(c) < 65 or np.any(~np.isfinite(c)) or np.any(c <= 0):\n            continue\n        x = c[:-1]                         # completed bars only\n        r = x[1:] / x[:-1] - 1.0\n        r20, r60 = r[-20:], r[-60:]\n        m3, m5, m20 = x[-1] / x[-4] - 1, x[-1] / x[-6] - 1, x[-1] / x[-21] - 1\n        v20 = max(float(np.std(r20)), .008)\n        down = max(float(np.std(r20[r20 < 0])) if np.sum(r20 < 0) > 1 else .008, .008)\n        upside = max(float(np.std(r20[r20 > 0])) if np.sum(r20 > 1) else .008, .008)\n        feat[s] = {\n            # Contrarian shock recovery, scaled by the asymmetry of recent risk.\n            "asym": (-m5 / v20) * np.clip(upside / down, .5, 2.0),\n            # Used only when the macro stress trigger is active.\n            "vix": -m5 / v20,\n            "vol_state": (m20 / v20) * np.clip(np.std(r60) / v20, .5, 2.0),\n            "dispersion": -m5 / v20,\n            "sortino": m20 / down,\n            "consistency": np.mean(r60 > 0) * m20 / v20,\n        }\n        vol[s] = max(float(np.std(r[-26:])), .008)\n        stamps[s] = str(d.iloc[-1]["date"])\n    if len(feat) < 12:\n        return\n    stamp = max(stamps.values())\n    if last_decision is not None and (np.datetime64(stamp) - np.datetime64(last_decision)) / np.timedelta64(1, "D") < 10:\n        return\n\n    vd = get_index_daily_data(symbol="VIX", days=65)\n    stress = False\n    if vd is not None and len(vd) >= 32:\n        vc = np.asarray(vd.sort_values("date")["close"], dtype=float)\n        stress = bool(vc[-2] > 1.20 * max(np.median(vc[-32:-2]), 1e-9))\n    breadth = np.mean([feat[s]["consistency"] > 0 for s in feat])\n    risk_off = stress or breadth < .45\n    key = {\n        "asymmetric_volatility_reversal_2d": "asym",\n        "vix_stress_reversal": "vix",\n        "vol_state_momentum": "vol_state",\n        "dispersion_reversal": "dispersion",\n        "downside_sortino_momentum": "sortino",\n        "trend_consistency_risk_adjusted": "consistency",\n    }\n    score = {s: 0.0 for s in UNIVERSE}\n    for f in factors:\n        fragment = next((k for k in key if k in f.get("factor_id", "")), None)\n        if fragment is None:\n            continue\n        vals = {s: f.get("direction", 1) * feat[s][key[fragment]] for s in feat}\n        rr = percentile(vals)\n        # VIX reversal is inactive outside elevated stress, per ensemble hint.\n        if fragment == "vix_stress_reversal" and not stress:\n            continue\n        for s in UNIVERSE:\n            score[s] += float(f.get("weight", 0)) * (rr[s] - .5)\n    if risk_off:\n        for s in ("XAU", "US10Y", "CN10Y"):\n            score[s] += .10\n        for s in ("BTC", "ETH", "WTI"):\n            score[s] -= .07\n    inv_mean = np.mean([1.0 / vol.get(s, .02) for s in UNIVERSE])\n    raw = {s: max(.05, .5 + score[s]) * (.80 + .20 * (1.0 / vol.get(s, .02)) / inv_mean) for s in UNIVERSE}\n    target = bounded(raw)\n    mean = np.mean(list(score.values()))\n    sd = max(float(np.std(list(score.values()))), 1e-9)\n    forecast = {s: float(.01 * (score[s] - mean) / sd) for s in UNIVERSE}\n    rebalance_to_weights(target, forecast_returns=forecast,\n                         factor_ids=[f["factor_id"] for f in factors], horizon_days=10)\n    last_decision = stamp\n', 'file_path': 'strategy.py'})
