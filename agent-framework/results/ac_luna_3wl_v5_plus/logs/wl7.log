  ▶️ write_file({'content': 'import json\nfrom pathlib import Path\nimport numpy as np\nfrom alphacrafter.sim.utils import (\n    register_hook, get_stock_daily_data, get_index_daily_data,\n    rebalance_to_weights,\n)\n\nUNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]\nENSEMBLE_PATH = Path(__file__).parent / "factors" / "factor_ensemble.json"\n_last_decision = None\n\n\ndef load_ensemble():\n    try:\n        return json.loads(ENSEMBLE_PATH.read_text(encoding="utf-8")).get("selected_factors", [])[:10]\n    except Exception:\n        return []\n\n\ndef rank(values):\n    out = {s: 0.5 for s in UNIVERSE}\n    good = sorted((s, v) for s, v in values.items() if np.isfinite(v))\n    if not good:\n        return out\n    for i, (s, _) in enumerate(good):\n        out[s] = (i + 0.5) / len(good)\n    return out\n\n\ndef bounded_weights(raw):\n    # Full-investment, long-only, diversified 15-asset portfolio.\n    w = {s: max(float(raw.get(s, 0.0)), 1e-8) for s in UNIVERSE}\n    for _ in range(30):\n        total = sum(w.values())\n        w = {s: v / total for s, v in w.items()}\n        low = {s for s in UNIVERSE if w[s] < 0.02}\n        high = {s for s in UNIVERSE if w[s] > 0.14}\n        if not low and not high:\n            break\n        fixed = low | high\n        for s in low: w[s] = 0.02\n        for s in high: w[s] = 0.14\n        free = [s for s in UNIVERSE if s not in fixed]\n        rem = 1.0 - sum(w[s] for s in fixed)\n        scale = rem / (sum(w[s] for s in free) or 1.0)\n        for s in free: w[s] *= scale\n    total = sum(w.values())\n    return {s: w[s] / total for s in UNIVERSE}\n\n\n@register_hook\ndef cross_asset_strategy():\n    global _last_decision\n    selected = load_ensemble()\n    if not selected:\n        return\n    specs = [(x["factor_id"], float(x["weight"]), int(x.get("direction", 1))) for x in selected]\n    close, ret, vol, dates = {}, {}, {}, []\n    for s in UNIVERSE:\n        d = get_stock_daily_data(symbol=s, days=180)\n        if d is None or len(d) < 75:\n            continue\n        d = d.sort_values("date")\n        c = np.asarray(d["close"], dtype=float)\n        if np.all(np.isfinite(c)) and np.all(c > 0):\n            close[s] = c\n            ret[s] = c[1:] / c[:-1] - 1.0\n            vol[s] = max(float(np.std(ret[s][-23:-1])), 0.008)\n            dates.append(d.iloc[-1]["date"])\n    if len(close) < 12:\n        return\n    decision = str(max(dates))\n    if _last_decision is not None:\n        try:\n            if (np.datetime64(decision) - np.datetime64(_last_decision)) / np.timedelta64(1, "D") < 10:\n                return\n        except Exception:\n            return\n\n    feat = {}\n    for s, c in close.items():\n        # Lag one completed bar; predictors never use the current bar.\n        p, r = c[:-1], ret[s][:-1]\n        q = r[-20:]\n        v = max(float(np.std(q)), 0.008)\n        down = max(float(np.std(q[q < 0])) if np.any(q < 0) else 0.008, 0.008)\n        r5, r10, r15, r20 = p[-1]/p[-6]-1, p[-1]/p[-11]-1, p[-1]/p[-16]-1, p[-1]/p[-21]-1\n        breadth = float(np.mean(q > 0))\n        path = max(float(np.sum(np.abs(q))), 0.02)\n        feat[s] = {\n            "stress_reversal": -r10 / v,\n            "breadth": breadth * (0.5 + r20 / v),\n            "consistency": breadth * (0.5 + r20 / v),\n            "volstate": r20 / v,\n            "efficiency": r20 / path,\n            "breakout": r15 / v,\n            "persistent": r20 / v,\n            "dispersion_reversal": -r5 / v,\n        }\n\n    score = {s: 0.5 for s in UNIVERSE}\n    for fid, wt, direction in specs:\n        if "continuous_stress_reversal" in fid: key = "stress_reversal"\n        elif "signed_breadth_momentum" in fid: key = "breadth"\n        elif "trend_consistency" in fid: key = "consistency"\n        elif "vol_state_momentum" in fid: key = "volstate"\n        elif "efficiency_trend" in fid: key = "efficiency"\n        elif "compression_breakout" in fid: key = "breakout"\n        elif "persistent_trend_quality" in fid: key = "persistent"\n        elif "dispersion_reversal" in fid: key = "dispersion_reversal"\n        else: continue\n        rr = rank({s: direction * feat[s][key] for s in feat})\n        for s in UNIVERSE:\n            score[s] += wt * (rr[s] - 0.5)\n\n    vix = get_index_daily_data(symbol="VIX", days=65)\n    high_vix = False\n    if vix is not None and len(vix) >= 32:\n        vc = np.asarray(vix.sort_values("date")["close"], dtype=float)\n        high_vix = bool(vc[-2] > 1.2 * np.median(vc[-32:-2]))\n    spx = close.get("SPX")\n    risk_off = high_vix or (spx is not None and (spx[-2] < spx[-22] or np.mean(ret["SPX"][-7:-2]) < 0))\n    if risk_off:\n        for s in ("XAU", "US10Y", "CN10Y"): score[s] += 0.10\n        for s in ("BTC", "ETH", "WTI"): score[s] -= 0.07\n\n    avg_inv = np.mean([1.0 / vol.get(s, 0.02) for s in UNIVERSE])\n    raw = {s: max(score[s], 0.05) * (0.78 + 0.22 * (1.0 / vol.get(s, 0.02)) / avg_inv) for s in UNIVERSE}\n    target = bounded_weights(raw)\n    mean = np.mean(list(score.values()))\n    sd = max(float(np.std(list(score.values()))), 1e-9)\n    forecast = {s: float(0.01 * (score[s] - mean) / sd) for s in UNIVERSE}\n    rebalance_to_weights(target, forecast_returns=forecast,\n                         factor_ids=[x[0] for x in specs], horizon_days=10)\n    _last_decision = decision\n\n\nfactor_ensemble = load_ensemble\n\nif __name__ == "__main__":\n    print(json.dumps({"factors": [x["factor_id"] for x in load_ensemble()], "assets": len(UNIVERSE)}))\n', 'file_path': 'strategy.py'})
