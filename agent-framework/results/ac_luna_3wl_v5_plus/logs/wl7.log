  ▶️ write_file({'content': 'import json\nfrom pathlib import Path\nimport numpy as np\nfrom alphacrafter.sim.utils import register_hook, get_stock_daily_data, get_index_daily_data, rebalance_to_weights\n\nUNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]\nENSEMBLE = Path(__file__).parent / "factor_ensemble.json"\nlast_decision = None\n\n\ndef load_factors():\n    try:\n        return json.loads(ENSEMBLE.read_text(encoding="utf-8")).get("selected_factors", [])[:10]\n    except Exception:\n        return []\n\n\ndef rank(values):\n    out = {s: 0.5 for s in UNIVERSE}\n    valid = sorted((s, float(v)) for s, v in values.items() if np.isfinite(v))\n    for i, (s, _) in enumerate(valid):\n        out[s] = (i + 0.5) / len(valid)\n    return out\n\n\ndef bounded(raw):\n    w = {s: max(float(raw.get(s, 1 / 15)), 1e-12) for s in UNIVERSE}\n    for _ in range(30):\n        z = sum(w.values()); w = {s: x / z for s, x in w.items()}\n        lo = {s for s in UNIVERSE if w[s] < .02}; hi = {s for s in UNIVERSE if w[s] > .14}\n        if not lo and not hi: break\n        fixed = lo | hi\n        for s in lo: w[s] = .02\n        for s in hi: w[s] = .14\n        free = [s for s in UNIVERSE if s not in fixed]\n        rem = 1 - sum(w[s] for s in fixed)\n        if free and rem > 0:\n            scale = rem / sum(w[s] for s in free)\n            for s in free: w[s] *= scale\n    z = sum(w.values())\n    return {s: w[s] / z for s in UNIVERSE}\n\n\n@register_hook\ndef cross_asset_strategy():\n    global last_decision\n    factors = load_factors()\n    if not factors: return\n    prices, vol, features, dates = {}, {}, {}, {}\n    for s in UNIVERSE:\n        d = get_stock_daily_data(symbol=s, days=190)\n        if d is None or len(d) < 80: continue\n        d = d.sort_values("date")\n        c = np.asarray(d["close"], dtype=float)\n        if np.any(~np.isfinite(c)) or np.any(c <= 0): continue\n        r = c[1:] / c[:-1] - 1\n        r5, r20, r40 = r[-6:-1], r[-21:-1], r[-41:-1]\n        m5, m20 = c[-2] / c[-7] - 1, c[-2] / c[-22] - 1\n        v5, v20 = max(float(np.std(r5)), .008), max(float(np.std(r20)), .008)\n        downside = max(float(np.std(r20[r20 < 0])) if np.sum(r20 < 0) > 1 else .008, .008)\n        consistency = float(np.mean(r40 > 0))\n        efficiency = abs(float(np.sum(r20))) / max(float(np.sum(abs(r20))), .008)\n        state = np.clip(float(np.std(r40)) / v20, .5, 2.)\n        prices[s], vol[s], dates[s] = c, max(float(np.std(r[-26:-1])), .008), str(d.iloc[-1]["date"])\n        features[s] = {"asym": -m5 / v5, "breadth": consistency*m20/v20, "trend": consistency*m20/v20,\n                       "volstate": m20/v20*state, "range": m20/v20*efficiency, "downside": m20/downside}\n    if len(prices) < 12: return\n    stamp = max(dates.values())\n    if last_decision is not None and (np.datetime64(stamp)-np.datetime64(last_decision))/np.timedelta64(1,"D") < 10: return\n    vix_ratio = 1.\n    vd = get_index_daily_data(symbol="VIX", days=65)\n    if vd is not None and len(vd) >= 32:\n        vc = np.asarray(vd.sort_values("date")["close"], dtype=float)\n        vix_ratio = max(1., float(vc[-2]/max(np.median(vc[-32:-2]), 1e-9)))\n    mapping = {"asymmetric_volatility_reversal":"asym", "signed_breadth_momentum":"breadth", "trend_consistency_risk_adjusted":"trend", "vol_state_momentum":"volstate", "range_efficiency_momentum":"range", "downside_risk_momentum":"downside"}\n    score = {s: .5 for s in UNIVERSE}\n    for f in factors:\n        key = next((v for k,v in mapping.items() if k in f.get("factor_id","")), None)\n        if key is None: continue\n        rr = rank({s: float(f.get("direction",1))*features[s][key] for s in features})\n        for s in UNIVERSE: score[s] += float(f.get("weight",0))*(rr[s]-.5)\n    spx = prices.get("SPX")\n    if vix_ratio > 1.20 or (spx is not None and spx[-2] < spx[-22]):\n        for s in ("XAU","US10Y","CN10Y"): score[s] += .10\n        for s in ("BTC","ETH","WTI"): score[s] -= .07\n    inv_mean = np.mean([1/vol.get(s,.02) for s in UNIVERSE])\n    raw = {s:max(score[s],.05)*(.78+.22*(1/vol.get(s,.02))/inv_mean) for s in UNIVERSE}\n    target = bounded(raw)\n    avg, sd = np.mean(list(score.values())), max(float(np.std(list(score.values()))),1e-9)\n    forecast = {s: float(.01*(score[s]-avg)/sd) for s in UNIVERSE}\n    rebalance_to_weights(target, forecast_returns=forecast, factor_ids=[f["factor_id"] for f in factors], horizon_days=10)\n    last_decision = stamp\n', 'file_path': 'strategy.py'})
