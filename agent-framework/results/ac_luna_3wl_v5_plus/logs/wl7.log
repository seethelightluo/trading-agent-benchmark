))\nprint('period',q.date.min(),q.date.max()); q.to_csv('scripts/miner_2_20270212_path_persistence_momentum_signal.csv',index=False)\n", 'file_path': 'scripts/miner_2_20270212_path_persistence_momentum.py'})
