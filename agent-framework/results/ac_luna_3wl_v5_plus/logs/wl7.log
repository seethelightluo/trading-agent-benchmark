loat)[:-1]  # only completed bars\n        if len(c) < 100 or np.any(~np.isfinite(c)) or np.any(c <= 0): continue\n        r = c[1:] / c[:-1] - 1.0\n        def ret(n): return c[-1] / c[-n-1] - 1.0\n        v10=max(np.std(r[-10:]), .008); v20=max(np.std(r[-20:]), .008)\n        v30=max(np.std(r[-30:]), .008); v40=max(np.std(r[-40:]), .008)\n        neg=r[-30:][r[-30:] < 0]\n        dn=max(np.std(neg) if len(neg) > 1 else v30, .008)\n        m5,m10,m20,m30,m40=[ret(n) for n in (5,10,20,30,40)]\n        low20=np.min(c[-21:]); high20=np.max(c[-21:])\n        path=np.sum(np.abs(r[-10:])) + 1e-8\n        data[s] = {\n          "quality": m40 / v40,\n          "sortino": m30 / dn,\n          "riskmom": m30 / v30,\n          "residual": m30 / v30,  # cross-sectional de-meaning is applied below\n          "multi": np.mean([np.sign(m10), np.sign(m20), np.sign(m30), np.sign(m40)]) + .15*m10/v10,\n          "stress": -m10 / v20,\n          "asym": -m5 / max(np.std(r[-10:][r[-10:] < 0]) if np.sum(r[-10:] < 0)>1 else v10, .008),\n          "recovery": ((c[-1]-low20) / max(high20-low20, 1e-8)) * (abs(m10)/path),\n        }\n        vol[s]=max(np.std(r[-25:]), .008); stamps[s]=str(df.iloc[-1]["date"])\n    if len(data) < 12: return\n    stamp=max(stamps.values())\n    if last_decision is not None and (np.datetime64(stamp)-np.datetime64(last_decision))/np.timedelta64(1,"D") < 10: return\n\n    # Relative/residual trend is explicitly cross-sectional and lagged.\n    med=np.median([data[s]["riskmom"] for s in data])\n    for s in data: data[s]["residual"] -= med\n    keys={\n      "miner_1_20270609_quality_momentum":"quality",\n      "miner_3_20270716_downside_sortino_momentum_30d":"sortino",\n      "miner_1_20270723_risk_adjusted_momentum30":"riskmom",\n      "miner_3_20270813_residual_trend_30d":"residual",\n      "miner_1_20270622_multihorizon_agreement":"multi",\n      "miner_3_20270506_continuous_stress_reversal":"stress",\n      "miner_3_20261130_asymmetric_volatility_reversal_