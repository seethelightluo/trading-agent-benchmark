import json
from pathlib import Path
import numpy as np
from alphacrafter.sim.utils import (
    register_hook, get_stock_daily_data, get_index_daily_data,
    rebalance_to_weights,
)

UNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
ENSEMBLE = Path(__file__).parent / "factors" / "factor_ensemble.json"
last_decision = None


def load_ensemble():
    try:
        return json.loads(ENSEMBLE.read_text(encoding="utf-8")).get("selected_factors", [])[:10]
    except Exception:
        return []


def percentile(vals):
    out = {s: .5 for s in UNIVERSE}
    good = [(s, float(v)) for s, v in vals.items() if np.isfinite(v)]
    if not good:
        return out
    good.sort(key=lambda x: x[1])
    n = len(good)
    for i, (s, _) in enumerate(good):
        out[s] = (i + .5) / n
    return out


def bounded(raw):
    # Full investment, modest concentration for a 15-asset high-risk universe.
    w = {s: max(float(raw.get(s, 1/15)), 1e-9) for s in UNIVERSE}
    for _ in range(30):
        z = sum(w.values()); w = {s: x / z for s, x in w.items()}
        lo = [s for s in UNIVERSE if w[s] < .02]
        hi = [s for s in UNIVERSE if w[s] > .14]
        if not lo and not hi:
            break
        fixed = set(lo + hi)
        for s in lo: w[s] = .02
        for s in hi: w[s] = .14
        free = [s for s in UNIVERSE if s not in fixed]
        rem = 1.0 - sum(w[s] for s in fixed)
        if free and rem > 0:
            scale = rem / sum(w[s] for s in free)
            for s in free: w[s] *= scale
    z = sum(w.values())
    return {s: w[s] / z for s in UNIVERSE}


@register_hook
def cross_asset_strategy():
    global last_decision
    factors = load_ensemble()
    if not factors:
        return
    data, feat, vol, dates = {}, {}, {}, {}
    for s in UNIVERSE:
        d = get_stock_daily_data(symbol=s, days=190)
        if d is None or len(d) < 80:
            continue
        d = d.sort_values("date")
        c = np.asarray(d["close"], dtype=float)
        if np.any(~np.isfinite(c)) or np.any(c <= 0):
            continue
        r = c[1:] / c[:-1] - 1.0
        # Last usable observation is t-1; exclude the current/incomplete bar.
        r5, r20, r60 = r[-6:-1], r[-21:-1], r[-61:-1]
        v20 = max(float(np.std(r20)), .008)
        down = max(float(np.std(r20[r20 < 0])) if np.sum(r20 < 0) > 1 else .008, .008)
        m5, m20 = c[-2] / c[-7] - 1, c[-2] / c[-22] - 1
        consistency = float(np.mean(r60 > 0))
        state = np.clip(float(np.std(r60)) / v20, .5, 2.0)
        feat[s] = {
            "vix": -m5 / max(float(np.std(r5)), .008),
            "disp": -m5 / v20,
            "volstate": m20 / v20 * state,
            "sortino": m20 / down,
            "consistency": consistency * m20 / v20,
        }
        vol[s] = max(float(np.std(r[-26:-1])), .008)
        dates[s] = str(d.iloc[-1]["date"])
    if len(feat) < 12:
        return
    stamp = max(dates.values())
    if last_decision is not None and (np.datetime64(stamp) - np.datetime64(last_decision)) / np.timedelta64(1, "D") < 10:
        return

    # Stress observation is used only for regime tilt; it is never tradable.
    vd = get_index_daily_data(symbol="VIX", days=65)
    stress = False
    if vd is not None and len(vd) >= 32:
        vc = np.asarray(vd.sort_values("date")["close"], dtype=float)
        stress = float(vc[-2] / max(np.median(vc[-32:-2]), 1e-9)) > 1.20
    broad_bear = feat.get("SPX", {}).get("consistency", 0) < 0

    keys = {
        "vix_stress_reversal": "vix", "dispersion_reversal": "disp",
        "vol_state_momentum": "volstate", "downside_sortino_momentum": "sortino",
        "trend_consistency_risk_adjusted": "consistency",
    }
    score = {s: 0.0 for s in UNIVERSE}
    for f in factors:
        fid = f.get("factor_id", "")
        key = next((v for k, v in keys.items() if k in fid), None)
        if key is None:
            continue
        rr = percentile({s: f.get("direction", 1) * feat[s][key] for s in feat})
        for s in UNIVERSE:
            score[s] += float(f.get("weight", 0.0)) * (rr[s] - .5)
    if stress or broad_bear:
        for s in ("XAU", "US10Y", "CN10Y"):
            score[s] += .10
        for s in ("BTC", "ETH", "WTI"):
            score[s] -= .07
    inv_avg = np.mean([1.0 / vol.get(s, .02) for s in UNIVERSE])
    raw = {s: max(score[s] + .5, .05) * (.80 + .20 * (1.0 / vol.get(s, .02)) / inv_avg) for s in UNIVERSE}
    target = bounded(raw)
    mean, sd = np.mean(list(score.values())), max(float(np.std(list(score.values()))), 1e-9)
    forecast = {s: float(.01 * (score[s] - mean) / sd) for s in UNIVERSE}
    rebalance_to_weights(target, forecast_returns=forecast,
                         factor_ids=[f["factor_id"] for f in factors], horizon_days=10)
    last_decision = stamp

