    return out


def bounded(raw):
    # Full investment, with useful diversification in a 15-name cross-section.
    w = {s: max(float(raw.get(s, 1e-6)), 1e-8) for s in UNIVERSE}
    for _ in range(20):
        z = sum(w.values())
