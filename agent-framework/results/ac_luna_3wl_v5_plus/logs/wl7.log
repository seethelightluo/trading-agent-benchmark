 import json
from pathlib import Path
import numpy as np
from alphacrafter.sim.utils import (
    register_hook, get_stock_daily_data, get_index_daily_data,
    rebalance_to_weights,
)

UNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
ENSEMBLE_PATH = Path(__file__).parent / "factors" / "factor_ensemble.json"
last_decision = None


def load_ensemble():
    try:
        return json.loads(ENSEMBLE_PATH.read_text()).get("selected_factors", [])[:10]
    except Exception:
        return []


def cross_rank(values):
    out = {s: 0.5 for s in UNIVERSE}
    valid = sorted((s, v) for s, v in values.items() if np.isfinite(v))
    for i, (s, _) in enumerate(valid):
        out[s] = (i + 0.5) / len(valid)
    return out


def cap_weights(raw):
    w = {s: max(float(raw.get(s, 0.0)), 1e-9) for s in UNIVERSE}
    # A 15-asset cross-section needs diversification, while retaining signal tilt.
    for _ in range(30):
        z = sum(w.values())
        w = {s: x / z for s, x in w.items()}
        low = {s for s in UNIVERSE if w[s] < 0.02}
        high = {s for s in UNIVERSE if w[s] > 0.14}
        if not low and not high:
            break
        fixed = low | high
        for s in low: w[s] = 0.02
        for s in high: w[s] = 0.14
        free = [s for s in UNIVERSE if s not in fixed]
        rem = 1.0 - sum(w[s] for s in fixed)
        scale = rem / max(sum(w[s] for s in free), 1e-12)
        for s in free: w[s] *= scale
    z = sum(w.values())
    return {s: w[s] / z for s in UNIVERSE}


@register_hook
def cross_asset_strategy():
    global last_decision
    factors = load_ensemble()
    if not factors:
        return
    data, vol = {}, {}
    for s in UNIVERSE:
        d = get_stock_daily_data(symbol=s, days=190)
        if d is None or len(d) < 80:
            continue
        d = d.sort_values("date")
        c = np.asarray(d["close"], dtype=float)
        if np.all(np.isfinite(c)) and np.all(c > 0):
            data[s] = (c, str(d.iloc[-1]["date"]))
            r = c[1:] / c[:-1] - 1
            vol[s] = max(float(np.std(r[-25:-1])), 0.008)
    if len(data) < 12:
        return
    decision = max(x[1] for x in data.values())
    if last_decision is not None:
        try:
            if (np.datetime64(decision) - np.datetime64(last_decision)) / np.timedelta64(1, "D") < 10:
                return
        except Exception:
            return

    signals = {}
    for s, (c, _) in data.items():
        r = c[1:] / c[:-1] - 1
        r10, r20 = r[-11:-1], r[-21:-1]
        v10, v20 = max(float(np.std(r10)), .008), max(float(np.std(r20)), .008)
        v60 = max(float(np.std(r[-61:-1])), .008)
        m20, m60 = c[-2] / c[-22] - 1, c[-2] / c[-62] - 1
        downside = max(float(np.std(r20[r20 < 0])) if np.sum(r20 < 0) > 1 else .008, .008)
        consistency = float(np.mean(r[-41:-1] > 0))
        signals[s] = {
            "asym": -(c[-2] / c[-4] - 1) / v10 * (1 + max(0., -m20) / v20),
            "breadth": consistency * m20 / v20,
            "conditioned": m20 / v20,
            "consistency": m60 / v60 * (.5 + consistency),
            "persistent": m60 / v60 * (.5 + consistency),
            "volstate": m20 / v20 * min(2., v60 / v20),
            "down": m20 / downside,
            "compressed": m20 / v20 * min(2., max(.5, v60 / v20)),
        }
    keymap = {
        "asymmetric_volatility_reversal": "asym",
        "signed_breadth_momentum": "breadth",
        "vol_state_momentum": "volstate",
        "trend_consistency_risk_adjusted": "consistency",
        "conditioned_momentum": "conditioned",
        "persistent_trend_quality": "persistent",
        "downside_risk_momentum": "down",
        "compressed_momentum": "compressed",
    }
    score = {s: 0.5 for s in UNIVERSE}
    for f in factors:
        fid = f.get("factor_id", "")
        key = next((v for k, v in keymap.items() if k in fid), None)
        if key is None:
            continue
        rr = cross_rank({s: int(f.get("direction", 1)) * signals[s][key] for s in signals})
        for s in UNIVERSE:
            score[s] += float(f.get("weight", 0.0)) * (rr[s] - 0.5)

    # Medium-high, uneven risk: retain full investment but rotate toward defensives.
    vix = get_index_daily_data(symbol="VIX", days=65)
    stress = False
    if vix is not None and len(vix) >= 32:
        vc = np.asarray(vix.sort_values("date")["close"], dtype=float)
        stress = bool(vc[-2] > 1.2 * np.median(vc[-32:-2]))
    spx = data.get("SPX", (None,))[0]
    riskoff = stress or (spx is not None and (spx[-2] < spx[-22] or np.mean(spx[-8:-2] / spx[-9:-3] - 1) < 0))
    if riskoff:
        for s in ("XAU", "US10Y", "CN10Y"): score[s] += 0.10
        for s in ("BTC", "ETH", "WTI"): score[s] -= 0.07
    invmean = np.mean([1.0 / vol.get(s, 0.02) for s in UNIVERSE])
    raw = {s: max(score[s], 0.05) * (0.78 + 0.22 * (1.0 / vol.get(s, 0.02)) / invmean) for s in UNIVERSE}
    target = cap_weights(raw)
    mean = np.mean(list(score.values()))
    sd = max(float(np.std(list(score.values()))), 1e-9)
    forecast = {s: float(0.01 * (score[s] - mean) / sd) for s in UNIVERSE}
    rebalance_to_weights(target, forecast_returns=forecast,
                         factor_ids=[f["factor_id"] for f in factors], horizon_days=10)
    last_decision = decision

if __name__ == "__main__":
    print([f["factor_id"] for f in load_ensemble()])


