  ▶️ write_file({'content': 'import json\nfrom pathlib import Path\nimport numpy as np\nfrom alphacrafter.sim.utils import (\n    register_hook, get_stock_daily_data, get_index_daily_data,\n    rebalance_to_weights,\n)\n\nUNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]\nENSEMBLE = Path(__file__).parent / "factors" / "factor_ensemble.json"\nlast_decision = None\n\n\ndef load_factors():\n    try:\n        return json.loads(ENSEMBLE.read_text(encoding="utf-8")).get("selected_factors", [])[:10]\n    except Exception:\n        return []\n\n\ndef percentile(values):\n    out = {s: .5 for s in UNIVERSE}\n    valid = sorted((s, v) for s, v in values.items() if np.isfinite(v))\n    if valid:\n        for i, (s, _) in enumerate(valid):\n            out[s] = (i + .5) / len(valid)\n    return out\n\n\ndef bounded(raw):\n    # Full investment, with sensible diversification for a 15-asset universe.\n    w = {s: max(float(raw.get(s, 1.0)), 1e-12) for s in UNIVERSE}\n    for _ in range(30):\n        z = sum(w.values())\n        w = {s: x / z for s, x in w.items()}\n        low = {s for s in UNIVERSE if w[s] < .02}\n        high = {s for s in UNIVERSE if w[s] > .14}\n        if not low and not high:\n            break\n        fixed = low | high\n        for s in low: w[s] = .02\n        for s in high: w[s] = .14\n        free = [s for s in UNIVERSE if s not in fixed]\n        remainder = max(0.0, 1.0 - sum(w[s] for s in fixed))\n        scale = remainder / max(sum(w[s] for s in free), 1e-12)\n        for s in free: w[s] *= scale\n    z = sum(w.values())\n    return {s: w[s] / z for s in UNIVERSE}\n\n\n@register_hook\ndef cross_asset_strategy():\n    global last_decision\n    factors = load_factors()\n    if not factors:\n        return\n    prices, vol = {}, {}\n    for symbol in UNIVERSE:\n        df = get_stock_daily_data(symbol=symbol, days=190)\n        if df is None or len(df) < 80:\n            continue\n        close = np.asarray(df.sort_values("date")["close"], dtype=float)\n        if np.all(np.isfinite(close)) and np.all(close > 0):\n            prices[symbol] = close\n            r = close[1:] / close[:-1] - 1\n            vol[symbol] = max(float(np.std(r[-26:-1])), .008)\n    if len(prices) < 12:\n        return\n    stamp = str(max(get_stock_daily_data(symbol=s, days=2).sort_values("date").iloc[-1]["date"] for s in prices))\n    if last_decision is not None:\n        try:\n            if (np.datetime64(stamp) - np.datetime64(last_decision)) / np.timedelta64(1, "D") < 10:\n                return\n        except Exception:\n            pass\n\n    raw_signal = {}\n    for s, c in prices.items():\n        r = c[1:] / c[:-1] - 1\n        r10, r20 = r[-11:-1], r[-21:-1]\n        v10 = max(float(np.std(r10)), .008)\n        v20 = max(float(np.std(r20)), .008)\n        v60 = max(float(np.std(r[-61:-1])), .008)\n        m20, m60 = c[-2] / c[-22] - 1, c[-2] / c[-62] - 1\n        consistency = float(np.mean(r[-41:-1] > 0))\n        downside = max(float(np.std(r20[r20 < 0])) if np.sum(r20 < 0) > 1 else .008, .008)\n        # Each proxy is lagged one session; ranks make heterogeneous assets comparable.\n        raw_signal[s] = {\n            "asym": -(c[-2] / c[-4] - 1) / v10 * (1 + max(0., -m20) / v20),\n            "conditioned": m20 / v20,\n            "breadth": consistency * m20 / v20,\n            "dispersion": m20 / v20 * min(2., max(.5, v60 / v20)),\n            "volstate": m20 / v20 * min(2., v60 / v20),\n            "down": m20 / downside,\n            "range": (m20 / v20) * (.5 + consistency),\n        }\n    mapping = {\n        "asymmetric_volatility_reversal_2d": "asym",\n        "conditioned_momentum": "conditioned",\n        "signed_breadth_momentum": "breadth",\n        "dispersion_conditioned_momentum": "dispersion",\n        "vol_state_momentum": "volstate",\n        "downside_risk_momentum": "down",\n        "range_efficiency_momentum": "range",\n    }\n    score = {s: .5 for s in UNIVERSE}\n    for factor in factors:\n        name = factor.get("factor_id", "")\n        key = next((v for k, v in mapping.items() if k in name), None)\n        if key is None:\n            continue\n        ranks = percentile({s: factor.get("direction", 1) * raw_signal[s][key] for s in raw_signal})\n        for s in UNIVERSE:\n            score[s] += float(factor.get("weight", 0.0)) * (ranks[s] - .5)\n\n    # High-risk sideways/bearish regime: remain fully invested but favor gold/yields.\n    stress = False\n    vix = get_index_daily_data(symbol="VIX", days=65)\n    if vix is not None and len(vix) >= 32:\n        vc = np.asarray(vix.sort_values("date")["close"], dtype=float)\n        stress = bool(vc[-2] > 1.2 * np.median(vc[-32:-2]))\n    spx = prices.get("SPX")\n    riskoff = stress or (spx is not None and (spx[-2] < spx[-22] or np.mean(spx[-8:-2] / spx[-9:-3] - 1) < 0))\n    if riskoff:\n        for s in ("XAU", "US10Y", "CN10Y"): score[s] += .10\n        for s in ("BTC", "ETH", "WTI"): score[s] -= .07\n\n    mean_inv = np.mean([1.0 / vol.get(s, .02) for s in UNIVERSE])\n    raw = {s: max(score[s], .05) * (.78 + .22 * (1.0 / vol.get(s, .02)) / mean_inv) for s in UNIVERSE}\n    target = bounded(raw)\n    mu = np.mean(list(score.values()))\n    sd = max(np.std(list(score.values())), 1e-9)\n    forecast = {s: float(.01 * (score[s] - mu) / sd) for s in UNIVERSE}\n    rebalance_to_weights(target, forecast_returns=forecast,\n                         factor_ids=[f["factor_id"] for f in factors], horizon_days=10)\n    last_decision = stamp\n', 'file_path': 'strategy.py'})
