bol=s, days=190)\n        if d is None or len(d) < 80:\n            continue\n        d = d.sort_values("date")\n        c = np.asarray(d["close"], dtype=float)\n        if np.all(np.isfinite(c)) and np.all(c > 0):\n            series[s] = (c, str(d.iloc[-1]["date"]))\n            vol[s] = max(float(np.std(c[1:] / c[:-1] - 1)[-23:-1] if False else np.std((c[1:] / c[:-1] - 1)[-23:-1])), .008)\n    if len(series) < 12:\n        return\n    decision = max(v[1] for v in series.values())\n    if _last_decision is not None:\n        try:\n            if (np.datetime64(decision) - np.datetime64(_last_decision)) / np.timedelta64(1, "D") < 10:\n                return\n        except Exception:\n            return\n\n    signals = {}\n    for s, (c, _) in series.items():\n        r = c[1:] / c[:-1] - 1\n        r5, r10, r20 = r[-6:-1], r[-11:-1], r[-21:-1]\n        v10 = max(float(np.std(r10)), .008)\n        v20 = max(float(np.std(r20)), .008)\n        v60 = max(float(np.std(r[-61:-1])), .008)\n        neg = r20[r20 < 0]\n        down = max(float(np.std(neg)) if len(neg) > 1 else .008, .008)\n        m20 = c[-2] / c[-22] - 1\n        pos = float(np.mean(r20 > 0))\n        # All features use data through the prior completed session.\n        signals[s] = {\n            "shock": -(c[-2] / c[-5] - 1) / v10 * v10 / v60,\n            "breadth": pos * (.5 + m20 / v20),\n            "volstate": (m20 / v20) * min(2., v60 / v20),\n            "consistency": m20 / v20 * (.5 + pos),\n            "persistent": m20 / v20 * (.5 + pos),\n            "breakout": (c[-2] / max(c[-22:-2]) - 1) / v20,\n            "shortrev": -(c[-2] / c[-7] - 1) / max(float(np.std(r[-31:-1])), .008),\n            "downtrend": m20 / down,\n        }\n\n    score = {s: .5 for s in UNIVERSE}\n    for spec in selected:\n        fid = spec.get("factor_id", "")\n        wt, direction = float(spec.get("weight", 0)), int(spec.get("direction", 1))\n        if "vol_shock_reversal" in fid: key = "shock"\n        elif "signed_breadth_momentum" in fid: key = "breadth"\n        elif "vol_state_momentum" in fid: key = "volstate"\n        elif "trend_consistency_risk_adjusted" in fid: key = "consistency"\n        elif "persistent_trend_quality" in fid: key = "persistent"\n        elif "breakout_persistence" in fid: key = "breakout"\n        elif "vol_scaled_short_reversal" in fid: key = "shortrev"\n        elif "downside_risk_adjusted_trend" in fid: key = "downtrend"\n        else: continue\n        rr = rank({s: direction * signals[s][key] for s in signals})\n        for s in UNIVERSE:\n            score[s] += wt * (rr[s] - .5)\n\n    vix = get_index_daily_data(symbol="VIX", days=65)\n    high_vix = False\n    if vix is not None and len(vix) >= 32:\n        vc = np.asarray(vix.sort_values("date")["close"], float)\n        high_vix = bool(vc[-2] > 1.2 * np.median(vc[-32:-2]))\n    spx = series.get("SPX", (None,))[0]\n    risk_off = high_vix or (spx is not None and (spx[-2] < spx[-22] or np.mean(spx[-8:-2] / spx[-9:-3] - 1) < 0))\n    if risk_off:\n        for s in ("XAU", "US10Y", "CN10Y"): score[s] += .10\n        for s in ("BTC", "ETH", "WTI"): score[s] -= .07\n\n    invmean = np.mean([1 / vol.get(s, .02) for s in UNIVERSE])\n    raw = {s: max(score[s], .05) * (.78 + .22 * (1 / vol.get(s, .02)) / invmean) for s in UNIVERSE}\n    target = bounded_weights(raw)\n    mu = np.mean(list(score.values()))\n    sd = max(float(np.std(list(score.values()))), 1e-9)\n    forecast = {s: float(.01 * (score[s] - mu) / sd) for s in UNIVERSE}\n    rebalance_to_weights(target, forecast_returns=forecast,\n                         factor_ids=[x["factor_id"] for x in selected], horizon_days=10)\n    _last_decision = decision\n\n\nif __name__ == "__main__":\n    print([x["factor_id"] for x in load_ensemble()])\n', 'file_path': 'strategy.py'})
