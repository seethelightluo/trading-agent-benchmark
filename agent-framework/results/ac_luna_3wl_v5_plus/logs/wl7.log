  ▶️ write_file({'content': 'import json\nfrom pathlib import Path\nimport numpy as np\nfrom alphacrafter.sim.utils import register_hook, get_stock_daily_data, get_index_daily_data, rebalance_to_weights\n\nUNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]\nENSEMBLE = Path(__file__).parent / "factor_ensemble.json"\nlast_decision = None\n\n\ndef factors():\n    try:\n        return json.loads(ENSEMBLE.read_text(encoding="utf-8")).get("selected_factors", [])[:10]\n    except Exception:\n        return []\n\n\ndef ranks(x):\n    out = {s: .5 for s in UNIVERSE}\n    a = sorted((s, v) for s, v in x.items() if np.isfinite(v))\n    if not a:\n        return out\n    for i, (s, _) in enumerate(a):\n        out[s] = (i + .5) / len(a)\n    return out\n\n\ndef bounded(raw):\n    # Diversified 15-asset, fully invested portfolio: 2% floor and 14% cap.\n    w = {s: max(float(raw.get(s, 1 / 15)), 1e-9) for s in UNIVERSE}\n    for _ in range(80):\n        z = sum(w.values())\n        w = {s: v / z for s, v in w.items()}\n        low = [s for s in UNIVERSE if w[s] < .02]\n        high = [s for s in UNIVERSE if w[s] > .14]\n        if not low and not high:\n            break\n        fixed = set(low + high)\n        for s in low: w[s] = .02\n        for s in high: w[s] = .14\n        free = [s for s in UNIVERSE if s not in fixed]\n        rem = 1 - sum(w[s] for s in fixed)\n        if free and rem > 0:\n            scale = rem / sum(w[s] for s in free)\n            for s in free: w[s] *= scale\n    z = sum(w.values())\n    return {s: w[s] / z for s in UNIVERSE}\n\n\n@register_hook\ndef cross_asset_strategy():\n    global last_decision\n    fs = factors()\n    if not fs:\n        return\n    data, feature, vol = {}, {}, {}\n    for s in UNIVERSE:\n        d = get_stock_daily_data(symbol=s, days=210)\n        if d is None or len(d) < 80:\n            continue\n        c = np.asarray(d.sort_values("date")["close"], dtype=float)\n        if len(c) < 80 or not np.all(np.isfinite(c)) or np.any(c <= 0):\n            continue\n        # Deliberately use the last completed bar (-2), never the current bar.\n        r = c[1:] / c[:-1] - 1\n        r5, r20, r30, r40 = r[-6:-1], r[-21:-1], r[-31:-1], r[-41:-1]\n        m5 = c[-2] / c[-7] - 1\n        m20, m30 = c[-2] / c[-22] - 1, c[-2] / c[-32] - 1\n        v5, v20, v30 = max(np.std(r5), .008), max(np.std(r20), .008), max(np.std(r30), .008)\n        down = max(np.std(r20[r20 < 0]) if np.sum(r20 < 0) > 1 else .008, .008)\n        consistency = np.mean(r40 > 0)\n        efficiency = abs(np.sum(r20)) / max(np.sum(abs(r20)), .008)\n        recovery = (c[-2] / max(np.min(c[-42:-2]), 1e-12) - 1) / v20\n        feature[s] = {\n            "trend": consistency * m20 / v20,\n            "volstate": (m20 / v20) * np.clip(np.std(r40) / v20, .5, 2),\n            "downside": m20 / down,\n            "relative": m30 / v30,\n            "range": m20 / v20 * efficiency,\n            "dispersion": -m5 / v5,\n            "recovery": recovery,\n        }\n        vol[s] = v20\n        data[s] = c\n    if len(data) < 12:\n        return\n    stamp = str(max(d[-2] for d in [np.asarray(get_stock_daily_data(symbol=s, days=210).sort_values("date")["date"])[-1:] for s in data]))\n    # Use the actual latest visible date from one loaded series; decisions are 10-day gated.\n    stamp = str(get_stock_daily_data(symbol=next(iter(data)), days=210).sort_values("date").iloc[-1]["date"])\n    if last_decision is not None and (np.datetime64(stamp) - np.datetime64(last_decision)) / np.timedelta64(1, "D") < 10:\n        return\n    mapping = {\n        "trend_consistency_risk_adjusted": "trend",\n        "vol_state_momentum": "volstate",\n        "downside_risk_momentum": "downside",\n        "relative_momentum_30d_vol_scaled": "relative",\n        "range_efficiency_momentum": "range",\n        "dispersion_reversal": "dispersion",\n        "recovery_efficiency": "recovery",\n    }\n    score = {s: .5 for s in UNIVERSE}\n    for f in fs:\n        key = next((v for k, v in mapping.items() if k in f.get("factor_id", "")), None)\n        if key is None:\n            continue\n        rr = ranks({s: float(f.get("direction", 1)) * feature[s][key] for s in feature})\n        for s in UNIVERSE:\n            score[s] += float(f.get("weight", 0)) * (rr[s] - .5)\n    vix_ratio = 1.\n    vd = get_index_daily_data(symbol="VIX", days=65)\n    if vd is not None and len(vd) >= 32:\n        vc = np.asarray(vd.sort_values("date")["close"], dtype=float)\n        vix_ratio = max(1., vc[-2] / max(np.median(vc[-32:-2]), 1e-9))\n    spx = data.get("SPX")\n    riskoff = vix_ratio > 1.2 or (spx is not None and spx[-2] < spx[-22])\n    if riskoff:\n        for s in ("XAU", "US10Y", "CN10Y"): score[s] += .10\n        for s in ("BTC", "ETH", "WTI"): score[s] -= .07\n    inv = np.mean([1 / vol.get(s, .02) for s in UNIVERSE])\n    raw = {s: max(score[s], .05) * (.78 + .22 * (1 / vol.get(s, .02)) / inv) for s in UNIVERSE}\n    target = bounded(raw)\n    mu, sd = np.mean(list(score.values())), max(np.std(list(score.values())), 1e-9)\n    forecast = {s: float(.01 * (score[s] - mu) / sd) for s in UNIVERSE}\n    rebalance_to_weights(target, forecast_returns=forecast, factor_ids=[f["factor_id"] for f in fs], horizon_days=10)\n    last_decision = stamp\n', 'file_path': 'strategy.py'})
