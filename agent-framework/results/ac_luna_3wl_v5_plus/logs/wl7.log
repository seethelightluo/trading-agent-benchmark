s=1).dropna()\n      if len(z)>=8: vals.append(z.iloc[:,0].corr(z.iloc[:,1],method='spearman'))\n    print('REG',name,len(vals),np.nanmean(vals))\n# artifact exact factor values\nout=factor.reset_index().melt(id_vars='date',var_name='symbol',value_name='signal').dropna()\nout.to_csv('scripts/miner_3_20270324_volshock_reversal_signal.csv',index=False)\n", 'file_path': 'scripts/miner_3_20270324_volshock_reversal.py'})
