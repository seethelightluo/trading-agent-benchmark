 import json
from pathlib import Path
import numpy as np
from alphacrafter.sim.utils import register_hook, get_stock_daily_data, get_index_daily_data, rebalance_to_weights

UNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
ENSEMBLE_PATH = Path(__file__).parent / "factor_ensemble.json"
_last_decision = None

def ensemble():
    try:
        return json.loads(ENSEMBLE_PATH.read_text(encoding="utf-8")).get("selected_factors", [])[:10]
    except Exception:
        return []

def rank(x):
    good = sorted((s, v) for s, v in x.items() if np.isfinite(v))
    out = {s: .5 for s in UNIVERSE}
    for i, (s, _) in enumerate(good): out[s] = (i + 1) / max(len(good), 1)
    return out

def weights(raw):
    w = {s: max(float(raw.get(s, 0)), 0) for s in UNIVERSE}
    z = sum(w.values()) or 1
    w = {s: v / z for s, v in w.items()}
    # Keep a diversified, fully invested 15-asset portfolio.
    for _ in range(20):
        low = [s for s in UNIVERSE if w[s] < .02]
        high = [s for s in UNIVERSE if w[s] > .14]
        if not low and not high: break
        for s in low: w[s] = .02
        for s in high: w[s] = .14
        fixed = set(low + high); free = [s for s in UNIVERSE if s not in fixed]
        rem = 1 - sum(w[s] for s in fixed); base = sum(w[s] for s in free) or 1
        for s in free: w[s] *= rem / base
    z = sum(w.values())
    return {s: w[s] / z for s in UNIVERSE}

@register_hook
def cross_asset_strategy():
    global _last_decision
    selected = ensemble()
    if not selected: return
    specs = {f["factor_id"]: (float(f["weight"]), int(f.get("direction", 1))) for f in selected}
    data, vol = {}, {}
    for s in UNIVERSE:
        df = get_stock_daily_data(symbol=s, days=150)
        if df is None or len(df) < 75: continue
        c = np.asarray(df.sort_values("date")["close"], dtype=float)
        r = c[1:] / np.maximum(c[:-1], 1e-12) - 1
        data[s] = (c, r, str(df.iloc[-1]["date"]))
        vol[s] = max(float(np.std(r[-21:-1])), .008)
    if len(data) < 12: return
    decision = max(v[2] for v in data.values())
    if _last_decision is not None and (np.datetime64(decision)-np.datetime64(_last_decision))/np.timedelta64(1,'D') < 10: return
    vix = get_index_daily_data(symbol="VIX", days=80)
    vix_high = False
    if vix is not None and len(vix) >= 30:
        vc = np.asarray(vix.sort_values("date")["close"], float)
        vix_high = vc[-2] > 1.2 * np.median(vc[-31:-1])
    vals = {f: {} for f in specs}
    for s, (c, r, _) in data.items():
        p, rr = c[:-1], r[:-1]
        tr = rr[-21:]; v = max(float(np.std(tr)), .008)
        r5 = p[-1]/p[-6]-1; r10 = p[-1]/p[-11]-1; r20 = p[-1]/p[-21]-1; r30 = p[-1]/p[-31]-1
        breadth = np.mean(tr > 0)
        dispersion = np.std([r20])  # replaced below by cross-section-neutral proxy
        common = {"momentum": r20/v, "breadth": r20/v*(.5+breadth),
                  "consistency": r20/v*(.5+breadth),
                  "efficiency": r20/max(float(np.sum(np.abs(tr))), .02),
                  "reversal": -r5/max(float(np.std(rr[-5:])), .008),
                  "volstate": r20/v*(.75 if vix_high else 1.0)}
        for f in specs:
            if "signed_breadth" in f: x = common["breadth"]
            elif "dispersion_conditioned" in f: x = common["momentum"]
            elif "conditioned_momentum" in f: x = common["consistency"]
            elif "vol_state" in f: x = common["volstate"]
            elif "trend_consistency" in f or "persistent_trend" in f: x = common["consistency"]
            elif "range_efficiency" in f: x = common["efficiency"]
            elif "asymmetric_volatility_reversal" in f: x = common["reversal"]
            else: x = common["momentum"]
            vals[f][s] = x
    score = {s: .5 for s in UNIVERSE}
    for f, (wt, direction) in specs.items():
        q = rank({s: direction*x for s,x in vals[f].items()})
        for s in UNIVERSE: score[s] += wt*(q[s]-.5)
    spx = data.get("SPX")
    risk_off = vix_high or (spx is not None and (spx[0][-2] < spx[0][-22] or np.mean(spx[1][-6:-1]) < 0))
    if risk_off:
        for s in ("XAU", "US10Y", "CN10Y"): score[s] += .10
        for s in ("BTC", "ETH", "WTI"): score[s] -= .06
    inv = {s: 1/max(vol.get(s,.02),.008) for s in UNIVERSE}; mean_inv = np.mean(list(inv.values()))
    raw = {s: max(score[s], .02)*(.78+.22*inv[s]/mean_inv) for s in UNIVERSE}
    w = weights(raw)
    mean, st = np.mean(list(score.values())), max(float(np.std(list(score.values()))), 1e-12)
    forecast = {s: float(.01*(score[s]-mean)/st) for s in UNIVERSE}
    rebalance_to_weights(w, forecast_returns=forecast, factor_ids=list(specs), horizon_days=10)
    _last_decision = decision


