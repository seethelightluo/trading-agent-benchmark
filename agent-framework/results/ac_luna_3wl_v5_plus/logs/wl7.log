  ▶️ write_file({'content': 'import json\nfrom pathlib import Path\nimport numpy as np\nfrom alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights\n\nUNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]\nENSEMBLE_PATH = Path(__file__).parent / "factors" / "factor_ensemble.json"\nREBALANCE_DAYS = 10\nMIN_WEIGHT, MAX_WEIGHT = 0.015, 0.16\n_last_decision = None\n\n\ndef rank_cs(values, direction=1):\n    valid = sorted((s, direction * float(v)) for s, v in values.items() if np.isfinite(v))\n    out = {s: 0.5 for s in UNIVERSE}\n    for i, (s, _) in enumerate(valid):\n        out[s] = (i + 1.0) / max(len(valid), 1)\n    return out\n\n\ndef boxed_weights(raw):\n    w = {s: max(float(raw.get(s, 0.01)), 1e-12) for s in UNIVERSE}\n    fixed = set()\n    for _ in range(50):\n        free = [s for s in UNIVERSE if s not in fixed]\n        scale = (1.0 - sum(w[s] for s in fixed)) / max(sum(w[s] for s in free), 1e-12)\n        changed = False\n        for s in free:\n            w[s] *= scale\n            if w[s] < MIN_WEIGHT:\n                w[s] = MIN_WEIGHT; fixed.add(s); changed = True\n            elif w[s] > MAX_WEIGHT:\n                w[s] = MAX_WEIGHT; fixed.add(s); changed = True\n        if not changed:\n            break\n    total = sum(w.values())\n    return {s: w[s] / total for s in UNIVERSE}\n\n\ndef load_ensemble():\n    try:\n        obj = json.loads(ENSEMBLE_PATH.read_text(encoding="utf-8"))\n        selected = [x for x in obj.get("selected_factors", [])\n                    if isinstance(x, dict) and x.get("factor_id")][:10]\n        weights = {x["factor_id"]: float(x.get("weight", 0.0)) for x in selected}\n        directions = {x["factor_id"]: int(x.get("direction", 1)) for x in selected}\n        return selected, weights, directions\n    except (OSError, ValueError, TypeError, KeyError):\n        return [], {}, {}\n\n\n@register_hook\ndef cross_asset_strategy():\n    global _last_decision\n    selected, factor_weights, directions = load_ensemble()\n    if not selected:\n        return\n    data = {}\n    for s in UNIVERSE:\n        df = get_stock_daily_data(symbol=s, days=90)\n        if df is None or len(df) < 25:\n            continue\n        df = df.sort_values("date").reset_index(drop=True)\n        c = np.asarray(df.close, dtype=float)\n        h = np.asarray(df.high, dtype=float)\n        l = np.asarray(df.low, dtype=float)\n        r = c[1:] / np.maximum(c[:-1], 1e-12) - 1.0\n        data[s] = (c, h, l, r, str(df.iloc[-1].date))\n    if len(data) < 12:\n        return\n    decision = max(v[4] for v in data.values())\n    if _last_decision is not None:\n        try:\n            if (np.datetime64(decision) - np.datetime64(_last_decision)) / np.timedelta64(1, "D") < REBALANCE_DAYS:\n                return\n        except Exception:\n            return\n\n    clv, peer, reversal, momentum, invvol, ret5 = {}, {}, {}, {}, {}, {}\n    for s, (c, h, l, r, _) in data.items():\n        vol = max(float(np.std(r[-20:])), 0.008)\n        clv[s] = float(np.mean((2*c[-3:] - h[-3:] - l[-3:]) / np.maximum(h[-3:] - l[-3:], 1e-12)))\n        reversal[s] = -float(np.mean(r[-5:]))\n        momentum[s] = float((c[-1] / max(c[-21], 1e-12) - 1.0) / (vol + 0.01))\n        invvol[s] = 1.0 / vol\n        ret5[s] = float(c[-1] / max(c[-6], 1e-12) - 1.0)\n    med = float(np.median(list(ret5.values())))\n    peer = {s: v - med for s, v in ret5.items()}\n    raw_factor = {\n        "miner_3_20260716_clv_1d": clv,\n        "miner_1_20260716_peer_median_leadlag_5d": peer,\n        "short_term_reversal_5d": reversal,\n        "miner_2_20260716_risk_adjusted_momentum_20d": momentum,\n    }\n    ranks = {fid: rank_cs(raw_factor.get(fid, {}), directions.get(fid, 1)) for fid in factor_weights}\n    score = {s: sum(factor_weights[fid] * ranks[fid].get(s, 0.5) for fid in factor_weights) for s in UNIVERSE}\n\n    # Medium-high risk / mildly bearish regime: remain fully invested but favor\n    # defensive tradable benchmarks and reduce the most volatile risk assets.\n    if "SPX" in data:\n        spx = data["SPX"][0]\n        if spx[-1] < spx[-21] or spx[-1] < spx[-6]:\n            for s in ("XAU", "US10Y", "CN10Y"):\n                score[s] += 0.14\n            for s in ("BTC", "ETH", "WTI"):\n                score[s] = max(0.05, score[s] - 0.08)\n    avg_iv = float(np.mean(list(invvol.values())))\n    raw = {s: max(score[s], 0.01) * (0.78 + 0.22 * invvol.get(s, avg_iv) / max(avg_iv, 1e-12)) for s in UNIVERSE}\n    weights = boxed_weights(raw)\n    mu = float(np.mean(list(score.values())))\n    sd = max(float(np.std(list(score.values()))), 1e-12)\n    forecast_returns = {s: float(0.01 * (score[s] - mu) / sd) for s in UNIVERSE}\n    rebalance_to_weights(weights, forecast_returns=forecast_returns,\n                         factor_ids=[x["factor_id"] for x in selected], horizon_days=10)\n    _last_decision = decision\n', 'file_path': 'strategy.py'})
