 import json
from pathlib import Path
import numpy as np
from alphacrafter.sim.utils import register_hook, get_stock_daily_data, get_index_daily_data, rebalance_to_weights

UNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
ENSEMBLE = Path(__file__).parent / "factor_ensemble.json"
last_decision = None

def load_factors():
    try:
        return json.loads(ENSEMBLE.read_text(encoding="utf-8")).get("selected_factors", [])[:10]
    except Exception:
        return []

def percentile(values):
    out = {s: .5 for s in UNIVERSE}
    good = [(s, float(v)) for s, v in values.items() if np.isfinite(v)]
    if not good: return out
    good.sort(key=lambda x: x[1])
    for i, (s, _) in enumerate(good): out[s] = (i + .5) / len(good)
    return out

def cap_weights(raw):
    w = {s: max(float(raw.get(s, 1/15)), 1e-8) for s in UNIVERSE}
    for _ in range(20):
        total = sum(w.values()); w = {s: v/total for s,v in w.items()}
        low = {s for s in UNIVERSE if w[s] < .02}; high = {s for s in UNIVERSE if w[s] > .14}
        if not low and not high: break
        fixed = low | high
        for s in low: w[s] = .02
        for s in high: w[s] = .14
        free = [s for s in UNIVERSE if s not in fixed]
        rem = 1 - sum(w[s] for s in fixed)
        if free and rem > 0:
            scale = rem / sum(w[s] for s in free)
            for s in free: w[s] *= scale
    total = sum(w.values())
    return {s: w[s]/total for s in UNIVERSE}

@register_hook
def cross_asset_strategy():
    global last_decision
    fs = load_factors()
    if not fs: return
    series, vol = {}, {}
    for s in UNIVERSE:
        d = get_stock_daily_data(symbol=s, days=190)
        if d is None or len(d) < 80: continue
        c = np.asarray(d.sort_values("date")["close"], dtype=float)
        if np.all(np.isfinite(c)) and np.all(c > 0):
            series[s] = c
            ret = c[1:] / c[:-1] - 1
            vol[s] = max(float(np.std(ret[-26:-1])), .008)
    if len(series) < 12: return
    stamp = max(str(get_stock_daily_data(symbol=s, days=190).sort_values("date").iloc[-1]["date"]) for s in series)
    if last_decision is not None and (np.datetime64(stamp)-np.datetime64(last_decision))/np.timedelta64(1,"D") < 10: return
    median20 = np.median([series[s][-2]/series[s][-22]-1 for s in series])
    rawsignals = {}
    for s,c in series.items():
        r = c[1:]/c[:-1]-1; r5=r[-6:-1]; r20=r[-21:-1]; r40=r[-41:-1]
        v5=max(float(np.std(r5)),.008); v20=max(float(np.std(r20)),.008)
        m5=c[-2]/c[-7]-1; m20=c[-2]/c[-22]-1
        downside=max(float(np.std(r20[r20<0])) if np.sum(r20<0)>1 else .008,.008)
        consistency=float(np.mean(r40>0)); efficiency=abs(np.mean(r20))/max(np.mean(abs(r20)),.008)
        volstate=min(2.,max(.5,float(np.std(r40))/v20))
        # All calculations use lagged completed observations; reversal is a controlled sleeve.
        rawsignals[s] = {
          "signed_breadth": consistency*m20/v20, "dispersion_conditioned": (m20-median20)/v20,
          "conditioned": m20/v20, "vol_state": m20/v20*volstate,
          "trend_consistency": consistency*m20/v20, "persistent": consistency*(c[-2]/c[-42]-1)/v20,
          "range_efficiency": m20/v20*efficiency, "asymmetric_reversal": -m5/v5
        }
    keymap = {"signed_breadth_momentum":"signed_breadth", "dispersion_conditioned_momentum":"dispersion_conditioned", "conditioned_momentum":"conditioned", "vol_state_momentum":"vol_state", "trend_consistency_risk_adjusted":"trend_consistency", "persistent_trend_quality":"persistent", "range_efficiency_momentum":"range_efficiency", "asymmetric_volatility_reversal":"asymmetric_reversal"}
    score={s:.5 for s in UNIVERSE}
    for f in fs:
        key=next((v for k,v in keymap.items() if k in f.get("factor_id","")),None)
        if key is None: continue
        rr=percentile({s:f.get("direction",1)*rawsignals[s][key] for s in rawsignals})
        for s in UNIVERSE: score[s]+=float(f.get("weight",0))*(rr[s]-.5)
    vix=get_index_daily_data(symbol="VIX",days=65); stress=False
    if vix is not None and len(vix)>=32:
        vc=np.asarray(vix.sort_values("date")["close"],dtype=float); stress=vc[-2]>1.2*np.median(vc[-32:-2])
    spx=series.get("SPX"); riskoff=stress or (spx is not None and spx[-2]<spx[-22])
    if riskoff:
        for s in ("XAU","US10Y","CN10Y"): score[s]+=.10
        for s in ("BTC","ETH","WTI"): score[s]-=.07
    invmean=np.mean([1/vol.get(s,.02) for s in UNIVERSE])
    raw={s:max(score[s],.05)*(.78+.22*(1/vol.get(s,.02))/invmean) for s in UNIVERSE}
    target=cap_weights(raw); mean=np.mean(list(score.values())); sd=max(float(np.std(list(score.values()))),1e-9)
    forecast={s:float(.01*(score[s]-mean)/sd) for s in UNIVERSE}
    rebalance_to_weights(target, forecast_returns=forecast, factor_ids=[f["factor_id"] for f in fs], horizon_days=10)
    last_decision=stamp


