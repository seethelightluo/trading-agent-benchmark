ot selected:\n        return\n    specs = {x["factor_id"]: (float(x["weight"]), int(x.get("direction", 1))) for x in selected}\n    data = {}\n    for s in UNIVERSE:\n        df = get_stock_daily_data(symbol=s, days=130)\n        if df is None or len(df) < 65:\n            continue\n        df = df.sort_values("date").reset_index(drop=True)\n        c = np.asarray(df["close"], dtype=float)\n        r = c[1:] / np.maximum(c[:-1], 1e-12) - 1.0\n        data[s] = (c, r, str(df.iloc[-1]["date"]))\n    if len(data) < 12:\n        return\n    date = max(v[2] for v in data.values())\n    if _last_date is not None and (np.datetime64(date) - np.datetime64(_last_date)) / np.timedelta64(1, "D") < 10:\n        return\n\n    vals = {fid: {} for fid in specs}\n    vol = {}\n    for s, (c, r, _) in data.items():\n        v = max(float(np.std(r[-20:])), .008)\n        down = max(float(np.sqrt(np.mean(np.minimum(r[-20:], 0.0) ** 2))), .003)\n        ret1 = float(r[-1]); ret2 = float(c[-1] / c[-3] - 1.0)\n        ret5 = float(c[-1] / c[-6] - 1.0); ret20 = float(c[-1] / c[-21] - 1.0)\n        ret60 = float(c[-1] / c[-61] - 1.0)\n        efficiency = ret20 / max(float(np.sum(np.abs(r[-20:]))), 1e-12)\n        breadth = float(np.mean(r[-20:] > 0))\n        # Each implementation is lagged to the last completed daily bar.\n        features = {\n            "miner_2_20260827_range_efficiency_momentum": efficiency,\n            "miner_3_20261102_conditioned_momentum": (ret20 / v) * (1.0 + .8 * np.sign(ret60) * (breadth - .5)),\n            "downside_risk_adjusted_trend_20d": ret20 / down,\n            "miner_2_risk_adjusted_momentum_20d": ret20 / v,\n            "miner_3_clv_1d": float((2.0 * (c[-1] - c[-2]) / max(abs(c[-1]), 1e-12)) / v),\n            "peer_median_leadlag_5d": ret5 - float(np.median([float(x[0][-1] / x[0][-6] - 1.0) for x in data.values()])),\n            "miner_3_20261130_asymmetric_volatility_reversal_2d_revalidated": -ret2 / v,\n        }\n        vol[s] = v\n        for fid in specs:\n            if fid in features: vals[fid][s] = features[fid]\n\n    score = {s: 0.5 for s in UNIVERSE}\n    for fid, (weight, direction) in specs.items():\n        rr = cross_rank({s: direction * v for s, v in vals[fid].items()})\n        for s in UNIVERSE: score[s] += weight * (rr[s] - .5)\n\n    # Moderate-high risk / consolidation: modest defensive tilt, never cash.\n    spx = data.get("SPX")\n    risk_off = bool(spx and (spx[0][-1] < spx[0][-21] or np.mean(spx[1][-5:]) < 0))\n    if risk_off:\n        for s in ("XAU", "US10Y", "CN10Y"): score[s] += .10\n        for s in ("BTC", "ETH", "WTI"): score[s] -= .06\n\n    inv = {s: 1.0 / vol.get(s, .02) for s in UNIVERSE}\n    avg_inv = float(np.mean(list(inv.values())))\n    raw = {s: max(score[s], .02) * (.78 + .22 * inv[s] / max(avg_inv, 1e-12)) for s in UNIVERSE}\n    weights = bounded(raw)\n    mean = float(np.mean(list(score.values())))\n    sd = max(float(np.std(list(score.values()))), 1e-12)\n    forecast = {s: float(.01 * (score[s] - mean) / sd) for s in UNIVERSE}\n    rebalance_to_weights(weights, forecast_returns=forecast,\n                         factor_ids=[x["factor_id"] for x in selected], horizon_days=10)\n    _last_date = date\n\n\nif __name__ == "__main__":\n    cross_asset_strategy()\n', 'file_path': 'strategy.py'})
