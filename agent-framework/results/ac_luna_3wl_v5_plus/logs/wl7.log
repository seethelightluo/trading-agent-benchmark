e(series[a].loc[dt,'s'])})\n ranks=vals.rank(pct=True)\n if prev is not None:\n  common=ranks.index.intersection(prev.index)\n  if len(common)>=8: turns.append(np.mean(np.abs(ranks[common]-prev[common])))\n prev=ranks\nprint('turnover',np.mean(turns), 'nturn',len(turns))\nr.to_csv('scripts/miner_1_20270224_clv_persistence_signal.csv')\n", 'file_path': 'scripts/miner_1_20270224_clv_persistence.py'})
