  ▶️ write_file({'content': "import numpy as np, pandas as pd\nfrom alphacrafter.sim.utils import get_index_daily_data\nU=['000300.SH','SPX','HSI','N225','SX5E','000688.SH','SOX','NDX','XAU','COPPER','WTI','BTC','ETH','US10Y','CN10Y']\nD={}\nfor s in U:\n    x=get_index_daily_data(s, days=1900)\n    if x is not None and len(x):\n        x=x.copy(); x['date']=pd.to_datetime(x['date']); x=x.set_index('date').sort_index(); D[s]=x['close'].astype(float)\np=pd.DataFrame(D).sort_index().ffill()\n# persistence-adjusted momentum: directional 15d move, discounted by path choppiness and recent volatility\nr=p.pct_change()\nfac=(p/p.shift(15)-1)/(r.abs().rolling(20).sum()+1e-8)\nrows=[]\nfor d in p.index:\n    if d not in fac.index: continue\n    f=fac.loc[d]; fw=p.shift(-5).loc[d]/p.loc[d]-1\n    z=pd.concat([f,fw],axis=1).dropna()\n    if len(z)>=8: rows.append((d,z.iloc[:,0].corr(z.iloc[:,1]),len(z)))\nq=pd.DataFrame(rows,columns=['date','ic','n']).set_index('date')\nq=q.replace([np.inf,-np.inf],np.nan).dropna()\nprint('dates',len(q),'mean_n',q.n.mean(),'coverage',p.notna().mean().mean())\nprint('IC %.6f ICIR %.6f hit %.4f'%(q.ic.mean(),q.ic.mean()/q.ic.std(ddof=1), (q.ic>0).mean()))\nfor h in [1,5,10,20]:\n rr=[]\n for d in fac.index:\n  z=pd.concat([fac.loc[d],p.shift(-h).loc[d]/p.loc[d]-1],axis=1).dropna()\n  if len(z)>=8: rr.append(z.iloc[:,0].corr(z.iloc[:,1]))\n print('decay',h,np.nanmean(rr),len(rr))\n# turnover rank changes daily\nrank=fac.rank(pct=True,axis=1); turn=(rank.diff().abs().mean(axis=1)).dropna()\nprint('turnover',turn.mean())\nprint('period',q.index.min(),q.index.max())\n", 'file_path': 'scripts/miner_2_20270212_path_persistence_momentum.py'})
