 import json
from pathlib import Path
import numpy as np
from alphacrafter.sim.utils import (register_hook, get_stock_daily_data,
    get_index_daily_data, rebalance_to_weights)

UNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
ENSEMBLE_PATH = Path(__file__).parent / "factors" / "factor_ensemble.json"
_last_decision = None


def ensemble():
    try:
        return json.loads(ENSEMBLE_PATH.read_text(encoding="utf-8")).get("selected_factors", [])[:10]
    except Exception:
        return []


def ranks(values):
    out = {s: 0.5 for s in UNIVERSE}
    good = sorted((s, v) for s, v in values.items() if np.isfinite(v))
    for i, (s, _) in enumerate(good):
        out[s] = (i + 0.5) / len(good)
    return out


def project(raw):
    # Full-investment long-only box: diversified in a 15-asset universe.
    w = {s: max(float(raw.get(s, 0.0)), 1e-9) for s in UNIVERSE}
    for _ in range(50):
        z = sum(w.values())
        w = {s: v / z for s, v in w.items()}
        low = {s for s in UNIVERSE if w[s] < 0.02}
        high = {s for s in UNIVERSE if w[s] > 0.13}
        if not low and not high:
            break
        fixed = low | high
        for s in low: w[s] = 0.02
        for s in high: w[s] = 0.13
        free = [s for s in UNIVERSE if s not in fixed]
        rem = 1.0 - sum(w[s] for s in fixed)
        total = sum(w[s] for s in free) or 1.0
        for s in free: w[s] *= rem / total
    z = sum(w.values())
    return {s: w[s] / z for s in UNIVERSE}


@register_hook
def cross_asset_strategy():
    global _last_decision
    selected = ensemble()
    if not selected:
        return
    specs = [(x["factor_id"], float(x["weight"]), int(x.get("direction", 1))) for x in selected]
    closes, returns, vols = {}, {}, {}
    dates = []
    for s in UNIVERSE:
        d = get_stock_daily_data(symbol=s, days=180)
        if d is None or len(d) < 75:
            continue
        d = d.sort_values("date")
        c = np.asarray(d["close"], dtype=float)
        if np.all(np.isfinite(c)) and np.all(c > 0):
            closes[s] = c
            returns[s] = c[1:] / c[:-1] - 1.0
            vols[s] = max(float(np.std(returns[s][-23:-1])), 0.008)
            dates.append(d.iloc[-1]["date"])
    if len(closes) < 12:
        return
    decision = str(max(dates))
    if _last_decision is not None:
        try:
            if (np.datetime64(decision) - np.datetime64(_last_decision)) / np.timedelta64(1, "D") < 10:
                return
        except Exception:
            return

    feat = {}
    for s, c in closes.items():
        # Exclude the most recent completed bar from predictors (one-bar lag).
        p, r = c[:-1], returns[s][:-1]
        q = r[-20:]
        v20 = max(float(np.std(q)), 0.008)
        down = max(float(np.std(q[q < 0])) if np.any(q < 0) else 0.008, 0.008)
        r5 = p[-1] / p[-6] - 1.0
        r10 = p[-1] / p[-11] - 1.0
        r15 = p[-1] / p[-16] - 1.0
        r20 = p[-1] / p[-21] - 1.0
        breadth = float(np.mean(q > 0))
        path = max(float(np.sum(np.abs(q))), 0.02)
        feat[s] = {
            "stress_reversal": -r10 / v20,
            "dispersion_reversal": -r5 / v20,
            "asym_reversal": -r5 / down,
            "downside": r20 / down,
            "consistency": breadth * (0.5 + r20 / v20),
            "breakout": r15 / v20,
            "breadth": breadth * (0.5 + r20 / v20),
            "volstate": r20 / v20,
            "range": r20 / path,
        }
    score = {s: 0.5 for s in UNIVERSE}
    for fid, wt, direction in specs:
        if "vix_stress_reversal" in fid: key = "stress_reversal"
        elif "dispersion_reversal" in fid: key = "dispersion_reversal"
        elif "asymmetric_volatility_reversal" in fid: key = "asym_reversal"
        elif "downside_risk_adjusted" in fid: key = "downside"
        elif "trend_consistency" in fid: key = "consistency"
        elif "compressed_breakout" in fid: key = "breakout"
        elif "signed_breadth" in fid: key = "breadth"
        elif "vol_state" in fid: key = "volstate"
        else: continue
        rr = ranks({s: direction * feat[s][key] for s in feat})
        for s in UNIVERSE:
            score[s] += wt * (rr[s] - 0.5)

    # Transition regime: defensive tradable assets replace a cash sleeve.
    vix = get_index_daily_data(symbol="VIX", days=65)
    high_vix = False
    if vix is not None and len(vix) >= 32:
        vc = np.asarray(vix.sort_values("date")["close"], dtype=float)
        high_vix = bool(vc[-2] > 1.2 * np.median(vc[-32:-2]))
    spx = closes.get("SPX")
    risk_off = high_vix or (spx is not None and (spx[-2] < spx[-22] or np.mean(returns["SPX"][-7:-2]) < 0))
    if risk_off:
        for s in ("XAU", "US10Y", "CN10Y"): score[s] += 0.10
        for s in ("BTC", "ETH", "WTI"): score[s] -= 0.07

    avg_inv = np.mean([1.0 / vols.get(s, 0.02) for s in UNIVERSE])
    raw = {s: max(score[s], 0.05) * (0.78 + 0.22 * (1.0 / vols.get(s, 0.02)) / avg_inv) for s in UNIVERSE}
    target = project(raw)
    mean, sd = np.mean(list(score.values())), max(float(np.std(list(score.values()))), 1e-9)
    forecast = {s: float(0.01 * (score[s] - mean) / sd) for s in UNIVERSE}
    rebalance_to_weights(target, forecast_returns=forecast,
                         factor_ids=[x[0] for x in specs], horizon_days=10)
    _last_decision = decision


factor_ensemble = ensemble

if __name__ == "__main__":
