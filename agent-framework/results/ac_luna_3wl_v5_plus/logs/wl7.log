  ▶️ write_file({'content': "import numpy as np, pandas as pd\nfrom alphacrafter.sim.utils import get_index_daily_data\n\nU=['000300.SH','SPX','HSI','N225','SX5E','000688.SH','SOX','NDX','XAU','COPPER','WTI','BTC','ETH','US10Y','CN10Y']\n# Trend-quality momentum: medium horizon return, scaled by vol, rewarded for consistency; all inputs lagged.\npx={}\nfor s in U:\n    d=get_index_daily_data(s, days=2600)\n    if d is not None and len(d):\n        x=d[['date','close']].copy(); x['date']=pd.to_datetime(x.date); px[s]=x.set_index('date').close.astype(float)\np=pd.DataFrame(px).sort_index()\nr=p.pct_change()\n# signal at date t uses t-1 information; forward return from t through t+h-1\nmom=r.rolling(20,min_periods=15).sum()\nvol=r.rolling(20,min_periods=15).std()\ncons=(r>0).rolling(20,min_periods=15).mean()\n# cross-asset breadth (lagged), conditional trend quality rather than market timing\nbreadth=(mom>0).mean(axis=1)\nsig=(mom/vol.replace(0,np.nan))*(0.5+cons)\n# make breadth confirmation: positive trend signal enhanced when breadth > half, negative weakened when breadth low\nsig=sig*(0.75+0.5*(breadth-0.5))\nsig=sig.shift(1)\nrows=[]\nfor h in [1,5,10,20]:\n    # close t-1 to close t+h-1, signal at t\n    fwd=p.shift(-(h-1))/p-1\n    vals=[]\n    for dt in sig.index:\n        a=sig.loc[dt]; b=fwd.loc[dt]\n        z=pd.concat([a,b],axis=1).dropna()\n        if len(z)>=8:\n            vals.append((dt,z.iloc[:,0].corr(z.iloc[:,1]),len(z)))\n    q=pd.DataFrame(vals,columns=['date','ic','n']).dropna()\n    mean=q.ic.mean(); sd=q.ic.std(ddof=1); icir=mean/sd*np.sqrt(252) if sd else np.nan\n    print(f'h={h} dates={len(q)} avg_n={q.n.mean():.2f} IC={mean:.6f} ICIR={icir:.6f} hit={(q.ic>0).mean():.4f}')\n    if h==1:\n        # rank turnover using consecutive valid rank vectors\n        rr=sig.rank(axis=1,pct=True); to=(rr.diff().abs().mean(axis=1)).dropna().mean()\n        print(f'coverage={sig.notna().mean().mean():.4f} rank_turnover={to:.4f} start={q.date.min().date()} end={q.date.max().date()}')\n    q['year']=q.date.dt.year\n    print('regimes',q.groupby(pd.cut(q.year,[2019,2022,2024,2026,2030])).ic.agg(['mean','count']).round(5).to_dict('index'))\n", 'file_path': 'scripts/miner_1_20261130_trend_quality.py'})

