 import json
from pathlib import Path
import numpy as np
from alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights

UNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
ENSEMBLE_PATH = Path(__file__).parent / "factors" / "factor_ensemble.json"
_last_date = None


def ensemble():
    try:
        x = json.loads(ENSEMBLE_PATH.read_text(encoding="utf-8"))
        return x.get("selected_factors", [])[:10]
    except Exception:
        return []


def ranks(x):
    out = {s: .5 for s in UNIVERSE}
    a = sorted((s, float(v)) for s, v in x.items() if np.isfinite(v))
    for i, (s, _) in enumerate(a):
        out[s] = (i + 1) / max(len(a), 1)
    return out


def bounded(raw):
    lo, hi = .02, .14
    w = {s: max(float(raw.get(s, lo)), 1e-12) for s in UNIVERSE}
    for _ in range(100):
        fixed = {s: min(max(w[s], lo), hi) for s in UNIVERSE}
        free = [s for s in UNIVERSE if lo < w[s] < hi]
        rem = 1.0 - sum(fixed[s] for s in UNIVERSE if s not in free)
        scale = rem / max(sum(w[s] for s in free), 1e-12)
        nw = dict(fixed)
        for s in free:
            nw[s] = w[s] * scale
        if max(abs(nw[s] - w[s]) for s in UNIVERSE) < 1e-11:
            w = nw
            break
        w = nw
    z = sum(w.values())
    return {s: float(w[s] / z) for s in UNIVERSE}


@register_hook
def cross_asset_strategy():
    global _last_date
    selected = ensemble()
    if not selected:
        return
    specs = {x["factor_id"]: (float(x["weight"]), int(x.get("direction", 1))) for x in selected}
    data = {}
    for s in UNIVERSE:
        df = get_stock_daily_data(symbol=s, days=130)
        if df is None or len(df) < 65:
            continue
        df = df.sort_values("date").reset_index(drop=True)
        c = np.asarray(df["close"], float)
        r = c[1:] / np.maximum(c[:-1], 1e-12) - 1.0
        data[s] = (c, r, str(df.iloc[-1]["date"]))
    if len(data) < 12:
        return
    date = max(v[2] for v in data.values())
    if _last_date is not None and (np.datetime64(date) - np.datetime64(_last_date)) / np.timedelta64(1, "D") < 10:
        return

    raw_factors = {fid: {} for fid in specs}
    ret3 = {}
    for s, (c, r, _) in data.items():
        vol = max(float(np.std(r[-20:])), .008)
        down = max(float(np.sqrt(np.mean(np.minimum(r[-20:], 0.0) ** 2))), .003)
        ret1 = float(r[-1]); ret2 = float(c[-1] / c[-3] - 1); ret3[s] = float(c[-1] / c[-4] - 1)
        ret5 = float(c[-1] / c[-6] - 1); ret20 = float(c[-1] / c[-21] - 1); ret60 = float(c[-1] / c[-61] - 1)
        efficiency = ret20 / max(float(np.sum(np.abs(r[-20:]))), 1e-12)
        breadth = float(np.mean(r[-20:] > 0))
        features = {
            "miner_2_20260827_range_efficiency_momentum": efficiency,
            "miner_3_20261102_conditioned_momentum": (ret20 / vol) * (1.0 + .8 * np.sign(ret60) * (breadth - .5)),
            "miner_2_20261102_downside_risk_adjusted_trend_20d": ret20 / down,
            "miner_3_20261008_asymmetric_volatility_reversal_2d": -ret2 / vol,
            "miner_3_20261022_smoothed_range_reversal_1d": -(.7 * ret1 + .3 * float(r[-2])) / vol,
            "miner_2_20261008_residual_short_reversal_3d": -ret3[s] / vol,
        }
        for fid in specs:
            if fid in features:
                raw_factors[fid][s] = features[fid]

    score = {s: .5 for s in UNIVERSE}
    for fid, (weight, direction) in specs.items():
        rr = ranks({s: direction * v for s, v in raw_factors.get(fid, {}).items()})
        for s in UNIVERSE:
            score[s] += weight * (rr[s] - .5)

    spx = data.get("SPX")
    risk_off = bool(spx and (spx[0][-1] < spx[0][-21] or np.mean(spx[1][-5:]) < 0))
    if risk_off:
        for s in ("XAU", "US10Y", "CN10Y"):
            score[s] += .10
        for s in ("BTC", "ETH", "WTI"):
            score[s] -= .06

    inv = {s: 1.0 / max(float(np.std(data[s][1][-20:])), .008) for s in data}
    avg = float(np.mean(list(inv.values())))
    raw = {s: max(score[s], .02) * (.78 + .22 * inv.get(s, avg) / max(avg, 1e-12)) for s in UNIVERSE}
    weights = bounded(raw)
    mean = float(np.mean(list(score.values())))
    sd = max(float(np.std(list(score.values()))), 1e-12)
    forecast = {s: float(.01 * (score[s] - mean) / sd) for s in UNIVERSE}
    rebalance_to_weights(weights, forecast_returns=forecast,
                         factor_ids=[x["factor_id"] for x in selected], horizon_days=10)
    _last_date = date


if __name__ == "__main__":
    cross_asset_strategy()


