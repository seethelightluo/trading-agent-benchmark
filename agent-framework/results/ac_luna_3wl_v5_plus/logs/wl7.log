 import json
from pathlib import Path
import numpy as np
from alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights

UNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
ENSEMBLE_PATH = Path(__file__).parent / "factors" / "factor_ensemble.json"
_last_date = None


def _selected():
    try:
        return json.loads(ENSEMBLE_PATH.read_text(encoding="utf-8")).get("selected_factors", [])[:10]
    except Exception:
        return []


def _rank(values):
    out = {s: 0.5 for s in UNIVERSE}
    good = sorted((s, float(v)) for s, v in values.items() if np.isfinite(v))
    for i, (s, _) in enumerate(good):
        out[s] = (i + 1.0) / max(len(good), 1)
    return out


def _weights(raw):
    # Full investment with modest 2%-14% concentration limits.
    w = {s: max(float(raw.get(s, 0.0)), 0.0) for s in UNIVERSE}
    w = {s: v / (sum(w.values()) or 1.0) for s, v in w.items()}
    for _ in range(100):
        low = [s for s in UNIVERSE if w[s] < 0.02]
        high = [s for s in UNIVERSE if w[s] > 0.14]
        if not low and not high:
            break
        excess = sum(w[s] - 0.14 for s in high)
        deficit = sum(0.02 - w[s] for s in low)
        for s in low:
            w[s] = 0.02
        for s in high:
            w[s] = 0.14
        free = [s for s in UNIVERSE if s not in low and s not in high]
        if free:
            scale = max(0.0, 1.0 - 0.02 * len(low) - 0.14 * len(high))
            base = sum(w[s] for s in free) or 1.0
            for s in free:
                w[s] = w[s] / base * scale
    z = sum(w.values()) or 1.0
    return {s: w[s] / z for s in UNIVERSE}


@register_hook
def cross_asset_strategy():
    global _last_date
    selected = _selected()
    if not selected:
        return
    specs = {x["factor_id"]: (float(x["weight"]), int(x.get("direction", 1))) for x in selected}
    data, vols = {}, {}
    for symbol in UNIVERSE:
        df = get_stock_daily_data(symbol=symbol, days=140)
        if df is None or len(df) < 70:
            continue
        df = df.sort_values("date").reset_index(drop=True)
        close = np.asarray(df["close"], dtype=float)
        ret = close[1:] / np.maximum(close[:-1], 1e-12) - 1.0
        volume = np.asarray(df["volume"], dtype=float) if "volume" in df else np.ones(len(close))
        data[symbol] = (close, ret, volume, str(df.iloc[-1]["date"]))
        vols[symbol] = max(float(np.std(ret[-21:-1])), 0.008)
    if len(data) < 12:
        return
    decision_date = max(v[3] for v in data.values())
    if _last_date is not None:
        try:
            if (np.datetime64(decision_date) - np.datetime64(_last_date)) / np.timedelta64(1, "D") < 10:
                return
        except Exception:
            return

    factor_values = {f: {} for f in specs}
    for symbol, (c, r, q, _) in data.items():
        # Signals use the last completed bar and its lagged trailing windows.
        end = -1
        ret20 = c[end-1] / c[end-21] - 1.0
        ret15 = c[end-1] / c[end-16] - 1.0
        trailing = r[-21:-1]
        vol20 = max(float(np.std(trailing)), 0.008)
        downside = max(float(np.sqrt(np.mean(np.minimum(trailing, 0.0) ** 2))), 0.003)
        breadth = float(np.mean(trailing > 0))
        efficiency = ret20 / max(float(np.sum(np.abs(trailing))), 1e-12)
        feats = {
            "miner_1_20270111_breakout_persistence": ret20 / (vol20 * np.sqrt(20.0)),
            "miner_2_20270111_trend_consistency_risk_adjusted": (ret20 / (vol20 * np.sqrt(20.0))) * (0.5 + breadth),
            "miner_3_20261102_conditioned_momentum": (ret20 / vol20) * (1.0 + 0.8 * np.sign(ret20) * (breadth - 0.5)),
            "miner_2_20260827_range_efficiency_momentum": efficiency,
            "miner_2_20261102_downside_risk_adjusted_trend_20d": ret20 / downside,
            "miner_3_20270111_relative_momentum_15d_vol_scaled": ret15 / vol20,
        }
        for factor in specs:
            factor_values[factor][symbol] = feats.get(factor, 0.0)

    score = {s: 0.5 for s in UNIVERSE}
    for factor, (weight, direction) in specs.items():
        ranked = _rank({s: direction * v for s, v in factor_values[factor].items()})
        for s in UNIVERSE:
            score[s] += weight * (ranked[s] - 0.5)

    # Volatile bullish regime: retain trend exposure, but cap risk and favor defensives
    # when SPX is below its lagged 20-day level or has negative recent breadth.
    spx = data.get("SPX")
    risk_off = spx is not None and (spx[0][-2] < spx[0][-22] or np.mean(spx[1][-6:-1]) < 0)
    if risk_off:
        for s in ("XAU", "US10Y", "CN10Y"):
            score[s] += 0.10
        for s in ("BTC", "ETH", "WTI"):
            score[s] -= 0.06

    inv = {s: 1.0 / max(vols.get(s, 0.02), 0.008) for s in UNIVERSE}
    mean_inv = np.mean(list(inv.values()))
    raw = {s: max(score[s], 0.02) * (0.78 + 0.22 * inv[s] / mean_inv) for s in UNIVERSE}
    weights = _weights(raw)
    mean_score = np.mean(list(score.values()))
    sd_score = max(float(np.std(list(score.values()))), 1e-12)
    forecast = {s: float(0.01 * (score[s] - mean_score) / sd_score) for s in UNIVERSE}
    rebalance_to_weights(weights, forecast_returns=forecast,
                          factor_ids=[x["factor_id"] for x in selected], horizon_days=10)
    _last_date = decision_date


if __name__ == "__main__":
    cross_asset_strategy()


