2023,2024),(2025,2027)]: print('regime',a,b,st(q[(q.date.dt.year>=a)&(q.date.dt.year<=b)]))\nr=q.pivot(index='date',columns='asset',values='f').rank(axis=1,pct=True); print('turnover',r.diff().abs().mean().mean(),'coverage',len(q)/(q.date.nunique()*15)); q.to_csv('scripts/miner_1_20270506_vix_compression_signal.csv',index=False)\n", 'file_path': 'scripts/miner_1_20270506_vix_compression.py'})
