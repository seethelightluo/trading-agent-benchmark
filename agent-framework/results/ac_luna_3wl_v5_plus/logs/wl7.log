  ▶️ write_file({'content': 'import json\nfrom pathlib import Path\nimport numpy as np\nfrom alphacrafter.sim.utils import register_hook, get_stock_daily_data, get_index_daily_data, rebalance_to_weights\n\nUNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]\nENSEMBLE_PATH = Path(__file__).parent / "factors" / "factor_ensemble.json"\n_last_decision = None\n\ndef selected_factors():\n    try:\n        return json.loads(ENSEMBLE_PATH.read_text(encoding="utf-8")).get("selected_factors", [])[:10]\n    except Exception:\n        return []\n\ndef ranks(values):\n    good = sorted((s, v) for s, v in values.items() if np.isfinite(v))\n    out = {s: .5 for s in UNIVERSE}\n    for i, (s, _) in enumerate(good):\n        out[s] = (i + 1) / max(len(good), 1)\n    return out\n\ndef bounded_weights(raw):\n    w = {s: max(float(raw.get(s, 0.0)), 0.0) for s in UNIVERSE}\n    z = sum(w.values()) or 1.0\n    w = {s: v / z for s, v in w.items()}\n    # Moderate concentration limits for this 15-asset cross-section.\n    for _ in range(30):\n        low = [s for s in UNIVERSE if w[s] < .02]\n        high = [s for s in UNIVERSE if w[s] > .14]\n        if not low and not high: break\n        for s in low: w[s] = .02\n        for s in high: w[s] = .14\n        fixed = set(low + high)\n        free = [s for s in UNIVERSE if s not in fixed]\n        rem = 1.0 - sum(w[s] for s in fixed)\n        base = sum(w[s] for s in free) or 1.0\n        for s in free: w[s] *= rem / base\n    z = sum(w.values())\n    return {s: w[s] / z for s in UNIVERSE}\n\n@register_hook\ndef cross_asset_strategy():\n    global _last_decision\n    selected = selected_factors()\n    if not selected: return\n    specs = {x["factor_id"]: (float(x["weight"]), int(x.get("direction", 1))) for x in selected}\n    data, vols = {}, {}\n    for s in UNIVERSE:\n        df = get_stock_daily_data(symbol=s, days=150)\n        if df is None or len(df) < 75: continue\n        df = df.sort_values("date")\n        c = np.asarray(df["close"], dtype=float)\n        r = c[1:] / np.maximum(c[:-1], 1e-12) - 1.0\n        data[s] = (c, r, str(df.iloc[-1]["date"]))\n        vols[s] = max(float(np.std(r[-21:-1])), .008)\n    if len(data) < 12: return\n    decision = max(x[2] for x in data.values())\n    if _last_decision is not None:\n        try:\n            if (np.datetime64(decision) - np.datetime64(_last_decision)) / np.timedelta64(1, "D") < 10: return\n        except Exception: return\n    vix = 0.0; vix_med = 0.0\n    vd = get_index_daily_data(symbol="VIX", days=80)\n    if vd is not None and len(vd) >= 30:\n        vc = np.asarray(vd.sort_values("date")["close"], dtype=float)\n        vix, vix_med = vc[-2], float(np.median(vc[-31:-1]))\n    vix_scale = 0.75 if vix > 0 and vix > vix_med else 1.0\n    vals = {f: {} for f in specs}\n    for s, (c, r, _) in data.items():\n        # Use only completed observations (the final row can be an in-session mark).\n        p = c[:-1]; rr = r[:-1]\n        tr = rr[-21:]; vol = max(float(np.std(tr)), .008)\n        breadth = float(np.mean(tr > 0))\n        r5 = p[-1] / p[-6] - 1; r10 = p[-1] / p[-11] - 1\n        r20 = p[-1] / p[-21] - 1; r30 = p[-1] / p[-31] - 1\n        consistency = r20 / vol * (.5 + breadth)\n        efficiency = r20 / max(float(np.sum(np.abs(tr))), .02)\n        breakout = (p[-1] / max(float(np.max(p[-21:-1])), 1e-12) - 1) / vol\n        downside = r20 / max(float(np.sqrt(np.mean(np.minimum(tr, 0)**2))), .003)\n        acceleration = (r10 - r30 / 3.0) / vol\n        reversal = -r5 / max(float(np.std(rr[-5:])), .008)\n        f = {\n          "miner_2_20270111_trend_consistency_risk_adjusted": consistency,\n          "miner_1_20270108_persistent_trend_quality_20d": consistency,\n          "miner_2_20260827_range_efficiency_momentum": efficiency,\n          "miner_3_20270125_relative_momentum_30d_vol_scaled": r30 / vol,\n          "miner_1_20270111_breakout_persistence": breakout,\n          "miner_2_20261102_downside_risk_adjusted_trend_20d": downside,\n          "miner_3_20270128_trend_acceleration_vol_scaled": acceleration,\n          "miner_1_20270128_regime_switch_momentum_reversal": (r10 / vol if r10 >= 0 else reversal),\n          "miner_3_20270128_vol_state_momentum": r20 / vol * vix_scale,\n          "miner_2_20270128_vix_conditioned_momentum": r15 / vol * vix_scale if (r15 := p[-1] / p[-16] - 1) else 0.0,\n        }\n        for name in specs: vals[name][s] = f.get(name, 0.0)\n    score = {s: .5 for s in UNIVERSE}\n    for name, (weight, direction) in specs.items():\n        q = ranks({s: direction * v for s, v in vals[name].items()})\n        for s in UNIVERSE: score[s] += weight * (q[s] - .5)\n    spx = data.get("SPX")\n    risk_off = spx is not None and (spx[0][-2] < spx[0][-22] or np.mean(spx[1][-6:-1]) < 0)\n    if risk_off:\n        for s in ("XAU", "US10Y", "CN10Y"): score[s] += .10\n        for s in ("BTC", "ETH", "WTI"): score[s] -= .06\n    inv = {s: 1 / max(vols.get(s, .02), .008) for s in UNIVERSE}\n    avg_inv = np.mean(list(inv.values()))\n    raw = {s: max(score[s], .02) * (.78 + .22 * inv[s] / avg_inv) for s in UNIVERSE}\n    weights = bounded_weights(raw)\n    mu, sd = np.mean(list(score.values())), max(float(np.std(list(score.values()))), 1e-12)\n    forecast = {s: float(.01 * (score[s] - mu) / sd) for s in UNIVERSE}\n    rebalance_to_weights(weights, forecast_returns=forecast, factor_ids=list(specs), horizon_days=10)\n    _last_decision = decision\n', 'file_path': 'strategy.py'})

