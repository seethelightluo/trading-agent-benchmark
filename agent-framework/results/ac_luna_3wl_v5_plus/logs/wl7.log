  ▶️ write_file({'content': "import numpy as np, pandas as pd\nfrom alphacrafter.sim.utils import get_account_dict, get_index_daily_data, get_stock_daily_data\n\n# Single candidate: lagged cross-sectional defensive low-volatility factor\nacct=get_account_dict(); universe=acct.get('watch_list',[])\nif not universe: universe=['000300.SH','SPX','HSI','N225','SX5E','000688.SH','SOX','NDX','XAU','COPPER','WTI','BTC','ETH','US10Y','CN10Y']\nframes={}\nfor s in universe:\n    d=get_index_daily_data(s, days=3000)\n    if d is None or len(d)<100: d=get_stock_daily_data(s, days=3000)\n    if d is not None and len(d)>0:\n        x=d[['date','close']].copy(); x['date']=pd.to_datetime(x.date); x=x.dropna().drop_duplicates('date').sort_values('date'); frames[s]=x.set_index('date').close\npx=pd.DataFrame(frames).sort_index().ffill()\nrets=px.pct_change()\n# signal at t uses through t-1: inverse 30d annualized vol, cross-section centered\nvol=rets.rolling(30,min_periods=25).std()*np.sqrt(252)\nsig=(1/(vol+0.01)).shift(1)\n# cross-sectional percentile, higher means safer\nsig=sig.rank(axis=1,pct=True)\n# forward non-overlapping-style daily forward cumulative returns\nout=[]\nfor h in [1,5,10,20]:\n    fwd=px.shift(-h)/px-1\n    ics=[]; dates=[]; counts=[]\n    for dt in sig.index:\n        a=sig.loc[dt]; b=fwd.loc[dt]; z=pd.concat([a,b],axis=1).dropna()\n        if len(z)>=8:\n            ics.append(z.iloc[:,0].corr(z.iloc[:,1],method='spearman')); dates.append(dt); counts.append(len(z))\n    v=np.array([x for x in ics if np.isfinite(x)])\n    print('H',h,'dates',len(v),'avg_n',round(float(np.mean(counts)),2),'IC',round(float(v.mean()),6),'ICIR',round(float(v.mean()/v.std(ddof=1)*np.sqrt(len(v)) if v.std(ddof=1)>0 else 0),6),'hit',round(float((v>0).mean()),4))\n    if h==10:\n        # rank turnover on valid consecutive common dates\n        rr=sig.rank(axis=1,pct=True); turns=[]\n        for i in range(1,len(rr)):\n            common=rr.iloc[i].dropna().index.intersection(rr.iloc[i-1].dropna().index)\n            if len(common)>=8: turns.append(np.mean(np.abs(rr.iloc[i][common]-rr.iloc[i-1][common])))\n        print('TURN',round(float(np.mean(turns)),6),'coverage',round(float(sig.notna().sum().sum()/(sig.shape[0]*len(universe))),4),'universe',len(universe),'assets_loaded',len(frames))\n        for label,lo,hi in [('2020-22','2020','2022-12-31'),('2023-24','2023','2024-12-31'),('2025-27','2025','2027-12-31')]:\n            q=np.array([ics[i] for i,d in enumerate(dates) if pd.Timestamp(lo)<=d<=pd.Timestamp(hi) and np.isfinite(ics[i])])\n            print('REG',label,'n',len(q),'IC',round(float(q.mean()),6) if len(q) else None,'ICIR',round(float(q.mean()/q.std(ddof=1)*np.sqrt(len(q))),6) if len(q)>1 and q.std(ddof=1)>0 else None)\nprint('range',px.index.min(),px.index.max(),'assets',list(frames))\n", 'file_path': 'scripts/miner_3_20270826_lowvol_defensive.py'})
