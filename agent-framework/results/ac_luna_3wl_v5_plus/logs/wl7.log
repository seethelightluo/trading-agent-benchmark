import json
from pathlib import Path
import numpy as np
from alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights

UNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
ENSEMBLE_PATH = Path(__file__).parent / "factors" / "factor_ensemble.json"
_last_decision = None


def load_ensemble():
    try:
        obj = json.loads(ENSEMBLE_PATH.read_text())
        selected = [x for x in obj.get("selected_factors", []) if x.get("factor_id")][:10]
        weights = {x["factor_id"]: float(x.get("weight", 0.0)) for x in selected}
        directions = {x["factor_id"]: int(x.get("direction", 1)) for x in selected}
        return selected, weights, directions
    except Exception:
        return [], {}, {}


def cs_rank(values, direction=1):
    valid = sorted((s, direction * float(v)) for s, v in values.items() if np.isfinite(v))
    out = {s: 0.5 for s in UNIVERSE}
    n = max(len(valid), 1)
    for i, (s, _) in enumerate(valid):
        out[s] = (i + 1) / n
    return out


def bounded_weights(raw):
    # Full investment, modest diversification for a 15-name cross-section.
    lo, hi = 0.015, 0.16
    w = {s: max(float(raw.get(s, lo)), 1e-12) for s in UNIVERSE}
    fixed = set()
    for _ in range(40):
        free = [s for s in UNIVERSE if s not in fixed]
        if not free:
            break
        scale = (1.0 - sum(w[s] for s in fixed)) / max(sum(w[s] for s in free), 1e-12)
        changed = False
        for s in free:
            w[s] *= scale
            if w[s] < lo:
                w[s] = lo; fixed.add(s); changed = True
            elif w[s] > hi:
                w[s] = hi; fixed.add(s); changed = True
        if not changed:
            break
    total = sum(w.values())
    return {s: w[s] / total for s in UNIVERSE}


@register_hook
def cross_asset_strategy():
    global _last_decision
    selected, factor_weights, directions = load_ensemble()
    if not selected:
        return

    data = {}
    for symbol in UNIVERSE:
        df = get_stock_daily_data(symbol=symbol, days=100)
        if df is None or len(df) < 30:
            continue
        df = df.sort_values("date").reset_index(drop=True)
        close = np.asarray(df["close"], dtype=float)
        high = np.asarray(df["high"], dtype=float)
        low = np.asarray(df["low"], dtype=float)
        op = np.asarray(df["open"], dtype=float)
        ret = close[1:] / np.maximum(close[:-1], 1e-12) - 1.0
        data[symbol] = (close, high, low, op, ret, str(df.iloc[-1]["date"]))
    if len(data) < 12:
        return
    decision_date = max(x[5] for x in data.values())
    if _last_decision is not None:
        try:
            if (np.datetime64(decision_date) - np.datetime64(_last_decision)) / np.timedelta64(1, "D") < 10:
                return
        except Exception:
            pass

    factors = {x["factor_id"]: {} for x in selected}
    invvol, five_day = {}, {}
    for s, (c, h, l, op, r, _) in data.items():
        vol = max(float(np.std(r[-20:])), 0.008)
        invvol[s] = 1.0 / vol
        five_day[s] = c[-1] / max(c[-6], 1e-12) - 1.0
        vals = {
            "miner_3_clv_1d": (2*c[-1] - h[-1] - l[-1]) / max(h[-1] - l[-1], 1e-12),
            "peer_median_leadlag_5d": five_day[s],
            "miner_2_risk_adjusted_momentum_20d": (c[-1] / max(c[-21], 1e-12) - 1.0) / vol,
            "short_term_reversal_5d": -five_day[s],
            "miner_1_20260924_volatility_scaled_reversal_5d": -five_day[s] / vol,
            "miner_3_20260924_overnight_gap_reversal": -(op[-1] / max(c[-2], 1e-12) - 1.0),
        }
        for fid in factors:
            if fid in vals:
                factors[fid][s] = vals[fid]

    if "peer_median_leadlag_5d" in factors:
        med = float(np.median(list(five_day.values())))
        factors["peer_median_leadlag_5d"] = {s: v - med for s, v in five_day.items()}
    ranked = {fid: cs_rank(vals, directions.get(fid, 1)) for fid, vals in factors.items()}
    score = {s: sum(factor_weights[fid] * ranked[fid].get(s, 0.5) for fid in factors) for s in UNIVERSE}

    # High-risk sideways/bull regime: retain full investment but dampen unstable
    # crypto/energy and add a small defensive tilt only when the broad trend breaks.
    if "SPX" in data:
        spx = data["SPX"][0]
        if spx[-1] < spx[-21]:
            for s in ("XAU", "US10Y", "CN10Y"):
                score[s] += 0.10
            for s in ("BTC", "ETH", "WTI"):
                score[s] = max(0.01, score[s] - 0.06)

    mean_iv = float(np.mean(list(invvol.values())))
    raw = {s: max(score[s], 0.01) * (0.78 + 0.22 * invvol.get(s, mean_iv) / max(mean_iv, 1e-12)) for s in UNIVERSE}
    weights = bounded_weights(raw)
    mean_score = float(np.mean(list(score.values())))
    scale = max(float(np.std(list(score.values()))), 1e-12)
    forecast = {s: float(0.01 * (score[s] - mean_score) / scale) for s in UNIVERSE}
    rebalance_to_weights(weights, forecast_returns=forecast,
                         factor_ids=[x["factor_id"] for x in selected], horizon_days=10)
    _last_decision = decision_date

