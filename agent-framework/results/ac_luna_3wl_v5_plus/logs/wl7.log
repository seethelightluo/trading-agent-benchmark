f.get("factor_id", ""), float(f.get("weight", 0)), float(f.get("direction", 1))\n        if "signed_breadth" in fid: key = "breadth"\n        elif "conditioned_momentum" in fid: key = "conditioned"\n        elif "downside_adjusted_trend" in fid: key = "downside"\n        elif "range_efficiency" in fid: key = "efficiency"\n        elif "vol_state" in fid: key = "volstate"\n        elif "continuous_stress_reversal" in fid: key = "stress_rev"\n        elif "volume_confirmed_reversal" in fid: key = "volume_rev"\n        elif "dispersion_reversal" in fid: key = "disp_rev"\n        else: continue\n        ids.append(fid)\n        rr = rank({s: direction * sig[s][key] for s in sig})\n        for s in UNIVERSE: score[s] += wt * (rr[s] - .5)\n\n    # Defensive tradable tilt, while preserving 100% investment.\n    vix = get_index_daily_data(symbol="VIX", days=65)\n    stress = False\n    if vix is not None and len(vix) >= 32:\n        vc = np.asarray(vix.sort_values("date")["close"], dtype=float)\n        stress = vc[-2] > 1.2 * np.median(vc[-32:-2])\n    spx = data.get("SPX", (None,))[0]\n    if stress or (spx is not None and spx[-2] < spx[-22]):\n        for s in ("XAU", "US10Y", "CN10Y"): score[s] += .10\n        for s in ("BTC", "ETH", "WTI"): score[s] -= .07\n    invmean = np.mean([1 / vols.get(s, .02) for s in UNIVERSE])\n    raw = {s: max(score[s], .05) * (.78 + .22 * (1 / vols.get(s, .02)) / invmean) for s in UNIVERSE}\n    target = bounded(raw)\n    mu, sd = np.mean(list(score.values())), max(np.std(list(score.values())), 1e-9)\n    forecast = {s: float(.01 * (score[s] - mu) / sd) for s in UNIVERSE}\n    rebalance_to_weights(target, forecast_returns=forecast, factor_ids=ids, horizon_days=10)\n    last_decision = stamp\n', 'file_path': 'strategy.py'})
