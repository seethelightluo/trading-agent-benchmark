 import json
from pathlib import Path
import numpy as np
from alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights

UNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
ENSEMBLE_PATH = Path(__file__).parent / "factors" / "factor_ensemble.json"
_last_decision = None


def load_ensemble():
    obj = json.loads(ENSEMBLE_PATH.read_text(encoding="utf-8"))
    xs = [x for x in obj.get("selected_factors", []) if x.get("factor_id")][:10]
    return xs


def cross_rank(values, direction):
    valid = sorted((s, direction * float(v)) for s, v in values.items() if np.isfinite(v))
    out = {s: .5 for s in UNIVERSE}
    n = max(1, len(valid))
    for i, (s, _) in enumerate(valid):
        out[s] = (i + 1) / n
    return out


def bounded_weights(raw):
    lo, hi = .015, .16
    w = {s: max(float(raw.get(s, .01)), 1e-9) for s in UNIVERSE}
    fixed = set()
    for _ in range(50):
        free = [s for s in UNIVERSE if s not in fixed]
        scale = (1.0 - sum(w[s] for s in fixed)) / max(sum(w[s] for s in free), 1e-12)
        changed = False
        for s in free:
            w[s] *= scale
            if w[s] < lo:
                w[s] = lo; fixed.add(s); changed = True
            elif w[s] > hi:
                w[s] = hi; fixed.add(s); changed = True
        if not changed:
            break
    z = sum(w.values())
    return {s: w[s] / z for s in UNIVERSE}


@register_hook
def cross_asset_strategy():
    global _last_decision
    selected = load_ensemble()
    if not selected:
        return
    specs = {x["factor_id"]: (float(x.get("weight", 0)), int(x.get("direction", 1))) for x in selected}
    data = {}
    for s in UNIVERSE:
        df = get_stock_daily_data(symbol=s, days=110)
        if df is None or len(df) < 30:
            continue
        df = df.sort_values("date").reset_index(drop=True)
        c = np.asarray(df["close"], float); h = np.asarray(df["high"], float)
        l = np.asarray(df["low"], float); o = np.asarray(df["open"], float)
        r = c[1:] / np.maximum(c[:-1], 1e-12) - 1.0
        data[s] = (c, h, l, o, r, str(df.iloc[-1]["date"]))
    if len(data) < 12:
        return
    decision_date = max(v[5] for v in data.values())
    if _last_decision is not None:
        try:
            if (np.datetime64(decision_date) - np.datetime64(_last_decision)) / np.timedelta64(1, "D") < 10:
                return
        except Exception:
            pass

    # All signals use only the last completed daily bar and are cross-sectionally ranked.
    signals = {fid: {} for fid in specs}
    five = {}
    for s, (c, h, l, o, r, _) in data.items():
        vol = max(float(np.std(r[-20:])), .008)
        ret5 = c[-1] / max(c[-6], 1e-12) - 1.0
        ret20 = c[-1] / max(c[-21], 1e-12) - 1.0
        rng = np.maximum(h[-20:] - l[-20:], 1e-12)
        efficiency = ret20 / max(float(np.sum(np.abs(r[-20:]))), 1e-12)
        clv = (2*c[-1] - h[-1] - l[-1]) / max(h[-1] - l[-1], 1e-12)
        five[s] = ret5
        values = {
            "miner_2_20260827_range_efficiency_momentum": efficiency * ret20 / vol,
            "peer_median_leadlag_5d": ret5,
            "miner_2_risk_adjusted_momentum_20d": ret20 / vol,
            "miner_3_clv_1d": clv,
            "miner_1_20260827_volnorm_reversal_5d": -ret5 / vol,
            "miner_3_range_weighted_intraday_reversal_1d": -r[-1] * rng[-1] / max(float(np.mean(rng)), 1e-12),
        }
        for fid in signals:
            if fid in values:
                signals[fid][s] = values[fid]
    if "peer_median_leadlag_5d" in signals:
        signals["peer_median_leadlag_5d"] = {s: five[s] - float(np.median([v for t, v in five.items() if t != s])) for s in five}

    score = {s: 0.5 for s in UNIVERSE}
    for fid, (weight, direction) in specs.items():
        ranked = cross_rank(signals.get(fid, {}), direction)
        for s in UNIVERSE:
            score[s] += weight * (ranked[s] - .5)

    # High-volatility bearish regime: retain full investment but favor defensive tradables.
    if "SPX" in data and data["SPX"][0][-1] < data["SPX"][0][-21]:
        for s in ("XAU", "US10Y", "CN10Y"):
            score[s] += .10
        for s in ("BTC", "ETH", "WTI"):
            score[s] -= .06
    inv = {s: 1.0 / max(float(np.std(data[s][4][-20:])), .008) for s in data}
    avg_inv = float(np.mean(list(inv.values())))
    raw = {s: max(score[s], .02) * (.78 + .22 * inv.get(s, avg_inv) / max(avg_inv, 1e-12)) for s in UNIVERSE}
    weights = bounded_weights(raw)
    mu = float(np.mean(list(score.values()))); sd = max(float(np.std(list(score.values()))), 1e-12)
    forecast = {s: float(.01 * (score[s] - mu) / sd) for s in UNIVERSE}
    rebalance_to_weights(weights, forecast_returns=forecast,
                         factor_ids=[x["factor_id"] for x in selected], horizon_days=10)
    _last_decision = decision_date


