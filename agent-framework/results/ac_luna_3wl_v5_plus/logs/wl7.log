  ▶️ write_file({'content': "import numpy as np, pandas as pd\nfrom alphacrafter.sim.utils import get_index_daily_data, get_stock_daily_data\n\nU=['000300.SH','SPX','HSI','N225','SX5E','000688.SH','SOX','NDX','XAU','COPPER','WTI','BTC','ETH','US10Y','CN10Y']\nrows=[]\nfor s in U:\n    df=get_index_daily_data(s, days=3000)\n    if df is None or len(df)<120: df=get_stock_daily_data(s, days=3000)\n    if df is None or len(df)<120: continue\n    d=df[['date','close']].copy().sort_values('date'); d['r']=d.close.pct_change()\n    r20=d.close/d.close.shift(20)-1; r60=d.close/d.close.shift(60)-1\n    down=d.r.where(d.r<0).rolling(30).std()*np.sqrt(20)\n    vol60=d.r.rolling(60).std()*np.sqrt(60)\n    # continuous trend confirmation: normalized 60d return, bounded, lagged\n    conf=0.5+0.5*np.tanh(r60/(vol60+1e-12))\n    fac=(r20/(down*np.sqrt(20)+1e-8)*conf).shift(1)\n    fwd=d.close.shift(-1)/d.close-1\n    f10=d.close.shift(-10)/d.close-1\n    for date,x,y,z in zip(d.date,fac,fwd,f10): rows.append((date,s,x,y,z))\nx=pd.DataFrame(rows,columns=['date','symbol','factor','fwd1','fwd10'])\nobs=[]\nfor dt,g in x.groupby('date'):\n    g=g.dropna(subset=['factor','fwd1','fwd10'])\n    if len(g)>=8:\n        obs.append([dt,len(g),g.factor.corr(g.fwd1,method='spearman'),g.factor.corr(g.fwd10,method='spearman')])\no=pd.DataFrame(obs,columns=['date','n','ic1','ic10']).sort_values('date')\nfor c in ['ic1','ic10']:\n    mu=o[c].mean(); sd=o[c].std(ddof=1)\n    print(c, 'mean',mu,'ir',mu/sd*np.sqrt(len(o)) if sd else np.nan,'hit',(o[c]>0).mean())\nprint('dates',len(o),'avg_n',o.n.mean(),'range',o.date.min(),o.date.max())\nfor a,b in [('2020','2022'),('2023','2024'),('2025','2027')]:\n    q=o[(o.date.dt.year>=int(a))&(o.date.dt.year<=int(b))]\n    print(a,b,len(q),q.ic1.mean() if len(q) else np.nan)\n# rank turnover: average fraction changing top/bottom ranks, use spearman rank corr consecutive cross sections\np=x.dropna(subset=['factor']).pivot(index='date',columns='symbol',values='factor')\nturn=[]\nfor i in range(1,len(p)):\n    a=p.iloc[i-1].rank(pct=True); b=p.iloc[i].rank(pct=True); common=a.index.intersection(b.index)\n    if len(common)>=8: turn.append((a[common]-b[common]).abs().mean())\nprint('rank_turnover',np.mean(turn),'coverage',x.factor.notna().mean())\n# Save recoverable artifact\nx.to_csv('scripts/miner_3_20270421_continuous_trend_confirmation_signal.csv',index=False)\n", 'file_path': 'scripts/miner_3_20270421_continuous_trend_confirmation.py'})
