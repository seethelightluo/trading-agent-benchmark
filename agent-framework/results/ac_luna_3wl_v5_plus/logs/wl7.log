ay(df["close"], dtype=float)[:-1]  # only completed bars\n        if len(c) < 80 or np.any(~np.isfinite(c)) or np.any(c <= 0): continue\n        r = c[1:] / c[:-1] - 1.0\n        def ret(n): return c[-1] / c[-n-1] - 1.0\n        v10 = max(np.std(r[-10:]), .008); v20 = max(np.std(r[-20:]), .008)\n        v30 = max(np.std(r[-30:]), .008); v60 = max(np.std(r[-60:]), .008)\n        neg = r[-30:][r[-30:] < 0]\n        dn = max(np.std(neg) if len(neg) > 1 else .008, .008)\n        m5, m10, m20, m30, m60 = [ret(n) for n in (5, 10, 20, 30, 60)]\n        signs = np.sign([m5, m10, m20, m30, m60])\n        features[s] = {\n            "quality": (np.mean(r[-30:] > 0) - .5) * m30 / v30,\n            "sortino": m30 / dn,\n            "mom30": m30 / v30,\n            "residual": (m30 - .5*m5) / v30,\n            "agreement": np.mean(signs) + .25*np.sign(m30),\n            "stress": -m5 / v10,\n            "asym": -m5 / v10 - .5*min(0.0, m10) / v20,\n            "recovery": m10 / max(abs(min(0.0, np.min(c[-11:] / np.maximum.accumulate(c[-11:]) - 1))), .01),\n        }\n        vols[s] = max(np.std(r[-25:]), .008)\n        stamps[s] = str(df.iloc[-1]["date"])\n    if len(features) < 12: return\n    stamp = max(stamps.values())\n    if last_decision is not None and (np.datetime64(stamp) - np.datetime64(last_decision)) / np.timedelta64(1, "D") < 10: return\n    key = {\n      "miner_1_20270609_quality_momentum":"quality",\n      "miner_3_20270716_downside_sortino_momentum_30d":"sortino",\n      "miner_1_20270723_risk_adjusted_momentum30":"mom30",\n      "miner_3_20270813_residual_trend_30d":"residual",\n      "miner_1_20270622_multihorizon_agreement":"agreement",\n      "miner_3_20270506_continuous_stress_reversal":"stress",\n      "miner_3_20261130_asymmetric_volatility_reversal_2d_revalidated":"asym",\n      "miner_1_20270707_recovery_efficiency_10d":"recovery",\n    }\n    score = {s: .5 for s in UNIVERSE}\n    for f in factors:\n        k = key.get(f.get("factor_id"))\n        if k is None: continue\n        rr = ranks({s: float(f.get("direction", 1)) * features[s][k] for s in features})\n        for s in UNIVERSE: score[s] += float(f["weight"]) * (rr[s] - .5)\n    vix = get_index_daily_data(symbol="VIX", days=70)\n    stressed = False\n    if vix is not None and len(vix) >= 35:\n        x = np.asarray(vix.sort_values("date")["close"], float)[:-1]\n        stressed = x[-1] > np.mean(x[-30:]) + .5*np.std(x[-30:])\n    if stressed or score.get("SPX", .5) < .5:\n        for s in ("XAU", "US10Y", "CN10Y"): score[s] += .08\n        for s in ("BTC", "ETH", "WTI"): score[s] -= .05\n    inv = np.mean([1.0 / vols[s] for s in UNIVERSE])\n    raw = {s: max(score[s], .05) * (.78 + .22*(1.0/vols[s])/inv) for s in UNIVERSE}\n    mean, sd = np.mean(list(score.values())), max(np.std(list(score.values())), 1e-8)\n    forecast = {s: float(.01*(score[s] - mean)/sd) for s in UNIVERSE}\n    rebalance_to_weights(bounded(raw), forecast_returns=forecast,\n                         factor_ids=[f["factor_id"] for f in factors], horizon_days=10)\n    last_decision = stamp\n\nstrategy = cross_asset_strategy\n', 'file_path': 'strategy.py'})

