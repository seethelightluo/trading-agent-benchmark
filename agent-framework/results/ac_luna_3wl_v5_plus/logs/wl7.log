d: key = "conditioned"\n        else: continue\n        rr = rank({s: int(spec.get("direction", 1)) * signals[s][key] for s in signals})\n        for s in UNIVERSE:\n            score[s] += float(spec["weight"]) * (rr[s] - 0.5)\n\n    vix = get_index_daily_data(symbol="VIX", days=65)\n    high_vix = False\n    if vix is not None and len(vix) >= 32:\n        vc = np.asarray(vix.sort_values("date")["close"], float)\n        high_vix = bool(vc[-2] > 1.2 * np.median(vc[-32:-2]))\n    spx = series.get("SPX", (None,))[0]\n    risk_off = high_vix or (spx is not None and (spx[-2] < spx[-22] or np.mean(spx[-8:-2] / spx[-9:-3] - 1) < 0))\n    if risk_off:\n        for s in ("XAU", "US10Y", "CN10Y"): score[s] += 0.10\n        for s in ("BTC", "ETH", "WTI"): score[s] -= 0.07\n\n    invmean = np.mean([1.0 / vol.get(s, 0.02) for s in UNIVERSE])\n    raw = {s: max(score[s], 0.05) * (0.78 + 0.22 * (1.0 / vol.get(s, 0.02)) / invmean) for s in UNIVERSE}\n    target = bounded_weights(raw)\n    mu, sd = np.mean(list(score.values())), max(float(np.std(list(score.values()))), 1e-9)\n    forecast = {s: float(0.01 * (score[s] - mu) / sd) for s in UNIVERSE}\n    rebalance_to_weights(target, forecast_returns=forecast,\n                         factor_ids=[x["factor_id"] for x in selected], horizon_days=10)\n    _last_decision = decision\n\n\nif __name__ == "__main__":\n    print([x["factor_id"] for x in load_ensemble()])\n', 'file_path': 'strategy.py'})
