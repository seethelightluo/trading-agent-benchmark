 import json
from pathlib import Path
import numpy as np
from alphacrafter.sim.utils import register_hook, get_stock_daily_data, get_index_daily_data, rebalance_to_weights

UNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
ENSEMBLE_PATH = Path(__file__).parent / "factors" / "factor_ensemble.json"
_last_decision = None


def ensemble():
    try:
        obj = json.loads(ENSEMBLE_PATH.read_text(encoding="utf-8"))
        return obj.get("selected_factors", [])[:10]
    except Exception:
        return []


def rank(values):
    out = {s: 0.5 for s in UNIVERSE}
    good = sorted((s, float(v)) for s, v in values.items() if np.isfinite(v))
    n = len(good)
    for i, (s, _) in enumerate(good):
        out[s] = (i + 0.5) / n
    return out


def bounded(raw):
    # Projection onto the complete long-only 2%-14% portfolio box.
    w = {s: max(float(raw.get(s, 0.0)), 1e-8) for s in UNIVERSE}
    for _ in range(30):
        z = sum(w.values())
        w = {s: v / z for s, v in w.items()}
        low = {s for s in UNIVERSE if w[s] < .02}
        high = {s for s in UNIVERSE if w[s] > .14}
        if not low and not high:
            break
        fixed = low | high
        for s in low: w[s] = .02
        for s in high: w[s] = .14
        free = [s for s in UNIVERSE if s not in fixed]
        rem = 1.0 - sum(w[s] for s in fixed)
        total = sum(w[s] for s in free) or 1.0
        for s in free: w[s] *= rem / total
    z = sum(w.values())
    return {s: w[s] / z for s in UNIVERSE}


@register_hook
def cross_asset_strategy():
    global _last_decision
    selected = ensemble()
    if not selected:
        return
    specs = [(str(x["factor_id"]), float(x["weight"]), int(x.get("direction", 1))) for x in selected]
    closes, rets, vols = {}, {}, {}
    for s in UNIVERSE:
        d = get_stock_daily_data(symbol=s, days=180)
        if d is None or len(d) < 70:
            continue
        c = np.asarray(d.sort_values("date")["close"], dtype=float)
        if np.all(np.isfinite(c)) and np.all(c > 0):
            closes[s] = c
            rets[s] = c[1:] / c[:-1] - 1.0
            vols[s] = max(float(np.std(rets[s][-23:-1])), .008)
    if len(closes) < 12:
        return
    # The final observed bar is not used as a predictor; it is the decision cut.
    decision = str(max(get_stock_daily_data(symbol=s, days=180).sort_values("date").iloc[-1]["date"] for s in closes))
    if _last_decision is not None:
        try:
            if (np.datetime64(decision) - np.datetime64(_last_decision)) / np.timedelta64(1, "D") < 10:
                return
        except Exception:
            return

    feat = {}
    for s, c in closes.items():
        p, r = c[:-1], rets[s][:-1]
        q = r[-20:]
        v20 = max(float(np.std(q)), .008)
        down = max(float(np.std(q[q < 0])) if np.any(q < 0) else .008, .008)
        breadth = float(np.mean(q > 0))
        r5, r10, r15, r20, r30 = (p[-1] / p[-k] - 1 for k in (6, 11, 16, 21, 31))
        path = max(float(np.sum(np.abs(q))), .02)
        # Features are deliberately simple, lagged, and cross-sectional.
        feat[s] = {
            "vix_reversal": -r5 / v20,
            "asym_reversal": -r5 / down,
            "volstate": r20 / v20,
            "breadth": breadth * (0.5 + r20 / v20),
            "consistency": breadth * (0.5 + r20 / v20),
            "downside": r20 / down,
            "breakout": (r15 / v20) * min(1.5, max(.5, float(np.std(r[-61:-2])) / v20)) if len(r) >= 61 else r15 / v20,
            "range": r20 / path,
            "current_vol": v20,
        }
    score = {s: 0.5 for s in UNIVERSE}
    for fid, wt, direction in specs:
        if "vix_stress_reversal" in fid: key = "vix_reversal"
        elif "asymmetric_volatility_reversal" in fid: key = "asym_reversal"
        elif "vol_state_momentum" in fid: key = "volstate"
        elif "signed_breadth_momentum" in fid: key = "breadth"
        elif "trend_consistency" in fid: key = "consistency"
        elif "downside_risk_adjusted" in fid: key = "downside"
        elif "compressed_breakout" in fid: key = "breakout"
        else: key = "volstate"
        rr = rank({s: direction * feat[s][key] for s in feat})
        for s in UNIVERSE:
            score[s] += wt * (rr[s] - .5)

    # Medium-high risk is expressed by reallocating to tradable defensives.
    vix = get_index_daily_data(symbol="VIX", days=65)
    high_vix = False
    if vix is not None and len(vix) >= 32:
        vc = np.asarray(vix.sort_values("date")["close"], dtype=float)
        high_vix = bool(vc[-2] > 1.2 * np.median(vc[-32:-2]))
    spx = closes.get("SPX")
    risk_off = high_vix or (spx is not None and (spx[-2] < spx[-22] or np.mean(rets["SPX"][-7:-2]) < 0))
    if risk_off:
        for s in ("XAU", "US10Y", "CN10Y"): score[s] += .10
        for s in ("BTC", "ETH", "WTI"): score[s] -= .07

    inv = np.mean([1.0 / vols.get(s, .02) for s in UNIVERSE])
    raw = {s: max(score[s], .05) * (.78 + .22 * (1.0 / vols.get(s, .02)) / inv) for s in UNIVERSE}
    target = bounded(raw)
    mean, sd = np.mean(list(score.values())), max(float(np.std(list(score.values()))), 1e-9)
    forecast = {s: float(.01 * (score[s] - mean) / sd) for s in UNIVERSE}
    rebalance_to_weights(target, forecast_returns=forecast, factor_ids=[x[0] for x in specs], horizon_days=10)
    _last_decision = decision

factor_ensemble = ensemble

if __name__ == "__main__":
    print(json.dumps({"factors": [x["factor_id"] for x in ensemble()], "assets": len(UNIVERSE)}))

