p.all(c > 0):\n            close[s] = c\n            ret[s] = c[1:] / c[:-1] - 1.0\n            vol[s] = max(float(np.std(ret[s][-23:-1])), .008)\n    if len(close) < 12:\n        return\n    dates = []\n    for s in close:\n        d = get_stock_daily_data(symbol=s, days=3)\n        if d is not None and len(d): dates.append(str(d.sort_values("date").iloc[-1]["date"]))\n    decision = max(dates) if dates else ""\n    if _last_decision is not None:\n        try:\n            if (np.datetime64(decision) - np.datetime64(_last_decision)) / np.timedelta64(1, "D") < 10:\n                return\n        except Exception:\n            return\n\n    feat = {}\n    for s, c in close.items():\n        r = ret[s][:-1]                 # last completed bar is excluded\n        q = r[-20:]\n        v = max(float(np.std(q)), .008)\n        down = max(float(np.std(q[q < 0])) if np.any(q < 0) else .008, .008)\n        r2 = c[:-1][-1] / c[:-1][-3] - 1.0\n        r5 = c[:-1][-1] / c[:-1][-6] - 1.0\n        r10 = c[:-1][-1] / c[:-1][-11] - 1.0\n        r20 = c[:-1][-1] / c[:-1][-21] - 1.0\n        breadth = float(np.mean(q > 0))\n        path = max(float(np.sum(np.abs(q))), .02)\n        feat[s] = {"stress": -r10 / v, "asym": -r2 / down, "disp": -r5 / v,\n                   "shock": -r2 / v, "downtrend": r20 / down, "breadth": breadth * (0.5 + r20 / v),\n                   "persistent": r20 / v, "volstate": r20 / v, "vol": vol[s]}\n\n    score = {s: .5 for s in UNIVERSE}\n    for item in selected:\n        fid, wt, direction = item["factor_id"], float(item["weight"]), int(item.get("direction", 1))\n        if "vix_stress_reversal" in fid: key = "stress"\n        elif "asymmetric_volatility_reversal" in fid: key = "asym"\n        elif "dispersion_reversal" in fid: key = "disp"\n        elif "vol_shock_reversal" in fid: key = "shock"\n        elif "downside_risk_adjusted_trend" in fid: key = "downtrend"\n        elif "signed_breadth_momentum" in fid: key = "breadth"\n        elif "persistent_trend_quality" in fid: key = "persistent"\n        elif "vol_state_momentum" in fid: key = "volstate"\n        else: continue\n        rr = ranks({s: direction * feat[s][key] for s in feat})\n        for s in UNIVERSE: score[s] += wt * (rr[s] - .5)\n\n    vix = get_index_daily_data(symbol="VIX", days=65)\n    vc = np.asarray(vix.sort_values("date")["close"], dtype=float) if vix is not None and len(vix) >= 32 else np.array([])\n    high_vix = len(vc) and bool(vc[-2] > 1.2 * np.median(vc[-32:-2]))\n    spx = close.get("SPX")\n    risk_off = bool(high_vix) or (spx is not None and (spx[-2] < spx[-22] or np.mean(ret["SPX"][-7:-2]) < 0))\n    if risk_off:\n        for s in ("XAU", "US10Y", "CN10Y"): score[s] += .10\n        for s in ("BTC", "ETH", "WTI"): score[s] -= .07\n\n    invmean = np.mean([1.0 / vol.get(s, .02) for s in UNIVERSE])\n    raw = {s: max(score[s], .05) * (.78 + .22 * (1.0 / vol.get(s, .02)) / invmean) for s in UNIVERSE}\n    target = bounded(raw)\n    mean, sd = np.mean(list(score.values())), max(float(np.std(list(score.values()))), 1e-9)\n    forecast = {s: float(.01 * (score[s] - mean) / sd) for s in UNIVERSE}\n    rebalance_to_weights(target, forecast_returns=forecast, factor_ids=[x["factor_id"] for x in selected], horizon_days=10)\n    _last_decision = decision\n\nif __name__ == "__main__":\n    print(json.dumps({"factors": [x["factor_id"] for x in load_ensemble()], "assets": len(UNIVERSE)}))\n', 'file_path': 'strategy.py'})
