  ▶️ write_file({'content': 'import json\nfrom pathlib import Path\nimport numpy as np\nfrom alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights\n\nUNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]\nENSEMBLE_PATH = Path(__file__).parent / "factors" / "factor_ensemble.json"\n_last_decision = None\n\n\ndef load_ensemble():\n    return json.loads(ENSEMBLE_PATH.read_text(encoding="utf-8")).get("selected_factors", [])[:10]\n\n\ndef rank(values):\n    out = {s: 0.5 for s in UNIVERSE}\n    good = sorted([(s, float(v)) for s, v in values.items() if np.isfinite(v)], key=lambda x: x[1])\n    for i, (s, _) in enumerate(good):\n        out[s] = (i + 1) / max(len(good), 1)\n    return out\n\n\ndef bounded(raw):\n    lo, hi = .015, .16\n    w = {s: max(float(raw.get(s, lo)), 1e-12) for s in UNIVERSE}\n    for _ in range(60):\n        fixed = {s: min(max(w[s], lo), hi) for s in UNIVERSE}\n        free = [s for s in UNIVERSE if lo < w[s] < hi]\n        rem = 1.0 - sum(fixed[s] for s in UNIVERSE if s not in free)\n        scale = rem / max(sum(w[s] for s in free), 1e-12)\n        nw = dict(fixed)\n        for s in free: nw[s] = w[s] * scale\n        if max(abs(nw[s] - w[s]) for s in UNIVERSE) < 1e-11:\n            w = nw; break\n        w = nw\n    z = sum(w.values())\n    return {s: w[s] / z for s in UNIVERSE}\n\n\n@register_hook\ndef cross_asset_strategy():\n    global _last_decision\n    selected = load_ensemble()\n    if not selected: return\n    specs = {x["factor_id"]: (float(x["weight"]), int(x.get("direction", 1))) for x in selected}\n    data = {}\n    for s in UNIVERSE:\n        df = get_stock_daily_data(symbol=s, days=130)\n        if df is None or len(df) < 65: continue\n        df = df.sort_values("date").reset_index(drop=True)\n        c = np.asarray(df.close, float); h = np.asarray(df.high, float)\n        l = np.asarray(df.low, float); v = np.asarray(df.volume, float)\n        r = c[1:] / np.maximum(c[:-1], 1e-12) - 1\n        data[s] = (c, h, l, v, r, str(df.iloc[-1].date))\n    if len(data) < 12: return\n    date = max(x[5] for x in data.values())\n    if _last_decision is not None and (np.datetime64(date)-np.datetime64(_last_decision))/np.timedelta64(1,"D") < 12: return\n\n    vals = {fid: {} for fid in specs}; recent5 = {}\n    for s, (c,h,l,v,r,_) in data.items():\n        vol = max(float(np.std(r[-20:])), .008)\n        ret1 = float(r[-1]); ret3 = float(c[-1]/c[-4]-1); ret5 = float(c[-1]/c[-6]-1)\n        ret20 = float(c[-1]/c[-21]-1); ret60 = float(c[-1]/c[-61]-1)\n        downside = max(float(np.sqrt(np.mean(np.minimum(r[-20:],0)**2))), .003)\n        eff = ret20 / max(float(np.sum(np.abs(r[-20:]))), 1e-12)\n        breadth = float(np.mean(r[-20:] > 0))\n        clv = (2*c[-1]-h[-1]-l[-1]) / max(h[-1]-l[-1],1e-12)\n        rr = max(h[-1]-l[-1],1e-12) / max(float(np.mean(h[-20:]-l[-20:])),1e-12)\n        vz = (v[-1]-np.mean(v[-21:-1])) / max(float(np.std(v[-21:-1])),1e-12)\n        vals_for = {\n          "miner_3_20261102_conditioned_momentum": (ret20/max(vol,.003)) * (1 + .8*np.sign(ret60)*(breadth-.5)),\n          "downside_risk_adjusted_trend_20d": ret20/downside,\n          "miner_2_20260827_range_efficiency_momentum": eff,\n          "miner_1_20260716_peer_median_leadlag_5d": ret5,\n          "miner_3_20261008_asymmetric_volatility_reversal_2d": (-float(c[-1]/c[-3]-1)/vol) if c[-1] < c[-3] else -.5*float(c[-1]/c[-3]-1)/vol,\n          "miner_3_volume_confirmed_reversal_3d": (-ret3/vol)*(1+min(max(vz,0),2)/2),\n          "miner_3_20260827_range_weighted_intraday_reversal": -ret1*rr,\n          "miner_3_20260716_clv_1d": clv}\n        for fid in specs:\n            if fid in vals_for: vals[fid][s] = vals_for[fid]\n        recent5[s] = ret5\n    if "miner_1_20260716_peer_median_leadlag_5d" in vals:\n        for s,x in recent5.items(): vals["miner_1_20260716_peer_median_leadlag_5d"][s] = x-np.median([y for t,y in recent5.items() if t!=s])\n\n    score = {s:.5 for s in UNIVERSE}\n    for fid,(wt,direction) in specs.items():\n        rr = rank({s: direction*x for s,x in vals.get(fid,{}).items()})\n        for s in UNIVERSE: score[s] += wt*(rr[s]-.5)\n    spx=data.get("SPX"); bearish = spx is not None and (spx[0][-1] < spx[0][-21] or np.mean(spx[4][-5:]) < 0)\n    if bearish:\n        for s in ("XAU","US10Y","CN10Y"): score[s] += .10\n        for s in ("BTC","ETH","WTI"): score[s] -= .06\n    inv={s:1/max(float(np.std(data[s][4][-20:])),.008) for s in data}; av=float(np.mean(list(inv.values())))\n    raw={s:max(score[s],.02)*(.78+.22*inv.get(s,av)/max(av,1e-12)) for s in UNIVERSE}\n    weights=bounded(raw); mean=float(np.mean(list(score.values()))); sd=max(float(np.std(list(score.values()))),1e-12)\n    forecast={s:float(.01*(score[s]-mean)/sd) for s in UNIVERSE}\n    rebalance_to_weights(weights, forecast_returns=forecast, factor_ids=[x["factor_id"] for x in selected], horizon_days=10)\n    _last_decision=date\n', 'file_path': 'strategy.py'})
