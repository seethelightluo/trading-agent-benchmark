import numpy as np
from alphacrafter.sim.utils import register_hook, get_stock_daily_data, get_index_daily_data, rebalance_to_weights

UNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
FACTOR_IDS = [
    "miner_1_20271217_volnorm_reversal_5d",
    "peer_median_leadlag_5d",
    "miner_2_range_efficiency_20d",
    "miner_2_downside_efficiency_20d",
    "miner_3_20271102_volscaled_relative_reversal_5d",
    "short_term_reversal_5d",
    "miner_2_20271217_vix_shock_resilience_10d",
]
FACTOR_WEIGHTS = [0.22, 0.20, 0.18, 0.15, 0.13, 0.07, 0.05]
FACTOR_DIRECTIONS = [1, 1, 1, 1, 1, 1, 1]
last_decision = None


def ranks(values):
    good = sorted((s, float(v)) for s, v in values.items() if np.isfinite(v))
    out = {s: 0.5 for s in UNIVERSE}
    if len(good) > 1:
        for i, (s, _) in enumerate(good):
            out[s] = (i + 1.0) / len(good)
    return out


def bounded(scores):
    lo, hi = 0.025, 0.13
    a = np.asarray([max(float(scores[s]), 1e-9) for s in UNIVERSE])
    w = a / a.sum()
    for _ in range(100):
        nw = np.clip(w, lo, hi)
        free = (w > lo) & (w < hi)
        if free.any():
            nw[free] = w[free] / max(w[free].sum(), 1e-12) * (1.0 - nw[~free].sum())
        if np.max(np.abs(nw - w)) < 1e-12:
            w = nw
            break
        w = nw
    w = np.clip(w, lo, hi)
    w /= w.sum()
    return {s: float(x) for s, x in zip(UNIVERSE, w)}


@register_hook
def cross_asset_strategy():
    global last_decision
    data = {}
    for s in UNIVERSE:
        df = get_stock_daily_data(symbol=s, days=100)
        if df is None or len(df) < 65:
            continue
        c = np.asarray(df.sort_values("date")["close"], dtype=float)
        if np.all(np.isfinite(c[-65:])) and np.all(c[-65:] > 0):
            data[s] = c
    if len(data) < 12:
        return
    dates = []
    for s in UNIVERSE:
        df = get_stock_daily_data(symbol=s, days=100)
        if df is not None and len(df):
            dates.append(str(df.sort_values("date").iloc[-1]["date"]))
    decision_date = max(dates) if dates else None
    if decision_date is None or (last_decision is not None and (np.datetime64(decision_date) - np.datetime64(last_decision)) / np.timedelta64(1, "D") < 10):
        return

    ret, ret5, ret20, vol20 = {}, {}, {}, {}
    for s, c in data.items():
        r = c[1:] / np.maximum(c[:-1], 1e-12) - 1.0
        ret[s] = r
        ret5[s] = c[-1] / c[-6] - 1.0
        ret20[s] = c[-1] / c[-21] - 1.0
        vol20[s] = max(float(np.std(r[-20:])), 0.005)
    peer = float(np.median(list(ret5.values())))
    raw = [{} for _ in FACTOR_IDS]
    for s in data:
        r = ret[s]
        downside = max(float(np.std(np.minimum(r[-20:], 0.0))), 0.005)
        # Causal implementations of the persisted factor specifications.
        raw[0][s] = -ret5[s] / (vol20[s] * np.sqrt(252.0))
        raw[1][s] = ret5[s] - peer
        raw[2][s] = ret20[s] / max(float(np.sum(np.abs(r[-20:]))), 1e-9)
        raw[3][s] = ret20[s] / downside
        raw[4][s] = -(ret5[s] - peer) / vol20[s]
        raw[5][s] = -ret5[s]

    # VIX is observation-only; use it only to form the resilience factor.
    vix = get_index_daily_data(symbol="VIX", days=100)
    if vix is not None and len(vix) >= 65:
        vr = np.asarray(vix.sort_values("date")["close"], dtype=float)
        vr = vr[1:] / np.maximum(vr[:-1], 1e-12) - 1.0
        for s in data:
            rr = ret[s][-min(len(ret[s]), len(vr)):]
            vv = vr[-len(rr):]
            shock = vv > 0
            raw[6][s] = (float(np.mean(rr[shock])) - float(np.mean(rr))) if shock.sum() >= 5 else 0.0
    else:
        raw[6] = {s: 0.0 for s in data}

    ranked = [ranks(x) for x in raw]
    score = {s: sum(w * d * ranked[i][s] for i, (w, d) in enumerate(zip(FACTOR_WEIGHTS, FACTOR_DIRECTIONS))) for s in UNIVERSE}
    # Sideways/high-risk posture: keep 100% invested, but shift modestly to defensives.
    stressed = "SPX" in data and (ret20["SPX"] < 0 or vol20["SPX"] > 0.018)
    if stressed:
        for s in ("XAU", "US10Y", "CN10Y"):
            score[s] += 0.08
        for s in ("BTC", "ETH", "WTI"):
            score[s] *= 0.80
    target = bounded(score)
    z = np.asarray([score[s] for s in UNIVERSE], dtype=float)
    z = (z - z.mean()) / max(float(z.std()), 1e-12)
    forecast_returns = {s: float(0.006 * z[i]) for i, s in enumerate(UNIVERSE)}
    rebalance_to_weights(target, forecast_returns=forecast_returns, factor_ids=FACTOR_IDS, horizon_days=10)
    last_decision = decision_date

