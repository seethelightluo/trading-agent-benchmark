  ▶️ write_file({'content': 'import numpy as np\nfrom alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights\n\nUNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]\nFACTOR_IDS = [\n    "peer_median_leadlag_5d", "miner_2_range_efficiency_20d",\n    "miner_2_risk_adjusted_momentum_20d", "miner_2_downside_efficiency_20d",\n    "miner_3_20271102_volscaled_relative_reversal_5d", "short_term_reversal_5d",\n    "miner_2_20271103_volume_pressure_reversal_3d"\n]\nFACTOR_WEIGHTS = [0.20, 0.18, 0.17, 0.14, 0.13, 0.10, 0.08]\nlast_decision = None\n\n\ndef ranks(x):\n    good = sorted((s, float(v)) for s, v in x.items() if np.isfinite(v))\n    out = {s: 0.5 for s in UNIVERSE}\n    if len(good) > 1:\n        for i, (s, _) in enumerate(good):\n            out[s] = (i + 1.0) / len(good)\n    return out\n\n\ndef weights_from_score(score):\n    lo, hi = 0.025, 0.13\n    raw = np.array([max(0.0, score[s]) for s in UNIVERSE], dtype=float)\n    w = raw / max(raw.sum(), 1e-12)\n    # Project onto the complete long-only bounded simplex.\n    for _ in range(20):\n        fixed = (w < lo) | (w > hi)\n        old = w.copy()\n        w = np.clip(w, lo, hi)\n        free = ~fixed\n        residual = 1.0 - w[~free].sum()\n        if free.any():\n            base = old[free].clip(lo, hi)\n            w[free] = base / max(base.sum(), 1e-12) * residual\n        if np.max(np.abs(w - old)) < 1e-10:\n            break\n    w = np.clip(w, lo, hi)\n    return {s: float(v / w.sum()) for s, v in zip(UNIVERSE, w)}\n\n\n@register_hook\ndef cross_asset_strategy():\n    global last_decision\n    data = {}\n    for s in UNIVERSE:\n        df = get_stock_daily_data(symbol=s, days=100)\n        if df is None or len(df) < 35:\n            continue\n        df = df.sort_values("date").reset_index(drop=True)\n        c = np.asarray(df["close"], dtype=float)\n        if np.any(~np.isfinite(c[-30:])) or np.any(c[-30:] <= 0):\n            continue\n        data[s] = (c, str(df.iloc[-1]["date"]))\n    if len(data) < 12:\n        return\n    decision = max(v[1] for v in data.values())\n    if last_decision is not None:\n        try:\n            if (np.datetime64(decision) - np.datetime64(last_decision)) / np.timedelta64(1, "D") < 10:\n                return\n        except Exception:\n            return\n\n    ret5 = {s: c[-1] / c[-6] - 1.0 for s, (c, _) in data.items()}\n    peer = float(np.median(list(ret5.values())))\n    f = [{} for _ in FACTOR_IDS]\n    for s, (c, _) in data.items():\n        d = c[1:] / np.maximum(c[:-1], 1e-12) - 1.0\n        d20 = d[-20:]\n        vol = max(float(np.std(d20)), 0.008)\n        r20 = c[-1] / c[-21] - 1.0\n        # Causal price proxies aligned to the persisted factor directions.\n        f[0][s] = ret5[s] - peer\n        f[1][s] = abs(r20) / max(float(np.sum(np.abs(d20))), 1e-8)\n        f[2][s] = r20 / vol\n        f[3][s] = min(r20, 0.0) / vol\n        f[4][s] = -(ret5[s] - peer) / vol\n        f[5][s] = -float(np.mean(d[-5:]))\n        f[6][s] = -float(np.mean(d[-3:]))\n    rr = [ranks(x) for x in f]\n    score = {s: sum(a * r[s] for a, r in zip(FACTOR_WEIGHTS, rr)) for s in UNIVERSE}\n\n    # High-risk bearish regime: remain fully invested, but migrate toward\n    # defensive tradable benchmarks rather than using a cash sleeve.\n    if "SPX" in data:\n        c = data["SPX"][0]\n        d = c[1:] / np.maximum(c[:-1], 1e-12) - 1.0\n        if c[-1] < c[-21] or np.std(d[-20:]) > 0.018:\n            for s in ("XAU", "US10Y", "CN10Y"):\n                score[s] += 0.10\n            for s in ("BTC", "ETH", "WTI"):\n                score[s] *= 0.75\n\n    target = weights_from_score(score)\n    a = np.array([score[s] for s in UNIVERSE], dtype=float)\n    z = (a - a.mean()) / max(float(a.std()), 1e-12)\n    forecast_returns = {s: float(0.008 * z[i]) for i, s in enumerate(UNIVERSE)}\n    rebalance_to_weights(target, forecast_returns=forecast_returns,\n                         factor_ids=FACTOR_IDS, horizon_days=10)\n    last_decision = decision\n', 'file_path': 'strategy.py'})
