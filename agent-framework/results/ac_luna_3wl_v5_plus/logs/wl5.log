 import numpy as np
from alphacrafter.sim.utils import register_hook, get_stock_daily_data, get_index_daily_data, rebalance_to_weights

UNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
FACTOR_IDS = [
    "miner_2_20280128_contrarian_risk_adjusted_trend_20d",
    "miner_2_20280215_volneutral_recovery_10d",
    "miner_3_20271217_volscaled_reversal_3d",
    "miner_3_20271231_relative_reversal_5d10d",
    "miner_2_channel_trend_20d",
    "miner_2_20280225_volconditioned_drawdown_recovery_10d",
]
FACTOR_WEIGHTS = np.array([0.40, 0.25, 0.14, 0.10, 0.07, 0.04])
_last_decision = None


def rank(v):
    good = sorted((s, float(x)) for s, x in v.items() if np.isfinite(x))
    out = {s: 0.5 for s in UNIVERSE}
    n = len(good)
    for i, (s, _) in enumerate(good):
        out[s] = (i + 1.0) / n if n > 1 else 0.5
    return out


def bounded_weights(score):
    x = np.array([max(float(score.get(s, 0.5)), 1e-8) for s in UNIVERSE])
    x /= x.sum()
    lo, hi = 0.03, 0.14
    # Iterative water filling keeps every tradable asset invested.
    for _ in range(50):
        low, high = x < lo, x > hi
        if not (low.any() or high.any()):
            break
        fixed = low | high
        y = np.clip(x, lo, hi)
        free = ~fixed
        rem = 1.0 - y[fixed].sum()
        if free.any() and rem > 0:
            y[free] = x[free] / x[free].sum() * rem
        x = y
    x = np.maximum(x, 0.0)
    x /= x.sum()
    return {s: float(w) for s, w in zip(UNIVERSE, x)}


@register_hook
def cross_asset_strategy():
    global _last_decision
    close, ret, dates = {}, {}, {}
    for s in UNIVERSE:
        df = get_stock_daily_data(symbol=s, days=130)
        if df is None or len(df) < 65:
            continue
        df = df.sort_values("date")
        c = np.asarray(df["close"], dtype=float)
        if np.all(np.isfinite(c[-65:])) and np.all(c[-65:] > 0):
            close[s] = c
            ret[s] = c[1:] / c[:-1] - 1.0
            dates[s] = str(df.iloc[-1]["date"])
    if len(close) < 12:
        return
    decision = max(dates.values())
    if _last_decision is not None:
        try:
            if (np.datetime64(decision) - np.datetime64(_last_decision)) / np.timedelta64(1, "D") < 10:
                return
        except Exception:
            return

    r3 = {s: close[s][-1] / close[s][-4] - 1 for s in close}
    r5 = {s: close[s][-1] / close[s][-6] - 1 for s in close}
    r10 = {s: close[s][-1] / close[s][-11] - 1 for s in close}
    r20 = {s: close[s][-1] / close[s][-21] - 1 for s in close}
    vol = {s: max(float(np.std(ret[s][-20:])), 0.005) for s in close}
    raw = [dict() for _ in FACTOR_IDS]
    for s, c in close.items():
        # Causal proxies: all signs are positive, matching the persisted ensemble.
        raw[0][s] = -r20[s] / vol[s]
        raw[1][s] = (c[-1] / min(c[-11:]) - 1.0) / vol[s]
        raw[2][s] = -r3[s] / vol[s]
        raw[3][s] = -(r5[s] - r10[s]) / vol[s]
        raw[4][s] = (c[-1] - min(c[-21:])) / max(max(c[-21:]) - min(c[-21:]), 1e-9)
        raw[5][s] = (c[-1] / min(c[-11:]) - 1.0) / vol[s]
    ranks = [rank(v) for v in raw]
    score = {s: sum(FACTOR_WEIGHTS[i] * ranks[i][s] for i in range(6)) for s in UNIVERSE}

    # Sideways/high-risk overlay: remain fully invested but favor defensive tradables.
    vix = get_index_daily_data(symbol="VIX", days=25)
    shock = False
    if vix is not None and len(vix) >= 6:
        vc = np.asarray(vix.sort_values("date")["close"], dtype=float)
        shock = bool(np.isfinite(vc[-1]) and vc[-1] / max(vc[-6], 1e-9) - 1 > 0.08)
    if shock or r20.get("SPX", 0) < 0 or vol.get("SPX", 0) > 0.018:
        for s in ("XAU", "US10Y", "CN10Y"):
            score[s] += 0.07
        for s in ("BTC", "ETH", "WTI"):
            score[s] *= 0.82
    target = bounded_weights(score)
    z = np.array([score[s] for s in UNIVERSE])
    z = (z - z.mean()) / max(float(z.std()), 1e-12)
    forecast_returns = {s: float(0.006 * z[i]) for i, s in enumerate(UNIVERSE)}
    rebalance_to_weights(target, forecast_returns=forecast_returns, factor_ids=FACTOR_IDS, horizon_days=10)
    _last_decision = decision


