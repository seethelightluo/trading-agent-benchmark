        out[s] = (i + 1) / n if n > 1 else .5
    return out


def target_weights(score):
    # Full investment, with sensible diversification for the 15-asset universe.
    x = np.array([max(float(score.get(s, .5)), 1e-9) for s in UNIVERSE])
    x /= x.sum()
    # Iterative bounded simplex projection: 3% minimum and 14% maximum.
    for _ in range(50):
        y = np.clip(x, .03, .14)
        fixed = (y <= .030000001) | (y >= .139999999)
        free = ~fixed
        if not free.any():
            break
        y[free] = x[free] / x[free].sum() * (1.0 - y[fixed].sum())
        if np.max(np.abs(y - x)) < 1e-11:
            x = y
            break
        x = y
    x = np.clip(x, 0.0, None)
    x /= x.sum()
    return {s: float(w) for s, w in zip(UNIVERSE, x)}


@register_hook
def cross_asset_strategy():
    global _last_decision
    close, daily_ret, dates = {}, {}, {}
    for symbol in UNIVERSE:
        df = get_stock_daily_data(symbol=symbol, days=170)
        if df is None or len(df) < 65:
            continue
        df = df.sort_values("date")
        c = np.asarray(df["close"], dtype=float)
        if np.all(np.isfinite(c[-65:])) and np.all(c[-65:] > 0):
            close[symbol] = c
            daily_ret[symbol] = c[1:] / c[:-1] - 1.0
            dates[symbol] = str(df.iloc[-1]["date"])
    if len(close) < 12:
        return
    decision = max(dates.values())
    if _last_decision is not None:
        try:
            if (np.datetime64(decision) - np.datetime64(_last_decision)) / np.timedelta64(1, "D") < 10:
                return
        except Exception:
            return

    r5 = {s: close[s][-1] / close[s][-6] - 1.0 for s in close}
    r10 = {s: close[s][-1] / close[s][-11] - 1.0 for s in close}
    r20 = {s: close[s][-1] / close[s][-21] - 1.0 for s in close}
    vol = {s: max(float(np.std(daily_ret[s][-20:])), .005) for s in close}
    downside = {s: max(float(np.std(np.minimum(daily_ret[s][-20:], 0))), .003) for s in close}
    raw = [dict() for _ in FACTOR_IDS]
    for s in close:
        # Price-only proxies use information through the last completed session.
        raw[0][s] = -r20[s] / vol[s]                         # contrarian trend
        raw[1][s] = (close[s][-1] / max(np.min(close[s][-11:]), 1e-12) - 1) / vol[s]
        raw[2][s] = r20[s] / downside[s]                     # downside-adjusted momentum
        raw[3][s] = 1.0 / vol[s]                             # resilience / defensive quality
        raw[4][s] = -r10[s] / vol[s]
        raw[5][s] = -r5[s] / vol[s]
        raw[6][s] = r20[s] / vol[s]                           # channel trend
        raw[7][s] = (r5[s] - r20[s] / 4.0) / vol[s]            # acceleration reversal
    ranks = [percentile_rank(f) for f in raw]
    score = {s: sum(FACTOR_WEIGHTS[i] * ranks[i][s] for i in range(8)) for s in UNIVERSE}

    # Reactive volatility calls for defensive tradable tilts, never cash.
    vix = get_index_daily_data(symbol="VIX", days=25)
    vix_shock = False
    if vix is not None and len(vix) >= 6:
        vc = np.asarray(vix.sort_values("date")["close"], dtype=float)
        vix_shock = bool(np.isfinite(vc[-1]) and vc[-1] / max(vc[-6], 1e-9) - 1.0 > .08)
    if vix_shock or r20.get("SPX", 0.0) < 0.0 or vol.get("SPX", 0.0) > .018:
        for s in ("XAU", "US10Y", "CN10Y"):
            score[s] += .07
        for s in ("BTC", "ETH", "WTI"):
            score[s] *= .82

    target = target_weights(score)
    z = np.array([score[s] for s in UNIVERSE], dtype=float)
    z = (z - z.mean()) / max(float(z.std()), 1e-12)
    forecast_returns = {s: float(.006 * z[i]) for i, s in enumerate(UNIVERSE)}
    rebalance_to_weights(target, forecast_returns=forecast_returns, factor_ids=FACTOR_IDS, horizon_days=10)
    _last_decision = decision

assert len(UNIVERSE) == 15 and len(FACTOR_IDS) == 8
assert abs(float(FACTOR_WEIGHTS.sum()) - 1.0) < 1e-9
assert set(UNIVERSE).isdisjoint({"DXY", "USDCNY", "USDJPY", "EURUSD", "VIX"})


