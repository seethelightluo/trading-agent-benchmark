    continue\n        df = df.sort_values("date")\n        c = np.asarray(df["close"], dtype=float)\n        if np.all(np.isfinite(c[-65:])) and np.all(c[-65:] > 0):\n            closes[s] = c\n            returns[s] = c[1:] / c[:-1] - 1.0\n            dates.append(str(df.iloc[-1]["date"]))\n    if len(closes) < 12 or not dates:\n        return\n    decision = max(dates)\n    if _last_decision is not None:\n        try:\n            if (np.datetime64(decision) - np.datetime64(_last_decision)) / np.timedelta64(1, "D") < 10:\n                return\n        except Exception:\n            return\n    r5 = {s: c[-1] / c[-6] - 1.0 for s, c in closes.items()}\n    r20 = {s: c[-1] / c[-21] - 1.0 for s, c in closes.items()}\n    vol = {s: max(float(np.std(returns[s][-20:])), 0.005) for s in closes}\n    peer = float(np.median(list(r5.values())))\n    raw = [{ } for _ in FACTOR_IDS]\n    for s in closes:\n        rr = returns[s][-20:]\n        downside = max(float(np.std(np.minimum(rr, 0.0))), 0.005)\n        # Causal proxies for the persisted factor definitions, using completed bars only.\n        raw[0][s] = -r20[s] / vol[s]                    # contrarian risk-adjusted trend\n        raw[1][s] = -r5[s] / vol[s]                     # volatility-normalized reversal\n        raw[2][s] = r5[s] - peer                       # peer lead-lag\n        raw[3][s] = r20[s] / max(float(np.sum(np.abs(rr))), 1e-9)  # range efficiency\n        raw[4][s] = r20[s] / downside                  # downside efficiency\n        raw[6][s] = r20[s] / vol[s]                     # small momentum sleeve\n\n    vix = get_index_daily_data(symbol="VIX", days=110)\n    if vix is not None and len(vix) >= 65:\n        vc = np.asarray(vix.sort_values("date")["close"], dtype=float)\n        vr = vc[1:] / np.maximum(vc[:-1], 1e-12) - 1.0\n        for s in closes:\n            n = min(len(vr), len(returns[s]))\n            shock = vr[-n:] > 0\n            x = returns[s][-n:]\n            raw[5][s] = float(np.m