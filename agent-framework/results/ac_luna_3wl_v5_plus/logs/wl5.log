  ▶️ write_file({'content': "import numpy as np, pandas as pd\nfrom alphacrafter.sim.utils import get_index_daily_data\n\nU=['000300.SH','SPX','HSI','N225','SX5E','000688.SH','SOX','NDX','XAU','COPPER','WTI','BTC','ETH','US10Y','CN10Y']\npx={}\nfor s in U:\n    d=get_index_daily_data(s, days=3000)\n    if d is not None and len(d):\n        d=d.copy(); d['date']=pd.to_datetime(d['date']); px[s]=d.set_index('date')['close']\nP=pd.DataFrame(px).sort_index().ffill()\nv=get_index_daily_data('VIX', days=3000)\n# observation-only macro signal from persistent file, never traded\nif v is None:\n    v=pd.read_csv('../persistent/index_data/VIX.csv'); v['date']=pd.to_datetime(v.date); v=v.set_index('date')['close']\nelse: v=v.assign(date=pd.to_datetime(v.date)).set_index('date')['close']\nv=v.reindex(P.index).ffill()\n# high-volatility conditional reversal: negative 5d return, strengthened when VIX is elevated\nrv=P.pct_change(5)\nvz=(v-v.rolling(60).mean())/v.rolling(60).std()\nf=-rv*(1+0.75*vz.clip(lower=0,upper=2))\nfr=P.shift(-10)/P-1\nrows=[]; dates=[]\nfor dt in f.index:\n    a=f.loc[dt]; b=fr.loc[dt]; ok=a.notna()&b.notna()\n    if ok.sum()>=8:\n        rows.append(a[ok].corr(b[ok],method='spearman')); dates.append(dt)\nic=np.array(rows,float); mean=float(np.nanmean(ic)); sd=float(np.nanstd(ic,ddof=1)); icir=mean/sd*np.sqrt(252) if sd else np.nan\n# signal turnover as average rank displacement on consecutive valid dates\nr=f.rank(pct=True,axis=1); turn=(r.diff().abs().mean(axis=1)).dropna()\nprint({'factor':'vix_conditioned_reversal_5d','dates':len(ic),'start':str(dates[0].date()),'end':str(dates[-1].date()),'avg_instruments':float(sum((f.loc[d].notna()&fr.loc[d].notna()).sum() for d in dates)/len(dates)),'coverage':float(np.mean([((f.loc[d].notna()&fr.loc[d].notna()).sum()/15) for d in dates])),'ic':mean,'icir':icir,'hit_ratio':float(np.mean(ic>0)),'turnover':float(turn.mean()),'decay_note':'10-day forward horizon; conditional multiplier uses lagged VIX level only'})\n# regime split\nfor label,mask in [('pre2025',np.array([d.year<2025 for d in dates])),('2025plus',np.array([d.year>=2025 for d in dates]))]:\n x=ic[mask]; print(label,len(x),float(np.mean(x)) if len(x) else None,float(np.mean(x)/np.std(x,ddof=1)*np.sqrt(252)) if len(x)>1 else None)\n", 'file_path': 'scripts/miner_1_20271203_vix_conditioned_reversal.py'})
