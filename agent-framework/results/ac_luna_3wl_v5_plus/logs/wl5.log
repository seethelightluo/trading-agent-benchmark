  ▶️ write_file({'content': 'import numpy as np\nfrom alphacrafter.sim.utils import register_hook, get_stock_daily_data, get_index_daily_data, rebalance_to_weights\n\nUNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]\nFACTOR_IDS = [\n    "miner_2_20280128_contrarian_risk_adjusted_trend_20d",\n    "miner_1_20271217_volnorm_reversal_5d",\n    "miner_1_20260716_peer_median_leadlag_5d",\n    "miner_2_downside_efficiency_20d",\n    "miner_2_20271217_vix_shock_resilience_10d",\n    "miner_3_20280114_risk_momentum_20d",\n    "miner_2_channel_trend_20d",\n    "miner_2_20280225_volconditioned_drawdown_recovery_10d",\n    "miner_3_20271231_relative_reversal_5d10d",\n]\nFACTOR_WEIGHTS = [0.25, 0.15, 0.12, 0.12, 0.10, 0.10, 0.07, 0.05, 0.04]\nFACTOR_DIRECTIONS = [1] * 9\n_last_decision = None\n\n\ndef _rank(values):\n    valid = sorted((s, float(v)) for s, v in values.items() if np.isfinite(v))\n    out = {s: 0.5 for s in UNIVERSE}\n    n = len(valid)\n    if n > 1:\n        for i, (s, _) in enumerate(valid):\n            out[s] = (i + 1.0) / n\n    return out\n\n\ndef _weights(scores):\n    # Broad, bounded allocation is appropriate for this 15-name, high-risk cross-section.\n    lo, hi = 0.025, 0.13\n    w = np.array([max(float(scores.get(s, 0.5)), 1e-8) for s in UNIVERSE])\n    w /= w.sum()\n    for _ in range(50):\n        fixed = (w <= lo) | (w >= hi)\n        nw = np.clip(w, lo, hi)\n        free = ~fixed\n        if free.any():\n            residual = 1.0 - nw[~free].sum()\n            nw[free] = w[free] / w[free].sum() * max(residual, 0.0)\n        if np.max(np.abs(nw - w)) < 1e-10:\n            w = nw\n            break\n        w = nw\n    w = np.clip(w, lo, hi)\n    w /= w.sum()\n    return {s: float(x) for s, x in zip(UNIVERSE, w)}\n\n\n@register_hook\ndef cross_asset_strategy():\n    global _last_decision\n    closes, rets = {}, {}\n    for s in UNIVERSE:\n        df = get_stock_daily_data(symbol=s, days=120)\n        if df is None or len(df) < 65:\n            continue\n        df = df.sort_values("date")\n        c = np.asarray(df["close"], dtype=float)\n        if np.all(np.isfinite(c[-65:])) and np.all(c[-65:] > 0):\n            closes[s] = c\n            rets[s] = c[1:] / c[:-1] - 1.0\n    if len(closes) < 12:\n        return\n    dates = [str(get_stock_daily_data(symbol=s, days=2).iloc[-1]["date"]) for s in closes]\n    decision = max(dates)\n    if _last_decision is not None:\n        try:\n            if (np.datetime64(decision) - np.datetime64(_last_decision)) / np.timedelta64(1, "D") < 10:\n                return\n        except Exception:\n            return\n\n    r3 = {s: c[-1] / c[-4] - 1.0 for s, c in closes.items()}\n    r5 = {s: c[-1] / c[-6] - 1.0 for s, c in closes.items()}\n    r10 = {s: c[-1] / c[-11] - 1.0 for s, c in closes.items()}\n    r20 = {s: c[-1] / c[-21] - 1.0 for s, c in closes.items()}\n    vol = {s: max(float(np.std(rets[s][-20:])), 0.005) for s in closes}\n    peer = float(np.median(list(r5.values())))\n    raw = [dict() for _ in FACTOR_IDS]\n    for s, c in closes.items():\n        rr = rets[s][-20:]\n        downside = max(float(np.std(np.minimum(rr, 0.0))), 0.005)\n        peak = max(c[-21:])\n        trough = min(c[-11:])\n        # Compact causal proxies preserve the selected factor directions.\n        raw[0][s] = -r20[s] / vol[s]\n        raw[1][s] = -r5[s] / vol[s]\n        raw[2][s] = r5[s] - peer\n        raw[3][s] = r20[s] / downside\n        raw[5][s] = r20[s] / vol[s]\n        raw[6][s] = (c[-1] - min(c[-21:])) / max(max(c[-21:]) - min(c[-21:]), 1e-9)\n        raw[7][s] = (c[-1] / trough - 1.0) / vol[s]\n        raw[8][s] = -(r5[s] - r10[s]) / vol[s]\n\n    # VIX-shock resilience: when the observation-only VIX is stressed, reward assets\n    # that held up recently; otherwise use the same stable risk-adjusted return proxy.\n    vix = get_index_daily_data(symbol="VIX", days=25)\n    vix_shock = False\n    if vix is not None and len(vix) >= 6:\n        vc = np.asarray(vix.sort_values("date")["close"], dtype=float)\n        vix_shock = bool(np.isfinite(vc[-1]) and vc[-1] / max(vc[-6], 1e-9) - 1.0 > 0.08)\n    for s in closes:\n        raw[4][s] = (r10[s] / vol[s]) if vix_shock else (0.5 * r20[s] / vol[s])\n\n    ranked = [_rank(x) for x in raw]\n    score = {s: sum(FACTOR_WEIGHTS[i] * ranked[i][s] for i in range(9)) for s in UNIVERSE}\n    market_vol = float(np.median(list(vol.values())))\n    if r20.get("SPX", 0.0) < 0 or vol.get("SPX", market_vol) > 0.018 or vix_shock:\n        for s in ("XAU", "US10Y", "CN10Y"):\n            score[s] += 0.08\n        for s in ("BTC", "ETH", "WTI"):\n            score[s] *= 0.80\n    target = _weights(score)\n    z = np.array([score[s] for s in UNIVERSE], dtype=float)\n    z = (z - z.mean()) / max(float(z.std()), 1e-12)\n    forecast_returns = {s: float(0.006 * z[i]) for i, s in enumerate(UNIVERSE)}\n    rebalance_to_weights(target, forecast_returns=forecast_returns, factor_ids=FACTOR_IDS, horizon_days=10)\n    _last_decision = decision\n', 'file_path': 'strategy.py'})
