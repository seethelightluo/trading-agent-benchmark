  ▶️ write_file({'content': 'import numpy as np\nfrom alphacrafter.sim.utils import (\n    register_hook, get_account_dict, get_stock_daily_data, rebalance_to_weights,\n)\n\nUNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]\nFACTOR_IDS = [\n    "miner_2_range_efficiency_20d", "peer_median_leadlag_5d",\n    "miner_2_risk_adjusted_momentum_20d", "miner_3_20271005_relative_reversal_5d",\n    "miner_2_short_reversal_3d", "short_term_reversal_5d",\n]\nFACTOR_WEIGHTS = [0.22, 0.20, 0.18, 0.16, 0.14, 0.10]\nDIRECTIONS = [1, 1, 1, 1, 1, 1]\nREBALANCE_DAYS = 10\nlast_date = None\n\n\ndef ranks(x):\n    out = {s: 0.5 for s in UNIVERSE}\n    good = sorted((s, float(v)) for s, v in x.items() if np.isfinite(v))\n    n = len(good)\n    if n > 1:\n        for i, (s, _) in enumerate(good):\n            out[s] = (i + 1.0) / n\n    return out\n\n\ndef bounded(raw):\n    # Sixteen? No: exactly 15 assets, full investment, fractional weights.\n    w = {s: max(0.0, float(raw.get(s, 0.0))) for s in UNIVERSE}\n    # A 15-name universe supports broad diversification; cap concentration.\n    w = {s: max(0.02, min(0.14, v)) for s, v in w.items()}\n    for _ in range(30):\n        free = [s for s in UNIVERSE if 0.020001 < w[s] < 0.139999]\n        fixed = sum(w[s] for s in UNIVERSE if s not in free)\n        if not free:\n            break\n        rem = max(0.0, 1.0 - fixed)\n        total = sum(w[s] for s in free) or 1.0\n        for s in free:\n            w[s] = rem * w[s] / total\n        w = {s: max(0.02, min(0.14, v)) for s, v in w.items()}\n    z = sum(w.values())\n    return {s: w[s] / z for s in UNIVERSE}\n\n\n@register_hook\ndef cross_asset_strategy():\n    global last_date\n    account = get_account_dict()\n    market = {}\n    for s in UNIVERSE:\n        df = get_stock_daily_data(symbol=s, days=90)\n        if df is None or len(df) < 30:\n            continue\n        df = df.sort_values("date").reset_index(drop=True)\n        c = np.asarray(df["close"], dtype=float)\n        r = c[1:] / np.maximum(c[:-1], 1e-12) - 1.0\n        market[s] = (c, r, str(df.iloc[-1]["date"]))\n    if len(market) < 12:\n        return\n    decision = max(v[2] for v in market.values())\n    if last_date is not None:\n        try:\n            gap = (np.datetime64(decision, "D") - np.datetime64(last_date, "D")) / np.timedelta64(1, "D")\n            if gap < REBALANCE_DAYS:\n                return\n        except Exception:\n            return\n\n    five = {s: c[-1] / max(c[-6], 1e-12) - 1.0 for s, (c, _, _) in market.items()}\n    median5 = float(np.median(list(five.values())))\n    factors = [dict() for _ in FACTOR_IDS]\n    for s, (c, r, _) in market.items():\n        v20 = max(float(np.std(r[-20:])), 0.008)\n        ret20 = c[-1] / max(c[-21], 1e-12) - 1.0\n        # Proxies preserve the supplied factor directions and are all backward-looking.\n        factors[0][s] = abs(ret20) / (float(np.sum(np.abs(r[-20:]))) + 1e-12)\n        factors[1][s] = five[s] - median5\n        factors[2][s] = ret20 / v20\n        factors[3][s] = -(five[s] - median5)\n        factors[4][s] = -float(np.mean(r[-3:]))\n        factors[5][s] = -float(np.mean(r[-5:]))\n    rr = [ranks(x) for x in factors]\n    score = {s: sum(ww * q[s] for ww, q in zip(FACTOR_WEIGHTS, rr)) for s in UNIVERSE}\n\n    # Risk-off correction: remain fully invested but rotate toward tradable defensives.\n    if "SPX" in market:\n        c, r, _ = market["SPX"]\n        if c[-1] < c[-21] and float(np.std(r[-20:])) > 0.012:\n            for s in ("XAU", "US10Y", "CN10Y"):\n                score[s] += 0.10\n            for s in ("BTC", "ETH", "WTI"):\n                score[s] = max(0.01, score[s] - 0.05)\n\n    invvol = {s: 1.0 / max(float(np.std(market[s][1][-20:])), 0.008) for s in market}\n    mean_iv = float(np.mean(list(invvol.values())))\n    raw = {s: max(0.01, score[s]) * (0.85 + 0.15 * invvol.get(s, mean_iv) / mean_iv) for s in UNIVERSE}\n    weights = bounded(raw)\n    mean_score = float(np.mean(list(score.values())))\n    sd = max(float(np.std(list(score.values()))), 1e-12)\n    forecast_returns = {s: float(0.01 * (score[s] - mean_score) / sd) for s in UNIVERSE}\n    rebalance_to_weights(weights, forecast_returns=forecast_returns, factor_ids=FACTOR_IDS, horizon_days=10)\n    last_date = decision\n', 'file_path': 'strategy.py'})
