 import numpy as np
from alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights

UNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
FACTOR_IDS = [
    "peer_median_leadlag_5d", "miner_2_range_efficiency_20d",
    "miner_2_risk_adjusted_momentum_20d",
    "miner_3_20271102_volscaled_relative_reversal_5d",
    "miner_2_downside_efficiency_20d", "short_term_reversal_5d",
    "miner_2_short_reversal_3d"
]
FACTOR_WEIGHTS = [0.18, 0.18, 0.18, 0.16, 0.10, 0.10, 0.10]
REBALANCE_DAYS = 10
last_decision = None


def rank_map(values):
    good = sorted((s, float(v)) for s, v in values.items() if np.isfinite(v))
    out = {s: 0.5 for s in UNIVERSE}
    n = len(good)
    if n > 1:
        for i, (s, _) in enumerate(good):
            out[s] = (i + 1.0) / n
    return out


def bounded_weights(score):
    # Broad allocation is appropriate for a 15-name, sideways/high-risk universe.
    w = {s: max(0.025, float(score.get(s, 0.5))) for s in UNIVERSE}
    total = sum(w.values())
    w = {s: x / total for s, x in w.items()}
    for _ in range(25):
        capped = [s for s in UNIVERSE if w[s] > 0.13]
        if not capped:
            break
        excess = sum(w[s] - 0.13 for s in capped)
        for s in capped:
            w[s] = 0.13
        free = [s for s in UNIVERSE if s not in capped]
        base = sum(w[s] for s in free)
        if not free or base <= 0:
            break
        for s in free:
            w[s] += excess * w[s] / base
    total = sum(max(0.025, x) for x in w.values())
    return {s: float(max(0.025, w[s]) / total) for s in UNIVERSE}


@register_hook
def cross_asset_strategy():
    global last_decision
    data = {}
    for symbol in UNIVERSE:
        df = get_stock_daily_data(symbol=symbol, days=90)
        if df is None or len(df) < 30:
            continue
        df = df.sort_values("date").reset_index(drop=True)
        close = np.asarray(df["close"], dtype=float)
        if np.any(~np.isfinite(close[-30:])) or np.any(close[-30:] <= 0):
            continue
        volume = np.asarray(df["volume"], dtype=float) if "volume" in df else np.ones(len(df))
        data[symbol] = (close, volume, str(df.iloc[-1]["date"]))
    if len(data) < 12:
        return
    decision = max(x[2] for x in data.values())
    if last_decision is not None:
        try:
            if (np.datetime64(decision) - np.datetime64(last_decision)) / np.timedelta64(1, "D") < REBALANCE_DAYS:
                return
        except Exception:
            return

    ret5 = {s: c[-1] / c[-6] - 1.0 for s, (c, _, _) in data.items()}
    peer = float(np.median(list(ret5.values())))
    factors = [{} for _ in FACTOR_IDS]
    for s, (c, vol, _) in data.items():
        daily = c[1:] / np.maximum(c[:-1], 1e-12) - 1.0
        d20 = daily[-20:]
        sigma = max(float(np.std(d20)), 0.008)
        r20 = c[-1] / c[-21] - 1.0
        # Simple causal proxies, each preserving the ensemble's stated direction.
        factors[0][s] = ret5[s] - peer
        factors[1][s] = abs(r20) / max(float(np.sum(np.abs(d20))), 1e-8)
        factors[2][s] = r20 / sigma
        factors[3][s] = -(ret5[s] - peer) / sigma
        factors[4][s] = min(r20, 0.0) / sigma
        factors[5][s] = -float(np.mean(daily[-5:]))
        factors[6][s] = -float(np.mean(daily[-3:]))

    ranked = [rank_map(x) for x in factors]
    score = {s: sum(w * r[s] for w, r in zip(FACTOR_WEIGHTS, ranked)) for s in UNIVERSE}

    # Sideways but high-risk: full investment is retained, with defensive
    # tradable benchmarks absorbing risk instead of a cash sleeve.
    if "SPX" in data:
        c = data["SPX"][0]
        rr = c[1:] / np.maximum(c[:-1], 1e-12) - 1.0
        if c[-1] < c[-21] or np.std(rr[-20:]) > 0.018:
            for s in ("XAU", "US10Y", "CN10Y"):
                score[s] += 0.10
            for s in ("BTC", "ETH", "WTI"):
                score[s] *= 0.75

    weights = bounded_weights(score)
    vals = np.asarray([score[s] for s in UNIVERSE], dtype=float)
    scale = max(float(np.std(vals)), 1e-12)
    center = float(np.mean(vals))
    forecast_returns = {s: float(0.008 * (score[s] - center) / scale) for s in UNIVERSE}
    rebalance_to_weights(weights, forecast_returns=forecast_returns,
                         factor_ids=FACTOR_IDS, horizon_days=10)
    last_decision = decision

