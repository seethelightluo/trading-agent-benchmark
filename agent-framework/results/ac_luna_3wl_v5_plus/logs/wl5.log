for s in U:
 x=pd.read_csv('../persistent/stock_data/'+s+'.csv'); x.date=pd.to_datetime(x.date); x=x[x.date<=end].sort_values('date').set_index('date'); D[s]=x.close.astype(float)
p=pd.DataFrame(D).sort_index(); r=p.pct_change(); mom=p.pct_change(20); vol=r.rolling(20,min_periods=15).std()*np.sqrt(252)
# Contrarian risk-adjusted trend: favor assets whose 20d trend was weak after volatility normalization.
f=-mom/(vol+1e-8)
allr={}
for h in [1,5,10,20]:
 q=p.shift(-h)/p-1; rows=[]
 for dt in f.index:
  z=pd.concat([f.loc[dt],q.loc[dt]],axis=1).dropna()
  if len(z)>=8: rows.append((dt,spearmanr(z.iloc[:,0],z.iloc[:,1]).statistic,len(z)))
 a=pd.DataFrame(rows,columns=['date','ic','n']).set_index('date'); allr[h]=a
 print('h',h,'dates',len(a),'mean_n',round(a.n.mean(),2),'coverage',round(a.n.mean()/15,4),'IC',round(a.ic.mean(),6),'ICIR',round(a.ic.mean()/a.ic.std(ddof=1),6),'hit',round((a.ic>0).mean(),4))
 for label,x in [('2026-27',a.loc['2026':'2027']),('2027-28',a.loc['2027':'2028'])]:
