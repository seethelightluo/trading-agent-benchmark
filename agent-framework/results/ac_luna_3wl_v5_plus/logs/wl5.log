rn\n    decision = max(v[2] for v in data.values())\n    if last_date is not None:\n        try:\n            elapsed = (np.datetime64(decision) - np.datetime64(last_date)) / np.timedelta64(1, "D")\n            if elapsed < REBALANCE_DAYS: return\n        except Exception: return\n\n    ret5 = {s: c[-1] / c[-6] - 1.0 for s, (c, r, _) in data.items() if len(c) >= 7}\n    median5 = float(np.median(list(ret5.values())))\n    factors = {\n        "peer_median_leadlag_5d": {s: v - median5 for s, v in ret5.items()},\n        "short_term_reversal_5d": {s: -v for s, v in ret5.items()},\n        "miner_2_risk_adjusted_momentum_20d": {\n            s: (c[-1] / c[-21] - 1.0) / max(float(np.std(r[-20:])), 0.008)\n            for s, (c, r, _) in data.items() if len(c) >= 22\n        },\n        "miner_3_intraday_reversal_1d": {s: -r[-1] for s, (c, r, _) in data.items() if len(r) >= 1},\n        "miner_2_short_reversal_3d": {s: -(c[-1] / c[-4] - 1.0) for s, (c, r, _) in data.items() if len(c) >= 5},\n    }\n    ensemble_path = Path(__file__).parent / "factors" / "factor_ensemble.json"\n    try:\n        ensemble = json.loads(ensemble_path.read_text())\n        selected = ensemble.get("selected_factors", [])[:10]\n    except (OSError, ValueError, TypeError):\n        return\n    scores = {s: 0.0 for s in UNIVERSE}\n    for item in selected:\n        fid, wt, direction = item.get("factor_id"), float(item.get("weight", 0.0)), float(item.get("direction", 1))\n        if fid in factors:\n            rr = rank_factor(factors[fid])\n            for s in UNIVERSE: scores[s] += wt * direction * rr[s]\n    # Bullish but choppy: retain broad exposure and modestly reward defensive assets.\n    if "SPX" in data:\n        spx = data["SPX"][0]\n        if spx[-1] < spx[-21] or spx[-1] < spx[-6]:\n            for s in ("XAU", "US10Y", "CN10Y"): scores[s] += 0.10\n            for s in ("BTC", "ETH", "WTI"): scores[s] -= 0.04\n    vols = {s: max(float(np.std(r[-20:])), 0.008) for s, (c, r, _) in data.items()}\n    medvol = float(np.median(list(vols.values())))\n    raw = {s: max(0.01, scores[s]) * (0.85 + 0.15 * medvol / vols.get(s, medvol)) for s in UNIVERSE}\n    weights = project(raw)\n    mean, std = float(np.mean(list(scores.values()))), float(np.std(list(scores.values())))\n    forecast = {s: 0.01 * (scores[s] - mean) / max(std, 1e-9) for s in UNIVERSE}\n    factor_ids = [str(x.get("factor_id")) for x in selected if x.get("factor_id") in factors]\n    rebalance_to_weights(weights, forecast_returns=forecast, factor_ids=factor_ids[:10], horizon_days=10)\n    last_date = decision\n', 'file_path': 'strategy.py'})
