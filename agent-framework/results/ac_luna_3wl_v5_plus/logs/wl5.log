 import numpy as np
from alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights

UNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
FACTOR_IDS = ["miner_2_range_efficiency_20d", "peer_median_leadlag_5d", "miner_2_risk_adjusted_momentum_20d", "miner_3_20271005_relative_reversal_5d", "miner_2_short_reversal_3d", "short_term_reversal_5d"]
FACTOR_WEIGHTS = [0.22, 0.20, 0.18, 0.16, 0.14, 0.10]
REBALANCE_DAYS = 10
last_date = None


def ranks(x):
    good = sorted((s, float(v)) for s, v in x.items() if np.isfinite(v))
    out = {s: 0.5 for s in UNIVERSE}
    if len(good) > 1:
        for i, (s, _) in enumerate(good): out[s] = (i + 1.0) / len(good)
    return out


def simplex(raw):
    floor, cap = 0.025, 0.13
    w = {s: float(raw.get(s, 1.0 / 15.0)) for s in UNIVERSE}
    if any(not np.isfinite(v) or v < 0 for v in w.values()):
        w = {s: 1.0 / 15.0 for s in UNIVERSE}
    w = {s: max(floor, min(cap, v)) for s, v in w.items()}
    # Iterative capped/floored proportional allocation.
    for _ in range(50):
        low = {s for s in UNIVERSE if w[s] <= floor + 1e-12}
        high = {s for s in UNIVERSE if w[s] >= cap - 1e-12}
        free = [s for s in UNIVERSE if s not in low and s not in high]
        rem = 1.0 - sum(w[s] for s in low) - sum(w[s] for s in high)
        if not free or rem <= 0: break
        base = sum(w[s] for s in free)
        for s in free: w[s] = rem * w[s] / max(base, 1e-12)
    total = sum(w.values())
    if not np.isfinite(total) or total <= 0: return {s: 1.0 / 15.0 for s in UNIVERSE}
    return {s: float(w[s] / total) for s in UNIVERSE}


@register_hook
def cross_asset_strategy():
    global last_date
    data = {}
    for s in UNIVERSE:
        df = get_stock_daily_data(symbol=s, days=90)
        if df is None or len(df) < 30: continue
        df = df.sort_values("date").reset_index(drop=True)
        c = np.asarray(df.close, dtype=float)
        if len(c) < 30 or not np.all(np.isfinite(c[-30:])) or np.any(c[-30:] <= 0): continue
        r = c[1:] / np.maximum(c[:-1], 1e-12) - 1.0
        data[s] = (c, r, str(df.iloc[-1].date))
    if len(data) < 12: return
    decision = max(v[2] for v in data.values())
    if last_date is not None:
        try:
            if (np.datetime64(decision) - np.datetime64(last_date)) / np.timedelta64(1, "D") < REBALANCE_DAYS: return
        except Exception: return
    ret5 = {s: c[-1] / c[-6] - 1 for s, (c, r, _) in data.items()}
    med5 = float(np.median(list(ret5.values())))
    lead = {s: v - med5 for s, v in ret5.items()}
    range_eff, mom, relrev, rev3, rev5, invvol = {}, {}, {}, {}, {}, {}
    for s, (c, r, _) in data.items():
        v20 = max(float(np.std(r[-20:])), 0.008)
        range_eff[s] = abs(c[-1] / c[-21] - 1) / (float(np.sum(np.abs(r[-20:]))) + 1e-12)
        mom[s] = (c[-1] / c[-21] - 1) / v20
        relrev[s] = -(ret5[s] - med5)
        rev3[s] = -float(np.mean(r[-3:]))
        rev5[s] = -float(np.mean(r[-5:]))
        invvol[s] = 1.0 / v20
    factor_ranks = [ranks(x) for x in (range_eff, lead, mom, relrev, rev3, rev5)]
    score = {s: sum(w * q[s] for w, q in zip(FACTOR_WEIGHTS, factor_ranks)) for s in UNIVERSE}
    if "SPX" in data:
        c, r, _ = data["SPX"]
        if float(np.std(r[-20:])) > 0.018 or c[-1] < c[-21]:
            for s in ("XAU", "US10Y", "CN10Y"): score[s] += 0.10
            for s in ("BTC", "ETH", "WTI"): score[s] -= 0.05
    mean_iv = float(np.mean(list(invvol.values())))
    raw = {s: max(0.01, score.get(s, 0.5)) * (0.88 + 0.12 * invvol.get(s, mean_iv) / mean_iv) for s in UNIVERSE}
    weights = simplex(raw)
    a = np.array([score.get(s, 0.5) for s in UNIVERSE], dtype=float)
    z = max(float(np.std(a)), 1e-12)
    forecast_returns = {s: float(0.008 * (score.get(s, 0.5) - float(np.mean(a))) / z) for s in UNIVERSE}
    rebalance_to_weights(weights, forecast_returns=forecast_returns, factor_ids=FACTOR_IDS, horizon_days=10)
    last_date = decision


