{"file_path":"scripts/miner_1_20271203_vix_conditioned_reversal.py","content":"import numpy as np, pandas as pd\nU=['000300.SH','SPX','HSI','N225','SX5E','000688.SH','SOX','NDX','XAU','COPPER','WTI','BTC','ETH','US10Y','CN10Y']\npx={}\nfor s in U:\n d=pd.read_csv('../persistent/stock_data/'+s+'.csv'); d['date']=pd.to_datetime(d.date); px[s]=pd.to_numeric(d.set_index('date')['close'],errors='coerce')\nP=pd.DataFrame(px).sort_index(); P=P[~P.index.duplicated(keep='last')].ffill()\nv=pd.read_csv('../persistent/index_data/VIX.csv'); v['date']=pd.to_datetime(v.date); v=v.set_index('date')['close']; v=v[~v.index.duplicated(keep='last')].reindex(P.index).ffill()\nrv=P.pct_change(5); vz=(v-v.rolling(60).mean())/v.rolling(60).std(); f=-rv*(1+0.75*vz.clip(lower=0,upper=2)); fr=P.shift(-10)/P-1\nrows=[]; dates=[]; nobs=[]\nfor dt in f.index:\n a=f.loc[dt]; b=fr.loc[dt]; ok=a.notna()&b.notna()\n if ok.sum()>=8:\n  q=a[ok].rank().corr(b[ok].rank())\n  if pd.notna(q): rows.append(q); dates.append(dt); nobs.append(ok.sum())\nic=np.array(rows,float); mean=float(np.mean(ic)); sd=float(np.std(ic,ddof=1)); icir=mean/sd*np.sqrt(252) if sd else np.nan; turn=float(f.rank(pct=True,axis=1).diff().abs().mean(axis=1).mean())\nprint({'factor':'vix_conditioned_reversal_5d','dates':len(ic),'start':str(dates[0].date()),'end':str(dates[-1].date()),'avg_instruments':float(np.mean(nobs)),'coverage':float(np.mean(nobs)/15),'ic':mean,'icir':icir,'hit_ratio':float(np.mean(ic>0)),'turnover':turn,'decay':'10-day forward horizon'})\nfor label,mask in [('pre2025',np.array([d.year<2025 for d in dates])),('2025plus',np.array([d.year>=2025 for d in dates]))]:\n x=ic[mask]; print(label,len(x),float(np.mean(x)) if len(x) else None,float(np.mean(x)/np.std(x,ddof=1)*np.sqrt(252)) if len(x)>1 else None)\n"}providername":"functions.write_file"}行 天天中彩票中奖 to=functions.exec_sync code (json)...
