  ▶️ write_file({'content': 'import numpy as np\nfrom alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights\n\nUNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]\nFACTOR_IDS = [\n    "miner_1_20271217_volnorm_reversal_5d",\n    "miner_2_range_efficiency_20d",\n    "peer_median_leadlag_5d",\n    "miner_2_downside_efficiency_20d",\n    "miner_2_risk_adjusted_momentum_20d",\n]\nFACTOR_WEIGHTS = [0.24, 0.22, 0.19, 0.18, 0.17]\nFACTOR_DIRECTIONS = [1, 1, 1, 1, 1]\nlast_decision = None\n\n\ndef rank_cross_section(values):\n    valid = sorted((s, float(v)) for s, v in values.items() if np.isfinite(v))\n    out = {s: 0.5 for s in UNIVERSE}\n    if len(valid) > 1:\n        for i, (s, _) in enumerate(valid):\n            out[s] = (i + 1.0) / len(valid)\n    return out\n\n\ndef bounded_weights(scores):\n    # Full investment, diversified across the deliberately small 15-asset universe.\n    lo, hi = 0.025, 0.13\n    x = np.asarray([max(float(scores[s]), 1e-9) for s in UNIVERSE])\n    w = x / x.sum()\n    for _ in range(100):\n        fixed = (w < lo) | (w > hi)\n        nw = np.clip(w, lo, hi)\n        free = ~fixed\n        if free.any():\n            rem = 1.0 - nw[fixed].sum()\n            nw[free] = w[free] / max(w[free].sum(), 1e-12) * rem\n        if np.max(np.abs(nw - w)) < 1e-12:\n            w = nw\n            break\n        w = nw\n    w = np.clip(w, lo, hi)\n    w /= w.sum()\n    return {s: float(v) for s, v in zip(UNIVERSE, w)}\n\n\n@register_hook\ndef cross_asset_strategy():\n    global last_decision\n    data = {}\n    for symbol in UNIVERSE:\n        df = get_stock_daily_data(symbol=symbol, days=100)\n        if df is None or len(df) < 35:\n            continue\n        df = df.sort_values("date").reset_index(drop=True)\n        close = np.asarray(df["close"], dtype=float)\n        if len(close) < 25 or np.any(~np.isfinite(close[-25:])) or np.any(close[-25:] <= 0):\n            continue\n        data[symbol] = (close, str(df.iloc[-1]["date"]))\n    if len(data) < 12:\n        return\n\n    decision_date = max(v[1] for v in data.values())\n    if last_decision is not None:\n        try:\n            if (np.datetime64(decision_date) - np.datetime64(last_decision)) / np.timedelta64(1, "D") < 10:\n                return\n        except Exception:\n            return\n\n    daily, ret3, ret5, ret20, vol5, vol20 = {}, {}, {}, {}, {}, {}\n    for s, (close, _) in data.items():\n        r = close[1:] / np.maximum(close[:-1], 1e-12) - 1.0\n        daily[s] = r\n        ret3[s] = close[-1] / close[-4] - 1.0\n        ret5[s] = close[-1] / close[-6] - 1.0\n        ret20[s] = close[-1] / close[-21] - 1.0\n        vol5[s] = max(float(np.std(r[-5:])), 0.005)\n        vol20[s] = max(float(np.std(r[-20:])), 0.005)\n\n    peer = float(np.median(list(ret5.values())))\n    raw = [{} for _ in FACTOR_IDS]\n    for s in data:\n        r = daily[s]\n        # Causal proxies matching the persisted factor definitions.\n        raw[0][s] = -ret5[s] / vol5[s]                         # vol-normalized reversal\n        raw[1][s] = abs(ret20[s]) / max(float(np.sum(np.abs(r[-20:]))), 1e-9)\n        raw[2][s] = ret5[s] - peer                              # peer lead-lag\n        downside = max(float(np.std(np.minimum(r[-20:], 0.0))), 0.005)\n        raw[3][s] = ret20[s] / downside                        # downside efficiency\n        raw[4][s] = ret20[s] / vol20[s]                        # risk-adjusted momentum\n\n    ranked = [rank_cross_section(x) for x in raw]\n    score = {s: sum(w * d * ranked[i][s] for i, (w, d) in enumerate(zip(FACTOR_WEIGHTS, FACTOR_DIRECTIONS))) for s in UNIVERSE}\n\n    # Medium/high-risk recovery: retain full exposure but bias weak-score portfolios defensively.\n    if "SPX" in data:\n        spx_r = daily["SPX"]\n        stressed = data["SPX"][0][-1] < data["SPX"][0][-21] or np.std(spx_r[-20:]) > 0.018\n        if stressed:\n            for s in ("XAU", "US10Y", "CN10Y"):\n                score[s] += 0.08\n            for s in ("BTC", "ETH", "WTI"):\n                score[s] *= 0.80\n\n    target = bounded_weights(score)\n    vals = np.asarray([score[s] for s in UNIVERSE], dtype=float)\n    z = (vals - vals.mean()) / max(float(vals.std()), 1e-12)\n    forecast_returns = {s: float(0.008 * z[i]) for i, s in enumerate(UNIVERSE)}\n    rebalance_to_weights(target, forecast_returns=forecast_returns, factor_ids=FACTOR_IDS, horizon_days=10)\n    last_decision = decision_date\n', 'file_path': 'strategy.py'})

