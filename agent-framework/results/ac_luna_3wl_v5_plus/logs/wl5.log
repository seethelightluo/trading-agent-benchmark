import numpy as np
from alphacrafter.sim.utils import register_hook, get_stock_daily_data, get_index_daily_data, rebalance_to_weights

UNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
FACTOR_IDS = [
    "miner_2_20280128_contrarian_risk_adjusted_trend_20d",
    "miner_2_20280215_volneutral_recovery_10d",
    "miner_3_20271217_volscaled_reversal_3d",
    "miner_2_20271217_vix_shock_resilience_10d",
    "miner_3_20280114_risk_momentum_20d",
    "miner_2_channel_trend_20d",
    "miner_2_downside_efficiency_20d",
]
FACTOR_WEIGHTS = np.array([0.34, 0.26, 0.13, 0.10, 0.08, 0.05, 0.04])
_last_decision = None


def cross_rank(values):
    finite = sorted((s, float(v)) for s, v in values.items() if np.isfinite(v))
    out = {s: 0.5 for s in UNIVERSE}
    n = len(finite)
    if n:
        for i, (s, _) in enumerate(finite):
            out[s] = (i + 1.0) / n if n > 1 else 0.5
    return out


def make_weights(score):
    # Full investment, broad bounds suited to a 15-asset high-risk cross-section.
    x = np.array([max(float(score.get(s, 0.5)), 1e-6) for s in UNIVERSE])
    x /= x.sum()
    lo, hi = 0.03, 0.14
    for _ in range(30):
        fixed_low = x < lo
        fixed_high = x > hi
        fixed = fixed_low | fixed_high
        if not fixed.any():
            break
        y = np.clip(x, lo, hi)
        remainder = 1.0 - y[fixed].sum()
        free = ~fixed
        if free.any() and remainder > 0:
            y[free] = x[free] / x[free].sum() * remainder
        x = y
    x = np.maximum(x, 0.0)
    x /= x.sum()
    return {s: float(w) for s, w in zip(UNIVERSE, x)}


@register_hook
def cross_asset_strategy():
    global _last_decision
    closes, rets, dates = {}, {}, {}
    for s in UNIVERSE:
        df = get_stock_daily_data(symbol=s, days=125)
        if df is None or len(df) < 65:
            continue
        df = df.sort_values("date")
        c = np.asarray(df["close"], dtype=float)
        if np.all(np.isfinite(c[-65:])) and np.all(c[-65:] > 0):
            closes[s] = c
            rets[s] = c[1:] / c[:-1] - 1.0
            dates[s] = str(df.iloc[-1]["date"])
    if len(closes) < 12:
        return
    decision = max(dates.values())
    if _last_decision is not None:
        try:
            gap = (np.datetime64(decision) - np.datetime64(_last_decision)) / np.timedelta64(1, "D")
            if gap < 10:
                return
        except Exception:
            return

    r3 = {s: closes[s][-1] / closes[s][-4] - 1.0 for s in closes}
    r10 = {s: closes[s][-1] / closes[s][-11] - 1.0 for s in closes}
    r20 = {s: closes[s][-1] / closes[s][-21] - 1.0 for s in closes}
    vol = {s: max(float(np.std(rets[s][-20:])), 0.005) for s in closes}
    down = {s: max(float(np.std(np.minimum(rets[s][-20:], 0.0))), 0.005) for s in closes}
    raw = [dict() for _ in FACTOR_IDS]
    for s, c in closes.items():
        lo10, lo20, hi20 = min(c[-11:]), min(c[-21:]), max(c[-21:])
        # Causal proxies preserve the screener directions and factor intent.
        raw[0][s] = -r20[s] / vol[s]
        raw[1][s] = (c[-1] / lo10 - 1.0) / vol[s]
        raw[2][s] = -r3[s] / vol[s]
        raw[4][s] = r20[s] / vol[s]
        raw[5][s] = (c[-1] - lo20) / max(hi20 - lo20, 1e-9)
        raw[6][s] = r20[s] / down[s]

    vix = get_index_daily_data(symbol="VIX", days=25)
    shock = False
    if vix is not None and len(vix) >= 6:
        vc = np.asarray(vix.sort_values("date")["close"], dtype=float)
        shock = bool(np.isfinite(vc[-1]) and vc[-1] / max(vc[-6], 1e-9) - 1.0 > 0.08)
    for s in closes:
        # Resilience proxy: reward positive recent performance during a VIX shock,
        # otherwise favor steadier (risk-adjusted) recent performance.
        raw[3][s] = (r10[s] / vol[s]) if shock else (-0.5 * r20[s] / vol[s] - vol[s])

    ranks = [cross_rank(v) for v in raw]
    score = {s: sum(FACTOR_WEIGHTS[i] * ranks[i][s] for i in range(len(FACTOR_IDS))) for s in UNIVERSE}
    spx20 = r20.get("SPX", 0.0)
    if shock or spx20 < 0.0 or vol.get("SPX", 0.0) > 0.018:
        for s in ("XAU", "US10Y", "CN10Y"):
            score[s] += 0.07
        for s in ("BTC", "ETH", "WTI"):
            score[s] *= 0.82
    target = make_weights(score)
    z = np.array([score[s] for s in UNIVERSE], dtype=float)
    z = (z - z.mean()) / max(float(z.std()), 1e-12)
    forecast_returns = {s: float(0.006 * z[i]) for i, s in enumerate(UNIVERSE)}
    rebalance_to_weights(target, forecast_returns=forecast_returns, factor_ids=FACTOR_IDS, horizon_days=10)
    _last_decision = decision

