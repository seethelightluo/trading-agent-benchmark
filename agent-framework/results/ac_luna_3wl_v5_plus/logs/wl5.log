 import numpy as np
from alphacrafter.sim.utils import register_hook, get_stock_daily_data, rebalance_to_weights

UNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
FACTOR_IDS = [
    "peer_median_leadlag_5d", "short_term_reversal_5d",
    "miner_3_20271102_volscaled_relative_reversal_5d",
    "miner_2_risk_adjusted_momentum_20d",
    "miner_3_20271005_relative_reversal_5d", "miner_2_short_reversal_3d",
    "miner_2_20271102_volume_pressure_reversal_1d"
]
FACTOR_WEIGHTS = [0.22, 0.20, 0.18, 0.15, 0.10, 0.08, 0.07]
REBALANCE_DAYS = 10
last_decision = None


def rank(values):
    valid = sorted((s, float(v)) for s, v in values.items() if np.isfinite(v))
    out = {s: 0.5 for s in UNIVERSE}
    n = len(valid)
    if n > 1:
        for i, (s, _) in enumerate(valid):
            out[s] = (i + 1.0) / n
    return out


def make_weights(score):
    # Full investment, deliberately broad in a 15-name universe.
    raw = {s: max(0.02, score.get(s, 0.5)) for s in UNIVERSE}
    total = sum(raw.values())
    w = {s: raw[s] / total for s in UNIVERSE}
    # Bound concentration and redistribute excess until stable.
    for _ in range(20):
        excess = sum(max(0.0, x - 0.13) for x in w.values())
        if excess < 1e-10:
            break
        free = [s for s in UNIVERSE if w[s] < 0.13 - 1e-10]
        for s in UNIVERSE:
            if w[s] > 0.13:
                w[s] = 0.13
        base = sum(w[s] for s in free)
        if base <= 0:
            break
        for s in free:
            w[s] += excess * w[s] / base
    # A small floor avoids accidental zero exposure in risk-off conditions.
    for s in UNIVERSE:
        w[s] = max(0.025, w[s])
    z = sum(w.values())
    return {s: float(w[s] / z) for s in UNIVERSE}


@register_hook
def cross_asset_strategy():
    global last_decision
    data = {}
    for symbol in UNIVERSE:
        df = get_stock_daily_data(symbol=symbol, days=90)
        if df is None or len(df) < 30:
            continue
        df = df.sort_values("date").reset_index(drop=True)
        close = np.asarray(df["close"], dtype=float)
        if np.any(~np.isfinite(close[-30:])) or np.any(close[-30:] <= 0):
            continue
        volume = np.asarray(df["volume"], dtype=float) if "volume" in df else np.ones(len(df))
        data[symbol] = (close, volume, str(df.iloc[-1]["date"]))
    if len(data) < 12:
        return

    decision = max(v[2] for v in data.values())
    if last_decision is not None:
        try:
            elapsed = (np.datetime64(decision) - np.datetime64(last_decision)) / np.timedelta64(1, "D")
            if elapsed < REBALANCE_DAYS:
                return
        except Exception:
            return

    five_day = {s: c[-1] / c[-6] - 1.0 for s, (c, _, _) in data.items()}
    median5 = float(np.median(list(five_day.values())))
    lead, reversal5, volrelrev5, momentum20, reversal3, volume_reversal = ({}, {}, {}, {}, {}, {})
    invvol = {}
    for s, (c, vol, _) in data.items():
        daily = c[1:] / np.maximum(c[:-1], 1e-12) - 1.0
        sigma = max(float(np.std(daily[-20:])), 0.008)
        invvol[s] = 1.0 / sigma
        lead[s] = five_day[s] - median5
        reversal5[s] = -float(np.mean(daily[-5:]))
        volrelrev5[s] = -(five_day[s] - median5) / sigma
        momentum20[s] = (c[-1] / c[-21] - 1.0) / sigma
        reversal3[s] = -float(np.mean(daily[-3:]))
        # High-volume down days receive a stronger reversal score.
        vbase = max(float(np.mean(vol[-20:])), 1e-12)
        volume_reversal[s] = -float(daily[-1]) * max(0.5, min(2.0, float(vol[-1]) / vbase))

    factors = [lead, reversal5, volrelrev5, momentum20,
               {s: -(five_day[s] - median5) for s in data}, reversal3, volume_reversal]
    ranked = [rank(x) for x in factors]
    score = {s: sum(weight * r[s] for weight, r in zip(FACTOR_WEIGHTS, ranked)) for s in UNIVERSE}

    # Bear/high-volatility posture: stay fully invested but prefer defensive tradables.
    if "SPX" in data:
        c, _, _ = data["SPX"]
        rr = c[1:] / np.maximum(c[:-1], 1e-12) - 1.0
        if c[-1] < c[-21] or np.std(rr[-20:]) > 0.018:
            for s in ("XAU", "US10Y", "CN10Y"):
                score[s] += 0.12
            for s in ("BTC", "ETH", "WTI"):
                score[s] *= 0.72

    weights = make_weights(score)
    score_array = np.array([score[s] for s in UNIVERSE], dtype=float)
    scale = max(float(np.std(score_array)), 1e-12)
    center = float(np.mean(score_array))
    forecast_returns = {s: float(0.008 * (score[s] - center) / scale) for s in UNIVERSE}
    rebalance_to_weights(weights, forecast_returns=forecast_returns,
                          factor_ids=FACTOR_IDS, horizon_days=10)
    last_decision = decision


