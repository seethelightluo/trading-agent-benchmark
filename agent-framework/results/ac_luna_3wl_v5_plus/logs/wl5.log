 import numpy as np
from alphacrafter.sim.utils import (register_hook, get_stock_daily_data,
    get_index_daily_data, rebalance_to_weights)

UNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
FACTOR_IDS = [
    "miner_2_20280128_contrarian_risk_adjusted_trend_20d",
    "miner_2_20280215_volneutral_recovery_10d",
    "miner_2_20260716_risk_adjusted_momentum_20d",
    "miner_2_downside_efficiency_20d",
    "miner_2_range_efficiency_20d",
    "miner_2_20271217_vix_shock_resilience_10d",
    "miner_1_20280229_dispersion_conditioned_relative_reversal_3d",
    "miner_3_20280114_risk_momentum_20d",
]
FACTOR_WEIGHTS = np.array([.28, .22, .12, .10, .10, .09, .05, .04])
FACTOR_DIRECTIONS = [1] * 8
_last_decision = None

def rank(values):
    good = sorted((s, float(v)) for s, v in values.items() if np.isfinite(v))
    out = {s: .5 for s in UNIVERSE}
    n = len(good)
    for i, (s, _) in enumerate(good):
        out[s] = (i + 1) / n if n > 1 else .5
    return out

def full_weights(score):
    # Full investment, with sensible diversification for a 15-asset universe.
    x = np.array([max(float(score.get(s, .5)), 1e-9) for s in UNIVERSE])
    x /= x.sum()
    lo, hi = .03, .14
    for _ in range(20):
        y = np.clip(x, lo, hi)
        fixed = (y == lo) | (y == hi)
        free = ~fixed
        if not free.any():
            break
        remainder = 1.0 - y[fixed].sum()
        y[free] = x[free] / x[free].sum() * remainder
        if np.max(np.abs(y - x)) < 1e-10:
            break
        x = y
    y = np.maximum(y, 0.0)
    y /= y.sum()
    return {s: float(w) for s, w in zip(UNIVERSE, y)}

@register_hook
def cross_asset_strategy():
    global _last_decision
    close, dret, dates = {}, {}, {}
    for s in UNIVERSE:
        df = get_stock_daily_data(symbol=s, days=140)
        if df is None or len(df) < 65:
            continue
        df = df.sort_values("date")
        c = np.asarray(df["close"], dtype=float)
        if np.all(np.isfinite(c[-65:])) and np.all(c[-65:] > 0):
            close[s] = c
            dret[s] = c[1:] / c[:-1] - 1.0
