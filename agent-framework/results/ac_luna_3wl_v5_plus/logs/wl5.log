  ▶️ write_file({'content': 'import numpy as np\nfrom alphacrafter.sim.utils import (\n    register_hook, get_stock_daily_data, get_index_daily_data, rebalance_to_weights\n)\n\nUNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]\nFACTOR_IDS = [\n    "miner_2_20280128_contrarian_risk_adjusted_trend_20d",\n    "miner_2_20280215_volneutral_recovery_10d",\n    "miner_3_20280114_risk_momentum_20d",\n    "miner_2_20271217_vix_shock_resilience_10d",\n    "miner_2_channel_trend_20d",\n    "miner_2_downside_efficiency_20d",\n    "miner_2_20280225_volconditioned_drawdown_recovery_10d",\n    "miner_2_20271018_lowvol_20d",\n]\nFACTOR_WEIGHTS = [0.30, 0.24, 0.12, 0.10, 0.08, 0.06, 0.06, 0.04]\nFACTOR_DIRECTIONS = [1] * 8\n_last_decision = None\n\n\ndef rank_factor(values):\n    good = sorted((s, float(v)) for s, v in values.items() if np.isfinite(v))\n    out = {s: 0.5 for s in UNIVERSE}\n    if len(good) > 1:\n        for i, (s, _) in enumerate(good):\n            out[s] = (i + 1.0) / len(good)\n    return out\n\n\ndef bounded_weights(score):\n    # Broad 15-asset allocation; no cash sleeve and no concentration in this high-risk regime.\n    lo, hi = 0.025, 0.13\n    w = np.array([max(score.get(s, 0.5), 1e-8) for s in UNIVERSE], dtype=float)\n    w /= w.sum()\n    for _ in range(30):\n        clipped = np.clip(w, lo, hi)\n        free = (w > lo) & (w < hi)\n        if free.any():\n            clipped[free] *= (1.0 - clipped[~free].sum()) / max(clipped[free].sum(), 1e-12)\n        if np.max(np.abs(clipped - w)) < 1e-10:\n            w = clipped\n            break\n        w = clipped\n    w = np.clip(w, lo, hi)\n    w /= w.sum()\n    return {s: float(x) for s, x in zip(UNIVERSE, w)}\n\n\n@register_hook\ndef cross_asset_strategy():\n    global _last_decision\n    closes, returns = {}, {}\n    for s in UNIVERSE:\n        df = get_stock_daily_data(symbol=s, days=120)\n        if df is None or len(df) < 65:\n            continue\n        c = np.asarray(df.sort_values("date")["close"], dtype=float)\n        if np.all(np.isfinite(c[-65:])) and np.all(c[-65:] > 0):\n            closes[s] = c\n            returns[s] = c[1:] / c[:-1] - 1.0\n    if len(closes) < 12:\n        return\n    # Hook is called daily; make one proposal per ten-trading-day block.\n    decision = str(get_stock_daily_data(symbol=next(iter(closes)), days=2).iloc[-1]["date"])\n    if _last_decision is not None:\n        try:\n            if (np.datetime64(decision) - np.datetime64(_last_decision)) / np.timedelta64(1, "D") < 10:\n                return\n        except Exception:\n            return\n\n    r3 = {s: c[-1] / c[-4] - 1.0 for s, c in closes.items()}\n    r5 = {s: c[-1] / c[-6] - 1.0 for s, c in closes.items()}\n    r10 = {s: c[-1] / c[-11] - 1.0 for s, c in closes.items()}\n    r20 = {s: c[-1] / c[-21] - 1.0 for s, c in closes.items()}\n    vol = {s: max(float(np.std(returns[s][-20:])), 0.005) for s in closes}\n    raw = [dict() for _ in FACTOR_IDS]\n    peer = float(np.median(list(r5.values())))\n    for s, c in closes.items():\n        downside = max(float(np.std(np.minimum(returns[s][-20:], 0.0))), 0.005)\n        lo20, hi20 = min(c[-21:]), max(c[-21:])\n        recovery = c[-1] / max(min(c[-11:]), 1e-12) - 1.0\n        raw[0][s] = -r20[s] / vol[s]                 # contrarian risk-adjusted trend\n        raw[1][s] = -r10[s] / vol[s] + 0.5 * recovery / vol[s]\n        raw[2][s] = r20[s] / vol[s]                  # risk momentum\n        raw[4][s] = (c[-1] - lo20) / max(hi20 - lo20, 1e-12)  # channel trend\n        raw[5][s] = r20[s] / downside                # downside efficiency proxy\n        raw[6][s] = recovery / vol[s]                # drawdown recovery\n        raw[7][s] = -vol[s]                           # low volatility\n\n    vix = get_index_daily_data(symbol="VIX", days=25)\n    shock = False\n    if vix is not None and len(vix) >= 6:\n        vc = np.asarray(vix.sort_values("date")["close"], dtype=float)\n        shock = bool(np.isfinite(vc[-1]) and vc[-1] / max(vc[-6], 1e-12) - 1.0 > 0.08)\n    for s in closes:\n        raw[3][s] = (r10[s] / vol[s]) if shock else (0.5 * r20[s] / vol[s])\n\n    ranked = [rank_factor(x) for x in raw]\n    score = {s: sum(FACTOR_WEIGHTS[i] * ranked[i][s] for i in range(8)) for s in UNIVERSE}\n    # Sideways/high-risk posture: retain full investment but tilt toward tradable defensives.\n    if r20.get("SPX", 0.0) < 0 or shock or vol.get("SPX", 0.0) > 0.018:\n        for s in ("XAU", "US10Y", "CN10Y"):\n            score[s] += 0.08\n        for s in ("BTC", "ETH", "WTI"):\n            score[s] *= 0.80\n    target = bounded_weights(score)\n    z = np.array([score[s] for s in UNIVERSE], dtype=float)\n    z = (z - z.mean()) / max(float(z.std()), 1e-12)\n    forecast_returns = {s: float(0.006 * z[i]) for i, s in enumerate(UNIVERSE)}\n    rebalance_to_weights(target, forecast_returns=forecast_returns, factor_ids=FACTOR_IDS, horizon_days=10)\n    _last_decision = decision\n', 'file_path': 'strategy.py'})
