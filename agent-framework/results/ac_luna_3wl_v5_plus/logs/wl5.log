        data[symbol] = (close, volume, str(df.iloc[-1]["date"]))
    if len(data) < 12:
        return

    decision = max(v[2] for v in data.values())
    if last_decision is not None:
        try:
            if (np.datetime64(decision) - np.datetime64(last_decision)) / np.timedelta64(1, "D") < REBALANCE_DAYS:
                return
        except Exception:
            return

    five = {s: c[-1] / c[-6] - 1.0 for s, (c, _, _) in data.items()}
    peer = float(np.median(list(five.values())))
    f = [{} for _ in FACTOR_IDS]
    for s, (c, vol, _) in data.items():
        daily = c[1:] / np.maximum(c[:-1], 1e-12) - 1.0
        d20 = daily[-20:]
        sigma = max(float(np.std(d20)), 0.008)
        rel = five[s] - peer
        # The seven formulas correspond, in ensemble order, to the persisted IDs.
        f[0][s] = rel
        f[1][s] = abs(c[-1] / c[-21] - 1.0) / max(float(np.sum(np.abs(d20))), 1e-8)
        f[2][s] = (c[-1] / c[-21] - 1.0) / sigma
        f[3][s] = -rel / sigma
        f[4][s] = -float(np.mean(daily[-5:]))
        f[5][s] = -rel
        vbase = max(float(np.mean(vol[-20:])), 1e-12)
        f[6][s] = -float(daily[-3:].mean()) * max(0.5, min(2.0, float(vol[-1]) / vbase))

    ranked = [ranks(x) for x in f]
    score = {s: sum(w * r[s] for w, r in zip(FACTOR_WEIGHTS, ranked)) for s in UNIVERSE}

    # Bear/high-volatility posture: remain fully invested, using tradable
    # defensive benchmarks rather than a cash sleeve.
    if "SPX" in data:
        c = data["SPX"][0]
        rr = c[1:] / np.maximum(c[:-1], 1e-12) - 1.0
        if c[-1] < c[-21] or np.std(rr[-20:]) > 0.018:
            for s in ("XAU", "US10Y", "CN10Y"):
                score[s] += 0.12
            for s in ("BTC", "ETH", "WTI"):
                score[s] *= 0.72

    weights = bounded_weights(score)
    vals = np.array([score[s] for s in UNIVERSE], dtype=float)
    scale = max(float(np.std(vals)), 1e-12)
    center = float(np.mean(vals))
    forecast_returns = {s: float(0.008 * (score[s] - center) / scale) for s in UNIVERSE}
    rebalance_to_weights(weights, forecast_returns=forecast_returns, factor_ids=FACTOR_IDS, horizon_days=10)
    last_decision = decision


