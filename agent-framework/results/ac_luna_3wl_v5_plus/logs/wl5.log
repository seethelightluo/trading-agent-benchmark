ype=float)\n        if np.all(np.isfinite(c[-70:])) and np.all(c[-70:] > 0):\n            prices[s] = c\n            returns[s] = c[1:] / np.maximum(c[:-1], 1e-12) - 1.0\n            dates.append(str(df.iloc[-1]["date"]))\n    if len(prices) < 12 or not dates:\n        return\n    decision_date = max(dates)\n    if last_decision is not None:\n        try:\n            if (np.datetime64(decision_date) - np.datetime64(last_decision)) / np.timedelta64(1, "D") < 10:\n                return\n        except Exception:\n            pass\n\n    f = [dict() for _ in FACTOR_IDS]\n    ret5, ret20, vol20, downside = {}, {}, {}, {}\n    for s, c in prices.items():\n        r = returns[s]\n        ret5[s] = c[-1] / c[-6] - 1.0\n        ret20[s] = c[-1] / c[-21] - 1.0\n        vol20[s] = max(float(np.std(r[-20:])), 0.005)\n        downside[s] = max(float(np.std(np.minimum(r[-20:], 0.0))), 0.005)\n        efficiency = max(float(np.sum(np.abs(r[-20:]))), 1e-9)\n        # Causal approximations of the persisted factor definitions.\n        f[0][s] = -ret20[s] / (vol20[s] * np.sqrt(252.0))\n        f[1][s] = -ret5[s] / (max(float(np.std(r[-5:])), 0.005) * np.sqrt(252.0))\n        f[2][s] = ret20[s] / (vol20[s] * np.sqrt(252.0))\n        f[3][s] = ret20[s] / efficiency\n        f[4][s] = ret20[s] / downside[s]\n\n    # Observation-only VIX is used solely for the resilience factor.\n    vix = get_index_daily_data(symbol="VIX", days=110)\n    if vix is not None and len(vix) >= 70:\n        vc = np.asarray(vix.sort_values("date")["close"], dtype=float)\n        vr = vc[1:] / np.maximum(vc[:-1], 1e-12) - 1.0\n        for s, r in returns.items():\n            n = min(len(r), len(vr))\n            rr, vv = r[-n:], vr[-n:]\n            shock = vv > max(float(np.quantile(vv, 0.80)), 0.01)\n            f[5][s] = float(np.mean(rr[shock]) - np.mean(rr)) if shock.sum() >= 3 else 0.0\n    else:\n        f[5] = {s: 0.0 for s in prices}\n\n    ranked = [rank(x) for x in f]\n    score = {s: sum(w * d * ranked[i][s] for i, (w, d) in enumerate(zip(FACTOR_WEIGHTS, FACTOR_DIRECTIONS))) for s in UNIVERSE}\n\n    # Medium-high risk: remain fully invested but use defensive tradables.\n    stressed = ("SPX" in ret20 and (ret20["SPX"] < 0 or vol20["SPX"] > 0.018))\n    if stressed:\n        for s in ("XAU", "US10Y", "CN10Y"):\n            score[s] += 0.10\n        for s in ("BTC", "ETH", "WTI"):\n            score[s] *= 0.75\n    target = bounded(score)\n    z = np.asarray([score[s] for s in UNIVERSE], dtype=float)\n    z = (z - z.mean()) / max(float(z.std()), 1e-12)\n    forecast_returns = {s: float(0.004 * z[i]) for i, s in enumerate(UNIVERSE)}\n    rebalance_to_weights(target, forecast_returns=forecast_returns, factor_ids=FACTOR_IDS, horizon_days=10)\n    last_decision = decision_date\n', 'file_path': 'strategy.py'})
