 import numpy as np
from alphacrafter.sim.utils import register_hook, get_stock_daily_data, get_index_daily_data, rebalance_to_weights

UNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
FACTOR_IDS = [
    "miner_2_20280128_contrarian_risk_adjusted_trend_20d",
    "miner_2_20280215_volneutral_recovery_10d",
    "miner_1_20280606_yieldspread_contrarian20",
    "miner_2_20280111_downside_risk_adjusted_momentum_20d",
    "miner_2_20280509_volshock10_reversal_10d",
    "miner_2_20280314_volscaled5_reversal_10d",
    "miner_2_20271217_vix_shock_resilience_10d",
    "miner_2_channel_trend_20d",
]
FACTOR_WEIGHTS = np.array([.25, .18, .15, .12, .10, .08, .07, .05], dtype=float)
_last_decision = None

def rank(v):
    good = sorted((s, float(x)) for s, x in v.items() if np.isfinite(x))
    out = {s: .5 for s in UNIVERSE}
    n = len(good)
    for i, (s, _) in enumerate(good):
        out[s] = (i + 1) / n if n > 1 else .5
    return out

def weights(score):
    # Full investment, diversified across the deliberately small 15-name universe.
    x = np.array([max(float(score.get(s, .5)), 1e-8) for s in UNIVERSE])
    x /= x.sum()
    for _ in range(30):
        y = np.clip(x, .03, .14)
        fixed = (y <= .03000001) | (y >= .13999999)
        free = ~fixed
        if not free.any():
            break
        y[free] = x[free] / x[free].sum() * (1.0 - y[fixed].sum())
        if np.max(np.abs(y - x)) < 1e-10:
            x = y
            break
        x = y
    y = np.clip(x, 0, None); y /= y.sum()
    return {s: float(w) for s, w in zip(UNIVERSE, y)}

@register_hook
def cross_asset_strategy():
    global _last_decision
    close, ret, dates = {}, {}, {}
    for s in UNIVERSE:
        df = get_stock_daily_data(symbol=s, days=170)
        if df is None or len(df) < 65:
            continue
        df = df.sort_values('date')
        c = np.asarray(df['close'], dtype=float)
        if np.all(np.isfinite(c[-65:])) and np.all(c[-65:] > 0):
            close[s] = c; ret[s] = c[1:] / c[:-1] - 1
            dates[s] = str(df.iloc[-1]['date'])
    if len(close) < 12:
        return
    decision = max(dates.values())
    if _last_decision is not None:
        try:
            if (np.datetime64(decision) - np.datetime64(_last_decision)) / np.timedelta64(1, 'D') < 10:
                return
        except Exception:
            return
    r5 = {s: close[s][-1] / close[s][-6] - 1 for s in close}
    r10 = {s: close[s][-1] / close[s][-11] - 1 for s in close}
    r20 = {s: close[s][-1] / close[s][-21] - 1 for s in close}
    vol = {s: max(float(np.std(ret[s][-20:])), .005) for s in close}
    down = {s: max(float(np.std(np.minimum(ret[s][-20:], 0))), .003) for s in close}
    raw = [dict() for _ in FACTOR_IDS]
    for s in close:
        # Proxies use only completed daily prices available at this hook.
        raw[0][s] = -r20[s] / vol[s]
        raw[1][s] = (close[s][-1] / max(np.min(close[s][-11:]), 1e-12) - 1) / vol[s]
        raw[2][s] = -(r20[s] * (1 if s not in ('US10Y', 'CN10Y') else -1)) / vol[s]
        raw[3][s] = r20[s] / down[s]
        raw[4][s] = -r10[s] / vol[s]
        raw[5][s] = -r5[s] / vol[s]
        raw[6][s] = 1.0 / vol[s]
        raw[7][s] = r20[s] / vol[s]
    ranks = [rank(x) for x in raw]
    score = {s: sum(FACTOR_WEIGHTS[i] * ranks[i][s] for i in range(8)) for s in UNIVERSE}
    vix = get_index_daily_data(symbol='VIX', days=25)
    vix_shock = False
    if vix is not None and len(vix) >= 6:
        vc = np.asarray(vix.sort_values('date')['close'], dtype=float)
        vix_shock = bool(np.isfinite(vc[-1]) and vc[-1] / max(vc[-6], 1e-9) - 1 > .08)
    if vix_shock or r20.get('SPX', 0) < 0 or vol.get('SPX', 0) > .018:
        for s in ('XAU', 'US10Y', 'CN10Y'):
            score[s] += .07
        for s in ('BTC', 'ETH', 'WTI'):
            score[s] *= .82
    target = weights(score)
    z = np.array([score[s] for s in UNIVERSE]); z = (z - z.mean()) / max(float(z.std()), 1e-12)
    forecast_returns = {s: float(.006 * z[i]) for i, s in enumerate(UNIVERSE)}
    rebalance_to_weights(target, forecast_returns=forecast_returns, factor_ids=FACTOR_IDS, horizon_days=10)
    _last_decision = decision

assert len(UNIVERSE) == 15 and len(FACTOR_IDS) == 8
assert abs(float(FACTOR_WEIGHTS.sum()) - 1.0) < 1e-9
assert set(UNIVERSE).isdisjoint({'DXY', 'USDCNY', 'USDJPY', 'EURUSD', 'VIX'})


