 import numpy as np
from alphacrafter.sim.utils import (register_hook, get_stock_daily_data,
                                     get_index_daily_data, rebalance_to_weights)

UNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
FACTOR_IDS = [
    "miner_2_20280128_contrarian_risk_adjusted_trend_20d",
    "miner_1_20271217_volnorm_reversal_5d",
    "miner_1_20260716_peer_median_leadlag_5d",
    "miner_2_range_efficiency_20d",
    "miner_2_downside_efficiency_20d",
    "miner_2_20271217_vix_shock_resilience_10d",
    "miner_3_20280114_risk_momentum_20d",
]
FACTOR_WEIGHTS = [0.30, 0.18, 0.15, 0.15, 0.12, 0.07, 0.03]
FACTOR_DIRECTIONS = [1, 1, 1, 1, 1, 1, 1]
_last_decision = None


def rank(x):
    good = sorted((s, float(v)) for s, v in x.items() if np.isfinite(v))
    out = {s: 0.5 for s in UNIVERSE}
    n = len(good)
    if n > 1:
        for i, (s, _) in enumerate(good):
            out[s] = (i + 1.0) / n
    return out


def weights(score):
    # Broad, bounded allocation is appropriate for a 15-asset, high-risk cross-section.
    lo, hi = 0.025, 0.13
    a = np.array([max(float(score[s]), 1e-9) for s in UNIVERSE])
    w = a / a.sum()
    for _ in range(20):
        fixed = np.clip(w, lo, hi)
        free = (w > lo) & (w < hi)
        residual = 1.0 - fixed[~free].sum()
        if free.any() and residual >= 0:
            fixed[free] = w[free] / w[free].sum() * residual
        if np.max(np.abs(fixed - w)) < 1e-10:
            w = fixed
            break
        w = fixed
    w = np.clip(w, lo, hi)
    w /= w.sum()
    return {s: float(v) for s, v in zip(UNIVERSE, w)}


@register_hook
def cross_asset_strategy():
    global _last_decision
    closes, returns, dates = {}, {}, []
    for s in UNIVERSE:
        df = get_stock_daily_data(symbol=s, days=110)
        if df is None or len(df) < 65:
            continue
        df = df.sort_values("date")
        c = np.asarray(df["close"], dtype=float)
        if np.all(np.isfinite(c[-65:])) and np.all(c[-65:] > 0):
            closes[s] = c
            returns[s] = c[1:] / c[:-1] - 1.0
            dates.append(str(df.iloc[-1]["date"]))
    if len(closes) < 12 or not dates:
        return
    decision = max(dates)
    if _last_decision is not None:
        try:
            if (np.datetime64(decision) - np.datetime64(_last_decision)) / np.timedelta64(1, "D") < 10:
                return
        except Exception:
            return
    r5 = {s: c[-1] / c[-6] - 1.0 for s, c in closes.items()}
    r20 = {s: c[-1] / c[-21] - 1.0 for s, c in closes.items()}
    vol = {s: max(float(np.std(returns[s][-20:])), 0.005) for s in closes}
    peer = float(np.median(list(r5.values())))
    raw = [{ } for _ in FACTOR_IDS]
    for s in closes:
        rr = returns[s][-20:]
        downside = max(float(np.std(np.minimum(rr, 0.0))), 0.005)
        # Causal proxies for the persisted factor definitions, using completed bars only.
        raw[0][s] = -r20[s] / vol[s]                    # contrarian risk-adjusted trend
        raw[1][s] = -r5[s] / vol[s]                     # volatility-normalized reversal
        raw[2][s] = r5[s] - peer                       # peer lead-lag
        raw[3][s] = r20[s] / max(float(np.sum(np.abs(rr))), 1e-9)  # range efficiency
        raw[4][s] = r20[s] / downside                  # downside efficiency
        raw[6][s] = r20[s] / vol[s]                     # small momentum sleeve

    vix = get_index_daily_data(symbol="VIX", days=110)
    if vix is not None and len(vix) >= 65:
        vc = np.asarray(vix.sort_values("date")["close"], dtype=float)
        vr = vc[1:] / np.maximum(vc[:-1], 1e-12) - 1.0
        for s in closes:
            n = min(len(vr), len(returns[s]))
            shock = vr[-n:] > 0
            x = returns[s][-n:]
            raw[5][s] = float(np.mean(x[shock]) - np.mean(x)) if shock.sum() >= 5 else 0.0
    else:
        raw[5] = {s: 0.0 for s in closes}

    ranked = [rank(x) for x in raw]
    score = {s: sum(w * d * ranked[i][s] for i, (w, d) in enumerate(zip(FACTOR_WEIGHTS, FACTOR_DIRECTIONS))) for s in UNIVERSE}
    # High-volatility sideways regime: full investment, modest defensive tilt, no cash.
    if "SPX" in r20 and (r20["SPX"] < 0 or vol["SPX"] > 0.018):
        for s in ("XAU", "US10Y", "CN10Y"):
            score[s] += 0.08
        for s in ("BTC", "ETH", "WTI"):
            score[s] *= 0.80
    target = weights(score)
    z = np.array([score[s] for s in UNIVERSE], dtype=float)
    z = (z - z.mean()) / max(float(z.std()), 1e-12)
    forecast_returns = {s: float(0.006 * z[i]) for i, s in enumerate(UNIVERSE)}
    rebalance_to_weights(target, forecast_returns=forecast_returns,
                         factor_ids=FACTOR_IDS, horizon_days=10)
    _last_decision = decision


