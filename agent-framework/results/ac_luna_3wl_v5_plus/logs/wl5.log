  ▶️ write_file({'content': 'import numpy as np\nfrom alphacrafter.sim.utils import (register_hook, get_stock_daily_data,\n                                     rebalance_to_weights)\n\nUNIVERSE = ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]\nFACTOR_IDS = [\n    "miner_2_20280128_contrarian_risk_adjusted_trend_20d",\n    "miner_1_20271217_volnorm_reversal_5d",\n    "miner_1_20260716_peer_median_leadlag_5d",\n    "miner_2_downside_efficiency_20d",\n    "miner_2_range_efficiency_20d",\n    "miner_3_20271231_relative_reversal_5d10d",\n    "miner_2_20260716_short_reversal_3d",\n    "miner_2_20280211_drawdown_recovery_10d",\n]\nFACTOR_WEIGHTS = [0.30, 0.17, 0.15, 0.13, 0.12, 0.06, 0.04, 0.03]\nFACTOR_DIRECTIONS = [1] * 8\n_last_decision = None\n\n\ndef rank(values):\n    good = sorted((s, float(v)) for s, v in values.items() if np.isfinite(v))\n    out = {s: 0.5 for s in UNIVERSE}\n    if len(good) > 1:\n        for i, (s, _) in enumerate(good):\n            out[s] = (i + 1.0) / len(good)\n    return out\n\n\ndef bounded_weights(score):\n    lo, hi = 0.025, 0.13\n    w = np.array([max(float(score[s]), 1e-9) for s in UNIVERSE])\n    w /= w.sum()\n    # Iterative water filling preserves complete, non-negative investment.\n    for _ in range(30):\n        nw = np.clip(w, lo, hi)\n        free = (w > lo) & (w < hi)\n        residual = 1.0 - nw[~free].sum()\n        if free.any() and residual >= 0:\n            nw[free] = w[free] / w[free].sum() * residual\n        if np.max(np.abs(nw - w)) < 1e-10:\n            w = nw\n            break\n        w = nw\n    w = np.clip(w, lo, hi)\n    w /= w.sum()\n    return {s: float(v) for s, v in zip(UNIVERSE, w)}\n\n\n@register_hook\ndef cross_asset_strategy():\n    global _last_decision\n    closes, rets = {}, {}\n    for s in UNIVERSE:\n        df = get_stock_daily_data(symbol=s, days=115)\n        if df is None or len(df) < 65:\n            continue\n        df = df.sort_values("date")\n        c = np.asarray(df["close"], dtype=float)\n        if np.all(np.isfinite(c[-65:])) and np.all(c[-65:] > 0):\n            closes[s] = c\n            rets[s] = c[1:] / c[:-1] - 1.0\n    if len(closes) < 12:\n        return\n    decision = str(max(str(get_stock_daily_data(symbol=s, days=2).iloc[-1]["date"]) for s in closes))\n    if _last_decision is not None:\n        try:\n            if (np.datetime64(decision) - np.datetime64(_last_decision)) / np.timedelta64(1, "D") < 10:\n                return\n        except Exception:\n            return\n    r3 = {s: c[-1] / c[-4] - 1.0 for s, c in closes.items()}\n    r5 = {s: c[-1] / c[-6] - 1.0 for s, c in closes.items()}\n    r10 = {s: c[-1] / c[-11] - 1.0 for s, c in closes.items()}\n    r20 = {s: c[-1] / c[-21] - 1.0 for s, c in closes.items()}\n    vol = {s: max(float(np.std(rets[s][-20:])), 0.005) for s in closes}\n    peer5 = float(np.median(list(r5.values())))\n    raw = [dict() for _ in FACTOR_IDS]\n    for s in closes:\n        rr = rets[s][-20:]\n        downside = max(float(np.std(np.minimum(rr, 0.0))), 0.005)\n        # Causal, compact implementations of the persisted factor intents.\n        raw[0][s] = -r20[s] / vol[s]\n        raw[1][s] = -r5[s] / vol[s]\n        raw[2][s] = r5[s] - peer5\n        raw[3][s] = r20[s] / downside\n        raw[4][s] = r20[s] / max(float(np.sum(np.abs(rr))), 1e-9)\n        raw[5][s] = -(r5[s] - r10[s]) / vol[s]\n        raw[6][s] = -r3[s] / max(vol[s], 0.005)\n        # Recovery rewards improvement from the recent drawdown, but is small.\n        peak = max(closes[s][-21:])\n        drawdown = closes[s][-11:-1].min() / peak - 1.0\n        raw[7][s] = r10[s] + max(-drawdown, 0.0)\n    ranked = [rank(x) for x in raw]\n    score = {s: sum(w * ranked[i][s] for i, w in enumerate(FACTOR_WEIGHTS)) for s in UNIVERSE}\n    # Sideways/high-risk posture: defensive tradable tilt, never cash.\n    market_vol = float(np.median(list(vol.values())))\n    if ("SPX" in r20 and r20["SPX"] < 0) or vol.get("SPX", market_vol) > 0.018:\n        for s in ("XAU", "US10Y", "CN10Y"):\n            score[s] += 0.08\n        for s in ("BTC", "ETH", "WTI"):\n            score[s] *= 0.80\n    target = bounded_weights(score)\n    z = np.array([score[s] for s in UNIVERSE], dtype=float)\n    z = (z - z.mean()) / max(float(z.std()), 1e-12)\n    forecast_returns = {s: float(0.006 * z[i]) for i, s in enumerate(UNIVERSE)}\n    rebalance_to_weights(target, forecast_returns=forecast_returns,\n                         factor_ids=FACTOR_IDS, horizon_days=10)\n    _last_decision = decision\n', 'file_path': 'strategy.py'})
