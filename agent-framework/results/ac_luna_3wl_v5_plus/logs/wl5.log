    r3 = {s: close[s][-1] / close[s][-4] - 1 for s in close}
    r5 = {s: close[s][-1] / close[s][-6] - 1 for s in close}
    r10 = {s: close[s][-1] / close[s][-11] - 1 for s in close}
    r20 = {s: close[s][-1] / close[s][-21] - 1 for s in close}
    vol = {s: max(float(np.std(dret[s][-20:])), .005) for s in close}
    raw = [dict() for _ in FACTOR_IDS]
    for s in close:
        # Causal price proxies preserve the ensemble's directions and diversify horizons.
        raw[0][s] = -r20[s] / vol[s]                         # contrarian risk-adjusted trend
        raw[1][s] = (close[s][-1] / min(close[s][-11:]) - 1) / vol[s]  # recovery
        raw[2][s] = r20[s] / vol[s]                          # risk-adjusted momentum
        neg = np.minimum(dret[s][-20:], 0.0)
        raw[3][s] = r20[s] / max(float(np.std(neg)), .005)   # downside efficiency
        window = close[s][-21:]
        raw[4][s] = abs(r20[s]) / max(float(np.sum(np.abs(dret[s][-20:]))), .01) # range efficiency
        raw[5][s] = -(r5[s] - r10[s]) / vol[s]              # shock resilience proxy
        raw[6][s] = -r3[s] / vol[s]                         # dispersion reversal proxy
        raw[7][s] = r20[s] / vol[s]                         # risk momentum
    ranks = [rank(v) for v in raw]
    score = {s: sum(FACTOR_WEIGHTS[i] * ranks[i][s] for i in range(len(FACTOR_IDS))) for s in UNIVERSE}

    vix = get_index_daily_data(symbol="VIX", days=25)
    shock = False
    if vix is not None and len(vix) >= 6:
