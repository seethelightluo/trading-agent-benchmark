 if n=='riskmom20': X=R.rolling(20).sum()/(R.rolling(60).std()*np.sqrt(20))
 elif n=='mom20': X=P.pct_change(20)
 else: X=-P.pct_change(5)
 z=pd.concat([F.stack(),X.stack()],axis=1).dropna(); print('corr',n,z.iloc[:,0].corr(z.iloc[:,1]))


