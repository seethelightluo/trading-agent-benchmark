{
  "factor_id": "miner_2_20280629_smoothed_residual_shock_5d",
  "factor_name": "Three-day smoothed volatility-normalized cross-asset residual shock reversal",
  "version": "1.0",
  "calculation": {
    "expression": "mean_{t-3:t-1}[-(r5_i - median_j(r5_j))/(sqrt(5)*vol20_i + epsilon)] evaluated with one additional day lag",
    "description": "For each tradable asset, compute its five-day return residual relative to the cross-sectional median, divide by its 20-day daily-return volatility scaled by sqrt(5), negate for reversal, smooth the raw signal over three completed observations, and lag one trading day. Positive values indicate volatility-normalized underperformance likely to mean-revert over the next five trading days.",
    "signal_artifact": "scripts/miner_2_20280629_smoothed_residual_shock.py",
    "formula_key": "smoothed_residual_5d_div_vol20_rolling3_lag1"
  },
  "dependencies": [
    "close",
    "daily returns"
  ],
  "parameters": {
    "residual_lookback_days": 5,
    "volatility_lookback_days": 20,
    "smoothing_window_days": 3,
    "forward_horizon_days": 5,
    "lag_days": 1,
    "epsilon": 1e-08,
    "minimum_cross_section": 8
  },
