  "factor_id": "miner_2_20300221_market_residual_reversal_10d",
  "factor_name": "Market-Residual 20-Day Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(rolling_sum_20(log_return_asset) - rolling_sum_20(cross_asset_mean_log_return)).shift(1)",
    "description": "Ranks assets by the negative of their lagged 20-day cumulative return residual relative to the equal-weighted mean return of the 15 tradable benchmark instruments. Positive values favor assets that underperformed the cross-asset benchmark, providing a contrarian residual-reversal signal. Forward returns are not used in signal construction."
  },
