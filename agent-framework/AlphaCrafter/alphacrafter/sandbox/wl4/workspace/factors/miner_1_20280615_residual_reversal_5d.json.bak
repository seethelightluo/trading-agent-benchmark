{
  "factor_id": "miner_1_residual_reversal_5d",
  "factor_name": "Market-Beta-Residual Five-Day Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-rolling_sum_5(log_return(asset) - beta_60(asset,SPX)*log_return(SPX))",
    "description": "For each tradable asset, estimate a trailing 60-observation beta to SPX using rolling covariance divided by rolling SPX variance, subtract the contemporaneous SPX beta component from the asset log return, and negate the trailing five-day residual return. Higher values indicate residual underperformance and expected reversal. Signals use only completed observations."
  },
  "dependencies": [
    "close",
    "SPX close"
  ],
  "parameters": {
    "beta_window": 60,
    "beta_min_periods": 40,
    "signal_window": 5,
    "forward_horizon": 1
  },
