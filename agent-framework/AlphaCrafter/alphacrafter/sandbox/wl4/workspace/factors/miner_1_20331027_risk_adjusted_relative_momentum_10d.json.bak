  "factor_name": "Risk-adjusted relative 20-day momentum",
  "version": "1.0",
  "calculation": {
    "expression": "(return_20d - cross_sectional_median(return_20d)) / (sqrt(20) * rolling_std(daily_return,20))",
    "description": "Cross-sectional relative 20-day price momentum scaled by each instrument's trailing 20-day realized volatility; lagged one completed day to avoid lookahead. Higher values indicate stronger risk-adjusted relative momentum."
