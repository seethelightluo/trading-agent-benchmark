{
  "factor_id": "miner_3_long_range_breakout_quality_10d",
  "factor_name": "Inverse Long-Range Breakout Quality",
  "version": "20330512.v1",
  "calculation": {
    "expression": "-pct_change(close,60)/(std(pct_change(close,1),120)*sqrt(60)) * (0.5 + rolling_mean((close-rolling_min(close,60))/(rolling_max(close,60)-rolling_min(close,60)),15))",
    "description": "A volatility-scaled 60-day trend signal inverted for the observed cross-asset contrarian effect, with a smoothed 60-day range-position confirmation term. Lagged one completed day to prevent look-ahead. Higher values favor assets with stronger, persistent, high-range-position moves that are candidates for subsequent 10-day underperformance."
  },
  "dependencies": ["close"],
  "parameters": {"momentum_window": 60, "volatility_window": 120, "range_window": 60, "range_position_smoothing": 15, "forward_horizon": 10, "lag_days": 1, "min_periods_volatility": 60, "min_periods_range": 40, "min_periods_smoothing": 8},
