{
  "factor_id": "miner_3_20320902_dispersion_gated_residual_reversal_30d",
  "factor_name": "Dispersion-Gated Volatility-Scaled Residual Reversal 30D",
  "version": "1.0",
  "calculation": {
    "expression": "lag1(-rolling_sum_10(asset_return - equal_weight_benchmark_return) / rolling_std_60(asset_return - benchmark_return) * clip(rolling_median_20(cross_sectional_dispersion) / rolling_median_120(dispersion), 0.5, 2.0))",
    "description": "Contrarian ten-session residual return, scaled by 60-session idiosyncratic volatility and multiplied by a continuous market-dispersion regime scale. The signal is lagged one session to prevent look-ahead."
  },
  "dependencies": ["close"],
  "parameters": {"residual_window": 10, "volatility_window": 60, "dispersion_window": 20, "dispersion_baseline_window": 120, "min_periods_residual": 8, "min_periods_volatility": 30, "min_periods_dispersion": 15, "gate_floor": 0.5, "gate_cap": 2.0, "forward_horizon": 30, "lag": 1},
