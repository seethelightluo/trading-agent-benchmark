{
  "factor_id": "miner_3_20320610_residual_reversal_30d",
  "factor_name": "Volatility-scaled cross-asset residual reversal 30-day",
  "version": "1.0",
  "calculation": {
    "expression": "-shift1((rolling_sum(pct_change(close),30) - cross_sectional_mean(rolling_sum(pct_change(close),30))) / (rolling_std(pct_change(close),30)*sqrt(252)))",
    "description": "For each tradable asset, calculate its 30-day cumulative return relative to the same-date equal-weight mean 30-day return across the 15-asset universe, divide by its 30-day annualized volatility, negate for contrarian ranking, and lag the resulting signal by one completed day to avoid look-ahead."
  },
  "dependencies": ["close"],
  "parameters": {"return_window": 30, "volatility_window": 30, "annualization": 252, "signal_lag_days": 1, "minimum_periods": 20, "forward_horizon_days": 10, "minimum_cross_section": 8},
  "validation": {
    "status": "EFFECTIVE",
    "period": {"start": "2020-01-01", "end": "2032-06-10"},
    "metrics": {
      "ic": 0.03215,
      "icir": 0.11452,
      "hit_ratio": 0.544,
      "dates": 2452,
      "average_cross_section": 15.0,
      "min_cross_section": 15,
      "coverage": 0.572,
      "turnover": 0.0536,
      "decay": {"h5_ic": 0.01575, "h10_ic": 0.03215, "h20_ic": 0.05223},
      "max_abs_library_correlation": null
    },
    "regime_notes": "Positive and robust across recent windows: H10 IC/ICIR 0.06223/0.22162 over 365 dates, 0.05304/0.18405 over 730 dates, and 0.04363/0.14719 over 1095 dates. Small cross-asset universe implies conservative uncertainty interpretation.",
    "signal_provenance": {"script": "scripts/miner_3_20320610_residual_reversal_30d.py", "signal_definition": "f = (-residual_30d / annualized_volatility_30d).shift(1)", "universe": ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"], "recomputed": true}
