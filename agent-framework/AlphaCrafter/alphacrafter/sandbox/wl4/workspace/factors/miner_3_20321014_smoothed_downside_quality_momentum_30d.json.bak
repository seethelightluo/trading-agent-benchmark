{
  "factor_id": "miner_3_20321014_smoothed_downside_quality_momentum_30d",
  "factor_name": "Smoothed downside-risk-adjusted trend-quality momentum 30d",
  "version": "1.0",
  "calculation": {
    "expression": "lag1((close/close[-40]-1) / (sqrt(rolling_mean(min(pct_change(close),0)^2,90))*sqrt(40)) * (2*rolling_mean(pct_change(close)>0,60)-1))",
    "description": "Ranks instruments by lagged 40-session momentum normalized by a slower 90-session downside deviation and multiplied by centered 60-session directional consistency. Only completed observations before the decision date are used."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "momentum_window": 40,
    "downside_vol_window": 90,
    "consistency_window": 60,
    "min_periods_downside": 60,
    "min_periods_consistency": 45,
    "lag": 1,
    "forward_horizon": 30
  },
