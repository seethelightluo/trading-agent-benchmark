{
  "factor_id": "miner_3_20341109_dispersion_conditioned_range_reversal_60d",
  "factor_name": "Dispersion-conditioned 60-day range reversal",
  "version": "2034-11-09",
  "calculation": {
    "expression": "(-(close - rolling_min(close,60)) / (rolling_max(close,60)-rolling_min(close,60))) * (0.5 + percentile_rank_60(cross_asset_std(pct_change(close,20))))",
    "description": "For each tradable asset, measure proximity to the bottom of its trailing 60-session price range and multiply the contrarian score by the cross-asset 20-day return-dispersion percentile over the trailing 60 sessions. The signal is lagged one completed session to avoid look-ahead and evaluated for 10-session forward returns."
  },
  "dependencies": ["close", "cross_asset_prices", "observation_date"],
  "parameters": {
    "range_window": 60,
    "dispersion_return_window": 20,
    "dispersion_rank_window": 60,
    "range_min_periods": 42,
    "dispersion_min_periods": 30,
    "signal_lag_sessions": 1,
    "forward_horizon_sessions": 10,
    "minimum_cross_section": 8
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-03-06 through 2034-10-25",
    "validated_on": "2034-11-09",
    "metrics": {
