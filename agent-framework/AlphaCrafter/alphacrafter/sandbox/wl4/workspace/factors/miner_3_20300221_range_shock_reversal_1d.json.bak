{
  "factor_id": "miner_3_20300221_range_shock_reversal_1d",
  "factor_name": "Range-State Normalized Shock Reversal",
  "version": "2030-02-21",
  "calculation": {
    "expression": "-((3d close-to-close return)/(20d return volatility*sqrt(3))) * clip((3d mean true-range proxy)/(60d median true-range proxy), 0.5, 3.0), lagged 1 completed session",
    "description": "Reverses an unusually large three-session cross-asset price shock and amplifies it when recent high-low range activity is elevated relative to its 60-session baseline. True-range proxy is (high-low)/prior close. All inputs are lagged before forecasting.",
    "signal_artifact": "scripts/miner_3_20300221_range_shock_reversal.py"
  },
  "dependencies": [
    "open",
    "high",
    "low",
    "close"
  ],
  "parameters": {
    "shock_window": 3,
    "risk_window": 20,
    "range_window": 3,
    "baseline_window": 60,
    "minimum_risk_observations": 15,
    "minimum_baseline_observations": 40,
    "range_clip": [
      0.5,
      3.0
    ],
    "lag_sessions": 1,
    "forecast_horizon_sessions": 1
  },
