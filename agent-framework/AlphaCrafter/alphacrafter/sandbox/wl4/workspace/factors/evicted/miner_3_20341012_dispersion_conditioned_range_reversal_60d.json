{
  "factor_id": "miner_3_20341012_dispersion_conditioned_range_reversal_60d",
  "factor_name": "Dispersion-Conditioned 60-Day Range Reversal",
  "version": "2034-10-12",
  "calculation": {
    "expression": "(-(close - rolling_min(close,60)) / (rolling_max(close,60)-rolling_min(close,60))) * (0.5 + percentile_rank_rolling(cross_sectional_std(pct_change(close,20)),60))",
    "description": "Ranks assets favoring those near the bottom of their 60-session range, with signal magnitude increased when the cross-asset 20-session return dispersion is elevated. All inputs are lagged one trading day before forecasting the next 10 trading days."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "range_window": 60,
    "dispersion_return_window": 20,
    "dispersion_rank_window": 60,
    "min_range_observations": 42,
    "horizon": 10,
    "signal_lag": 1
  },
