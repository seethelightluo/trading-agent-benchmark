  "factor_name": "Idiosyncratic-Volatility-Weighted Residual Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "lag1(-rolling_sum(residual_return_10d) * clip(idiosyncratic_vol_30d / cross_sectional_median(idiosyncratic_vol_30d), 0.5, 2.0))",
    "description": "Subtract the daily cross-sectional median return to form residual returns, take the negative 10-day residual accumulation, and weight it by relative 30-day residual volatility. The one-day lag prevents look-ahead; volatility is clipped to limit extreme exposures."
