  "factor_name": "Drawdown-Penalized Volatility-Adjusted Momentum",
  "version": "20281228",
  "calculation": {
    "expression": "close_return_20d / (std(pct_change(close),20)*sqrt(20)) - 0.75*((rolling_max(close,60)-close)/rolling_max(close,60))",
    "description": "Ranks medium-term momentum after volatility scaling, penalizing assets that remain materially below their recent 60-session peak. All inputs are lagged one completed session at decision time. Higher values indicate stronger, less drawdown-impaired trend quality."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "momentum_window": 20,
    "volatility_window": 20,
    "drawdown_window": 60,
    "drawdown_penalty": 0.75,
