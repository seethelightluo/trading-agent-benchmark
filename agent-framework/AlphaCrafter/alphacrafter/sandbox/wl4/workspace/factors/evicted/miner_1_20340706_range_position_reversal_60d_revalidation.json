  "factor_name": "Volatility-scaled 60-day range-position reversal (revalidated)",
  "version": "2.0",
  "calculation": {
    "expression": "(0.5 - rolling_position(close, 60)) / (rolling_std(pct_change(close), 40) * sqrt(40))",
