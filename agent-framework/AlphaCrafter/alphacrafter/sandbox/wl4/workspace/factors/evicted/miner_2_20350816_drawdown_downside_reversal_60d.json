{
  "factor_id": "miner_2_drawdown_downside_reversal_60d",
  "factor_name": "Drawdown-to-Downside-Risk Reversal 60d",
  "version": "1.0",
  "calculation": {
    "expression": "-(close / rolling_max(close, 60) - 1) / rolling_std(negative_returns_only, 20), shifted 1 completed session",
    "description": "Ranks assets that are materially below their 60-session high while normalizing the drawdown by recent downside volatility. The negative sign gives higher scores to deeper drawdowns per unit of downside risk, a cross-asset mean-reversion signal. All inputs are lagged one completed session before use."
  },
  "dependencies": [
    "close",
    "pct_change"
  ],
  "parameters": {
    "drawdown_window": 60,
    "downside_vol_window": 20,
    "min_drawdown_observations": 40,
    "min_downside_vol_observations": 15,
    "forward_horizon_days": 10,
    "lag_days": 1,
    "minimum_cross_section": 8
  },
