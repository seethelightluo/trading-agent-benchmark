{
  "factor_id": "miner_3_20350802_downside_quality_blend_20_30",
  "factor_name": "Normalized blended downside-risk quality (20/30 day)",
  "version": "1.0",
  "calculation": {
    "expression": "-0.5 * ((downside_std(returns,20) / cross_sectional_median(downside_std(returns,20))) + (downside_std(returns,30) / cross_sectional_median(downside_std(returns,30))) )",
    "description": "For each asset, compute rolling standard deviation of negative daily returns over 20 and 30 sessions, normalize each by the same-day cross-sectional median, average the normalized risks, negate so higher values indicate lower downside risk, and lag one completed session to prevent look-ahead. Signals are evaluated against 10-session forward returns."
  },
