{
  "factor_id": "miner_2_20340928_dispersion_conditioned_reversal_60d",
  "factor_name": "Cross-asset-dispersion-conditioned 60-day range reversal",
  "version": "1.0",
  "calculation": {
    "expression": "(-(close - rolling_min(close,60)) / (rolling_max(close,60)-rolling_min(close,60))) * (0.5 + percentile_rank_60d(cross_sectional_std(pct_change(close,20))))",
    "description": "Ranks assets near the lower part of their trailing 60-day range more strongly when cross-asset 20-day return dispersion is elevated; all inputs are lagged one completed day before forward evaluation."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "range_window": 60,
    "range_min_periods": 42,
    "dispersion_return_window": 20,
    "dispersion_rank_window": 60,
    "dispersion_min_periods": 30,
    "regime_multiplier_floor": 0.5,
    "forward_horizon_days": 10,
    "lag_days": 1
  },
