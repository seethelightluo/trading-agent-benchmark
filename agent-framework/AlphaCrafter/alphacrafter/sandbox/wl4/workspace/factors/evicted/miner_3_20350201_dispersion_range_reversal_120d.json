{
  "factor_id": "miner_3_20350201_dispersion_range_reversal_120d",
  "factor_name": "Dispersion-conditioned 120-day range reversal",
  "version": "2035-02-01",
  "calculation": {
    "expression": "-((close - rolling_min(close,120))/(rolling_max(close,120)-rolling_min(close,120))) * (0.5 + rolling_mean(rank_rolling60(cross_sectional_std(pct_change(close,20))),10))",
    "description": "Ranks assets more favorably when they are lower in their 120-session range, with reversal intensity scaled by the recent 10-session average percentile of cross-asset 20-session return dispersion. Signal is lagged one completed session to avoid look-ahead."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "range_window": 120,
    "range_min_periods": 84,
    "dispersion_return_window": 20,
    "dispersion_rank_window": 60,
    "dispersion_smoothing_window": 10,
    "dispersion_smoothing_min_periods": 5,
    "forward_horizon_sessions": 10,
    "signal_lag_sessions": 1,
    "minimum_cross_section": 8
  },
