{
  "factor_id": "range_efficiency_reversal_10d",
  "factor_name": "Range-Efficiency Normalized Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "lag1(-(return_20d / sum(abs(daily_return),20)) / annualized_volatility_20d)",
    "description": "Cross-asset reversal of the prior 20-session directional return, normalized by its absolute-return path length (range efficiency) and 20-session realized volatility; signal is lagged one session to prevent look-ahead.",
    "implementation": "ret20=close.pct_change(20); path=sum(abs(close.pct_change()),20); vol=std(close.pct_change(),20)*sqrt(20); factor=(-(ret20/(path+1e-8))/(vol+1e-8)).shift(1)"
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "return_window": 20,
    "path_window": 20,
    "volatility_window": 20,
    "volatility_annualization": "sqrt(20)",
    "lag_sessions": 1,
    "minimum_cross_section": 8
  },
