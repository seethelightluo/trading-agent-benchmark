  "factor_name": "Volatility-Scaled Cross-Asset 30-Day Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "cross_section_center( - pct_change(close,30) / rolling_std(pct_change(close,1),20) )",
    "description": "Contrarian 30-day return, scaled by each asset's recent 20-day volatility, cross-sectionally demeaned and lagged one completed day to prevent look-ahead."
