{
  "factor_id": "miner_2_crossasset_residual_reversal_20d",
  "factor_name": "Volatility-Scaled Cross-Asset Residual Reversal 20d",
  "version": "20350705",
  "calculation": {
    "expression": "lag(-(R20_i - median_j(R20_j)) / std20(r_i), 1)",
    "description": "Subtract each instrument's 20-session return from the cross-sectional median 20-session return, reverse the residual, and scale by its own 20-session realized volatility. The signal is lagged one completed session and is intended for the 10-trading-day holding horizon.",
    "signal_reconstruction": "Load close prices for the 15 tradable symbols through the previous completed day; R20=close.pct_change(20); r=close.pct_change(); vol=r.rolling(20,min_periods=12).std(); raw=-(R20-R20.median(axis=1))/vol; signal=raw.shift(1)."
  },
  "dependencies": [
    "close",
    "daily_return"
  ],
  "parameters": {
    "return_window_days": 20,
    "volatility_window_days": 20,
    "volatility_min_periods": 12,
    "cross_section_center": "median",
    "lag_days": 1,
    "forward_horizon_days": 10,
    "minimum_cross_section": 8,
    "universe_size": 15
  },
