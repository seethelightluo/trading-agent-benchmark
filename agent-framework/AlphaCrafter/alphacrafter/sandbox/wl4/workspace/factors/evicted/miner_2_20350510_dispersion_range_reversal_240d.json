  "factor_name": "Dispersion-Weighted 240-Day Range Reversal",
  "version": "2035-05-10",
  "calculation": {
    "expression": "-((close - rolling_min(close,240)) / (rolling_max(close,240)-rolling_min(close,240))) * (0.5 + rolling_mean(rolling_minmax( cross_section_std(pct_change(close,20)),60),5))",
    "description": "Cross-sectional contrarian range-location signal over 240 sessions, amplified when cross-asset 20-day return dispersion is elevated. The signal is shifted by one completed trading day to prevent look-ahead."
