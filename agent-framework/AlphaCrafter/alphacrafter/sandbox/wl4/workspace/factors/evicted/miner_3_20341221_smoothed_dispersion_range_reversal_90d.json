  "factor_name": "Smoothed dispersion-conditioned 90-day range reversal",
  "version": "2034-12-21",
  "calculation": {
    "expression": "shift1(-(close-rolling_min(close,90))/(rolling_max(close,90)-rolling_min(close,90)) * (0.5 + rolling_mean(rolling_percentile_rank(rolling_std(pct_change(close,20)),60),5))",
