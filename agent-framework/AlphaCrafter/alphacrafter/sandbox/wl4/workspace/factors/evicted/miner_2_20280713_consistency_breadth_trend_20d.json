  "factor_name": "Consistency- and breadth-confirmed risk-adjusted trend",
  "version": "1.0",
  "calculation": {
    "expression": "lag1( zscore_cs(ret20/(std_daily20*sqrt(20))) * 2*(consistency20-0.5) * (0.5+0.5*abs(2*(breadth20-0.5))) )",
    "description": "Cross-sectional z-score of 20-day volatility-normalized return, signed and scaled by the fraction of positive 5/10/15/20-day subperiod returns and by absolute cross-asset 20-day breadth confirmation. The one-observation lag prevents use of the current completed day's close in a forward-return test."
  },
  "dependencies": [
    "close",
    "daily_pct_change"
  ],
