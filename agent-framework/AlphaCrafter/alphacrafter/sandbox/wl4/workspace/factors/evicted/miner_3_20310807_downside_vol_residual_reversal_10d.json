{
  "factor_id": "miner_3_downside_vol_residual_reversal_10d",
  "factor_name": "Downside-volatility-scaled cross-asset residual reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-((rolling_sum(return,10) - cross_sectional_median(rolling_sum(return,10))) / (0.7*rolling_std(return.where(return<0,0),40) + 0.3*rolling_std(return,40)))",
    "description": "Opposes each instrument's 10-session return relative to the daily cross-sectional median, scaling by a blended 40-session downside and total volatility estimate. Signal is lagged one completed session to prevent look-ahead."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "return_lookback": 10,
    "volatility_lookback": 40,
    "downside_vol_weight": 0.7,
