  "version": "1.0",
  "calculation": {
    "expression": "-clip(ret_20_lag/(vol_60_lag*sqrt(20)) * (1 + 0.5*clip(vol_10_lag/vol_60_lag - 1,-3,3)) * (0.5 + 0.5*positive_return_fraction_20_lag), -8, 8), then cross-sectional demean",
