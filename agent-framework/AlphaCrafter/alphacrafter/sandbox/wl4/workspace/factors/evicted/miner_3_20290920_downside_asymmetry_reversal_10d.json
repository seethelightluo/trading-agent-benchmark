  "factor_name": "Downside-Asymmetry Reversal",
  "version": "2029-09-20",
  "calculation": {
    "expression": "lag1(rolling_mean_3(-return_10d * downside_vol_20d / (upside_vol_20d + 1e-8), min_periods=2))",
    "description": "Ranks assets higher when their recent 10-day loss is larger and downside volatility dominates upside volatility; the three-day smoothing and one-day lag prevent same-day information leakage. The downside/upside volatility ratio is capped at 5 for numerical robustness.",
    "signal_reconstruction": "r=pct_change(close); downside_vol=rolling_std(clip_upper(r,0),20,min_periods=15); upside_vol=rolling_std(clip_lower(r,0),20,min_periods=15); raw=-pct_change(close,10)*clip(downside_vol/(upside_vol+1e-8),0,5); signal=rolling_mean(raw,3,min_periods=2).shift(1)",
    "horizon": "10 trading days"
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "return_window": 10,
    "volatility_window": 20,
    "smoothing_window": 3,
    "volatility_min_periods": 15,
    "signal_lag": 1,
    "asymmetry_cap": 5.0
  },
