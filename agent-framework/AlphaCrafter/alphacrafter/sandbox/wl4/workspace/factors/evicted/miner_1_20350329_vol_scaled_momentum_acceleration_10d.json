{
  "factor_id": "miner_1_vol_scaled_momentum_acceleration_10d",
  "factor_name": "Volatility-Scaled Momentum Acceleration",
  "version": "1.0",
  "calculation": {
    "expression": "lag(((close/close.shift(20)-1) - (close.shift(20)/close.shift(60)-1)) / (rolling_std(pct_change(close),60)*sqrt(20)), 1)",
    "description": "Ranks assets whose latest 20-day return exceeds the preceding 40-day return, scaled by 60-day realized volatility. The one-day lag prevents use of the decision day's incomplete data.",
    "signal_reconstruction": "Load close through the prior completed day; recent=close.pct_change(20); prior=close.shift(20).pct_change(40); vol=close.pct_change().rolling(60,min_periods=30).std(); signal=((recent-prior)/(vol*sqrt(20)+1e-12)).shift(1)."
  },
  "dependencies": [
    "close",
    "daily_return"
  ],
  "parameters": {
    "recent_window_days": 20,
    "prior_window_days": 40,
    "volatility_window_days": 60,
    "volatility_min_periods": 30,
    "forward_horizon_days": 10,
    "lag_days": 1,
    "universe_size": 15
  },
