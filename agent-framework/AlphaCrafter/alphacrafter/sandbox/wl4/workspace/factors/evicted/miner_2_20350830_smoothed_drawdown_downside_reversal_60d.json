  "factor_id": "miner_2_smoothed_drawdown_downside_reversal_60d",
  "factor_name": "Smoothed Drawdown-to-Downside-Risk Reversal 60d",
  "version": "1.0",
  "calculation": {
    "expression": "-rolling_mean(close/rolling_max(close,60)-1,10)/rolling_std(min(pct_change(close),0),20), lagged 1 session",
    "description": "Ranks assets for mean reversion by their ten-session average drawdown from the 60-session high, normalized by 20-session downside volatility. More negative drawdowns produce larger positive reversal scores; all inputs are lagged one completed session before forward-return measurement."
  },
  "dependencies": [
    "close",
    "pct_change"
  ],
