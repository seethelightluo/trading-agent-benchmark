{
  "factor_id": "miner_1_range_location_reversal_45d",
  "factor_name": "45-day range-location reversal",
  "version": "1.0",
  "calculation": {
    "expression": "0.5 - (close - rolling_min(low,45)) / (rolling_max(high,45) - rolling_min(low,45))",
    "description": "Contrarian cross-sectional score: assets nearer the lower end of their trailing 45-day high-low range receive higher scores. The signal uses only information through the decision date and is evaluated against forward returns.",
    "signal_lag": "At each date, trailing OHLC windows include data through that date; production decisions must supply data only through the previous completed trading day."
  },
  "dependencies": [
    "close",
    "high",
    "low"
  ],
