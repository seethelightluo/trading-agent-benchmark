{
  "factor_id": "miner_2_dispersion_conditioned_reversal_20d",
  "factor_name": "Dispersion-Conditioned Volatility-Scaled Reversal 20d",
  "version": "1.0",
  "calculation": {
    "expression": "lag1(-(close/close[-20]-1)/(std(pct_change(close),40)*sqrt(40)) * (1 + 0.7*clip((dispersion20-mean120(dispersion20))/std120(dispersion20),-1.5,1.5)))",
    "description": "Ranks instruments by lagged 20-session reversal scaled by 40-session realized volatility, increasing reversal exposure when cross-asset daily-return dispersion is elevated. Dispersion is the cross-sectional standard deviation of daily returns smoothed over 20 sessions; regime normalization uses trailing 120 sessions only."
  },
  "dependencies": [
    "close",
    "pct_change"
  ],
  "parameters": {
    "reversal_window": 20,
    "volatility_window": 40,
    "dispersion_smoothing": 20,
    "dispersion_norm_window": 120,
    "dispersion_multiplier": 0.7,
    "lag": 1,
    "forward_horizon": 10,
    "min_assets_per_date": 8
  },
