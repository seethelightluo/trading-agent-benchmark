  "factor_name": "Breadth-Gated Risk-Adjusted 60-Day Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(close/lag(close,60)-1) / (rolling_std(pct_change(close),20)*sqrt(252)) * clip(0.5 + 0.8*(cross_sectional_mean(sign(rolling_mean(pct_change(close),20)))-0.5), 0.25, 1.05)",
    "description": "Ranks assets with negative 60-day risk-adjusted returns higher for contrarian allocation. Reversal strength is modulated by the contemporaneous cross-asset breadth of positive 20-day average returns. All inputs are lagged one completed trading day before the 10-day forward return evaluation."
  },
