  "factor_name": "High-dispersion cross-asset residual reversal",
  "version": "1.0",
  "calculation": {
    "expression": "where(cross_sectional_std(pct_change(close)).shift(1) > rolling_median(cross_sectional_std(pct_change(close)).shift(1),60), -(pct_change(close,10).shift(1)-cross_sectional_median(pct_change(close,10)).shift(1)), 0)",
    "description": "Buys the lagged 10-session relative losers and assigns a neutral signal outside elevated-dispersion days. Dispersion is the cross-sectional standard deviation of daily returns, compared with its trailing 60-session median; all inputs are lagged one completed session."
