  "factor_name": "Smoothed dispersion-conditioned 60-day range reversal",
  "version": "1.0",
  "calculation": {
    "expression": "(-(close - rolling_min(close,60))/(rolling_max(close,60)-rolling_min(close,60))) * (0.5 + SMA5(percentile_position(std(cross_sectional_return_20d),60)))",
