{
  "factor_id": "vix_conditioned_residual_reversal_10d",
  "factor_name": "VIX-conditioned volatility-scaled residual reversal",
  "version": "20320401",
  "calculation": {
    "expression": "(-residual_return_20d / realized_volatility_20d) * (1 + max(0, log(VIX_t/VIX_{t-10})))",
    "description": "For each tradable asset, subtract the cross-asset mean 20-day log return from its own 20-day log return, reverse the residual, scale by its 20-day realized volatility, and increase the signal only when the observation-only VIX has risen over the prior 10 sessions. The complete signal is lagged one session before ranking."
  },
  "dependencies": [
    "close",
    "VIX observation-only close"
  ],
  "parameters": {
    "residual_window": 20,
    "volatility_window": 20,
    "vix_change_window": 10,
    "forward_horizon": 10,
    "minimum_cross_section": 8,
