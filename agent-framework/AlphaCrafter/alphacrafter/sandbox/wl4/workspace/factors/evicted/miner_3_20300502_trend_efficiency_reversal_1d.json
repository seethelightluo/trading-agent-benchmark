  "factor_name": "Trend-Efficiency Volatility-Scaled Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(lagged_40d_return / realized_volatility_20d) * abs(lagged_40d_return) / lagged_40d_abs_return_path_40d",
    "description": "A contrarian cross-asset signal that reverses the direction of the prior 40-session return, scales by prior 20-session volatility, and weights the signal by trend efficiency (absolute net return divided by cumulative absolute daily return). All inputs are lagged one completed session before forecasting.",
    "formula": "F_i,t = -shift_1((close_i,t/close_i,t-40-1)/(std_20(return_i)+epsilon) * clip(abs(close_i,t/close_i,t-40-1)/(sum_40(abs(return_i))+epsilon),0,1))"
  },
  "dependencies": [
    "close"
  ],
