{
  "factor_id": "miner_2_20351122_residual_reversal_vol20",
  "factor_name": "Volatility-Scaled Relative 20-Day Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "rank_cs((-((close/close.shift(20))-1 - median_cs((close/close.shift(20))-1)) / rolling_std(pct_change(close),30)).shift(1))",
    "description": "For each tradable asset, subtract the contemporaneous cross-asset median 20-day return from its own 20-day return, reverse the residual, scale by trailing 30-day daily volatility, and lag one completed session. Higher values indicate stronger contrarian preference for relatively underperforming assets after volatility adjustment."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "residual_lookback_days": 20,
    "volatility_lookback_days": 30,
    "forward_horizon_days": 10,
    "signal_lag_days": 1,
    "minimum_cross_section": 8
  },
