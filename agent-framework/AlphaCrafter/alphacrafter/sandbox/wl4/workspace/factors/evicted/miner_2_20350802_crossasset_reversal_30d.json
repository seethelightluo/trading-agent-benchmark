  "factor_name": "Volatility-Scaled Cross-Asset Reversal 30d",
  "version": "1.2",
  "calculation": {
    "expression": "-(close/close.shift(30)-1) / rolling_std(pct_change(close), 20), lagged 1 completed session",
    "description": "Ranks assets higher when their trailing 30-session return is more negative after scaling by 20-session realized volatility. The one-session lag prevents look-ahead."
