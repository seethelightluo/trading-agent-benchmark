{
  "factor_id": "miner_1_20351122_residual_trend_quality_30d",
  "factor_name": "30-Day Cross-Asset Residual Trend Quality Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "lag1(-(return_30d - cross_sectional_median(return_30d)) / rolling_std(daily_return,30))",
    "description": "Ranks assets positively when their 30-day return is weak relative to the cross-asset median, scaled by 30-day realized volatility; intended as a risk-adjusted cross-asset mean-reversion signal. The one-session lag prevents look-ahead."
  },
  "dependencies": [
    "close",
    "daily_return"
  ],
