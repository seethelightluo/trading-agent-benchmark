  "version": "1.0",
  "calculation": {
    "expression": "-((close - rolling_min(close,210,min_periods=147))/(rolling_max(close,210,min_periods=147)-rolling_min(close,210,210,min_periods=147))) * (0.5 + smooth10(clip01((cross_sectional_std(pct_change(close,20))-rolling_min(...,60))/(rolling_max(...,60)-rolling_min(...,60))))) ; lag 1 session",
    "description": "Ranks assets favoring prices near their long rolling range lows, with reversal exposure amplified when smoothed cross-asset 20-day return dispersion is high. The signal is lagged one completed session to avoid look-ahead."
