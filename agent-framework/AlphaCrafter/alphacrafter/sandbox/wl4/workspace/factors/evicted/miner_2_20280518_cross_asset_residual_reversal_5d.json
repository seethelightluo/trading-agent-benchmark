  "factor_id": "miner_2_cross_asset_residual_reversal_5d",
  "factor_name": "Cross-Asset Residual Reversal 5D",
  "version": "1.0",
  "calculation": {
    "expression": "-((close[t]/close[t-5]-1) - cross_sectional_mean_i(close_i[t]/close_i[t-5]-1))",
    "description": "For each tradable asset, subtract the contemporaneous cross-sectional mean 5-day return from its own 5-day return and reverse the residual. Higher values favor assets that underperformed peers over the prior five completed sessions, using only information available at the signal date."
