  "factor_name": "30-day downside-adjusted reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-pct_change(close,30) / rolling_std(clip(pct_change(close,1), upper=0),30), lagged 1 session",
    "description": "Ranks instruments contrarily to their prior 30-session return, scaling the reversal signal by downside deviation so losses accumulated with greater downside risk receive a stronger contrarian score. The signal is lagged one completed session to avoid look-ahead."
