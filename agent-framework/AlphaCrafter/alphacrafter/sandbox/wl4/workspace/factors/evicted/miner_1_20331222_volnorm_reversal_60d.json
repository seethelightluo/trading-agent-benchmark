  "factor_name": "Volatility-normalized 60-day reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(close / close.shift(60) - 1) / (std(pct_change(close), 60) * sqrt(60)), shifted by one day",
    "description": "Ranks assets higher when their prior 60-trading-day return was more negative after normalization by trailing 60-day realized volatility. The one-day shift ensures only completed historical information is used."
  },
