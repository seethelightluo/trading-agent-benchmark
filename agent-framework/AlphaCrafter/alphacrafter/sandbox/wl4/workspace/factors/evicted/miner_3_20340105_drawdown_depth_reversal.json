  "factor_id": "miner_3_20340105_drawdown_depth_reversal",
  "factor_name": "Volatility-scaled drawdown-depth reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(close / rolling_min(close,120) - 1) / (rolling_std(pct_change(close),30) * sqrt(252)), shifted_by_1",
    "description": "Ranks assets with deeper distance below their 120-trading-day trough more highly, normalized by recent annualized volatility. The one-day lag ensures only completed data are used. This is an explicitly contrarian drawdown-depth signal, not momentum."
  },
