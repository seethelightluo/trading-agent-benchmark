  "factor_name": "Volatility-Weighted Breadth-Conditioned Cross-Asset Trend 20D",
  "version": "1.0",
  "calculation": {
    "expression": "zscore_cs(return_20d) * 2 * (weighted_positive_breadth_20d - 0.5), lagged_1d",
    "description": "Compute each asset's 20-day return, cross-sectional z-score it, and multiply by twice the deviation of inverse-realized-volatility-weighted positive 20-day participation from 50 percent. All inputs are shifted one completed trading day before being used for forward prediction."
