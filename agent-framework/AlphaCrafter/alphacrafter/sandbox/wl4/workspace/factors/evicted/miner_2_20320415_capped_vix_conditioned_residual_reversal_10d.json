{
  "factor_id": "capped_vix_conditioned_residual_reversal_10d",
  "factor_name": "Capped VIX-Conditioned Volatility-Scaled Residual Reversal",
  "version": "20320415",
  "calculation": {
    "expression": "(-residual_return_20d / realized_volatility_20d) * (1 + clip(max(log(VIX_t/VIX_t-10), 0), 0, 0.20)), lagged 1 session",
    "description": "For each tradable asset, compute its 20-session log return relative to the equal-weighted cross-asset 20-session log return, reverse the residual sign, scale by 20-session daily return volatility, and amplify positive VIX shocks over the preceding 10 sessions. The VIX amplification is capped at 20 percent and the complete signal is lagged one session to avoid look-ahead."
  },
  "dependencies": [
    "close",
    "VIX close",
    "cross-sectional equal-weighted returns"
  ],
  "parameters": {
    "residual_window": 20,
    "volatility_window": 20,
    "volatility_min_periods": 15,
    "vix_change_window": 10,
    "vix_positive_floor": 0.0,
    "vix_shock_cap": 0.2,
    "signal_lag": 1,
    "forward_validation_horizon": 10
  },
