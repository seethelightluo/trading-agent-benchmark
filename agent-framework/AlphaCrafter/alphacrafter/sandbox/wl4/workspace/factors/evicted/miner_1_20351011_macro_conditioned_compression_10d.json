  "factor_name": "VIX-Conditioned Own-Volatility Compression 10D",
  "version": "1.0",
  "calculation": {
    "expression": "-(rolling_std(pct_change(close),10)/rolling_std(pct_change(close),60)) * (1 + 0.5*clip(zscore_like(VIX,60),-1,1)) shifted 1 day",
    "description": "Ranks instruments by recent own-volatility compression relative to 60-day volatility, with compression exposure amplified in elevated VIX regimes. VIX is a macro observation-only conditioning signal; the factor remains lagged one completed trading day."
