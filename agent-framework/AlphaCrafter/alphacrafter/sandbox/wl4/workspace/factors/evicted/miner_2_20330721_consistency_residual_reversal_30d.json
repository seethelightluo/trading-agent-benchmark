  "factor_name": "Directional-Consistency-Scaled Residual 30-Day Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-cross_sectional_demean(pct_change(close,30)) * (0.5 + rolling_mean(indicator(daily_return>0),60,min_periods=40))",
