  "factor_name": "Volatility-scaled cross-asset relative reversal 45d",
  "version": "1.0",
  "calculation": {
    "expression": "-((rolling_sum(pct_change(close),45) - cross_sectional_median(rolling_sum(pct_change(close),45))) / rolling_std(pct_change(close),45)).shift(1)",
    "description": "For each tradable benchmark instrument, invert its 45-day cumulative return relative to the same-day cross-sectional median and scale by its 45-day return volatility. The one-day lag ensures only completed data are used. Higher values indicate stronger relative underperformance and expected subsequent reversal."
