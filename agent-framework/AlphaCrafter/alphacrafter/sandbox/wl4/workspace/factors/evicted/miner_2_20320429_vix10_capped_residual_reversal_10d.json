{
  "factor_id": "vix10_capped_residual_reversal_10d",
  "factor_name": "10% capped VIX-conditioned residual reversal",
  "version": "20320429",
  "calculation": {
    "expression": "shift_1((-residual_return_20d / realized_volatility_20d) * (1 + clip(max(0, log(VIX_t/VIX_t-10)), 0, 0.10)))",
    "description": "For each of the 15 tradable benchmark assets, compute 20-session log return relative to the equal-weighted cross-asset 20-session log return, divide its negative by 20-session daily-return volatility, and multiply by one plus the positive 10-session VIX log shock capped at 10%. Lag the complete signal by one session to avoid look-ahead."
  },
  "dependencies": [
    "close",
    "VIX close"
  ],
  "parameters": {
    "residual_window": 20,
    "volatility_window": 20,
    "vix_shock_window": 10,
    "vix_positive_cap": 0.1,
    "forward_horizon_for_validation": 10,
    "cross_section": "equal_weighted_15_asset_mean",
    "signal_lag_sessions": 1
  },
