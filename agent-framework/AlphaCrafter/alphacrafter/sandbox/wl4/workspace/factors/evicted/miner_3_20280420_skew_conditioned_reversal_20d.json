  "factor_name": "Volatility-Scaled Skewness-Conditioned Reversal 20D",
  "version": "1.0",
  "calculation": {
    "expression": "(-(sum_return_10d[t-1]) / (std_return_20d[t-1]*sqrt(20))) * (1 + 0.25*clip(skew_return_60d[t-1], -2, 2))",
    "description": "A lagged 10-day contrarian return scaled by trailing 20-day volatility, with a bounded common/asset-specific multiplier from trailing 60-day return skewness. Every input is available no later than the prior completed trading day; higher values indicate stronger reversal candidates."
  },
