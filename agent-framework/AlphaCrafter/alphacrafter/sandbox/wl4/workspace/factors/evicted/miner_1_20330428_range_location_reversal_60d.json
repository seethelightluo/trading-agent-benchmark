{
  "factor_id": "miner_1_20330428_range_location_reversal_60d",
  "factor_name": "Volatility-normalized 60-day range-location reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(close - rolling_min(close,60)) / (rolling_max(close,60)-rolling_min(close,60)) - 0.5, divided by rolling_std(daily_return,20), then lagged one day",
    "description": "Ranks assets positively when their lagged close is near the lower half of its 60-trading-day price range, with lower recent volatility receiving greater magnitude. The centered range location is negated for contrarian exposure; all observations are lagged to prevent look-ahead."
  },
  "dependencies": [
    "close",
    "daily_return"
  ],
  "parameters": {
    "range_window": 60,
    "volatility_window": 20,
    "min_range_observations": 40,
    "min_vol_observations": 15,
    "lag_days": 1
  },
