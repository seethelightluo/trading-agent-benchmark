{
  "factor_id": "downside_adjusted_momentum_20d",
  "factor_name": "Downside-Adjusted Momentum with Up-Day Consistency",
  "version": "1.0",
  "calculation": {
    "expression": "lag1((close/close[-20]-1) / sqrt(mean_20(min(pct_change(close),0)^2)) * (0.75 + 0.5*mean_20(pct_change(close)>0)) )",
    "description": "Twenty-trading-day momentum normalized by downside deviation, with a modest multiplier for the fraction of up days. The one-day lag prevents look-ahead use at decision time."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "momentum_window": 20,
    "downside_vol_window": 20,
    "consistency_window": 20,
