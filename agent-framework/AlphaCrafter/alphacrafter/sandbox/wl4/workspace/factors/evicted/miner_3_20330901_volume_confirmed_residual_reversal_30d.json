  "factor_name": "Volume-Confirmed Volatility-Scaled Broad Residual Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "shift_1((-residual_return_30d / annualized_volatility_20d) * (1 + 0.5*log(clamp(relative_volume_40d,0.25,4))))",
