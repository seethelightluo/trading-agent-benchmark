{
  "factor_id": "risk_adjusted_reversal_40d",
  "factor_name": "40-Session Risk-Adjusted Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-((close_t- close_{t-40})/close_{t-40}) / (std(pct_change(close),40)*sqrt(252)), lagged one completed session",
    "description": "Ranks assets higher when their trailing 40-session return has been weak after adjustment for realized volatility; intended as a contrarian cross-asset signal. All inputs are lagged one session at decision time."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "lookback_sessions": 40,
    "volatility_window": 40,
    "annualization": 252,
    "lag_sessions": 1,
    "minimum_cross_section": 8
  },
