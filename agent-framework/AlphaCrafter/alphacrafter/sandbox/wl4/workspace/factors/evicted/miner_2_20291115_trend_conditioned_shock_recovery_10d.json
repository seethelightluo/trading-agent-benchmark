{
  "factor_id": "miner_2_20291115_trend_conditioned_shock_recovery_10d",
  "factor_name": "Trend-Conditioned Downside Shock Recovery",
  "version": "1.0",
  "calculation": {
    "expression": "lag1(-10d_return / rolling_rms(downside_returns,20) * I(60d_return > 0))",
    "description": "Ranks assets for 10-day recovery after a short pullback, but only when the longer 60-day regime is positive; downside-volatility scaling avoids rewarding ordinary high-noise assets.",
    "signal_reconstruction": "r=close.pct_change(); downside_rms=r.clip(upper=0).pow(2).rolling(20,min_periods=15).mean().pow(0.5); short=close/close.shift(10)-1; regime=(close/close.shift(60)-1>0).astype(float); signal=(-short/(downside_rms+1e-8)*regime).replace([inf,-inf],nan).shift(1)."
  },
  "dependencies": [
    "close",
    "daily_return"
  ],
  "parameters": {
    "shock_window_days": 10,
    "regime_window_days": 60,
    "downside_vol_window_days": 20,
    "downside_vol_min_periods": 15,
    "lag_days": 1,
    "forward_horizon_days": 10,
    "minimum_cross_section": 8,
