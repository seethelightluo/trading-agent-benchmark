  "version": "2033-12-22",
  "calculation": {
    "expression": "(-pct_change(close,30) / annualized_std(pct_change(close),20)).shift(1)",
    "description": "Ranks assets higher when their prior 30-trading-day return was more negative after normalization by trailing 20-day annualized realized volatility. The one-session lag ensures only completed information is used."
