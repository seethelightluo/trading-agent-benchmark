{
  "factor_id": "miner_3_stress_inefficient_reversal_10d",
  "factor_name": "Cross-Asset Stress-Scaled Path-Inefficiency Contrarian Reversal",
  "version": "20290531",
  "calculation": {
    "expression": "((-return(close,20) * (1 - abs(return(close,20))/rolling_sum(abs(daily_return),20)) / rolling_std(daily_return,20)) * (1 + 0.5 * (clip(median_cross_section(rolling_std(daily_return,20)) / rolling_median(median_cross_section(rolling_std(daily_return,20)),60),0.5,2.0)-1))).shift(1)",
    "description": "The base path-inefficiency weighted 20-day contrarian reversal is multiplied by a mild cross-asset realized-volatility stress scaling. Cross-sectional median 20-day volatility is divided by its trailing 60-day median, clipped to [0.5,2.0], and the centered stress is multiplied by 0.5. The full signal is lagged one completed trading day to prevent look-ahead bias; higher stress modestly amplifies the existing reversal signal without changing its sign."
  },
  "dependencies": ["close"],
  "parameters": {
    "return_lookback_days": 20,
    "path_window_days": 20,
    "volatility_window_days": 20,
    "cross_asset_baseline_days": 60,
    "stress_clip": [0.5, 2.0],
    "stress_scale": 0.5,
    "lag_days": 1,
    "validation_horizon_days": 10,
    "minimum_cross_section": 8
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2026-01-01 through 2029-05-30",
    "validated_on": "2029-05-31",
    "metrics": {
