{
  "factor_id": "miner_1_volume_confirmed_reversal_20d",
  "factor_name": "Volume-Confirmed Five-Day Reversal",
  "version": "2030-06-13",
  "calculation": {
    "expression": "(-sum(return,5) * volume / rolling_mean(volume,20)).shift(1)",
    "description": "Ranks assets higher when their prior five-session return was negative and occurred with abnormally high volume; the one-session lag prevents look-ahead. Intended for a 20-session forward horizon."
  },
  "dependencies": ["close", "volume"],
  "parameters": {"return_window": 5, "volume_window": 20, "forward_horizon": 20, "signal_lag": 1},
  "validation": {
