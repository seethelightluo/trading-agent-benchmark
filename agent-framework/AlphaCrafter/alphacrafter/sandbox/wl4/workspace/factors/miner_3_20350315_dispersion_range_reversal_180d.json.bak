{
  "factor_id": "miner_3_20350315_dispersion_range_reversal_180d",
  "factor_name": "Dispersion-conditioned 180-day range reversal",
  "version": "2035-03-15",
  "calculation": {
    "expression": "-((close - rolling_min(close,180,min_periods=126))/(rolling_max(close,180,min_periods=126)-rolling_min(close,180,min_periods=126))) * (0.5 + rolling_mean(percentile_position(cross_asset_std(pct_change(close,20)),60),10))",
    "description": "One-session-lagged negative 180-session range position, amplified by the recent cross-asset 20-day return dispersion percentile. Higher values indicate stronger reversal opportunity, especially in elevated-dispersion regimes."
  },
  "dependencies": ["close"],
  "parameters": {"range_window": 180, "range_min_periods": 126, "dispersion_return_window": 20, "dispersion_rank_window": 60, "dispersion_smoothing_window": 10, "signal_lag": 1, "forward_horizon": 10, "minimum_cross_section": 8},
