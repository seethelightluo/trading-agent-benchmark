{
  "factor_id": "miner_2_20340427_downside_volscaled_reversal_60d",
  "factor_name": "Downside-volatility-scaled 60-day reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-((close / close.shift(60)) - 1) / (sqrt(rolling_mean(clip(pct_change(close), upper=0)^2, 60)) * sqrt(252)), shifted(1)",
    "description": "Ranks assets by the negative trailing 60-session return, scaled by downside semi-deviation; signal is lagged one completed session and evaluated for 10-session forward returns."
  },
  "dependencies": ["close"],
  "parameters": {"return_window": 60, "downside_window": 60, "min_periods": 35, "annualization": 252, "signal_lag": 1, "forward_horizon": 10, "min_cross_section": 8},
