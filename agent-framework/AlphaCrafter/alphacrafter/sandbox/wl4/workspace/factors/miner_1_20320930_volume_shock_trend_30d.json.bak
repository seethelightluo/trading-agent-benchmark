{
  "factor_id": "miner_1_20320930_volume_shock_trend_30d",
  "factor_name": "Volume-Shock Confirmed Volatility-Normalized Trend",
  "version": "1.0",
  "calculation": {
    "expression": "lag1((pct_change(close,20)/(rolling_std(pct_change(close,1),60)*sqrt(20))) * log(clip(volume/rolling_median(volume,60),0.25,4.0)))",
    "description": "Twenty-session volatility-normalized trend multiplied by a bounded log volume-participation shock. The full signal is lagged one session so only completed sessions are used."
  },
  "dependencies": [
    "close",
    "volume"
  ],
  "parameters": {
    "trend_window": 20,
    "volatility_window": 60,
    "volume_median_window": 60,
    "volume_clip": [
      0.25,
      4.0
    ],
    "lag_sessions": 1,
    "validation_horizon": 30
  },
