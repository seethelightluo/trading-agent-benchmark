{
  "factor_id": "relative_residual_reversal_10d",
  "factor_name": "Cross-Asset Relative Residual Reversal",
  "version": "20300613",
  "calculation": {
    "expression": "-((R20_i - median_j(R20_j)) / std20(r_i - median_j(r_j))) shifted by 1 session",
    "description": "For each tradable instrument, subtract the cross-sectional median 20-session return to isolate relative residual performance, then reverse the residual and scale by 20-session volatility of daily returns relative to the cross-sectional median. Inputs are shifted one completed session to prevent look-ahead bias."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "return_window": 20,
    "volatility_window": 20,
    "vol_min_periods": 15,
    "cross_section_robust_center": "median",
    "lag_sessions": 1,
    "minimum_cross_section": 8
  },
