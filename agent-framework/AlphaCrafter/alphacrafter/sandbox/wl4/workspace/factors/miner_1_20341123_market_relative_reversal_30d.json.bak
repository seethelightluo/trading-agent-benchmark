{
  "factor_id": "market_relative_reversal_30d",
  "factor_name": "Market-relative idiosyncratic reversal, 30-day",
  "version": "1.0",
  "calculation": {
    "expression": "-((return_30(asset) - sum(mean_cross_sectional_daily_return,30)) / (sqrt(30)*rolling_std_30(asset_daily_return - mean_cross_sectional_daily_return)))",
    "description": "At each date, subtract the equal-weight cross-asset market's 30-session return from each asset's 30-session return, divide by 30-session residual volatility annualization proxy, negate, and lag one session. Higher values favor assets with weaker market-relative recent performance on a risk-adjusted basis."
  },
  "dependencies": ["close"],
  "parameters": {"lookback_sessions": 30, "forward_horizon_sessions": 10, "minimum_cross_section": 8, "lag_sessions": 1, "market_return": "equal_weight_mean_asset_daily_return", "residual_volatility_window": 30},
