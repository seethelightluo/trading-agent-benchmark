{
  "factor_id": "miner_3_20320722_downside_residual_reversal_20d",
  "factor_name": "Downside-volatility-scaled 10-day residual reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-lag1((sum_10(asset_return-equal_weight_benchmark_return))/downside_volatility_30)",
    "description": "Contrarian cross-asset residual return over 10 sessions, scaled by 30-session downside volatility and lagged one completed session to avoid look-ahead. Higher values indicate relatively underperforming assets with adverse-move risk scaled residuals, used as a reversal signal."
  },
  "dependencies": ["close", "pct_change"],
  "parameters": {"residual_window": 10, "downside_volatility_window": 30, "min_residual_observations": 8, "min_downside_observations": 20, "annualization": 252, "signal_lag": 1, "forward_horizon": 20, "universe_size": 15},
