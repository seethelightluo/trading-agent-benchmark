{
  "factor_id": "miner_2_20311016_breadth_gated_residual_reversal_20d",
  "factor_name": "Breadth-gated downside-volatility residual reversal 20d",
  "version": "1.0",
  "calculation": {
    "expression": "shift1(-(ret20 - cross_sectional_median(ret20)) / (0.7*downside_vol40 + 0.3*vol40) * clip(1.35 - rolling_mean30(breadth20), 0.65, 1.35)",
    "description": "Cross-asset 20-session residual reversal scaled by downside/total 40-session volatility, with a positive bounded multiplier that strengthens reversal exposure when rolling 30-session breadth is narrow. The signal is lagged one completed session to avoid look-ahead."
  },
  "dependencies": ["close"],
  "parameters": {
    "residual_horizon": 20,
    "risk_window": 40,
    "downside_weight": 0.7,
    "total_vol_weight": 0.3,
    "breadth_horizon": 20,
    "breadth_window": 30,
    "multiplier_min": 0.65,
    "multiplier_max": 1.35,
    "signal_lag": 1,
    "admission_horizon": 20,
    "universe_size": 15
  },
