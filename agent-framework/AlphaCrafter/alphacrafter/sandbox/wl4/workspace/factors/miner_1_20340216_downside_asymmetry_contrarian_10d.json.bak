  "factor_name": "Downside-Asymmetry Contrarian Trend",
  "version": "1.0",
  "calculation": {
    "expression": "lag(-return_60d / (0.7*downside_volatility_40d + 0.3*realized_volatility_40d), 1)",
    "description": "Contrarian ranking of 60-session returns, scaled by downside and total volatility. Assets with poor medium-term performance relative to their downside risk receive higher scores; the signal is lagged one completed session to avoid look-ahead bias.",
    "signal_reconstruction": "Load close prices for the 15 tradable benchmark instruments through the previous completed day. Compute daily returns, downside volatility as rolling 40-day standard deviation of negative returns with non-negative returns replaced by zero, total 40-day annualized volatility, then F=-(close.pct_change(60)/(0.7*downside_vol+0.3*total_vol)). Shift F by one session. Missing values remain missing."
  },
  "dependencies": ["close"],
  "parameters": {"return_window": 60, "risk_window": 40, "downside_weight": 0.7, "total_vol_weight": 0.3, "forward_horizon": 10, "signal_lag": 1},
