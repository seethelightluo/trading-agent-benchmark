{
  "factor_id": "miner_3_drawdown_recovery_10d",
  "factor_name": "Inefficient Drawdown Recovery",
  "version": "1.0",
  "calculation": {
    "expression": "shift1(((abs(close/rolling_max(close,60)-1) * ((pct_change(close,10)-shift(pct_change(close,30),10)) / rolling_std(pct_change(close,1),20)) * clip(1-abs(pct_change(close,10))/rolling_sum(abs(pct_change(close,1)),10), lower=0)) / rolling_std(pct_change(close,1),20)))",
    "description": "Ranks assets for forward recovery after a deep 60-day drawdown, rewarding improving 10-day returns versus the preceding 30-day path and penalizing inefficient/choppy recent movement. The one-day shift ensures only completed data are used."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "drawdown_window": 60,
    "drawdown_min_periods": 40,
    "recent_window": 10,
    "prior_window": 30,
    "volatility_window": 20,
    "inefficiency_window": 10,
    "signal_lag_days": 1,
    "forward_horizon_days": 10
  },
