{
  "factor_id": "miner_2_drawdown_penalized_momentum_10d",
  "factor_name": "Drawdown-Penalized Volatility-Adjusted Momentum (Current Revalidation)",
  "version": "20290111",
  "calculation": {
    "expression": "close_return_20d / (std(pct_change(close),20)*sqrt(20)) - 0.75*((rolling_max(close,60)-close)/rolling_max(close,60))",
    "description": "Cross-sectional score combining 20-session return normalized by 20-session realized volatility with a penalty for distance below the 60-session high. Signal uses the previous completed session only."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "momentum_window": 20,
    "volatility_window": 20,
    "drawdown_window": 60,
    "drawdown_penalty": 0.75,
    "forward_horizon": 10,
    "lag_sessions": 1
  },
  "signal_provenance": {
    "artifact_type": "reproducible_definition",
