{
  "factor_id": "mad_residual_reversal_10d",
  "factor_name": "MAD-scaled cross-asset residual reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-((return_10_i - cross_sectional_median(return_10)) / rolling_MAD(return_1_i,40)).shift(1)",
    "description": "For each tradable asset, negate its 10-day return residual relative to the daily cross-sectional median and scale by its 40-day rolling median absolute deviation of daily returns. Lag one completed session to avoid look-ahead. Higher values indicate stronger reversal opportunity."
  },
  "dependencies": ["close"],
  "parameters": {"residual_window_days": 10, "mad_window_days": 40, "lag_days": 1, "minimum_cross_section": 8},
