{
  "factor_id": "miner_3_defensive_volatility_quality_10d",
  "factor_name": "Defensive Volatility Quality",
  "version": "1.0",
  "calculation": {
    "expression": "lag(-(realized_vol_20d / median(realized_vol_20d,120d)) - 0.5 * pct_change(realized_vol_20d,10d), 1)",
    "description": "Ranks assets favoring volatility below their own 120-day median and volatility that is declining over the last 10 days. Lower and improving realized volatility receive higher scores. The signal is lagged one completed trading day.",
    "signal_reconstruction": "Load close prices for the 15 tradable symbols through the prior completed day; r=close.pct_change(); vol=r.rolling(20,min_periods=15).std()*sqrt(252); baseline=vol.rolling(120,min_periods=60).median(); raw=-(vol/baseline)-0.5*vol.pct_change(10); signal=raw.shift(1). No observation after the decision's prior completed day is used."
  },
  "dependencies": [
    "close",
    "daily_return"
  ],
  "parameters": {
    "volatility_window_days": 20,
    "volatility_min_periods": 15,
    "baseline_window_days": 120,
    "baseline_min_periods": 60,
    "volatility_change_days": 10,
    "volatility_change_weight": 0.5,
    "annualization": 252,
    "lag_days": 1,
    "forward_horizon_days": 10,
    "universe_size": 15
  },
