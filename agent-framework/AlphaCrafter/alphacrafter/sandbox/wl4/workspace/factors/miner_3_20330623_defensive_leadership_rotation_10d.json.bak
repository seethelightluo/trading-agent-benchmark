{
  "factor_id": "miner_3_20330623_defensive_leadership_rotation_10d",
  "factor_name": "Defensive Leadership Rotation",
  "version": "1.0",
  "calculation": {
    "expression": "((return_20 - return_60) * (1 + 0.8 * (rank_40(mean(return_20[defensive]) - mean(return_20[cyclical])) - 0.5))).shift(1)",
    "description": "Asset-specific 20-day versus 60-day return acceleration, scaled by the lagged relative leadership of defensive assets versus cyclical assets. Defensive set is XAU, US10Y, CN10Y; cyclical set is WTI, COPPER, BTC, ETH, SOX, NDX. Inputs and regime gate are lagged one completed trading day. Positive values favor assets with improving relative trend when defensive leadership is strong, while retaining cross-sectional differentiation."
  },
  "dependencies": ["close"],
  "parameters": {
    "short_window": 20,
    "long_window": 60,
    "regime_window": 40,
    "regime_smoothing_window": 10,
    "defensive_assets": ["XAU", "US10Y", "CN10Y"],
    "cyclical_assets": ["WTI", "COPPER", "BTC", "ETH", "SOX", "NDX"],
    "regime_multiplier": 0.8,
    "forward_horizon_days": 10
  },
