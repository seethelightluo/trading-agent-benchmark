{
  "factor_id": "miner_3_tailrisk_reversal_10d",
  "factor_name": "Tail-Risk Normalized Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "lag(rolling_mean(-return_10d / downside_volatility_20d, 3), 1)",
    "description": "Ranks assets by ten-day reversal normalized by recent downside volatility: recent losses relative to downside risk receive higher scores, with a three-day smoothing window and one-day information lag.",
    "signal_reconstruction": "Load close prices for the 15 tradable symbols through the prior completed day; r=close.pct_change(); downside_vol=r.clip(upper=0).rolling(20,min_periods=15).std(); raw=-close.pct_change(10)/(downside_vol+1e-8); signal=raw.rolling(3,min_periods=2).mean().shift(1)."
  },
  "dependencies": [
    "close",
    "daily_return"
  ],
  "parameters": {
    "return_window_days": 10,
    "downside_volatility_window_days": 20,
    "downside_volatility_min_periods": 15,
    "smoothing_window_days": 3,
    "smoothing_min_periods": 2,
    "lag_days": 1,
    "forward_horizon_days": 10,
    "universe_size": 15
  },
