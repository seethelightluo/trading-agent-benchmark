  "factor_id": "range_slow_trend_30d",
  "factor_name": "Slow Range-Position Volatility-Scaled Trend",
  "version": "1.0",
  "calculation": {
    "expression": "shift1((close/close[-60]-1)/(std(pct_change(close),90)*sqrt(60)) * mean((close-low)/(high-low)-0.5,25))",
    "description": "A lagged 60-session volatility-scaled trend multiplied by the 25-session mean close location within the daily range. The one-session shift ensures only completed prior-day information is used."
  },
  "dependencies": ["close", "high", "low"],
  "parameters": {"trend_window": 60, "volatility_window": 90, "range_position_window": 25, "horizon": 30, "min_cross_section": 8},
