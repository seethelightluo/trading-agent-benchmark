{
  "factor_id": "asymmetric_rebound_10d",
  "factor_name": "Volatility-normalized downside-asymmetry rebound",
  "version": "1.0",
  "calculation": {
    "expression": "-return(close,10)[t-1] * clip(downside_std(return,40)[t-1] / total_std(return,40)[t-1],0,3) / total_std(return,40)[t-1]",
    "description": "Cross-sectional rebound score favoring recent 10-session losers, with greater weight for losses occurring under concentrated downside volatility, normalized by medium-term realized volatility. All rolling inputs are lagged one completed session to avoid look-ahead."
  },
  "dependencies": ["close"],
  "parameters": {"reversal_window": 10, "volatility_window": 40, "min_periods": 20, "asymmetry_clip": [0, 3], "lag_sessions": 1},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2032-09-01",
    "validation_timestamp": "2032-09-02T00:00:00Z",
    "regime_notes": "Validated across the full synthetic cross-asset history and multiple market regimes; interpretation is conservative because the cross-section has 15 instruments.",
