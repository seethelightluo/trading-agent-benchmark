{
  "factor_id": "miner_2_20291213_residual_trend_reversal_10d",
  "factor_name": "Cross-asset residual shock recovery with smooth trend conditioning",
  "version": "1.0",
  "calculation": {
    "expression": "shift1((-rolling_sum_10(asset_return - cross_sectional_median_return_1)/(rolling_std_20(asset_return)*sqrt(10))) * (0.25 + 0.75*(1+tanh(pct_change_60/0.12))/2))",
    "description": "At each date, subtract the cross-sectional median one-day return to isolate asset-specific residual movement. Reward normalized 10-day residual underperformance as a contrarian recovery signal, with a smooth multiplier that emphasizes assets in positive 60-day trends. Signal is lagged one completed day to prevent look-ahead."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "residual_window_days": 10,
    "volatility_window_days": 20,
    "trend_window_days": 60,
    "trend_scale": 0.12,
    "trend_floor": 0.25,
    "lag_days": 1,
    "min_vol_observations": 15
  },
  "validation": {
    "status": "EFFECTIVE",
