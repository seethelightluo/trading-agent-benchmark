{
  "factor_id": "miner_1_range_position_reversal_10d",
  "factor_name": "Lagged intraday range-position reversal",
  "version": "1.0.0",
  "calculation": {
    "expression": "(0.5 - (close_t - low_t) / (high_t - low_t)).shift(1)",
    "description": "Ranks assets positively when the prior completed session closed near the bottom of its high-low range, anticipating cross-asset reversal over the next ten sessions. Zero-range observations are invalid and the signal is lagged to avoid look-ahead."
  },
  "dependencies": [
    "open",
    "high",
    "low",
    "close"
  ],
  "parameters": {
    "horizon_days": 10,
    "lag_days": 1,
    "minimum_cross_section": 8,
    "winsorization": null
  },
