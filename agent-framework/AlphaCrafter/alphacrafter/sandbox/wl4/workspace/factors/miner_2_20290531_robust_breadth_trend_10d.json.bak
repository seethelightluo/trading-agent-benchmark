{
  "factor_id": "miner_2_20290531_robust_breadth_trend_10d",
  "factor_name": "Breadth-conditioned robust trend",
  "version": "2029-05-31",
  "calculation": {
    "expression": "shift1((close/close[-60]-1)/(std(pct_change(close),40)*sqrt(40)) * (1 if cross_sectional_breadth_60d>=0.5 else -0.5))",
    "description": "Cross-sectional 60-day momentum scaled by 40-day realized volatility. When at least half of available tradable assets have positive 60-day returns, preserve trend direction; otherwise reverse and dampen the signal for a defensive regime. All inputs are lagged one completed day."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "trend_window": 60,
    "vol_window": 40,
    "breadth_threshold": 0.5,
    "bear_state_multiplier": -0.5,
    "lag_days": 1,
    "min_cross_section": 8
  },
