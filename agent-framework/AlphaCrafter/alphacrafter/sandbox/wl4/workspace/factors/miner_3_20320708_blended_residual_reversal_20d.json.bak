{
  "factor_id": "miner_3_20320708_blended_residual_reversal_20d",
  "factor_name": "20/30-day volatility-scaled cross-asset residual reversal blend",
  "version": "1.0",
  "calculation": {
    "expression": "0.5*(-(R20_i-mean_i(R20))/annvol20_i) + 0.5*(-(R30_i-mean_i(R30))/annvol30_i), lagged 1 day",
    "description": "For each tradable asset, compute cumulative return over 20 and 30 sessions, subtract the equal-weight cross-asset cumulative return benchmark, divide each residual by its own rolling annualized return volatility, negate for reversal, average the two horizons, and lag the signal one completed day. Rank direction is positive for expected higher forward returns."
  },
  "dependencies": ["close"],
  "parameters": {
    "short_window": 20,
    "long_window": 30,
    "volatility_annualization": 252,
    "minimum_window_observations": {"short": 15, "long": 25},
    "blend_weights": [0.5, 0.5],
    "signal_lag_days": 1,
    "forward_validation_horizon_days": 20,
    "universe_size": 15
  },
