  "dependencies": ["close"],
  "parameters": {"return_window": 10, "dispersion_baseline_window": 40, "dispersion_min_periods": 25, "gate_lower": 0.5, "gate_upper": 2.0, "smoothing_window": 3, "signal_lag": 1, "horizon_days": 20},
