  "factor_name": "Smoothed dispersion-gated residual reversal 20d",
  "version": "1.0",
  "calculation": {
    "expression": "shift(rolling_mean_3(-((ret_10 - cross_sectional_median(ret_10)) * clip(cross_sectional_std(ret_10) / rolling_mean_40(cross_sectional_std(ret_10), min_periods=25), 0.5, 2.0))), 1)",
    "description": "Cross-sectional 10-session residual reversal, scaled by the prevailing cross-sectional return dispersion relative to its 40-session baseline, smoothed over three observations and lagged one completed session to avoid look-ahead. Higher values indicate stronger expected forward returns."
