{
  "factor_id": "miner_1_residual_momentum_quality_10d",
  "factor_name": "Residual Momentum Quality",
  "version": "1.0",
  "calculation": {
    "expression": "((close/close.shift(20)-1) - cross_sectional_mean(close/close.shift(20)-1)) / rolling_std(pct_change(close),20)",
    "description": "Ranks assets by 20-session return relative to the equal-weight universe, scaled by each asset's 20-session realized volatility. The signal is shifted by one completed session to prevent look-ahead bias. Higher values indicate stronger risk-adjusted residual momentum."
  },
  "dependencies": [
    "close",
    "pct_change"
  ],
  "parameters": {
    "lookback_sessions": 20,
    "volatility_window": 20,
    "forward_horizon_sessions": 10,
    "minimum_cross_section": 8,
    "lag_sessions": 1
  },
