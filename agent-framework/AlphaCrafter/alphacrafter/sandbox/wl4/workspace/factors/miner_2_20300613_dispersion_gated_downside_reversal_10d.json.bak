{
  "factor_id": "miner_2_20300613_dispersion_gated_downside_reversal_10d",
  "factor_name": "Dispersion-gated relative downside reversal",
  "version": "1.0",
  "calculation": {
    "expression": "shift(1, -(rolling_sum(pct_change(close),10)-cross_sectional_median(rolling_sum(pct_change(close),10))) / rolling_std(negative_only(pct_change(close)),20) * rolling_mean(cross_sectional_std(pct_change(close)),5) / rolling_median(rolling_mean(cross_sectional_std(pct_change(close)),5),60))",
    "description": "Ranks assets positively when their lagged 10-session return is unusually poor relative to the cross-sectional median, scaled by their 20-session downside volatility and amplified during elevated five-session cross-asset dispersion relative to its 60-session median. The one-session lag prevents look-ahead."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "relative_return_window": 10,
    "downside_vol_window": 20,
    "dispersion_window": 5,
    "dispersion_baseline_window": 60,
    "signal_lag": 1,
    "forward_horizon": 10
  },
