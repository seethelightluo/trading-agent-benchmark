{
  "factor_id": "miner_1_intraday_reversal_10d",
  "factor_name": "Volatility-normalized intraday reversal",
  "version": "2030-08-08",
  "calculation": {
    "expression": "(-(close/open-1) / rolling_std(daily_close_return,20)).shift(1)",
    "description": "Ranks assets higher when the prior session's open-to-close decline was larger after volatility normalization; signal is lagged one completed session to avoid look-ahead."
  },
  "dependencies": [
    "open",
    "close"
  ],
  "parameters": {
    "volatility_window": 20,
    "volatility_min_periods": 15,
    "lag_sessions": 1,
    "forward_horizon": 10
  },
