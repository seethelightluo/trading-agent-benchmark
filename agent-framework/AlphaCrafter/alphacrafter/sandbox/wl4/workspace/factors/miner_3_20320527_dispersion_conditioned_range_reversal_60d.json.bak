{
  "factor_id": "miner_3_20320527_dispersion_conditioned_range_reversal_60d",
  "factor_name": "Dispersion-conditioned 60-day range-location reversal",
  "version": "1.0",
  "calculation": {
    "expression": "(0.5 - (close - rolling_min(low,60)) / (rolling_max(high,60)-rolling_min(low,60))) * clip(cross_asset_mean(rolling_std(pct_change(close),20)) / rolling_median_252(cross_asset_mean(rolling_std(pct_change(close),20))), 0.5, 2.0)",
    "description": "Contrarian range-location score amplified in elevated cross-asset volatility dispersion and attenuated in unusually quiet regimes. All rolling inputs are backward-looking at the signal date."
  },
  "dependencies": ["close", "high", "low"],
  "parameters": {"range_window": 60, "range_min_periods": 40, "dispersion_window": 20, "dispersion_min_periods": 15, "regime_median_window": 252, "regime_median_min_periods": 60, "gate_floor": 0.5, "gate_ceiling": 2.0, "forward_horizon": 10},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2032-05-27",
