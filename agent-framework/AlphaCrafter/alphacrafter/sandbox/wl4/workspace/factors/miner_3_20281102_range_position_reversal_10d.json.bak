{
  "factor_id": "range_position_reversal_10d",
  "factor_name": "20-day range-position pullback reversal with tape filter",
  "version": "1.0",
  "calculation": {
    "expression": "(0.5 - (close[t-1] - rolling_min(close,20)[t-1]) / (rolling_max(close,20)[t-1] - rolling_min(close,20)[t-1])) * (0.5 + 0.5*I(mean_assets(rolling_mean(pct_change(close),20)[t-1]) > -0.01))",
    "description": "Ranks assets that closed near the bottom of their lagged 20-session price range more highly as reversal candidates. A broad-tape filter halves the signal when the prior 20-session average cross-asset return is below -1 percent. All inputs are lagged one completed session.",
    "signal_provenance": "scripts/miner_3_20281102_range_position_reversal.py; reproducible from ../persistent/stock_data close series through 2028-11-01"
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "range_window": 20,
    "minimum_observations": 15,
    "tape_window": 20,
    "tape_threshold": -0.01,
    "forward_horizon_days": 10,
    "winsorization": "none"
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": {
      "start": "2020-01-01",
