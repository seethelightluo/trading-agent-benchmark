{
  "factor_id": "miner_3_range_position_reversal_40d",
  "factor_name": "40-day range-position reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(close - rolling_min(close,40))/(rolling_max(close,40)-rolling_min(close,40)), shifted by 1 completed session",
    "description": "Ranks instruments higher when their lagged close is near the bottom of its trailing 40-session range, using cross-sectional ranking for portfolio construction. Undefined zero-range observations are omitted."
  },
  "dependencies": ["close"],
  "parameters": {"lookback_sessions": 40, "min_periods": 28, "forward_horizon_sessions": 10, "lag_sessions": 1},
  "validation": {
