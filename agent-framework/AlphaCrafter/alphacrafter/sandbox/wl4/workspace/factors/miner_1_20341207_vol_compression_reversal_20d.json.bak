  "factor_id": "vol_compression_reversal_20d",
  "factor_name": "Volatility-Compression-Scaled 20-Day Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "(-return_20 / (sqrt(20)*volatility_20)) * clip(volatility_20/volatility_60, 0.25, 2.0), lagged_one_session",
    "description": "Contrarian recent 20-session return, risk-scaled by 20-session volatility and modulated by the ratio of short- to long-term volatility; all inputs are lagged one completed session."
  },
  "dependencies": ["close"],
  "parameters": {"return_window": 20, "short_vol_window": 20, "long_vol_window": 60, "forward_horizon": 10, "vol_ratio_floor": 0.25, "vol_ratio_cap": 2.0, "lag": 1},
