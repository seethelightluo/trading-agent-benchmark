{
  "factor_id": "miner_1_20280518_vix_scaled_reversal_5d",
  "factor_name": "VIX-Scaled Five-Day Cross-Asset Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-sum(return_t-4..return_t) * (VIX_t / median(VIX_{t-59}..VIX_t))",
    "description": "Ranks assets for reversal after a five-session move, scaling the contrarian signal by the contemporaneous VIX level relative to its trailing 60-session median. Price and VIX inputs are lagged operationally so only the prior completed session is used at decision time.",
    "signal_artifact": "scripts/miner_1_20280518_vix_conditioned_reversal.py",
    "implementation_note": "Forward one-session return is used for admission IC; factor is intended for short-horizon portfolio ranking and may be evaluated at the 10-day rebalance cadence."
  },
  "dependencies": ["close", "pct_change", "VIX.close"],
  "parameters": {"return_lookback_sessions": 5, "vix_median_window_sessions": 60, "forward_horizon_sessions": 1, "minimum_cross_section": 8},
  "validation": {
    "status": "EFFECTIVE",
