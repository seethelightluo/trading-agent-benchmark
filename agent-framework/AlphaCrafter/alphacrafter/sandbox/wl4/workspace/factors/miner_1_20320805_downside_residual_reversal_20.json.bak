{
  "factor_id": "miner_1_20320805_downside_residual_reversal_20",
  "factor_name": "Downside-volatility-scaled residual reversal 10d",
  "version": "1.0",
  "calculation": {
    "expression": "-(rolling_sum_10(asset_return - cross_sectional_mean_return_10) / rolling_30_downside_volatility).shift(1)",
    "description": "Compute each asset's 10-session cumulative return residual relative to the contemporaneous cross-sectional mean, divide by 30-session annualized downside volatility, negate to form a contrarian score, and lag one completed session to prevent look-ahead. Higher values indicate stronger expected forward returns."
  },
  "dependencies": [
    "close",
    "pct_change"
  ],
  "parameters": {
    "residual_window": 10,
    "downside_volatility_window": 30,
    "downside_volatility_definition": "sqrt(mean(min(return,0)^2))*sqrt(252)",
    "lag_sessions": 1,
    "forward_horizon_for_validation": 20,
    "minimum_cross_section": 8
  },
  "validation": {
    "status": "EFFECTIVE",
    "validated_at": "2032-08-05",
