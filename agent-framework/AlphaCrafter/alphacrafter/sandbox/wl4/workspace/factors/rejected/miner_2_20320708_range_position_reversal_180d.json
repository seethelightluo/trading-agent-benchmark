{
  "factor_id": "range_position_reversal_180d",
  "factor_name": "Volatility-scaled 180-day range-position reversal",
  "version": "1.0",
  "calculation": {
    "expression": "(0.5 - ((lagged_close - rolling_min(lagged_close,180)) / (rolling_max(lagged_close,180) - rolling_min(lagged_close,180)))) / max(annualized_realized_volatility_40d, 0.05)",
    "description": "For each tradable benchmark, measure the prior completed day's location in its trailing 180-session high-low range and reverse it, scaling by lagged 40-session realized volatility. Higher values favor assets nearer the lower half of their long range, particularly when volatility is lower. All inputs are lagged to avoid look-ahead."
  },
  "dependencies": ["close", "daily_returns"],
  "parameters": {"range_window": 180, "range_min_periods": 120, "vol_window": 40, "vol_min_periods": 30, "annualization": 252, "volatility_floor": 0.05, "forward_horizon_for_admission": 10},
