      "dates": 2269,
      "average_instruments": 14.43,
      "minimum_instruments": 8,
      "factor_coverage": 0.7321,
      "turnover": null,
      "decay_ic": {"5d": 0.011875, "10d": 0.016652, "20d": 0.00484},
      "max_abs_library_correlation": null
    },
    "regime_notes": "Positive full-sample predictive rank correlation across 2,269 dates and all 15 tradable instruments; recent 260/520/780-date IC values were 0.055869/0.060021/0.028884, respectively. Small cross-section implies conservative interpretation of uncertainty.",
    "provenance": {
      "script": "scripts/miner_2_20321111_dispersion_conditioned_reversal.py",
      "signal_artifact": "scripts/miner_2_20321111_dispersion_conditioned_reversal_signal.csv",
