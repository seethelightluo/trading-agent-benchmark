{
  "factor_id": "miner_2_20321111_dispersion_conditioned_reversal",
  "factor_name": "Lagged Dispersion-Conditioned Cross-Asset Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-pct_change(close,20).shift(1) * clip((mean_i(std(returns_i,20)).shift(1) / rolling_median(mean_i(std(returns_i,20)).shift(1),120)), 0.5, 2.0)",
    "description": "Reverses each asset's lagged 20-session return and scales the signal by the lagged cross-sectional average 20-session volatility relative to its trailing 120-session median. The bounded dispersion multiplier emphasizes reversal when the cross-asset market is unusually dispersed/volatile while limiting leverage to avoid extreme regimes.",
    "lookahead_control": "All prices and dispersion inputs are shifted one completed session before signal use; forward returns are used only for validation."
  },
  "dependencies": ["close"],
  "parameters": {"return_window": 20, "volatility_window": 20, "dispersion_median_window": 120, "multiplier_floor": 0.5, "multiplier_cap": 2.0, "minimum_cross_section": 8, "validation_horizons": [5, 10, 20]},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2032-11-10",
    "last_validated": "2032-11-11T00:00:00Z",
    "metrics": {
      "horizon_days": 10,
      "ic": 0.016652,
      "icir": 0.7841,
