{
  "factor_id": "miner_3_20320624_residual_reversal_20d",
  "factor_name": "20-day volatility-scaled cross-asset residual reversal",
  "version": "1.0",
  "calculation": {
    "expression": "(-((rolling_sum(pct_change(close),20) - cross_sectional_mean(rolling_sum(pct_change(close),20))) / (rolling_std(pct_change(close),20) * sqrt(252)))).shift(1)",
    "description": "Ranks assets contrarian to their 20-trading-day cumulative return relative to the equal-weight benchmark, scaled by each asset's 20-day annualized volatility. The one-day lag prevents look-ahead bias."
  },
  "dependencies": ["close"],
  "parameters": {"residual_window_days": 20, "volatility_window_days": 20, "min_periods": 15, "annualization": 252, "signal_lag_days": 1},
