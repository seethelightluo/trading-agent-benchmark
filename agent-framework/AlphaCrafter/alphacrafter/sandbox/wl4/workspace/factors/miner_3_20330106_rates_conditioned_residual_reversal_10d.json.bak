{
  "factor_id": "miner_3_20330106_rates_conditioned_residual_reversal_10d",
  "factor_name": "Rates-conditioned volatility-scaled cross-sectional residual reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-((R20_i - mean_cross_section(R20))/(std60_daily_returns_i*sqrt(20))) * clip(1 + 0.30*abs(z120(mean(R20_US10Y,R20_CN10Y))), 1, 1.6), shifted by 1 session",
    "description": "Ranks assets by reversal of their lagged 20-session return residual versus the 15-asset cross-sectional mean, scaled by 60-session realized volatility. The signal is amplified during unusually extreme joint US10Y/CN10Y 20-session rate-move regimes. All inputs are lagged one completed session to prevent look-ahead bias."
  },
  "dependencies": [
    "close",
    "US10Y close",
    "CN10Y close"
  ],
  "parameters": {
    "asset_return_window": 20,
    "volatility_window": 60,
    "rate_regime_window": 120,
    "rate_regime_min_periods": 80,
    "regime_z_clip": 2.0,
    "multiplier_slope": 0.3,
    "multiplier_bounds": [
      1.0,
      1.6
    ],
    "signal_lag_sessions": 1,
    "forward_validation_horizon_sessions": 10,
    "universe_size": 15
  },
  "validation": {
