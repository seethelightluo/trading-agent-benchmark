{
  "factor_id": "miner_1_20331110_volscaled_long_reversal_90d",
  "factor_name": "Volatility-scaled long-horizon reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(close/close.shift(90)-1) / (std(pct_change(close),40)*sqrt(252)), shifted by 1 trading day",
    "description": "Ranks assets positively when their lagged 90-trading-day return is low relative to their 40-day annualized realized volatility. The one-day lag ensures only completed data are used."
  },
  "dependencies": ["close"],
  "parameters": {"lookback_return_days": 90, "volatility_window_days": 40, "volatility_min_periods": 25, "forward_horizon_days": 10, "minimum_cross_section": 8},
