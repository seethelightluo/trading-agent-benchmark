{
  "factor_id": "miner_1_20331124_volnorm_reversal_20d",
  "factor_name": "Volatility-normalized 20-day reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(close/close.shift(20)-1)/(rolling_std(pct_change(close),20)*sqrt(20))",
    "description": "Cross-asset contrarian 20-day return divided by trailing 20-day realized volatility; signal uses completed data only."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "lookback_days": 20,
    "volatility_window": 20,
    "min_vol_observations": 15,
    "forward_horizon_days": 10,
    "lag": "one completed trading day"
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-02 through 2033-11-23",
    "last_validated": "2033-11-24",
    "metrics": {
      "ic": 0.027211,
      "icir": 0.087326,
      "dates": 2446,
      "average_instruments": 12.53,
      "coverage": 0.8356,
      "turnover": 0.05631,
      "hit_ratio": 0.5298,
      "max_abs_library_correlation": null,
      "decay_ic_5d": 0.012835,
      "decay_ic_10d": 0.027211,
      "decay_ic_20d": 0.049594
    },
    "regime_notes": "Passes benchmark daily paper IC and ICIR gates; broad coverage and positive recent 260/520-day results, but 780-day ICIR is weaker. Small cross-section uncertainty is material."
