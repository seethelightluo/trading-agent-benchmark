{
  "factor_id": "miner_1_20320513_breadth_conditioned_relative_reversal_10d",
  "factor_name": "Breadth-Conditioned Volatility-Scaled Relative Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "where((cross_sectional_mean(positive_daily_return_20d) < 0.40) OR (cross_sectional_mean(positive_daily_return_20d) > 0.67), -(return_10d - cross_sectional_median(return_10d)) / (rolling_std(daily_return,20)*sqrt(10)), NaN)",
    "description": "At each completed date, compute each asset's 10-day return relative to the cross-sectional median, reverse it, and scale by its 20-day volatility. Activate the signal only when 20-day market breadth is in a weak or strong extreme. The signal is lagged in use so no future data enters the decision.",
    "signal_lag": "one completed trading session"
  },
  "dependencies": [
    "close",
    "daily_return"
  ],
  "parameters": {
    "relative_return_window": 10,
    "volatility_window": 20,
    "volatility_scaling": "sqrt(10)",
    "breadth_window": 20,
    "breadth_low_threshold": 0.4,
    "breadth_high_threshold": 0.67,
    "cross_sectional_center": "median",
    "direction": "positive"
  },
  "validation": {
    "status": "EFFECTIVE",
