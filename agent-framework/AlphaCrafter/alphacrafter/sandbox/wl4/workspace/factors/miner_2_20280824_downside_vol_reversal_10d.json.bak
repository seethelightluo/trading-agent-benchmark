  "factor_name": "Downside-volatility adjusted momentum reversal",
  "version": "1.1",
  "calculation": {
    "expression": "lag1(rolling_mean_3((-return_20 / (downside_volatility_40 * sqrt(20))) * (abs(cross_sectional_breadth_20 - 0.5) + 0.5))",
