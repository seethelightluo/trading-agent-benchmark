{
  "factor_id": "miner_2_downside_risk_contrarian_10d",
  "factor_name": "Downside-Risk Contrarian Quality (10d)",
  "version": "1.0",
  "calculation": {
    "expression": "-(close[t-1]/close[t-41]-1) / (rolling_std(negative_daily_returns, 40)[t-1] * sqrt(252))",
    "description": "Ranks assets positively when their lagged 40-day downside volatility is high relative to their preceding 40-day return; this is the empirically validated contrarian orientation in the cross-asset benchmark. All inputs are lagged one completed day."
  },
  "dependencies": ["close", "pct_change"],
  "parameters": {"return_lookback_days": 40, "downside_volatility_window_days": 40, "annualization": 252, "lag_days": 1, "forward_horizon_days": 10, "minimum_downside_observations": 8},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-02 through 2032-02-04",
    "metrics": {
      "selected_horizon_days": 10,
      "ic": 0.0508287147,
      "icir": 8.2961038,
      "hit_ratio": 0.5658802,
      "dates": 2755,
      "average_instruments": 11.0301,
      "coverage": 0.5746293,
      "turnover": null,
      "recent_365_ic": 0.0944292,
      "recent_365_icir": 5.8150584,
      "recent_730_ic": 0.0503944,
      "recent_730_icir": 4.44131298,
      "recent_1095_ic": 0.0653272,
      "recent_1095_icir": 6.9600119,
      "h20_ic": 0.0472006,
      "h20_icir": 8.4569280,
      "max_abs_library_correlation": null,
      "gate_ic": 0.007,
      "gate_icir": 0.084
    },
    "regime_notes": "Positive orientation is the negation of the tested downside-risk quality ratio. Positive and stable across the full sample and recent 365/730/1095-day windows, but cross-section averages about 11 instruments and uncertainty is conservative for a 15-asset universe.",
    "validation_script": "scripts/miner_2_20320205_downside_quality.py",
    "signal_provenance": "Reproducible from the 15 listed tradable stock_data close series; cutoff through 2032-02-04, with no future observations used for each date. Observation-only macro series were not traded or used."
  },
  "tags": ["risk", "downside-volatility", "contrarian", "cross-asset", "10d"]
}