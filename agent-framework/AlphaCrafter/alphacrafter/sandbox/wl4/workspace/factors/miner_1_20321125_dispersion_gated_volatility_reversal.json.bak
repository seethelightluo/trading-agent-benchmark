{
  "factor_id": "miner_1_20321125_dispersion_gated_volatility_reversal",
  "factor_name": "Dispersion-gated volatility-scaled residual reversal",
  "version": "1.0",
  "calculation": {
    "expression": "lag1(gate(dispersion_20 > rolling_median(dispersion_20,120)) * rank_pct(-return_20/(volatility_60*sqrt(20)))-0.5)",
    "description": "Cross-sectional contrarian reversal of 20-session returns scaled by 60-session volatility, activated when cross-sectional 20-session return dispersion exceeds its trailing 120-session median. Signal is lagged one completed session to prevent look-ahead."
  },
  "dependencies": ["close"],
  "parameters": {
    "return_window": 20,
    "volatility_window": 60,
    "dispersion_window": 20,
    "dispersion_median_window": 120,
    "minimum_volatility_observations": 40,
    "minimum_dispersion_observations": 60,
    "lag_sessions": 1,
    "cross_section_minimum": 8,
    "universe_size": 15
  },
