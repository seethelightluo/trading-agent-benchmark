{
  "factor_id": "miner_3_20350301_dispersion_range_reversal_180d",
  "factor_name": "Dispersion-conditioned 180-day range reversal",
  "version": "2035-03-01",
  "calculation": {
    "expression": "-((close - rolling_min(close,180,min_periods=126))/(rolling_max(close,180,min_periods=126)-rolling_min(close,180,min_periods=126))) * (0.5 + rolling_mean(rolling_percentile_rank(cross_asset_std(pct_change(close,20)),60),10))",
    "description": "Ranks assets for 10-day forward returns using their negative 180-session range position, amplified when smoothed cross-asset 20-day return dispersion is high. The signal is shifted one completed session to avoid look-ahead."
  },
  "dependencies": ["close"],
  "parameters": {
    "range_window": 180,
    "range_min_periods": 126,
    "dispersion_return_window": 20,
    "dispersion_rank_window": 60,
    "dispersion_smoothing_window": 10,
    "dispersion_floor": 0.5,
    "signal_lag": 1,
    "forward_horizon_days": 10,
    "minimum_cross_section": 8,
    "universe_size": 15
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-08-21/2035-02-14",
    "metrics": {
      "daily_paper_ic": 0.077421,
      "daily_paper_icir": 0.250054,
      "ic_hit_ratio": 0.5846,
      "validation_dates": 2263,
      "average_instruments": 11.3,
      "factor_coverage": 0.5091,
      "rank_turnover": 0.0578,
      "max_abs_library_correlation": null
    },
    "decay": {"forward_horizon_days": 10},
    "regime_notes": "Strong full-sample and recent 120-observation results; recent 260-observation ICIR is below the admission gate, indicating timeliness risk. Small 15-asset cross-section requires conservative interpretation.",
    "validation_timestamp": "2035-03-01T00:00:00Z"
  },
  "signal_artifact": "scripts/artifacts/miner_3_20350301_dispersion_range_reversal_180d_signal.csv",
  "ic_artifact": "scripts/artifacts/miner_3_20350301_dispersion_range_reversal_180d_ic.csv",
  "tags": ["reversal", "range", "dispersion", "cross_asset", "10d_horizon"]
}