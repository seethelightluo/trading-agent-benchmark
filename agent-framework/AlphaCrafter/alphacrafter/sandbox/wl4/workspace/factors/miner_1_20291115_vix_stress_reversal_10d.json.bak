{
  "factor_id": "miner_1_20291115_vix_stress_reversal_10d",
  "factor_name": "VIX-Stress-Gated Downside Volatility Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "lag1((-pct_change(close,10)/(sqrt(mean(min(pct_change(close,1),0)^2,20))*sqrt(20))) * (1 + 0.6*max(zscore(VIX,60),0)))",
    "description": "Ranks assets for medium-term reversal using negative ten-day return normalized by downside semivolatility, with stronger reversal exposure when the observation-only VIX is above its 60-day mean in standardized units. Signal is lagged one trading day to avoid look-ahead."
  },
  "dependencies": [
    "close",
    "VIX.close"
  ],
  "parameters": {
    "return_window": 10,
    "downside_vol_window": 20,
    "vix_zscore_window": 60,
    "vix_zscore_min_periods": 30,
    "stress_multiplier": 0.6,
    "signal_lag": 1,
    "forward_horizon": 10
  },
  "validation": {
