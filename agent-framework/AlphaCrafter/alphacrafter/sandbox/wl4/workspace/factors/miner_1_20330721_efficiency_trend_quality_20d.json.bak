{
  "factor_id": "miner_1_20330721_efficiency_trend_quality_20d",
  "factor_name": "Reversed efficiency-adjusted trend quality",
  "version": "2033-07-21",
  "calculation": {
    "expression": "-shift1((close.pct_change(20)) / rolling_sum(abs(daily_return),20) * clip(0.75 + 0.5*rolling_mean(cross_sectional_positive_return_breadth,15),0.75,1.25))",
    "description": "The negative sign reverses the empirically contrarian 20-session path-efficiency trend signal. Path efficiency is signed return divided by cumulative absolute daily movement; a breadth multiplier is applied and the complete signal is lagged one session to prevent look-ahead."
  },
  "dependencies": ["close", "daily_return"],
  "parameters": {"trend_window": 20, "breadth_window": 15, "breadth_min_periods": 10, "path_min_periods": 15, "breadth_multiplier_floor": 0.75, "breadth_multiplier_cap": 1.25, "forecast_horizon": 10, "lag": 1},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-02 through 2033-07-20",
    "metrics": {"ic": 0.035073, "icir": 0.110757, "hit_ratio": 0.549693, "coverage": 0.432935, "turnover": 0.072311, "decay": {"horizon": 10}, "dates": 2445, "average_instruments": 10.91, "max_abs_library_correlation": null},
    "regime_notes": "15-asset cross-asset universe; at least 8 valid instruments per IC date. Full sample sign-reversed IC and ICIR clear benchmark gates, but recent windows remain modest and uncertainty is material.",
    "signal_artifact": "scripts/artifacts/miner_1_20330721_efficiency_trend_quality_20d_signal.csv",
    "ic_artifact": "scripts/artifacts/miner_1_20330721_efficiency_trend_quality_20d_ic.csv"
  },
  "tags": ["trend_quality", "path_efficiency", "breadth_conditioned", "contrarian"],
  "last_validated": "2033-07-21T00:00:00Z"
}
