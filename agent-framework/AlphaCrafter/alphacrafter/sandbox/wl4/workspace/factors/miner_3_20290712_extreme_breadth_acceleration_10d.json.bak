{
  "factor_id": "miner_3_extreme_breadth_acceleration_10d",
  "factor_name": "Extreme-Breadth Volatility-Scaled Acceleration",
  "version": "1.0",
  "calculation": {
    "expression": "cross_section_demean(((return_10d - lagged_return_30d) / rolling_std(daily_return,20)) * (1 + 2*abs(breadth_20d - 0.5))).shift(1)",
    "description": "Volatility-scaled relative return acceleration is amplified when the cross-asset breadth of positive 20-day returns is extreme, without changing its directional sign. The full signal is lagged one trading day to prevent look-ahead bias."
  },
  "dependencies": [
    "close",
    "daily_return"
  ],
  "parameters": {
    "short_window": 10,
    "prior_window": 30,
    "volatility_window": 20,
    "breadth_window": 20,
    "breadth_amplitude": 2.0,
    "signal_lag": 1,
    "minimum_cross_section": 8,
    "horizon_days": 10
  },
