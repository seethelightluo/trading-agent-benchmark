{
  "factor_id": "miner_3_20340413_drawdown_recovery_volscaled_120d",
  "factor_name": "Volatility-Scaled Drawdown Recovery Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "(-drawdown_120) / annualized_volatility_60, lagged 1 trading day, where drawdown_120 = close / rolling_max(close,120) - 1",
    "description": "Ranks assets by the reversal opportunity implied by their medium-term drawdown, scaled by realized 60-day risk. The lag prevents look-ahead and favors less risky recovery candidates."
  },
  "dependencies": ["close", "daily_returns"],
  "parameters": {"drawdown_window": 120, "volatility_window": 60, "vol_min_periods": 35, "drawdown_min_periods": 80, "forward_horizon_days": 10, "lag_days": 1},
