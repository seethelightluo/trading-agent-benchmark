{
  "factor_id": "miner_2_20300919_breadth_conditioned_40d_momentum_10d",
  "factor_name": "40-day breadth-conditioned momentum",
  "version": "1.0",
  "calculation": {
    "expression": "pct_change(close,40) * (2 * breadth20_{t-1} - 1), then lag one day",
    "description": "For each tradable asset, multiply its 40-session return by twice the lagged fraction of the 15 tradable instruments with positive 20-session returns minus one. The complete signal is shifted one completed trading day before forward-return measurement to avoid look-ahead."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "momentum_window_days": 40,
    "breadth_window_days": 20,
    "breadth_universe_size": 15,
    "signal_lag_days": 1,
    "forward_horizon_days": 10
  },
