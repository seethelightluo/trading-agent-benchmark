{
  "factor_id": "miner_2_inefficient_trend_reversal_10d",
  "factor_name": "Volatility-Normalized Inefficient Trend Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "lag1(-((close/close.shift(40))-1) / (rolling_sum(abs(daily_return),40) * rolling_std(daily_return,20)))",
    "description": "Favors assets whose signed 40-day trend is negative after scaling by path efficiency and recent volatility. It is the contrarian counterpart to an efficient-trend signal: larger values identify inefficient or adverse trends with expected 10-day recovery potential. Inputs are lagged one completed trading day.",
    "signal_reconstruction": "Load close prices for the 15 tradable symbols; r=close.pct_change(); net=close/close.shift(40)-1; path=abs(r).rolling(40,min_periods=30).sum(); vol=r.rolling(20,min_periods=15).std(); signal=(-net/(path+1e-12)/vol).replace([inf,-inf],nan).shift(1)."
  },
  "dependencies": [
    "close",
    "daily_return"
  ],
  "parameters": {
    "trend_window_days": 40,
    "path_window_days": 40,
    "path_min_periods": 30,
    "volatility_window_days": 20,
    "volatility_min_periods": 15,
    "lag_days": 1,
    "forward_horizon_days": 10,
    "minimum_cross_section": 8,
    "universe_size": 15
  },
  "validation": {
