{
  "factor_id": "miner_2_20341109_lowbreadth_reversal_20d",
  "factor_name": "Low-Breadth 20-Day Cross-Asset Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-rolling_sum(pct_change(close),20) if lagged cross-sectional positive-return breadth < 0.40, else neutral",
    "description": "At each date, compute each tradable asset's 20-session return and invert it only when fewer than 40% of instruments have positive 20-session returns. Signals are lagged one completed session and evaluated against 10-session forward returns. The breadth series is computed only from the 15 tradable instruments."
  },
  "dependencies": ["close", "pct_change", "cross_sectional_breadth"],
  "parameters": {"lookback_days": 20, "breadth_threshold": 0.40, "signal_lag_days": 1, "forward_horizon_days": 10, "minimum_cross_section": 8},
  "validation": {
