  "version": "1.0",
  "calculation": {
    "expression": "lag1(-(close/close[-20]-1)/(std(pct_change(close),40)*sqrt(40)) * clip(1 + zscore(rolling_mean(cross_sectional_std(pct_change(close,20)),60),120), -1.5, 1.5) clipped to [0.25,2.5])",
    "description": "Ranks instruments on lagged 20-session reversal scaled by 40-session realized volatility, with a lagged cross-asset dispersion regime multiplier. Higher reversal scores receive higher expected forward-return rank. All inputs end at the prior completed session."
