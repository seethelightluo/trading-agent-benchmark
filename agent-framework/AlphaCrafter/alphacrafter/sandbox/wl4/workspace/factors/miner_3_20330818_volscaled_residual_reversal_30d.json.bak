{
  "factor_id": "miner_3_20330818_volscaled_residual_reversal_30d",
  "factor_name": "Volatility-Scaled Broad Residual Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-((30d_return_asset - rolling_60d_beta(asset,equal_weight_market)*30d_return_market) / rolling_20d_annualized_volatility).shift(1)",
    "description": "Compute each tradable asset's 30-trading-day return residual after removing its rolling 60-day beta exposure to the equal-weight return of the 15-asset tradable universe. Negate the residual for contrarian reversal, scale by lagged 20-day annualized volatility to reduce noisy/high-risk signal dominance, and shift one completed day to prevent look-ahead bias. Higher values indicate stronger expected forward returns."
  },
  "dependencies": ["close", "daily_returns"],
  "parameters": {
    "residual_return_window": 30,
    "beta_window": 60,
    "beta_min_periods": 40,
    "market_return_window_min_periods": 20,
    "volatility_window": 20,
    "volatility_min_periods": 15,
    "forward_horizon_trading_days": 10,
    "signal_lag_days": 1,
    "annualization": 252,
    "universe_size": 15
  },
