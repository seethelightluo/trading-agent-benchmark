{
  "factor_id": "miner_1_20340330_crosssection_volscaled_reversal_60d",
  "factor_name": "Cross-sectional volatility-scaled 60-day reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-((return_60 - cross_sectional_median(return_60)) / rolling_std(daily_return,60)).shift(1)",
    "description": "Ranks assets favoring underperformers over the prior 60 days after scaling their relative return by trailing 60-day volatility. The one-day lag prevents use of the decision day's close. Higher values predict higher subsequent 10-trading-day returns."
  },
  "dependencies": ["close"],
  "parameters": {"lookback_return_days": 60, "volatility_window_days": 60, "forward_horizon_days": 10, "lag_days": 1, "minimum_vol_observations": 40, "minimum_cross_section": 8},
