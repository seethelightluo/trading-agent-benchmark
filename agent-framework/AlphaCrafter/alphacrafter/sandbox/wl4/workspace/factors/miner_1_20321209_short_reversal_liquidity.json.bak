{
  "factor_id": "miner_1_20321209_short_reversal_liquidity",
  "factor_name": "Liquidity-damped short-horizon contrarian reversal",
  "version": "1.0",
  "calculation": {
    "expression": "shift1((-sum(pct_change(close),10)/(std(pct_change(close),40)*sqrt(10)))/(1+clip((rolling_max(close,20)-rolling_min(close,20))/close,0,1)))",
    "description": "Use the lagged negative 10-session return as a contrarian signal, volatility-normalized over 40 sessions and damped when the recent 20-session price range is unusually large. The one-session lag prevents look-ahead bias."
  },
  "dependencies": ["close"],
  "parameters": {"return_window": 10, "volatility_window": 40, "range_window": 20, "min_periods_return": 8, "min_periods_volatility": 30, "min_periods_range": 15, "range_clip": [0, 1], "lag_sessions": 1},
