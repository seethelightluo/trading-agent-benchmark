  "factor_id": "miner_3_inefficient_reversal_10d",
  "factor_name": "Path-Inefficiency Weighted Contrarian Reversal",
  "version": "20290517",
  "calculation": {
    "expression": "(-return(close,20) * (1 - abs(return(close,20))/rolling_sum(abs(daily_return),20)) / rolling_std(daily_return,20)).shift(1)",
    "description": "Contrarian 20-day return, volatility scaled and weighted toward path-inefficient/choppy moves; signal is shifted one completed day to prevent look-ahead bias. Values are ranked cross-sectionally."
