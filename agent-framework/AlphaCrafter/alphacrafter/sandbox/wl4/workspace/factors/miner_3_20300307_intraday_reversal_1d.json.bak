{
  "factor_id": "miner_3_20300307_intraday_reversal_1d",
  "factor_name": "Lagged Intraday Shock Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-0.5*(open_t/close_{t-1}-1)/(median20((high-low)/close_{t-1})) - (close_t/open_t-1)/(median20((high-low)/close_{t-1}))",
    "description": "Cross-asset reversal signal formed from the prior session's overnight gap and open-to-close body, normalized by its 20-session median range and lagged one completed session. Positive values favor assets with prior negative intraday/gap shocks.",
    "signal_artifact": "scripts/miner_3_20300307_intraday_reversal.py",
    "data_cutoff": "2030-03-06"
  },
  "dependencies": [
    "open",
    "close",
    "high",
    "low"
  ],
  "parameters": {
    "gap_weight": 0.5,
    "body_weight": 1.0,
    "range_window": 20,
    "range_min_periods": 15,
    "signal_lag_sessions": 1,
    "minimum_cross_section": 8,
    "universe_size": 15
  },
