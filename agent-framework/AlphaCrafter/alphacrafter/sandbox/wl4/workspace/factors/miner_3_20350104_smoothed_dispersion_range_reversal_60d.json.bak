{
  "factor_id": "miner_3_20350104_smoothed_dispersion_range_reversal_60d",
  "factor_name": "Smoothed dispersion-conditioned 60-day range reversal",
  "version": "2035-01-04",
  "calculation": {
    "expression": "-((close - rolling_min(close,60,min_periods=42))/(rolling_max(close,60,min_periods=42)-rolling_min(close,60,min_periods=42))) * (0.5 + rolling_mean(rolling_percentile_rank(std(pct_change(close,20)),60),5))",
    "description": "Contrarian range-location signal over 60 sessions, multiplied by a smoothed cross-asset 20-day return-dispersion regime score. All inputs are lagged one completed session before evaluation. Dispersion percentile uses the trailing 60 sessions and five-session smoothing."
  },
  "dependencies": ["close", "cross_asset_close", "daily_returns"],
  "parameters": {"range_window": 60, "range_min_periods": 42, "dispersion_return_window": 20, "dispersion_rank_window": 60, "dispersion_smoothing_window": 5, "forward_horizon_days": 10, "signal_lag_days": 1, "minimum_cross_section": 8},
  "validation": {
    "status": "EFFECTIVE",
    "timestamp": "2035-01-04T00:00:00Z",
    "period": {"start": "2020-03-06", "end": "2034-12-20"},
    "metrics": {"ic": 0.039643, "icir": 0.123373, "ic_hit_ratio": 0.5560, "dates": 2534, "average_instruments": 11.06, "universe_instruments": 15, "coverage": 0.5784, "rank_turnover": 0.0933, "max_abs_library_correlation": null, "recent_120d_ic": -0.025542, "recent_120d_icir": -0.083379, "recent_260d_ic": 0.027086, "recent_260d_icir": 0.083178, "recent_520d_ic": 0.004212, "recent_520d_icir": 0.013747, "recent_780d_ic": 0.035344, "recent_780d_icir": 0.106754},
    "regime_notes": "Full-history daily paper IC and ICIR pass the benchmark gates, but recent 120/520-observation timeliness is weak; use conservatively and monitor drift."
  },
