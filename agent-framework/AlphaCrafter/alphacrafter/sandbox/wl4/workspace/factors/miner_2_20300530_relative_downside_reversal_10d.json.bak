{
  "factor_id": "miner_2_20300530_relative_downside_reversal_10d",
  "factor_name": "Relative Downside-Volatility Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "(-((rolling_sum(pct_change(close),10) - cross_sectional_median(rolling_sum(pct_change(close),10))) / rolling_std(where(pct_change(close)<0,pct_change(close),0),20))).shift(1)",
    "description": "Ranks assets whose lagged 10-session return underperformed the contemporaneous cross-sectional median, normalized by 20-session downside volatility; higher values indicate stronger relative-loss reversal candidates.",
