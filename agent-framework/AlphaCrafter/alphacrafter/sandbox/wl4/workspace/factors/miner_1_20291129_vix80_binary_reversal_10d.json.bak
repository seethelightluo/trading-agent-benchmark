{
  "factor_id": "miner_1_20291129_vix80_binary_reversal_10d",
  "factor_name": "VIX 80th-Percentile Gated Downside Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "lag1((-(close_t/close_{t-20}-1)/rolling_std(pct_change(close),20)) * I(VIX_t > rolling_quantile(VIX,120,0.80)))",
    "description": "For each tradable asset, rank 20-day downside reversal normalized by 20-day return volatility, but activate the score only when the observation-only VIX is above its trailing 120-day 80th percentile. The complete score is lagged one trading day to prevent look-ahead. Zero scores outside stress regimes are intentional.",
    "signal_artifact": "scripts/miner_1_20291129_vix_percentile_reversal.py; variant=vix80_binary"
  },
  "dependencies": [
    "close",
    "VIX.close"
  ],
  "parameters": {
    "lookback_return_days": 20,
    "volatility_window": 20,
    "vix_window": 120,
    "vix_percentile": 0.8,
    "lag_days": 1,
    "forward_horizon_days": 10
  },
