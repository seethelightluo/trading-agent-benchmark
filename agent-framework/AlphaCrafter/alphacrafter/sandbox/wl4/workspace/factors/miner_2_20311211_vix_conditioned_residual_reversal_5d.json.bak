{
  "factor_id": "miner_2_20311211_vix_conditioned_residual_reversal_5d",
  "factor_name": "VIX-conditioned cross-asset residual reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(r_10d - cross_sectional_median(r_10d)).rolling_mean(3).shift(1) * (1 + 0.75 * I[VIX_t > rolling_252d_percentile_70(VIX)])",
    "description": "For each tradable asset, reverse its lagged 10-session return residual versus the daily cross-sectional median. Smooth over three sessions and amplify the reversal signal by 75% when lagged VIX is above its trailing 252-session 70th percentile. All inputs are lagged or trailing-only."
  },
  "dependencies": ["close", "VIX observation-only macro series"],
  "parameters": {"return_window": 10, "smoothing_window": 3, "vix_window": 252, "vix_percentile": 0.70, "stress_amplification": 0.75, "signal_lag": 1},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-02 through 2031-12-10",
    "last_validated": "2031-12-11",
    "metrics": {
