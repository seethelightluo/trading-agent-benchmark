{
  "factor_id": "miner_1_volatility_scaled_momentum_20d",
  "factor_name": "Lagged five-day momentum scaled by twenty-day volatility",
  "version": "2030-09-05",
  "calculation": {
    "expression": "(close_t / close_{t-5} - 1) / rolling_std_20(pct_change(close)) shifted by 1 session",
    "description": "Cross-sectional score equal to each asset's trailing five-session return divided by trailing twenty-session daily return volatility, lagged one completed session to prevent look-ahead. Higher scores indicate stronger recent risk-adjusted momentum."
  },
