{
  "factor_id": "miner_2_20330512_inverse_efficiency_30d",
  "factor_name": "Inverse Path-Efficiency Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-clip((close/close.shift(30)-1) / rolling_sum(abs(pct_change),30), -1, 1) / (rolling_std(pct_change,30)*sqrt(30)), shifted_by_1_day",
    "description": "Ranks assets contrarily to their 30-day net move after adjusting for path efficiency and realized volatility. Assets with persistent directional moves receive lower scores, while choppy or inefficient paths receive higher reversal scores. The one-day lag prevents look-ahead use at decision time."
  },
  "dependencies": ["close", "pct_change"],
  "parameters": {
    "lookback_days": 30,
    "volatility_window": 30,
    "minimum_observations": 15,
    "clip_efficiency": [-1.0, 1.0],
    "signal_lag_days": 1,
    "forward_horizon_days": 30
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2033-05-11 (available aligned observations)",
    "as_of": "2033-05-12",
    "metrics": {
      "ic": 0.073851,
      "icir": 0.2987,
      "hit_ratio": 0.6169,
      "dates": 1827,
      "average_cross_section_n": 14.84,
      "factor_coverage": 0.692,
      "rank_turnover": 0.0735,
      "max_abs_library_correlation": null,
      "admission_thresholds": {"absolute_daily_paper_ic": 0.007, "absolute_daily_paper_icir": 0.084}
    },
    "decay": {
      "5d_ic": 0.013994,
      "10d_ic": 0.030609,
      "20d_ic": 0.032617,
      "30d_ic": 0.073851
    },
    "regime_notes": "Validated across the 15-asset synthetic cross-asset universe and many historical regimes. Full-history 30-day IC and ICIR clear the benchmark gates; uncertainty remains material because the cross-section is small."
  },
  "signal_artifact": "scripts/artifacts/miner_2_20330512_inverse_efficiency_signal.csv",
  "last_validated": "2033-05-12T00:00:00Z",
  "tags": ["reversal", "path_efficiency", "volatility_scaled", "cross_asset", "30d"]
}
