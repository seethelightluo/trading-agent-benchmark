{
  "factor_id": "miner_3_20351122_residual_trend_quality_20d",
  "factor_name": "20-day residual trend quality reversal",
  "version": "1.0",
  "calculation": {
    "expression": "zscore_cs(shift1(-(pct_change(close,20)-cs_median(pct_change(close,20)))/rolling_std(pct_change(close,1),20)) )",
    "description": "For each tradable asset, subtract the cross-sectional median 20-day return, divide by 20-day realized daily-return volatility, negate for contrarian exposure, lag one completed session, and cross-sectionally standardize. Higher values indicate volatility-adjusted residual underperformance and are expected to outperform over the next 10 sessions."
  },
  "dependencies": ["close"],
  "parameters": {
    "trend_window": 20,
    "volatility_window": 20,
    "volatility_min_periods": 15,
    "signal_lag_sessions": 1,
    "forward_horizon_sessions": 10,
    "minimum_cross_section": 8
  },
  "validation": {
