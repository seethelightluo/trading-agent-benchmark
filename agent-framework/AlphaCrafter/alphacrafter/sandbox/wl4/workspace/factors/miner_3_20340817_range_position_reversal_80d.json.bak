{
  "factor_id": "miner_3_range_position_reversal_80d",
  "factor_name": "80-day Range-Position Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(close[t-1] - rolling_min(close,80)[t-1]) / (rolling_max(close,80)[t-1] - rolling_min(close,80)[t-1])",
    "description": "Cross-sectional reversal score: assets near the bottom of their trailing 80-session price range receive higher scores. The rolling window is computed through t-1 and the signal is lagged one completed session to prevent look-ahead."
  },
  "dependencies": ["close"],
  "parameters": {
    "lookback_days": 80,
    "minimum_observations": 56,
    "forward_horizon_days": 10,
    "cross_section_minimum": 8,
    "winsorization": null
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-03-27 through 2034-08-02",
    "as_of": "2034-08-17",
