{
  "factor_id": "range_position_reversal_10d",
  "factor_name": "Volatility-scaled 60-day range-position reversal",
  "version": "1.0",
  "calculation": {
    "expression": "(0.5 - (close_lag1 - rolling_min(close_lag1,60)) / (rolling_max(close_lag1,60) - rolling_min(close_lag1,60))) / max(annualized_std(pct_change(close),40),0.05)",
    "description": "Ranks assets positively when their lagged close is near the lower end of its prior 60-trading-day range, scaled by inverse lagged 40-day realized volatility. All inputs are lagged or completed-day data; higher values indicate stronger expected rebound."
  },
  "dependencies": ["close"],
  "parameters": {"range_window": 60, "volatility_window": 40, "min_periods_range": 45, "min_periods_volatility": 30, "volatility_floor": 0.05, "forward_horizon_days": 10},
