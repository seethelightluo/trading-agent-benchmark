{
  "factor_id": "downside_adjusted_strength_20d",
  "factor_name": "Downside-Adjusted Medium-Term Strength",
  "version": "1.0",
  "calculation": {
    "expression": "pct_change(close,20) / (sqrt(20) * rolling_std(min(pct_change(close,1),0),20))",
    "description": "Ranks assets by 20-trading-day return per unit of downside-day volatility. Cross-sectionally standardized and lagged one completed day to prevent lookahead.",
    "signal_artifact": "scripts/miner_1_20280810_downside_strength.py"
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "return_window_days": 20,
    "downside_vol_window_days": 20,
    "minimum_observations": 15,
    "lag_days": 1
  },
