{
  "factor_id": "miner_1_volscaled_momentum20_10d",
  "factor_name": "Volatility-Scaled 20-Day Momentum",
  "version": "1.0",
  "calculation": {
    "expression": "rank_cs((close/close.shift(20)-1)/(std(pct_change(close),20)*sqrt(20)))",
    "description": "Rank each tradable asset by its 20-session return divided by trailing 20-session realized volatility, then lag the cross-sectional rank by one completed session to prevent look-ahead bias."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "momentum_window": 20,
    "volatility_window": 20,
    "forward_horizon": 10,
    "minimum_cross_section": 8,
    "signal_lag": 1
  },
