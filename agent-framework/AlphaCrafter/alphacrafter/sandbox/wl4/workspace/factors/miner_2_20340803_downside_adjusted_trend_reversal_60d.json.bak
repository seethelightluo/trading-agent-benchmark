{
  "factor_id": "miner_2_downside_adjusted_trend_reversal_60d",
  "factor_name": "Downside-adjusted 60-day trend reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-pct_change(close,60) / (rolling_std(min(pct_change(close,1),0),60)*sqrt(252))",
    "description": "Contrarian score that favors assets with weak 60-session returns after scaling by their downside volatility. Signal is lagged one completed session to avoid look-ahead. Cross-sectional higher values predict higher next-10-session returns."
  },
  "dependencies": ["close"],
  "parameters": {"trend_window": 60, "downside_window": 60, "forward_horizon": 10, "annualization": 252, "minimum_cross_section": 8, "lag_sessions": 1},
  "validation": {
    "status": "EFFECTIVE",
    "period": {"start": "2026-10-06", "end": "2034-07-19"},
    "metrics": {
      "ic": 0.065811,
      "icir": 0.227600,
      "ic_hit_ratio": 0.5886,
      "coverage": 1.0,
      "turnover": 0.0504,
      "dates": 2032,
      "average_instruments": 15.0,
      "max_abs_library_correlation": null,
      "decay": {"5": 0.040866, "10": 0.065811, "20": 0.093867, "40": 0.111930}
    },
    "regime_notes": "Full available online-history validation across the 15 tradable benchmark assets; sign and stability were positive for the contrarian orientation across 120, 260, 520, 780, and 1200-session windows.",
    "validation_timestamp": "2034-08-03T00:00:00Z"
  },
  "provenance": {
    "research_script": "scripts/miner_2_20340803_downside_adjusted_trend_60d.py",
    "signal_definition": "signal = (-close.pct_change(60) / (downside_std_60 * sqrt(252))).shift(1)",
    "forward_return": "close[t+10]/close[t]-1",
