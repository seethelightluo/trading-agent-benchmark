{
  "factor_id": "miner_1_20320722_blended_residual_reversal_20_30",
  "factor_name": "Blended Volatility-Scaled Cross-Asset Residual Reversal 20/30",
  "version": "1.0",
  "calculation": {
    "expression": "0.5*(-residual_return_20d/annualized_volatility_20d) + 0.5*(-residual_return_30d/annualized_volatility_30d), lagged 1 session",
    "description": "For each tradable asset, compute 20-day and 30-day cumulative returns, subtract the same-day equal-weight cross-asset mean return, negate for reversal, scale each component by its trailing annualized volatility, and average the components. The signal is shifted by one completed session to prevent look-ahead bias. Higher values indicate stronger expected forward returns."
  },
  "dependencies": ["close"],
  "parameters": {"short_window": 20, "long_window": 30, "volatility_windows": [20, 30], "annualization": 252, "lag_sessions": 1, "minimum_valid_assets": 8},
  "validation": {
