{
  "factor_id": "miner_1_20330915_breadth_conditioned_residual_momentum30",
  "factor_name": "Breadth-Conditioned 30-Day Residual Momentum",
  "version": "1.0",
  "calculation": {
    "expression": "lag1((rolling_sum_30(asset_daily_return - cross_sectional_mean_return) / rolling_std_60(asset_daily_return - cross_sectional_mean_return)) * (rolling_mean_10(cross_sectional_breadth) - 0.5))",
    "description": "For each asset, compute 30-session cumulative return residualized against the contemporaneous cross-asset mean, scale it by 60-session residual volatility, and condition its amplitude and direction on lagged 10-session market breadth. The complete signal is lagged one session to prevent look-ahead. Breadth is the fraction of available tradable assets with positive daily return."
  },
  "dependencies": ["close", "daily_returns", "cross_sectional_breadth"],
  "parameters": {"residual_window": 30, "volatility_window": 60, "breadth_window": 10, "forward_horizon": 10, "lag": 1, "min_cross_section": 8},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-02 through 2033-09-14",
    "validation_timestamp": "2033-09-15",
    "metrics": {
      "horizon_sessions": 10,
      "ic": 0.04553617,
      "icir": 0.15626901,
      "hit_ratio": 0.5621,
      "dates": 2400,
      "average_instruments": 15.0,
      "coverage": 1.0,
      "turnover": 0.08016896,
      "decay_ic": {"1": 0.01154881, "5": 0.02471896, "10": 0.04553617, "20": 0.06841995, "30": 0.07669367},
      "max_abs_library_correlation": null
    },
    "regime_notes": "Positive and stable across recent 260 (IC 0.06664, ICIR 0.22587), 520 (0.06891, 0.23563), and 780 (0.04128, 0.14052) session windows. Interpret uncertainty conservatively because the cross-section is 15 assets, though 2,400 daily observations were available.",
    "signal_artifact": "scripts/artifacts/miner_1_20330915_breadth_conditioned_residual_momentum_signal.csv"
  },
