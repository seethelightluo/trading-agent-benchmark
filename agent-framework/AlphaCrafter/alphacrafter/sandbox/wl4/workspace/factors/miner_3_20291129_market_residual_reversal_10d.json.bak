  "factor_name": "Cross-Asset Market-Residual Volatility-Normalized Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-shift1((rolling_sum_5(asset_return - cross_sectional_median_return))/(sqrt(5)*rolling_std_20(asset_return)))",
    "description": "For each tradable benchmark asset, subtract the same-day cross-sectional median return from its daily return, aggregate the residual over five sessions, volatility-normalize using 20-session return volatility, and lag the signal one session. Higher values indicate expected positive forward returns from reversal of idiosyncratic relative moves.",
    "signal_artifact": "scripts/miner_3_20291129_market_residual_reversal.py",
    "lookahead_control": "The signal is shifted one completed session before correlation with forward returns. Cross-sectional median uses only returns available at signal construction time."
  },
  "dependencies": ["close"],
  "parameters": {"residual_reference": "cross_sectional_median", "signal_window_days": 5, "volatility_window_days": 20, "volatility_min_periods": 15, "lag_days": 1, "validation_horizon_days": 10},
