{
  "factor_id": "recovery_weakness_reversal_40d",
  "factor_name": "40-day recovery-weakness reversal",
  "version": "20341109",
  "calculation": {
    "expression": "-((close/close.shift(40)-1)/(rolling_drawdown_40+0.05)).shift(1)",
    "description": "Ranks assets contrarily by poor 40-session return relative to their trailing 40-session maximum drawdown; weaker recovery receives a higher reversal score. Lagged one completed session to avoid look-ahead."
  },
  "dependencies": ["close"],
  "parameters": {"return_window": 40, "drawdown_window": 40, "drawdown_min_periods": 30, "drawdown_floor": 0.05, "forward_horizon": 10, "lag": 1, "min_cross_section": 8},
  "validation": {
