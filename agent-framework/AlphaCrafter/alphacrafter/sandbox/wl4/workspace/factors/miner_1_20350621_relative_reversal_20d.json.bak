{
  "factor_id": "miner_1_relative_reversal_20d",
  "factor_name": "Volatility-Scaled Cross-Asset Relative Reversal 20d",
  "version": "1.0",
  "calculation": {
    "expression": "-((rolling_sum(pct_change(close),20) - cross_sectional_median(rolling_sum(pct_change(close),20))) / rolling_std(pct_change(close),30)).shift(1)",
    "description": "Ranks assets by the inverse of their recent 20-trading-day return after removing the contemporaneous cross-asset median move; each residual is scaled by its 30-day return volatility. The one-day lag prevents look-ahead. Higher values indicate stronger relative-reversal preference."
  },
  "dependencies": ["close"],
  "parameters": {"lookback_return_days": 20, "min_return_observations": 15, "volatility_days": 30, "min_volatility_observations": 20, "forward_horizon_days": 10, "cross_sectional_min_assets": 8},
  "validation": {
