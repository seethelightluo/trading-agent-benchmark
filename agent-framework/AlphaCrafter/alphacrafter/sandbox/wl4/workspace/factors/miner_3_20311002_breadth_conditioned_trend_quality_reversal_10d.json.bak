{
  "factor_id": "miner_3_20311002_breadth_conditioned_trend_quality_reversal_10d",
  "factor_name": "Breadth-Conditioned Volatility-Normalized Trend Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-((0.6*ret_10d + 0.4*ret_30d) / (sqrt(20)*std_daily_20d)) * (0.65 + 0.7*clip(mean_20d(indicator(ret_10d>0)),0,1))",
    "description": "Cross-asset reversal of a multi-horizon trend signal, normalized by 20-session realized volatility and scaled by recent breadth. The signal is shifted one completed session before use to prevent look-ahead. Higher values indicate assets whose persistent trend is more likely to mean-revert over the 10-session horizon."
  },
  "dependencies": ["close"],
  "parameters": {"short_window": 10, "long_window": 30, "vol_window": 20, "breadth_window": 20, "short_weight": 0.6, "long_weight": 0.4, "breadth_multiplier_base": 0.65, "breadth_multiplier_scale": 0.7, "forward_horizon_sessions": 10, "lag_sessions": 1},
