{
  "factor_id": "miner_1_20320429_dispersion_gated_residual_reversal_10d",
  "factor_name": "High-dispersion cross-asset residual reversal",
  "version": "1.0",
  "calculation": {
    "expression": "shift(1, where(std_cs(rolling_sum(log_return,10)) > rolling_quantile(std_cs(rolling_sum(log_return,10)),60,0.60), -(rolling_sum(log_return,10)-cs_mean(rolling_sum(log_return,10))) / clip(rolling_std(log_return,20)*sqrt(20),0.005,1.0)))",
    "description": "For each tradable asset, compute its 10-session log return relative to the cross-sectional mean, negate it for contrarian ranking, and volatility-scale it by 20-session annualized volatility. Activate the signal only when cross-asset 10-session return dispersion exceeds its trailing 60-session 60th percentile. Lag one completed session to prevent lookahead.",
    "direction": "positive factor values predict higher forward returns"
  },
  "dependencies": ["close", "cross_sectional_returns", "rolling_volatility"],
  "parameters": {"return_window": 10, "volatility_window": 20, "dispersion_window": 60, "dispersion_quantile": 0.60, "lag_sessions": 1, "forward_horizon": 10, "min_cross_section": 8, "volatility_floor": 0.005, "volatility_cap": 1.0},
