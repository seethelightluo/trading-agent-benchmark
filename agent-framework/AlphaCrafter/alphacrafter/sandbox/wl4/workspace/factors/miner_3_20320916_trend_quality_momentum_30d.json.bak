  "factor_name": "Volatility-normalized trend quality momentum 30d",
  "version": "1.0",
  "calculation": {
    "expression": "shift1((pct_change(close,40)/(rolling_std(pct_change(close),60)*sqrt(40))) * (2*rolling_mean(I[pct_change(close)>0],40)-1))",
    "description": "Lagged medium-term momentum normalized by realized volatility and weighted by directional consistency of daily returns. Positive values indicate persistent risk-adjusted trends."
  },
