{
  "factor_id": "miner_2_20301003_risk_adjusted_breadth_momentum_10d",
  "factor_name": "Risk-adjusted 40-day momentum conditioned by cross-asset breadth",
  "version": "1.0",
  "calculation": {
    "expression": "(close/close.shift(40)-1) / (rolling_std(pct_change(close),20)*sqrt(252)) * (2*mean_i[pct_change(close_i,20)>0]-1), all shifted one completed session",
    "description": "Cross-sectional medium-term momentum scaled by trailing 20-session realized volatility and multiplied by the lagged fraction of tradable instruments with positive 20-session returns, transformed to [-1,1]. The complete signal is lagged one day before forecasting forward returns."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "momentum_window": 40,
    "volatility_window": 20,
    "breadth_window": 20,
    "annualization": 252,
    "signal_lag_days": 1,
    "forward_horizon_days": 10,
    "minimum_cross_section": 8
  },
