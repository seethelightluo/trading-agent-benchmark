{
  "factor_id": "miner_2_20300711_compression_reversal_10d",
  "factor_name": "Volatility Compression Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "(-pct_change(close,5) * rolling_std(pct_change(close,1),5) / rolling_std(pct_change(close,1),20)).shift(1)",
    "description": "Contrarian five-session return, scaled by the ratio of short-term to medium-term realized volatility. The one-session lag ensures only completed information is used. Lower recent volatility relative to baseline attenuates reversal exposure, while elevated short-term volatility increases it."
  },
  "dependencies": ["close"],
  "parameters": {"return_lookback_days": 5, "short_vol_window": 5, "long_vol_window": 20, "short_vol_min_periods": 4, "long_vol_min_periods": 15, "signal_lag_days": 1},
