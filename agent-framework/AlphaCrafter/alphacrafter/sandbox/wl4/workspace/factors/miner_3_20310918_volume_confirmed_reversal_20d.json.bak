{
  "factor_id": "miner_3_20310918_volume_confirmed_reversal_20d",
  "factor_name": "Volume-confirmed residual reversal",
  "version": "2031-10-02",
  "calculation": {
    "expression": "-cross_sectional_residual(rolling_sum(return,15)) * (1 + 0.25 * clipped_log_volume_zscore(40)), lagged_1",
    "description": "Reverses each asset's 15-session return residual versus the cross-sectional median, increasing emphasis when log volume is unusually elevated relative to its rolling 40-session median/MAD. Signal is lagged one completed session."
  },
  "dependencies": ["close", "volume"],
  "parameters": {"return_window": 15, "volume_window": 40, "volume_mad_scale": 1.4826, "volume_multiplier": 0.25, "zscore_clip": [-2, 2], "lag": 1, "forward_horizon": 20},
