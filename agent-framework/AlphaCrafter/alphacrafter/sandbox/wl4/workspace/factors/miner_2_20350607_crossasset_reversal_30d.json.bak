{
  "factor_id": "miner_2_crossasset_reversal_30d",
  "factor_name": "Volatility-Scaled Cross-Asset 30-Day Reversal",
  "version": "1.1",
  "calculation": {
    "expression": "cross_section_center(-pct_change(close,30)/rolling_std(pct_change(close,1),20)).shift(1)",
    "description": "Contrarian 30-day return scaled by each asset's recent 20-day volatility, centered against the cross-sectional median and lagged one completed day to prevent look-ahead."
  },
  "dependencies": ["close"],
  "parameters": {
    "lookback_days": 30,
    "volatility_window": 20,
    "forward_horizon_days": 10,
    "minimum_valid_assets": 8,
    "lag_days": 1,
    "universe_size": 15
  },
  "validation": {
