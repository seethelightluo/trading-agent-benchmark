{
  "factor_id": "miner_3_20301003_dxy_conditioned_reversal20",
  "factor_name": "DXY-Impulse-Conditioned 20-Day Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-asset_return_20d * clip(max(DXY_return_20d / (20d_DXY_volatility * sqrt(20)), 0), 0, 3)",
    "description": "Cross-asset contrarian 20-day return activated and scaled by a positive standardized 20-day DXY impulse. Signal is lagged one completed session before forward-return measurement. DXY is observation-only and never tradable."
  },
  "dependencies": ["close", "DXY close"],
  "parameters": {"asset_lookback_days": 20, "dxy_return_days": 20, "dxy_volatility_window": 120, "dxy_volatility_min_periods": 60, "stress_floor": 0, "stress_cap": 3, "forward_horizon_days": 20, "lag_sessions": 1},
