{
  "factor_id": "miner_3_20350913_downside_adjusted_reversal_30d",
  "factor_name": "Downside-volatility-adjusted 30-day cross-asset reversal",
  "version": "1.0",
  "calculation": {
    "expression": "zscore_cs((-(close/close.shift(30)-1)) / rolling_std(pct_change(close).clip(upper=0), 30), lag=1)",
    "description": "Ranks assets positively when their lagged 30-session return is poor relative to their own recent downside volatility. The signal is cross-sectionally standardized and lagged one completed session to avoid look-ahead."
  },
  "dependencies": ["close"],
  "parameters": {"lookback_return_days": 30, "downside_volatility_days": 30, "downside_clip": 0, "signal_lag_days": 1, "forward_horizon_days": 10, "minimum_downside_vol_observations": 20},
