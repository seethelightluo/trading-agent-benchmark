{
  "factor_id": "miner_2_consistency_momentum_15d",
  "factor_name": "15-Day Consistency-Weighted Momentum",
  "version": "20280323",
  "calculation": {
    "expression": "(close / lag(close,15) - 1) * (0.5 + 0.5 * mean(sign(pct_change(close,1)) > 0 over prior 15 sessions))",
    "description": "Medium-term momentum is increased when a larger fraction of the prior 15 daily returns is positive. This rewards persistent directional movement while retaining a continuous, interpretable price-only signal.",
    "signal_artifact": "At each completed date t, compute the expression from closes through t for each of the 15 tradable assets, then use the cross-sectional Spearman rank. Forward validation return is close[t+10]/close[t]-1; no future observations enter the signal."
  },
  "dependencies": ["close"],
  "parameters": {
    "lookback_days": 15,
    "consistency_window_days": 15,
    "validation_horizon_days": 10,
    "minimum_cross_section": 8
  },
  "validation": {
    "period": {"start": "2020-01-01", "end": "2028-03-22"},
    "validation_timestamp": "2028-03-23T00:00:00",
    "sample_dates": 1794,
    "universe_size": 15,
    "average_valid_instruments": 15.0,
    "metrics": {
      "horizon_days": 10,
      "ic_mean": 0.0330177715,
      "ic_daily": 0.0330177715,
      "ic_abs_daily": 0.0330177715,
      "icir_daily": 0.0970103637,
      "ic_hit_ratio": 0.5373467113,
      "coverage": 1.0,
      "turnover_rank_mean_abs_change": null,
      "decay_ic": null,
      "max_abs_library_correlation": null
    },
    "status": "EFFECTIVE",
    "regime_notes": "Validation used all 15 tradable cross-asset instruments and 1,794 dates, with at least 8 valid instruments per date. The admission IC and ICIR exceed 0.0070 and 0.0840 respectively. Small-universe uncertainty remains material; longer 30- and 40-day consistency variants failed, supporting the 15-day specification."
  },
  "tags": ["momentum", "trend_persistence", "cross_asset"],
  "last_validated": "2028-03-23T00:00:00"
}