  "factor_name": "Inefficient Shock Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-((close/close.shift(10)-1) / rolling_std(pct_change(close),20)) * (1 - clip(abs(close/close.shift(10)-1)/(rolling_sum(abs(pct_change(close)),10)+1e-12),0,1)), then shift(1)",
