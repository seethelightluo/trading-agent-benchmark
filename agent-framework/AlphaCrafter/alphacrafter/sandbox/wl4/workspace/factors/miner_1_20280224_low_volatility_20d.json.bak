{
  "factor_id": "miner_1_low_volatility_20d",
  "factor_name": "20-Day Low Volatility",
  "version": "20280224",
  "calculation": {
    "expression": "-rolling_std(pct_change(close),20)",
    "description": "Ranks tradable assets by lower recent realized daily volatility, using only completed daily closes; higher values indicate lower 20-day volatility.",
    "signal_artifact": "At each date t, compute negative sample standard deviation of close-to-close returns over the prior 20 observations, cross-sectionally rank across the 15 tradable instruments, and evaluate against close[t+10]/close[t]-1."
  },
