{
  "factor_id": "miner_1_20351122_residual_trend_quality_30d",
  "factor_name": "30-Day Cross-Asset Residual Trend Quality Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "lag1(-(return_30d - cross_sectional_median(return_30d)) / rolling_std(daily_return,30))",
    "description": "Ranks assets positively when their 30-day return is weak relative to the cross-asset median, scaled by 30-day realized volatility; intended as a risk-adjusted cross-asset mean-reversion signal. The one-session lag prevents look-ahead."
  },
  "dependencies": ["close", "daily_return"],
  "parameters": {"trend_window": 30, "volatility_window": 30, "vol_min_periods": 22, "forecast_horizon_days": 10, "lag_days": 1, "minimum_cross_section": 8},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2026-08-05 through 2035-11-07",
    "validation_timestamp": "2035-11-22T00:00:00Z",
    "metrics": {
      "ic": 0.055245,
      "icir": 0.183574,
      "ic_hit_ratio": 0.5746,
      "dates_used": 2412,
      "average_instruments": 11.55,
      "universe_size": 15,
      "coverage": 0.4518,
      "rank_turnover": 0.0712,
      "decay": {"horizon_days": 10, "same_horizon_ic": 0.055245},
      "max_abs_library_correlation": null
    },
    "regime_notes": "Positive and robust across the full historical sample and recent 120/260/520/780 observation windows; interpret uncertainty conservatively because the cross-section averages about 11.6 assets.",
