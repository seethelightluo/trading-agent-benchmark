{
  "factor_id": "miner_2_downside_asymmetry_reversal_20d",
  "factor_name": "Downside-Asymmetry 20-Day Reversal",
  "version": "2035-03-29",
  "calculation": {
    "expression": "-sum(pct_change(close),20) / rolling_std(min(pct_change(close),0),40)",
    "description": "Cross-asset reversal score: assets with weaker trailing 20-day returns relative to their 40-day downside volatility receive higher scores. The signal is shifted by one completed trading day to avoid look-ahead bias; cross-sectional ranking is used for portfolio applications."
  },
  "dependencies": ["close", "daily returns"],
  "parameters": {
    "return_window_days": 20,
    "downside_volatility_window_days": 40,
    "downside_volatility_definition": "standard deviation of returns clipped above at zero",
    "minimum_downside_volatility_observations": 25,
    "signal_lag_days": 1,
    "forward_validation_horizon_days": 10,
    "minimum_cross_section": 8,
    "universe_size": 15
  },
