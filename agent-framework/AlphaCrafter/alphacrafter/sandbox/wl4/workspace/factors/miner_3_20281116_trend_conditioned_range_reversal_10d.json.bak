{
  "factor_id": "trend_conditioned_range_reversal_10d",
  "factor_name": "Trend-Conditioned Range-Position Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "(0.5 - (close[t-1]-rolling_min(close,20)[t-1])/(rolling_max(close,20)[t-1]-rolling_min(close,20)[t-1])) * (0.5+0.5*I(close[t-1] > rolling_mean(close,60)[t-1])) * (0.5+0.5*I(cross_asset_mean(rolling_mean(return,20))[t-1] > -0.01))",
    "description": "Ranks lagged 20-session range pullbacks positively, but doubles the pullback signal for instruments above their lagged 60-session trend and halves it during severe broad cross-asset weakness. All inputs are lagged one completed session."
  },
  "dependencies": [
    "close",
    "daily returns"
  ],
  "parameters": {
    "range_window": 20,
    "range_min_periods": 15,
    "trend_window": 60,
    "trend_min_periods": 40,
    "tape_window": 20,
    "tape_threshold": -0.01,
    "forward_horizon": 10,
    "min_cross_section": 8
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2028-11-15",
    "metrics": {
      "ic": 0.03244,
      "icir": 0.10994,
      "ic_hit_ratio": 0.532,
      "coverage": 0.3394,
      "turnover": 0.12607,
      "validation_dates": 598,
      "average_instruments": 12.72,
      "minimum_instruments": 8,
      "recent_250d_ic": 0.07084,
      "recent_250d_icir": 0.2448,
      "max_abs_library_correlation": null,
      "admission_thresholds": {
        "absolute_ic_min": 0.007,
        "absolute_icir_min": 0.084
      }
    },
    "regime_notes": "Positive full-sample and recent predictive rank IC across the small 15-asset cross-section; stronger at 5-, 10-, and 20-day horizons. Coverage is reduced by the 60-day trend warm-up and range requirements; dates retain at least 8 valid instruments.",
    "signal_provenance": "scripts/miner_3_20281116_trend_conditioned_range_reversal.py; reproducible from ../persistent/stock_data close series through 2028-11-15",
    "validation_timestamp": "2028-11-16T00:00:00Z"
  },
