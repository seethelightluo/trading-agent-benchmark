{
  "factor_id": "miner_2_20330526_range_position_reversal_30d",
  "factor_name": "60-day Range-Position Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "shift(0.5 - clip((close - rolling_min(close,60))/(rolling_max(close,60)-rolling_min(close,60),0,1), 1)",
    "description": "Ranks assets favoring prices near the lower half of their trailing 60-day range, using a one-day lag to prevent look-ahead. The score is cross-sectionally interpretable as contrarian range location."
  },
  "dependencies": ["close"],
  "parameters": {"range_window": 60, "minimum_periods": 30, "signal_lag": 1, "forward_horizon_days": 30},
  "validation": {
