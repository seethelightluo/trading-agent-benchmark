      "ic_mean": 0.0344244977,
      "ic_daily": 0.0344244977,
      "ic_abs_daily": 0.0344244977,
      "icir_daily": 0.1007179799,
      "ic_hit_ratio": 0.5390625,
      "coverage": 0.9939393939,
      "turnover_rank_mean_abs_change": 0.0890607909,
      "decay_ic": {"1": -0.0070859137, "5": 0.0027230618, "10": 0.0344244977, "20": 0.0417432233},
      "max_abs_library_correlation": null
    },
    "status": "EFFECTIVE",
    "regime_notes": "All 15 tradable cross-asset instruments were used with at least 8 valid names per date. The full-period 10-session IC and ICIR exceed benchmark admission thresholds. Early-half IC was 0.04766 and late-half IC was 0.02119, both positive, though the small cross-section implies material uncertainty. Five-, ten-, fifteen-, and thirty-session consistency windows were weaker; the 20-session window was strongest in this sweep."
  },
