{
  "factor_id": "miner_2_consistency_momentum_20d",
  "factor_name": "20-Day Consistency-Weighted Momentum",
  "version": "20280406",
  "calculation": {
    "expression": "(close[t-1] / close[t-1-20] - 1) * (0.5 + 0.5 * mean(sign(pct_change(close,1)) > 0 over sessions t-20 through t-1))",
    "description": "Twenty-session price momentum multiplied by a persistence score, rewarding assets whose recent directional movement contains more positive daily returns.",
    "signal_artifact": "For each completed decision date t, calculate from closes through t-1 only and rank cross-sectionally across the 15 tradable instruments. Forward return is close[t+10]/close[t]-1 for validation; no future observations enter the signal."
  },
  "dependencies": ["close"],
  "parameters": {
    "lookback_days": 20,
    "consistency_window_days": 20,
    "validation_horizon_days": 10,
    "minimum_cross_section": 8
  },
  "validation": {
    "period": {"start": "2020-01-01", "end": "2028-04-05"},
    "validation_timestamp": "2028-04-06T00:00:00",
    "sample_dates": 2816,
    "universe_size": 15,
    "average_valid_instruments": 14.9982,
    "metrics": {
