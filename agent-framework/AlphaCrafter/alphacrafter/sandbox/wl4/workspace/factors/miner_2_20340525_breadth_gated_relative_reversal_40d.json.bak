      "icir": 0.1964264115,
      "ic_hit_ratio": 0.5810147299,
      "ic_observations": 2444,
      "average_instruments": 12.8838,
      "coverage": 0.8589198036,
      "rank_turnover": 0.0556552727,
      "max_abs_library_correlation": null,
      "thresholds": {"absolute_daily_paper_ic": 0.007, "absolute_daily_paper_icir": 0.084}
    },
    "decay": {
      "120_sessions": {"ic": 0.1089015121, "icir": 0.3410662828},
      "260_sessions": {"ic": 0.0968239970, "icir": 0.3134373954},
      "520_sessions": {"ic": 0.0698143005, "icir": 0.2228361129},
