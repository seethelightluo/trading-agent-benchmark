{
  "factor_id": "miner_2_breadth_gated_relative_reversal_40d",
  "factor_name": "Breadth-gated volatility-scaled relative reversal 40d",
  "version": "1.0",
  "calculation": {
    "expression": "-(ret40_i - cross_sectional_median(ret40))/vol60_i * clip(1.3 - 1.6*(breadth20 - 0.5), 0.2, 1.8), lagged 1 session",
    "description": "Ranks instruments for reversal of 40-session relative performance, scaled by 60-session realized volatility. The continuous breadth gate increases reversal exposure when fewer instruments have positive 20-session returns and dampens it when participation is broad. All inputs are lagged before use."
  },
  "dependencies": ["close"],
  "parameters": {"reversal_window": 40, "volatility_window": 60, "breadth_window": 20, "forward_horizon": 10, "min_valid_instruments": 8, "gate_lower": 0.2, "gate_upper": 1.8},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2026-07-20 to 2034-04-26",
    "validated_on": "2034-05-25",
    "metrics": {
