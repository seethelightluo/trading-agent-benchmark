{
  "factor_id": "beta_neutral_reversal_10d",
  "factor_name": "Beta-Neutral Volatility-Scaled Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(ret_20d(asset) - beta_60d(asset, equal_weight_tradable_benchmark) * ret_20d(equal_weight_tradable_benchmark)) / (sqrt(20) * std_20d(daily_returns(asset)))",
    "description": "Ranks assets higher when their recent 20-day return underperformed the equal-weight 15-asset tradable benchmark after removing the asset's 60-day rolling beta exposure, scaled by its 20-day annualized realized volatility. All inputs are lagged completed-day observations at the decision timestamp."
  },
  "dependencies": [
    "close",
    "daily_returns"
  ],
  "parameters": {
    "return_window": 20,
    "beta_window": 60,
    "volatility_window": 20,
    "benchmark": "equal_weight_available_tradable_assets",
    "minimum_cross_section": 8
  },
  "validation": {
