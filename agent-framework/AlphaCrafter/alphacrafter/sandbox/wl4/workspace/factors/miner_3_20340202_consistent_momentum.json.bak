{
  "factor_id": "miner_3_20340202_consistent_momentum",
  "factor_name": "Volatility-adjusted momentum with directional consistency",
  "version": "1.0",
  "calculation": {
    "expression": "(return_60 / annualized_volatility_60) * (positive_return_fraction_60 - 0.5), shifted one trading day",
    "description": "Ranks assets by 60-day risk-adjusted momentum, scaled by the fraction of positive daily returns above or below neutral. The one-day lag prevents use of the decision-day close."
  },
  "dependencies": ["close"],
  "parameters": {
    "momentum_window": 60,
    "volatility_window": 60,
    "volatility_min_periods": 35,
    "consistency_window": 60,
    "forward_horizon_trading_days": 10,
    "signal_lag_days": 1,
    "minimum_cross_section": 8
  },
