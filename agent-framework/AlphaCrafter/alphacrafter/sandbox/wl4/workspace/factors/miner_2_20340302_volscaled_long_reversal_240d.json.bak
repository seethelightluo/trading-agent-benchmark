{
  "factor_id": "miner_2_20340302_volscaled_long_reversal_240d",
  "factor_name": "Volatility-scaled long-horizon reversal 240d",
  "version": "1.0",
  "calculation": {
    "expression": "(-close.pct_change(240) / (rolling_std(daily_returns,60)*sqrt(252))).shift(1)",
    "description": "Ranks assets positively when their lagged 240-trading-day return is weak relative to trailing 60-day annualized volatility. The one-session lag prevents use of contemporaneous information."
  },
  "dependencies": ["close"],
  "parameters": {"lookback_days": 240, "volatility_window": 60, "volatility_min_periods": 35, "forecast_horizon_days": 10, "lag_days": 1},
