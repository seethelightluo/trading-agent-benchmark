{
  "factor_id": "miner_1_20340525_range_position_reversal60",
  "factor_name": "60-day range-position reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(close - rolling_min(close,60)) / (rolling_max(close,60) - rolling_min(close,60)), shifted by one completed day",
    "description": "Ranks assets positively when their lagged close is near the bottom of its own trailing 60-day range, seeking subsequent 10-trading-day mean reversion. Zero-range observations are missing."
  },
  "dependencies": ["close"],
  "parameters": {"lookback_days": 60, "forward_horizon_days": 10, "signal_lag_days": 1, "minimum_cross_section": 8},
