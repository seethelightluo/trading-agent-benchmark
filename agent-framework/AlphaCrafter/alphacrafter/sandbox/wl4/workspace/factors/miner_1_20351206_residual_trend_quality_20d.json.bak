{
  "factor_id": "residual_trend_quality_20d",
  "factor_name": "20-Day Cross-Asset Residual Trend Quality Reversal",
  "version": "2035-12-06",
  "calculation": {
    "expression": "-((return_20d - cross_sectional_median(return_20d)) / rolling_std(daily_return,20)).shift(1)",
    "description": "Contrarian reversal of each asset's 20-day return relative to the cross-sectional median, scaled by its 20-day realized volatility. The one-session lag prevents look-ahead bias."
  },
  "dependencies": ["close"],
  "parameters": {"trend_window": 20, "volatility_window": 20, "volatility_min_periods": 15, "forecast_horizon": 10, "minimum_cross_section": 8, "lag_sessions": 1},
