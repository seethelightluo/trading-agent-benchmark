{
  "factor_id": "miner_1_20290906_volscaled_reversal_15d",
  "factor_name": "Volatility-Scaled Medium-Term Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "lag(-ROC(close,15) / rolling_std(daily_return,20), 1)",
    "description": "Ranks the 15 tradable benchmark assets by negative trailing 15-day return scaled by 20-day realized volatility. More negative recent performance with lower volatility receives a higher contrarian score. The one-day lag ensures only completed observations are used."
  },
  "dependencies": ["close", "daily_return"],
  "parameters": {"return_window_days": 15, "volatility_window_days": 20, "lag_days": 1, "minimum_valid_instruments": 8},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2029-09-05",
    "validation_timestamp": "2029-09-06",
