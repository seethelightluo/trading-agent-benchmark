{
  "factor_id": "miner_3_20340511_vix_beta_relative_reversal_20d",
  "factor_name": "VIX-beta-adjusted volatility-scaled relative-strength reversal",
  "version": "1.0",
  "calculation": {
    "expression": "lag1((-(return_20d - cross_sectional_median(return_20d))/volatility_40d) * (1 - 0.25 * zscore_120d(asset_return_beta_to_VIX_returns))",
    "description": "Ranks recent relative underperformers more highly for 10-day mean reversion, volatility scales the signal, and adjusts it by lagged rolling asset beta to daily VIX returns so unusually VIX-sensitive assets receive a moderated reversal score. All inputs are lagged one trading day before use."
  },
  "dependencies": ["close", "VIX close"],
  "parameters": {"relative_return_lookback": 20, "volatility_lookback": 40, "beta_lookback": 120, "minimum_beta_observations": 60, "beta_zscore_clip": 2.0, "beta_adjustment": 0.25, "forward_horizon_days": 10, "lag_days": 1, "minimum_cross_section": 8},
