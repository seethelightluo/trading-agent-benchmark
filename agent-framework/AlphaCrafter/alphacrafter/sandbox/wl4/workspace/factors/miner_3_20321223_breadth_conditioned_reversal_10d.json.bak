{
  "factor_id": "miner_3_20321223_breadth_conditioned_reversal_10d",
  "factor_name": "Breadth-conditioned volatility-scaled cross-sectional residual reversal",
  "version": "1.0",
  "calculation": {
    "expression": "shift1(-(ret20 - cross_sectional_mean(ret20))/(rolling_std(ret1,60)*sqrt(20)) * clip(1 + 0.30*abs(zscore(cross_sectional_positive_breadth20,120)),-,1.6))",
    "description": "Ranks assets for forward returns using lagged 20-session cross-sectional residual reversal, volatility scaled, with a bounded multiplier when the cross-asset positive-return breadth is unusually extreme. All inputs are shifted by one completed session; breadth is observation-only and no non-tradable asset is ordered."
  },
  "dependencies": ["close", "cross_sectional_returns", "rolling_volatility", "tradable_universe"],
  "parameters": {"return_window": 20, "volatility_window": 60, "breadth_window": 20, "breadth_z_window": 120, "multiplier_slope": 0.30, "multiplier_cap": 1.60, "lag_sessions": 1, "admission_horizon": 10},
