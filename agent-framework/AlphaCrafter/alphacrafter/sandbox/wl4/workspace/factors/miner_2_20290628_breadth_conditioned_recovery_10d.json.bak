{
  "factor_id": "miner_2_20290628_breadth_conditioned_recovery_10d",
  "factor_name": "Breadth-Conditioned Drawdown Recovery",
  "version": "1.0",
  "calculation": {
    "expression": "shift1(abs(close/rolling_max(close,60)-1) * ((pct_change(close,10)-shift(pct_change(close,30),10))/(std(pct_change(close),20))) * (1 - abs(pct_change(close,10))/rolling_sum(abs(pct_change(close)),10)).clip(lower=0) * (1.35 if cross_sectional_breadth_60d<0.5 else 0.85))",
    "description": "Ranks assets with deep 60-day drawdowns that show improving 10-day returns versus the preceding 30-day path, rewarding inefficient recovery and scaling by recent volatility. A breadth-conditioned multiplier emphasizes recovery during weak aggregate breadth and dampens it during broad strength. All inputs are lagged one completed day for forward-return testing."
  },
  "dependencies": [
    "close",
    "pct_change",
    "cross_sectional_breadth"
  ],
  "parameters": {
    "drawdown_window": 60,
    "recent_window": 10,
    "prior_window": 30,
    "volatility_window": 20,
    "efficiency_window": 10,
    "breadth_window": 60,
    "weak_breadth_threshold": 0.5,
    "weak_breadth_multiplier": 1.35,
    "strong_breadth_multiplier": 0.85,
    "lag_days": 1,
    "decision_horizon_days": 10
  },
  "validation": {
