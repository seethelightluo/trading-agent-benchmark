{
  "factor_id": "miner_1_20320219_broad_drawdown_weighted_residual_reversal_5d",
  "factor_name": "Broad drawdown-weighted volatility-normalized residual reversal (5d)",
  "version": "1.0",
  "calculation": {
    "expression": "shift_1(-(rolling_sum(pct_change(close),10)-cross_sectional_median(rolling_sum(pct_change(close),10)))/(rolling_std(pct_change(close),40)*sqrt(252)) * (1+0.75*clip(-(close/rolling_max(close,60)-1),0,0.5)))",
    "description": "At each decision date, use only information through the prior completed session. Reverse each asset's 10-session cumulative return residual versus the cross-sectional median, normalize by 40-session realized volatility, and continuously amplify assets in drawdown from their 60-session high. Unlike the selective predecessor, this implementation retains finite values for the full universe after warmup. Higher values indicate stronger expected 5-session forward return. Cross-sectional median is computed among the available 15 tradable assets.",
    "signal_lag": 1,
    "signal_artifact": "scripts/miner_1_20320219_broad_drawdown_residual.py"
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "residual_window": 10,
    "volatility_window": 40,
    "drawdown_window": 60,
    "drawdown_cap": 0.5,
    "drawdown_amplifier": 0.75,
    "forward_horizon": 5,
    "annualization": 252
  },
  "validation": {
    "status": "EFFECTIVE",
