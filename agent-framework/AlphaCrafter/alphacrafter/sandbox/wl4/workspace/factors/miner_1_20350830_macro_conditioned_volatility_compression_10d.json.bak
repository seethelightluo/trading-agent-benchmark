{
  "factor_id": "miner_1_20350830_macro_conditioned_volatility_compression_10d",
  "factor_name": "VIX-Conditioned Relative Volatility Compression 10D",
  "version": "1.0",
  "calculation": {
    "expression": "(-(sigma_10 / sigma_60) * (1 + 0.5 * clip((VIX - rolling_median(VIX,60)) / rolling_median(VIX,60), -1, 1))).shift(1)",
    "description": "Ranks assets favoring lower recent realized volatility relative to their 60-day baseline, with the compression signal amplified in elevated lagged VIX regimes. All inputs are lagged one completed session to prevent look-ahead."
  },
  "dependencies": ["close", "VIX"],
  "parameters": {"short_window": 10, "baseline_window": 60, "short_min_observations": 8, "baseline_min_observations": 40, "vix_window": 60, "vix_clip_lower": -1.0, "vix_clip_upper": 1.0, "vix_amplitude": 0.5, "forecast_horizon_days": 10, "lag_days": 1, "min_cross_section": 8},
  "validation": {
    "status": "EFFECTIVE",
    "period": {"start": "2026-08-06", "end": "2035-08-15"},
    "metrics": {"ic": 0.026508, "icir": 0.100682, "ic_hit_ratio": 0.5448, "coverage": 0.4701, "rank_turnover": 0.0785, "valid_dates": 2355, "average_instruments": 12.22, "universe_size": 15, "recent_120_icir": 0.159615, "recent_260_icir": 0.186795, "recent_520_icir": 0.114633, "recent_780_icir": 0.086761, "max_abs_library_correlation": null},
    "regime_notes": "Positive full-sample and rolling ICIR across the 15-asset cross-asset universe; strongest recent performance during the latest 120-260 observations. Interpret uncertainty conservatively due to small cross-section.",
