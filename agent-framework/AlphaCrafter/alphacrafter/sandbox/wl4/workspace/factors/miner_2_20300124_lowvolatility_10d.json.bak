{
  "factor_id": "miner_2_20300124_lowvolatility_10d",
  "factor_name": "Lagged 20-day realized low volatility",
  "version": "1.0",
  "calculation": {
    "expression": "-std(log(close_t/close_{t-1}), 20), lagged by one completed session",
    "description": "Ranks tradable assets by lower trailing 20-session realized volatility. The one-session lag prevents use of the decision-day close. Higher factor values indicate lower realized volatility and are expected to predict higher forward returns.",
    "signal_artifact": "reconstructable from ../persistent/stock_data/{symbol}.csv close columns; factor = -rolling(20).std(log(close/close.shift(1))).shift(1)"
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "realized_window_sessions": 20,
    "lag_sessions": 1,
    "horizons_sessions": [
      1,
      5,
      10,
      20
    ],
    "minimum_cross_section": 8,
    "tradable_universe_only": true
  },
