{
  "factor_id": "miner_2_20280615_residual_shock_reversal_5d",
  "factor_name": "Volatility-normalized cross-asset residual shock reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-((5d_return_i - cross_sectional_median_5d_return) / (sqrt(5) * rolling_std(daily_return,20)_i + 1e-8)), lagged 1 day",
    "description": "Ranks assets positively when their recent five-day return lagged the cross-asset median after volatility normalization, expressing short-horizon residual shock reversal. The one-day lag prevents using the decision day's information."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "shock_window": 5,
    "volatility_window": 20,
    "signal_lag": 1,
    "cross_section": "15 tradable benchmark instruments"
  },
