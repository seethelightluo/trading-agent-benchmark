{
  "factor_id": "range_position_reversal_120d",
  "factor_name": "Volatility-scaled 120-day range-position reversal",
  "version": "1.0",
  "calculation": {
    "expression": "(0.5 - (lagged_close - rolling_min(lagged_close,120)) / (rolling_max(lagged_close,120)-rolling_min(lagged_close,120))) / max(annualized_lagged_realized_volatility_40d, 0.05)",
    "description": "Cross-asset mean-reversion signal favoring instruments near the lower half of their trailing 120-session range, scaled by lagged 40-session realized volatility. All inputs are lagged to avoid look-ahead. Higher values are more favorable."
  },
  "dependencies": ["close"],
  "parameters": {"range_window": 120, "range_min_periods": 85, "vol_window": 40, "vol_min_periods": 30, "vol_floor": 0.05, "forward_horizon_days": 10},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2032-06-23",
    "validated_at": "2032-06-24T00:00:00Z",
    "metrics": {
      "ic": 0.069265,
      "icir": 0.22977,
      "icir_definition": "mean daily cross-sectional Spearman IC divided by its sample standard deviation",
      "ic_hit_ratio": 0.5814,
      "factor_coverage": 0.4732,
      "turnover": null,
      "valid_dates": 1916,
      "average_instruments": 11.72,
      "minimum_instruments": 8,
      "decay": {"h5_ic": 0.045236, "h5_icir_daily": 0.1467, "h20_ic": 0.074873, "h20_icir_daily": 0.2475},
      "recent_260d_ic": 0.105361,
      "recent_520d_ic": 0.066613,
      "recent_780d_ic": 0.057768,
      "max_abs_library_correlation": null
    },
    "admission_thresholds": {"absolute_daily_paper_ic_min": 0.007, "absolute_daily_paper_icir_min": 0.084},
    "regime_notes": "Positive across 5d, 10d, and 20d horizons; 10d predictive power is positive in recent 260, 520, and 780-session windows. Small cross-asset cross-section implies material IC uncertainty.",
    "signal_provenance": "scripts/miner_2_20320624_range_position_120d_signal.csv",
    "validation_script": "scripts/miner_2_20320624_range_position_reversal_120d.py"
  },
  "tags": ["mean_reversion", "range_position", "volatility_scaled", "cross_asset"],
  "last_validated": "2032-06-24T00:00:00Z"
}