{
  "factor_id": "miner_2_20350301_drawdown_downside_reversal_60d",
  "factor_name": "Downside-risk-normalized 60-day drawdown reversal",
  "version": "1.0",
  "calculation": {
    "expression": "(-((close / rolling_max(close,60,min_periods=40))-1)) / rolling_std(min(pct_change(close),0),20,min_periods=15), lagged 1 day",
    "description": "Ranks assets that are furthest below their 60-trading-day high, normalized by 20-day downside volatility. Larger values indicate stronger rebound potential. The signal is shifted one completed trading day before measuring 10-day forward returns."
  },
  "dependencies": ["close"],
  "parameters": {"drawdown_window": 60, "drawdown_min_periods": 40, "downside_vol_window": 20, "downside_vol_min_periods": 15, "forward_horizon": 10, "lag": 1, "minimum_cross_section": 8},
