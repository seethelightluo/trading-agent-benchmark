{
  "factor_id": "miner_3_20300919_vix_conditioned_reversal_20d",
  "factor_name": "VIX-Conditioned 20-Day Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(close / close.shift(20) - 1) * max(VIX / rolling_median(VIX, 60) - 1, 0)",
    "description": "Contrarian 20-session return, activated and scaled by the contemporaneous elevation of VIX over its trailing 60-session median. Signal is lagged one completed session for forecasting. Higher values favor recent losers during elevated volatility."
  },
  "dependencies": ["close", "VIX"],
  "parameters": {"lookback_return_days": 20, "vix_median_window": 60, "forward_horizon_days": 20, "signal_lag_days": 1},
