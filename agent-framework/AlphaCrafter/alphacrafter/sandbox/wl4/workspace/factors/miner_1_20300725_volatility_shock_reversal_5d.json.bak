{
  "factor_id": "miner_1_volatility_shock_reversal_5d",
  "factor_name": "Volatility-Shock Weighted Five-Day Reversal",
  "version": "2030-07-25",
  "calculation": {
    "expression": "shift(1, -return_5d * (realized_vol_5d / realized_vol_40d))",
    "description": "Ranks instruments positively when their prior five-session return was negative, with the reversal signal amplified when short-term realized volatility is elevated relative to its medium-term baseline. All inputs are lagged one completed session to avoid look-ahead."
  },
  "dependencies": ["close"],
  "parameters": {
    "return_window": 5,
    "short_volatility_window": 5,
    "baseline_volatility_window": 40,
    "short_vol_min_periods": 5,
    "baseline_vol_min_periods": 30,
    "signal_lag": 1,
    "forward_horizon": 5,
    "minimum_cross_section": 8
  },
  "validation": {
