{
  "factor_id": "miner_1_20330203_drawdown_convex_reversal_10d",
  "factor_name": "Drawdown-convex volatility-scaled medium-term reversal",
  "version": "1.0",
  "calculation": {
    "expression": "(-return_60d / realized_vol_60d_sqrt60) * (1 + 2 * abs(close / rolling_max(close,120) - 1)) * (0.5 + positive_return_fraction_60d), shifted 1 session",
    "description": "Contrarian 60-session return scaled by realized volatility and convexly increased for larger peak-to-trough drawdowns, with a positive-return consistency adjustment. The complete signal is lagged one session to prevent look-ahead bias; rank cross-sectionally across the 15 tradable benchmark instruments."
  },
  "dependencies": [
    "close",
    "daily_returns"
  ],
  "parameters": {
    "return_window": 60,
    "volatility_window": 60,
    "volatility_scale": "sqrt(60)",
    "drawdown_peak_window": 120,
    "drawdown_convexity": 2.0,
    "consistency_window": 60,
    "minimum_vol_observations": 40,
    "minimum_peak_observations": 80,
    "lag_sessions": 1,
    "admission_horizon_sessions": 10
  },
