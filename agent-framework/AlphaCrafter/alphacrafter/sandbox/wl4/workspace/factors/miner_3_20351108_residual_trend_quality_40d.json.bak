  "factor_name": "40-day residual trend quality reversal",
  "version": "1.0",
  "calculation": {
    "expression": "zscore_cs(shift1(-(return_40d - median_cs(return_40d)) / realized_vol_30d))",
    "description": "Cross-sectional contrarian score for 40-day returns relative to the cross-sectional median, scaled by 30-day realized volatility and lagged one completed session to avoid look-ahead."
