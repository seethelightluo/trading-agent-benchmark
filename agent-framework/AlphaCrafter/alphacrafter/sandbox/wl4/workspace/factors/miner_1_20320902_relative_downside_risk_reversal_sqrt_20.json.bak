  "factor_id": "miner_1_20320902_relative_downside_risk_reversal_sqrt_20",
  "factor_name": "Square-root relative downside-risk residual reversal",
  "version": "1.0",
  "calculation": {
    "expression": "(-rolling_sum_20(asset_return - cross_sectional_mean_return) / downside_volatility_60) * sqrt(clip(downside_volatility_60 / cross_sectional_median_downside_volatility_60, 0.5, 2.0)), lagged_1",
    "description": "Ranks assets for residual reversal, normalizing by 60-session downside volatility and applying a square-root compressed relative downside-risk multiplier. The one-session lag prevents look-ahead."
  },
  "dependencies": ["close"],
  "parameters": {"residual_window": 20, "downside_vol_window": 60, "min_residual_observations": 15, "min_downside_observations": 40, "risk_clip": [0.5, 2.0], "risk_transform": "sqrt", "signal_lag": 1, "admission_horizon_days": 20},
