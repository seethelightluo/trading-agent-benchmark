{
  "factor_id": "risk_adjusted_reversal_40d",
  "factor_name": "40-Session Risk-Adjusted Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-((close_t- close_{t-40})/close_{t-40}) / (std(pct_change(close),40)*sqrt(252)), lagged one completed session",
    "description": "Ranks assets higher when their trailing 40-session return has been weak after adjustment for realized volatility; intended as a contrarian cross-asset signal. All inputs are lagged one session at decision time."
  },
  "dependencies": ["close"],
  "parameters": {"lookback_sessions": 40, "volatility_window": 40, "annualization": 252, "lag_sessions": 1, "minimum_cross_section": 8},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2029-02-07",
    "validation_timestamp": "2029-02-08T00:00:00Z",
    "metrics": {
      "horizon_days": 1,
      "ic": 0.029477,
      "icir": 0.101233,
      "hit_ratio": 0.5293,
      "dates": 631,
      "average_instruments": 12.62,
      "coverage": 0.277829,
      "turnover": 0.037810,
      "max_abs_library_correlation": null
    },
    "regime_notes": "Validated across the full synthetic cross-asset history through 2029-02-07; 15 tradable instruments, with at least 8 valid instruments per IC date. Stronger positive contrarian IC at 5/10/20-day horizons (0.075688/0.092532/0.110522), but admission uses the daily horizon.",
    "signal_provenance": {
      "artifact_type": "recomputable_formula",
