{
  "factor_id": "miner_1_20291101_multihorizon_trend_quality",
  "factor_name": "Volatility-Normalized Multi-Horizon Trend Quality",
  "version": "1.0",
  "calculation": {
    "expression": "lag1(((0.6*pct_change(close,20)+0.4*pct_change(close,60))/ (std(pct_change(close,1),20)*sqrt(20))) * (1 if sign(ret20)==sign(ret60) else 0.35))",
    "description": "Combines medium and long horizon cross-asset trend, scales by realized volatility, and rewards agreement between horizons. The signal is lagged one trading day. Validation found a negative recent relationship, so downstream use must invert direction or treat it as a contrarian signal; no direction is assumed by this record."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "medium_window": 20,
    "long_window": 60,
    "vol_window": 20,
    "medium_weight": 0.6,
    "long_weight": 0.4,
    "disagreement_multiplier": 0.35,
    "signal_lag": 1,
    "forward_horizon": 10
  },
  "validation": {
