{
  "factor_id": "miner_3_20330217_range_aligned_momentum_30d",
  "factor_name": "Range-Position-Aligned Momentum",
  "version": "1.0",
  "calculation": {
    "expression": "lag1((close.pct_change(40)/(std(pct_change(close),60)*sqrt(40))) * rolling_mean(((close-low)/(high-low))-0.5,15,min_periods=8))",
    "description": "Lagged 40-session volatility-normalized momentum signed and scaled by the mean 15-session close location within daily ranges. Positive values identify assets with positive momentum and persistent closes above mid-range; negative values identify the opposite."
  },
  "dependencies": ["close", "high", "low"],
  "parameters": {"momentum_window": 40, "volatility_window": 60, "range_position_window": 15, "range_position_min_periods": 8, "lag_sessions": 1},
