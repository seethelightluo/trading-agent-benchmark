{
  "factor_id": "range_position_reversal_120d",
  "factor_name": "120-day Range-Position Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(close - rolling_min(close,120)) / (rolling_max(close,120) - rolling_min(close,120)), lagged one trading day",
    "description": "Ranks assets higher when their lagged close is nearer the bottom of its 120-session observed range, testing long-horizon range mean reversion over the next 10 trading sessions. Undefined zero-range windows are excluded."
  },
  "dependencies": ["close"],
  "parameters": {"lookback_days": 120, "minimum_observations": 80, "forecast_horizon_days": 10, "lag_days": 1},
  "validation": {
