{
  "factor_id": "miner_3_consistency_momentum_10d",
  "factor_name": "Consistency-weighted risk-adjusted momentum",
  "version": "1.0",
  "calculation": {
    "expression": "(pct_change(close,20) / (std(pct_change(close,1),20) * sqrt(20))) * (0.5 + mean(pct_change(close,1)>0,20))",
    "description": "Twenty-session momentum divided by annualized-style 20-session realized volatility, weighted by the fraction of positive daily returns in the same 20-session window. Inputs are lagged one completed session before forward-return evaluation.",
    "signal_artifact": "scripts/miner_3_20290111_consistency_momentum.py"
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "momentum_window": 20,
    "volatility_window": 20,
    "consistency_window": 20,
    "volatility_scale": "sqrt(20)",
    "consistency_floor": 0.5,
    "horizon_days": 10,
    "lag_sessions": 1
  },
