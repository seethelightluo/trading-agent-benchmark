{
  "factor_id": "miner_3_20341207_smoothed_dispersion_range_reversal_60d",
  "factor_name": "Smoothed dispersion-conditioned 60-day range reversal",
  "version": "2034-12-07",
  "calculation": {
    "expression": "shift1(-(close-rolling_min(close,60))/(rolling_max(close,60)-rolling_min(close,60)) * (0.5 + rolling_mean(rolling_percentile_rank(rolling_std(pct_change(close,20)),60),5))",
    "description": "Contrarian 60-session range-location signal, scaled by a smoothed trailing cross-asset 20-day return-dispersion percentile; shifted one completed session to avoid look-ahead."
  },
  "dependencies": ["close"],
  "parameters": {"range_window": 60, "range_min_periods": 42, "dispersion_return_window": 20, "dispersion_percentile_window": 60, "dispersion_min_periods": 30, "dispersion_smoothing_window": 5, "forward_horizon_days": 10, "lag_days": 1, "minimum_cross_section": 8},
