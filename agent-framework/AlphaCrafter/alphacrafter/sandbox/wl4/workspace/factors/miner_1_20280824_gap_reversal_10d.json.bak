{
  "factor_id": "gap_reversal_10d",
  "factor_name": "Smoothed overnight gap reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-rolling_mean(open / close.shift(1) - 1, 3).shift(1)",
    "description": "For each tradable asset, take the negative three-session mean overnight gap and lag it one completed session. Higher values indicate stronger expected medium-horizon reversal after adverse overnight gaps. The one-session lag prevents use of information from the decision day's open."
  },
  "dependencies": [
    "open",
    "close"
  ],
  "parameters": {
    "gap_window": 3,
    "signal_lag": 1,
    "forward_horizon_days": 10,
    "minimum_cross_section": 8
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2028-08-23 (available source observations)",
