{
  "factor_id": "miner_3_range_breakout_quality_10d",
  "factor_name": "Inverse Range Breakout Quality",
  "version": "2033-04-28",
  "calculation": {
    "expression": "-(pct_change(close,40) / (rolling_std(pct_change(close),60)*sqrt(40))) * (0.5 + rolling_mean((close-rolling_min(close,40))/(rolling_max(close,40)-rolling_min(close,40)),10))",
    "description": "Inverse volatility-scaled 40-day momentum, modulated by the 10-day average 40-day range position. A high score favors weaker recent trends, with range location controlling signal magnitude. All inputs are lagged one completed day."
  },
  "dependencies": ["close", "high", "low"],
  "parameters": {"momentum_window": 40, "volatility_window": 60, "range_window": 40, "location_window": 10, "forward_horizon_days": 10, "lag_days": 1},
  "validation": {
