{
  "factor_id": "miner_3_relative_acceleration_10d",
  "factor_name": "Volatility-Scaled Relative Return Acceleration",
  "version": "1.0",
  "calculation": {
    "expression": "cross_section_demean((return_10d - lagged_return_30d) / rolling_std(daily_return,20)).shift(1)",
    "description": "Ranks assets whose recent 10-day return is accelerating relative to the preceding 30-day return, scaled by 20-day volatility. Cross-sectional demeaning is applied and the complete signal is lagged one trading day to avoid look-ahead bias."
  },
  "dependencies": [
    "close",
    "daily_return"
  ],
  "parameters": {
    "short_window": 10,
    "prior_window": 30,
    "volatility_window": 20,
    "signal_lag": 1,
    "minimum_cross_section": 8,
    "horizon_days": 10
  },
