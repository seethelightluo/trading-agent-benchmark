{
  "factor_id": "miner_2_20280810_downside_vol_reversal_20d",
  "factor_name": "Downside-volatility-scaled long-horizon reversal",
  "version": "1.0",
  "calculation": {
    "expression": "rolling_mean_3((-close_return_20d / (sqrt(20)*rolling_std(negative_daily_returns,40))) * (abs(cross_sectional_positive_return_breadth_20d - 0.5) + 0.5), 3).shift(1)",
    "description": "Contrarian 20-day return signal, scaled by downside volatility and by the extremity of cross-sectional positive-return breadth; three-observation smoothing and one-day lag prevent look-ahead. Higher values indicate stronger expected forward return."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "return_lookback_days": 20,
    "downside_vol_window": 40,
