{
  "factor_id": "miner_3_20341123_smoothed_dispersion_range_reversal_60d",
  "factor_name": "Smoothed dispersion-conditioned 60-day range reversal",
  "version": "1.0",
  "calculation": {
    "expression": "(-(close - rolling_min(close,60))/(rolling_max(close,60)-rolling_min(close,60))) * (0.5 + SMA5(percentile_position(std(cross_sectional_return_20d),60)))",
    "description": "Contrarian range-location signal, scaled by a five-session smoothed trailing percentile of cross-asset 20-day return dispersion; lagged one completed session to avoid lookahead."
  },
  "dependencies": ["close", "cross_asset_prices"],
  "parameters": {"range_window": 60, "range_min_periods": 42, "dispersion_return_window": 20, "dispersion_percentile_window": 60, "dispersion_min_periods": 30, "dispersion_smoothing_window": 5, "signal_lag": 1, "forward_horizon": 10},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-03-06 through 2034-11-08",
    "metrics": {"ic": 0.040520, "icir": 0.125873, "ic_hit_ratio": 0.5563, "dates": 2504, "average_instruments": 11.07, "universe_size": 15, "minimum_cross_section": 8, "coverage": 0.5778, "rank_turnover": 0.0935, "max_abs_library_correlation": null},
