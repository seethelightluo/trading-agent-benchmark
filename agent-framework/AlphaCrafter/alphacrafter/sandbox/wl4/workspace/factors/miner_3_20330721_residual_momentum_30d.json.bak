{
  "factor_id": "miner_3_20330721_residual_momentum_30d",
  "factor_name": "Equity-Benchmark Residual Momentum (Contrarian Direction)",
  "version": "1.0",
  "calculation": {
    "expression": "direction * (asset_return_30d - rolling_beta_60d(asset_daily_return, equity_mean_daily_return) * equity_mean_return_30d)",
    "description": "Compute each asset's 30-trading-day return residual to the equal-weight mean return of the eight equity-index instruments, using lagged 60-day rolling covariance beta. The validated trading direction is -1 (contrarian to the raw residual signal). All signal values are shifted one trading day before evaluation/use."
  },
  "dependencies": ["close", "daily_return"],
  "parameters": {
    "asset_return_window": 30,
    "beta_window": 60,
    "equity_benchmark_assets": ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX"],
    "forward_horizon_days": 10,
    "direction": -1,
    "minimum_cross_section": 8
  },
  "validation": {
