  "factor_name": "Volatility-normalized cross-asset residual reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-rolling_mean_3(r_10d - cross_sectional_median(r_10d)) / rolling_std_40(daily_return).shift(1)",
    "description": "Reverse each asset's smoothed 10-session return residual versus the daily cross-sectional median, normalize by trailing 40-session return volatility, and lag the complete signal one observation before forecasting."
