  "factor_name": "Volatility-Scaled 60-Day Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-shift(pct_change(close,60) / (rolling_std(pct_change(close),20)*sqrt(20)), 1)",
    "description": "Negates the prior 60-session return normalized by 20-session realized volatility, lagged one completed session; higher values favor reversal candidates."
  },
