  "factor_name": "Own-Volatility Compression 10D",
  "version": "1.0",
  "calculation": {
    "expression": "-(rolling_std(pct_change(close),10)/rolling_std(pct_change(close),40)-1) shifted 1 day",
    "description": "Ranks instruments favoring recent volatility compression relative to their own medium-term volatility; signal is lagged one completed trading day to avoid look-ahead."
