{
  "factor_id": "miner_1_20300418_downside_reversal_conditioned_10d",
  "factor_name": "Downside-Volatility-Scaled Reversal with Trend Guard",
  "version": "1.0",
  "calculation": {
    "expression": "shift_1(rolling_mean_3((-pct_change(close,10)/rolling_std(where(pct_change(close,1)<0,pct_change(close,1),0),20)) * I[pct_change(close,60)>-0.15]))",
    "description": "Ranks a 10-session mean-reversion score scaled by 20-session downside volatility, while suppressing assets in severe 60-session drawdowns. The signal is lagged one completed session and smoothed over three sessions. Higher values indicate stronger expected forward reversal returns."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "reversal_window": 10,
    "downside_volatility_window": 20,
    "downside_min_periods": 15,
    "trend_window": 60,
    "trend_floor": -0.15,
    "smoothing_window": 3,
    "smoothing_min_periods": 2,
    "lag_sessions": 1,
    "minimum_cross_section": 8,
    "epsilon": 1e-09
  },
  "validation": {
