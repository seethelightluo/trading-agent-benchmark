{
  "factor_id": "miner_3_multihorizon_range_blend_40_80_120",
  "factor_name": "Multi-horizon range-position reversal blend",
  "version": "1.0",
  "calculation": {
    "expression": "mean(-(close-min(close,w))/(max(close,w)-min(close,w)) for w in [40,80,120]), lagged 1 session",
    "description": "Equal-weight blend of reversal scores placing higher values on instruments nearer the bottom of their 40-, 80-, and 120-session trailing price ranges. The complete signal is shifted one session to prevent look-ahead."
  },
  "dependencies": ["close"],
  "parameters": {"windows": [40,80,120], "min_periods_fraction": 0.7, "lag_sessions": 1, "forward_horizon_sessions": 10},
