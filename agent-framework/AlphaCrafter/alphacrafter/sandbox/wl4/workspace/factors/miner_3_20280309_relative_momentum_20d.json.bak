  "factor_id": "miner_3_relative_momentum_20d",
  "factor_name": "Cross-Asset Relative Momentum 20D",
  "version": "20280309",
  "calculation": {
    "expression": "(close_t-1/close_t-21 - 1) - cross_sectional_median_i(close_t-1/close_t-21 - 1)",
    "description": "For each tradable asset, calculate its lagged 20-trading-day return and subtract the same-day cross-sectional median across the 15 tradable instruments. Positive values identify relative winners; negative values identify relative losers. The one-day lag prevents use of the just-completed day's close.",
