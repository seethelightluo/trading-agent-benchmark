{
  "factor_id": "breadth_conditioned_trend_quality_reversal_10d",
  "factor_name": "Breadth-conditioned trend-quality reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-[(0.6*ret_10d + 0.4*ret_30d) / realized_vol_20d] * clip(0.65 + 0.7*rolling_mean_20d(cross_sectional_fraction(ret_10d > 0)), 0.65, 1.35), lagged_1d",
    "description": "Cross-sectional reversal of blended 10- and 30-session returns, volatility scaled and conditioned by the preceding market breadth regime. The signal is lagged one completed session to prevent look-ahead. Higher values indicate stronger expected forward returns."
  },
  "dependencies": ["close"],
  "parameters": {"return_short_days": 10, "return_long_days": 30, "short_weight": 0.6, "long_weight": 0.4, "volatility_days": 20, "breadth_days": 10, "breadth_smoothing_days": 20, "breadth_floor": 0.65, "breadth_multiplier_slope": 0.7, "breadth_cap": 1.35, "lag_days": 1, "forward_horizon_days": 10},
