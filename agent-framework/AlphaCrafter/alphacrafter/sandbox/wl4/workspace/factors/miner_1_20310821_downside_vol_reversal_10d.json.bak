    "regime_notes": "Positive full-history H10 IC/ICIR and positive recent-window H10 IC/ICIR: recent 365d 0.034438/0.111109, 730d 0.030625/0.108387, 1095d 0.036733/0.129935. Small 15-asset cross-section implies conservative interpretation.",
    "signal_provenance": {"artifact_type": "reproducible_script", "script": "scripts/miner_1_20310821_downside_vol_reversal.py", "universe_size": 15}
