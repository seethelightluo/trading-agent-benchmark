{
  "factor_id": "downside_vol_residual_reversal_10d",
  "factor_name": "Downside-Volatility Scaled Residual Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-((rolling_sum(return,10) - cross_sectional_median(rolling_sum(return,10))) / (0.7*rolling_std(negative_returns,40) + 0.3*rolling_std(return,40)))",
    "description": "At each date, fade 10-day cross-sectional residual moves, scaling by a blended 40-day downside and total volatility estimate; signal is lagged one completed session to avoid look-ahead. Higher values favor assets that underperformed their cross-asset median on a volatility-adjusted basis."
  },
  "dependencies": ["close", "returns"],
  "parameters": {"residual_window_days": 10, "volatility_window_days": 40, "downside_vol_weight": 0.7, "total_vol_weight": 0.3, "lag_days": 1, "forward_horizon_days": 10},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2031-08-20",
    "validated_at": "2031-08-21T00:00:00Z",
    "metrics": {
