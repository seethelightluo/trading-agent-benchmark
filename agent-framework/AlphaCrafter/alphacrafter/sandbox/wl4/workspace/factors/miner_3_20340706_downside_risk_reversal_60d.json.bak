{
  "factor_id": "miner_3_20340706_downside_risk_reversal_60d",
  "factor_name": "Downside-risk reversal with mild risk-adjusted return correction",
  "version": "1.0",
  "calculation": {
    "expression": "lag1(downside_rms_60 / total_volatility_60 - 0.25 * mean_return_60 / total_volatility_60)",
    "description": "For each tradable cross-asset instrument, compute trailing 60-session downside RMS divided by total volatility, then subtract one quarter of volatility-scaled mean return. Lag by one completed session. Higher values historically identify assets with downside-risk-heavy profiles that subsequently exhibit stronger 10-session returns; use as a positively ranked reversal signal."
  },
  "dependencies": ["close", "daily_returns"],
  "parameters": {
    "risk_window_days": 60,
    "minimum_volatility_observations": 40,
    "minimum_downside_observations": 20,
    "return_adjustment_weight": 0.25,
    "lag_days": 1,
    "forward_horizon_days": 10,
    "minimum_cross_section": 8
  },
