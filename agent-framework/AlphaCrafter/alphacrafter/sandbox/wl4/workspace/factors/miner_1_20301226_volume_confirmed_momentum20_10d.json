{
  "factor_id": "miner_1_volume_confirmed_momentum20_10d",
  "factor_name": "Volume-Confirmed 20-Day Momentum",
  "version": "1.0",
  "calculation": {
    "expression": "rank_pct(shift1(pct_change(close,20) * (1 + 0.25 * clip((log(volume)-rolling_mean(log(volume),60))/rolling_std(log(volume),60), -2, 2)))",
    "description": "Ranks a lagged 20-session return amplified or attenuated by a bounded 60-session standardized log-volume surprise. The one-session lag prevents look-ahead and cross-asset ranking makes the signal scale-independent."
  },
  "dependencies": [
    "close",
    "volume",
    "date"
  ],
  "parameters": {
    "momentum_window": 20,
    "volume_window": 60,
    "volume_z_clip": [
      -2,
      2
    ],
    "volume_weight": 0.25,
    "signal_lag": 1,
    "forward_horizon": 10,
    "minimum_cross_section": 8
  },
