{
  "factor_id": "miner_3_20320819_multihorizon_residual_reversal_20d",
  "factor_name": "Multi-horizon volatility-scaled cross-asset residual reversal (10/30 blend)",
  "version": "1.0",
  "calculation": {
    "expression": "-0.5*(rolling_sum_10(residual_return)/rolling_std_60(return) + rolling_sum_30(residual_return)/rolling_std_60(return)).shift(1)",
    "description": "Equal-weight cross-asset benchmark residual returns over 10 and 30 sessions, averaged and divided by 60-session annualized volatility; negated for contrarian exposure and lagged one completed session."
  },
  "dependencies": [
    "close",
    "pct_change"
  ],
  "parameters": {
    "short_window": 10,
    "long_window": 30,
    "vol_window": 60,
    "min_periods_short": 8,
    "min_periods_long": 20,
    "min_periods_vol": 40,
    "lag": 1,
    "forward_horizon": 20,
    "universe_size": 15
  },
  "validation": {
