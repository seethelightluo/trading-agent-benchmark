{
  "factor_id": "miner_1_relative_reversal_dispersion_10d_v1",
  "factor_name": "Cross-Asset Relative Volatility-Normalized Reversal 10D",
  "version": "1.0",
  "calculation": {
    "expression": "-((return_10d - cross_sectional_median(return_10d)) / (rolling_std(daily_return,20)*sqrt(10)+1e-8)) shifted 1 day",
    "description": "Fade each instrument's ten-day return relative to the contemporaneous cross-asset median, scaled by trailing 20-day volatility; lagged one completed day to prevent look-ahead."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "return_window": 10,
    "volatility_window": 20,
    "forward_horizon": 10,
    "lag": 1,
    "minimum_cross_section": 8
  },
