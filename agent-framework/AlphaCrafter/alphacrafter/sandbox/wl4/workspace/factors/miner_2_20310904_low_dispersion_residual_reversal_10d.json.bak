{
  "factor_id": "miner_2_20310904_low_dispersion_residual_reversal_10d",
  "factor_name": "Low-dispersion cross-asset residual reversal (10d)",
  "version": "1.0",
  "calculation": {
    "expression": "- (ret_10d(asset,t-1) - median_assets(ret_10d,t-1)) when dispersion(t-1) < rolling_median(dispersion,60,t-1), else 0",
    "description": "Contrarian relative-losers signal activated only during compressed cross-asset daily-return dispersion regimes. All prices and regime state are lagged one completed session to avoid look-ahead. Zero is neutral outside the low-dispersion regime.",
