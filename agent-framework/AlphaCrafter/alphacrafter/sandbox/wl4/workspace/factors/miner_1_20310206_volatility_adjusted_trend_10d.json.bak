  "factor_name": "Volatility-Adjusted Multi-Horizon Trend",
  "version": "20310206",
  "calculation": {
    "expression": "rank_cs(0.6*(return_20d/ann_vol_20d) + 0.4*(return_60d/ann_vol_60d)) lagged_1d",
    "description": "For each tradable benchmark asset, combine 20-session and 60-session returns after scaling by their respective trailing annualized realized volatility. Rank cross-sectionally and lag the signal by one completed session before forecasting the next 10-session return. Higher values indicate stronger risk-adjusted trend."
