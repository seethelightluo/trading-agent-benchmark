{
  "factor_id": "miner_3_moderate_breadth_acceleration_10d",
  "factor_name": "Moderate Extreme-Breadth Relative Acceleration",
  "version": "1.0",
  "calculation": {
    "expression": "cross_section_demean(((return_10d - lag(return_10d,10))/rolling_std(daily_return,20))* (1 + abs(breadth_20d - 0.5)), lag=1)",
    "description": "For each tradable asset, compute volatility-scaled relative acceleration as the 10-day return minus the 10-day-lagged 10-day return, divide by 20-day daily-return volatility, multiply by a moderate emphasis for broad cross-asset extremes, demean cross-sectionally, and lag one completed day before forecasting. breadth_20d is the fraction of the 15 tradable assets with positive 20-day return.",
    "signal_reconstruction": "Load close prices for the 15 tradable symbols; r=close.pct_change(); acc=(close.pct_change(10)-close.pct_change(30).shift(10))/r.rolling(20,min_periods=15).std(); breadth=(close.pct_change(20)>0).mean(axis=1); raw=acc*(1+abs(breadth-0.5)); signal=raw.sub(raw.mean(axis=1),axis=0).shift(1)."
  },
  "dependencies": [
    "close",
    "daily_return"
  ],
  "parameters": {
    "acceleration_fast_days": 10,
    "acceleration_slow_days": 30,
    "volatility_window_days": 20,
    "volatility_min_periods": 15,
    "breadth_window_days": 20,
    "breadth_universe_size": 15,
    "breadth_multiplier": "1 + abs(breadth - 0.5)",
    "lag_days": 1,
    "forward_horizon_days": 10
  },
