{
  "factor_id": "miner_2_range_position_reversal_90d",
  "factor_name": "90-day range-position reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(close - rolling_min(close,90)) / (rolling_max(close,90) - rolling_min(close,90)), lagged 1 session",
    "description": "Ranks assets lower when their prior completed-session close is near the top of its 90-session range, favoring medium-term range weakness as a cross-sectional reversal signal. Signals with zero range are treated as missing."
  },
  "dependencies": ["close"],
  "parameters": {"lookback_sessions": 90, "min_periods": 60, "signal_lag_sessions": 1, "forward_horizon_sessions": 10, "min_cross_section": 8},
  "validation": {
    "status": "EFFECTIVE",
    "period": {"start": "2020-04-03", "end": "2034-08-02"},
    "timestamp": "2034-08-17",
    "metrics": {
      "ic": 0.047311,
      "icir": 0.146851,
      "hit_ratio": 0.5615,
      "dates": 2689,
      "average_instruments": 11.43,
      "universe_size": 15,
      "coverage": 0.677,
      "turnover": 0.0824,
      "max_abs_library_correlation": null,
      "decay": {
        "horizon_10_definition": "Spearman cross-sectional correlation of lagged signal with close(t+10)/close(t)-1",
        "note": "10-session admission horizon; longer-horizon decay not evaluated in this cycle"
      }
    },
    "regime_notes": "Validated across the full 2020-2034 synthetic cross-asset history, including pandemic, inflation/rate, crypto, and risk-on/off regimes. Small cross-section implies conservative interpretation of IC uncertainty."
  },
  "provenance": {
    "signal_artifact": "scripts/artifacts/miner_2_20340817_range_position_90d_signal.csv",
    "ic_artifact": "scripts/artifacts/miner_2_20340817_range_position_90d_ic.csv",
    "assets": ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"],
    "data_cutoff": "2034-08-16",
    "observation_rule": "Only completed data through t-1 used for signal; forward returns are evaluated after signal date."
  },
  "tags": ["reversal", "technical", "cross_asset", "range_position"]
}
