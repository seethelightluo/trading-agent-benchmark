{
  "factor_id": "miner_3_dxy_conditioned_momentum_10d",
  "factor_name": "DXY-Regime Volatility-Normalized Momentum Reversal",
  "version": "20291101",
  "calculation": {
    "expression": "lag1[(R20_asset/(sqrt(20)*sigma20_asset)) * (1 + 0.25*tanh(R20_DXY/(sqrt(20)*sigma20_DXY)))]",
    "description": "Compute each asset's 20-day return normalized by 20-day realized volatility, then scale it by the established 20-day DXY trend regime. The validated raw signal is contrarian at the 10-day horizon, so portfolio construction should use direction=-1. DXY is observation-only and is never tradable. All inputs are lagged one session."
  },
  "dependencies": [
    "close",
    "DXY close"
  ],
  "parameters": {
    "asset_return_window": 20,
    "asset_volatility_window": 20,
    "dxy_return_window": 20,
    "dxy_volatility_window": 20,
    "dxy_scale": 0.25,
    "dxy_trend_clip": 2.0,
    "lag_sessions": 1,
    "forward_horizon_days": 10,
    "direction": -1
  },
