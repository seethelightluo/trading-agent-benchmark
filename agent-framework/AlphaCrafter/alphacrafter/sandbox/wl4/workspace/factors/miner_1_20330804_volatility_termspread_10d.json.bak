  "factor_name": "Volatility Term-Structure Compression",
  "version": "1.0",
  "calculation": {
    "expression": "-(rolling_std(pct_change(close),10) / rolling_std(pct_change(close),60) - 1), lagged 1 session",
    "description": "Ranks assets higher when short-horizon realized volatility is compressed relative to 60-session realized volatility; intended to identify assets with stabilizing risk conditions for the next 10-session horizon."
  },
  "dependencies": ["close"],
  "parameters": {"short_window": 10, "long_window": 60, "min_short_observations": 8, "min_long_observations": 40, "lag_sessions": 1, "forward_horizon": 10, "minimum_cross_section": 8},
