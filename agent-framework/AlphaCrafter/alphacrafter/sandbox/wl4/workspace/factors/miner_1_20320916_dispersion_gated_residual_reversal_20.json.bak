{
  "factor_id": "miner_1_20320916_dispersion_gated_residual_reversal_20",
  "factor_name": "Dispersion-gated residual reversal 20d",
  "version": "1.0",
  "calculation": {
    "expression": "(-rolling_sum(residual_return,20) / (rolling_std(residual_return,60)*sqrt(252))) * clip(rolling_mean(cross_sectional_residual_dispersion,20) / rolling_median(rolling_mean(cross_sectional_residual_dispersion,20),120), 0.5, 2.0), shifted by 1 session",
    "description": "Cross-asset residual-return contrarian signal, volatility normalized and continuously scaled by recent market-wide cross-sectional dispersion relative to its 120-session median. Uses only information available before the prediction date."
  },
  "dependencies": ["close"],
  "parameters": {"residual_benchmark": "equal_weight_mean_daily_return", "lookback_return": 20, "lookback_volatility": 60, "lookback_dispersion": 20, "dispersion_baseline": 120, "min_periods_return": 12, "min_periods_volatility": 30, "min_periods_dispersion": 15, "clip": [0.5, 2.0], "lag_sessions": 1, "forecast_horizon_sessions": 20},
