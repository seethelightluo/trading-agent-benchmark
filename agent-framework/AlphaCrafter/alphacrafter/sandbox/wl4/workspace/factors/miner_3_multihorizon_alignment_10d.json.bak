{
  "factor_id": "miner_3_multihorizon_alignment_10d",
  "factor_name": "Multi-horizon volatility-normalized momentum alignment",
  "version": "20290208",
  "calculation": {
    "expression": "((z10 + 2*z20 + z60)/4) * (0.5 + (I[z10>0]+I[z20>0]+I[z60>0])/3), where zh=return_h/(20d realized daily volatility*sqrt(20))",
    "description": "Cross-asset trend score using lagged 10-, 20-, and 60-session returns normalized by 20-session realized volatility, with an agreement multiplier rewarding aligned positive horizons. Signal at decision date uses data only through the prior completed session."
  },
  "dependencies": ["close"],
  "parameters": {"horizons": [10, 20, 60], "weights": [1, 2, 1], "vol_window": 20, "vol_min_periods": 15, "forecast_horizon": 10, "minimum_cross_section": 8},
