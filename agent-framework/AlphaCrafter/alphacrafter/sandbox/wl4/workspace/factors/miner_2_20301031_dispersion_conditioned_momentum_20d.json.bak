  "factor_name": "Cross-Asset Dispersion-Scaled Momentum",
  "version": "1.0",
  "calculation": {
    "expression": "(20d_close_return_i / (1 + 10 * cross_sectional_std(20d_close_returns))) shifted by one completed trading day",
