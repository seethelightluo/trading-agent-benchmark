{
  "factor_id": "miner_1_20290726_downside_asymmetry_momentum_20d",
  "factor_name": "Downside-Asymmetry Momentum 20D",
  "version": "1.0",
  "calculation": {
    "expression": "lag1(ROC(close,20) / (sqrt(20) * downside_std(pct_change(close),20) + 1e-8))",
    "description": "Ranks assets by their 20-trading-day return scaled by the volatility of negative daily returns only. The one-day lag prevents use of the current completed bar in a same-day decision. Higher values indicate stronger return achieved with less downside variability."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "lookback_days": 20,
    "downside_window": 20,
    "minimum_observations": 12,
    "lag_days": 1,
    "epsilon": 1e-08,
    "forward_horizon_days": 10
  },
