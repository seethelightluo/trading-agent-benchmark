{
  "factor_id": "miner_2_20351206_regime_residual_reversal",
  "factor_name": "Volatility-Regime-Scaled Relative 20-Day Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "rank_cs((-(ret_20 - median_cs(ret_20)) / vol_30) * clip(vol_30 / vol_90, 0.5, 2.5), pct=True).shift(1)",
    "description": "Ranks contrarian relative 20-day returns, volatility-scaled and amplified when 30-day volatility is elevated relative to its 90-day baseline. The one-session lag prevents look-ahead. Higher values indicate stronger expected forward returns."
  },
  "dependencies": ["close"],
  "parameters": {"return_window": 20, "short_vol_window": 30, "long_vol_window": 90, "min_short_vol_observations": 20, "min_long_vol_observations": 60, "regime_clip": [0.5, 2.5], "signal_lag_days": 1, "forward_horizon_days": 10},
