{
  "factor_id": "miner_2_20350201_breadth_gated_risk_reversal_60d",
  "factor_name": "Breadth-Gated Risk-Adjusted 60-Day Reversal",
  "version": "2035-02-01",
  "calculation": {
    "expression": "-pct_change(close,60) / (rolling_std(pct_change(close,1),20) * sqrt(252)) * clip(0.5 + 0.8 * (cross_sectional_breadth_20d - 0.5), 0.25, 1.05), lagged 1 day",
    "description": "Fade 60-day risk-adjusted performance. Scale reversal by the contemporaneous fraction of tradable assets with positive 20-day mean daily returns, and lag the signal one completed day to prevent look-ahead."
  },
  "dependencies": ["close", "daily returns"],
  "parameters": {"lookback_return_days": 60, "volatility_days": 20, "breadth_days": 20, "forward_horizon_days": 10, "minimum_cross_section": 8, "annualization": 252, "breadth_clip": [0.25, 1.05], "signal_lag_days": 1},
  "validation": {
