{
  "factor_id": "miner_1_horizon_alignment_momentum_10d",
  "factor_name": "Multi-Horizon Rank-Aligned Momentum",
  "version": "1.0",
  "calculation": {
    "expression": "mean(rank_pct(close/close.shift(h)-1) for h in [5,10,20,40]), shifted by 1 session",
    "description": "For each tradable asset, average its cross-sectional percentile ranks of 5-, 10-, 20-, and 40-session price returns. The one-session lag ensures only completed daily data is used. Higher values indicate persistent strength across multiple horizons."
  },
  "dependencies": ["close"],
  "parameters": {"lookbacks": [5, 10, 20, 40], "signal_lag": 1, "forward_horizon": 10, "minimum_cross_section": 8},
  "validation": {
    "status": "EFFECTIVE",
    "period": {"start": "2020-01-01", "end": "2030-10-30"},
    "validated_on": "2030-10-31",
    "metrics": {
      "ic": 0.007321,
      "icir": 1.313230,
      "ic_hit_ratio": 0.5059,
      "coverage": 0.9979,
      "turnover": 0.106206,
      "validation_dates": 3491,
      "average_instruments": 15.0,
      "universe_size": 15,
      "max_abs_library_correlation": null,
      "decay": {"5d_ic": -0.002829, "10d_ic": 0.007321, "20d_ic": 0.013881},
      "recent_365d_ic": -0.027418,
      "recent_365d_icir": -1.304694
    },
    "signal_artifact": "scripts/miner_1_20301031_horizon_alignment_momentum.py",
    "regime_notes": "Full-history 10-session IC and ICIR clear the benchmark gates, but recent 365-session performance is materially negative; treat as a low-weight diversification candidate pending revalidation. Small cross-asset cross-sections imply conservative interpretation of IC uncertainty."
