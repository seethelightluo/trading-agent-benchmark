  "calculation": {
    "expression": "-std(negative_only_daily_returns, window=30, min_periods=15), lagged 1 session",
    "description": "Ranks assets higher when their recent downside-only volatility is lower. Negative-return observations are retained and positive-return observations are treated as missing; the signal is lagged one completed session to avoid look-ahead."
