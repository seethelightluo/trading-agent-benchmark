{
  "factor_id": "miner_3_20341026_dispersion_conditioned_range_reversal_60d",
  "factor_name": "Dispersion-conditioned 60-day range reversal",
  "version": "2034-10-26",
  "calculation": {
    "expression": "-(close - rolling_min(close,60,min_periods=42))/(rolling_max(close,60,min_periods=42)-rolling_min(close,60,min_periods=42)) * (0.5 + percentile_rank_60(cross_sectional_std(pct_change(close,20))))",
    "description": "For each tradable benchmark, favor assets near the bottom of their trailing 60-session price range. Scale the reversal magnitude by the trailing 60-session percentile rank of cross-asset 20-session return dispersion. Signal is lagged one completed session to avoid look-ahead and targets 10-session forward returns. Undefined or zero ranges are excluded."
  },
  "dependencies": ["close"],
  "parameters": {"range_window": 60, "range_min_periods": 42, "dispersion_return_window": 20, "dispersion_rank_window": 60, "dispersion_min_periods": 30, "signal_lag": 1, "forward_horizon": 10, "minimum_cross_section": 8},
