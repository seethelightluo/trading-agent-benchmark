{
  "factor_id": "downside_skew_reversal_10d",
  "factor_name": "Downside-Skew Loss Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-rolling_sum(negative_part(daily_return), 10) / rolling_std(negative_part(daily_return), 30)",
    "description": "Ranks assets higher when their recent downside losses are large relative to their downside volatility; the one-session lag makes the signal tradable without look-ahead. The empirically supported direction is the raw reversal expression (negative recent downside loss divided by downside volatility)."
  },
  "dependencies": ["close"],
  "parameters": {"loss_window": 10, "downside_vol_window": 30, "minimum_downside_vol_observations": 15, "signal_lag_sessions": 1, "forward_horizon_sessions": 10},
