{
  "factor_id": "volscaled_reversal_20d",
  "factor_name": "Volatility-scaled 20-day reversal",
  "version": "1.0",
  "calculation": {
    "expression": "(-pct_change(close,20) / (rolling_std(pct_change(close,1),60) * sqrt(252))).shift(1)",
    "description": "Ranks assets higher when their lagged 20-trading-day return is more negative after scaling by trailing 60-day annualized realized volatility. The one-day lag prevents use of the current completed day's close in the decision signal."
  },
  "dependencies": ["close"],
  "parameters": {"reversal_window_days": 20, "volatility_window_days": 60, "vol_min_observations": 40, "forward_horizon_days": 10, "signal_lag_days": 1},
  "validation": {
