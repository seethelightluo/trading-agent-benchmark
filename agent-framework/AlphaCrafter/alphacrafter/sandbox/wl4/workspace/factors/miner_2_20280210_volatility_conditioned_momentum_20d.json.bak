{
  "factor_id": "miner_2_volatility_conditioned_momentum_20d",
  "factor_name": "Volatility-Conditioned 20-Day Momentum",
  "version": "20280210",
  "calculation": {
    "expression": "(close/lag(close,20)-1) / (std(pct_change(close),20)*sqrt(252)+epsilon) * (1 if close/lag(close,60)-1 >= 0 else 0.5)",
    "description": "Ranks recent momentum by realized volatility and softly attenuates momentum when the slower 60-day trend is negative. The signal uses only completed-day prices and is evaluated cross-sectionally.",
    "signal_artifact": "At each date t, compute 20-day return divided by annualized 20-day close-return volatility, multiplied by 1 for nonnegative 60-day return and 0.5 otherwise; use the cross-sectional rank as the signal. Forward return is close[t+10]/close[t]-1."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "momentum_days": 20,
    "volatility_days": 20,
    "trend_days": 60,
    "annualization": 252,
    "negative_trend_multiplier": 0.5,
    "validation_horizon_days": 10,
    "minimum_cross_section": 8
  },
  "validation": {
    "period": {
      "start": "2020-01-01",
      "end": "2028-02-09"
