{
  "factor_id": "miner_1_20320708_volcompression_residual_reversal_30d",
  "factor_name": "Volatility-Compression Weighted Residual Reversal 30D",
  "version": "1.0",
  "calculation": {
    "expression": "-((ret_30 - mean_cross_section(ret_30)) / (std(ret_1,60)*sqrt(252))) * (1 + 0.5*clip(1 - std(ret_1,20)/std(ret_1,60), -2, 2)), shifted_lag_1",
    "description": "Ranks assets for 10-day forward returns by volatility-scaled 30-day residual return reversal, with a moderate boost when short-term volatility is compressed relative to its 60-day volatility. All inputs are lagged one completed session before use."
  },
  "dependencies": ["close"],
  "parameters": {
    "residual_return_window": 30,
    "short_volatility_window": 20,
    "long_volatility_window": 60,
    "annualization": 252,
    "compression_multiplier": 0.5,
    "compression_clip": [-2, 2],
    "signal_lag_sessions": 1,
    "forward_horizon_sessions": 10,
    "minimum_cross_section": 8
  },
  "signal_provenance": {
    "artifact_script": "scripts/miner_1_20320708_volcompression_residual_reversal_30d.py",
    "universe": ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"],
    "signal_definition": "f = (-residual_30d/(vol60*sqrt(252))) * (1+0.5*clip(1-vol20/vol60,-2,2)); f=f.shift(1)",
    "no_future_data": true
  },
  "validation": {
