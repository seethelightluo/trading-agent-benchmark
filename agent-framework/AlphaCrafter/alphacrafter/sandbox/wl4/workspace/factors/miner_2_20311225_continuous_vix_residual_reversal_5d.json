{
  "factor_id": "miner_2_20311225_continuous_vix_residual_reversal_5d",
  "factor_name": "Continuous VIX-scaled cross-asset residual reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-rolling_mean_3(r_10d - cross_sectional_median(r_10d)).shift(1) * (1 + 0.75 * trailing_rank_252(VIX))",
    "description": "Reverse each tradable asset's 10-session return residual versus the daily cross-sectional median, smooth over three observations, and scale continuously by the lagged trailing 252-session percentile rank of observation-only VIX. Signal is shifted one observation before forward-return testing."
  },
  "dependencies": [
    "close",
    "VIX observation-only macro series"
  ],
  "parameters": {
    "return_window": 10,
    "smoothing_window": 3,
