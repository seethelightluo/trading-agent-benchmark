{
  "factor_id": "miner_3_20350118_smoothed_dispersion_range_reversal_60d_smooth10",
  "factor_name": "10-session smoothed dispersion-conditioned 60-day range reversal",
  "version": "1.0",
  "calculation": {
    "expression": "shift(-((close-rolling_min(close,60,min_periods=42))/(rolling_max(close,60,min_periods=42)-rolling_min(close,60,min_periods=42)))*(0.5+rolling_mean(rank60(cross_asset_std(pct_change(close,20))),10,min_periods=5)),1)",
    "description": "A lagged contrarian range-location signal. The negative 60-day range location is scaled by 0.5 plus a 10-session moving average of the trailing 60-session percentile rank of cross-asset 20-day return dispersion. Higher values indicate stronger expected reversal; all inputs are lagged one completed session for trading."
  },
  "dependencies": ["close"],
  "parameters": {"range_window": 60, "range_min_periods": 42, "dispersion_return_window": 20, "dispersion_rank_window": 60, "dispersion_smoothing_window": 10, "dispersion_smoothing_min_periods": 5, "forward_horizon": 10, "signal_lag": 1, "minimum_cross_section": 8},
  "validation": {
    "status": "EFFECTIVE",
    "period": {"start": "2020-03-06", "end": "2035-01-03"},
    "metrics": {"ic": 0.040907, "icir": 0.127129, "hit_ratio": 0.5574, "dates": 2544, "average_instruments": 11.05, "coverage": 0.5785, "rank_turnover": 0.0933, "decay_horizon": 10, "max_abs_library_correlation": null},
    "regime_notes": "Validated across 2,544 cross-sectional dates and all 15 tradable benchmark instruments. Full-history admission passes the benchmark gates, while the latest 520-observation ICIR is weak; use conservatively and monitor timeliness.",
    "signal_artifact": "scripts/artifacts/miner_3_20350118_dispersion_range_reversal_60d_smooth10_signal.csv",
    "ic_artifact": "scripts/artifacts/miner_3_20350118_dispersion_range_reversal_60d_smooth10_ic.csv"
  },
