{
  "factor_id": "miner_1_20351025_macro_conditioned_compression_10d",
  "factor_name": "VIX-Conditioned Own-Volatility Compression 10D",
  "version": "1.1",
  "calculation": {
    "expression": "-(rolling_std(pct_change(close),10)/rolling_std(pct_change(close),60)) * (1 + 0.5*clip((VIX - rolling_median(VIX,60))/rolling_median(VIX,60),-1,1)) shifted 1 day",
    "description": "Ranks the 15 tradable benchmark instruments by lagged own-volatility compression relative to 60-day volatility, amplified when VIX is elevated relative to its 60-day median. VIX is observation-only and never traded."
  },
  "dependencies": ["close", "VIX.close"],
  "parameters": {"short_volatility_window": 10, "long_volatility_window": 60, "vix_window": 60, "vix_condition_multiplier": 0.5, "vix_clip": [-1, 1], "forward_horizon": 10, "lag": 1, "minimum_cross_section": 8},
  "validation": {
