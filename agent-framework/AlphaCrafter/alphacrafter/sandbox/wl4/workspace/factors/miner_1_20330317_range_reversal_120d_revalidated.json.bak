{
  "factor_id": "range_reversal_120d_10d",
  "factor_name": "120-day range-position reversal",
  "version": "2033-03-17-revalidation",
  "calculation": {
    "expression": "1 - (close - rolling_min(close,120).shift(1)) / (rolling_max(close,120).shift(1) - rolling_min(close,120).shift(1))",
    "description": "Ranks assets toward the lower end of their lagged 120-day price range, interpreting depressed range position as a cross-asset mean-reversion opportunity. The range extrema are lagged to avoid look-ahead."
  },
  "dependencies": ["close"],
  "parameters": {"lookback_days": 120, "forward_horizon_days": 10, "cross_section_minimum": 8},
  "validation": {
