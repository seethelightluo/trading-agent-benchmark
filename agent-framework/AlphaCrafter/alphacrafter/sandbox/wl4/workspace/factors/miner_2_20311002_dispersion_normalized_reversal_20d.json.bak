{
  "factor_id": "miner_2_20311002_dispersion_normalized_reversal_20d",
  "factor_name": "Dispersion-normalized residual reversal",
  "version": "2031-10-02",
  "calculation": {
    "expression": "-cross_sectional_residual(rolling_sum(return,10)) / rolling_std(return,30) / clip(cross_sectional_median(rolling_std(return,20)) / rolling_median(cross_sectional_median(rolling_std(return,20)),60), 0.5, 2.0), lagged_1",
    "description": "Ranks assets for reversal of their lagged 10-session return residual versus the daily cross-sectional median, scaled by asset 30-session volatility and normalized by the prevailing 20-session cross-asset dispersion relative to its trailing 60-session median. The signal is lagged one completed session to avoid look-ahead."
  },
  "dependencies": ["close"],
  "parameters": {"residual_window": 10, "dispersion_window": 20, "dispersion_baseline_window": 60, "asset_volatility_window": 30, "lag": 1, "min_periods": {"returns": 8, "dispersion": 12, "baseline": 30, "volatility": 20}, "dispersion_scale_clip": [0.5, 2.0], "forward_horizon": 20},
