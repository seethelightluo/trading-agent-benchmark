{
  "factor_id": "miner_2_20331013_drawdown_vol_reversal_20d",
  "factor_name": "Drawdown-volatility normalized 20-day reversal",
  "version": "1.0",
  "calculation": {
    "expression": "shift_1((-return_20d) * (-drawdown_60d) / volatility_30d)",
    "description": "Ranks assets higher when their lagged 20-day loss and drawdown from the 60-day high are large, scaled by 30-day realized volatility; intended as a contrarian rebound signal. Drawdown is clipped at zero and rolling windows require sufficient observations."
  },
  "dependencies": ["close"],
  "parameters": {
    "return_window": 20,
    "drawdown_peak_window": 60,
    "volatility_window": 30,
    "minimum_drawdown_peak_observations": 40,
    "minimum_volatility_observations": 20,
    "signal_lag_days": 1,
    "forward_validation_horizon_days": 20
  },
  "validation": {
