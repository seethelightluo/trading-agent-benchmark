{
  "factor_id": "miner_1_20351108_breadth_conditioned_trend_quality_10d",
  "factor_name": "Breadth-Conditioned Trend-Quality Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-((close/close.shift(20)-1) / (std(pct_change(close),20)*sqrt(252))) * (1 + 0.65*2*(breadth20-0.5)), lagged 1 day",
    "description": "Contrarian 20-day risk-adjusted trend signal. The reversal strength is conditioned by the contemporaneous fraction of tradable assets with positive 20-day returns; all inputs are lagged one day before use.",
    "breadth20": "cross-sectional fraction of the 15 tradable assets whose 20-day return is positive",
    "direction": "higher values predict higher forward returns"
  },
  "dependencies": ["close", "pct_change"],
  "parameters": {"trend_window": 20, "vol_window": 20, "breadth_window": 20, "breadth_scale": 0.65, "lag_days": 1, "holding_horizon_days": 10},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-02-04/2035-11-07",
    "last_validated": "2035-11-08T00:00:00Z",
    "metrics": {
