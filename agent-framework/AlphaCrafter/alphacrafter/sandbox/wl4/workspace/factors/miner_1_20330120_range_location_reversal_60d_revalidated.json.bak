{
  "factor_id": "miner_1_20330120_range_location_reversal_60d_revalidated",
  "factor_name": "60-Day Range-Location Reversal (Revalidated)",
  "version": "20330120",
  "calculation": {
    "expression": "0.5 - (close - rolling_min(close,60)) / (rolling_max(close,60) - rolling_min(close,60) + epsilon), shifted by one completed session",
    "description": "Cross-sectional reversal signal favoring instruments near the lower end of their trailing 60-session price range; lagged one session to prevent look-ahead."
  },
  "dependencies": ["close"],
  "parameters": {"window": 60, "shift": 1, "epsilon": 1e-12, "forward_horizon": 10},
