{
  "factor_id": "volatility_gated_range_reversal_10d",
  "factor_name": "Volatility-Gated 120-Day Range Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "(1 - (lag1_close - rolling_min(lag1_close,120)) / (rolling_max(lag1_close,120) - rolling_min(lag1_close,120))) * clip(lag1_20d_volatility / cross_sectional_median(lag1_20d_volatility), 0.5, 2.0)",
    "description": "Ranks assets near the lower end of their lagged 120-day price range more highly, with a continuous multiplier that emphasizes assets whose lagged 20-day volatility is above the cross-sectional median. All price extrema, volatility, and regime inputs are lagged to prevent look-ahead.",
    "horizon": "10 trading days"
  },
  "dependencies": ["close"],
  "parameters": {
    "range_window": 120,
    "volatility_window": 20,
    "volatility_min_periods": 10,
    "multiplier_clip": [0.5, 2.0],
    "minimum_cross_section": 8,
    "universe_size": 15
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-02 through 2033-03-31",
    "last_validated": "2033-03-31",
    "metrics": {
      "horizon_days": 10,
      "ic": 0.035465,
