{
  "factor_id": "miner_3_20350412_dispersion_range_reversal_240d",
  "factor_name": "Dispersion-conditioned 240-day range reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-((close - rolling_min(close,240,min_periods=168))/(rolling_max(close,240,min_periods=168)-rolling_min(close,240,min_periods=168))) * (0.5 + rolling_mean(normalize_rolling((cross_sectional_std(pct_change(close,20)),60),5),5)).shift(1)",
    "description": "Negative trailing range position, amplified by smoothed normalized cross-asset 20-session return dispersion. The complete signal is lagged one session; higher values indicate stronger reversal preference."
  },
  "dependencies": ["close"],
  "parameters": {"range_window": 240, "range_min_periods": 168, "dispersion_return_window": 20, "dispersion_normalization_window": 60, "dispersion_smoothing_window": 5, "forward_horizon": 10, "signal_lag": 1, "minimum_cross_section": 8},
