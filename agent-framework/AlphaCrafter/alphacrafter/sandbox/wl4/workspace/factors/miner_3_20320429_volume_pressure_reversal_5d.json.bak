{
  "factor_id": "miner_3_20320429_volume_pressure_reversal_5d",
  "factor_name": "Volume-Weighted Intraday Pressure Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-rolling_sum_5((log(close/open) * volume / rolling_median(volume,20))) / (rolling_std_20(log(close/open)) * sqrt(5))",
    "description": "Contrarian score that buys assets with recent negative signed intraday pressure, with each intraday move weighted by relative volume and normalized by recent intraday volatility. Uses only completed daily bars."
  },
  "dependencies": ["open", "close", "volume"],
  "parameters": {"pressure_window_days": 5, "volume_median_window_days": 20, "volatility_window_days": 20, "forward_horizon_days": 10},
