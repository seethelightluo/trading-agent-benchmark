{
  "factor_id": "miner_3_20330120_drawdown_adjusted_reversal_10d",
  "factor_name": "Drawdown-adjusted medium-term residual reversal",
  "version": "1.0",
  "calculation": {
    "expression": "(-return_60d / (realized_vol_60d_sqrt60 * (1 + 2 * abs(close / rolling_max(close,120) - 1))) * (0.5 + positive_return_fraction_60d)).shift(1)",
    "description": "Contrarian 60-session return, scaled by 60-session realized volatility, penalized for peak-to-trough drawdown, and modestly adjusted by positive-return consistency. The complete signal is lagged one session to avoid look-ahead bias. Cross-sectional ranking is performed across the available 15 tradable benchmark instruments."
  },
  "dependencies": [
    "close",
    "daily_returns"
  ],
  "parameters": {
    "return_window": 60,
    "volatility_window": 60,
    "volatility_annualization_sqrt": 60,
    "drawdown_peak_window": 120,
    "drawdown_penalty": 2.0,
    "consistency_window": 60,
    "minimum_vol_observations": 40,
    "minimum_peak_observations": 80,
    "lag_sessions": 1,
    "admission_horizon_sessions": 10
  },
