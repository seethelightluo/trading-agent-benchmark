{
  "factor_id": "miner_2_20350104_dispersion_range_reversal_90d",
  "factor_name": "Dispersion-Gated 90-Day Range Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-((close - rolling_min(close,90)) / (rolling_max(close,90)-rolling_min(close,90))) * (0.5 + rolling_mean((cross_sectional_std(pct_change(close,20))-rolling_min(cross_sectional_std(pct_change(close,20)),60))/(rolling_max(cross_sectional_std(pct_change(close,20)),60)-rolling_min(cross_sectional_std(pct_change(close,20)),60)),5))",
    "description": "Ranks assets favoring those near the bottom of their 90-day range, with reversal strength increased when cross-asset 20-day return dispersion is elevated. Signal is lagged one completed day to prevent look-ahead."
  },
  "dependencies": ["close"],
  "parameters": {"range_window": 90, "dispersion_return_window": 20, "dispersion_normalization_window": 60, "dispersion_smoothing_window": 5, "forward_horizon": 10, "minimum_cross_section": 8},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-05-19/2034-12-20",
    "timestamp": "2035-01-04T00:00:00Z",
    "metrics": {
      "ic": 0.053694,
      "icir": 0.166915,
      "ic_hit_ratio": 0.5738,
      "qualifying_dates": 2398,
      "average_instruments": 11.01,
      "universe_size": 15,
      "coverage": 0.5407,
      "rank_turnover": 0.0768,
      "max_abs_library_correlation": null,
      "decay": {"horizon": 10, "note": "Validated at the 10-trading-day forward horizon; multi-horizon decay not run in this cycle."}
    },
    "regime_notes": "Full-history IC and ICIR clear benchmark gates, but recent 120/260/520 qualifying-date windows are weak or negative/near-zero (ICIR -0.0409/0.0315/0.0277); 780-date ICIR remains positive at 0.1245. Treat as a conservative, regime-sensitive complement rather than a standalone signal."
  },
  "signal_artifact": "scripts/artifacts/miner_2_20350104_dispersion_range_reversal_90d_signal.csv",
  "ic_artifact": "scripts/artifacts/miner_2_20350104_dispersion_range_reversal_90d_ic.csv",
  "tags": ["reversal", "range", "dispersion", "cross-asset", "regime-conditioned"]
}