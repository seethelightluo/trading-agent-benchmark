  "factor_id": "range_position_reversal_60d",
  "factor_name": "Volatility-scaled 60-day range-position reversal",
  "version": "1.0",
  "calculation": {
    "expression": "(0.5 - lagged_range_position_60d) / max(lagged_realized_volatility_30d_annualized, 0.05)",
    "description": "Using data through the prior completed session, measure each asset's close location within its trailing 60-session high-low range and favor assets below the midpoint. Scale the reversal score by inverse 30-session annualized realized volatility with a 5% floor. Cross-sectional ranking is applied only to valid values."
