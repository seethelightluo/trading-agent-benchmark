{
  "factor_id": "miner_2_20340105_volscaled_reversal_90d",
  "factor_name": "90-day volatility-scaled reversal",
  "version": "1.0",
  "calculation": {
    "expression": "(-pct_change(close, 90) / (rolling_std(pct_change(close), 45) * sqrt(252))).shift(1)",
    "description": "Ranks assets favoring contrarian exposure to negative 90-trading-day returns after adjustment by 45-day annualized realized volatility. The one-session lag ensures only completed data are used."
  },
  "dependencies": ["close"],
  "parameters": {
    "return_window": 90,
    "volatility_window": 45,
    "volatility_min_periods": 25,
    "forward_horizon": 10,
    "lag_sessions": 1,
    "universe": "15 tradable benchmark instruments"
  },
