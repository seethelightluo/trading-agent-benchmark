{
  "factor_id": "miner_3_20340720_range_position_reversal_60d",
  "factor_name": "60-day range-position reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-((close - rolling_min(close,60)) / (rolling_max(close,60) - rolling_min(close,60))) shifted by 1 completed session",
    "description": "Ranks assets nearer the bottom of their trailing 60-day price range more positively, using a one-session lag and a 10-trading-day forward return horizon. Undefined or zero-range observations are omitted."
  },
  "dependencies": ["close"],
  "parameters": {"lookback_days": 60, "signal_lag_days": 1, "forward_horizon_days": 10, "min_periods": 40},
