  "factor_name": "Range-Efficiency Trend Reversal",
  "version": "20291227.v1",
  "calculation": {
    "expression": "-[(sum(log_return,10) / sum(abs(log_return),10)) / (rolling_std(log_return,20) * sqrt(1))]",
    "description": "Contrarian score: reverse the lagged ten-day directional efficiency, scaled by trailing 20-day volatility. Signals are shifted one completed day to prevent look-ahead. Higher values favor assets whose persistent recent move is expected to mean-revert over the next 10 trading days."
