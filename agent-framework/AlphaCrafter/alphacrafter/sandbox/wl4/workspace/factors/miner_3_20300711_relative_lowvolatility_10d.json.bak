{
  "factor_id": "relative_lowvolatility_10d",
  "factor_name": "Cross-Asset Relative Low-Volatility Preference",
  "version": "20300711",
  "calculation": {
    "expression": "-log((std20(r_i) / median_j(std20(r_j))).clip(lower=1e-8)) shifted by 1 session",
    "description": "Prefer instruments whose trailing 20-session realized volatility is below the cross-sectional median, using a logarithmic relative-volatility transformation. The signal is lagged one completed session to prevent look-ahead bias."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "volatility_window": 20,
    "vol_min_periods": 15,
    "cross_section_center": "median",
    "transform": "negative_log_relative_volatility",
    "lag_sessions": 1,
    "minimum_cross_section": 8
  },
