{
  "factor_id": "miner_2_20300905_long_breadth_momentum_10d",
  "factor_name": "Long-horizon breadth-conditioned momentum",
  "version": "1.0",
  "calculation": {
    "expression": "pct_change(close,60) * (2 * breadth20_{t-1} - 1), then lag one day",
    "description": "For each tradable asset, multiply its 60-trading-day return by twice the lagged fraction of the 15 tradable assets with positive 20-day returns minus one. The complete signal is shifted one completed trading day to prevent look-ahead. Positive breadth preserves or amplifies momentum; weak breadth reverses its sign."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "momentum_window_days": 60,
    "breadth_window_days": 20,
    "breadth_universe_size": 15,
    "signal_lag_days": 1,
    "forward_horizon_days": 10
  },
