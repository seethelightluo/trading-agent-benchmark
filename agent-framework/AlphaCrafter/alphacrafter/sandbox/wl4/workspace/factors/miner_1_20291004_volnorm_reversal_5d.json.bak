  "factor_name": "Volatility-Normalized Short-Horizon Reversal",
  "version": "20291004",
  "calculation": {
    "expression": "rolling_mean_3(-return_5d / (sqrt(20)*std(return_1d,20)), min_periods=2).shift(1)",
    "description": "Ranks instruments positively when their prior five-day return was weak after scaling by recent 20-day realized volatility; the lag ensures only completed data are used. Higher values indicate stronger expected 10-day reversal returns."
  },
