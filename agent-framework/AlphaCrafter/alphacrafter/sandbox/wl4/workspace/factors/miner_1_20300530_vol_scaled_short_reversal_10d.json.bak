  "factor_name": "Volatility-Scaled Five-Day Short Reversal",
  "version": "20300530.v1",
  "calculation": {
    "expression": "shift(-rolling_sum(pct_change(close),5)/(rolling_std(pct_change(close),20)+1e-12),1)",
