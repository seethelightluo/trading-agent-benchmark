{
  "factor_id": "miner_2_20280727_dispersion_residual_reversal_5d",
  "factor_name": "Dispersion-Conditioned Volatility-Scaled Residual Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "rolling_mean_3(-((ret_5 - cross_sectional_median(ret_5)) / (volatility_20 * sqrt(5))) * clip(dispersion_20 / rolling_median(dispersion_20,120),0.5,2.0)).shift(1)",
    "description": "For each tradable asset, reverse its five-day return relative to the same-day cross-sectional median, normalize by 20-day daily volatility, amplify or attenuate according to the 20-day rolling average cross-sectional dispersion relative to its 120-day median, smooth over three observations, and lag one day to prevent look-ahead. Higher values predict higher subsequent returns."
  },
  "dependencies": [
    "close",
    "daily_returns"
  ],
  "parameters": {
    "return_window": 5,
    "volatility_window": 20,
    "dispersion_window": 20,
    "dispersion_baseline_window": 120,
    "smoothing_window": 3,
    "dispersion_clip": [
      0.5,
      2.0
    ],
    "lag": 1
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2028-07-26",
