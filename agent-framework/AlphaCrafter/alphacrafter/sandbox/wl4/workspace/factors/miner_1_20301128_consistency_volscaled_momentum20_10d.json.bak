{
  "factor_id": "miner_1_consistency_volscaled_momentum20_10d",
  "factor_name": "Consistency-Weighted Volatility-Scaled 20-Day Momentum",
  "version": "1.0",
  "calculation": {
    "expression": "rank_cs(((close/close.shift(20)-1)/(std(pct_change(close),20)*sqrt(20)))*(0.5+0.5*(mean(pct_change(close)>0,20)-0.5)*2))",
    "description": "Rank assets by volatility-scaled 20-session momentum weighted by the fraction of positive daily returns in the same window; lag the signal one completed session to avoid look-ahead bias."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "momentum_window": 20,
    "volatility_window": 20,
    "consistency_window": 20,
    "forward_horizon": 10,
    "minimum_cross_section": 8,
    "signal_lag": 1
  },
