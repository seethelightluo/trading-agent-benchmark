{
  "factor_id": "miner_1_20350510_risk_adjusted_momentum_reversal_60d",
  "factor_name": "60-day volatility-normalized momentum reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-sum(pct_change(close), 60) / std(pct_change(close), 40)",
    "description": "Cross-asset contrarian score: negate the trailing 60-session cumulative return and scale it by trailing 40-session daily return volatility. The signal is lagged one completed session before forward-return testing or portfolio use. Higher values favor assets with weaker risk-adjusted recent performance."
  },
  "dependencies": ["close"],
  "parameters": {"return_window": 60, "volatility_window": 40, "min_return_observations": 45, "min_volatility_observations": 30, "signal_lag": 1, "forward_horizon_days": 10},
