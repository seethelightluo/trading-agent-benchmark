{
  "factor_id": "range_reversal_120d_10d",
  "factor_name": "120-day range-location contrarian reversal (10d)",
  "version": "1.0",
  "calculation": {
    "expression": "(0.5 - (close - rolling_min(close,120)) / (rolling_max(close,120)-rolling_min(close,120))) shifted 1 session",
    "description": "Ranks assets nearer their 120-session lows more positively and assets nearer highs more negatively, using only the prior completed session."
  },
  "dependencies": ["close"],
  "parameters": {"range_window": 120, "min_periods": 80, "lag_sessions": 1, "forward_horizon": 10},
  "validation": {
