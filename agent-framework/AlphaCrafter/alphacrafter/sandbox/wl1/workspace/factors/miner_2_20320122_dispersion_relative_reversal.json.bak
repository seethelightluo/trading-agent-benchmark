{
  "factor_id": "miner_2_20320122_dispersion_relative_reversal",
  "factor_name": "Cross-Asset Dispersion-Conditioned Relative Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "I(dispersion_5d_lagged > rolling_median(dispersion_5d_lagged,120)) * (-(asset_log_return_5d_lagged - cross_section_median_log_return_5d_lagged)) / (asset_volatility_30d_lagged * sqrt(5) + epsilon)",
    "description": "When cross-asset five-day return dispersion is above its trailing 120-observation median, rank assets by volatility-scaled reversal relative to the contemporaneous cross-sectional median. The complete signal is lagged one trading day before use; inactive dates are zero rather than missing."
  },
  "dependencies": ["close"],
  "parameters": {
    "return_window": 5,
    "volatility_window": 30,
    "dispersion_window": 120,
    "dispersion_statistic": "median absolute deviation from cross-sectional median",
    "activation_threshold": "trailing 120-observation median",
    "epsilon": 1e-12,
    "lag_days": 1
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2026-01-01 through 2032-01-07 (available valid observations; earlier dates had insufficient non-constant active signals)",
    "metrics": {
      "horizon_days": 10,
      "ic": 0.029197,
      "icir": 0.113529,
      "hit_ratio": 0.5369,
      "dates": 704,
      "average_instruments": 15.0,
      "coverage": 1.0,
      "turnover": null,
      "decay_ic_1d": 0.016998,
      "decay_ic_5d": 0.015040,
      "decay_ic_10d": 0.029197,
      "decay_ic_20d": 0.033467,
      "max_abs_library_correlation": null
    },
    "regime_notes": "10-day IC/ICIR: 2026-2028 0.007587/0.028174; 2029-2030 0.039282/0.155854; 2031-2032-01-07 0.062638/0.269255. Strong recent improvement, but early available regime is below the ICIR gate; uncertainty is material in the 15-asset cross-section.",
    "signal_artifact": "scripts/miner_2_20320122_dispersion_relative_reversal_signal.csv"
  },
  "tags": ["cross_asset", "relative_reversal", "dispersion", "volatility_scaled", "conditional"] ,
