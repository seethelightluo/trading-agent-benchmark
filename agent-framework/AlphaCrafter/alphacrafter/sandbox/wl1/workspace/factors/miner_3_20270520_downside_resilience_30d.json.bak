{
  "factor_id": "miner_3_20270520_downside_resilience_30d",
  "factor_name": "Downside-Resilience Risk-Adjusted Momentum 30d",
  "version": "1.0",
  "calculation": {
    "expression": "lag1(rolling_sum(pct_change(close),30) / (sqrt(rolling_mean(min(pct_change(close),0)^2,30)) + 1e-8) * (1 - rolling_mean(1[pct_change(close)<0],30)))",
    "description": "Thirty-session cumulative return adjusted for downside deviation and the frequency of negative sessions, with all inputs lagged one completed session. Higher values indicate positive momentum achieved with fewer and smaller down moves.",
    "lookahead_control": "Signal is shifted one session; forward returns are measured from the factor-date close to h sessions later.",
    "signal_artifact": "scripts/miner_3_20270520_downside_resilience.py"
  },
  "dependencies": ["close"],
  "parameters": {
    "return_window": 30,
    "downside_deviation_window": 30,
    "negative_frequency_window": 30,
    "lag_sessions": 1,
    "minimum_observations": 20,
    "epsilon": 1e-8
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": {"start": "2020-01-01", "end": "2027-05-20"},
