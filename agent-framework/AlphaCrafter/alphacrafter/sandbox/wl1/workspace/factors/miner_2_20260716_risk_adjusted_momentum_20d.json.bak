{
  "factor_id": "miner_2_risk_adjusted_momentum_20d",
  "factor_name": "20-Day Risk-Adjusted Momentum",
  "version": "20260716",
  "calculation": {
    "expression": "(close / lag(close,20) - 1) / (std(daily_returns,60) * sqrt(20))",
    "description": "Twenty-session return scaled by trailing 60-session realized volatility; higher values indicate stronger risk-adjusted trend."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "momentum_days": 20,
    "volatility_days": 60,
    "minimum_cross_section": 8
  },
