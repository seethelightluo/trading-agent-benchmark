{
  "factor_id": "tail_resilient_momentum_30d",
  "factor_name": "Tail-Resilient Momentum",
  "version": "20290208",
  "calculation": {
    "expression": "(close/close.shift(30)-1) / (1 + 4*downside_volatility_60d + (1-close/rolling_max(close,60)))",
    "description": "Thirty-day momentum penalized by annualized downside volatility and current drawdown from the 60-day high; signal is lagged one completed day to avoid look-ahead."
  },
  "dependencies": ["close", "pct_change"],
  "parameters": {"momentum_window": 30, "risk_window": 60, "downside_vol_multiplier": 4, "min_downside_observations": 40, "lag_days": 1},
  "validation": {
