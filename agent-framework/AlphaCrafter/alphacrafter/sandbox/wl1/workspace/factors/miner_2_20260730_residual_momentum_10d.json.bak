{
  "factor_id": "miner_2_20260730_residual_momentum_10d",
  "factor_name": "Cross-Asset-Beta-Neutral 20-Day Residual Momentum",
  "version": "1.0",
  "calculation": {
    "expression": "(close_t / close_{t-20} - 1) - beta_i,t * (product_{k=t-20}^{t-1}(1 + median_j(return_j,k)) - 1)",
    "description": "For each tradable instrument, subtract its rolling 20-session beta to the cross-sectional median return multiplied by the corresponding 20-session benchmark return from its raw 20-session momentum. Beta is estimated using the prior 20 daily returns, preventing use of the forward target. Higher values indicate idiosyncratic residual strength. Portfolio use should rank cross-sectionally and apply only at the 10-session horizon."
  },
  "dependencies": [
    "close",
    "daily_returns"
  ],
  "parameters": {
    "lookback_sessions": 20,
    "market_proxy": "daily cross-sectional median across the 15 tradable watchlist instruments",
    "beta_window": 20,
    "forward_horizon_sessions": 10,
    "minimum_cross_section": 8
  },
