{
  "factor_id": "xs_acceleration_risk_40d",
  "factor_name": "Cross-Sectional Trend Acceleration Risk-Scaled",
  "version": "20290531",
  "calculation": {
    "expression": "((pct_change(close,20) - pct_change(close,60)/3) - cross_sectional_mean) / (rolling_std(daily_returns,40)+0.005) * (0.5 + abs(cross_sectional_breadth_20d-0.5))",
    "description": "Ranks assets by lagged 20-day trend acceleration relative to a 60-day baseline, residualized against the cross-sectional mean and scaled by 40-day realized volatility. A bounded participation confirmation multiplier reduces dependence on broad market direction. All inputs are shifted one completed session before use."
  },
  "dependencies": ["close", "daily_returns"],
  "parameters": {"short_window": 20, "long_window": 60, "vol_window": 40, "vol_floor": 0.005, "breadth_window": 20, "minimum_cross_section": 8, "lag_sessions": 1},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2029-05-30",
    "last_validated": "2029-05-31T00:00:00Z",
    "metrics": {
