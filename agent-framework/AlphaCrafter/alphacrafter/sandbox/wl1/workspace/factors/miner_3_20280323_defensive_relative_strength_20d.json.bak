{
  "factor_id": "miner_3_20280323_defensive_relative_strength_20d",
  "factor_name": "Defensive Relative Strength Risk-Adjusted 20D",
  "version": "1.0",
  "calculation": {
    "expression": "lag1((return_20d(asset) - mean(return_20d(equity_benchmarks))) / annualized_volatility_20d(asset))",
    "description": "Ranks tradable assets by 20-session return relative to the equal-weight mean return of eight equity benchmarks, scaled by each asset's 20-session realized volatility. The one-session lag prevents look-ahead bias."
  },
  "dependencies": ["close", "returns", "equity benchmark subset"],
  "parameters": {
    "lookback_sessions": 20,
    "volatility_window": 20,
    "annualization": 252,
    "equity_benchmarks": ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX"],
    "lag_sessions": 1,
    "minimum_cross_section": 8
  },
