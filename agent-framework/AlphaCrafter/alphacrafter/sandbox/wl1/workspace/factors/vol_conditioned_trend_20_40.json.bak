{
  "factor_id": "vol_conditioned_trend_20_40",
  "factor_name": "Volatility-Conditioned 20-Day Trend",
  "version": "2028-12-28",
  "calculation": {
    "expression": "shift((close/close_20d_ago - 1) / (1 + 2*annualized_total_vol_40d + 2*annualized_downside_vol_40d), 1)",
    "description": "Twenty-day price trend penalized by total and downside realized volatility; shifted one completed day to prevent look-ahead. Higher values indicate persistent returns achieved with lower realized risk."
  },
  "dependencies": ["close", "daily_returns"],
  "parameters": {"trend_window": 20, "volatility_window": 40, "volatility_min_periods": 25, "annualization": 252, "total_vol_multiplier": 2, "downside_vol_multiplier": 2, "lag_days": 1},
