{
  "factor_id": "miner_2_20280810_downside_adjusted_breadth_trend_30d",
  "factor_name": "Downside-Adjusted Breadth Trend 30D",
  "version": "1.0",
  "calculation": {
    "expression": "(close/close.shift(30)-1) / (sqrt(30)*rolling_std(min(pct_change(close),0),30)) * (0.5 + 0.5*rolling_mean(pct_change(close)>0,30))",
    "description": "Thirty-day return scaled by downside deviation, multiplied by a positive-day breadth quality multiplier. The complete signal is lagged one session before forward-return testing to prevent look-ahead bias. Higher values indicate efficient, persistent upside with comparatively contained downside variation."
  },
  "dependencies": [
    "close",
    "pct_change"
  ],
  "parameters": {
    "lookback_days": 30,
