{
  "factor_id": "miner_2_20271230_consistency_weighted_trend_20d",
  "factor_name": "Consistency-Weighted Volatility-Adjusted 20-Day Trend",
  "version": "1.0",
  "calculation": {
    "expression": "shift1((close/close[-20]-1)/(rolling_std(pct_change(close),40)*sqrt(20)+0.004) * (abs(mean(I[pct_change(close)>0],20)-0.5)+0.5))",
    "description": "One-session-lagged 20-day momentum divided by 40-day volatility, multiplied by a bounded directional-consistency term based on the fraction of positive daily returns over 20 sessions. Uses only completed data."
  },
  "dependencies": ["close"],
  "parameters": {"return_window": 20, "volatility_window": 40, "min_vol_observations": 25, "consistency_window": 20, "min_consistency_observations": 15, "stabilizer": 0.004, "lag": 1},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2027-12-29",
    "validation_timestamp": "2027-12-30",
    "metrics": {
      "admission_horizon_days": 20,
      "ic": 0.045265,
      "icir": 0.138734,
      "hit_ratio": 0.5377,
      "valid_dates": 2721,
      "average_instruments": 15.0,
      "coverage": 0.9999,
      "coverage_dates": 2741,
      "rank_turnover": 0.08207,
      "decay_ic_5d": 0.013574,
      "decay_ic_10d": 0.032316,
      "decay_ic_20d": 0.045265,
      "max_abs_library_correlation": null
    },
    "regime_notes": "Full-sample admission gates pass (absolute IC >= 0.0070 and absolute ICIR >= 0.0840), but 2026+ and 2027 20-day IC were negative (-0.014112 and -0.030066); use conservative or regime-conditioned ensemble weight. Cross-section is the complete 15-instrument tradable universe.",
    "signal_artifact": "scripts/miner_2_20271230_consistency_weighted_trend_signal.csv"
  },
  "tags": ["momentum", "trend", "volatility_adjusted", "consistency", "cross_asset"],
