  "factor_id": "miner_2_20260730_momentum_acceleration_10d",
  "factor_name": "Momentum Acceleration",
  "version": "1.0",
  "calculation": {
    "expression": "sum(return,10) - 0.5*sum(return[t-10:t-30],20)",
    "description": "Recent 10-session cumulative return minus half the preceding 20-session cumulative return. Higher values indicate stronger recent acceleration; the validated relationship to the next 10-session return is negative, so portfolio consumers should apply the validated contrarian orientation explicitly.",
    "implementation": "rolling_sum(pct_change(close),10) - 0.5*rolling_sum(pct_change(close).shift(10),20)"
  },
  "dependencies": [
    "close"
  ],
