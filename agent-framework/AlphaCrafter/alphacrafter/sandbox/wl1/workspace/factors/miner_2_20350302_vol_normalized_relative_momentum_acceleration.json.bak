{
  "factor_id": "vol_normalized_relative_momentum_acceleration_20_60",
  "factor_name": "Volatility-Normalized Relative Momentum Acceleration",
  "version": "1.0",
  "calculation": {
    "expression": "((sum(log_return,20) - sum(log_return,60)/3) / rolling_std(log_return,20)) shifted by 1 completed day",
    "description": "Ranks assets by acceleration of 20-day momentum relative to 60-day momentum, normalized by recent daily volatility. Positive values indicate improving medium-term trend on a risk-adjusted basis. The one-day lag prevents look-ahead."
  },
  "dependencies": ["close"],
  "parameters": {"short_window": 20, "long_window": 60, "vol_window": 20, "validation_horizon_days": 20, "lag_days": 1},
  "validation": {
