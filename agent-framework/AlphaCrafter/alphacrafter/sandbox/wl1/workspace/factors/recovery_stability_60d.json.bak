{
  "factor_id": "recovery_stability_60d",
  "factor_name": "Recovery Location with Breadth and Downside Stability",
  "version": "1.0",
  "calculation": {
    "expression": "((close-min(close,60))/(max(close,60)-min(close,60)+epsilon)) * (2*mean(I(return>0,30))-0.5) / (1+sqrt(mean(min(return,0)^2,30))*sqrt(252)), shifted 1 day",
    "description": "Ranks assets higher when they occupy a strong location in their 60-day range, have persistent positive-return breadth over 30 days, and exhibit lower downside variability. The complete signal is shifted by one completed session to prevent look-ahead."
  },
  "dependencies": ["close", "daily returns"],
  "parameters": {"range_window": 60, "range_min_periods": 45, "breadth_window": 30, "breadth_min_periods": 24, "downside_window": 30, "epsilon": 1e-8, "lag_sessions": 1},
  "validation": {
    "status": "EFFECTIVE",
    "period": {"start": "2020-01-01", "end": "2029-02-07"},
    "metrics": {
      "horizon_days": 20,
      "ic": 0.040681,
      "icir": 0.127088,
      "hit_ratio": 0.5468,
      "valid_dates": 2992,
      "average_instruments": 15.0,
      "coverage": 0.9999,
      "turnover": 0.07194,
      "max_abs_library_correlation": null,
      "decay": {"5d_ic": 0.022435, "10d_ic": 0.031502, "20d_ic": 0.040681}
    },
    "regime_notes": "2020-2025 IC/ICIR 0.065548/0.209665 (2146 dates); 2026+ -0.022397/-0.067831 (846); 2027+ 0.023592/0.077005 (529); 2028+ 0.131063/0.516079 (268). Strong full sample and 2028 result, but weak 2026-plus aggregate and small cross-section require conservative interpretation.",
    "signal_artifact": "scripts/miner_3_20290208_recovery_stability_signal.csv"
  },
  "tags": ["momentum", "recovery", "breadth", "downside-risk", "cross-asset"],
