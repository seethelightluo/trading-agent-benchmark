{
  "factor_id": "residual_beta_neutral_momentum_30d",
  "factor_name": "Beta-Neutral Residual Momentum 30d",
  "version": "2029-01-25",
  "calculation": {
    "expression": "rolling_sum_30(r_i - beta_i,60 * equal_weight_market_return) / (1 + annualized_std_40(r_i - beta_i * market_return))",
    "description": "For each tradable asset, estimate a rolling 60-day beta to the equal-weight 15-asset benchmark, accumulate 30 days of beta-neutral residual returns, and divide by residual volatility. Signal is lagged one completed day to prevent look-ahead."
  },
  "dependencies": ["close"],
  "parameters": {"beta_window": 60, "beta_min_periods": 40, "momentum_window": 30, "volatility_window": 40, "vol_min_periods": 25, "annualization": 252, "market_proxy": "equal_weight_mean_daily_returns", "lag_days": 1},
