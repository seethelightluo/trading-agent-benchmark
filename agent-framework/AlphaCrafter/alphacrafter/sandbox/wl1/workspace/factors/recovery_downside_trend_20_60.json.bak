{
  "factor_id": "recovery_downside_trend_20_60",
  "factor_name": "Recovery-Adjusted Downside Trend",
  "version": "1.0",
  "calculation": {
    "expression": "(close/close_lag20 - 1) / (annualized_std(clip(pct_change, upper=0),20)+eps) * exp(-3*(1-close/rolling_max(close,60)))",
    "description": "Ranks 20-day return by downside volatility and penalizes drawdown from the 60-day high. Signal is lagged one completed day to prevent look-ahead."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "trend_window": 20,
    "downside_vol_window": 20,
    "drawdown_window": 60,
    "drawdown_penalty": 3.0,
    "annualization": 252,
    "lag": 1,
    "epsilon": 1e-08
  },
