{
  "factor_id": "miner_2_20320624_dispersion_gated_residual_pullback_10d",
  "factor_name": "Dispersion-Gated Volatility-Normalized Residual Pullback",
  "version": "1.0",
  "calculation": {
    "expression": "where(cross_sectional_residual_dispersion > rolling_quantile(dispersion,120,0.60), -rolling_sum(residual_log_return,10)/rolling_mean(asset_volatility_20,20), NaN), lagged 1 day",
    "description": "Ranks assets by a volatility-normalized ten-day residual pullback, activated only on elevated cross-asset dispersion. Residual return is asset log return minus equal-weight universe log return. The one-day lag prevents look-ahead."
  },
  "dependencies": ["close"],
  "parameters": {"residual_window": 10, "volatility_window": 20, "volatility_average_window": 20, "dispersion_window": 120, "dispersion_quantile": 0.60, "forward_horizon": 10, "minimum_assets": 8, "signal_lag": 1},
  "validation": {
