{
  "factor_id": "miner_2_20310320_path_efficiency_30d",
  "factor_name": "Lagged 30-day Path-Efficiency Trend",
  "version": "20310320.v1",
  "calculation": {
    "expression": "(close/close.shift(30)-1) / rolling_sum(abs(daily_return),30), shifted 1 day",
    "description": "Net intermediate return divided by total absolute daily path; lagged one completed session to prevent look-ahead."
  },
