{
  "factor_id": "miner_1_20350202_short_reversal_volscaled_3d",
  "factor_name": "Volatility-scaled 3-day short-term reversal",
  "version": "1.0",
  "calculation": {
    "expression": "cross_sectional_demean(-(sum(pct_change(close),3) / rolling_std(pct_change(close),20))).shift(1)",
    "description": "Ranks assets favoring recent 3-day losers after scaling by 20-day realized volatility; the one-day lag prevents lookahead."
  },
  "dependencies": ["close"],
  "parameters": {"lookback_return_days": 3, "volatility_days": 20, "signal_lag_days": 1, "minimum_volatility_observations": 15},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-02 through 2035-02-02",
    "metrics": {
      "horizon_days": 20,
      "ic": 0.02366,
      "icir": 0.08542,
      "ic_hit_ratio": 0.5264,
      "dates": 2439,
      "average_instruments": 14.37,
      "coverage": 0.9583,
      "turnover": 0.16543,
      "decay_ic": {"5": 0.01035, "10": 0.01208, "20": 0.02366, "40": 0.01696},
      "max_abs_library_correlation": null
    },
    "regime_notes": "10-day IC was positive in 2025-2029 (0.02067) and 2030-2035 (0.00714); early 2020-2024 had insufficient valid observations for the reported 10-day subperiod due to the source series alignment. The 20-day full-sample gate passes, but the small cross-asset universe warrants conservative monitoring.",
    "signal_artifact": "scripts/miner_1_20350202_short_reversal_signal.csv"
  },
