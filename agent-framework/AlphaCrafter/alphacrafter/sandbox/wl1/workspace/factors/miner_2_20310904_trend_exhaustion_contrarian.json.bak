  "factor_name": "Trend Exhaustion Contrarian (20d horizon)",
  "version": "2031-09-04",
  "calculation": {
    "expression": "-shift1(((0.55*sum(log_return,60)+0.45*sum(log_return,120))/rolling_std(log_return,60)) - 0.40*abs(sum(log_return,20)-sum(log_return,60)/3)/rolling_std(log_return,60))",
    "description": "Cross-asset contrarian score that fades persistent, volatility-normalized medium/long trends and adds a penalty for short-term divergence from the 60-day trend. Signal is shifted one completed session to avoid look-ahead; higher values predict stronger subsequent 20-day returns in the validation sample."
  },
  "dependencies": ["close"],
  "parameters": {"medium_window": 20, "long_window": 60, "extended_window": 120, "vol_window": 60, "medium_weight": 0.55, "extended_weight": 0.45, "divergence_penalty": 0.40, "lag_days": 1, "horizon_days": 20},
