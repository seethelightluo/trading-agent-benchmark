{
  "factor_id": "miner_3_20260827_momentum_acceleration_20d_20d",
  "factor_name": "Volatility-Scaled Momentum Acceleration",
  "version": "1.0",
  "calculation": {
    "expression": "((close_t/close_{t-20}-1) - 0.5*(close_{t-20}/close_{t-60}-1)) / (std(pct_change(close),20)+0.02)",
    "description": "Measures recent 20-session momentum relative to half the preceding 40-session momentum, scaled by recent realized volatility and a stabilizer. All inputs end no later than the decision date. Higher values indicate strengthening medium-term trends."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "recent_window": 20,
    "prior_window": 40,
    "prior_weight": 0.5,
    "volatility_window": 20,
    "stabilizer": 0.02,
    "forward_horizon": 20
  },
