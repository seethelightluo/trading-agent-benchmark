{
  "factor_id": "miner_1_20260730_vix_state_reversal_5d",
  "factor_name": "VIX-State Conditional Five-Day Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(close_t / close_{t-5} - 1) * I(VIX_t > rolling_median(VIX,60))",
    "description": "Ranks assets by negative trailing five-day return only when the observation-only VIX level is above its trailing 60-day median; otherwise the signal is zero. VIX and prices are lagged/completed-bar data at decision time.",
    "signal_artifact": "scripts/miner_2_20260730_vix_state_reversal_validate.py"
  },
  "dependencies": [
    "close",
    "VIX.close"
  ],
  "parameters": {
    "return_window": 5,
    "vix_median_window": 60,
    "regime": "VIX above trailing median",
    "forward_horizon_days": 1
  },
