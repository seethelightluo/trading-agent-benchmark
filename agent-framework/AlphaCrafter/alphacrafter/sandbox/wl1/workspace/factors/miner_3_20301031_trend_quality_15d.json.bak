{
  "factor_id": "miner_3_20301031_trend_quality_15d",
  "factor_name": "Risk-Adjusted Trend Persistence Quality",
  "version": "1.0",
  "calculation": {
    "expression": "(close/close.shift(15)-1) / (std(daily_return,30)*sqrt(30)+epsilon) * (0.5 + 0.5*(2*mean(I(daily_return>0),15)-1)), lagged 1 session",
    "description": "Ranks the 15 tradable cross-asset instruments by medium-horizon return scaled by recent realized risk and continuously rewarded for persistence of positive daily returns. All inputs are shifted one completed session before forward-return testing to prevent look-ahead."
  },
  "dependencies": ["close", "daily returns"],
  "parameters": {
    "trend_window_days": 15,
    "volatility_window_days": 30,
    "persistence_window_days": 15,
    "volatility_annualization_factor": 30,
    "epsilon": 1e-08,
    "lag_days": 1,
    "minimum_cross_section": 8
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": {"start": "2020-01-01", "end": "2030-10-30", "cutoff": "2030-10-31"},
    "as_of": "2030-10-31",
    "metrics": {
      "admission_horizon_days": 20,
      "ic": 0.037870,
      "icir": 0.118541,
      "ic_hit_ratio": 0.5404,
      "valid_dates": 3466,
      "average_instruments": 14.9986,
      "factor_coverage": 0.9937,
      "turnover": 0.078662,
      "decay_ic_1d": -0.005614,
      "decay_ic_5d": 0.003383,
      "decay_ic_10d": 0.014396,
      "decay_ic_20d": 0.037870,
      "max_abs_library_correlation": null
    },
    "regime_notes": "Strong positive 20-day predictive IC over the full 2020-2030 sample, with sign reversals in 2023-24 and 2027-29 and positive recovery in 2030; uncertainty is interpreted conservatively given the 15-asset cross-section. The 20-day horizon passes the benchmark-wide IC and ICIR gates; shorter horizons do not.",
    "signal_artifact": "scripts/miner_3_20301031_trend_quality_signal.csv",
