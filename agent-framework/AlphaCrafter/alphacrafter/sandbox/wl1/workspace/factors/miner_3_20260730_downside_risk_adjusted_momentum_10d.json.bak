{
  "factor_id": "miner_3_20260730_downside_risk_adjusted_momentum_10d",
  "factor_name": "Downside-Risk-Adjusted Momentum",
  "version": "1.0",
  "calculation": {
    "expression": "(close_t / close_{t-20} - 1) / sqrt(mean(min(pct_change_{t-19:t},0)^2))",
    "description": "Twenty-session price momentum divided by the trailing downside deviation, rewarding persistent trends while penalizing assets with frequent or large negative daily shocks. Computed using completed observations only; higher values predict higher forward 10-session returns."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "lookback_sessions": 20,
    "downside_window_sessions": 20,
    "forward_horizon_sessions": 10,
    "minimum_cross_section": 8
  },
