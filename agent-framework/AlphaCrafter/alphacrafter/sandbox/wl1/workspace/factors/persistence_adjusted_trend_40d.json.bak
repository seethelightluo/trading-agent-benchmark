{
  "factor_id": "persistence_adjusted_trend_40d",
  "factor_name": "Persistence-Adjusted Volatility-Scaled Trend",
  "version": "1.0",
  "calculation": {
    "expression": "((close/close.shift(40)-1)/(std(pct_change,40)*sqrt(252)))*mean(pct_change>0,20), lagged 1 day",
    "description": "Ranks assets by their 40-day volatility-scaled return, weighted by the trailing fraction of positive daily returns. Inputs are lagged one completed session before forecast formation; higher values predict higher 40-day forward return in the full-history validation."
  },
  "dependencies": ["close"],
  "parameters": {"trend_window": 40, "volatility_window": 40, "persistence_window": 20, "signal_lag": 1, "admission_horizon_days": 40},
