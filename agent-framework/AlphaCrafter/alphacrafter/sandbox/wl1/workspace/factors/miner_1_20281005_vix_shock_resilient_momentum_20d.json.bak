{
  "factor_id": "miner_1_20281005_vix_shock_resilient_momentum_20d",
  "factor_name": "VIX-Shock-Resilient Volatility-Scaled Momentum",
  "version": "1.0",
  "calculation": {
    "expression": "momentum_20d/(realized_vol_20d*sqrt(20)) - 0.35*rolling_beta(asset_return, VIX_5d_return,60d)*rolling_mean(VIX_5d_return,5d)",
    "description": "Ranks assets by lagged 20-session momentum adjusted for realized volatility, then penalizes positive exposure to recent VIX shocks. The complete signal is shifted one session so only completed observations are used."
  },
  "dependencies": [
    "close",
    "VIX"
  ],
  "parameters": {
    "momentum_window": 20,
    "realized_volatility_window": 20,
    "vix_return_window": 5,
    "beta_window": 60,
    "beta_min_observations": 40,
    "vix_mean_window": 5,
    "shock_penalty": 0.35,
    "lag_sessions": 1
  },
