{
  "factor_id": "miner_3_20280810_residual_momentum_20d_beta60",
  "factor_name": "Benchmark-Residual Volatility-Normalized Momentum",
  "version": "1.0",
  "calculation": {
    "expression": "rolling_sum_20(r_i - beta_i,60 * mean_cross_section(r), 20) / (sqrt(20) * rolling_std_20(r_i - beta_i,60 * mean_cross_section(r)))",
    "description": "For each tradable instrument, estimate a rolling 60-session beta to the equal-weight mean return of all 15 tradable instruments. Compute 20-session cumulative residual return and divide by annualization-free 20-session residual volatility; lag the signal one completed session to prevent look-ahead."
  },
  "dependencies": [
    "close",
    "daily_returns"
  ],
  "parameters": {
    "benchmark": "equal_weight_mean_of_15_tradable_assets",
    "beta_window": 60,
    "signal_window": 20,
    "volatility_window": 20,
    "minimum_beta_observations": 40,
    "minimum_volatility_observations": 15,
    "lag_sessions": 1
  },
