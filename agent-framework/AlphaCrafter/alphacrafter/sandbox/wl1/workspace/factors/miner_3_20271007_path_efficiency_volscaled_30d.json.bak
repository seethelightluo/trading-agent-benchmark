{
  "factor_id": "miner_3_20271007_path_efficiency_volscaled_30d",
  "factor_name": "Volatility-Scaled Path-Efficiency Momentum",
  "version": "2027-10-07",
  "calculation": {
    "expression": "(pct_change(close,30) / (rolling_sum(abs(pct_change(close,1)),30)+0.01)) / (rolling_std(pct_change(close,1),30)+0.003), shifted by 1 session",
    "description": "Ranks assets by directional 30-session return relative to their total absolute price path, then scales by inverse realized volatility. The path-efficiency term rewards persistent trends over choppy moves; one-session lag prevents look-ahead."
  },
  "dependencies": ["close"],
  "parameters": {"directional_window": 30, "path_window": 30, "volatility_window": 30, "path_floor": 0.01, "volatility_floor": 0.003, "lag_sessions": 1},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-02 through 2027-10-06",
    "validation_timestamp": "2027-10-07T00:00:00Z",
    "metrics": {
