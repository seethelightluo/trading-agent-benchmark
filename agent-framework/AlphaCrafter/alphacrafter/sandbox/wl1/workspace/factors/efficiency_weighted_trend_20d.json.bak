{
  "factor_id": "efficiency_weighted_trend_20d",
  "factor_name": "Efficiency-Weighted Volatility-Scaled 20-Day Trend",
  "version": "20280210",
  "calculation": {
    "expression": "lag1((sum_20(return) / (sqrt(20)*std_40(return)+0.004)) * abs(sum_20(return))/sum_20(abs(return)))",
    "description": "Twenty-session cumulative return scaled by 40-session realized volatility and path efficiency, lagged one session to prevent look-ahead."
  },
  "dependencies": ["close"],
  "parameters": {"return_window": 20, "volatility_window": 40, "minimum_return_observations": 15, "minimum_volatility_observations": 30, "volatility_floor": 0.004, "lag": 1},
