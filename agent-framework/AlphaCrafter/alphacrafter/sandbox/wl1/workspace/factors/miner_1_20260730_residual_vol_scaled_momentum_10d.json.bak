{
  "factor_id": "miner_1_20260730_residual_vol_scaled_momentum_10d",
  "factor_name": "Volatility-Scaled Cross-Asset Residual Momentum",
  "version": "1.0",
  "calculation": {
    "expression": "((close_t/close_{t-20}-1) - beta_i*(prod(1+median_cross_sectional_return_{t-19:t})-1)) / std(residual_returns_{t-19:t})",
    "description": "For each tradable asset, remove its rolling 20-session beta exposure to the cross-sectional median return from its 20-session momentum, then divide by rolling residual-return volatility. Higher values indicate stronger, volatility-normalized idiosyncratic persistence. Signals use data through t and predict t+10; online use must lag to the previous completed session."
  },
  "dependencies": [
    "close",
    "daily_returns"
  ],
  "parameters": {
    "lookback_sessions": 20,
    "holding_horizon_sessions": 10,
    "cross_section": "median_return_all_15_tradable_assets",
    "minimum_valid_instruments": 8
  },
