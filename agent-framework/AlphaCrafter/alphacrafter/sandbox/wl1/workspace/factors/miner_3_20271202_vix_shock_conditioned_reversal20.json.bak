{
  "factor_id": "miner_3_20271202_vix_shock_conditioned_reversal20",
  "factor_name": "VIX-Shock-Conditioned 20-Day Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "(-sum_{20d}(asset_return)) * (1 + 0.75 * percentile_rank_252(abs(VIX_return_5d)))", 
    "description": "Ranks cross-asset 20-session reversal, amplified when the absolute five-session VIX move is unusually large. The complete signal is shifted one session to prevent look-ahead. VIX is observation-only and no orders are placed for it."
  },
  "dependencies": ["close", "VIX.close"],
  "parameters": {"return_window": 20, "vix_change_window": 5, "vix_percentile_window": 252, "vix_min_periods": 80, "amplification": 0.75, "signal_lag": 1, "universe_size": 15},
