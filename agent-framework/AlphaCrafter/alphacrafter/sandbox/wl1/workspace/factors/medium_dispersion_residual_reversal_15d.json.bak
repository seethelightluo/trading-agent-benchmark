{
  "factor_id": "medium_dispersion_residual_reversal_15d",
  "factor_name": "Medium-horizon dispersion-gated residual reversal",
  "version": "2033-05-13",
  "calculation": {
    "expression": "shift(-1, -rolling_sum(log_return - cross_sectional_mean(log_return),15) / rolling_std(residual_return,60) * I[dispersion > rolling_quantile(dispersion,120,0.65)])",
    "description": "Ranks assets for contrarian exposure after elevated cross-asset dispersion. Fifteen-session residual moves are volatility-normalized by 60-session residual volatility; the activation condition and one-session lag avoid look-ahead and suppress low-dispersion noise."
  },
  "dependencies": ["close"],
  "parameters": {"residual_window": 15, "volatility_window": 60, "dispersion_window": 120, "dispersion_quantile": 0.65, "forecast_horizon": 10, "lag": 1},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 to 2033-05-12",
    "metrics": {"daily_paper_ic": 0.039510, "daily_paper_icir": 0.139387, "ic_hit_ratio": 0.5665, "coverage": 1.0, "average_instruments": 15.0, "valid_dates": 639, "rank_turnover": 0.1272, "decay_ic_5d": 0.025415, "decay_ic_10d": 0.039510, "decay_ic_20d": 0.046637, "max_abs_library_correlation": null},
    "regime_notes": "Strong in 2024-2029, near zero in 2030-2032, positive in the latest 2032-2033 segment; use capped ensemble weight and monitor drift. Small 15-asset cross-section implies conservative uncertainty interpretation.",
    "signal_artifact": "scripts/miner_2_20330513_medium_dispersion_reversal_signal.csv",
    "validation_script": "scripts/miner_2_20330513_medium_dispersion_reversal.py"
