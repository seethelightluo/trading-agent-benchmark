{
  "factor_id": "miner_3_20270812_downside_persistence_40d",
  "factor_name": "Downside-Persistence Stabilization Breadth",
  "version": "1.0",
  "calculation": {
    "expression": "lag1((rolling_mean_40(I[r>0]) - rolling_mean_40(I[r<0])) / (rolling_std_40(r) + 0.005))",
    "description": "Ranks assets by the balance of positive versus negative return days over 40 sessions, normalized by realized volatility. The one-day lag ensures only completed data are used."
  },
  "dependencies": ["close", "daily_returns"],
  "parameters": {"window_days": 40, "min_periods": 25, "lag_days": 1, "volatility_floor": 0.005},
