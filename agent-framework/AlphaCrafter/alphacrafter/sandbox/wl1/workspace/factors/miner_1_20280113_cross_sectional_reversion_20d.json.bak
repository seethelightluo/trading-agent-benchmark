{
  "factor_id": "miner_1_20280113_cross_sectional_reversion_20d",
  "factor_name": "Cross-sectional five-day reversal",
  "version": "20280113",
  "calculation": {
    "expression": "-(sum(pct_change,5)-cross_section_mean(sum(pct_change,5)))",
    "description": "Ranks assets positively when their trailing five-session return is below the contemporaneous 15-asset cross-sectional mean; signal is observed at the decision date and evaluated with forward 20-session returns.",
    "lag": 1
  },
  "dependencies": ["close", "pct_change", "watchlist"],
  "parameters": {"lookback_sessions": 5, "horizon_sessions": 20, "min_valid_instruments": 8},
