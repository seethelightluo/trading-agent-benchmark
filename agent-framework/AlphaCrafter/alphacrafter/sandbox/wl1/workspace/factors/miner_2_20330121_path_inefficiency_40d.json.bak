  "factor_name": "Cross-sectional residual path inefficiency reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-rolling_sum(residual_log_return,40) / rolling_sum(abs(residual_log_return),40), lagged one day",
    "description": "For each tradable asset, subtract the daily cross-asset mean log return, measure 40-day net residual displacement relative to its absolute residual path length, and reverse the sign. This favors noisy/inefficient prior paths for 10-trading-day mean reversion."
