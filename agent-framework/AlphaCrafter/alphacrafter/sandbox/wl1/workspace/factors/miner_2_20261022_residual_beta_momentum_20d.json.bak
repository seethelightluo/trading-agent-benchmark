{
  "factor_id": "miner_2_20261022_residual_beta_momentum_20d",
  "factor_name": "Beta-Neutralized Medium-Term Momentum",
  "version": "1.0",
  "calculation": {
    "expression": "(close/close.shift(20)-1) - rolling_beta_60(asset_daily_return, median_cross_asset_daily_return).shift(1) * (median_close/median_close.shift(20)-1)",
    "description": "Measures each asset's 20-session return after removing its lagged 60-session beta exposure to the cross-asset median market move. The one-session lag on beta and signal makes the forward-return test lookahead safe."
  },
  "dependencies": [
    "close",
    "pct_change"
  ],
  "parameters": {
    "momentum_lookback_days": 20,
    "beta_lookback_days": 60,
    "beta_min_periods": 30,
    "market_proxy": "daily cross-sectional median return",
    "signal_lag_days": 1,
    "forward_horizon_admission": 10,
    "universe_size": 15,
    "cutoff_date": "2026-07-15"
  },
