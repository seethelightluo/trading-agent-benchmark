{
  "factor_id": "miner_2_20351012_volume_confirmed_acceleration_20_60",
  "factor_name": "Volume-Confirmed Relative Momentum Acceleration",
  "version": "1.0",
  "calculation": {
    "expression": "lag1(((r20-CS_median(r20))-(r60-CS_median(r60))) * clip(SMA(volume,20)/SMA(volume,60),0.5,2.5))",
    "description": "Cross-sectional relative 20-day versus 60-day momentum acceleration, amplified or attenuated by the causal 20/60-day volume ratio. The full signal is lagged one trading day to prevent look-ahead. Missing or non-positive volume defaults to a neutral multiplier of 1."
  },
  "dependencies": ["close", "volume"],
  "parameters": {"short_return_days": 20, "long_return_days": 60, "short_volume_window": 20, "long_volume_window": 60, "volume_clip": [0.5, 2.5], "signal_lag_days": 1, "forward_validation_horizon_days": 10, "minimum_cross_section": 8},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 to 2035-10-12",
    "validated_at": "2035-10-12",
