{
  "factor_id": "miner_1_20271118_downside_relative_strength_20d",
  "factor_name": "Downside-Volatility Relative Strength 20d",
  "version": "1.0",
  "calculation": {
    "expression": "lag1((close/close.shift(20)-1)/(sqrt(mean(min(pct_change(close),0)^2 over 40d))+0.005))",
    "description": "Ranks assets by 20-trading-day return scaled by 40-day downside volatility. The one-session lag ensures only completed-day information is used. Higher values indicate stronger medium-term relative strength per unit of downside risk."
  },
  "dependencies": ["close"],
  "parameters": {"return_window": 20, "downside_vol_window": 40, "stabilizer": 0.005, "lag_sessions": 1, "admission_horizon_days": 20},
