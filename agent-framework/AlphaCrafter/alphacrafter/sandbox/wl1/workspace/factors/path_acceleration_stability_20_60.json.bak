{
  "factor_id": "path_acceleration_stability_20_60",
  "factor_name": "Path-Stability-Weighted Trend Acceleration",
  "version": "1.0",
  "calculation": {
    "expression": "((log(close/close[-20]) - log(close/close[-60])/3) / (rolling_std(pct_change(close),30)*sqrt(30)+1e-6)) * (0.5 + abs(sum(pct_change(close),30))/(sum(abs(pct_change(close),30))+1e-12))",
    "description": "Measures acceleration of the 20-day trend relative to the one-third 60-day trend, scales by 30-day realized volatility, and rewards stable directional paths. The signal is lagged one completed day before use."
  },
  "dependencies": ["close", "pct_change"],
  "parameters": {"short_window": 20, "long_window": 60, "volatility_window": 30, "path_window": 30, "long_divisor": 3, "signal_lag_days": 1, "forward_horizon_days": 10},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2034-03-03",
    "last_validated": "2034-03-03T00:00:00Z",
    "metrics": {
      "ic": 0.02998937,
      "icir": 0.09887968,
      "ic_horizon_days": 10,
      "daily_paper_ic": 0.02998937,
      "daily_paper_icir": 0.09887968,
      "dates": 4307,
      "average_instruments": 14.99884,
      "universe_size": 15,
      "coverage": 0.98580,
      "turnover": 0.08839,
      "hit_rate": 0.54098,
      "max_abs_library_correlation": null
    },
    "regime_notes": "Positive IC/ICIR in 2020-2026 and 2030-2032; negative recent 2033-2034 subperiod (IC -0.07354, ICIR -0.25822), so recency drift requires monitoring. Full-history admission passes absolute IC >= 0.0070 and absolute daily ICIR >= 0.0840, with conservative interpretation due to 15-asset cross-section.",
    "signal_artifact": "scripts/miner_3_20340303_path_acceleration_signal.csv"
  },
