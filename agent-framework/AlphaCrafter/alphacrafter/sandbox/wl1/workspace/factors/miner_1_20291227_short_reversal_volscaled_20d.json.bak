{
  "factor_id": "miner_1_20291227_short_reversal_volscaled_20d",
  "factor_name": "Short-Horizon Reversal Scaled by Volatility",
  "version": "1.0",
  "calculation": {
    "expression": "-(close/close.shift(5)-1) / rolling_std(pct_change(close),20)",
    "description": "Ranks assets positively when their lagged five-session return is weak, with the reversal signal normalized by trailing 20-session volatility. Signal is shifted one completed session to avoid look-ahead.",
    "signal_shift": 1
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "reversal_window_days": 5,
    "volatility_window_days": 20,
    "forward_horizon_days": 20,
    "minimum_cross_section": 8
  },
