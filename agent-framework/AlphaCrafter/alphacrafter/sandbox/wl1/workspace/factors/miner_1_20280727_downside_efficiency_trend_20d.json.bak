{
  "factor_id": "miner_1_20280727_downside_efficiency_trend_20d",
  "factor_name": "Downside-Risk Adjusted Efficiency Trend",
  "version": "1.0",
  "calculation": {
    "expression": "shift_1((close_t/close_{t-20}-1) / (downside_std(daily_returns_{t-19:t})*sqrt(20)) * abs(close_t/close_{t-20}-1) / (sum(abs(daily_returns_{t-19:t}))+1e-8))",
    "description": "Ranks assets by lagged 20-session directional return adjusted for downside-only realized volatility and multiplied by path efficiency. The signal penalizes adverse volatility while rewarding persistent directional movement."
  },
  "dependencies": [
    "close",
    "daily_returns"
  ],
  "parameters": {
    "lookback_days": 20,
    "downside_volatility_window_days": 20,
    "minimum_volatility_observations": 10,
    "signal_lag_days": 1,
    "epsilon": 1e-08
  },
