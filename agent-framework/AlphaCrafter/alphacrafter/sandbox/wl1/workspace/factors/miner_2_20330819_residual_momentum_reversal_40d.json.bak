{
  "factor_id": "miner_2_20330819_residual_momentum_reversal_40d",
  "factor_name": "Risk-normalized 40-day residual momentum reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-rolling_sum_40(log_return - equal_weight_cross_sectional_log_return) / (rolling_std_60(residual_return) * sqrt(40))",
    "description": "For each tradable benchmark asset, calculate its 40-day cumulative return relative to the contemporaneous equal-weight benchmark, normalize by 60-day residual volatility, and reverse the signal cross-sectionally. The signal is shifted by one completed day before evaluation or use. Higher values favor assets with weaker recent residual performance, implementing medium-horizon residual reversal."
  },
  "dependencies": ["close"],
  "parameters": {"residual_window_days": 40, "risk_window_days": 60, "forward_horizon_days": 10, "lag_days": 1, "benchmark": "equal_weight_mean_log_return", "minimum_cross_section": 8},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2024-01-01 through 2033-08-18",
    "metrics": {
