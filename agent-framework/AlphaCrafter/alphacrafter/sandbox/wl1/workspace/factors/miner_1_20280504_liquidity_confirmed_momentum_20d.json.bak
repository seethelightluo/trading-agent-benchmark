{
  "factor_id": "miner_1_20280504_liquidity_confirmed_momentum_20d",
  "factor_name": "Liquidity-Confirmed 20-Day Momentum",
  "version": "1.0",
  "calculation": {
    "expression": "pct_change(close,20) * clip(rolling_mean(volume,5) / rolling_mean(volume,20), 0.25, 4.0)",
    "description": "A 20-trading-day price momentum signal amplified when recent five-day average activity is above its 20-day baseline and attenuated when activity is unusually weak. Signal is lagged one completed session before use."
  },
  "dependencies": ["close", "volume"],
  "parameters": {"momentum_window": 20, "activity_fast_window": 5, "activity_slow_window": 20, "activity_floor": 0.25, "activity_cap": 4.0, "signal_lag": 1, "forward_validation_horizon": 20},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2028-05-04 (available aligned sample)",
    "metrics": {
      "ic": 0.037004,
      "icir": 0.101644,
      "horizon_days": 20,
