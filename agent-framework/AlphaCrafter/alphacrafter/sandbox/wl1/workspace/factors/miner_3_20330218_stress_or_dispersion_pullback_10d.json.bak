{
  "factor_id": "miner_3_20330218_stress_or_dispersion_pullback_10d",
  "factor_name": "Stress-or-Dispersion Volatility-Normalized Residual Pullback",
  "version": "1.0",
  "calculation": {
    "expression": "shift(-rolling_sum(residual_return,10)/rolling_mean(rolling_std(residual_return,20),20),1) activated when lagged (benchmark_return_20d < 0 OR residual_dispersion_20d > rolling_median(residual_dispersion_20d,120))",
    "description": "Ranks assets by lagged ten-day residual pullback, normalized by residual volatility, only during benchmark stress or elevated cross-asset dispersion. Positive values indicate stronger expected residual recovery."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "pullback_window": 10,
    "volatility_window": 20,
    "volatility_baseline_window": 20,
    "dispersion_window": 20,
    "dispersion_reference_window": 120,
    "stress_window": 20,
    "forward_horizon": 10,
