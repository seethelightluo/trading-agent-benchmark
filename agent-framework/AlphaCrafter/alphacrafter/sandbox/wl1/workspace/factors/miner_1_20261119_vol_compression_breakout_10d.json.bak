{
  "factor_id": "miner_1_20261119_vol_compression_breakout_10d",
  "factor_name": "Volatility-Compression Breakout",
  "version": "1.0",
  "calculation": {
    "expression": "shift1((return_20d / volatility_60d) * clip(volatility_60d / volatility_20d, 0.5, 2.0))",
    "description": "Ranks assets by 20-day price momentum scaled by 60-day realized volatility and adjusted for the ratio of long-run to recent volatility. The one-day shift prevents lookahead; compression receives greater emphasis while the ratio is bounded for stability."
  },
  "dependencies": ["close", "daily_returns"],
  "parameters": {"momentum_window": 20, "recent_vol_window": 20, "baseline_vol_window": 60, "min_periods_recent": 15, "min_periods_baseline": 40, "compression_ratio_clip": [0.5, 2.0], "signal_lag_days": 1, "forward_horizon_days": 10},
