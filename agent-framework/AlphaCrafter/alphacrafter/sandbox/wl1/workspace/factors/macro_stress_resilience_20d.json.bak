{
  "factor_id": "macro_stress_resilience_20d",
  "factor_name": "VIX-Conditioned Relative Momentum Resilience",
  "version": "20290809",
  "calculation": {
    "expression": "shift1((r20 - median_cs(r20)) / (downside_vol20 + 0.02) * (1 + 0.35*clip((VIX-median60(VIX))/std60(VIX),-1,2)*tanh(5*(r20-median_cs(r20)))))",
    "description": "Cross-sectional 20-day relative momentum risk-scaled by trailing downside volatility, with a lagged VIX-stress interaction that amplifies resilient positive relative momentum and penalizes weak relative momentum during stress. All prices and VIX observations are lagged one completed day.",
    "signal_artifact": "scripts/miner_2_20290809_macro_stress_resilience_signal.csv"
  },
  "dependencies": [
    "close",
    "VIX"
  ],
  "parameters": {
    "momentum_window": 20,
    "downside_vol_window": 20,
    "vix_window": 60,
    "stress_clip": [
      -1,
      2
    ],
    "interaction_strength": 0.35,
    "epsilon": 0.02,
    "lag_days": 1
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": {
      "start": "2020-01-02",
      "end": "2029-08-08",
