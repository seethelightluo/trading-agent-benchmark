{
  "factor_id": "breadth_regime_switch_20d_trend",
  "factor_name": "Breadth-Regime-Switched 20-Day Cross-Asset Trend",
  "version": "2034-09-29",
  "calculation": {
    "expression": "lag1(20d_return * sign(rolling60d_mean(cross_sectional_positive_20d_breadth)-0.5))",
    "description": "Ranks 20-day asset returns as trend-following when the trailing 60-day fraction of assets with positive 20-day returns exceeds 50%, and reverses the ranking in weak-breadth regimes. All inputs are lagged one completed trading day."
  },
  "dependencies": ["close"],
  "parameters": {
    "return_window": 20,
    "breadth_window": 20,
    "regime_window": 60,
    "regime_threshold": 0.5,
    "signal_lag_days": 1,
    "minimum_cross_section": 8
  },
