{
  "factor_id": "miner_3_20310821_consistent_trend_quality_20d",
  "factor_name": "Consistent Trend Quality (Contrarian Risk-Adjusted)",
  "version": "1.0",
  "calculation": {
    "expression": "rank_cs(-((0.55*log_return_20d + 0.45*log_return_60d/3) / (downside_vol_40d + 0.5*volatility_40d)) * (1 + 0.35*alignment)) lagged_1d",
    "description": "Ranks the contrarian of a multi-horizon trend-quality score. Trend returns are scaled by downside and total volatility; aligned positive/negative horizons receive a 35% magnitude adjustment. Cross-sectional demeaning and one-day lag prevent common-market and look-ahead effects."
  },
  "dependencies": [
    "close",
    "daily_returns"
  ],
  "parameters": {
    "short_window": 20,
    "long_window": 60,
    "risk_window": 40,
    "short_weight": 0.55,
    "long_weight": 0.45,
    "alignment_boost": 0.35,
    "downside_vol_weight": 1.0,
    "total_vol_weight": 0.5,
    "lag_days": 1,
    "forward_horizon_days": 20
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2026-01-01 through 2031-08-20",
