{
  "factor_id": "directional_breadth_5_40",
  "factor_name": "Lagged Multi-Horizon Directional Breadth",
  "version": "1.0",
  "calculation": {
    "expression": "lag1(sum(w_h * I(mean_return_h > 0), h in {5,10,20,40}) - cross_sectional_mean(...))",
    "description": "For each tradable asset, weighted breadth of positive mean returns over 5, 10, 20 and 40 completed sessions, relative to the cross-asset mean; lagged one session to avoid look-ahead. Weights are 0.35, 0.30, 0.20 and 0.15."
  },
  "dependencies": ["close"],
  "parameters": {"horizons": [5, 10, 20, 40], "weights": [0.35, 0.30, 0.20, 0.15], "lag": 1, "min_cross_section": 8},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2029-08-08",
    "validation_timestamp": "2029-08-09",
    "metrics": {
      "horizon_days": 20,
      "ic": 0.029102,
      "daily_icir": 0.092358,
