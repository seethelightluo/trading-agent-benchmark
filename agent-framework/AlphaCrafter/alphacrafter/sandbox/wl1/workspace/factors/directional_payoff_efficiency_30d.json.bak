{
  "factor_id": "directional_payoff_efficiency_30d",
  "factor_name": "Directional Payoff Efficiency with Breadth Confirmation 30D",
  "version": "2028.08.24",
  "calculation": {
    "expression": "((close/close.shift(30)-1)/(rolling_mean(positive_returns,30)+rolling_mean(-negative_returns,30))) * (0.5+0.5*positive_mean/(positive_mean+negative_mean)) * (0.5+0.5*rolling_mean(return>0,30)); signal=expression.shift(1)",
    "description": "Scores medium-term return by directional payoff efficiency, rewarding larger typical up-day moves relative to down-day moves and confirming with positive-day breadth. The complete signal is lagged one session to prevent look-ahead."
  },
  "dependencies": [
    "close",
    "daily_returns"
  ],
  "parameters": {
    "lookback_days": 30,
    "min_periods": 20,
    "lag_days": 1,
    "positive_breadth_floor": 0.5
  },
