{
  "factor_id": "miner_2_highvol_amplified_reversal_3d",
  "factor_name": "High-Volatility Amplified Short Reversal",
  "version": "20260730_initial",
  "calculation": {
    "expression": "-(close/lag(close,3)-1) * clip(VIX / rolling_median(VIX,60), 0.5, 2.5)",
    "description": "A three-session contrarian return signal amplified when the observation-only VIX level is elevated relative to its trailing 60-session median. Positive values favor recent losers and negative values penalize recent winners. VIX is used only as a macro conditioning signal; no order is submitted for it.",
    "forward_horizon": "1 trading day"
  },
  "dependencies": [
    "close",
    "VIX close"
  ],
  "parameters": {
    "reversal_window": 3,
    "vix_median_window": 60,
    "vix_min_periods": 30,
    "amplification_floor": 0.5,
    "amplification_cap": 2.5,
    "min_cross_section": 8
  },
  "signal_provenance": {
    "artifact_type": "reproducible_script",
    "script": "scripts/miner_2_20260730_highvol_reversal.py",
    "universe": "15 tradable benchmark instruments",
    "macro_source": "../persistent/index_data/VIX.csv",
    "no_future_data": true,
    "date_alignment": "factor uses completed asset close and VIX observations through the same date; forward return begins next observed asset close",
    "observation_only_macro": true
  },
  "validation": {
