{
  "factor_id": "updown_vol_balance_30d",
  "factor_name": "Up-Down Volatility Balanced Trend",
  "version": "1.0",
  "calculation": {
    "expression": "shift1(rolling_sum(return,30) * (rolling_std(max(return,0),30)+0.002) / (rolling_std(max(-return,0),30)+0.002))",
    "description": "Ranks assets by lagged 30-session trend, rewarding upside volatility participation relative to downside volatility. All inputs are lagged one completed session to avoid look-ahead."
  },
  "dependencies": ["close"],
  "parameters": {"lookback_days": 30, "min_periods": 20, "stabilizer": 0.002, "lag_days": 1, "clip": [-20, 20]},
  "validation": {
