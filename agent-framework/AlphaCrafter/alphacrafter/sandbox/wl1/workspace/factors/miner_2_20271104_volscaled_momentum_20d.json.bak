  "factor_name": "Volatility-Scaled Twenty-Day Momentum",
  "version": "1.0",
  "calculation": {
    "expression": "lag1(pct_change(close,20) / (std(pct_change(close,1),40) * sqrt(20) + 0.004))",
    "description": "Prior completed-session 20-day price momentum divided by trailing 40-session realized volatility scaled to a 20-day horizon, with a stabilizing constant; one-session lag prevents look-ahead."
  },
  "dependencies": ["close"],
  "parameters": {"momentum_window": 20, "volatility_window": 40, "min_vol_observations": 25, "annualization_horizon": 20, "stabilizer": 0.004, "lag_sessions": 1},
