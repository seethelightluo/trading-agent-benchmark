{
  "factor_id": "miner_2_20280601_downside_adjusted_acceleration_20_60",
  "factor_name": "Downside-Adjusted Momentum Acceleration (20/60)",
  "version": "1.0",
  "calculation": {
    "expression": "(pct_change(close,20) - pct_change(close,60)/3) / (rolling_std(where(pct_change(close,1)<0,pct_change(close,1),0),20)+1e-6), lagged 1 session",
    "description": "Measures acceleration of medium-term momentum by comparing 20-day return with one-third of 60-day return, then normalizes by recent downside semideviation. The one-session lag prevents use of the current incomplete session."
  },
  "dependencies": ["close"],
  "parameters": {"short_window": 20, "long_window": 60, "downside_window": 20, "long_scaler": 3, "epsilon": 1e-6, "signal_lag": 1},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2028-05-31",
    "metrics": {
      "admission_horizon_days": 10,
      "ic": 0.043877,
      "icir": 0.134507,
      "hit_ratio": 0.5577,
      "valid_dates": 2806,
      "average_instruments": 15.0,
      "coverage": 0.9999,
      "rank_turnover": 0.090289,
      "max_abs_library_correlation": null,
      "decay": {"5d_ic": 0.016498, "10d_ic": 0.043877, "20d_ic": 0.06469}
    },
    "regime_notes": "Positive 10-day IC in 2024+, 2026+, 2027+, and 2028 YTD; recent 2028 IC is positive but lower than full-history. Cross-section is the full 15-instrument tradable universe; uncertainty is interpreted conservatively.",
    "signal_provenance": "scripts/miner_2_20280601_downside_adjusted_acceleration_20_60_signal.csv"
  },
  "tags": ["momentum", "acceleration", "downside-risk-adjusted", "cross-asset"],
  "last_validated": "2028-06-01T00:00:00"
}
