  "factor_name": "Volatility-Normalized 20-Day Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(sum_return_20d)/(sqrt(20)*std_daily_return_20d + 1e-8), shifted by 1 session",
    "description": "Ranks assets for medium-term reversal while scaling the negative 20-day return by trailing realized volatility; the one-session lag prevents use of the decision-day close. Higher values indicate stronger risk-adjusted oversold conditions."
