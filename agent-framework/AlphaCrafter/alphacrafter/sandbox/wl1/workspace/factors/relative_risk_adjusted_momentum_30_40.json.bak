{
  "factor_id": "relative_risk_adjusted_momentum_30_40",
  "factor_name": "Relative Risk-Adjusted Momentum",
  "version": "2029-01-11",
  "calculation": {
    "expression": "((close/close.shift(30)-1) - cross_sectional_median_15((close/close.shift(30)-1))) / (rolling_std(pct_change(close),40)*sqrt(252)+0.05), shifted_by_1_day",
    "description": "Ranks each tradable benchmark by its 30-day return relative to the same-day universe median, scaled by its 40-day annualized volatility. The one-day lag prevents look-ahead; the small volatility floor controls instability."
  },
  "dependencies": ["close"],
  "parameters": {"return_window": 30, "volatility_window": 40, "volatility_min_periods": 25, "annualization": 252, "volatility_floor": 0.05, "lag_days": 1, "clip": [-10, 10], "universe_size": 15},
  "validation": {
    "status": "EFFECTIVE",
    "period": {"start": "2020-01-01", "end": "2029-01-10"},
    "horizon_days": 20,
