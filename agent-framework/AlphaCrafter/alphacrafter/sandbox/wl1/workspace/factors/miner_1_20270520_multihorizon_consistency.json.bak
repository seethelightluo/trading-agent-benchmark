{
  "factor_id": "miner_1_20270520_multihorizon_consistency",
  "factor_name": "Multi-Horizon Volatility-Scaled Trend Consistency",
  "version": "1.0",
  "calculation": {
    "expression": "0.5 * (sum_return_20 / (sqrt(20)*std_return_20)) + 0.5 * (sum_return_60 / (sqrt(60)*std_return_60)), lagged one session",
    "description": "Average of 20-session and 60-session cumulative returns scaled by their realized volatility. The complete cross-sectional signal is shifted by one session to avoid look-ahead bias. Higher values indicate persistent positive trends across both horizons."
  },
  "dependencies": ["close"],
  "parameters": {"short_window": 20, "long_window": 60, "short_min_periods": 15, "long_min_periods": 40, "lag_sessions": 1, "universe_size": 15},
