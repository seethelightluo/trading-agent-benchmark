{
  "factor_id": "miner_2_20330527_trend_quality_relative_60d",
  "factor_name": "Relative Trend Quality with Consistency and Volatility Scaling",
  "version": "1.0",
  "calculation": {
    "expression": "(rolling_sum(relative_log_return,60) * (rolling_mean(relative_log_return > 0,60)-0.5)) / rolling_std(relative_log_return,60), lagged 1 session",
    "description": "Ranks assets by medium-term cross-asset relative return, rewarding consistent positive residual sessions and scaling by residual volatility. Relative returns are versus the equal-weight benchmark of the 15 tradable assets."
  },
  "dependencies": ["close"],
  "parameters": {"return_window": 60, "minimum_return_observations": 40, "consistency_window": 60, "volatility_window": 60, "minimum_volatility_observations": 40, "lag_sessions": 1, "forward_validation_horizon": 10},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2024-01-01 through 2033-05-26",
    "metrics": {"ic": 0.042624, "icir": 0.163311, "coverage": 0.9996, "turnover": 0.0815, "hit_ratio": 0.5617, "valid_dates": 1766, "average_instruments": 14.99, "decay_5d_ic": 0.027709, "decay_10d_ic": 0.042624, "decay_20d_ic": 0.061063, "max_abs_library_correlation": null},
    "regime_notes": "Positive across 2024-2026 (IC 0.043582), 2027-2029 (0.054285), and 2030-2032 (0.032191); weakened and inverted in 2032-2033 (IC -0.024961), so use capped exposure and monitor drift. Small cross-asset universe uncertainty is addressed through 1,766 dates and approximately 15 instruments per date.",
    "validation_script": "scripts/miner_2_20330527_trend_quality.py",
    "signal_artifact": "scripts/miner_2_20330527_trend_quality_signal.csv"
  },
