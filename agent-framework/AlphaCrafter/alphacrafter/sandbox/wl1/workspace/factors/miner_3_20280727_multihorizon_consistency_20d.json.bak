{
  "factor_id": "miner_3_20280727_multihorizon_consistency_20d",
  "factor_name": "Multi-Horizon Volatility-Normalized Trend Consistency",
  "version": "1.0",
  "calculation": {
    "expression": "mean_h(ret_h / (sqrt(h)*std_daily_20d)) * (0.5 + 0.5*rolling20_positive_day_fraction), h in {5,10,20}, lagged one session",
    "description": "Average 5-, 10-, and 20-session volatility-normalized returns, scaled by the fraction of positive daily returns over the prior 20 sessions. Rewards trends that agree across horizons and exhibit directional breadth."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "horizons": [
      5,
      10,
      20
    ],
    "volatility_window": "matching horizon",
    "breadth_window": 20,
    "minimum_volatility_observations": "max(5, horizon/2)",
    "lag_sessions": 1,
    "universe_size": 15
  },
