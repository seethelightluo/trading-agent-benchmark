{
  "factor_id": "dispersion_intensity_relative_acceleration_20_60",
  "factor_name": "Dispersion-Intensity Relative Momentum Acceleration",
  "version": "1.0",
  "calculation": {
    "expression": "(((return_20 - CS_median(return_20)) - (return_60 - CS_median(return_60))) * clip(CS_std(return_20) / rolling_median(CS_std(return_20),60),0.5,2.0)).shift(1)",
    "description": "Cross-sectional relative momentum acceleration is amplified when cross-sectional 20-day return dispersion is high versus its trailing 60-day median. The one-day lag prevents use of information unavailable at decision time."
  },
  "dependencies": ["close"],
  "parameters": {
    "short_return_window": 20,
    "long_return_window": 60,
    "dispersion_window": 20,
    "dispersion_baseline_window": 60,
    "intensity_clip": [0.5, 2.0],
    "lag_days": 1,
    "forward_horizon_days": 10,
    "minimum_cross_section": 8
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2035-04-27",
