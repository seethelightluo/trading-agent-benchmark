{
  "factor_id": "miner_3_20320722_extreme_dispersion_pullback_10d",
  "factor_name": "Extreme Dispersion Trend-Confirmed Residual Pullback",
  "version": "1.0",
  "calculation": {
    "expression": "-((asset_log_return_10d - cross_asset_mean_log_return_10d) / rolling_mean(asset_daily_volatility_20d,20)).shift(1), active when lagged 60d trend > 0 and lagged cross-asset dispersion > trailing 120d 75th percentile",
    "description": "Ranks assets for a 10-trading-day residual reversal after extreme cross-asset dispersion, restricted to assets with positive smoothed medium-term trend. All inputs are lagged one completed day to prevent look-ahead."
  },
  "dependencies": ["close"],
  "parameters": {
    "residual_window_days": 10,
    "volatility_window_days": 20,
    "volatility_mean_window_days": 20,
    "trend_window_days": 60,
    "trend_smoothing_days": 10,
    "dispersion_window_days": 20,
    "dispersion_quantile_window_days": 120,
    "dispersion_quantile": 0.75,
    "forward_horizon_days": 10,
    "minimum_cross_section": 8
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2032-07-21",
    "last_validated": "2032-07-22",
    "metrics": {
      "daily_paper_ic": 0.0593174534,
      "same_horizon_ic": 0.0593174534,
      "daily_paper_icir": 0.1885892923,
      "same_horizon_icir": 0.1885892923,
      "ic_hit_ratio": 0.58125,
      "valid_cross_sectional_dates": 160,
      "calendar_dates": 3958,
      "assets": 15,
      "average_instruments_per_date": 9.2875,
      "active_date_fraction": 0.18342597,
      "rank_turnover": 0.11421003,
      "max_abs_library_correlation": null,
      "admission_thresholds": {"absolute_daily_paper_ic": 0.007, "absolute_daily_paper_icir": 0.084}
    },
    "decay": {"evaluated_forward_horizon_days": 10},
    "regime_notes": "No qualifying observations in 2020-2023; 2024-2026 IC -0.02662 over 17 dates, 2027-2029 IC 0.07781 over 55 dates, 2030-2032 IC 0.06436 over 88 dates. Strong recent performance but sparse activation and early negative regime require conservative use."
  },
  "signal_artifact": "scripts/miner_3_20320722_extreme_dispersion_pullback_signal.csv",
  "tags": ["cross_asset", "dispersion", "reversal", "trend_conditioned", "volatility_scaled"]
}
