{
  "factor_id": "miner_2_20270520_cross_asset_relative_strength_20d",
  "factor_name": "Cross-Asset Median-Relative Strength",
  "version": "1.0",
  "calculation": {
    "expression": "lag1(asset_return_20d - cross_sectional_median(asset_return_20d))",
    "description": "For each tradable benchmark, compute its 20-session cumulative close-to-close return and subtract the same-day median across all 15 tradable instruments. The signal is lagged by one completed session to prevent look-ahead bias.",
    "signal_provenance": "Reproducible signal artifact: scripts/miner_2_20270520_relative_strength.py; closes from ../persistent/stock_data for exactly the 15 tradable watchlist assets, data cut through 2027-05-20, no observation-only macro series and no future data."
  },
  "dependencies": ["close", "daily_return"],
  "parameters": {
    "return_window_days": 20,
    "cross_sectional_center": "median",
    "signal_lag_days": 1,
    "minimum_cross_section": 8
  },
