{
  "factor_id": "miner_2_20321028_quiet_reversal_40d",
  "factor_name": "Quiet-Regime Residual Trend Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-lag1(residual_return_sum_40 / mean_rolling_volatility_40) * I( lag1(dispersion_20 < median_120(dispersion_20)) )",
    "description": "Cross-sectionally mean-neutralized 40-day residual trend, inverted only when lagged residual dispersion is below its trailing 120-day median. The signal anticipates reversal of established relative trends during quiet regimes, using only information available before the decision date."
  },
  "dependencies": ["close"],
  "parameters": {"trend_window": 40, "volatility_window": 40, "dispersion_window": 20, "dispersion_median_window": 120, "forward_horizon_days": 10, "min_assets_per_date": 8},
