{
  "factor_id": "miner_2_20260924_trend_quality_40d",
  "factor_name": "Volatility-Scaled Trend Quality",
  "version": "1.0",
  "calculation": {
    "expression": "((close/close.shift(40))-1) / (std(pct_change(close),20)*sqrt(20)) * abs(close/close.shift(40)-1) / rolling_sum(abs(pct_change(close)),40)",
    "description": "Ranks assets by 40-session trend return, scaled by 20-session realized volatility and multiplied by 40-session path efficiency. Rewards persistent directional trends rather than noisy moves."
  },
  "dependencies": [
    "close",
    "pct_change"
  ],
  "parameters": {
    "trend_lookback_days": 40,
    "volatility_lookback_days": 20,
