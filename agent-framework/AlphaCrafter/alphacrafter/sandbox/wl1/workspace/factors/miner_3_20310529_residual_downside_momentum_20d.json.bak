  "factor_name": "Residual downside-risk-adjusted 20-day momentum",
  "version": "1.0",
  "calculation": {
    "expression": "rank_cs((log(close/close[-20]) - cross_asset_median(log(close/close[-20]))) / rolling_std(min(log_return,0),40)).shift(1)",
    "description": "Ranks each asset's 20-day log return relative to the contemporaneous cross-asset median, scaled by 40-day downside deviation. The one-day lag ensures only completed information is used."
  },
  "dependencies": ["close"],
