{
  "factor_id": "miner_2_20330415_disp_scaled_accel_reversal",
  "factor_name": "Dispersion-scaled residual acceleration reversal",
  "version": "1.0",
  "calculation": {
    "expression": "shift(-(sum_10(residual_return)-sum_30(residual_return)/3)/rolling_std_90(residual_return) * (0.65 + 0.70 * percentile_rank_120(cross_sectional_residual_dispersion)), 1)",
    "description": "Reverses recent residual acceleration, with a continuous backward-looking boost when cross-asset residual dispersion is elevated. Residual returns are daily log returns minus the equal-weight cross-sectional mean. Signal is lagged one completed session."
  },
