{
  "factor_id": "miner_2_20300905_downside_adjusted_trend_30d",
  "factor_name": "Downside-Adjusted Trend Percentile 30d Smoothed",
  "version": "1.0",
  "calculation": {
    "expression": "rank_pct((close/close.shift(30)-1)/(sqrt(mean(min(pct_change(close),0)^2,40))*sqrt(30)+1e-8), cross_section) averaged over 10 observations and shifted by 1 day",
    "description": "Ranks each asset's 30-day return after penalizing downside semivolatility, smooths the cross-sectional percentile over ten observations, and lags the signal one completed day to avoid look-ahead. Higher values indicate stronger downside-adjusted trend."
  },
  "dependencies": ["close", "pct_change"],
  "parameters": {"trend_lookback_days": 30, "downside_vol_window_days": 40, "downside_vol_min_periods": 25, "smoothing_window_days": 10, "signal_lag_days": 1, "universe_size": 15},
