{
  "factor_id": "miner_3_20261008_stress_adaptive_relative_strength",
  "factor_name": "Stress-Adaptive Relative Strength",
  "version": "1.0",
  "calculation": {
    "expression": "-tanh(3*(VIX_t/VIX_{t-20}-1)_{t-1}) * ((close_i/median_i(close)-1) / lag20)",
    "description": "Cross-sectional 20-session relative strength versus the daily universe median, multiplied by a lagged VIX-regime coefficient. The coefficient favors continuation in calm regimes and reverses exposure when VIX has risen materially over the prior 20 sessions. VIX and prices are lagged so no future data is used."
  },
  "dependencies": ["close", "VIX"],
  "parameters": {"relative_strength_window": 20, "vix_window": 20, "vix_scale": 3.0, "minimum_cross_section": 8, "universe_size": 15},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2026-07-15",
    "validated_at": "2026-10-08",
    "metrics": {
      "ic": 0.030873,
      "icir": 0.085993,
      "daily_paper_ic": 0.030873,
      "daily_paper_icir": 0.085993,
      "ic_hit_ratio": 0.5322,
      "valid_dates": 2343,
      "average_instruments": 15.0,
      "coverage": 0.9999,
      "turnover": 0.122903,
      "decay": {"5d_ic": 0.010527, "5d_icir": 0.029754, "10d_ic": 0.024341, "10d_icir": 0.068944, "20d_ic": 0.030873, "20d_icir": 0.085993},
      "max_abs_library_correlation": null
    },
    "regime_notes": "20-session horizon passed both benchmark gates on the 15-instrument universe; annual 10d IC was mixed, so uncertainty is conservative. 20d result is supported by 2343 dates with full cross-section coverage."
  },
  "signal_provenance": {
    "artifact_type": "reproducible_script",
    "script": "scripts/miner_3_20261008_stress_adaptive_relative_strength.py",
    "cutoff": "2026-07-15",
    "universe": ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"],
    "forward_return": "close[t+h]/close[t]-1, h=20 trading sessions",
    "minimum_valid_instruments": 8
  },
  "tags": ["cross_asset", "relative_strength", "macro_regime", "VIX", "trend", "conditional"]
}
