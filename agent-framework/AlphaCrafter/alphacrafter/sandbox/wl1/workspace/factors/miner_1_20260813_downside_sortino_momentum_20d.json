  "factor_name": "Downside-risk-adjusted 20-day momentum",
  "version": "1.0",
  "calculation": {
    "expression": "pct_change(close,20) / (sqrt(252) * rolling_std(negative_only(pct_change(close,1)),40,min_periods=5) + 0.02)",
