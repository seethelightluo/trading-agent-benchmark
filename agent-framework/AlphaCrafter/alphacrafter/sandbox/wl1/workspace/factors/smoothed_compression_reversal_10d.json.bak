{
  "factor_id": "smoothed_compression_reversal_10d",
  "factor_name": "Smoothed Volatility-Compression Directional Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "rolling_mean(-log(close/close.shift(10)) * rolling_std(log_returns,30,min_periods=20) / (rolling_std(log_returns,5,min_periods=4)+1e-12),3,min_periods=2).shift(1)",
    "description": "Fades the recent 10-session directional move with long/short realized-volatility scaling, then averages the raw signal over three observations to reduce rank noise. Signal is lagged one session."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "return_window_days": 10,
    "short_volatility_window_days": 5,
    "short_volatility_min_periods": 4,
    "long_volatility_window_days": 30,
    "long_volatility_min_periods": 20,
    "smoothing_window_days": 3,
    "smoothing_min_periods": 2,
    "forward_horizon_days": 10,
    "lag_days": 1,
    "epsilon": 1e-12
  },
