{
  "factor_id": "miner_1_20270729_compression_confirmed_trend_20d",
  "factor_name": "Volatility Compression-Confirmed Trend",
  "version": "1.0",
  "calculation": {
    "expression": "(close[t-1]/close[t-21]-1)/(ann_vol_20[t-1]) * (1+0.8*tanh((ann_vol_60[t-1]-ann_vol_20[t-1])/ann_vol_60[t-1]))",
    "description": "Lagged 20-session momentum divided by 20-session annualized volatility, amplified when short volatility is compressed relative to 60-session volatility."
  },
