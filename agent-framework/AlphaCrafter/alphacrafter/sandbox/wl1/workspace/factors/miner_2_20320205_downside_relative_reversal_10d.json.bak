{
  "factor_id": "miner_2_20320205_downside_relative_reversal_10d",
  "factor_name": "Downside-volatility-scaled relative reversal with medium-trend gate",
  "version": "1.0",
  "calculation": {
    "expression": "(-relative_log_return_10d / (downside_realized_vol_30d*sqrt(10)+epsilon)) * (tanh(2*log(close/rolling_median(close,120)))+1)/2, shifted one day",
    "description": "Ranks assets for 10-day relative pullback reversal, scaling shocks by downside volatility and attenuating assets below their 120-day median trend. All inputs are lagged one completed day."
  },
  "dependencies": ["close"],
  "parameters": {"return_window": 10, "downside_vol_window": 30, "trend_window": 120, "trend_scale": 2.0, "min_downside_vol_observations": 20, "signal_lag": 1, "epsilon": 1e-9},
