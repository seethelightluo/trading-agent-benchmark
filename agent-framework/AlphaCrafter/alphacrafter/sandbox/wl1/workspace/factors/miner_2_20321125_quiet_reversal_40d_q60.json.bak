{
  "factor_id": "miner_2_20321125_quiet_reversal_40d_q60",
  "factor_name": "Quiet-Regime Volatility-Normalized Residual Trend Reversal",
  "version": "1.1",
  "calculation": {
    "expression": "-rolling_sum(cross_sectionally_demeaned(log_return), 40) / rolling_mean(rolling_std(log_return, 40), 40), lagged one day, masked when 20-day mean residual dispersion is below its trailing 120-day 60th percentile",
    "description": "Ranks volatility-normalized relative trend losers positively for ten-day mean reversion during relatively quiet cross-asset regimes. Signal inputs use only completed data through the prior date."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "trend_window": 40,
    "volatility_window": 40,
    "volatility_min_periods": 25,
    "dispersion_smoothing_window": 20,
    "dispersion_lookback": 120,
    "dispersion_quantile": 0.6,
    "forward_horizon": 10,
