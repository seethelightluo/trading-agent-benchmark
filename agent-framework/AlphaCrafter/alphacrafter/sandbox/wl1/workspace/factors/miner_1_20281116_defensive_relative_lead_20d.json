  "factor_name": "Risk-Off Defensive Basket Relative Leadership 20d",
  "version": "1.0",
  "calculation": {
    "expression": "(asset_return_20d - mean(XAU_return_20d, US10Y_return_20d, CN10Y_return_20d)) * (0.25 + 0.75*I(breadth_20d < 0.40)), lagged 1 day",
