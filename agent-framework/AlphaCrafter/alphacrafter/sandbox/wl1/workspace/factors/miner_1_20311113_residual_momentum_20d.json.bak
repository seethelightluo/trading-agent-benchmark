{
  "factor_id": "miner_1_20311113_residual_momentum_20d",
  "factor_name": "Market-Beta-Neutral Residual Momentum",
  "version": "1.0",
  "calculation": {
    "expression": "shift(rolling_sum_20(log_return_i - beta_i_60 * equal_weight_cross_asset_log_return, min_periods=15), 1)",
    "description": "For each tradable instrument, estimate a trailing 60-day beta to the equal-weight cross-asset return, subtract the beta-implied common component from the instrument daily return, and sum residual returns over 20 days. Lag one completed day to prevent look-ahead. Observation-only macro series are not used."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "market_definition": "equal_weight_mean_of_15_tradable_returns",
    "beta_window_days": 60,
    "beta_min_periods": 40,
    "signal_window_days": 20,
    "signal_min_periods": 15,
    "lag_days": 1,
    "minimum_cross_section": 8
  },
