{
  "factor_id": "miner_2_20301017_residual_momentum_10d",
  "factor_name": "Volatility-scaled residual momentum",
  "version": "1.0",
  "calculation": {
    "expression": "rank_cs(rolling_mean_5(lag1((return_10d - cross_sectional_median(return_10d)) / (volatility_30d * sqrt(10)))) )",
    "description": "For each tradable instrument, subtract the cross-sectional median 10-day return to isolate relative momentum, scale by trailing 30-day close-to-close volatility, cross-sectionally percentile-rank, smooth over five observations, and lag one completed day. Higher values indicate stronger volatility-adjusted residual momentum."
  },
  "dependencies": ["close"],
  "parameters": {"return_window_days": 10, "volatility_window_days": 30, "rank_smoothing_days": 5, "lag_days": 1, "minimum_volatility_observations": 20},
