{
  "factor_id": "miner_1_20291213_volatility_normalized_momentum_20d",
  "factor_name": "Volatility-Normalized 20-Day Momentum",
  "version": "1.0",
  "calculation": {
    "expression": "lag1(pct_change(close,20) / rolling_std(negative_and_positive_daily_returns,40))",
    "description": "Twenty-trading-day price momentum divided by trailing 40-day daily return volatility, lagged one completed trading day to avoid look-ahead."
  },
  "dependencies": ["close", "pct_change"],
  "parameters": {"momentum_window": 20, "volatility_window": 40, "lag_days": 1, "minimum_volatility_observations": 30},
