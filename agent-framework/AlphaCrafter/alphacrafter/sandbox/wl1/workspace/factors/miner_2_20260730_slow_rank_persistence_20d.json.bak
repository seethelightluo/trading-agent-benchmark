{
  "factor_id": "miner_2_20260730_slow_rank_persistence_20d",
  "factor_name": "Smoothed 30/90-Day Rank Persistence",
  "version": "1.0",
  "calculation": {
    "expression": "EMA10(((rank_cs(ret_30) + rank_cs(ret_90))/2) * agreement(ret_30, ret_90))",
    "description": "Cross-sectional percentile ranks of 30-day and 90-day returns are averaged and multiplied by 1 when their signs agree (0.5 otherwise), then exponentially smoothed with span 10. Signals use prices through the prior completed date only."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "short_window": 30,
    "long_window": 90,
    "ema_span": 10,
    "disagreement_multiplier": 0.5,
    "forward_horizon_days": 20,
    "minimum_cross_section": 8
  },
  "validation": {
