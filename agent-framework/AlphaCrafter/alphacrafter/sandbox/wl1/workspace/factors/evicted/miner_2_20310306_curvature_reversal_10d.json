{
  "factor_id": "miner_2_20310306_curvature_reversal_10d",
  "factor_name": "Volatility-Scaled Trend Curvature with Short-Term Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "cross_sectional_demean((((R20 - R60/3) - 0.35*R5) / (std(pct_change,40)+1e-6)).shift(1))",
    "description": "Ranks assets where the intermediate 20-day trend is accelerating relative to its 60-day baseline, while subtracting the latest 5-day move to avoid chasing abrupt short-term extensions. The score is normalized by 40-day realized volatility, cross-sectionally demeaned, and lagged one session.",
    "lookahead_control": "All rolling inputs use data through t and the investable signal is shifted to t-1. Forward returns begin after the signal date."
  },
  "dependencies": [
    "close",
    "pct_change"
  ],
  "parameters": {
    "short_reversal_window": 5,
    "medium_window": 20,
    "long_window": 60,
    "long_baseline_divisor": 3,
    "volatility_window": 40,
    "reversal_penalty": 0.35,
    "signal_lag_days": 1,
    "minimum_cross_section": 8,
