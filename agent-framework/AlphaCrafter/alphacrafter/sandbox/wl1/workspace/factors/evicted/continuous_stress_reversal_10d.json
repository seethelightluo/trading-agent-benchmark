{
  "factor_id": "continuous_stress_reversal_10d",
  "factor_name": "Continuous stress-intensity volatility-scaled 10-day reversal",
  "version": "1.0",
  "calculation": {
    "expression": "shift( -log(close/close[-10]) / (rolling_std(log_return,20)*sqrt(10)) * clip((percentile_rank_120(mean_cross_asset_volatility_20)-0.50)/0.50,0,1), 1)",
    "description": "Ranks cross-asset 20-day volatility over a trailing 120-day window, converts excess stress above the median into a continuous 0-to-1 intensity, and multiplies it by each asset's volatility-scaled 10-day reversal. The complete signal is lagged one day to avoid look-ahead. Higher values indicate stronger rebound candidates after stress."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "reversal_days": 10,
    "volatility_window": 20,
    "stress_rank_window": 120,
    "stress_midpoint": 0.5,
    "stress_scale": 0.5,
    "max_stress_intensity": 1.0,
    "lag_days": 1,
    "forward_horizon_days": 10
  },
