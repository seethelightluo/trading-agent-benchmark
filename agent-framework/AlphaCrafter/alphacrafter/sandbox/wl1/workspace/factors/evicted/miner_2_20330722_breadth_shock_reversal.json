{
  "factor_id": "miner_2_20330722_breadth_shock_reversal",
  "factor_name": "Breadth-Conditioned Residual Shock Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "where(mean_cross_asset_positive_return_10d < 0.40, -(residual_return_5d)/(residual_downside_or_total_vol_30d*sqrt(5)), 0), lagged_1d",
    "description": "Fade recent five-day residual shocks only when cross-asset breadth has been persistently weak; residuals are returns relative to the equal-weight 15-asset benchmark. Signals are lagged one session to avoid lookahead."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "shock_window": 5,
    "vol_window": 30,
    "breadth_window": 10,
