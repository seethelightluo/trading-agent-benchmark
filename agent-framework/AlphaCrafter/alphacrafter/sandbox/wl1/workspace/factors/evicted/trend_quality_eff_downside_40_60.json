  "factor_name": "Trend Quality by Path Efficiency and Downside Risk",
  "version": "1.0",
  "calculation": {
    "expression": "clip((return_40 * clip(return_60 / sum(abs(daily_return),60), -2, 2)) / (1 + 3 * downside_volatility_40), -5, 5), lagged 1 day",
