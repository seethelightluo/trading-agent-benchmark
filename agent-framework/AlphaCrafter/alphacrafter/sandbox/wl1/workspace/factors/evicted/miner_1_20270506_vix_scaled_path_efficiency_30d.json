  "factor_name": "VIX-Scaled Directional Path Efficiency",
  "version": "1.0",
  "calculation": {
    "expression": "shift1((sum(ret,30)/sum(abs(ret),30)) * exp(-0.35*clip(VIX_zscore_60,-2,2)))",
    "description": "Thirty-session directional path efficiency, multiplied by an inverse-VIX state scaler and lagged one completed session. Higher values favor persistent directional trends, with trend exposure moderated when VIX is elevated relative to its 60-session history."
  },
  "dependencies": [
    "close",
    "pct_change",
    "VIX.close"
  ],
  "parameters": {
    "path_window": 30,
    "path_min_periods": 20,
