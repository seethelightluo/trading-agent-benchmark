{
  "factor_id": "miner_1_20320304_downside_residual_reversal_60d_fallback",
  "factor_name": "Fallback Downside-Volatility-Scaled Cross-Sectional Residual Reversal 60D",
  "version": "1.0",
  "calculation": {
    "expression": "shift_1(-(log(close/close[-60]) - cross_sectional_median(log(close/close[-60]))) / coalesce(downside_std(log_returns,60)*sqrt(60), total_std(log_returns,60)*sqrt(60)))",
    "description": "Ranks lagged 60-day relative losers positively for reversal, scaling by 60-day downside volatility; falls back to total volatility only when downside volatility is unavailable. All inputs are lagged one session before use."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "lookback_days": 60,
    "forward_horizon_days": 20,
