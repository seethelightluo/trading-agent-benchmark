  "factor_name": "Extended-Shock Reversal Extension",
  "version": "1.0",
  "calculation": {
    "expression": "-log(close_t/close_{t-5}) * (1 + 0.5 * clip(abs(log(close_t/close_{t-60}))/(sqrt(60)*rolling_std(log_returns,20)),0,3)), lagged one day",
    "description": "Contrarian five-day return signal, with reversal strength increased after an extended 60-day move relative to recent volatility. All inputs are lagged before use. Cross-sectional rank is used by consumers."
