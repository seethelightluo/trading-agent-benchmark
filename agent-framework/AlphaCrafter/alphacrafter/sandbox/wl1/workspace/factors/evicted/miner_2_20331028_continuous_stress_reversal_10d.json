  "factor_name": "Continuous Stress-Intensity Volatility-Scaled Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "clip((rank120(cross_asset_mean(rolling_std(log_returns,20)))-0.50)/0.50,0,1) * (-log(close/close[-10])/(rolling_std(log_returns,20)*sqrt(10)))",
    "description": "Ranks assets by lagged ten-day reversal normalized by 20-day volatility, activated continuously and proportionally to elevated cross-asset volatility stress. Signal is shifted one completed session to avoid look-ahead."
