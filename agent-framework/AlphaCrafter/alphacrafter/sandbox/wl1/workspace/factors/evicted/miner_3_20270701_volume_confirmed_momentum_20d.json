  "factor_id": "volume_confirmed_volscaled_momentum_20d",
  "factor_name": "Volume-Confirmed Volatility-Scaled 20-Day Momentum",
  "version": "20270701",
  "calculation": {
    "expression": "lag1((close/close[-20]-1) / (std(pct_change(close),20)+1e-8) * clip(SMA(volume,10)/SMA(volume,60),0.25,4)^0.25)",
    "description": "Ranks assets by lagged 20-day momentum scaled by realized volatility and modestly confirmed by relative recent trading volume. The one-session lag prevents look-ahead bias."
  },
