{
  "factor_id": "miner_1_20320401_shorter_downside_residual_reversal_40d",
  "factor_name": "40-Day Downside-Volatility-Scaled Cross-Asset Residual Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-((log(close/close[-40]) - cross_sectional_median(log(close/close[-40])))/downside_volatility_40d).shift(1)",
    "description": "Ranks assets for 10-session forward returns using the negative 40-session return residual relative to the daily cross-sectional median, scaled by 40-session annualized downside volatility. Total volatility is used when downside volatility is unavailable. The one-session lag prevents look-ahead bias."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "residual_lookback_sessions": 40,
