  "factor_name": "Defensive-Basket Relative Downside-Quality Momentum",
  "version": "1.0",
  "calculation": {
    "expression": "shift1((rolling_sum(return,20) - rolling_sum(mean_return(XAU,US10Y,CN10Y),20)) / (rolling_std(min(return,0),40)*sqrt(20)+epsilon))",
    "description": "For each tradable asset, subtract the trailing 20-day return of a defensive basket (XAU, US10Y, CN10Y), then scale by trailing 40-day downside volatility. Shift by one completed day to avoid look-ahead. Higher values indicate stronger relative, downside-risk-adjusted performance."
  },
