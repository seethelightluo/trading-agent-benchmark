  "factor_name": "Lagged Shock-Reversal Momentum with Dispersion Dampening",
  "version": "1.0",
  "calculation": {
    "expression": "shift1(((log(close/close[-30]) - 0.8*log(close/close[-5])) / rolling_std(log_returns,40)) / (1 + cross_sectional_dispersion_20 / median(cross_sectional_dispersion_20,120)))",
    "description": "Ranks 30-day momentum after subtracting recent 5-day momentum to capture shock reversal, scales by 40-day volatility, and dampens signals during unusually high cross-asset return dispersion. The one-day lag ensures only completed-day information is used."
