{
  "factor_id": "miner_3_20310724_relative_momentum_acceleration_20d",
  "factor_name": "Volatility-scaled relative momentum acceleration",
  "version": "1.0",
  "calculation": {
    "expression": "rank_cs(shift1((log(close/close[20]) - log(close/close[60])/3) / (40d_realized_vol*sqrt(252)) - cross_sectional_mean))",
    "description": "For each tradable cross-asset instrument, compare 20-day log momentum with the average 20-day pace implied by 60-day momentum, normalize by 40-day realized volatility, demean cross-sectionally, and lag one completed day. Higher values indicate improving relative trend adjusted for risk."
  },
