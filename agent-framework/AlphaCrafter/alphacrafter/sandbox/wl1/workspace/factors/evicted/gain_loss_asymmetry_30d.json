  "factor_id": "gain_loss_asymmetry_30d",
  "factor_name": "30-Day Gain-Loss Asymmetry",
  "version": "1.0",
  "calculation": {
    "expression": "((rolling_sum(max(pct_change(close),0),30)+0.01)/(rolling_sum(max(-pct_change(close),0),30)+0.01)).shift(1)",
    "description": "Measures the balance of cumulative positive daily returns against cumulative negative-return magnitude over 30 trading days. The one-day lag prevents use of the decision day's incomplete information. Higher values indicate stronger upside participation and/or contained downside."
