  "factor_name": "Risk-Adjusted Trend Persistence Quality",
  "version": "1.0",
  "calculation": {
    "expression": "(close/close.shift(15)-1) / (std(daily_return,30)*sqrt(30)+epsilon) * (0.5 + 0.5*(2*mean(I(daily_return>0),15)-1)), lagged 1 session",
    "description": "Ranks the 15 tradable cross-asset instruments by medium-horizon return scaled by recent realized risk and continuously rewarded for persistence of positive daily returns. All inputs are shifted one completed session before forward-return testing to prevent look-ahead."
