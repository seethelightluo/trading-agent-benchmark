  "factor_name": "Downside-Semideviation-Normalized Ten-Day Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "lag1(-(close/close.shift(10)-1)/(sqrt(mean(clip(daily_return,upper=0)^2,40))*sqrt(252)+0.005))",
    "description": "Ranks assets for reversal of the prior ten-session return, normalized by trailing downside semideviation; signal is lagged one completed session to avoid look-ahead."
