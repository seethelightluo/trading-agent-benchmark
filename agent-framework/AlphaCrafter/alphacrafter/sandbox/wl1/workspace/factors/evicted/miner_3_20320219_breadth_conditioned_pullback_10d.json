  "factor_name": "Cross-Asset Breadth-Conditioned Volatility-Normalized Pullback",
  "version": "1.0",
  "calculation": {
    "expression": "shift1((1.5 - cross_sectional_breadth_20d) * (-0.6*log(close/close[-5]) - 0.4*log(close/close[-10])) / (rolling_std(log_return,30)*sqrt(7)+epsilon))",
