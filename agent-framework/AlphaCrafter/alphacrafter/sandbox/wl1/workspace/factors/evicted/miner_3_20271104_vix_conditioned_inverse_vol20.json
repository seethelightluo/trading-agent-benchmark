  "factor_name": "VIX-Conditioned Inverse 20-Day Realized Volatility",
  "version": "1.0",
  "calculation": {
    "expression": "[1/(std(pct_change(close),20)+0.003)] * [1 + 0.50*clip(zscore(VIX_return_20,252),-2,2)]",
    "description": "Ranks assets by inverse 20-session realized volatility, amplified during elevated VIX 20-session change; all inputs are lagged one completed session to prevent look-ahead. VIX is observation-only and not tradable."
