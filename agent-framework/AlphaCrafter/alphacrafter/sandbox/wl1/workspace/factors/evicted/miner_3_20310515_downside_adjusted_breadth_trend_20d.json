{
  "factor_id": "miner_3_20310515_downside_adjusted_breadth_trend_20d",
  "factor_name": "Downside-adjusted breadth-conditioned medium trend",
  "version": "1.0",
  "calculation": {
    "expression": "rank_cs(shift1(log(close/close[-20]) / rolling_std(where(log_return<0, log_return, 0), 40) * (0.75 + 0.5 * cross_asset_mean(rolling_mean(indicator(log_return>0),20), axis=assets))))",
    "description": "Twenty-day log momentum divided by 40-day downside deviation, multiplied by a smooth cross-asset breadth tilt. The signal is lagged one trading day before cross-sectional ranking to prevent look-ahead. Breadth tilt is clipped to [0.75, 1.25]."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "momentum_window": 20,
    "downside_vol_window": 40,
    "downside_vol_min_periods": 25,
    "breadth_window": 20,
    "breadth_min_periods": 15,
    "breadth_tilt_intercept": 0.75,
    "breadth_tilt_slope": 0.5,
    "breadth_tilt_clip": [
      0.75,
      1.25
    ],
    "lag_days": 1,
    "rank_method": "cross_sectional_percentile"
  },
