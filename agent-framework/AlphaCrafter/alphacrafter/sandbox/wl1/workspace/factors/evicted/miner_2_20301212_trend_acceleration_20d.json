  "factor_id": "miner_2_20301212_trend_acceleration_20d",
  "factor_name": "Risk-normalized trend acceleration with persistence",
  "version": "1.0",
  "calculation": {
    "expression": "(pct_change(close,20) - pct_change(close,60)/3) / (sqrt(40)*rolling_std(pct_change(close,1),40)) * (0.5 + 0.5*(2*rolling_mean(positive_return,20)-1)); signal = raw.shift(1)",
    "description": "Measures acceleration of the recent 20-session trend relative to a 60-session baseline, normalizes by 40-session realized volatility, and confirms the signal with the fraction of positive daily returns. The one-session lag prevents look-ahead. Positive values indicate stronger improving trends."
