{
  "factor_id": "shock_reversal_5d_volscaled",
  "factor_name": "Volatility-Scaled Five-Day Shock Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-log(close/close_lag5) / (rolling_std(log_returns,20)*sqrt(5)+epsilon) when abs(log(close/close_lag5)/(rolling_std(log_returns,20)*sqrt(5))) > 1; otherwise 0; lagged one completed day",
    "description": "Contrarian cross-asset signal that buys assets after statistically large five-day declines and favors assets expected to mean-revert after large rallies via the negative standardized shock. Small shocks are neutralized."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "shock_window": 5,
    "volatility_window": 20,
    "shock_threshold": 1.0,
    "forward_horizon_days": 10,
    "lag": 1,
    "epsilon": 1e-12
  },
