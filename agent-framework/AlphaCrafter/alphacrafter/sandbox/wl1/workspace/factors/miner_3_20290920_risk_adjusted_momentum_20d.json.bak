  "factor_name": "20-day volatility-adjusted momentum",
  "version": "2029-09-20",
  "calculation": {
    "expression": "lag1(rolling_sum(close.pct_change(),20) / (rolling_std(close.pct_change(),20) * sqrt(252)))",
    "description": "Cross-asset risk-adjusted 20-day continuation signal, lagged one completed trading day to prevent look-ahead. Higher values indicate stronger recent return per unit of realized volatility."
  },
  "dependencies": ["close"],
  "parameters": {"return_window": 20, "volatility_window": 20, "annualization": 252, "lag": 1, "minimum_observations": 10},
