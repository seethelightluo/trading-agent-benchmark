{
  "factor_id": "relative_momentum_volscaled_40d",
  "factor_name": "Cross-sectional 40-day Relative Momentum Volatility Scaled",
  "version": "2028-12-28",
  "calculation": {
    "expression": "(return_40d(asset) - cross_sectional_median(return_40d)) / (sqrt(252) * rolling_std(daily_return,20))", 
    "description": "Ranks assets by 40-trading-day momentum relative to the contemporaneous universe median, normalized by trailing 20-day realized volatility; signal is lagged one completed trading day to avoid look-ahead.",
    "signal_artifact": "scripts/miner_3_20281228_relative_momentum_volscaled_40d_signal.csv"
  },
  "dependencies": ["close", "daily_return"],
  "parameters": {"momentum_window": 40, "volatility_window": 20, "min_vol_observations": 15, "lag_days": 1, "universe_size": 15},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2028-12-27",
    "last_validated": "2028-12-28T00:00:00",
    "metrics": {
      "horizon_days": 20,
      "ic": 0.030498,
      "icir": 0.089362,
      "valid_dates": 2966,
      "average_instruments": 15.0,
      "coverage": 0.9999,
      "turnover": 0.063515,
      "hit_ratio": 0.5327,
      "max_abs_library_correlation": 0.9683601319
    },
    "regime_notes": "Full-sample 20-day gate passes conservatively across 2,966 dates. IC/ICIR were 0.038656/0.114825 during 2020-2025, 0.009003/0.025540 during 2026+, 0.034390/0.113510 during 2027+, and 0.137095/0.483394 during 2028+; recent strength is material but regime dependence remains. Cross-sectional sample is 15 instruments and uncertainty is interpreted conservatively.",
    "thresholds": {"absolute_daily_paper_ic_min": 0.007, "absolute_daily_paper_icir_min": 0.084}
  },
