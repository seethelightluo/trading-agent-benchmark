{
  "factor_id": "miner_1_20320219_downside_residual_reversal_60d",
  "factor_name": "Downside-Volatility-Scaled Cross-Sectional Residual Reversal 60D",
  "version": "1.0",
  "calculation": {
    "expression": "-((log(close/close.shift(60))-cross_sectional_median(log(close/close.shift(60))))/(downside_std(log_returns,60)*sqrt(60)+epsilon)).shift(1)",
    "description": "Ranks lagged 60-day relative losers positively for reversal, scaling each residual by its trailing downside volatility. Downside volatility uses only negative daily log returns; the complete signal is lagged one session."
  },
  "dependencies": ["close"],
  "parameters": {"lookback_days": 60, "downside_vol_window": 60, "downside_min_periods": 30, "forward_horizon_days": 20, "epsilon": 1e-12, "cross_section_min_assets": 8, "lag_days": 1},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2026-01-01/2032-02-19",
    "last_validated": "2032-02-19",
