{
  "factor_id": "miner_3_20271230_downside_normalized_reversal20",
  "factor_name": "Downside-Risk-Normalized 20-Day Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-sum(return,20) / (sqrt(20)*sqrt(mean(min(return,0)^2,20)) + 1e-8), lagged 1 session",
    "description": "Ranks assets higher when their recent 20-day cumulative return is negative relative to their recent downside deviation. The complete signal is shifted one session before forward-return evaluation to prevent look-ahead."
  },
  "dependencies": ["close"],
  "parameters": {"lookback_days": 20, "min_periods": 15, "downside_window": 20, "signal_lag_days": 1, "epsilon": 1e-8},
