  "factor_id": "miner_3_20270617_volscaled_momentum_20d",
  "factor_name": "Volatility-Scaled 20-Day Momentum",
  "version": "20270617",
  "calculation": {
    "expression": "lag1(20d_price_return / rolling_std(daily_returns,20))",
    "description": "Ranks the 15 tradable cross-asset instruments by prior 20-session return divided by prior realized 20-session daily volatility. The one-session lag ensures the signal uses only completed data.",
    "signal_provenance": {
      "artifact": "scripts/miner_3_20270617_volscaled_momentum.py",
      "data_source": "../persistent/stock_data/{symbol}.csv",
      "cutoff": "2027-06-16",
      "universe_size": 15,
      "forward_return_definition": "close[t+h]/close[t]-1"
    }
  },
  "dependencies": [
    "close",
    "daily_returns"
  ],
  "parameters": {
    "momentum_window": 20,
    "volatility_window": 20,
    "minimum_volatility_observations": 15,
    "lag_sessions": 1
  },
