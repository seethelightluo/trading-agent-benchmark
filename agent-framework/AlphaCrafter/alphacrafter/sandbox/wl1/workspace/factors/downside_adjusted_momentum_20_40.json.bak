  "factor_name": "Downside-adjusted medium-term momentum",
  "version": "20290906.v1",
  "calculation": {
    "expression": "shift(rolling_sum(return,20) / (sqrt(40) * rolling_std(where(return<0,return,0),40)), 1), cross_sectionally_demeaned",
    "description": "Ranks lagged 20-trading-day cumulative returns by downside volatility over the prior 40 trading days; positive returns do not contribute to downside deviation. Uses only information available before the signal date."
  },
  "dependencies": ["close"],
  "parameters": {"momentum_window": 20, "downside_vol_window": 40, "min_periods_return": 10, "min_periods_downside_vol": 20, "lag": 1, "cross_sectional_demean": true},
