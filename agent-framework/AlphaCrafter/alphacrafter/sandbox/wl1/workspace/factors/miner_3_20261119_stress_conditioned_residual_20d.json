{
  "factor_id": "miner_3_20261119_stress_conditioned_residual_20d",
  "factor_name": "VIX-Stress-Conditioned Cross-Asset Residual Momentum",
  "version": "1.0",
  "calculation": {
    "expression": "lag1((R20_i - beta60_i * R20_equity_basket) * (max(0,VIX_z120) + 0.25*max(0,VIX_change10)))",
    "description": "Twenty-session asset return residualized against a six-index equity basket using a 60-session rolling beta, multiplied by a positive VIX stress gate. The signal is lagged one session and cross-sectionally winsorized at the 5th and 95th percentiles.",
    "lookahead_control": "All rolling inputs and VIX observations are cut through 2026-07-15; signal is shifted one session before forward-return testing."
  },
  "dependencies": [
    "close",
    "VIX observation-only macro series"
  ],
  "parameters": {
    "return_window": 20,
    "beta_window": 60,
    "beta_min_periods": 40,
    "vix_z_window": 120,
    "vix_z_min_periods": 60,
    "vix_change_window": 10,
    "stress_change_weight": 0.25,
    "winsor_lower": 0.05,
    "winsor_upper": 0.95,
    "minimum_cross_section": 8
  },
