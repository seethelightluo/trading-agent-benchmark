{
  "factor_id": "miner_2_20330107_quiet_downside_reversal_40d",
  "factor_name": "Quiet-Regime Downside-Risk-Scaled Residual Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-shift1((cross_sectional_residual(log_return).rolling_sum(40)) / sqrt(rolling_mean_40(min(log_return,0)^2))) * I(smoothed_dispersion_20 < lagged_trailing_quantile_120(dispersion_20,0.60))",
    "description": "Contrarian residual trend signal activated in quiet dispersion regimes, scaling the prior 40-day residual trend by downside semideviation rather than total volatility. Signals use only completed data and are evaluated at a 10-trading-day forward horizon."
  },
  "dependencies": ["close"],
  "parameters": {"trend_window": 40, "downside_window": 40, "dispersion_window": 20, "regime_window": 120, "quiet_quantile": 0.60, "forward_horizon": 10, "minimum_cross_section": 8},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 to 2033-01-06 (usable dates depend on rolling warmup and forward horizon)",
    "metrics": {
      "ic": 0.0328802316,
      "icir": 0.1309428509,
      "horizon_days": 10,
      "valid_dates": 960,
      "average_instruments": 15.0,
      "coverage": 1.0,
      "rank_turnover": 0.0616399265,
      "hit_ratio": 0.5770833333,
      "max_abs_library_correlation": null
    },
    "regime_notes": "2024-2026: n=21, IC=0.26871, ICIR=1.51091; 2027-2029: n=478, IC=0.02271, ICIR=0.08758; 2030-2032: n=461, IC=0.03269, ICIR=0.13604. The 2020-2023 segment had no usable observations under the available aligned history and was not treated as evidence.",
    "signal_artifact": "scripts/miner_2_20330107_quiet_downside_reversal_signal.csv",
