  "factor_name": "High-Dispersion Residual Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-rolling_sum(residual_return,5)/rolling_std(residual_return,20) * I[cross_sectional_return_dispersion > rolling_median(dispersion,120)]",
    "description": "Ranks assets by five-day residual reversal, volatility-scaled by twenty-day residual volatility, and activates only during unusually high cross-asset dispersion. Residual return is asset return minus the equal-weight universe return."
  },
  "dependencies": ["close", "daily_returns"],
  "parameters": {"residual_benchmark": "equal_weight_15_assets", "reversal_window_days": 5, "volatility_window_days": 20, "dispersion_window_days": 120, "activation_threshold": "trailing_median", "admission_horizon_days": 10},
