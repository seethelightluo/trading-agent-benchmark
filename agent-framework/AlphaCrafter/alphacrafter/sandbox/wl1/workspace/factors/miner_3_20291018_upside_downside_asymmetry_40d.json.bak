{
  "factor_id": "miner_3_20291018_upside_downside_asymmetry_40d",
  "factor_name": "40-Day Upside/Downside Magnitude Asymmetry",
  "version": "1.0",
  "calculation": {
    "expression": "rolling_mean(max(return,0),40) / (rolling_mean(max(-return,0),40) + 1e-8), shifted by 1 day",
    "description": "For each tradable cross-asset instrument, compare average positive daily return magnitude with average negative daily return magnitude over the prior 40 observations. Higher values indicate historically favorable upside-versus-downside payoff asymmetry. The signal is lagged one day to prevent look-ahead."
  },
  "dependencies": ["close", "daily_return"],
  "parameters": {"window": 40, "min_periods": 25, "epsilon": 1e-8, "lag": 1, "forward_admission_horizon_days": 20},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2029-10-17",
    "validation_date": "2029-10-18",
    "metrics": {
      "ic": 0.027986,
      "icir": 0.085423,
      "horizon_days": 20,
      "valid_dates": 3191,
      "average_instruments": 15.0,
      "coverage": 0.9916,
      "rank_turnover": 0.048665,
      "hit_ratio": 0.5268,
      "max_abs_library_correlation": 0.653051
    },
    "regime_notes": "Passed benchmark-wide full-sample gates with 15 instruments and 3,191 daily cross-sectional observations. Strong in 2020-2025 (IC 0.044314, ICIR 0.138167), weak post-2026 (IC -0.006468, ICIR -0.019062), and negative in 2029 YTD (IC -0.090881, ICIR -0.325688); use with conservative weight and regime monitoring. IC uncertainty is material because the cross-section is small.",
    "decay": {"1d_ic": 0.005282, "5d_ic": 0.013282, "10d_ic": 0.01758, "20d_ic": 0.027986}
  },
  "signal_artifact": "scripts/miner_3_20291018_downside_asymmetry_signal.csv",
  "tags": ["payoff-asymmetry", "risk", "cross-asset", "lagged", "40d"]
}
