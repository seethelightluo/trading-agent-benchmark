{
  "factor_id": "miner_3_20270311_residual_volscaled_momentum_20d",
  "factor_name": "Volatility-Scaled Beta-Neutralized Residual Momentum",
  "version": "20270311",
  "calculation": {
    "expression": "shift(1, rolling_sum_20(asset_return - beta_60 * cross_asset_mean_return) / (sqrt(20) * rolling_std_60(asset_return - beta_60 * cross_asset_mean_return)))",
    "description": "For each tradable asset, remove lagged 60-session beta exposure to the equal-weight cross-asset daily return, sum the residual return over 20 sessions, and scale by trailing 60-session residual volatility. The one-session signal lag ensures only completed bars are used.",
    "forward_horizon": "20 trading days",
    "signal_artifact": "scripts/miner_3_20270311_residual_volscaled_momentum.py"
  },
  "dependencies": [
    "close",
    "pct_change"
  ],
  "parameters": {
    "momentum_window_days": 20,
    "beta_window_days": 60,
    "beta_min_periods": 40,
    "residual_volatility_window_days": 60,
    "residual_volatility_min_periods": 40,
    "market_proxy": "equal_weight mean of 15 tradable asset returns",
    "signal_lag_days": 1,
