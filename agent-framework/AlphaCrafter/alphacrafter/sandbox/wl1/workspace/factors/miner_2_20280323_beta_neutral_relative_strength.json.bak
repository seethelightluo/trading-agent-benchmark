  "factor_name": "Beta-Neutral Relative Strength 30d",
  "version": "2028-03-23",
  "calculation": {
    "expression": "((sum_return_30d(asset) - cross_sectional_median(sum_return_30d)) / (std_return_40d * sqrt(30) + 0.004)).shift(1)",
    "description": "Ranks each tradable asset by 30-day return relative to the contemporaneous cross-asset median, scaled by 30-day realized volatility. One-session lag prevents look-ahead."
  },
  "dependencies": ["close", "daily_returns"],
  "parameters": {"return_window": 30, "return_min_periods": 20, "vol_window": 40, "vol_min_periods": 30, "vol_annualization": "sqrt(30)", "epsilon": 0.004, "lag_sessions": 1, "universe_size": 15},
