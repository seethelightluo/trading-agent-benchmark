{
  "factor_id": "miner_1_20261105_drawdown_recovery_asymmetry_10d",
  "factor_name": "Drawdown-Recovery Asymmetry",
  "version": "1.0",
  "calculation": {
    "expression": "((close / rolling_min(close, 60)) - 1) / rolling_std(min(pct_change(close), 0), 20).shift(1)",
    "description": "Ranks assets by recovery from their 60-day trough, scaled by recent downside volatility; all inputs are lagged one completed day before the forward return. Higher values indicate efficient recovery with less downside variability."
  },
  "dependencies": ["close"],
  "parameters": {"drawdown_window": 60, "downside_vol_window": 20, "signal_lag": 1, "forward_horizon_days": 10},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-08 through 2026-11-05 (cutoff; forward observations through available sample)",
    "last_validated": "2026-11-05T00:00:00Z",
    "metrics": {
      "ic": 0.035754,
      "icir": 0.109389,
      "hit_ratio": 0.5371,
      "valid_dates": 2398,
      "average_instruments": 14.99,
      "coverage": 0.9993,
      "rank_turnover": 0.059785,
      "decay": {"5d_ic": 0.026817, "5d_icir": 0.08184, "20d_ic": 0.04146, "20d_icir": 0.123591},
      "max_abs_library_correlation": null
    },
    "regime_notes": "Positive annual 10-day IC in 2020, 2021, 2022, 2023, 2025, and 2026; negative in 2024. Small 15-instrument cross-section; uncertainty interpreted conservatively.",
    "signal_provenance": {
      "script": "scripts/miner_1_20261105_drawdown_recovery.py",
      "universe": ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"],
