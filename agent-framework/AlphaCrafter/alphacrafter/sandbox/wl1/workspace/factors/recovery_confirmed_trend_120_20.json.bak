{
  "factor_id": "recovery_confirmed_trend_120_20",
  "factor_name": "Recovery-Confirmed Downside-Adjusted Trend",
  "version": "2028-11-16",
  "calculation": {
    "expression": "(close / rolling_min(close,120) - 1) * pct_change(close,20) / (1 + 4 * annualized_downside_volatility_40d)",
    "description": "Ranks assets that have recovered from their 120-day lows and have confirmed 20-day positive trend, while penalizing downside volatility. The signal is lagged one trading day."
  },
  "dependencies": ["close", "daily returns"],
  "parameters": {"recovery_window": 120, "trend_window": 20, "downside_vol_window": 40, "downside_vol_multiplier": 4, "annualization": 252, "signal_lag_days": 1, "minimum_history": 60},
