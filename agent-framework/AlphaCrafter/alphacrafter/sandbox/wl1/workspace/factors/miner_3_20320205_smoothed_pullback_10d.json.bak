{
  "factor_id": "miner_3_20320205_smoothed_pullback_10d",
  "factor_name": "Smoothed trend-gated pullback reversal",
  "version": "1.0",
  "calculation": {
    "expression": "shift(1, ((-0.60*log(close/close[-5]) - 0.40*log(close/close[-10])) / (rolling_std(log_returns,30)*sqrt(7)+epsilon)) * ((tanh(2*log(close/close[-80]))+1)/2))",
    "description": "A blended five- and ten-day contrarian shock normalized by 30-day realized volatility, gated toward assets with positive 80-day trends. The one-day lag prevents look-ahead and smoothing reduces signal turnover."
  },
  "dependencies": ["close"],
  "parameters": {"short_window": 5, "long_shock_window": 10, "short_weight": 0.60, "long_weight": 0.40, "vol_window": 30, "vol_min_periods": 20, "vol_scale_days": 7, "trend_window": 80, "trend_gate_scale": 2.0, "lag_days": 1, "epsilon": 1e-9, "forward_horizon_days": 10},
