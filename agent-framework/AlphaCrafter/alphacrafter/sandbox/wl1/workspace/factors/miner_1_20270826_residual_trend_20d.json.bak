  "factor_name": "Idiosyncratic Volatility-Normalized Cross-Asset Trend",
  "version": "1.0",
  "calculation": {
    "expression": "shift_1((rolling_sum_30(asset_return - equal_weight_cross_asset_return)) / (sqrt(30)*rolling_std_30(asset_return - equal_weight_cross_asset_return) + 0.01))",
    "description": "For each tradable asset, measure its 30-session cumulative return relative to the contemporaneous equal-weight cross-asset return, normalize by 30-session residual volatility, and lag one session. Higher values indicate persistent asset-specific trend strength."
