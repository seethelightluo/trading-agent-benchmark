  "dependencies": ["close", "daily_returns"],
  "parameters": {"lookback_sessions": 30, "forward_horizon_sessions": 20, "minimum_lookback": 20, "lag_sessions": 1, "volatility_floor": 0.01, "cross_section": "equal_weight_15_tradable_assets"},
