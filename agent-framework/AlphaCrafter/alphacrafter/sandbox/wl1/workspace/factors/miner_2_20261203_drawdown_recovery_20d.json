{
  "factor_id": "miner_2_20261203_drawdown_recovery_20d",
  "factor_name": "Drawdown Recovery with Extension Penalty",
  "version": "1.0",
  "calculation": {
    "expression": "((close / lag(close,20)) - 1) * (1 - (close - rolling_min(close,120)) / (rolling_max(close,120) - rolling_min(close,120)))",
    "description": "Ranks assets by trailing 20-day recovery while penalizing assets already near their 120-day high. Signal is lagged one completed day before forward-return testing and cross-sectionally clipped at the 5th/95th percentiles."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "recovery_window": 20,
    "range_window": 120,
    "range_min_periods": 80,
    "winsor_lower": 0.05,
    "winsor_upper": 0.95,
    "signal_lag": 1
  },
