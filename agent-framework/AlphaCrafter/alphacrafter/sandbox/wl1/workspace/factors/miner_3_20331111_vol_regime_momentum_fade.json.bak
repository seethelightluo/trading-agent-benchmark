  "calculation": {
    "expression": "-((log(close/close_60d) / (std(log_returns,40)*sqrt(40))) / (1 + std(log_returns,10)/std(log_returns,40)))",
    "description": "Inverse-direction medium-term risk-adjusted momentum: fade assets with strong 60-day trend after adjusting for their 40-day volatility and penalizing elevated short-term volatility. Signal is shifted one completed session before use. The persisted direction is negative relative to the raw quality-momentum expression because the raw signal has negative forward IC."
  },
  "dependencies": ["close"],
