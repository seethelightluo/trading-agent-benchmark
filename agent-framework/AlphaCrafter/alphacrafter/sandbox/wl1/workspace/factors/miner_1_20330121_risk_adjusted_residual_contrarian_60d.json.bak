{
  "factor_id": "miner_1_20330121_risk_adjusted_residual_contrarian_60d",
  "factor_name": "Risk-Adjusted 60-Day Residual Contrarian",
  "version": "1.0",
  "calculation": {
    "expression": "-cross_sectional_demean(pct_change(close,60) / (rolling_std(pct_change(close,1),20)*sqrt(252)))",
    "description": "For each tradable cross-asset instrument, negate its 60-session return after scaling by trailing 20-session annualized volatility, then demean across the available universe. The signal is lagged by one completed session before forecasting the next 10 trading-day return. Higher values select volatility-adjusted residual losers for contrarian exposure."
  },
  "dependencies": ["close"],
  "parameters": {"lookback_return_days": 60, "volatility_window_days": 20, "annualization": 252, "forward_horizon_days": 10, "minimum_cross_section": 8, "lag_days": 1},
