{
  "factor_id": "dispersion_scaled_residual_trend_contrarian_20d",
  "factor_name": "Dispersion-scaled residual trend contrarian",
  "version": "1.0",
  "calculation": {
    "expression": "-(residual_return_20d / residual_volatility_60d) * (0.80 + 0.40 * rolling_percentile(residual_cross_asset_dispersion_120d))",
    "description": "Compute each asset's 20-session return residual to the equal-weight cross-asset return, scale by 60-session residual volatility, amplify in higher-dispersion states, lag one completed session, and use the contrarian (negative) orientation."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "trend_window": 20,
    "volatility_window": 60,
    "dispersion_rank_window": 120,
    "dispersion_floor": 0.8,
    "dispersion_scale": 0.4,
    "signal_lag": 1,
    "forward_horizon": 10
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 to 2033-04-28",
    "last_validated": "2033-04-29",
    "metrics": {
      "daily_paper_ic": 0.0256876644,
      "daily_paper_icir": 0.0921015435,
      "ic_hit_ratio": 0.534936999,
      "valid_dates": 1746,
      "average_instruments": 14.9943,
      "coverage": 0.9996182,
      "turnover": 0.0834268,
      "decay_ic_5": 0.0208131,
      "decay_ic_10": 0.0256877,
      "decay_ic_20": 0.0293176,
      "max_abs_library_correlation": null
    },
    "regime_notes": "The persisted contrarian orientation has positive aggregate IC in the full sample; the underlying raw residual trend had negative IC. Regime performance is not uniform, so use as a capped factor and revalidate periodically.",
    "provenance": {
