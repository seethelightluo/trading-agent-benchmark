  "factor_name": "Recovery-Gated Volatility-Normalized Trend",
  "version": "20270812",
  "calculation": {
    "expression": "lag1((pct_change(close,20)/(std(pct_change(close,1),20)*sqrt(20))) * (0.5 + (close-rolling_min(close,60))/(rolling_max(close,60)-rolling_min(close,60))))",
    "description": "Ranks medium-term volatility-normalized trend, amplified for assets recovered from their 60-day low toward the 60-day range. One-session lag ensures only completed data are used."
