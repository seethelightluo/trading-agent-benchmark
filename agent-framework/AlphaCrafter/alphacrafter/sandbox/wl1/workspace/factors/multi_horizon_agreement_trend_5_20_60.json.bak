{
  "factor_id": "multi_horizon_agreement_trend_5_20_60",
  "factor_name": "Multi-Horizon Agreement Risk-Adjusted Trend",
  "version": "1.0",
  "calculation": {
    "expression": "((ROC(close,20)/(0.01+sqrt(252)*std(pct_change(close),40))) * (sign(ROC(close,5))+sign(ROC(close,20))+sign(ROC(close,60)))/3).shift(1)",
    "description": "Ranks assets by lagged 20-day return scaled by 40-day annualized volatility, reinforced when short, medium, and long horizon returns agree in direction. The one-day lag prevents look-ahead."
  },
  "dependencies": ["close"],
  "parameters": {"short_window": 5, "medium_window": 20, "long_window": 60, "volatility_window": 40, "volatility_floor": 0.01, "annualization": 252, "lag_days": 1},
