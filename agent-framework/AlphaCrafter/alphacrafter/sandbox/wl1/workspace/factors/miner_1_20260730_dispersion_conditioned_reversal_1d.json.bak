  "factor_name": "Dispersion-Conditioned Short-Term Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "if cross_asset_dispersion_3d > trailing_60d_median_dispersion: -sum(asset_returns_3d), otherwise NaN",
    "description": "When contemporaneous cross-asset return dispersion is unusually high, rank assets by the negative of their trailing three-day return. The dispersion threshold uses only the prior 60 observations, and the signal is evaluated against next-day return."
