{
  "factor_id": "miner_2_20270617_downside_adjusted_momentum_30d",
  "factor_name": "Downside-Adjusted Medium-Term Momentum",
  "version": "2027-06-17",
  "calculation": {
    "expression": "lag1(pct_change(close,30) / rolling_std(clip(pct_change(close,1), upper=0),30,min_periods=20))",
    "description": "Thirty-trading-day price momentum scaled by trailing downside deviation, with a one-day lag to prevent look-ahead. Higher values indicate gains achieved with less downside risk.",
