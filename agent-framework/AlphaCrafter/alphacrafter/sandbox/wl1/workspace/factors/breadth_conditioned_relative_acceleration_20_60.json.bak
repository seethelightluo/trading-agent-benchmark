{
  "factor_id": "breadth_conditioned_relative_acceleration_20_60",
  "factor_name": "Cross-Asset Breadth-Conditioned Relative Momentum Acceleration",
  "version": "1.0",
  "calculation": {
    "expression": "((R20 - median_cs(R20)) - (R60 - median_cs(R60))) * clip(0.5 + mean_cs(R20 > 0), 0.65, 1.35), shifted_by_1_day",
    "description": "Cross-sectional relative 20-day versus 60-day momentum acceleration, scaled by the prevailing fraction of tradable assets with positive 20-day return. The breadth multiplier is bounded and all signals are lagged one completed day to prevent look-ahead. Positive values indicate stronger relative acceleration."
  },
  "dependencies": ["close"],
  "parameters": {
    "short_window": 20,
    "long_window": 60,
    "breadth_window": 20,
    "breadth_multiplier_base": 0.5,
    "multiplier_clip": [0.65, 1.35],
    "signal_lag_days": 1,
    "forward_horizon_days": 10,
    "minimum_cross_section": 8
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2035-05-25",
