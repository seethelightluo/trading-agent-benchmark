  "factor_name": "Downside-Persistence Risk-Normalized Breadth",
  "version": "1.0",
  "calculation": {
    "expression": "lag1((mean(indicator(r>0),40) - mean(indicator(r<0),40)) / (std(r,40) + 0.005))",
    "description": "Cross-asset factor rewarding a high frequency of positive sessions relative to negative sessions, normalized by 40-day realized volatility. The complete signal is shifted one session so only completed data are used at decision time."
  },
  "dependencies": ["close", "pct_change"],
  "parameters": {"lookback_days": 40, "min_periods": 25, "volatility_floor": 0.005, "signal_lag_days": 1, "admission_horizon_days": 20},
