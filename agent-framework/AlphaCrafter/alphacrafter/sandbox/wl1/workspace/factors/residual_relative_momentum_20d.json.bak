{
  "factor_id": "residual_relative_momentum_20d",
  "factor_name": "Risk-Scaled Cross-Sectional Residual Momentum 20d",
  "version": "1.0",
  "calculation": {
    "expression": "((return_20d - cross_sectional_median(return_20d)) / (annualized_volatility_40d + 0.05)).shift(1), clipped to [-10,10]",
    "description": "Ranks each tradable asset by its 20-day return relative to the same-day universe median, normalized by 40-day annualized volatility. The one-day lag prevents look-ahead bias."
  },
  "dependencies": ["close", "pct_change", "cross_sectional_median", "rolling_std"],
  "parameters": {"return_window": 20, "volatility_window": 40, "volatility_floor": 0.05, "annualization": 252, "lag": 1, "clip": [-10, 10], "universe_size": 15},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2029-02-07",
    "validated_horizon_days": 20,
    "metrics": {
      "ic": 0.047306,
      "icir": 0.141439,
      "hit_ratio": 0.553,
      "valid_dates": 3011,
      "average_instruments": 15.0,
      "coverage": 0.9999,
      "turnover": 0.082492,
      "max_abs_library_correlation": null
    },
    "regime_notes": "Positive across 2020-2025 (IC 0.054627, ICIR 0.162853), 2026+ (0.028571, 0.086209), 2027+ (0.051303, 0.177950), and strongest in 2028+ (0.124960, 0.446495). Small 15-asset cross-section implies conservative uncertainty interpretation.",
    "signal_artifact": "scripts/miner_1_20290208_residual_relative_momentum_signal.csv"
  },
