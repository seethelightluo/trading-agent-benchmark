  "factor_name": "Smooth Medium-Term Momentum with Short-Term Reversal",
  "version": "20270603",
  "calculation": {
    "expression": "(close/lag(close,20)-1) - (close/lag(close,5)-1), lagged one completed trading day",
    "description": "Ranks assets by medium-term 20-trading-day momentum after subtracting the latest 5-trading-day return, reducing short-term chasing while retaining trend information. The complete signal is shifted one day before forward-return evaluation."
