{
  "factor_id": "miner_1_20270408_breadth_confirmed_momentum_20d",
  "factor_name": "Breadth-Confirmed Volatility-Adjusted Momentum",
  "version": "1.0",
  "calculation": {
    "expression": "shift1((close/close[-20]-1)/rolling_std(pct_change(close),40) * (0.5 + rolling_mean(indicator(pct_change(close)>0),20)))",
    "description": "Twenty-session momentum scaled by 40-session realized volatility and multiplied by a confirmation term based on the fraction of positive sessions in the preceding 20 sessions. The one-session lag ensures only completed data are used."
  },
  "dependencies": ["close"],
  "parameters": {"momentum_window": 20, "volatility_window": 40, "breadth_window": 20, "min_vol_observations": 25, "min_breadth_observations": 15, "lag_sessions": 1},
