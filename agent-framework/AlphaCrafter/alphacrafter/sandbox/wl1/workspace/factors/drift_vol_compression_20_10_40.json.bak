{
  "factor_id": "drift_vol_compression_20_10_40",
  "factor_name": "Positive Drift with Volatility Compression",
  "version": "1.0",
  "calculation": {
    "expression": "shift(1, ret_20/(vol_40+0.01) * (1-vol_10/(vol_40+0.01)))",
    "description": "Ranks assets by positive 20-day drift adjusted for 40-day volatility and the transition toward lower 10-day realized volatility. The one-day lag prevents look-ahead."
  },
  "dependencies": [
    "close",
    "daily returns"
  ],
  "parameters": {
    "return_window": 20,
    "short_vol_window": 10,
    "long_vol_window": 40,
    "min_return_period": 15,
    "min_short_vol_period": 8,
    "min_long_vol_period": 25,
    "stabilizer": 0.01,
    "lag": 1
  },
  "validation": {
