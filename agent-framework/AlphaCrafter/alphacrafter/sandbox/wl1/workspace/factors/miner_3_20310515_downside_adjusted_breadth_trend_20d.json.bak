{
  "factor_id": "miner_3_20310515_downside_adjusted_breadth_trend_20d",
  "factor_name": "Downside-adjusted breadth-conditioned medium trend",
  "version": "1.0",
  "calculation": {
    "expression": "rank_cs(shift1(log(close/close[-20]) / rolling_std(where(log_return<0, log_return, 0), 40) * (0.75 + 0.5 * cross_asset_mean(rolling_mean(indicator(log_return>0),20), axis=assets))))",
    "description": "Twenty-day log momentum divided by 40-day downside deviation, multiplied by a smooth cross-asset breadth tilt. The signal is lagged one trading day before cross-sectional ranking to prevent look-ahead. Breadth tilt is clipped to [0.75, 1.25]."
  },
  "dependencies": ["close"],
  "parameters": {
    "momentum_window": 20,
    "downside_vol_window": 40,
    "downside_vol_min_periods": 25,
    "breadth_window": 20,
    "breadth_min_periods": 15,
    "breadth_tilt_intercept": 0.75,
    "breadth_tilt_slope": 0.5,
    "breadth_tilt_clip": [0.75, 1.25],
    "lag_days": 1,
    "rank_method": "cross_sectional_percentile"
  },
  "signal_artifact": "scripts/miner_3_20310515_downside_adjusted_breadth_trend_signal.csv",
  "validation": {
    "status": "EFFECTIVE",
    "timestamp": "2031-05-15",
    "period": "2020-01-02 through 2031-05-14",
    "horizon_days": 20,
    "metrics": {
      "ic": 0.037681,
      "icir": 0.119301,
      "hit_ratio": 0.5346,
      "observations": 3603,
      "unique_dates": 3603,
      "instruments": 15,
      "average_valid_instruments": 14.71,
      "coverage": 0.97394,
      "rank_turnover": 0.08052,
      "max_abs_library_correlation": null
    },
    "decay": {
      "1d_ic": -0.005023,
      "5d_ic": 0.010470,
      "10d_ic": 0.028760,
      "20d_ic": 0.037681
    },
    "regime_notes": "Strong in 2020-2022 and 2031 YTD; weaker in 2023-2028 and negative in 2029-2030. Interpret small cross-asset cross-sections conservatively despite long date history."
  },
  "tags": ["momentum", "downside-risk", "breadth", "trend", "cross-asset"],
  "last_validated": "2031-05-15"
}
