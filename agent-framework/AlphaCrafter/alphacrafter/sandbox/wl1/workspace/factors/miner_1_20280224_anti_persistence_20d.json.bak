  "factor_name": "Volatility-scaled anti-persistence reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(sum_return_20d * positive_day_fraction_20d / std_daily_return_20d)",
    "description": "Ranks assets higher when their recent volatility-scaled 20-day trend is weaker/negative, combining trend direction with breadth of positive sessions. Signal uses data through date t and predicts returns after t."
