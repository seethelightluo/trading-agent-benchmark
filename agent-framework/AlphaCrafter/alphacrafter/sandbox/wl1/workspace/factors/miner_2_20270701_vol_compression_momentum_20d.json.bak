{
  "factor_id": "miner_2_20270701_vol_compression_momentum_20d",
  "factor_name": "Volatility-Compression Risk-Adjusted Momentum",
  "version": "1.0",
  "calculation": {
    "expression": "lag1((return_20d / (std(return_1d,20)+eps)) * clip(std(return_1d,60)/std(return_1d,20), 0.5, 2.0))",
    "description": "Ranks assets by 20-day momentum scaled by recent volatility and amplified when short-term volatility is below its 60-day baseline. The one-session lag ensures only completed daily data are used."
  },
  "dependencies": ["close", "daily_returns"],
  "parameters": {"momentum_window": 20, "short_vol_window": 20, "long_vol_window": 60, "min_short_observations": 15, "min_long_observations": 40, "compression_clip": [0.5, 2.0], "lag_sessions": 1, "epsilon": 1e-8},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2027-06-30",
    "metrics": {
      "admission_horizon_days": 10,
