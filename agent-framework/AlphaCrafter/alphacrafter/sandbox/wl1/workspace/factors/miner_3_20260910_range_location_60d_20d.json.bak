{
  "factor_id": "miner_3_20260910_range_location_60d_20d",
  "factor_name": "60-Day Range Location",
  "version": "1.0",
  "calculation": {
    "expression": "(close_t - rolling_min(close,60)_t) / (rolling_max(close,60)_t - rolling_min(close,60)_t)",
    "description": "Cross-sectional percentile-like location of each tradable asset's latest close within its trailing 60-session high-low range. Higher values indicate stronger breakout positioning; the range includes the as-of close and uses no future observations."
  },
  "dependencies": ["close"],
  "parameters": {"lookback_sessions": 60, "forward_horizon_sessions": 20, "minimum_cross_section": 8},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2026-07-15",
    "metrics": {
      "ic": 0.036408,
      "icir": 0.109319,
      "ic_hit_ratio": 0.52,
      "valid_dates": 1604,
      "average_instruments": 14.53,
      "coverage": 0.9689,
      "rank_turnover": 0.088264,
      "max_abs_library_correlation": null,
      "decay_ic": {"5d": 0.016377, "10d": 0.030702, "20d": 0.036408, "30d": 0.023881}
    },
    "thresholds": {"minimum_abs_daily_ic": 0.007, "minimum_abs_daily_icir": 0.084},
    "regime_notes": "Positive 20-session IC in 2020, 2022, 2023, 2025, and 2026; mildly negative in 2021 and 2024. Predictive strength is strongest at 20 sessions among tested horizons, with horizon decay by 30 sessions. Small cross-asset universe requires conservative uncertainty interpretation.",
    "validation_timestamp": "2026-09-10T00:00:00Z"
  },
  "signal_provenance": {
    "artifact_script": "scripts/miner_3_20260910_range_location.py",
    "data_cutoff": "2026-07-15",
    "universe": ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"],
    "method": "Daily cross-sectional Spearman correlation between as-of factor and forward close-to-close return; dates with at least 8 valid instruments.",
    "forward_return_definition": "close[t+20]/close[t]-1"
  },
  "tags": ["range", "breakout", "momentum", "cross_asset"]
}
