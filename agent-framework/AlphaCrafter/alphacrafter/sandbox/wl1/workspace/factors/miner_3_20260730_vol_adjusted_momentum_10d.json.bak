{
  "factor_id": "miner_3_20260730_vol_adjusted_momentum_10d",
  "factor_name": "Volatility-Adjusted Momentum",
  "version": "1.0",
  "calculation": {
    "expression": "(close_t / close_{t-20} - 1) / (std(pct_change(close) over the last 20 sessions) * sqrt(20) + 1e-8)",
    "description": "Twenty-session cumulative return scaled by annualized-like 20-session realized volatility. Higher values identify positive momentum achieved with lower recent risk; signal at date t uses only completed observations and predicts the next 10 sessions."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "lookback_sessions": 20,
    "volatility_window": 20,
    "volatility_scale": "sqrt(20)",
    "forward_horizon_sessions": 10,
    "minimum_cross_section": 8,
    "epsilon": 1e-08,
    "std_ddof": 1
  },
