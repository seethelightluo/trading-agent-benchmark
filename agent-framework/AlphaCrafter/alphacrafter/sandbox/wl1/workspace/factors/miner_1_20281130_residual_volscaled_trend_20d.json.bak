{
  "factor_id": "miner_1_20281130_residual_volscaled_trend_20d",
  "factor_name": "Market-Residual Volatility-Scaled Trend 20d",
  "version": "1.0",
  "calculation": {
    "expression": "clip(rolling_sum_20(residual_return) / (sqrt(40)*rolling_std_40(residual_return)), -5, 5), shifted_by_1_day",
    "description": "For each tradable asset, estimate a 60-day rolling beta to the equal-weight universe daily return, subtract beta times market return to obtain residual returns, sum residual returns over 20 days, and scale by 40-day residual volatility. The signal is lagged one completed day to prevent look-ahead and clipped to limit outlier influence."
  },
  "dependencies": [
    "close",
    "daily_returns"
  ],
  "parameters": {
    "beta_window": 60,
    "beta_min_periods": 30,
    "signal_window": 20,
    "vol_window": 40,
    "vol_min_periods": 25,
    "clip_min": -5,
    "clip_max": 5,
    "lag_days": 1,
    "universe": 15
  },
