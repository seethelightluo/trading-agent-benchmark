{
  "factor_id": "miner_2_20261231_corr_adjusted_trend_20d",
  "factor_name": "Equity-Correlation-Adjusted Volatility-Scaled Trend",
  "version": "1.0",
  "calculation": {
    "expression": "lag1((ret_30d / realized_vol_30d) * (1 - corr_30d(asset_daily_return, equal_weight_equity_daily_return)))",
    "description": "Thirty-day momentum divided by 30-day realized volatility, attenuated by the asset's rolling 30-day correlation with the equal-weighted eight-instrument equity basket. Signal is lagged one completed day.",
    "signal_provenance": "Computed from close prices through 2027-01-27 only; equal-weight equity basket is 000300.SH, SPX, HSI, N225, SX5E, 000688.SH, SOX, NDX. No observation-only macro series or future data used."
  },
  "dependencies": [
    "close",
    "daily_return"
  ],
  "parameters": {
