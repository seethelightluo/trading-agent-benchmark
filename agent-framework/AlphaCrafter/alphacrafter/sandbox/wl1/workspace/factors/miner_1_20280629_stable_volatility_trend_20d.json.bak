{
  "factor_id": "miner_1_20280629_stable_volatility_trend_20d",
  "factor_name": "Stable Volatility-Conditioned Trend",
  "version": "1.0",
  "calculation": {
    "expression": "(close/close.shift(20)-1) / max(std(daily_return,20),0.002) * clip(std(daily_return[-20:-1])/max(std(daily_return[-10:]),0.002),0.5,1.5)",
    "description": "Twenty-day risk-adjusted trend multiplied by a bounded stability ratio. Trends receive more weight when recent volatility is no higher than the preceding ten sessions, while unstable volatility changes are capped. Signal uses data through the decision-date prior completed session."
  },
  "dependencies": [
    "close",
    "daily_return"
  ],
  "parameters": {
    "trend_window": 20,
    "volatility_window": 20,
    "recent_volatility_window": 10,
    "prior_volatility_window": 10,
    "vol_floor": 0.002,
    "stability_clip": [
      0.5,
      1.5
    ],
    "signal_lag_sessions": 1
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2028-06-29",
    "metrics": {
      "horizon_days": 20,
