{
  "factor_id": "medium_relative_contrarian_60_15d",
  "factor_name": "Inverse medium-horizon residual momentum, risk scaled",
  "version": "1.0",
  "calculation": {
    "expression": "-(sum_60(residual_log_return) + 0.5 * sum_15(residual_log_return)) / (sqrt(60) * rolling_std_60(residual_log_return) + 1e-8), lagged 1 day",
    "description": "Ranks assets higher when their 60-day and 15-day cumulative returns relative to the equal-weight tradable benchmark are weak, with residual-volatility scaling. The one-day lag prevents use of the current day's close."
  },
  "dependencies": ["close"],
  "parameters": {
    "benchmark": "equal_weight_mean_log_return_of_15_tradable_assets",
    "long_window_days": 60,
    "short_window_days": 15,
    "short_weight": 0.5,
    "volatility_window_days": 60,
    "minimum_return_observations": 40,
    "minimum_volatility_observations": 30,
    "lag_days": 1,
    "forward_horizon_days": 10
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2033-06-09",
    "last_validated": "2033-06-10",
    "metrics": {
      "ic": 0.063497,
      "icir": 0.227968,
      "ic_hit_ratio": 0.5811,
      "forward_horizon_days": 10,
      "valid_ic_dates": 1776,
      "average_cross_section": 14.99,
      "universe_size": 15,
      "coverage": 0.9996,
      "average_rank_turnover": 0.0607,
      "max_abs_library_correlation": null
    },
    "regime_notes": "Positive aggregate IC and ICIR across evaluated 2024-2026, 2027-2029, 2030-2032, and 2032-2033 regimes; 15-asset cross-sectional uncertainty warrants conservative weighting.",
    "signal_artifact": "scripts/miner_3_20330610_medium_relative_contrarian_signal.csv"
  },
  "tags": ["cross_asset", "relative_value", "contrarian", "momentum", "risk_scaled"],
  "provenance": {
    "agent": "miner_1",
    "validation_timestamp": "2033-06-10",
    "method": "daily Spearman cross-sectional IC against 10-trading-day forward log returns"
  }
}
