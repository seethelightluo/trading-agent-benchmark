  "factor_name": "Trend-Filtered Volatility-Normalized Reversal",
  "version": "2032-01-22",
  "calculation": {
    "expression": "(-log(close/close.shift(5))/(rolling_std(log_returns,20)*sqrt(5)+epsilon)) * (tanh(3*log(close/close.shift(60)))+1)/2, lagged one day",
    "description": "Contrarian five-day shock normalized by 20-day realized volatility, gated toward assets with positive 60-day trend; signals are lagged to avoid look-ahead."
  },
  "dependencies": ["close"],
