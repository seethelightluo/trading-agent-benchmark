{
  "factor_id": "miner_3_20280113_momentum_acceleration_volscaled20",
  "factor_name": "Volatility-Scaled Momentum Acceleration 20D",
  "version": "1.0",
  "calculation": {
    "expression": "((sum_return_20d - sum_return_60d/3) / (std_return_60d*sqrt(60)+epsilon)).shift(1)",
    "description": "Measures whether the recent 20-session return pace is accelerating relative to the trailing 60-session average pace, normalized by 60-session realized volatility. Positive values indicate improving trend impulse. The one-session lag prevents look-ahead."
  },
  "dependencies": ["close"],
  "parameters": {"short_window": 20, "long_window": 60, "vol_window": 60, "min_short_observations": 15, "min_long_observations": 45, "epsilon": 1e-8, "lag_sessions": 1},
  "validation": {
