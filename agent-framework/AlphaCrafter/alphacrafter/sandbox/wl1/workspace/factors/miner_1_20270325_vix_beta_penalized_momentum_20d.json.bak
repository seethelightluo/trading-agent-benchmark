{
  "factor_id": "miner_1_20270325_vix_beta_penalized_momentum_20d",
  "factor_name": "VIX-Beta Penalized Momentum",
  "version": "1.0",
  "calculation": {
    "expression": "log(close/close[-20]) - 0.75 * beta_60(asset_return,VIX_return) * max(0,(VIX/VIX_median_120)-1), then lag 1 session",
    "description": "Twenty-session log momentum penalized during elevated VIX regimes for assets with positive VIX beta; all inputs are lagged one completed session before signal use. Negative VIX beta receives a relative boost under stress."
  },
  "dependencies": [
    "close",
    "VIX close"
  ],
  "parameters": {
    "momentum_window": 20,
    "beta_window": 60,
    "beta_min_periods": 40,
    "vix_median_window": 120,
    "vix_median_min_periods": 80,
    "stress_floor": 0.0,
    "stress_coefficient": 0.75,
    "signal_lag": 1
  },
  "validation": {
    "status": "EFFECTIVE",
