  "factor_name": "VIX-Conditioned Efficiency-Weighted Trend",
  "version": "1.0",
  "calculation": {
    "expression": "sign(rolling_median(VIX,60)-VIX) * (return_20 / (std(return_1,20)*sqrt(252))) * (return_20 / sum(abs(return_1),20))",
    "description": "Ranks assets by 20-session momentum scaled by realized volatility and path efficiency; the trend direction is retained when VIX is at or below its 60-session median and inverted when VIX is above its median. All inputs are shifted one completed session before use."
  },
  "dependencies": [
    "close",
    "VIX close"
  ],
  "parameters": {
    "momentum_window": 20,
    "volatility_window": 20,
    "vix_window": 60,
    "regime_threshold": "60-session VIX median",
    "lag_sessions": 1
  },
