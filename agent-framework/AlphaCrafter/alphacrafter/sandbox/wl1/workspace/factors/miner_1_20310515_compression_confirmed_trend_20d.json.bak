  "factor_name": "Compression-Confirmed Efficiency Trend",
  "version": "1.0",
  "calculation": {
    "expression": "rank_cs(shift1((0.65*log_return_20 + 0.35*log_return_40) * efficiency_20 / (vol20 * (vol20/vol60 + 0.15))) )",
    "description": "Ranks medium-horizon directional momentum, rewarding efficient moves and lower recent volatility relative to the 60-day baseline. All inputs are lagged one session to prevent look-ahead."
  },
  "dependencies": ["close"],
  "parameters": {"momentum_windows": [20,40], "momentum_weights": [0.65,0.35], "efficiency_window": 20, "volatility_windows": [20,60], "compression_offset": 0.15, "forecast_horizon_days": 20, "lag_days": 1},
  "validation": {
