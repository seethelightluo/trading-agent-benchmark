{
  "factor_id": "miner_2_20271007_reversal5_vol40",
  "factor_name": "Five-Day Volatility-Normalized Short-Term Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "lag1(-(close/close.shift(5)-1)/(rolling_std(daily_returns,40)*sqrt(252)+0.005))",
    "description": "Ranks assets higher when their prior five-session return was negative, with the reversal magnitude normalized by annualized 40-session realized volatility and a small stabilizer. The one-session lag ensures only completed data is used."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "reversal_window": 5,
    "volatility_window": 40,
    "annualization": 252,
    "stabilizer": 0.005,
    "lag": 1,
    "holding_horizons": [
      5,
      10,
      20
    ]
  },
