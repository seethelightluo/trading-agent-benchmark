{
  "factor_id": "compression_reversal_10d",
  "factor_name": "Volatility-Compression Directional Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "(-log(close/close.shift(10)) * rolling_std(log_returns,30,min_periods=20) / (rolling_std(log_returns,5,min_periods=4)+1e-12)).shift(1)",
    "description": "Fades the recent 10-session directional move while scaling by the ratio of long- to short-horizon realized volatility; higher values favor recent losers emerging from compressed volatility. Signal is lagged one session."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "return_window_days": 10,
