{
  "factor_id": "miner_1_20280210_vix_beta_reversal_20d",
  "factor_name": "VIX-beta-penalized volatility-scaled reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(sum_return_5d / std_return_20d) - 0.20 * zscore(covariance(asset_return,VIX_return,60d)/variance(VIX_return,60d))",
    "description": "Ranks recent underperformance after volatility scaling, while modestly penalizing assets with high trailing sensitivity to VIX returns. All inputs are trailing and lag-safe."
  },
  "dependencies": ["close", "VIX close"],
  "parameters": {"reversal_window": 5, "volatility_window": 20, "vix_beta_window": 60, "beta_penalty": 0.20, "forward_admission_horizon_sessions": 20},
