{
  "factor_id": "miner_3_20270114_stress_amplified_realized_volatility",
  "factor_name": "Stress-Amplified Realized Volatility",
  "version": "1.0",
  "calculation": {
    "expression": "rolling_std(pct_change(close),20) * (1 + clip(zscore(VIX,120),0,2))",
    "description": "Ranks instruments by lagged 20-session realized volatility, with the cross-sectional signal amplified when lagged VIX is above its 120-session rolling mean. Higher values are preferred. The signal is shifted one session to prevent lookahead.",
    "signal_lag_sessions": 1,
    "winsorization": "cross-sectional 5th/95th percentile"
  },
  "dependencies": ["close", "VIX"],
  "parameters": {"volatility_window": 20, "vix_zscore_window": 120, "vix_min_periods": 60, "stress_clip_lower": 0, "stress_clip_upper": 2, "forward_horizon_sessions": 10},
  "validation": {
    "status": "EFFECTIVE",
    "period": {"start": "2020-01-01", "end": "2026-07-15"},
