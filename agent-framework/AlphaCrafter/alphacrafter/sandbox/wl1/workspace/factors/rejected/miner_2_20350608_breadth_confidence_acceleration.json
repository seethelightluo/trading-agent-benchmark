{
  "factor_id": "miner_2_20350608_breadth_confidence_acceleration",
  "factor_name": "Breadth-Confidence Relative Momentum Acceleration",
  "version": "1.0",
  "calculation": {
    "expression": "((r20 - median_cross_section(r20)) - (r60 - median_cross_section(r60))) * (1 + 2*abs(breadth20 - 0.5)).clip(1, 1.5), then lag 1 day",
    "description": "Ranks assets by the acceleration of their 20-day relative return versus 60-day relative return. The signal is strengthened when cross-asset 20-day trend breadth is unusually high or low and is weakened at neutral breadth. The one-day lag prevents look-ahead bias."
  },
  "dependencies": ["close"],
  "parameters": {"short_lookback_days": 20, "long_lookback_days": 60, "breadth_lookback_days": 20, "breadth_confidence_min": 1.0, "breadth_confidence_max": 1.5, "signal_lag_days": 1, "forward_horizon_days": 10},
