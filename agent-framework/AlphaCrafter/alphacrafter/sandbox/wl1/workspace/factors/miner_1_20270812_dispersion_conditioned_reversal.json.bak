{
  "factor_id": "miner_1_20270812_dispersion_conditioned_reversal",
  "factor_name": "Dispersion-Conditioned Short Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "if percentile_rank(rolling_std(cross_asset_daily_returns,20)) > 0.65: -rolling_sum(return,5) else 0.25*rolling_sum(return,20), shifted 1 day",
    "description": "Contrarian five-day reversal during elevated cross-asset dispersion, with a weak medium-term trend anchor in normal dispersion. The one-day lag prevents look-ahead."
  },
  "dependencies": ["close"],
  "parameters": {"dispersion_window": 20, "dispersion_threshold": 0.65, "reversal_window": 5, "trend_window": 20, "normal_trend_weight": 0.25, "lag_days": 1},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2027-08-12",
    "last_validated": "2027-08-12T00:00:00Z",
    "metrics": {
