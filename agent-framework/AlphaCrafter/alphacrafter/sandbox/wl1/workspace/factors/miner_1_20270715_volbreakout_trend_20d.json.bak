{
  "factor_id": "miner_1_20270715_volbreakout_trend_20d",
  "factor_name": "Volatility-Scaled Trend with Short-Term Confirmation",
  "version": "1.0",
  "calculation": {
    "expression": "(close[t-1]/close[t-21]-1)/(std(pct_change(close),20)*sqrt(252))[t-1] * (1 + 0.5*tanh(((close[t-1]/close[t-6])-1)/((std(pct_change(close),20)*sqrt(252))[t-1])))",
    "description": "Medium-term 20-session momentum scaled by trailing 20-session annualized volatility, multiplied by a bounded confirmation term from 5-session momentum. Every input is lagged to avoid look-ahead. Higher values indicate persistent, risk-adjusted trends."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "momentum_window": 20,
    "confirmation_window": 5,
    "volatility_window": 20,
    "annualization": 252,
    "confirmation_strength": 0.5,
    "admission_horizon_days": 20
  },
  "signal_provenance": {
    "script": "scripts/miner_1_20270715_volbreakout_trend.py",
    "signal_definition": "f computed cross-sectionally from lagged close and rolling pct-change volatility",
