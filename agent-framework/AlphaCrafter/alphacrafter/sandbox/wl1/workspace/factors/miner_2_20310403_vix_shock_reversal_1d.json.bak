{
  "factor_id": "miner_2_20310403_vix_shock_reversal_1d",
  "factor_name": "VIX Shock-Conditioned Cross-Asset Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "demean_cs((-sum_return_5d / rolling_std_return_20d) * (1 + max(VIX/rolling_median(VIX,60)-1,0)), lag=1)",
    "description": "Ranks recent cross-asset losers for rebound potential, increasing the reversal exposure when observation-only VIX is elevated relative to its trailing median. The signal is lagged one completed session."
  },
  "dependencies": ["close", "VIX close"],
  "parameters": {"reversal_window": 5, "risk_window": 20, "vix_baseline_window": 60, "min_periods": {"risk": 15, "vix": 40}, "lag": 1},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 to 2031-04-03",
    "last_validated": "2031-04-03T00:00:00Z",
    "metrics": {
      "horizon_days": 1,
      "ic": 0.026870,
      "icir": 0.087896,
      "ic_hit_ratio": 0.5349,
      "observations": 3558,
      "average_instruments": 15.0,
      "coverage": 0.9887,
      "turnover": 0.156473,
      "decay_ic_5d": 0.022311,
      "decay_ic_10d": 0.014446,
      "decay_ic_20d": 0.000004,
      "max_abs_library_correlation": null
    },
    "regime_notes": "Positive daily IC across full sample and all reported recent regimes; daily ICIR is above the benchmark gate, while longer-horizon IC decays toward zero. Small 15-asset cross-section implies conservative uncertainty interpretation."
  },
  "tags": ["reversal", "volatility", "macro-conditioned", "cross-asset"],
  "signal_artifact": "scripts/miner_2_20310403_vix_shock_reversal_signal.csv",
