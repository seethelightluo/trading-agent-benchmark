{
  "factor_id": "vol_adjusted_momentum_20_40",
  "factor_name": "Volatility-Adjusted Relative Momentum 20/40",
  "version": "2029-08-23",
  "calculation": {
    "expression": "cross_sectional_demean(shift(rolling_sum(pct_change(close),20) / (sqrt(40)*rolling_std(pct_change(close),40), 1))",
    "description": "Ranks each tradable asset by its lagged 20-day cumulative return scaled by 40-day realized volatility; cross-sectional demeaning is applied after a one-day lag to prevent look-ahead."
  },
  "dependencies": ["close"],
  "parameters": {"momentum_window": 20, "volatility_window": 40, "volatility_annualization": "sqrt(40)", "lag_days": 1, "minimum_vol_observations": 20},
