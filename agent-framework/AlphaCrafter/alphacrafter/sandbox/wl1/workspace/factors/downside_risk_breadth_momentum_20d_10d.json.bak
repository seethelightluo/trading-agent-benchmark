{
  "factor_id": "downside_risk_breadth_momentum_20d_10d",
  "factor_name": "Downside-risk-adjusted breadth-confirmed momentum",
  "version": "1.0",
  "calculation": {
    "expression": "rank_cs(lag1(((log(close/close[-20]) - 0.35*log(close/close[-5])) / downside_rms_40) * (0.65 + 0.70*breadth_60) * own_trend_60))",
    "description": "Twenty-day momentum plus five-day reversal, divided by 40-day downside RMS volatility, scaled by the fraction of tradable assets above their 60-day moving average and gated by the asset's own 60-day trend. Signal is lagged one completed day and ranked cross-sectionally."
  },
  "dependencies": ["close"],
  "parameters": {
    "momentum_days": 20,
    "reversal_days": 5,
    "reversal_weight": 0.35,
    "downside_window": 40,
    "downside_min_periods": 20,
    "trend_window": 60,
    "trend_min_periods": 40,
    "breadth_base": 0.65,
    "breadth_scale": 0.70,
    "lag_days": 1,
    "universe_size": 15,
    "forward_horizon_days": 10
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2031-04-17",
    "last_validated": "2031-04-17",
    "metrics": {
      "ic": 0.031700,
      "icir": 0.084167,
      "horizon_days": 10,
      "observations": 1847,
      "assets": 15,
      "average_valid_instruments": 10.5587,
      "coverage": 0.521628,
      "turnover": 0.098462,
      "hit_ratio": 0.5365,
      "decay_ic_1d": 0.003565,
      "decay_ic_5d": 0.026689,
      "decay_ic_20d": 0.032920,
      "max_abs_library_correlation": null
    },
    "regime_notes": "Positive in 2020-22 (IC 0.073479), weak but positive in 2023-25 (0.003941), 2026-28 (0.011819), and 2029-30 (0.018880). 2031 sample has only 10 observations and is not relied upon. ICIR clears the benchmark gate narrowly; interpret conservatively given the 15-asset cross-section.",
    "signal_artifact": "scripts/miner_3_20310417_downside_risk_breadth_momentum_signal.csv"
  },
  "tags": ["momentum", "reversal", "downside-risk", "breadth", "cross-asset"]
}
