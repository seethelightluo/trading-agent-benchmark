{
  "factor_id": "miner_1_20260827_medium_downside_momentum_30d",
  "factor_name": "30-day downside-semideviation-adjusted momentum",
  "version": "1.0",
  "calculation": {
    "expression": "pct_change(close,30) / (sqrt(rolling_mean(min(pct_change(close,1),0)^2,60))*sqrt(252)+0.02)",
    "description": "Ranks assets by medium-horizon price momentum scaled by recent downside semideviation. Nonnegative daily returns contribute zero to downside risk; the stabilizer avoids explosive ratios. All inputs are lagged at the decision date."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "momentum_window": 30,
    "downside_window": 60,
    "annualization": 252,
    "stabilizer": 0.02,
    "minimum_downside_observations": 40
  },
