{
  "factor_id": "miner_2_20330902_downside_residual_reversal_30d",
  "factor_name": "Downside-volatility-normalized residual reversal 30d",
  "version": "1.0",
  "calculation": {
    "expression": "-rolling_sum_30(log_return_i - mean_cross_section(log_return), 30) / (sqrt(30) * rolling_std_60(min(residual_return, 0)))",
    "description": "Ranks assets higher when their recent 30-day return relative to the equal-weight tradable benchmark is weak, scaling by downside residual volatility. The signal is shifted one completed day to prevent look-ahead bias."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "residual_window": 30,
    "downside_vol_window": 60,
    "min_residual_observations": 25,
    "min_vol_observations": 30,
    "lag_days": 1,
    "forward_horizon": 10,
    "universe": 15
  },
