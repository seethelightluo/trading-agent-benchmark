{
  "factor_id": "downside_adjusted_trend_20d_40d",
  "factor_name": "20-Day Trend Adjusted by Downside Volatility",
  "version": "20290111",
  "calculation": {
    "expression": "lag1(pct_change(close,20) / (sqrt(252) * rolling_std(clip(pct_change(close,1), upper=0),40, min_periods=25) + 1e-12))",
    "description": "Ranks assets by their prior completed-day 20-trading-day return normalized by trailing 40-day downside volatility. Positive-return volatility is excluded from the risk denominator; the one-day lag prevents look-ahead."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "trend_window": 20,
    "downside_window": 40,
    "min_periods": 25,
    "annualization": 252,
    "lag_days": 1
  },
