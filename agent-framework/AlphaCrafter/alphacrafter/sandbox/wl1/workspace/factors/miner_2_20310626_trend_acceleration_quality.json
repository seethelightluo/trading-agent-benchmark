  "factor_name": "Volatility-Scaled Trend Acceleration with Reversal Quality",
  "version": "1.0",
  "calculation": {
    "expression": "rank_cs(lag1((log(close_t/close_t-20)-log(close_t/close_t-60)/3)/vol40 - 0.35*log(close_t/close_t-5)/vol20))",
    "description": "Ranks the lagged medium-term trend acceleration relative to a 60-day baseline, scales by 40-day realized volatility, and penalizes severe five-day reversals using 20-day volatility. The one-day lag prevents look-ahead."
