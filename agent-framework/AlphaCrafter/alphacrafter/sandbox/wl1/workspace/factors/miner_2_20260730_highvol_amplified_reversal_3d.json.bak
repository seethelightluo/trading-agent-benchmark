{
  "factor_id": "miner_2_highvol_amplified_reversal_3d",
  "factor_name": "VIX-Scaled 3-Day Reversal",
  "version": "20260730",
  "calculation": {
    "expression": "-(close / lag(close,3) - 1) * clip(VIX / rolling_median(VIX,60), 0.5, 2.5)",
    "description": "Ranks recent three-session losers positively for next-day reversal, with the signal amplified when VIX is elevated relative to its trailing 60-session median. VIX is observation-only and is never traded."
  },
  "dependencies": [
    "close",
    "VIX"
  ],
  "parameters": {
    "reversal_days": 3,
    "vix_median_days": 60,
    "vix_multiplier_floor": 0.5,
    "vix_multiplier_cap": 2.5,
    "minimum_cross_section": 8,
    "horizon_days": 1
  },
  "signal_provenance": {
    "source_script": "scripts/miner_2_20260730_highvol_reversal.py",
    "universe": [
