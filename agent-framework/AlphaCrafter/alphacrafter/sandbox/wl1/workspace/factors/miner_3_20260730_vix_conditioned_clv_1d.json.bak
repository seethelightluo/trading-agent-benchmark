{
  "factor_id": "miner_3_20260730_vix_conditioned_clv_1d",
  "factor_name": "VIX-conditioned intraday location exhaustion",
  "version": "1.0",
  "calculation": {
    "expression": "-CLV_t * (1 + 0.5 * clip((VIX_t - mean(VIX,60))/std(VIX,60), -2, 2))",
    "description": "Negative completed-session close location value, amplified when VIX is elevated relative to its trailing 60-observation mean. Higher values predict higher next-day cross-asset return.",
    "timing": "All inputs are from the completed session t; target is return from t close to t+1 close."
  },
  "dependencies": [
    "close",
    "high",
    "low",
    "VIX close"
  ],
  "parameters": {
    "clv_window": 1,
    "vix_z_window": 60,
    "vix_z_min_periods": 30,
    "amplification": 0.5,
    "z_clip": [
      -2,
      2
    ],
    "horizon_days": 1
  },
