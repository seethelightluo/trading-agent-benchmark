  "factor_name": "Breadth-Quality Volatility-Scaled Trend",
  "version": "2029-03-08",
  "calculation": {
    "expression": "shift1(pct_change(close,20) * rolling_mean(I[pct_change(close,1)>0],40) / (1 + annualized_std(pct_change(close,1),40)))",
    "description": "Ranks assets by medium-term return, requiring consistent positive daily breadth and scaling by total realized volatility. Signal is lagged one completed day to avoid look-ahead."
  },
  "dependencies": ["close"],
