{
  "factor_id": "drift_vol_compression_20_60_reval",
  "factor_name": "Drift Volatility Compression",
  "version": "2029-06-14",
  "calculation": {
    "expression": "lag1((mean_return_20/(std_return_10+0.002))*clip(std_return_60/(std_return_10+0.002),0.25,4.0))",
    "description": "Ranks positive recent drift favorably when short-term volatility is compressed relative to its longer-term volatility; the ratio is clipped for robustness and lagged one trading day."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "drift_window": 20,
    "short_vol_window": 10,
    "long_vol_window": 60,
    "min_drift_observations": 15,
    "min_long_vol_observations": 40,
    "vol_floor": 0.002,
    "compression_clip": [
      0.25,
      4.0
    ],
    "lag_days": 1
  },
  "validation": {
