{
  "factor_id": "miner_1_20260730_drawdown_recovery_20d",
  "factor_name": "Medium-Drawdown Recovery Quality",
  "version": "1.0",
  "calculation": {
    "expression": "(close_t / close_{t-10} - 1) / (0.02 + max(0, 1 - close_t / rolling_max(close, 60)))",
    "description": "Ranks assets by their 10-day rebound relative to stabilized distance below the trailing 60-day peak; the 0.02 floor prevents extreme leverage near the peak. Higher values indicate stronger recovery quality."
  },
  "dependencies": ["close"],
  "parameters": {"rebound_window": 10, "peak_window": 60, "peak_min_periods": 30, "stabilizer": 0.02, "forward_horizon_days": 20},
  "validation": {
