  "factor_id": "recovery_velocity_30_120",
  "factor_name": "Volatility-Scaled Recovery Velocity",
  "version": "2029-06-28",
  "calculation": {
    "expression": "lag1((return_30 / (std(return_1,30)*sqrt(252))) * (1 + drawdown_120))",
    "description": "Ranks assets by 30-day volatility-scaled return while rewarding recovery toward the 120-day high through a bounded drawdown multiplier. The signal is lagged one completed trading day to prevent lookahead. Drawdown is clipped at zero, so the multiplier is in (0,1]."
