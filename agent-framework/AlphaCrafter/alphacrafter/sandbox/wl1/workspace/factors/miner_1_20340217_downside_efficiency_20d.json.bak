{
  "factor_id": "miner_1_20340217_downside_efficiency_20d",
  "factor_name": "Downside-Volatility-Adjusted Path Efficiency 20d",
  "version": "1.0",
  "calculation": {
    "expression": "shift1((close/close.shift(20)-1) / (sum(abs(pct_change(close)),20) * downside_volatility_20)",
    "description": "Ranks assets by directional 20-session return divided by total absolute return path length and 20-session downside volatility. Higher values identify persistent positive trends with limited downside variability. The signal is lagged one completed session to prevent look-ahead bias and cross-sectional tails are clipped at the 5th and 95th percentiles."
  },
  "dependencies": ["close", "pct_change"],
  "parameters": {"lookback_days": 20, "downside_volatility_window": 20, "winsorize_quantiles": [0.05, 0.95], "signal_lag_days": 1, "forward_horizon_days": 20},
  "validation": {
