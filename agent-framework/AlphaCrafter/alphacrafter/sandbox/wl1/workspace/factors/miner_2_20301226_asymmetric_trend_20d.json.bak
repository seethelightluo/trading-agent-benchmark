{
  "factor_id": "miner_2_20301226_asymmetric_trend_20d",
  "factor_name": "Asymmetric Volatility-Adjusted Trend",
  "version": "1.0",
  "calculation": {
    "expression": "shift1((pct_change(close,20)/(std(returns,40)*sqrt(20))) * (1 + 0.75*(upside_volatility_40 - downside_volatility_40)/(upside_volatility_40 + downside_volatility_40)))",
    "description": "Twenty-session momentum normalized by 40-session realized volatility and adjusted for the asymmetry between upside and downside semivolatility. The signal is lagged one completed session to prevent look-ahead."
  },
  "dependencies": ["close", "daily_returns"],
  "parameters": {"momentum_window": 20, "volatility_window": 40, "semivolatility_min_periods": 25, "asymmetry_multiplier": 0.75, "lag_sessions": 1},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2030-12-25",
