{
  "factor_id": "miner_2_20340303_dispersion_efficiency_acceleration",
  "factor_name": "Dispersion-Conditioned Range-Efficiency Acceleration",
  "version": "2034-03-03",
  "calculation": {
    "expression": "lag1(clip5_95((E20-E60)*(0.65+0.70*rank_cs(mean_i(std10(return_i))))))",
    "description": "For each asset, subtract 60-day directional range efficiency from 20-day efficiency, then scale by the cross-sectional rank of recent cross-asset return dispersion. The signal is lagged one completed session and winsorized cross-sectionally.",
    "efficiency_definition": "Ew = pct_change(close,w) / (rolling_sum(abs(daily_return),w) * rolling_std(daily_return,w))"
  },
  "dependencies": ["close", "daily_return", "cross_asset_dispersion"],
  "parameters": {"short_window": 20, "long_window": 60, "dispersion_window": 10, "dispersion_weight_intercept": 0.65, "dispersion_weight_slope": 0.70, "winsor_lower": 0.05, "winsor_upper": 0.95, "signal_lag_days": 1, "forward_horizon_days": 10},
  "validation": {
