{
  "factor_id": "miner_1_20311211_exhaustion_contrarian_20d",
  "factor_name": "Downside-Adjusted Exhaustion Contrarian",
  "version": "1.0",
  "calculation": {
    "expression": "-((log(close/close[-60]) - 0.70*log(close/close[-10])) / (downside_std_40*sqrt(40) + 0.5*std_20*sqrt(20)))",
    "description": "Contrarian score for assets whose medium-term advance is not confirmed by recent momentum, scaled by downside and total realized volatility; signal lagged one completed session. Higher values indicate stronger recovery/exhaustion opportunity."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "medium_window": 60,
    "recent_window": 10,
    "recent_weight": 0.7,
    "downside_window": 40,
    "total_vol_window": 20,
    "total_vol_weight": 0.5,
    "lag": 1,
    "forward_horizon": 20
  },
