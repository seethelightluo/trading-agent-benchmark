{
  "factor_id": "conditional_dispersion_reversal_5d_10d",
  "factor_name": "Conditional High-Dispersion Residual Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "where(high_dispersion_lag1 AND benchmark_10d_return<0, -rolling_sum(residual_return,5) / mean(rolling_std(residual_return,20),60), NaN), lagged 1 day",
    "description": "Ranks assets for 10-trading-day forward returns by volatility-scaled five-day residual reversal relative to the equal-weight benchmark. Activates only when cross-asset dispersion is above its trailing 120-day median and the benchmark has negative trailing 10-day return. All inputs are lagged one completed day."
  },
  "dependencies": ["close"],
  "parameters": {"residual_benchmark": "equal_weight_mean_daily_log_return", "reversal_window_days": 5, "volatility_window_days": 20, "volatility_smoothing_days": 60, "dispersion_window_days": 120, "benchmark_condition_days": 10, "forward_horizon_days": 10, "lag_days": 1, "minimum_cross_section": 8},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2032-08-04",
    "validation_date": "2032-08-05",
    "metrics": {"ic": 0.0253318584, "icir": 0.0908668962, "hit_ratio": 0.5620052770, "valid_dates": 379, "average_instruments": 15.0, "universe_size": 15, "coverage_active_date_fraction": 0.2305947581, "rank_turnover": 0.1564760026, "max_abs_library_correlation": null},
    "regime_notes": "2024-2026: 26 dates, IC 0.09712, ICIR 0.38526; 2027-2029: 223 dates, IC 0.00991, ICIR 0.03514; 2030-2032: 130 dates, IC 0.03742, ICIR 0.13501. Small conditional sample warrants conservative interpretation, but latest regime clears both gates.",
    "signal_artifact": "scripts/miner_1_20320805_conditional_reversal_signal.csv"
  },
  "tags": ["reversal", "cross_asset", "dispersion", "residual", "stress_conditioned", "volatility_scaled"],
  "last_validated": "2032-08-05T00:00:00Z"
}
