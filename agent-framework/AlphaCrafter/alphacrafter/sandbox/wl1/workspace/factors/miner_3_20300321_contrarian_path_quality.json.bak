  "factor_name": "Contrarian Volatility-Normalized Path Quality",
  "version": "1.0",
  "calculation": {
    "expression": "-(return_20/(std(return_1,40)*sqrt(20)+0.01))*(1.5-positive_day_fraction_20)",
