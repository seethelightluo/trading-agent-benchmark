{
  "factor_id": "miner_3_20330610_medium_relative_contrarian_60_15d",
  "factor_name": "Volatility-scaled medium-horizon relative contrarian",
  "version": "1.0",
  "calculation": {
    "expression": "-((sum(log(close_t/close_t-1),60) + 0.5*sum(log(close_t/close_t-1),15)) / (std(residual_returns,60)*sqrt(60))) shifted by 1 completed day",
    "description": "Ranks instruments contrarily to their 60-day residual return with a 15-day component, where residual returns subtract the equal-weight cross-asset benchmark return; scales by 60-day residual volatility and lags one day to prevent look-ahead. Higher values indicate medium-horizon relative weakness likely to mean-revert over the next 10 trading days."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "long_window_days": 60,
    "short_window_days": 15,
    "short_component_weight": 0.5,
    "residual_volatility_window_days": 60,
    "volatility_scaling": "sqrt(60)",
    "signal_lag_days": 1,
    "forward_horizon_days": 10,
    "minimum_cross_section": 8,
    "universe_size": 15
  },
