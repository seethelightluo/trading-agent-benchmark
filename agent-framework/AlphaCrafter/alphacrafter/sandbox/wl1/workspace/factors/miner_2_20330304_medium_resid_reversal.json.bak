  "factor_name": "15-day residual risk-adjusted reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-rolling_sum(residual_log_return,15) / rolling_std(residual_log_return,60), lagged 1 day",
    "description": "Cross-sectional market-relative residual return reversal over 15 sessions, scaled by 60-session residual volatility and lagged to avoid look-ahead. Residual return is asset log return minus equal-weight universe log return."
