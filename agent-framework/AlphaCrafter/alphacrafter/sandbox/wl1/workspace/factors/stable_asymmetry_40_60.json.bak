{
  "factor_id": "stable_asymmetry_40_60",
  "factor_name": "Stable Return Asymmetry with Breadth",
  "version": "1.1",
  "calculation": {
    "expression": "shift1((rolling_mean_40(max(return,0))/(rolling_mean_40(max(-return,0))+1e-5))*(2*rolling_mean_40(I(return>0))-0.5)/(rolling_std_60(return)*sqrt(252)+0.01))",
    "description": "Rewards persistent upside magnitude and positive-day breadth, penalizes downside magnitude and total volatility; lagged one completed day."
  },
  "dependencies": [
    "close",
    "pct_change"
  ],
  "parameters": {
    "upside_window": 40,
    "volatility_window": 60,
    "lag_days": 1,
