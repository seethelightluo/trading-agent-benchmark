  "factor_name": "Path-Efficiency-Weighted Momentum",
  "version": "1.0",
  "calculation": {
    "expression": "rank_cs((close/lag(close,20)-1) * ((close/lag(close,20)-1) / rolling_sum(abs(daily_return),20)))",
    "description": "Ranks the 20-session signed momentum after weighting it by path efficiency, favoring directional moves achieved with less choppy absolute price travel. All rolling inputs use data available through the decision date.",
