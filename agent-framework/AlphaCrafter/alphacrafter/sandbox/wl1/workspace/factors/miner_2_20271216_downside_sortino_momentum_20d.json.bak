{
  "factor_id": "miner_2_20271216_downside_sortino_momentum_20d",
  "factor_name": "Downside-Risk-Adjusted 20-Day Momentum",
  "version": "2027-12-16",
  "calculation": {
    "expression": "(close/close.shift(20)-1) / (rolling_std(negative_daily_returns,40)*sqrt(20)+0.004), shifted by 1 session",
    "description": "Ranks instruments by their trailing 20-session return normalized by the volatility of negative daily returns over the trailing 40 sessions. The one-session lag ensures only completed data are used."
  },
  "dependencies": ["close", "daily_returns"],
  "parameters": {"momentum_window": 20, "downside_vol_window": 40, "min_periods": 25, "annualization_factor": 20, "stabilizer": 0.004, "signal_lag": 1},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2027-12-15",
    "last_validated": "2027-12-16T00:00:00Z",
    "metrics": {
      "admission_horizon_days": 20,
      "ic": 0.046496,
      "icir": 0.139636,
      "valid_dates": 2713,
      "average_instruments": 15.0,
      "coverage": 1.0,
      "turnover": 0.080591,
      "hit_ratio": 0.5396,
      "max_abs_library_correlation": null
    },
    "decay": {"5d_ic": 0.013488, "10d_ic": 0.034281, "20d_ic": 0.046496},
    "regime_notes": "Strong full-sample and pre-2026 performance, but negative drift in 2026-2027 and notably negative 2027 IC; use conservative regime conditioning and revalidate frequently."
  },
  "signal_artifact": "scripts/miner_2_20271216_downside_sortino_signal.csv",
  "tags": ["momentum", "downside-risk", "sortino", "cross-asset", "lagged"]
