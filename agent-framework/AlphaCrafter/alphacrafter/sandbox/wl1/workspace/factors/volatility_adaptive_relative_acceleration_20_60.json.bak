{
  "factor_id": "volatility_adaptive_relative_acceleration_20_60",
  "factor_name": "Volatility-adaptive relative momentum acceleration",
  "version": "1.0",
  "calculation": {
    "expression": "shift1(((r20-CSmedian(r20))-(r60-CSmedian(r60))) * clip(1 - 0.30*(clip((vol20/median120(vol20))-CSmedian(vol20/median120(vol20)),-2,2)/2),0.4,1.6))",
    "description": "Cross-sectionally centered 20-day minus 60-day return acceleration, multiplied by a bounded inverse relative-volatility adjustment. The signal is lagged one completed trading day to avoid look-ahead."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "short_return_days": 20,
    "long_return_days": 60,
    "volatility_window_days": 20,
    "volatility_baseline_days": 120,
    "volatility_min_periods": 60,
    "forward_horizon_days": 10,
    "min_cross_section": 8,
    "adjustment_strength": 0.3,
    "clip_low": 0.4,
    "clip_high": 1.6
  },
