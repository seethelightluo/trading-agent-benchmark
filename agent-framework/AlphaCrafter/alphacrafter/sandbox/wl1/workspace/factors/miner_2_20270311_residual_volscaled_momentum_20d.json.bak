{
  "factor_id": "miner_2_20270311_residual_volscaled_momentum_20d",
  "factor_name": "Residual Volatility-Scaled Momentum",
  "version": "1.0",
  "calculation": {
    "expression": "(sum_{j=1..20}(r_i[j] - beta_i[60] * r_bm[j])) / (std_{60}(r_i - beta_i[60] * r_bm) * sqrt(20))",
    "description": "Ranks each asset by trailing 20-session cumulative return unexplained by the equal-weight benchmark, scaled by trailing 60-session residual volatility. The signal is lagged one completed session before forward-return testing to prevent look-ahead."
  },
  "dependencies": ["close", "daily_returns"],
  "parameters": {
    "beta_lookback": 60,
    "beta_minimum_observations": 40,
    "momentum_lookback": 20,
    "volatility_lookback": 60,
    "volatility_minimum_observations": 40,
    "lag": 1,
    "benchmark": "equal_weight_mean_return_of_15_tradable_assets"
  },
  "signal_provenance": {
    "script": "scripts/miner_3_20270311_residual_volscaled_momentum.py",
    "universe": ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"],
    "cutoff": "2027-03-11",
    "forward_return_definition": "close[t+h]/close[t]-1",
    "cross_section_minimum": 8,
    "data_source": "../persistent/stock_data/{symbol}.csv"
  },
  "validation": {
