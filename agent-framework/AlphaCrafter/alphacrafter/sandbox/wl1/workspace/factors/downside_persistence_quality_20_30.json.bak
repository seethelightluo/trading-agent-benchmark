{
  "factor_id": "downside_persistence_quality_20_30",
  "factor_name": "Downside Persistence Quality Trend",
  "version": "20290531",
  "calculation": {
    "expression": "lag1((ROC20 clipped [-0.3,0.3]) * log(1 + (mean30_positive_return+0.001)/(mean30_negative_magnitude+0.001)) / (downside_std30 + 0.01))",
    "description": "Ranks assets by medium-term trend, gain/loss asymmetry, and low downside volatility. All inputs are lagged one trading day before portfolio use to avoid look-ahead bias."
  },
  "dependencies": [
    "close",
    "daily_returns"
  ],
  "parameters": {
    "trend_window": 20,
    "asymmetry_window": 30,
    "risk_window": 30,
