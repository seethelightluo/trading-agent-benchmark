{
  "factor_id": "miner_1_20320429_stress_or_dispersion_pullback_10d",
  "factor_name": "Stress-or-High-Dispersion Residual Pullback",
  "version": "1.0",
  "calculation": {
    "expression": "I((sum_{k=1..20} mean_cross_section(r_{t-k}) < 0) OR (mean20(std_cross_section(residual_returns)) > median120(mean20(std_cross_section(residual_returns))))) * [-sum_{k=1..10}(r_{t-k}-mean_cross_section(r_{t-k})) / mean20(sigma20(residual_returns))]",
    "description": "Volatility-normalized ten-day residual reversal, activated when the equal-weight cross-asset benchmark has negative trailing 20-day return or residual dispersion is above its trailing 120-day median. Signal is lagged one session and uses only completed data."
  },
  "dependencies": ["close"],
  "parameters": {
    "residual_window_days": 10,
    "benchmark_stress_window_days": 20,
    "volatility_window_days": 20,
    "dispersion_window_days": 20,
    "dispersion_threshold_window_days": 120,
    "activation": "negative benchmark 20d return OR dispersion above trailing 120d median",
    "forward_validation_horizon_days": 10,
    "minimum_cross_section": 8
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": {"start": "2020-01-01", "end": "2032-04-28"},
    "metrics": {
      "ic": 0.0327762229,
      "icir": 0.1185994693,
      "coverage": 1.0,
      "active_date_fraction": 0.7213955875,
      "average_instruments": 15.0,
      "dates": 1149,
      "turnover": 0.1065924552,
      "hit_ratio": 0.5387293299,
      "max_abs_library_correlation": null,
      "decay_ic_1d": 0.0055871239,
      "decay_ic_5d": 0.0218698988,
      "decay_ic_20d": 0.0319532848
    },
    "regime_notes": "10d IC/ICIR positive and above gates in the full sample; performance is expected to be conditional because the signal is active on stress or high-dispersion dates. The 15-asset cross-section is broad, but IC uncertainty remains material.",
    "admission_gates": {"absolute_daily_paper_ic": 0.007, "absolute_daily_paper_icir": 0.084}
  },
  "signal_artifact": "scripts/miner_1_20320429_stress_or_dispersion_signal.csv",
