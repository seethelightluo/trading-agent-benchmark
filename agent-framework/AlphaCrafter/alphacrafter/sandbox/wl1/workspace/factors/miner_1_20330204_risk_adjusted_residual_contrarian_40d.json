{
  "factor_id": "risk_adjusted_residual_contrarian_40d",
  "factor_name": "Risk-Adjusted 40-Day Residual Contrarian",
  "version": "1.0",
  "calculation": {
    "expression": "cross_sectional_demean(-(close/close.shift(40)-1)/(rolling_std(pct_change(close),20,min_periods=15)*sqrt(252))).shift(1)",
    "description": "Ranks assets by the inverse of their trailing 40-session return normalized by 20-session annualized volatility, after cross-sectional demeaning and a one-session information-availability lag. Higher values indicate volatility-adjusted recent losers and are used as a contrarian signal."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "lookback_days": 40,
    "volatility_window": 20,
    "volatility_min_periods": 15,
    "forward_horizon_days": 10,
    "lag_days": 1,
    "cross_sectional_demean": true
  },
