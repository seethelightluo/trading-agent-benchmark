{
  "factor_id": "consistency_amplified_relative_acceleration_20_60",
  "factor_name": "Trend-consistency amplified relative momentum acceleration",
  "version": "1.0",
  "calculation": {
    "expression": "shift1(((r20-CSmedian(r20))-(r60-CSmedian(r60))) * clip(0.70 + 0.60*rolling20_fraction_positive_returns,0.70,1.30))",
    "description": "Cross-sectionally centered 20-day minus 60-day return acceleration, modestly amplified for assets with a higher fraction of positive daily returns over the causal prior 20 sessions. Signal is lagged one completed trading day."
  },
  "dependencies": ["close"],
  "parameters": {
    "short_return_days": 20,
    "long_return_days": 60,
    "consistency_window_days": 20,
    "consistency_min_periods": 12,
    "amplifier_base": 0.70,
    "amplifier_slope": 0.60,
    "amplifier_low": 0.70,
    "amplifier_high": 1.30,
    "forward_horizon_days": 10,
    "min_cross_section": 8
  },
