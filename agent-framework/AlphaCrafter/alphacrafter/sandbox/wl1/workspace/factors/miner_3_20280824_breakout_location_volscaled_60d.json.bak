{
  "factor_id": "miner_3_20280824_breakout_location_volscaled_60d",
  "factor_name": "Volatility-Scaled 60-Day Breakout Location",
  "version": "1.0",
  "calculation": {
    "expression": "((close - rolling_min(close,60))/(rolling_max(close,60)-rolling_min(close,60))-0.5) / (rolling_std(pct_change(close),20)*sqrt(20))",
    "description": "Ranks assets by their lagged location within the trailing 60-session price range, centered at zero and normalized by 20-session realized volatility. Higher values represent persistent upside breakout location after risk adjustment; lower values represent downside range location. The signal is lagged one completed session."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "range_window": 60,
    "volatility_window": 20,
    "volatility_annualization": "sqrt(20)",
    "lag_sessions": 1,
    "minimum_range_observations": 40,
    "minimum_volatility_observations": 15
  },
  "validation": {
