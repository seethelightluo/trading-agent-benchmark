{
  "factor_id": "miner_2_20300221_accel_persistence_trend",
  "factor_name": "Volatility-Scaled Trend Acceleration with Persistence Gate",
  "version": "1.0",
  "calculation": {
    "expression": "((close/close.shift(20)-1) - (close/close.shift(60)-1)/3) / (rolling_std(pct_change,40)*sqrt(20)); retain only when sign(R20)==sign(R60); lag one day",
    "description": "Ranks assets whose recent 20-day trend is accelerating relative to its 60-day baseline, normalized by 40-day realized volatility. Signals are set to zero when short and medium trends disagree, reducing exposure to unstable reversals. The persisted signal is lagged one trading day to avoid look-ahead."
  },
  "dependencies": [
    "close",
    "pct_change"
  ],
  "parameters": {
    "short_window": 20,
    "long_window": 60,
    "vol_window": 40,
    "baseline_divisor": 3,
    "holding_horizons_days": [
      1,
      5,
      10,
      20
    ],
    "signal_lag_days": 1,
    "minimum_cross_section": 8
  },
  "signal_artifact": "scripts/miner_2_20300221_accel_persistence_signal.csv",
