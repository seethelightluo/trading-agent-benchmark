{
  "factor_id": "miner_2_20320902_residual_reversal_7d_smooth_dispersion",
  "factor_name": "Seven-Day Smooth High-Dispersion Residual Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-sum_{i=0..6}(r_asset[t-i]-mean_cross_section(r[t-i])) / rolling_std_20(residual_return) * clip(dispersion_t / rolling_median_120(dispersion)-0.85, 0, 1.5)",
    "description": "Ranks assets positively when their seven-day cumulative return relative to the equal-weight cross-asset benchmark is negative, normalized by 20-day residual volatility and activated smoothly when current cross-sectional dispersion is elevated. All inputs are lagged through the decision date."
  },
  "dependencies": ["close"],
  "parameters": {
    "universe_size": 15,
    "residual_window_days": 7,
    "residual_volatility_window_days": 20,
    "dispersion_window_days": 120,
    "dispersion_median_min_periods": 60,
    "activation_floor": 0.85,
    "activation_cap": 1.5,
    "forward_horizon_days": 10,
    "minimum_cross_section": 8
  },
  "signal_artifact": "scripts/miner_2_20320902_residual_reversal_7d_signal.csv",
  "validation": {
    "status": "EFFECTIVE",
    "validated_at": "2032-09-02",
    "period": "2022-08-12 through 2032-09-01",
    "metrics": {
      "ic_10d_spearman": 0.02716176021978841,
      "icir_10d": 0.08626228004897121,
      "ic_hit_ratio": 0.526438569206843,
      "valid_dates": 2572,
      "average_instruments_per_date": 15.0,
      "coverage": 1.0,
      "rank_turnover": 0.1635673559697047,
      "max_abs_library_correlation": null,
      "decay_note": "Not recomputed in this window comparison; same-horizon 10-day metrics are used for admission."
    },
    "regime_notes": {
      "2024-2026": {"dates": 684, "ic": 0.048994460568338595, "icir": 0.14737975845762152},
      "2027-2029": {"dates": 559, "ic": 0.02381510784238163, "icir": 0.089317050449971},
      "2030-2032": {"dates": 495, "ic": 0.03869334902655724, "icir": 0.144461395955607}
    }
  },
  "tags": ["cross_asset", "residual_reversal", "mean_reversion", "dispersion_conditioned", "volatility_normalized"]
}
