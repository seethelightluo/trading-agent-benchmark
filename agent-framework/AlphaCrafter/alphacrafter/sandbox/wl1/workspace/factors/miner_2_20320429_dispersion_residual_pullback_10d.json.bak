{
  "factor_id": "miner_2_20320429_dispersion_residual_pullback_10d",
  "factor_name": "High-Dispersion Volatility-Normalized Residual Pullback",
  "version": "1.0",
  "calculation": {
    "expression": "I(D_t > median120(D_t)) * [-sum_{k=1..10}(r_{t-k}-mean_cross_section(r_{t-k})) / (sigma20_t / sigma60_t)]",
    "description": "Contrarian ten-day residual return scaled by the ratio of short- to long-horizon volatility, activated only when the trailing cross-asset residual dispersion is above its 120-day median. The complete signal is lagged one trading day so it uses only completed data."
  },
  "dependencies": ["close"],
  "parameters": {"residual_window_days": 10, "short_volatility_days": 20, "long_volatility_days": 60, "dispersion_window_days": 20, "dispersion_threshold_window_days": 120, "activation": "dispersion above trailing median", "forward_validation_horizon_days": 10},
  "validation": {
    "status": "EFFECTIVE",
    "period": {"start": "2024-01-01", "end": "2032-04-28"},
    "metrics": {"ic": 0.0281952331, "icir": 0.0986762739, "coverage": 1.0, "average_instruments": 14.99297, "dates": 711, "turnover": 0.1046699, "hit_ratio": 0.5203938, "max_abs_library_correlation": null, "decay_ic_1d": 0.0068089204, "decay_ic_5d": 0.0211212121, "decay_ic_20d": 0.0288895970},
    "regime_notes": "10d IC/ICIR: 2024-2026 0.13072/0.51454 (67 dates); 2027-2029 0.02567/0.08374 (340 dates, marginal ICIR below gate); 2030-2032 0.00843/0.03198 (304 dates, drift weaker). Interpret conservatively given 15-asset cross-section."
  },
  "signal_artifact": "scripts/miner_2_20320429_dispersion_residual_pullback_signal.csv",
  "provenance": {"validated_at": "2032-04-29", "universe_size": 15, "assets_used": 15, "information_cutoff": "2032-04-28", "admission_thresholds": {"absolute_daily_paper_ic": 0.007, "absolute_daily_paper_icir": 0.084}},
  "tags": ["residual", "reversal", "volatility", "dispersion", "cross_asset"]
}
