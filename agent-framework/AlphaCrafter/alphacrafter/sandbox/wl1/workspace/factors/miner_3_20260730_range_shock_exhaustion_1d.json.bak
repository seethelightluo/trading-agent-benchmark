{
  "factor_id": "miner_3_range_shock_exhaustion_1d",
  "factor_name": "Range-Normalized Signed Shock Exhaustion",
  "version": "20260730_revalidated",
  "calculation": {
    "expression": "-pct_change(close,1) * ((high-low)/close) / rolling_median((high-low)/close,20)",
    "description": "Uses only the completed bar. Large directional moves relative to the asset's own recent range are treated as short-horizon exhaustion: positive values favor assets with large down shocks and negative values penalize large up shocks.",
