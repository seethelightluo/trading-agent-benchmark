{
  "factor_id": "miner_2_20290503_path_efficiency_30d",
  "factor_name": "Path-Efficiency Momentum 30D",
  "version": "2029-05-03",
  "calculation": {
    "expression": "(close/close.shift(30)-1) / rolling_sum(abs(pct_change(close)),30), then shift(1)",
    "description": "Ranks assets by net 30-session return per unit of total absolute daily movement, lagged one completed session to prevent look-ahead. Higher values indicate persistent directional travel rather than choppy movement."
  },
