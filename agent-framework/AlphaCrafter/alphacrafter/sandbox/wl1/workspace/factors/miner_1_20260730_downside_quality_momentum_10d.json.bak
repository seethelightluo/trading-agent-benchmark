  "factor_id": "miner_1_20260730_downside_quality_momentum_10d",
  "factor_name": "Downside-risk-adjusted 20-day momentum",
  "version": "1.0",
  "calculation": {
    "expression": "log(close/close[-20]) / (std(negative_returns_30d)*sqrt(20) + 0.01)",
    "description": "Ranks assets by medium-term log momentum adjusted for the dispersion of negative daily returns over the trailing 30 sessions; higher values indicate positive momentum achieved with lower downside risk.",
