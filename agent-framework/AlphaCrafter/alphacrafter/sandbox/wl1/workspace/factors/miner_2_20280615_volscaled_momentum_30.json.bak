{
  "factor_id": "miner_2_20280615_volscaled_momentum_30",
  "factor_name": "30-Day Volatility-Scaled Momentum",
  "version": "1.0",
  "calculation": {
    "expression": "(close / close.shift(30) - 1) / (rolling_std(pct_change(close), 30) + 1e-6), shifted by 1 session",
    "description": "Ranks assets by 30-day momentum normalized by trailing 30-day realized volatility. The one-session lag ensures only completed-session information is used."
  },
  "dependencies": ["close"],
  "parameters": {"momentum_window": 30, "volatility_window": 30, "vol_min_periods": 15, "epsilon": 1e-6, "lag": 1},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2028-06-14",
    "timestamp": "2028-06-15",
