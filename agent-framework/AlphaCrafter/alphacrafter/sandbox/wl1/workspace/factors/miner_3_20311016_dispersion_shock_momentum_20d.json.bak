{
  "factor_id": "miner_3_20311016_dispersion_shock_momentum_20d",
  "factor_name": "Dispersion-Damped Shock-Reversal Momentum",
  "version": "1.0",
  "calculation": {
    "expression": "((log(close/close[-30]) - 0.8*log(close/close[-5])) / rolling_std(log_returns,40)) * (1 + cross_sectional_dispersion_20d / rolling_median(cross_sectional_dispersion_20d,120))^-1",
    "description": "Lagged risk-adjusted medium-term momentum, subtracting recent five-day shock and damped during unusually dispersed cross-asset conditions. Cross-sectional rank is used by portfolio construction."
  },
  "dependencies": ["close"],
  "parameters": {"momentum_window": 30, "shock_window": 5, "shock_weight": 0.8, "volatility_window": 40, "dispersion_window": 20, "dispersion_baseline_window": 120, "lag_days": 1},
  "validation": {
