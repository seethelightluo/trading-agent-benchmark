{
  "factor_id": "miner_3_20290712_residual_momentum_volscaled_40",
  "factor_name": "40-Day Cross-Asset Residual Momentum Volatility-Scaled",
  "version": "1.0",
  "calculation": {
    "expression": "shift_1((asset_return_40d - equal_weight_cross_asset_return_40d) / (annualized_40d_std(asset_daily_return - equal_weight_cross_asset_daily_return) + 1e-8))",
    "description": "Ranks each tradable benchmark by its 40-trading-day return relative to the equal-weight return of the 15-asset tradable universe, normalized by 40-day annualized residual volatility. The one-day lag prevents use of the current incomplete session."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "lookback_days": 40,
    "volatility_window": 40,
    "min_periods": 24,
    "annualization": 252,
    "lag_days": 1,
    "universe_size": 15
  },
