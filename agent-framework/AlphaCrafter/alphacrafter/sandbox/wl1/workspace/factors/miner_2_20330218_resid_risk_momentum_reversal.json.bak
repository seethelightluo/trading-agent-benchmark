  "factor_name": "Residual risk-adjusted momentum reversal 10d",
  "version": "2033-02-18",
  "calculation": {
    "expression": "-rolling_sum(residual_log_return,10) / rolling_std(residual_log_return,40), lagged 1 day",
    "description": "For each tradable benchmark asset, subtract the equal-weight cross-sectional mean log return to obtain residual returns, reverse the trailing 10-day residual move, and scale by trailing 40-day residual volatility. The one-day lag prevents look-ahead bias."
  },
