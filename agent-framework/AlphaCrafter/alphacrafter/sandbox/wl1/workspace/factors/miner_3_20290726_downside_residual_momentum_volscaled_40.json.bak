{
  "factor_id": "miner_3_20290726_downside_residual_momentum_volscaled_40",
  "factor_name": "40-day downside-volatility-scaled cross-asset residual momentum",
  "version": "1.0",
  "calculation": {
    "expression": "(ret_40(asset) - mean_asset(ret_40) ) / downside_vol_40(asset), lagged_1d",
    "description": "Cross-asset 40-day momentum relative to the equal-weight benchmark, scaled by the asset's 40-day annualized downside residual volatility. The signal is lagged one completed trading day to prevent look-ahead bias."
