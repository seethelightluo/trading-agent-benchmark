{
  "factor_id": "miner_3_20330819_stress_dispersion_residual_pullback_15d",
  "factor_name": "Stress-or-dispersion gated residual pullback",
  "version": "1.0",
  "calculation": {
    "expression": "where((sum(benchmark_log_return,20)<0) OR (mean_i(std(residual_return_i,20)) > rolling_quantile_120(mean_i(std(residual_return_i,20)),0.60)), -sum(residual_return_i,15), 0), lag(1)",
    "description": "When the equal-weight benchmark is weak or cross-asset residual dispersion is elevated, rank the negative 15-day residual return as a pullback/recovery signal; otherwise deactivate. The one-day lag prevents look-ahead."
  },
  "dependencies": ["close"],
  "parameters": {"residual_window_days": 15, "benchmark_gate_days": 20, "dispersion_window_days": 20, "dispersion_quantile_window_days": 120, "dispersion_quantile": 0.60, "lag_days": 1, "forward_horizon_days": 10},
  "validation": {
    "status": "EFFECTIVE",
    "period": {"start": "2020-01-01", "end": "2033-08-18", "cutoff": "2033-08-18"},
