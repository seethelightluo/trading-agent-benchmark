{
  "factor_id": "dispersion_scaled_shock_reversal_5d",
  "factor_name": "Cross-Asset Dispersion-Scaled Shock Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-return_5d/(rolling_std_return_20d*sqrt(5)) * clip(1 + 0.75*zscore(cross_sectional_dispersion_60d), 0, 3), lagged 1 day",
    "description": "Ranks assets by contrarian five-day shock normalized by own recent volatility, with stronger reversal exposure when cross-asset daily return dispersion is elevated. All inputs are lagged before the forward-return test."
  },
  "dependencies": ["close"],
  "parameters": {"shock_window": 5, "vol_window": 20, "dispersion_window": 60, "dispersion_multiplier": 0.75, "forward_horizon": 10, "lag": 1},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 to 2033-12-09 (usable forward observations 2024-01-03 to 2033-11-24)",
    "last_validated": "2033-12-09T00:00:00Z",
    "metrics": {"ic": 0.023873, "icir": 0.085986, "hit_ratio": 0.5008, "dates": 1913, "average_instruments": 15.0, "coverage": 1.0, "turnover": 0.131668, "max_abs_library_correlation": null},
    "regime_notes": "Strong in 2024-2026 (IC 0.119468, ICIR 0.467906), weak but positive in 2027-2032, and recovered in 2033 (IC 0.064166, ICIR 0.231308). Small-universe uncertainty is material; admission is marginal on ICIR.",
    "signal_artifact": "scripts/miner_1_20331209_dispersion_shock_reversal_signal.csv",
    "ic_artifact": "scripts/miner_1_20331209_dispersion_shock_reversal_ic.csv"
  },
  "tags": ["reversal", "volatility", "cross-asset", "dispersion"],
