{
  "factor_id": "miner_3_20310904_recovery_pullback_20d",
  "factor_name": "Contrarian Recovery Pullback Risk-Adjusted Momentum",
  "version": "1.1",
  "calculation": {
    "expression": "rank_cs(-(log(close/close_60d) - 0.70*log(close/close_10d))/(downside_vol_40d + 0.5*volatility_20d + 1e-6)), lagged 1 day",
    "description": "Ranks the contrarian of a medium-term trend less its recent 10-day component, scaled by downside and total volatility. The negative formulation favors assets whose strong 60-day trend is associated with a pullback/recovery configuration, while avoiding high downside-risk signals. Signal is lagged one completed session."
  },
  "dependencies": [
    "close",
    "daily_returns"
  ],
  "parameters": {
    "medium_window": 60,
    "short_window": 10,
    "short_weight": 0.7,
    "downside_window": 40,
    "volatility_window": 20,
    "volatility_weight": 0.5,
    "lag": 1,
    "minimum_cross_section": 8
  },
