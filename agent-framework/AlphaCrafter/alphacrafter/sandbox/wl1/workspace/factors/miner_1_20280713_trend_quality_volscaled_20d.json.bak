{
  "factor_id": "miner_1_20280713_trend_quality_volscaled_20d",
  "factor_name": "Trend Quality Volatility-Scaled Efficiency",
  "version": "1.0",
  "calculation": {
    "expression": "shift_1((close_t/close_{t-20}-1) / (std(daily_returns_{t-19:t})*sqrt(20)) * abs(close_t/close_{t-20}-1) / (sum(abs(daily_returns_{t-19:t}))+1e-8))",
    "description": "Ranks assets by lagged 20-session return scaled by annualized realized volatility and multiplied by path efficiency. The one-session lag ensures the signal uses only completed data at decision time; higher values favor directional, lower-chop trends."
  },
  "dependencies": [
    "close",
    "daily_returns"
  ],
  "parameters": {
    "lookback_days": 20,
    "volatility_window_days": 20,
    "minimum_volatility_observations": 10,
    "signal_lag_days": 1,
    "epsilon": 1e-08
  },
