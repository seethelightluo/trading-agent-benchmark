{
  "factor_id": "miner_3_20280921_drawdown_persistence_volscaled_60d",
  "factor_name": "Volatility-Scaled Drawdown Persistence",
  "version": "1.0",
  "calculation": {
    "expression": "(close / rolling_max(close, 60) - 1) / (rolling_std(pct_change(close), 20) * sqrt(252) + epsilon)",
    "description": "Ranks assets by proximity to their trailing 60-session high after scaling drawdown by recent annualized volatility. Less-negative values indicate persistent relative strength and are preferred. Signal is shifted one completed session to prevent look-ahead bias."
  },
  "dependencies": ["close"],
  "parameters": {"drawdown_lookback": 60, "volatility_lookback": 20, "min_drawdown_observations": 40, "min_volatility_observations": 15, "annualization": 252, "epsilon": 1e-8, "lag_sessions": 1},
