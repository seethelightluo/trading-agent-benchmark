  "factor_name": "Common-Beta-Neutralized Residual Momentum",
  "version": "1.0",
  "calculation": {
    "expression": "rolling_sum_20(return_i - beta_60_i_to_EW * return_EW).shift(1)",
    "description": "For each tradable benchmark instrument, estimate 60-session rolling beta to the equal-weight return of all 15 tradable instruments, subtract beta-scaled common return from the instrument return, sum the residual returns over 20 sessions, and lag one completed session. Higher values indicate stronger idiosyncratic momentum after removing common cross-asset beta exposure."
  },
  "dependencies": ["close", "daily_returns"],
  "parameters": {"universe_size": 15, "beta_window": 60, "beta_min_periods": 40, "residual_window": 20, "residual_min_periods": 15, "signal_lag_sessions": 1, "forward_horizon_admission": 10},
