{
  "factor_id": "miner_1_20260730_long_recovery_20d",
  "factor_name": "Long-Horizon Drawdown Recovery Quality",
  "version": "1.0",
  "calculation": {
    "expression": "(close_t / close_{t-20} - 1) / (0.03 + max(0, 1 - close_t / rolling_max(close, 120)))",
    "description": "Ranks assets by their 20-day rebound relative to the stabilized distance below the trailing 120-day peak. The stabilizer limits sensitivity near the peak; higher values indicate persistent recovery rather than a one-day bounce."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "rebound_window": 20,
    "peak_window": 120,
    "peak_min_periods": 60,
    "stabilizer": 0.03,
    "forward_horizon_days": 20
  },
  "validation": {
