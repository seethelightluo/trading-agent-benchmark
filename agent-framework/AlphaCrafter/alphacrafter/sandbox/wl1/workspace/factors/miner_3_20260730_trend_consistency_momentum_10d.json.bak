{
  "factor_id": "miner_3_20260730_trend_consistency_momentum_10d",
  "factor_name": "Trend-Consistency Blended Momentum",
  "version": "1.0",
  "calculation": {
    "expression": "0.5 * rank(close/close.shift(20)-1) + 0.5 * rank(rolling_mean(positive_daily_return_indicator,20))",
    "description": "Cross-sectional average rank of 20-session cumulative momentum and the fraction of positive-return sessions over the same window. Rewards assets with both strong return and persistent directional trend; signals use completed observations and predict forward 10-session returns."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "momentum_lookback_sessions": 20,
    "positive_session_window": 20,
    "positive_session_min_periods": 10,
    "rank_combination": "equal_weight",
    "forward_horizon_sessions": 10,
    "minimum_cross_section": 8
  },
