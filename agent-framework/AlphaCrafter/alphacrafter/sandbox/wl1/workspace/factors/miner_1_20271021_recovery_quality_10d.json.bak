      "coverage": 0.9999,
      "rank_turnover": 0.116143,
      "max_abs_library_correlation": null,
      "decay": {"5d_ic": 0.011194, "10d_ic": 0.018317, "20d_ic": 0.035753},
      "regime_subperiods": {"2025+": {"ic": 0.032446, "icir": 0.105132, "dates": 871}, "2026+": {"ic": 0.002484, "icir": 0.00786, "dates": 506}, "2027": {"ic": -0.042857, "icir": -0.15728, "dates": 189}}
    },
    "regime_notes": "Full-sample admission passes, but the factor is inverted in 2027; use only with regime conditioning and conservative weight until revalidated."
