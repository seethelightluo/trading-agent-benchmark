{
  "factor_id": "miner_1_20271021_recovery_quality_10d",
  "factor_name": "Recovery Quality: Return per Drawdown and Volatility",
  "version": "20271021",
  "calculation": {
    "expression": "lag1(pct_change(close,10) / (abs(close/rolling_max(close,60)-1)+0.02) / (rolling_std(pct_change(close,1),20)+0.003))",
    "description": "Ranks assets by recent ten-session recovery quality, rewarding positive recovery relative to drawdown from the 60-session high and realized volatility. All inputs are lagged one completed session for point-in-time use."
  },
  "dependencies": ["close"],
  "parameters": {"return_window": 10, "drawdown_high_window": 60, "volatility_window": 20, "drawdown_floor": 0.02, "volatility_floor": 0.003, "lag_sessions": 1},
  "signal_artifact": "scripts/miner_1_20271021_recovery_quality10_signal.csv",
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 to 2027-10-20",
    "last_validated": "2027-10-21T00:00:00Z",
    "metrics": {
      "admission_horizon_sessions": 20,
      "ic": 0.035753,
