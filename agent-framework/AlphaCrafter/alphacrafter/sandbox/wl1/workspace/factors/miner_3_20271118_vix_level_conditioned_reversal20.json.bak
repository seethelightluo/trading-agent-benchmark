{
  "factor_id": "miner_3_20271118_vix_level_conditioned_reversal20",
  "factor_name": "VIX-Level-Conditioned 20-Day Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "(-sum_{k=0..19}(close_t-k/close_t-k-1-1)) * (1 + 0.75 * percentile_rank(VIX_t, trailing_252_sessions))", 
    "description": "Ranks recent 20-session reversal more strongly when the observation-only VIX level is high; the complete cross-sectional signal is shifted by one session to prevent look-ahead. Higher values indicate stronger reversal preference. VIX is never traded."
  },
  "dependencies": ["close", "VIX.close"],
  "parameters": {"return_window": 20, "vix_rank_window": 252, "vix_min_periods": 80, "conditioning_multiplier": 0.75, "signal_lag_sessions": 1, "universe_size": 15},
  "validation": {
    "status": "EFFECTIVE",
    "period": {"start": "2020-01-01", "end": "2027-11-17", "cutoff": "2027-11-17"},
    "metrics": {
      "selected_horizon_days": 20,
      "ic": -0.041887,
      "icir": -0.119022,
      "valid_dates": 2637,
      "average_instruments": 15.0,
      "coverage": 1.0,
      "turnover": 0.080539,
      "ic_hit_ratio": 0.4516,
      "max_abs_library_correlation": null,
      "decay": {"5d_ic": -0.002457, "10d_ic": -0.023978, "20d_ic": -0.041887}
    },
    "regime_notes": "Full-sample 20-day rank IC is negative, so downstream use should be sign-aware if higher signal is interpreted as a portfolio preference. Recent 2027 and Q3 2027 IC turned positive (0.021411 and 0.031384), indicating regime dependence; monitor sign drift and avoid unconstrained standalone use.",
    "validation_timestamp": "2027-11-18T00:00:00Z"
  },
  "signal_provenance": {"artifact": "scripts/miner_3_20271118_vix_level_reversal_signal.csv", "schema": "date plus 15 instrument columns", "lagged": true},
  "tags": ["reversal", "volatility-conditioned", "macro-regime", "cross-asset", "long-only-compatible"]
}
