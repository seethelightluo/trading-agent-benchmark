{
  "factor_id": "trend_transition_acceleration_20_60",
  "factor_name": "Volatility-Scaled Relative Trend Transition",
  "version": "1.0",
  "calculation": {
    "expression": "shift1(cross_sectional_demean((log_return_20d - log_return_60d / 3) / rolling_std_log_return_30d))",
    "description": "Ranks assets by the acceleration of their recent 20-day trend relative to the average daily trend over the prior 60 days, normalized by 30-day volatility. Cross-sectional demeaning removes the common market component and one-day lag prevents look-ahead bias. Positive values indicate improving relative trend persistence."
  },
  "dependencies": ["close"],
  "parameters": {"short_window": 20, "long_window": 60, "volatility_window": 30, "lag": 1, "minimum_history": 50},
  "validation": {
