  "dependencies": ["close"],
  "parameters": {"formation_days": 5, "volatility_days": 20, "benchmark_trend_days": 20, "dispersion_window": 120, "dispersion_quantile": 0.60, "forward_horizon_days": 10, "lag_days": 1},
