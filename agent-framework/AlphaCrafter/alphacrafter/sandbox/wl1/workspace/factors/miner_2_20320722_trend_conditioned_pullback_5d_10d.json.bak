  "version": "1.0",
  "calculation": {
    "expression": "-rolling_sum(residual_log_return_5d,5)/rolling_mean(asset_volatility_20d,20), lagged_one_day, active iff benchmark_log_return_20d > 0 and residual_dispersion > trailing_120d_60th_percentile",
