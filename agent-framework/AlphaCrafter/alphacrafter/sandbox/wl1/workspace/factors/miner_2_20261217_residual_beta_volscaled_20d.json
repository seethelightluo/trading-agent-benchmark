  "factor_name": "Equity-Beta Residual Volatility-Scaled Strength",
  "version": "1.0",
  "calculation": {
    "expression": "shift(1, rolling_sum_20(residual_return) / (rolling_std_20(asset_return) * sqrt(20))) where residual_return = asset_return - rolling_beta_40(asset_return,equity_basket_return) * equity_basket_return",
    "description": "For each tradable asset, remove its rolling 40-day beta exposure to the equal-weighted eight-equity benchmark basket, sum the residual daily returns over 20 days, and scale by 20-day total return volatility. The one-day lag ensures only completed information is used."
