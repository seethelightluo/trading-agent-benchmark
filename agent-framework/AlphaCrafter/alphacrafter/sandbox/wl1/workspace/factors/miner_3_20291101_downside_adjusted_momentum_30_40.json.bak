{
  "factor_id": "miner_3_20291101_downside_adjusted_momentum_30_40",
  "factor_name": "Downside-adjusted 30-day momentum",
  "version": "1.0",
  "calculation": {
    "expression": "(close / close.shift(30) - 1) / sqrt(rolling_mean(clip(pct_change, upper=0)^2, 40))",
    "description": "Lagged cross-asset momentum measured over 30 trading days and scaled by trailing 40-day downside deviation. Signal is shifted one completed day to prevent look-ahead."
  },
  "dependencies": ["close"],
  "parameters": {"momentum_window": 30, "downside_window": 40, "min_periods": 25, "lag_days": 1},
