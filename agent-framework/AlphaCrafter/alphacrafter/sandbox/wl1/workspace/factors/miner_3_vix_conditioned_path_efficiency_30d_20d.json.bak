{
  "factor_id": "miner_3_vix_conditioned_path_efficiency_30d_20d",
  "factor_name": "VIX-Conditioned Path-Efficiency Trend",
  "version": "20270506_revalidated",
  "calculation": {
    "expression": "shift(1, (rolling_sum(pct_change(close),30) / rolling_sum(abs(pct_change(close)),30)) * (1 - rolling_percentile_rank(VIX,60)))",
    "description": "Thirty-session directional path efficiency, attenuated by the inverse 60-session VIX percentile. All inputs are lagged one completed session before use. Higher values indicate persistent positive trends in calmer volatility states; negative values indicate persistent declines.",
