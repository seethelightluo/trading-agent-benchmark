  },
  "dependencies": ["close", "VIX close"],
  "parameters": {"path_window": 30, "vix_rank_window": 60, "minimum_path_observations": 20, "minimum_vix_observations": 40, "signal_lag": 1, "admission_horizon_days": 20},
