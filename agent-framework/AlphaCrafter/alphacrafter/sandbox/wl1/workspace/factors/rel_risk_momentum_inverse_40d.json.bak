{
  "factor_id": "rel_risk_momentum_inverse_40d",
  "factor_name": "Inverse relative risk-adjusted momentum",
  "version": "1.0",
  "calculation": {
    "expression": "-[(relative_return_40d / (relative_volatility_40d*sqrt(40))) * (1 + 0.30*I(relative_return_10d > 0))]",
    "description": "Cross-sectional inverse of benchmark-relative 40-day momentum scaled by 40-day residual volatility, with a 30% positive short-term trend gate; lagged one day to prevent look-ahead. The inverse direction is retained because it was the validated predictive orientation."
  },
  "dependencies": ["close"],
  "parameters": {"benchmark": "equal_weight_mean_log_return", "momentum_window": 40, "volatility_window": 40, "short_trend_window": 10, "trend_gate_multiplier": 0.30, "signal_lag_days": 1, "forward_horizon_days": 10},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 to 2033-05-26",
    "validated_on": "2033-05-27",
    "metrics": {
      "ic": 0.042136,
      "icir": 0.153536,
      "ic_hit_ratio": 0.5736,
      "turnover": 0.0651,
