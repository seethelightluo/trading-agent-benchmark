{
  "factor_id": "smooth_dispersion_volnorm_pullback_10d",
  "factor_name": "Smooth Dispersion Volatility-Normalized Residual Pullback",
  "version": "1.0",
  "calculation": {
    "expression": "shift(-sum(log_return - equal_weight_cross_asset_return,10) / rolling_mean(rolling_std(residual,20),60),1) * clip(dispersion_20 / rolling_median(dispersion_20,180),0.6,1.8)",
    "description": "Ranks assets by lagged residual ten-day pullback, volatility normalized with a 60-day mean of 20-day residual volatility, and smoothly scaled by current 20-day residual dispersion relative to its 180-day median. Positive values indicate stronger expected residual recovery."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "pullback_window": 10,
    "volatility_window": 20,
