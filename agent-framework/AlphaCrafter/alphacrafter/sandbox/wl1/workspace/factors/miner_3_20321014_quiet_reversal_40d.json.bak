  "parameters": {"residual_lookback_days": 40, "volatility_lookback_days": 40, "dispersion_lookback_days": 20, "dispersion_threshold_window_days": 120, "forward_horizon_days": 10, "minimum_cross_section": 8, "signal_artifact": "scripts/miner_3_20321014_quiet_reversal_signal.csv"},
