  "version": "2032-10-14",
  "calculation": {
    "expression": "-((sum_40(log_return_i)-mean_cross_section(sum_40(log_return)))/mean_40(volatility_i)) * I[lagged_1(20d_residual_dispersion < rolling_120_median)]",
    "description": "In quiet cross-asset regimes, rank assets for contrarian exposure using the negative 40-day residual trend scaled by average 40-day volatility. The regime indicator is lagged one session to avoid look-ahead. Zero signal outside quiet regimes."
