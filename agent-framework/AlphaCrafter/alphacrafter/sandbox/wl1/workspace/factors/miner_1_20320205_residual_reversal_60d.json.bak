{
  "factor_id": "miner_1_20320205_residual_reversal_60d",
  "factor_name": "Volatility-Normalized Cross-Sectional Residual Reversal 60D",
  "version": "1.0",
  "calculation": {
    "expression": "-((log(close_t/close_{t-60}) - cross_sectional_median(log(close_t/close_{t-60})))/(std(diff(log(close)),60)*sqrt(60))) lagged 1 session",
    "description": "Contrarian signal for instruments whose 60-day log return is below the daily cross-sectional median, normalized by 60-day realized volatility and lagged to prevent look-ahead. Higher values indicate stronger relative losers."
  },
  "dependencies": ["close"],
  "parameters": {"lookback_days": 60, "volatility_window": 60, "volatility_min_periods": 40, "cross_sectional_center": "median", "signal_lag_days": 1},
  "validation": {
    "status": "EFFECTIVE",
    "period": {"start": "2026-01-01", "end": "2032-02-05"},
    "metrics": {
      "admission_horizon_days": 20,
      "ic": 0.093786,
      "icir": 0.322745,
      "hit_ratio": 0.6453,
      "valid_dates": 1401,
      "average_instruments": 14.99,
      "coverage": 0.9995,
      "turnover": "not separately estimated; daily rank signal available in artifact",
      "max_abs_library_correlation": null,
      "decay_ic": {"1": 0.012025, "5": 0.043283, "10": 0.056017, "20": 0.093786, "40": 0.135937}
    },
    "regime_notes": "Positive across all evaluated online-era regimes; 20-day IC/ICIR were 0.034712/0.109431 in 2026-2028, 0.125494/0.487518 in 2029-2030, and 0.167700/0.643452 in 2031-2032-02-05. Small 15-asset cross-section implies conservative inference.",
    "validation_timestamp": "2032-02-05",
    "signal_artifact": "scripts/miner_1_20320205_residual_reversal_60d_signal.csv",
    "no_future_data": true
  },
  "tags": ["reversal", "cross-sectional", "volatility-adjusted", "multi-asset"]
}
