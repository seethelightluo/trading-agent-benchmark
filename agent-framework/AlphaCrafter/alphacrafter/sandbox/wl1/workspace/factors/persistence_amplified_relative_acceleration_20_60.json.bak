{
  "factor_id": "persistence_amplified_relative_acceleration_20_60",
  "factor_name": "Path-persistence amplified relative momentum acceleration",
  "version": "2035-11-23.v1",
  "calculation": {
    "expression": "[(R20 - CSMedian(R20)) - (R60 - CSMedian(R60))] * clip(0.5 + 2.0*abs(C40 - 0.5), 0.5, 1.5), lagged 1 day",
    "description": "Cross-sectional relative acceleration between 20-day and 60-day returns, multiplied by a bounded causal 40-session directional persistence amplitude. The amplitude rewards either persistent positive or persistent negative paths while preserving the acceleration sign. Signal is shifted one completed session before forward-return evaluation."
  },
  "dependencies": ["close"],
  "parameters": {"short_window": 20, "long_window": 60, "persistence_window": 40, "persistence_min_periods": 24, "forward_horizon": 10, "minimum_cross_section": 8, "lag_days": 1, "amplitude_floor": 0.5, "amplitude_slope": 2.0, "amplitude_cap": 1.5},
