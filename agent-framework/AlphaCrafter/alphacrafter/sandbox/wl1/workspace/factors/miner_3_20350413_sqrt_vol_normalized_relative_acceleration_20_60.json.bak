{
  "factor_id": "miner_3_20350413_sqrt_vol_normalized_relative_acceleration_20_60",
  "factor_name": "Square-root volatility-normalized relative momentum acceleration",
  "version": "1.0",
  "calculation": {
    "expression": "lag1(((R20-CSMedian(R20))-(R60-CSMedian(R60)))/clip(sqrt(VOL20/CSMedian(VOL20)),sqrt(0.5),sqrt(2.0)))",
    "description": "Compute cross-sectional relative 20-day versus 60-day momentum acceleration, then divide by the square root of the cross-sectional relative 20-day annualized volatility. The volatility ratio is clipped before square-root scaling to reduce noisy over-penalization of volatile assets; signal is lagged one trading day to avoid look-ahead."
  },
  "dependencies": ["close"],
  "parameters": {"short_window": 20, "long_window": 60, "vol_window": 20, "vol_annualization": 252, "vol_clip_low": 0.5, "vol_clip_high": 2.0, "signal_lag_days": 1, "forward_horizon_days": 10, "minimum_cross_section": 8},
