  "factor_name": "Volatility-Term-Structure Shock Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "clip((-r20 / (ann_vol20 + 0.04)) * clip(ann_vol20 / (ann_vol60 + 0.04), 0.5, 2.0), -5, 5), lagged one completed session",
    "description": "Fades the trailing 20-session return, risk-scaled by 20-session annualized volatility, and strengthens the reversal when short-term volatility is elevated relative to its 60-session baseline. The one-session lag prevents look-ahead."
