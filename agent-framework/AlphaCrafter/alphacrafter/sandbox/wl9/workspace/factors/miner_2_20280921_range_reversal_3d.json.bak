{
  "factor_id": "range_reversal_3d",
  "factor_name": "Volatility-scaled 3-day reversal with 60-day range-position contrarian overlay",
  "version": "1.0",
  "calculation": {
    "expression": "-(close/close.shift(3)-1)/rolling_std(pct_change,20) + (0.5 - (close-rolling_min(close,60))/(rolling_max(close,60)-rolling_min(close,60)))",
    "description": "Ranks assets higher when their recent 3-day return is low after volatility normalization and when their current price is near the lower portion of its 60-day trading range. Uses only completed historical prices at each signal date."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "reversal_window_days": 3,
    "volatility_window_days": 20,
    "range_window_days": 60,
    "minimum_cross_section": 8
  },
