{
  "factor_id": "miner_3_20310724_quadratic_breadth_reversal_60d",
  "factor_name": "Quadratic Breadth-Gated Volatility-Scaled Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "(-return_60d / annualized_volatility_40d) * (1 + 2 * (1 - positive_return_breadth_60d)^2), lagged 1 session",
    "description": "For each tradable benchmark instrument, take the negative 60-session return, scale by 40-session annualized return volatility, and amplify reversal when the cross-sectional breadth of positive 60-session returns is low. The breadth penalty is quadratic, and the resulting signal is lagged one completed session to avoid look-ahead."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "return_lookback_sessions": 60,
    "volatility_lookback_sessions": 40,
    "volatility_annualization": 252,
    "breadth_lookback_sessions": 60,
    "breadth_transform": "quadratic bearish breadth penalty",
    "breadth_amplitude": 2.0,
    "signal_lag_sessions": 1,
    "minimum_cross_section": 8
  },
  "validation": {
