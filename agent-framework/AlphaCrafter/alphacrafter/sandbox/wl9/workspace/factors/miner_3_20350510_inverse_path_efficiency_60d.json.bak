{
  "factor_id": "miner_3_20350510_inverse_path_efficiency_60d",
  "factor_name": "Inverse Path Efficiency Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-((close_t / close_{t-60}) - 1) / (sum_{k=t-59..t} abs(return_k) + 1e-8), lagged 1 session",
    "description": "Ranks assets with low directional path efficiency and recent losses highest, under the hypothesis that choppy/dislocated 60-day paths mean-revert over subsequent horizons. The raw path-efficiency ratio is negated; values are clipped to [-1,1]."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "lookback_days": 60,
    "path_min_periods": 45,
    "lag_days": 1,
    "clip": [
      -1,
      1
    ],
    "forward_horizon_admission_days": 10
  },
  "validation": {
    "status": "EFFECTIVE",
