{
  "factor_id": "miner_2_20290308_dispersion_scaled_reversal_5d",
  "factor_name": "Dispersion-scaled relative reversal 5d",
  "version": "1.0",
  "calculation": {
    "expression": "-(ret_5d - cross_sectional_median(ret_5d)) / (realized_vol_20d + epsilon)",
    "description": "Fade each instrument's five-session return relative to the cross-sectional median, scaling the reversal score by trailing 20-session realized volatility. Higher values indicate more negative residual performance per unit of risk and are expected to outperform over the next five sessions."
  },
  "dependencies": [
    "close",
    "pct_change"
  ],
  "parameters": {
    "residual_lookback_days": 5,
    "volatility_lookback_days": 20,
    "forward_horizon_days": 5,
    "epsilon": 1e-12,
    "minimum_cross_section": 8
  },
