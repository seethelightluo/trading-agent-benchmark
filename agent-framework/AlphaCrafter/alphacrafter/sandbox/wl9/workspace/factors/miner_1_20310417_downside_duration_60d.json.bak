{
  "factor_id": "miner_1_20310417_downside_duration_60d",
  "factor_name": "Breadth-stressed downside-volatility-scaled drawdown duration reversal",
  "version": "1.0",
  "calculation": {
    "expression": "shift_1((drawdown_duration_60 / downside_volatility_20) * (1 + (1 - breadth_20)))",
    "description": "For each tradable asset, count sessions since its most recent 60-session high, divide by 20-session annualized downside volatility (standard deviation of negative daily returns), and multiply by one plus one minus the cross-sectional fraction of assets with positive 20-session returns. Lag the signal one session. Higher values indicate longer drawdowns adjusted for downside risk, with stronger contrarian emphasis during broad market stress."
  },
  "dependencies": ["close", "daily_returns"],
  "parameters": {"high_lookback": 60, "downside_volatility_lookback": 20, "breadth_lookback": 20, "forward_horizon": 60, "lag": 1, "annualization": 252, "minimum_cross_section": 8},
