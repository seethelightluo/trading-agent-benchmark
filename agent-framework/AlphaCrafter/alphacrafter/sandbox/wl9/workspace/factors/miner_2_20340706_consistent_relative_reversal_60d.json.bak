{
  "factor_id": "miner_2_20340706_consistent_relative_reversal_60d",
  "factor_name": "Consistent Relative Momentum Reversal 60D",
  "version": "1.0",
  "calculation": {
    "expression": "(-pct_change(close,20) * (0.5 + rolling_mean(pct_change(close)>0,20))) shifted by one session",
    "description": "Cross-asset reversal signal that assigns larger positive scores to assets with negative, directionally consistent 20-session returns. The signal is lagged one completed session to avoid look-ahead bias."
  },
  "dependencies": ["close"],
  "parameters": {"return_window": 20, "persistence_window": 20, "minimum_persistence_observations": 15, "lag_sessions": 1, "forward_horizon": 60},
