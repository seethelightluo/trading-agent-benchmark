{
  "factor_id": "miner_3_20300418_path_asymmetry_reversal_60d",
  "factor_name": "Path Asymmetry Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(rolling_mean(positive_return_indicator,20)-rolling_mean(negative_return_indicator,20))*(abs(return_20d)+0.01), lagged 1 day",
    "description": "Contrarian signal that reverses the imbalance between up and down sessions over 20 days, with magnitude scaled by the absolute 20-day cumulative return. Signal is lagged one completed session to avoid lookahead."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "path_window_days": 20,
    "forward_horizon_days": 60,
    "lag_days": 1,
    "magnitude_floor": 0.01
  },
