{
  "factor_id": "miner_3_20301212_range_compression_reversal_60d",
  "factor_name": "Range-Compression Trend Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(rolling_sum(close.pct_change(),40) / rolling_std(close.pct_change(),30)) * clip(1.5 - (mean((high-low)/close,20) / median((high-low)/close,90)), 0.25, 1.5), lagged 1 session",
    "description": "Fades a 40-day risk-adjusted trend, with the contrarian signal strongest following compressed normalized trading ranges. The one-session lag prevents using the decision day's close."
  },
  "dependencies": [
    "close",
    "high",
    "low"
  ],
  "parameters": {
    "trend_window": 40,
    "volatility_window": 30,
    "recent_range_window": 20,
    "baseline_range_window": 90,
    "compression_center": 1.5,
    "clip_low": 0.25,
    "clip_high": 1.5,
    "lag": 1,
    "forward_horizon": 60
  },
  "validation": {
