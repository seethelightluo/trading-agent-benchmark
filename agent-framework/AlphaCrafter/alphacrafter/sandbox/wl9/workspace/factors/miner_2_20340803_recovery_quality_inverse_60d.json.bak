{
  "factor_id": "miner_2_20340803_recovery_quality_inverse_60d",
  "factor_name": "Broad-stress recovery quality inverse",
  "version": "1.0",
  "calculation": {
    "expression": "-where(breadth_5 > rolling_quantile(breadth_5,120,0.60), (-drawdown_60)*positive_return_10*(positive_path_efficiency_20+0.05)/(realized_volatility_20+0.005), 0)",
    "description": "During broad weakness, rank assets inversely by a lagged recovery-quality composite: drawdown depth, positive ten-session rebound, and positive path efficiency, scaled by volatility. The negative orientation is supported by validation and favors the contrarian side of the recovery-quality signal. Signal is shifted one completed session."
  },
  "dependencies": ["close"],
  "parameters": {"drawdown_window": 60, "rebound_window": 10, "path_window": 20, "breadth_window": 5, "breadth_quantile_window": 120, "breadth_quantile": 0.60, "volatility_window": 20, "volatility_floor": 0.005, "lag_sessions": 1},
