{
  "factor_id": "miner_1_20300905_relative_momentum_reversal_60d",
  "factor_name": "Volatility-scaled relative momentum reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-((return_60d - cross_sectional_median(return_60d))/rolling_std(return_1d,30) - 0.35*return_5d/rolling_std(return_1d,30)), lagged_1d",
    "description": "Ranks medium-term relative laggards higher, while rewarding short-term rebound; both components are volatility scaled. The one-session lag prevents look-ahead."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "momentum_window": 60,
    "short_reversal_window": 5,
    "volatility_window": 30,
    "short_reversal_weight": 0.35,
    "lag": 1,
    "minimum_cross_section": 8
  },
