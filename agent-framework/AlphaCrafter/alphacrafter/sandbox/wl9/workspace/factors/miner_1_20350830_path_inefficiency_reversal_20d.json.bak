{
  "factor_id": "miner_1_20350830_path_inefficiency_reversal_20d",
  "factor_name": "Path-Inefficiency Volatility-Scaled Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "(-(return_20d_lagged)/(std_return_60d_lagged*sqrt(60)+0.05)) * (1 - clip(abs(return_20d_lagged)/(sum(abs(daily_return),20)_lagged+1e-9),0,1))",
    "description": "Favors cross-sectional rebound candidates with adverse 20-session returns, scaled by trailing volatility, when the preceding path was noisy and inefficient. Inputs are lagged through the prior completed session."
  },
  "dependencies": ["close", "daily_returns"],
  "parameters": {"return_window": 20, "volatility_window": 60, "path_window": 20, "vol_min_periods": 40, "path_min_periods": 16, "forward_admission_horizon_days": 10, "min_cross_section": 8, "stabilizer": 0.05},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2035-08-29",
