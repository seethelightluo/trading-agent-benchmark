{
  "factor_id": "miner_2_20301031_liquidity_adjusted_reversal_60d",
  "factor_name": "Liquidity-Adjusted Relative Shock Reversal 60D",
  "version": "1.0",
  "calculation": {
    "expression": "(-((return_10d - cross_sectional_median(return_10d)) / annualized_downside_volatility_30d) * clip(volume_sma20 / volume_sma60, 0.5, 2.0)).shift(1)",
    "description": "Ranks lagging assets for medium-horizon reversal, scaling relative ten-day underperformance by 30-day downside volatility and by bounded abnormal volume. The one-day lag prevents look-ahead bias."
  },
  "dependencies": [
    "close",
    "volume"
  ],
  "parameters": {
    "relative_return_window": 10,
    "downside_volatility_window": 30,
    "volume_fast_window": 20,
    "volume_slow_window": 60,
    "volume_ratio_clip": [
      0.5,
      2.0
    ],
    "signal_lag_days": 1,
    "forward_horizon_days": 60
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2024-01-01 through 2030-10-30",
    "validation_date": "2030-10-31",
