  "factor_name": "Volatility-adjusted 40-day momentum, contrarian 20-day forecast",
  "version": "1.0",
  "calculation": {
    "expression": "lag1(pct_change(close,40) / rolling_std(pct_change(close),20))",
    "description": "For each tradable benchmark instrument, divide the trailing 40-session return by its trailing 20-session realized volatility and lag the signal one completed session. Higher values historically predict lower subsequent 20-session returns in this cross-asset benchmark, so portfolio use should reverse the direction.",
