{
  "factor_id": "miner_3_20300221_volscaled_relative_reversal_40d",
  "factor_name": "Volatility-scaled smoothed relative reversal",
  "version": "1.0",
  "calculation": {
    "expression": "rolling_mean_5((median_cs(return_20d) - return_20d) / (std(return_1d,20)*sqrt(20))).shift(1)",
    "description": "For each tradable asset, take the negative deviation of its 20-day return from the same-day cross-sectional median, scale by its own trailing 20-day annualized volatility, smooth over five sessions, and lag one completed session. Higher values indicate relatively weak risk-adjusted recent performance and are expected to mean-revert over the selected horizon."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "relative_return_window": 20,
    "volatility_window": 20,
    "smoothing_window": 5,
    "annualization": "sqrt(20)",
    "lag_sessions": 1,
    "forward_horizon_days": 40,
    "minimum_cross_section": 8
  },
