{
  "factor_id": "miner_2_20310724_downside_asymmetry_reversal_60d",
  "factor_name": "Downside-Asymmetry Volatility-Scaled Relative Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "median_demean(lag1(-rolling_sum(residual_return,60) / downside_volatility_40 * clip(downside_volatility_40 / upside_volatility_40,0.5,2.0)))",
    "description": "For each asset, subtract the daily cross-sectional mean return to form residual returns. Invert the 60-session cumulative residual return and scale by 40-session annualized downside residual volatility. Multiply by clipped downside/upside residual volatility asymmetry, then cross-sectionally median-demean and lag one completed session. Higher values indicate contrarian candidates with downside-dominant recent risk."
  },
  "dependencies": ["close", "daily_returns", "cross_sectional_mean_return"],
  "parameters": {
    "reversal_window": 60,
    "volatility_window": 40,
    "minimum_volatility_observations": 20,
    "asymmetry_clip": [0.5, 2.0],
    "annualization": 252,
    "signal_lag_sessions": 1,
    "minimum_cross_section": 8
  },
