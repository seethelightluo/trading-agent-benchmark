{
  "factor_id": "miner_2_dispersion_gated_reversal_1d",
  "factor_name": "Cross-asset dispersion-gated one-day reversal",
  "version": "2028-11-02",
  "calculation": {
    "expression": "-(close/close[-1]-1) * (1 + cross_sectional_std(mean(return[-4:0])) / cross_sectional_median(abs(mean(return[-4:0]))))",
    "description": "Ranks assets by the negative of their latest one-day return, with the reversal magnitude amplified when five-day cross-asset return dispersion is high. The signal uses only completed daily prices and contemporaneous cross-sectional statistics."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "return_lookback_days": 1,
    "dispersion_window_days": 5,
    "dispersion_scaling": "cross-sectional standard deviation divided by cross-sectional median absolute mean return",
    "forward_validation_horizon_days": 1,
    "minimum_cross_section": 8
  },
