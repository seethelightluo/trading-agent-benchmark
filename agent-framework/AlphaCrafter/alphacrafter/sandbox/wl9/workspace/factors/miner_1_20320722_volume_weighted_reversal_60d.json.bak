{
  "factor_id": "miner_1_20320722_volume_weighted_reversal_60d",
  "factor_name": "Volume-Weighted Volatility-Normalized Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "shift_1((-rolling_sum(pct_change(close),20) / (rolling_std(pct_change(close),60)*sqrt(20))) * clip(1 + (log(volume)-rolling_median(log(volume),60))/2, 0.25, 2.0))",
    "description": "Ranks assets for long-only reversal: recent 20-session losses receive larger positive scores, normalized by 60-session volatility and weighted by abnormal volume. Volume shock is clipped to limit outlier influence. The one-session lag prevents look-ahead bias."
  },
  "dependencies": ["close", "volume"],
  "parameters": {"return_window": 20, "volatility_window": 60, "volume_baseline_window": 60, "volume_shock_scale": 2.0, "volume_weight_floor": 0.25, "volume_weight_cap": 2.0, "lag_sessions": 1, "forward_validation_horizon": 60},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 to 2032-07-21",
    "validated_at": "2032-07-22",
    "metrics": {
      "ic": 0.200432,
      "icir": 0.518903,
      "valid_dates": 1494,
      "average_instruments": 8.03,
      "hit_ratio": 0.6914,
      "coverage": 0.289776,
      "turnover": 0.067490,
      "max_abs_library_correlation": null
    },
    "decay": {"5d": 0.073644, "10d": 0.104361, "20d": 0.133096, "40d": 0.161074, "60d": 0.200432},
    "regime_results": {
      "2024-2026": {"dates": 105, "ic": 0.190635, "icir": 0.436619, "hit_ratio": 0.6667},
      "2027-2029": {"dates": 782, "ic": 0.165845, "icir": 0.427280, "hit_ratio": 0.6624},
