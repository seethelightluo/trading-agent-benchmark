{
  "factor_id": "miner_1_20340720_trend_acceleration_20d",
  "factor_name": "Risk-adjusted trend acceleration",
  "version": "1.0",
  "calculation": {
    "expression": "((close/close.shift(20)-1) - (close/close.shift(60)-1)/3) / (annualized_std(pct_change(close),20)+0.05), then lag one session",
    "description": "Ranks assets whose recent 20-day return is accelerating relative to their average 60-day daily trend, scaled by recent risk. The one-session lag ensures only completed daily information is used. Positive values favor improving trends."
  },
  "dependencies": ["close"],
  "parameters": {"short_window": 20, "long_window": 60, "annualization": 252, "volatility_window": 20, "volatility_floor": 0.05, "signal_lag_sessions": 1, "forward_horizon_days": 20},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2034-07-19",
    "validation_timestamp": "2034-07-20",
    "metrics": {
      "ic": 0.0407605510,
      "icir": 0.1296078549,
      "hit_ratio": 0.5448134668,
      "valid_dates": 4396,
      "average_instruments": 14.9988626,
      "coverage": 0.9861098705,
      "turnover": 0.0878357414,
      "max_abs_library_correlation": null
    },
    "admission_thresholds": {"min_abs_ic": 0.007, "min_abs_icir": 0.084},
    "regime_notes": "Strong in 2020-2026 (IC 0.05474 in 2020-23; 0.06650 in 2024-26), negative in 2027-29 (-0.03590) and 2033-34 (-0.03695), positive but weaker in 2030-32 (0.01950). Treat as regime-sensitive and avoid oversized allocation.",
    "method": "Daily cross-sectional Spearman correlation between lagged signal and forward close-to-close return; minimum 8 valid instruments; 15-instrument universe used.",
    "signal_artifact": "scripts/miner_1_20340720_trend_acceleration_signal.csv"
  },
  "tags": ["momentum", "trend", "acceleration", "risk_adjusted", "cross_asset"]
