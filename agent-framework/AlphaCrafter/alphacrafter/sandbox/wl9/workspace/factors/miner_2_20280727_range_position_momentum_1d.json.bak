{
  "factor_id": "range_position_momentum_1d",
  "factor_name": "Range-Position-Weighted Momentum",
  "version": "20280727",
  "calculation": {
    "expression": "-(close/close.shift(20)-1) * (0.5 + (close-rolling_min(close,60))/(rolling_max(close,60)-rolling_min(close,60)))",
    "description": "Contrarian 20-trading-day momentum, weighted by the asset's 60-day price-range position. The negative sign is the validated direction for next-day cross-sectional returns; range position increases the magnitude near the upper end of the range and dampens it near the lower end. Cross-sectional ranking is used by consumers."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "momentum_window": 20,
    "range_window": 60,
    "range_min_periods": 40,
    "base_weight": 0.5,
    "validated_horizon_days": 1
  },
