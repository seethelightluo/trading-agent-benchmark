{
  "factor_id": "miner_1_20330303_path_efficiency_reversal_60d",
  "factor_name": "Path-efficiency-normalized 60D reversal",
  "version": "1.0",
  "calculation": {
    "expression": "(-pct_change(close,60) / rolling_sum(abs(pct_change(close,1)),60)).shift(1)",
    "description": "Ranks assets for reversal by their lagged 60-session loss normalized by cumulative absolute daily movement over the same window. The one-session lag ensures only completed-day information is used; larger positive values indicate stronger normalized reversal opportunity."
  },
  "dependencies": ["close"],
  "parameters": {"lookback_days": 60, "minimum_path_days": 40, "signal_lag_days": 1, "forward_horizons": [10,20,40,60]},
  "validation": {
