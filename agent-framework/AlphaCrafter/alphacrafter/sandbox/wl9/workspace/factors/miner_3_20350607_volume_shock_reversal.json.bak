{
  "factor_id": "miner_3_20350607_volume_shock_reversal",
  "factor_name": "Volume-Confirmed Short-Shock Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "lag1( -(close/close_shift_5 - 1) / (rolling_std(pct_change(close),20)+0.005) * (1 + clip(volume/rolling_median(volume,60)-1,-0.8,3.0)) )",
    "description": "A contrarian five-session return shock is scaled by 20-session realized volatility and amplified when volume is abnormal versus its 60-session rolling median. The signal is shifted one completed session to avoid look-ahead bias and clipped to limit outliers.",
    "signal_artifact": "scripts/miner_3_20350607_volume_shock_reversal_signal.csv"
  },
  "dependencies": ["close", "volume"],
  "parameters": {
    "shock_lookback_sessions": 5,
    "volatility_window_sessions": 20,
    "volume_baseline_window_sessions": 60,
    "volume_clip": [-0.8, 3.0],
    "volatility_floor": 0.005,
    "lag_sessions": 1,
    "clip_signal": [-10.0, 10.0],
    "minimum_cross_section": 8
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 to 2035-06-06",
