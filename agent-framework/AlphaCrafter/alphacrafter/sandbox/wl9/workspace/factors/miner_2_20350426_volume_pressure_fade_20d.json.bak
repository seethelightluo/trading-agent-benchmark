{
  "factor_id": "miner_2_20350426_volume_pressure_fade_20d",
  "factor_name": "Volume-Weighted Intraday Pressure Fade",
  "version": "1.0",
  "calculation": {
    "expression": "-rolling_mean_20(((close-open)/(high-low))*clip(volume/rolling_median(volume,40),0,5))",
    "description": "For each tradable benchmark, measure signed close-to-open pressure relative to the day's range, cap abnormal volume at 5 times its trailing 40-session median, multiply pressure by the volume surprise, and take the negative 20-session mean. Higher values identify assets whose volume-confirmed intraday selling pressure is expected to mean-revert over longer horizons. Values use only completed sessions and are cross-sectionally comparable."
  },
  "dependencies": [
    "open",
    "high",
    "low",
    "close",
    "volume"
  ],
  "parameters": {
    "pressure_window": 20,
    "volume_baseline_window": 40,
    "minimum_pressure_observations": 15,
    "volume_cap": 5.0,
    "admission_horizon_sessions": 60
  },
