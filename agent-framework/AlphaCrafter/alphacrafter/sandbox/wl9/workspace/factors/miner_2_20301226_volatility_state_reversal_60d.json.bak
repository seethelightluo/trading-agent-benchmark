{
  "factor_id": "miner_2_20301226_volatility_state_reversal_60d",
  "factor_name": "Volatility-State Weighted Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "lag1((-sum(return,10)/std(return,60)) * clip(std(return,10)/std(return,60),0.5,3.0))",
    "description": "Ten-day cross-asset reversal signal weighted by the asset's current 10-day realized volatility relative to its 60-day volatility state. Higher values favor recent losers during elevated volatility states; all inputs are lagged one trading day for decision timing."
  },
  "dependencies": ["close", "daily_returns"],
  "parameters": {"reversal_window": 10, "volatility_window_short": 10, "volatility_window_long": 60, "state_clip_lower": 0.5, "state_clip_upper": 3.0, "lag_days": 1, "forward_horizon_days": 60},
  "validation": {
