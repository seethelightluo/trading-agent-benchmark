{
  "factor_id": "miner_2_20290726_medium_reversal_quality_10d",
  "factor_name": "20-day volatility-normalized drawdown-aware reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(close/lag(close,20)-1)/(rolling_std(daily_return,60)*sqrt(60)+1e-6)*(1+0.25*abs(min(close/rolling_max(close,120)-1,0)))",
    "description": "Ranks assets higher when their 20-day return is weaker per unit of 60-day realized volatility, with a mild additional reversal weight for drawdown from the 120-day high."
  },
  "dependencies": ["close", "daily_return"],
  "parameters": {"lookback_return": 20, "volatility_window": 60, "drawdown_window": 120, "drawdown_multiplier": 0.25, "forward_horizon": 10},
  "validation": {
