{
  "factor_id": "downside_volatility_reversal_60d",
  "factor_name": "Downside-Volatility-Weighted Reversal (60d)",
  "version": "1.0",
  "calculation": {
    "expression": "(-return_20d) * (0.75 + clip(downside_variance_40d / total_variance_40d, 0, 1)), lagged_1d",
    "description": "Contrarian 20-session price return, amplified when recent realized variance is concentrated in negative-return sessions. The signal is lagged one completed session to avoid look-ahead."
  },
  "dependencies": ["close"],
  "parameters": {
    "reversal_window_days": 20,
    "variance_window_days": 40,
    "minimum_variance_observations": 20,
    "base_multiplier": 0.75,
    "downside_fraction_clip": [0, 1],
    "lag_days": 1,
    "forward_horizon_days": 60
  },
