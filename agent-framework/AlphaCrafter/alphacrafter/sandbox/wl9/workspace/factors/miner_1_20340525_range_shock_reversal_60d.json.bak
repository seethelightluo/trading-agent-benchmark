{
  "factor_id": "miner_1_20340525_range_shock_reversal_60d",
  "factor_name": "Range-expansion downside shock reversal 60D",
  "version": "1.0",
  "calculation": {
    "expression": "(-min(pct_change(close,20),0)/(rolling_std(pct_change(close,1),60)*sqrt(252)+0.05)) * clip((rolling_mean((high-low)/close,5)/rolling_median((high-low)/close,60)),0.25,4), shifted 1 session",
    "description": "Ranks assets for medium-horizon rebound after a downside 20-session move, scaled by realized volatility and confirmed by recent high-low range expansion. The one-session shift prevents look-ahead."
  },
  "dependencies": ["close", "high", "low"],
  "parameters": {"loss_window": 20, "volatility_window": 60, "range_window": 5, "range_baseline_window": 60, "forecast_horizon_days": 60, "shift_sessions": 1, "minimum_valid_cross_section": 8},
