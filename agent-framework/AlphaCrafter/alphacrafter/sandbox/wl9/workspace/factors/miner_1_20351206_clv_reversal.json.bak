{
  "factor_id": "miner_1_20351206_clv_reversal",
  "factor_name": "Volume-weighted close-location pressure reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-rolling_mean(CLV_1d,20) * rolling_mean(clip(volume/rolling_median(volume,60),0,4),20), shifted by 1 day",
    "description": "Fades persistent intraday close-location pressure: repeated closes near the high are treated as potential exhaustion, while closes near the low receive positive reversal scores. Pressure is weighted by a capped relative-volume regime. The one-session lag prevents look-ahead bias."
  },
  "dependencies": ["close", "high", "low", "volume"],
  "parameters": {"clv_window": 20, "volume_median_window": 60, "volume_cap": 4.0, "lag": 1, "forward_horizon": 10},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2035-11-21",
    "last_validated": "2035-12-06T00:00:00Z",
