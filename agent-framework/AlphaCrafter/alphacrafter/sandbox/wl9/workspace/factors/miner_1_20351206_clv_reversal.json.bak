      "admission_thresholds": {"absolute_daily_paper_ic": 0.007, "absolute_daily_paper_icir": 0.084}
    },
    "decay": {"h5": 0.0523829431, "h10": 0.0743611227, "h20": 0.0916982190, "h40": 0.1147362100, "h60": 0.1464056483},
    "regime_ic": {"2024-2026": 0.0046666667, "2027-2029": 0.0652173913, "2030-2032": 0.0909651361, "2033-2035": 0.0712710765},
