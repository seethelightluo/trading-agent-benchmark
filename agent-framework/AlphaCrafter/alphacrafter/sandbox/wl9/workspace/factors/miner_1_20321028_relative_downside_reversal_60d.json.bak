{
  "factor_id": "miner_1_20321028_relative_downside_reversal_60d",
  "factor_name": "Relative Downside-Risk-Normalized 60D Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-((close/close.shift(60))-1 - cross_sectional_mean((close/close.shift(60))-1)) / (sqrt(rolling_mean(min(pct_change(close),0)^2,60))*sqrt(60))",
    "description": "Contrarian relative 60-session return, normalized by each instrument's 60-session downside realized risk and lagged one completed session to prevent look-ahead bias. Higher values indicate relatively weaker, downside-risk-adjusted instruments expected to mean-revert."
  },
  "dependencies": ["close"],
  "parameters": {"lookback_sessions": 60, "downside_vol_window": 60, "downside_min_periods": 40, "lag_sessions": 1, "forward_horizon_admission": 60},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 to 2032-10-27",
    "last_validated": "2032-10-28",
    "metrics": {
      "ic": 0.221266,
      "icir": 0.758030,
      "hit_ratio": 0.7859,
      "valid_ic_dates": 1551,
      "average_instruments": 13.03,
      "factor_coverage": 0.425554,
      "turnover": 0.050350,
      "max_abs_library_correlation": null,
      "horizon_sessions": 60
    },
    "thresholds": {"minimum_absolute_daily_paper_ic": 0.0070, "minimum_absolute_daily_paper_icir": 0.0840},
    "regime_notes": "Positive across reported regimes: 2024 IC 0.374541 (92 dates), 2027-2029 IC 0.187031 (782 dates), 2030 IC 0.330723 (261 dates), 2031-2032 IC 0.183049 (416 dates). Small 15-instrument cross-section; uncertainty is interpreted across 1551 historical dates.",
    "signal_artifact": "scripts/miner_1_20321028_relative_downside_reversal_signal.csv",
    "provenance": "Executed validation script scripts/miner_1_20321028_relative_downside_reversal.py on 2032-10-28 using all 15 tradable benchmark instruments; Spearman cross-sectional IC."
  },
  "tags": ["reversal", "relative_strength", "downside_volatility", "cross_asset", "lagged"]
}
