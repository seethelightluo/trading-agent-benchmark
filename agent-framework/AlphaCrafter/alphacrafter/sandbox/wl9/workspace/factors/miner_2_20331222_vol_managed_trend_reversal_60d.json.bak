{
  "factor_id": "miner_2_20331222_vol_managed_trend_reversal_60d",
  "factor_name": "Volatility-managed medium-term trend reversal",
  "version": "1.0",
  "calculation": {
    "expression": "shift(-pct_change(close,60)/(annualized_std(pct_change(close),60)+0.04)*(0.65+0.35*sign(pct_change(close,20))),1)",
    "description": "Ranks assets by the lagged negative 60-session return, scaled by trailing 60-session annualized volatility and modestly conditioned on the direction of the 20-session return. The one-session lag ensures only completed data are used; clipping limits outliers. Positive values indicate stronger expected forward returns under the validated reversal effect."
  },
  "dependencies": ["close"],
  "parameters": {"long_window": 60, "confirmation_window": 20, "volatility_window": 60, "annualization": 252, "volatility_floor": 0.04, "confirmation_base": 0.65, "confirmation_scale": 0.35, "clip": [-5, 5], "signal_lag_sessions": 1, "forward_horizon_sessions": 60},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2033-12-07",
    "metrics": {
      "ic": 0.087034,
      "icir": 0.253185,
      "hit_ratio": 0.6046,
      "valid_dates": 4206,
      "average_instruments": 14.10,
