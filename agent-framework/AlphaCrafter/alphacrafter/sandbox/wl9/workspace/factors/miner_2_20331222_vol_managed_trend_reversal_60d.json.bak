    },
    "decay": {"10d_ic": 0.028532, "20d_ic": 0.046770, "40d_ic": 0.076616, "60d_ic": 0.087034},
    "regime_notes": "Positive 60-session IC in all reported regimes: 2027 0.079765; 2028-2029 0.210521; 2030 0.320744; 2031-2032 0.215630; 2033 YTD 0.038177. Effect weakened but remained positive in 2033.",
    "lookahead_control": "Signal shifted one completed session; forward returns begin after signal date.",
