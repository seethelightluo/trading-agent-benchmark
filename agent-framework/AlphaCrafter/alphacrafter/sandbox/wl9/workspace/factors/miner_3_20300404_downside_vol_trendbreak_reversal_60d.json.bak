  "factor_name": "Downside-Volatility-Scaled Trend-Break Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(return_20d - return_60d/3) / annualized_downside_volatility_20d, lagged one completed session",
    "description": "Contrarian reversal of the recent 20-day move relative to the preceding 60-day trend, normalized by the asset's 20-day downside realized volatility. Downside volatility uses the rolling standard deviation of negative daily returns with positive returns replaced by zero."
  },
  "dependencies": ["close"],
  "parameters": {"recent_window": 20, "trend_window": 60, "trend_scaler": 3.0, "downside_vol_window": 20, "annualization": 252, "lag": 1, "minimum_cross_section": 8},
