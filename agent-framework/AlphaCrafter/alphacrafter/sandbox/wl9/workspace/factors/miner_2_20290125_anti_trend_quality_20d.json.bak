{
  "factor_id": "miner_2_20290125_anti_trend_quality_20d",
  "factor_name": "Anti-trend quality 60-day mean-reversion",
  "version": "1.0",
  "calculation": {
    "expression": "-(close_t / close_{t-60} - 1) * mean(1{daily_return>0}, t-59:t)",
    "description": "Negative 60-day total return multiplied by the fraction of positive daily returns during the same lookback. Higher values favor persistently advancing assets that are expected to mean-revert over the next 20 trading days, and persistently falling assets receive lower scores."
  },
  "dependencies": ["close"],
  "parameters": {"lookback_days": 60, "forward_horizon_days": 20, "consistency_window_days": 60, "minimum_cross_section": 8},
  "validation": {
