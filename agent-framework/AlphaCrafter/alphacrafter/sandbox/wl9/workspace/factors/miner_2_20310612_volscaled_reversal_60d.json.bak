{
  "factor_id": "miner_2_20310612_volscaled_reversal_60d",
  "factor_name": "Volatility-Scaled Medium-Term Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-rolling_sum(pct_change(close),60) / (rolling_std(pct_change(close),40) * sqrt(252) + 1e-12), cross_sectional_median_demean, lag(1)",
    "description": "Ranks assets favoring contrarian exposure to 60-session cumulative returns after scaling by 40-session annualized realized volatility. Cross-sectional median demeaning and one-session lag prevent level and look-ahead effects."
  },
  "dependencies": ["close"],
  "parameters": {
    "return_window": 60,
    "volatility_window": 40,
    "annualization": 252,
    "vol_min_periods_return": 40,
    "vol_min_periods": 25,
    "lag_sessions": 1,
    "universe_size": 15
  },
