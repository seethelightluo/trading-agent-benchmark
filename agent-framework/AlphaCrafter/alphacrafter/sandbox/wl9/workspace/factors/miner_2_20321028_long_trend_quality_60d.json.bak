{
  "factor_id": "miner_2_20321028_long_trend_quality_60d",
  "factor_name": "Long-Horizon Trend Quality",
  "version": "1.0",
  "calculation": {
    "expression": "lag1(120d_return * abs(120d_return) / sum(abs(daily_return),120d))",
    "description": "The 120-session return is scaled by directional efficiency, defined as absolute net return divided by the cumulative absolute daily return. The signal is lagged by one completed session to prevent lookahead bias. Despite the negative IC, the factor is admitted with inverse direction: lower trend-quality scores predict higher subsequent returns in this benchmark."
  },
  "dependencies": [
    "close",
    "daily_return"
  ],
  "parameters": {
    "lookback_days": 120,
