  "factor_name": "Cross-Asset Relative Trend Persistence",
  "version": "1.0",
  "calculation": {
    "expression": "lag1(sum_60(asset_log_return - cross_asset_mean_log_return) * (2*mean_60(I[asset_log_return-cross_asset_mean_log_return>0])-1))",
