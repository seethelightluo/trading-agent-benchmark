  "factor_name": "Range-Position Weighted Relative Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "[-relative_cross_sectional_return_40d * (1.25 - 0.75 * trailing_range_position_120d)].shift(1)",
    "description": "Compute each asset's 40-session cumulative return relative to the cross-sectional median, invert it for medium-horizon reversal, and weight the reversal more strongly when price is in the lower portion of its trailing 120-session range. Signal is lagged one completed session to avoid look-ahead."
