  "factor_name": "VIX-Regime Trend/Reversal Switch",
  "version": "2029-03-08",
  "calculation": {
    "expression": "if VIX_t > median(VIX_{t-60:t}), then -(r_5d_i - median_cross_section(r_5d)); otherwise (r_20d_i / std_daily_return_20d_i)",
