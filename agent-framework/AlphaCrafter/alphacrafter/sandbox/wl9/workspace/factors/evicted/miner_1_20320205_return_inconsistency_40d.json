  "factor_name": "40-Day Volatility-Adjusted Return Inconsistency",
  "version": "1.0",
  "calculation": {
    "expression": "-(rolling_mean((pct_change(close)>0),60)-0.5)/(rolling_std(pct_change(close),60)+1e-8), lagged 1 completed session",
    "description": "Sign-inverted directional persistence scaled by inverse realized volatility. Assets with unusually consistent positive or negative daily direction receive lower scores; the factor is intended as a cross-sectional return-inconsistency/reversal signal. The one-session lag prevents look-ahead."
