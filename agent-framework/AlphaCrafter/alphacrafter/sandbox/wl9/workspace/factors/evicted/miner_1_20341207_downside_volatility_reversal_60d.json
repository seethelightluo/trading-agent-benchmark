{
  "factor_id": "downside_volatility_reversal_60d",
  "factor_name": "Downside-volatility-normalized 40-day reversal",
  "version": "1.0",
  "calculation": {
    "expression": "(-(close / close.shift(40) - 1) / (rolling_std(clip(pct_change(close), upper=0), 40) * sqrt(40) + 0.002)).shift(1)",
    "description": "Ranks assets higher when their trailing 40-day loss is large relative to their downside volatility. The one-session lag ensures only completed data are used; the positive sign makes the signal contrarian."
