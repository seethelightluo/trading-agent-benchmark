  "factor_name": "Bear-Regime Standardized Five-Day Shock Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "shift(-rolling_sum(pct_change(close), 5) / (rolling_std(pct_change(close), 20)*sqrt(20)) * I(rolling_sum(equal_weight_mean_returns,20)<=0), 1)",
