  "version": "2030-03-07",
  "calculation": {
    "expression": "-(ret_10d - cross_sectional_median(ret_10d)) / (sqrt(10)*std_daily_return_20d) * (0.5 + percentile_rank_252(cross_sectional_dispersion_10d))",
