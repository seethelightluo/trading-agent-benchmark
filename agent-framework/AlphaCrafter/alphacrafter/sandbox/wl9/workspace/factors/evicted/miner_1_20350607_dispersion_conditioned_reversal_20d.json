{
  "factor_id": "dispersion_conditioned_reversal_20d",
  "factor_name": "Cross-sectional dispersion-conditioned volatility-scaled reversal",
  "version": "1.0",
  "calculation": {
    "expression": "lag1((-return_20d / annualized_volatility_40d) * (1 + 0.75 * (clip(cross_sectional_dispersion_20d / rolling_median_252_dispersion, 0.5, 2.0) - 1)), clip(-3,3))",
    "description": "Ranks recent losers favorably, scaling reversal by asset volatility and increasing its magnitude when cross-asset return dispersion is elevated. All inputs are lagged to the last completed session for trading use."
  },
  "dependencies": [
    "close",
    "daily_returns"
  ],
  "parameters": {
    "return_window": 20,
    "volatility_window": 40,
    "dispersion_window": 20,
