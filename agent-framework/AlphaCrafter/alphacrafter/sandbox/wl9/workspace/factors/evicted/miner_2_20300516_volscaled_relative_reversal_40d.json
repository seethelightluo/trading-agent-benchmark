{
  "factor_id": "miner_2_20300516_volscaled_relative_reversal_40d",
  "factor_name": "Volatility-Scaled Relative Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "shift1(-(return_20d - cross_sectional_median(return_20d)) / (std(return_1d,20)*sqrt(20)+epsilon))",
    "description": "Contrarian cross-asset signal: buy assets that underperformed the cross-sectional 20-session return median and sell/rank lower assets that outperformed, scaled by their recent realized volatility. Lag one completed session to avoid lookahead."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "relative_return_window": 20,
    "volatility_window": 20,
    "volatility_annualization": "sqrt(20)",
    "lag_sessions": 1,
    "forward_horizon_sessions": 40,
    "minimum_cross_section": 8,
    "epsilon": 1e-08
  },
