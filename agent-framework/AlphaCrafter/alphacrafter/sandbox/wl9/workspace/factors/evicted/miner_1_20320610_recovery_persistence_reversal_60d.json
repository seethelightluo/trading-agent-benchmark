  "factor_name": "Recovery-Persistence Volatility-Scaled Relative Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "shift1(-relative_return_30d * (1 + 0.65*clip(max(recovery_return_10d,0)/(0.03+volatility_40d*sqrt(10)),0,2)) * (0.75 + 0.5*I[recovery_return_20d>0])/(volatility_40d*sqrt(40)+0.01))",
    "description": "Contrarian cross-sectional 30-session return relative to the daily universe median, amplified when positive recovery persists over nested 10- and 20-session horizons, and scaled by recent volatility. All inputs are shifted by one completed session."
