  "factor_name": "Path-Inefficiency Volatility-Normalized Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(return_20 / (realized_volatility_60*sqrt(60)+0.05)) * (1 - abs(return_20)/(sum(abs(daily_return),20)+1e-9))",
    "description": "Contrarian 20-session return normalized by 60-session volatility, weighted toward assets whose return path was noisy and inefficient. All rolling inputs are shifted to use only completed information through the prior day; final signal is clipped to [-20,20]."
  },
  "dependencies": [
    "close",
    "daily_return"
  ],
  "parameters": {
    "reversal_window": 20,
    "volatility_window": 60,
    "path_window": 20,
    "min_periods_volatility": 40,
    "min_periods_path": 16,
    "stabilizer": 0.05,
    "clip": [
      -20,
      20
    ],
