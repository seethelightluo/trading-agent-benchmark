  "factor_name": "Medium Reversal Downside-Scaled 60D",
  "version": "1.0",
  "calculation": {
    "expression": "rank_cs(lag1(-(return_20 / rolling_std(negative_daily_returns,40))))",
    "description": "Contrarian medium-horizon return normalized by downside volatility. Higher values indicate assets with stronger recent 20-session losses relative to their 40-session downside-risk scale, and therefore forecast higher subsequent returns. The signal is lagged one session to avoid look-ahead."
