{
  "factor_id": "volatility_cluster_reversal_5d",
  "factor_name": "Volatility-Cluster Risk-Scaled Short Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "clip(-(close[t-1]/close[t-6]-1)/(rolling_std(return,20)[t-1]*sqrt(5)+0.03) * clip(rolling_std(return,5)[t-1]/rolling_std(return,20)[t-1],0.5,3.0),-20,20)",
    "description": "Fades the prior five-session return, scales it by trailing 20-session volatility, and increases the reversal signal when recent five-session volatility is clustered above its 20-session baseline. All price and volatility inputs are lagged one completed session. Positive values indicate expected relative outperformance."
  },
  "dependencies": [
    "close",
    "pct_change"
  ],
