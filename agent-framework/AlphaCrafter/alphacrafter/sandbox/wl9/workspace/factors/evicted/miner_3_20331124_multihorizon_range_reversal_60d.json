  "factor_name": "Multi-horizon volatility-normalized range-conditioned reversal",
  "version": "1.0",
  "calculation": {
    "expression": "clip(((-0.55*return_20/annvol_20) + (-0.45*return_60/annvol_60)) * clip(1.20 - range_position_180, 0.30, 1.20), -5, 5), lagged 1 session",
    "description": "Blends 20-session and 60-session contrarian returns normalized by their respective annualized volatilities, then increases the signal for assets near the lower portion of their trailing 180-session price range. The signal is clipped and shifted one completed session to prevent look-ahead bias."
