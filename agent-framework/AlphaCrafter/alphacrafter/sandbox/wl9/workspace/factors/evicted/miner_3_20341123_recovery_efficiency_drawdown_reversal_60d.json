{
  "factor_id": "miner_3_20341123_recovery_efficiency_drawdown_reversal_60d",
  "factor_name": "Recovery-Efficiency Drawdown Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "(-(close / rolling_max(close,120) - 1) * (1 - abs(rolling_sum(return,60)) / (rolling_sum(abs(return),60) + 1e-6))).shift(1)",
    "description": "Ranks assets positively when they are below their 120-day peak and their recent path has low directional efficiency, identifying drawdowns with choppy recovery potential. The one-day lag prevents use of the current completed day's return in the decision signal."
  },
  "dependencies": [
    "close",
    "pct_change"
  ],
  "parameters": {
    "drawdown_lookback": 120,
    "efficiency_lookback": 60,
    "min_periods_peak": 80,
    "min_periods_efficiency": 40,
    "epsilon": 1e-06,
    "signal_lag_days": 1,
    "forward_validation_horizon_days": 60
  },
