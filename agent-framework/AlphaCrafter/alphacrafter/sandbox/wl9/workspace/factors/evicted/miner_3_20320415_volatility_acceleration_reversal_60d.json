{
  "factor_id": "miner_3_20320415_volatility_acceleration_reversal_60d",
  "factor_name": "Volatility-Acceleration Relative Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "(-relative_return_20d) * clip(volatility_10d / volatility_60d, 0.5, 3.0), lagged 1 completed session",
    "description": "Ranks assets for reversal after unusually rapid volatility acceleration. Relative return is each asset's 20-session return minus the cross-sectional median 20-session return; the contrarian signal is scaled by the ratio of 10-session to 60-session realized volatility and lagged to avoid look-ahead bias."
  },
  "dependencies": [
    "close",
    "daily returns"
  ],
  "parameters": {
    "relative_return_window": 20,
    "short_volatility_window": 10,
    "long_volatility_window": 60,
    "short_volatility_min_periods": 8,
