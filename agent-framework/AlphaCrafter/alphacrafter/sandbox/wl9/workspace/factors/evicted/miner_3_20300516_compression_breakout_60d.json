  "factor_id": "miner_3_20300516_compression_breakout_60d",
  "factor_name": "Breadth-Regime Compression Breakout",
  "version": "1.0",
  "calculation": {
    "expression": "shift1((rolling_sum_20(asset_return - cross_sectional_median_return) / rolling_std_40(asset_return)) / clip(rolling_std_5(asset_return) / rolling_std_40(asset_return), 0.25, 2.0) * (2*cross_sectional_breadth_20d - 1))",
    "description": "Compute each asset's 20-session return relative to the daily cross-asset median, normalize by 40-session volatility, and favor compressed recent paths through the inverse ratio of 5-session to 40-session volatility. Multiply by centered 20-session cross-sectional breadth to condition on the prevailing regime, then lag one completed session."
  },
