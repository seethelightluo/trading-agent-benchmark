  "factor_name": "Volume-Shock-Adjusted Drawdown Duration Reversal",
  "version": "2031-04-03",
  "calculation": {
    "expression": "lag1((sessions_since_rolling_high_60 / annualized_volatility_20) * (1 + 0.25*tanh(log(volume) - rolling_mean_20(log(volume))))",
