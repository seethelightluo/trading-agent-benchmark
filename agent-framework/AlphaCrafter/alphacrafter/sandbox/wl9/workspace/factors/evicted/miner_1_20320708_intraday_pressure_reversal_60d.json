  "factor_name": "Lagged Intraday Pressure Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(0.7*EWMA_20((2*close-high-low)/(high-low)) + 0.3*MA_10((close-close[-1])/(high-low))) shifted by one completed session",
