{
  "factor_id": "miner_2_20310515_volume_confirmed_reversal_40d",
  "factor_name": "Volume-Confirmed Volatility-Scaled Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "cross_sectional_demean((-rolling_sum(return,10) / (annualized_std(return,40)+epsilon)) * sqrt(clip(mean(volume,10)/mean(volume,60),0.5,3.0)), median)",
    "description": "Contrarian ten-session return shock scaled by 40-session annualized volatility and amplified when recent average activity is elevated relative to its 60-session baseline. The cross-sectional median is subtracted and the signal is lagged one completed session to prevent look-ahead."
  },
