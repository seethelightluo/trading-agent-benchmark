  "factor_name": "Range-Position Weighted Medium-Term Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "clip((-(close/close.shift(60)-1)/(std(pct_change(close),60)*sqrt(252)+0.05)) * (1 + 0.75*(0.5 - (close-rolling_min(close,120))/(rolling_max(close,120)-rolling_min(close,120)))), -5, 5).shift(1)",
    "description": "Fades the 60-session risk-adjusted return, with stronger contrarian emphasis for assets near the lower end of their trailing 120-session price range. The signal is lagged one completed session to prevent look-ahead."
