  "factor_name": "Stress-gated volatility-normalized cross-asset residual reversal",
  "version": "1.0",
  "calculation": {
    "expression": "(-rolling_sum_5(asset_return - cross_sectional_median_return) / rolling_std_20(asset_return)) * (0.5 + 0.5 * I(sum_20(cross_sectional_median_return) < 0)), lagged_1",
    "description": "Reverses each asset's five-session return relative to the contemporaneous cross-asset median, scales by 20-session volatility, and increases reversal strength during negative 20-session benchmark regimes. The signal is lagged one completed session."
