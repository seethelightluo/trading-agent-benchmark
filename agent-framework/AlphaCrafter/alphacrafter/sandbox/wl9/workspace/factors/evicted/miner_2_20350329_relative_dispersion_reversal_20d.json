{
  "factor_id": "miner_2_20350329_relative_dispersion_reversal_20d",
  "factor_name": "Volatility-Scaled Cross-Asset Relative Dispersion Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(return_20d_i - median_cross_section(return_20d))/(volatility_40d_i*sqrt(40)), lagged_one_session",
    "description": "For each tradable asset, subtract the same-day cross-asset median 20-day return and fade the relative move. Scale by trailing 40-day realized volatility and lag one completed session. Higher values indicate relatively underperforming, lower-volatility assets expected to mean-revert."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "relative_return_window": 20,
    "volatility_window": 40,
    "volatility_min_periods": 30,
    "cross_section_statistic": "median",
    "lag_sessions": 1
  },
