  "factor_name": "Short-to-long volatility term-structure reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(rolling_std(return_1d,10) / rolling_std(return_1d,60) - 1), lagged one session",
    "description": "Ranks assets whose recent 10-day realized volatility is low relative to their 60-day volatility more positively, interpreting volatility compression as a conditional rebound/continuation signal. The signal is lagged one completed session before forward-return evaluation."
