  "factor_name": "Twenty-Day Return Path Asymmetry",
  "version": "1.0",
  "calculation": {
    "expression": "(sum(max(pct_change(close),0),20) - sum(max(-pct_change(close),0),20)) / (sum(max(pct_change(close),0),20) + sum(max(-pct_change(close),0),20))",
    "description": "Measures whether the trailing 20-day return path was dominated by positive or negative daily moves. Higher values indicate positive-return contribution dominated the path and are ranked as continuation exposure. Signal uses prices through the evaluation date only."
