{
  "factor_id": "miner_3_20330414_drawdown_rebound_60d",
  "factor_name": "Risk-normalized drawdown rebound",
  "version": "1.0",
  "calculation": {
    "expression": "(-pct_change(close,20)/(rolling_std(pct_change(close,1),20)*sqrt(252)+0.05))*clip(1+0.75*(-clip(close/rolling_max(close,120)-1,-0.8,0)),1,1.60), lagged_one_session",
    "description": "Ranks assets for medium-horizon rebound after a risk-normalized 20-session loss, amplified in a bounded manner when price is below its trailing 120-session peak. Every input and signal is lagged one completed session to avoid look-ahead."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "reversal_window": 20,
    "volatility_window": 20,
    "peak_window": 120,
    "annualization": 252,
    "volatility_floor": 0.05,
    "drawdown_clip": [
      -0.8,
      0.0
    ],
    "amplifier": 0.75,
    "amplifier_clip": [
      1.0,
      1.6
    ],
    "forward_validation_horizon": 60,
