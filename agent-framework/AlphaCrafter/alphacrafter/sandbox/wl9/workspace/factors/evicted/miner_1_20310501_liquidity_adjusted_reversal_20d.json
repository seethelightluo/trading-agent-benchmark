{
  "factor_id": "miner_1_20310501_liquidity_adjusted_reversal_20d",
  "factor_name": "Liquidity-adjusted short-term reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-rolling_sum(pct_change(close), 5) / rolling_std(pct_change(close), 20)",
    "description": "Contrarian five-session return scaled by trailing 20-session volatility. The signal is lagged one completed session before use, preventing look-ahead bias. Higher values indicate stronger expected medium-horizon rebound.",
    "implementation": "sig = (-(close.pct_change().rolling(5).sum()) / (close.pct_change().rolling(20).std()+1e-12)).shift(1)"
  },
