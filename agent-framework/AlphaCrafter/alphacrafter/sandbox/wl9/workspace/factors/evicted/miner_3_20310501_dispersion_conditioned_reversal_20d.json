  "factor_name": "Cross-Asset Dispersion-Conditioned Volatility-Adjusted Reversal",
  "version": "2031-05-01",
  "calculation": {
    "expression": "(-return_15d / annualized_std_return_20d) * (1 + 0.40*tanh((mean20(cross_sectional_daily_return_std)-mean120)/std120)), lagged_one_session",
    "description": "Ranks recent 15-session contrarian performance after volatility scaling; amplifies the contrarian signal when trailing cross-asset return dispersion is unusually high. The dispersion state is common across the 15 tradable instruments and uses only information available through the prior completed session."
