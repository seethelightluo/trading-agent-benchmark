{
  "factor_id": "miner_3_20330526_volshock_reversal_60d",
  "factor_name": "Volatility-shock expansion reversal",
  "version": "1.0",
  "calculation": {
    "expression": "shift1((-ret5/(ann_vol10+0.05)) * (1 + 0.8*clip(ann_vol10/(ann_vol60+0.05)-1,-0.8,2.0)) * (1+0.35*abs(cross_sectional_negative_fraction(ret5)-0.5)))",
    "description": "Ranks assets higher when their lagged five-session loss is large relative to short-horizon volatility, with an expansion-of-volatility boost and a mild broad-move intensity adjustment. All inputs are shifted one completed session to prevent look-ahead bias. Higher values predict stronger subsequent 60-session returns."
  },
  "dependencies": [
    "close",
    "daily_returns"
  ],
