{
  "factor_id": "miner_1_20320401_dispersion_recovery_reversal_60d",
  "factor_name": "Dispersion-Conditioned Recovery Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "shift1((median_cross_sectional_return_60 - return_60) * (1 + 0.25*clip(recovery_return_10/(volatility_40*sqrt(10)), -1, 1)) * clip(dispersion_60/rolling_median(dispersion_60,120), 0.5, 2.0))",
    "description": "A contrarian cross-asset signal favoring lagged 60-session losers relative to the cross-sectional median. Conviction is modestly increased by recent recovery confirmation and elevated cross-sectional dispersion. All inputs are shifted one completed session to prevent look-ahead bias."
  },
  "dependencies": [
    "close",
    "daily_returns"
  ],
  "parameters": {
    "relative_return_window": 60,
    "recovery_window": 10,
    "volatility_window": 40,
    "dispersion_window": 60,
    "dispersion_baseline_window": 120,
    "recovery_weight": 0.25,
    "recovery_clip": [
      -1.0,
      1.0
    ],
    "dispersion_clip": [
      0.5,
      2.0
    ],
    "lag_sessions": 1,
    "minimum_cross_section": 8
  },
