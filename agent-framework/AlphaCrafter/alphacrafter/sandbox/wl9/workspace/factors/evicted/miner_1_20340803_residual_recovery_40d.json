  "factor_name": "Weak-breadth residual recovery",
  "version": "1.0",
  "calculation": {
    "expression": "weak_breadth * (-residual_return_60 / (sqrt(20)*downside_vol_20 + 0.02) + 1.5*return_10 / (sqrt(20)*volatility_20 + 0.02)), lagged 1 session",
