{
  "factor_id": "miner_3_20351025_downside_reversal_90d",
  "factor_name": "Downside-Concentration Risk-Normalized 90D Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(close[t-1]/close[t-91]-1)/(std(negative_daily_returns,90)[t-1]*sqrt(90)+0.05) * (0.5 + clip(-sum(negative_returns,90)[t-1]/(sum(abs(returns),90)[t-1]+1e-9),0,1))",
    "description": "Contrarian long-horizon return signal, normalized by downside volatility and strengthened when the prior 90-day absolute return path is concentrated in losses. All inputs are lagged one completed day. Higher values predict stronger forward returns."
  },
  "dependencies": [
    "close",
    "daily_returns"
  ],
  "parameters": {
    "lookback_days": 90,
    "downside_volatility_min_periods": 45,
    "downside_share_min_periods": 45,
    "forward_admission_horizon_days": 10,
    "clip_lower": -30,
    "clip_upper": 30,
    "epsilon": 1e-09,
    "constant": 0.05
  },
