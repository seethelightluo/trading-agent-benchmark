  "factor_name": "VIX-conditioned peer-relative residual reversal",
  "version": "1.0",
  "calculation": {
    "expression": "clip(-rolling_sum(asset_return - cross_sectional_median_return,60) / (rolling_std(residual_return,60)*sqrt(252)+0.05) * clip(VIX/rolling_median(VIX,120),0.5,2.5), -5, 5), lagged 1 session",
    "description": "Fades each instrument's 60-session cumulative return residual to the contemporaneous 15-asset median. The reversal is scaled by residual volatility and strengthened when observation-only VIX is elevated relative to its trailing 120-session median. All inputs are lagged before use for forward-return testing."
