{
  "factor_id": "miner_2_20341109_recovery_efficiency_reversal_60d",
  "factor_name": "Drawdown and Path-Inefficiency Recovery Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-drawdown_120d * (1 - abs(net_return_60d) / (sum_abs_daily_returns_60d + 1e-6)), lagged_1d",
    "description": "Ranks assets higher when they are below their trailing 120-day peak and have experienced a choppy, path-inefficient 60-day decline. The lag prevents look-ahead bias."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "peak_window": 120,
    "path_window": 60,
