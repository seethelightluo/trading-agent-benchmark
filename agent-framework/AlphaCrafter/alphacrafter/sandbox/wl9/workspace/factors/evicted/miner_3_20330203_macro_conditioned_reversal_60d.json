  "factor_name": "Macro-Conditioned Volatility-Scaled Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "(-return_60d / (annualized_volatility_60d + 0.05)) * (1 + 0.35*tanh(vix_zscore_252_lagged)) * (1 - 0.15*tanh(dxy_return_20d_lagged))",
    "description": "Cross-asset 60-session reversal signal risk-scaled by 60-session realized volatility and conditioned by lagged VIX stress and DXY trend. The complete signal is shifted one completed session to prevent look-ahead. VIX and DXY are observation-only macro inputs and are not tradable."
  },
  "dependencies": [
    "close",
    "VIX close",
    "DXY close"
  ],
