  "factor_name": "Benchmark-Residual 20d Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-rolling_sum_20(pct_change(close) - cross_sectional_mean(pct_change(close))), lagged_1",
    "description": "For each tradable instrument, negate its 20-session cumulative return relative to the equal-weight cross-sectional benchmark; lag one completed session to avoid look-ahead. Higher scores favor assets that underperformed the benchmark and may mean-revert over the subsequent horizon."
