{
  "factor_id": "miner_3_20350426_shortshock_volscaled_reversal_5d",
  "factor_name": "Short-Shock Volatility-Scaled Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "clip(-(close_t/close_{t-5}-1) / (std(pct_change(close),20)*sqrt(252)+0.005), -5, 5)",
    "description": "Ranks assets positively when their lagged five-trading-day price shock is negative, scaled by trailing 20-day realized volatility. The signal is formed using close through t and evaluated against forward returns; implementation must lag the signal one completed session before trading. Cross-sectional winsorization limits extreme crypto observations."
  },
  "dependencies": [
    "close",
    "pct_change"
  ],
  "parameters": {
    "shock_lookback_days": 5,
    "volatility_window_days": 20,
    "annualization": 252,
    "volatility_floor": 0.005,
    "winsorization": [
      -5,
      5
    ],
    "signal_lag_days": 1
  },
