  "factor_name": "Volatility-Adjusted Cross-Asset Momentum Acceleration",
  "version": "1.0",
  "calculation": {
    "expression": "((close_t/close_{t-20}-1) - (close_t/close_{t-60}-1)/3) / (std(pct_change(close) over trailing 20 observations) * sqrt(252))",
