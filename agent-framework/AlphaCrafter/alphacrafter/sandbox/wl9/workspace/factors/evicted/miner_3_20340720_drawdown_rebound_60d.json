  "factor_name": "Drawdown Rebound with Upside Participation",
  "version": "1.0",
  "calculation": {
    "expression": "((1 - close / rolling_max(close,60)) / (rolling_mean(max(-pct_change(close,1),0),20) + 0.001) * (rolling_mean(max(pct_change(close,1),0),20) + 0.001) / (rolling_mean(max(-pct_change(close,1),0),20) + rolling_mean(max(pct_change(close,1),0),20) + 0.002)).shift(1)",
    "description": "Ranks assets with deeper 60-day drawdowns, scaled by recent downside intensity and rewarded for positive-return participation. Inputs are shifted one completed session to prevent look-ahead. Higher values are expected to predict stronger 60-day forward returns."
