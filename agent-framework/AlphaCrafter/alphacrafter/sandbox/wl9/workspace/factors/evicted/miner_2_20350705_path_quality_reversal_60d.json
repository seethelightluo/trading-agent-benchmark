{
  "factor_id": "path_quality_reversal_60d",
  "factor_name": "Path-Quality Risk-Adjusted Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-pct_change(close,60) / (rolling_std(pct_change(close,1),60) * sqrt(252)) * abs(sum(rolling_returns_60)) / sum(abs(rolling_returns_60)), lagged 1 session",
    "description": "Contrarian 60-session return, scaled by annualized 60-session realized volatility and multiplied by a 60-session path-efficiency measure. The path-quality term is absolute net return divided by cumulative absolute daily returns, rewarding persistent directional moves and attenuating noisy paths. All inputs are lagged one completed session to avoid look-ahead bias."
  },
  "dependencies": [
    "close"
  ],
