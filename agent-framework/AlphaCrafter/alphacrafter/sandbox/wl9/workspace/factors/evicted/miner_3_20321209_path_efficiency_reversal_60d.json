  "factor_name": "60-Day Path-Efficiency Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-((close / lag(close,60) - 1) / rolling_sum(abs(pct_change(close)),60)) lagged_one_day",
    "description": "Ranks assets positively when their prior 60-session net return was negative relative to their total absolute-return path, favoring persistent drawdowns and allowing cross-asset mean reversion. The complete signal is shifted one session to prevent look-ahead bias."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "lookback_sessions": 60,
