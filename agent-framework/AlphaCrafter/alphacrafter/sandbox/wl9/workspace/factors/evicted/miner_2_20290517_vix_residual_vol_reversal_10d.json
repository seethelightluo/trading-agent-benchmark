  "factor_name": "VIX-gated market-residual volatility-scaled reversal 10d",
  "version": "1.1",
  "calculation": {
    "expression": "when VIX_t > median(VIX[t-60:t]), -(residual_return_5d / std(asset_returns[t-9:t]))",
    "description": "Estimate each asset's 5-day return residual after removing rolling 60-day beta exposure to the equal-weight cross-asset daily return, negate the residual, and scale by recent 10-day volatility. Activate only when VIX is above its trailing 60-session median. Higher values predict higher 10-day forward returns."
