  "factor_name": "Breadth-gated volatility-scaled medium-term reversal",
  "version": "1.0",
  "calculation": {
    "expression": "(-pct_change(close,60) / annualized_std(pct_change(close,1),40)) * (1 + 2 * (1 - cross_sectional_breadth(pct_change(close,60)>0)), lag=1)",
