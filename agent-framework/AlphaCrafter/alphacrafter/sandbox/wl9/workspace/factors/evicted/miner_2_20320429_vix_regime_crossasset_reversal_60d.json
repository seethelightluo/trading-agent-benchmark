{
  "factor_id": "miner_2_20320429_vix_regime_crossasset_reversal_60d",
  "factor_name": "VIX-Regime-Scaled Cross-Asset Residual Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "shift1(-((return_20d - cross_sectional_median(return_20d)) / rolling_std(return_1d,60)) * (0.75 + rolling_percentile(VIX,252).shift1()))",
    "description": "Contrarian cross-asset 20-session residual return normalized by 60-session volatility, with a backward-looking VIX percentile multiplier that increases reversal intensity during stressed volatility regimes. The complete signal is lagged one completed session. VIX is observation-only and never tradable."
  },
  "dependencies": [
    "close",
    "daily_return",
    "VIX"
  ],
  "parameters": {
    "return_window": 20,
    "volatility_window": 60,
    "vix_percentile_window": 252,
    "multiplier_floor": 0.75,
    "lag_sessions": 1,
    "forward_validation_horizon": 60,
    "minimum_cross_section": 8
  },
