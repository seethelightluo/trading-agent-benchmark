{
  "factor_id": "miner_1_20320916_volume_persistence_flow_10d",
  "factor_name": "Volume Persistence Flow Pressure 10D",
  "version": "1.0",
  "calculation": {
    "expression": "shift(rolling_sum(pct_change(close) * clip(volume / rolling_median(volume,60) - 1,-3,3),20),1) / (rolling_std(pct_change(close),60) * sqrt(252))",
    "description": "Accumulates signed returns weighted by abnormal volume over 20 sessions, scales by 60-session annualized realized volatility, and lags one completed session to prevent look-ahead."
  },
  "dependencies": [
    "close",
    "volume"
  ],
  "parameters": {
    "pressure_window": 20,
    "volume_median_window": 60,
    "volatility_window": 60,
