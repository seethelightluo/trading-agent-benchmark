{
  "factor_id": "regime_gated_range_reversal_3d",
  "factor_name": "Regime-Gated Volatility-Scaled 3-Day Reversal with Range Overlay",
  "version": "1.0",
  "calculation": {
    "expression": "gate * (-((close/close_lag3)-1)/rolling_std(pct_change,20) + 0.5 - range_position_60) + (1-gate) * 0.35 * base",
    "description": "Compute the existing volatility-scaled 3-day reversal plus 60-day range-position reversal overlay. The cross-asset regime gate is one when the current median 20-day asset volatility exceeds the trailing 60-day median of the median cross-sectional 20-day volatility; otherwise signal magnitude is reduced to 35 percent. Higher values rank more favorably."
  },
  "dependencies": [
    "close",
    "pct_change"
  ],
