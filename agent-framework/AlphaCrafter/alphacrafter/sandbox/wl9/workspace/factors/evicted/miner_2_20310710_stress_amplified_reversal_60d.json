{
  "factor_id": "miner_2_20310710_stress_amplified_reversal_60d",
  "factor_name": "Stress-Amplified Relative Volatility-Scaled Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "median_demean( -rolling_sum_60(residual_return) / (rolling_std_60(residual_return)*sqrt(252)) * clip(rolling_std_20(residual_return)/rolling_std_60(residual_return), 0.5, 2.0) ).shift(1)",
    "description": "For each asset, subtract the contemporaneous cross-sectional mean return from daily return, sum residual returns over 60 sessions, invert as a contrarian signal, scale by 60-session residual volatility, and amplify recent stress when 20-session residual volatility exceeds its 60-session baseline. Cross-sectionally median demean and lag one completed session."
  },
  "dependencies": [
    "close",
    "daily_returns"
  ],
  "parameters": {
    "relative_return_window": 60,
    "long_volatility_window": 60,
    "short_volatility_window": 20,
    "annualization": 252,
    "stress_clip": [
      0.5,
      2.0
    ],
    "signal_lag_sessions": 1,
    "minimum_cross_section": 8
  },
