  "dependencies": [
    "close",
    "high",
    "low"
  ],
  "parameters": {
    "return_window": 10,
    "volatility_window": 20,
    "location_window": 10,
    "location_weight": 0.8,
    "vol_floor": 0.02,
    "clip": [
