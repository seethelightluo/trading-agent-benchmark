  "factor_id": "close_location_reversal_20d",
  "factor_name": "Close-location pressure and volatility-scaled reversal",
  "version": "1.0",
  "calculation": {
    "expression": "shift1(clip(-rolling_sum(return,10)/(rolling_std(return,20)*sqrt(10)+0.02) - 0.8*rolling_mean(((close-low)/(high-low+eps)-0.5),10), -5, 5))",
    "description": "Ranks instruments higher when their recent ten-session return is negative after volatility scaling and their closes have tended toward the lower half of daily ranges. The complete signal is lagged by one session to prevent look-ahead bias."
