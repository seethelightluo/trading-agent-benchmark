  "factor_name": "Cross-Sectional Residual Reversal, 20-Day",
  "version": "1.0",
  "calculation": {
    "expression": "-(close_t/close_{t-20}-1 - cross_sectional_median(close_t/close_{t-20}-1)) / rolling_std(pct_change(close),20), lagged 1 session",
