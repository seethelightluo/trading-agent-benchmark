{
  "factor_id": "volcompression_reversal_20d",
  "factor_name": "Volatility-compression conditioned 20-day reversal",
  "version": "1.0",
  "calculation": {
    "expression": "[-(return_20d / (realized_vol_20d * sqrt(20))) * (1 + 0.5 * (1 - clip(realized_vol_20d / realized_vol_60d, 0.25, 3.0)))] lagged_one_day",
    "description": "Contrarian standardized 20-day return, with a larger reversal weight when short realized volatility is compressed relative to its 60-day baseline. All inputs are lagged one completed session before use."
  },
  "dependencies": [
    "close",
    "daily_returns"
  ],
  "parameters": {
    "return_window_days": 20,
    "short_vol_window_days": 20,
    "long_vol_window_days": 60,
    "short_vol_min_periods": 15,
    "long_vol_min_periods": 40,
    "compression_clip": [
      0.25,
      3.0
    ],
    "compression_weight": 0.5,
    "signal_lag_days": 1,
    "forward_horizon_days": 20
  },
