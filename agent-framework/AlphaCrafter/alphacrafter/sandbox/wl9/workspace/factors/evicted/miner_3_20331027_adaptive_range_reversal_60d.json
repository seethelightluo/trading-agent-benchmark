{
  "factor_id": "miner_3_20331027_adaptive_range_reversal_60d",
  "factor_name": "Adaptive 180-day range-position weighted medium-term reversal",
  "version": "1.0",
  "calculation": {
    "expression": "clip((-(close/close.shift(60)-1)/(rolling_std(pct_change(close),60)*sqrt(252)+0.05))*(1+0.75*(0.5-(close-rolling_min(close,180))/(rolling_max(close,180)-rolling_min(close,180)))), -5, 5).shift(1)",
    "description": "A one-session-lagged contrarian 60-session return scaled by annualized 60-session volatility. The contrarian signal is strengthened for instruments near the bottom of their trailing 180-session price range and reduced near the top. The signal is clipped to limit outliers."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "return_lookback_sessions": 60,
    "range_window_sessions": 180,
    "volatility_window_sessions": 60,
    "annualization": 252,
    "volatility_floor": 0.05,
    "range_weight": 0.75,
    "clip_lower": -5,
    "clip_upper": 5,
    "lag_sessions": 1,
