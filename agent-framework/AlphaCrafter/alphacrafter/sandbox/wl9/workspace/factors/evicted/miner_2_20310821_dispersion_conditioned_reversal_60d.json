  "factor_name": "Cross-Asset Dispersion-Conditioned Relative Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-rolling_sum_60(log_return_i - cross_sectional_mean_log_return) * (0.75 + 0.75 * percentile_rank_252(mean_60(cross_sectional_std(log_return))))",
