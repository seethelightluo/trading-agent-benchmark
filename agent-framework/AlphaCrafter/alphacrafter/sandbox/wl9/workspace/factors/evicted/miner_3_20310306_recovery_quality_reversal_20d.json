  "factor_name": "Volatility-Normalized Drawdown Recovery Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(close / rolling_min(close,60) - 1) / (rolling_std(pct_change(close),20) * sqrt(252))",
    "description": "Ranks assets contrarily on their 60-session rebound from the trailing low, penalized by 20-session annualized volatility; signal is lagged one completed session to avoid look-ahead. Higher values favor assets with smaller or more volatility-efficient recoveries, consistent with the validated cross-sectional reversal effect."
