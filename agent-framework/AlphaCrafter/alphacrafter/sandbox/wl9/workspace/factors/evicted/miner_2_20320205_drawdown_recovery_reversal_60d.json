  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "lookback_high": 60,
    "min_high_observations": 40,
    "age_exponent": 0.5,
    "volatility_window": 40,
    "volatility_scale": "sqrt(40)",
    "lag_sessions": 1
  },
