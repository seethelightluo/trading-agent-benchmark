{
  "factor_id": "drawdown_recovery_reversal_60d",
  "factor_name": "Drawdown-depth Recovery Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "(-(close / rolling_max(close,60) - 1) / sqrt(age_since_rolling_max(close,60)) / rolling_std(pct_change(close),40) * sqrt(40)).shift(1)",
    "description": "Ranks assets by drawdown depth from their 60-session high, discounted by the square root of time since that high and normalized by 40-session realized volatility. The signal is lagged one completed session to avoid look-ahead. Higher values indicate deeper, more recent, volatility-adjusted pullbacks.",
