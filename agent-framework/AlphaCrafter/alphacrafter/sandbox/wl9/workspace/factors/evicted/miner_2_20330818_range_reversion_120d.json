{
  "factor_id": "miner_2_20330818_range_reversion_120d",
  "factor_name": "120D Trading-Range Midpoint Reversion",
  "version": "1.0",
  "calculation": {
    "expression": "clip(((rolling_midpoint(close,120) / close) - 1) / (rolling_std(pct_change(close),20) * sqrt(252) + 0.05), -5, 5).shift(1)",
    "description": "Ranks assets expected to mean-revert toward the midpoint of their trailing 120-session high-low range, scaled by recent 20-session annualized volatility. The one-session lag prevents look-ahead. Positive values indicate price below the range midpoint."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "range_window": 120,
    "range_min_periods": 80,
    "risk_window": 20,
    "risk_min_periods": 12,
    "risk_floor": 0.05,
    "clip_min": -5,
    "clip_max": 5,
    "lag_sessions": 1
  },
