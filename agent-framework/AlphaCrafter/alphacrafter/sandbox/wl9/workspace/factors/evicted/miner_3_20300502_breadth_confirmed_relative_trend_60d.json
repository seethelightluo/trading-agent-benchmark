  "factor_name": "Breadth-Confirmed Relative Trend",
  "version": "1.0",
  "calculation": {
    "expression": "shift1(((rolling_sum_40(pct_change_asset - cross_sectional_median_pct_change) / rolling_std_20(pct_change_asset)) * (2*cross_sectional_breadth_10d - 1)))",
    "description": "For each asset, compute its 40-session return relative to the daily cross-asset median, volatility-normalize by 20-session return standard deviation, and multiply by centered breadth (twice the fraction of assets with positive 10-session returns minus one). Lag one completed session to avoid lookahead."
