  "factor_name": "VIX-conditioned residual reversal scaled by asset volatility",
  "version": "1.0",
  "calculation": {
    "expression": "-(R60_i - median_cross_section(R60)) / (std_daily_return_i,40 * sqrt(252)) * (1 + 0.30 * clip(Z60(VIX), -2, 2))",
