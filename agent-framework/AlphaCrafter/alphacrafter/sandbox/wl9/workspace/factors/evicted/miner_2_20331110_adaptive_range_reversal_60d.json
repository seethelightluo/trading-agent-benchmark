  "factor_name": "Adaptive 180-day range-position volatility-scaled reversal",
  "version": "1.0",
  "calculation": {
    "expression": "clip((-return_60d / (annualized_volatility_60d + 0.05)) * (1 + 0.75 * (0.5 - range_position_180d)), -5, 5), lagged one session",
    "description": "Fades the asset's 60-day return after volatility adjustment, with a medium-term range-position multiplier. Assets near the bottom of their 180-day price range receive stronger contrarian weight; assets near the top receive weaker reversal weight. Signal is lagged to prevent look-ahead."
  },
