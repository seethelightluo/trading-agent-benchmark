  "factor_name": "20-day volatility-normalized drawdown-aware reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(close/lag(close,20)-1)/(rolling_std(daily_return,60)*sqrt(60)+1e-6)*(1+0.25*abs(min(close/rolling_max(close,120)-1,0)))",
