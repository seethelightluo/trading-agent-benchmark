{
  "factor_id": "miner_3_20350201_shortshock_reversal_60d",
  "factor_name": "Short-Shock Volatility-Normalized Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "(-(close_t/close_{t-5}-1) / (sqrt(5)*rolling_std(pct_change(close),20)+epsilon)).shift(1)",
    "description": "Fades each instrument's five-trading-day price shock, scaled by its trailing 20-day return volatility. The one-day lag ensures that only completed trading-day information is used."
  },
  "dependencies": [
    "close",
    "pct_change(close)"
  ],
  "parameters": {
    "shock_window_days": 5,
    "volatility_window_days": 20,
    "volatility_min_periods": 15,
    "shock_scaling": "sqrt(5)",
    "epsilon": 1e-05,
    "signal_lag_days": 1,
