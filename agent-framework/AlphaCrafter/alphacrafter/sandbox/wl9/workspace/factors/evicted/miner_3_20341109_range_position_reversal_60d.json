  "factor_name": "Volatility-Adjusted 60D Range-Position Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(close / ((rolling_max(close,60) + rolling_min(close,60)) / 2) - 1) / (rolling_std(pct_change(close),20) + 0.005), lagged 1 completed day",
    "description": "Ranks assets favoring those below their trailing 60-day range midpoint and penalizes high recent volatility. The one-day lag prevents use of the current incomplete observation."
  },
