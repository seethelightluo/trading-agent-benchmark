  "factor_name": "Volatility-scaled cross-asset residual contrarian reversal",
  "version": "1.0",
  "calculation": {
    "expression": "(-((close/close.shift(60)-1) - rolling_sum(equal_weight_mean(pct_change(close)),60)) / (rolling_std(pct_change(close),40)*sqrt(252)+0.04)).clip(-5,5).shift(1)",
    "description": "Ranks assets higher when their 60-session return underperformed the equal-weight tradable-universe return, scaled by 40-session annualized volatility. Inputs are lagged one completed session to avoid look-ahead."
