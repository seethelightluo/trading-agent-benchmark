{
  "factor_id": "miner_1_20340202_breadth_conditioned_residual_momentum_10d",
  "factor_name": "Breadth-conditioned residual momentum/reversal",
  "version": "1.0",
  "calculation": {
    "expression": "lag1(standardize_cs((20d_asset_return - mean_cs(20d_asset_return)) * (1 if 20d_market_breadth >= 0.60 else -1) / max(annualized_20d_volatility, 0.04)))",
    "description": "Uses the sign of equal-weight cross-asset 20-session breadth to adapt between continuation in broad positive regimes and residual reversal in weaker regimes. Signal is lagged one completed session, cross-sectionally standardized and clipped to [-5,5]."
  },
  "dependencies": [
    "close",
    "daily_returns"
  ],
  "parameters": {
    "return_window": 20,
    "volatility_window": 20,
    "breadth_threshold": 0.6,
    "vol_floor": 0.04,
    "lag_sessions": 1,
    "clip": [
