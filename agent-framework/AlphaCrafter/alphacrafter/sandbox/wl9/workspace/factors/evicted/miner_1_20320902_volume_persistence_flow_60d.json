{
  "factor_id": "miner_1_20320902_volume_persistence_flow_60d",
  "factor_name": "Volume Persistence Flow Pressure",
  "version": "1.0",
  "calculation": {
    "expression": "shift(rolling_sum_20(return * clip(volume / rolling_median_60(volume) - 1, -3, 3)) / annualized_rolling_std_60(return), 1)",
    "description": "Accumulates signed returns during abnormal-volume sessions, scales by 60-session annualized volatility, and lags one completed session. Positive values represent persistent flow pressure."
  },
