{
  "factor_id": "miner_2_20311127_downside_correlation_reversal_20d",
  "factor_name": "Downside-Correlation Conditioned Cross-Asset Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-cross_sectional_residual_return_40d * (1 + rolling_corr_80d(asset_daily_return, benchmark_return_on_negative_benchmark_days))",
    "description": "Compute each asset's 40-session return minus the contemporaneous 15-asset mean return. Multiply its negative (contrarian) signal by one plus the rolling 80-session correlation between the asset return and the equal-weight benchmark return, with correlation evaluated against benchmark returns only on negative benchmark days. Lag the signal one completed session before forward-return evaluation."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "residual_lookback": 40,
    "downside_correlation_lookback": 80,
    "benchmark": "equal_weight_mean_daily_log_return",
