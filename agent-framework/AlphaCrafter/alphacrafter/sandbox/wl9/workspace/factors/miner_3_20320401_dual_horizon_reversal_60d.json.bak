  "factor_name": "Dual-horizon downside-risk reversal",
  "version": "1.0",
  "calculation": {
    "expression": "((-ret20/(downside_vol60+vol60))*(1+clip(ret5-ret60/12,-0.25,0.25))).shift(1)",
    "description": "Contrarian 20-session return, normalized by the sum of 60-session downside and total volatility, modulated by a short-versus-medium horizon turn signal. Positive values indicate expected rebound. All inputs are lagged one completed session."
