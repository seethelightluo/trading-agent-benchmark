{
  "factor_id": "miner_3_20350301_residual_reversal_60d",
  "factor_name": "Benchmark-Residual Risk-Adjusted Reversal 60D",
  "version": "1.0",
  "calculation": {
    "expression": "-rolling_sum(residual_return,60)/(sqrt(60)*rolling_std(residual_return,60)+epsilon), lagged 1 day",
    "description": "For each tradable instrument, estimate a 120-day rolling beta to the equal-weight return of all 15 tradable instruments, remove benchmark exposure, fade the 60-day cumulative residual move, and scale by residual volatility. The signal is shifted one completed day to avoid look-ahead."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "benchmark": "equal_weight_mean_of_15_tradable_returns",
    "beta_window": 120,
    "beta_min_periods": 80,
    "reversal_window": 60,
    "reversal_min_periods": 45,
    "epsilon": 1e-08,
    "signal_lag_days": 1
  },
