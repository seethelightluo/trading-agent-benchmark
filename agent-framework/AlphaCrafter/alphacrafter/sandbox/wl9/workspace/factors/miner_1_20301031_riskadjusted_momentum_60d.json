  "calculation": {
    "expression": "cross_sectional_demean(-(close/close.shift(120)-1)/(std(pct_change(close),60)*sqrt(252))).shift(1)",
    "description": "Ranks assets higher when their 120-trading-day return is more negative after scaling by 60-day annualized realized volatility. Cross-sectional demeaning and one-session lag prevent common-market level effects and look-ahead use. Intended as a medium-horizon rebound signal."
