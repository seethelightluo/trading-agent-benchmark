{
  "factor_id": "miner_2_20320916_volatility_compression_reversal_60d",
  "factor_name": "Volatility Compression Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "(-(close/close.shift(20)-1) * (rolling_std(return,120) / rolling_std(return,20))).shift(1)",
    "description": "Cross-asset contrarian 20-session return amplified when recent realized volatility is compressed relative to its 120-session baseline. The one-session lag ensures only completed daily data are used. Positive values indicate stronger expected forward recovery."
  },
  "dependencies": ["close", "daily returns"],
  "parameters": {
    "short_return_window": 20,
    "short_volatility_window": 20,
    "long_volatility_window": 120,
    "volatility_min_periods_short": 15,
    "volatility_min_periods_long": 80,
    "signal_lag_sessions": 1,
    "admission_horizon_sessions": 60
  },
