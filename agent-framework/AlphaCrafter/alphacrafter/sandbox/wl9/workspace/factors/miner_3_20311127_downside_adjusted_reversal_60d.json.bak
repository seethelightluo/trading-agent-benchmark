{
  "factor_id": "miner_3_20311127_downside_adjusted_reversal_60d",
  "factor_name": "Downside-risk-adjusted 60-day contrarian reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-pct_change(close,60) / (sqrt(252) * rolling_std(log_return.where(log_return<0),30,min_periods=12))",
    "description": "Ranks assets favoring negative trailing 60-session returns, scaled by trailing 30-session downside volatility; signal is shifted one completed session before forward-return evaluation to prevent look-ahead."
  },
  "dependencies": ["close", "date"],
  "parameters": {"return_window": 60, "downside_vol_window": 30, "downside_vol_min_periods": 12, "annualization": 252, "signal_lag": 1},
