{
  "factor_id": "shortvol_reversal_60d",
  "factor_name": "Short-Horizon Volatility-Adjusted Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-return(close,20) / (annualized_std(pct_change(close),60) + 1e-8), lagged 1 session",
    "description": "Fades each instrument's trailing 20-session price return and scales the contrarian exposure by trailing 60-session realized volatility. The signal is shifted by one completed session to avoid look-ahead."
  },
  "dependencies": [
    "close",
    "pct_change"
  ],
  "parameters": {
    "return_window": 20,
    "volatility_window": 60,
    "volatility_min_periods": 45,
    "forward_horizon": 60,
    "lag": 1,
    "annualization": "sqrt(60)"
  },
