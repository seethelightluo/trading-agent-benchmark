{
  "factor_id": "miner_2_volscaled_trend_10d",
  "factor_name": "Ten-day volatility-scaled trend",
  "version": "20280127",
  "calculation": {
    "expression": "(close_t / close_{t-20} - 1) / std(pct_change(close)_{t-19:t})",
    "description": "Ranks assets by their trailing 20-trading-day return divided by trailing 20-day daily-return volatility. Positive values indicate persistent risk-adjusted trends; all inputs are observable through the prior completed day.",
