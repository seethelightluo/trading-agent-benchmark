{
  "factor_id": "miner_3_20330303_vix_conditioned_short_reversal_60d",
  "factor_name": "VIX-Conditioned Volatility-Normalized 20D Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "(-return_20d / (rolling_std_daily_return_20d * sqrt(252) + 0.05)) * (1 + 0.30*tanh((VIX - rolling_median_252(VIX)) / (rolling_std_252(VIX)+1e-8)))",
    "description": "A lagged, volatility-normalized short-horizon reversal signal. The reversal is amplified when lagged VIX is elevated relative to its trailing one-year distribution. VIX is observation-only; the signal is shifted one completed session to avoid look-ahead."
  },
  "dependencies": ["close", "pct_change", "VIX"],
  "parameters": {"reversal_window": 20, "risk_window": 20, "vix_window": 252, "annualization": 252, "vol_floor": 0.05, "stress_amplitude": 0.30, "signal_lag_sessions": 1, "forward_validation_horizon": 60},
  "validation": {
    "status": "EFFECTIVE",
    "period": {"start": "2020-01-01", "end": "2033-03-02", "data_cutoff": "2033-03-02"},
