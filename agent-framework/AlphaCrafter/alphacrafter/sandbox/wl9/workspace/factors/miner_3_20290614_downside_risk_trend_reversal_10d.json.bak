  "factor_name": "Downside-risk-scaled trend reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(0.7*return(close,10)+0.3*return(close,60))/((rolling_std(negative_daily_returns,20)*sqrt(20))+1e-6)",
    "description": "Ranks assets for 10-trading-day forward returns by the inverse of a downside-volatility-scaled blend of 10-day and 60-day momentum. The negative sign captures the empirically observed reversal of recent risk-adjusted trends in the available online-era sample."
