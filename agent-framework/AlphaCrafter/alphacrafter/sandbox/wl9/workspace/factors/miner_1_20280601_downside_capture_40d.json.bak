  "factor_id": "miner_1_downside_capture_40d",
  "factor_name": "Forty-day downside capture efficiency",
  "version": "20280601",
  "calculation": {
    "expression": "-(mean(asset_returns on days when equity_benchmark_return < 0 over trailing 40 sessions)) / rolling_std(asset_daily_returns,40)",
