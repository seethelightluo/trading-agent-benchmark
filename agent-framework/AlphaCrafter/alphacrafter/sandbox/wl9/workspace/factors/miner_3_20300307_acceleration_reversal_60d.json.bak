{
  "factor_id": "miner_3_20300307_acceleration_reversal_60d",
  "factor_name": "Contrarian return-acceleration reversal",
  "version": "1.0",
  "calculation": {
    "expression": "(-(return_10d - return_40d/4)).shift(1)",
    "description": "For each tradable asset, measure the recent 10-session return relative to its preceding 40-session average ten-session-equivalent return, negate the acceleration, and lag one completed session. Higher values indicate unusually recent weakness expected to mean-revert over a 60-session horizon."
  },
  "dependencies": ["close"],
  "parameters": {
    "short_return_window": 10,
    "baseline_return_window": 40,
    "baseline_scaling": 4,
    "lag_sessions": 1,
    "forward_horizon_days": 60,
    "minimum_cross_section": 8
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": {"start": "2020-03-03", "end": "2030-03-07"},
    "validated_at": "2030-03-07",
    "metrics": {
      "ic": 0.048333,
      "icir": 0.165433,
      "horizon_days": 60,
