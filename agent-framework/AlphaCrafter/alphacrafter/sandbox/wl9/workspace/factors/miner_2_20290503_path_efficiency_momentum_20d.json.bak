{
  "factor_id": "miner_2_20290503_path_efficiency_momentum_20d",
  "factor_name": "Volatility-scaled directional path efficiency momentum",
  "version": "1.0",
  "calculation": {
    "expression": "((close/close.shift(20))-1) / (sum(abs(daily_return),20) * std(daily_return,20))",
    "description": "Ranks assets by net 20-session price movement relative to cumulative absolute movement, additionally scaled by recent return volatility. Positive values indicate persistent directional movement; negative values indicate inefficient/downward paths. Signal is formed at the prior completed close and evaluated against the 20-trading-day forward return."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "lookback_days": 20,
    "forward_horizon_days": 20,
    "minimum_cross_section": 8,
    "epsilon": 1e-08
  },
