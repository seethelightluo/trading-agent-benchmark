{
  "factor_id": "miner_1_20301003_cross_sectional_dispersion_reversal_60d",
  "factor_name": "Dispersion-Activated Idiosyncratic Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "lag1( - (return_10d - cross_sectional_median(return_10d)) / rolling_std(return_1d,20) * (0.5 + 0.5*I[rolling20_rankpct(cross_sectional_std(return_10d)) >= 0.5] ) )",
    "description": "Ranks assets favorably when they are recent 10-day relative shock laggards, volatility-scaled, with stronger reversal exposure during elevated cross-sectional dispersion. The one-session lag prevents look-ahead."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "shock_window_days": 10,
    "risk_window_days": 20,
    "dispersion_window_days": 20,
    "dispersion_activation_rank": 0.5,
    "low_dispersion_multiplier": 0.5,
    "lag_days": 1,
    "forward_horizon_days": 60
  },
  "signal_artifact": "scripts/miner_1_20301003_cross_sectional_dispersion_reversal_signal.csv",
  "validation": {
