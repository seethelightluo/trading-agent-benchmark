{
  "factor_id": "miner_2_20300613_volscaled_short_reversal_40d",
  "factor_name": "Volatility-Scaled Smoothed Short Relative Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "rolling_mean_5(-rolling_sum_10(asset_return - cross_sectional_median_return) / rolling_std_20(asset_return)).shift(1)",
    "description": "Ranks assets favorably when their recent 10-day return lagged the cross-sectional median, scaled by 20-day volatility and smoothed over five days. One-day lag prevents look-ahead."
  },
  "dependencies": ["close", "daily_returns"],
  "parameters": {"relative_return_window": 10, "volatility_window": 20, "smoothing_window": 5, "lag_days": 1, "forward_validation_horizon_days": 40},
  "validation": {
    "status": "EFFECTIVE",
