{
  "factor_id": "miner_3_20340914_rebound_acceleration_60d",
  "factor_name": "Volatility-scaled rebound acceleration",
  "version": "1.0",
  "calculation": {
    "expression": "((close/close.shift(20)-1) - (close/close.shift(60)-1)) / (rolling_std(pct_change(close),60)+0.005), shifted one completed day",
    "description": "Ranks assets whose recent 20-day return has improved relative to their 60-day return, normalized by 60-day daily volatility. The one-day lag prevents look-ahead. Positive values identify accelerating rebounds."
  },
  "dependencies": ["close"],
  "parameters": {"short_window": 20, "long_window": 60, "volatility_window": 60, "volatility_floor": 0.005, "signal_lag_days": 1, "forward_horizon_days": 60},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2034-09-13",
    "last_validated": "2034-09-14",
    "metrics": {
