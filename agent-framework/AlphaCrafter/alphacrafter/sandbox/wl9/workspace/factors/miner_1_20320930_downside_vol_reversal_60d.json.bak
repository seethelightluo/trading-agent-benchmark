{
  "factor_id": "miner_1_20320930_downside_vol_reversal_60d",
  "factor_name": "Downside-Volatility-Normalized 60D Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-rolling_sum(pct_change(close),60,min_periods=40) / (sqrt(60)*rolling_rms(negative_only(pct_change(close)),60,min_periods=40))",
    "description": "Contrarian 60-session return scaled by downside realized volatility, lagged by one completed session to prevent look-ahead. Higher values indicate stronger reversal potential."
  },
  "dependencies": ["close"],
  "parameters": {"lookback_sessions": 60, "minimum_observations": 40, "forward_horizon_sessions": 60, "lag_sessions": 1, "downside_only": true},
  "signal_artifact": "scripts/miner_1_20320930_downside_vol_reversal_signal.csv",
  "validation": {
