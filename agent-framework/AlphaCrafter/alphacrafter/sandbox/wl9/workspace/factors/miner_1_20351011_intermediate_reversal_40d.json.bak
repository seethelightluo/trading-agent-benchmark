{
  "factor_id": "miner_1_20351011_intermediate_reversal_40d",
  "factor_name": "40D Drawdown-Weighted Volatility-Scaled Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "(-return_40d_lag1 / (realized_volatility_60d_lag1 * sqrt(40) + 0.05)) * (0.5 + drawdown_from_lagged_120d_high)",
    "description": "Contrarian intermediate-horizon return, scaled by lagged 60-day realized volatility and weighted toward assets below their lagged 120-day high. All inputs use data through the previous completed day; higher values indicate stronger expected forward relative return. Values are clipped to [-20,20]."
  },
  "dependencies": ["close", "daily_returns"],
  "parameters": {
    "return_window_days": 40,
    "volatility_window_days": 60,
    "drawdown_high_window_days": 120,
    "volatility_floor": 0.05,
    "drawdown_multiplier": "0.5 + drawdown",
    "clip_range": [-20, 20],
    "lag_days": 1
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2035-10-10",
    "as_of": "2035-10-11",
