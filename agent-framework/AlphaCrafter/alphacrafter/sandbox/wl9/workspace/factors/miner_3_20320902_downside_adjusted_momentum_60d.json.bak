{
  "factor_id": "miner_3_20320902_downside_adjusted_momentum_60d",
  "factor_name": "Downside-Adjusted Momentum Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "(-((close / close.shift(60)) - 1) / rolling_std(negative_only(pct_change(close)), 60, min_periods=40) * sqrt(252)).shift(1)",
    "description": "Contrarian 60-session return divided by 60-session downside realized volatility, with the signal negated and lagged one completed session. Higher values indicate assets with weaker downside-adjusted momentum and expected recovery potential."
  },
  "dependencies": ["close"],
  "parameters": {
    "lookback_sessions": 60,
    "downside_volatility_window": 60,
    "downside_volatility_min_periods": 40,
    "annualization": 252,
    "lag_sessions": 1,
    "forward_validation_horizon": 60
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 to 2032-09-01",
