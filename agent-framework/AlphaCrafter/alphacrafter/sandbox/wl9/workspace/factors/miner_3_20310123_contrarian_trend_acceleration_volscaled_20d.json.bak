{
  "factor_id": "miner_3_20310123_contrarian_trend_acceleration_volscaled_20d",
  "factor_name": "Volatility-Scaled Contrarian Trend Acceleration",
  "version": "1.0",
  "calculation": {
    "expression": "((return_20 / volatility_20) - (return_60 / volatility_20)).shift(1)",
    "description": "Ranks assets positively when their recent 20-session risk-adjusted trend trails their 60-session risk-adjusted trend, expressing contrarian normalization while scaling by current realized volatility. Signal is lagged one completed session to prevent look-ahead."
  },
  "dependencies": ["close"],
  "parameters": {"short_window": 20, "long_window": 60, "volatility_window": 20, "lag": 1, "min_cross_section": 8, "admission_horizon_days": 20},
