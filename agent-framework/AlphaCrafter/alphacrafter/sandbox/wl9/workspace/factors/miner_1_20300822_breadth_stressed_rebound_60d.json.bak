{
  "factor_id": "miner_1_20300822_breadth_stressed_rebound_60d",
  "factor_name": "Breadth-stressed relative downside shock rebound",
  "version": "1.0",
  "calculation": {
    "expression": "shift1(rolling_mean_3(-(ret10 - cross_sectional_median(ret10)) / (rolling_mean_30(abs(min(ret1,0))) + 1e-8) * I(cross_sectional_breadth_20 < 0.47))",
    "description": "Ranks relative 10-session downside shocks by downside volatility, activates the contrarian rebound only when fewer than 47% of tradable assets have positive 20-session returns, smooths the signal over three sessions, and lags it one session to avoid look-ahead."
  },
  "dependencies": ["close", "daily_return"],
  "parameters": {"shock_window": 10, "downside_vol_window": 30, "breadth_window": 20, "breadth_threshold": 0.47, "smoothing_window": 3, "lag": 1, "forward_horizon": 60},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2030-08-22",
    "validated_at": "2030-08-22",
    "metrics": {
      "horizon_days": 60,
      "dates": 1538,
      "average_instruments": 13.90,
      "coverage": 0.9264,
      "ic": 0.064056,
      "icir": 0.198081,
      "hit_ratio": 0.5897,
      "turnover_proxy": 0.088856,
      "max_abs_library_correlation": null
    },
    "regime_notes": "Positive across 2024-2026 (347 dates, IC 0.064725, ICIR 0.204456) and 2027-2030 (788 dates, IC 0.092855, ICIR 0.308013). Small 15-asset cross-section requires conservative uncertainty interpretation.",
    "signal_artifact": "scripts/miner_1_20300822_breadth_stressed_rebound_signal.csv"
  },
  "tags": ["reversal", "downside-risk", "breadth-conditioned", "cross-asset"],
