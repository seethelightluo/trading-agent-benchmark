  "factor_name": "Downside-adjusted medium-term contrarian",
  "version": "1.0",
  "calculation": {
    "expression": "-(return_60 / (sqrt(252) * rolling_mean(max(-daily_return,0),60))).shift(1)",
    "description": "Ranks assets positively when their lagged 60-session return is weak relative to their downside semideviation; one-session lag prevents look-ahead. Higher values indicate stronger contrarian preference."
  },
