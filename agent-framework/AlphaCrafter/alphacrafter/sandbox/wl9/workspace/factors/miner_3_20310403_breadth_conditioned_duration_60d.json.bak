{
  "factor_id": "miner_3_20310403_breadth_conditioned_duration_60d",
  "factor_name": "Breadth-Conditioned Drawdown Duration Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "(drawdown_duration_60 / annualized_volatility_20) * (2 - breadth_20).shift(1)",
    "description": "For each tradable asset, count sessions since its most recent 60-session high, divide by 20-session annualized volatility, and amplify the reversal score when the cross-asset fraction with positive 20-session return is low. The signal is lagged one session to avoid look-ahead. Higher values indicate longer, volatility-adjusted drawdown duration in stressed breadth conditions."
  },
  "dependencies": [
    "close",
    "pct_change"
  ],
  "parameters": {
    "drawdown_lookback_sessions": 60,
    "volatility_lookback_sessions": 20,
    "breadth_lookback_sessions": 20,
    "forward_horizon_sessions": 60,
    "signal_lag_sessions": 1,
    "minimum_cross_section": 8
  },
