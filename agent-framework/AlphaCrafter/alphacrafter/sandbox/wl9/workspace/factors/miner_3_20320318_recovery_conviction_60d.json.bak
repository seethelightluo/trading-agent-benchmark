{
  "factor_id": "miner_3_20320318_recovery_conviction_60d",
  "factor_name": "Recovery-Conviction Reversal 60D",
  "version": "1.0",
  "calculation": {
    "expression": "lag1((-(close/close.shift(20)-1)/(rolling_std(pct_change(close),60)+eps))*(1+clip(-(close/rolling_max(close,60)-1),0,0.35))*(0.5+rolling_mean(pct_change(close)>0,20))",
    "description": "Contrarian 20-session loss, risk-normalized by 60-session volatility, amplified by drawdown from the 60-session high and by recent positive-day conviction; every component is lagged one completed session to prevent look-ahead. Higher values predict stronger forward returns."
  },
  "dependencies": ["close"],
  "parameters": {"return_lookback": 20, "volatility_lookback": 60, "drawdown_lookback": 60, "recovery_lookback": 20, "drawdown_clip": 0.35, "lag_sessions": 1, "epsilon": 1e-8},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2032-03-17",
    "timestamp": "2032-03-18T00:00:00Z",
    "regime_notes": "Positive across evaluated 2024-2032 regimes, with weaker but positive 2031-2032 partial performance; long-horizon predictive strength materially exceeds short-horizon strength.",
    "metrics": {
      "ic_horizon_days": 60,
      "ic": 0.174605,
      "icir": 0.563755,
      "hit_ratio": 0.7085,
      "valid_dates": 1403,
      "average_instruments": 14.99,
      "universe_size": 15,
      "minimum_instruments_per_date": 8,
      "coverage": 0.459669,
      "turnover": 0.058329,
      "decay_ic": {"5d": 0.040578, "10d": 0.064752, "20d": 0.079622, "40d": 0.133021, "60d": 0.174605},
      "max_abs_library_correlation": null
    },
    "signal_artifact": "scripts/miner_3_20320318_recovery_conviction_signal.csv",
    "validation_method": "Daily cross-sectional Spearman IC against forward close-to-close returns; at least 8 valid instruments per date; lagged signal; all 15 tradable assets included."
  },
  "tags": ["reversal", "recovery", "volatility_adjusted", "drawdown", "cross_asset"]
}
