{
  "factor_id": "miner_1_20340914_dispersion70_residual_recovery_60d",
  "factor_name": "70th-percentile dispersion-gated residual recovery",
  "version": "1.0",
  "calculation": {
    "expression": "where(std_cs(sum_return_60), std_cs(sum_return_60).rolling(120).quantile(0.70), (-residual_60/(sqrt(20)*volatility_20+0.02) + 1.5*return_10/(sqrt(20)*volatility_20+0.02)))",
    "description": "Cross-sectional residual recovery: fade 60-day residual weakness and add recent 10-day recovery, volatility scaled, activated only when cross-sectional 60-day return dispersion exceeds its trailing 120-session 70th percentile; signal is lagged one session."
  },
  "dependencies": ["close"],
  "parameters": {"residual_window": 60, "recovery_window": 10, "volatility_window": 20, "dispersion_window": 120, "dispersion_quantile": 0.70, "volatility_floor": 0.02, "recovery_weight": 1.5, "signal_lag": 1, "universe_size": 15},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01/2034-09-13",
    "validated_at": "2034-09-14",
    "metrics": {"admission_horizon_days": 60, "ic": 0.05254343, "icir": 0.13420427, "hit_ratio": 0.58608059, "valid_dates": 1365, "average_instruments": 15.0, "coverage": 0.30610890, "active_date_fraction": 0.30610890, "rank_turnover": 0.06300037, "max_abs_library_correlation": null},
    "thresholds": {"absolute_ic_min": 0.007, "absolute_icir_min": 0.084},
    "regime_notes": "Negative in 2020-2023 (IC -0.12157, ICIR -0.26714); positive in 2024-2026 (0.13619, 0.47219), 2027-2029 (0.08215, 0.25104), 2030-2032 (0.11478, 0.37220), and 2033-2034 (0.03959, 0.12412). Small 15-asset cross-section requires conservative interpretation.",
    "provenance": {"validation_script": "scripts/miner_1_20340914_dispersion70_residual_recovery.py", "signal_artifact": "scripts/miner_1_20340914_dispersion70_residual_recovery_signal.csv", "signal_artifact_columns": ["date", "symbol", "signal"]}
  },
  "tags": ["cross_asset", "residual", "reversal", "dispersion", "volatility_scaled", "conditional"],
