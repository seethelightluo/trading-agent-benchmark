{
  "factor_id": "miner_1_20320624_peak_drawdown_recovery_60d",
  "factor_name": "Peak Drawdown Recovery Volatility-Scaled Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "((-((close / rolling_max(close,120)) - 1) / (rolling_std(pct_change(close),60)*sqrt(60))) * (0.5 + max(rolling_sum(pct_change(close),10),0))).shift(1)",
    "description": "Ranks assets positively when they are deeply below their trailing 120-session peak, scaled by trailing 60-session volatility, with a nonnegative 10-session rebound confirmation multiplier. All inputs are shifted one completed session to prevent look-ahead. Higher values indicate preferred recovery candidates."
  },
  "dependencies": [
    "close",
    "date"
  ],
  "parameters": {
    "peak_window": 120,
    "volatility_window": 60,
    "rebound_window": 10,
    "minimum_peak_observations": 80,
    "minimum_volatility_observations": 40,
    "minimum_rebound_observations": 8,
    "lag_sessions": 1,
    "validation_horizon_sessions": 60
  },
