{
  "factor_id": "relative_residual_reversal_20d",
  "factor_name": "Volatility-scaled cross-asset relative residual reversal",
  "version": "1.0",
  "calculation": {
    "expression": "clip(-(ret_20 - cross_sectional_median(ret_20))/(annualized_std(ret_1,60)+0.05), -5, 5).shift(1)",
    "description": "Ranks assets for contrarian exposure to their 20-session return residual relative to the contemporaneous cross-asset median, normalized by 60-session annualized volatility. Positive values identify relative laggards expected to rebound. The one-session lag prevents look-ahead bias."
  },
  "dependencies": ["close", "pct_change"],
  "parameters": {"return_window": 20, "volatility_window": 60, "volatility_floor": 0.05, "clip": [-5, 5], "lag_sessions": 1, "forward_horizon_days": 20},
  "validation": {
