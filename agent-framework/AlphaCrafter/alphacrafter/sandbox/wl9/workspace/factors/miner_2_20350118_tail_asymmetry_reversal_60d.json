{
  "factor_id": "miner_2_20350118_tail_asymmetry_reversal_60d",
  "factor_name": "Tail-Asymmetry Volatility-Scaled Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(close/shift(close,60)-1) * (rolling_mean(abs(min(pct_change(close),0)),60) / (rolling_mean(max(pct_change(close),0),60)+1e-5)) / (rolling_std(pct_change(close),60)+1e-5), then lag 1 day",
    "description": "Contrarian signal that emphasizes assets with negative 60-day returns and loss-heavy recent daily paths, normalized by realized volatility. The signal is shifted one completed trading day to avoid look-ahead."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "lookback_days": 60,
    "forward_horizon_days": 60,
    "minimum_observations": 45,
