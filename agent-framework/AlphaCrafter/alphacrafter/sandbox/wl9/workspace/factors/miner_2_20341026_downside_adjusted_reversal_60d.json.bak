{
  "factor_id": "miner_2_20341026_downside_adjusted_reversal_60d",
  "factor_name": "Downside-adjusted 60-day contrarian reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-return_60d / (downside_std_60d + 0.005), lagged 1 completed session",
    "description": "Ranks assets higher when their trailing 60-day return is weak relative to their downside volatility, producing a contrarian signal. Downside deviation uses daily returns below zero over the trailing 60 sessions with a minimum of 40 observations. Signal is shifted by one session to avoid look-ahead."
  },
  "dependencies": ["close", "daily_returns"],
  "parameters": {
    "lookback_days": 60,
    "downside_window": 60,
    "downside_min_periods": 40,
    "volatility_floor": 0.005,
    "signal_lag_days": 1,
    "forward_horizon_days": 60
  },
