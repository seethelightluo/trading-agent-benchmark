{
  "factor_id": "miner_3_20340427_downside_dispersion_rebound_60d",
  "factor_name": "High-dispersion downside shock rebound",
  "version": "1.0",
  "calculation": {
    "expression": "shift_1(max(-return(close,20),0) / (annualized_std(return(close,1),60) + 0.05) * I(cross_asset_20d_dispersion > rolling_quantile(cross_asset_20d_dispersion,120,0.75)), 1)",
    "description": "Ranks assets positively when they experienced a large negative 20-session return normalized by 60-session volatility, but only during high cross-asset dispersion. The completed-bar signal is shifted one session to prevent look-ahead. Positive values represent expected rebound potential."
  },
  "dependencies": ["close", "daily_returns", "observation_only_cross_asset_prices"],
  "parameters": {
    "shock_lookback": 20,
    "volatility_lookback": 60,
    "volatility_floor": 0.05,
    "dispersion_lookback": 20,
    "dispersion_quantile_lookback": 120,
    "dispersion_quantile": 0.75,
    "signal_lag": 1,
    "forward_horizon": 60,
    "universe_size": 15
  },
  "validation": {
