{
  "factor_id": "miner_1_20340316_return_acceleration_20d",
  "factor_name": "Volatility-managed return acceleration",
  "version": "1.0",
  "calculation": {
    "expression": "clip((return_20d - return_60d/3) / (annualized_volatility_20d + 0.04), -5, 5), lagged_one_session",
    "description": "Measures whether recent 20-session performance is accelerating relative to the medium-term daily pace, scaled by recent volatility. Positive values indicate strengthening momentum; all inputs are shifted one completed session to prevent look-ahead."
  },
  "dependencies": ["close"],
  "parameters": {"short_window": 20, "medium_window": 60, "volatility_window": 20, "volatility_floor": 0.04, "clip_min": -5, "clip_max": 5, "lag_sessions": 1},
