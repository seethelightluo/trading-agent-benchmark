{
  "factor_id": "crosssectional_breadth_contrarian_60d",
  "factor_name": "Cross-sectional breadth contrarian, 20/60D volatility-scaled",
  "version": "1.0",
  "calculation": {
    "expression": "-((0.6*(R20_i-median_i(R20))+0.4*(R60_i-median_i(R60)))/(std20_i+0.005))",
    "description": "Fades each asset's return relative to the contemporaneous cross-sectional median over 20 and 60 sessions, with volatility scaling. The signal is shifted one completed session to avoid look-ahead. Higher values indicate stronger contrarian preference."
  },
  "dependencies": ["close"],
  "parameters": {"short_window": 20, "long_window": 60, "short_weight": 0.6, "long_weight": 0.4, "vol_window": 20, "volatility_floor": 0.005, "lag_sessions": 1, "horizon": 60},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2034-10-11",
    "validated_at": "2034-10-12",
