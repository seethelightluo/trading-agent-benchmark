  "factor_name": "Volatility-shock short-horizon contrarian reversal",
  "version": "1.0",
  "calculation": {
    "expression": "(-return_10d / (rolling_std(return_1d,20)*sqrt(252))) * (rolling_std(return_1d,20) / rolling_std(return_1d,60)), lagged_one_session",
    "description": "Ranks assets for contrarian exposure to recent ten-session moves, risk-normalized by recent volatility and amplified when short-term volatility is elevated relative to its 60-session baseline. The complete signal is shifted one session to prevent look-ahead."
