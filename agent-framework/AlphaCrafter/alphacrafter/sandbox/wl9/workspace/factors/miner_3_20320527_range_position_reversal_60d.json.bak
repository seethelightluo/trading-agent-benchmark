{
  "factor_id": "miner_3_20320527_range_position_reversal_60d",
  "factor_name": "Range-Position Conditioned Relative Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "(-relative_return_20d) * (1.5 - range_position_120d), shifted by 1 completed session",
    "description": "Cross-sectional contrarian 20-session return relative to the daily cross-sectional median, amplified for instruments near the bottom of their trailing 120-session price range. Range position is clipped to [0,1], making the multiplier range from 0.5 to 1.5. The complete signal is lagged one session to prevent look-ahead bias."
  },
  "dependencies": [
    "close",
    "daily_returns"
  ],
  "parameters": {
    "return_window": 20,
    "range_window": 120,
    "return_min_periods": 15,
    "range_min_periods": 80,
    "multiplier": "1.5 - clipped_range_position",
    "lag_sessions": 1,
    "universe_size": 15,
    "minimum_cross_section": 8
  },
  "validation": {
