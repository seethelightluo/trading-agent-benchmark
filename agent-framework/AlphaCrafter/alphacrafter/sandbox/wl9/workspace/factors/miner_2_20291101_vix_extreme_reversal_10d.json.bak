{
  "factor_id": "miner_2_20291101_vix_extreme_reversal_10d",
  "factor_name": "Extreme-VIX gated risk-scaled short-term reversal",
  "version": "2029-11-01",
  "calculation": {
    "expression": "-pct_change(close,10)/(rolling_std(pct_change(close,1),20)*sqrt(20)+1e-8) * I(VIX > rolling_quantile(VIX,252,0.75))",
    "description": "Ranks assets by negative ten-session return normalized by trailing 20-session realized volatility, activated only when observation-only VIX is above its trailing 252-session 75th percentile. Higher values indicate stronger reversal candidates during extreme volatility stress."
  },
  "dependencies": ["close", "VIX observation-only macro series"],
  "parameters": {"return_window": 10, "volatility_window": 20, "vix_quantile_window": 252, "vix_quantile": 0.75, "forward_horizon": 10},
