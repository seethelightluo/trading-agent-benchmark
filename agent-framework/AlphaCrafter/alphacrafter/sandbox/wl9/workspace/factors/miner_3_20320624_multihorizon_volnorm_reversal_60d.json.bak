  "factor_name": "Multi-horizon volatility-normalized relative reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-((0.65*(ret20-cross_sectional_median(ret20)) + 0.35*(ret60-cross_sectional_median(ret60))) / annualized_std(ret_60)).shift(1)",
    "description": "Blends short and medium horizon relative reversal, then scales by trailing 60-session annualized volatility. The one-session lag ensures only completed data are used. Higher values indicate relatively weak, volatility-adjusted assets expected to mean-revert.",
    "lookahead_control": "All inputs are shifted one completed session before signal use."
  },
  "dependencies": ["close", "returns"],
  "parameters": {"short_window": 20, "medium_window": 60, "short_weight": 0.65, "medium_weight": 0.35, "volatility_window": 60, "min_return_observations": 15, "min_volatility_observations": 40, "annualization": 252, "lag_sessions": 1},
