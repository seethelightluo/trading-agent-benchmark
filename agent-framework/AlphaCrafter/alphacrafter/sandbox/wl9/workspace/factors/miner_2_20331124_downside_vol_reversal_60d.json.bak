{
  "factor_id": "miner_2_20331124_downside_vol_reversal_60d",
  "factor_name": "Downside-volatility-scaled medium-term reversal",
  "version": "1.0",
  "calculation": {
    "expression": "clip(-(close/close.shift(60)-1)/(sqrt(rolling_mean(clip(daily_return, upper=0)^2,60))*sqrt(252)+0.04), -5, 5).shift(1)",
    "description": "Fades each asset's trailing 60-session return, scaling by realized downside volatility. The one-session lag ensures only completed data are used; clipping limits cross-asset outliers."
  },
  "dependencies": ["close"],
  "parameters": {"return_window": 60, "downside_vol_window": 60, "annualization": 252, "denominator_floor": 0.04, "clip_lower": -5, "clip_upper": 5, "signal_lag": 1},
