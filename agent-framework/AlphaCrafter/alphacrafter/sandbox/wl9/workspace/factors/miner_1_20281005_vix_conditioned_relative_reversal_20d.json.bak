{
  "factor_id": "miner_1_vix_conditioned_relative_reversal_20d",
  "factor_name": "Elevated-VIX twenty-day cross-asset relative reversal",
  "version": "20281005",
  "calculation": {
    "expression": "-((sum(log(close_t/close_{t-1}),20)) - cross_sectional_median(sum(log(close_t/close_{t-1}),20))) when VIX_t > trailing_median(VIX,60); otherwise null",
    "description": "Ranks assets with weaker trailing 20-day relative performance highest for subsequent returns during elevated-VIX regimes. Cross-sectional demeaning makes the factor a relative reversal signal; it uses only completed daily prices and the observation-only VIX series.",
    "signal_artifact": "scripts/miner_1_20281005_vix_conditioned_relative_reversal.py"
  },
  "dependencies": [
    "close",
    "VIX.close"
  ],
  "parameters": {
    "reversal_lookback_days": 20,
    "forward_horizon_days": 20,
    "vix_window_days": 60,
    "activation": "VIX > trailing_median(VIX,60)",
    "minimum_cross_section": 8,
    "universe_size": 15
  },
