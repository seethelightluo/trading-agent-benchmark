{
  "factor_id": "miner_1_20341221_range_compression_reversal_60d",
  "factor_name": "Range-Compression Volatility-Scaled Medium-Term Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "(-ret_60 / (sqrt(60)*std(ret_1,120) + 1e-6)) * clip(std(ret_1,120)/(std(ret_1,20)+1e-8),0.25,4.0)",
    "description": "Ranks assets for medium-term reversal using negative 60-day return normalized by 120-day realized volatility, amplified when recent 20-day volatility is compressed relative to its 120-day baseline. The signal is shifted by one completed session to prevent look-ahead."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "return_window_days": 60,
    "recent_volatility_window_days": 20,
    "baseline_volatility_window_days": 120,
    "compression_ratio_clip": [
      0.25,
      4.0
    ],
    "lag_days": 1,
    "minimum_cross_section": 8
  },
