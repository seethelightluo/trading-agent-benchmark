{
  "factor_id": "miner_2_20310306_inverted_persistence_100d",
  "factor_name": "100-Day Inverted Positive-Session Frequency",
  "version": "1.0",
  "calculation": {
    "expression": "-rolling_mean(indicator(close.pct_change() > 0), 100, min_periods=80).shift(1)",
    "description": "Ranks assets higher when a smaller fraction of their prior 100 sessions had positive returns, implementing the explicitly validated inverse of the failed persistence-direction candidate. The one-session lag prevents look-ahead."
  },
  "dependencies": ["close"],
  "parameters": {"window": 100, "min_periods": 80, "signal_lag": 1, "forward_horizon_days": 20},
  "validation": {
