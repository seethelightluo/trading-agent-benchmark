{
  "factor_id": "miner_2_20321125_stress_volscaled_reversal_60d",
  "factor_name": "Stress-Conditioned Volatility-Scaled Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "shift_1((-sum_return_20d) / (std_daily_return_20d * sqrt(252))) * I(equal_weight_mean_sum_return_20d <= -0.02)",
    "description": "Ranks recent 20-day losers by inverse annualized 20-day volatility, activated only when the equal-weight tradable-universe 20-day return is at or below -2 percent. The complete signal is lagged one session to prevent look-ahead bias. Higher values indicate stronger contrarian preference."
  },
  "dependencies": ["close"],
  "parameters": {
    "return_window_days": 20,
    "volatility_window_days": 20,
    "annualization": 252,
    "stress_threshold": -0.02,
    "lag_sessions": 1,
    "minimum_cross_section": 8
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2032-11-20",
    "validation_timestamp": "2032-11-25",
    "metrics": {
      "admission_horizon_days": 60,
      "ic": 0.148235,
      "icir": 0.541641,
      "hit_ratio": 0.7229,
      "valid_dates": 350,
      "average_instruments": 13.06,
      "coverage": 0.432296,
      "turnover": 0.031951,
      "max_abs_library_correlation": null,
      "admission_thresholds": {"absolute_daily_paper_ic": 0.007, "absolute_daily_paper_icir": 0.084}
    },
    "decay": {"10d_ic": 0.099634, "20d_ic": 0.124185, "40d_ic": 0.132889, "60d_ic": 0.148235},
    "regime_results": {
      "2024": {"valid_dates": 19, "ic": 0.224869, "icir": 1.562424, "hit_ratio": 1.0},
      "2027-2029": {"valid_dates": 254, "ic": 0.123778, "icir": 0.442258, "hit_ratio": 0.6693},
      "2030": {"valid_dates": 34, "ic": 0.230123, "icir": 0.93699, "hit_ratio": 0.8824},
      "2031-2032": {"valid_dates": 43, "ic": 0.194097, "icir": 0.684507, "hit_ratio": 0.7907}
    },
    "universe": "15 tradable benchmark instruments; observations require at least 8 valid instruments",
    "signal_artifact": "scripts/miner_2_20321125_stress_volscaled_reversal_signal.csv",
    "notes": "Metrics are daily cross-sectional Spearman IC against forward close-to-close returns. Only stress-activated dates contribute; effective sample coverage is lower because the conditional gate is inactive outside stress."
  },
  "tags": ["reversal", "volatility-scaled", "stress-regime", "cross-asset", "contrarian"],
