{
  "factor_id": "miner_2_20281228_downside_adjusted_momentum_20d",
  "factor_name": "Downside-risk-adjusted 20-day momentum",
  "version": "1.0",
  "calculation": {
    "expression": "(close / close.shift(20) - 1) / sqrt(mean(min(pct_change(close),0)^2 over 20 sessions))",
    "description": "Ranks assets by trailing 20-session return per unit of trailing downside deviation. The signal uses only completed historical observations and is positively oriented: higher values predict higher forward returns in the full-history validation."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "return_window": 20,
    "downside_window": 20,
    "minimum_observations": 10,
    "winsorization": null
  },
