{
  "factor_id": "miner_3_20331027_range_position_reversal_60d",
  "factor_name": "Range-Position-Scaled 60-Day Contrarian Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "clip((-(close/close[-60]-1)/(annualized_std_60+0.05)) * (1 + 0.75*(0.5-range_position_120)), -5, 5), lagged 1 day",
    "description": "Fades the 60-trading-day return after volatility scaling, with additional emphasis when the asset is near the lower end of its trailing 120-day close range. The signal is lagged one completed session to avoid look-ahead."
  },
  "dependencies": ["close", "daily_returns"],
  "parameters": {
    "return_window": 60,
    "volatility_window": 60,
    "range_window": 120,
    "volatility_floor": 0.05,
    "range_position_multiplier": 0.75,
    "clip_lower": -5,
    "clip_upper": 5,
    "lag_days": 1,
    "universe_size": 15
  },
