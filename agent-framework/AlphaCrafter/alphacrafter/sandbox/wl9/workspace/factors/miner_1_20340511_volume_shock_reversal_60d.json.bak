{
  "factor_id": "miner_1_20340511_volume_shock_reversal_60d",
  "factor_name": "Volume-confirmed downside shock reversal",
  "version": "1.0",
  "calculation": {
    "expression": "(-clip(pct_change(close,20), upper=0)/(annualized_std(pct_change(close,1),60)+0.05))*(1+clip(volume/rolling_median(volume,60)-1,lower=0))",
    "description": "Ranks assets for 60-day forward returns by downside-only 20-session reversal scaled by volatility and amplified by abnormal positive volume; signal is shifted one completed session."
  },
  "dependencies": ["close", "volume"],
  "parameters": {"return_window": 20, "volatility_window": 60, "volume_baseline_window": 60, "forward_horizon": 60, "volatility_floor": 0.05, "volume_amplifier_cap": 4.0, "min_cross_section": 8},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2034-05-10",
    "last_validated": "2034-05-11",
