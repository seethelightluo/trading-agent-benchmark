{
  "factor_id": "miner_1_20320429_shock_rebound_fade_60d",
  "factor_name": "Shock-Conditioned Rebound Fade",
  "version": "1.0",
  "calculation": {
    "expression": "-relative_return_5d * (0.5 + clip(max(0, -(relative_return_40d)), 0, 0.30)/0.10), shifted one session",
    "description": "Cross-sectional contrarian signal that fades a short-term rebound when it follows a deep 40-session relative drawdown; all inputs are lagged one completed session. Higher values indicate expected forward outperformance."
  },
  "dependencies": ["close"],
  "parameters": {"short_window": 5, "shock_window": 40, "shock_cap": 0.30, "shock_scale": 0.10, "minimum_cross_section": 8, "lag_sessions": 1},
  "validation": {
