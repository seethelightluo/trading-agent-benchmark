{
  "factor_id": "miner_3_20350927_drawdown_gated_reversal",
  "factor_name": "Drawdown-Gated Volatility-Normalized Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(return_20d_lag1 / (realized_vol_60d_lag1 * sqrt(20) + 0.05)) * drawdown_from_120d_high_lag1",
    "description": "Cross-asset contrarian 20-day return normalized by lagged 60-day volatility and emphasized when the asset is below its lagged 120-day high. All inputs are shifted to use only completed data."
  },
  "dependencies": ["close"],
  "parameters": {
    "return_window": 20,
    "volatility_window": 60,
    "drawdown_high_window": 120,
    "vol_min_periods": 40,
    "high_min_periods": 80,
    "stabilizer": 0.05,
    "lag_days": 1,
    "clip": [-20, 20]
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2035-09-26",
    "timestamp": "2035-09-27",
