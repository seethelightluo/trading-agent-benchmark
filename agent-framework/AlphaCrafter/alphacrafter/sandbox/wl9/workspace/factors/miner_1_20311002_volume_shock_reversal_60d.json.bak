{
  "factor_id": "volume_shock_reversal_60d",
  "factor_name": "Volume-Shock-Weighted Contrarian Residual Momentum",
  "version": "1.0",
  "calculation": {
    "expression": "-residual_return_60d * (0.5 + cross_sectional_rank(volume_sma_20 / volume_sma_120))",
    "description": "For each tradable asset, subtract the cross-sectional mean 60-day return, reverse its sign, and weight the reversal by relative volume shock. Signals are lagged one trading day to prevent look-ahead bias."
  },
  "dependencies": ["close", "volume"],
  "parameters": {
    "residual_return_window": 60,
    "volume_fast_window": 20,
    "volume_slow_window": 120,
    "volume_min_periods_fast": 10,
    "volume_min_periods_slow": 60,
    "volume_ratio_clip": [0.25, 4.0],
    "cross_sectional_weight_floor": 0.5,
    "signal_lag_days": 1,
    "forward_horizon_days": 20
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2031-10-02",
    "last_validated": "2031-10-02",
    "metrics": {
      "ic": 0.137822,
      "icir": 0.269688,
      "hit_ratio": 0.6114,
      "valid_ic_dates": 1580,
      "average_instruments_per_date": 8.95,
      "factor_coverage": 0.5970,
      "turnover": 0.128597,
      "decay_ic": {"5d": 0.075614, "10d": 0.119412, "20d": 0.137822, "40d": 0.160578, "60d": 0.164847},
      "max_abs_library_correlation": null
    },
    "regime_notes": "20-day IC remained positive across 2024-2026 (+0.086717), 2027-2029 (+0.092138), 2030 (+0.246755), and 2031 YTD (+0.347902). Small cross-asset cross-sections imply conservative interpretation; each IC date had at least 8 valid instruments.",
    "universe_size": 15,
    "signal_artifact": "scripts/miner_1_20311002_volume_shock_reversal_signal.csv",
    "validation_script": "scripts/miner_1_20311002_volume_shock_reversal_research.py"
  },
  "tags": ["reversal", "volume", "cross-asset", "contrarian", "liquidity"]
}
