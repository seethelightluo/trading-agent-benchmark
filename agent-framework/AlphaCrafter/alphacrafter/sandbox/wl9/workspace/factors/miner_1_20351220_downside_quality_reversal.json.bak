  "factor_name": "Downside-risk-adjusted intermediate reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(close[t-1]/close[t-61]-1) / (sqrt(60)*rolling_std(negative_daily_returns,60)[t-1] + 0.05)",
    "description": "Ranks assets by the negative of their lagged 60-session intermediate return, scaled by lagged realized downside volatility. Higher values favor assets with weaker intermediate performance after accounting for downside risk. The signal is lagged and clipped to [-20,20]."
  },
  "dependencies": ["close", "daily_returns"],
  "parameters": {
    "lookback_return_days": 60,
    "downside_volatility_window": 60,
    "minimum_downside_volatility_observations": 40,
    "volatility_annualization": "sqrt(60)",
    "volatility_floor": 0.05,
    "lag_days": 1,
    "clip": [-20, 20],
    "universe": 15
  },
