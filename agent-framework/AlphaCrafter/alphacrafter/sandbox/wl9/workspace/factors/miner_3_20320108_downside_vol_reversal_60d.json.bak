{
  "factor_id": "miner_3_20320108_downside_vol_reversal_60d",
  "factor_name": "Downside-Variance Conditioned Reversal (60d)",
  "version": "1.0",
  "calculation": {
    "expression": "-pct_change(close,20) * (0.75 + clip(rolling_mean(negative_return^2,40) / rolling_mean(return^2,40),0,1))",
    "description": "Contrarian 20-session return amplified when downside variance accounts for a larger share of recent realized variance; signal lagged one completed session."
  },
  "dependencies": ["close"],
  "parameters": {"lookback_return_days": 20, "downside_variance_window": 40, "minimum_window": 20, "base_amplifier": 0.75, "holding_horizon_days": 60, "lag_days": 1},
