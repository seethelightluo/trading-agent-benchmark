{
  "factor_id": "range_stress_reversal_20d",
  "factor_name": "Range-Stress Contrarian Reversal",
  "version": "2032-01-08",
  "calculation": {
    "expression": "(-pct_change(close,20) * ((rolling_mean((high-low)/close,20)) / rolling_mean((high-low)/close,80))).shift(1)",
    "description": "Ranks assets by a lagged 20-session contrarian return, amplified when their recent 20-session normalized trading range is elevated relative to its 80-session baseline. The one-session lag prevents look-ahead."
  },
  "dependencies": ["close", "high", "low"],
  "parameters": {"return_window_days": 20, "stress_window_days": 20, "baseline_window_days": 80, "minimum_stress_observations": 10, "minimum_baseline_observations": 40, "signal_lag_days": 1, "forward_horizon_days": 20},
  "validation": {
