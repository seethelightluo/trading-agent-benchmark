{
  "factor_id": "miner_2_20310918_volatility_shock_recovery_20d",
  "factor_name": "Volatility-Shock Recovery Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-residual_return_20d * (1 + max(0, residual_vol_5d / residual_vol_60d - 1)), lagged 1 session",
    "description": "Compute each asset's log-return residual versus the contemporaneous 15-asset mean. Reverse the 20-session residual return and amplify it when 5-session residual volatility exceeds 60-session residual volatility, with the shock multiplier capped at 3. Forward validation uses 20-session returns and all signals are lagged one session."
  },
  "dependencies": ["close"],
  "parameters": {"residual_window": 20, "short_vol_window": 5, "long_vol_window": 60, "forward_horizon": 20, "lag": 1, "shock_cap": 3},
  "validation": {
