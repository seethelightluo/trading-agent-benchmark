{
  "factor_id": "miner_2_20310109_range_position_reversal_60d",
  "factor_name": "Volatility-Scaled 60-Day Range Position Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(((close - rolling_min(close,60)) / (rolling_max(close,60) - rolling_min(close,60)) - 0.5) / rolling_std(pct_change(close),20))",
    "description": "Contrarian cross-sectional signal: assets near the upper end of their prior 60-session trading range receive negative scores and assets near the lower end receive positive scores; scores are scaled by inverse 20-day realized volatility and lagged one session to prevent look-ahead."
  },
  "dependencies": ["close"],
  "parameters": {
    "range_window": 60,
    "volatility_window": 20,
    "signal_lag": 1,
    "forward_horizon": 60,
    "minimum_cross_section": 8,
    "universe_size": 15
  },
  "validation": {
    "status": "EFFECTIVE",
    "validated_on": "2031-01-09",
    "period": "2020-01-01 through 2031-01-08",
    "metrics": {
