{
  "factor_id": "miner_3_20300808_downside_pressure_40d",
  "factor_name": "Lagged Downside Pressure Quality",
  "version": "1.0",
  "calculation": {
    "expression": "rolling_sum(-min(pct_change(close),0),40)/(rolling_sum(abs(pct_change(close)),40)+1e-12), then lag 1 session",
    "description": "Measures the share of recent absolute movement attributable to downside days. Higher values indicate persistent downside pressure and, empirically, predict stronger subsequent medium-horizon returns in this cross-asset universe. The one-session lag prevents lookahead."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "window": 40,
    "min_periods": 20,
    "lag": 1
  },
  "validation": {
