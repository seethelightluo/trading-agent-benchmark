  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "short_return_window": 5,
    "short_volatility_window": 5,
    "long_volatility_window": 60,
    "multiplier_clip_lower": 0.25,
    "multiplier_clip_upper": 4.0,
    "forward_admission_horizon_days": 1
  },
