{
  "factor_id": "miner_3_20280921_shock_conditioned_reversal_5d",
  "factor_name": "Volatility-shock-conditioned cross-sectional reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(R5 - median_cross_section(R5)) * clip((sigma5/sigma60)/median_cross_section(sigma5/sigma60), 0.25, 4.0)",
    "description": "Compute each asset's trailing five-session return and the ratio of five-session to sixty-session realized daily volatility. Contrarian exposure to recent relative losers is amplified when that asset is experiencing an elevated volatility shock, with a bounded shock multiplier. All inputs are lagged through the decision date.",
