{
  "factor_id": "cross_asset_relative_reversal_10d",
  "factor_name": "Cross-asset relative short-term reversal, volatility scaled",
  "version": "1.0",
  "calculation": {
    "expression": "-(asset_log_return_10d - cross_sectional_median_log_return_10d) / rolling_std_daily_log_return_20d",
    "description": "For each tradable benchmark instrument, reverse its 10-session log return relative to the same-date cross-sectional median return and scale by its own 20-session daily log-return volatility. Signal is lagged one completed session; higher values indicate relatively oversold assets."
  },
  "dependencies": ["close"],
  "parameters": {
    "return_window_sessions": 10,
    "cross_section_center": "median",
    "volatility_window_sessions": 20,
    "signal_lag_sessions": 1,
    "forward_horizon_sessions": 10,
    "min_cross_section": 8,
    "universe_size": 15
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": {"start": "2020-01-01", "end": "2035-03-29"},
    "metrics": {
      "horizon_sessions": 10,
      "ic": 0.0292905105,
      "icir": 1.7355347,
      "hit_ratio": 0.55,
      "valid_dates": 2440,
      "average_instruments": 14.1697,
      "coverage_over_valid_dates": 0.9446,
      "coverage_all_date_asset_cells": 0.5420,
      "rank_turnover": 0.10856,
      "decay": "Not evaluated beyond the admission horizon in this cycle",
      "max_abs_library_correlation": null
    },
    "regime_notes": "Positive IC in each evaluated regime: 2024-2026 0.06657 (103 dates), 2027-2029 0.02087 (782), 2030-2032 0.02403 (784), 2033-2036 0.03820 (771). The dataset provided no qualifying dates in 2020-2023 after the required rolling windows and alignment. Small cross-section implies conservative uncertainty interpretation.",
    "admission_gates": {"absolute_daily_paper_ic_min": 0.007, "absolute_daily_paper_icir_min": 0.084, "passed": true}
  },
  "signal_artifact": "scripts/miner_1_20350329_cross_asset_relative_reversal_10d_signal.csv",
  "validation_script": "scripts/miner_1_20350329_cross_asset_relative_reversal_10d.py",
  "tags": ["reversal", "cross_asset", "volatility_scaled", "price_only"],
