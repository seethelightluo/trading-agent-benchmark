{
  "factor_id": "miner_3_20320205_residual_reversal_60d",
  "factor_name": "Cross-Asset Residual Reversal 60D",
  "version": "1.0",
  "calculation": {
    "expression": "-(return_10d_i - cross_sectional_median(return_10d)) / annualized_volatility_40d_i, shifted by one completed session",
    "description": "Contrarian 10-session return after removing the contemporaneous cross-asset median return, normalized by 40-session annualized realized volatility. Higher values indicate relatively weaker recent residual performance and are expected to mean-revert over the 60-session horizon."
  },
  "dependencies": ["close"],
  "parameters": {
    "return_window": 10,
    "volatility_window": 40,
    "volatility_min_periods": 20,
    "forward_horizon": 60,
    "lag_sessions": 1,
    "minimum_cross_section": 8,
    "universe_size": 15
  },
