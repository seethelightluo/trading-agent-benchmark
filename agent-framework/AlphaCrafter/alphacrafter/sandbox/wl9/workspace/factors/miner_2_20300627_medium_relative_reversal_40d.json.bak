{
  "factor_id": "miner_2_20300627_medium_relative_reversal_40d",
  "factor_name": "Medium-Horizon Volatility-Scaled Relative Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "shift1(rolling_mean_3(-(sum_20(return_1d - cross_sectional_median(return_1d)) / (std_10(return_1d)+epsilon))))",
    "description": "Ranks cross-asset medium-horizon underperformers favorably for contrarian exposure. The 20-session cumulative relative return is negated, divided by 10-session realized volatility, smoothed over three observations, and lagged one completed session to prevent look-ahead."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "relative_return_window": 20,
    "volatility_window": 10,
    "smoothing_window": 3,
    "lag_sessions": 1,
    "forward_horizon_sessions": 40,
    "minimum_cross_section": 8,
    "epsilon": 1e-08
  },
