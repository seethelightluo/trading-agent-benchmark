{
  "factor_id": "miner_3_20321028_trend_conditioned_reversal_60d",
  "factor_name": "Trend-Conditioned Cross-Asset Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "(-sum_{i=0..19}(close_t-i/close_t-i-1 - 1)) * I(sum_{i=0..19} mean_cross_sectional_return_t-i > 0), shifted by one completed session",
    "description": "Ranks assets by negative trailing 20-session return (contrarian signal), but activates the signal only when the equal-weight mean return of the 15 tradable instruments over the trailing 20 sessions is positive. The full factor is lagged one session to prevent look-ahead. When inactive, signal values are zero.",
    "signal_artifact": "scripts/miner_3_20321028_trend_conditioned_reversal_signal.csv",
    "research_script": "scripts/miner_3_20321028_trend_conditioned_reversal.py"
  },
  "dependencies": ["close", "daily_pct_change", "15-asset cross-sectional mean return"],
  "parameters": {"asset_universe_size": 15, "lookback_sessions": 20, "activation_lookback_sessions": 20, "forward_validation_horizon_sessions": 60, "lag_sessions": 1, "minimum_valid_instruments": 8},
