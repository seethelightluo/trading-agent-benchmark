{
  "factor_id": "pullback_trend_reversal_60d",
  "factor_name": "Volatility-scaled 60D trend pullback reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-pct_change(close,60) * (1 + clip(close/rolling_max(close,20)-1,-1,0)) / (rolling_std(pct_change(close),60)*sqrt(60)+1e-8), shifted 1 completed session",
    "description": "Contrarian cross-asset signal combining the negative 60-day trend with the magnitude of any contained 20-day pullback, normalized by 60-day realized volatility. Positive values favor assets whose medium-term weakness and pullback profile imply stronger subsequent rebound potential. The one-session lag prevents look-ahead."
  },
  "dependencies": ["close"],
  "parameters": {"trend_window": 60, "pullback_window": 20, "volatility_window": 60, "minimum_volatility_observations": 40, "lag_sessions": 1},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 to 2035-04-10",
    "metrics": {
      "ic": 0.086512,
      "icir": 4.984233,
      "ic_horizon_days": 10,
      "hit_ratio": 0.6252,
      "valid_dates": 2241,
      "average_valid_instruments": 15.0,
      "universe_instruments": 15,
      "minimum_cross_section": 8,
      "coverage": 0.549443,
      "turnover_10d": 0.125164,
      "decay": {"10d_ic": 0.086512, "20d_ic": 0.128730, "40d_ic": 0.177960, "60d_ic": 0.198055},
      "max_abs_library_correlation": null
    },
    "regime_notes": "Positive across evaluated 2024-2026, 2027-2029, 2030-2032, and 2033-2035 regimes; small 15-instrument cross-section requires conservative inference."
  },
  "signal_artifact": "scripts/miner_1_20350412_pullback_trend_reversal_60d_signal.csv",
  "validation_script": "scripts/miner_1_20350412_pullback_trend_reversal_60d.py",
  "last_validated": "2035-04-12T00:00:00Z",
  "tags": ["reversal", "trend", "volatility_scaled", "cross_asset", "pullback"]
}