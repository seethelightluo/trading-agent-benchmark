{
  "factor_id": "trend_quality_120d_contrarian",
  "factor_name": "120-session trend-quality contrarian",
  "version": "1.0",
  "calculation": {
    "expression": "-((120*log_price_regression_slope_120)/(residual_volatility_120*realized_volatility_40))",
    "description": "Invert the volatility-scaled 120-session log-price trend slope; favor assets whose apparently smooth, risk-adjusted trends have become vulnerable to medium-horizon reversal. Signal is lagged one completed session."
  },
  "dependencies": ["close"],
  "parameters": {"trend_window": 120, "minimum_trend_observations": 100, "realized_vol_window": 40, "residual_volatility_window": 120, "forward_horizon_days": 60, "lag_days": 1},
