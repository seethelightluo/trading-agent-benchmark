{
  "factor_id": "miner_3_20330331_breadth_confirmed_reversal_60d",
  "factor_name": "Breadth-Confirmed Risk-Adjusted 40D Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "[-pct_change(close,40)/(rolling_std(pct_change(close,1),40)*sqrt(252)+0.05)] * clip(1 + 0.60*(breadth_60 - 0.50), 0.65, 1.35), lagged one completed session",
    "description": "Cross-asset contrarian signal: buys relatively beaten-down instruments on a risk-adjusted 40-session basis. Signal magnitude is modestly strengthened when cross-sectional breadth (fraction of instruments above their own 60-session moving average) confirms a broad regime. All price and breadth inputs are lagged one completed session to prevent look-ahead."
  },
  "dependencies": ["close"],
  "parameters": {
    "return_window": 40,
    "volatility_window": 40,
    "breadth_ma_window": 60,
    "breadth_multiplier": 0.60,
    "breadth_clip": [0.65, 1.35],
    "annualization": 252,
    "volatility_floor": 0.05,
    "lag_sessions": 1,
    "universe_size": 15
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2033-03-30",
