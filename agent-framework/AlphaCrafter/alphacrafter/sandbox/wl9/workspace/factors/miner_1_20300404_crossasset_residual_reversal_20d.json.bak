{
  "factor_id": "miner_1_20300404_crossasset_residual_reversal_20d",
  "factor_name": "Volatility-normalized cross-asset residual reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-rolling_sum_5(asset_return - cross_sectional_median_return) / rolling_std_20(asset_return), lagged_1",
    "description": "For each tradable asset, subtract the daily median return across the 15-asset universe, sum the residual over five sessions, normalize by its trailing 20-session return volatility, and reverse the signal. The one-session lag prevents lookahead."
  },
  "dependencies": ["close"],
  "parameters": {"residual_window_days": 5, "volatility_window_days": 20, "forward_horizon_days": 20, "lag_days": 1, "minimum_valid_assets": 8},
