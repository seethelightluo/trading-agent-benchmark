{
  "factor_id": "miner_3_20341221_volume_confirmed_reversal_60d",
  "factor_name": "Volume-Confirmed Volatility-Scaled Medium-Term Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "(-ret_60 / (sqrt(60)*std(ret_1,60) + 1e-6)) * sqrt(clip(mean(volume,20)/mean(volume,120),0.25,4.0))",
    "description": "Ranks assets for medium-term reversal using the negative 60-day return normalized by 60-day realized volatility, amplified when recent 20-day average volume is elevated relative to its 120-day average. Signal is shifted by one completed trading day to avoid look-ahead."
  },
  "dependencies": [
    "close",
    "volume"
  ],
  "parameters": {
    "return_window_days": 60,
    "volatility_window_days": 60,
    "recent_volume_window_days": 20,
    "baseline_volume_window_days": 120,
    "volume_ratio_clip": [
      0.25,
      4.0
    ],
    "lag_days": 1,
    "minimum_cross_section": 8
  },
