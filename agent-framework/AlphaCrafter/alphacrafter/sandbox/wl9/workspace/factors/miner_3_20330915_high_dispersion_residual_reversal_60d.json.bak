{
  "factor_id": "miner_3_20330915_high_dispersion_residual_reversal_60d",
  "factor_name": "High-dispersion peer-relative residual reversal",
  "version": "1.0",
  "calculation": {
    "expression": "clip(-residual_return_sum(60)/(annualized_residual_volatility(60)+0.05), -5, 5) when percentile_rank(rolling_mean(cross_asset_return_std(20),252)) > 0.60, else 0; lag one session",
    "description": "Subtract the contemporaneous median return of the 15 tradable benchmark assets from each asset return, fade the resulting 60-session idiosyncratic move, scale by idiosyncratic annualized volatility, and activate only when 20-day cross-asset dispersion is above its trailing 252-session 60th percentile. The regime and signal are lagged one session to avoid lookahead."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "lookback_sessions": 60,
    "volatility_annualization": 252,
    "risk_floor": 0.05,
    "dispersion_window": 20,
    "dispersion_percentile_window": 252,
    "dispersion_threshold": 0.6,
    "minimum_dispersion_history": 126,
    "minimum_residual_history": 45,
    "clip": [
      -5,
      5
    ],
    "lag_sessions": 1,
    "universe_size": 15
  },
