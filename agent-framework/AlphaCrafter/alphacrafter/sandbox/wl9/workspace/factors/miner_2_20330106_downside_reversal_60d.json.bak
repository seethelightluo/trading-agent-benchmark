  "factor_name": "Downside-volatility-normalized 60-day reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-return(close,60) / (sqrt(rolling_mean(min(pct_change(close),0)^2,60,min_periods=30))*sqrt(252)), lagged_1d",
