{
  "factor_id": "miner_3_20350705_downside_reversal_60d",
  "factor_name": "Downside-risk-scaled 60-day reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-((close / close.shift(60)) - 1) / (sqrt(rolling_mean(where(daily_return < 0, daily_return^2, 0), 60)) + 0.005), then lag 1 day",
    "description": "Ranks assets contrarily to their trailing 60-day return, scaling the reversal signal by trailing downside deviation. The one-day lag ensures only completed data are used at decision time; values are clipped to [-10,10]."
  },
  "dependencies": ["close", "daily_return"],
  "parameters": {"lookback_days": 60, "downside_window": 60, "minimum_downside_observations": 40, "stabilizer": 0.005, "lag_days": 1, "clip": [-10, 10], "forward_horizon_days": 10},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2035-07-04",
    "last_validated": "2035-07-05",
    "metrics": {
      "ic": 0.075891,
      "icir": 4.076817,
      "horizon_days": 10,
      "dates": 2625,
      "average_cross_section": 14.8,
      "hit_ratio": 0.605,
      "coverage": 0.7223,
      "turnover_proxy_10d": 0.1737,
      "max_abs_library_correlation": null
    },
    "decay": {"5d_ic": 0.051517, "20d_ic": 0.09797, "40d_ic": 0.156711, "60d_ic": 0.197248},
    "regime_notes": "10-day IC was -0.000999 in 2020-2023 (188 dates), then positive in 2024-2026 (+0.042898; 228), 2027-2029 (+0.098723; 782), 2030-2032 (+0.085629; 784), and 2033-2035 (+0.070428; 643). Interpret small cross-asset IC conservatively; broad coverage averaged 72.23%.",
    "signal_artifact": "scripts/miner_3_20350705_downside_reversal_60d_signal.csv"
  },
  "tags": ["reversal", "downside-risk", "cross-asset", "risk-adjusted", "price-only"]
}