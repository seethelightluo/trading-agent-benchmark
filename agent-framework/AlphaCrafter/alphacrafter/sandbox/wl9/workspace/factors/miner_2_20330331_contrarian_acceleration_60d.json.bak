  "factor_name": "Volatility-scaled contrarian momentum acceleration",
  "version": "1.0",
  "calculation": {
    "expression": "-[(return_20 - (return_60-return_20)/2)/(ann_volatility_30+0.05)]",
    "description": "Compute 20-session return minus the average of the preceding two 20-session return segments, scale by 30-session annualized volatility plus 0.05, invert for a contrarian longer-horizon signal, cross-sectionally median demean, and lag one completed session. Higher values indicate stronger expected long-horizon mean reversion."
  },
