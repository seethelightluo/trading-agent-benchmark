{
  "factor_id": "miner_3_20350719_drawdown_recovery_weakness_120d",
  "factor_name": "Volatility-Normalized Drawdown Recovery Weakness",
  "version": "1.0",
  "calculation": {
    "expression": "((close / rolling_min(close,120,min_periods=80))-1) / (rolling_std(pct_change(close),60,min_periods=40)+0.005), shifted by 1 completed day; portfolio direction = -1",
    "description": "Measures distance above each asset's 120-day trough normalized by 60-day realized volatility. The one-day lag prevents look-ahead. Higher raw values predict weaker subsequent returns; the portfolio uses the negative direction so assets with less recovery / greater drawdown receive higher score.",
    "signal_direction": -1
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "trough_window": 120,
    "trough_min_periods": 80,
    "vol_window": 60,
    "vol_min_periods": 40,
    "risk_floor": 0.005,
    "signal_lag_days": 1,
    "winsor_clip": [
      -20,
      20
    ]
  },
