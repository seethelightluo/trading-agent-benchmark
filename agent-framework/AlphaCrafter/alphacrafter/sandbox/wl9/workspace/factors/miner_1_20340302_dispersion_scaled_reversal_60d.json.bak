{
  "factor_id": "miner_1_20340302_dispersion_scaled_reversal_60d",
  "factor_name": "Lagged Dispersion-Scaled Multi-Horizon Residual Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "clip(-(0.55*(r20-cross_sectional_mean(r20))+0.45*(r60-cross_sectional_mean(r60)))/(ann_vol40+0.04),-6,6) * (0.65+0.35*sigmoid(z20_dispersion))",
    "description": "Reverses each instrument's 20- and 60-session cross-sectional residual returns, scales by 40-session annualized volatility with a 4 percentage-point floor, and continuously increases the signal multiplier in elevated cross-asset dispersion. The dispersion multiplier is based on the rolling 20-session mean of cross-sectional 20-session return dispersion, standardized by a 252-session rolling mean and standard deviation. All signal inputs are lagged one completed session to avoid look-ahead."
  },
  "dependencies": ["close"],
  "parameters": {
    "short_window": 20,
    "long_window": 60,
    "short_residual_weight": 0.55,
    "long_residual_weight": 0.45,
    "volatility_window": 40,
    "volatility_floor_annualized": 0.04,
    "dispersion_window": 20,
    "dispersion_standardization_window": 252,
    "multiplier_low": 0.65,
    "multiplier_range": 0.35,
    "clip": [-6, 6],
    "lag_sessions": 1,
    "forward_validation_horizon_sessions": 60,
    "minimum_cross_section": 8,
    "universe_size": 15
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2034-03-01",
    "validated_at": "2034-03-02T00:00:00Z",
