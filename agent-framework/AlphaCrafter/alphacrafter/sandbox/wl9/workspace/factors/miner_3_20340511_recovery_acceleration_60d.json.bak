{
  "factor_id": "miner_3_20340511_recovery_acceleration_60d",
  "factor_name": "Stress-Gated Volatility-Normalized Recovery Acceleration",
  "version": "1.0",
  "calculation": {
    "expression": "shift1(clip(max(5D_return,0)*max(-20D_return,0)/(annualized_volatility_60D+0.05)^2,0,8) * I(negative_20D_breadth > trailing_120D_quantile(negative_20D_breadth,0.60)))",
    "description": "Ranks assets showing a positive short-term recovery after a negative 20-day path, normalized by 60-day annualized volatility, and activates the signal when at least a relatively high fraction of the cross-asset universe has negative 20-day returns. All inputs are shifted one completed session before use."
  },
  "dependencies": ["close"],
  "parameters": {
    "short_window": 5,
    "drawdown_window": 20,
    "volatility_window": 60,
    "volatility_floor": 0.05,
    "breadth_window": 120,
    "breadth_quantile": 0.60,
    "clip_lower": 0,
    "clip_upper": 8,
    "signal_lag_sessions": 1,
    "forward_horizon_sessions": 60
  },
  "validation": {
