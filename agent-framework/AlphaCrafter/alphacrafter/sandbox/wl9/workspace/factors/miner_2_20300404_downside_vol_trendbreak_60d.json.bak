{
  "factor_id": "miner_2_20300404_downside_vol_trendbreak_60d",
  "factor_name": "Downside-Volatility-Weighted Trend-Break Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-((ret_20 - ret_60/3) * downside_vol_20 / total_vol_20), lagged 1 session",
    "description": "Contrarian trend-break signal: reverses the recent 20-session return relative to the prior-60-session average and weights it by the asset's downside-to-total realized volatility ratio. Uses only completed data via one-session lag."
  },
  "dependencies": ["close"],
  "parameters": {"short_window": 20, "long_window": 60, "long_normalization": 3.0, "vol_window": 20, "downside_definition": "standard deviation of negative daily returns, min 5 observations", "lag": 1, "forward_horizon": 60},
