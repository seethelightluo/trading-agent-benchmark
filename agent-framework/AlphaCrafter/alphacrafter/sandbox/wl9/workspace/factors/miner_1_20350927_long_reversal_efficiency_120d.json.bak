{
  "factor_id": "miner_1_20350927_long_reversal_efficiency_120d",
  "factor_name": "120D Efficiency-Weighted Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-ret_120 / (std(ret_1,120)*sqrt(120)+0.05) * clip(abs(ret_120)/(sum(abs(ret_1),120)+1e-12),0,1)",
    "description": "Contrarian 120-trading-day return, normalized by 120-day realized volatility and weighted by path efficiency. Positive values favor assets with recent losses and efficient directional paths, with lagged inputs only. Cross-sectional ranking is recommended."
  },
  "dependencies": ["close", "daily_returns"],
  "parameters": {"lookback": 120, "vol_window": 120, "min_vol_observations": 80, "vol_floor": 0.05, "clip": [-20,20], "lag_days": 1},
  "validation": {
