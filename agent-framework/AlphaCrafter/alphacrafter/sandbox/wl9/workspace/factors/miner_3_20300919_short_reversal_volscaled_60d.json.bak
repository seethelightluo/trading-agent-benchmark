{
  "factor_id": "miner_3_20300919_short_reversal_volscaled_60d",
  "factor_name": "Volatility-Scaled Short-Term Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "(-pct_change(close, 5) / rolling_std(pct_change(close), 20)).shift(1)",
    "description": "Ranks assets positively when their lagged five-session return was weak relative to recent 20-session realized volatility, expressing cross-asset short-term reversal with risk scaling. The signal is lagged one completed session to prevent look-ahead."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "lookback_return": 5,
    "volatility_window": 20,
    "volatility_min_periods": 15,
    "lag": 1,
    "forward_horizon": 60,
    "minimum_cross_section": 8
  },
