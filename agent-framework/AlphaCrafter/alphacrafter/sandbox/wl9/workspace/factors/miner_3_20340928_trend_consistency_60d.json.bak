{
  "factor_id": "miner_3_20340928_trend_consistency_60d",
  "factor_name": "Volatility-scaled trend consistency",
  "version": "1.0",
  "calculation": {
    "expression": "((close/close.shift(60)-1) * (2*rolling_mean(pct_change(close)>0,60)-1) / (rolling_std(pct_change(close),60)+0.005)).shift(1)",
    "description": "Ranks assets by 60-day return multiplied by the persistence of positive daily returns, scaled by 60-day volatility. The one-day lag prevents use of the current incomplete session."
  },
  "dependencies": ["close"],
  "parameters": {"return_window": 60, "consistency_window": 60, "volatility_window": 60, "min_periods": 40, "volatility_floor": 0.005, "lag_days": 1, "forward_horizon": 60},
