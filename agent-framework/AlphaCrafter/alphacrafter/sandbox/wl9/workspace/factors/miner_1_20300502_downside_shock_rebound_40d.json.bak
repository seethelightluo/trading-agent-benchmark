{
  "factor_id": "miner_1_20300502_downside_shock_rebound_40d",
  "factor_name": "Breadth-gated downside shock rebound",
  "version": "1.0",
  "calculation": {
    "expression": "shift1(-min(residual_3d,0) * (1 + 1.5*(1-breadth_3d)) / (volatility_20d + 0.01))",
    "description": "Compute each asset's three-day return residual to the cross-sectional median, retain only negative residual shocks, reverse their sign, scale by a market-stress gate based on the fraction of assets with positive three-day returns, and normalize by 20-day volatility. Lag one session to avoid lookahead. Higher values predict stronger forward rebound."
  },
  "dependencies": ["close"],
  "parameters": {
    "residual_window_days": 3,
    "cross_section_reference": "daily_median",
    "volatility_window_days": 20,
    "stress_gate": "1 + 1.5*(1 - positive_return_breadth_3d)",
    "volatility_floor": 0.01,
    "lag_days": 1,
    "validation_horizon_days": 40
  },
  "validation": {
