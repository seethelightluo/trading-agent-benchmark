{
  "factor_id": "miner_3_20311030_volatility_persistence_reversal_60d",
  "factor_name": "Volatility-Compression Contrarian Residual Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-cross_sectional_residual(pct_change(close,40)) * clip(rolling_std(log_return,80) / rolling_std(log_return,20), 0.5, 3.0), shifted by one completed session",
    "description": "Ranks assets contrarian to their 40-day cross-sectional residual return, amplifying reversal exposure when 20-day volatility is compressed relative to the 80-day baseline. All inputs are lagged one session before use."
  },
  "dependencies": ["close"],
  "parameters": {"return_window": 40, "short_vol_window": 20, "long_vol_window": 80, "min_short_observations": 15, "min_long_observations": 50, "compression_clip": [0.5, 3.0], "lag_sessions": 1, "forward_horizon_days": 20},
