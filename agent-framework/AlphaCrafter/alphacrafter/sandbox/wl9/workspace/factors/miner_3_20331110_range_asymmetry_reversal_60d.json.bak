{
  "factor_id": "miner_3_20331110_range_asymmetry_reversal_60d",
  "factor_name": "Asymmetric 252-session range-position medium-term reversal",
  "version": "1.0",
  "calculation": {
    "expression": "clip((-return(close,60)/(stdev(pct_change(close),60)*sqrt(252)+0.05)) * clip(1.25 - 1.5*((close-min(close,252))/(max(close,252)-min(close,252))),0.25,1.25), -5, 5), lagged 1 session",
    "description": "Fades a volatility-scaled 60-session return, with contrarian magnitude amplified near the bottom of the trailing 252-session range and attenuated near the top. The signal is lagged one completed session and clipped for robustness."
  },
  "dependencies": ["close"],
  "parameters": {
    "return_window": 60,
    "volatility_window": 60,
    "range_window": 252,
    "annualization": 252,
    "volatility_floor": 0.05,
    "range_weight_intercept": 1.25,
    "range_weight_slope": -1.5,
    "range_weight_min": 0.25,
    "range_weight_max": 1.25,
    "clip_min": -5,
    "clip_max": 5,
    "lag_sessions": 1
  },
