{
  "factor_id": "volume_divergence_reversal_20d",
  "factor_name": "Volume-Divergence Risk-Adjusted Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "(-return(close,20) / (rolling_std(return(close,1),60) + 0.005)) * (2 - clip(rolling_mean(volume,10) / rolling_mean(volume,60), 0, 2))",
    "description": "Contrarian 20-session price impulse scaled by 60-session volatility and amplified when recent volume is below its 60-session average, using only information through the prior completed session.",
    "lag": 1
  },
  "dependencies": ["close", "volume"],
  "parameters": {"price_window": 20, "volatility_window": 60, "volume_fast_window": 10, "volume_slow_window": 60, "volatility_floor": 0.005, "volume_clip": [0, 2], "signal_clip": [-10, 10], "forward_horizon": 10},
  "validation": {
