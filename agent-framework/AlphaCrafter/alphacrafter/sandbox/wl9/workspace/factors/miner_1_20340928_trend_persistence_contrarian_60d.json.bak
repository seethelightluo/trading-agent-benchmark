{
  "factor_id": "trend_persistence_contrarian_60d",
  "factor_name": "Trend-persistence risk-adjusted contrarian",
  "version": "1.0",
  "calculation": {
    "expression": "-((return_60 / (sqrt(252)*std_return_60 + 0.02)) * (0.5 + positive_day_fraction_60) * (1 - rolling_drawdown_60)).shift(1)",
    "description": "Ranks assets contrarily to lagged 60-day risk-adjusted persistent trend, rewarding reversal of strong persistent moves while penalizing deep drawdowns. Signal is lagged one session."
  },
  "dependencies": ["close"],
  "parameters": {"trend_window": 60, "volatility_window": 60, "drawdown_window": 60, "vol_floor": 0.02, "forward_horizon": 60, "lag": 1, "min_cross_section": 8},
  "validation": {
