{
  "factor_id": "miner_3_20291129_inverse_trend_quality_10d",
  "factor_name": "Inverse Trend Quality Reversal",
  "version": "2029-11-29",
  "calculation": {
    "expression": "-((close/close.shift(60)-1)/(rolling_std(pct_change(close),20)*sqrt(252))) * abs(close/close.shift(60)-1) / rolling_sum(abs(pct_change(close)),60)",
    "description": "Ranks assets for medium-term mean reversion: the negative of 60-session return scaled by 20-session annualized volatility and path efficiency. Cross-sectional winsorization at the daily 5th/95th percentiles is applied. Larger values indicate stronger reversal opportunity.",
