  "calculation": {
    "expression": "mean_{w in {40,60,80}}[-((close/close.shift(w)-1) - median_assets(close/close.shift(w)-1)) / (sqrt(60)*rolling_std_60(asset_daily_return - cross_asset_median_daily_return))]",
