  "factor_name": "Risk-adjusted medium-term contrarian momentum",
  "version": "1.0",
  "calculation": {
    "expression": "-(close/close.shift(60)-1) / (sqrt(252)*rolling_std(log_returns,20)).shifted_by_one_session",
    "description": "For each tradable cross-asset instrument, take the negative 60-session return divided by its trailing 20-session annualized realized volatility. The signal is lagged one completed session. The negative sign expresses the validated medium-horizon contrarian direction."
  },
  "dependencies": ["close"],
  "parameters": {"lookback_return": 60, "volatility_window": 20, "volatility_annualization": 252, "signal_lag": 1, "forward_horizon": 60},
