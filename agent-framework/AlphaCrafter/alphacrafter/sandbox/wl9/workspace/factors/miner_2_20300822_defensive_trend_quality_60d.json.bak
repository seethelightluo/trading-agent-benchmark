{
  "factor_id": "miner_2_20300822_defensive_trend_quality_60d",
  "factor_name": "Inverse Defensive Trend Quality 60-Day",
  "version": "1.0",
  "calculation": {
    "expression": "rank(rolling_mean_3((return_60 / annualized_downstream_volatility_40) * path_efficiency_40)).shift(1)",
    "description": "Ranks a medium-horizon risk-adjusted trend multiplied by 40-day path efficiency, smooths ranks over three sessions, and lags one session. The validated forecast direction is inverted: lower-quality or overextended trend profiles are favored for 60-day forward returns. All rolling inputs and signal are lagged to avoid lookahead."
  },
  "dependencies": [
    "close",
    "pct_change"
  ],
  "parameters": {
    "trend_window": 60,
    "volatility_window": 40,
    "path_window": 40,
    "smoothing_window": 3,
    "lag": 1,
    "annualization": 252,
    "direction": -1,
    "min_valid_cross_section": 8
  },
