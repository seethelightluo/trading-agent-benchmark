{
  "factor_id": "miner_2_20290614_stress_downside_residual_reversal_10d",
  "factor_name": "VIX-stress residual reversal scaled by downside volatility",
  "version": "1.0",
  "calculation": {
    "expression": "-((ret_5d(asset) - beta_60d(asset, market_mean) * mean_asset_ret_5d) / downside_std_20d(asset)) when VIX > rolling_median(VIX, 60)",
    "description": "In elevated-VIX regimes, buy assets with negative recent market-neutral residual returns, scaling by recent downside volatility. Beta is estimated using the trailing 60 sessions and all calculations use data available at the signal date."
  },
  "dependencies": [
    "close",
    "VIX"
  ],
  "parameters": {
    "residual_lookback_days": 5,
    "beta_lookback_days": 60,
    "downside_volatility_lookback_days": 20,
    "vix_regime_lookback_days": 60,
    "forward_horizon_days": 10,
    "minimum_cross_section": 8,
    "universe_size": 15
  },
