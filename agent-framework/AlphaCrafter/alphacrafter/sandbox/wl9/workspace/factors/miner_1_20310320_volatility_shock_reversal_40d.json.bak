{
  "factor_id": "miner_1_20310320_volatility_shock_reversal_40d",
  "factor_name": "Volatility-Shock Short-Term Contrarian Reversal, 40-Day Horizon",
  "version": "1.0",
  "calculation": {
    "expression": "(-pct_change(close,10)/(rolling_std(pct_change(close,1),20)*sqrt(252))) * (rolling_std_20/rolling_std_60), lagged 1 session",
    "description": "Ranks assets positively when their lagged ten-session return is negative and unusually large relative to recent annualized volatility, with the contrarian signal amplified when 20-day volatility is elevated relative to 60-day volatility. Forward validation horizon is 40 trading days."
  },
  "dependencies": ["close"],
  "parameters": {"shock_lookback": 10, "short_volatility_window": 20, "long_volatility_window": 60, "annualization": 252, "signal_lag": 1, "validation_horizon": 40},
