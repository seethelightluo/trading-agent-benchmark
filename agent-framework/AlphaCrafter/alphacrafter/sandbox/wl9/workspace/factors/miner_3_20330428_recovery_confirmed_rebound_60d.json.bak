{
  "factor_id": "miner_3_20330428_recovery_confirmed_rebound_60d",
  "factor_name": "Risk-normalized drawdown rebound with short recovery confirmation",
  "version": "2033-04-28",
  "calculation": {
    "expression": "shift1((-R20/(annualized_vol20+0.05))*clip(1+0.75*abs(drawdown120),1,1.60)*clip(1+0.50*R5,-0.20,0.20), 1)",
    "description": "Ranks assets for 60-day forward returns using a lagged 20-session risk-normalized contrarian return, amplified by bounded drawdown from the 120-session peak and modestly confirmed by the latest 5-session recovery. Inputs are shifted one completed session to prevent look-ahead."
  },
  "dependencies": ["close"],
  "parameters": {"reversal_window": 20, "confirmation_window": 5, "volatility_window": 20, "drawdown_window": 120, "annualization": 252, "volatility_floor": 0.05, "drawdown_amplifier": 0.75, "max_drawdown_amplifier": 1.60, "confirmation_scale": 0.50, "confirmation_clip": [-0.20, 0.20], "signal_lag_sessions": 1},
