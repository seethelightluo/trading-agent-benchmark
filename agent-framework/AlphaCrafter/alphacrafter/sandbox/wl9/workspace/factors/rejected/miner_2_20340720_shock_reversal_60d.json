{
  "factor_id": "miner_2_20340720_shock_reversal_60d",
  "factor_name": "Broad-Shock Volatility-Normalized Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "shift_1((-(rolling_sum(return,5))/(rolling_std(return,20)+0.005)) * I(breadth_5 > rolling_quantile(breadth_5,120,0.65)))",
    "description": "Ranks assets for forward medium-horizon rebound after a broad cross-asset five-session shock. The negative five-session return is normalized by 20-session volatility; activation requires the fraction of assets with negative five-session returns to exceed its trailing 120-session 65th percentile. All inputs are lagged one completed session to prevent look-ahead."
  },
  "dependencies": ["close", "daily_returns"],
  "parameters": {
    "shock_window": 5,
    "volatility_window": 20,
    "volatility_min_periods": 15,
    "volatility_floor": 0.005,
    "breadth_window": 5,
    "breadth_quantile_window": 120,
    "breadth_quantile": 0.65,
    "signal_lag_sessions": 1,
    "forward_validation_horizon_sessions": 60
  },
