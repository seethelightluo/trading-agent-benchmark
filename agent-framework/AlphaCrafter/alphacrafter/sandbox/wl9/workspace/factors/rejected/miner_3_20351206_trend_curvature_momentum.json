  "factor_name": "Volatility-Scaled Trend Curvature Momentum",
  "version": "1.0",
  "calculation": {
    "expression": "clip((return_20d_lagged - return_120d_lagged) / (sqrt(60)*rolling_std_60d_lagged + 0.05), -20, 20)",
