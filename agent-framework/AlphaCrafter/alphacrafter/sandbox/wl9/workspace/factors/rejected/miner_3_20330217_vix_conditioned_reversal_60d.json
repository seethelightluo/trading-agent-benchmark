{
  "factor_id": "miner_3_20330217_vix_conditioned_reversal_60d",
  "factor_name": "VIX-conditioned volatility-normalized 60D reversal",
  "version": "1.0",
  "calculation": {
    "expression": "[-pct_change(close,60) / (rolling_std(daily_returns,60)*sqrt(252)+0.05)] * [1 + 0.35*tanh((VIX - rolling_median(VIX,252))/rolling_std(VIX,252))]",
    "description": "Ranks assets by lagged, volatility-normalized 60-session reversal, amplified or attenuated according to the lagged standardized VIX regime. The signal is shifted one completed session to prevent look-ahead bias. VIX is observation-only and is not tradable."
  },
  "dependencies": ["close", "daily_returns", "VIX"],
  "parameters": {
    "lookback_sessions": 60,
    "volatility_floor": 0.05,
    "vix_regime_window": 252,
    "vix_amplitude": 0.35,
    "signal_lag_sessions": 1,
    "forward_horizon_sessions": 60,
    "minimum_cross_section": 8
  },
