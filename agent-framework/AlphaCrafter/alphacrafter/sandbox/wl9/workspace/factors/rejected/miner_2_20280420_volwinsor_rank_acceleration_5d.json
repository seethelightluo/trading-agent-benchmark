{
  "factor_id": "miner_2_volwinsor_rank_acceleration_5d",
  "factor_name": "Winsorized Volatility-Scaled Rank Acceleration",
  "version": "1.0",
  "calculation": {
    "expression": "(rank_cs(close/close.shift(5)-1) - rank_cs(close/close.shift(20)-1)) / clip(rolling_std(pct_change(close),20), cross_sectional_10th_percentile, cross_sectional_90th_percentile)",
    "description": "Measures improvement in an asset's 5-day return rank versus its 20-day return rank, scaled by trailing 20-day daily volatility. Volatility is winsorized cross-sectionally at each date to reduce extreme-volatility distortion. Uses only completed data available at the signal date. Higher values indicate improving, volatility-efficient leadership."
  },
  "dependencies": ["close"],
  "parameters": {
    "short_lookback_days": 5,
    "long_lookback_days": 20,
    "volatility_lookback_days": 20,
    "volatility_min_periods": 15,
    "volatility_winsor_lower_quantile": 0.10,
    "volatility_winsor_upper_quantile": 0.90,
    "forward_validation_horizon_days": 5,
    "minimum_cross_section": 8
  },
