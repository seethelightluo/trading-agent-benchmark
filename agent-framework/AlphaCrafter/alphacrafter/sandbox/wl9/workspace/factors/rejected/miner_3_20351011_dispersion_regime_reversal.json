  "factor_name": "Dispersion-Regime Volatility-Normalized Short Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "[-(close[t-1]/close[t-6]-1)/(std(pct_change(close),20)[t-1]*sqrt(5)+0.03)] * clip(mean_i(std(return_i,20)[t-1]) / rolling_median_120(mean_i(std(return_i,20)),t-1), 0.5, 2.0)",
    "description": "Ranks assets by five-day contrarian return normalized by each asset's lagged 20-day volatility, scaled by the lagged cross-sectional dispersion regime. The dispersion multiplier is based on the cross-sectional mean of 20-day return volatility relative to its trailing 120-day median, clipped for stability. All inputs are lagged to avoid lookahead."
  },
  "dependencies": ["close", "pct_change"],
