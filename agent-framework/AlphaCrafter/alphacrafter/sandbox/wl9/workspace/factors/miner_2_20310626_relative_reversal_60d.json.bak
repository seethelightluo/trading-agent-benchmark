{
  "factor_id": "miner_2_20310626_relative_reversal_60d",
  "factor_name": "Cross-Asset Relative Volatility-Scaled Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-rolling_sum_60(asset_return - cross_sectional_mean_return) / (rolling_std_40(asset_return - cross_sectional_mean_return) * sqrt(252))",
    "description": "Ranks assets contrarian to their 60-session cumulative return relative to the contemporaneous cross-asset return mean, scaled by 40-session residual realized volatility. Cross-sectional median demean and one-session lag prevent look-ahead."
  },
  "dependencies": ["close", "daily_returns"],
  "parameters": {"relative_return_window": 60, "volatility_window": 40, "annualization": 252, "minimum_return_observations": 40, "minimum_volatility_observations": 25, "lag_sessions": 1, "cross_section": "15 tradable benchmark instruments"},
