{
  "factor_id": "miner_3_20320513_drawdown_duration_reversal_60d",
  "factor_name": "Drawdown Duration Conditioned Relative Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-relative_20d_return * (1 + 0.5 * mean(I(close < rolling_max(close,120)),60)) * (1 + min(-drawdown_from_120d_high,0.7))",
    "description": "Contrarian cross-sectional 20-session return relative to the daily cross-sectional median, amplified when an instrument has spent much of the prior 60 sessions below its 120-session high and when its drawdown is large. Signal is lagged one completed session."
  },
  "dependencies": ["close"],
  "parameters": {"relative_return_window": 20, "peak_window": 120, "duration_window": 60, "minimum_peak_observations": 80, "minimum_duration_observations": 30, "drawdown_cap": 0.7, "duration_amplifier": 0.5, "lag_sessions": 1, "forward_horizon": 60},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2032-05-12",
    "last_validated": "2032-05-13",
    "metrics": {
      "ic": 0.160283,
      "icir": 0.495921,
      "horizon_sessions": 60,
      "valid_dates": 1451,
      "average_instruments": 15.0,
      "minimum_cross_section": 8,
      "coverage": 0.465694,
      "turnover": 0.059695,
      "hit_ratio": 0.6975,
      "max_abs_library_correlation": null
    },
    "decay": {"5d_ic": 0.033918, "10d_ic": 0.060794, "20d_ic": 0.076064, "40d_ic": 0.123483, "60d_ic": 0.160283},
    "regime_notes": "Positive across reported regimes: 2024-2026 unavailable as a combined split in this run; 2024 standalone partial IC 0.326511, 2027-2029 IC 0.137925, 2030 IC 0.200721, 2031-2032 IC 0.120800. Small 15-asset universe warrants conservative uncertainty interpretation.",
    "lookahead_control": "All signal inputs are shifted one completed session; forward returns begin after the signal date.",
    "signal_artifact": "scripts/miner_3_20320513_drawdown_duration_reversal_signal.csv",
    "research_script": "scripts/miner_3_20320513_drawdown_duration_reversal.py"
  },
  "tags": ["reversal", "drawdown", "duration", "cross_asset", "medium_term"],
