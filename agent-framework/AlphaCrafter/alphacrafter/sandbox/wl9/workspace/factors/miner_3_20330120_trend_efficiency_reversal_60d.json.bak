{
  "factor_id": "miner_3_20330120_trend_efficiency_reversal_60d",
  "factor_name": "Volatility-scaled trend-efficiency reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-((close/close.shift(40)-1)/(sum_abs_daily_returns_40+1e-8))/(realized_volatility_40*sqrt(252)+0.05), lagged 1 session",
    "description": "Ranks assets contrarian to persistent directional trends: the 40-session return divided by the cumulative absolute daily-return path and realized volatility, with the resulting trend-efficiency score negated. Higher values favor assets whose recent efficient trend was negative or weak, consistent with the observed cross-asset reversal effect. Signal is shifted one completed session to prevent look-ahead."
  },
  "dependencies": ["close"],
  "parameters": {"lookback_sessions": 40, "volatility_window": 40, "min_periods": 30, "annualization": 252, "volatility_floor": 0.05, "lag_sessions": 1, "forward_horizon_sessions": 60},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2033-01-19",
    "validated_at": "2033-01-20",
    "metrics": {"ic": 0.184555, "icir": 0.625542, "hit_ratio": 0.7304, "valid_dates": 1617, "average_instruments": 14.99, "minimum_instruments": 8, "coverage": 0.487361, "turnover": 0.048474, "max_abs_library_correlation": null, "decay": {"10d_ic": 0.064061, "20d_ic": 0.095235, "40d_ic": 0.153623, "60d_ic": 0.184555}},
    "regime_notes": "Contrarian sign was selected because the raw trend-efficiency score had negative IC at every tested horizon. 60-session IC was negative in 2024, 2027-2029, 2030, and 2031-2032; uncertainty is interpreted conservatively because the cross-section has 15 instruments.",
    "admission_gates": {"minimum_absolute_daily_paper_ic": 0.007, "minimum_absolute_daily_paper_icir": 0.084, "same_horizon": "60d"}
  },
  "signal_provenance": {"artifact": "scripts/miner_3_20330120_trend_efficiency_signal.csv", "format": "date,symbol,signal", "source_script": "scripts/miner_3_20330120_trend_efficiency.py", "note": "Artifact contains the oriented reversal signal (-raw trend efficiency), lagged one session."},
  "tags": ["reversal", "trend-efficiency", "volatility-scaled", "cross-asset"],
