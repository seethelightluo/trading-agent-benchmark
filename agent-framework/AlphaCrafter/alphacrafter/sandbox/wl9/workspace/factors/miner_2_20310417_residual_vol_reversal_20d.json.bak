{
  "factor_id": "miner_2_20310417_residual_vol_reversal_20d",
  "factor_name": "Cross-Sectional Residual Volatility-Scaled Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(return_20d - cross_sectional_median(return_20d)) / volatility_40d",
    "description": "Ranks assets favoring reversal of their 20-session return relative to the same-day universe median, scaled by 40-session annualized volatility. Signal is computed only from completed data and applied with a one-session lag."
  },
  "dependencies": ["close"],
  "parameters": {"return_window": 20, "volatility_window": 40, "forward_horizon": 20, "minimum_cross_section": 8},
