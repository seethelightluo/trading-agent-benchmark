  "factor_name": "Downside-volatility path-inefficient drawdown reversal",
  "version": "1.0",
  "calculation": {
    "expression": "(-drawdown_120) * (1 - abs(return_40) / sum(abs(daily_return),40)) / (downside_volatility_60 + 1e-5), lagged 1 day",
