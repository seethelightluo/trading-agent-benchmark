{
  "factor_id": "multisession_intraday_reversal_5d",
  "factor_name": "Five-Session Intraday Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-rolling_mean((close/open)-1, 5).shift(1)",
    "description": "For each tradable benchmark asset, average the prior five completed sessions' open-to-close returns and negate it. The one-session lag ensures the signal is available before the forecast interval; cross-sectional 2nd/98th percentile winsorization limits isolated OHLC observations."
  },
  "dependencies": ["open", "close"],
  "parameters": {
    "intraday_window": 5,
    "lag_sessions": 1,
    "winsor_lower": 0.02,
    "winsor_upper": 0.98,
    "minimum_cross_section": 8,
    "primary_horizon_days": 10
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 to 2035-09-12",
    "validation_timestamp": "2035-09-13",
    "regime_notes": "Negative in 2020-2023, then positive in each subsequent regime; strongest in 2033-2035. Small 15-asset cross-section implies conservative interpretation. H20/H40 predictive decay is stronger than H10.",
    "metrics": {
      "ic": 0.013498,
      "icir": 0.706922,
      "horizon_days": 10,
      "valid_dates": 2687,
      "average_cross_section": 14.74,
      "coverage": 0.738035,
      "turnover_proxy_10d": 0.353940,
      "hit_ratio": 0.5266,
      "decay": {"H1": 0.003696, "H5": 0.001475, "H10": 0.013498, "H20": 0.025487, "H40": 0.030956},
      "max_abs_library_correlation": 0.999316
    },
    "thresholds": {"minimum_absolute_daily_paper_ic": 0.007, "minimum_absolute_daily_paper_icir": 0.084},
    "signal_artifact": "scripts/miner_2_20350913_multisession_intraday_reversal_signal.csv"
  },
  "tags": ["reversal", "intraday", "cross_asset", "price_only", "multi_session"],
  "last_validated": "2035-09-13"
}
