{
  "factor_id": "miner_3_20340330_dispersion_gated_reversal_60d",
  "factor_name": "High-Dispersion Volatility-Normalized Contrarian Shock Reversal",
  "version": "20340330",
  "calculation": {
    "expression": "indicator(cross_asset_mean_20d_return_volatility > trailing_120d_median) * clip(-return_20d / (annualized_volatility_60d + 0.05), -8, 8), lagged 1 session",
    "description": "Ranks assets by a volatility-normalized 20-session contrarian shock only when mean 20-session cross-asset return volatility is above its trailing 120-session median. All inputs are shifted one completed session before use."
  },
  "dependencies": ["close", "daily_returns"],
  "parameters": {
    "shock_window": 20,
    "volatility_window": 60,
    "volatility_annualization": 252,
    "volatility_floor": 0.05,
    "clip_lower": -8,
    "clip_upper": 8,
    "dispersion_window": 20,
    "dispersion_median_window": 120,
    "dispersion_median_min_periods": 60,
    "lag_sessions": 1,
    "minimum_cross_section": 8
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2034-03-29",
    "validation_timestamp": "2034-03-30T00:00:00",
    "regime_notes": "60D IC was negative in 2020-2023, strong in 2024-2032, and near zero in 2033-2034; regime-sensitive and should receive conservative portfolio weight.",
