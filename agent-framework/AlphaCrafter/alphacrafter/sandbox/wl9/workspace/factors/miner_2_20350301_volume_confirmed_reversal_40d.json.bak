{
  "factor_id": "miner_2_20350301_volume_confirmed_reversal_40d",
  "factor_name": "Volume-Confirmed Risk-Adjusted Reversal 40D",
  "version": "1.0",
  "calculation": {
    "expression": "-((close/close.shift(60)-1)/(rolling_std(pct_change(close),60)*sqrt(60))) * (1 + 0.35*clip(rolling_mean(volume,20)/rolling_mean(volume,120)-1,-2,2)), lagged 1 session",
    "description": "Fades the 60-session risk-adjusted return, with the reversal magnitude amplified when recent trading activity differs from its 120-session baseline. Inputs are shifted one completed session to avoid look-ahead."
  },
  "dependencies": [
    "close",
    "volume"
  ],
  "parameters": {
    "return_window": 60,
    "volatility_window": 60,
    "volume_fast_window": 20,
    "volume_slow_window": 120,
    "volume_clip": [
      -2,
      2
    ],
    "volume_loading": 0.35,
    "lag_sessions": 1,
    "minimum_cross_section": 8
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 to 2035-03-01",
    "last_validated": "2035-03-01",
