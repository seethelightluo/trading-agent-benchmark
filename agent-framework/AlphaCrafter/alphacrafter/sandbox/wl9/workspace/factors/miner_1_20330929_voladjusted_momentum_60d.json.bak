  "factor_name": "60-day volatility-adjusted momentum (contrarian direction)",
  "version": "20330929",
  "calculation": {
    "expression": "clip(pct_change(close,60)/(rolling_std(daily_return,60)*sqrt(252)+0.05),-5,5), lagged 1 session",
    "description": "Ranks assets by trailing 60-session cumulative return normalized by trailing realized volatility. The measured predictive relationship is negative, so portfolio consumers should use the contrarian direction (-1) unless independently revalidated. Signal is lagged one session to prevent look-ahead."
  },
  "dependencies": ["close"],
  "parameters": {"lookback_days": 60, "volatility_window": 60, "min_periods": 45, "annualization": 252, "stabilizer": 0.05, "clip_low": -5, "clip_high": 5, "lag_days": 1},
