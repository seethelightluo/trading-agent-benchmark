{
  "factor_id": "miner_2_20310807_vix_conditioned_reversal_60d",
  "factor_name": "VIX-Conditioned Cross-Asset Relative Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "shift_1(-(rolling_sum_60(log(close).diff - cross_sectional_mean(log(close).diff))) * (0.75 + 0.75 * rolling_rank_pct_252(VIX)))",
    "description": "Contrarian 60-session residual performance, amplified smoothly when the observation-only VIX is high relative to its trailing 252-session history. Signal is lagged one completed session to prevent look-ahead. Cross-sectional ranking is applied downstream by the portfolio constructor."
  },
  "dependencies": ["close", "VIX"],
  "parameters": {"residual_window_sessions": 60, "vix_rank_window_sessions": 252, "minimum_vix_history": 100, "vix_multiplier_floor": 0.75, "vix_multiplier_span": 0.75, "signal_lag_sessions": 1, "universe_size": 15},
  "validation": {
    "status": "EFFECTIVE",
    "period": {"start": "2024-01-01", "end": "2031-08-07"},
    "validation_timestamp": "2031-08-07T00:00:00Z",
    "metrics": {
      "admission_horizon_sessions": 20,
      "ic": 0.150912,
      "icir": 0.483139,
      "hit_ratio": 0.6695,
      "valid_dates": 1286,
      "average_instruments": 14.99,
      "minimum_instruments": 8,
