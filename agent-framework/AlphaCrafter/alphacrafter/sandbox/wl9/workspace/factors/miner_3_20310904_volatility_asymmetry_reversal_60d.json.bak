{
  "factor_id": "miner_3_20310904_volatility_asymmetry_reversal_60d",
  "factor_name": "Volatility-Asymmetry Conditioned Cross-Asset Contrarian Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-((return_20d - cross_sectional_mean(return_20d)) * (0.5 + percentile_rank_15(downside_semivolatility_20d / upside_semivolatility_20d))) lagged 1 session",
    "description": "Ranks each asset's 20-session downside-to-upside realized volatility asymmetry cross-sectionally and scales a negative relative 20-session return signal. The one-session lag prevents look-ahead. Zero downside/upside windows are stabilized with a small denominator epsilon and the ratio is clipped to [0,10]."
  },
  "dependencies": ["close"],
  "parameters": {
    "return_window": 20,
    "volatility_window": 20,
    "forward_horizon": 60,
    "cross_section_min_instruments": 8,
    "lag_sessions": 1,
    "epsilon": 1e-8,
    "ratio_clip": [0, 10],
    "universe_size": 15
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2031-09-04",
