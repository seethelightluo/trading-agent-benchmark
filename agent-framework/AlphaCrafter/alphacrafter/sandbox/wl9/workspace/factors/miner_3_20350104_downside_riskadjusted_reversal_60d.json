  "factor_id": "miner_3_20350104_downside_riskadjusted_reversal_60d",
  "factor_name": "Downside-volatility-normalized 60D reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(close/close.shift(60)-1) / (sqrt(rolling_mean(min(pct_change(close),0)^2,60))*sqrt(60)+1e-5), shifted 1 trading day",
    "description": "Ranks assets with negative trailing 60-day returns more highly, while normalizing the reversal magnitude by trailing downside volatility. The one-day lag prevents use of the current incomplete day."
  },
