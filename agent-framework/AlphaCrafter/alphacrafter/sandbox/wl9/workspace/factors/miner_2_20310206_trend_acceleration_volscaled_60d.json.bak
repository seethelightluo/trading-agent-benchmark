{
  "factor_id": "miner_2_20310206_trend_acceleration_volscaled_60d",
  "factor_name": "Volatility-Scaled Trend Acceleration",
  "version": "1.0",
  "calculation": {
    "expression": "(return(close,20)/rolling_std(pct_change(close),20) - return(close,60)/rolling_std(pct_change(close),20)).shift(1)",
    "description": "The lagged difference between short- and medium-horizon returns normalized by current 20-day realized volatility. Higher values indicate improving relative trend acceleration; the signal is lagged one session to avoid look-ahead."
  },
  "dependencies": ["close"],
  "parameters": {"short_window": 20, "long_window": 60, "volatility_window": 20, "lag": 1, "forward_horizon": 60},
