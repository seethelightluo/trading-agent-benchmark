{
  "factor_id": "volatility_managed_reversal_60d",
  "factor_name": "Volatility-Managed Short-Term Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(sum_return(close,10) / rolling_std(pct_change(close),30)).shift(1)",
    "description": "Ranks assets positively when their prior 10-day return was weak after scaling by trailing 30-day realized volatility; the one-day lag prevents look-ahead. This is a cross-asset reversal signal with risk normalization."
  },
  "dependencies": ["close"],
  "parameters": {"return_window": 10, "volatility_window": 30, "signal_lag": 1, "forward_horizon_days": 60},
