{
  "factor_id": "miner_1_20310807_downside_asymmetry_reversal_60d",
  "factor_name": "Downside-asymmetry residual reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-residual_return_60d / downside_residual_volatility_40d * clip(downside_residual_volatility_40d / upside_residual_volatility_40d, 0.5, 2.0)",
    "description": "Contrarian cross-asset residual 60-session return, scaled by downside residual volatility and its downside/upside volatility asymmetry. Residual returns subtract the contemporaneous cross-sectional mean. The signal is cross-sectionally median demeaned and lagged one session to prevent look-ahead."
  },
  "dependencies": ["close", "daily_returns"],
  "parameters": {
    "residual_return_window": 60,
    "downside_upside_volatility_window": 40,
    "minimum_downside_upside_observations": 20,
    "forward_validation_horizon_days": 20,
    "minimum_cross_section": 8,
    "asymmetry_clip": [0.5, 2.0],
    "annualization": 252
  },
