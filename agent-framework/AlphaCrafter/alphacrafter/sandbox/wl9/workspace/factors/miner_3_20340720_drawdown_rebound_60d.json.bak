{
  "factor_id": "miner_3_20340720_drawdown_rebound_60d",
  "factor_name": "Drawdown Rebound with Upside Participation",
  "version": "1.0",
  "calculation": {
    "expression": "((1 - close / rolling_max(close,60)) / (rolling_mean(max(-pct_change(close,1),0),20) + 0.001) * (rolling_mean(max(pct_change(close,1),0),20) + 0.001) / (rolling_mean(max(-pct_change(close,1),0),20) + rolling_mean(max(pct_change(close,1),0),20) + 0.002)).shift(1)",
    "description": "Ranks assets with deeper 60-day drawdowns, scaled by recent downside intensity and rewarded for positive-return participation. Inputs are shifted one completed session to prevent look-ahead. Higher values are expected to predict stronger 60-day forward returns."
  },
  "dependencies": ["close"],
  "parameters": {"peak_window": 60, "participation_window": 20, "stabilizer": 0.001, "forward_horizon_days": 60, "lag_days": 1},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2034-07-19",
    "validation_date": "2034-07-20",
    "metrics": {
      "ic": 0.0588063907183272,
      "icir": 0.19417104853054493,
      "valid_dates": 4377,
      "average_instruments": 14.998857665067398,
      "factor_coverage": 0.9907994640464494,
      "rank_turnover": 0.07887853314790137,
      "hit_ratio": 0.566826593557231,
      "max_abs_library_correlation": null,
      "decay": {"10d_ic": 0.007878945965721319, "20d_ic": 0.018584785195146298, "40d_ic": 0.04233390258856741, "60d_ic": 0.0588063907183272}
    },
    "regime_notes": "60-day IC/ICIR were negative in 2020-2026, positive in 2027-2029, and strongest in 2030-2034; treat as regime-sensitive despite full-history gate pass."
  },
  "signal_artifact": "scripts/miner_3_20340720_drawdown_rebound_signal.csv",
  "tags": ["reversal", "drawdown", "rebound", "participation", "cross_asset"],
  "last_validated": "2034-07-20"
}
