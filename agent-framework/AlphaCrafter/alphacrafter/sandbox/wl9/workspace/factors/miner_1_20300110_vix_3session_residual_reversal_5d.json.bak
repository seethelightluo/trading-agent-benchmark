{
  "factor_id": "miner_1_20300110_vix_3session_residual_reversal_5d",
  "factor_name": "Three-session persistent elevated-VIX residual reversal scaled by downside volatility",
  "version": "1.0",
  "calculation": {
    "expression": "if VIX[t-1], VIX[t-2], and VIX[t-3] each exceed trailing-60-session VIX median: -(asset_return_10d - cross_sectional_median(asset_return_10d)) / downside_volatility_20d; otherwise inactive",
    "description": "At each decision date, use only completed observations through t-1. During a three-session persistent elevated-VIX regime, rank the contrarian ten-session cross-asset residual return, scaled by each asset's trailing 20-session downside volatility. Higher values indicate stronger expected five-session forward return. VIX is observation-only."
  },
  "dependencies": ["close", "VIX close", "daily returns"],
  "parameters": {
    "vix_lookback": 60,
    "vix_persistence_sessions": 3,
    "residual_return_lookback": 10,
    "downside_volatility_lookback": 20,
    "forward_validation_horizon": 5,
    "minimum_cross_section": 8,
    "universe_size": 15
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2030-01-09",
