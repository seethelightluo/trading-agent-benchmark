{
  "factor_id": "miner_3_20340817_momentum_curvature_20d",
  "factor_name": "Volatility-scaled momentum curvature",
  "version": "1.0",
  "calculation": {
    "expression": "((close/close[-20]-1) - 0.25*(close/close[-80]-1)) / (rolling_std(pct_change(close),60)+0.005)",
    "description": "Measures recent 20-session momentum relative to the quarter-scale trend baseline, scaled by 60-session realized volatility. Inputs are shifted one completed session before signal use to prevent look-ahead bias. Higher values indicate accelerating medium-term trends."
  },
  "dependencies": ["close"],
  "parameters": {"short_window": 20, "long_window": 80, "volatility_window": 60, "long_return_weight": 0.25, "volatility_floor": 0.005, "signal_lag": 1},
