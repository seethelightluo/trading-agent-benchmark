{
  "factor_id": "miner_3_20310821_dispersion_conditioned_contrarian_60d",
  "factor_name": "Dispersion-conditioned cross-asset contrarian reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-((return_20d - cross_sectional_mean(return_20d)) * (0.5 + percentile_rank_252(mean_i(asset_volatility_20d))) )",
    "description": "For each tradable asset, reverse its 20-session return residual versus the available 15-asset cross-sectional mean, and scale the contrarian signal by the trailing 252-session percentile rank of average 20-session cross-asset volatility. Signal is lagged one session before IC evaluation or portfolio use. Higher dispersion strengthens the reversal exposure."
  },
  "dependencies": ["close"],
  "parameters": {
    "return_lookback_days": 20,
    "volatility_lookback_days": 20,
    "dispersion_rank_window_days": 252,
    "volatility_min_periods": 15,
    "rank_min_periods": 100,
    "signal_lag_days": 1,
    "minimum_cross_section": 8,
    "universe_size": 15
  },
