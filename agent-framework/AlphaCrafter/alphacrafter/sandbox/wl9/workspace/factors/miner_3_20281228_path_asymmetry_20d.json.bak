{
  "factor_id": "miner_3_20281228_path_asymmetry_20d",
  "factor_name": "Twenty-Day Return Path Asymmetry",
  "version": "1.0",
  "calculation": {
    "expression": "(sum(max(pct_change(close),0),20) - sum(max(-pct_change(close),0),20)) / (sum(max(pct_change(close),0),20) + sum(max(-pct_change(close),0),20))",
    "description": "Measures whether the trailing 20-day return path was dominated by positive or negative daily moves. Higher values indicate positive-return contribution dominated the path and are ranked as continuation exposure. Signal uses prices through the evaluation date only."
  },
  "dependencies": ["close"],
  "parameters": {
    "lookback_days": 20,
    "forward_horizon_days": 20,
    "minimum_cross_section": 8,
    "epsilon": 1e-12
  },
  "validation": {
    "status": "EFFECTIVE",
    "timestamp": "2028-12-28",
    "period": "2020-01-01 through 2028-12-27",
    "regime_notes": "Validated across the full synthetic history and all 15 intentionally tradable cross-asset instruments. The 20-day horizon passes both benchmark gates, but recent 252-observation, online, and 2028 YTD ICs are negative; this is a regime-sensitive admission requiring close monitoring and conservative ensemble weighting.",
    "metrics": {
      "horizon_days": 20,
