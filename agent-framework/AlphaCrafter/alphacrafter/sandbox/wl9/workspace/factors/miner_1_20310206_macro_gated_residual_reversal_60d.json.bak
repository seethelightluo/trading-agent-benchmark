{
  "factor_id": "miner_1_20310206_macro_gated_residual_reversal_60d",
  "factor_name": "VIX-gated cross-asset residual reversal",
  "version": "2031-02-06",
  "calculation": {
    "expression": "(-rolling_sum_20(asset_return - cross_sectional_median_return_20)) * (0.5 + rolling_percentile_60(VIX)), lagged_1",
    "description": "Subtract the daily cross-sectional median return, fade each asset's trailing 20-session residual performance, and scale the reversal signal by the lagged 60-session percentile of observation-only VIX. All inputs are lagged before use."
  },
  "dependencies": ["close", "VIX observation-only macro series"],
  "parameters": {"residual_window": 20, "vix_percentile_window": 60, "minimum_residual_observations": 15, "lag_sessions": 1, "forward_horizon": 60},
  "validation": {
