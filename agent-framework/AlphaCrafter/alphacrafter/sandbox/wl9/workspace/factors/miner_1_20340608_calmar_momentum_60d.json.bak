{
  "factor_id": "calmar_momentum_60d",
  "factor_name": "60-day Calmar-style momentum (contrarian direction)",
  "version": "1.0",
  "calculation": {
    "expression": "clip(pct_change(close,60) / (rolling_max(rolling_max(close,60)/close - 1,60) + 0.03), -12, 12).shift(1)",
    "description": "Sixty-session return divided by the maximum absolute drawdown observed over the trailing 60-session rolling-high path, with a 0.03 floor, clipped and lagged one completed session. The validated predictive direction is negative (rank low scores are favored)."
  },
  "dependencies": ["close"],
  "parameters": {"return_window": 60, "drawdown_window": 60, "drawdown_floor": 0.03, "clip": [-12,12], "lag_sessions": 1},
  "validation": {
