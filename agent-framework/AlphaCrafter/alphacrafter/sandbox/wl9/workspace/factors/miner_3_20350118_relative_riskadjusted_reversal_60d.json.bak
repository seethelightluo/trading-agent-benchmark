{
  "factor_id": "miner_3_20350118_relative_riskadjusted_reversal_60d",
  "factor_name": "Cross-asset relative risk-adjusted 60-day reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(R60_i - median_j(R60_j)) / (sqrt(60)*std_60(r_i - median_j(r_j)) + 1e-5)",
    "description": "Fade each asset's 60-day return relative to the contemporaneous cross-asset median, scaled by 60-day volatility of daily returns relative to the daily cross-sectional median. Signal is shifted one completed trading day to avoid look-ahead."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "lookback_days": 60,
    "volatility_window": 60,
    "volatility_min_periods": 45,
    "epsilon": 1e-05,
    "forward_horizons_days": [
      10,
      20,
      40,
      60,
      80
    ],
    "minimum_cross_section": 8
  },
