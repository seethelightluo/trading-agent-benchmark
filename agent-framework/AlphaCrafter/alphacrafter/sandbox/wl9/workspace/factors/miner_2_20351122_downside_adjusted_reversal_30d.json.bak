{
  "factor_id": "downside_adjusted_reversal_30d",
  "factor_name": "Downside-Adjusted Contrarian 30D Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(close[t-1]/close[t-31]-1) / (sqrt(mean(min(pct_change,0)^2,30)[t-1])*sqrt(30)+0.04) * (1 + 0.25*clip(upside_semideviation_30/(downside_semideviation_30+0.001),0,3))",
    "description": "Contrarian 30-day return scaled by lagged downside semideviation, with a modest upside-to-downside volatility adjustment. All inputs are lagged through the previous completed trading day; higher values indicate stronger expected forward return."
  },
  "dependencies": ["close", "pct_change"],
  "parameters": {
    "lookback_days": 30,
    "minimum_vol_observations": 20,
    "downside_floor": 0.04,
    "upside_ratio_weight": 0.25,
    "upside_ratio_clip": [0, 3],
    "winsorization": [-40, 40]
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2035-11-21",
    "horizon": "10 trading days",
    "metrics": {
      "ic": 0.061897,
      "icir": 3.481270,
      "hit_ratio": 0.5796,
      "dates": 2417,
      "average_instruments": 15.0,
      "minimum_instruments": 11,
      "coverage": 0.5680,
      "turnover_proxy_10d": 0.1651,
      "max_abs_library_correlation": null,
      "decay_ic": {"h5": 0.047159, "h10": 0.061897, "h20": 0.081150, "h40": 0.116569, "h60": 0.148833}
    },
    "regime_notes": "Positive H10 IC in all reported post-warmup regimes: 2024-2026 0.153954, 2027-2029 0.064094, 2030-2032 0.048752, 2033-2035 0.060074. Small 15-instrument cross-section implies conservative uncertainty interpretation.",
    "signal_artifact": "scripts/miner_2_20351122_downside_adjusted_reversal_30d_signal.csv",
    "validation_script": "scripts/miner_2_20351122_downside_adjusted_reversal_30d.py"
  },
  "tags": ["reversal", "downside-risk", "volatility-scaled", "cross-asset"],
