  "factor_name": "Volume-confirmed risk-adjusted medium-term reversal",
  "version": "1.0",
  "calculation": {
    "expression": "clip(-rolling_sum(return,60)/(rolling_std(return,60)*sqrt(252)+0.05)*(1+0.30*clip(log(volume_mean_20/volume_mean_120),-1,1)),-5,5).shift(1)",
    "description": "Contrarian 60-day return normalized by annualized 60-day volatility; relative volume confirmation modestly amplifies or attenuates the reversal signal, then lags one session to prevent look-ahead."
  },
  "dependencies": ["close", "volume"],
  "parameters": {"return_window": 60, "volatility_window": 60, "volatility_floor": 0.05, "volume_fast_window": 20, "volume_slow_window": 120, "volume_clip": [-1, 1], "volume_amplitude": 0.30, "signal_clip": [-5, 5], "lag_sessions": 1},
