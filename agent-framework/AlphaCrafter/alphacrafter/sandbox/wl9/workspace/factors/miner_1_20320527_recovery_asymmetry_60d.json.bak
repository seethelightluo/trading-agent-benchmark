{
  "factor_id": "miner_1_20320527_recovery_asymmetry_60d",
  "factor_name": "Recovery-Asymmetry Relative Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-relative_return_20d * (1 + 0.75 * recovery_10d / (abs(drawdown_120d)+0.05))_clipped_0_1 * (1 + 0.25 * abs(drawdown_120d))",
    "description": "Contrarian relative 20-session return, amplified for assets in a 120-session drawdown that have begun a positive 10-session recovery. The signal is shifted one completed session before evaluation to prevent look-ahead bias."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "relative_return_window": 20,
    "peak_window": 120,
    "recovery_window": 10,
    "min_periods_return": 15,
    "min_periods_peak": 80,
    "min_periods_recovery": 8,
    "recovery_scale": 0.75,
    "drawdown_scale": 0.25,
    "signal_lag_sessions": 1,
    "validation_horizon_sessions": 60,
    "minimum_cross_section": 8
  },
