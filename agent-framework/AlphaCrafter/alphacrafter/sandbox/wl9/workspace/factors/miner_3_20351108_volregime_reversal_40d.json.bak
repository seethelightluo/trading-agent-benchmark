{
  "factor_id": "miner_3_20351108_volregime_reversal_40d",
  "factor_name": "Volatility-Regime Amplified 40-Day Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(close[t-1]/close[t-41]-1)/(std(ret[t-40:t-1])*sqrt(40)+0.05) * clip(std(ret[t-40:t-1])/std(ret[t-120:t-1]), 0.5, 2.5)",
    "description": "Contrarian 40-day return risk-normalized by recent volatility, amplified when 40-day volatility is elevated relative to the 120-day baseline. All inputs are lagged one completed session."
  },
  "dependencies": ["close", "daily_returns"],
  "parameters": {
    "return_window": 40,
    "short_vol_window": 40,
    "long_vol_window": 120,
    "min_short_vol_observations": 25,
    "min_long_vol_observations": 75,
    "vol_ratio_clip": [0.5, 2.5],
    "stabilizer": 0.05,
    "signal_clip": [-30, 30],
    "lag_sessions": 1
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2035-11-07",
    "validated_at": "2035-11-08T00:00:00Z",
    "metrics": {
      "horizon_days": 10,
      "ic": 0.060279,
      "icir": 3.393221,
      "hit_ratio": 0.5886,
      "coverage": 0.5635,
      "turnover_10d_proxy": 0.1499,
      "dates": 2394,
      "average_cross_section": 14.99,
      "minimum_cross_section": 9,
      "max_abs_library_correlation": null,
      "decay_ic": {"5": 0.043170, "10": 0.060279, "20": 0.090944, "40": 0.137914, "60": 0.166609}
    },
    "admission_thresholds": {"min_abs_daily_paper_ic": 0.007, "min_abs_daily_paper_icir": 0.084},
    "regime_notes": "H10 IC remained positive in 2024-2026 (0.124180), 2027-2029 (0.074645), 2030-2032 (0.051513), and 2033-2035 (0.046045); no eligible 2020-2023 segment after required 120-day warmup.",
    "signal_artifact": "scripts/miner_3_20351108_volregime_reversal_40d_signal.csv"
  },
  "tags": ["reversal", "volatility", "regime", "cross_asset"],
  "last_validated": "2035-11-08"
}
