  "factor_name": "Drawdown-Recovery Risk-Adjusted Reversal 20D",
  "version": "1.0",
  "calculation": {
    "expression": "-pct_change(close,20) / (abs(rolling_min(close/rolling_max(close,120)-1,60)) + 0.05), shifted 1 completed day",
    "description": "Ranks assets for reversal of their 20-day return, scaled by recent 60-day drawdown severity from a 120-day rolling peak. The one-day lag prevents look-ahead bias.",
    "lookahead_control": "Signal at date t uses information through t-1; forward returns begin after the signal date."
  },
  "dependencies": ["close"],
  "parameters": {"return_window": 20, "peak_window": 120, "drawdown_window": 60, "drawdown_floor": 0.05, "signal_lag_days": 1, "minimum_cross_section": 8},
