{
  "factor_id": "miner_3_20350524_drawdown_recovery_curvature_60d",
  "factor_name": "Drawdown Recovery Curvature Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(drawdown_60d * (1 - recovery_fraction_60d)), lagged 1 completed session",
    "description": "Compute drawdown as close divided by the 60-day rolling high minus one. Compute recovery fraction as (close minus 60-day rolling trough) divided by (rolling high minus rolling trough). Reward assets with deep, unrecovered drawdowns, using the negative product as a cross-sectional reversal signal.",
    "signal_artifact": "scripts/miner_2_20350524_drawdown_recovery_curvature_60d_signal.csv"
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "lookback_days": 60,
    "rolling_min_periods": 45,
    "lag_days": 1,
    "min_cross_section": 8
  },
