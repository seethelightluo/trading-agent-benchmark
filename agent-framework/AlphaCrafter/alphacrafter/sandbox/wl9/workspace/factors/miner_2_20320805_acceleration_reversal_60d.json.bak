      "average_instruments": 15.0,
      "coverage": 0.463710,
      "turnover": 0.043259,
      "max_abs_library_correlation": null
    },
    "thresholds": {"minimum_absolute_daily_paper_ic": 0.007, "minimum_absolute_daily_paper_icir": 0.084},
    "regime_notes": "Positive and stable aggregate cross-sectional Spearman IC across the full synthetic history; uncertainty remains material because the cross-section contains 15 instruments.",
