{
  "factor_id": "miner_2_20320805_acceleration_reversal_60d",
  "factor_name": "Volatility-Normalized Trend Acceleration Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(return_60d - return_20d) / (sqrt(60)*std_daily_60d)",
    "description": "Contrarian exposure to the recent acceleration of medium-horizon returns, normalized by 60-session realized volatility. Signal is lagged one completed session to prevent lookahead; higher values indicate stronger expected forward return."
  },
  "dependencies": ["close"],
  "parameters": {"long_window": 60, "short_window": 20, "volatility_window": 60, "signal_lag": 1, "forward_horizon": 60},
  "validation": {
    "status": "EFFECTIVE",
    "period": {"start": "2020-01-01", "end": "2032-08-04"},
    "metrics": {
