{
  "factor_id": "miner_3_20300207_smoothed_relative_reversal_40d",
  "factor_name": "Smoothed cross-sectional relative reversal 40-day",
  "version": "1.0",
  "calculation": {
    "expression": "rolling_mean_5( -(return_20d_i - cross_sectional_median(return_20d)), min_periods=3 ).shift(1)",
    "description": "For each tradable asset, take the negative deviation of its trailing 20-session return from the same-day cross-sectional median, smooth the signal over five sessions, and lag one completed session to prevent lookahead. Higher values indicate stronger relative reversal exposure."
  },
  "dependencies": ["close"],
  "parameters": {
    "return_window": 20,
    "smoothing_window": 5,
    "smoothing_min_periods": 3,
    "forward_horizon": 40,
    "minimum_cross_section": 8,
    "universe_size": 15,
    "winsorization": null
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2030-02-07 (signals lagged one session)",
    "last_validated": "2030-02-07",
    "metrics": {
      "ic": 0.064997,
      "icir": 0.183324,
      "forward_horizon_days": 40,
      "dates": 1529,
      "average_instruments": 14.32,
      "coverage": 0.9549,
      "turnover": null,
      "hit_ratio": 0.5860,
      "max_abs_library_correlation": null
    },
    "regime_notes": "Negative in early period (IC -0.046064, ICIR -0.116944), positive in middle (IC 0.049598, ICIR 0.143089), and strongest in late period (IC 0.129001, ICIR 0.401691). Interpret conservatively because the cross-section has 15 instruments and effectiveness is regime dependent.",
    "signal_artifact": "scripts/miner_3_20300207_smoothed_relative_reversal_40d_signal.csv"
  },
