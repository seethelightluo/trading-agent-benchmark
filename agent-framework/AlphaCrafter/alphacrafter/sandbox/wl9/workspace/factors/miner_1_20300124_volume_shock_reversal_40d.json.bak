{
  "factor_id": "miner_1_20300124_volume_shock_reversal_40d",
  "factor_name": "Volume-Shock Residual Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "clip(-(r_5 - cross_sectional_median(r_5)) * (1 + clip(volume / rolling_median(volume,60) - 1, 0, 3), 5%, 95%)",
    "description": "Contrarian residual to the five-session return, amplified when an asset experiences unusually high volume relative to its 60-session median. Signals are formed only from completed sessions and evaluated cross-sectionally."
  },
  "dependencies": ["close", "volume"],
  "parameters": {"return_window": 5, "volume_median_window": 60, "volume_min_periods": 20, "volume_shock_cap": 3.0, "winsorization": [0.05, 0.95], "validation_horizon_sessions": 40},
