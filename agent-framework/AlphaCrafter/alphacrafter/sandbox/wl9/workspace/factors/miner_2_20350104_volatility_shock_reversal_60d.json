{
  "factor_id": "miner_2_20350104_volatility_shock_reversal_60d",
  "factor_name": "Volatility-shock conditioned 20D reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(close/close.shift(20)-1) * (volatility_20 / volatility_60) / (volatility_20 + 0.005), shifted 1 trading day",
    "description": "Ranks assets for reversal after a recent 20-day return, amplifying the signal when 20-day realized volatility is unusually high relative to 60-day volatility. The signal is lagged one completed session to avoid look-ahead."
  },
  "dependencies": [
    "close",
    "pct_change"
  ],
  "parameters": {
    "return_window": 20,
    "short_vol_window": 20,
    "long_vol_window": 60,
    "short_vol_min_periods": 15,
    "long_vol_min_periods": 45,
    "annualization_factor": "sqrt(window)",
