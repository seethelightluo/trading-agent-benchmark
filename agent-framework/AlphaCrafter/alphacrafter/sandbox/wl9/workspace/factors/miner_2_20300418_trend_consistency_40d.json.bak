  "factor_name": "Trend Consistency Signed Momentum",
  "version": "1.0",
  "calculation": {
    "expression": "lag1(ret_20) * (2 * mean_60(I(ret_1 > 0)) - 1)",
    "description": "The lagged 20-session return is multiplied by the lagged 60-session fraction of positive daily returns transformed to [-1,1]. This retains momentum when the path is persistent and reverses the sign when the recent move is path-inconsistent. All inputs are lagged one completed session."
  },
  "dependencies": ["close"],
