{
  "factor_id": "miner_2_20330414_volcompression_reversal_60d",
  "factor_name": "Volatility-compression scaled contrarian reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-return_20d / (volatility_20d * sqrt(252) + 0.05) * clip(1.5 - volatility_20d / volatility_60d, 0.5, 1.5)",
    "description": "Cross-asset contrarian 20-session return normalized by recent realized volatility, amplified when short-window volatility is compressed relative to its 60-session baseline. The complete signal is shifted by one completed session to avoid look-ahead. Cross-sectional ranking is used downstream."
  },
  "dependencies": ["close"],
  "parameters": {"return_window": 20, "short_vol_window": 20, "long_vol_window": 60, "annualization": 252, "offset": 0.05, "compression_floor": 0.5, "compression_cap": 1.5, "signal_lag_sessions": 1},
