{
  "factor_id": "miner_2_20350802_volregime_shock_reversal_20d",
  "factor_name": "Volatility-Regime Shock Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "(-return(close,20) / (std(pct_change(close),20) + 0.005)) * (std(pct_change(close),20) / (std(pct_change(close),120) + 0.005)), lagged 1 session",
    "description": "Contrarian 20-session loss, risk adjusted by short-term realized volatility and amplified when short-term volatility is elevated relative to its 120-session baseline. The signal is lagged one completed session to avoid look-ahead."
  },
  "dependencies": ["close"],
  "parameters": {
    "return_window": 20,
    "short_vol_window": 20,
    "long_vol_window": 120,
    "volatility_floor": 0.005,
    "lag_sessions": 1,
    "clip_range": [-20, 20]
  },
