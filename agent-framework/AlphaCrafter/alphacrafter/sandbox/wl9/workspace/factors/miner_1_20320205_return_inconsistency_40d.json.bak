{
  "factor_id": "return_inconsistency_40d",
  "factor_name": "40-Day Volatility-Adjusted Return Inconsistency",
  "version": "1.0",
  "calculation": {
    "expression": "-(rolling_mean((pct_change(close)>0),60)-0.5)/(rolling_std(pct_change(close),60)+1e-8), lagged 1 completed session",
    "description": "Sign-inverted directional persistence scaled by inverse realized volatility. Assets with unusually consistent positive or negative daily direction receive lower scores; the factor is intended as a cross-sectional return-inconsistency/reversal signal. The one-session lag prevents look-ahead."
  },
  "dependencies": ["close"],
  "parameters": {"direction_window": 60, "min_periods": 40, "volatility_window": 60, "lag": 1, "epsilon": 1e-8, "forward_horizon_days": 40},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2032-02-04",
    "last_validated": "2032-02-05T00:00:00",
    "metrics": {
      "ic": 0.163285,
      "icir": 0.681396,
      "hit_ratio": 0.7584,
      "valid_ic_dates": 1395,
      "average_instruments": 14.99,
      "minimum_cross_section": 8,
      "coverage": 0.455862,
      "turnover": 0.030696,
      "max_abs_library_correlation": null
    },
    "decay": {"5d_ic": 0.056630, "10d_ic": 0.087636, "20d_ic": 0.122349, "40d_ic": 0.163285, "60d_ic": 0.184946},
    "regime_notes": "Positive across evaluated regimes: 2024-2026 IC 0.233701 (106 dates); 2027-2029 IC 0.166501 (782); 2030 IC 0.118948 (261); 2031-02-04 IC 0.169760 (246). Small 15-instrument universe implies conservative IC uncertainty interpretation.",
    "signal_artifact": "scripts/miner_1_20320205_return_inconsistency_40d_signal.csv"
