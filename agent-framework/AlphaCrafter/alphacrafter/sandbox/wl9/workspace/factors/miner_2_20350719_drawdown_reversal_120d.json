{
  "factor_id": "drawdown_reversal_120d",
  "factor_name": "Volatility-Scaled Drawdown Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "(1 - close / rolling_min(close,120)) / (rolling_std(pct_change(close),60) + 0.005), shifted by 1 completed session",
    "description": "Ranks instruments that remain below their 120-session trough-adjusted recovery level, with the drawdown signal scaled by 60-session realized volatility. Positive values favor deeper, volatility-adjusted drawdowns as contrarian rebound candidates. The one-session lag prevents look-ahead bias."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "drawdown_window": 120,
    "volatility_window": 60,
    "min_drawdown_observations": 80,
    "min_volatility_observations": 40,
    "volatility_floor": 0.005,
    "signal_lag": 1,
    "forward_horizon": 10
  },
