{
  "factor_id": "multimacro_residual_reversal_60d",
  "factor_name": "Multi-macro residual reversal, volatility-normalized 60D",
  "version": "1.0",
  "calculation": {
    "expression": "-residual_return_60d(asset | VIX,DXY,USDCNY) / realized_volatility_60d",
    "description": "Estimate rolling 60-session asset return exposure to observation-only VIX, DXY, and USDCNY daily returns using an intercept plus macro-factor OLS. Subtract the macro-implied component from the asset 60-session log return, reverse the residual, divide by 60-session daily log-return volatility, and lag one completed session. Cross-sectional ranking is applied downstream."
  },
  "dependencies": [
    "close",
    "VIX",
    "DXY",
    "USDCNY"
  ],
  "parameters": {
    "lookback_sessions": 60,
    "macro_factors": [
      "VIX",
      "DXY",
      "USDCNY"
    ],
    "volatility_window": 60,
    "signal_lag_sessions": 1,
    "min_cross_section": 8
  },
