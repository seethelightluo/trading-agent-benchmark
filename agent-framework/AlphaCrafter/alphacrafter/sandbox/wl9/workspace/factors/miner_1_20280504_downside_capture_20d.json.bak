{
  "factor_id": "miner_1_downside_capture_20d",
  "factor_name": "Twenty-day downside capture efficiency",
  "version": "20280518",
  "calculation": {
    "expression": "-(mean(asset_returns on days when equity_benchmark_return < 0 over trailing 20 sessions)) / rolling_std(asset_daily_returns,20)",
    "description": "Ranks assets higher when their average return during weak equity-benchmark sessions is less negative relative to their total trailing volatility. The equity benchmark is the equal-weight mean daily return of the eight equity-index instruments. Signal uses only completed daily observations.",
    "signal_artifact": "scripts/miner_1_20280504_downside_capture_20d.py"
  },
  "dependencies": [
    "close"
  ],
