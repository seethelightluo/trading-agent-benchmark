{
  "factor_id": "miner_2_20350215_residual_reversal_40d",
  "factor_name": "Benchmark-Beta Residual Reversal 40D",
  "version": "1.0",
  "calculation": {
    "expression": "-rolling_sum_40(residual_return) / (rolling_std_40(residual_return) * sqrt(40) + epsilon), lagged 1 day",
    "description": "For each tradable asset, estimate a rolling 120-session beta to the equal-weight mean return of the 15 tradable instruments. Subtract beta times benchmark return from the asset return, then fade the asset's 40-session cumulative residual move, scaled by residual volatility. Higher values indicate relatively oversold residual performance and expected rebound. Signal is shifted by one completed session to prevent look-ahead."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "universe": "15 tradable benchmark instruments",
    "benchmark": "equal_weight_mean_return",
    "beta_window": 120,
    "beta_min_periods": 80,
    "signal_window": 40,
    "signal_min_periods": 30,
    "forward_horizon_admission": 40,
    "lag_sessions": 1,
    "epsilon": 1e-08
  },
  "validation": {
