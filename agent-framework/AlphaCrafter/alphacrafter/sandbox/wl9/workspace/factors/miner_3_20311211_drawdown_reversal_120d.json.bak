{
  "factor_id": "miner_3_20311211_drawdown_reversal_120d",
  "factor_name": "Volatility-scaled 120-day drawdown contrarian reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(close / rolling_max(close,120) - 1) / (std(log_return,60) * sqrt(252))",
    "description": "Ranks assets positively when they are in deeper 120-session drawdowns, scaled by trailing annualized 60-session return volatility. Signal is shifted by one completed session to prevent look-ahead bias."
  },
  "dependencies": ["close"],
  "parameters": {
    "drawdown_window": 120,
    "volatility_window": 60,
    "volatility_min_periods": 30,
    "drawdown_min_periods": 40,
    "annualization": 252,
    "signal_lag_sessions": 1,
    "forward_horizons_sessions": [5,10,20,40,60],
    "minimum_cross_section": 8
  },
