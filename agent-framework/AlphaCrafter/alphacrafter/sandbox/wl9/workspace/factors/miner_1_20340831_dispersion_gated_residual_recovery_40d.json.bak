      "max_abs_library_correlation": null
    },
    "thresholds": {"absolute_daily_paper_ic_min": 0.007, "absolute_daily_paper_icir_min": 0.084},
    "regime_notes": "Negative in 2020-2023 (IC -0.05669), positive thereafter: 2024-2026 +0.08933, 2027-2029 +0.06596, 2030-2032 +0.13523, 2033-2034 +0.08296. Interpret conservatively given 15-asset cross-section.",
    "provenance": {
