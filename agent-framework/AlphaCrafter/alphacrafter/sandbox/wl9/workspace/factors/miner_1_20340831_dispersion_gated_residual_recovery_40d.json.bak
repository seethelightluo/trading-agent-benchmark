{
  "factor_id": "miner_1_20340831_dispersion_gated_residual_recovery_40d",
  "factor_name": "High-dispersion residual recovery",
  "version": "1.0",
  "calculation": {
    "expression": "[(-residual_60d)/(sqrt(20)*volatility_20d+0.02) + 1.5*return_10d/(sqrt(20)*volatility_20d+0.02)] conditioned on cross-sectional dispersion_60d > trailing_120d median, shifted one session",
    "description": "Ranks assets for recovery after 60-day cross-sectional residual underperformance, scaled by 20-day volatility and activated only when cross-sectional 60-day return dispersion is above its trailing 120-day median. Signal is lagged one completed session to avoid look-ahead."
  },
  "dependencies": ["close", "daily_returns"],
  "parameters": {
    "residual_lookback": 60,
    "recovery_lookback": 10,
    "volatility_lookback": 20,
    "dispersion_lookback": 60,
    "dispersion_threshold_window": 120,
    "dispersion_threshold_quantile": 0.5,
    "volatility_floor": 0.02,
    "recovery_weight": 1.5,
    "signal_lag_sessions": 1,
    "forward_horizon_days": 40
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 to 2034-08-30",
    "last_validated": "2034-08-31",
    "metrics": {
      "ic": 0.0522584411,
