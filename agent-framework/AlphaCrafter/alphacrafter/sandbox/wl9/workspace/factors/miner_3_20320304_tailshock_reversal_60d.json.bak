{
  "factor_id": "miner_3_20320304_tailshock_reversal_60d",
  "factor_name": "Tail-Shock Intensity Scaled Relative Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(r_60 - median_cs(r_60)) / (std_60(negative_daily_returns)*sqrt(252)) * clip(1 + mean_20(abs(negative_daily_returns))/mean_60(abs(daily_returns)), 0.5, 2.0)",
    "description": "Ranks assets contrarian to their 60-session cross-sectional relative return, scaling the reversal by downside volatility and recent negative-tail shock intensity. The signal is shifted one completed session to prevent look-ahead. Higher values are preferred."
  },
  "dependencies": ["close"],
  "parameters": {
    "relative_return_window": 60,
    "downside_volatility_window": 60,
    "downside_volatility_min_periods": 30,
    "shock_window": 20,
    "shock_min_periods": 10,
    "baseline_abs_return_window": 60,
    "clip_lower": 0.5,
    "clip_upper": 2.0,
    "signal_lag": 1,
    "forward_validation_horizon": 60
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2032-03-03",
