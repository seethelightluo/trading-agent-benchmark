  "factor_name": "Volatility-scaled rebound acceleration reversal 40D",
  "version": "1.0",
  "calculation": {
    "expression": "((close/close.shift(20)-1) - (close/close.shift(60)-1)) / (rolling_std(pct_change(close),60)+0.005), shifted by 1 completed session",
