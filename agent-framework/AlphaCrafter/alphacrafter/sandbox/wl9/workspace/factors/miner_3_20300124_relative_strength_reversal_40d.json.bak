{
  "factor_id": "miner_3_20300124_relative_strength_reversal_40d",
  "factor_name": "Cross-Asset Relative-Strength Reversal 40D",
  "version": "1.0",
  "calculation": {
    "expression": "-(return_10d(asset) - cross_sectional_median(return_10d))",
    "description": "At each date, rank lagged 10-trading-day relative losers above relative winners; the signal is shifted one completed session and evaluated against the subsequent 40-trading-day return. Higher values indicate stronger expected mean reversion."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "formation_days": 10,
    "horizon_days": 40,
    "minimum_cross_section": 8,
    "lag_sessions": 1,
