{
  "factor_id": "miner_1_20340622_volatility_scaled_reversal_60d",
  "factor_name": "Volatility-scaled 10-day reversal with high-dispersion gate",
  "version": "1.0",
  "calculation": {
    "expression": "shift1((-return_10d) / (annualized_volatility_20d + 0.10) * I[mean_cross_asset_daily_volatility_20d > trailing_120d_60th_percentile])",
    "description": "For each tradable asset, rank recent 10-session losers positively for reversal, scale the reversal by trailing 20-session annualized volatility plus a stabilizing 0.10 denominator, and activate the signal only on elevated cross-asset dispersion dates. The complete signal is lagged one session to prevent look-ahead. Positive values indicate expected rebound."
  },
  "dependencies": ["close", "daily_returns"],
  "parameters": {
    "return_window": 10,
    "volatility_window": 20,
    "volatility_min_periods": 15,
    "volatility_annualization": 252,
    "denominator_floor": 0.10,
    "dispersion_window": 20,
    "dispersion_gate_window": 120,
    "dispersion_gate_quantile": 0.60,
    "signal_lag_sessions": 1,
    "forward_validation_horizon": 60
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2034-06-21",
