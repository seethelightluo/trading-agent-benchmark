{
  "factor_id": "miner_2_20350104_short_reversal_volscaled_20d",
  "factor_name": "Volatility-Scaled Short-Term Reversal with Recovery Confirmation",
  "version": "1.0",
  "calculation": {
    "expression": "(-return_20d)/(sqrt(20)*std_daily_return_20d + 0.01) * (1 + 0.25*tanh(return_60d/0.20)), lagged 1 session",
    "description": "Ranks recent oversold assets higher after discounting losses by realized 20-day volatility; a bounded 60-day recovery term favors reversals with medium-term confirmation and reduces falling-knife exposure."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "short_window": 20,
    "volatility_window": 20,
    "medium_window": 60,
    "recovery_multiplier": 0.25,
    "recovery_scale": 0.2,
    "volatility_floor": 0.01,
    "signal_lag_sessions": 1,
    "forward_horizon_sessions": 60
  },
  "validation": {
    "status": "EFFECTIVE",
