{
  "factor_id": "miner_1_20300725_pullback_trend_60d",
  "factor_name": "Trend-Conditioned Relative Pullback Rebound",
  "version": "1.1",
  "calculation": {
    "expression": "(-clip(ret_5 - cross_sectional_median(ret_5), upper=0) / rolling_mean(abs(clip(daily_return, upper=0)), 30)) * (1 + clip(max(ret_60 - cross_sectional_median(ret_60), 0), upper=0.5)); then shift(1)",
    "description": "Rewards five-session relative laggards for a subsequent rebound, conditioned on positive sixty-session relative trend, normalized by downside volatility, and lagged one session to prevent lookahead."
  },
  "dependencies": ["close"],
  "parameters": {"short_window": 5, "trend_window": 60, "risk_window": 30, "trend_cap": 0.5, "lag": 1, "minimum_cross_section": 8},
  "validation": {
    "status": "EFFECTIVE",
    "period": {"start": "2020-01-01", "end": "2030-08-08"},
    "validated_at": "2030-08-08",
