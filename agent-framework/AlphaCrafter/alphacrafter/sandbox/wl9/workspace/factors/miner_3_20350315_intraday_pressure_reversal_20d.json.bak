{
  "factor_id": "miner_3_20350315_intraday_pressure_reversal_20d",
  "factor_name": "ATR-Normalized Intraday Pressure Reversal 20D",
  "version": "1.0",
  "calculation": {
    "expression": "-rolling_mean((close-open)/true_range, 20).shift(1)",
    "description": "For each tradable benchmark, compute daily close-open pressure normalized by true range, average over the prior 20 completed sessions, and reverse the sign. The one-day lag prevents use of the current incomplete session. true_range=max(high-low, abs(high-prev_close), abs(low-prev_close))."
  },
  "dependencies": [
    "open",
    "high",
    "low",
    "close"
  ],
  "parameters": {
    "lookback_days": 20,
    "min_periods": 15,
    "signal_lag_days": 1,
    "forward_horizon_days": 10,
    "min_cross_section": 8
  },
