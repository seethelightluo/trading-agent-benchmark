{
  "factor_id": "relative_reversal_60d",
  "factor_name": "Cross-Asset Relative Reversal Scaled by Idiosyncratic Volatility",
  "version": "1.0",
  "calculation": {
    "expression": "-(return_60d(asset)-median_cross_section(return_60d))/(sqrt(60)*rolling_std_60d(daily_return(asset)-cross_section_median_daily_return)+1e-5), lagged 1 day",
    "description": "Fades each asset's 60-day performance relative to the contemporaneous cross-asset median, scaling by 60-day volatility of market-relative daily returns. Higher values indicate relatively underperforming, risk-adjusted assets expected to mean-revert."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "lookback_days": 60,
    "volatility_window_days": 60,
    "volatility_min_periods": 45,
    "cross_section_statistic": "median",
    "epsilon": 1e-05,
    "signal_lag_days": 1
  },
  "validation": {
    "status": "EFFECTIVE",
