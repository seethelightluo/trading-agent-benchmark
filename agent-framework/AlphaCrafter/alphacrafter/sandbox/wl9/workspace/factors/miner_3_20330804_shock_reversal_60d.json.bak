{
  "factor_id": "miner_3_20330804_shock_reversal_60d",
  "factor_name": "Volatility-normalized shock reversal",
  "version": "1.0",
  "calculation": {
    "expression": "clip((-sum_returns_20d / (std_returns_60d*sqrt(252)+0.05)) * (1 + 2*clip(max(-sum_returns_5d,0),0,0.30)), -5, 5), lagged 1 day",
    "description": "Contrarian 20-day return normalized by trailing 60-day volatility, with greater emphasis after a recent five-day downside shock. The signal is lagged one session to avoid look-ahead."
  },
  "dependencies": ["close", "daily_returns"],
  "parameters": {
    "return_window_days": 20,
    "volatility_window_days": 60,
    "shock_window_days": 5,
    "volatility_annualization": 252,
    "volatility_floor": 0.05,
    "shock_amplifier": 2.0,
    "shock_cap": 0.30,
    "clip_range": [-5, 5],
    "lag_days": 1
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2033-08-03",
