{
  "factor_id": "miner_1_20330331_peak_drawdown_reversal_60d",
  "factor_name": "Peak-drawdown downside-risk-normalized reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(close / rolling_max(close,120) - 1) / (rolling_std(negative_daily_returns,40)*sqrt(252)+0.05)",
    "description": "Ranks instruments with deep drawdowns from their 120-session peak, scaled by 40-session downside volatility, as rebound candidates. The complete signal is shifted by one completed session to avoid look-ahead bias."
  },
  "dependencies": ["close", "daily_returns"],
  "parameters": {"peak_window": 120, "downside_vol_window": 40, "downside_vol_min_periods": 25, "annualization": 252, "stabilizer": 0.05, "signal_lag": 1, "forward_horizon": 60},
