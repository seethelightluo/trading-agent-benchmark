{
  "factor_id": "miner_3_20320122_relative_momentum_reversal_60d",
  "factor_name": "Volatility-scaled cross-asset relative momentum reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-((close/close.shift(60)-1) - cross_sectional_median((close/close.shift(60)-1)))/(rolling_std(pct_change(close),40)*sqrt(252))",
    "description": "Ranks assets positively when their 60-session return trails the contemporaneous cross-asset median, with the contrarian magnitude scaled by inverse 40-session annualized realized volatility. Signal is shifted by one completed session before forward-return evaluation."
  },
  "dependencies": ["close"],
  "parameters": {"relative_lookback_days": 60, "volatility_window_days": 40, "annualization": 252, "signal_lag_days": 1, "minimum_cross_section": 8},
