{
  "factor_id": "miner_1_20290823_breadth_conditioned_momentum_10d",
  "factor_name": "Breadth-Conditioned Risk-Adjusted Momentum",
  "version": "1.0",
  "calculation": {
    "expression": "where(cross_asset_breadth_20d >= 0.50, (return_20d / volatility_20d) * 2 * (positive_day_fraction_20d - 0.5), missing)",
    "description": "Ranks assets by 20-trading-day return scaled by annualized 20-day volatility and by directional consistency. The signal is active only when at least half of the tradable universe has positive 20-day average daily returns. All inputs are lagged/current-day observable and are used to predict the next 10 trading days. Missing signals are ignored in validation and should be neutralized in portfolio construction."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "return_window": 20,
    "volatility_window": 20,
    "consistency_window": 20,
    "breadth_threshold": 0.5,
    "forward_horizon": 10,
    "annualization": 252
  },
