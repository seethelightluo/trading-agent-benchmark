{
  "factor_id": "miner_1_20310821_choppy_residual_reversal_60d",
  "factor_name": "Choppiness-weighted residual reversal",
  "version": "2031-08-21",
  "calculation": {
    "expression": "-cross_sectional_demean(rolling_sum(log_return,60))/rolling_std(log_return,40) * (0.75 + 1.25*clip(1 - rolling_sum(abs(log_return),60)/abs(rolling_sum(log_return,60)),0,1)), lagged 1 session",
    "description": "Contrarian residual 60-session return, volatility normalized and amplified when the recent path is choppy rather than directional. Signal is lagged one session to prevent look-ahead."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "residual_window": 60,
    "volatility_window": 40,
    "choppiness_window": 60,
    "multiplier_floor": 0.75,
    "multiplier_range": 1.25,
    "lag": 1,
    "forward_horizon": 20
  },
