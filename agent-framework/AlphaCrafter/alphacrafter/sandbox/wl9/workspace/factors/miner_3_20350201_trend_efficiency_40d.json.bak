{
  "factor_id": "miner_3_20350201_trend_efficiency_40d",
  "factor_name": "Trend Efficiency 40D",
  "version": "1.0",
  "calculation": {
    "expression": "(close_t/close_{t-40}-1)^2 / (sum_{i=0}^{39}|return_{t-i}| + 1e-8), lagged one completed day",
    "description": "Signed 40-day net return multiplied by directional efficiency (net return divided by absolute-return path length), lagged one trading day. This rewards persistent directional moves and penalizes choppy paths."
  },
  "dependencies": ["close"],
  "parameters": {"lookback_days": 40, "minimum_path_observations": 30, "forward_horizon_days": 40, "lag_days": 1, "epsilon": 1e-8},
  "validation": {
