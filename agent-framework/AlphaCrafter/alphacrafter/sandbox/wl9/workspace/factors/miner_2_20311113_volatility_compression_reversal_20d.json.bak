{
  "factor_id": "miner_2_20311113_volatility_compression_reversal_20d",
  "factor_name": "Volatility-Compression Conditioned Cross-Asset Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-cross_sectional_residual_return_40d * clip(rolling_volatility_80d / rolling_volatility_20d, 0.5, 3.0)",
    "description": "For each tradable instrument, negate its 40-session return relative to the contemporaneous mean 40-session return across the 15-asset universe, and amplify the contrarian signal when short-term volatility is compressed relative to its longer baseline. The signal is shifted one completed session before forward-return evaluation.",
    "signal_lag": "1 completed trading session"
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "residual_return_window": 40,
    "short_vol_window": 20,
    "long_vol_window": 80,
    "short_vol_min_periods": 15,
    "long_vol_min_periods": 50,
    "compression_clip": [
      0.5,
      3.0
    ],
    "admission_horizon_sessions": 20
  },
