{
  "factor_id": "miner_1_vix_path_quality_reversal_10d",
  "factor_name": "VIX-Conditioned Path-Quality Relative Reversal 10D",
  "version": "2028-11-16",
  "calculation": {
    "expression": "-(sum(log(close/close[-1]),10) / sum(abs(log(close/close[-1])),10)) * I(VIX > rolling_median(VIX,60))",
    "description": "Contrarian score equal to negative ten-day directional displacement divided by ten-day traveled log-return path, active only when VIX is above its trailing 60-day median. Positive values favor assets with negative path-quality displacement during elevated volatility."
  },
  "dependencies": [
    "close",
    "VIX"
  ],
  "parameters": {
    "lookback_days": 10,
    "regime_lookback_days": 60,
    "regime_threshold": "trailing_median",
    "forward_horizon_days": 10
  },
