{
  "factor_id": "miner_2_20330915_volatility_compression_60d",
  "factor_name": "Volatility Expansion with Risk-Adjusted Drift",
  "version": "20330915",
  "calculation": {
    "expression": "lag1[(realized_vol_20 / realized_vol_60 - 1) - 0.25 * return_20 / (realized_vol_60 + 0.05)]",
    "description": "Ranks assets higher when short-term volatility has expanded relative to its 60-session baseline and when recent drift is weak after volatility adjustment. All inputs are lagged one completed session before forecast formation."
  },
  "dependencies": ["close", "pct_change"],
  "parameters": {"short_vol_window": 20, "long_vol_window": 60, "drift_window": 20, "drift_weight": 0.25, "volatility_floor": 0.05, "lag_sessions": 1, "forward_horizon": 60},
  "validation": {
