{
  "factor_id": "miner_2_20300711_downside_skew_reversal_40d",
  "factor_name": "Downside-Skew Volatility-Scaled Relative Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "rolling_mean_3(-rolling_sum_15(asset_return - cross_sectional_median_return,15) / (0.5*rolling_std_15(return)+0.5*rolling_std_15(negative_returns)), lagged 1 day)",
    "description": "Contrarian cross-asset signal favoring recent relative underperformers, normalized by an asymmetric volatility scale that gives equal weight to total and downside volatility. The signal is smoothed over three observations and lagged one completed session to prevent lookahead."
  },
  "dependencies": [
    "close",
    "daily_returns"
  ],
  "parameters": {
    "relative_return_window": 15,
    "volatility_window": 15,
    "return_min_periods": 10,
    "volatility_min_periods": 8,
    "downside_volatility_weight": 0.5,
    "total_volatility_weight": 0.5,
    "smoothing_window": 3,
    "lag": 1,
    "forward_horizon": 40
  },
