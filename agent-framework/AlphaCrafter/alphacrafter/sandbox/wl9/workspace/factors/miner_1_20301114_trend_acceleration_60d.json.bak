{
  "factor_id": "miner_1_20301114_trend_acceleration_60d",
  "factor_name": "Contrarian risk-adjusted trend acceleration",
  "version": "1.0",
  "calculation": {
    "expression": "((close/close.shift(20)-1) - (close/close.shift(60)-1)/3) / (std(pct_change(close),30)*sqrt(252)); then shift(1)",
    "description": "Measures recent 20-day return relative to the prior 60-day average pace, normalized by 30-day annualized volatility. The validated relationship is contrarian: lower acceleration predicts higher subsequent 60-day returns, so portfolio consumers should use direction -1. One-session lag avoids look-ahead bias."
  },
