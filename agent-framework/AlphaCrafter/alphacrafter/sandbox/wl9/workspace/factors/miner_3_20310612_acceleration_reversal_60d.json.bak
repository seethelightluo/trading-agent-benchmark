  "calculation": {
    "expression": "-[((close/close.shift(5)-1) - (close/close.shift(20)-1)/4) / (std(pct_change(close),40)*sqrt(252))] - 0.25*[(close/close.shift(20)-1)/(std(pct_change(close),40)*sqrt(252))]",
    "description": "Contrarian signal for unusually adverse five-day return relative to the asset's average 20-day pace, volatility scaled and modestly anchored by 20-day reversal; shifted one session before forward-return evaluation."
