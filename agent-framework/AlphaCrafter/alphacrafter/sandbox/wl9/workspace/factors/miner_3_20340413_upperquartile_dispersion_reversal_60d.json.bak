{
  "factor_id": "miner_3_20340413_upperquartile_dispersion_reversal_60d",
  "factor_name": "Upper-quartile dispersion-gated volatility-normalized contrarian reversal",
  "version": "1.0",
  "calculation": {
    "expression": "clip(-return_20d / (annualized_volatility_60d + 0.05), -8, 8) * I(dispersion_20d > rolling_quantile(dispersion_20d, 120d, 0.75))",
    "description": "Cross-sectional contrarian shock signal activated only when mean 20-day cross-asset return volatility is above its trailing 120-session 75th percentile; all inputs are shifted one completed session before use."
  },
  "dependencies": ["close", "daily_returns"],
  "parameters": {
    "return_window": 20,
    "volatility_window": 60,
    "volatility_annualization": 252,
    "volatility_floor": 0.05,
    "dispersion_window": 20,
    "dispersion_quantile_window": 120,
    "dispersion_quantile": 0.75,
    "clip_lower": -8,
    "clip_upper": 8,
    "lag_sessions": 1,
