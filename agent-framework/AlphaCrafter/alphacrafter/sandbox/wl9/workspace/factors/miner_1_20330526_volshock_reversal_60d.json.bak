  "calculation": {
    "expression": "shift1((-ret5/(ann_std(ret1,10)+0.05)).clip(-4,4) * (1+0.8*(ann_std(ret1,10)/(ann_std(ret1,60)+0.05)-1).clip(-0.8,2)) * (1+0.35*abs(mean_cross_section(ret1_5<0)-0.5)))",
    "description": "Ranks assets for 60-session forward returns by lagged five-session shock reversal, amplified when short volatility expands relative to 60-session volatility and modestly scaled by cross-sectional breadth intensity. All per-asset inputs are shifted one completed session."
