{
  "factor_id": "miner_1_20321111_peak_recovery_reversal_60d",
  "factor_name": "Peak Drawdown Age-Adjusted Recovery Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-((close / rolling_max(close,60) - 1) / (1 + peak_age_60/60)) / downside_volatility_60, lagged 1 session",
    "description": "Contrarian recovery score for instruments below their 60-session peak. The drawdown is attenuated when the peak is older, normalized by 60-session downside realized volatility, and lagged one session to avoid look-ahead bias."
  },
  "dependencies": ["close", "pct_change"],
  "parameters": {
    "lookback_days": 60,
    "minimum_vol_observations": 40,
    "downside_volatility_annualization": "sqrt(60)",
    "peak_age_definition": "sessions since most recent rolling 60-session maximum",
    "signal_lag_sessions": 1,
    "forward_horizon_admission_days": 60
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 to 2032-11-10",
    "last_validated": "2032-11-11",
    "metrics": {
      "ic": 0.190756,
      "icir": 0.649651,
      "hit_ratio": 0.7384,
      "valid_ic_dates": 1575,
      "average_instruments": 13.05,
      "instrument_count": 15,
      "coverage": 0.430312,
      "turnover": 0.070382,
      "max_abs_library_correlation": null,
      "decay": {"10d_ic": 0.063823, "20d_ic": 0.088871, "40d_ic": 0.149408, "60d_ic": 0.190756}
    },
    "thresholds": {"minimum_absolute_daily_paper_ic": 0.007, "minimum_absolute_daily_paper_icir": 0.084},
    "regime_notes": "Positive across reported regimes: 2024 IC 0.195150; 2027-2029 IC 0.201066; 2030 IC 0.235061; 2031-2032 IC 0.143591. Small cross-asset universe implies conservative uncertainty interpretation.",
    "signal_artifact": "scripts/miner_1_20321111_peak_recovery_reversal_signal.csv",
    "provenance": "Spearman cross-sectional IC; daily observations require at least 8 valid instruments; prices visible through prior completed session and factor is one-session lagged."
  },
  "tags": ["reversal", "drawdown", "recovery", "downside-volatility", "cross-asset"]
}
