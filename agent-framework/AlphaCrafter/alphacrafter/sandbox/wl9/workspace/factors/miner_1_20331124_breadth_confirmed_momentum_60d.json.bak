  "factor_name": "Breadth-confirmed risk-adjusted 60-day momentum",
  "version": "1.0",
  "calculation": {
    "expression": "lag1((R60/(annualized_sigma60+0.05))*2*(breadth20-0.5))",
    "description": "Risk-adjusted 60-session return, signed and scaled by the fraction of tradable assets with positive 20-session returns; all inputs are lagged one completed session for prediction."
