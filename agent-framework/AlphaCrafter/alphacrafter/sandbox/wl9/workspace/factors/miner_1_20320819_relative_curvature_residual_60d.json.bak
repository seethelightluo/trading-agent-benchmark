{
  "factor_id": "miner_1_20320819_relative_curvature_residual_60d",
  "factor_name": "Relative Cross-Asset Curvature Residual Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(((R20_i - median_j(R20_j)) - (R60_i - median_j(R60_j))/3) / ann_vol60_i), lagged 1 day",
    "description": "For each tradable instrument, compute 20-session and 60-session cumulative returns, subtract the contemporaneous cross-asset median at each horizon, compare short-horizon relative return with one-third long-horizon relative return, negate for contrarian exposure, and scale by 60-session annualized realized volatility. The signal is shifted by one completed session to prevent look-ahead bias."
  },
  "dependencies": ["close"],
  "parameters": {
    "short_window": 20,
    "long_window": 60,
    "long_pace_divisor": 3,
    "volatility_window": 60,
    "volatility_annualization": 252,
    "minimum_return_observations": 15,
    "minimum_volatility_observations": 45,
    "signal_lag_sessions": 1,
    "minimum_cross_section": 8,
    "horizon_days": 60
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2032-08-18",
    "last_validated": "2032-08-19",
    "metrics": {
