  "calculation": {
    "expression": "lag1((return_20 / annualized_volatility_20) if return_60 > 0 else NA)",
    "description": "Ranks assets by their prior-session-lagged 20-day return divided by annualized 20-day realized volatility, retaining the signal only when the 60-day trend is positive. This targets persistent recoveries while avoiding continuation signals in falling assets."
