{
  "factor_id": "miner_2_20330901_short_shock_reversal_60d",
  "factor_name": "Short-horizon shock reversal with range-location confirmation",
  "version": "1.0",
  "calculation": {
    "expression": "clip((-sum(ret,5)/(stdev(ret,20)*sqrt(252)+0.05)) + 0.35*((rolling_midpoint(close,60)-close)/(rolling_high(close,60)-rolling_low(close)+epsilon)), -6, 6), shifted 1 session",
    "description": "Ranks assets for medium-term rebound after a recent five-session loss, risk-normalized by 20-session volatility and modestly confirmed by location below the trailing 60-session range midpoint. The one-session lag prevents look-ahead."
  },
  "dependencies": ["close", "daily_returns"],
  "parameters": {
    "shock_window": 5,
    "risk_window": 20,
    "range_window": 60,
    "range_location_weight": 0.35,
    "annualization": 252,
    "epsilon": 1e-12,
    "lag_sessions": 1,
    "clip": [-6, 6]
  },
  "validation": {
    "status": "EFFECTIVE",
    "timestamp": "2033-09-01",
    "period": "2020-01-01 through 2033-08-31",
    "universe_size": 15,
    "valid_dates": 1798,
    "regime_notes": "Positive across 2024, 2027-2029, 2030, and 2031-2032; substantially weakened but remained slightly positive in 2033 YTD, so current use should be conservative.",
    "metrics": {
      "horizon_days": 60,
      "ic": 0.152023,
      "icir": 0.519042,
      "hit_ratio": 0.6963,
      "coverage": 0.550126,
      "turnover": 0.128668,
      "average_instruments": 15.0,
      "max_abs_library_correlation": null,
      "regime_ic": {"2024": 0.236920, "2027-2029": 0.135074, "2030": 0.249412, "2031-2032": 0.140113, "2033_ytd": 0.010084}
    }
  },
  "signal_artifact": "scripts/miner_2_20330901_short_shock_reversal_signal.csv",
