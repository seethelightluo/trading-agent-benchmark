  "version": "1.0",
  "calculation": {
    "expression": "lag1(rolling_return(close,60) / (annualized_volatility(close,20) + 0.10))",
    "description": "Ranks assets by their prior 60-trading-day return scaled by trailing 20-day realized volatility plus a stabilizing 10 percentage-point term. The one-session lag prevents look-ahead and favors persistent risk-adjusted trends."
