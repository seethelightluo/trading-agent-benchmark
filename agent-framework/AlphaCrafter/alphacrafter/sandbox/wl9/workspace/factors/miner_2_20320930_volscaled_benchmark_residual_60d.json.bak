{
  "factor_id": "miner_2_20320930_volscaled_benchmark_residual_60d",
  "factor_name": "Volatility-Scaled Benchmark Residual Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-rolling_sum_20(asset_returns - cross_sectional_mean_return_1, 20) / (rolling_std(asset_returns, 60) * sqrt(20)), lagged_1",
    "description": "For each tradable asset, measure its negative 20-session cumulative return relative to the equal-weight cross-asset benchmark, scale by 60-session realized volatility, and lag the signal one session to prevent look-ahead. Higher values indicate relatively weak, risk-adjusted assets expected to mean-revert over the medium horizon."
  },
  "dependencies": ["close", "pct_change"],
  "parameters": {"residual_benchmark": "equal_weight_mean_of_15_tradable_assets", "return_window": 20, "volatility_window": 60, "volatility_annualization_factor": 20, "lag": 1, "forward_horizon_admission": 60},
