{
  "factor_id": "miner_3_20320805_range_pressure_reversal_60d",
  "factor_name": "Volatility-scaled close-range pressure reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-rolling_mean((2*close-high-low)/(high-low),40) / (rolling_std(pct_change(close),40)*sqrt(252)), shifted 1 session",
    "description": "Contrarian signal from the average daily close location within high-low ranges. Positive buying pressure is assigned a negative forward expectation, and the signal is scaled by realized volatility. The one-session shift prevents use of incomplete/current information."
  },
  "dependencies": ["close", "high", "low"],
  "parameters": {"window": 40, "min_periods": 30, "annualization": 252, "lag_sessions": 1, "forward_validation_horizon": 60},
  "validation": {
