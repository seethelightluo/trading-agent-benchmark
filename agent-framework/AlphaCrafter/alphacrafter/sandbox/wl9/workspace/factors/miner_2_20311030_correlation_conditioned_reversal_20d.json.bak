{
  "factor_id": "miner_2_20311030_correlation_conditioned_reversal_20d",
  "factor_name": "Correlation-Conditioned Cross-Asset Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-cross_sectional_residual_return_60d * (0.75 + 0.75 * percentile_rank(rolling_corr(asset_daily_log_return, equal_weight_cross_asset_daily_log_return, 60d)))",
    "description": "Contrarian 60-session residual return, emphasizing recent relative losers whose returns are more correlated with the equal-weight cross-asset market proxy. Signal is lagged one session before forward-return testing."
  },
  "dependencies": ["close", "daily_log_return"],
  "parameters": {"residual_lookback": 60, "correlation_lookback": 60, "correlation_min_periods": 30, "market_proxy": "equal_weight_mean_daily_log_return", "signal_lag": 1, "minimum_cross_section": 8},
