{
  "factor_id": "vix_stress_reversal_20d",
  "factor_name": "VIX-stress amplified 20-day contrarian reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(close/close.shift(20)-1) * (1 + 0.5*clip((VIX-rolling_mean(VIX,60))/rolling_std(VIX,60), -2, 2))",
    "description": "Cross-asset contrarian 20-day return, amplified when the lagged observable VIX stress z-score is elevated. Signal uses completed-day data only; forward validation is from t to t+20. VIX is observation-only and is never traded."
  },
  "dependencies": ["close", "VIX.close"],
  "parameters": {"lookback_days": 20, "vix_window": 60, "stress_clip": [-2, 2], "stress_amplifier": 0.5, "forward_horizon_days": 20, "minimum_cross_section": 8},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-02 through 2031-07-10",
    "last_validated": "2031-07-10T00:00:00Z",
    "metrics": {
      "ic": 0.037298,
      "icir": 0.115230,
      "horizon_days": 20,
      "valid_dates": 3284,
      "loaded_instruments": 15,
      "average_valid_instruments": 14.664434,
      "coverage": 0.977629,
      "turnover_proxy": 0.120374,
      "hit_ratio": 0.5484,
      "max_abs_library_correlation": null
    },
    "admission_thresholds": {"absolute_ic_min": 0.007, "absolute_icir_min": 0.084},
    "regime_results": {
      "2024-2026": {"dates": 490, "ic": 0.001981, "icir": 0.005145, "hit_ratio": 0.5204},
      "2027-2029": {"dates": 752, "ic": 0.068673, "icir": 0.268998, "hit_ratio": 0.5811},
      "2030": {"dates": 230, "ic": 0.121615, "icir": 0.379315, "hit_ratio": 0.6478},
      "2031_ytd": {"dates": 124, "ic": 0.121444, "icir": 0.431531, "hit_ratio": 0.6613}
    },
    "regime_notes": "Aggregate 20-day IC and ICIR pass benchmark gates with broad coverage. Predictive strength is materially stronger from 2027 onward; 2024-2026 is weak and should be monitored for regime drift.",
    "signal_artifact": "scripts/miner_1_20310710_macro_stress_reversal_signal.csv"
  },
