{
  "factor_id": "miner_1_20300307_dispersion_gated_reversal_10d",
  "factor_name": "Dispersion-Gated Volatility-Normalized Relative Reversal",
  "version": "2030-03-07",
  "calculation": {
    "expression": "-(ret_10d - cross_sectional_median(ret_10d)) / (sqrt(10)*std_daily_return_20d) * (0.5 + percentile_rank_252(cross_sectional_dispersion_10d))",
    "description": "Ranks assets for reversal of their 10-day return relative to the cross-asset median, normalizes by own 20-day realized volatility, and increases exposure when cross-asset 10-day return dispersion is elevated. The signal is lagged one completed day for forecasting."
  },
  "dependencies": ["close"],
  "parameters": {"relative_return_window": 10, "volatility_window": 20, "dispersion_window": 10, "dispersion_rank_window": 252, "forecast_horizons_days": [5,10,20,40], "signal_lag_days": 1},
