{
  "factor_id": "miner_2_20340202_downside_residual_reversal_10d",
  "factor_name": "Downside-Quality Cross-Sectional Residual Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "clip(-residual_return_60d / downside_rms_vol_40d * clip(upside_rms_vol_40d / downside_rms_vol_40d, 0.5, 2.0), -6, 6), lagged 1 session",
    "description": "Fade each instrument's 60-session return relative to the cross-sectional median, scaling the reversal by downside RMS volatility and the upside-to-downside volatility ratio. Signal is lagged one completed session to avoid look-ahead."
  },
  "dependencies": ["close", "daily_returns"],
  "parameters": {
    "residual_window": 60,
    "volatility_window": 40,
    "annualization": 252,
    "volatility_floor": 0.04,
    "up_down_ratio_clip": [0.5, 2.0],
    "signal_clip": [-6, 6],
    "lag_sessions": 1,
    "forward_horizon_sessions": 10
  },
