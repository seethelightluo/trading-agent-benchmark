{
  "factor_id": "miner_3_20301226_range_position_reversal_60d",
  "factor_name": "Risk-Scaled 60-Day Range-Position Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(((close-rolling_min(close,60))/(rolling_max(close,60)-rolling_min(close,60))-0.5)/rolling_std(pct_change(close),20))",
    "description": "Contrarian signal: favor instruments near the lower part of their prior 60-session price envelope and underweight instruments near the upper part, scaled by inverse recent volatility. Signal is lagged one completed session to avoid look-ahead."
  },
  "dependencies": [
    "close",
    "high",
    "low"
  ],
  "parameters": {
    "lookback": 60,
    "volatility_window": 20,
    "signal_lag": 1,
    "validation_horizon": 60,
    "min_cross_section": 8
  },
