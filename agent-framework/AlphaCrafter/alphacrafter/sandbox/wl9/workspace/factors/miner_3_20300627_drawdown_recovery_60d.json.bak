{
  "factor_id": "miner_3_20300627_drawdown_recovery_60d",
  "factor_name": "Relative Drawdown Recovery, Downside-Scaled",
  "version": "1.0",
  "calculation": {
    "expression": "-(drawdown_60d - cross_sectional_median(drawdown_60d)) / downside_scale_40d, lagged 1 day",
    "description": "Contrarian recovery signal: favors instruments whose trailing-60-day drawdown is deeper than the cross-sectional median, normalized by mean absolute negative daily return over 40 days. The signal is shifted one completed session to prevent lookahead."
  },
  "dependencies": [
    "close",
    "daily_returns"
  ],
  "parameters": {
    "drawdown_window": 60,
    "scale_window": 40,
    "drawdown_min_periods": 45,
    "scale_min_periods": 15,
    "forward_horizon": 60,
    "lag": 1
  },
