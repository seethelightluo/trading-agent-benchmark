{
  "factor_id": "miner_3_20320708_volume_shock_reversal_60d",
  "factor_name": "Volume-Shock Amplified Volatility-Normalized Relative Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "shift1((-(relative_return_20d)/annualized_volatility_60d) * (1 + 0.35*clip(max(volume_mean_20d/volume_mean_120d-1,0),0,1)))",
    "description": "Cross-sectional 20-session relative reversal, normalized by trailing 60-session volatility and amplified modestly when recent volume is unusually elevated. The production signal is lagged one completed session to avoid look-ahead bias."
  },
  "dependencies": ["close", "volume"],
  "parameters": {"reversal_window": 20, "relative_reference": "cross_sectional_median", "volatility_window": 60, "volume_fast_window": 20, "volume_slow_window": 120, "volume_min_periods": {"fast": 12, "slow": 60}, "volume_shock_floor": 0.0, "volume_shock_cap": 1.0, "amplifier": 0.35, "lag_sessions": 1},
