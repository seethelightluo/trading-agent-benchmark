  "calculation": {
    "expression": "cross_sectional_median((-return_5d / downside_volatility_40d) * (1 - 0.35 * max(recovery_from_20d_low, 0))) - ((-return_5d / downside_volatility_40d) * (1 - 0.35 * max(recovery_from_20d_low, 0)))",
    "description": "Contrarian signal favoring recent five-day losers, scaled by downside volatility and penalizing assets that have already recovered from their 20-day low; cross-sectionally median-centered and lagged one session.",
