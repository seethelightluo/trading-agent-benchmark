  },
  "dependencies": ["close", "daily_returns"],
  "parameters": {"shock_horizon_days": 5, "downside_vol_window_days": 40, "recovery_window_days": 20, "recovery_penalty": 0.35, "signal_lag_days": 1, "forward_validation_horizon_days": 40},
