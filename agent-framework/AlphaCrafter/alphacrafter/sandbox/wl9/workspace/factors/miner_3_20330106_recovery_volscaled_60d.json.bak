{
  "factor_id": "miner_3_20330106_recovery_volscaled_60d",
  "factor_name": "Volatility-scaled recovery asymmetry reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-((close/rolling_min(close,60)-1)/(1-close/rolling_max(close,60)+0.02))/(rolling_std(pct_change(close),60)*sqrt(252)+0.05), shifted by 1 completed session",
    "description": "Ranks assets favoring weak recovery from their trailing low relative to peak drawdown, with the contrarian signal normalized by realized volatility. The one-session lag prevents use of the current incomplete session."
  },
  "dependencies": ["close"],
  "parameters": {"lookback_days": 60, "min_periods": 45, "drawdown_epsilon": 0.02, "volatility_floor": 0.05, "volatility_annualization": 252, "signal_lag_days": 1, "forward_horizon_days": 60},
