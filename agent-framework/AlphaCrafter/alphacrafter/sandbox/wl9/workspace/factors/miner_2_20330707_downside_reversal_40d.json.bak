{
  "factor_id": "miner_2_20330707_downside_reversal_40d",
  "factor_name": "Downside-volatility-adjusted contrarian displacement with short recovery",
  "version": "1.0",
  "calculation": {
    "expression": "clip(-return_40d/(downside_volatility_60d+0.05) + 0.25*return_10d/(volatility_20d+0.05), -5, 5), lagged 1 session",
    "description": "Ranks assets positively when they have suffered weak 40-day performance after adjustment for downside volatility, with a modest boost for a short-term recovery. The one-session lag prevents look-ahead."
  },
  "dependencies": ["close", "daily_returns"],
  "parameters": {
    "displacement_window": 40,
    "downside_volatility_window": 60,
    "short_recovery_window": 10,
    "short_volatility_window": 20,
    "recovery_weight": 0.25,
    "risk_offset": 0.05,
    "clip": [-5, 5],
    "lag_sessions": 1
  },
