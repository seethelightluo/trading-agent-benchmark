{
  "factor_id": "miner_2_20340622_return_acceleration_20d",
  "factor_name": "Lagged Cross-Asset Return Acceleration",
  "version": "1.0",
  "calculation": {
    "expression": "(pct_change(close,20) - pct_change(close,60)/3).shift(1), cross-sectionally demeaned by daily median",
    "description": "Ranks tradable assets by the acceleration of their recent 20-session return relative to the preceding 60-session average-return scale. The one-session lag ensures only completed daily data are used. Higher values indicate strengthening trend and predict higher 20-session forward returns."
  },
  "dependencies": ["close"],
  "parameters": {"recent_window": 20, "comparison_window": 60, "comparison_scale": 3.0, "signal_lag": 1, "minimum_cross_section": 8},
