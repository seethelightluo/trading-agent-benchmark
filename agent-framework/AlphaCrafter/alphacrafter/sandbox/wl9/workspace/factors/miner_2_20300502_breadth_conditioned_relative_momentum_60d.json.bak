{
  "factor_id": "miner_2_20300502_breadth_conditioned_relative_momentum_60d",
  "factor_name": "Breadth-Conditioned Relative Momentum",
  "version": "1.0",
  "calculation": {
    "expression": "lag1((r20_i - median_cross_section(r20)) * (2 * rolling_mean_10(cross_sectional_positive_return_breadth) - 1))",
    "description": "Compute each asset's 20-session return relative to the contemporaneous cross-sectional median, then condition its sign and magnitude on the lagged market breadth regime. Breadth is the 10-session rolling mean fraction of the 15 tradable instruments with positive daily returns. The complete signal is lagged one session to avoid lookahead. Higher values indicate relative winners during broad positive-breadth regimes or relative losers during negative-breadth regimes, consistent with regime-dependent continuation."
  },
  "dependencies": ["close", "daily_returns"],
  "parameters": {"return_lookback": 20, "breadth_lookback": 10, "signal_lag": 1, "minimum_cross_section": 8, "forward_horizon": 60},
  "validation": {
    "status": "EFFECTIVE",
    "metrics": {
      "ic": 0.071464,
      "icir": 0.198494,
      "coverage": 0.9605,
      "average_instruments": 14.41,
      "dates": 1562,
      "instruments": 15,
      "hit_ratio": 0.5717,
      "turnover_proxy": 0.069864,
      "max_abs_library_correlation": null
    },
    "period": "2021-11-30 through 2030-04-30",
    "regime_notes": "60-day result passes benchmark-wide absolute IC and ICIR gates. Early regime IC -0.008276 (388 dates), middle +0.061680 (376 dates), late +0.114844 (798 dates); performance is regime dependent and should receive conservative ensemble weight. The 40-day variant ICIR 0.083259 narrowly failed the 0.0840 ICIR gate and was not persisted.",
    "admission_thresholds": {"absolute_daily_paper_ic": 0.007, "absolute_daily_paper_icir": 0.084},
