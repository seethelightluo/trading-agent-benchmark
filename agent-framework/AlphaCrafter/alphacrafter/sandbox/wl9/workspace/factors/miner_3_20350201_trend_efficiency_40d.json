{
  "factor_id": "miner_3_20350201_trend_efficiency_40d",
  "factor_name": "Directional Trend Efficiency 40D",
  "version": "1.0",
  "calculation": {
    "expression": "((close_t/close_{t-40}-1) * ((close_t/close_{t-40}-1) / (rolling_sum(abs(pct_change(close)),40)+epsilon))).shift(1)",
    "description": "Measures the signed 40-trading-day move multiplied by directional efficiency, where efficiency is net return divided by the absolute-return path length. Positive values favor persistent upward trends and negative values favor persistent downward trends. The one-day lag prevents look-ahead."
  },
  "dependencies": ["close", "pct_change(close)"],
  "parameters": {
    "trend_window_days": 40,
    "path_window_days": 40,
    "path_min_periods": 30,
    "epsilon": 0.00000001,
    "signal_lag_days": 1,
    "universe": ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
  },
