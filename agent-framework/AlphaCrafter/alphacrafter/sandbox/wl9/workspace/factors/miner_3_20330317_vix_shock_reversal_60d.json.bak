{
  "factor_id": "miner_3_20330317_vix_shock_reversal_60d",
  "factor_name": "VIX-shock-amplified volatility-normalized reversal",
  "version": "1.0",
  "calculation": {
    "expression": "shift1((-return_10d / (rolling_std(return_1d,20)*sqrt(252)+0.05)) * (1 + 0.35*tanh(zscore_5d_change(VIX,252))) )",
    "description": "Ranks assets positively after a negative ten-session return normalized by realized volatility, with the reversal signal amplified when the observation-only VIX has recently risen unusually relative to its 252-session history. The complete signal is shifted one session before evaluation."
  },
  "dependencies": ["close", "VIX close"],
  "parameters": {
    "return_window": 10,
    "volatility_window": 20,
    "vix_change_window": 5,
    "vix_zscore_window": 252,
    "vix_amplitude": 0.35,
    "annualization": 252,
    "shift_sessions": 1,
    "minimum_cross_section": 8
  },
  "validation": {
    "status": "EFFECTIVE",
    "last_validated": "2033-03-17T00:00:00Z",
