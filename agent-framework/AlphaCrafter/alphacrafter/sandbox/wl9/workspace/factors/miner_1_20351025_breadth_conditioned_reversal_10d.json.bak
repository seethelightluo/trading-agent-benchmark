{
  "factor_id": "miner_1_20351025_breadth_conditioned_reversal_10d",
  "factor_name": "Breadth-Conditioned Volatility-Scaled Reversal 10D",
  "version": "1.0",
  "calculation": {
    "expression": "-(return_10d_lagged)/(rolling_std_daily_return_20d_lagged*sqrt(10)+0.03) * clip(1.5 - cross_asset_breadth_20d_lagged, 0.5, 1.5)",
    "description": "Ranks assets by a contrarian ten-session return normalized by trailing local volatility; the signal is amplified when the fraction of assets with positive trailing 20-session mean return is low. All inputs are lagged through the prior completed session."
  },
  "dependencies": ["close", "daily_returns"],
  "parameters": {"return_window_sessions": 10, "volatility_window_sessions": 20, "breadth_window_sessions": 20, "volatility_floor": 0.03, "gate_center": 1.5, "gate_min": 0.5, "gate_max": 1.5, "minimum_cross_section": 8},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2035-10-24",
    "metrics": {
      "horizon_sessions": 10,
      "ic": 0.038539,
      "icir": 2.134741,
      "hit_ratio": 0.5677,
      "valid_dates": 2406,
      "average_instruments": 15.0,
      "minimum_instruments": 10,
      "coverage": 0.6062,
      "turnover_proxy_10d": 0.3024,
      "max_abs_library_correlation": null,
      "decay_ic": {"5": 0.0292, "10": 0.038539, "20": 0.057563, "40": 0.062696, "60": 0.094264},
      "regime_ic_h10": {"2024-2026": 0.079821, "2027-2029": 0.035344, "2030-2032": 0.019664, "2033-2035": 0.055783}
    },
    "admission_thresholds": {"minimum_absolute_paper_ic": 0.007, "minimum_absolute_paper_icir": 0.084},
    "signal_artifact": "scripts/miner_1_20351025_breadth_conditioned_reversal_signal.csv",
    "regime_notes": "Positive H10 IC in each reported post-2023 regime; small 15-instrument cross-section warrants conservative interpretation."
  },
  "tags": ["reversal", "volatility_scaled", "breadth", "cross_asset", "10d"],
  "last_validated": "2035-10-25T00:00:00Z"
}
