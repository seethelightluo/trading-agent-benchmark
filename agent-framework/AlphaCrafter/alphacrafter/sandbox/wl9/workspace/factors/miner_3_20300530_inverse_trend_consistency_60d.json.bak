{
  "factor_id": "miner_3_20300530_inverse_trend_consistency_60d",
  "factor_name": "Inverse Volatility-Normalized Relative Trend Consistency",
  "version": "1.1",
  "calculation": {
    "expression": "-relative_return_20d_to_cross_sectional_median / volatility_40d * (1 + positive_session_fraction_20d - 0.5), lagged_1d",
    "description": "Ranks assets contrarian to persistent relative trends, volatility-normalized and adjusted by the fraction of positive sessions. The signal is lagged one session to prevent lookahead."
  },
