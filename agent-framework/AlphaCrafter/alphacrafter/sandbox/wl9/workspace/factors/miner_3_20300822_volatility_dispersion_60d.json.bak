{
  "factor_id": "miner_3_20300822_volatility_dispersion_60d",
  "factor_name": "Cross-Asset Low-Volatility Dispersion",
  "version": "1.0",
  "calculation": {
    "expression": "-(rolling_std(pct_change(close),20) / cross_sectional_median(rolling_std(pct_change(close),20)) - 1), then lag 1 session",
    "description": "Ranks assets with 20-session realized volatility below the cross-sectional median more positively, using only completed information. The signal is intended as a medium-horizon defensive/low-volatility cross-asset tilt."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "volatility_window": 20,
    "cross_sectional_normalizer": "median",
    "lag": 1
  },
