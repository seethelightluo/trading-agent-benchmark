{
  "factor_id": "macro_residual_reversal_vixdxy_60d",
  "factor_name": "VIX-DXY macro residual reversal, volatility-normalized 60D",
  "version": "1.0",
  "calculation": {
    "expression": "-residual_60d(asset_log_returns ~ intercept + beta_VIX*VIX_returns + beta_DXY*DXY_returns) / rolling_std(asset_log_returns,60), lagged 1 session",
    "description": "For each tradable benchmark asset, fit a rolling 60-session OLS exposure to observation-only VIX and DXY returns, calculate the 60-session asset return residual after subtracting the current macro-implied component, reverse its sign, and divide by 60-session realized volatility. The signal is lagged one completed session."
  },
  "dependencies": [
    "close",
    "VIX close",
    "DXY close"
  ],
  "parameters": {
    "lookback_sessions": 60,
    "macro_signals": [
      "VIX",
      "DXY"
    ],
    "minimum_cross_section": 8,
    "signal_lag_sessions": 1,
    "volatility_floor": "nonzero"
  },
