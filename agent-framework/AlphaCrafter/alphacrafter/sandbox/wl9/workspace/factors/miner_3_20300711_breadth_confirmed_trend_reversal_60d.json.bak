{
  "factor_id": "miner_3_20300711_breadth_confirmed_trend_reversal_60d",
  "factor_name": "Breadth-Confirmed Risk-Adjusted Trend Reversal",
  "version": "1.1",
  "calculation": {
    "expression": "-((close/close.shift(60)-1)/(rolling_std(pct_change(close),40)*sqrt(252)+1e-8))*((max((cross_sectional_mean(pct_change(close,20)>0)-0.5)*2,0))+0.25), then lag 1 session",
    "description": "Contrarian 60-day risk-adjusted trend signal, strengthened when breadth exceeds 50 percent and lagged one completed session to prevent lookahead."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "trend_window": 60,
    "volatility_window": 40,
    "breadth_window": 20,
    "annualization": 252,
    "breadth_baseline": 0.25,
    "lag": 1
  },
