{
  "factor_id": "miner_3_20321111_bear_regime_reversal_60d",
  "factor_name": "Bear-Regime Cross-Asset Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "(-rolling_sum(pct_change(close), 20)) * I(rolling_sum(equal_weight_mean_asset_returns, 20) <= 0), shifted by 1 completed session",
    "description": "Cross-sectional contrarian 20-session return signal, activated only when the equal-weight benchmark of the 15 tradable assets has non-positive 20-session return. The one-session shift prevents look-ahead bias."
  },
  "dependencies": ["close"],
  "parameters": {"lookback_days": 20, "benchmark_window": 20, "benchmark_min_periods": 15, "lag_days": 1, "forward_horizon_days": 60, "minimum_cross_section": 8},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2032-10-13",
    "metrics": {
      "ic": 0.136923,
      "icir": 0.462246,
      "hit_ratio": 0.6897,
      "valid_dates": 751,
      "average_instruments": 15.0,
      "coverage": 0.485009,
      "turnover": 0.043194,
      "max_abs_library_correlation": 0.6824344617
    },
    "horizon_days": 60,
    "thresholds": {"minimum_absolute_ic": 0.007, "minimum_absolute_icir": 0.084},
    "decay": {"10d_ic": 0.062524, "20d_ic": 0.092039, "40d_ic": 0.109586, "60d_ic": 0.136923},
    "regime_notes": "Positive 60-day IC in reported subperiods: 2024 0.312898 (62 dates), 2027-2029 0.106622 (462), 2030 0.178517 (91), 2031-2032 0.131800 (136). Small 15-asset cross-section implies conservative uncertainty interpretation.",
    "validation_timestamp": "2032-11-11T00:00:00",
