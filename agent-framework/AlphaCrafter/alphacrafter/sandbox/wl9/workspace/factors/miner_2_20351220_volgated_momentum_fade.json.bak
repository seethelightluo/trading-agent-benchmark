{
  "factor_id": "volgated_momentum_fade_21d",
  "factor_name": "Volatility-Gated Medium-Term Momentum Fade",
  "version": "1.0",
  "calculation": {
    "expression": "-(R_21_lag / (sqrt(40)*std_daily_40_lag + 0.05)) * (1 + 0.5*sign(R_120_lag)*clip(abs(R_120_lag),0,1))",
    "description": "Fades lagged 21-trading-day cross-asset momentum, scaling by lagged 40-day annualized volatility and strengthening the fade when the lagged 120-day trend confirms direction. All inputs are shifted to the prior completed day."
  },
  "dependencies": ["close", "daily_returns"],
  "parameters": {"short_window": 21, "trend_window": 120, "vol_window": 40, "vol_floor": 0.05, "trend_gate_strength": 0.5, "winsor_clip": 20},
