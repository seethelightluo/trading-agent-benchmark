{
  "factor_id": "miner_1_20290517_stress_residual_reversal_5d",
  "factor_name": "Stress-Conditioned Cross-Sectional Residual Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "when breadth_5d < trailing_60d_20th_percentile: -(return_5d - cross_sectional_median(return_5d)) / std(return_1d,20)",
    "description": "During broad market stress, favor instruments with unusually weak five-day residual returns, normalized by their recent 20-day return volatility. Signal is evaluated cross-sectionally; higher values indicate stronger rebound potential. Long-only implementation requires defensive assets for non-selected capital."
  },
  "dependencies": [
    "close",
    "date"
  ],
  "parameters": {
    "return_window": 5,
    "forward_horizon": 10,
    "volatility_window": 20,
    "breadth_window": 60,
    "stress_percentile": 20,
    "minimum_cross_section": 8
  },
