{
  "factor_id": "miner_2_20300905_downside_skew_trend_60d",
  "factor_name": "Downside-Skew Trend Quality 60D",
  "version": "1.0",
  "calculation": {
    "expression": "rank_cs(rolling_mean_3(lag1((return_40 / downside_semideviation_40) * path_efficiency_40)))",
    "description": "Ranks 40-session return adjusted by annualized downside semideviation and multiplied by 40-session absolute path efficiency; three-session smoothing and one-session lag prevent same-day leakage. Forecast direction is -1 because the raw signal has negative forward-return IC."
  },
