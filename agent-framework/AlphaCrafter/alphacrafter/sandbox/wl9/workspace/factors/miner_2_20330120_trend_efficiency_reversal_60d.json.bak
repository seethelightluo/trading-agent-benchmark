  },
  "dependencies": ["close"],
  "parameters": {
    "return_window_sessions": 40,
    "path_window_sessions": 40,
    "volatility_window_sessions": 40,
    "volatility_floor": 0.05,
    "signal_lag_sessions": 1,
    "minimum_cross_section": 8
  },
