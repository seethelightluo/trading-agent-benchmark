  "factor_name": "Volatility-adjusted trend-efficiency reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-return(close,40) / (rolling_sum(abs(pct_change(close)),40) * (annualized_volatility_40d + 0.05)), lagged_1d",
    "description": "Contrarian signal that favors assets whose 40-session directional return is weak relative to their realized absolute price path and volatility. The one-session lag ensures only completed data are used; downstream portfolio construction ranks the cross-section.",
