{
  "factor_id": "downside_skew_volume_reversal_60d",
  "factor_name": "Downside-Skew-Weighted Contrarian Residual Momentum",
  "version": "1.0",
  "calculation": {
    "expression": "-demean_cs(pct_change(close,60)) * (0.5 + cs_rank(clip(std(negative_returns,60)/std(returns,60),0.25,2.5))) then lag(1)",
    "description": "Ranks each asset's downside volatility share over 60 sessions, giving greater weight to contrarian residual 60-day reversal in assets whose volatility is concentrated on negative returns. The full signal is lagged one session to prevent look-ahead bias."
  },
  "dependencies": ["close", "daily_returns"],
  "parameters": {"residual_lookback": 60, "downside_lookback": 60, "minimum_downside_observations": 30, "clip_lower": 0.25, "clip_upper": 2.5, "lag": 1},
