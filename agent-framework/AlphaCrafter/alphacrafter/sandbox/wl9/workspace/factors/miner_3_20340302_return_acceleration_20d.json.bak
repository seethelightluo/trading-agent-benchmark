{
  "factor_id": "miner_3_20340302_return_acceleration_20d",
  "factor_name": "Volatility-managed return acceleration",
  "version": "1.0",
  "calculation": {
    "expression": "clip((return_20d - return_60d/3)/(annualized_volatility_20d + 0.04), -5, 5), shifted by 1 session",
    "description": "Measures whether the recent 20-session return is accelerating relative to the medium-term 60-session pace, scaled by recent volatility. The one-session lag prevents look-ahead; positive values indicate strengthening relative performance and negative values indicate deceleration."
  },
  "dependencies": ["close"],
  "parameters": {"short_window": 20, "medium_window": 60, "pace_divisor": 3, "vol_window": 20, "vol_floor": 0.04, "clip": [-5, 5], "lag_sessions": 1, "forward_horizon": 20},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2034-03-01",
    "validation_timestamp": "2034-03-02T00:00:00Z",
    "metrics": {
      "ic": 0.040733,
      "icir": 0.130207,
      "hit_ratio": 0.5442,
      "valid_dates": 4296,
      "average_instruments": 15.0,
      "coverage": 0.985793,
      "turnover": 0.087928,
      "max_abs_library_correlation": null
    },
    "decay": {"10d_ic": 0.026084, "20d_ic": 0.040733, "40d_ic": 0.029090, "60d_ic": 0.000821},
    "regime_notes": "Passed aggregate benchmark gates, but predictive power was negative in 2027-2034, including IC -0.101997 in 2033-2034. Use conservatively and revalidate promptly; small 15-asset cross-section makes uncertainty material."
  },
  "signal_artifact": "scripts/miner_3_20340302_return_acceleration_signal.csv",
