  "factor_name": "Downside-risk-adjusted medium-term momentum",
  "version": "1.0",
  "calculation": {
    "expression": "((close_t / close_{t-60}) - 1) / (sqrt(mean(min(daily_return,0)^2,60)) + 0.005), shifted by 1 trading day",
    "description": "Ranks assets by their trailing 60-day return scaled by downside-only realized deviation. The one-day lag prevents look-ahead; lower downside-adjusted momentum historically forecasts higher subsequent returns in this cross-asset benchmark, so portfolio use should apply inverse direction."
  },
  "dependencies": ["close"],
  "parameters": {"lookback_days": 60, "downside_window_days": 60, "downside_min_periods": 40, "stabilizer": 0.005, "signal_lag_days": 1, "clip": [-10, 10], "admission_horizon_days": 10},
