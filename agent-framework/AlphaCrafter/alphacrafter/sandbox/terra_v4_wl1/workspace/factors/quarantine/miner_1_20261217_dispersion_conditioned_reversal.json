{
  "factor_id": "miner_1_20261217_dispersion_conditioned_reversal",
  "factor_name": "Cross-Asset Dispersion-Conditioned 3-Day Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-rolling_sum(asset_return,3) * clip(1 + 0.35 * zscore(cross_sectional_daily_return_dispersion,60,lagged),0.65,1.35)",
    "description": "Fades each instrument's completed 3-day return, increasing or decreasing reversal amplitude according to the prior 60-session cross-asset return-dispersion regime. The dispersion mean and standard deviation are lagged one session to avoid look-ahead."
  },
  "dependencies": ["close"],
  "parameters": {"reversal_window": 3, "dispersion_window": 60, "min_dispersion_history": 30, "amplitude_floor": 0.65, "amplitude_cap": 1.35, "amplitude_slope": 0.35, "min_cross_section": 8},
  "signal_artifact": "scripts/miner_3_20261217_dispersion_reversal_signal.csv",
