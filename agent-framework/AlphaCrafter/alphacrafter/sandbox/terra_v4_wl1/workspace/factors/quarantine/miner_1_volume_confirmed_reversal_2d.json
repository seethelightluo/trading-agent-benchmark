{
  "factor_id": "miner_1_volume_confirmed_reversal_2d",
  "factor_name": "Volume-Confirmed Two-Day Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "cross_sectional_median(-rolling_sum(pct_change(close),2) * (2 - clip(volume / rolling_median(volume,30),0,2)))",
    "description": "Fades the lagged two-day return, with larger signal when volume is below its trailing 30-day median and suppression when unusually high volume confirms the move; cross-sectional median is removed. All inputs are lagged or available at decision close."
  },
  "dependencies": ["close", "volume"],
  "parameters": {"return_window": 2, "volume_baseline_window": 30, "volume_baseline_min_periods": 20, "volume_clip_low": 0, "volume_clip_high": 2},
