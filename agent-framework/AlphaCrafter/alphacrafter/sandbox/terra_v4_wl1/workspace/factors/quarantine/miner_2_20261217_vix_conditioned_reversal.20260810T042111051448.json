{
  "factor_id": "vix_conditioned_intraday_reversal",
  "factor_name": "VIX-regime-conditioned five-day reversal",
  "version": "1.0",
  "calculation": {
    "expression": "if clip(VIX_5d_return,-0.5,0.5)>0: -price_return_5d*(1+clip(VIX_5d_return,-0.5,0.5)); otherwise: -0.5*price_return_5d",
    "description": "A five-session cross-asset reversal signal that increases reversal exposure when the observation-only VIX has risen over five sessions and halves it when VIX is flat or falling. VIX is used only as a macro conditioning signal; no order is submitted for VIX. All inputs are lagged completed-session data."
  },
  "dependencies": ["close", "VIX.close"],
  "parameters": {"return_window": 5, "vix_window": 5, "vix_clip_lower": -0.5, "vix_clip_upper": 0.5, "calculation_lag": "previous_completed_session"},
