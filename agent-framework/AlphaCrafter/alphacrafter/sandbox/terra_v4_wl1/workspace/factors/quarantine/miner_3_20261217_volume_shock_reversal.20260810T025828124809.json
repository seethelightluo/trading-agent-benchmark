{
  "factor_id": "miner_3_20261217_volume_shock_reversal",
  "factor_name": "Volume-Shock-Weighted Three-Day Reversal",
  "version": "2026-12-17",
  "calculation": {
    "expression": "-(close[t-1] / close[t-4] - 1) * log(1 + clip(volume[t-1] / rolling_mean(volume,20)[t-1], lower=0))",
    "description": "Fades the preceding three-session return, with magnitude scaled by the prior session's 20-session volume shock. Signal uses only completed bars through t-1; higher positive values indicate stronger expected next-period reversal."
  },
  "dependencies": ["close", "volume"],
  "parameters": {
    "lookback_return_sessions": 3,
    "volume_mean_sessions": 20,
    "volume_min_periods": 15,
    "volume_shock_transform": "log1p",
    "cross_section_min_instruments": 8
  },
