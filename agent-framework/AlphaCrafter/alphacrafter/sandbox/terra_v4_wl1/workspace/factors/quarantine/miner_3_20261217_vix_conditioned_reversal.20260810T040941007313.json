{
  "factor_id": "miner_3_20261217_vix_conditioned_reversal",
  "factor_name": "VIX-Conditioned Five-Day Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "if clip( VIX_return_5d, -0.5, 0.5 ) > 0: -asset_return_5d * (1 + clip(VIX_return_5d,-0.5,0.5)); else: -asset_return_5d * 0.5",
    "description": "Fade each tradable asset's five-session return, increasing reversal strength when the observation-only VIX has risen over the prior five sessions and attenuating it otherwise. VIX is used only as a macro conditioning signal; it is never traded. All inputs are lagged completed-session data at decision time."
  },
  "dependencies": ["close", "VIX close"],
  "parameters": {"asset_return_lookback": 5, "vix_return_lookback": 5, "vix_clip": [-0.5, 0.5], "positive_vix_multiplier": "1 + clipped_vix_return", "negative_vix_multiplier": 0.5},
