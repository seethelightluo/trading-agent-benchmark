  "factor_name": "Five-day volatility-scaled cross-asset residual reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(return_5d_i - median_j(return_5d_j)) / rolling_std(return_1d_i, 20)",
    "description": "Ranks assets higher when their lagged five-session return underperformed the cross-sectional median, scaled by each asset's trailing 20-session daily-return volatility. The median is computed cross-sectionally on the decision date using only completed historical closes. Dates with fewer than 8 valid assets are excluded."
  },
