{
  "factor_id": "miner_1_20310724_volatility_scaled_momentum_10d",
  "factor_name": "20-day volatility-scaled momentum",
  "version": "1.0",
  "calculation": {
    "expression": "pct_change(close,20) / (std(log_return,20) * sqrt(252) + 1e-12)",
    "description": "Cross-sectional momentum over the completed prior 20 sessions, divided by trailing realized volatility. At date t all inputs are lagged through t-1; intended horizon is 10 trading days. Higher values indicate stronger risk-adjusted momentum."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "lookback_days": 20,
    "volatility_window": 20,
    "forward_horizon_days": 10,
    "annualization": 252,
    "minimum_cross_section": 8
  },
