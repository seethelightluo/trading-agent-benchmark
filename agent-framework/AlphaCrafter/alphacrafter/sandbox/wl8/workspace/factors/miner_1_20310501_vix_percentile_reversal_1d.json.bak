{
  "factor_id": "miner_1_20310501_vix_percentile_reversal_1d",
  "factor_name": "Continuous VIX-percentile volatility-scaled short-term reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-five_day_return / (rolling_std_daily_return_20d * sqrt(5)) * (0.75 + 0.75 * lagged_120d_VIX_percentile)",
    "description": "Ranks assets for one-day forward returns using a volatility-scaled five-day reversal, continuously strengthened as lagged VIX percentile rises. The VIX percentile is lagged one session and clipped to [0.05, 0.95] to avoid look-ahead and unstable extremes."
  },
  "dependencies": ["close", "VIX close"],
  "parameters": {"reversal_window_days": 5, "volatility_window_days": 20, "vix_percentile_window_days": 120, "vix_percentile_lag_days": 1, "multiplier_floor": 0.75, "multiplier_span": 0.75, "clip_lower": 0.05, "clip_upper": 0.95, "forward_horizon_days": 1},
  "validation": {
