  "factor_name": "Dispersion-conditioned downside-volatility-scaled 40-day reversal",
  "version": "1.0",
  "calculation": {
    "expression": "gate(cross_sectional_rank(-sum(log_return,40)/std(negative_log_return,60)), cross_sectional_dispersion > rolling_median(dispersion,60)); smooth(rank_signal,3)",
    "description": "Ranks a 40-session reversal scaled by 60-session downside volatility, applies it only when cross-asset return dispersion exceeds its trailing 60-session median, then smooths the centered rank signal over three sessions. All inputs are lag-safe at decision time."
