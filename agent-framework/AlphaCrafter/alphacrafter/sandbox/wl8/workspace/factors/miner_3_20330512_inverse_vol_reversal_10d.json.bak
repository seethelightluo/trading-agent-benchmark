{
  "factor_id": "miner_3_20330512_inverse_vol_reversal_10d",
  "factor_name": "Inverse-volatility-scaled 10-day reversal with 5-day smoothing",
  "version": "1.0",
  "calculation": {
    "expression": "rank_cs(rolling_mean_5(clip_cs((-log(close/close[-10]))/realized_vol_20,10%,90%)))-0.5",
    "description": "Compute 10-session reversal, scale each asset by trailing 20-session realized volatility, winsorize cross-sectionally at the 10th and 90th percentiles, convert to cross-sectional percentile ranks, center at zero, and smooth over five sessions. Positive values indicate stronger expected forward returns. All inputs are lag-safe."
  },
  "dependencies": ["close"],
  "parameters": {
    "reversal_lookback_sessions": 10,
    "realized_vol_window_sessions": 20,
    "winsorization_quantiles": [0.10, 0.90],
    "smoothing_window_sessions": 5,
    "forward_horizon_sessions": 10,
    "minimum_cross_section": 8
  },
  "validation": {
