  "factor_id": "miner_1_20300808_dispersion_gated_reversal_5d",
  "factor_name": "Dispersion-gated volatility-normalized five-day reversal",
  "version": "2030-08-08",
  "calculation": {
    "expression": "-(close/lag(close,5)-1) / rolling_std(pct_change(close),20) * clip(cross_asset_dispersion_20 / rolling_median(cross_asset_dispersion_20,120),0.5,2.0)",
    "description": "Ranks assets for five-day reversal, scaling by recent asset volatility and strengthening the signal when cross-asset daily-return dispersion is elevated relative to its trailing 120-day median. All inputs are available at the decision date."
