  "factor_name": "Volatility-Normalized 10-Day Shock Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-pct_change(close,10) / rolling_std(pct_change(close,1),20)",
    "description": "Ranks assets higher when their trailing 10-session return is negative, scaled by trailing 20-session daily volatility. Designed as a slower, lower-turnover complement to the 5-day shock reversal factor."
