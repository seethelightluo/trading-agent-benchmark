{
  "factor_id": "miner_1_20310403_volcompression_momentum_10d",
  "factor_name": "Volatility-Compression Momentum (Contrarian Direction)",
  "version": "1.0",
  "calculation": {
    "expression": "sign_direction * return(close,10) * min(1, realized_vol_5d / realized_vol_60d) when vol_ratio < 1; sign_direction * return(close,10) otherwise, with sign_direction=-1",
    "description": "Ten-day cross-asset momentum is inverted for portfolio use because the validated relationship is reversal; during volatility compression the signal magnitude is scaled by the short/long realized-volatility ratio. All inputs end at the prior completed session."
  },
  "dependencies": ["close"],
  "parameters": {"momentum_window_days": 10, "short_vol_days": 5, "long_vol_days": 60, "direction": -1, "forward_horizon_days": 10},
