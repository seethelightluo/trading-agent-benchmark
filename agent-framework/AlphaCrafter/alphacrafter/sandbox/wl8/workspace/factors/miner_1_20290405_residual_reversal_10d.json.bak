{
  "factor_id": "miner_1_20290405_residual_reversal_10d",
  "factor_name": "Market-Residual Volatility-Scaled Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "clip(-(rolling_sum(asset_return - cross_sectional_mean_return, 10) / lagged_20d_std(asset_return - cross_sectional_mean_return)), -8, 8)",
    "description": "Subtract the daily cross-asset mean return to isolate relative residual performance, sum the residual over 10 sessions, lag the result one completed session, and take the inverse scaled by lagged 20-session residual volatility. Higher values indicate stronger relative losers expected to mean-revert."
  },
  "dependencies": ["close"],
  "parameters": {"lookback_return": 10, "volatility_window": 20, "volatility_min_periods": 12, "lag_sessions": 1, "clip": [-8, 8], "forward_horizon": 10},
