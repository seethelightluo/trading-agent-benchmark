{
  "factor_id": "miner_3_20300808_cross_sectional_reversal_10d_volnorm",
  "factor_name": "Volatility-Normalized Cross-Sectional 10-Day Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-pct_change(close,10) / (rolling_std(pct_change(close,1),20,min_periods=15) * sqrt(10))",
    "description": "For each tradable asset, rank the negative trailing 10-trading-day return, scaled by its trailing 20-day daily volatility. Higher values indicate stronger recent underperformance after risk normalization and a stronger expected reversal signal. Forward returns are evaluated over the next 10 trading days."
  },
  "dependencies": ["close"],
  "parameters": {"lookback_return_days": 10, "volatility_window_days": 20, "volatility_min_periods": 15, "forward_horizon_days": 10, "universe_size": 15},
