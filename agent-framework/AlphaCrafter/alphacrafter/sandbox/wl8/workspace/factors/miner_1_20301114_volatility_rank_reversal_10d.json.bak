  "factor_name": "Volatility-rank weighted 10-day reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-return(close,10) * (0.5 + cross_sectional_rank(realized_volatility(return,20)))",
    "description": "Reverse the trailing 10-trading-day return, with larger magnitude for instruments in the higher recent 20-day volatility ranks. The cross-sectional volatility rank is calculated using information available at the signal date."
