{
  "factor_id": "miner_3_20310403_vix_conditioned_trend_20d",
  "factor_name": "VIX-Conditioned Trend/Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "demean_cs(momentum_20d * (1 - 2*clip((VIX/VIX_median_252 - 1 - 0.15)/0.35, -1, 1)))",
    "description": "Use 20-day price momentum in calm regimes and smoothly invert it toward short-term reversal as VIX rises materially above its trailing 252-day median. Cross-sectionally demean the result. VIX is observation-only and is never tradable."
  },
  "dependencies": ["close", "VIX close"],
  "parameters": {"momentum_window": 20, "vix_median_window": 252, "stress_center": 0.15, "stress_transition_width": 0.35, "forward_horizon_days": 10},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-05-06/2031-03-19",
    "validation_timestamp": "2031-04-03T00:00:00Z",
    "metrics": {
