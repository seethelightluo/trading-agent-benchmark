      "decay_ic_5d": 0.013465,
      "decay_ic_10d": 0.032687,
      "decay_ic_20d": 0.032488,
      "max_abs_library_correlation": null
    },
    "regime_notes": "Passed full-history benchmark gates (absolute IC >= 0.0070 and absolute ICIR >= 0.0840) across all 15 tradable assets. Predictive power is regime-dependent and negative in 2030 and the latest 180/360 observations; use only with ensemble/regime monitoring.",
    "signal_artifact": "scripts/miner_3_20310403_vix_conditioned_trend_signal.csv",
