  "factor_name": "Volatility-scaled 10-day reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(close/close.shift(10)-1) / (rolling_std(daily_returns,20)*sqrt(10)).clip(lower=0.005)",
    "description": "Ranks assets favoring recent 10-day losers, scaled by trailing 20-day realized volatility; all inputs are lagged through the decision date. Higher values indicate stronger reversal signal."
