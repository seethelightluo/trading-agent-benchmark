  "factor_name": "Three-day smoothed volatility-normalized short-term reversal",
  "version": "1.0",
  "calculation": {
    "expression": "rolling_mean_3(-(close/close.shift(5)-1)/rolling_std(pct_change(close),20), min_periods=2)",
