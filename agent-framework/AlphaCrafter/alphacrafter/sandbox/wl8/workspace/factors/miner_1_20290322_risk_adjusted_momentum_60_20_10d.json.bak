{
  "factor_id": "miner_1_20290322_risk_adjusted_momentum_60_20_10d",
  "factor_name": "Risk-adjusted 60-session momentum (contrarian direction)",
  "version": "2029-03-22",
  "calculation": {
    "expression": "clip(((close / close.shift(60)) - 1).shift(1) / (rolling_std(pct_change(close),20).shift(1) * sqrt(20)), -10, 10)",
    "description": "Uses information available through the prior completed session: 60-session price return divided by lagged 20-session realized volatility. Empirical forward-return association is negative in this cross-asset benchmark, so portfolio consumers should use the inverse direction (lower raw momentum receives higher score)."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "lookback_return": 60,
    "volatility_window": 20,
    "volatility_annualization": "sqrt(20)",
    "clip": [
      -10,
      10
    ],
    "forward_horizon": 10,
    "direction": -1,
    "min_cross_section": 8
  },
