  "factor_name": "Range Efficiency Momentum 40d",
  "version": "2035-12-20",
  "calculation": {
    "expression": "(close / rolling_min(close,40) - 1) / (rolling_max(close,40) / rolling_min(close,40) - 1), lagged 1 session",
    "description": "Ranks assets by the location of the current close within its trailing 40-session high-low range. Higher values indicate persistent upward positioning and lower values indicate weak positioning. The signal is lagged one session and evaluated for 10-session forward returns."
  },
