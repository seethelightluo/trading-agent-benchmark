{
  "factor_id": "miner_3_20320624_efficiency_weighted_momentum_10d",
  "factor_name": "Path-Efficiency Weighted Intermediate Momentum",
  "version": "2.0",
  "calculation": {
    "expression": "rolling_mean((pct_change(close,20,lag=1) / (rolling_sum(abs(pct_change(close,1,lag=1)),20)+1e-12)) * (pct_change(close,20,lag=1) / (rolling_sum(abs(pct_change(close,1,lag=1)),20)+1e-12),3)",
    "description": "Ranks assets using lagged 20-session directional return weighted by its path efficiency, where efficiency is directional return divided by the sum of absolute daily returns over the same lagged window. A three-session lagged smoothing reduces one-day ranking noise. All inputs use completed observations only.",
    "forward_horizon": "10 trading days",
    "signal_artifact": "scripts/miner_3_20320610_efficiency_momentum_signal.csv",
    "ic_artifact": "scripts/miner_3_20320610_efficiency_momentum_ic.csv"
  },
