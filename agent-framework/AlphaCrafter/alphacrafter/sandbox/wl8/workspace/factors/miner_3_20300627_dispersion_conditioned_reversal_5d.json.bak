{
  "factor_id": "miner_3_20300627_dispersion_conditioned_reversal_5d",
  "factor_name": "Dispersion-conditioned five-day reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-pct_change(close,5) * clip(cross_sectional_mean(rolling_std(pct_change(close),20)) / rolling_median_120(cross_sectional_mean(rolling_std(pct_change(close),20))), 0.5, 2.0)",
    "description": "Ranks recent five-day reversal more strongly when aggregate cross-asset realized volatility dispersion is elevated, using only information available at the signal date. The negative five-day return is the base reversal signal and the smooth dispersion multiplier is common across assets on each date."
  },
  "dependencies": ["close"],
  "parameters": {
    "reversal_lookback_days": 5,
    "dispersion_volatility_window_days": 20,
    "dispersion_baseline_window_days": 120,
    "multiplier_clip": [0.5, 2.0],
    "forward_horizon_days": 10,
    "minimum_cross_section": 8
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-03-16 through 2030-06-13",
    "last_validated": "2030-06-27T00:00:00",
    "metrics": {
      "ic": 0.0314982671,
      "icir": 0.0964856215,
      "forward_horizon_days": 10,
      "dates": 1660,
      "average_instruments": 14.5187,
      "coverage": 0.967912,
      "turnover": 0.151934,
      "hit_rate": 0.522892,
      "max_abs_library_correlation": null
    },
    "regime_notes": "Full-history daily cross-sectional Spearman IC across the 15 tradable benchmark instruments. The admission gates absolute IC >= 0.0070 and absolute ICIR >= 0.0840 are both passed. Recent 180-day IC/ICIR was 0.02370/0.07942, recent 360-day 0.01076/0.03442, 2029 0.00017/0.00053, and 2030 YTD 0.03418/0.11176; recent regime performance is positive but uncertain in the small cross-section.",
    "artifacts": {
      "signal_file": "scripts/miner_3_20300627_dispersion_switch_10d_signal.csv",
      "ic_file": "scripts/miner_3_20300627_dispersion_switch_10d_ic.csv",
      "signal_semantics": "Rows are signal dates; columns are the 15 tradable instruments; values are point-in-time factor signals."
    }
