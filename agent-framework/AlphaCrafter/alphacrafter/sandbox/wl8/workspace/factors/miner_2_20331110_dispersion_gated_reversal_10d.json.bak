{
  "factor_id": "miner_2_20331110_dispersion_gated_reversal_10d",
  "factor_name": "Cross-asset dispersion-scaled medium-term reversal",
  "version": "1.0",
  "calculation": {
    "expression": "(-log(close_t / close_{t-10})) * rolling_mean_5(rolling_std_5(log_returns).cross_sectional_mean), smoothed by rolling_mean_3",
    "description": "Invert each asset's lagged 10-session log return and scale it by the lag-safe five-session cross-asset return dispersion, then smooth over three sessions. Higher values indicate stronger reversal opportunity when benchmark-wide dispersion is elevated. Signal uses data through the previous completed session only."
  },
  "dependencies": ["close"],
  "parameters": {
    "lookback_return_days": 10,
    "dispersion_vol_window": 5,
    "dispersion_smoothing_window": 5,
    "signal_smoothing_window": 3,
    "forward_horizon_days": 10,
    "min_cross_section": 8,
    "tradable_universe_size": 15
  },
