{
  "factor_id": "slow_stress_reversal_20d",
  "factor_name": "Slow VIX-intensity conditioned 20-day reversal (revalidated)",
  "version": "20321028",
  "calculation": {
    "expression": "rolling_mean_3(-sum(pct_change(close,1),20).shift(1) * (VIX_percentile_120d.shift(1)-0.5))",
    "description": "Contrarian 20-session return signal, scaled by the lagged distance of VIX from its 120-session percentile midpoint and smoothed over three sessions. All inputs are lagged to prevent look-ahead. Higher values indicate stronger expected forward return."
  },
  "dependencies": ["close", "VIX.close"],
  "parameters": {"return_window": 20, "vix_percentile_window": 120, "vix_min_periods": 60, "smoothing_window": 3, "forward_horizon_days": 10},
