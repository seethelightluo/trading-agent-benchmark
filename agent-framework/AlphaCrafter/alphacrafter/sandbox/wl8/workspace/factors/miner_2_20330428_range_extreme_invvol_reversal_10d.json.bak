{
  "factor_id": "miner_2_20330428_range_extreme_invvol_reversal_10d",
  "factor_name": "Range-Extreme Inverse-Volatility Reversal 10D",
  "version": "1.0",
  "calculation": {
    "expression": "rank((-return_10d / rolling_std(return_1d,20)) * (1 + 0.8 * 2 * abs((close - rolling_min(close,60))/(rolling_max(close,60)-rolling_min(close,60)) - 0.5)) )",
    "description": "Inverse-volatility normalized 10-day reversal, amplified when an asset is near either extreme of its trailing 60-day price range. Cross-sectional percentile rank is the tradable signal. All inputs are lag-safe at decision time."
  },
  "dependencies": ["close"],
  "parameters": {"reversal_lookback_days": 10, "volatility_window_days": 20, "range_window_days": 60, "extreme_amplifier": 0.8, "forward_horizon_days": 10, "minimum_cross_section": 8},
