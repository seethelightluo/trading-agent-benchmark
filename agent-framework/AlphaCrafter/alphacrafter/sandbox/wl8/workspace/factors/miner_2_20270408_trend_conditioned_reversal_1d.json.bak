{
  "factor_id": "miner_2_20270408_trend_conditioned_reversal_1d",
  "factor_name": "Trend-Conditioned Intraday Reversal 1D",
  "version": "1.1",
  "calculation": {
    "expression": "-asset_daily_return when sign(asset_5d_return)=sign(asset_20d_return), else 0; cross-sectional rank used for portfolio scoring",
    "description": "Reverses the completed session return only when the asset's short- and medium-term trends agree, suppressing reversal signals during trend-conflict states. The signal uses prices through the prior completed session and is evaluated against the next observation return."
  },
  "dependencies": [
    "close"
  ],
