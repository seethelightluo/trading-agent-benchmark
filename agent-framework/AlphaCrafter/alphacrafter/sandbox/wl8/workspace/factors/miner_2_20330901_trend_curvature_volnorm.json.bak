{
  "factor_id": "miner_2_20330901_trend_curvature_volnorm",
  "factor_name": "Volatility-normalized trend curvature",
  "version": "1.0",
  "calculation": {
    "expression": "((close[t-1]/close[t-21]-1) - (close[t-1]/close[t-61]-1)/3) / vol30[t-1], cross-sectionally median-centered and smoothed over 5 sessions",
    "description": "Measures whether the recent 20-session trend is stronger or weaker than one-third of the preceding 60-session trend, scaled by lagged 30-session annualized volatility. Positive values indicate recent trend acceleration relative to the slower trend; all inputs are lagged and the signal is smoothed cross-sectionally."
  },
  "dependencies": ["close"],
  "parameters": {
    "short_return_days": 20,
    "long_return_days": 60,
    "long_return_scale": 3,
    "volatility_window": 30,
    "smoothing_days": 5,
    "forward_horizon_days": 10,
    "minimum_cross_section": 8
  },
  "validation": {
