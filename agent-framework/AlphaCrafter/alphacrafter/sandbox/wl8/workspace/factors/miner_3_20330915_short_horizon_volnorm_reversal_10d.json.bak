  "version": "1.0",
  "calculation": {
    "expression": "rolling_mean_3(-(log(close/close.shift(5)) / (rolling_std(log_returns,20)*sqrt(20))))",
    "description": "Contrarian five-session return shock, normalized by trailing 20-session annualized volatility and smoothed over three sessions. Higher values indicate stronger recent underperformance and expected ten-session rebound. All inputs are lag-safe at the decision date."
