{
  "factor_id": "miner_2_20350510_peer_relative_reversal_5d10d",
  "factor_name": "Peer-relative volatility-normalized 5-day reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(log(close_t-1/close_t-6) - cross_sectional_median_i[log(close_t-1/close_t-6)]) / (sqrt(20) * std_20(log(close/close_prev))_t-1)",
    "description": "For each tradable asset, negate its lagged five-session log return relative to the same-day cross-sectional median, then divide by lagged 20-session annualized realized volatility. Higher values indicate relatively weaker recent performers expected to mean-revert over the next 10 sessions.",
    "signal_artifact": "scripts/miner_2_20350510_relative_reversal.py",
    "forward_target": "log(close_{t+10}/close_t)",
    "alignment": "All inputs are lagged through the previous completed session; forward return begins after signal date."
  },
  "dependencies": ["close"],
  "parameters": {"relative_return_lookback_sessions": 5, "realized_volatility_window_sessions": 20, "forward_horizon_sessions": 10, "minimum_cross_section": 8, "volatility_annualization": "sqrt(20)"},
