{
  "factor_id": "miner_1_20340831_vix_conditioned_residual_reversal_10d",
  "factor_name": "VIX-conditioned residual short-horizon reversal",
  "version": "1.1",
  "calculation": {
    "expression": "rank_cs(rolling_mean_3((-residual_return_5d_lag1) / residual_volatility_20d_lag1) * clip(VIX_lag1 / rolling_median(VIX_lag1,252),0.6,1.8)) demean_cs",
    "description": "For each tradable benchmark, invert the lagged five-session return relative to the cross-sectional daily mean, scale by lagged 20-session residual volatility, multiply by a lagged VIX stress ratio, smooth for three sessions, then cross-sectionally percentile-rank and demean. All inputs are lagged and the forecast horizon is ten trading days."
  },
  "dependencies": ["close", "VIX observation-only macro signal"],
  "parameters": {"reversal_window": 5, "volatility_window": 20, "volatility_min_periods": 15, "vix_median_window": 252, "vix_median_min_periods": 60, "stress_clip": [0.6, 1.8], "smoothing_window": 3, "forecast_horizon_days": 10, "min_cross_section": 8},
