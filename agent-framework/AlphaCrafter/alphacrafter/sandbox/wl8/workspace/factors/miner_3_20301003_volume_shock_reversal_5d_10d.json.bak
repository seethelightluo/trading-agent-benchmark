{
  "factor_id": "miner_3_20301003_volume_shock_reversal_5d_10d",
  "factor_name": "Volume-shock weighted short-term reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-pct_change(close,5) * (1 + 0.35 * clip(log(mean(volume,3)/mean(volume,30)),-3,3))",
    "description": "Ranks assets for 10-day forward returns by reversing their recent 5-day return, with the reversal magnitude increased when short-term volume is elevated relative to its 30-day baseline. Uses only information available at the signal date."
  },
  "dependencies": ["close", "volume"],
  "parameters": {"return_window_days": 5, "volume_fast_window_days": 3, "volume_slow_window_days": 30, "volume_weight": 0.35, "volume_shock_clip": [-3, 3], "forward_horizon_days": 10},
  "validation": {
    "status": "EFFECTIVE",
    "period": {"start": "2026-08-21", "end": "2030-09-18"},
    "metrics": {
      "daily_paper_ic": 0.03775194288241613,
      "daily_paper_icir": 0.09722339505777874,
      "ic_hit_ratio": 0.5488721804511278,
      "dates": 1064,
      "average_instruments": 9.0,
      "factor_coverage": 0.6,
      "rank_turnover": 0.150122527562,
      "max_abs_library_correlation": null
    },
    "decay": {"forward_horizon_days": 10, "same_horizon_used_for_gate": true},
    "regime_notes": "Full validation passes the benchmark gates, but the 2029 and 2030 subperiod ICs are weak while the recent 180-observation IC is positive; interpret the edge conservatively and monitor drift."
  },
  "provenance": {
