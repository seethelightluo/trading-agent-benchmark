{
  "factor_id": "miner_1_20280810_volscaled_reversal_rank_blend_5_15d",
  "factor_name": "Volatility-Scaled Reversal Rank Blend (5d/15d)",
  "version": "1.0",
  "calculation": {
    "expression": "mean(rank_pct(-(sum(pct_change(close),5).shift(1))/rolling_std(pct_change(close),20).shift(1)), rank_pct(-(sum(pct_change(close),15).shift(1))/rolling_std(pct_change(close),20).shift(1)))",
    "description": "Cross-sectionally averages percentile ranks of lagged five-session and fifteen-session reversal signals, each normalized by lagged 20-session realized volatility. Uses only completed-session data and is defined on the 15 tradable benchmark assets."
  },
  "dependencies": ["close"],
  "parameters": {
    "short_return_window": 5,
    "long_return_window": 15,
    "volatility_window": 20,
    "signal_lag_sessions": 1,
    "cross_sectional_rank": "percentile",
    "universe_size": 15
  },
  "validation": {
