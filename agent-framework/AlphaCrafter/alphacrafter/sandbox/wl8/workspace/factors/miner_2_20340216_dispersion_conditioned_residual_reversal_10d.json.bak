{
  "factor_id": "dispersion_conditioned_residual_reversal_10d",
  "factor_name": "Cross-Asset Dispersion-Conditioned Residual Reversal",
  "version": "20340216",
  "calculation": {
    "expression": "rolling_mean_3((-residual_return_sum_10d) * clip(cross_asset_mean_20d_return_volatility / rolling_median_252d_of_that_volatility, 0.5, 2.0))",
    "description": "Compute each asset's log return residual after subtracting the daily cross-sectional mean, reverse its lagged 10-session cumulative residual return, and scale the reversal by lagged cross-asset dispersion. The dispersion gate emphasizes reversal when the universe is unusually heterogeneous. All rolling inputs are lagged one completed session; the final signal is a three-session mean.",
    "forward_horizon": "10 trading days"
  },
  "dependencies": ["close"],
  "parameters": {
    "residual_window": 10,
    "dispersion_window": 20,
    "dispersion_baseline_window": 252,
    "smoothing_window": 3,
    "dispersion_clip": [0.5, 2.0],
    "min_cross_section": 8
  },
  "validation": {
    "period": "2020-01-01 through 2034-02-15",
    "validation_date": "2034-02-16",
