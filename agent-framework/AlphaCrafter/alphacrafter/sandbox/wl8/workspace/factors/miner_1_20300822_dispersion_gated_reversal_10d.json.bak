{
  "factor_id": "miner_1_20300822_dispersion_gated_reversal_10d",
  "factor_name": "Dispersion-gated volatility-normalized 10-day reversal",
  "version": "1.0",
  "calculation": {
    "expression": "(-return(close,10) / rolling_std(pct_change(close),20)) * clip(cross_asset_dispersion_20 / rolling_median(cross_asset_dispersion_20,120), 0.5, 2.0)",
    "description": "Ranks assets by ten-day reversal normalized by trailing 20-day volatility, with the signal scaled by elevated or subdued cross-asset dispersion. All inputs are lagged to the decision date. Higher values indicate stronger expected subsequent return."
  },
  "dependencies": ["close", "pct_change", "cross_asset_returns"],
  "parameters": {"reversal_window": 10, "volatility_window": 20, "dispersion_window": 20, "dispersion_baseline_window": 120, "gate_lower": 0.5, "gate_upper": 2.0, "forward_horizon": 10, "minimum_cross_section": 8},
