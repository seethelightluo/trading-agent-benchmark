  "factor_name": "Volatility-Normalized 5-Day Shock Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-pct_change(close, 5) / rolling_std(pct_change(close, 1), 20)",
    "description": "Ranks assets with recent five-day losses higher, scaling the reversal signal by trailing 20-day daily volatility to improve comparability across asset classes."
  },
