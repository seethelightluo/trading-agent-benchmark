{
  "factor_id": "miner_3_20300110_inverse_breakout_120d",
  "factor_name": "Volatility-Scaled Distance Below 120-Day High",
  "version": "1.0",
  "calculation": {
    "expression": "-(close[t-1] / rolling_max(close,120,min_periods=80)[t-1] - 1) / std(pct_change(close),20,min_periods=15)[t-1]",
    "description": "Ranks assets by their lagged distance below the 120-trading-day high, normalized by lagged 20-day realized volatility. Larger values identify deeper volatility-adjusted drawdowns and are tested against forward 10-trading-day returns. The signal uses only completed data through t-1."
  },
  "dependencies": ["close", "pct_change"],
  "parameters": {
    "high_window_days": 120,
    "high_min_periods": 80,
    "volatility_window_days": 20,
    "volatility_min_periods": 15,
    "forward_horizon_days": 10,
    "minimum_cross_section": 8
  },
  "signal_artifact": "scripts/miner_3_20300110_inverse_breakout_signal.csv",
