{
  "factor_id": "miner_3_20300711_volnorm_dispersion_reversal_5d",
  "factor_name": "Volatility-normalized dispersion-conditioned five-day reversal",
  "version": "1.0",
  "calculation": {
    "expression": "(-pct_change(close,5) / rolling_std(pct_change(close,1),20)) * clip(cross_asset_mean_20d_vol / rolling_median(cross_asset_mean_20d_vol,120), 0.5, 2.0)",
    "description": "Ranks instruments for reversal after scaling their five-day negative return by instrument volatility, with signal strength conditioned on the aggregate 20-day cross-asset volatility dispersion regime. All inputs are lagged through the decision date; forward returns are used only for validation."
  },
  "dependencies": ["close"],
  "parameters": {
    "reversal_lookback_days": 5,
    "instrument_volatility_window": 20,
    "cross_asset_volatility_window": 20,
    "dispersion_baseline_window": 120,
    "dispersion_baseline_min_periods": 60,
    "multiplier_clip": [0.5, 2.0],
    "forward_horizon_days": 10,
    "minimum_cross_section": 8
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2026-07-28 through 2030-06-27",
