{
  "factor_id": "miner_2_20320916_slow_stress_reversal_20d",
  "factor_name": "Slow VIX-Intensity Conditioned Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "rolling_mean_3(-rolling_sum_20(pct_change(close).shift(1)) * (percentile_rank_120(VIX.shift(1)) - 0.5))",
    "description": "Contrarian 20-session asset return, lagged one session and scaled continuously by the lagged 120-session VIX percentile distance from neutral; three-session smoothed. Higher values indicate stronger expected forward return."
  },
  "dependencies": ["close", "VIX"],
  "parameters": {"return_window": 20, "vix_window": 120, "vix_min_periods": 60, "smoothing_window": 3, "forward_horizon": 10, "lag": 1},
