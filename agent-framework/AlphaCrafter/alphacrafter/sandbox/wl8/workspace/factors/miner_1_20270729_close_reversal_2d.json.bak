{
  "factor_id": "miner_1_close_reversal_2d",
  "factor_name": "Two-day cross-asset close reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(close_t / close_{t-2} - 1)",
    "description": "Ranks assets higher when their completed two-session return is more negative; the signal is evaluated against the next completed-session return and uses no future data."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "lookback_sessions": 2,
    "forward_horizon_sessions": 1,
    "minimum_cross_section": 8
