{
  "factor_id": "miner_2_20290628_volshock_residual_reversal_3d",
  "factor_name": "Volatility-shock-weighted residual 3-day reversal",
  "version": "1.0",
  "calculation": {
    "expression": "cross_sectional_median_demean((-sum(pct_change(close),3).shift(1)) * clip((rolling_std(pct_change(close),20).shift(1) / rolling_median(rolling_std(pct_change(close),20).shift(1),120)), 0.5, 3.0))",
    "description": "Ranks lagged three-day reversal more strongly when the instrument's lagged 20-day volatility is elevated relative to its own trailing 120-day median; all inputs are lagged and the result is cross-sectionally median demeaned."
  },
  "dependencies": ["close"],
  "parameters": {"reversal_window_days": 3, "volatility_window_days": 20, "volatility_baseline_days": 120, "volatility_min_periods": 15, "baseline_min_periods": 60, "shock_clip": [0.5, 3.0], "cross_sectional_center": "median"},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-02 through 2029-06-27",
