{
  "factor_id": "miner_1_stress_conditioned_volscaled_reversal_5d",
  "factor_name": "Stress-Conditioned Volatility-Scaled 5-Day Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(close/close.shift(5)-1) / rolling_std(pct_change(close),20) * (0.5 + I((cross_sectional_fraction_of_assets_with_positive_5d_return)<0.45)), then lag one completed session",
    "description": "Ranks assets for short-term mean reversion using five-session returns normalized by trailing 20-session volatility. The reversal amplitude is increased when fewer than 45% of the available tradable assets have positive five-session returns, representing broad stress. Signal uses only completed-session data."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "return_window": 5,
    "volatility_window": 20,
    "stress_breadth_threshold": 0.45,
    "base_multiplier": 0.5,
    "stress_multiplier": 1.5,
    "signal_lag_sessions": 1,
    "universe_size": 15
  },
  "validation": {
