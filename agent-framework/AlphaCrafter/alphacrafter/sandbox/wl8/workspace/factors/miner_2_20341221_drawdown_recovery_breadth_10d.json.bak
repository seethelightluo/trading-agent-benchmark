{
  "factor_id": "miner_2_20341221_drawdown_recovery_breadth_10d",
  "factor_name": "Breadth-Conditioned Drawdown Recovery",
  "version": "1.1",
  "calculation": {
    "expression": "recovery60 = close / rolling_min(close,60) - 1; factor = recovery60 / rolling_std(return,30); if lagged cross-asset positive-return breadth <= 0.50 then factor = -factor",
    "description": "Ranks assets by lagged 60-session recovery from their trailing low, volatility normalized. The signal is contrarian when broad cross-asset breadth is weak, using only completed prior-session information."
  },
  "dependencies": ["close", "daily_return", "cross_asset_breadth"],
  "parameters": {"recovery_window": 60, "volatility_window": 30, "breadth_window": 10, "breadth_threshold": 0.50, "forecast_horizon_days": 10, "minimum_cross_section": 8},
  "validation": {
