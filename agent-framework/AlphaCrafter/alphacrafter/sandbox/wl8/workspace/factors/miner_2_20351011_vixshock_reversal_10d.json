{
  "factor_id": "miner_2_20351011_vixshock_reversal_10d",
  "factor_name": "VIX-Shock Conditioned Volatility-Normalized Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "where(VIX.pct_change(5) > 0.08 and VIX > rolling_median(VIX,120), -rolling_return(close,5) / rolling_std(log_return(close),20), 0).shift(1)",
    "description": "After a completed-session VIX rise of at least 8% over five sessions while VIX is above its lagged 120-session median, rank assets by the negative five-session return scaled by 20-session realized volatility. The one-session lag prevents lookahead and the conditional activation targets cross-asset rebound after volatility shocks.",
    "forward_horizon": "10 trading days"
  },
  "dependencies": [
    "close",
    "VIX.close"
  ],
  "parameters": {
    "return_window": 5,
    "volatility_window": 20,
    "vix_change_window": 5,
    "vix_shock_threshold": 0.08,
    "vix_regime_window": 120,
    "lag": 1
  },
