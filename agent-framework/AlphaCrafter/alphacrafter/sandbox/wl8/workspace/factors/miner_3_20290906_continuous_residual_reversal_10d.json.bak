{
  "factor_id": "miner_3_20290906_continuous_residual_reversal_10d",
  "factor_name": "Continuous Volatility-Scaled Beta-Neutral Residual Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "(- residual_return_5d / annualized_volatility_20d).shift(1)",
    "description": "For each tradable asset, subtract 60-day rolling beta to the equal-weight benchmark times benchmark 5-day return from the asset 5-day return; negate and divide by lagged 20-day annualized volatility. Larger values indicate stronger normalized residual declines expected to mean-revert. All inputs are lagged one completed day."
  },
  "dependencies": ["close", "pct_change", "rolling_covariance", "rolling_volatility"],
  "parameters": {"residual_window_days": 60, "shock_window_days": 5, "volatility_window_days": 20, "forward_horizon_days": 10, "benchmark": "equal_weight_mean_return", "minimum_cross_section": 8},
  "validation": {
