{
  "factor_id": "miner_3_20330203_vix_conditioned_reversal_10d",
  "factor_name": "VIX-conditioned volatility-scaled 10-day reversal",
  "version": "1.0",
  "calculation": {
    "expression": "rank_cs((-log(close_t/close_t-10)/rolling_std(log_returns,20)) * clip(VIX_t/median(VIX,120),0.5,2.0)); demean and 2-day smooth",
    "description": "Fades each asset's prior 10-session return after volatility scaling, with signal magnitude conditioned on the observation-only VIX level relative to its trailing 120-session median. Cross-sectional ranking, demeaning, and two-session smoothing improve robustness. All inputs are lag-safe at decision time."
  },
  "dependencies": ["close", "VIX", "daily returns"],
  "parameters": {"reversal_lookback": 10, "volatility_window": 20, "vix_median_window": 120, "vix_gate_clip": [0.5, 2.0], "smoothing_sessions": 2, "forward_horizon_days": 10, "minimum_cross_section": 8},
  "validation": {
