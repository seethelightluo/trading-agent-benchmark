  "factor_name": "Volatility-scaled 10-day reversal",
  "version": "1.0",
  "calculation": {
    "expression": "rolling_mean_3(-log(close/close_lag_10) / (sqrt(20)*std(log_returns,20)), min_periods=2)",
    "description": "Fade the prior 10-trading-day move, scaling by 20-day realized volatility and smoothing the cross-asset signal over three observations. Higher values indicate stronger expected forward returns from reversal. All inputs are lag-safe at the decision date."
  },
  "dependencies": ["close"],
  "parameters": {"lookback_return_days": 10, "volatility_window_days": 20, "volatility_annualization_factor": "sqrt(20)", "smoothing_window_days": 3, "forward_validation_horizon_days": 10},
