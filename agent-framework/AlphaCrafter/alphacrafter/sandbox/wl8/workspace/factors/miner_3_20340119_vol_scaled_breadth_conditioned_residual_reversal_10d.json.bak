{
  "factor_id": "miner_3_20340119_vol_scaled_breadth_conditioned_residual_reversal_10d",
  "factor_name": "Volatility-scaled breadth-conditioned residual reversal (10-day)",
  "version": "1.0",
  "calculation": {
    "expression": "rolling_mean_3((-residual_return_sum_10_lag1 / residual_volatility_20_lag1) * clip(1 + 1.5*(0.5 - breadth_20_lag1), 0.625, 1.375))",
    "description": "Cross-asset residual reversal over a lagged 10-session horizon, normalized by each asset's lagged 20-session residual volatility, and conditionally strengthened during weak broad-market breadth; smoothed over three sessions. All inputs are lagged to avoid look-ahead."
  },
  "dependencies": ["close"],
  "parameters": {"residual_window": 10, "volatility_window": 20, "breadth_window": 20, "smoothing_window": 3, "breadth_gate_slope": 1.5, "gate_min": 0.625, "gate_max": 1.375, "horizon_days": 10, "min_cross_section": 8},
