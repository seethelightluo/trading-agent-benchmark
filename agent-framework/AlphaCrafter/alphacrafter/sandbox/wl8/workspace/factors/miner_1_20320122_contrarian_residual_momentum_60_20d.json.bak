{
  "factor_id": "miner_1_20320122_contrarian_residual_momentum_60_20d",
  "factor_name": "Volatility-scaled contrarian medium-term residual momentum",
  "version": "1.0",
  "calculation": {
    "expression": "-((sum(return_1d,60) - sum(return_1d,20)) / (std(return_1d,60) * sqrt(60)))",
    "description": "A lagged cross-asset contrarian signal: assets whose 60-day return remains strong relative to their recent 20-day return receive lower scores, while medium-term laggards receive higher scores. The differential is scaled by 60-day realized volatility; all inputs are shifted one completed trading day before the 10-day forward-return test."
  },
  "dependencies": ["close"],
  "parameters": {
    "long_lookback_days": 60,
    "short_lookback_days": 20,
    "volatility_lookback_days": 60,
    "forward_horizon_days": 10,
    "universe_size": 15,
    "minimum_cross_section": 8
  },
