{
  "factor_id": "miner_1_20310626_breadth33_conditioned_momentum_10d",
  "factor_name": "Breadth-conditioned 20-day momentum (33% threshold)",
  "version": "1.0",
  "calculation": {
    "expression": "lagged_20d_return if lagged_breadth >= 0.33 else -lagged_20d_return",
    "description": "Use lagged 20-day cross-asset momentum in normally participating markets; invert it during narrow-breadth stress regimes. Both momentum and breadth are lagged one completed day."
  },
  "dependencies": [
    "close"
  ],
