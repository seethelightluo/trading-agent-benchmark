{
  "factor_id": "miner_2_20270225_cross_asset_residual_reversal_3d",
  "factor_name": "Cross-Asset Median Residual Reversal 3D",
  "version": "1.1",
  "calculation": {
    "expression": "-rolling_sum_3d(asset_daily_return - cross_sectional_median_daily_return)",
    "description": "For each tradable asset, subtract the same-day cross-sectional median return from its daily return, sum the residual over the latest three observations, and reverse the sign. Higher values identify recent relative underperformance and candidates for short-term mean reversion, using only completed observations."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "residual_reference": "cross_sectional_median",
    "lookback_days": 3,
    "minimum_observations": 2,
    "universe_size": 15,
    "minimum_names_per_date": 8
  },
