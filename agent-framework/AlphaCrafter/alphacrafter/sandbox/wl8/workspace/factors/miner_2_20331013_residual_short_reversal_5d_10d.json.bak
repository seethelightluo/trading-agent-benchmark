  "factor_name": "Market-Residual Short-Term Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-rolling_mean_3(sum_5(residual_return)); residual_return = daily_log_return - rolling_beta_60(asset, cross_asset_mean_return)*cross_asset_mean_return",
    "description": "Contrarian five-session reversal after removing each asset's rolling 60-session exposure to the contemporaneous equal-weighted tradable-universe return, smoothed over three sessions. Uses only information available through the signal date."
  },
  "dependencies": ["close"],
  "parameters": {"market_proxy": "equal_weight_mean_daily_log_return", "beta_window": 60, "beta_min_periods": 40, "reversal_window": 5, "smoothing_window": 3, "forward_horizon": 10, "min_cross_section": 8},
