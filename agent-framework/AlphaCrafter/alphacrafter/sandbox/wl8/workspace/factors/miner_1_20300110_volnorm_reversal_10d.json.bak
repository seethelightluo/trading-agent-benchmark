{
  "factor_id": "miner_1_20300110_volnorm_reversal_10d",
  "factor_name": "Volatility-Normalized Short-Term Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "clip(-(close[t-1]/close[t-6]-1)/(std(pct_change(close),20)[t-1]*sqrt(5)), -5, 5)",
    "description": "Ranks assets for 10-trading-day forward returns by the negative lagged five-day return normalized by lagged 20-day daily volatility. Signals are clipped to reduce extreme crypto and commodity observations; all inputs are lagged one completed day."
  },
  "dependencies": ["close", "pct_change"],
  "parameters": {"reversal_lookback_days": 5, "volatility_window_days": 20, "volatility_min_periods": 15, "forward_horizon_days": 10, "clip": [-5, 5]},
