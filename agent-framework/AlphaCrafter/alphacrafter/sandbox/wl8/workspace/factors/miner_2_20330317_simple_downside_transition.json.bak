{
  "factor_id": "miner_2_20330317_simple_downside_transition",
  "factor_name": "Simple Downside-Risk Transition Reversal",
  "version": "1.1",
  "calculation": {
    "expression": "rolling_mean_3((-log(close/close[-40])/downside_vol_60) * (1 - clip(log(downside_vol_20/downside_vol_60), -1, 1)) )",
    "description": "Contrarian 40-day log return normalized by 60-day downside volatility, favoring assets whose short-term downside risk is compressing and dampening expanding-risk assets."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "reversal_window": 40,
    "downside_short_window": 20,
    "downside_long_window": 60,
    "smoothing_window": 3,
    "min_periods_short": 15,
    "min_periods_long": 40,
    "forward_horizon": 10
  },
