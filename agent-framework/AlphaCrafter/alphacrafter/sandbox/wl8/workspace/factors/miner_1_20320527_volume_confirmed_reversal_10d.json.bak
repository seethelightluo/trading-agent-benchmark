{
  "factor_id": "miner_1_20320527_volume_confirmed_reversal_10d",
  "factor_name": "Volume-confirmed stress reversal",
  "version": "1.0",
  "calculation": {
    "expression": "(-pct_change(close,3).shift(1) / (rolling_std(pct_change(close),30).shift(1)*sqrt(30))) * clip((volume / rolling_median(volume,30)).shift(1),0.5,3.0) * clip((cross_sectional_dispersion / rolling_median(cross_sectional_dispersion,60)).shift(1),0.5,2.0)",
    "description": "Lagged three-session reversal normalized by lagged 30-session realized volatility, amplified by lagged abnormal volume and lagged cross-asset dispersion stress. All inputs are available before the decision date. Positive values indicate candidates expected to outperform over the next 10 trading days."
  },
  "dependencies": ["close", "volume", "cross_sectional_returns"],
  "parameters": {"reversal_lookback": 3, "volatility_lookback": 30, "volume_baseline": 30, "stress_baseline": 60, "forward_horizon_days": 10, "min_cross_section": 8, "volume_clip": [0.5, 3.0], "stress_clip": [0.5, 2.0]},
