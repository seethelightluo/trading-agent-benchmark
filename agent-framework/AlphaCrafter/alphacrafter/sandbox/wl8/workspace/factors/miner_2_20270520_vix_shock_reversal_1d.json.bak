{
  "factor_id": "miner_2_vix_shock_reversal_1d",
  "factor_name": "VIX Shock-Conditioned Intraday Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-asset_return_1d when VIX_return_1d > rolling_median(VIX_return_1d, 20), else 0",
    "description": "Contrarian one-day asset return signal activated only when the observation-only VIX daily change exceeds its trailing 20-session median. The VIX and asset observations are lagged completed-day data for next-day prediction."
  },
  "dependencies": [
    "close",
    "VIX.close",
    "date"
  ],
  "parameters": {
    "vix_median_window": 20,
    "asset_return_window": 1,
    "forward_horizon_days": 1,
    "minimum_names_per_date": 8
  },
