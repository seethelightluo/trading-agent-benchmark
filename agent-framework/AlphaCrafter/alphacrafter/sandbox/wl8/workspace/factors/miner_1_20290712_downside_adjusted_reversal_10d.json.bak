{
  "factor_id": "miner_1_20290712_downside_adjusted_reversal_10d",
  "factor_name": "Downside-risk-adjusted 10-day reversal",
  "version": "20290712",
  "calculation": {
    "expression": "CS_CENTER(-sum_return_10d_lag1 / downside_volatility_20d_lag1)",
    "description": "Ranks assets favoring recent losers, scaled by their lagged downside volatility; downside volatility uses only negative daily returns and a five-observation minimum, with all inputs shifted one completed session."
  },
