{
  "factor_id": "range_recovery_60d",
  "factor_name": "Lagged 60-day range recovery",
  "version": "1.0",
  "calculation": {
    "expression": "shift_1((close - rolling_min(close,60)) / (rolling_max(close,60) - rolling_min(close,60)))",
    "description": "For each tradable asset, rank the prior completed day's position within its trailing 60-session high-low range. Higher values indicate recovery/strength from the trailing range low. Inputs are lagged one completed session to avoid look-ahead."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "lookback": 60,
    "min_periods": 40,
    "lag": 1,
    "forward_horizon": 1
  },
