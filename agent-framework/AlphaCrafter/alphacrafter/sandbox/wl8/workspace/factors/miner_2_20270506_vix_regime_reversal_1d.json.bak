{
  "factor_id": "miner_2_vix_regime_reversal_1d",
  "factor_name": "Elevated-VIX Intraday Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "if VIX_t > median(VIX_{t-19:t}), then -pct_change(close_t, 1), else 0",
    "description": "Reverse the latest completed one-day asset return only when the observation-only VIX level is above its trailing 20-session median; otherwise emit a neutral zero signal. VIX is used only as a macro conditioning signal and is not tradable."
  },
  "dependencies": [
    "close",
    "VIX.close"
  ],
  "parameters": {
    "vix_window": 20,
    "forward_horizon_days": 1,
    "minimum_cross_section": 8,
    "universe_size": 15
  },
