{
  "factor_id": "miner_3_20311030_dispersion_conditioned_5d_reversal",
  "factor_name": "Dispersion-Conditioned 5-Day Cross-Asset Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-sum(pct_change(close), 5) * I(rolling_mean_20(cross_sectional_std(pct_change(close))) > rolling_quantile_252(rolling_mean_20(cross_sectional_std(pct_change(close))), 0.65))",
    "description": "Ranks assets by negative trailing five-day return, activating the reversal signal only when lagged 20-day average cross-sectional daily-return dispersion is above its trailing 252-day 65th percentile. All inputs are lagged through the completed observation date at portfolio decision time."
  },
  "dependencies": ["close"],
  "parameters": {"reversal_window_days": 5, "dispersion_window_days": 20, "threshold_lookback_days": 252, "threshold_quantile": 0.65, "forward_horizon_days": 10},
  "validation": {
    "status": "EFFECTIVE",
    "period": {"start": "2026-07-28", "end": "2031-08-21"},
    "metrics": {
