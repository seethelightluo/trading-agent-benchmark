{
  "factor_id": "miner_3_20341012_multihorizon_trend_consistency_reversal10",
  "factor_name": "Multi-Horizon Trend-Consistency Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-rank(((0.6*r20 + 0.4*r60)/vol30) * (1 + 0.5*(2*I(sign(r20)=sign(r60))-1)))",
    "description": "Contrarian score of lagged 20-day and 60-day returns, normalized by lagged 30-day volatility; aligned trends receive a 1.5x amplification before reversing the cross-sectional rank. All inputs are lagged through the previous completed day. Negative direction is intentional because persistent multi-horizon moves showed reversal at the 10-day horizon."
  },
  "dependencies": ["close"],
  "parameters": {"short_window": 20, "long_window": 60, "vol_window": 30, "short_weight": 0.6, "long_weight": 0.4, "alignment_multiplier": 0.5, "forward_horizon_days": 10, "cross_sectional_transform": "percentile_rank_then_negative"},
