{
  "factor_id": "miner_2_20310612_vix_level_reversal_10d",
  "factor_name": "Elevated-VIX 10-day cross-asset reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-asset_return_10d * clip((VIX_252d_percentile - 0.80) / 0.20, 0, 1)",
    "description": "Fade each tradable asset's trailing 10-session return, with signal magnitude gated by the trailing 252-session percentile of VIX; no signal is applied below the 80th percentile. Values use data through the decision date and predict the next 10-session return."
  },
  "dependencies": [
    "close",
    "VIX.close"
  ],
