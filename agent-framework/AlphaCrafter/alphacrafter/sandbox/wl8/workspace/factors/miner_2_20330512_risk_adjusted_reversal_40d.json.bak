{
  "factor_id": "miner_2_20330512_risk_adjusted_reversal_40d",
  "factor_name": "Inverse-Volatility-Normalized 40-Day Cross-Asset Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(close / lag(close,40) - 1) / (rolling_std(pct_change(close),20) * sqrt(252))",
    "description": "Contrarian medium-horizon return signal scaled by trailing realized volatility. Values are computed only from completed observations and predict the following 10 trading-day return."
  },
  "dependencies": ["close", "date"],
  "parameters": {"return_window": 40, "volatility_window": 20, "annualization": 252, "forward_horizon_days": 10, "minimum_names_per_date": 8},
