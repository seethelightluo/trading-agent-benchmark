  "factor_name": "Volatility-Normalized 15D Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "clip(-lag1(pct_change(close,15) / rolling_std(pct_change(close),20)), -8, 8)",
    "description": "Fade the completed 15-trading-day return after normalization by lagged 20-day return volatility. All inputs are available through the previous completed session."
