{
  "factor_id": "miner_3_20300725_volnorm_dispersion_reversal_5d",
  "factor_name": "Volatility-Normalized Dispersion-Conditioned Five-Day Reversal",
  "version": "1.1",
  "calculation": {
    "expression": "(-pct_change(close,5) / rolling_std(pct_change(close,1),20)) * clip(cross_asset_mean_vol20 / rolling_median(cross_asset_mean_vol20,120), 0.5, 2.0)",
    "description": "Ranks assets by five-day reversal normalized by 20-day realized volatility, amplified or damped by the contemporaneous cross-asset volatility regime. All inputs are lagged to the signal date."
  },
  "dependencies": ["close"],
  "parameters": {"reversal_window": 5, "volatility_window": 20, "dispersion_median_window": 120, "min_vol_observations": 15, "min_median_observations": 60, "regime_clip": [0.5, 2.0], "forward_horizon": 10},
