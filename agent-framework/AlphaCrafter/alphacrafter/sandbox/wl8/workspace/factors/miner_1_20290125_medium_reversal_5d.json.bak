{
  "factor_id": "miner_1_20290125_medium_reversal_5d",
  "factor_name": "Volatility-normalized medium-term reversal (5-day forecast)",
  "version": "1.0",
  "calculation": {
    "expression": "cross_sectional_demean(clip(-pct_change(close,20).shift(1) / rolling_std(pct_change(close),20).shift(1), -8, 8))",
    "description": "Ranks assets favoring reversal of the completed 20-trading-day return, scaled by lagged 20-day realized volatility and cross-sectionally demeaned. Inputs are lagged at each decision date."
  },
  "dependencies": ["close"],
  "parameters": {"lookback_days": 20, "volatility_window": 20, "min_vol_observations": 15, "clip_lower": -8, "clip_upper": 8, "forecast_horizon_days": 5, "universe": 15},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2029-01-23",
    "last_validated": "2029-01-25",
    "metrics": {"ic": 0.040509, "icir": 0.135880, "dates": 641, "average_instruments": 11.05, "coverage": 0.260322, "turnover": null, "hit_ratio": 0.5351, "recent_180d_ic": 0.004791, "recent_180d_icir": 0.015552, "max_abs_library_correlation": null},
    "regime_notes": "Full-sample cross-sectional Spearman IC across 15 tradable cross-asset benchmark instruments; conservative interpretation due to small cross-section. Recent 180-day predictive power weakened, so monitor drift.",
