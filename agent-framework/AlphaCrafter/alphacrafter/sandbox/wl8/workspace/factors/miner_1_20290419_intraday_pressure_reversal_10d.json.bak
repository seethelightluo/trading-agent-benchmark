{
  "factor_id": "miner_1_20290419_intraday_pressure_reversal_10d",
  "factor_name": "Volatility-Scaled Intraday Pressure Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "demean_cs((-rolling_sum((close-open)/(high-low),10)/rolling_std(pct_change(close),20)).shift(1))",
    "description": "Compute signed close-open pressure normalized by the day's high-low range, accumulate over 10 sessions, scale by 20-session return volatility, invert for reversal, lag one completed session, and cross-sectionally demean by the daily median. Zero ranges are treated as missing and pressure is clipped to [-1,1]."
  },
  "dependencies": ["open", "high", "low", "close"],
  "parameters": {"pressure_window": 10, "volatility_window": 20, "forward_horizon": 10, "min_cross_section": 8, "clip": [-1, 1]},
