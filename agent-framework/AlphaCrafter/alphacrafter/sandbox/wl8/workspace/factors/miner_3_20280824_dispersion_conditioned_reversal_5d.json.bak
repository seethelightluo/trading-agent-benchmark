{
  "factor_id": "miner_3_20280824_dispersion_conditioned_reversal_5d",
  "factor_name": "Dispersion-conditioned volatility-scaled five-day reversal",
  "version": "2028-08-24",
  "calculation": {
    "expression": "-(rolling_sum(pct_change(close),5).shift(1))/rolling_std(pct_change(close),20).shift(1) * I[cross_sectional_dispersion_{t-1} > rolling_median(cross_sectional_dispersion,60)_{t-1}]",
    "description": "Fade the completed five-session return after lagged volatility normalization, gated by elevated cross-asset daily return dispersion. All signal and regime inputs are lagged.",
