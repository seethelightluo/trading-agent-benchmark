{
  "factor_id": "miner_2_20330526_slow_invvol_reversal_60d",
  "factor_name": "Slow Inverse-Volatility-Normalized 60-Day Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(close / close.shift(60) - 1) / (rolling_std(pct_change(close), 30) * sqrt(252))",
    "description": "Contrarian cross-asset signal that favors assets with negative or less-positive 60-day returns after scaling by 30-day annualized realized volatility; all inputs are lag-safe at the decision date."
  },
  "dependencies": ["close"],
  "parameters": {"return_lookback_days": 60, "volatility_window_days": 30, "annualization": 252, "forward_horizon_days": 10, "minimum_cross_section": 8},
