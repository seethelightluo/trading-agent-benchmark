{
  "factor_id": "miner_3_20321209_inverse_volnorm_momentum_40d",
  "factor_name": "Inverse volatility-normalized 40-day momentum",
  "version": "1.0",
  "calculation": {
    "expression": "-rolling_mean_3(log(close/close[-40]) / (sqrt(40)*rolling_std_40(log_return)), min_periods=2)",
    "description": "Contrarian cross-sectional signal: fade the 40-day momentum measured per unit of realized volatility, with a three-day smoothing filter. Larger values indicate stronger expected 10-trading-day forward return. All inputs are lag-safe at the decision date."
  },
  "dependencies": ["close"],
  "parameters": {
    "momentum_window": 40,
    "volatility_window": 40,
    "volatility_min_periods": 25,
    "smoothing_window": 3,
    "smoothing_min_periods": 2,
    "forward_horizon_days": 10,
    "cross_section_min_instruments": 8
  },
