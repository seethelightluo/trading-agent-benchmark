{
  "factor_id": "miner_1_20320708_lowvolatility_60d_10d",
  "factor_name": "Lagged 60-day volatility (low-volatility tilt)",
  "version": "1.0",
  "calculation": {
    "expression": "-mean_5(rolling_std(pct_change(close), 60).shift(1))",
    "description": "Ranks instruments higher when their trailing 60-trading-day realized volatility is lower. The volatility estimate is lagged one completed day and smoothed over five observations; no future data are used."
  },
  "dependencies": ["close"],
  "parameters": {"volatility_window": 60, "smoothing_window": 5, "forward_horizon": 10, "lag": 1},
