  "dependencies": ["close"],
  "parameters": {"short_horizon_days": 10, "medium_horizon_days": 40, "short_weight": 0.65, "medium_weight": 0.35, "volatility_window_days": 20, "forward_horizon_days": 10, "minimum_cross_section": 8},
