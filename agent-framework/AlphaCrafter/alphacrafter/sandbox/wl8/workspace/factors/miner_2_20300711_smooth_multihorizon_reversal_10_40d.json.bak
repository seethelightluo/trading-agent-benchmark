  "factor_name": "Smooth Multi-Horizon Volatility-Normalized Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(0.65 * return(close,10) + 0.35 * return(close,40)) / rolling_std(pct_change(close),20)",
    "description": "Ranks assets positively when their recent 10-day and medium-term 40-day returns are negative, scaling the blended reversal signal by trailing 20-day volatility. All inputs are lagged at the decision date and no future data are used."
