{
  "factor_id": "miner_2_20300613_smooth_shock_reversal_10_40d",
  "factor_name": "Smoothed volatility-normalized shock reversal with medium-term anchor",
  "version": "1.0",
  "calculation": {
    "expression": "-(return_10d / rolling_std_daily_return_20d) * (1 + 0.25*tanh(-(return_40d / rolling_std_daily_return_40d)))",
    "description": "Fades a ten-day volatility-normalized shock and modestly strengthens reversal when the forty-day normalized trend is opposite to the shock. Uses bounded conditioning to reduce extreme signals."
  },
  "dependencies": ["close"],
  "parameters": {"shock_window": 10, "shock_vol_window": 20, "anchor_window": 40, "anchor_vol_window": 40, "anchor_strength": 0.25, "forward_horizon": 10},
