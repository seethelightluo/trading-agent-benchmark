{
  "factor_id": "miner_3_20330901_inverse_risk_adjusted_trend_persistence_10d",
  "factor_name": "Inverse Risk-Adjusted Trend Persistence",
  "version": "1.0",
  "calculation": {
    "expression": "-rolling_mean_3((log(close/close[-40])/sqrt(20)*std(log_returns,20)) * (1 + 0.5*sign(log(close/close[-10]))*sign(log(close/close[-40]))))",
    "description": "Contrarian, volatility-scaled 40-session trend signal, strengthened when the 10-session and 40-session trends agree, then smoothed over three sessions. Computed cross-sectionally on the 15 tradable benchmark assets."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "trend_window": 40,
    "confirmation_window": 10,
    "volatility_window": 20,
    "smoothing_window": 3,
    "confirmation_loading": 0.5,
    "forward_horizon": 10
  },
