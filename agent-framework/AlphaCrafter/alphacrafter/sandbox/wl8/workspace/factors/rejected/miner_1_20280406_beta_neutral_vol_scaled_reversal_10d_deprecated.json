  "version": "1.0",
  "calculation": {
    "expression": "-shift((rolling_sum(return,10) - rolling_beta_60(return,equal_weight_market)*rolling_sum(equal_weight_market_return,10)) / (rolling_std(return,20)*sqrt(20)), 1)",
