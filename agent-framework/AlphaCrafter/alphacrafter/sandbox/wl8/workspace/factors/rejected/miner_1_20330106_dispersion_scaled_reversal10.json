{
  "factor_id": "dispersion_scaled_reversal_10d",
  "factor_name": "Cross-Asset Dispersion-Scaled 10-Day Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "rolling_mean_3((-log(close/close.shift(10)) / (rolling_std(log_returns,20)*sqrt(20))) * clip(mean_cross_asset_rolling_std(log_returns,20) / rolling_median_252(mean_cross_asset_rolling_std(log_returns,20)), 0.5, 2.0))",
    "description": "Ranks assets by ten-trading-day volatility-normalized reversal, with the signal scaled by the common cross-asset dispersion regime. All inputs are lag-safe at the decision date."
  },
  "dependencies": ["close"],
  "parameters": {"reversal_days": 10, "volatility_window": 20, "smoothing_window": 3, "dispersion_window": 20, "dispersion_baseline_window": 252, "dispersion_clip": [0.5, 2.0]},
