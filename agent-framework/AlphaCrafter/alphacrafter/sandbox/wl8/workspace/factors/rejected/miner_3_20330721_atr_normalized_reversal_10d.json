  "factor_name": "ATR-Normalized 10-Day Reversal with 3-Day Smoothing",
  "version": "2033-07-21",
  "calculation": {
    "expression": "rank_cs(clip(-log(close/close[-10]) / mean(log(high/low),20), 10%, 90%)) - 0.5, then rolling_mean(3)",
    "description": "Ranks ten-session price reversal after normalization by the trailing 20-session mean log high-low range. Cross-sectional extremes are winsorized at the 10th and 90th percentiles and the ranked signal is smoothed over three sessions. All inputs are lag-safe at the decision date. Positive values indicate expected positive forward returns."
  },
  "dependencies": ["close", "high", "low"],
