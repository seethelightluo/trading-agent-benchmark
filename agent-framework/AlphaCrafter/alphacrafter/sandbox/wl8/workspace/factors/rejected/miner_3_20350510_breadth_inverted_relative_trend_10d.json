  "factor_name": "Breadth-Inverted Market-Relative Risk-Normalized Trend",
  "version": "1.0",
  "calculation": {
    "expression": "shift1((relative_return_20d / (relative_volatility_30d + 0.05*cross_sectional_mean_relative_volatility_30d)) * (1 - clip(positive_absolute_return_breadth_60d - 0.5, -0.5, 0.5)))",
    "description": "Compute each asset's 20-session return relative to the equal-weight 15-asset benchmark, divide by 30-session relative volatility with a cross-sectional floor, then invert the prior breadth conditioning so trend is emphasized when market breadth is narrow and damped when breadth is broad. Lag one session to avoid look-ahead bias."
  },
  "dependencies": ["close"],
  "parameters": {
