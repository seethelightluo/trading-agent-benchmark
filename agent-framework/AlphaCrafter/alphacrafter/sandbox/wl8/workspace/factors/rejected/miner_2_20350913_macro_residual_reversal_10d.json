  "factor_name": "VIX-conditioned cross-asset residual reversal",
  "version": "1.0",
  "calculation": {
    "expression": "shift(-rolling_sum(asset_return - equal_weight_cross_asset_return, 5) * clip(VIX_20d_mean / VIX_120d_median, 0.5, 2.5), 1)",
    "description": "Ranks assets higher when their lagged five-session return is unusually negative relative to the equal-weight tradable cross-asset benchmark, with reversal intensity scaled by the observation-only VIX level relative to its trailing baseline. The one-session shift prevents lookahead."
