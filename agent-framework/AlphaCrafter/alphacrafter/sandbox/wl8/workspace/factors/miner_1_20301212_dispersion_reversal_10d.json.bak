{
  "factor_id": "miner_1_20301212_dispersion_reversal_10d",
  "factor_name": "Dispersion-gated volatility-scaled 5-day reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-pct_change(close,5)/(rolling_std(pct_change(close,1),20)*sqrt(5)) * clip(mean_cross_section(rolling_std(pct_change(close,1),20))/rolling_median_60(mean_cross_section(rolling_std(pct_change(close,1),20)),0.5,2.0)",
    "description": "Ranks assets by five-day contrarian return normalized by their 20-day realized volatility, then scales the signal by the contemporaneous cross-asset dispersion regime. All inputs are lagged through the decision date and the signal is evaluated against ten-day forward returns."
  },
  "dependencies": ["close"],
  "parameters": {"reversal_lookback_days": 5, "volatility_window_days": 20, "forward_horizon_days": 10, "dispersion_median_window_days": 60, "dispersion_gate_lower": 0.5, "dispersion_gate_upper": 2.0},
  "validation": {
