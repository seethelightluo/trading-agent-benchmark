{
  "factor_id": "miner_2_vix_panic_reversal_5d",
  "factor_name": "VIX Panic-Regime Volatility-Scaled Reversal",
  "version": "20290308",
  "calculation": {
    "expression": "I(panic_t) * demean_cs(-lag(return_5d,1) / lag(realized_vol_20d,1))",
    "description": "When completed VIX is above its trailing 60-session median or has risen more than 5% over five sessions, rank assets by negative completed five-day return scaled by lagged 20-day volatility; cross-sectional demean the result. Zero outside panic regimes.",
    "forward_horizon": "1 trading day admission; strongest observed at 10 trading days",
    "signal_artifact": "scripts/miner_2_20290308_vix_panic_reversal_signal.csv"
  },
  "dependencies": ["close", "VIX"],
  "parameters": {
    "return_lookback_days": 5,
    "volatility_lookback_days": 20,
    "panic_vix_median_days": 60,
    "panic_vix_rise_days": 5,
    "panic_vix_rise_threshold": 0.05,
    "minimum_cross_section": 8,
    "winsorization": "none"
  },
  "validation": {
    "period": {"start": "2020-01-01", "end": "2029-03-06"},
