{
  "factor_id": "miner_3_20330428_dispersion_gate_5smooth",
  "factor_name": "Five-session smoothed dispersion-conditioned cross-asset reversal",
  "version": "1.0",
  "calculation": {
    "expression": "mean_5((rank_cs(-log(close/close[-10]))-mean_cs(rank_cs(-log(close/close[-10]))))*(0.75+0.5*rank_pct_120(std_cs(log(close/close[-10])))))",
    "description": "Ranks inverse 10-day returns cross-sectionally, centers the ranks, scales reversal exposure by a clipped 120-session percentile of cross-asset 10-day return dispersion, then smooths the signal over five sessions. All inputs are lag-safe at decision time."
  },
  "dependencies": ["close"],
  "parameters": {"return_window": 10, "dispersion_window": 120, "dispersion_min_periods": 60, "scale_floor": 0.75, "scale_slope": 0.5, "scale_cap": 1.25, "smoothing_window": 5, "forward_horizon": 10, "minimum_cross_section": 8},
  "validation": {
