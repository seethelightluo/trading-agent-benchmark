  "factor_name": "Volatility-Normalized Five-Day Shock Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-rolling_sum(log_return,5) / rolling_mean(rolling_std(log_return,20),60), all lagged by one session; cross-sectional percentile rank then demean",
