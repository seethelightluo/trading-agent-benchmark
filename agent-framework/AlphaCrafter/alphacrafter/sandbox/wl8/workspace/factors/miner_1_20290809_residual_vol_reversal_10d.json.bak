{
  "factor_id": "miner_1_20290809_residual_vol_reversal_10d",
  "factor_name": "Volatility-scaled beta-neutral residual reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-lag1(residual_return_10d) / lag1(idiosyncratic_volatility_20d), residual_return_10d = return_10d - beta_40d * benchmark_return_10d, beta_40d = cov(asset, equal_weight_benchmark)/var(benchmark)",
    "description": "For each tradable benchmark instrument, remove its rolling 40-day beta exposure to the equal-weight 15-asset benchmark from its prior 10-day return, then reverse-rank the residual and scale by prior 20-day residual volatility. All inputs are lagged one completed trading day.",
    "leakage_control": "At date t, prices and rolling estimates are shifted so only data through t-1 is used; forward returns are used only for validation."
  },
  "dependencies": [
    "close",
    "pct_change"
  ],
  "parameters": {
    "benchmark": "equal_weight_mean_return",
    "beta_window": 40,
    "beta_min_periods": 25,
    "residual_return_window": 10,
    "residual_return_min_periods": 8,
    "idiosyncratic_vol_window": 20,
    "idiosyncratic_vol_min_periods": 12,
    "validation_horizon_days": 10,
    "minimum_cross_section": 8
  },
