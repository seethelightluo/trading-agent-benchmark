  "factor_name": "Volatility-normalized relative medium-term momentum",
  "version": "1.0",
  "calculation": {
    "expression": "mean_3(shift_1((sum_20(asset_returns)-sum_20(equal_weight_universe_return))/(std_20(asset_returns)*sqrt(20))))",
    "description": "For each tradable asset, compute its lagged 20-trading-day cumulative return in excess of the equal-weight 15-asset universe cumulative return, normalize by its 20-day realized volatility, and smooth over three observations. Higher values indicate stronger risk-adjusted relative momentum."
  },
  "dependencies": ["close", "daily_returns", "cross_section_equal_weight_return"],
