  "version": "20290614_v1",
  "calculation": {
    "expression": "(-sum_{k=1..5} return_{t-k,i}) * clip(vol20_{t-1,i}/median120(vol20_i), 0.5, 3.0), then cross-sectional median demean",
    "description": "Five-day lagged reversal is scaled by each instrument's lagged 20-day volatility relative to its own trailing 120-day median, then cross-sectionally median demeaned. All inputs are available through t-1."
  },
  "dependencies": ["close"],
  "parameters": {"reversal_window": 5, "volatility_window": 20, "volatility_baseline_window": 120, "min_periods": 10, "shock_clip": [0.5, 3.0], "horizon_days": 5},
