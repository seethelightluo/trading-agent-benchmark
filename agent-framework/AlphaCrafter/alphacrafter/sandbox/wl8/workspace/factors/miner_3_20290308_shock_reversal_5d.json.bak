{
  "factor_id": "miner_3_shock_reversal_5d",
  "factor_name": "Volatility-normalized three-day shock reversal",
  "version": "20290308",
  "calculation": {
    "expression": "clip(-(close/close.shift(3)-1).shift(1) / (rolling_std(pct_change(close),20).shift(1)*sqrt(3)), -8, 8)",
    "description": "Ranks assets for five-session forward returns by reversal of the completed three-session price shock, normalized by lagged 20-session realized volatility. All inputs are lagged to avoid look-ahead."
  },
  "dependencies": ["close", "pct_change", "realized_volatility"],
  "parameters": {"shock_window": 3, "volatility_window": 20, "forward_horizon": 5, "clip": [-8, 8], "minimum_cross_section": 8},
  "validation": {
    "status": "EFFECTIVE",
    "period": {"start": "2026-08-11", "end": "2029-02-27"},
