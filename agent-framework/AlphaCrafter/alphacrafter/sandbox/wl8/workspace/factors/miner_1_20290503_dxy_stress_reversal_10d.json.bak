{
  "factor_id": "dxy_stress_reversal_10d",
  "factor_name": "DXY-Stress-Conditioned 10-Day Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-sum(return,10).shift(1) * clip(1 + 0.75 * zscore(DXY,60).shift(1), 0.25, 2.5)",
