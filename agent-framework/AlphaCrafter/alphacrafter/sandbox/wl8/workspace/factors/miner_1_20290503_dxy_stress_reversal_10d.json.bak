  },
  "dependencies": ["close", "pct_change", "DXY close"],
  "parameters": {"lookback_return": 10, "dxy_zscore_window": 60, "stress_multiplier": 0.75, "multiplier_floor": 0.25, "multiplier_cap": 2.5, "forward_horizon": 10},
