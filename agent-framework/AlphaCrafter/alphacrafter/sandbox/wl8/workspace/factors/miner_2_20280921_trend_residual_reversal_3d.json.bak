{
  "factor_id": "miner_2_20280921_trend_residual_reversal_3d",
  "factor_name": "Volatility-Scaled Trend-Residual Three-Day Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-((sum(return,3)-3*sum(return,20)/20)/std(return,20))/(1+8*std(return,20))",
    "description": "At each decision date, use only lagged completed-session returns. Remove the average 20-session trend component from the lagged 3-session return, invert the residual shock, scale by lagged 20-session volatility, and modestly suppress extreme-risk assets. Cross-sectional higher values indicate expected stronger next 3-session returns."
  },
  "dependencies": ["close"],
  "parameters": {"short_window": 3, "trend_window": 20, "vol_window": 20, "min_vol_observations": 15, "risk_suppression_coefficient": 8.0, "signal_lag": 1, "forward_horizon_days": 3},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2028-09-19",
    "metrics": {
      "ic": 0.027228,
      "icir": 0.089091,
      "hit_ratio": 0.5314,
      "dates": 557,
      "average_instruments": 11.09,
      "coverage": 0.2473,
      "turnover": null,
      "max_abs_library_correlation": null,
      "horizon_days": 3
    },
    "regime_notes": "Full-sample daily paper IC and ICIR pass the benchmark gates (absolute IC >= 0.0070 and absolute ICIR >= 0.0840). Recent 180-day 3-day IC was 0.012771 with ICIR 0.045198, so current strength is weaker and should be revalidated. Small cross-section uncertainty is material.",
    "signal_artifact": "scripts/miner_2_20280921_trend_residual_reversal_signal.csv"
  },
