{
  "factor_id": "miner_2_20280824_range_shock_reversal_1d",
  "factor_name": "Range-Shock-Conditioned Volatility-Normalized Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(close[t-1]/close[t-6]-1) / std(pct_change(close),20)[t-1] * (1 + 0.25*clip((range[t-1]-median(range[t-61:t-1]))/std(range[t-61:t-1]),-2,2)), range=high/low-1",
    "description": "Contrarian lagged five-session return scaled by lagged 20-session realized volatility, with a bounded positive amplification when the prior intraday high-low range is unusually wide relative to its 60-session history. All inputs are lagged to avoid look-ahead."
  },
  "dependencies": ["close", "high", "low"],
  "parameters": {"return_lookback": 5, "volatility_window": 20, "range_history_window": 60, "shock_multiplier": 0.25, "shock_clip": [-2, 2], "forward_horizon_admission": 1},
  "validation": {
