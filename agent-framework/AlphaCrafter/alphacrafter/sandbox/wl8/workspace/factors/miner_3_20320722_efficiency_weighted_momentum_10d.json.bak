  "factor_name": "Path-efficiency-weighted 20-day momentum (revalidated)",
  "version": "1.1",
  "calculation": {
    "expression": "lagged_return_20d * (lagged_return_20d / sum(abs(daily_return),20))",
    "description": "A lag-safe 20-session directional momentum signal weighted by path efficiency, then smoothed over three sessions. Higher values indicate persistent directional trends; all signal inputs precede the forecast window."
