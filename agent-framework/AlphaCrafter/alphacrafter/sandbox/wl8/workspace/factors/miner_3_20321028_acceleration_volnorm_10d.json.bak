  "factor_name": "Volatility-Normalized Momentum Acceleration",
  "version": "1.0",
  "calculation": {
    "expression": "rolling_mean_3(shift_1((pct_change(close,20) - pct_change(close,60)/3) / (sqrt(20)*rolling_std(pct_change(close,1),40))) clipped to [-5,5])",
    "description": "Measures whether recent 20-day price momentum is accelerating relative to the average daily-equivalent 60-day momentum, normalized by trailing 40-day realized volatility. All inputs are lagged one completed day and the signal is smoothed over three observations. Higher values indicate stronger positive acceleration."
  },
  "dependencies": ["close"],
  "parameters": {"short_window": 20, "long_window": 60, "vol_window": 40, "smoothing_window": 3, "forward_horizon_days": 10, "clip": [-5, 5]},
