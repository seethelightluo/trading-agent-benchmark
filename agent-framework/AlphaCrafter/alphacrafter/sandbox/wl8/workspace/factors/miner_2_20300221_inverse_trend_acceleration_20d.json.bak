{
  "factor_id": "miner_2_20300221_inverse_trend_acceleration_20d",
  "factor_name": "Inverse medium-term trend acceleration, volatility normalized",
  "version": "1.0",
  "calculation": {
    "expression": "-((return_60d - return_10d) - cross_sectional_median(return_60d - return_10d)) / rolling_std(daily_return,40d), lagged_one_day",
    "description": "Ranks assets favoring medium-term underperformance relative to their recent 10-day performance, scaled by realized volatility. The signal is lagged one completed day to avoid look-ahead and is intended for a 20-trading-day forward horizon."
  },
  "dependencies": ["close"],
  "parameters": {"long_window": 60, "short_window": 10, "vol_window": 40, "lag_days": 1, "horizon_days": 20, "minimum_cross_section": 8},
