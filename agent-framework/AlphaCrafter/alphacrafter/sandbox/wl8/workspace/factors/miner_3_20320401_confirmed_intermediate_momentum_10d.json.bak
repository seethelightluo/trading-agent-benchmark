{
  "factor_id": "miner_3_20320401_confirmed_intermediate_momentum_10d",
  "factor_name": "Volatility-Adjusted Intermediate Momentum with Short-Term Confirmation",
  "version": "1.0",
  "calculation": {
    "expression": "(rolling_sum(pct_change(close),20,lag=1)/(rolling_std(pct_change(close),30,lag=1)*sqrt(20))) * (1 if rolling_sum(pct_change(close),5,lag=1)>0 else 0.35)",
    "description": "Ranks assets by lagged 20-session volatility-adjusted momentum. Positive lagged 5-session return receives full strength; non-positive confirmation is downweighted to reduce false continuation signals. All inputs are shifted and use only completed data.",
    "forward_horizon": "10 trading days",
    "signal_artifact": "scripts/miner_3_20320401_confirmed_momentum_signal.csv",
    "ic_artifact": "scripts/miner_3_20320401_confirmed_momentum_ic.csv"
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "momentum_window": 20,
    "confirmation_window": 5,
