  "factor_name": "Volatility-scaled relative leadership with breadth regime",
  "version": "1.0",
  "calculation": {
    "expression": "clip((relative_return_5d_to_cross_sectional_median / lagged_realized_volatility_20d) * lagged_20d_mean_daily_breadth, -8, 8)",
    "description": "Ranks recent relative leaders for continuation when aggregate breadth is positive and reverses the leadership tilt when breadth is negative. Every input is shifted to use only completed sessions."
  },
