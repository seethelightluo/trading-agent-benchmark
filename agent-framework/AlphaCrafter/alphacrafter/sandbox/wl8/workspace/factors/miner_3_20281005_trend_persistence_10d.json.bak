{
  "factor_id": "miner_3_20281005_trend_persistence_10d",
  "factor_name": "Volatility-scaled trend persistence",
  "version": "2028-10-05",
  "calculation": {
    "expression": "clip(((mean(sign(return_1d)>0,20)-0.5) * return_20d) / std(return_1d,20), -8, 8), all inputs shifted one session",
    "description": "Ranks assets by lagged directional consistency over 20 sessions, multiplied by lagged 20-session momentum and inverse lagged volatility. Positive values favor persistent upward trends; negative values favor persistent downward trends. The one-session shift prevents look-ahead bias."
  },
  "dependencies": [
    "close",
    "pct_change"
  ],
  "parameters": {
    "consistency_window": 20,
    "momentum_window": 20,
    "volatility_window": 20,
