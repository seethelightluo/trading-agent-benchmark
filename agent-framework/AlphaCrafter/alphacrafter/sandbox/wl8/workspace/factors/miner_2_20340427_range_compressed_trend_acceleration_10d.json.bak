{
  "factor_id": "miner_2_20340427_range_compressed_trend_acceleration_10d",
  "factor_name": "Range-compressed trend acceleration",
  "version": "1.0",
  "calculation": {
    "expression": "((return_20d - return_60d) / volatility_20d) * clip(1.25 - ATR20/ATR60, 0.25, 1.75)",
    "description": "Risk-normalized medium-term trend acceleration, amplified when recent normalized true range is compressed relative to its 60-session baseline. True range uses high-low and previous-close gaps. Signals are cross-sectionally standardized each date and positively oriented toward higher forward returns."
  },
  "dependencies": ["close", "high", "low"],
  "parameters": {"trend_short": 20, "trend_long": 60, "volatility_window": 20, "atr_short": 20, "atr_long": 60, "forward_horizon": 10, "minimum_cross_section": 8, "compression_clip": [0.25, 1.75], "signal_lag": "end_of_previous_completed_day"},
