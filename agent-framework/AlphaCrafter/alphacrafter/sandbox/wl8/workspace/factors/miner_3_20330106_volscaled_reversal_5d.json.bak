{
  "factor_id": "miner_3_20330106_volscaled_reversal_5d",
  "factor_name": "Ranked volatility-scaled short-term reversal",
  "version": "1.0",
  "calculation": {
    "expression": "rolling_mean_2(cs_demean(rank_pct(-log(close/close[-5]) / rolling_std(log_returns,20))), axis=dates)",
    "description": "Fade the prior five-session log return after scaling by 20-session realized volatility. Cross-sectional percentile ranking limits outlier influence, cross-sectional demeaning produces a comparable long-only score, and a two-session moving average reduces one-day noise. All inputs are lag-safe as of the decision date."
  },
  "dependencies": ["close"],
  "parameters": {"return_window_days": 5, "volatility_window_days": 20, "volatility_min_periods": 15, "smoothing_days": 2, "forward_validation_horizon_days": 10, "minimum_cross_section": 8},
  "validation": {
