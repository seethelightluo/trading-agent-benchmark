{
  "factor_id": "miner_1_20340622_short_residual_reversal_10d",
  "factor_name": "Dispersion-scaled short-horizon market-neutral residual reversal",
  "version": "1.0",
  "calculation": {
    "expression": "rank_cs(rolling_mean_3((-residual_return_5d / residual_volatility_20d) * clip(lagged_cross_sectional_dispersion / rolling_median_252d_dispersion, 0.6, 1.4))) demean_cs",
    "description": "For each tradable asset, subtract the cross-sectional mean log return to form a market-neutral residual. Reverse the lagged five-session residual return, normalize by lagged 20-session residual volatility, scale by lagged cross-sectional dispersion relative to its 252-session median, smooth over three sessions, then cross-sectionally rank and demean. All inputs are lagged to avoid look-ahead."
  },
  "dependencies": ["close"],
  "parameters": {"reversal_window": 5, "volatility_window": 20, "dispersion_median_window": 252, "smoothing_window": 3, "dispersion_clip": [0.6, 1.4], "forward_horizon": 10},
