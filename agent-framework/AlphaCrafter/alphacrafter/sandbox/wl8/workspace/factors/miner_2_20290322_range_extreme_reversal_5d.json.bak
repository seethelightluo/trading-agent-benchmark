{
  "factor_id": "miner_2_20290322_range_extreme_reversal_5d",
  "factor_name": "Volatility-Normalized 60-Day Range-Extreme Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-((close - (rolling_max(close,60)+rolling_min(close,60))/2)/(rolling_max(close,60)-rolling_min(close,60)))/(rolling_std(pct_change(close),20)*sqrt(20))",
    "description": "For instruments near the upper or lower edge of their 60-trading-day range, take the opposite (reversal) direction and scale by 20-day realized volatility. Values are computed from information available at the close of the signal date; the validated forward return begins afterward. Range span zero is treated as missing."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "range_window": 60,
    "range_min_periods": 40,
    "vol_window": 20,
    "vol_min_periods": 15,
    "forward_horizon_days": 5,
    "cross_section_min_instruments": 8
  },
