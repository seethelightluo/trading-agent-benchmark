{
  "factor_id": "miner_1_20351108_short_shock_reversal_10d",
  "factor_name": "Lagged short-horizon volatility-normalized shock reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(close[t-1]/close[t-6]-1) / (rolling_std(pct_change(close),20)[t-1] * sqrt(5))",
    "description": "Ranks assets for 10-session forward returns by reversing their lagged five-session price shock, normalized by trailing 20-session realized volatility. All inputs are lagged completed-session observations."
  },
  "dependencies": ["close"],
  "parameters": {"shock_lookback_sessions": 5, "signal_lag_sessions": 1, "volatility_window_sessions": 20, "forward_horizon_sessions": 10},
