{
  "factor_id": "miner_3_20350301_vix_gated_momentum_10d",
  "factor_name": "VIX-gated volatility-adjusted 20-day momentum",
  "version": "1.0",
  "calculation": {
    "expression": "lag1((close/close[-20]-1)/(std(pct_change(close),30)*sqrt(252))) * (0.65*I(VIX[-1] <= rolling_median(VIX,252)[-1]) + 0.35)",
    "description": "Ranks 20-session momentum after volatility scaling. The complete signal is lagged one session. A lagged observation-only VIX regime gate attenuates, but does not remove, momentum exposure during elevated VIX states. Cross-sectional use is across the 15 tradable benchmark instruments."
  },
  "dependencies": [
    "close",
    "VIX",
    "pct_change"
  ],
  "parameters": {
    "momentum_window": 20,
    "volatility_window": 30,
    "annualization": 252,
    "vix_median_window": 252,
    "stress_multiplier": 0.35,
    "calm_multiplier": 1.0,
    "signal_lag_sessions": 1,
    "forward_horizon_sessions": 10
  },
  "validation": {
