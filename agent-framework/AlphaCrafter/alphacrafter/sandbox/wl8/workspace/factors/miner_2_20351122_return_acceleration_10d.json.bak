  "factor_name": "Lagged Cross-Asset Return Acceleration",
  "version": "1.0",
  "calculation": {
    "expression": "(close/close.shift(20)-1 - (close/close.shift(60)-1)/3).shift(1)",
    "description": "Measures whether the latest 20-session return is stronger or weaker than the average 20-session pace over the preceding 60 sessions. The one-session lag ensures only completed daily data are used. Positive values indicate accelerating relative strength."
