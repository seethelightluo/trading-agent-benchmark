  "factor_name": "Overnight gap intraday reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(open_t / close_{t-1} - 1)",
    "description": "Contrarian cross-asset score formed from the completed overnight gap: assets opening above the previous close receive negative scores and vice versa. Predicts same-session open-to-close return; all inputs are known at the session open and no future data are used.",
