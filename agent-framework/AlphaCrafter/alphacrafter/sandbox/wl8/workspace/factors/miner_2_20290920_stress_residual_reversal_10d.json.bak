{
  "factor_id": "miner_2_20290920_stress_residual_reversal_10d",
  "factor_name": "High-and-rising-VIX beta-neutral residual reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-residual_return_5d / realized_volatility_20d, activated when lagged VIX is above its 120-day median and has risen over 5 days",
    "description": "Estimate each asset's rolling 60-day beta to the equal-weight benchmark, compute the 5-day beta-neutral residual return, invert it for reversal, scale by 20-day volatility, and activate only in high and rising VIX regimes. All inputs are shifted one trading day before signal use."
  },
  "dependencies": [
    "close",
    "VIX close"
  ],
  "parameters": {
    "beta_window": 60,
    "beta_min_periods": 40,
    "residual_window": 5,
    "vol_window": 20,
    "vol_min_periods": 15,
    "vix_trend_window": 5,
    "vix_median_window": 120,
    "vix_median_min_periods": 60,
    "forward_horizon_days": 10,
    "min_cross_section": 8
  },
