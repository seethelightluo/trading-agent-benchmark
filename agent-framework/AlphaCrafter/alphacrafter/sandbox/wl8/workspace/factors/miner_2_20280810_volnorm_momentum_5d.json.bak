{
  "factor_id": "miner_2_20280810_volnorm_momentum_5d",
  "factor_name": "Volatility-Normalized Momentum (Contrarian 5D)",
  "version": "1.0",
  "calculation": {
    "expression": "-(rolling_sum(pct_change(close), 12) / rolling_std(pct_change(close), 20)).shift(1)",
    "description": "Ranks assets by the negative of their lagged 12-session return scaled by lagged 20-session realized volatility. The negative direction captures the robust medium-horizon cross-asset reversal observed in validation; all inputs are lagged before the forward-return test."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "return_lookback": 12,
    "volatility_lookback": 20,
    "min_return_observations": 10,
    "min_volatility_observations": 15,
    "lag_sessions": 1,
    "forward_horizon_sessions": 5
  },
