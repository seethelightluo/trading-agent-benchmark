{
  "factor_id": "miner_3_20280907_drawdown_weighted_reversal_5d",
  "factor_name": "Drawdown-weighted volatility-scaled five-day reversal",
  "version": "2028-09-07",
  "calculation": {
    "expression": "-rolling_sum(pct_change(close),5).shift(1)/rolling_std(pct_change(close),20).shift(1) * (1 + 2*clip(-((close/rolling_max(close,60).shift(1))-1),0,0.25))",
    "description": "Volatility-normalized reversal of the completed five-session return, smoothly emphasizing instruments below their lagged 60-session high. All inputs are lagged and the drawdown multiplier is bounded to avoid extreme concentration.",
