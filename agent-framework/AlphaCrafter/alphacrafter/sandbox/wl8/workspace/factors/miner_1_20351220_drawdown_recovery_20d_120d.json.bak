{
  "factor_id": "miner_1_20351220_drawdown_recovery_20d_120d",
  "factor_name": "Drawdown Recovery Efficiency 20/120",
  "version": "1.0",
  "calculation": {
    "expression": "(close_t/close_{t-20}-1) / (abs(min(close_t/rolling_max(close,120)-1,0)) + 0.02), shifted by 1 session",
    "description": "Ranks tradable assets by recent 20-session price recovery relative to their remaining drawdown from the trailing 120-session high. The one-session lag prevents look-ahead and the floor stabilizes near-high observations. Higher values indicate stronger recovery efficiency."
  },
  "dependencies": ["close"],
  "parameters": {"return_lookback": 20, "high_lookback": 120, "drawdown_floor": 0.02, "signal_lag": 1, "forward_horizon": 10},
