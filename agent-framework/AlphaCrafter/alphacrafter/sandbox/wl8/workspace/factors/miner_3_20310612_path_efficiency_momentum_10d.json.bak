  "factor_name": "Path-Efficiency 20-Day Momentum",
  "version": "1.0",
  "calculation": {
    "expression": "lagged_20d_return / lagged_20d_sum_abs_daily_returns",
    "description": "The previous-session 20-trading-day price return divided by the sum of absolute daily returns over that same lagged window. Higher values represent directional momentum with less choppy path movement; all inputs are lagged to avoid look-ahead."
