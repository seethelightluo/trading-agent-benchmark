{
  "factor_id": "miner_2_volscaled_reversal15d_20280713",
  "factor_name": "15-day volatility-scaled cross-asset reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(close[t-1] / close[t-16] - 1) / (sqrt(20) * rolling_std(pct_change(close), 20) evaluated through t-1)",
    "description": "Ranks assets positively when their lagged 15-session return is low, with the reversal magnitude normalized by lagged 20-session realized volatility. All inputs are shifted so the decision at t uses only completed data through t-1."
  },
  "dependencies": ["close"],
  "parameters": {"lookback_sessions": 15, "volatility_window_sessions": 20, "min_vol_observations": 15, "normalization": "sqrt(20) annualization-like scale"},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2026-01-01/2028-07-12",
    "validation_timestamp": "2028-07-13",
    "metrics": {
      "horizon_days": 1,
      "ic": 0.027933,
      "icir": 0.087057,
      "dates": 508,
      "assets": 15,
      "average_instruments_per_date": 11.08,
      "coverage": 0.7387,
      "turnover": "not computed; 15-session signal is intended for 10-trading-day decisions",
      "max_abs_library_correlation": null,
      "admission_gates": {"absolute_daily_ic_min": 0.007, "absolute_daily_icir_min": 0.084},
      "hit_ratio": 0.537
    },
    "regime_notes": "Passes the benchmark daily IC and ICIR gates on 508 observations with the available 15-asset cross-section; uncertainty remains material because average cross-sectional breadth is 11.08. The 15-session lookback was the strongest passing candidate among 3, 5, 7, 10, 15, and 20-session variants."
  },
