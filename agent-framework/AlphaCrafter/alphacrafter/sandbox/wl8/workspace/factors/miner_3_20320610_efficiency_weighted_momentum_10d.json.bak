{
  "factor_id": "miner_3_20320610_efficiency_weighted_momentum_10d",
  "factor_name": "Path-efficiency weighted intermediate momentum",
  "version": "20320610",
  "calculation": {
    "expression": "rolling_mean_3(pct_change(close,20).shift(1) * clip(pct_change(close,20).shift(1) / sum_abs_returns(close,20).shift(1), -1, 1))",
    "description": "Lagged 20-session directional momentum multiplied by path efficiency, where path efficiency is directional return divided by the sum of absolute daily returns. A three-session smoothing reduces rank noise; all inputs are lagged to prevent look-ahead."
  },
  "dependencies": ["close", "daily_returns"],
  "parameters": {
    "momentum_window": 20,
    "efficiency_window": 20,
    "smoothing_window": 3,
    "forward_horizon_sessions": 10,
    "lag_sessions": 1,
    "clip": [-1, 1],
    "minimum_cross_section": 8,
    "universe_size": 15
  },
