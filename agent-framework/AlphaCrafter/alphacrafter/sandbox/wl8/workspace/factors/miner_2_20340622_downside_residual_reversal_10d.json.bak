{
  "factor_id": "miner_2_20340622_downside_residual_reversal_10d",
  "factor_name": "Downside-volatility-normalized market-neutral residual reversal",
  "version": "1.0",
  "calculation": {
    "expression": "rank_pct(-rolling_sum(residual_return,10).shift(1) / rolling_downside_volatility(residual_return,40).shift(1)) * drawdown_gate, then 3-day smooth and cross-sectional demean",
    "description": "Compute returns relative to the equal-weight cross-asset benchmark, invert the trailing 10-day residual return, normalize by trailing 40-day downside residual volatility, and modestly increase exposure after a negative trailing 60-day benchmark return. All features are shifted before forward-return evaluation to avoid lookahead."
  },
  "dependencies": ["close"],
  "parameters": {
    "residual_definition": "asset_log_return minus equal_weight_universe_log_return",
    "reversal_window": 10,
    "downside_volatility_window": 40,
    "downside_volatility_min_periods": 20,
    "benchmark_drawdown_window": 60,
    "drawdown_gate_clip": 0.1,
    "smoothing_window": 3,
    "forward_horizon_days": 10,
    "min_cross_section": 8
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2034-06-21",
    "validation_date": "2034-06-22",
