{
  "factor_id": "vix_stress_reversal_3d_1d",
  "factor_name": "VIX-stress-conditioned three-day reversal",
  "version": "2027-11-04",
  "calculation": {
    "expression": "-r_3d * (1 + 0.5 * max(0, clip(zscore_60d(lagged_5d_VIX_return), -2, 2)))",
    "description": "Reverse each tradable asset's completed three-day return, with larger reversal exposure after a lagged positive VIX shock. All inputs are lagged completed observations."
  },
  "dependencies": [
    "close",
    "VIX.close"
  ],
  "parameters": {
    "asset_return_window_days": 3,
