{
  "factor_id": "miner_2_20271216_vix_stress_reversal_3d",
  "factor_name": "Lagged VIX-stress amplified three-day reversal",
  "version": "2027-12-16",
  "calculation": {
    "expression": "-(close_t/close_{t-3}-1) * (1 + 0.8 * max(0, clip(VIX_t/VIX_median60_t - 1, -0.5, 1.5)))",
    "description": "Cross-sectional reversal of each asset's trailing three-day return, with the reversal magnitude amplified only when the lagged VIX level is above its 60-observation median. VIX stress is shifted one observation before joining to avoid contemporaneous information leakage. Higher values predict higher next-day returns."
  },
  "dependencies": [
    "close",
    "VIX.close"
  ],
  "parameters": {
    "return_lookback": 3,
    "vix_window": 60,
    "vix_min_periods": 30,
    "stress_clip": [
      -0.5,
      1.5
    ],
    "stress_amplifier": 0.8,
    "forward_horizon": 1
  },
  "validation": {
