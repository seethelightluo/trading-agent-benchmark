{
  "factor_id": "defensive_relative_trend_20d",
  "factor_name": "Risk-Normalized Defensive-Relative Trend",
  "version": "20320219",
  "calculation": {
    "expression": "((sum_20(return_i)-mean_j_in_defensive(sum_20(return_j)))/lagged_std_30(return_i)).shift(1)",
    "description": "For every tradable asset, measure its lagged 20-trading-day return relative to the equal-weighted XAU, US10Y, and CN10Y defensive basket, then normalize by lagged 30-day daily return volatility. Higher values indicate stronger persistent trend relative to defensive assets. Uses completed bars only and is intended for a 10-day forward horizon.",
    "forward_horizon": "10 trading days"
  },
  "dependencies": ["close"],
  "parameters": {
    "trend_lookback_days": 20,
    "defensive_assets": ["XAU", "US10Y", "CN10Y"],
    "volatility_lookback_days": 30,
    "minimum_cross_section": 8,
    "lag_days": 1
  },
