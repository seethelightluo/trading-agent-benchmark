{
  "factor_id": "miner_1_20350913_inverse_trend_60d_10d",
  "factor_name": "Lagged 60-session inverse trend",
  "version": "1.0",
  "calculation": {
    "expression": "-(close / close.shift(60) - 1).shift(1)",
    "description": "Ranks tradable cross-asset instruments by the negative of their lagged 60-session return; recent underperformers receive higher expected 10-session rebound scores. The one-session signal lag prevents look-ahead bias."
  },
  "dependencies": [
    "close",
    "date"
  ],
  "parameters": {
    "lookback_sessions": 60,
    "signal_lag_sessions": 1,
    "forward_horizon_sessions": 10,
    "minimum_cross_section": 8
  },
