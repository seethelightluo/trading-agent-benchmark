{
  "factor_id": "miner_3_20290111_relative_reversal_5d",
  "factor_name": "Market-relative volatility-normalized 10-day reversal",
  "version": "2029-01-11",
  "calculation": {
    "expression": "clip(-(asset_return_10d_lag1 - equal_weight_market_return_10d_lag1) / lagged_20d_return_volatility, -8, 8)",
    "description": "Ranks assets positively when their completed 10-session return has lagged the equal-weight tradable-universe market return, normalized by lagged 20-session daily-return volatility. All inputs are shifted to avoid look-ahead."
