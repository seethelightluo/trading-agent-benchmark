{
  "factor_id": "miner_3_20330623_range_atr_dispersion_reversal_10d",
  "factor_name": "Range-ATR normalized dispersion-gated reversal",
  "version": "1.0",
  "calculation": {
    "expression": "rolling_mean_3(rank_cs(clip_10_90(-log(close/close[-10]) / rolling_mean_20(log(high/low))) - 0.5) * percentile_rank_60(mean_asset_rolling_std_5(log_returns)))",
    "description": "Ranks ten-session reversal after normalization by twenty-session mean log high-low range, clips cross-sectionally at the 10th and 90th percentiles, gates by the 60-session percentile of aggregate five-session return dispersion, and smooths for three sessions. Positive values indicate stronger expected forward returns. All inputs are lag-safe."
  },
  "dependencies": ["close", "high", "low"],
  "parameters": {"reversal_window": 10, "range_window": 20, "range_min_periods": 10, "cross_sectional_clip": [0.10, 0.90], "dispersion_window": 5, "gate_window": 60, "gate_min_periods": 30, "smoothing_window": 3, "forward_horizon": 10, "min_cross_section": 8},
