{
  "factor_id": "miner_1_20321125_momentum_curvature_10d",
  "factor_name": "Volatility-normalized momentum curvature",
  "version": "1.0",
  "calculation": {
    "expression": "clip(((return_20d - return_60d/3) / rolling_std(return_1d,30)).shift(1), -8, 8)",
    "description": "Measures recent 20-session momentum relative to the average preceding 40-session trend, normalized by lagged 30-session volatility. Higher values indicate improving relative trend and lower values indicate deteriorating trend. Every input is shifted one completed session to prevent look-ahead."
  },
  "dependencies": ["close"],
  "parameters": {
    "recent_window": 20,
    "long_window": 60,
    "long_scale": 3,
    "volatility_window": 30,
    "forward_horizon": 10,
    "clip_low": -8,
    "clip_high": 8,
    "min_valid_instruments": 8
  },
