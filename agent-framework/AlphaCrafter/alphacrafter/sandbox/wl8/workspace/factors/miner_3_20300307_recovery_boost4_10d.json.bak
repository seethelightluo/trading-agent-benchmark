{
  "factor_id": "miner_3_20300307_recovery_boost4_10d",
  "factor_name": "Trend-conditioned volatility-normalized 120d recovery boost (4x)",
  "version": "20300321",
  "calculation": {
    "expression": "(-(close[t-1]/rolling_max(close,120)[t-1]-1)/rolling_std(pct_change(close),20)[t-1]) * (1 + 4*max(close[t-1]/close[t-61]-1, 0))",
    "description": "Volatility-normalized lagged drawdown from the 120-day high, positively boosted when the lagged 60-trading-day trend is positive. All inputs are lagged to prevent look-ahead."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "drawdown_window": 120,
    "volatility_window": 20,
    "trend_window": 60,
    "trend_boost": 4,
    "forward_horizon_days": 10,
    "minimum_cross_section": 8
  },
