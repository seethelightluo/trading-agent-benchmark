  "factor_name": "Drawdown Recovery Efficiency 20/120",
  "version": "1.0",
  "calculation": {
    "expression": "(close_t/close_{t-20}-1) / (abs(min(close_t/rolling_max(close,120)-1,0)) + 0.02), shifted by 1 session",
