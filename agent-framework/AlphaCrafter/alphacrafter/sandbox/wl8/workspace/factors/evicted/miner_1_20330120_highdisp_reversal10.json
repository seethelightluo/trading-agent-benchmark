{
  "factor_id": "miner_1_20330120_highdisp_reversal10",
  "factor_name": "High-Dispersion Conditional Volatility-Normalized 10-Day Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "mean_3( I[lagged_5d_cross_asset_dispersion > rolling_252d_dispersion_quantile(0.75)] * demean_cs(rank_pct(-log(close/close[-10])/rolling_std(log_returns,20))) )",
    "description": "Fade the volatility-normalized ten-day cross-sectional move only during unusually high cross-asset dispersion. Dispersion and gate are lagged to avoid look-ahead, and the gated rank signal is smoothed over three observations."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "reversal_lookback_days": 10,
    "volatility_window_days": 20,
