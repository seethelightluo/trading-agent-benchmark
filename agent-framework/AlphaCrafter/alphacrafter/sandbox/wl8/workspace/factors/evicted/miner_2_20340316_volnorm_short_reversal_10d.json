  "factor_name": "Volatility-normalized short-horizon reversal with dispersion scaling",
  "version": "1.0",
  "calculation": {
    "expression": "rolling_mean_3(zscore_cs(-(close/close_lag5-1) / rolling_std_20(daily_return)) * clip(mean_cross_asset_rolling_std20(daily_return) / rolling_median252(mean_cross_asset_rolling_std20(daily_return)), 0.5, 1.5))",
    "description": "Ranks the inverse five-session return after normalizing each asset by its trailing 20-session volatility, then smooths three sessions and scales exposure by the lagged cross-asset dispersion regime. All observations are lagged through the prior completed session for forward 10-session validation."
