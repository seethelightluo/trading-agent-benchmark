  "factor_name": "Beta-Neutral Residual Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-shift1(rolling_sum_10(asset_return) - rolling_beta_60(asset_return, equal_weight_benchmark_return) * rolling_sum_10(equal_weight_benchmark_return))",
    "description": "Fade each asset's lagged 10-trading-day cumulative return after removing its lagged rolling 60-day beta exposure to the equal-weight benchmark. The benchmark is computed only from the 15 tradable instruments and all inputs are lagged through the prior completed session."
