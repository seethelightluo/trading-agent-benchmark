  "factor_name": "Dispersion-gated volatility-scaled 10-day reversal",
  "version": "1.1",
  "calculation": {
    "expression": "-(close/close.shift(10)-1)/(rolling_std(pct_change(close),20)*sqrt(10)).clip(lower=0.005) * (0.5 + rolling_rank_60(mean_cross_asset(rolling_std(pct_change(close),20))))",
    "description": "Ranks a 10-day reversal signal after volatility scaling, with a smooth multiplier based only on the trailing 60-day percentile rank of mean 20-day cross-asset volatility. All inputs are lagged through the decision date and no future data are used."
