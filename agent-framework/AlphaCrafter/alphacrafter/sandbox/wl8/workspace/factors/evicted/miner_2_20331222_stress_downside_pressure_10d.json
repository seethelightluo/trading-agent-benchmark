  "factor_name": "VIX-Stress Downside-Pressure Reversal",
  "version": "1.1",
  "calculation": {
    "expression": "I(VIX_t > median(VIX_{t-59:t})) * (-sum(log_return_{t-10:t}) / downside_volatility_{t-19:t})",
    "description": "When VIX is above its trailing 60-session median, rank assets by their lagged 10-session loss normalized by 20-session downside volatility. Larger values identify stressed assets with potential 10-session rebound. The signal is lagged one session and neutral outside stress regimes."
