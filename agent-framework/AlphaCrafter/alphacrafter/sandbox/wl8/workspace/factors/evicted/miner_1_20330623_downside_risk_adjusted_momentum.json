  "factor_name": "Downside-risk-adjusted intermediate momentum reversal",
  "version": "1.0",
  "calculation": {
    "expression": "rank_cs(winsorize_10_90(log(close/close[-40]) / downside_semideviation_60), pct=True) centered at 0 and smoothed over 3 days",
    "description": "Compute 40-trading-day log momentum divided by 60-day downside semideviation, winsorize each date cross-sectionally at the 10th and 90th percentiles, percentile-rank and center the result, then apply a 3-day trailing mean. Negative forecast direction is used: weaker risk-adjusted intermediate performers are expected to mean-revert upward over the next 10 trading days. All inputs are lag-safe at the decision date."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "momentum_lookback_days": 40,
    "downside_vol_lookback_days": 60,
    "downside_definition": "sqrt(mean(min(log_return,0)^2))",
    "winsor_lower": 0.1,
    "winsor_upper": 0.9,
    "rank_smoothing_days": 3,
    "forward_horizon_days": 10
  },
