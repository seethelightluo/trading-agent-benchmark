{
  "factor_id": "miner_3_20270520_vix_direction_reversal_1d",
  "factor_name": "VIX-shock-direction-conditioned intraday reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(close/open - 1) * clip(1 + 0.50 * clip((lagged_VIX_return / rolling20_std(lagged_VIX_return)), -2, 2), 0, 2)",
    "description": "Lagged intraday reversal, directionally modulated by the standardized prior-day VIX return. Positive VIX shocks amplify reversal; falling-VIX shocks attenuate it. All VIX inputs are lagged and the factor is evaluated cross-sectionally."
  },
  "dependencies": [
    "open",
    "close",
    "VIX.close"
  ],
  "parameters": {
    "vix_scale_window": 20,
