{
  "factor_id": "miner_3_dxy_conditioned_reversal_3d",
  "factor_name": "DXY-volatility-conditioned 3-day reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(close/close.shift(3)-1) * (1 + 0.5*abs(clip(shift(DXY_return_5d / rolling_std(DXY_return_5d,60),1),-2,2)))",
    "description": "Ranks assets by lagged three-day reversal, with reversal magnitude amplified when the completed prior DXY five-day move is unusually large relative to its trailing 60-day volatility. The macro state is shifted one session to prevent look-ahead."
  },
  "dependencies": [
    "close",
    "DXY.close"
  ],
  "parameters": {
    "asset_lookback_days": 3,
    "dxy_return_days": 5,
    "dxy_volatility_window": 60,
    "dxy_volatility_min_periods": 30,
    "dxy_lag_days": 1,
    "state_clip": [
      -2.0,
      2.0
    ],
    "amplification": 0.5
  },
