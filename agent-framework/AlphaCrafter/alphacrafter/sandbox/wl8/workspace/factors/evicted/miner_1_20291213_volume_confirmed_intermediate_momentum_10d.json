  "factor_name": "Volume-Confirmed Intermediate Momentum",
  "version": "1.0",
  "calculation": {
    "expression": "shift1((pct_change(close,20)-pct_change(close,5))*sqrt(clip(volume/rolling_median(volume,60),0.25,4.0)))",
