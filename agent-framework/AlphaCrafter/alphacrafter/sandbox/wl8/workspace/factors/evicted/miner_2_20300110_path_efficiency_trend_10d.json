  "factor_name": "Path-Efficiency Confirmed Intermediate Trend",
  "version": "1.0",
  "calculation": {
    "expression": "(close[t-1]/close[t-21]-1) / sum(abs(pct_change(close)[t-20:t-1])) * (1 + 0.5*tanh((close[t-1]/close[t-61]-1)/0.20))",
    "description": "Ranks assets by 20-trading-day return per unit of realized absolute price path, with a bounded 60-day trend confirmation multiplier. All inputs are lagged one completed day; the signal is evaluated against next-10-trading-day returns."
