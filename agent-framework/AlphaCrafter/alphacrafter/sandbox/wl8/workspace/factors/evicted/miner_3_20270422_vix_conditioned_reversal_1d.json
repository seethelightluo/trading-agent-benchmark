  "factor_name": "VIX-conditioned intraday reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(close/open - 1) * (1 + 0.75 * clip(VIX_close_lag1 / median(VIX_close_lag1,20) - 1, -0.5, 1.5))",
    "description": "Cross-asset intraday reversal score, amplified when lagged VIX is above its trailing 20-observation median. VIX is observation-only and lagged to avoid lookahead; score is formed after the completed session for next-day return prediction.",
