{
  "factor_id": "miner_3_20330707_range_atr_dispersion_reversal_10d",
  "factor_name": "Range-ATR normalized dispersion-gated reversal (5-session smoothing)",
  "version": "1.1",
  "calculation": {
    "expression": "rank_cs(clip10_90(-log(close/close[-10]) / mean20(log(high/low))) - 0.5) * percentile_rank60(mean_cross_asset(std5(log_return))) ; rolling_mean3",
    "description": "Ten-session reversal normalized by each asset's trailing 20-session mean log high-low range, cross-sectionally clipped and ranked, multiplied by a trailing 60-session rank of five-session cross-asset return dispersion, then smoothed over three sessions. All inputs are lagged to the decision date."
  },
  "dependencies": [
    "close",
    "high",
    "low"
  ],
  "parameters": {
    "reversal_lookback": 10,
    "range_window": 20,
