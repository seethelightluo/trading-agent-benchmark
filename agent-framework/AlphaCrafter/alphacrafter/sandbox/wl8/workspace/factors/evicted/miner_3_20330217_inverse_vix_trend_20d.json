{
  "factor_id": "miner_3_20330217_inverse_vix_trend_20d",
  "factor_name": "Inverse VIX-conditioned volatility-normalized intermediate trend",
  "version": "1.0",
  "calculation": {
    "expression": "-((log(close/close.shift(20))/rolling_std(log(close).diff(),20))*clip(1.5 - VIX/rolling_median(VIX,120), -0.5, 1.0))",
    "description": "Contrarian volatility-normalized 20-session trend, with signal strength activated in calmer-than-normal VIX regimes. Cross-sectional percentile ranking, demeaning, and two-session smoothing are applied. All inputs are lag-safe at decision time."
  },
  "dependencies": [
    "close",
    "VIX",
    "daily_returns"
  ],
  "parameters": {
    "trend_window": 20,
    "volatility_window": 20,
    "vix_median_window": 120,
    "vix_ratio_clip": [
      0.5,
      2.0
    ],
    "regime_clip": [
      -0.5,
      1.0
    ],
    "smoothing_window": 2,
    "forward_horizon": 10
