  "factor_name": "Percentile Dispersion-Gated Raw Reversal 10D",
  "version": "1.0",
  "calculation": {
    "expression": "rank_cs(-(mean(log_return,10).shift(1))/std(cs_demeaned_log_return,20).shift(1) * (0.70 + 0.60 * percentile_rank_rolling(std(log_return).shift(1),60)^1.5)",
    "description": "Cross-sectional rank of lagged raw 10-session reversal normalized by lagged 20-session cross-sectional residual volatility, multiplied by a lagged nonlinear percentile dispersion-state gate. All inputs are lagged to prevent look-ahead bias; final signal is cross-sectionally demeaned."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "reversal_window": 10,
    "residual_volatility_window": 20,
    "dispersion_percentile_window": 60,
    "dispersion_min_periods": 30,
    "gate_formula": "clip(0.70 + 0.60 * percentile^1.5, 0.70, 1.30)",
