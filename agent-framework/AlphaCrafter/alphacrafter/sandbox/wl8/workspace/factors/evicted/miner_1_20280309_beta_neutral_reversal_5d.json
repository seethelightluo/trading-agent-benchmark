  "factor_name": "Beta-Neutral Five-Day Cross-Asset Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-shift(rolling_sum(return,5) - rolling_beta_60(return, equal_weight_market)*rolling_sum(equal_weight_market_return,5), 1)",
    "description": "For each tradable asset, remove its 60-session rolling beta exposure to the equal-weight 15-asset market proxy from its five-session return, lag the residual, and take the negative residual as the reversal score. Forward returns use the next completed session, avoiding look-ahead."
