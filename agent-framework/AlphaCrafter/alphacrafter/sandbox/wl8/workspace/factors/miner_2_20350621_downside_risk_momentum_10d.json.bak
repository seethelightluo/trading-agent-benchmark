{
  "factor_id": "miner_2_20350621_downside_risk_momentum_10d",
  "factor_name": "Downside-risk-adjusted 30-day momentum",
  "version": "1.0",
  "calculation": {
    "expression": "shift( pct_change(close,30) / rolling_std(where(pct_change(close,1)<0, pct_change(close,1), 0),30), 1)",
    "description": "Lagged 30-session return divided by 30-session downside deviation; positive momentum is rewarded while assets with frequent/larger negative daily returns are penalized. Cross-sectional Spearman ranking is used for portfolio signals."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "momentum_window": 30,
    "downside_window": 30,
    "forward_horizon": 10,
    "lag": 1,
    "minimum_cross_section": 8
  },
