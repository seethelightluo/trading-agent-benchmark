{
  "factor_id": "miner_2_20280420_vix_high_rankvol_reversal_1d",
  "factor_name": "VIX-High Rank Volatility-Scaled 5-Day Reversal",
  "version": "2028-04-20",
  "calculation": {
    "expression": "I(VIX_lag1 > median(VIX_lag1,60d)) * -(rank_pct(sum_return_5d_lag1)-0.5)/(0.5+rank_pct(std_return_20d_lag1))",
    "description": "When lagged VIX is above its trailing 60-trading-day median, score assets by rank-based five-day reversal scaled by ranked twenty-day volatility; otherwise signal is zero. All inputs are shifted one completed trading day before forecasting next-day return. Negative observed IC is retained as the factor direction."
  },
  "dependencies": [
    "close",
    "VIX close"
  ],
  "parameters": {
    "return_window_days": 5,
    "volatility_window_days": 20,
    "vix_median_window_days": 60,
    "minimum_vix_history": 40,
    "forecast_horizon_days": 1,
    "rank_method": "cross-sectional percentile",
    "lag_days": 1
  },
