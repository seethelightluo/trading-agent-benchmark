{
  "factor_id": "downside_scaled_reversal_20d",
  "factor_name": "Downside-volatility-scaled 20-day reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-return_20d / rolling_std(negative_daily_returns, 20)",
    "description": "Ranks assets higher when their 20-day return is lower after scaling by their trailing 20-day downside volatility. Lower-return assets are favored while accounting for downside-risk magnitude. The signal is computed using only information available at each date."
