{
  "factor_id": "miner_1_20320513_breadth_stress_reversal_10d",
  "factor_name": "Breadth- and stress-scaled short-term reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(close/close.shift(3)-1) / (rolling_std(pct_change(close),30).shift(1)*sqrt(30)) * clip(lagged_dispersion/lagged_dispersion_median_60,0.5,2.0) * (0.5 + lagged_5d_cross_asset_downside_breadth)",
    "description": "Cross-sectional short-term reversal normalized by lagged 30-day realized volatility and continuously scaled by lagged market stress and the fraction of assets with negative daily returns over the prior five sessions. All inputs are lagged; higher values indicate stronger expected rebound."
  },
  "dependencies": ["close", "pct_change", "cross_asset_returns"],
  "parameters": {"reversal_window": 3, "volatility_window": 30, "stress_window": 60, "breadth_window": 5, "forward_horizon_days": 10, "min_cross_section": 8, "stress_clip": [0.5, 2.0]},
