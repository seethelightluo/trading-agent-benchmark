{
  "factor_id": "miner_2_20310529_vix_level_reversal_5d_10d",
  "factor_name": "VIX elevated-level conditioned 5-day reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-asset_return_5d * clip((VIX_trailing_252_percentile - 0.70) / 0.30, 0, 1)",
    "description": "Fade each tradable asset's five-day return, with signal magnitude activated and scaled when VIX is above its trailing 252-session 70th percentile. VIX is observation-only and is never traded. All inputs are lag-safe at the decision date."
  },
  "dependencies": [
    "close",
    "VIX close"
  ],
  "parameters": {
    "asset_return_lookback": 5,
    "vix_percentile_window": 252,
    "vix_percentile_min_periods": 60,
    "activation_percentile": 0.7,
    "full_scale_percentile": 1.0,
    "forward_horizon": 10
  },
