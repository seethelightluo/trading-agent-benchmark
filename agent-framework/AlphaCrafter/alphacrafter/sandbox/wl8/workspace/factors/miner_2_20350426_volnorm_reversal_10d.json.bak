{
  "factor_id": "miner_2_20350426_volnorm_reversal_10d",
  "factor_name": "Volatility-normalized intermediate-horizon reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-sum(log_return,10,lag=1) / (rolling_std(log_return,40,lag=1) + epsilon)",
    "description": "Ranks assets by the inverse of their prior 10-session return, scaled by prior 40-session daily realized volatility. The one-session lag ensures only completed information is used for the subsequent 10-session forward return."
  },
  "dependencies": ["close"],
  "parameters": {"reversal_window": 10, "volatility_window": 40, "forward_horizon": 10, "epsilon": 1e-8, "minimum_cross_section": 8},
  "validation": {
    "status": "EFFECTIVE",
    "period": {"start": "2020-01-01", "end": "2035-04-26"},
    "validated_at": "2035-04-26T00:00:00Z",
    "regime_notes": "Validated on the 15-instrument synthetic cross-asset universe through the supplied current date. Results were positive in each chronological regime segment tested, but the final segment is shorter; interpret uncertainty conservatively.",
    "metrics": {
      "ic": 0.0342110433,
      "icir": 0.1151545900,
      "ic_horizon_days": 10,
      "ic_hit_ratio": 0.5358894,
      "valid_dates": 2243,
      "average_instruments": 15.0,
      "coverage": 0.5457,
      "turnover": null,
      "decay": "Not estimated in this cycle",
      "max_abs_library_correlation": null
    },
    "signal_artifact": {
      "type": "reproducible_panel_expression",
      "script": "scripts/miner_2_20350426_reversal_grid.py",
      "universe": ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"],
      "data_source": "../persistent/stock_data/*.csv",
      "forward_return": "close[t+10]/close[t]-1"
    }
