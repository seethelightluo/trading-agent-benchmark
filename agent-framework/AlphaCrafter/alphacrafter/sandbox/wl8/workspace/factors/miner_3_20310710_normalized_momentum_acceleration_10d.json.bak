{
  "factor_id": "miner_3_20310710_normalized_momentum_acceleration_10d",
  "factor_name": "Risk-Normalized Momentum Acceleration",
  "version": "1.0",
  "calculation": {
    "expression": "((pct_change(close,20) - pct_change(close,60)/3) / (rolling_std(pct_change(close,1),20)*sqrt(252))).shift(1)",
    "description": "Measures recent 20-session return relative to a one-third share of 60-session return, scaled by trailing realized volatility. The one-session lag ensures only completed data are used; higher values indicate improving risk-adjusted momentum."
  },
  "dependencies": ["close"],
  "parameters": {"short_window": 20, "long_window": 60, "long_scaling": 3, "volatility_window": 20, "annualization": 252, "forward_horizon_sessions": 10, "lag_sessions": 1, "universe_size": 15},
