{
  "factor_id": "yield_stress_residual_reversal_10d",
  "factor_name": "Yield-volatility-stress-conditioned residual reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-mean_3(shift_1(residual_return_10d)) * clip(0.7 + 0.9 * percentile_252(shift_1(sum_20(abs(mean_return(US10Y,CN10Y)))), 0.7, 1.6))",
    "description": "For each tradable asset, reverse its lagged 10-session log-return residual versus the equal-weight tradable cross-asset market return. Scale the reversal by lagged percentile-ranked stress in the two tradable yield series, measured as the rolling 20-session sum of absolute average yield returns, then smooth over three sessions. All inputs are lagged and forward 10-session returns are used only for validation."
  },
  "dependencies": ["close", "US10Y close", "CN10Y close"],
  "parameters": {"residual_window": 10, "stress_window": 20, "stress_percentile_window": 252, "stress_min_periods": 126, "smoothing_window": 3, "forward_horizon": 10, "minimum_cross_section": 8, "scale_floor": 0.7, "scale_slope": 0.9, "scale_cap": 1.6},
