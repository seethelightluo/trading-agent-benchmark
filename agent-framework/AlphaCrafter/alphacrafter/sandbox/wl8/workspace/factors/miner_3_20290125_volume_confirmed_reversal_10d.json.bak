{
  "factor_id": "miner_3_20290125_volume_confirmed_reversal_10d",
  "factor_name": "Volume-Confirmed Short-Term Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "(-return_5d_lag1) * log(1 + volume_lag1 / median_volume_40d_lag1)",
    "description": "Fade the completed five-day return, amplified when lagged volume is abnormally high relative to the trailing 40-day median. All price and volume inputs are lagged one completed trading day; extreme or nonpositive volume observations are treated as missing."
  },
  "dependencies": ["close", "volume"],
  "parameters": {"return_window_days": 5, "volume_median_window_days": 40, "forward_horizon_days": 10, "minimum_valid_instruments": 8},
