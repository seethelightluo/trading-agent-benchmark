  "factor_name": "Lagged 30-session inverse trend",
  "version": "2035-09-27",
  "calculation": {
    "expression": "-(close[t-1] / close[t-31] - 1)",
    "description": "Ranks assets by the negative trailing 30-session return, using prices only through t-1 to avoid look-ahead; higher values indicate stronger mean-reversion expectation over the next 10 sessions."
