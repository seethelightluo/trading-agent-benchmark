{
  "factor_id": "miner_1_20351025_vix_clv_pressure_10d",
  "factor_name": "VIX-conditioned lagged close-location pressure reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-rolling_mean(((close-low)/(high-low)-0.5),10,min_periods=7).shift(1) * (1 + 0.35*clip((VIX-rolling_median(VIX,120))/rolling_std(VIX,120),-2,2))",
    "description": "Cross-asset reversal signal using the negative ten-session average close-location pressure, amplified when VIX is elevated relative to its trailing 120-session median and standard deviation. All inputs are lagged or available through the completed session."
  },
  "dependencies": [
    "close",
    "high",
    "low",
    "VIX"
  ],
  "parameters": {
    "pressure_window": 10,
    "min_periods": 7,
    "vix_window": 120,
    "vix_median_window": 120,
    "vix_z_clip": [
      -2,
      2
    ],
    "vix_amplitude": 0.35,
    "signal_lag": 1,
    "forward_horizon": 10
  },
  "validation": {
    "status": "EFFECTIVE",
