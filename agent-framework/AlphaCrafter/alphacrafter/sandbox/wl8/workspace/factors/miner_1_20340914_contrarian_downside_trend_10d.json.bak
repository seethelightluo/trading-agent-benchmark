  "factor_name": "Contrarian downside-volatility-adjusted residual trend",
  "version": "1.0",
  "calculation": {
    "expression": "rank_cs((-sum_40(lag1(residual_log_return)))/lag1(std_40(negative_part(residual_log_return)))) demean_cs",
    "description": "Fade the lagged 40-session cross-asset residual return, scaling the contrarian signal by lagged downside residual volatility. Residual returns subtract the same-day cross-sectional mean log return. All rolling inputs are shifted one session before signal formation."
