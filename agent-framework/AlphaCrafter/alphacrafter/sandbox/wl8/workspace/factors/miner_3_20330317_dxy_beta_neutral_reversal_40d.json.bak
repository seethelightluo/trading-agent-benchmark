  "factor_name": "DXY-Beta-Neutralized 40-Day Cross-Asset Reversal",
  "version": "20330317",
  "calculation": {
    "expression": "-rank_cs(log_return_40d(asset) - beta_120d(asset,DXY)*log_return_40d(DXY))",
    "description": "Residualize each tradable asset's completed 40-day log return against its trailing 120-day daily DXY beta, invert the residual cross-sectional rank, and smooth ranks over two completed sessions. DXY is observation-only and no future data is used.",
    "forward_horizon": "10 trading days"
  },
  "dependencies": ["close", "DXY close"],
  "parameters": {"return_lookback_days": 40, "beta_lookback_days": 120, "beta_min_periods": 80, "smoothing_days": 2, "min_cross_section": 8},
