{
  "factor_id": "miner_3_20340427_smoothed_liquidity_residual_reversal_10d",
  "factor_name": "Smoothed liquidity-confirmed residual reversal",
  "version": "2034-04-27",
  "calculation": {
    "expression": "demean_cs(rolling_mean_3(0.75*rank_cs(-rolling_sum_10(idio_return).shift(1)/rolling_std_40(idio_return).shift(1)) + 0.25*rank_cs((mean_volume_10/mean_volume_60).shift(1).clip(0.5,2.0))))",
    "description": "Ranks ten-session market-neutral residual reversal normalized by trailing idiosyncratic risk, blends a lagged relative-volume rank, and smooths the composite over three sessions. Cross-sectional demeaned signal uses only completed historical observations."
  },
  "dependencies": ["close", "volume"],
  "parameters": {"reversal_window": 10, "risk_window": 40, "liquidity_fast_window": 10, "liquidity_slow_window": 60, "smooth_window": 3, "reversal_weight": 0.75, "liquidity_weight": 0.25, "min_cross_section": 8},
