  "factor_name": "Trend-Efficiency Risk-Adjusted Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(r20 / (0.01 + sum(abs(daily_return),20))) * (1 + clip(r60,-0.5,0.5))",
    "description": "Negative 20-day return divided by 20-day absolute-return path length, amplified mildly by the clipped 60-day anchor return. Higher values favor reversal of assets with inefficient recent directional movement, while avoiding division by near-zero path length."
  },
  "dependencies": ["close"],
  "parameters": {"return_window": 20, "path_window": 20, "anchor_window": 60, "path_floor": 0.01, "anchor_clip": [-0.5, 0.5]},
