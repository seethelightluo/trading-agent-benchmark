{
  "factor_id": "miner_1_20311211_dispersion_scaled_reversal_20d",
  "factor_name": "Cross-Asset Dispersion-Scaled 5-Day Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(close / close.shift(5) - 1) * rolling_mean(cross_sectional_std(daily_returns), 20)",
    "description": "Invert each asset's trailing 5-day return and scale the common reversal signal by the lagged 20-day mean cross-sectional dispersion of daily returns. The multiplier is common across assets on each date and therefore preserves the cross-sectional reversal ranking while conditioning its magnitude on market dispersion.",
    "signal_artifact": "scripts/miner_1_20311211_dispersion_scaled_reversal.py",
    "no_future_data": true
  },
  "dependencies": ["close", "daily_returns"],
  "parameters": {"lookback_days": 5, "dispersion_window_days": 20, "primary_forward_horizon_days": 20, "minimum_cross_section": 8},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2031-12-10",
    "last_validated": "2031-12-11",
    "metrics": {
      "ic": 0.01535853,
      "icir": 2.146634,
      "forward_horizon_days": 20,
      "dates": 2045,
      "average_instruments": 14.63,
      "coverage": 0.669107,
      "turnover": 0.181195,
      "hit_ratio": 0.5154,
