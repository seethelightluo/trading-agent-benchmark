{
  "factor_id": "dispersion_conditioned_reversal_20d",
  "factor_name": "Dispersion-Conditioned Relative Reversal 20D",
  "version": "1.0",
  "calculation": {
    "expression": "-((return_5d - cross_sectional_mean(return_5d)) / rolling_std(daily_return,20)) * (0.5 + percentile_rank_252(rolling_median_20(cross_sectional_std(return_20d))))",
    "description": "Risk-scaled five-day relative reversal, strengthened when the cross-asset 20-day return dispersion is elevated. All cross-sectional statistics use only information available at the signal date."
  },
  "dependencies": ["close"],
  "parameters": {
    "short_lookback_days": 5,
    "volatility_lookback_days": 20,
    "dispersion_return_lookback_days": 20,
    "dispersion_smoothing_days": 20,
    "dispersion_rank_lookback_days": 252,
    "minimum_rank_history_days": 60,
    "forward_validation_horizon_days": 20,
    "universe_size": 15
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2035-12-05",
    "validated_at": "2035-12-06T00:00:00Z",
    "regime_notes": "Validated across the full synthetic cross-asset history, including multiple trend, reversal, volatility, and dispersion regimes. Small cross-section requires conservative interpretation.",
    "metrics": {
      "ic": 0.00764373,
      "icir": 1.78735103,
      "hit_ratio": 0.5082,
      "valid_dates": 4797,
      "average_instruments": 14.999,
      "coverage": 0.995618,
