      "decay_ic_10d": 0.01181138,
      "decay_ic_40d": -0.00204292,
      "max_abs_library_correlation": null
    }
  },
  "signal_artifact": "scripts/miner_1_20351206_dispersion_conditioned_reversal_signal.csv",
  "tags": ["reversal", "cross-asset", "dispersion", "volatility-scaled"]
}
