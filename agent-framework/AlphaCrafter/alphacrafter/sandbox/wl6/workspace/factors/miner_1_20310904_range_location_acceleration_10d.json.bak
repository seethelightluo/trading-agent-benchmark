{
  "factor_id": "miner_1_range_location_acceleration_10d",
  "factor_name": "Range Location Acceleration 10d",
  "version": "1.0",
  "calculation": {
    "expression": "rolling_location(close,40) - rolling_location(close,40).shift(5), where rolling_location=(close-rolling_min(close,40))/(rolling_max(close,40)-rolling_min(close,40))",
    "description": "Measures the five-day acceleration in an asset's position within its trailing 40-day price range. Higher values identify upward range-location movement and lower values identify downward movement.",
    "signal_provenance": "scripts/miner_1_20310904_range_location_acceleration.py"
  },
  "dependencies": ["close"],
  "parameters": {
    "range_window": 40,
    "acceleration_window": 5,
    "forward_horizon": 10,
    "minimum_cross_section": 8
  },
  "validation": {
