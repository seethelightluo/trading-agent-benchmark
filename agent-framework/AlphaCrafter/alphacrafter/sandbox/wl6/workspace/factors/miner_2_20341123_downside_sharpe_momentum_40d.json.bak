{
  "factor_id": "miner_2_20341123_downside_sharpe_momentum_40d",
  "factor_name": "Downside-risk-adjusted 30-day momentum",
  "version": "20341123",
  "calculation": {
    "expression": "shift(rolling_sum(return,30) / rolling_mean(abs(return where return<0),30), 1), cross_sectionally median-centered",
    "description": "Ranks assets by 30-session cumulative momentum divided by their mean absolute negative daily return over the same window. The signal is lagged one completed session and median-centered to prevent look-ahead bias and remove common level."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "lookback_days": 30,
    "downside_window": 30,
    "minimum_return_observations": 15,
    "minimum_downside_observations": 8,
    "signal_lag_days": 1,
    "forecast_horizon_days": 40
  },
