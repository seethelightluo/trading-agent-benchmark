{
  "factor_id": "risk_adjusted_reversal_20d",
  "factor_name": "20-day volatility-scaled contrarian reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-pct_change(close,20) / (std(pct_change(close,1),20) * sqrt(20))",
    "description": "Ranks assets higher when their 20-session return is more negative after normalization by realized 20-session volatility, targeting medium-horizon mean reversion.",
