{
  "factor_id": "miner_1_relative_trend_quality_10d",
  "factor_name": "Relative Trend Quality with Short-Term Confirmation",
  "version": "1.0",
  "calculation": {
    "expression": "sum(pct_change(close),20)/(std(pct_change(close),40)*sqrt(20)) + 0.25*sum(pct_change(close),5)/(std(pct_change(close),10)*sqrt(5))",
    "description": "A 20-day volatility-adjusted trend score augmented by a 5-day volatility-adjusted confirmation term. Cross-sectional ranks are used for portfolio signals. Inputs are lag-safe and use data through the completed observation date only."
  },
  "dependencies": ["close"],
  "parameters": {"trend_window": 20, "trend_vol_window": 40, "confirmation_window": 5, "confirmation_vol_window": 10, "confirmation_weight": 0.25, "forward_horizon_days": 10},
  "validation": {
    "status": "EFFECTIVE",
    "period": {"start": "2020-01-01", "end": "2028-11-29"},
    "metrics": {
      "ic": 0.022963,
      "icir": 1.1281,
      "hit_ratio": 0.5297,
      "valid_dates": 2254,
      "average_instruments": 13.87,
      "coverage": 0.9246,
      "turnover": null,
      "decay": {"1d_ic": -0.004186, "5d_ic": 0.006021, "10d_ic": 0.022963},
      "max_abs_library_correlation": null
    },
    "regime_notes": "10-day IC was positive in 2020-2022 (+0.038172), slightly negative in 2023-2024 (-0.003057), and positive in 2025-2026 (+0.022375) and 2027-2028 (+0.028244). Small 15-asset cross-section warrants conservative weighting."
  },
