{
  "factor_id": "miner_3_vol_scaled_consistency_40d",
  "factor_name": "Volatility-scaled 40-day return-sign consistency",
  "version": "1.0",
  "calculation": {
    "expression": "shift_1((mean(sign(return)>0,40)-0.5)/(std(return,20)*sqrt(252)))",
    "description": "For each tradable benchmark instrument, measure the fraction of positive daily returns over the trailing 40 sessions, center it at neutral breadth, and scale by trailing 20-day annualized volatility. The one-session lag prevents look-ahead. Higher values indicate persistent positive direction with lower recent noise."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "consistency_window": 40,
    "volatility_window": 20,
    "annualization": 252,
    "lag": 1,
    "minimum_cross_section": 8
  },
