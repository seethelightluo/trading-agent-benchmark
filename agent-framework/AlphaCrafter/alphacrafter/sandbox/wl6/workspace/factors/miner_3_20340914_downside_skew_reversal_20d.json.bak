{
  "factor_id": "miner_3_20340914_downside_skew_reversal_20d",
  "factor_name": "Downside-Skew Risk-Normalized Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-demean_cs((sum(ret,10)/(sqrt(mean(ret^2 where ret<0,20))*sqrt(10))))",
    "description": "Compute each asset's 10-session cumulative return normalized by its 20-session downside semideviation and sqrt(10), subtract the cross-sectional median, invert for contrarian reversal, and lag one completed session. Higher values indicate stronger downside-skew-adjusted recent losers and are expected to outperform over 20 sessions."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "return_window": 10,
    "downside_window": 20,
    "minimum_return_observations": 7,
    "minimum_downside_observations": 10,
    "cross_section_center": "median",
    "lag_sessions": 1,
    "forward_horizon": 20
  },
