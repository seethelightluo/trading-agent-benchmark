{
  "factor_id": "miner_3_dxy_shock_reversal_1d",
  "factor_name": "DXY shock-conditioned cross-asset reversal",
  "version": "1.3",
  "calculation": {
    "expression": "-lagged_asset_return_1d / lagged_20d_asset_volatility * clip((abs(lagged_DXY_return_1d / lagged_60d_DXY_volatility)-0.75)/1.75, 0, 1)",
    "description": "After an unusually large prior-day DXY move, rank the 15 tradable benchmark assets by volatility-scaled reversal of their prior-day return. All inputs are lagged one completed session; DXY is observation-only."
  },
  "dependencies": [
    "close",
    "DXY close"
  ],
  "parameters": {
    "asset_return_lag_days": 1,
    "asset_volatility_window": 20,
