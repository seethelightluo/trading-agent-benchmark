{
  "factor_id": "miner_2_20290823_tail_adjusted_momentum_10d",
  "factor_name": "Tail-Risk-Adjusted Momentum with Drawdown Penalty",
  "version": "1.0",
  "calculation": {
    "expression": "(close/close.shift(30)-1)/(0.015+sqrt(mean(min(pct_change(close),0)^2,30)))*(1-min(max(0,1-close/rolling_max(close,30)),0.8))",
    "description": "Thirty-day momentum is divided by a downside-tail volatility estimate and reduced for the current 30-day drawdown. All inputs are lagged through the prior completed close at decision time."
  },
  "dependencies": ["close"],
  "parameters": {
    "momentum_window": 30,
    "downside_vol_window": 30,
    "downside_vol_floor": 0.015,
    "drawdown_window": 30,
    "drawdown_penalty_cap": 0.8,
    "forward_horizon_days": 10,
    "minimum_cross_section": 8
  },
  "validation": {
