{
  "factor_id": "miner_3_momentum_acceleration_10d",
  "factor_name": "20-day Momentum Acceleration",
  "version": "1.0",
  "calculation": {
    "expression": "sum(return,20) - 20 * mean(return[t-60:t-20])",
    "description": "Cross-asset signal measuring recent 20-session cumulative momentum relative to the preceding 40-session average daily return, using only completed sessions. Higher values indicate strengthening momentum; lower values indicate weakening momentum."
