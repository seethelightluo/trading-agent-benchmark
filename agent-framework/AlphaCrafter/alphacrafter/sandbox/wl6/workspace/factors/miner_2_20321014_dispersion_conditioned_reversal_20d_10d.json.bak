{
  "factor_id": "miner_2_20321014_dispersion_conditioned_reversal_20d_10d",
  "factor_name": "Cross-Asset Dispersion-Conditioned 20-Day Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(close/lag(close,20)-1) * (1 + 0.5 * I[mean_i(std_5(pct_change(close_i))) > rolling_median(mean_i(std_5(pct_change(close_i))),120)])",
    "description": "Ranks assets by negative trailing 20-session return and increases reversal exposure by 50 percent when the cross-asset average five-day realized volatility is above its trailing 120-session median. The dispersion/regime statistic is observation-only and no macro or non-tradable asset is ordered.",
    "signal_artifact": "scripts/miner_2_20321014_dispersion_conditioned_reversal.py"
  },
  "dependencies": ["close"],
  "parameters": {
    "lookback_sessions": 20,
    "cross_asset_volatility_window_days": 5,
    "regime_median_window_days": 120,
    "regime_min_periods": 60,
    "stress_multiplier": 0.5,
    "forward_horizon_sessions": 10,
    "minimum_cross_section": 8
  },
