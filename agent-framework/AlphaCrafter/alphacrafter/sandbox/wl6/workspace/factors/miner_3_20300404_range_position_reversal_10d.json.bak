{
  "factor_id": "miner_3_20300404_range_position_reversal_10d",
  "factor_name": "Risk-Scaled Range-Position Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(((close - rolling_min(close,60)) / (rolling_max(close,60)-rolling_min(close,60)) - 0.5) * 2 + return_20d / (sqrt(20)*std_20d)) / 2",
