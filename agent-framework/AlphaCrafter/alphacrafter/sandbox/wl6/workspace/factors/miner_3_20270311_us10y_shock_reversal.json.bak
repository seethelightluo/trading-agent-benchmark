{
  "factor_id": "miner_3_us10y_shock_reversal_1d",
  "factor_name": "US10Y Shock-Conditioned Cross-Asset Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-lag1(asset_return) / lag1(rolling_std(asset_return,20)) * I(abs(zscore(lag1(US10Y_return),60)) > 1.5)",
    "description": "For each tradable benchmark asset, rank volatility-scaled one-day reversal only on the next decision date after an unusually large US10Y return shock. All inputs are lagged completed-day observations. The US10Y series is treated as a tradable benchmark input, not an order restriction."
  },
  "dependencies": [
    "close",
    "US10Y close"
  ],
  "parameters": {
    "asset_vol_window": 20,
    "macro_zscore_window": 60,
    "macro_min_periods": 40,
    "shock_threshold": 1.5,
    "forward_horizons_days": [
      1,
      5,
      10
    ]
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2027-03-10",
