{
  "factor_id": "miner_3_relative_residual_momentum_20d",
  "factor_name": "Cross-sectional Relative Residual Risk-adjusted Momentum",
  "version": "1.0",
  "calculation": {
    "expression": "(return_20d - cross_sectional_median(return_20d)) / (rolling_std(daily_returns,40) * sqrt(20))",
    "description": "At each date, subtract the median 20-trading-day return across the 15 tradable benchmark instruments, then scale the relative momentum by each instrument's trailing 40-day realized volatility. Uses only data available through the completed date."
  },
  "dependencies": [
    "close",
    "daily_returns"
  ],
  "parameters": {
    "momentum_window": 20,
    "volatility_window": 40,
    "minimum_cross_section": 8,
    "forward_horizon": 10
  },
