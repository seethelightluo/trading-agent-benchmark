{
  "factor_id": "miner_1_cn10y_shock_reversal_1d",
  "factor_name": "CN10Y shock-conditioned volatility-scaled cross-asset reversal",
  "version": "1.0",
  "calculation": {
    "expression": "clip(-asset_return_1d / lagged_20d_asset_return_std, -3, 3) * clip(abs(lagged_CN10Y_return) / lagged_60d_CN10Y_return_std, 0, 3)",
    "description": "For each tradable benchmark asset, fade its prior completed-session return after scaling by its lagged 20-session return volatility. Multiply by the prior CN10Y absolute return shock normalized by lagged 60-session CN10Y volatility. All rolling statistics and macro inputs are lagged; values are clipped for robustness. Positive scores indicate expected higher forward return."
  },
  "dependencies": [
    "close",
    "CN10Y.close"
  ],
  "parameters": {
    "asset_return_window": 1,
    "asset_volatility_window": 20,
    "macro_volatility_window": 60,
    "asset_volatility_min_periods": 15,
    "macro_volatility_min_periods": 40,
    "asset_signal_clip": [
      -3,
      3
    ],
    "macro_shock_clip": [
      0,
      3
    ],
    "horizon_days": 1,
    "universe_size": 15
  },
