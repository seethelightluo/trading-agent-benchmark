  "factor_name": "Volatility-compression 20-day reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-return(close,10) * rolling_std(return(close,1),10) / rolling_std(return(close,1),60)",
    "description": "Ranks assets that have recently fallen over 10 sessions and whose short-term volatility is compressed relative to 60-session volatility; lower recent returns receive positive reversal scores, scaled by the compression ratio. Signals use only data available at the cutoff."
