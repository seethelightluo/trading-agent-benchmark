  "factor_name": "Cross-Asset Dispersion-Gated Volatility-Normalized Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "(-return(close,5) / rolling_std(pct_change(close),20)) * clip(cross_sectional_dispersion_20d / rolling_median(cross_sectional_dispersion_20d,120), 0.5, 2.5)",
    "description": "Contrarian five-day return normalized by instrument volatility, amplified or attenuated by the contemporaneous cross-asset dispersion regime. Dispersion is the 20-day rolling mean of the cross-sectional standard deviation of daily returns; all inputs are point-in-time.",
