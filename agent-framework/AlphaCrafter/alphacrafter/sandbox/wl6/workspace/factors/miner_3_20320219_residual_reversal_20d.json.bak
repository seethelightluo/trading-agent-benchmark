{
  "factor_id": "miner_3_20320219_residual_reversal_20d",
  "factor_name": "Risk-scaled cross-asset residual reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-rolling_sum_10(residual_return) / (rolling_std_40(residual_return) * sqrt(10) + 1e-12)",
    "description": "For each tradable asset, estimate a 60-day rolling beta to the equal-weight mean daily return of the 15-asset tradable universe, subtract beta times benchmark return from asset return, and reverse the 10-day cumulative residual move. Scale by 40-day residual volatility. Higher values indicate stronger risk-scaled residual mean-reversion potential.",
    "signal_artifact": "scripts/miner_3_20320219_residual_reversal.py"
  },
  "dependencies": ["close"],
  "parameters": {
    "universe": 15,
    "benchmark": "equal_weight_mean_daily_return",
    "beta_window": 60,
    "beta_min_periods": 30,
    "residual_return": "asset_return - rolling_beta * benchmark_return",
    "signal_window": 10,
    "residual_volatility_window": 40,
    "residual_vol_min_periods": 20,
    "primary_forward_horizon_days": 20,
    "minimum_cross_section": 8
  },
  "validation": {
