{
  "factor_id": "miner_2_20290208_residual_downside_momentum_10d",
  "factor_name": "Cross-Sectional Residual Momentum over Downside Volatility",
  "version": "1.0",
  "calculation": {
    "expression": "(return_20d(asset) - cross_sectional_median(return_20d)) / downside_volatility_60d",
    "description": "For each tradable asset, subtract the same-date universe median 20-day return and divide by the asset's trailing 60-day downside return volatility annualized by sqrt(252). Signals use only completed observations through the signal date."
  },
  "dependencies": ["close", "pct_change"],
  "parameters": {
    "momentum_window_days": 20,
    "downside_volatility_window_days": 60,
    "annualization": 252,
    "forward_horizon_days": 10,
    "minimum_cross_section": 8,
    "universe_size": 15
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 to 2029-02-07",
    "validated_on": "2029-02-08",
    "metrics": {
