{
  "factor_id": "miner_1_20311113_short_reversal_volnorm_5d",
  "factor_name": "Volatility-Normalized 5-Day Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(close_t/close_{t-5}-1)/rolling_std(pct_change(close),20,min_periods=10)",
    "description": "Ranks each tradable benchmark by the negative of its trailing 5-day return divided by trailing 20-day daily-return volatility. Higher values indicate stronger short-horizon reversal after volatility normalization. Every input ends at the signal date.",
    "direction": "positive",
    "provenance_script": "scripts/miner_1_20311113_short_reversal_volnorm.py",
    "signal_artifact": "Reconstructable from ../persistent/stock_data/{symbol}.csv using the exact 15-asset universe and expression; validation signal cutoff 2031-10-29."
  },
  "dependencies": ["close", "daily_returns"],
  "parameters": {
    "return_window_days": 5,
    "volatility_window_days": 20,
    "volatility_min_periods": 10,
    "forward_validation_horizon_days": 5
  },
