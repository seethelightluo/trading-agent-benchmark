{
  "factor_id": "miner_3_20340413_peer_residual_reversal_10d",
  "factor_name": "Risk-scaled peer-residual reversal (10-day lookback, 20-day horizon)",
  "version": "1.0",
  "calculation": {
    "expression": "-(return_10d_i - cross_sectional_mean(return_10d)) / (rolling_std_daily_return_20d_i * sqrt(20))",
    "description": "Ranks assets that underperformed the contemporaneous equal-weight 15-asset basket over 10 days, favoring volatility-scaled mean reversion over the validated 20-day forward horizon. Signal uses prices through the prior completed day."
  },
  "dependencies": ["close"],
  "parameters": {"lookback_days": 10, "volatility_window_days": 20, "horizon_days": 20, "minimum_cross_section_names": 8},
  "validation": {
