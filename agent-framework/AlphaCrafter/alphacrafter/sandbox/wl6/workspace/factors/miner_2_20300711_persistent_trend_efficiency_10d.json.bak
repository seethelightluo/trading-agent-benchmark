{
  "factor_id": "miner_2_20300711_persistent_trend_efficiency_10d",
  "factor_name": "Persistent Trend Efficiency",
  "version": "1.0",
  "calculation": {
    "expression": "(return(close,40)/(annualized_std(daily_return,40)+1e-8))*(1+0.8*(mean(I[daily_return>0],40)-0.5))",
    "description": "Ranks instruments by 40-session volatility-adjusted momentum, amplified when the trailing daily return signs show persistent upward participation. The signal uses only prices through the evaluated date and is intended for a 10-session forward horizon.",
    "source_script": "scripts/miner_2_20300711_persistent_trend_efficiency_10d.py",
    "signal_artifact": "computed directly from the close panel in the source script; no future observations are used"
  },
  "dependencies": ["close", "daily_returns"],
  "parameters": {
    "momentum_window": 40,
    "volatility_window": 40,
    "persistence_window": 40,
    "persistence_amplifier": 0.8,
    "annualization": 252,
    "epsilon": 1e-8,
    "forward_horizon_sessions": 10,
    "minimum_cross_section": 8,
    "universe_size": 15
  },
  "signal_provenance": {
    "artifact_type": "research_script",
    "script": "scripts/miner_2_20300711_persistent_trend_efficiency_10d.py",
    "signal_definition": "f=(P.pct_change(40)/(P.pct_change(1).rolling(40).std()*sqrt(252)+epsilon))*(1+0.8*(P.pct_change(1).gt(0).rolling(40).mean()-0.5))",
    "forward_return_definition": "close.shift(-10)/close - 1",
    "cross_sectional_statistic": "Spearman rank correlation",
    "tradable_universe": ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
  },
  "validation": {
    "status": "EFFECTIVE",
    "validated_at": "2030-07-11T00:00:00Z",
    "last_validated": "2030-07-11",
    "period": "2020-01-02 through 2030-07-10",
    "metrics": {
      "admission_horizon_days": 10,
