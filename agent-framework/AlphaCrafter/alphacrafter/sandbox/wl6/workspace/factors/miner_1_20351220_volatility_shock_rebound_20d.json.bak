{
  "factor_id": "miner_1_20351220_volatility_shock_rebound_20d",
  "factor_name": "Volatility-Shock Relative Rebound 20D",
  "version": "1.0",
  "calculation": {
    "expression": "-(r5 - cross_sectional_mean(r5)) / vol20 * clip(vol20 / vol120, 0.5, 3.0)",
    "description": "Fade five-day cross-sectional relative losers and favor relative winners after a volatility shock, with risk scaling by 20-day volatility and a 20/120-day volatility ratio clipped to limit instability. All inputs are lagged through the signal date."
  },
  "dependencies": ["close"],
  "parameters": {"short_return_days": 5, "short_vol_days": 20, "baseline_vol_days": 120, "shock_clip_lower": 0.5, "shock_clip_upper": 3.0, "admission_horizon_days": 20},
