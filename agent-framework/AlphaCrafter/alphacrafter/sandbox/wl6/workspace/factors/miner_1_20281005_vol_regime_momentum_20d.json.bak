{
  "factor_id": "miner_1_vol_regime_momentum_20d",
  "factor_name": "Volatility-Regime-Adjusted 20-Day Momentum",
  "version": "1.0",
  "calculation": {
    "expression": "sum(return[t-19:t]) / (std(return[t-39:t]) * sqrt(20)) / clip(std(return[t-19:t]) / std(return[t-79:t]), 0.25, 4.0)",
    "description": "Uses completed-session 20-day cumulative return, scaled by 40-day realized volatility and adjusted by the inverse ratio of recent 20-day volatility to 80-day volatility. The signal is lagged naturally by using data through the decision day's last completed session; lower recent volatility relative to its 80-day baseline receives a higher momentum score. No forward data enters the signal."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "momentum_window": 20,
    "risk_window": 40,
    "recent_volatility_window": 20,
    "baseline_volatility_window": 80,
    "regime_ratio_clip": [
      0.25,
      4.0
    ],
    "forward_horizon": 10,
    "minimum_cross_section": 8
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2028-10-04",
