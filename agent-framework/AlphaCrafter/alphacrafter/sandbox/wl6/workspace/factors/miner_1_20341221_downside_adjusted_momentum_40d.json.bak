{
  "factor_id": "downside_adjusted_momentum_40d",
  "factor_name": "Downside-risk-adjusted 20-day momentum",
  "version": "1.0",
  "calculation": {
    "expression": "median_demean((close/shift(close,20)-1) / (sqrt(20)*rolling_std(negative_returns,20))).shift(1)",
    "description": "Ranks assets by prior 20-day return divided by downside-only 20-day realized volatility, lagged one session to prevent look-ahead, then cross-sectionally median demeaned. The validated target horizon is 40 trading days."
  },
  "dependencies": ["close", "daily_returns"],
  "parameters": {
    "formation_window": 20,
    "downside_volatility_window": 20,
    "minimum_observations": 15,
    "forward_horizon": 40,
    "lag_sessions": 1,
    "demean_method": "cross_sectional_median"
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2034-12-20",
    "last_validated": "2034-12-21T00:00:00Z",
    "metrics": {
