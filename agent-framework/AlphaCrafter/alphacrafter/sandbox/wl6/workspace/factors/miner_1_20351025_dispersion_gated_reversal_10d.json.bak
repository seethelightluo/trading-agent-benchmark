{
  "factor_id": "miner_1_dispersion_gated_reversal_10d",
  "factor_name": "Dispersion-Gated Volatility-Scaled Cross-Asset Reversal",
  "version": "2035-10-25",
  "calculation": {
    "expression": "shift1(where(std_cs(ret20) > rolling_median(std_cs(ret20),120), -(ret20-median_cs(ret20))/rolling_std(ret1,60), 0))",
    "description": "For each asset, take the negative cross-sectional deviation of 20-session return from the daily cross-sectional median, scale by its 60-session return volatility, and activate only when cross-sectional 20-session return dispersion exceeds its trailing 120-session median. Lag one completed session to prevent lookahead."
  },
  "dependencies": ["close"],
  "parameters": {"return_lookback": 20, "volatility_lookback": 60, "dispersion_window": 120, "signal_lag": 1, "forward_horizon": 10, "minimum_cross_section": 8},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-10-02 through 2035-10-24",
    "validated_at": "2035-10-25",
    "regime_notes": "Revalidated across 4,808 daily rows and 15 tradable cross-asset instruments; active on 2,340 dates. Strong positive 5D and 10D reversal IC, with predictive decay and slight negative 20D IC; intended only for 10-session decisions.",
    "metrics": {
      "ic": 0.01724666,
      "icir": 2.55810400,
      "horizon_days": 10,
      "valid_dates": 2329,
      "average_instruments": 13.140,
      "hit_ratio": 0.5208,
      "coverage": 0.9997920133,
      "active_cross_sections": 2340,
      "rank_turnover": 0.068994,
      "decay": {"5d_ic": 0.01528568, "10d_ic": 0.01724666, "20d_ic": -0.00084681},
      "max_abs_library_correlation": null
    }
  },
  "signal_artifact": "scripts/miner_1_20351025_dispersion_gated_reversal_signal.csv",
