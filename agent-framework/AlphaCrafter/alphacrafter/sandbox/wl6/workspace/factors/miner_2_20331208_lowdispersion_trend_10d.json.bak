{
  "factor_id": "miner_2_20331208_lowdispersion_trend_10d",
  "factor_name": "Low-dispersion volatility-normalized trend",
  "version": "1.0",
  "calculation": {
    "expression": "I(cross_sectional_daily_return_dispersion < rolling_median(dispersion,60)) * return(close,20) / (std(return(close,1),20)*sqrt(252))",
    "description": "Ranks assets by 20-day risk-adjusted trend only when cross-asset daily return dispersion is below its trailing 60-day median; otherwise emits zero. All inputs are available by the signal date."
  },
  "dependencies": ["close"],
  "parameters": {"trend_window": 20, "volatility_window": 20, "dispersion_window": 1, "gate_lookback": 60, "forward_horizon": 10},
