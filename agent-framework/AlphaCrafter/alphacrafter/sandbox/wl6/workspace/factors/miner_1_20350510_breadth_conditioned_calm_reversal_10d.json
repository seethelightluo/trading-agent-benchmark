  "factor_name": "Breadth-Conditioned Calm Relative Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-((return_20d - cross_sectional_median(return_20d)) / annualized_volatility_40d) * clip(1.5 - breadth_20d, 0.5, 1.5), lagged_1d",
