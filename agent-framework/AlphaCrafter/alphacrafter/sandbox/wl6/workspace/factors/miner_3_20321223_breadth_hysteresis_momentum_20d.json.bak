{
  "factor_id": "miner_3_20321223_breadth_hysteresis_momentum_20d",
  "factor_name": "Breadth-hysteresis 20-day momentum",
  "version": "1.0",
  "calculation": {
    "expression": "momentum_20d(asset) * regime_t, where regime_t=+1 after breadth>=0.55, regime_t=-1 after breadth<=0.45, and regime_t persists within (0.45,0.55)",
    "description": "Compute trailing 20-day return for each tradable asset. Cross-asset breadth is the fraction of valid assets with positive 20-day returns. Use continuation when breadth is at least 55%, reversal when breadth is at most 45%, and retain the prior regime in the neutral band to reduce switching near the threshold. Higher scores indicate stronger expected forward returns.",
    "signal_artifact": "scripts/miner_3_20321223_breadth_hysteresis_momentum_20d.py"
  },
  "dependencies": ["close"],
  "parameters": {"lookback_days": 20, "forward_validation_horizon_days": 20, "breadth_continuation_threshold": 0.55, "breadth_reversal_threshold": 0.45, "minimum_cross_section": 8},
  "validation": {
