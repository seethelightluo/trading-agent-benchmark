{
  "factor_id": "miner_1_vol_scaled_range_acceleration_10d",
  "factor_name": "Volatility-Scaled 40-Day Range Location Acceleration",
  "version": "1.0",
  "calculation": {
    "expression": "(rolling_location(close,40) - lag(rolling_location(close,40),5)) / rolling_std(pct_change(close),20)",
    "description": "Five-day acceleration in each asset's normalized 40-day price-range location, scaled by trailing 20-day annualized realized volatility. Positive values indicate efficient upward range movement relative to risk; negative values indicate downward movement. The signal uses only data available through the signal date."
  },
  "dependencies": ["close", "daily_return"],
  "parameters": {
    "range_window": 40,
    "acceleration_lag": 5,
    "volatility_window": 20,
    "volatility_annualization": 252,
    "primary_forward_horizon_days": 10,
    "minimum_cross_section": 8,
    "universe_size": 15
  },
