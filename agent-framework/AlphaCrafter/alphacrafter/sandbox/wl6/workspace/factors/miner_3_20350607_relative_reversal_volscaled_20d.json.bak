{
  "factor_id": "miner_3_relative_reversal_volscaled_20d",
  "factor_name": "Relative 5-day reversal scaled by 20-day volatility",
  "version": "1.0",
  "calculation": {
    "expression": "(-(pct_change(close,5)-cross_sectional_median(pct_change(close,5)))/(rolling_std(pct_change(close),20)+1e-8)).shift(1)",
    "description": "A lagged cross-asset contrarian signal. Assets that underperformed the contemporaneous five-day cross-sectional median receive higher scores, with the score scaled by trailing realized volatility. The one-session lag prevents use of information from the forecast day's close."
  },
  "dependencies": ["close"],
  "parameters": {
    "return_lookback_sessions": 5,
    "volatility_window_sessions": 20,
    "minimum_volatility_observations": 15,
    "cross_section": "15 tradable benchmark instruments",
    "minimum_valid_instruments_per_date": 8,
    "winsorization": null
  },
  "validation": {
