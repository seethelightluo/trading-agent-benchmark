{
  "factor_id": "miner_1_20300530_drawdown_rebound_10d",
  "factor_name": "Volatility-Adjusted Drawdown Rebound",
  "version": "1.0",
  "calculation": {
    "expression": "-(1-close/rolling_max(close,40)) + 0.5*pct_change(close,5)/(rolling_std(pct_change(close,1),20)*sqrt(20)+1e-12)",
    "description": "Ranks assets positively when they are below their 40-day peak, with a stabilizing five-day return scaled by 20-day realized volatility. Uses only information available at the signal date.",
    "source_script": "scripts/miner_1_20300530_drawdown_rebound.py",
    "signal_artifact": "recomputable_from_persistent_stock_data"
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "drawdown_peak_window": 40,
    "recent_return_window": 5,
    "volatility_window": 20,
    "volatility_scale": "sqrt(20)",
    "rebound_weight": 0.5,
    "epsilon": 1e-12
  },
