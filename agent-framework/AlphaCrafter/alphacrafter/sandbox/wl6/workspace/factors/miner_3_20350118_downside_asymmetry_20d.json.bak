  "factor_id": "downside_asymmetry_20d",
  "factor_name": "Lagged Downside Variance Share",
  "version": "1.0",
  "calculation": {
    "expression": "shift(rolling_sum(min(log_return,0)^2,20) / rolling_sum(log_return^2,20),1)",
