{
  "factor_id": "miner_2_20350705_downside_adjusted_trend_reversal_10d",
  "factor_name": "Downside-adjusted trend reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-((sum_return_40d / stdev_return_30d) * upside_volatility_30d / downside_volatility_30d * clip(1 + drawdown_from_60d_high, lower=0.25)).shift(1)",
    "description": "Contrarian cross-sectional signal using 40-day risk-adjusted return, scaled by the ratio of upside to downside volatility and moderated by drawdown from the 60-day high. The complete signal is lagged one session to prevent look-ahead bias; larger values indicate stronger expected forward returns."
  },
  "dependencies": ["close", "daily_returns"],
  "parameters": {
    "return_window": 40,
    "volatility_window": 30,
    "drawdown_window": 60,
    "minimum_return_observations": 25,
    "minimum_volatility_observations": 20,
    "minimum_drawdown_observations": 40,
    "forward_horizon_days": 10,
    "lag_sessions": 1,
    "cross_section_minimum": 8
  },
  "validation": {
    "status": "EFFECTIVE",
    "timestamp": "2035-07-05T00:00:00Z",
    "period": "2020-01-01 through 2035-04-11",
    "regime_notes": "Validated over the 15-instrument synthetic cross-asset universe. Positive at 5D, 10D and 20D horizons; 10D selected for admission. Small cross-section requires conservative interpretation. 40D reversal sign was unstable.",
