{
  "factor_id": "miner_2_20310904_relative_residual_reversal_20d",
  "factor_name": "Volatility-Scaled Relative Residual Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(return_20d(asset) - cross_sectional_median(return_20d)) / rolling_std(daily_return,20)",
    "description": "Ranks assets for 20-session cross-sectional residual reversal, with the residual scaled by each asset's trailing 20-session realized volatility. Higher values indicate relatively underperforming assets expected to mean-revert. All inputs are available at the signal date and no future data are used."
  },
  "dependencies": [
    "close",
    "daily_return"
  ],
  "parameters": {
    "lookback_sessions": 20,
    "volatility_window": 20,
    "minimum_cross_section": 8,
    "universe_size": 15,
    "primary_forward_horizon_sessions": 20
  },
