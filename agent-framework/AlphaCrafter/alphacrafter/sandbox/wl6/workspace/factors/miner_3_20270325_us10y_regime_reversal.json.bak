{
  "factor_id": "miner_3_us10y_regime_reversal_1d",
  "factor_name": "US10Y Moderate-or-Extreme Regime Volatility-Scaled Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "(-asset_return[t-1] / rolling_std(asset_return,20)[t-1]) * I(abs(zscore(US10Y_return,60)[t-1]) > 0.75)",
    "description": "Ranks tradable assets for next-day cross-sectional reversal using lagged one-day return normalized by lagged 20-day volatility, activated when lagged US10Y return is in a moderate or extreme standardized-move regime. All inputs are lagged to avoid look-ahead bias.",
    "signal_artifact": "scripts/miner_3_20270325_us10y_regime_reversal.py"
  },
  "dependencies": [
    "close",
    "US10Y close"
  ],
