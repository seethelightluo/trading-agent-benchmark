{
  "factor_id": "miner_3_20351206_dispersion_gated_reversal_10d",
  "factor_name": "Dispersion-gated relative short-term reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-((return_5d - cross_sectional_mean(return_5d)) / realized_volatility_20d) * clip(cross_sectional_dispersion_5d / rolling_median(cross_sectional_dispersion_5d,120d), 0.5, 2.0)",
    "description": "Ranks assets for short-horizon reversal using volatility-scaled five-day residual returns, with stronger exposure when cross-sectional dispersion is elevated relative to its 120-day median."
  },
  "dependencies": ["close", "daily_returns"],
  "parameters": {"return_window": 5, "volatility_window": 20, "dispersion_baseline_window": 120, "dispersion_min_periods": 60, "gate_floor": 0.5, "gate_ceiling": 2.0, "forward_horizon": 10},
