{
  "factor_id": "miner_2_20351220_downside_vol_trend_20d",
  "factor_name": "Breadth-Regime Downside-Volatility-Scaled Relative Trend 20D",
  "version": "1.0",
  "calculation": {
    "expression": "((ret_10 - cross_sectional_mean(ret_10)) / downside_vol_20) * regime, where regime=-1 if breadth(ret_10>0)<0.5 else +1",
    "description": "Ranks 10-day relative trend after scaling by trailing downside volatility. In broad-negative regimes the sign is reversed to favor relative recovery/defensive rotation; in broad-positive regimes it follows relative trend. All calculations use information available at the close of the prior completed day."
  },
  "dependencies": ["close", "daily_returns"],
  "parameters": {"return_lookback": 10, "downside_volatility_window": 20, "breadth_threshold": 0.5, "forward_horizon_days": 20, "minimum_cross_section": 8},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2035-12-19",
    "validated_at": "2035-12-20T00:00:00",
