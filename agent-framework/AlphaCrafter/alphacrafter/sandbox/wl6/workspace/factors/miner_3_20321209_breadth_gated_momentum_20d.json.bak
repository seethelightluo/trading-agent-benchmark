{
  "factor_id": "miner_3_20321209_breadth_gated_momentum_20d",
  "factor_name": "Cross-Asset Breadth-Gated 20-Day Momentum",
  "version": "1.0",
  "calculation": {
    "expression": "(close_t/close_{t-20}-1) * sign(cross_asset_breadth_20d_t - 0.5)",
    "description": "Compute each asset's trailing 20-trading-day return. If at least half of the valid tradable universe has positive 20-day returns, retain momentum direction; otherwise invert it to favor relative losers during broadly weak conditions. Breadth and momentum use only data through the signal date.",
    "provenance_script": "scripts/miner_3_20321209_breadth_gated_momentum_20d.py",
    "signal_artifact": "Reconstructable from ../persistent/stock_data/{symbol}.csv with the exact 15-asset universe in parameters. Signal cutoff for validation is 2032-12-08; forward returns are labels only."
  },
  "dependencies": ["close", "daily_returns"],
  "parameters": {
    "momentum_window_days": 20,
    "breadth_window_days": 20,
    "breadth_threshold": 0.5,
    "minimum_cross_section": 8,
    "universe": ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
