{
  "factor_id": "miner_3_range_location_momentum_20d",
  "factor_name": "Volatility-Adjusted Momentum with Range Location Confirmation",
  "version": "1.0",
  "calculation": {
    "expression": "(sum(pct_change(close),20)/(std(pct_change(close),40)*sqrt(20))) * (0.5 + clip((close-rolling_min(close,60))/(rolling_max(close,60)-rolling_min(close,60)),0,1))",
    "description": "Ranks assets by 20-day cumulative return scaled by 40-day realized volatility, amplified when price is high within its trailing 60-day range. All inputs are lagged to the last completed observation at decision time."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "momentum_window": 20,
    "volatility_window": 40,
    "range_window": 60,
    "location_floor": 0.5,
    "location_cap": 1.5,
    "forward_horizon_days": 10
  },
