{
  "factor_id": "miner_2_20300905_breadth_gated_recovery_10d",
  "factor_name": "Breadth-Gated Drawdown Recovery Acceleration",
  "version": "1.0",
  "calculation": {
    "expression": "((-drawdown_120 + 0.50 * return_10d) / realized_vol_30d) * (0.5 + clip(cross_asset_breadth_20d_lag1, 0, 1))",
    "description": "Ranks assets by risk-scaled recovery evidence while conditioning the signal on lagged cross-asset breadth; breadth is the fraction of the 15 tradable assets with positive 20-day return. All inputs are lagged or completed-day observations at decision time."
  },
  "dependencies": ["close", "pct_change", "rolling_max", "realized_volatility", "cross_asset_prices"],
  "parameters": {"drawdown_window": 120, "recovery_window": 10, "volatility_window": 30, "recovery_weight": 0.5, "breadth_window": 20, "breadth_lag": 1, "min_cross_section": 8, "horizon_days": 10},
  "validation": {
    "status": "EFFECTIVE",
    "period": {"start": "2026-01-23", "end": "2030-09-04"},
    "metrics": {
      "ic": 0.01051178,
      "icir": 1.40273,
      "forward_horizon_days": 10,
      "valid_dates": 1063,
      "average_instruments": 14.996,
      "coverage": 0.999749,
      "turnover_proxy": 0.0285760,
      "ic_hit_ratio": 0.50141,
      "decay_ic_5d": 0.01056771,
      "decay_ic_20d": 0.01499074,
      "max_abs_library_correlation": null
    },
    "regime_notes": "Positive annual mean IC in 2026, 2027, 2028 and 2030 YTD; negative in 2029, so the factor is regime-sensitive. Conservative interpretation is warranted given the 15-asset cross-section.",
