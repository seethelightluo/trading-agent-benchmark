{
  "factor_id": "miner_3_stress_conditioned_reversal_3d",
  "factor_name": "Cross-asset stress-conditioned three-day reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-sum(asset_returns,3) * I[lagged_cross_asset_MAD > lagged_60d_MAD_75th_percentile], with signal evaluated after completed day t",
    "description": "Applies a short-horizon cross-sectional reversal signal only when lagged cross-asset return dispersion is above its lagged 60-trading-day 75th percentile. The dispersion regime test is lagged, and forward returns begin on t+1. Zero is emitted outside stress, so the factor is explicitly conditional rather than a continuous reversal."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "reversal_window_days": 3,
    "dispersion_measure": "cross-sectional mean absolute deviation of daily returns",
    "dispersion_window_days": 60,
    "stress_quantile": 0.75,
    "dispersion_lag_days": 1,
    "signal_lag_days": 1,
    "forward_horizon_days": 1,
    "minimum_cross_section": 8
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": {
      "start": "2020-01-01",
      "end": "2028-07-26"
    },
