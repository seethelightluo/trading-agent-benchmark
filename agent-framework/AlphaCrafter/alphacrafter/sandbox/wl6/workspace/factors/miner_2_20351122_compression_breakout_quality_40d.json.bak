  "factor_name": "Volatility-Compression Breakout Quality 40D",
  "version": "2035-11-22",
  "calculation": {
    "expression": "cross_sectional_demean(((close/close.shift(20)-1)/rolling_std(pct_change(close),20)) * clip(rolling_std(pct_change(close),60)/rolling_std(pct_change(close),20),0.25,4.0))",
    "description": "Ranks 20-day trend by recent risk, with a multiplicative preference for instruments whose 60-day volatility exceeds their 20-day volatility; the daily cross-sectional mean is removed. Higher values indicate stronger, volatility-conditioned medium-term continuation quality."
  },
  "dependencies": ["close"],
  "parameters": {"momentum_window": 20, "short_vol_window": 20, "long_vol_window": 60, "compression_clip": [0.25, 4.0], "forward_horizon_days": 40},
