{
  "factor_id": "miner_2_20300502_intraday_recovery_quality_10d",
  "factor_name": "Intraday Recovery Quality 10D",
  "version": "1.0",
  "calculation": {
    "expression": "rolling_mean_10((0.65*CLV + 0.35*(2*recovery_from_low-1)) conditional on negative daily return, otherwise 0.25*CLV) / rolling_std_20(daily_return)",
    "description": "Measures persistent close recovery and close location after weak sessions, risk-normalized by 20-day realized volatility. Positive values favor assets showing resilient intraday recovery with lower risk. The signal is computed using data available through each decision date only."
  },
  "dependencies": ["open", "high", "low", "close"],
  "parameters": {"signal_window_days": 10, "risk_window_days": 20, "forward_horizon_days": 10, "clv_weight": 0.65, "recovery_weight": 0.35, "positive_day_clv_weight": 0.25},
  "validation": {
    "status": "EFFECTIVE",
    "timestamp": "2030-05-02T00:00:00Z",
    "period": "2020-01-01 through 2030-05-02 available history",
    "universe_size": 15,
    "valid_date_observations": 1756,
    "metrics": {
      "daily_paper_ic": 0.03496401696602662,
      "daily_paper_icir": 0.12079903358354566,
      "ic_hit_ratio": 0.5398633257403189,
      "ic_std": 0.28943954209471723,
      "coverage": "valid cross-sections required at least 8 of 15; exact per-asset aggregate not emitted by script",
      "turnover": "not emitted",
      "decay_ic_5d": 0.028900941134336576,
      "decay_ic_20d": 0.03168498808923152,
      "max_abs_library_correlation": null
    },
    "gates": {"absolute_ic_threshold": 0.007, "absolute_icir_threshold": 0.084, "passed": true},
    "regime_notes": "Positive predictive association is observed at 5D, 10D, and 20D horizons; uncertainty remains material because the cross-section is only 15 instruments."
  },
  "signal_artifact": {"script": "scripts/miner_2_20300502_intraday_recovery_quality_10d.py", "artifact_type": "reproducible_signal_definition", "lookahead_safe": true},
  "dependencies_data": "Daily OHLC prices for the 15 tradable benchmark instruments",
  "tags": ["intraday", "recovery", "quality", "risk-adjusted", "cross-asset"],
  "last_validated": "2030-05-02"
}