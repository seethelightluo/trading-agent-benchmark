{
  "factor_id": "miner_2_20300516_volume_confirmed_recovery_10d",
  "factor_name": "Volume-Confirmed Recovery Quality 10D",
  "version": "1.0",
  "calculation": {
    "expression": "rolling_mean_10(CLV * clip(volume / rolling_median(volume,30), upper=3) on down-return days, else 0) / rolling_std_20(daily_return)",
    "description": "Average close-location recovery quality on negative-return sessions, strengthened by abnormal but capped volume and normalized by recent realized volatility. All rolling inputs are lag-safe at each signal date."
  },
  "dependencies": ["open", "close", "high", "low", "volume"],
  "parameters": {"signal_window": 10, "volume_window": 30, "volatility_window": 20, "volume_cap": 3.0, "forward_horizon": 10},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2030-05-16 available history",
    "last_validated": "2030-05-16",
    "metrics": {
      "daily_paper_ic": 0.0551378586,
      "daily_paper_icir": 0.1682205593,
      "ic_hit_ratio": 0.5688259109,
      "ic_std": 0.3277712236,
      "valid_ic_dates": 1482,
      "average_instruments": 15,
      "minimum_instruments": 8,
      "coverage": 0.8233,
      "turnover": null,
      "decay_ic_5d": 0.0483742019,
      "decay_ic_20d": 0.0541096789,
      "max_abs_library_correlation": null
    },
    "regime_notes": "Broad 15-instrument cross-asset sample; conservative interpretation due to small daily cross-section. Positive IC remained positive at 5D, 10D, and 20D horizons.",
    "signal_provenance": {
      "script": "scripts/miner_2_20300516_volume_confirmed_recovery_10d.py",
      "source_universe": "15 tradable benchmark instruments",
      "lookahead_safe": true,
      "forward_return": "close[t+h]/close[t]-1"
    }
  },
  "tags": ["recovery", "volume", "volatility_scaled", "cross_asset"],
  "last_validated": "2030-05-16"
}