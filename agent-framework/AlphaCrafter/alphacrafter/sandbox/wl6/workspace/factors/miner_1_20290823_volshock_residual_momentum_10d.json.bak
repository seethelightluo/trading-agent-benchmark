{
  "factor_id": "volshock_residual_momentum_10d",
  "factor_name": "Volatility-Shock Amplified Residual Momentum",
  "version": "1.0",
  "calculation": {
    "expression": "(residual_return_10d / (annualized_volatility_30d + 0.02)) * (1 + 0.6 * clip(volatility_20d / volatility_120d - 1, -0.5, 1.0))",
    "description": "Cross-sectional residual 10-day momentum, normalized by 30-day volatility and amplified for assets experiencing an instrument-specific short-term volatility shock. Residual return is the instrument 10-day return minus the cross-sectional mean 10-day return on each date. Positive values indicate stronger risk-adjusted residual momentum.",
    "signal_artifact": "scripts/miner_1_20290823_volshock_residual_reversal.py"
  },
  "dependencies": ["close"],
  "parameters": {
    "residual_window": 10,
    "volatility_window": 30,
    "short_volatility_window": 20,
    "long_volatility_window": 120,
    "volatility_floor": 0.02,
    "shock_clip_lower": -0.5,
    "shock_clip_upper": 1.0,
    "shock_amplitude": 0.6,
    "admission_horizon_days": 10
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2029-08-22",
    "validated_on": "2029-08-23",
    "metrics": {
