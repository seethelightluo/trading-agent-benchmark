  "factor_id": "miner_3_stability_adjusted_trend_10d",
  "factor_name": "Stability-Adjusted Medium-Term Trend",
  "version": "1.0",
  "calculation": {
    "expression": "return_40d / (stddev(daily_returns,40) * sqrt(40) + 0.02)",
    "description": "Ranks assets by 40-trading-day return scaled by realized daily-return dispersion over the same window, with a fixed stabilizing denominator floor. Uses only completed prices through the signal date."
