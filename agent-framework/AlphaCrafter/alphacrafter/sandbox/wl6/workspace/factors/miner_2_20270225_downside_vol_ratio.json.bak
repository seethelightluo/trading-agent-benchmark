{
  "factor_id": "miner_2_20270225_downside_vol_ratio",
  "factor_name": "Lagged Downside Volatility Relative to Total Volatility",
  "version": "1.0",
  "calculation": {
    "expression": "shift_1(rolling_std(where(pct_change(close,1)<0,pct_change(close,1)),10) / rolling_std(pct_change(close,1),40))",
    "description": "Ranks assets by downside volatility relative to total recent volatility. The ratio is lagged one completed session, so decisions use only prior closes. Positive forward-return IC indicates assets with comparatively activated downside volatility tended to rebound in this validation sample."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "downside_window": 10,
    "total_volatility_window": 40,
    "downside_min_periods": 5,
    "total_min_periods": 30,
    "cross_section_min_instruments": 8,
    "holding_horizon_sessions": 1
  },
