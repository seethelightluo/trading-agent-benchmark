{
  "factor_id": "miner_1_20311225_range_efficiency_reversal_20d",
  "factor_name": "20-Day Range-Efficiency Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(close/close.shift(20)-1) / (rolling_sum(abs(pct_change(close)),20)+1e-8)",
    "description": "Ranks assets for expected 20-day rebound by taking the negative trailing 20-day return and normalizing it by the absolute-return path length. Larger values indicate a decline relative to choppy path movement, interpreted as reversal potential.",
    "signal_artifact": "scripts/miner_1_20311225_range_efficiency_reversal.py",
    "no_future_data": true
  },
  "dependencies": ["close"],
  "parameters": {"lookback_days": 20, "forecast_horizon_days": 20, "epsilon": 1e-8},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2031-12-24",
    "validation_timestamp": "2031-12-25",
    "metrics": {
