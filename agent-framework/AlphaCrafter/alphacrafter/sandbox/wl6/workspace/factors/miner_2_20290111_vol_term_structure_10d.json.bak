{
  "factor_id": "miner_2_20290111_vol_term_structure_10d",
  "factor_name": "Short-to-Long Realized Volatility Term Structure",
  "version": "1.0",
  "calculation": {
    "expression": "-(rolling_std(pct_change(close),10) / rolling_std(pct_change(close),60) - 1)",
    "description": "Ranks assets with compressed short-horizon volatility relative to their 60-day realized volatility more favorably; uses only information available at the signal date."
  },
  "dependencies": ["close"],
  "parameters": {"short_window": 10, "long_window": 60, "admission_horizon_days": 10},
