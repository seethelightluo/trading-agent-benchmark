{
  "factor_id": "miner_1_20350621_reversal_volscaled_20d",
  "factor_name": "Cross-Asset Short Reversal Volatility-Scaled 20D",
  "version": "1.0",
  "calculation": {
    "expression": "-rolling_sum(pct_change(close), 5) / rolling_std(cross_section_demeaned(pct_change(close)), 20)",
    "description": "Lagged five-session reversal signal, scaled by each asset's 20-session volatility of cross-sectional demeaned daily returns. Higher values indicate stronger expected 20-day rebound potential. Signal is shifted one completed session to avoid look-ahead."
  },
  "dependencies": ["close"],
  "parameters": {"reversal_window_days": 5, "volatility_window_days": 20, "forward_horizon_days": 20, "minimum_cross_section": 8, "lag_days": 1},
  "validation": {
