{
  "factor_id": "miner_1_range_location_reversal_20d",
  "factor_name": "20-Day Range-Location Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(close - rolling_max(close,20).shift(1)) / (rolling_max(close,20).shift(1) - rolling_min(close,20).shift(1) + 1e-12)",
    "description": "Ranks assets contrarily by their location relative to the prior 20-session high-low range. Assets near the lower end receive higher scores, while assets near the upper end receive lower scores. Uses only completed-session prices and is intended for a 20-day forward horizon."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "lookback_sessions": 20,
    "lag_sessions": 1,
    "forward_horizon_days": 20,
    "minimum_range_observations": 15,
    "universe_size": 15
  },
  "validation": {
    "status": "EFFECTIVE",
