{
  "factor_id": "miner_3_20320219_benchmark_residual_reversal_20d",
  "factor_name": "Risk-scaled benchmark residual reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-rolling_sum_10(residual_return) / (rolling_std_40(residual_return) * sqrt(10) + 1e-12)",
    "description": "For each tradable asset, estimate a 60-day rolling beta to the equal-weight daily return of all 15 tradable instruments, subtract beta times benchmark return to obtain residual return, and rank the negative 10-day residual return normalized by 40-day residual volatility. Higher values indicate unusually weak benchmark-relative performance with a risk-adjusted reversal expectation. All inputs are lagged through the decision date.",
    "signal_artifact": "scripts/miner_3_20320219_residual_reversal.py"
  },
  "dependencies": ["close", "daily_return"],
  "parameters": {
    "universe": ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"],
    "benchmark": "equal_weight_mean_daily_return",
    "beta_window": 60,
    "residual_return_window": 10,
    "residual_volatility_window": 40,
    "admission_horizon_days": 20
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2032-02-18",
    "validation_timestamp": "2032-02-19T00:00:00Z",
