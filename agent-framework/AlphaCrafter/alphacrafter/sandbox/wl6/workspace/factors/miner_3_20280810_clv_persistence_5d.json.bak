{
  "factor_id": "miner_3_clv_persistence_5d",
  "factor_name": "Five-day close-location-value persistence",
  "version": "1.0",
  "calculation": {
    "expression": "rolling_mean_5((2*close-high-low)/(high-low))",
    "description": "For each tradable asset, compute the daily close location value (CLV), with zero-range observations treated as missing, then average over the latest five completed sessions. Higher values indicate persistent closes near the high of the daily range. The signal is lagged by the decision timing and evaluated against the subsequent ten-session return.",
    "signal_artifact": "scripts/miner_3_20280713_clv_persistence.py"
  },
  "dependencies": ["high", "low", "close"],
  "parameters": {
    "clv_window": 5,
    "forward_horizon_days": 10,
    "minimum_cross_section": 8,
    "universe_size": 15
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2028-08-09",
    "last_validated": "2028-08-10",
    "metrics": {
      "horizon": "10d",
      "ic": 0.011598,
      "icir": 0.5482,
      "hit_ratio": 0.5133,
      "dates": 2211,
      "average_instruments": 11.75,
      "coverage": 0.783333,
      "turnover": null,
      "decay": {
        "1d_ic": -0.029851,
        "5d_ic": 0.001147,
        "10d_ic": 0.011598
      },
      "max_abs_library_correlation": null
    },
    "regime_notes": "10-day IC was positive in 2020-2022 (+0.031143) and 2027-2028 (+0.075919), but negative in 2023-2024 (-0.022778) and 2025-2026 (-0.034175). Interpret as a regime-sensitive medium-horizon signal; combine conservatively with existing factors.",
    "validation_method": "Daily cross-sectional Spearman rank IC; dates require at least eight valid instruments; all inputs are completed-session data and forward returns are used only for research evaluation."
  },
  "tags": ["price-action", "CLV", "persistence", "cross-asset", "10-day"]
}
