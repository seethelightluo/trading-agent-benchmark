{
  "factor_id": "defensive_breadth_reversal_20d",
  "factor_name": "Defensive Breadth-Gated Risk-Adjusted Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "if equity_breadth_20d < 0.40 then -asset_return_20d / rolling_std_daily_return_20d else 0",
    "description": "Ranks assets by risk-adjusted 20-day reversal only during weak broad equity breadth; otherwise emits a neutral signal. Equity breadth is the fraction of the eight equity indices with positive 20-day returns."
