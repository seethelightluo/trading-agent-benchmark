{
  "factor_id": "miner_3_20300307_momentum_curvature_10d",
  "factor_name": "Volatility-scaled momentum curvature",
  "version": "1.0",
  "calculation": {
    "expression": "((close/close.shift(10)-1) - (close/close.shift(60)-1)/6) / (rolling_std(pct_change(close),30)*sqrt(30))",
    "description": "Measures acceleration or deceleration of short-term momentum relative to the preceding 60-day average pace, normalized by 30-day annualized realized volatility. Higher values indicate recent momentum stronger than the prior trend pace. Signal is evaluated cross-sectionally and intended for a 10-trading-day forward horizon.",
