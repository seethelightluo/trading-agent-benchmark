{
  "factor_id": "miner_2_20350524_defensive_trend_quality_40d",
  "factor_name": "Defensive trend quality",
  "version": "1.0",
  "calculation": {
    "expression": "(return_30d * (0.5 + fraction_positive_days_30d)) / (0.5 * volatility_30d + 0.5 * downside_volatility_30d), shifted by 1 day",
    "description": "Ranks assets by medium-horizon trend strength, rewarded for persistence of positive daily returns and penalized by total and downside volatility. Signal is lagged one completed trading day to avoid look-ahead."
  },
  "dependencies": ["close"],
  "parameters": {
    "trend_window": 30,
    "persistence_window": 30,
    "risk_window": 30,
    "minimum_periods": 20,
    "forward_horizon": 40,
    "signal_lag_days": 1
  },
  "validation": {
