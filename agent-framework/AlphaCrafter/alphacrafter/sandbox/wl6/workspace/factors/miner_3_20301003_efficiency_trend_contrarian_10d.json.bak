{
  "factor_id": "miner_3_20301003_efficiency_trend_contrarian_10d",
  "factor_name": "Efficiency-Weighted Trend Contrarian",
  "version": "1.0",
  "calculation": {
    "expression": "-(close/close.shift(40)-1) / (std(pct_change(close),20)*sqrt(20)) * clip(abs(close/close.shift(40)-1) / rolling_sum(abs(pct_change(close)),40), 0, 1)",
    "description": "Fade a 40-trading-day trend, risk-scaled by 20-day volatility and weighted by directional path efficiency. Higher values indicate stronger contrarian preference. All inputs are lagged through the prior completed session at decision time."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "trend_window": 40,
    "volatility_window": 20,
    "path_window": 40,
    "annualization_for_volatility": "sqrt(20)",
    "forward_horizon_days": 10
  },
