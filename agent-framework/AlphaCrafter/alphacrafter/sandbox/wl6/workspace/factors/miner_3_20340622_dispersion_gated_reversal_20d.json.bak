{
  "factor_id": "miner_3_20340622_dispersion_gated_reversal_20d",
  "factor_name": "Dispersion-Gated Volatility-Normalized Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "shift1((-return_10d/(rolling_std(return_1d,20)*sqrt(10))) * (0.65 + 0.70*clip(rank_pct(rolling_std(return_1d,10).cross_asset_mean,126),0.1,0.9)))",
    "description": "Ranks assets by lagged ten-day reversal normalized by 20-day volatility, increasing exposure smoothly when cross-asset ten-day dispersion is elevated. All inputs are lagged one trading day before forward returns."
  },
  "dependencies": ["close"],
  "parameters": {"reversal_window_days": 10, "volatility_window_days": 20, "dispersion_window_days": 10, "dispersion_rank_window_days": 126, "min_cross_section": 8, "lag_days": 1, "multiplier_floor": 0.65, "multiplier_span": 0.70},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2034-06-21",
