{
  "factor_id": "miner_2_peer_relative_reversal_10d",
  "factor_name": "Peer-Relative Volatility-Scaled 10-Day Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(rolling_sum(log_return,10) - cross_sectional_median(rolling_sum(log_return,10))) / rolling_std(log_return,20)",
    "description": "Negative peer-relative ten-session momentum, volatility normalized; larger values indicate expected next-day reversal and uses only information through the prior completed session."
  },
  "dependencies": ["close"],
  "parameters": {"signal_window_days": 10, "volatility_window_days": 20, "minimum_volatility_observations": 15, "direction": -1, "cross_section": "15 tradable benchmark instruments"},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2028-09-20",
    "metrics": {
      "horizon_days": 1,
