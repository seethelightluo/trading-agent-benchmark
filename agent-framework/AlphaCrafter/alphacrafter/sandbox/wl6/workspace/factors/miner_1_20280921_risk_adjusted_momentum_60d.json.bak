{
  "factor_id": "risk_adjusted_momentum_60d",
  "factor_name": "Lagged 60-Day Risk-Adjusted Momentum",
  "version": "1.0",
  "calculation": {
    "expression": "shift(rolling_sum(pct_change(close),60) / (rolling_std(pct_change(close),60)*sqrt(60)), 1)",
    "description": "Ranks assets by their prior 60-session cumulative return normalized by prior 60-session realized volatility; the one-session lag prevents use of the current incomplete session."
  },
  "dependencies": ["close"],
  "parameters": {"lookback_return_days": 60, "lookback_volatility_days": 60, "annualization_scale": 60, "signal_lag_days": 1, "forward_horizon_days": 1},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2028-09-20",
    "metrics": {
      "daily_paper_ic": 0.012287,
      "daily_paper_icir": 0.5968,
      "ic_hit_ratio": 0.5137,
