  "factor_name": "Own-History Volatility Percentile Reversal 20d",
  "version": "1.0",
  "calculation": {
    "expression": "-(realized_volatility_20d - rolling_mean(realized_volatility_20d,120d)) / rolling_std(realized_volatility_20d,120d)",
    "description": "For each tradable benchmark instrument, assign a higher score when current 20-session realized volatility is unusually low relative to its own trailing 120-session volatility history. Values are point-in-time and ranked cross-sectionally for portfolio use. This is a volatility-regime reversal signal, not a cash or short position signal."
  },
  "dependencies": ["close"],
