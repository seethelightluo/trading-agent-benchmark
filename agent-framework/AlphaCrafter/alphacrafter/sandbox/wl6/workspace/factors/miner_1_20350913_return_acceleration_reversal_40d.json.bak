{
  "factor_id": "miner_1_return_acceleration_reversal_40d",
  "factor_name": "Volatility-Scaled Return Acceleration Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(pct_change(close,20) - pct_change(close,120)/6) / (std(pct_change(close,1),60)*sqrt(252))",
    "description": "Contrarian cross-sectional score: penalizes recent 20-session acceleration relative to the average 20-session slice of the trailing 120-session return, normalized by 60-session annualized volatility. Signal is shifted by one completed session. Higher scores indicate stronger expected 40-day forward returns."
  },
  "dependencies": ["close"],
  "parameters": {"short_window": 20, "long_window": 120, "long_slices": 6, "vol_window": 60, "annualization": 252, "forward_horizon_days": 40, "lag_sessions": 1},
  "validation": {
    "status": "EFFECTIVE",
    "period": {"start": "2020-05-02", "end": "2035-07-18", "as_of": "2035-09-13"},
    "metrics": {
