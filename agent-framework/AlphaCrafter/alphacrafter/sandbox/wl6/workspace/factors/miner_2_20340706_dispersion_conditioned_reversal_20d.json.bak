{
  "factor_id": "dispersion_conditioned_reversal_20d",
  "factor_name": "High-Dispersion Volatility-Normalized Residual Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "where(rank_60d(cross_sectional_std(r10)) > 0.50, -(r10 - median_cs(r10)) / (std20(daily_returns)*sqrt(20)), NaN), lagged 1 day",
    "description": "Ranks assets for medium-horizon residual reversal only when the trailing 10-day cross-asset return dispersion is above its trailing 60-day median. The residual shock is divided by each asset's 20-day annualized realized volatility and lagged one completed session to avoid look-ahead."
  },
  "dependencies": ["close"],
  "parameters": {"shock_window": 10, "vol_window": 20, "dispersion_window": 60, "dispersion_percentile": 0.50, "holding_horizon_days": 20, "lag_days": 1, "minimum_cross_section": 8},
