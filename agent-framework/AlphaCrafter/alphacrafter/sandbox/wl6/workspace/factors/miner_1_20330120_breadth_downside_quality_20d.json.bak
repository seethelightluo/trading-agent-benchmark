{
  "factor_id": "miner_1_20330120_breadth_downside_quality_20d",
  "factor_name": "Breadth-conditioned downside-volatility quality",
  "version": "1.0",
  "calculation": {
    "expression": "state(breadth_20d) * (return_20d / downside_volatility_30d)",
    "description": "Compute each asset's 20-trading-day return divided by rolling 30-day standard deviation of negative daily returns. Multiply by a cross-asset breadth hysteresis state: +1 when at least 60% of assets have positive 20-day momentum, -1 when at most 40% do, and retain the previous state in between. Rank cross-sectionally for portfolio use."
  },
  "dependencies": ["close", "daily_returns"],
  "parameters": {
    "momentum_window": 20,
    "downside_volatility_window": 30,
    "downside_volatility_min_periods": 5,
    "breadth_positive_threshold": 0.60,
    "breadth_negative_threshold": 0.40,
    "minimum_cross_section": 8,
    "validation_horizons": [5, 10, 20, 40]
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2033-01-19",
    "last_validated": "2033-01-20",
    "metrics": {
      "admission_horizon_days": 20,
      "ic": 0.030212,
      "icir": 0.098081,
      "ic_hit_ratio": 0.5441,
      "valid_dates": 2656,
      "average_instruments": 12.46,
      "coverage": 0.8304,
      "turnover": 0.131387,
      "decay_ic": {"5": -0.003730, "10": 0.016018, "20": 0.030212, "40": 0.005489},
      "decay_icir": {"5": -0.011761, "10": 0.051464, "20": 0.098081, "40": 0.017824},
      "max_abs_library_correlation": null
    },
    "regime_notes": "Positive aggregate 20-day IC, but negative annual IC in 2022, 2023, and 2030-2032; interpret conservatively given the 15-instrument cross-section. Recent 2033 observations are incomplete for the 20-day horizon.",
    "signal_artifact": {
      "type": "reconstructable",
      "script": "scripts/miner_1_20330120_breadth_downside_quality_20d.py",
      "universe": ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"],
      "data_cutoff": "2033-01-19",
      "forward_return_definition": "close[t+h]/close[t]-1"
    }
