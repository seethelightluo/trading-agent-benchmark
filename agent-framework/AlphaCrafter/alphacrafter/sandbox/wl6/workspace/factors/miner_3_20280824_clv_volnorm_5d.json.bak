{
  "factor_id": "miner_3_clv_volnorm_5d",
  "factor_name": "Volatility-Normalized CLV Persistence",
  "version": "1.0",
  "calculation": {
    "expression": "rolling_mean_5((2*close-high-low)/(high-low)) / rolling_std_20(close.pct_change())",
    "description": "The five-session mean close-location-value, divided by trailing 20-session realized close-return volatility. All inputs are from completed sessions available at the decision timestamp. Higher values indicate persistent closes near highs after risk normalization."
  },
  "dependencies": ["close", "high", "low"],
  "parameters": {"clv_window": 5, "volatility_window": 20, "forward_horizon_days": 10, "minimum_cross_section": 8},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2028-08-23",
    "metrics": {
      "ic": 0.00983,
      "icir": 0.4969,
      "horizon": "10d",
      "dates": 2204,
      "average_instruments": 11.28,
      "factor_coverage": 0.7521,
      "hit_ratio": 0.505,
      "turnover": null,
      "max_abs_library_correlation": null
    },
    "regime_notes": "10-day IC by broad regime: 2020-2022 +0.017120 (753 dates); 2023-2024 -0.014187 (516); 2025-2026 -0.017140 (516); 2027-2028 +0.059521 (419). Strong recent regime dependence; use conservatively and in ensemble only.",
    "validation_timestamp": "2028-08-24T00:00:00Z",
    "signal_artifact": "scripts/miner_3_20280824_clv_volnorm.py",
    "method": "Daily cross-sectional Spearman rank IC; dates require at least 8 valid tradable instruments; forward returns are close[t+10]/close[t]-1."
  },
  "tags": ["technical", "close-location-value", "volatility-normalized", "cross-asset", "medium-horizon"]
}
