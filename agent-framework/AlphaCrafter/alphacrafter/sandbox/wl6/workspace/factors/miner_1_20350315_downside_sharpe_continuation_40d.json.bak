{
  "factor_id": "downside_sharpe_continuation_40d",
  "factor_name": "Downside-Volatility-Adjusted 30-Day Continuation",
  "version": "1.0",
  "calculation": {
    "expression": "lag1(pct_change(close,30) / downside_std(log_returns,30))",
    "description": "Thirty-session price continuation divided by the standard deviation of negative daily log returns over the trailing 30 sessions, lagged one session to prevent look-ahead bias. Higher values indicate positive continuation achieved with less downside volatility."
  },
  "dependencies": ["close"],
  "parameters": {"return_window": 30, "downside_vol_window": 30, "downside_vol_min_periods": 15, "lag": 1, "forward_horizon": 40},
