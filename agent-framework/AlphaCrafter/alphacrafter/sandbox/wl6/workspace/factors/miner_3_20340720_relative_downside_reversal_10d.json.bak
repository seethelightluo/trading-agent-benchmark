{
  "factor_id": "miner_3_20340720_relative_downside_reversal_10d",
  "factor_name": "Relative Downside-Scaled Reversal with Shock Gate",
  "version": "1.0",
  "calculation": {
    "expression": "shift_1((-((ret20 - cross_sectional_median(ret20)) / (downside_rms30*sqrt(20))) * clip(1 + 0.35*max(-ret5,0)/(vol20*sqrt(5)), 1, 1.8))",
    "description": "Cross-sectional relative 20-day return reversal, scaled by 30-day downside RMS volatility and mildly amplified after a negative 5-day shock. The complete signal is lagged one trading day to prevent look-ahead bias."
  },
  "dependencies": ["close"],
  "parameters": {
    "relative_return_window": 20,
    "downside_rms_window": 30,
    "downside_min_periods": 10,
    "shock_window": 5,
    "volatility_window": 20,
    "shock_amplifier": 0.35,
    "gate_lower": 1.0,
    "gate_upper": 1.8,
    "signal_lag_days": 1,
    "minimum_cross_section": 8
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2034-07-19",
    "timestamp": "2034-07-20",
    "metrics": {
