{
  "factor_id": "consistent_trend_nodrawdown_20d",
  "factor_name": "Consistent Trend Volatility-Normalized Momentum",
  "version": "1.0",
  "calculation": {
    "expression": "(close.pct_change(60) * (1 + rolling_mean(sign(pct_change(close)) > 0, 40) - 0.5) / (rolling_std(pct_change(close), 40) * sqrt(252))).shift(1)",
    "description": "Sixty-session momentum scaled by directional consistency and inverse forty-session realized volatility, lagged one session. The directional term rewards a higher fraction of positive daily returns without using future data."
  },
  "dependencies": ["close"],
  "parameters": {"momentum_window": 60, "consistency_window": 40, "volatility_window": 40, "lag": 1, "annualization": 252},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2035-03-28",
    "metrics": {
      "horizon_days": 20,
      "ic": 0.01530374,
      "icir": 2.59046154,
      "hit_ratio": 0.5358,
      "ic_observations": 2206,
      "average_instruments": 12.666,
      "coverage": 0.8444,
      "turnover": 0.04887,
      "max_abs_library_correlation": null
    },
    "thresholds": {"absolute_daily_paper_ic": 0.007, "absolute_daily_paper_icir": 0.084},
    "regime_notes": "Passes the benchmark gates in a 15-instrument cross-asset universe; uncertainty should be interpreted conservatively. Decay is positive across tested 5/10/20/40-session horizons, with IC 0.01283128/0.01318456/0.01530374/0.01659771.",
    "signal_artifact": "scripts/miner_3_20350329_consistent_trend_nodrawdown_20d_signal.csv"
  },
