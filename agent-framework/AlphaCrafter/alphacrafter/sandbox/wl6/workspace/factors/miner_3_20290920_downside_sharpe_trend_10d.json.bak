{
  "factor_id": "miner_3_20290920_downside_sharpe_trend_10d",
  "factor_name": "Downside-volatility-adjusted 20-day trend",
  "version": "1.0",
  "calculation": {
    "expression": "pct_change(close,20) / (sqrt(252) * rolling_std(where(pct_change(close,1)<0,pct_change(close,1),0),30,min_periods=20) + 0.02)",
    "description": "Ranks instruments by their trailing 20-trading-day return scaled by trailing downside volatility. The fixed floor stabilizes the ratio for assets with very low downside variation. All inputs are lagged historical closes available at decision time."
  },
  "dependencies": ["close"],
  "parameters": {
    "trend_window": 20,
    "downside_vol_window": 30,
    "downside_vol_min_periods": 20,
    "annualization": 252,
    "volatility_floor": 0.02,
    "forward_horizon_days": 10
  },
