{
  "factor_id": "miner_2_peer_relative_momentum_20d",
  "factor_name": "Peer-Relative Volatility-Scaled 20-Day Momentum",
  "version": "1.0",
  "calculation": {
    "expression": "(return_20d_lagged_1d - cross_sectional_median(return_20d_lagged_1d)) / trailing_std(return_1d,20)_lagged_1d",
    "description": "For each of the 15 tradable benchmark assets, subtract the same-date cross-sectional median of lagged 20-session price momentum and divide by lagged 20-session realized return volatility. The signal uses only information available through the prior completed session. Higher values indicate stronger relative momentum after risk scaling."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "momentum_window_days": 20,
    "volatility_window_days": 20,
    "lag_days": 1,
    "minimum_cross_section": 8,
    "universe_size": 15
  },
