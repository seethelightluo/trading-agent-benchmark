{
  "factor_id": "miner_2_20310501_multiscale_persistent_trend_quality",
  "factor_name": "Multiscale Persistent Trend Quality",
  "version": "1.0",
  "calculation": {
    "expression": "((0.25*r20 + 0.35*r60 + 0.40*r120) * (sign(r20)+sign(r60)+sign(r120))/3) / (rolling_std(return,60)+1e-12)",
    "description": "Combines 20-, 60-, and 120-trading-day returns, rewards agreement in trend direction across horizons, and scales by trailing 60-day daily return volatility. The signal is computed using data available at the decision-day close or earlier and is evaluated against forward returns."
  },
  "dependencies": ["close"],
  "parameters": {
    "short_window": 20,
    "medium_window": 60,
    "long_window": 120,
    "volatility_window": 60,
    "return_weights": [0.25, 0.35, 0.40],
    "minimum_valid_instruments_for_ic": 8,
    "forward_horizons_days": [5, 10, 20]
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 to 2031-04-30",
    "validation_timestamp": "2031-05-01T00:00:00Z",
    "metrics": {
      "primary_horizon_days": 20,
      "ic": 0.01508182,
      "icir": 2.037701,
      "ic_hit_ratio": 0.51113,
      "valid_dates": 1168,
      "average_instruments": 14.981,
      "coverage": 0.99874,
      "turnover_proxy": 0.064449,
      "decay_ic": {"5d": 0.0094916, "10d": 0.01354219, "20d": 0.01508182},
      "max_abs_library_correlation": null
    },
    "regime_notes": "Positive average IC across the full sample and strongest measured decay at 20 days. Annual regime IC was positive in 2026, 2028-2030 and negative in 2027 and 2031 year-to-date; uncertainty is material because the universe has 15 assets.",
    "signal_artifact": {
      "script": "scripts/miner_3_20310417_multiscale_momentum_quality.py",
      "source_formula": "(0.25*pct_change(20)+0.35*pct_change(60)+0.40*pct_change(120))*((sign(pct_change(20))+sign(pct_change(60))+sign(pct_change(120)))/3)/(rolling_std(pct_change(1),60)+1e-12)",
      "universe": ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"],
      "data_access": "get_stock_daily_data",
      "reproducible": true
