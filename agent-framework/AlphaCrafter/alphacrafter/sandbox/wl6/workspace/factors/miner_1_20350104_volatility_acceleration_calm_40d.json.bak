{
  "factor_id": "volatility_acceleration_calm_40d",
  "factor_name": "Lagged inverse volatility acceleration (40-day forward)",
  "version": "1.0",
  "calculation": {
    "expression": "-(rolling_std(log_return,20) / rolling_std(log_return,60)).shift(1)",
    "description": "Ranks assets favorably when recent 20-day realized volatility is low relative to its 60-day baseline. The one-session lag prevents using the current day's close; higher values indicate calmer volatility conditions and are evaluated against 40-day forward returns."
  },
  "dependencies": ["close"],
  "parameters": {"short_window": 20, "long_window": 60, "signal_lag": 1, "forward_horizon": 40},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2035-01-03",
    "last_validated": "2035-01-04T00:00:00Z",
    "metrics": {
      "horizon_days": 40,
      "ic": 0.026794,
      "icir": 4.953,
      "ic_hit_ratio": 0.5478,
      "ic_observations": 2112,
      "average_instruments": 13.003,
      "coverage": 0.8669,
      "turnover": null,
      "max_abs_library_correlation": null
    },
    "regime_notes": "Original volatility-acceleration signal had IC -0.043529 in 2020-2027, -0.011855 in 2028-2031, and +0.008609 in 2032-2035; inverse signal is positive in the first two regimes but recent regime is adverse. Interpret uncertainty conservatively in the 15-asset universe.",
    "provenance": {
      "validation_script": "scripts/miner_1_20350104_volatility_acceleration.py",
      "signal_artifact": "scripts/miner_1_20350104_volatility_acceleration_signal.csv",
      "source_signal_direction": "negative_of_artifact_signal"
    }
  },
  "tags": ["volatility", "calm", "risk-regime", "cross-asset"]
}
