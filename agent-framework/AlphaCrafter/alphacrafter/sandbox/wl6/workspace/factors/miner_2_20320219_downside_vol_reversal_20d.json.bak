  "factor_name": "Downside-Volatility-Normalized Reversal (20d)",
  "version": "1.0",
  "calculation": {
    "expression": "-(close/lag(close,10)-1)/rolling_std_40(where(daily_return<0,daily_return,0))",
    "description": "Ranks assets higher when their recent 10-session loss is large relative to downside volatility over 40 sessions, producing a contrarian oversold signal. Signal uses only prices through the prior completed session."
  },
  "dependencies": ["close", "daily_return"],
  "parameters": {"return_lookback": 10, "downside_vol_lookback": 40, "downside_vol_min_periods": 20, "forward_horizons_tested": [5,10,20], "minimum_cross_section": 8},
