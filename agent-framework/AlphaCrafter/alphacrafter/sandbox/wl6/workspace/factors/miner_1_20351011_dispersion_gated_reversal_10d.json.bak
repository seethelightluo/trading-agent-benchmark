{
  "factor_id": "miner_1_dispersion_gated_reversal_10d",
  "factor_name": "Dispersion-Gated Volatility-Scaled Cross-Asset Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "shift(-((R20 - cross_sectional_median(R20))/rolling_std(return,60)),1) when cross_sectional_std(R20) > rolling_median(cross_sectional_std(R20),120), otherwise 0",
    "description": "Use lagged, volatility-scaled 20-session cross-sectional reversal only when recent cross-asset return dispersion exceeds its trailing 120-session median; compressed-dispersion dates receive a neutral signal. The one-session lag prevents look-ahead."
  },
  "dependencies": ["close", "daily_return"],
  "parameters": {"return_window": 20, "volatility_window": 60, "dispersion_window": 120, "forward_horizon": 10, "minimum_valid_instruments": 8, "lag_sessions": 1},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-10-02 through 2035-10-10",
    "last_validated": "2035-10-11",
    "metrics": {
      "ic": 0.01701113,
      "icir": 2.51685315,
      "horizon_days": 10,
      "valid_dates": 2322,
      "average_instruments": 13.142,
      "coverage": 0.999792,
      "rank_turnover": 0.068994,
      "hit_ratio": 0.5207,
      "max_abs_library_correlation": null
    },
    "decay": {"5d_ic": 0.01545758, "10d_ic": 0.01701113, "20d_ic": -0.00092639, "40d_ic": -0.00666767, "60d_ic": -0.00220897},
    "regime_notes": "Validated on the 15-instrument tradable cross-asset universe. Signal is active on 2,329 of 4,798 dates and uses approximately 13.14 instruments per active cross-section. Strongest result is at the intended 10-session horizon; longer-horizon predictive power decays and reverses. Small cross-section warrants conservative interpretation.",
    "signal_artifact": "scripts/miner_1_20351011_dispersion_gated_reversal_signal.csv"
  },
  "tags": ["reversal", "dispersion", "volatility_scaled", "cross_asset", "regime_conditioned"]
}
