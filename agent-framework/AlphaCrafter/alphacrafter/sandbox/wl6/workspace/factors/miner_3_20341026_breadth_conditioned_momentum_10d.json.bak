{
  "factor_id": "breadth_conditioned_momentum_10d",
  "factor_name": "Breadth-Conditioned Cross-Asset Momentum 10D",
  "version": "1.0",
  "calculation": {
    "expression": "demean_cs((rolling_sum_20d(asset_return) * 2*(rolling_mean_20d(I[asset_return>0])-0.5)).shift(1))",
    "description": "Multiply each asset's 20-session cumulative return by lagged aggregate cross-asset breadth, where breadth is the mean fraction of the 15 tradable instruments with positive daily returns over 20 sessions. Positive breadth favors continuation; narrow/negative breadth naturally attenuates or reverses the momentum signal. Cross-sectionally median demeaned and lagged one completed session."
  },
  "dependencies": ["close"],
  "parameters": {
    "momentum_window": 20,
    "breadth_window": 20,
    "breadth_assets": 15,
    "signal_lag": 1,
    "forward_horizon_days": 10,
    "minimum_cross_section": 8
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2034-10-25",
    "validated_at": "2034-10-26T00:00:00Z",
    "metrics": {
      "ic": 0.01076916,
      "icir": 1.333575,
      "ic_hit_ratio": 0.5131,
      "ic_observations": 2477,
      "average_instruments": 14.505,
      "coverage": 0.9670,
      "turnover": 0.077740,
      "max_abs_library_correlation": null
    },
    "decay": {
      "5d_ic": 0.00116195,
      "10d_ic": 0.01076916,
      "20d_ic": -0.00380949,
      "40d_ic": -0.05080658
    },
    "regime_notes": "10D IC was -0.013351 in early 2020-2027, +0.011478 in mid 2028-2031, and +0.033337 in recent 2032-2034-10-25. The recent improvement is encouraging, but early-regime sign instability and strong negative 40D decay require a 10D-only, modest-weight deployment and monitoring.",
    "signal_artifact": "scripts/miner_3_20341026_breadth_conditioned_momentum_signal.csv",
    "validation_script": "scripts/miner_3_20341026_breadth_conditioned_momentum.py"
  },
