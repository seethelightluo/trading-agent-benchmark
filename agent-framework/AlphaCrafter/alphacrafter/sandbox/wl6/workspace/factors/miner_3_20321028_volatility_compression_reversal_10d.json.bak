{
  "factor_id": "miner_3_20321028_volatility_compression_reversal_10d",
  "factor_name": "Volatility-Compression Pullback Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(close/close.shift(10)-1) * (rolling_std(pct_change(close),10,min_periods=8) / rolling_std(pct_change(close),60,min_periods=40))",
    "description": "Ranks assets with negative recent 10-session returns, scaled by their short-to-long realized volatility ratio. Higher values favor pullbacks occurring with relatively compressed short-term volatility. The signal uses only completed historical prices available at the decision date.",
    "provenance_script": "scripts/miner_3_20321028_volatility_compression_reversal_10d.py",
    "signal_artifact": "Reconstructable from the 15-asset close panel and rolling windows; validation cutoff 2032-10-27; primary forward horizon 20 sessions."
  },
  "dependencies": ["close"],
  "parameters": {
    "return_window": 10,
    "short_volatility_window": 10,
    "short_volatility_min_periods": 8,
    "long_volatility_window": 60,
    "long_volatility_min_periods": 40,
    "primary_horizon_days": 20
  },
