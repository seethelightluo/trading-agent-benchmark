{
  "factor_id": "miner_1_20340720_drawdown_weighted_reversal_20d",
  "factor_name": "Drawdown-weighted volatility-scaled 5-day reversal",
  "version": "1.0",
  "calculation": {
    "expression": "shift_1((-return_5d / (volatility_20d * sqrt(5))) * (1 + 0.75 * clip(-drawdown_60d, 0, 0.5)))",
    "description": "Lagged cross-asset reversal signal. Recent five-day losers are favored, normalized by 20-day volatility and weighted modestly more when below their 60-day rolling peak. The one-day lag prevents look-ahead bias."
  },
  "dependencies": ["close"],
  "parameters": {"reversal_window_days": 5, "volatility_window_days": 20, "drawdown_window_days": 60, "drawdown_weight": 0.75, "max_drawdown_weight_input": 0.5, "lag_days": 1, "forward_horizon_days": 20},
  "validation": {
