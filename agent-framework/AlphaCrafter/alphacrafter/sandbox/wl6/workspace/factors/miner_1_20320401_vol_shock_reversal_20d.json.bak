{
  "factor_id": "vol_shock_reversal_20d",
  "factor_name": "Volatility-shock reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-((realized_vol_10 / realized_vol_40) - 1) * return_10 / (realized_vol_40 + epsilon)",
    "description": "Measure a 10-day volatility shock relative to 40-day realized volatility and reverse the recent 10-day return, scaled by baseline volatility. Higher values indicate assets with recent volatility-amplified underperformance and a stronger 20-day reversal forecast. All inputs are lagged through the prior completed session."
  },
  "dependencies": ["close"],
  "parameters": {"short_vol_window": 10, "baseline_vol_window": 40, "return_window": 10, "epsilon": 1e-12, "forward_horizon_days": 20},
