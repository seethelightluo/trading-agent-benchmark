{
  "factor_id": "miner_3_20290726_vol_compression_trend_10d",
  "factor_name": "Volatility-Compression-Weighted Trend",
  "version": "1.0",
  "calculation": {
    "expression": "(close/close.shift(20)-1)/(std(pct_change(close),20)*sqrt(20)+0.01) * clip(std(pct_change(close),60)/(std(pct_change(close),20)+0.001),0.5,2.0)",
    "description": "Ranks 20-day trend by short-horizon volatility-adjusted strength, amplified when short volatility is compressed relative to its 60-day baseline; clipping limits extreme ratios. Uses only completed closes."
  },
  "dependencies": ["close"],
  "parameters": {"trend_window": 20, "short_vol_window": 20, "long_vol_window": 60, "vol_floor": 0.01, "ratio_floor": 0.001, "ratio_clip": [0.5, 2.0], "forward_horizon_days": 10},
