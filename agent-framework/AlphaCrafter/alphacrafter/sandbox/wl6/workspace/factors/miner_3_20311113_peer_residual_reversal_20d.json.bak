{
  "factor_id": "miner_3_20311113_peer_residual_reversal_20d",
  "factor_name": "Peer-Residual Volatility-Normalized Reversal (20d)",
  "version": "1.0",
  "calculation": {
    "expression": "-rolling_sum_20(asset_daily_return - cross_asset_mean_daily_return) / rolling_std_20(asset_daily_return - cross_asset_mean_daily_return)",
    "description": "For each of the 15 tradable benchmark instruments, subtract the equal-weight cross-asset daily return from its daily return, sum the residual over 20 sessions, and reverse its sign after scaling by 20-day residual volatility. Inputs are known only through the prior completed session at decision time. Higher values indicate stronger residual underperformance and therefore a stronger reversal forecast."
  },
  "dependencies": [
    "close",
    "daily_return"
  ],
  "parameters": {
    "lookback_days": 20,
    "forward_horizons_tested": [
      5,
      10,
      20
    ],
    "peer_return": "equal_weight_mean_across_valid_tradable_instruments",
    "minimum_cross_section": 8
  },
