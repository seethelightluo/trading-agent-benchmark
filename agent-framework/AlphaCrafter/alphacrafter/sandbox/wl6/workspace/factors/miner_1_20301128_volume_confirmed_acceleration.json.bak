{
  "factor_id": "miner_1_20301128_volume_confirmed_acceleration",
  "factor_name": "Volume-Confirmed Momentum Acceleration",
  "version": "1.0",
  "calculation": {
    "expression": "(pct_change(close,5) - pct_change(close,20)/4) * log(1 + volume/rolling_median(volume,40))",
    "description": "Measures recent 5-day momentum acceleration relative to the average daily 20-day move, with stronger weight when activity exceeds the 40-day median. Higher values indicate improving momentum confirmed by participation and higher expected 10-day forward return. Uses only data through the prior completed session."
  },
  "dependencies": ["close", "volume"],
  "parameters": {
    "short_return_window": 5,
    "medium_return_window": 20,
    "volume_baseline_window": 40,
    "forward_horizon_days": 10,
    "universe_size": 15,
    "minimum_valid_cross_section": 8
  },
  "validation": {
