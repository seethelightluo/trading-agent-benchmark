{
  "factor_id": "miner_1_trend_consistency_60d",
  "factor_name": "60-Day Trend Consistency",
  "version": "2.0",
  "calculation": {
    "expression": "(mean((close/lag(close,1)-1)>0 over 60 sessions) - 0.5), shifted by 1 session",
    "description": "Cross-asset trend persistence signal equal to the fraction of positive daily returns over the trailing 60 completed sessions, centered at zero and lagged one day to prevent look-ahead. Higher values indicate more consistent upward trend."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "lookback_sessions": 60,
    "signal_lag_sessions": 1,
    "minimum_cross_section": 8
  },
