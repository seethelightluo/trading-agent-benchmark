{
  "factor_id": "miner_2_20280713_gap_reversal_volnorm",
  "factor_name": "Volatility-Normalized Overnight Gap Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(open_t / close_{t-1} - 1) / rolling_std(pct_change(close), 20) evaluated at t-1",
    "description": "Ranks assets higher when the most recently completed session's overnight gap was unusually negative, expecting cross-asset gap mean reversion. The signal is lagged and uses only OHLC data available before the forecast interval."
  },
  "dependencies": ["open", "close"],
  "parameters": {"volatility_window": 20, "forward_horizons_days": [1, 5, 10], "minimum_cross_section": 8},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2028-07-12",
    "metrics": {
      "daily_ic": 0.0113767603,
      "daily_icir": 0.5735535213,
      "daily_hit_ratio": 0.5210084,
      "daily_dates": 1666,
      "average_instruments": 15.0,
      "coverage": 0.984,
      "rank_turnover": null,
      "ic_5d": 0.0195845047,
      "ic_10d": 0.0083438099,
      "max_abs_library_correlation": null
    },
    "regime_notes": "Positive aggregate daily IC; conservative interpretation warranted because cross-section is 15 assets and history has asynchronous OHLC availability."
  },
  "signal_artifact": "scripts/miner_2_20280713_gap_reversal.py",
  "last_validated": "2028-07-13T00:00:00Z",
  "tags": ["reversal", "overnight_gap", "volatility_normalized", "cross_asset"]
}
