  "calculation": {
    "expression": "shift1((pct_change(close,10)/(rolling_std(pct_change(close),20)*sqrt(10))) * tanh(pct_change(close,60)/(rolling_std(pct_change(close),20)*sqrt(60))))",
    "description": "The lagged 10-day return scaled by 20-day realized volatility, multiplied by a smooth sign-and-strength alignment with the 60-day trend. The one-day lag ensures only completed prior-day information is used."
