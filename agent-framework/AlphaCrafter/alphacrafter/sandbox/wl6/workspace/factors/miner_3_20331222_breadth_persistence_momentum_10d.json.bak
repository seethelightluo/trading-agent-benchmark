{
  "factor_id": "miner_3_20331222_breadth_persistence_momentum_10d",
  "factor_name": "Breadth-signed volatility-scaled persistence momentum",
  "version": "1.0",
  "calculation": {
    "expression": "pct_change(close,10) * (2 * rolling_mean(pct_change(close,1)>0,10) - 1) / rolling_std(pct_change(close,1),20)",
    "description": "Ranks assets by ten-day momentum, signed by the fraction of positive sessions in the preceding ten days and scaled by twenty-day realized volatility. Persistent advances receive a positive multiplier; persistent declines receive a negative multiplier, while choppy paths are attenuated. The signal is formed only from data through the as-of date."
  },
  "dependencies": ["close"],
  "parameters": {
    "momentum_window": 10,
    "breadth_window": 10,
    "volatility_window": 20,
    "forward_horizon": 10,
    "epsilon": 1e-12,
    "universe_size": 15
  },
