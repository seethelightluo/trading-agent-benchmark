  "factor_name": "Volatility-scaled trend acceleration",
  "version": "1.0",
  "calculation": {
    "expression": "((close/close.shift(20)-1) - 0.5*(close/close.shift(60)-1)) / (30d rolling std(pct_change) * sqrt(30)), then lag one day",
    "description": "Measures recent trend relative to the slower trend baseline and scales it by trailing realized volatility; the one-day lag prevents look-ahead bias. Higher values indicate stronger recent trend acceleration per unit risk."
  },
  "dependencies": ["close"],
  "parameters": {"short_window": 20, "long_window": 60, "long_weight": 0.5, "vol_window": 30, "vol_min_periods": 20, "vol_annualization_factor": 30, "lag_days": 1, "admission_horizon_days": 40},
