{
  "factor_id": "miner_3_sign_consistency_momentum_10d",
  "factor_name": "Sign-Consistency Weighted Risk-Adjusted Momentum",
  "version": "1.0",
  "calculation": {
    "expression": "(sum(return,20) / (std(return,40)*sqrt(20))) * (0.5 + 0.5*abs(2*mean(return>0,20)-1))",
    "description": "Twenty-day risk-adjusted momentum, strengthened by the absolute persistence of positive versus negative daily return signs over the same 20-day window. All inputs are lagged to the last completed day at decision time."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "momentum_window": 20,
    "volatility_window": 40,
    "persistence_window": 20,
    "admission_horizon_days": 10
  },
