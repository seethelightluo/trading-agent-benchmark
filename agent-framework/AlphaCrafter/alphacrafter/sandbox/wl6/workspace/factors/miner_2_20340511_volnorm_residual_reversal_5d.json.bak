{
  "factor_id": "volnorm_residual_reversal_5d",
  "factor_name": "Volatility-Normalized Cross-Asset Residual Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-((r_5_i - median_j(r_5_j)) / vol20_i)",
    "description": "Ranks assets higher when their lagged five-session return underperformed the contemporaneous cross-asset median, normalized by their own trailing 20-session annualized return volatility. The signal is shifted one completed session before evaluation to prevent look-ahead bias.",
    "signal_lag_sessions": 1
  },
  "dependencies": ["close"],
  "parameters": {
    "return_lookback_sessions": 5,
    "volatility_lookback_sessions": 20,
    "volatility_annualization": 252,
    "cross_section_statistic": "median",
    "validation_forward_horizon_sessions": 5,
    "minimum_cross_section": 8
  },
  "validation": {
    "status": "EFFECTIVE",
    "timestamp": "2034-05-11T00:00:00Z",
    "period": "2020-01-01 through 2034-05-10",
    "universe_size": 15,
    "metrics": {
      "ic": 0.007713,
      "icir": 0.384839,
      "ic_definition": "mean daily cross-sectional Spearman IC; ICIR = mean IC / sample standard deviation of daily IC * sqrt(252)",
      "valid_dates": 4401,
      "average_instruments": 13.492,
      "coverage": 0.8995,
      "turnover_proxy": 0.15282,
      "ic_hit_ratio": 0.5012,
      "decay_ic": {"5d": 0.007713, "10d": 0.000391, "20d": -0.000364, "40d": -0.003631},
      "max_abs_library_correlation": null
    },
    "regime_notes": "Passes the benchmark absolute daily IC and ICIR gates at the 5-session horizon. Predictive power decays rapidly beyond 5 sessions; interpret as a short-horizon reversal factor. Cross-section is the full 15-asset benchmark with at least 8 valid assets per date.",
    "signal_artifact": {
      "source_script": "scripts/miner_2_20340511_volnorm_residual_reversal.py",
      "source_hash": "not_recorded",
      "reconstruction": "Build close panel for the 15 tradable assets, compute r5=P/P.shift(5)-1, vol20=pct_change(P).rolling(20).std()*sqrt(252), then signal=(-(r5-r5.median(axis=1).broadcast)/vol20).shift(1)."
    }
  },
  "tags": ["reversal", "cross-asset", "volatility-normalized", "short-horizon"],
  "last_validated": "2034-05-11"
}