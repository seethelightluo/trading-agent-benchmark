{
  "factor_id": "miner_2_20350719_dispersion_gated_reversal_10d",
  "factor_name": "High-dispersion gated short-term reversal",
  "version": "1.0",
  "calculation": {
    "expression": "where(CSDispersion_5D_lag1 > rolling_median(CSDispersion_5D_lag1,60D), -(close.pct_change(5).shift(1))/rolling_std(daily_returns,20D).shift(1), 0)",
    "description": "Cross-sectional reversal of lagged five-day returns scaled by each asset's lagged 20-day volatility; signal is active only when the five-day average cross-asset return dispersion exceeds its trailing 60-day median. All inputs are completed-session lagged."
  },
  "dependencies": ["close", "daily_returns"],
  "parameters": {"return_lookback_days": 5, "volatility_lookback_days": 20, "dispersion_window_days": 5, "dispersion_threshold_window_days": 60, "forward_horizon_days": 10, "minimum_cross_section": 8},
