  "factor_name": "Dispersion-conditioned risk-scaled peer residual reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-((return(close,10)-cross_sectional_mean(return(close,10)))/(std(pct_change(close),20)*sqrt(20))) * clip(cross_sectional_dispersion_20 / median(cross_sectional_dispersion_20,120), 0.5, 2.0), lagged 1 session",
    "description": "Ranks assets for 20-trading-day forward return prediction by risk-scaled reversal versus the contemporaneous 15-asset peer basket, conditioned on the prevailing cross-sectional return dispersion regime. Higher values indicate stronger expected reversal return."
