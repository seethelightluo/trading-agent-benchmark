  "dependencies": ["close"],
  "parameters": {"residual_lookback_days": 10, "volatility_lookback_days": 20, "dispersion_lookback_days": 20, "dispersion_baseline_days": 120, "multiplier_clip": [0.5, 2.0], "signal_lag_days": 1, "forward_horizon_days": 20, "min_cross_section": 8},
