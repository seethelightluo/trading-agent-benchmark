{
  "factor_id": "miner_3_20351025_breadth_confirmed_trend_20d",
  "factor_name": "Breadth-confirmed risk-adjusted persistent trend",
  "version": "1.0",
  "calculation": {
    "expression": "sign((cross_sectional_mean(20D_mean_return)> = 0.5)-0.5) * (0.5*20D_mean_return + 0.5*60D_mean_return) / (60D_return_std + 1e-8)",
    "description": "Compute a risk-adjusted persistent trend score and multiply all asset scores by the prevailing cross-asset breadth regime: retain trend sign when at least half of instruments have positive 20-day mean returns, otherwise invert it. All inputs are lagged through the observation date."
  },
  "dependencies": ["close"],
  "parameters": {"short_window": 20, "long_window": 60, "volatility_window": 60, "breadth_threshold": 0.5, "epsilon": 1e-8, "forward_horizon_days": 20},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2035-10-24",
    "metrics": {
      "ic": 0.02410683,
      "icir": 5.50181304,
      "dates": 4727,
      "average_instruments": 14.999,
      "coverage": 0.987271,
      "rank_turnover": 0.114865,
      "hit_ratio": 0.5295,
      "max_abs_library_correlation": null
    },
    "decay": {"5D_ic": 0.00380153, "10D_ic": 0.01344010, "20D_ic": 0.02410683, "40D_ic": 0.01936894},
    "regime_notes": "Long historical validation across the 15-instrument cross-asset universe. Positive predictive association is strongest at 20D and remains positive at 40D; breadth conditioning raises turnover versus the unconditioned trend signal. Small cross-section implies conservative interpretation.",
    "signal_artifact": "scripts/miner_3_20351025_breadth_confirmed_trend_signal.csv",
