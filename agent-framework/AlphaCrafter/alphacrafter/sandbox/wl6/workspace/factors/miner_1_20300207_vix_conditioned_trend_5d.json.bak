{
  "factor_id": "vix_conditioned_trend_5d",
  "factor_name": "VIX-conditioned trend agreement",
  "version": "1.0",
  "calculation": {
    "expression": "demean_cs((return_20d / realized_vol_20d) * agreement(sign(return_5d), sign(return_20d), sign(return_60d)) * regime_coef)",
    "description": "Volatility-scaled multi-horizon trend agreement. regime_coef is 1 in normal lagged VIX regimes and -0.5 when lagged 60-day VIX percentile exceeds 0.8, reducing or reversing trend exposure during volatility stress. Cross-sectional demean is applied each date. VIX is observation-only and lagged one session.",
    "signal_provenance": {
      "script": "scripts/miner_1_20300207_vix_conditioned_trend.py",
      "inputs": "tradable benchmark closes plus ../persistent/index_data/VIX.csv",
      "artifact": "reproducible script; no future data used"
    }
  },
  "dependencies": ["close", "VIX.close"],
  "parameters": {"momentum_short": 5, "momentum_medium": 20, "momentum_long": 60, "volatility_window": 20, "vix_percentile_window": 60, "vix_extreme_percentile": 0.8, "stress_regime_coefficient": -0.5, "forward_horizon_days": 5, "min_cross_section": 8},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-02 through 2030-02-06",
    "validated_at": "2030-02-07",
    "regime_notes": "15-instrument cross-asset universe; positive 5-day IC overall, with mixed annual signs in 2020, 2023, 2025, 2027 and 2028. Interpret uncertainty conservatively due to small cross-section.",
    "metrics": {
      "forward_horizon_days": 5,
      "valid_dates": 3086,
      "average_valid_instruments": 13.826960466623461,
      "ic": 0.010861882925649607,
      "icir": 1.9986831953333402,
      "ic_hit_ratio": 0.5155541153596889,
      "turnover": 0.375208229668793,
      "coverage": 0.904051623823125,
      "max_abs_library_correlation": null,
      "min_cross_section": 8
    },
    "thresholds": {"absolute_daily_paper_ic": 0.007, "absolute_daily_paper_icir": 0.084}
  },
  "tags": ["momentum", "trend", "volatility", "macro-conditioned", "cross-asset"],
  "last_validated": "2030-02-07"
}