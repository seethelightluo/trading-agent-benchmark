{
  "factor_id": "efficiency_continuation_20d",
  "factor_name": "Path-Efficiency Trend Continuation",
  "version": "1.0",
  "calculation": {
    "expression": "shift_1(0.65 * ((close/close[-20]-1) / sum(abs(daily_return),20)) + 0.35 * (close/close[-60]-1))",
    "description": "Ranks assets by lagged 20-day directional efficiency, blended with a slower 60-day trend. Directional efficiency rewards net movement achieved with a short absolute-return path, while the one-session lag prevents look-ahead."
  },
  "dependencies": ["close"],
  "parameters": {"efficiency_window": 20, "trend_window": 60, "efficiency_weight": 0.65, "trend_weight": 0.35, "lag_days": 1},
  "validation": {
