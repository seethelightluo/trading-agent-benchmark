{
  "factor_id": "miner_2_20320930_vix_conditioned_reversal_20d_10d",
  "factor_name": "VIX-Conditioned 20-Day Cross-Asset Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(close/lag(close,20)-1) * (1 + 0.5 * I[VIX > rolling_median(VIX,120)])",
    "description": "Ranks assets by negative trailing 20-session return, increasing reversal exposure by 50 percent when observation-only VIX is above its trailing 120-session median. VIX is used only as a macro conditioning signal and is not tradable. Signal is computed using information through the prior completed session."
  },
  "dependencies": ["close", "VIX"],
  "parameters": {
    "lookback_sessions": 20,
    "vix_median_window": 120,
    "vix_min_periods": 60,
    "stress_multiplier": 0.5,
    "forward_horizon_sessions": 10,
    "minimum_cross_section": 8
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2032-09-29",
    "signal_cutoff": "2032-09-29",
    "validation_timestamp": "2032-09-30T00:00:00Z",
    "regime_notes": "Positive full-sample result across 1,593 daily observations; annual IC was positive in 2026 and 2028-2031, negative in 2027 and 2032 YTD. Small cross-asset universe warrants conservative interpretation.",
    "metrics": {
      "ic": 0.031417,
      "icir": 0.106306,
      "ic_hit_ratio": 0.5323,
      "valid_dates": 1593,
      "average_instruments": 15.0,
      "coverage": 0.479291,
      "turnover": 0.058597,
      "decay": {
        "5d_ic": 0.007357,
        "5d_icir": 0.024510,
        "10d_ic": 0.031417,
        "10d_icir": 0.106306,
