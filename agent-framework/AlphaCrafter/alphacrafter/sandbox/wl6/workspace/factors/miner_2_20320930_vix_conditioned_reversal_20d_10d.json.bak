  },
  "signal_provenance": {
    "artifact_type": "reproducible_daily_cross_sectional_signal",
    "script": "scripts/miner_2_20320930_vix_conditioned_reversal.py",
    "universe": ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"],
    "macro_observation_only": ["VIX"],
    "forward_return": "close[t+10]/close[t]-1",
    "ic_method": "daily Spearman cross-sectional correlation; dates require at least 8 valid instruments"
