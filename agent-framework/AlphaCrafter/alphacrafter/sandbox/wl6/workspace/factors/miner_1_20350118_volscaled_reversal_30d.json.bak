{
  "factor_id": "volscaled_reversal_30d",
  "factor_name": "30-day volatility-scaled reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-rolling_sum(log(close/close[-1]), 30) / rolling_std(log(close/close[-1]), 20), shifted one completed session",
    "description": "Ranks assets contrarian to their trailing 30-session return after normalization by trailing 20-session realized volatility. The one-session lag prevents look-ahead."
  },
  "dependencies": ["close"],
  "parameters": {"return_window": 30, "volatility_window": 20, "signal_lag": 1, "forward_horizon": 20, "minimum_cross_section": 8},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2035-01-17",
    "validated_on": "2035-01-18T00:00:00Z",
    "metrics": {
      "horizon_days": 20,
      "ic": 0.028569,
      "icir": 4.737,
      "ic_hit_ratio": 0.5331,
      "ic_observations": 2172,
      "average_instruments": 12.660,
      "coverage": 0.8440,
      "turnover": null,
      "decay": {"5d": 0.017392, "10d": 0.027874, "20d": 0.028569, "40d": -0.015123},
      "max_abs_library_correlation": null
    },
    "regime_notes": "Reversal direction was positive in all tested broad regimes at the 10-day diagnostic horizon: 2020-2027 IC +0.034580, 2028-2031 +0.030282, 2032-2035-01-17 +0.021649. Small cross-section warrants conservative interpretation.",
    "provenance": {
      "validation_script": "scripts/miner_1_20350118_volscaled_momentum_30d.py",
