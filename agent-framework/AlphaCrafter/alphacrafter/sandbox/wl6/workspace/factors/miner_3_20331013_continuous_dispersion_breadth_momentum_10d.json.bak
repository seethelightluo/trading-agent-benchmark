{
  "factor_id": "miner_3_20331013_continuous_dispersion_breadth_momentum_10d",
  "factor_name": "Continuous-dispersion-gated breadth relative momentum",
  "version": "1.0",
  "calculation": {
    "expression": "(r10 - cross_sectional_median(r10)) * breadth10 * clip(cross_sectional_dispersion60_ratio, 0, 1) / downside_semideviation20",
    "description": "Ranks ten-day relative momentum after multiplying by ten-day directional breadth and a continuous participation weight equal to current cross-sectional ten-day return dispersion divided by its trailing 60-date median, clipped to [0,1]. Downside semideviation scales risk.",
    "signal_artifact": "scripts/miner_3_20331013_continuous_dispersion_breadth_momentum_10d.py",
    "lookahead_control": "Signals use data through each signal date; forward returns begin after that date and are never used in factor construction."
  },
  "dependencies": ["close"],
  "parameters": {
    "momentum_window": 10,
    "breadth_window": 10,
    "downside_semideviation_window": 20,
    "dispersion_baseline_window": 60,
    "dispersion_baseline_min_periods": 30,
    "dispersion_weight_clip": [0.0, 1.0],
    "forward_horizon": 10,
    "universe_size": 15
  },
