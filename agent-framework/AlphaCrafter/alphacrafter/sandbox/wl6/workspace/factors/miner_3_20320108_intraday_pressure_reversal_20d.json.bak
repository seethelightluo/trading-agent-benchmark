{
  "factor_id": "miner_3_20320108_intraday_pressure_reversal_20d",
  "factor_name": "Relative Intraday Pressure Reversal 20D",
  "version": "1.0",
  "calculation": {
    "expression": "-((rolling_mean((close-open)/(high-low),10) - cross_sectional_mean(rolling_mean((close-open)/(high-low),10))) )",
    "description": "Ranks assets for 20-trading-day reversal using the negative of their ten-day average close-to-open pressure normalized by daily range, after removing the cross-asset mean. Higher values identify relatively weak intraday pressure expected to rebound."
  },
  "dependencies": ["open", "close", "high", "low"],
  "parameters": {"pressure_window": 10, "forward_horizon": 20, "minimum_valid_instruments": 8},
