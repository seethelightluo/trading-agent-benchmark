{
  "factor_id": "miner_2_20351206_dxy_regime_residual_momentum_40d",
  "factor_name": "DXY-Regime Residual Momentum Risk-Scaled 40D",
  "version": "2035-12-06",
  "calculation": {
    "expression": "cross_section_demean(((close/close.shift(20)-1)-cross_section_mean_20d_return)/(rolling_std(pct_change(close),60)+epsilon) * (1+0.35*clip(zscore_252d(DXY_20d_return),-2,2)))",
    "description": "Ranks 20-day asset momentum after removing the cross-sectional mean, scales by 60-day realized volatility, and modulates exposure according to the standardized 20-day DXY regime. DXY is observation-only and is not tradable."
  },
  "dependencies": ["close", "DXY observation-only close"],
  "parameters": {"momentum_window": 20, "risk_window": 60, "dxy_window": 20, "dxy_zscore_window": 252, "dxy_interaction": 0.35, "clip": [-2, 2], "epsilon": 1e-8, "forward_horizon": 40},
  "validation": {
    "status": "EFFECTIVE",
    "last_validated": "2035-12-06T00:00:00Z",
    "period": "2020-01-01 through 2035-12-05",
