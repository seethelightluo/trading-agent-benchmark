{
  "factor_id": "miner_3_20310724_vol_scaled_reversal_20d",
  "factor_name": "Volatility-Scaled Five-Day Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-return(close,5) / rolling_std(daily_return,20)",
    "description": "Ranks assets that recently underperformed after adjusting the five-day reversal magnitude by their 20-day realized volatility; higher values indicate stronger prospective 20-day rebound candidates.",
    "signal_horizon_days": 20,
    "as_of_rule": "Uses prices through the prior completed trading day only"
  },
  "dependencies": ["close"],
  "parameters": {"lookback_return_days": 5, "volatility_window_days": 20, "forward_horizon_days": 20, "min_cross_section": 8},
