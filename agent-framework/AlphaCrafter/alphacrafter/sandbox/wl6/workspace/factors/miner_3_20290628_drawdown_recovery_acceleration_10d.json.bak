{
  "factor_id": "miner_3_drawdown_recovery_acceleration_10d",
  "factor_name": "Volatility-Scaled Drawdown Recovery Acceleration",
  "version": "1.0",
  "calculation": {
    "expression": "(0.7*(close/rolling_min(close,60)-1)+0.3*(close/close.shift(20)-1))/(rolling_std(pct_change(close),60)*sqrt(20)+0.015)",
    "description": "Ranks assets by recovery from their 60-day trough, blended with recent 20-day trend, and scaled by realized volatility. All inputs are known at the decision date from completed closes."
  },
  "dependencies": ["close"],
  "parameters": {"recovery_window": 60, "trend_window": 20, "volatility_window": 60, "trend_weight": 0.3, "recovery_weight": 0.7, "vol_annualization_days": 20, "vol_floor": 0.015, "forward_horizon_days": 10},
