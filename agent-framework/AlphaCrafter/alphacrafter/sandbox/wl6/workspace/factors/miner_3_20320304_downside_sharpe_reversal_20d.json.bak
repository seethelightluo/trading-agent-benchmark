{
  "factor_id": "miner_3_20320304_downside_sharpe_reversal_20d",
  "factor_name": "Downside-volatility-scaled 20-day reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(close / close.shift(20) - 1) / (rolling_std(clip(pct_change, upper=0), 60) * sqrt(60) + 1e-12)",
    "description": "Reverse each asset's trailing 20-trading-day return and scale it by annualized downside realized volatility over the prior 60 trading days. Higher values indicate cheaper recent performance relative to downside risk."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "reversal_window_days": 20,
    "downside_vol_window_days": 60,
    "downside_vol_min_periods": 40,
    "epsilon": 1e-12,
    "universe_size": 15
  },
