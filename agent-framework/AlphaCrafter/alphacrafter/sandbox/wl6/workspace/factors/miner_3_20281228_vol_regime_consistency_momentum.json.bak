{
  "factor_id": "miner_3_vol_regime_consistency_momentum_20d",
  "factor_name": "Volatility-Regime Conditioned Consistency Momentum",
  "version": "1.0",
  "calculation": {
    "expression": "(close/close.shift(20)-1)/(std(pct_change(close),20)*sqrt(20)) * (0.5+0.5*(2*mean_20(pct_change(close)>0)-1)) / (1+max(std20/median_60(std20)-1,0))",
    "description": "Ranks 20-day risk-adjusted momentum, amplified by directional consistency and conditionally downweighted when current realized volatility exceeds its trailing 60-day median. All inputs are lagged completed daily observations at decision time."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "momentum_window": 20,
    "volatility_window": 20,
    "volatility_baseline_window": 60,
    "consistency_window": 20,
    "forward_horizon": 10,
    "min_cross_section": 8
  },
  "validation": {
