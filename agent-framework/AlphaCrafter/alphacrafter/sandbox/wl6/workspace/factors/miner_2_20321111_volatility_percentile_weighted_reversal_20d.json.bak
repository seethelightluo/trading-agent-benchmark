    "cutoff": "2032-11-10"
  },
  "dependencies": ["close"],
  "parameters": {"return_window_days": 20, "volatility_window_days": 20, "percentile_window_days": 252, "percentile_min_periods": 126, "base_weight": 0.5, "forward_horizon_days": 20},
