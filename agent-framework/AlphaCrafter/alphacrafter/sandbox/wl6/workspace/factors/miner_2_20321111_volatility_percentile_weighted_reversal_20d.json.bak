{
  "factor_id": "miner_2_20321111_volatility_percentile_weighted_reversal_20d",
  "factor_name": "Volatility-percentile-weighted 20-day reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-sum_return(close,20) * (0.5 + percentile_rank(rolling_std(pct_change(close),20),252))",
    "description": "Ranks each instrument's recent realized volatility over its trailing 252-day history and weights the 20-day reversal signal more strongly for historically high-volatility instruments. The signal is positive for recent losers and negative for recent winners.",
