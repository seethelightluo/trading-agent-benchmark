{
  "factor_id": "miner_3_risk_scaled_trend_contrarian_20d",
  "factor_name": "Risk-Scaled Trend Contrarian",
  "version": "1.0",
  "calculation": {
    "expression": "-pct_change(close,20) / (rolling_std(pct_change(close,1),60) * sqrt(20) + 1e-12)",
    "description": "Ranks assets higher when their trailing 20-day return is more negative after adjustment for their trailing 60-day realized daily volatility. The contrarian sign favors subsequent rebound while preventing raw-return comparisons from being dominated by high-volatility assets.",
