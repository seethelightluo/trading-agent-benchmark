{
  "factor_id": "short_consistency_ewma_momentum_10d",
  "factor_name": "Short-Horizon EWMA-Volatility-Scaled Consistency Momentum",
  "version": "1.0",
  "calculation": {
    "expression": "pct_change(close,10) * (2 * mean_positive_daily_returns(10) - 1) / (EWMA_std_daily_returns(span=20) * sqrt(10) + 1e-12)",
    "description": "Ranks assets by recent ten-day directional momentum, rewarding a consistent daily return sign and scaling by exponentially weighted recent risk. Positive values indicate persistent upward movement; negative values indicate persistent downward movement."
  },
  "dependencies": ["close"],
  "parameters": {"momentum_window": 10, "consistency_window": 10, "ewma_span": 20, "annualization_window": 10, "forward_horizon": 10, "epsilon": 1e-12},
