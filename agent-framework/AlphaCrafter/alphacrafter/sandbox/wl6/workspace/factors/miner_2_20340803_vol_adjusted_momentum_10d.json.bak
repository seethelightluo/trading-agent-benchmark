{
  "factor_id": "vol_adjusted_momentum_10d",
  "factor_name": "Volatility-Adjusted Dual-Horizon Momentum",
  "version": "1.0",
  "calculation": {
    "expression": "shift(0.70*((close/close.shift(10)-1)/(rolling_std(pct_change(close),20)*sqrt(10))) + 0.30*(close/close.shift(60)-1), 1)",
    "description": "Ranks instruments by lagged ten-day momentum scaled by recent realized volatility, blended with an unscaled 60-day trend return. The one-session lag prevents look-ahead use of the latest completed close."
  },
  "dependencies": ["close"],
  "parameters": {"short_window": 10, "vol_window": 20, "long_window": 60, "short_weight": 0.70, "long_weight": 0.30, "lag": 1, "minimum_cross_section": 8},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2034-08-02",
    "validation_timestamp": "2034-08-03T00:00:00Z",
    "metrics": {
      "primary_horizon_days": 10,
      "ic": 0.01051197,
      "icir": 2.21758988,
      "hit_ratio": 0.5188,
      "valid_dates": 4416,
      "average_instruments": 13.45,
      "coverage": 0.8965,
      "turnover_proxy": 0.11151704,
      "decay": {"5d_ic": 0.00695307, "10d_ic": 0.01051197, "20d_ic": 0.01060927, "40d_ic": 0.01583746},
      "max_abs_library_correlation": null
    },
    "thresholds": {"minimum_absolute_daily_paper_ic": 0.007, "minimum_absolute_daily_paper_icir": 0.084},
    "regime_notes": "10D IC was +0.01159 in 2020-2024, +0.02866 in 2025-2029, -0.01153 in 2030-2032, and -0.01723 in 2033-2034; full-sample admission is strong but recent drift is adverse, so use modest ensemble weight and monitor recency.",
    "universe": "15 tradable benchmark instruments; dates require at least 8 valid instruments",
    "provenance": {"validation_script": "scripts/miner_2_20340803_vol_adjusted_momentum_10d.py", "signal_artifact": "scripts/miner_2_20340803_vol_adjusted_momentum_10d_signal.csv"}
  },
  "tags": ["momentum", "volatility_adjusted", "trend", "cross_asset"],
