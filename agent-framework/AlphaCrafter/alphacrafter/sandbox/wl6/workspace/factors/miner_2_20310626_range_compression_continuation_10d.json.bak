{
  "factor_id": "miner_2_20310626_range_compression_continuation_10d",
  "factor_name": "Volatility Compression Breakout Continuation",
  "version": "1.0",
  "calculation": {
    "expression": "sum(return(close,1),10)/(rolling_std(daily_returns,10)+1e-12) * clip(rolling_std(daily_returns,40)/(rolling_std(daily_returns,10)+1e-12),0.25,4.0)",
    "description": "Ranks assets whose recent 10-day directional move is large on a volatility-normalized basis and has emerged during relative short-term volatility compression versus the 40-day baseline. Positive factor values indicate continuation. All inputs use data available through the prior completed day.",
    "direction": 1
  },
  "dependencies": ["close", "daily_returns"],
  "parameters": {
    "return_window": 10,
    "short_volatility_window": 10,
    "long_volatility_window": 40,
    "short_volatility_min_periods": 8,
    "long_volatility_min_periods": 25,
    "compression_ratio_clip": [0.25, 4.0],
    "forward_horizon_days": 10
  },
  "validation": {
