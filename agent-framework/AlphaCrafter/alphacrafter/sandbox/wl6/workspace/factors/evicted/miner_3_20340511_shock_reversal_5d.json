{
  "factor_id": "miner_3_20340511_shock_reversal_5d",
  "factor_name": "Dispersion-Gated Volatility-Normalized Shock Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "shift_1((-return_5d / (realized_vol_20d * sqrt(5))) * clip(cross_sectional_dispersion_20d / median_dispersion_120d, 0.5, 2.0))",
    "description": "Ranks recent five-day shocks for cross-asset reversal, normalizes each shock by 20-day realized volatility, and increases the signal when cross-sectional daily-return dispersion is elevated. The one-session lag prevents look-ahead."
