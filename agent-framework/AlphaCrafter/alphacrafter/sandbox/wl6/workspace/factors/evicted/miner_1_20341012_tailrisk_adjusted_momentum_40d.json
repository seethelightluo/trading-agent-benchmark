  "factor_name": "Tail-risk-adjusted medium-term momentum",
  "version": "1.0",
  "calculation": {
    "expression": "cross_sectional_demean(shift((close/shift(close,20)-1)/(rolling_std(where(pct_change(close)<0,pct_change(close),0),40)*sqrt(40)),1))",
    "description": "Ranks 20-day price momentum after scaling by 40-day downside deviation; negative daily returns contribute to downside risk and the signal is lagged one completed session to avoid look-ahead."
