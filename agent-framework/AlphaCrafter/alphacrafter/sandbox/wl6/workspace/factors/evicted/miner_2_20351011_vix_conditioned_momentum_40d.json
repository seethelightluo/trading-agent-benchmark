  "factor_name": "VIX-Regime Conditioned Volatility-Scaled Relative Momentum",
  "version": "1.0",
  "calculation": {
    "expression": "rank_demean((close/close.shift(60)-1) / rolling_std(pct_change(close),60)) * (1 if VIX trailing 252-day percentile < 70% else -1)",
    "description": "Cross-sectional 60-trading-day relative momentum, scaled by each asset's 60-day return volatility. The signal follows momentum in normal and calm VIX regimes and reverses momentum when the observation-only VIX is at or above its trailing 70th percentile. All inputs are lagged completed-session data."
  },
