  "factor_name": "Downside-volatility-scaled three-day shock reversal",
  "version": "1.0",
  "calculation": {
    "expression": "(-sum(pct_change(close), 3)) * downside_vol_60 / (downside_vol_20 + 1e-8), shifted_by_1_day",
