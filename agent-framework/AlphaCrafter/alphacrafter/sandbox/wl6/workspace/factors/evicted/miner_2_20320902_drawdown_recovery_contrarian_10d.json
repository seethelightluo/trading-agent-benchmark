{
  "factor_id": "miner_2_20320902_drawdown_recovery_contrarian_10d",
  "factor_name": "Downside-normalized drawdown-recovery contrarian",
  "version": "1.0",
  "calculation": {
    "expression": "-(close / rolling_min(close,60,min_periods=40) - 1) / (sqrt(rolling_mean(min(pct_change(close),0)^2,60,min_periods=40))*sqrt(20)) * (0.5 + 0.5*I[pct_return(close,20)>0])",
    "description": "Fades mature 60-session rebounds from the rolling trough, normalizing by 60-session downside volatility and modestly increasing the contrarian signal when the recent 20-session return is positive. All inputs are lagged through the decision cutoff."
  },
  "dependencies": [
    "close"
  ],
