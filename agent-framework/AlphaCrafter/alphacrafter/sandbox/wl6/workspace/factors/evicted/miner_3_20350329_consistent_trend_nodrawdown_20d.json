  "factor_name": "Consistent Trend Volatility-Normalized Momentum",
  "version": "1.0",
  "calculation": {
    "expression": "(close.pct_change(60) * (1 + rolling_mean(sign(pct_change(close)) > 0, 40) - 0.5) / (rolling_std(pct_change(close), 40) * sqrt(252))).shift(1)",
