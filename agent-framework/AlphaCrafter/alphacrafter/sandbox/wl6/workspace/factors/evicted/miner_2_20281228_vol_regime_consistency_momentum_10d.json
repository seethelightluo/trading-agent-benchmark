{
  "factor_id": "miner_2_20281228_vol_regime_consistency_momentum_10d",
  "factor_name": "Volatility-Regime Consistency Risk-Adjusted Momentum",
  "version": "1.0",
  "calculation": {
    "expression": "(return_20d / (realized_volatility_20d * sqrt(20))) * (0.5 + 0.5 * ((fraction_positive_returns_20d - 0.5) * 2)) / (1 + max(realized_volatility_20d / median(realized_volatility_20d, 60d) - 1, 0))",
    "description": "Ranks assets by 20-day momentum normalized by 20-day realized volatility, rewards consistency of positive daily returns, and attenuates the signal when current volatility exceeds its trailing 60-day median. All inputs are lagged to the decision date and no future data is used."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "momentum_window_days": 20,
    "realized_volatility_window_days": 20,
    "volatility_regime_median_window_days": 60,
    "consistency_window_days": 20,
    "forward_horizon_days": 10,
    "annualization": "sqrt(20)"
  },
