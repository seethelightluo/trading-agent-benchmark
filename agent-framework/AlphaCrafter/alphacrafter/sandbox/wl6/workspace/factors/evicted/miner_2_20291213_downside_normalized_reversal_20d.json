  "factor_name": "Downside-Volatility-Normalized Medium-Horizon Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-pct_change(close,20) / max(annualized_20d_downside_volatility, 0.05)",
    "description": "Ranks assets higher when their 20-day return is more negative after normalization by the standard deviation of negative daily returns over the trailing 20 sessions. Downside volatility uses at least 10 negative-return observations when available; a 5% annualized floor stabilizes the ratio."
