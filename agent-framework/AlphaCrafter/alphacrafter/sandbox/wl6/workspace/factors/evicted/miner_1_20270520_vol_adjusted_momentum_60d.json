  "factor_name": "60-day momentum normalized by 20-day volatility",
  "version": "1.0",
  "calculation": {
    "expression": "shift_1(rolling_sum(pct_change(close), 60) / rolling_std(pct_change(close), 20))",
    "description": "For each tradable asset, compute the trailing 60-session simple return sum divided by trailing 20-session daily return volatility, then lag the signal by one completed session to prevent lookahead. Higher values indicate stronger volatility-adjusted medium-term momentum."
