  "factor_name": "Risk-Adjusted Intraday Close-Location Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-rolling_mean((close-open)/(high-low), 3, min_periods=2) / (rolling_std(close.pct_change(),20,min_periods=15)*sqrt(20)+0.02)",
    "description": "Ranks assets whose recent closes were relatively weak within their daily ranges, with the signal normalized by 20-day realized volatility; positive values represent stronger expected short-horizon reversal. All inputs are lagged through the completed signal date."
