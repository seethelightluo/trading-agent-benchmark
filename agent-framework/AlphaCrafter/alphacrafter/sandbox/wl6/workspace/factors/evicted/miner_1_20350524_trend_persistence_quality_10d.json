  "factor_name": "Trend Persistence Quality 10D",
  "version": "1.0",
  "calculation": {
    "expression": "((close/close.shift(20)-1) / (rolling_std(pct_change(close),40)*sqrt(252)) * (2*rolling_mean(I[pct_change(close)>0],20)-1)).shift(1)",
    "description": "Ranks assets by lagged 20-day momentum, annualized volatility normalization, and consistency of positive daily returns over the preceding 20 sessions. The consistency term ranges from -1 to +1 and rewards persistent trends while penalizing choppy or contrary paths. All inputs are lagged one completed session."
  },
