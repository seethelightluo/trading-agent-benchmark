  "factor_name": "Downside-Risk-Scaled 10-Day Momentum",
  "version": "1.0",
  "calculation": {
    "expression": "pct_change(close,10) / sqrt(rolling_mean(min(pct_change(close,1),0)^2,20))",
    "description": "Ranks assets by recent 10-day return per unit of recent 20-day downside volatility, rewarding positive momentum achieved with limited downside risk. Values are winsorization-free and use only information available at the observation date."
