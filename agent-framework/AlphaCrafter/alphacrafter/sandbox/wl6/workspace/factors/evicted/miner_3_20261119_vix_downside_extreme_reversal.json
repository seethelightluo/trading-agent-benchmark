{
  "factor_id": "miner_3_vix_downside_extreme_reversal_1d",
  "factor_name": "VIX extreme shock downside-only volatility-scaled reversal",
  "version": "1.3",
  "calculation": {
    "expression": "max(-asset_return[t-1] / rolling_std(asset_return,20)[t-1], 0) * cap(max(VIX_return[t-1],0) / lagged_60d_quantile(VIX_return,0.75)[t-1], 0, 3) * I(VIX_return[t-1] > lagged_60d_quantile(VIX_return,0.75)[t-1])",
    "description": "Ranks assets higher when they had a negative prior-day return, scaled by prior 20-session volatility, after an extreme positive prior VIX return. Positive prior asset returns receive zero signal; all inputs are lagged.",
    "lookahead_control": "At date t, only t-1 and earlier close/VIX observations are used; forward returns begin at t close and extend through t+h."
  },
  "dependencies": [
    "close",
    "VIX close"
  ],
  "parameters": {
    "asset_vol_window": 20,
    "asset_vol_min_periods": 15,
    "vix_quantile_window": 60,
    "vix_quantile": 0.75,
    "vix_quantile_min_periods": 40,
    "shock_cap": 3,
