{
  "factor_id": "dispersion_shock_reversal_20d",
  "factor_name": "Cross-Asset Dispersion-Gated Five-Day Shock Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "median_demean(shift1(-(ret5/(vol20+eps))*clip(disp5/median60(disp5),0.75,1.75)))",
    "description": "For each tradable asset, take the contrarian five-session return shock scaled by its 20-session realized volatility. Multiply by the cross-sectional median five-session return dispersion relative to its trailing 60-session median, clipped to avoid unstable amplification. Lag one completed session and median demean cross-sectionally. Higher values indicate stronger expected forward returns."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "shock_window": 5,
    "volatility_window": 20,
    "dispersion_window": 5,
    "dispersion_baseline_window": 60,
    "dispersion_clip": [
      0.75,
      1.75
    ],
    "lag": 1,
    "minimum_valid_instruments": 8
  },
