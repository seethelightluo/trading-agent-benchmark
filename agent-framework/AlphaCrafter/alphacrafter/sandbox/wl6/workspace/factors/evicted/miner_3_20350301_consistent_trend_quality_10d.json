{
  "factor_id": "consistent_trend_quality_10d",
  "factor_name": "Volatility- and Drawdown-Penalized Consistent Trend Quality",
  "version": "1.0",
  "calculation": {
    "expression": "((close/close.shift(60)-1) * (rolling_mean(pct_change(close)>0,40)-0.5) + (close/close.shift(60)-1)) / (rolling_std(pct_change(close),40)*sqrt(252)*(1 + max(0, 1-close/rolling_max(close,120)))) ; lag 1",
    "description": "Ranks medium-term momentum after rewarding directional consistency and penalizing realized volatility and current drawdown. The signal is lagged one completed session to avoid look-ahead."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "momentum_window": 60,
