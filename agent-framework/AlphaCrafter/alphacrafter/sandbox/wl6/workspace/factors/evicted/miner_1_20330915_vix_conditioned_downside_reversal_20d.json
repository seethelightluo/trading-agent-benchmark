{
  "factor_id": "miner_1_20330915_vix_conditioned_downside_reversal_20d",
  "factor_name": "VIX-Conditioned Downside-Risk-Adjusted 20-Day Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "[-pct_change(close,20) / rolling_std(where(daily_return < 0, daily_return, 0),40)] * clip(1/(1 + rolling_mean(VIX,20)/rolling_mean(VIX,120)),0.35,0.8)",
    "description": "Downside-risk-adjusted 20-day reversal scaled by a smooth observation-only VIX regime gate. The gate reduces signal magnitude during elevated volatility while preserving cross-sectional ordering; all inputs are lagged completed daily observations."
  },
  "dependencies": [
    "close",
    "daily_returns",
    "VIX"
  ],
  "parameters": {
    "return_window": 20,
    "downside_volatility_window": 40,
    "vix_fast_window": 20,
    "vix_slow_window": 120,
    "gate_lower": 0.35,
    "gate_upper": 0.8,
    "forward_horizon_days": 10,
    "minimum_cross_section": 8
  },
