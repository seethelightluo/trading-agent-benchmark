  "factor_name": "Downside-Risk-Adjusted Medium-Term Momentum",
  "version": "1.0",
  "calculation": {
    "expression": "rolling_sum(pct_change(close),20) / (sqrt(rolling_mean(min(pct_change(close),0)^2,40))*sqrt(20)+1e-12)",
    "description": "Ranks assets by 20-day cumulative return normalized by trailing 40-day downside deviation; upside volatility is not penalized. Signal uses completed data only and is evaluated against forward 10-day returns."
