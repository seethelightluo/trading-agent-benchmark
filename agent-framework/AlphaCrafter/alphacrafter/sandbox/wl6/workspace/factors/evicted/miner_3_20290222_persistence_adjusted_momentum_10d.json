{
  "factor_id": "miner_3_20290222_persistence_adjusted_momentum_10d",
  "factor_name": "Peer-Relative Persistence-Adjusted Momentum",
  "version": "1.0",
  "calculation": {
    "expression": "((return_20d - cross_sectional_median(return_20d)) / annualized_downside_or_total_volatility_60d) * (0.5 + 0.5 * (2 * positive_return_fraction_20d - 1))",
    "description": "Ranks instruments by 20-day momentum relative to the same-date universe median, scales by trailing 60-day return volatility, and adjusts magnitude using the persistence of positive daily returns over the last 20 sessions. Uses completed daily observations only. The research implementation uses total 60-day volatility as the denominator and persistence multiplier in [0,1]."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "momentum_window_days": 20,
    "volatility_window_days": 60,
    "persistence_window_days": 20,
    "forward_horizon_days": 10,
    "cross_sectional_center": "median",
    "volatility_annualization": 252,
    "persistence_definition": "2 * fraction_of_positive_daily_returns - 1",
    "persistence_multiplier": "0.5 + 0.5 * persistence"
  },
