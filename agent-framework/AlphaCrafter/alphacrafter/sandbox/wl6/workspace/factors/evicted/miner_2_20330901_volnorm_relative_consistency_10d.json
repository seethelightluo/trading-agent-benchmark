  "factor_name": "Volatility-normalized relative consistency momentum",
  "version": "1.0",
  "calculation": {
    "expression": "((close/close.shift(20)-1) - cross_sectional_median_20d_return) * (2*rolling_mean(close.pct_change()>0,20)-1) / rolling_std(close.pct_change(),20)",
