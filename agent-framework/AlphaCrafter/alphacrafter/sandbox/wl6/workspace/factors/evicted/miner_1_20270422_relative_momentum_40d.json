  "factor_name": "40-Day Cross-Asset Relative Momentum",
  "version": "1.1",
  "calculation": {
    "expression": "cross_sectional_demean(close / close.shift(40) - 1).shift(1)",
    "description": "For each tradable benchmark asset, compute 40-session price momentum using information through the prior completed session, then subtract the same-day cross-sectional median. Positive values identify relative leaders and negative values identify laggards."
