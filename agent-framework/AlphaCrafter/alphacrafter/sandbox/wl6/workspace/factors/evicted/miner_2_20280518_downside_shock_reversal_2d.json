  "factor_name": "Downside Shock Reversal 2-Day",
  "version": "1.0",
  "calculation": {
    "expression": "(-sum(return,2) * clip(downside_vol_60 / (downside_vol_15 + 1e-8), 0.5, 2.0)).shift(1)",
    "description": "Reverse the trailing two-session return, scale it by a bounded ratio of 60-day to 15-day downside volatility, and lag one completed session to prevent look-ahead. Higher values indicate attractive rebound potential after a short shock, with the multiplier adapting to the downside-volatility regime."
  },
