  "factor_id": "miner_2_20341221_downside_adjusted_momentum_40d",
  "factor_name": "Downside-adjusted momentum with drawdown penalty",
  "version": "1.0",
  "calculation": {
    "expression": "median_center(shift1((close/shift(close,20)-1)/(sqrt(mean(clip(pct_change(close),upper=0)^2,20))*sqrt(20)+0.005) + 0.25*(close/rolling_max(close,60)-1)))",
    "description": "Twenty-session price momentum divided by downside semideviation, with a modest 60-session drawdown penalty; lagged one completed session and cross-sectionally median-centered. Higher values indicate stronger risk-adjusted trend and less drawdown."
