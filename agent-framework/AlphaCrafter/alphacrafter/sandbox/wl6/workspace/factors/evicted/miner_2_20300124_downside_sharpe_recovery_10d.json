{
  "factor_id": "miner_2_20300124_downside_sharpe_recovery_10d",
  "factor_name": "Downside-Sharpe Recovery with Medium-Trend Gate",
  "version": "1.0",
  "calculation": {
    "expression": "(return(close,10) / (sqrt(mean(min(return(close,1),0)^2,30))*sqrt(30) + 1e-6)) * (0.5 + 0.5*I[return(close,40)>0])",
    "description": "Ranks assets by recent 10-session recovery efficiency, dividing return by downside deviation estimated from the trailing 30 daily returns. The score is retained at full strength when the 40-session trend is positive and halved otherwise. Prices are observed through the prior completed session at decision time; no future data are used. Higher values predict higher subsequent 10-session returns."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "recovery_window_sessions": 10,
    "downside_window_sessions": 30,
    "trend_gate_window_sessions": 40,
    "downside_deviation": "sqrt(mean(min(daily_return,0)^2))*sqrt(30)",
    "negative_trend_multiplier": 0.5,
    "epsilon": 1e-06,
    "minimum_cross_section": 8,
    "universe_size": 15,
    "forecast_horizon_sessions": 10
  },
  "signal_provenance": {
    "artifact_type": "research_script",
    "script": "scripts/miner_2_20300124_downside_sharpe_recovery.py",
    "signal_definition": "sig=(P.pct_change(10)/sqrt(mean(clip(P.pct_change(1),upper=0)^2,30)*30 + epsilon))*(0.5+0.5*(P.pct_change(40)>0))",
    "forward_return_definition": "close.shift(-10)/close - 1",
    "cross_sectional_statistic": "Spearman rank correlation",
