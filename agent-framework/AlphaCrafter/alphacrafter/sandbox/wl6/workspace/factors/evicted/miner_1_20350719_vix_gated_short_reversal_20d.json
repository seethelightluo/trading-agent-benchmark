{
  "factor_id": "miner_1_vix_gated_short_reversal_20d",
  "factor_name": "VIX-Gated Volatility-Scaled Short-Term Reversal 20D",
  "version": "1.0",
  "calculation": {
    "expression": "cross_sectional_demean((-(rolling_sum(pct_change(close),10)/(rolling_std(pct_change(close),20)+1e-8)) * clip(1+0.35*tanh((VIX-rolling_mean(VIX,252))/(rolling_std(VIX,252)+1e-8)),0.65,1.35)).shift(1))",
    "description": "Ranks lagged ten-session reversal scaled by twenty-session volatility, with a bounded VIX z-score gate. Higher values favor recent losers expected to mean-revert; elevated VIX modestly increases signal magnitude. VIX is observation-only and is never traded."
  },
  "dependencies": [
    "close",
    "VIX"
  ],
  "parameters": {
    "reversal_window": 10,
    "volatility_window": 20,
    "vix_window": 252,
    "vix_gate_coefficient": 0.35,
    "gate_bounds": [
      0.65,
      1.35
    ],
    "lag": 1,
    "horizon": 20
  },
