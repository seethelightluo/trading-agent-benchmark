  "factor_name": "Volatility-Scaled Directional Efficiency Momentum",
  "version": "1.0",
  "calculation": {
    "expression": "(sum_20(pct_change(close)) / (sum_20(abs(pct_change(close))) + 1e-12)) / (std_40(pct_change(close)*sqrt(20)) + 1e-12)",
