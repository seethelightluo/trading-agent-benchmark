  "factor_name": "Fast Path-Efficient Relative Trend Quality",
  "version": "1.0",
  "calculation": {
    "expression": "shift(1, (relative_return(close,20) / (realized_volatility(returns,15)*sqrt(20))) * clip(abs(relative_return(close,20))/rolling_sum(abs(returns),20),0,1))",
    "description": "Cross-sectional 20-trading-day return relative to the same-day cross-sectional median, normalized by 15-day realized volatility and multiplied by 20-day path efficiency. The one-session lag prevents look-ahead. The admitted horizon is 40 trading days."
