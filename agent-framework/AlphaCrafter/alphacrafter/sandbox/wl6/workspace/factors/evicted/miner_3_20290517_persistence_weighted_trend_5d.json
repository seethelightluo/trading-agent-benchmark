  "factor_name": "Persistence-Weighted Medium-Term Trend",
  "version": "1.0",
  "calculation": {
    "expression": "pct_change(close,40) * (0.5 + rolling_mean(indicator(pct_change(close,1)>0),20,min_periods=15))",
    "description": "Ranks assets by 40-session return, scaled by the fraction of positive daily sessions over the recent 20-session window. The positive-session persistence term rewards smoother, more consistently advancing trends without using future data."
