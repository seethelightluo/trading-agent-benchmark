{
  "factor_id": "miner_3_drawdown_recovery_20d",
  "factor_name": "Risk-Adjusted Momentum with Drawdown Recovery",
  "version": "1.0",
  "calculation": {
    "expression": "close.pct_change().rolling(20).sum()/(close.pct_change().rolling(40).std()*sqrt(20)) + 0.50*clip(close/rolling_min(close,60)-1,0,2)",
    "description": "Ranks assets by 20-session return normalized by 40-session realized volatility, augmented by a bounded recovery distance from the trailing 60-session trough. All inputs are lagged to the completed observation date."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "momentum_window": 20,
    "volatility_window": 40,
    "trough_window": 60,
    "recovery_weight": 0.5,
    "recovery_clip": [
      0.0,
      2.0
    ],
    "forward_horizon": 10
  },
