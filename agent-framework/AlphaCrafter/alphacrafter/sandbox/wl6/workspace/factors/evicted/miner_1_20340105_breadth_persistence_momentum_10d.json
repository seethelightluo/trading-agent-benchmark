  "factor_name": "Breadth-Persistence Volatility-Adjusted Momentum",
  "version": "1.0",
  "calculation": {
    "expression": "pct_change(close,10) * (2 * rolling_mean(pct_change(close,1) > 0, 10) - 1) / rolling_std(pct_change(close,1),20)",
    "description": "Ten-day price momentum, signed by the asset's fraction of up days over the same ten-day window and scaled by trailing 20-day return volatility. Positive breadth persistence confirms continuation; negative breadth persistence reverses the momentum sign. Computed using data available at the signal date only."
