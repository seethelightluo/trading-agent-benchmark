{
  "factor_id": "miner_3_vix_extreme_reversal_1d",
  "factor_name": "Extreme Lagged VIX-Shock Volatility-Scaled Reversal",
  "version": "20261105",
  "calculation": {
    "expression": "-(asset_return_1d / lagged_20d_return_volatility) * capped_positive_lagged_VIX_return_relative_to_prior_60d_75th_percentile",
    "description": "Fade the prior asset return, scaled by prior 20-session volatility, only after an unusually large VIX increase. The shock is the prior session VIX return divided by its prior 60-session 75th percentile, retained only when above that percentile and capped at 3. All signal inputs are shifted so the decision date uses completed information only."
  },
  "dependencies": [
    "close",
    "VIX.close"
  ],
  "parameters": {
    "volatility_window": 20,
    "volatility_min_periods": 15,
    "vix_quantile_window": 60,
    "vix_quantile": 0.75,
    "vix_quantile_min_periods": 40,
    "shock_lag_sessions": 1,
    "shock_multiplier_cap": 3,
    "holding_horizon_sessions": 1,
    "cross_section_min_instruments": 8
  },
