  "factor_name": "10-Day Volatility-Normalized Momentum",
  "version": "1.0",
  "calculation": {
    "expression": "rolling_sum(pct_change(close),10) / (rolling_std(pct_change(close),20) * sqrt(10))",
    "description": "Ranks assets by their lagged 10-session return divided by trailing 20-session realized volatility. Signal uses only data available through the completed session and forecasts the next 10 sessions."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
