{
  "factor_id": "downside_volatility_premium_20d",
  "factor_name": "Cross-Asset Downside Realized Volatility Premium 20D",
  "version": "1.0",
  "calculation": {
    "expression": "shift(0.5 * downside_std(log_return,20) * sqrt(20) + 0.5 * downside_std(log_return,60) * sqrt(60), 1)",
    "description": "For each tradable asset, retain only negative daily log returns (positive returns set to zero), compute lagged 20-day and 60-day downside realized volatility, and average them. Higher lagged downside volatility receives a higher 20-day forward-return score.",
    "direction": "positive"
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "windows_days": [
      20,
      60
    ],
    "annualization_scale": "sqrt(window)",
    "lag_days": 1,
    "minimum_cross_section": 8,
    "return_definition": "log(close_t / close_t-1)",
    "downside_transform": "min(log_return, 0)"
  },
