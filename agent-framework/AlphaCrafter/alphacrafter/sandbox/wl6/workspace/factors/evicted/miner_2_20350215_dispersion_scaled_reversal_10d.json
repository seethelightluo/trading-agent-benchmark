  "factor_name": "Dispersion-Scaled Ten-Day Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "where(cross_asset_dispersion_20d_percentile > 0.5, -return_10d / (realized_volatility_20d * sqrt(252)), NaN), lagged_1d",
    "description": "Contrarian ten-day return scaled by each asset's 20-day realized volatility, active only when cross-asset daily-return dispersion is above its rolling 20-day median percentile. The signal is lagged one completed session to avoid look-ahead. Higher values indicate stronger rebound candidates during elevated dispersion."
  },
