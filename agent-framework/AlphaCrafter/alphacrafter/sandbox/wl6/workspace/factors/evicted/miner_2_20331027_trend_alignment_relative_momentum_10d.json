{
  "factor_id": "miner_2_20331027_trend_alignment_relative_momentum_10d",
  "factor_name": "Trend-alignment relative momentum with downside normalization",
  "version": "1.0",
  "calculation": {
    "expression": "((r_10 - cross_sectional_median(r_10)) * (1 + 0.5 * (2 * positive_day_fraction_10 - 1)) * sign(r_20)) / downside_semideviation_20",
    "description": "Ranks each tradable asset's 10-day return relative to the daily cross-sectional median, amplifies signals with consistent positive daily direction, preserves the intermediate 20-day trend direction, and scales by 20-day downside semideviation. The signal is observed at date t and predicts the next 10 trading-day return."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
