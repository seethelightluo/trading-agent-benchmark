  "factor_name": "Volatility-regime-scaled three-day shock reversal",
  "version": "1.0",
  "calculation": {
    "expression": "(-sum(return,3)) * (rolling_std(return,60) / rolling_std(return,20)), shifted by 1 day",
    "description": "Ranks assets for next-day performance by contrarian reversal of their lagged three-day return, scaled upward when current short-term volatility is below its 60-day baseline. All inputs are lagged one completed session to avoid look-ahead."
