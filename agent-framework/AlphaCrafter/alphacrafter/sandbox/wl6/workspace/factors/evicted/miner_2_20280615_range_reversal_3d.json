{
  "factor_id": "range_reversal_3d",
  "factor_name": "Three-Day Range-Normalized Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-sum(pct_change(close),3) / rolling_mean(true_range/close,20), lagged 1 session",
    "description": "Ranks assets positively when their prior three-session loss is large relative to their trailing 20-session average normalized true range. True range uses high-low and gaps from the prior close. The factor is shifted one completed session to prevent look-ahead."
