  "factor_id": "miner_3_sign_consistency_momentum_20d",
  "factor_name": "Sign-Consistency Risk-Adjusted Momentum",
  "version": "1.0",
  "calculation": {
    "expression": "(sum(pct_change(close),20)/(std(pct_change(close),40)*sqrt(20))) * (0.5 + 0.5*abs(2*mean(pct_change(close)>0,20)-1))",
    "description": "Twenty-day cumulative return normalized by forty-day realized volatility, strengthened by persistence of daily return signs. The consistency multiplier ranges from 0.5 to 1.0 and uses only completed observations."
  },
