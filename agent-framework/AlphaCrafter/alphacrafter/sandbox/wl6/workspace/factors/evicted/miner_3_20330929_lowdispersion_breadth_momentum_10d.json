{
  "factor_id": "miner_3_20330929_lowdispersion_breadth_momentum_10d",
  "factor_name": "Low-dispersion gated downside-semideviation relative momentum",
  "version": "1.0",
  "calculation": {
    "expression": "((r10_i - median_cross_section(r10)) * breadth10_i * I(dispersion10 >= trailing60_median(dispersion10))) / downside_semideviation20_i",
    "description": "Ten-day return relative to the cross-sectional median, multiplied by ten-day directional breadth and suppressed to zero when cross-sectional ten-day return dispersion is below its trailing 60-observation median; divide by 20-day downside semideviation. The signal uses only data through the decision date and is evaluated against the subsequent 10-day return."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "relative_return_window": 10,
    "breadth_window": 10,
    "downside_semideviation_window": 20,
    "dispersion_window": 10,
    "dispersion_history_window": 60,
    "forward_horizon": 10,
    "minimum_cross_section": 8
  },
