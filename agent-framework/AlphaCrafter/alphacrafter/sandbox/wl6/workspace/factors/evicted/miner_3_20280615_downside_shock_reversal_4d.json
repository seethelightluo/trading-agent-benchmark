  "factor_name": "Capped downside-volatility-scaled four-day shock reversal",
  "version": "1.0",
  "calculation": {
    "expression": "(-sum(return,4)) * clip(downside_volatility_40 / (downside_volatility_10 + 1e-8), 0.5, 2.0), shifted by 1 completed day",
