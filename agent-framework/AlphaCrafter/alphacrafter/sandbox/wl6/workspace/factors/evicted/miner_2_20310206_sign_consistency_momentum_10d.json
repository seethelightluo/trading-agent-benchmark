  "factor_name": "Directional-Consistency Risk-Scaled Momentum",
  "version": "1.0",
  "calculation": {
    "expression": "(mean(sign(pct_change(close,1))>0,20)-mean(sign(pct_change(close,1))<0,20)) * pct_change(close,20)/(std(pct_change(close,1),20)*sqrt(20)), shifted_one_session",
