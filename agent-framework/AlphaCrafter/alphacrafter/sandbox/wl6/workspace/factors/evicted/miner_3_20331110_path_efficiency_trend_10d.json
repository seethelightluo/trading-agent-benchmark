{
  "factor_id": "miner_3_20331110_path_efficiency_trend_10d",
  "factor_name": "Path-efficiency scaled relative trend",
  "version": "1.0",
  "calculation": {
    "expression": "(return_10 / (sum_{j=0..9}|daily_return_{t-j}| + epsilon)) * (return_20 - cross_sectional_median(return_20)) / (rolling_std(daily_return,20) + epsilon)",
    "description": "Measures directional efficiency of the recent ten-day price path, then scales it by the instrument's cross-sectional relative twenty-day trend and by inverse realized volatility. Positive values favor assets with efficient directional movement and above-median intermediate trend; negative values favor inefficient/downward relative trends. Signal is evaluated using only data through the decision date and predicts the next ten trading-day return.",
    "lookahead_control": "At date t all inputs use closes through t; forward return is close[t+10]/close[t]-1 and is never used in the signal."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "efficiency_window": 10,
    "relative_trend_window": 20,
    "volatility_window": 20,
    "horizon": 10,
    "epsilon": 1e-12
  },
