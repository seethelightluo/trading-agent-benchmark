{
  "factor_id": "miner_2_20281130_vix_conditioned_sign_momentum_10d",
  "factor_name": "VIX-Conditioned Sign-Consistency Risk-Adjusted Momentum",
  "version": "1.0",
  "calculation": {
    "expression": "(rolling_sum(return,20)/(rolling_std(return,40)*sqrt(20))) * (0.5 + 0.5*2*abs(rolling_mean(return>0,20)-0.5)) * (1 - 0.40*lagged_1d_percentile(VIX,252))",
    "description": "Twenty-day risk-adjusted momentum, strengthened by directional sign consistency and scaled down when lagged VIX is at a high trailing percentile. VIX is observation-only and never traded; all inputs are lagged through the last completed session."
  },
  "dependencies": [
    "close",
    "VIX"
  ],
  "parameters": {
    "momentum_window": 20,
    "volatility_window": 40,
    "sign_window": 20,
    "vix_percentile_window": 252,
    "vix_lag_days": 1,
    "stress_scale": 0.4
  },
