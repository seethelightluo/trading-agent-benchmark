  "factor_name": "Tail-Adjusted Momentum 30D",
  "version": "1.0",
  "calculation": {
    "expression": "shift_1(pct_change(close,30) / (sqrt(30) * rolling_std(min(pct_change(close,1),0),30) + 1e-8))",
    "description": "Thirty-trading-day price momentum scaled by trailing downside volatility, lagged one completed day to prevent look-ahead. Higher values indicate stronger return per unit of downside risk."
