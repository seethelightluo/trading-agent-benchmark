  "factor_name": "Dispersion-Conditioned Medium-Term Momentum",
  "version": "1.0",
  "calculation": {
    "expression": "((close/close.shift(20)-1) - 0.35*(close/close.shift(3)-1)) / (rolling_std(pct_change(close),40)*sqrt(20)) * 1/(1+cross_sectional_std(raw_signal))",
    "description": "Risk-adjusted 20-day momentum with a modest three-day reversal penalty, multiplied by a common inverse cross-sectional dispersion scaler computed on the same lagged signal snapshot. All inputs use completed data only; the common scaler preserves cross-sectional ordering while moderating exposure in dispersed conditions."
  },
  "dependencies": [
    "close",
    "daily_returns"
  ],
  "parameters": {
    "momentum_window": 20,
    "reversal_window": 3,
    "reversal_penalty": 0.35,
    "volatility_window": 40,
    "dispersion_scaler": "1/(1+cross_sectional_std(raw_signal))",
    "forward_horizon": 10
  },
