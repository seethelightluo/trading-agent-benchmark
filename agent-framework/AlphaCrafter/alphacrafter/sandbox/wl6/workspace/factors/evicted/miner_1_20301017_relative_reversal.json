{
  "factor_id": "miner_1_20301017_relative_reversal",
  "factor_name": "Relative Cross-Asset Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-((close/close.shift(20)-1) - equal_weight_mean(pct_change(close).rolling_sum(20))) / rolling_std(pct_change(close),20)",
    "description": "Ranks assets by the negative of their 20-trading-day return relative to the equal-weight universe return, scaled by each asset's trailing 20-day return volatility. Higher values indicate stronger expected 10-day relative rebound. All prices are lagged through the prior completed session at decision time."
  },
