{
  "factor_id": "miner_2_range_location_momentum_10d",
  "factor_name": "Volatility-Normalized Momentum with Range Location Confirmation",
  "version": "1.0",
  "calculation": {
    "expression": "(sum(pct_change(close),20)/(std(pct_change(close),40)*sqrt(20))) * (0.5 + clip((close-rolling_min(close,60))/(rolling_max(close,60)-rolling_min(close,60)),0,1))",
    "description": "Ranks each asset using 20-session momentum normalized by 40-session realized volatility, amplified smoothly when price is near the upper part of its trailing 60-session range. Inputs are computed only through the prior completed session."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "momentum_window": 20,
    "volatility_window": 40,
    "range_window": 60,
    "location_floor": 0.5,
    "location_clip": [
      0.0,
      1.0
    ],
    "forward_horizon": 10
  },
