{
  "factor_id": "miner_2_20290125_trend_agreement_10d",
  "factor_name": "Multi-Horizon Trend Agreement Risk-Adjusted Momentum",
  "version": "1.0",
  "calculation": {
    "expression": "((close/close.shift(20))-1) / (std(pct_change(close),40)*sqrt(40)) * (sign(close/close.shift(10)-1)+sign(close/close.shift(20)-1)+sign(close/close.shift(60)-1))/3",
    "description": "Ranks 20-day momentum normalized by 40-day realized volatility, amplified when short, medium, and long horizon trends agree and attenuated when they conflict. Uses only completed prices available at the decision date."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
