{
  "factor_id": "vix_shock_reversal_10d",
  "factor_name": "VIX-regime volatility-scaled 5-day shock reversal",
  "version": "1.0",
  "calculation": {
    "expression": "lag1( -(close/shift(close,5)-1) / (rolling_std(pct_change(close),20)*sqrt(5)) * I(VIX > rolling_median(VIX,60)) )",
    "description": "Contrarian reversal of the prior five-session return, standardized by 20-session realized volatility and activated only when observation-only VIX is above its trailing 60-session median. The full signal is lagged one session and cross-sectional median demeaned."
  },
  "dependencies": [
    "close",
    "VIX"
  ],
  "parameters": {
    "shock_lookback": 5,
    "volatility_lookback": 20,
    "volatility_min_periods": 15,
    "vix_regime_lookback": 60,
    "vix_min_periods": 40,
    "lag": 1,
    "min_cross_section": 8
  },
