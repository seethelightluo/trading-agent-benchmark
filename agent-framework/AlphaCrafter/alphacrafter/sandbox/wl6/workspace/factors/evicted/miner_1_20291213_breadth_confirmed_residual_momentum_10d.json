  "factor_name": "Breadth-Confirmed Residual Momentum",
  "version": "1.0",
  "calculation": {
    "expression": "((R20 - cross_sectional_median(R20)) / (rolling_std(R1,30)*sqrt(20)+0.01)) * (0.5 + cross_sectional_fraction(R20>0))",
