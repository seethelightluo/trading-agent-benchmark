{
  "factor_id": "miner_1_20300502_trend_acceleration_10d",
  "factor_name": "Risk-scaled trend acceleration",
  "version": "1.0",
  "calculation": {
    "expression": "((close/close.shift(20)-1) - (close/close.shift(60)-1)/3) / (rolling_std(pct_change(close),20)*sqrt(20)+1e-9)",
    "description": "Measures the deviation of recent 20-day return from the average 60-day trend pace, scaled by 20-day realized volatility. Positive values indicate acceleration; validation finds the inverse orientation more predictive at the 10-day horizon. Signal uses only completed historical prices."
  },
  "dependencies": ["close"],
  "parameters": {"recent_window": 20, "trend_window": 60, "vol_window": 20, "forward_horizon": 10, "direction": -1},
  "validation": {
