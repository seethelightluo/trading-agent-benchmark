{
  "factor_id": "miner_3_20351122_breadth_gated_residual_trend_40d",
  "factor_name": "Breadth-gated cross-asset relative residual risk-adjusted trend 40D",
  "version": "1.0",
  "calculation": {
    "expression": "gate * (0.6*(return_20d - cross_sectional_mean(return_20d)) + 0.4*(return_60d - cross_sectional_mean(return_60d))) / rolling_std_daily_return_60d",
    "description": "Ranks tradable instruments by cross-sectional residual medium/long trend after scaling by realized volatility. A smooth breadth gate based on the absolute deviation of 20D positive-return breadth from 50% attenuates signals in one-sided breadth regimes while retaining the relative ranking."
  },
  "dependencies": ["close", "daily_returns"],
  "parameters": {
    "short_return_window": 20,
    "long_return_window": 60,
    "volatility_window": 60,
    "short_weight": 0.6,
    "long_weight": 0.4,
    "breadth_window": 20,
    "breadth_gate": "0.5 + 0.5*(1 - 2*abs(breadth_20d - 0.5)), clipped to [0.5, 1.0]",
    "admission_horizon_days": 40
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2035-11-21, cutoff 2035-11-21",
    "metrics": {
      "ic": 0.01462890,
      "icir": 3.12273532,
      "daily_paper_ic": 0.01462890,
      "daily_paper_icir": 3.12273532,
      "horizon_days": 40,
      "dates": 4727,
      "average_instruments": 14.999,
      "instruments": 15,
      "coverage": 0.987324,
      "rank_turnover": 0.062193,
      "hit_ratio": 0.5219,
      "max_abs_library_correlation": null
    },
    "regime_notes": "Long-horizon validation across multiple regimes in the 15-instrument synthetic cross-asset universe. The 40D horizon passed the benchmark gates; 20D IC was 0.00689852 and therefore below the 0.0070 IC gate. Interpret uncertainty conservatively because the cross-section is small.",
    "thresholds": {"min_abs_daily_paper_ic": 0.007, "min_abs_daily_paper_icir": 0.084}
  },
  "signal_artifact": "scripts/miner_3_20351122_breadth_gated_residual_signal.csv",
  "validation_script": "scripts/miner_3_20351122_breadth_gated_residual.py",
  "tags": ["cross_asset", "trend", "momentum", "residual", "risk_adjusted", "breadth_conditioned"],
  "last_validated": "2035-11-22T00:00:00Z"
}
