{
  "factor_id": "miner_2_20261203_volatility_appetite",
  "factor_name": "Lagged cross-asset volatility appetite",
  "version": "1.1",
  "calculation": {
    "expression": "shift_1(rolling_std(pct_change(close), 10))",
    "description": "Ranks assets by their prior 10-session realized return volatility. Higher lagged volatility receives a higher score; the one-session lag prevents use of the decision day's close."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "volatility_window": 10,
    "lag": 1,
    "minimum_observations": 8
  },
