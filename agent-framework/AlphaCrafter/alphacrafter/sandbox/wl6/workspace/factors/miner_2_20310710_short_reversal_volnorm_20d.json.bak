{
  "factor_id": "miner_2_20310710_short_reversal_volnorm_20d",
  "factor_name": "Volatility-Normalized Short Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-pct_change(close,5)/(rolling_std(pct_change(close,1),20)*sqrt(5)+epsilon)",
    "description": "Ranks assets favoring five-day underperformers after scaling the short reversal by their 20-day realized volatility. The admitted validation horizon is 20 trading days; all inputs are lagged through the decision date and use no future data."
  },
  "dependencies": ["close"],
  "parameters": {"signal_lookback_days": 5, "volatility_lookback_days": 20, "min_periods": 15, "horizon_days": 20, "epsilon": 1e-12},
  "validation": {
