{
  "factor_id": "miner_1_20291129_regime_gated_reversal_10d",
  "factor_name": "Volatility-Regime-Gated Short-Horizon Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-R_10 / (sigma_20*sqrt(10)+0.01) * (1 + 0.6*clip(sigma_20/sigma_120 - 1, -0.5, 1.0))",
    "description": "For each tradable instrument, take the negative ten-day close-to-close return, scale by 20-day realized daily volatility annualization over the ten-day horizon plus a stabilizing constant, and amplify the signal when short volatility is elevated relative to its 120-day baseline. All inputs are lagged/current completed-day observations at decision time; forward returns are used only for validation."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "short_return_days": 10,
    "short_vol_days": 20,
    "long_vol_days": 120,
    "vol_min_periods": 15,
    "long_vol_min_periods": 60,
    "stabilizer": 0.01,
    "regime_clip_low": -0.5,
    "regime_clip_high": 1.0,
    "regime_amplitude": 0.6,
    "forward_horizon_days": 10,
    "minimum_cross_section": 8
  },
