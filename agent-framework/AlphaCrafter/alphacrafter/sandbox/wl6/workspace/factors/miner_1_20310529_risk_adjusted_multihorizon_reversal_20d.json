  "factor_name": "Risk-Adjusted Multi-Horizon Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(pct_change(close,20) + 0.5 * pct_change(close,60) / 3) / rolling_std(pct_change(close,1),30)",
    "description": "Cross-sectional reversal score: negate a blended 20-day return and scaled 60-day return, then normalize by 30-day realized daily volatility. Higher values indicate lower recent risk-adjusted performance and are expected to mean-revert over the selected 20-trading-day horizon. All inputs are lagged through the decision date."
