{
  "factor_id": "miner_1_20311030_downside_adjusted_momentum_10d",
  "factor_name": "Downside-Adjusted 10-Day Momentum",
  "version": "1.0",
  "calculation": {
    "expression": "pct_change(close,10) / rolling_std(negative_daily_returns,30,min_periods=10)",
    "description": "Ranks positive and negative 10-day price momentum after scaling by trailing downside volatility; higher values indicate stronger momentum per unit of downside risk. All inputs are available by the decision date.",
    "direction": "positive"
  },
  "dependencies": ["close"],
  "parameters": {"momentum_lookback_days": 10, "downside_volatility_window_days": 30, "downside_volatility_min_periods": 10, "forward_validation_horizon_days": 10},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2031-10-15",
    "validated_at": "2031-10-30",
    "regime_notes": "15-instrument cross-asset universe; performance was regime dependent, with positive annual mean IC in 2021, 2025, 2027, 2028 and 2031 YTD, and negative mean IC in 2020, 2022-2024 and 2029-2030. Interpret uncertainty conservatively due to small cross-section.",
    "metrics": {
      "ic": 0.00887771,
      "icir": 1.056743,
      "ic_hit_ratio": 0.5011,
      "dates": 1423,
      "average_instruments": 11.60,
      "coverage": 0.418148,
      "turnover": 0.134619,
      "decay_ic_5d": 0.00495202,
      "decay_ic_10d": 0.00887771,
      "decay_ic_20d": -0.03426336,
      "max_abs_library_correlation": null
    }
  },
  "signal_provenance": {
    "script": "scripts/miner_1_20311030_downside_adjusted_momentum.py",
    "universe_size": 15,
    "signal_artifact": "close.pct_change(10) / close.pct_change(1).where(close.pct_change(1)<0).rolling(30,min_periods=10).std()",
    "future_data_used": false
  },
  "tags": ["momentum", "downside-risk", "cross-asset", "interpretable"]
}
