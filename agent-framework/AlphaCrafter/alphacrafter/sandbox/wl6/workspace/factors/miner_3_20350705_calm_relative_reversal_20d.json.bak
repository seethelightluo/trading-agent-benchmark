{
  "factor_id": "miner_3_calm_relative_reversal_20d",
  "factor_name": "Calm Relative Momentum Reversal 20D",
  "version": "1.0",
  "calculation": {
    "expression": "-((close/close.shift(30)-1)/(rolling_std(pct_change(close),30)+1e-8) + 0.25*(close/rolling_max(close,60)-1)).cross_sectional_median_demeaned().shift(1)",
    "description": "Ranks the inverse of lagged 30-session volatility-scaled momentum with a drawdown penalty. Higher values favor assets whose calm prior advances and shallow drawdowns are expected to mean-revert over the next 20 sessions. All inputs are lagged one completed session."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "momentum_window": 30,
    "volatility_window": 30,
    "drawdown_window": 60,
    "drawdown_coefficient": 0.25,
    "lag": 1,
    "horizon": 20
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2035-07-04",
    "last_validated": "2035-07-05",
    "metrics": {
