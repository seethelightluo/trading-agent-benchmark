{
  "factor_id": "miner_2_20270603_reversal_volscaled_10d",
  "factor_name": "Lagged volatility-scaled 10-day reversal",
  "version": "1.0",
  "calculation": {
    "expression": "shift_1(-(close / shift(close, 10) - 1) / (rolling_std(pct_change(close), 20) * sqrt(252)))",
    "description": "Ranks assets higher after a prior 10-session loss that is large relative to trailing 20-session annualized volatility; all inputs are lagged one completed session and predict the next 10-session return."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "return_window": 10,
    "volatility_window": 20,
    "annualization": 252,
    "lag": 1,
    "forward_horizon": 10
  },
  "validation": {
    "status": "EFFECTIVE",
