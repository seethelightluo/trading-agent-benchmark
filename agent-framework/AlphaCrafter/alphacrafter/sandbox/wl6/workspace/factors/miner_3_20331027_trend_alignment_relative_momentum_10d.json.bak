{
  "factor_id": "miner_3_20331027_trend_alignment_relative_momentum_10d",
  "factor_name": "Trend-alignment scaled cross-asset relative momentum",
  "version": "1.0",
  "calculation": {
    "expression": "((r10 - cross_sectional_median(r10)) * (1 + 0.5*breadth10) * sign(r20)) / downside_semideviation20",
    "description": "Cross-sectional 10-day relative momentum is scaled by recent ten-day return breadth and oriented by the sign of intermediate 20-day trend, then normalized by 20-day downside semideviation. Breadth10 is 2 times the fraction of positive daily returns over ten days minus one.",
    "signal_artifact": "scripts/miner_3_20331027_trend_alignment_relative_momentum_10d.py",
    "lookahead_control": "Factor uses prices through each signal date; forward returns begin after the signal date and are used only for validation. Online use must lag data by one completed trading day."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "relative_return_window": 10,
    "trend_window": 20,
    "breadth_window": 10,
    "downside_window": 20,
    "breadth_scale": 0.5,
    "forward_horizon": 10,
    "minimum_cross_section": 8
  },
