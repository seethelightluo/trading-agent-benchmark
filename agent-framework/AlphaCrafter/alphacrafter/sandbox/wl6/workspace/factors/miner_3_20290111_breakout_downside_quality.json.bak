{
  "factor_id": "miner_3_breakout_downside_quality_10d",
  "factor_name": "Breakout Location with Downside-Risk Quality",
  "version": "1.0",
  "calculation": {
    "expression": "((close-min_rolling(close,120))/(max_rolling(close,120)-min_rolling(close,120))-0.5) * (1+clip(close/close.shift(20)-1,-0.5,0.5)) / (sqrt(mean_rolling(clip(pct_change(close),upper=0)^2,40))*sqrt(40))",
    "description": "Ranks assets by position in their 120-day price range, confirmed by capped 20-day momentum and scaled by 40-day downside semideviation. Inputs use only completed observations available at the decision date."
  },
  "dependencies": ["close"],
  "parameters": {
    "range_window": 120,
    "momentum_window": 20,
    "downside_window": 40,
    "forward_horizon": 10,
    "min_cross_section": 8,
    "universe_size": 15
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2029-01-10",
    "last_validated": "2029-01-11T00:00:00Z",
    "metrics": {
      "ic": 0.018945,
      "icir": 1.0119,
      "horizon_days": 10,
      "valid_dates": 2204,
      "average_instruments": 13.85,
      "coverage": 0.9232,
      "hit_ratio": 0.5218,
      "turnover": null,
      "decay": {"1d_ic": 0.006574, "5d_ic": 0.009555, "10d_ic": 0.018945},
      "max_abs_library_correlation": null
    },
    "regime_results": {
      "2020-2022": {"dates": 653, "ic": 0.018936},
      "2023-2024": {"dates": 516, "ic": 0.042637},
      "2025-2026": {"dates": 516, "ic": -0.003042},
      "2027-2028": {"dates": 519, "ic": 0.017260},
      "2029-01": {"dates": 0, "ic": null}
    },
    "regime_notes": "Positive in 2020-2022, 2023-2024, and 2027-2028; mildly negative in 2025-2026. Small cross-section requires conservative uncertainty interpretation.",
    "provenance": {
      "signal_artifact": "scripts/miner_3_20290111_breakout_downside_quality.py",
      "universe": ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"],
