{
  "factor_id": "volume_confirmed_residual_momentum_5d",
  "factor_name": "Volume-Scaled Cross-Asset Residual Momentum",
  "version": "1.0",
  "calculation": {
    "expression": "((return_10 - cross_sectional_median(return_10)) / realized_volatility_30) * (0.75 + 0.25 * clip(log(volume / median_volume_60), -1, 1))",
    "description": "Lagged one-session cross-asset residual momentum. Ten-session return relative to the contemporaneous cross-sectional median is normalized by 30-session realized volatility and smoothly scaled by abnormal volume; above-normal volume modestly strengthens the signal while low volume attenuates it.",
    "lag": "one completed session"
  },
  "dependencies": ["close", "volume"],
  "parameters": {
    "return_window": 10,
    "volatility_window": 30,
    "volume_baseline_window": 60,
    "volume_scale": 0.25,
    "primary_forward_horizon": 5,
    "minimum_cross_section": 8
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2034-06-22 data extract; forward observations through latest available aligned date",
    "validated_at": "2034-06-22T00:00:00Z",
    "metrics": {
      "ic": 0.008151149,
      "icir": 1.034328498,
      "hit_ratio": 0.5008,
      "coverage": 0.6,
      "average_instruments": 9.0,
      "valid_dates": 2406,
      "turnover_proxy": 0.1215,
      "max_abs_library_correlation": null,
      "horizon_days": 5,
      "regime_ic": {
        "2025-2029": 0.006,
        "2030-2032": -0.013447,
        "2033-2034": -0.023674
      }
    },
    "regime_notes": "Passed the benchmark-wide absolute IC and ICIR gates at the 5-session horizon, but recent 2030-2034 regime IC was negative; use cautiously and require deterministic library correlation screening and future revalidation.",
    "signal_artifact": "scripts/miner_2_20340622_volume_confirmed_residual_momentum_signal.csv",
