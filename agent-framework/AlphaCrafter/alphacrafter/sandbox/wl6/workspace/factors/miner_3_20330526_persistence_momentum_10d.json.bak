{
  "factor_id": "miner_3_persistence_momentum_10d",
  "factor_name": "Volatility-Normalized Persistence Momentum",
  "version": "2033-05-26",
  "calculation": {
    "expression": "(close / close.shift(20) - 1) / rolling_std(pct_change(close),20) * (2 * rolling_mean(I[pct_change(close)>0],40) - 1)",
    "description": "Ranks 20-day momentum after volatility normalization, weighted by the directional persistence of the prior 40 daily returns. Positive persistence reinforces trend signals while negative persistence reverses them. Signal is computed using completed daily bars only."
  },
  "dependencies": ["close"],
  "parameters": {"momentum_lookback_days": 20, "volatility_lookback_days": 20, "persistence_lookback_days": 40, "forward_horizon_days": 10, "minimum_instruments_per_date": 8},
