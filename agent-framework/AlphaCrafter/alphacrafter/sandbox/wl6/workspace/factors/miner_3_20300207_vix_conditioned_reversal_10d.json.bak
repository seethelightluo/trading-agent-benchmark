{
  "factor_id": "miner_3_20300207_vix_conditioned_reversal_10d",
  "factor_name": "VIX-conditioned volatility-scaled short-term reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(R_5 / (stdev(daily_returns,20)*sqrt(20))) * (1 + 0.35*tanh((VIX - mean(VIX,20))/stdev(VIX,20)))",
    "description": "Ranks assets for 10-day forward returns using five-day reversal, scaled by 20-day realized volatility and amplified when the observation-only VIX is elevated relative to its trailing 20-day level. VIX is used only as a macro conditioning signal; no order is submitted for VIX. All inputs are lagged through the decision date.",
    "signal_artifact": "scripts/miner_3_20300207_vix_conditioned_reversal.py"
  },
  "dependencies": ["close", "VIX close"],
  "parameters": {"return_lookback_days": 5, "volatility_lookback_days": 20, "macro_lookback_days": 20, "macro_multiplier": 0.35, "forward_horizon_days": 10},
  "validation": {
