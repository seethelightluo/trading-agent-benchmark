{
  "factor_id": "miner_1_20290419_volume_confirmed_short_reversal_1d",
  "factor_name": "Volume-Confirmed Short Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(return_5d / (realized_volatility_20d*sqrt(20)+0.01)) * (0.75 + 0.25*cross_sectional_rank(volume/median_volume_20d))",
    "description": "Contrarian five-day return, normalized by 20-day realized volatility, with a bounded abnormal-volume confirmation multiplier. Uses only completed daily observations."
  },
  "dependencies": ["close", "volume", "daily_returns"],
  "parameters": {"return_window": 5, "volatility_window": 20, "volume_median_window": 20, "volume_multiplier_floor": 0.75, "volume_multiplier_span": 0.25, "forward_horizon_days": 1, "minimum_valid_instruments": 8},
