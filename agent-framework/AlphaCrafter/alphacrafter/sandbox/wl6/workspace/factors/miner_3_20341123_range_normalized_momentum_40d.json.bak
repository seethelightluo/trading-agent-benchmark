{
  "factor_id": "range_normalized_momentum_40d",
  "factor_name": "Range-Normalized Momentum 40D",
  "version": "1.0",
  "calculation": {
    "expression": "demean_cs((rolling_sum_20d(asset_return) / rolling_std_20d(asset_return)).shift(1))",
    "description": "Twenty-session cumulative asset return divided by its own 20-session realized return volatility, lagged by one completed session and cross-sectionally median demeaned. Higher values prefer persistent risk-adjusted trends over the 40-session forward horizon."
  },
  "dependencies": ["close"],
  "parameters": {
    "return_window": 20,
    "volatility_window": 20,
    "min_periods": 15,
    "signal_lag": 1,
    "forward_horizon_days": 40,
    "minimum_cross_section": 8
  },
