{
  "factor_id": "volnorm_residual_reversal_20d",
  "factor_name": "Volatility-Normalized Residual Shock Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-shift_1(rolling_sum_5((asset_return - cross_sectional_mean_return) / rolling_std_20(asset_return)))",
    "description": "For each tradable asset, subtract the daily equal-weight cross-asset return, normalize the residual shock by the asset's trailing 20-day return volatility, sum the last five sessions, invert for contrarian exposure, and lag one completed session to prevent look-ahead."
  },
  "dependencies": ["close", "pct_change", "cross_sectional_mean_return", "rolling_std"],
  "parameters": {"shock_window": 5, "volatility_window": 20, "lag": 1, "forward_horizon": 20, "min_history": 10, "min_cross_section": 8},
