{
  "factor_id": "miner_3_20300808_short_reversal_10d",
  "factor_name": "Risk-Scaled Three-Day Short Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(close / close.shift(3) - 1) / (rolling_std(pct_change(close), 20) * sqrt(20) + 1e-12)",
    "description": "Ranks assets by the negative of their trailing three-day return, scaled by 20-day annualized realized volatility. Higher values indicate stronger recent underperformance after risk adjustment. The validated relationship is negative at the 10-trading-day horizon; consumers should preserve the recorded direction or invert it explicitly."
  },
  "dependencies": ["close"],
  "parameters": {"lookback_return_days": 3, "volatility_window_days": 20, "volatility_min_periods": 15, "horizon_days": 10},
  "validation": {
