{
  "factor_id": "miner_1_vol_compressed_trend_10d",
  "factor_name": "Volatility-Compressed 20-Day Trend",
  "version": "1.0",
  "calculation": {
    "expression": "shift_1((close/close.shift(20)-1)/rolling_std(return,60) / (1 + rolling_std(return,10)/rolling_std(return,60)))",
    "description": "Ranks assets by lagged 20-session momentum scaled by medium-term realized volatility, with a compression multiplier that favors trends whose short-term volatility is below the 60-session baseline. All inputs are lagged one completed session to avoid look-ahead."
  },
  "dependencies": ["close", "pct_change"],
  "parameters": {"trend_window": 20, "short_vol_window": 10, "medium_vol_window": 60, "forward_horizon": 10, "minimum_cross_section": 8},
  "validation": {
    "status": "EFFECTIVE",
    "last_validated": "2030-03-07T00:00:00Z",
    "period": "2020-01-01 through 2030-03-07",
