{
  "factor_id": "downside_risk_reversal_20d",
  "factor_name": "Downside-Risk-Adjusted Medium-Horizon Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-return(close,20) / (sqrt(40) * rolling_std(negative_daily_returns,40))",
    "description": "Ranks assets by contrarian 20-day return normalized by realized downside volatility over the preceding 40 sessions. Negative-return observations only enter the downside-risk denominator; lower recent performers with controlled downside risk receive higher scores."
  },
  "dependencies": ["close"],
  "parameters": {
    "return_lookback_days": 20,
    "downside_volatility_window_days": 40,
    "downside_definition": "daily_return if daily_return < 0 else 0",
    "forward_horizon_days": 10,
    "minimum_cross_section": 8
  },
