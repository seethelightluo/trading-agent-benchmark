{
  "factor_id": "miner_2_volscaled_drawdown_reversal_20d",
  "factor_name": "Volatility-Scaled 60-Day Drawdown Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "(-((close / rolling_max(close,60)) - 1) / rolling_std(pct_change(close),20)).shift(1)",
    "description": "Ranks assets higher when they are farther below their trailing 60-session high after scaling the drawdown by recent 20-session volatility. The one-session lag ensures only completed prior-session information is used; it is intended as a 20-session contrarian signal."
  },
  "dependencies": ["close"],
  "parameters": {
    "drawdown_lookback_sessions": 60,
    "volatility_lookback_sessions": 20,
    "lag_sessions": 1,
    "minimum_cross_section": 8,
    "universe_size": 15,
    "admission_horizon_days": 20
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": {"start": "2026-01-01", "end": "2034-03-01"},
    "validated_at": "2034-03-02",
    "metrics": {
