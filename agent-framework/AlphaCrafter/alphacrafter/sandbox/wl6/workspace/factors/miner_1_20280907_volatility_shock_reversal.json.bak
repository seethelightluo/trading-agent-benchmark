{
  "factor_id": "volatility_shock_reversal_5_60d",
  "factor_name": "Five-to-Sixty Day Volatility Shock Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(rolling_std(pct_change(close),5) / rolling_std(pct_change(close),60) - 1)",
    "description": "Ranks assets inversely by the lagged expansion in short-term volatility relative to its 60-day baseline; elevated volatility shocks receive lower scores, consistent with subsequent cross-sectional continuation in this sample. Signal is shifted one completed day before forward returns."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "short_window": 5,
    "long_window": 60,
    "signal_lag": 1,
    "forward_horizon_days": 1,
    "universe_size": 15
  },
