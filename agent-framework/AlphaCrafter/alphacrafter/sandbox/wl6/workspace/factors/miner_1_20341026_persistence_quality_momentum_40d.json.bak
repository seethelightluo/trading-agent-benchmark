{
  "factor_id": "persistence_quality_momentum_40d",
  "factor_name": "Persistence-Quality Volatility-Scaled Momentum (40D)",
  "version": "1.0",
  "calculation": {
    "expression": "lag1((close/shift(close,40)-1) * (mean(I[return>0],40)-0.5) / (std(return,40)*sqrt(40)))",
    "description": "Forty-trading-day momentum is weighted by directional persistence and scaled by realized volatility. The signal is lagged one trading day and cross-sectionally median demeaned. Higher values indicate persistent, risk-adjusted continuation."
  },
  "dependencies": ["close", "daily_returns"],
  "parameters": {"momentum_window": 40, "persistence_window": 40, "volatility_window": 40, "min_periods": 28, "lag_days": 1, "cross_sectional_center": "median"},
