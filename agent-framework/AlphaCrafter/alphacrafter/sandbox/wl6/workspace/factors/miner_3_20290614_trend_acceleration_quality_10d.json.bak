{
  "factor_id": "miner_3_trend_acceleration_quality_10d",
  "factor_name": "Risk-Scaled Trend Acceleration with Drawdown Quality",
  "version": "1.0",
  "calculation": {
    "expression": "((close/close.shift(20)-1) - (close/close.shift(60)-1)/3) / (std(pct_change(close),60)*sqrt(20)+0.015) + 0.25*(close/rolling_max(close,120)-1)/(std(pct_change(close),60)*sqrt(20)+0.015)",
    "description": "Ranks assets by short-term trend acceleration relative to medium-term trend, scaled by realized risk and mildly rewarded for shallower drawdown. All inputs are available through the completed decision-day close. Higher values predict stronger 10-trading-day forward returns."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "short_window": 20,
    "medium_window": 60,
    "drawdown_window": 120,
    "volatility_window": 60,
    "volatility_floor": 0.015,
    "drawdown_weight": 0.25,
    "forward_horizon_days": 10
  },
  "validation": {
