{
  "factor_id": "short_reversal_20d",
  "factor_name": "Volatility-normalized 5-day cross-asset reversal",
  "version": "1.0",
  "calculation": {
    "expression": "(-((close/lag(close,5))-1 - cross_sectional_median((close/lag(close,5))-1)) / (rolling_std(daily_return,20)*sqrt(20))).shift(1)",
    "description": "Ranks recent five-day relative losers higher for reversal, normalized by each asset's 20-day realized volatility and lagged one completed day to avoid look-ahead."
  },
  "dependencies": ["close"],
  "parameters": {"reversal_window_days": 5, "volatility_window_days": 20, "minimum_volatility_observations": 12, "lag_days": 1, "minimum_cross_section": 8},
  "validation": {
