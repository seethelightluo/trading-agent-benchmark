{
  "factor_id": "miner_3_20330915_downside_semidev_relative_momentum_10d",
  "factor_name": "Downside-Semideviation Relative Momentum with Breadth Gate",
  "version": "1.0",
  "calculation": {
    "expression": "((return_10d - cross_sectional_median(return_10d)) * (2 * fraction_positive_returns_10d - 1)) / downside_semideviation_20d",
    "description": "Ranks cross-asset ten-day momentum relative to the contemporaneous universe median, amplified or reversed by ten-day directional breadth and scaled by trailing 20-day downside semideviation. Higher values predict higher next-ten-trading-day returns.",
    "source_script": "scripts/miner_3_20330901_downside_semidev_relative_momentum_10d.py",
    "signal_artifact": {
      "type": "reconstructable_historical_signal",
      "data_path": "../persistent/stock_data/{symbol}.csv",
      "cutoff": "2033-09-01",
      "universe": ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
    }
  },
  "dependencies": ["close", "daily returns"],
  "parameters": {
    "relative_momentum_window": 10,
    "breadth_window": 10,
    "downside_semideviation_window": 20,
    "forward_horizon_days": 10,
    "minimum_cross_section": 8,
    "minimum_downside_semideviation": 1e-8
  },
