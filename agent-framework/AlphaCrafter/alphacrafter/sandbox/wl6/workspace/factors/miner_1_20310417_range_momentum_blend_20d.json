{
  "factor_id": "miner_1_range_momentum_blend_20d",
  "factor_name": "Range-Location Reversal with Medium-Term Momentum Blend",
  "version": "1.0",
  "calculation": {
    "expression": "zscore(-(close-prior20_high)/(prior20_high-prior20_low+1e-12)) + 0.35*zscore(close/close.shift(60)-1)",
    "description": "Cross-sectionally standardizes a 20-session range-location reversal score and adds 35% of a 60-session momentum score. The reversal component favors assets near the lower end of the prior completed 20-day range; the momentum component moderates extreme rankings with medium-term trend information."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "range_lookback_sessions": 20,
    "range_lag_sessions": 1,
    "momentum_lookback_sessions": 60,
    "momentum_weight": 0.35,
    "minimum_range_observations": 15,
    "universe_size": 15
  },
