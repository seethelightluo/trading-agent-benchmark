{
  "factor_id": "miner_2_downside_adjusted_momentum_30d",
  "factor_name": "Lagged downside-volatility-adjusted 30-day momentum",
  "version": "1.0",
  "calculation": {
    "expression": "shift_1(rolling_sum(pct_change(close),30) / (sqrt(rolling_mean(min(pct_change(close),0)^2,30))*sqrt(252)))",
    "description": "Ranks tradable benchmark instruments by their prior 30-session return divided by downside deviation estimated over the trailing 30 sessions. The complete signal is lagged one session and predicts the next 10-session cross-sectional return; higher values indicate momentum achieved with less downside risk.",
    "signal_artifact": "scripts/miner_2_20270617_downside_momentum_30d.py"
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "return_window": 30,
    "downside_volatility_window": 30,
    "annualization": 252,
    "lag_sessions": 1,
    "forward_horizon_days": 10,
    "minimum_cross_section": 8
  },
