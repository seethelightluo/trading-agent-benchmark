{
  "factor_id": "recovery_consistency_momentum_10d",
  "factor_name": "Recovery Consistency Momentum (contrarian orientation)",
  "version": "20330414",
  "calculation": {
    "expression": "-((close / rolling_min(close,60)) - 1) * (rolling_mean(pct_change(close),20) / rolling_std(pct_change(close),20))",
    "description": "Ranks assets inversely to their recovery from the 60-day low after scaling by 20-day directional consistency; negative empirical IC is intentionally oriented as a contrarian signal."
  },
  "dependencies": ["close"],
  "parameters": {"recovery_window": 60, "consistency_window": 20, "min_periods_recovery": 40, "min_periods_consistency": 15, "forward_horizon_days": 10, "direction": -1},
  "validation": {
