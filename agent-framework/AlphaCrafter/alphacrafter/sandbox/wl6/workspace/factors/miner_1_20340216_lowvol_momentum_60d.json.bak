{
  "factor_id": "miner_1_20340216_lowvol_momentum_60d",
  "factor_name": "Volatility-scaled 60-day momentum",
  "version": "1.0",
  "calculation": {
    "expression": "(close_t / close_{t-60} - 1) / (std(pct_change(close),60) * sqrt(252))",
    "description": "Ranks the 60-trading-day price trend after scaling by trailing 60-day annualized realized volatility. Higher values indicate stronger risk-adjusted medium-term momentum. The signal uses only completed observations available at t."
  },
  "dependencies": ["close", "pct_change"],
  "parameters": {"lookback_days": 60, "volatility_window": 60, "annualization": 252, "forward_horizon_days": 10},
