{
  "factor_id": "miner_3_trend_agreement_quality_10d",
  "factor_name": "Multi-Horizon Trend Agreement Risk Quality",
  "version": "1.0",
  "calculation": {
    "expression": "(0.25*return(close,10) + 0.45*return(close,30) + 0.30*return(close,90)) / (rolling_std(pct_change(close),60)*sqrt(252))",
    "description": "Ranks assets by agreement of short, medium, and long horizon returns, scaled by trailing 60-day annualized realized volatility. All inputs are available through the completed observation date."
  },
  "dependencies": ["close"],
  "parameters": {"horizons_days": [10, 30, 90], "weights": [0.25, 0.45, 0.30], "volatility_window": 60, "annualization": 252, "forward_horizon_days": 10},
  "validation": {
