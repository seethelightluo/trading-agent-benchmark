{
  "factor_id": "volatility_regime_momentum_10d",
  "factor_name": "Volatility-Regime-Adjusted Momentum (10d)",
  "version": "1.1",
  "calculation": {
    "expression": "momentum_20d / (volatility_20d * (1 + volatility_20d / volatility_60d))",
    "description": "Twenty-session price momentum scaled by short-term realized volatility and penalized when short-term volatility exceeds its 60-session baseline. The validated predictive sign is negative; portfolio construction should invert the raw signal.",
