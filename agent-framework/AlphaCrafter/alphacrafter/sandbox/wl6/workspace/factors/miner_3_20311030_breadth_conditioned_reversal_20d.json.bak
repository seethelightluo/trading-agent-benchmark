{
  "factor_id": "miner_3_20311030_breadth_conditioned_reversal_20d",
  "factor_name": "Breadth-Conditioned Volatility-Normalized Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(close_t/close_{t-20}-1)/std(pct_change(close),20) * (0.5 + clip(rolling_mean_10(cross_asset_breadth_20d),0.2,0.8))",
    "description": "For each tradable benchmark, take the negative 20-day return normalized by its trailing 20-day daily-return volatility. Scale the reversal by smoothed cross-asset breadth, defined as the fraction of the 15 assets with positive 20-day returns; breadth is clipped to avoid extreme scaling. All rolling inputs end at the signal date.",
    "provenance_script": "scripts/miner_3_20311030_breadth_conditioned_momentum.py",
    "signal_artifact": "Reconstructable from ../persistent/stock_data/{symbol}.csv using the expression and exact universe below; signal cutoff 2031-10-29. The validated momentum implementation had IC -0.04212026, so this persisted reversal is its exact sign inverse."
  },
  "dependencies": [
    "close",
    "daily_returns"
  ],
  "parameters": {
    "momentum_window_days": 20,
    "volatility_window_days": 20,
    "breadth_window_days": 20,
    "breadth_smoothing_days": 10,
    "breadth_clip": [
