{
  "factor_id": "miner_2_20311225_dxy_shock_reversal_10d",
  "factor_name": "DXY shock-conditioned cross-asset reversal",
  "version": "1.0",
  "calculation": {
    "expression": "if DXY_5d_return > rolling_252d_quantile(abs(DXY_5d_return), 0.70), then -asset_10d_return, else 0",
    "description": "Fade each tradable asset's lagged 10-day return only after an unusually strong positive 5-day DXY move. The DXY condition and asset returns are observed through the decision date; forward returns begin afterward."
  },
  "dependencies": ["close", "DXY close"],
  "parameters": {"asset_lookback_days": 10, "dxy_shock_days": 5, "threshold_window_days": 252, "threshold_quantile": 0.70, "forward_horizon_days": 10},
