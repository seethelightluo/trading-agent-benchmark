{
  "factor_id": "miner_2_20350621_breadth_conditioned_risk_reversal_20d",
  "factor_name": "Breadth-conditioned risk-adjusted momentum/reversal",
  "version": "1.0",
  "calculation": {
    "expression": "where(shift(breadth_20d,1)>=0.5, ret_20d/vol_30d, -(ret_20d/vol_30d)); signal=shift(expression,1)",
    "description": "Compute each asset's 20-trading-day cumulative return divided by its 30-day return volatility. When at least half of the available instruments had positive 20-day returns, retain risk-adjusted momentum; otherwise invert it to capture weak-breadth reversal. Lag one completed trading day to avoid look-ahead."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "return_window": 20,
    "volatility_window": 30,
    "breadth_window": 20,
    "breadth_threshold": 0.5,
    "lag_days": 1
  },
