{
  "factor_id": "miner_1_20320304_downside_adjusted_continuation_20d",
  "factor_name": "Downside-adjusted medium-term continuation",
  "version": "1.0",
  "calculation": {
    "expression": "pct_change(close,20) / (rolling_std(clip(pct_change(close,1), upper=0),40) * sqrt(40))",
    "description": "Ranks assets by their trailing 20-day return scaled by trailing 40-day downside volatility. Higher values indicate stronger continuation per unit of downside risk.",
    "signal_timing": "Computed using closes through t; evaluated against forward returns from t to t+20 without future data."
  },
  "dependencies": ["close"],
  "parameters": {"return_lookback_days": 20, "downside_volatility_lookback_days": 40, "minimum_volatility_observations": 30, "winsorization": null},
