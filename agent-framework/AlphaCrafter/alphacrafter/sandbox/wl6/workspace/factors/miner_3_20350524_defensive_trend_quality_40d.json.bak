{
  "factor_id": "defensive_trend_quality_40d",
  "factor_name": "Defensive Trend Quality 40D",
  "version": "1.0",
  "calculation": {
    "expression": "lag1((close_return_30d * (0.5 + rolling_mean(I(return_1d > 0),30)) / (0.5 * rolling_std(return_1d,30) + rolling_std(max(-return_1d,0),30))))",
    "description": "Ranks assets by 30-day trend, amplified by the persistence of positive daily returns and normalized by total and downside volatility. The one-day lag prevents look-ahead bias."
  },
  "dependencies": ["close"],
  "parameters": {
    "trend_window": 30,
    "quality_window": 30,
    "risk_window": 30,
    "forward_horizon": 40,
    "lag": 1,
    "minimum_observations": 20
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2035-04-25",
    "last_validated": "2035-05-24",
    "metrics": {
      "admission_horizon_days": 40,
      "ic": 0.01343119,
      "icir": 2.21078706,
      "hit_ratio": 0.5268,
      "dates": 2257,
      "average_instruments": 13.012,
      "coverage": 0.8674,
      "turnover": 0.06618,
      "max_abs_library_correlation": null
    },
    "regime_notes": "40-day predictive association passed across the full historical sample; 5D/10D/20D associations were negative, so this is a slower-horizon research factor and should not be treated as a standalone 10-day signal.",
    "signal_artifact": "scripts/miner_3_20350524_defensive_trend_quality_signal.csv",
    "validation_script": "scripts/miner_3_20350524_defensive_trend_quality.py"
  },
  "tags": ["trend", "quality", "defensive", "downside-risk", "cross-asset"],
  "provenance": {
    "agent": "miner_3",
    "validated_at": "2035-05-24",
    "universe_size": 15,
    "minimum_cross_section": 8,
    "observation_only_macro_excluded": true
  }
}