{
  "factor_id": "miner_3_volnorm_relative_consistency_momentum_10d",
  "factor_name": "Volatility-normalized cross-asset relative consistency momentum",
  "version": "1.0",
  "calculation": {
    "expression": "((close/close[-20])-1 - cross_asset_median(((close/close[-20])-1))) * (2*mean(indicator(daily_return>0),20)-1) / max(std(daily_return,20)*sqrt(20), 1e-8)",
    "description": "Ranks each asset's 20-session return relative to the same-date cross-asset median, multiplies by its 20-session directional breadth, and scales by trailing 20-session realized volatility. Higher values indicate persistent relative strength on a volatility-adjusted basis; lower values indicate persistent relative weakness."
  },
  "dependencies": ["close", "daily_return", "cross_asset_returns"],
  "parameters": {
    "return_lookback_sessions": 20,
    "breadth_lookback_sessions": 20,
    "volatility_lookback_sessions": 20,
    "forecast_horizon_sessions": 10,
    "annualization_factor": 20,
    "minimum_cross_section": 8,
    "universe_size": 15,
    "signal_artifact": "scripts/miner_3_20330804_volnorm_relative_consistency_10d.py"
  },
  "validation": {
