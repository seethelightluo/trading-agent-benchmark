{
  "factor_id": "miner_1_recovery_90d",
  "factor_name": "Drawdown-Recovery Risk-Adjusted Momentum 20d with 90d Trough",
  "version": "1.0",
  "calculation": {
    "expression": "sum(return,20)/(std(return,40)*sqrt(20)) + 0.50*clip(close/rolling_min(close,90)-1,0,2)",
    "description": "Ranks the 15 tradable cross-asset instruments by lagged 20-day risk-adjusted momentum plus a bounded rebound from the trailing 90-day trough. Inputs are available only through the completed session."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "momentum_window": 20,
    "volatility_window": 40,
    "recovery_window": 90,
    "recovery_weight": 0.5,
    "recovery_clip": [
      0,
      2
    ],
    "forward_horizon_days": 10
  },
