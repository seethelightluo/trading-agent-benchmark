{
  "factor_id": "miner_3_20310501_vix_regime_reversal_20d",
  "factor_name": "VIX-Regime Volatility-Scaled Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-return(close,20) * clip(VIX / median(VIX,120), 0.5, 2.0) / (rolling_std(daily_returns,40) + 1e-12)",
    "description": "Ranks assets with recent 20-day losses for rebound potential, increasing the signal in elevated-VIX regimes and scaling by asset volatility. VIX is an observation-only macro input, lagged through the decision date; no future data are used."
  },
  "dependencies": [
    "close",
    "daily_returns",
    "VIX"
  ],
  "parameters": {
    "return_window": 20,
    "vix_median_window": 120,
    "vix_min_periods": 60,
    "vix_multiplier_clip": [
      0.5,
      2.0
    ],
    "volatility_window": 40,
    "volatility_min_periods": 25,
    "forward_horizon_days": 20
  },
