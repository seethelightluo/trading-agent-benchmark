{
  "factor_id": "miner_1_20301114_volume_confirmed_momentum",
  "factor_name": "Volume-Confirmed 10-Day Momentum",
  "version": "1.0",
  "calculation": {
    "expression": "pct_change(close,10) * log(1 + volume / rolling_median(volume,40))",
    "description": "Ranks recent 10-day momentum more highly when accompanied by above-baseline trading activity. Volume ratio is clipped at zero before log transformation; signal uses only data through the prior completed session."
  },
  "dependencies": ["close", "volume"],
  "parameters": {
    "return_window": 10,
    "volume_baseline_window": 40,
    "minimum_volume_observations": 20,
    "forward_horizon_days": 10,
    "universe_size": 15
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": {"start": "2020-01-01", "end": "2030-11-13"},
    "metrics": {
      "ic": 0.01826068,
      "icir": 0.88669,
      "ic_hit_ratio": 0.52759,
      "valid_dates": 1740,
      "average_instruments": 14.443,
      "coverage": 0.962874,
      "turnover_proxy": 0.0953555,
      "decay_ic_5d": 0.01851385,
      "decay_ic_10d": 0.01826068,
      "decay_ic_20d": 0.00698465,
      "max_abs_library_correlation": null
    },
    "regime_notes": "Validation used the full 15-instrument tradable cross-asset universe and 1740 daily cross-sectional observations at the 10-day horizon. 10-day IC was positive in 2020, 2022, 2026, 2027, and 2028, but negative in 2021, 2023-2025, 2029, and 2030 YTD; aggregate admission is therefore positive but regime-sensitive. Small cross-section warrants conservative uncertainty interpretation.",
    "signal_artifact": {
