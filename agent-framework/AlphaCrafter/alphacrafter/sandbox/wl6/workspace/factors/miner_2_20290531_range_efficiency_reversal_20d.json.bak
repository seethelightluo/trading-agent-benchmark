  "factor_name": "Sign-Reversed Volatility-Normalized Trend Efficiency",
  "version": "1.0",
  "calculation": {
    "expression": "-(rolling_sum(return,30) / (rolling_sum(abs(return),30)+1e-9)) / (rolling_std(return,20)*sqrt(20)+0.01)",
    "description": "Ranks assets by the negative of directional trend efficiency normalized by recent volatility. The sign reversal expresses the validated 20-day cross-sectional tendency for less efficient or recently persistent paths to mean-revert over the next 20 trading days. All rolling inputs are trailing-only."
