{
  "factor_id": "miner_3_capped_downside_shock_reversal_3d",
  "factor_name": "Capped Downside Shock Reversal 3-Day",
  "version": "1.0",
  "calculation": {
    "expression": "(-sum(return,3) * clip(downside_vol_60 / (downside_vol_20 + 1e-8), 0.5, 2.0)).shift(1)",
    "description": "Reversal of the trailing three-day return, scaled by the ratio of 60-day to 20-day downside volatility and capped to limit extreme regime multipliers; lagged one completed session."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "return_lookback_days": 3,
    "downside_vol_short_days": 20,
    "downside_vol_long_days": 60,
    "multiplier_floor": 0.5,
    "multiplier_cap": 2.0,
    "lag_days": 1,
    "minimum_cross_section": 8
  },
  "validation": {
