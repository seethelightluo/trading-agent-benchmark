{
  "factor_id": "miner_2_20301031_volscaled_reversal_20d",
  "factor_name": "Volatility-scaled 20-day cross-asset reversal",
  "version": "1.0",
  "calculation": {
    "expression": "clip(-(close/close.shift(20)-1)/(rolling_std(pct_change(close),20)*sqrt(20)),-8,8)",
    "description": "Ranks assets by contrarian 20-session return normalized by their recent 20-session realized volatility; higher values indicate stronger risk-adjusted underperformance and are expected to mean-revert over the admitted 20-session horizon. Cross-sectional Spearman IC is measured against forward returns."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "lookback_sessions": 20,
    "volatility_window": 20,
    "annualization_scale": "sqrt(20)",
    "winsor_lower": -8,
    "winsor_upper": 8,
