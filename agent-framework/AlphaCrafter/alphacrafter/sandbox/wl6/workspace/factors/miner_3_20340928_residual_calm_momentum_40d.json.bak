{
  "factor_id": "residual_calm_momentum_40d",
  "factor_name": "Residual Calm Momentum 40D",
  "version": "1.0",
  "calculation": {
    "expression": "demean_cs((rolling_sum_30d(asset_return - cross_sectional_median_return) / (rolling_std_30d(asset_return)*sqrt(30))).shift(1))",
    "description": "Thirty-trading-day momentum relative to the daily cross-asset common return, risk-scaled by 30-day realized volatility, lagged one session and cross-sectionally median demeaned. Higher values prefer smooth residual winners."
  },
