{
  "factor_id": "miner_3_vix_shock_reversal_1d",
  "factor_name": "Lagged VIX-Shock Volatility-Scaled Reversal",
  "version": "20261022",
  "calculation": {
    "expression": "-asset_return_1d / lagged_20d_return_volatility when lagged_VIX_return > 0, otherwise 0",
    "description": "At each asset date, use only the prior completed session's VIX percentage change as a shock gate. During VIX-up sessions, fade the asset's prior close-to-close return, scaled by volatility estimated through the prior session. Forward return is next close-to-close return."
  },
  "dependencies": [
    "close",
    "VIX.close"
  ],
  "parameters": {
    "volatility_window": 20,
    "volatility_min_periods": 15,
    "shock_definition": "VIX percentage change > 0",
    "shock_lag_sessions": 1,
    "holding_horizon_sessions": 1,
    "cross_section_min_instruments": 8
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-27 to 2026-10-19",
