  "factor_name": "Smoothed short consistency EWMA momentum",
  "version": "1.0",
  "calculation": {
    "expression": "EWMA3((close/close[-10]-1) * (2*mean(I[pct_change(close)>0],10)-1) / (sqrt(10)*EWMA_std(pct_change(close),20)))",
    "description": "Ten-day momentum scaled by directional consistency and 20-day exponentially weighted volatility, then smoothed with a three-observation EWMA. Higher values indicate persistent risk-adjusted upward momentum."
