{
  "factor_id": "miner_2_directional_persistence_30d",
  "factor_name": "30-Day Directional Persistence",
  "version": "1.0",
  "calculation": {
    "expression": "(mean(sign(close_t/close_{t-1}-1)>0 over trailing 30 sessions) - 0.5).shift(1)",
    "description": "For each tradable asset, compute the fraction of positive daily returns in the trailing 30 completed sessions, center at zero, and lag one session to prevent look-ahead. Higher values indicate persistent upward direction."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "lookback_days": 30,
    "lag_days": 1,
    "minimum_cross_section": 8
  },
