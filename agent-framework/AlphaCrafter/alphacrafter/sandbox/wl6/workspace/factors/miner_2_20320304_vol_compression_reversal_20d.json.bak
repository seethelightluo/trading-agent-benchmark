{
  "factor_id": "miner_2_20320304_vol_compression_reversal_20d",
  "factor_name": "Volatility-Compression Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-return(close,10) * clip(stddev(daily_return,60) / (stddev(daily_return,10)+1e-8), 0.25, 4.0)",
    "description": "Ranks assets positively when a recent 10-session loss is large relative to its short-term volatility, with the reversal magnitude amplified when short-term volatility is compressed relative to the 60-session baseline. The ratio is clipped for robustness. Higher values predict stronger subsequent 20-session returns."
  },
  "dependencies": ["close"],
  "parameters": {"return_window": 10, "short_vol_window": 10, "long_vol_window": 60, "ratio_clip": [0.25, 4.0], "forward_horizon": 20},
  "validation": {
