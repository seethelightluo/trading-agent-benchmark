{
  "factor_id": "miner_3_20290208_residual_downside_momentum_10d",
  "factor_name": "Relative Residual Downside-Volatility-Adjusted Momentum",
  "version": "1.0",
  "calculation": {
    "expression": "((close/close.shift(20)-1) - cross_sectional_median(close/close.shift(20)-1)) / (rolling_std(negative_only(pct_change(close)),60)*sqrt(252))",
    "description": "For each date, subtract the cross-sectional median 20-day return from each instrument's 20-day return, then divide by trailing 60-day downside realized volatility. The signal uses only completed prices through the signal date and ranks instruments cross-sectionally.",
    "signal_provenance": "scripts/miner_3_20290208_residual_downside_momentum.py"
  },
  "dependencies": ["close"],
  "parameters": {
    "momentum_window": 20,
    "downside_volatility_window": 60,
    "annualization": 252,
    "forward_horizon": 10,
    "min_cross_section": 8,
    "universe_size": 15
  },
  "validation": {
