{
  "factor_id": "miner_3_20350118_downside_asymmetry_10d",
  "factor_name": "Lagged Downside Variance Asymmetry",
  "version": "1.0",
  "calculation": {
    "expression": "shift_1(sum_{20d}(min(log_return,0)^2) / sum_{20d}(log_return^2))",
    "description": "For each tradable benchmark asset, measures the fraction of recent 20-day squared variation attributable to negative daily log returns, lagged one completed session. Higher values indicate downside-dominated recent risk and are tested as a cross-sectional predictor of forward returns."
  },
  "dependencies": ["close"],
  "parameters": {"lookback_days": 20, "forward_horizon_days": 10, "lag_days": 1, "return_type": "log", "minimum_cross_section": 8},
  "validation": {
