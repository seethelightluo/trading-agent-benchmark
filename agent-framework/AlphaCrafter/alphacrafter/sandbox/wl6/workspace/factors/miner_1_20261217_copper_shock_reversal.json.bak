  "factor_name": "Copper shock volatility-scaled cross-asset reversal",
  "version": "1.0",
  "calculation": {
    "expression": "clip(-asset_return[t-1] / lagged_20d_asset_volatility[t-1], -3, 3) * clip(abs(COPPER_return[t-1]) / lagged_60d_COPPER_volatility[t-1], 0, 3)",
