{
  "factor_id": "miner_3_20300124_trend_agreement_residual_10d",
  "factor_name": "Volatility-scaled multi-horizon trend agreement",
  "version": "1.0",
  "calculation": {
    "expression": "demean_cs((pct_change(close,20) / (std(pct_change(close,1),20)*sqrt(252))) * (sign(pct_change(close,5))+sign(pct_change(close,20))+sign(pct_change(close,60)))/3)",
    "description": "Ranks assets by 20-day momentum scaled by annualized 20-day volatility, multiplied by the agreement of 5-, 20-, and 60-day momentum signs, then cross-sectionally demeaned. Values use only completed data through the decision date."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "short_window": 5,
    "signal_window": 20,
    "long_window": 60,
    "vol_window": 20,
    "annualization": 252,
    "forward_horizon_days": 10,
    "minimum_cross_section": 8
  },
