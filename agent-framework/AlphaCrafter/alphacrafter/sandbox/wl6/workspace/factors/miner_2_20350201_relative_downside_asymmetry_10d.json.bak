{
  "factor_id": "miner_2_20350201_relative_downside_asymmetry_10d",
  "factor_name": "Relative downside variance asymmetry",
  "version": "1.0",
  "calculation": {
    "expression": "cross_sectional_median_demean(rolling_sum(min(log_return,0)^2,20) / rolling_sum(log_return^2,20)).shift(1)",
    "description": "Measures the share of recent realized variance generated by negative log returns. Higher values indicate downside-dominated paths; the signal is lagged one completed session and cross-sectionally median demeaned. Positive direction is used because the validated relationship predicts stronger subsequent 10-day returns in this benchmark."
  },
  "dependencies": ["close"],
  "parameters": {"lookback_days": 20, "min_periods": 15, "signal_lag_days": 1, "horizon_days": 10, "universe_size": 15},
