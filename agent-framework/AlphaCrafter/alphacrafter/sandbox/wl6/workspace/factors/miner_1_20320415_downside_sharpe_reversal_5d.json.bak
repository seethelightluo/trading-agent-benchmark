{
  "factor_id": "downside_sharpe_reversal_5d",
  "factor_name": "Downside-Sharpe Reversal (5d)",
  "version": "1.0",
  "calculation": {
    "expression": "-(close/close.shift(20)-1) / (rolling_std(negative_daily_returns,60)*sqrt(20)+1e-12)",
    "description": "Ranks assets by 20-session reversal return scaled by trailing 60-session downside volatility. More positive values identify recent underperformers with lower downside-risk-adjusted performance; all inputs are lagged at the decision date."
  },
  "dependencies": ["close", "daily_returns"],
  "parameters": {"lookback_return_days": 20, "downside_volatility_days": 60, "minimum_downside_observations": 30, "forecast_horizon_days": 5},
  "validation": {
    "status": "EFFECTIVE",
    "period": {"start": "2020-03-30", "end": "2032-04-07", "cutoff": "2032-04-14"},
    "metrics": {"ic": 0.0134838, "icir": 2.0389, "horizon_days": 5, "valid_dates": 2133, "average_instruments": 14.62, "coverage": 0.9750, "turnover_1d_rank_change": 0.09147, "hit_ratio": 0.5101, "max_abs_library_correlation": null},
    "admission_thresholds": {"absolute_daily_paper_ic_min": 0.0070, "absolute_daily_paper_icir_min": 0.0840},
    "regime_notes": "Positive aggregate IC, but negative periods occurred in 2021-22 and 2025; 2032 year-to-date through cutoff was negative. Small 15-asset cross-section implies conservative uncertainty. Validation used at least 8 valid instruments per date.",
    "signal_artifact": {"type": "reproducible_script", "path": "scripts/miner_1_20320415_downside_sharpe_reversal_10d.py", "formula_horizon_note": "The script computes the same factor and reports 5d, 10d, and 20d horizons; 5d result is persisted here."}
  },
  "tags": ["reversal", "downside-risk", "cross-asset", "price-only"],
  "last_validated": "2032-04-15T00:00:00Z"
}
