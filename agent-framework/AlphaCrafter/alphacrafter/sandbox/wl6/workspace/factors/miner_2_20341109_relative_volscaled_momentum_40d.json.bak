      "coverage": 0.7762,
      "turnover": 0.107376,
      "hit_ratio": 0.4996,
      "max_abs_library_correlation": null,
      "decay_ic_5d": 0.00172296,
      "decay_ic_10d": -0.00329691,
      "decay_ic_20d": -0.01505336,
      "decay_ic_40d": 0.00751451
