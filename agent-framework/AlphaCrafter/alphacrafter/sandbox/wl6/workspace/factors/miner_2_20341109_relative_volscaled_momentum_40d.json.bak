{
  "factor_id": "miner_2_20341109_relative_volscaled_momentum_40d",
  "factor_name": "Relative volatility-scaled 10-day momentum",
  "version": "1.0",
  "calculation": {
    "expression": "cross_sectional_demean((rolling_sum_10(asset_return - equal_weight_mean_return_1d) / rolling_std_20(asset_return)).shift(1))",
    "description": "Measures each asset's recent return relative to the equal-weight cross-asset benchmark, scaled by its own 20-day volatility. The one-session lag prevents look-ahead and the validated forecast horizon is 40 trading days."
  },
  "dependencies": ["close"],
  "parameters": {"relative_return_window": 10, "volatility_window": 20, "lag_days": 1, "forecast_horizon_days": 40, "minimum_cross_section": 8},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2034-11-08",
    "last_validated": "2034-11-09",
    "metrics": {
