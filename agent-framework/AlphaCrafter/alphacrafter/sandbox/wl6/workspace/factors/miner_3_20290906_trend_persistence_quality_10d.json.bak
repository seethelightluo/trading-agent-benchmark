{
  "factor_id": "miner_3_20290906_trend_persistence_quality_10d",
  "factor_name": "Trend Persistence Quality 10d",
  "version": "1.0",
  "calculation": {
    "expression": "pct_change(close,20) * (1 + 2 * (rolling_mean(indicator(daily_return>0),20,min_periods=15)-0.5))",
    "description": "Ranks 20-day price trend after scaling it by the persistence of positive daily returns; persistent upward paths receive larger positive trend scores while choppy paths are attenuated."
  },
  "dependencies": ["close"],
  "parameters": {"trend_window": 20, "persistence_window": 20, "persistence_min_periods": 15, "forward_horizon": 10},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2029-09-05",
    "metrics": {
      "ic": 0.017282,
      "icir": 0.8227,
      "ic_hit_ratio": 0.5294,
      "valid_dates": 2465,
      "average_instruments": 14.69,
      "coverage": 0.9795,
      "turnover_proxy": 0.194795,
      "max_abs_library_correlation": null,
      "admission_thresholds": {"absolute_daily_paper_ic": 0.007, "absolute_daily_paper_icir": 0.084}
    },
    "regime_notes": "10d IC by regime: 2020-2022 +0.048399; 2023-2024 -0.022033; 2025-2026 +0.034718; 2027-2028 +0.010591; 2029 YTD -0.037701. Effective on full history but materially regime-dependent and weak in 2029 YTD.",
    "signal_artifact": "scripts/miner_3_20290906_trend_persistence_quality.py"
  },
  "tags": ["momentum", "trend", "path_quality", "cross_asset"],
