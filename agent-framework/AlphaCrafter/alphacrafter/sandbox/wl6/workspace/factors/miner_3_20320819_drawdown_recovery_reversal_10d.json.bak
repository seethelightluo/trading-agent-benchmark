{
  "factor_id": "miner_3_20320819_drawdown_recovery_reversal_10d",
  "factor_name": "Downside-adjusted drawdown recovery reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(close / rolling_min(close,60) - 1) / (sqrt(rolling_mean(min(pct_change(close),0)^2,60))*sqrt(20)+1e-12) * (0.5 + 0.5*I[pct_change(close,20)>0])",
    "description": "Ranks recent 60-day recovery inversely: assets with large recoveries from their trough, especially when recovery is paired with positive 20-day return, are penalized; downside volatility normalizes the recovery magnitude. The negative sign is the validated reversal direction."
  },
  "dependencies": ["close"],
  "parameters": {"trough_window": 60, "recent_return_window": 20, "downside_window": 60, "risk_horizon_scale": 20, "forward_horizon": 10},
  "validation": {
    "status": "EFFECTIVE",
    "period": {"start": "2026-02-06", "end": "2032-08-18", "cutoff": "2032-08-18"},
    "metrics": {
