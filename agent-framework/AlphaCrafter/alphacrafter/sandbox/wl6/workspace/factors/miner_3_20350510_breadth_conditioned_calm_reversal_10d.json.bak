{
  "factor_id": "breadth_conditioned_calm_reversal_10d",
  "factor_name": "Breadth-Conditioned Calm Relative-Strength Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "(-((close/close.shift(20)-1)-cross_sectional_median(close/close.shift(20)-1)) / (rolling_std(pct_change(close),40)*sqrt(252)) * clip(1.5-breadth20,0.5,1.5)).shift(1)",
    "description": "Ranks medium-term relative weakness for reversal, scaled by asset calmness and strengthened when cross-asset 20-day breadth is weak. The full signal is lagged one day to prevent look-ahead. Breadth is the fraction of the 15 tradable assets with positive 20-day mean daily return."
  },
  "dependencies": [
    "close",
    "pct_change",
    "cross_sectional_median",
    "rolling_std"
  ],
  "parameters": {
    "relative_lookback_days": 20,
    "calmness_lookback_days": 40,
    "breadth_lookback_days": 20,
    "forecast_horizon_days": 10,
    "breadth_multiplier": "clip(1.5-breadth,0.5,1.5)",
    "lag_days": 1,
    "minimum_cross_section": 8
  },
