{
  "factor_id": "miner_2_20300822_drawdown_recovery_acceleration_10d",
  "factor_name": "Long-window Drawdown Recovery Acceleration",
  "version": "1.0",
  "calculation": {
    "expression": "(-drawdown_120d + 0.50 * return_10d) / realized_volatility_30d",
    "description": "Ranks assets favorably when they remain below their 120-day peak while exhibiting a recent 10-day recovery, with the combined signal scaled by 30-day daily realized volatility. The construction captures recovery acceleration without requiring a directional short position. Higher values predict higher subsequent returns."
  },
  "dependencies": ["close"],
  "parameters": {
    "drawdown_window": 120,
    "drawdown_min_periods": 80,
    "recovery_window": 10,
    "recovery_weight": 0.5,
    "volatility_window": 30,
    "volatility_min_periods": 20,
    "forward_horizon_days": 10,
    "cross_section_min_instruments": 8
  },
