  "factor_name": "40-Day Range Location Acceleration",
  "version": "1.0",
  "calculation": {
    "expression": "((close - rolling_min(close,40)) / (rolling_max(close,40)-rolling_min(close,40))) - lag(((close - rolling_min(close,40)) / (rolling_max(close,40)-rolling_min(close,40))),5)",
    "description": "Five-day acceleration in each asset's normalized 40-day range location. Positive values identify movement toward the upper part of the recent range and negative values movement toward the lower part. Signals are evaluated cross-sectionally without future data."
