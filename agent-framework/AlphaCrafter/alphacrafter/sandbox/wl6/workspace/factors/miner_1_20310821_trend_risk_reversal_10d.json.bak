{
  "factor_id": "miner_1_trend_risk_reversal_10d",
  "factor_name": "10-day Trend-Risk Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(close / lag(close,20) - 1) / rolling_std(pct_change(close,1),60)",
    "description": "Ranks assets favoring reversal of the 20-day trend, scaled by 60-day daily return volatility. Higher values indicate a more negative recent trend per unit of longer-run risk and are expected to predict stronger subsequent 10-day returns."
  },
  "dependencies": ["close"],
  "parameters": {"trend_window_days": 20, "risk_window_days": 60, "forward_horizon_days": 10, "minimum_cross_section": 8},
  "validation": {
