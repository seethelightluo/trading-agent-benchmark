{
  "factor_id": "miner_3_trend_consistency_60d",
  "factor_name": "60-Day Return Sign Consistency",
  "version": "1.1",
  "calculation": {
    "expression": "shift_1(mean((daily_return > 0), 60) - 0.5)",
    "description": "For each tradable asset, compute the fraction of positive daily returns over the trailing 60 completed sessions, center at zero, and lag by one session. Higher values indicate persistent upward trend; lower values indicate persistent downward trend.",
