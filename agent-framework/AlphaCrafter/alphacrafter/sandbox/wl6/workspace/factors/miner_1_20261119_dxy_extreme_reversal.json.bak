{
  "factor_id": "miner_1_dxy_extreme_reversal_1d",
  "factor_name": "Extreme lagged DXY-shock volatility-scaled reversal",
  "version": "1.0",
  "calculation": {
    "expression": "(-asset_return_t / rolling_std(asset_return,20)_{t-1}) * cap(max(DXY_return_{t-1},0) / rolling_quantile(DXY_return,60,0.75)_{t-2}, 3) when DXY_return_{t-1} > rolling_quantile(DXY_return,60,0.75)_{t-2}, else 0",
    "description": "Fades the prior completed daily asset return, scaled by lagged 20-session volatility, only after an unusually positive lagged DXY shock. The shock magnitude is capped at three times the lagged 60-session 75th percentile threshold. All inputs are lagged to prevent lookahead. Higher values indicate stronger expected next-day reversal."
  },
  "dependencies": [
    "asset close",
    "DXY close"
  ],
  "parameters": {
    "asset_vol_window": 20,
    "dxy_quantile_window": 60,
    "dxy_quantile": 0.75,
    "shock_cap": 3.0,
    "horizon_days": 1,
    "minimum_cross_section": 8
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01/2026-11-18",
