{
  "factor_id": "miner_3_gap_reversal_quality_5d",
  "factor_name": "Five-Day Volatility-Scaled Gap Reversal Quality",
  "version": "1.0",
  "calculation": {
    "expression": "-(rolling_mean(open / close.shift(1) - 1, 5) / (rolling_std(close.pct_change(), 20) * sqrt(20) + 0.02))",
    "description": "Ranks instruments by the negative recent overnight gap, scaled by 20-day realized volatility. Larger adverse recent gaps receive higher reversal scores for a five-trading-day forward horizon. Uses only completed daily OHLC data."
  },
  "dependencies": ["open", "close"],
  "parameters": {
    "gap_window": 5,
    "volatility_window": 20,
    "minimum_gap_observations": 4,
    "minimum_volatility_observations": 15,
    "stabilizer": 0.02,
    "forward_horizon_days": 5
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2029-05-30",
    "last_validated": "2029-05-31T00:00:00Z",
    "metrics": {
      "horizon_days": 5,
      "ic": 0.012992,
      "icir": 0.6596,
      "dates": 2411,
      "average_instruments": 14.68,
      "coverage": 0.9787,
      "turnover_proxy": 0.256183,
      "hit_ratio": 0.3501,
      "max_abs_library_correlation": null
    },
    "regime_notes": "Positive aggregate IC and ICIR, but regime means weakened after 2022 and turned negative in 2025-2026; results are conservative for the small 15-instrument cross-section. The latest 2029 partial regime had unstable rank correlations and was not used to claim robustness.",
    "lookahead_check": "Signal uses open and close through the observation date only; forward close returns are used solely for validation."
  },
  "signal_artifact": "scripts/miner_3_20290531_gap_reversal_quality.py",
  "tags": ["reversal", "overnight_gap", "volatility_scaled", "cross_asset"]
}