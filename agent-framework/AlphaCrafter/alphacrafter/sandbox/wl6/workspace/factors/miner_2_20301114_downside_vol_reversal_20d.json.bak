{
  "factor_id": "miner_2_20301114_downside_vol_reversal_20d",
  "factor_name": "Downside-volatility-scaled 20-day reversal",
  "version": "1.0",
  "calculation": {
    "expression": "clip(-(close/shift(close,20)-1)/(rolling_std(where(pct_change(close)<0,pct_change(close),NaN),20,min_periods=10)*sqrt(20)),-8,8)",
    "description": "Ranks assets by 20-day reversal normalized by downside-only daily volatility. Negative observations contribute to the risk scale, while upside volatility is not penalized. Higher values indicate unusually weak risk-adjusted trailing performance and a stronger expected rebound."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "lookback_days": 20,
    "downside_vol_window": 20,
    "downside_vol_min_periods": 10,
    "normalization": "sqrt(20)",
    "winsorization": [
      -8,
      8
    ],
    "forward_horizon_days": 20,
    "minimum_cross_section": 8,
    "universe_size": 15
  },
