{
  "factor_id": "miner_3_20310626_trend_efficiency_5d",
  "factor_name": "Path-Efficiency Trend Persistence",
  "version": "1.0",
  "calculation": {
    "expression": "(close/lag(close,60)-1) / rolling_sum(abs(daily_return),60)",
    "description": "Ranks assets by directional 60-day return relative to the absolute-return path length over the same window. Higher values indicate more efficient, persistent trends; only completed historical prices are used."
  },
  "dependencies": ["close", "daily_return"],
  "parameters": {
    "trend_window": 60,
    "path_window": 60,
    "minimum_path_observations": 45,
    "forward_horizon_days": 5,
    "cross_section_minimum": 8
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 to 2031-06-20",
    "validated_at": "2031-06-26",
