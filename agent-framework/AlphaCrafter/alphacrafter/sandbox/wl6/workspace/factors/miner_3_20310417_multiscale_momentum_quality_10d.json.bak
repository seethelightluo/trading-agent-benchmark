{
  "factor_id": "miner_3_20310417_multiscale_momentum_quality_10d",
  "factor_name": "Volatility-Scaled Multiscale Momentum Agreement",
  "version": "1.0",
  "calculation": {
    "expression": "((0.25*return(close,20)+0.35*return(close,60)+0.40*return(close,120))*((sign(return20)+sign(return60)+sign(return120))/3))/(rolling_std(daily_returns,60)+1e-12)",
    "description": "Ranks assets by a volatility-scaled blend of 20-, 60-, and 120-day momentum, multiplied by the fractionally signed agreement across those horizons. Agreement rewards persistent directional trends and suppresses conflicting multi-horizon signals. All inputs are lagged to the decision date."
  },
  "dependencies": ["close", "daily_returns"],
  "parameters": {
    "return_windows": [20, 60, 120],
    "blend_weights": [0.25, 0.35, 0.40],
    "volatility_window": 60,
    "volatility_min_periods": 40,
    "forward_horizon_days": 10
  },
  "validation": {
