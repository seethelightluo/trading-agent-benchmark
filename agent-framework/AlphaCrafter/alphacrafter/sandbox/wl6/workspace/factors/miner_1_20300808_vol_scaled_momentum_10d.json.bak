{
  "factor_id": "miner_1_20300808_vol_scaled_momentum_10d",
  "factor_name": "Volatility-Scaled Medium-Term Momentum with Breadth Dampener",
  "version": "1.0",
  "calculation": {
    "expression": "((close_t / close_{t-20}) - 1) / (std(pct_change(close),30) * sqrt(252)) * (0.5 + mean_i(1[sum_{20} return_i > 0]))",
    "description": "Twenty-session momentum divided by trailing 30-session annualized realized volatility, multiplied by a contemporaneous cross-asset breadth modifier. Signal uses only information available through date t and forecasts the next 10 trading days."
  },
  "dependencies": ["close", "pct_change", "15-asset cross-sectional returns"],
  "parameters": {"momentum_window": 20, "volatility_window": 30, "annualization": 252, "breadth_window": 20, "breadth_floor": 0.5, "horizon_days": 10},
  "validation": {
