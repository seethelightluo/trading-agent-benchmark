  "factor_name": "VIX-weighted short-term reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-pct_change(close,5) * (VIX / rolling_median(VIX,60))",
    "description": "Ranks assets for reversal using the negative five-day return, amplified or damped by the contemporaneous observation-only VIX stress ratio. VIX is aligned and forward-filled only from completed observations; no tradable order is implied for VIX."
  },
  "dependencies": ["close", "VIX observation-only macro signal"],
  "parameters": {
    "return_window": 5,
    "vix_median_window": 60,
    "forward_horizon_days": 20,
    "minimum_cross_section": 8,
    "annualization": 252
  },
