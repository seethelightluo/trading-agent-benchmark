{
  "factor_id": "miner_3_20310320_downside_risk_reversal_20d",
  "factor_name": "Downside-Risk-Adjusted 20-Day Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-return(close,20) / (rolling_std(daily_returns,40) + rolling_std(negative_daily_returns,40))",
    "description": "Ranks assets favoring negative recent 20-day returns, scaled down when total or downside volatility is high. Negative-return observations are used for downside volatility; the fallback is total volatility when downside history is unavailable. Signal is computed using information available at the decision date."
  },
  "dependencies": [
    "close",
    "daily_returns"
  ],
  "parameters": {
    "return_window": 20,
    "volatility_window": 40,
    "volatility_min_periods": 25,
    "downside_min_periods": 5,
    "forward_horizon_days": 20
  },
