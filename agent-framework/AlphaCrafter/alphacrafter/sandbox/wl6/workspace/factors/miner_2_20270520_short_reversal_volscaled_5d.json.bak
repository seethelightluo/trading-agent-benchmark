{
  "factor_id": "miner_2_20270520_short_reversal_volscaled_5d",
  "factor_name": "Lagged volatility-scaled short-term reversal",
  "version": "1.0",
  "calculation": {
    "expression": "shift_1(-(close / shift(close, 5) - 1) / (rolling_std(pct_change(close), 20) * sqrt(252)))",
    "description": "Ranks assets higher when their prior 5-session loss was large relative to their trailing 20-session annualized volatility. All inputs are lagged one completed session to prevent look-ahead. Higher values predict stronger subsequent 10-session returns in the full sample."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "return_window": 5,
    "volatility_window": 20,
    "annualization": 252,
    "lag": 1,
    "forward_horizon": 10
  },
  "validation": {
