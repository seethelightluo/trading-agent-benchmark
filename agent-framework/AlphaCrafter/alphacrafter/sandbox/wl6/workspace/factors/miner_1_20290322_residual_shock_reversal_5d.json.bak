{
  "factor_id": "miner_1_20290322_residual_shock_reversal_5d",
  "factor_name": "Cross-Sectional Residual Shock Reversal 5-Day",
  "version": "1.0",
  "calculation": {
    "expression": "-((ret_5 / (std(ret_1,20)*sqrt(5))) - cross_sectional_median(ret_5 / (std(ret_1,20)*sqrt(5))))",
    "description": "Compute each asset's five-day return standardized by its 20-day realized volatility, subtract the cross-sectional median shock, and invert it to favor relative shock losers for the next five trading days. The signal is formed only from completed data."
  },
  "dependencies": ["close"],
  "parameters": {"shock_window_days": 5, "volatility_window_days": 20, "forward_horizon_days": 5, "minimum_cross_section": 8},
