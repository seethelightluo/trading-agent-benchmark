{
  "factor_id": "trend_consistency_momentum_10d",
  "factor_name": "Trend-Consistency Weighted Momentum",
  "version": "20330623",
  "calculation": {
    "expression": "pct_change(close,20) * (2 * rolling_mean(indicator(pct_change(close,1)>0),20) - 1)",
    "description": "Twenty-day momentum weighted by directional persistence of daily returns; sustained one-sided trends receive larger magnitude and choppy paths are attenuated or sign-reversed. Signal is evaluated against the next 10 trading-day return."
  },
  "dependencies": ["close"],
  "parameters": {"lookback_days": 20, "horizon_days": 10, "positive_return_indicator": true},
  "validation": {
