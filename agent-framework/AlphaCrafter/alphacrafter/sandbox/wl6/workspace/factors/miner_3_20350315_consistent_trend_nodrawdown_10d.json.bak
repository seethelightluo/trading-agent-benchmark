{
  "factor_id": "consistent_trend_nodrawdown_10d",
  "factor_name": "Volatility-Scaled Consistent Trend Without Drawdown Penalty",
  "version": "1.0",
  "calculation": {
    "expression": "lag1((close/close.shift(60)-1) * (1 + (mean(return>0,40)-0.5)) / (std(return,40)*sqrt(252)))",
    "description": "Compute 60-trading-day price momentum, amplify it by directional consistency measured as the 40-day fraction of positive returns, and scale by inverse 40-day realized volatility. Lag the signal one completed day to avoid look-ahead. Unlike the related drawdown-penalized factor, this version does not include a rolling-high drawdown term."
  },
  "dependencies": ["close", "pct_change"],
  "parameters": {"momentum_window": 60, "consistency_window": 40, "volatility_window": 40, "annualization": 252, "lag_days": 1},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2035-03-13",
    "metrics": {
      "horizon_days": 10,
      "ic": 0.01370715,
      "icir": 2.18996627,
      "hit_ratio": 0.5277,
      "dates": 2206,
      "average_instruments": 12.666,
      "coverage": 0.8444,
      "turnover": 0.04887,
      "max_abs_library_correlation": null
    },
    "regime_notes": "Positive full-sample 10-day rank IC and ICIR across the 15-instrument synthetic cross-asset universe; uncertainty should be interpreted conservatively because the cross-section is small. Decay is positive at 5D, 20D, and 40D, with IC 0.013247, 0.015947, and 0.017535 respectively.",
    "signal_artifact": "scripts/miner_3_20350315_consistent_trend_nodrawdown_signal.csv",
