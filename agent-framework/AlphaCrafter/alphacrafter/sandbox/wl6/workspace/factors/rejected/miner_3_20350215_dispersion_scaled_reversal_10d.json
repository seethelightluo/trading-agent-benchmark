{
  "factor_id": "dispersion_scaled_reversal_10d",
  "factor_name": "High-Dispersion Volatility-Scaled 10D Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "where(rolling_percentile(rolling_std(cross_sectional_daily_returns,20),20)>0.5, -return(close,10)/(std(daily_returns,20)*sqrt(252)), NaN), shifted_by_1_day",
    "description": "Ranks assets by their negative trailing 10-trading-day return scaled by own 20-day annualized realized volatility, activated only when the 20-day percentile of cross-asset daily-return dispersion exceeds its median; signal is lagged one completed session to prevent look-ahead."
