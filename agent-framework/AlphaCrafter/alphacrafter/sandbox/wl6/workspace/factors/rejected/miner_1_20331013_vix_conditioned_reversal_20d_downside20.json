  "factor_name": "VIX-conditioned 20-day downside-volatility reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(close/close.shift(20)-1) / rolling_std(negative_daily_returns,20) * clip(1/(1 + SMA(VIX,20)/SMA(VIX,120)),0.35,0.8)",
