  "factor_id": "miner_3_downside_risk_adjusted_momentum_20d",
  "factor_name": "Downside-Risk Adjusted Consistency Momentum",
  "version": "1.0",
  "calculation": {
    "expression": "(pct_change(close,20) / (sqrt(rolling_mean(min(pct_change(close,1),0)^2,40))*sqrt(20))) * (0.5 + 0.5*(2*rolling_mean(1[pct_change(close,1)>0],20)-1))",
    "description": "Twenty-day momentum divided by trailing 40-day downside deviation annualization proxy, multiplied by a bounded 20-day positive-return consistency term. All inputs are lagged completed daily observations at decision time."
  },
  "dependencies": ["close"],
  "parameters": {
    "momentum_window": 20,
    "downside_window": 40,
