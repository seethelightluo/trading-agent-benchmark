{
  "factor_id": "miner_2_volregime_drawdown_reversal_20d",
  "factor_name": "Volatility-Regime-Scaled Drawdown Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "shift1((-(close/rolling_max(close,60)-1)/rolling_std(return,20)) * clip(rolling_std(return,60)/rolling_std(return,20),0.25,4.0))",
    "description": "Ranks assets for 20-trading-day forward reversal by scaling 60-day drawdown relative to 20-day volatility, then weighting by the ratio of medium-term to short-term volatility. The one-session lag prevents use of the current completed session in the decision signal."
  },
  "dependencies": ["close", "daily returns"],
  "parameters": {
    "drawdown_window": 60,
    "short_volatility_window": 20,
    "medium_volatility_window": 60,
    "regime_ratio_clip": [0.25, 4.0],
    "signal_lag_sessions": 1,
    "forward_horizon_sessions": 20,
    "minimum_cross_section": 8
  },
