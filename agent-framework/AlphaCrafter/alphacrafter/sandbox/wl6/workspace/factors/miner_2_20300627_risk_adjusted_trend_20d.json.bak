{
  "factor_id": "risk_adjusted_trend_drawdown_penalty_20d",
  "factor_name": "Risk-Adjusted Trend with Drawdown Penalty",
  "version": "1.0",
  "calculation": {
    "expression": "pct_change(close,20)/(annualized_std(pct_change(close),20)+1e-8) + 0.5*(close/rolling_max(close,20)-1)",
    "description": "Twenty-day momentum is scaled by 20-day annualized volatility and penalized by the current distance from the 20-day high. Higher values indicate efficient trend continuation with limited recent drawdown.",
    "source_script": "scripts/miner_2_20300627_risk_adjusted_trend.py",
    "signal_artifact": "computed directly from the 15-symbol close panels in the source script; no future observations are used"
  },
  "dependencies": [
    "close",
    "daily_returns"
  ],
  "parameters": {
    "momentum_window": 20,
    "volatility_window": 20,
    "drawdown_window": 20,
    "drawdown_penalty": 0.5,
    "annualization": 252,
    "epsilon": 1e-08,
    "forward_horizon": 10
  },
