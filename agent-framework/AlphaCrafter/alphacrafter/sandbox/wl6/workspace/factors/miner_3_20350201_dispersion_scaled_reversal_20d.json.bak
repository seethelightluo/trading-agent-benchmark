{
  "factor_id": "dispersion_scaled_reversal_20d",
  "factor_name": "High-Dispersion Volatility-Scaled 5D Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "shift1((-pct_change(close,5) / (rolling_std(pct_change(close,1),20)*sqrt(252))) * I(cross_sectional_dispersion_percentile_20d > 0.5))",
    "description": "Contrarian five-day return scaled by each asset's 20-day realized volatility, activated when the cross-asset one-day return dispersion is above its trailing 20-day median; shifted one trading day to avoid look-ahead."
  },
  "dependencies": ["close"],
  "parameters": {"reversal_window": 5, "volatility_window": 20, "dispersion_window": 20, "dispersion_threshold": 0.5, "lag": 1, "forward_horizon": 20},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 to 2035-01-30",
    "last_validated": "2035-02-01",
    "metrics": {
      "ic_20d": 0.03245244,
      "icir_20d": 3.55442655,
      "ic": 0.03245244,
      "icir": 3.55442655,
      "dates": 1092,
      "average_instruments": 11.655,
      "coverage": 0.7770,
      "turnover": 0.19907,
      "hit_ratio": 0.5394,
      "max_abs_library_correlation": null
    },
    "thresholds": {"absolute_daily_paper_ic": 0.007, "absolute_daily_paper_icir": 0.084},
    "regime_notes": "Positive across all tested horizons; 20D strongest. Small 15-asset cross-section requires conservative interpretation. High dispersion gate is active only conditionally; signal artifact records valid observations.",
    "provenance": {"validation_script": "scripts/miner_3_20350201_dispersion_scaled_reversal.py", "signal_artifact": "scripts/miner_3_20350201_dispersion_scaled_reversal_signal.csv"}
