{
  "factor_id": "miner_1_20300822_dxy_conditioned_momentum_10d",
  "factor_name": "DXY-Regime-Conditioned Volatility-Scaled Momentum",
  "version": "1.0",
  "calculation": {
    "expression": "((close/close.shift(20)-1)/(std(pct_change(close),30)*sqrt(252))) * (1 - (DXY/DXY.rolling_mean(60)-1))",
    "description": "Twenty-session momentum normalized by 30-session annualized volatility, continuously damped when DXY is above its causal 60-session mean. DXY is observation-only and never tradable."
  },
  "dependencies": ["close", "DXY", "pct_change"],
  "parameters": {"momentum_window": 20, "volatility_window": 30, "dxy_regime_window": 60, "horizon_days": 10},
  "validation": {
    "status": "EFFECTIVE",
    "metrics": {
      "ic": 0.01613731,
      "icir": 0.82185,
      "ic_hit_ratio": 0.50673,
      "valid_dates": 3418,
      "average_instruments": 14.096,
      "coverage": 0.93117,
      "turnover": 0.59305,
      "decay_ic_5d": 0.00289498,
      "decay_ic_20d": 0.02763768,
      "max_abs_library_correlation": null
    },
    "period": "2020-01-01 through 2030-08-21",
    "regime_notes": "Positive in 2020-2022 and 2024-2027, negative in 2023 and 2028-2030 YTD; regime dependence is substantial and uncertainty is conservative given 15-asset cross-section."
  },
  "signal_provenance": {"artifact": "scripts/miner_1_20300822_dxy_conditioned_momentum.py", "signal_definition": "sig at date t uses prices and DXY through t only; forward return starts after t", "universe_size": 15},
