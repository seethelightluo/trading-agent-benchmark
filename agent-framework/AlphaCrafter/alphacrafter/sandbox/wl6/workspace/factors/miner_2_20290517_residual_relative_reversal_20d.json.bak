  "factor_name": "Beta-Neutral Residual Relative-Strength Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-rolling_sum_40(residual_return) / (rolling_std_20(residual_return)*sqrt(20)+0.02)",
    "description": "For each tradable asset, estimate trailing 60-day beta to the equal-weight universe return, subtract beta times benchmark return to form residual returns, then reverse the 40-day residual momentum and scale by trailing 20-day residual volatility. Higher values indicate residual underperformers with lower residual risk and are expected to mean-revert over the 20-day validation horizon.",
    "lookahead_control": "All beta, residual, momentum, and volatility inputs are trailing-only; forward returns are labels only.",
