{
  "factor_id": "consistent_trend_quality_20d",
  "factor_name": "Volatility- and drawdown-adjusted consistent trend quality",
  "version": "1.0",
  "calculation": {
    "expression": "shift_1((pct_change(close,60)*(1+(mean(indicator(return>0),40)-0.5)))/(std(return,40)*sqrt(252)*(1+max(-drawdown(close,120),0))))",
    "description": "Ranks medium-term momentum by directional consistency, while penalizing realized volatility and distance below the trailing 120-day high; lagged one session to avoid look-ahead."
  },
  "dependencies": ["close", "pct_change", "rolling_std", "rolling_max"],
  "parameters": {"momentum_window": 60, "consistency_window": 40, "risk_window": 40, "drawdown_window": 120, "lag": 1, "admission_horizon_days": 20},
