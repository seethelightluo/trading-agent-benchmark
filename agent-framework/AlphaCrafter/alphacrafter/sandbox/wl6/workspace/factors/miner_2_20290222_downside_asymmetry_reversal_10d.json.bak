    "thresholds": {"min_abs_ic": 0.007, "min_abs_icir": 0.084},
    "regime_notes": "The un-negated asymmetry produced IC -0.025371 and ICIR -0.092198; this persisted factor reverses its sign so admission metrics are positive. Regime breakdowns are interpreted conservatively because the retrieved validation sample is uneven across historical date buckets and the universe has only 15 instruments.",
    "signal_provenance": "scripts/miner_2_20290222_volatility_asymmetry.py"
