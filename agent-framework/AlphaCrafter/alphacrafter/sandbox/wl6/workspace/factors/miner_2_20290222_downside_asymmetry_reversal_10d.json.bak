{
  "factor_id": "miner_2_20290222_downside_asymmetry_reversal_10d",
  "factor_name": "Downside-Asymmetry Reversal (10D)",
  "version": "1.0",
  "calculation": {
    "expression": "(downside_rms_20 - upside_rms_20) / total_volatility_60",
    "description": "Negated volatility asymmetry: favors assets whose recent downside RMS exceeds upside RMS, consistent with a cross-sectional reversal/stress-recovery effect. All rolling inputs are lagged completed daily observations at the signal date."
  },
  "dependencies": ["close", "pct_change"],
  "parameters": {"upside_downside_window": 20, "total_volatility_window": 60, "min_periods_short": 15, "min_periods_long": 40, "forward_horizon_days": 10},
  "validation": {
    "status": "EFFECTIVE",
    "last_validated": "2029-02-22",
