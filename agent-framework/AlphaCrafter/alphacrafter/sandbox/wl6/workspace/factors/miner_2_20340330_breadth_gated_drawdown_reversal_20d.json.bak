    "decay": {"5d_ic": -0.00411215, "10d_ic": 0.00418691, "20d_ic": 0.00735958, "40d_ic": -0.0024312},
    "regime_notes": "20-day IC passed overall; positive annual IC in 2026, 2028, 2030, and 2034 YTD, with weakness in 2032-2033. Small cross-asset universe implies conservative interpretation of IC uncertainty.",
    "signal_artifact": "scripts/miner_2_20340330_breadth_gated_drawdown_reversal.py",
