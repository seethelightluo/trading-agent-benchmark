{
  "factor_id": "miner_2_breadth_gated_drawdown_reversal_20d",
  "factor_name": "Breadth-Gated 60-Day Drawdown Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "(-drawdown_60 / volatility_20) * clip(0.5 + cross_sectional_breadth_20, 0.25, 1.5), lagged 1 session",
    "description": "Ranks oversold assets by 60-day peak drawdown normalized by 20-day volatility, scaled by the fraction of tradable assets with positive 20-day returns. The breadth gate gives greater weight to isolated drawdowns during broad positive tapes and suppresses reversal exposure during broad weakness. Signal is lagged one completed session to avoid look-ahead."
  },
  "dependencies": ["close"],
  "parameters": {
    "drawdown_lookback_days": 60,
    "volatility_lookback_days": 20,
    "breadth_return_lookback_days": 20,
    "breadth_definition": "fraction of the 15 tradable assets with positive 20-day return",
    "gate_formula": "clip(0.5 + breadth, 0.25, 1.5)",
    "signal_lag_days": 1,
    "forward_validation_horizon_days": 20,
    "minimum_cross_section": 8
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 to 2034-03-29 data; forward observations through 2034-03-09",
    "last_validated": "2034-03-30",
