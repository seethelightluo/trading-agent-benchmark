{
  "factor_id": "miner_3_20320205_risk_scaled_acceleration_reversal_20d",
  "factor_name": "Risk-Scaled Acceleration Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-((close/close.shift(20)-1) - (close/close.shift(60)-1)/3) / (rolling_std(pct_change(close),40,min_periods=20)*sqrt(20)+1e-12)",
    "description": "Reverses the difference between recent 20-session return and the one-third-scaled 60-session return, with the difference normalized by 40-session realized daily volatility. Higher values favor assets whose recent acceleration was weaker after risk adjustment. Signal is computed using information available at the decision date only.",
    "provenance_script": "scripts/miner_3_20320205_risk_scaled_acceleration.py",
    "signal_artifact": "Reconstructable from the expression over the 15-asset close panel; validation cutoff 2032-02-04."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "recent_window": 20,
    "baseline_window": 60,
    "baseline_scale": 3,
    "volatility_window": 40,
    "volatility_min_periods": 20,
    "primary_horizon_days": 20
  },
