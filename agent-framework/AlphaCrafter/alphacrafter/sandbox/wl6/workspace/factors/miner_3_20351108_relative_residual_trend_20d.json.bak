{
  "factor_id": "relative_residual_trend_20d",
  "factor_name": "Cross-asset relative residual risk-adjusted trend 20D",
  "version": "2035-11-08",
  "calculation": {
    "expression": "(0.6*(return_20d - cross_sectional_mean(return_20d)) + 0.4*(return_60d - cross_sectional_mean(return_60d))) / rolling_std(daily_return,60)",
    "description": "Ranks instruments by medium/long horizon trend relative to the contemporaneous cross-asset mean, scaled by instrument volatility. Relative residualization removes the common market move while preserving cross-sectional leadership."
  },
  "dependencies": ["close", "daily_return"],
  "parameters": {"short_window": 20, "long_window": 60, "short_weight": 0.6, "long_weight": 0.4, "vol_window": 60, "epsilon": 1e-8, "forward_horizon": 20},
