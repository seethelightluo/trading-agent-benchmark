{
  "factor_id": "miner_1_20291101_smoothed_breadth_trend_10d",
  "factor_name": "Smoothed Cross-Asset Breadth Trend",
  "version": "1.0",
  "calculation": {
    "expression": "return_20d(asset) * (0.5 + mean_i[close_i > SMA_60_i])",
    "description": "For each tradable asset, multiply its trailing 20-day return by a continuous cross-sectional breadth state: 0.5 plus the fraction of the 15-asset universe whose close is above its 60-day moving average. The breadth multiplier is common across assets and therefore preserves the cross-sectional ranking while providing an interpretable market-regime state.",
    "signal_artifact": "scripts/miner_3_20291018_smoothed_breadth_trend.py"
  },
  "dependencies": ["close", "date"],
  "parameters": {
