{
  "factor_id": "miner_3_20340330_peer_residual_reversal_20d",
  "factor_name": "Risk-scaled peer residual reversal 20d",
  "version": "1.0",
  "calculation": {
    "expression": "-(asset_return_20d - equal_weight_cross_asset_mean_return_20d) / annualized_realized_volatility_20d",
    "description": "Ranks assets that underperformed the contemporaneous equal-weight 15-asset 20-day return basket, favoring larger negative residuals for mean reversion while scaling by each asset's 20-day realized volatility. The peer mean is computed cross-sectionally at each date using available tradable assets."
  },
  "dependencies": ["close", "daily_returns"],
  "parameters": {"residual_lookback_days": 20, "volatility_lookback_days": 20, "volatility_annualization": "sqrt(20)", "minimum_cross_section": 8},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2034-03-29 cutoff; forward 10-day observations available through 2034-03-15",
