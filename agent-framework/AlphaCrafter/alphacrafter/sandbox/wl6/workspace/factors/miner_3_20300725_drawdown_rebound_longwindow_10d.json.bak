  "factor_name": "Long-Window Drawdown Rebound with Risk-Scaled Recovery",
  "version": "1.0",
  "calculation": {
    "expression": "-(close / rolling_max(close,60) - 1) + 0.35 * return_10d / (sqrt(20)*std_30d)",
