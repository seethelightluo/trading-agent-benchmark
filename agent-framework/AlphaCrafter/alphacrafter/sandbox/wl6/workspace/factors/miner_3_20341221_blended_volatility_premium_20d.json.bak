      "average_instruments": 15.0,
      "coverage": 1.0,
      "turnover": null,
      "decay": {"5d_ic": -0.002089, "10d_ic": -0.000780, "20d_ic": 0.009471, "40d_ic": 0.016170},
      "max_abs_library_correlation": null
    },
    "thresholds": {"minimum_absolute_daily_paper_ic": 0.0070, "minimum_absolute_daily_paper_icir": 0.0840},
    "regime_notes": "Full-history validation across the 15-instrument synthetic cross-asset universe. The factor is weak/negative at 5D and 10D but positive at 20D and stronger at 40D, supporting a medium-horizon use. Small cross-section implies conservative interpretation despite 2,122 daily IC observations.",
    "universe": ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"],
