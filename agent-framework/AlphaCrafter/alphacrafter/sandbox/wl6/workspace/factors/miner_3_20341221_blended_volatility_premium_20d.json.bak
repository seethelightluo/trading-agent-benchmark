{
  "factor_id": "blended_volatility_premium_20d",
  "factor_name": "Blended Cross-Asset Realized Volatility Premium 20D",
  "version": "1.0",
  "calculation": {
    "expression": "0.5*sqrt(20)*std(log_return,20) + 0.5*sqrt(60)*std(log_return,60), lagged one session",
    "description": "Ranks tradable cross-asset instruments by the average of 20-session and 60-session annualized realized volatility, using only information available through the prior completed session. Higher realized volatility receives a higher expected-return score."
  },
  "dependencies": ["close"],
  "parameters": {"short_window": 20, "long_window": 60, "weights": [0.5, 0.5], "lag": 1, "forward_horizon_days": 20},
  "validation": {
    "status": "EFFECTIVE",
    "period": {"start": "2020-01-01", "end": "2034-12-06"},
    "validated_at": "2034-12-21",
