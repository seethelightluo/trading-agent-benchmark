{
  "factor_id": "miner_1_trend_persistence_120d",
  "factor_name": "Downside-Risk-Adjusted 120D Trend Persistence (Contrarian Orientation)",
  "version": "1.0",
  "calculation": {
    "expression": "-((close/close.shift(120)-1)/(rolling_std(min(pct_change(close),0),60)*sqrt(252)+1e-8))*(1+0.35*tanh(rolling_mean(pct_change(close),60)/(rolling_std(pct_change(close),60)+1e-8)*sqrt(60)))",
    "description": "Ranks assets by the negative of a 120-session return normalized by 60-session downside volatility, modulated by 60-session path consistency. The validated orientation is contrarian: assets with stronger downside-risk-adjusted medium-term trends receive lower scores. All inputs are lagged one completed session before use."
  },
  "dependencies": ["close"],
  "parameters": {
    "trend_lookback_sessions": 120,
    "risk_lookback_sessions": 60,
    "consistency_lookback_sessions": 60,
    "consistency_weight": 0.35,
    "annualization": 252,
    "minimum_cross_section": 8,
    "universe_size": 15
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": {"start": "2020-05-02", "end": "2035-07-04"},
    "validated_at": "2035-08-30",
    "metrics": {
      "admission_horizon_days": 40,
      "ic": 0.02965459,
      "icir": 0.09114,
      "hit_ratio": 0.5573,
      "valid_dates": 4606,
      "average_instruments": 14.999,
      "coverage": 0.9999,
      "rank_turnover": 0.03752,
      "max_abs_library_correlation": null,
      "decay": {"5d_ic": 0.00048743, "10d_ic": 0.00877592, "20d_ic": 0.01704518, "40d_ic": 0.02965459},
      "regime_notes": "Full synthetic history spanning 2020-05-02 through 2035-08-22 signal dates and multiple market regimes; sign was selected strictly from the observed same-horizon paper IC, with no future data in signal construction. Small cross-section uncertainty is mitigated by 4,606 daily observations.",
      "signal_artifact": "scripts/miner_1_20350830_trend_persistence_120d_signal.csv",
      "validation_script": "scripts/miner_1_20350830_trend_persistence_120d.py"
    }
  },
  "tags": ["trend", "contrarian", "downside-risk", "low-turnover", "cross-asset"],
