{
  "factor_id": "miner_1_20311127_downside_vol_reversal_20d",
  "factor_name": "Downside-Volatility-Normalized 10-Day Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(close_t / close_{t-10} - 1) / rolling_std(where(daily_return < 0, daily_return, 0), 40)",
    "description": "Ranks assets for 20-trading-day forward performance by reversing their trailing 10-day return and scaling by 40-day downside-return volatility. The signal uses only prices through the decision cutoff and is undefined when downside volatility is unavailable or zero."
  },
  "dependencies": ["close"],
  "parameters": {"lookback_return_days": 10, "downside_volatility_window_days": 40, "forward_validation_horizon_days": 20, "minimum_cross_section": 8},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2031-11-26",
    "metrics": {
      "ic": 0.01431134,
      "icir": 2.081913,
      "horizon_days": 20,
      "dates": 2026,
      "average_instruments": 12.61,
      "coverage": 0.587452,
      "turnover_proxy": 0.178792,
      "hit_ratio": 0.5242,
      "max_abs_library_correlation": null
    },
    "regime_notes": "20-day signal passed benchmark gates; 5-day IC -0.00030750 and 10-day IC -0.00353305 failed, indicating slower decay profile. Cross-sectional sample is small and coverage is reduced by the 40-day downside-volatility warm-up/availability; interpret uncertainty conservatively. Annual 10-day behavior was mixed across regimes.",
    "provenance": "scripts/miner_3_20311127_downside_vol_reversal.py",
    "no_future_data": true,
    "validation_timestamp": "2031-11-27"
  },
  "tags": ["reversal", "volatility", "downside-risk", "cross-asset", "20d-horizon"]
