  "factor_name": "Downside-volatility-scaled range-location acceleration",
  "version": "1.0",
  "calculation": {
    "expression": "((close-min(close,40))/(max(close,40)-min(close,40)) - lag((close-min(close,40))/(max(close,40)-min(close,40)),5)) / (sqrt(rolling_mean(min(pct_change(close),0)^2,20))*sqrt(252))",
    "description": "Five-day acceleration in trailing 40-day range location, scaled by 20-day downside semideviation annualized. Positive values indicate upward range progress relative to recent downside risk."
  },
  "dependencies": ["close"],
  "parameters": {"range_window": 40, "lag_window": 5, "downside_vol_window": 20, "annualization": 252, "forward_horizon_days": 10},
