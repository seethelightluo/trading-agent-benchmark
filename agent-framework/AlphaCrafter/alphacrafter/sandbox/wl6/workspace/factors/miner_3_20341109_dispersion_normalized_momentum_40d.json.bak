{
  "factor_id": "dispersion_normalized_momentum_40d",
  "factor_name": "Cross-Asset Dispersion-Normalized Momentum 40D",
  "version": "1.0",
  "calculation": {
    "expression": "shift_1(rolling_sum(pct_change(close),20) / mean_cross_asset(rolling_std(pct_change(close),20)))",
    "description": "For each tradable asset, compute its 20-session cumulative return and divide by the cross-sectional mean of 20-session realized return volatility. Lag the signal by one completed session and cross-sectionally median demean it. The signal is intended for a 40-session forward horizon."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "momentum_window": 20,
    "volatility_window": 20,
    "lag_sessions": 1,
    "forward_horizon": 40,
    "min_periods": 15
  },
  "validation": {
