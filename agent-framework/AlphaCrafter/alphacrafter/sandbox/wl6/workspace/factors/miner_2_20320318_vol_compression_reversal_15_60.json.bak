  "factor_name": "15-Day Volatility-Compression Reversal",
  "version": "1.2",
  "calculation": {
    "expression": "-return(close,15) * clip(rolling_std(daily_returns,60) / (rolling_std(daily_returns,10) + 1e-12), 0.25, 4.0)",
    "description": "Contrarian 15-session return scaled by the ratio of 60-session to 10-session realized volatility. Higher scores favor recent losers whose short-term volatility is compressed relative to the longer baseline. Signal uses only observations available through the prior completed session.",
