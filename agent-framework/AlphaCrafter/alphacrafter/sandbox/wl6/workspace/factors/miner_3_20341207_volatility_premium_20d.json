  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "volatility_window_days": 20,
    "annualization_scale": "sqrt(20)",
    "minimum_observations": 15,
    "lag_days": 1,
    "demean": "cross_sectional_median"
  },
