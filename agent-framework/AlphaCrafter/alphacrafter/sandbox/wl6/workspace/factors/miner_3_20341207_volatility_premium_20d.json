  "factor_name": "Cross-Asset Realized Volatility Premium 20D",
  "version": "1.0",
  "calculation": {
    "expression": "cross_sectional_demean(shift(rolling_std(pct_change(close), 20, min_periods=15) * sqrt(20), 1))",
    "description": "Ranks assets by lagged 20-session realized volatility. Higher recent realized volatility receives a higher expected forward-return score; the signal is cross-sectionally median demeaned to remove the common volatility level.",
