{
  "factor_id": "miner_2_20340216_downside_cluster_reversal_20d",
  "factor_name": "Downside Cluster Reversal 20D",
  "version": "1.1",
  "calculation": {
    "expression": "-(close/close.shift(10)-1) * mean(max(-daily_return,0),20) / (std(max(-daily_return,0),20)*sqrt(20)+epsilon) * (1 + mean((max(-daily_return,0)>0),20))",
    "description": "A contrarian medium-horizon signal that favors assets with recent 10-day losses concentrated in downside-heavy, downside-volatility paths. Higher values indicate stronger oversold downside clustering and expected 20-day rebound.",
    "signal_artifact": "scripts/miner_2_20340216_downside_cluster_reversal_20d_revalidation.py"
  },
  "dependencies": ["close"],
  "parameters": {
    "recent_return_window": 10,
    "downside_window": 20,
    "minimum_downside_observations": 15,
    "forward_horizon_days": 20,
    "epsilon": 1e-12
  },
  "validation": {
    "status": "EFFECTIVE",
