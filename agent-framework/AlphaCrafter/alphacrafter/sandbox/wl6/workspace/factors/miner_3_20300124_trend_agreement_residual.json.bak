{
  "factor_id": "trend_agreement_residual_20d",
  "factor_name": "Trend Agreement Residual Momentum",
  "version": "1.0",
  "calculation": {
    "expression": "demean_cs((pct_change(close,20) / (std(pct_change(close,1),20)*sqrt(252))) * (sign(pct_change(close,5)) + sign(pct_change(close,20)) + sign(pct_change(close,60))) / 3)",
    "description": "Risk-scaled 20-day momentum, multiplied by agreement among 5-, 20-, and 60-day momentum signs, then cross-sectionally demeaned. All inputs are lagged at the decision timestamp and the signal is long-only portfolio ranking compatible."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "short_window": 5,
    "momentum_window": 20,
    "long_window": 60,
    "volatility_window": 20,
    "annualization": 252,
    "cross_sectional_demean": true
  },
