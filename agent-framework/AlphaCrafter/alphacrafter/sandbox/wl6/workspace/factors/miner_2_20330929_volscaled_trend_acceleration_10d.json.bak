{
  "factor_id": "miner_2_20330929_volscaled_trend_acceleration_10d",
  "factor_name": "Volatility-Scaled Trend Acceleration",
  "version": "1.0",
  "calculation": {
    "expression": "(close/close.shift(10) - 1 - (close/close.shift(10) - 1).shift(10)) / (rolling_std(pct_change(close), 30) * sqrt(252) + 1e-12)",
    "description": "Measures the acceleration of each instrument's 10-trading-day return relative to its preceding 10-trading-day return, normalized by 30-day annualized realized volatility. Positive values indicate strengthening upward trends; negative values indicate weakening or accelerating downward trends. All inputs are lagged or rolling using information available at the signal date."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "trend_window_days": 10,
    "acceleration_lag_days": 10,
    "volatility_window_days": 30,
    "annualization_factor": 252,
    "minimum_volatility_observations": 20,
    "forward_horizon_days": 10
  },
  "validation": {
