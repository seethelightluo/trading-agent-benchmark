{
  "factor_id": "miner_3_20330203_breadth_voladjusted_momentum_20d",
  "factor_name": "Extreme-breadth hysteresis volatility-adjusted momentum",
  "version": "1.0",
  "calculation": {
    "expression": "state(breadth_20d) * (return_20d / (std_daily_return_30d * sqrt(252)))",
    "description": "Compute each asset's 20-trading-day return divided by its trailing 30-day annualized realized volatility. Multiply the cross-sectional signal by a hysteresis regime state: +1 when at least 65% of assets have positive 20-day returns, -1 when at most 35% do, and otherwise retain the prior state. Higher values indicate preferred longs."
  },
  "dependencies": ["close"],
  "parameters": {
    "momentum_window": 20,
    "volatility_window": 30,
    "annualization": 252,
    "breadth_positive_activation": 0.65,
    "breadth_negative_activation": 0.35,
    "minimum_cross_section": 8,
    "universe_size": 15
  },
  "validation": {
