{
  "factor_id": "miner_1_downside_adjusted_momentum_10d",
  "factor_name": "Downside-volatility-adjusted medium momentum",
  "version": "1.0",
  "calculation": {
    "expression": "pct_change(close,60) / rolling_std(where(pct_change(close,1)<0,pct_change(close,1),0),60)",
    "description": "Ranks assets by 60-day price momentum scaled by their downside-only daily volatility over the same 60-day window. Higher values indicate stronger trend per unit of downside risk. Signal is computed using data available at the decision date and evaluated against subsequent returns."
  },
  "dependencies": ["close"],
  "parameters": {"momentum_window": 60, "downside_volatility_window": 60, "min_periods": 40, "forward_horizon_days": 10},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2031-04-30",
    "validated_at": "2031-05-01",
    "metrics": {
      "ic": 0.01325719,
      "icir": 1.97874,
      "horizon_days": 10,
      "valid_dates": 2162,
      "average_instruments": 14.327,
      "coverage": 0.95513,
      "turnover": 0.139823,
      "hit_ratio": 0.51434,
      "max_abs_library_correlation": null
    },
    "decay": {"5d_ic": 0.00711316, "10d_ic": 0.01325719, "20d_ic": 0.00516059},
    "regime_notes": "Positive 10-day IC in 2020-21, 2023-25, 2027-28 and 2031 YTD; negative in 2022, 2026, 2029-30. Strongest recent result is 2031 YTD, but cross-sectional uncertainty remains material with 15 assets and coverage varies because downside-volatility warmup is required."
  },
