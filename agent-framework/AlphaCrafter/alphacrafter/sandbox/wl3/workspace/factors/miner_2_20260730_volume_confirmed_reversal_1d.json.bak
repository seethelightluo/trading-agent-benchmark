{
  "factor_id": "miner_2_20260730_volume_confirmed_reversal_1d",
  "factor_name": "Volume-Confirmed One-Day Reversal",
  "version": "20260730",
  "calculation": {
    "expression": "-(close/lag(close,1)-1)/std(returns,20) * (1 + 0.35 * max(clip(volume/rolling_median(volume,20),0.5,3.0)-1,0))",
    "description": "Short-term volatility-scaled reversal, strengthened only when current volume exceeds its trailing 20-day median; volume boost is clipped for robustness."
  },
  "dependencies": [
    "close",
    "volume"
  ],
  "parameters": {
    "volatility_days": 20,
    "volume_median_days": 20,
    "volume_ratio_clip": [
      0.5,
      3.0
    ],
    "volume_boost": 0.35,
    "minimum_cross_section": 8
  },
