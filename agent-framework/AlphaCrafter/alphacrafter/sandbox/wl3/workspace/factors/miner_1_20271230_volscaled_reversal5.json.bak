{
  "factor_id": "miner_1_20271230_volscaled_reversal5",
  "factor_name": "Volatility-scaled 5-session cross-sectional reversal",
  "version": "1.0",
  "calculation": {
    "expression": "(-(close_t / close_{t-5} - 1) / rolling_std(pct_change(close), 20)).shift(1)",
    "description": "Ranks assets by their lagged five-session underperformance normalized by trailing 20-session realized daily volatility; higher values indicate stronger reversal candidates. The one-session lag prevents use of the decision day's close."
  },
  "dependencies": ["close"],
  "parameters": {"reversal_window": 5, "volatility_window": 20, "min_volatility_observations": 15, "lag": 1},
