{
  "factor_id": "miner_1_20330303_inverse_medium60_gap10",
  "factor_name": "Inverse Medium Trend 60d with 10d Gap",
  "version": "1.0",
  "calculation": {
    "expression": "rolling_mean_3(-(log(close[t-10]/close[t-70])-cross_sectional_median)/((rolling_std(log_return,20))*sqrt(20))).shift(1)",
    "description": "Fades each instrument's 60-session relative return measured through a 10-session exclusion gap, scales by 20-session realized volatility, smooths over three observations, and lags one day to prevent look-ahead. Higher values indicate stronger expected reversal."
  },
  "dependencies": ["close"],
  "parameters": {"trend_window": 60, "exclusion_gap": 10, "volatility_window": 20, "smoothing_window": 3, "forward_horizon": 10, "minimum_cross_section": 8},
