{
  "factor_id": "miner_1_20291213_smoothed_intraday_reversal_5d",
  "factor_name": "Three-session smoothed volatility-scaled intraday reversal",
  "version": "1.0",
  "calculation": {
    "expression": "CSdemean(-rolling_mean_3(log(close/open)/(rolling_std_20(log(close).diff())*sqrt(20))).shift(1))",
    "description": "For each asset, average the abnormal close-to-open displacement over the three most recent completed sessions, negate it for reversal, lag the result one session, and cross-sectionally median demean."
  },
  "dependencies": ["open", "close"],
  "parameters": {"intraday_window": 3, "volatility_window": 20, "volatility_annualization": "sqrt(20)", "signal_lag": 1, "forward_horizon": 5, "minimum_cross_section": 8},
