{
  "factor_id": "miner_1_20280504_trend_efficiency60",
  "factor_name": "60-session directional trend efficiency",
  "version": "1.0",
  "calculation": {
    "expression": "shift(rolling_sum(returns,60) / rolling_sum(abs(returns),60), 1)",
    "description": "Lagged net return divided by total absolute return path over 60 sessions; high values identify persistent directional trends rather than choppy advances."
  },
  "dependencies": ["close"],
  "parameters": {"lookback": 60, "min_periods": 45, "lag": 1, "forward_horizon_admission": 5},
