{
  "factor_id": "volatility_breadth_panic_reversal",
  "factor_name": "High-Volatility Broad-Selloff Panic Reversal",
  "version": "1.2",
  "calculation": {
    "expression": "-log_return_3d / realized_volatility_20d when positive_return_breadth_3d <= 0.25 and cross_asset_median_volatility_20d trailing_252d percentile >= 0.70, else 0",
