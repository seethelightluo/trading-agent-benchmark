  "parameters": {"return_window_days": 3, "volatility_window_days": 20, "percentile_window_days": 252, "breadth_threshold": 0.25, "volatility_percentile_threshold": 0.70, "forward_horizon_days": 10, "execution_lag_days": 1, "universe_size": 15},
