{
  "factor_id": "miner_2_20340915_downside_trend_reversal",
  "factor_name": "Downside-risk-adjusted medium-trend reversal",
  "version": "1.0",
  "calculation": {"expression": "-((close/lag(close,40)-1)/(sqrt(30)*downside_volatility_30))*(1+0.25*tanh(8*(close/lag(close,10)-1)))", "description": "Ranks assets contrarian to their 40-session trend after scaling by 30-session downside volatility; a smooth 10-session confirmation modulation limits extreme signals. Higher values indicate preferred reversal candidates."},
  "dependencies": ["close", "daily returns"],
  "parameters": {"trend_window": 40, "downside_vol_window": 30, "downside_min_periods": 15, "confirmation_window": 10, "confirmation_scale": 8.0, "confirmation_weight": 0.25, "forward_horizon": 10},
  "validation": {"status": "EFFECTIVE", "period": "2020-01-03 through 2034-08-22", "metrics": {"ic": 0.059514, "icir": 0.157010, "ic_hit_ratio": 0.5667, "valid_dates": 240, "average_instruments": 8.24, "coverage": 0.2113, "turnover": 0.1262, "decay": {"horizon": "10 trading days", "method": "Spearman cross-sectional IC"}, "max_abs_library_correlation": null}, "regime_notes": "Positive full-sample paper IC and ICIR. Effective cross-section averaged 8.24 instruments with at least 8 per date; uncertainty is therefore material and recent 120-session ICIR was only 0.0260."},
