{
  "factor_id": "miner_1_20320108_trend_persistence30",
  "factor_name": "30-day directional trend persistence",
  "version": "1.0",
  "calculation": {
    "expression": "cross_sectional_demean(2 * mean(close.diff() > 0, 30) - 1).shift(1)",
    "description": "For each tradable asset, measure the fraction of positive daily returns over the prior 30 observations, convert to a signed persistence score, demean across assets, and lag one day. Higher values indicate persistent upward trend."
  },
  "dependencies": ["close"],
  "parameters": {"lookback_days": 30, "forward_horizon_days": 10, "lag_days": 1, "min_periods": 20},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2032-01-08",
