{
  "factor_id": "miner_1_20280420_upday_dominance30",
  "factor_name": "30-session Up-Day Dominance",
  "version": "1.0",
  "calculation": {
    "expression": "shift_1((sum(max(return,0),30)-sum(-min(return,0),30))/(sum(abs(return),30)+1e-12))",
    "description": "Signed return imbalance over the prior 30 completed sessions; positive values indicate gain-led rather than loss-led price movement. Cross-sectional use is long-only and lagged to avoid look-ahead."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "window": 30,
    "min_periods": 24,
    "lag": 1,
    "forward_horizon_admission_days": 5
  },
