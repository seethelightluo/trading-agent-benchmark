{
  "factor_id": "miner_2_20310710_persistent_trend_volscaled",
  "factor_name": "Volatility-scaled consistent 10-day trend",
  "version": "1.0",
  "calculation": {
    "expression": "lag1((close.pct_change(10) * rolling_mean(return,10) / rolling_std(return,10)) / rolling_std(return,20))",
    "description": "Ranks assets by lagged ten-session momentum, strengthened when daily returns are directionally consistent and scaled by recent realized volatility. The one-session lag prevents use of the current completed session in the signal."
  },
  "dependencies": ["close"],
  "parameters": {"momentum_window": 10, "consistency_window": 10, "volatility_window": 20, "minimum_periods": {"consistency": 8, "volatility": 15}, "signal_lag": 1},
