  "factor_name": "Ranked volatility-scaled 10-day momentum",
  "version": "1.0",
  "calculation": {
    "expression": "rank_pct(cross_section(10d_pct_return / (20d_log_return_volatility * sqrt(252))))",
    "description": "Compute each tradable instrument's 10-trading-day percentage return divided by trailing 20-day annualized log-return volatility, convert to a cross-sectional percentile rank, smooth ranks over five observations, and lag one completed day. Higher values indicate stronger risk-adjusted relative momentum."
  },
  "dependencies": ["close"],
  "parameters": {"momentum_window": 10, "volatility_window": 20, "annualization": 252, "smoothing_window": 5, "lag": 1, "minimum_volatility_observations": 15},
