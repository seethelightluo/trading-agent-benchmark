  "factor_name": "Equal-Weighted Volatility-Scaled Cross-Asset Residual Momentum 20/40",
  "version": "1.0",
  "calculation": {
    "expression": "0.5*((log(close/close[-20])-cross_asset_mean)/sqrt(20)*sigma20) + 0.5*((log(close/close[-40])-cross_asset_mean)/sqrt(40)*sigma40), lagged 1 session",
