{
  "factor_id": "miner_1_20280113_mom60_vol20",
  "factor_name": "60-session risk-adjusted momentum",
  "version": "1.0",
  "calculation": {
    "expression": "((close / close.shift(60)) - 1) / rolling_std(pct_change(close), 20)",
    "description": "Cross-asset medium-term momentum normalized by trailing 20-session realized volatility and lagged one completed session to avoid look-ahead. Positive values indicate strong risk-adjusted trend."
  },
  "dependencies": ["close"],
  "parameters": {"momentum_window": 60, "volatility_window": 20, "volatility_min_periods": 15, "signal_lag": 1},
