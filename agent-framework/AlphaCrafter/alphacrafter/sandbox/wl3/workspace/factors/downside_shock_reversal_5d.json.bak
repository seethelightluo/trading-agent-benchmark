{
  "factor_id": "downside_shock_reversal_5d",
  "factor_name": "VIX-Gated Downside Shock Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-((sum(log_return,5) - cross_sectional_median(sum(log_return,5))) / downside_realized_volatility_20) * VIX_stress_gate, lagged_1",
    "description": "Ranks assets for reversal after a five-session relative downside shock, scaled by 20-session downside volatility. The signal is active when VIX exceeds its 60-session mean by 0.15 rolling standard deviations; all inputs are lagged one completed session."
  },
  "dependencies": ["close", "VIX"],
  "parameters": {"shock_window": 5, "downside_vol_window": 20, "vix_window": 60, "vix_threshold_std": 0.15, "lag": 1, "min_cross_section": 8},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2030-07-11",
    "last_validated": "2030-07-11T00:00:00Z",
    "metrics": {"horizon_days": 5, "ic": 0.033908, "icir": 0.103820, "observations": 1344, "average_instruments": 15.0, "coverage": 0.9935, "turnover": null, "hit_ratio": 0.5350, "max_abs_library_correlation": null},
    "regime_notes": "Positive IC in 2020-2022 (0.056533), 2023-2025 (0.047126), and 2026-2027 (0.036389); negative in 2028-2030 (-0.018060), so recent drift requires monitoring."
  },
  "signal_artifact": "scripts/miner_3_20300711_downshock_reversal_signal.csv",
  "tags": ["reversal", "downside-risk", "macro-regime", "cross-asset" ]
}