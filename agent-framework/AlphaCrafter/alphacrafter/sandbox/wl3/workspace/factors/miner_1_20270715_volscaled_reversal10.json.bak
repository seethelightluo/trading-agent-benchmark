{
  "factor_id": "miner_1_20270715_volscaled_reversal10",
  "factor_name": "Volatility-scaled 10-session cross-asset reversal",
  "version": "20270715",
  "calculation": {
    "expression": "clip((-pct_change(close,10)/(rolling_std(pct_change(close),20,min_periods=15)*sqrt(20))) - cross_sectional_median, -6, 6)",
    "description": "Ranks instruments positively after poor ten-session performance, scaling by recent 20-session realized volatility and demeaning by the daily cross-sectional median. Signals use only completed data through the prior date."
  },
  "dependencies": [
    "close",
    "date"
  ],
  "parameters": {
    "lookback_return_sessions": 10,
    "volatility_window_sessions": 20,
    "volatility_min_periods": 15,
    "winsor_clip": 6,
    "forward_admission_horizon_sessions": 1,
    "minimum_cross_section": 8
  },
