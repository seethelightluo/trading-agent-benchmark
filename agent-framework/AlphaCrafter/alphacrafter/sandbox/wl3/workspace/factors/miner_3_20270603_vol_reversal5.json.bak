{
  "factor_id": "miner_3_20270603_vol_reversal5",
  "factor_name": "Volatility-Scaled Five-Day Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "clip((-pct_change(close,5) / (rolling_std(pct_change(close,1),20)*sqrt(20))).cross_sectional_demean_by_median, -6, 6)",
    "description": "Fades the trailing five-session return, normalizes by 20-session annualized realized volatility, and subtracts the cross-sectional median each day to isolate relative reversal while limiting outliers. Computed using data available through the prior completed session."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "reversal_lookback_days": 5,
    "volatility_window_days": 20,
    "volatility_min_periods": 15,
    "clip_lower": -6,
    "clip_upper": 6,
    "cross_sectional_center": "median"
  },
