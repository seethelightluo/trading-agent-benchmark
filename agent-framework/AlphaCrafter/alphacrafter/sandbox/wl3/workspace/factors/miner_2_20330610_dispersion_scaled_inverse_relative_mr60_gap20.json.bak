{
  "factor_id": "miner_2_20330610_dispersion_scaled_inverse_relative_mr60_gap20",
  "factor_name": "Dispersion-scaled inverse relative momentum 60d, gap 20",
  "version": "1.0",
  "calculation": {
    "expression": "-((log(close_t/close_{t-60}) - cross_sectional_median(log(close_t/close_{t-60})))/(sqrt(40)*rolling_std(diff(log(close),40)))) shifted by 21 sessions",
    "description": "Fades each instrument's 60-session return relative to the cross-sectional median, normalizes by its 40-session realized volatility, and applies a 20-session information gap plus one-day execution lag to avoid short-horizon overlap and look-ahead. Higher values indicate stronger expected rebound."
  },
  "dependencies": ["close"],
  "parameters": {"formation_window": 60, "volatility_window": 40, "forward_horizon": 10, "information_gap": 20, "execution_lag": 1, "minimum_cross_section": 8},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 to 2033-06-09",
    "last_validated": "2033-06-10T00:00:00Z",
