{
  "factor_id": "miner_3_20260730_volume_confirmed_reversal_1d",
  "factor_name": "Volume-Confirmed Volatility-Scaled One-Day Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-r_t / std20(r) * (1 + 0.35 * max(clip(volume_t / median20(volume), 0.5, 3.0) - 1, 0))",
    "description": "Negates the latest daily return and scales it by 20-day realized volatility; unusually high volume amplifies the reversal signal, while volume at or below its trailing median receives no amplification.",
    "signal_artifact": "scripts/miner_3_20260730_volume_confirmed_reversal.py",
    "lookahead_policy": "At date t, uses OHLCV through t only; validation predicts close-to-close return from t to t+1. Online use must lag signal one completed trading day."
  },
  "dependencies": [
    "close",
    "volume",
    "daily_return",
    "20d_realized_volatility",
    "20d_volume_median"
  ],
  "parameters": {
    "volatility_window": 20,
    "volume_window": 20,
    "volume_clip": [
      0.5,
      3.0
    ],
    "high_volume_amplification": 0.35,
    "forward_horizon_days": 1,
    "cross_section": "all 15 tradable watchlist assets"
  },
  "validation": {
    "status": "EFFECTIVE",
