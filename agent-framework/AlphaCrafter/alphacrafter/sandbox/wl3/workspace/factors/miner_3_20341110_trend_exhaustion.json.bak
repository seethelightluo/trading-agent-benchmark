{
  "factor_id": "miner_3_20341110_trend_exhaustion",
  "factor_name": "Risk-Normalized Trend Exhaustion",
  "version": "1.0",
  "calculation": {
    "expression": "lag1(0.7 * pct_change(close,20) / rolling_std(pct_change(close,1),20) - 0.3 * pct_change(close,5) / rolling_std(pct_change(close,1),20))",
    "description": "Ranks assets by a medium-term risk-normalized trend while favoring assets experiencing a short-term pullback; all inputs are lagged one completed session before forward-return testing."
  },
  "dependencies": ["close"],
  "parameters": {"medium_window": 20, "short_window": 5, "vol_window": 20, "medium_weight": 0.7, "pullback_weight": 0.3, "lag": 1},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2034-11-10",
    "metrics": {
      "horizon_sessions": 3,
      "ic": 0.0070244061,
      "icir": 1.1255045,
      "hit_ratio": 0.50674295,
      "dates": 2447,
      "average_valid_instruments": 13.00245,
      "coverage": 0.5028281,
      "turnover": 0.05773225,
      "max_abs_library_correlation": null,
      "admission_thresholds": {"absolute_ic": 0.007, "absolute_icir": 0.084}
    },
    "regime_notes": "Full history across the 15-instrument synthetic cross-asset universe. The 3-session horizon passed the benchmark gate. Ten-session IC was approximately 0.00025 with ICIR 0.038, and 20-session performance was negative; therefore this is a short-horizon complementary signal rather than a slow trend factor.",
    "signal_artifact": "scripts/miner_3_20341110_trend_exhaustion_signal.csv"
  },
  "tags": ["momentum", "reversal", "volatility_scaled", "cross_asset"],
  "last_validated": "2034-11-10T00:00:00Z"
}
