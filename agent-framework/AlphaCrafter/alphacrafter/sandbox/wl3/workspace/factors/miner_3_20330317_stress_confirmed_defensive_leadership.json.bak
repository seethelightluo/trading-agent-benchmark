{
  "factor_id": "miner_3_20330317_stress_confirmed_defensive_leadership",
  "factor_name": "Stress-confirmed defensive leadership",
  "version": "1.0",
  "calculation": {
    "expression": "mean_3((log(close/close[-20]) - mean_equity_log_return_20) * I(mean_equity_log_return_20 < 0 AND mean_equity_log_return_5 < 0 AND equity_negative_breadth_20 >= 0.5)).shift(1)",
    "description": "Cross-asset 20-day return relative to the eight-instrument equity basket, activated only when equity returns are negative, five-day equity returns confirm weakness, and at least half of equities have negative 20-day returns; three-observation smoothing and one-day lag prevent look-ahead."
  },
  "dependencies": ["close"],
  "parameters": {"equity_assets": ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX"], "relative_window": 20, "confirmation_window": 5, "breadth_threshold": 0.5, "smoothing": 3, "lag": 1, "forward_horizon": 10},
