{
  "factor_id": "miner_3_20260730_total_overnight_intraday_reversal",
  "factor_name": "Volatility-Scaled Total Overnight and Intraday Reversal",
  "version": "20260730",
  "calculation": {
    "expression": "-(open_t / close_{t-1} - 1) / vol20_t - (close_t / open_t - 1) / vol20_t",
    "description": "Adds the reversal of the overnight gap and the completed intraday return, scaling the combined shock by trailing 20-session close-to-close volatility. Values are computed using data through the completed session only."
  },
  "dependencies": [
    "open",
    "close"
  ],
  "parameters": {
    "volatility_window": 20,
    "forward_horizon_days": 1,
    "minimum_volatility_observations": 10
  },
