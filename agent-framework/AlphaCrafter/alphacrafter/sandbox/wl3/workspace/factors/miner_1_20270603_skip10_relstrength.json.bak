{
  "factor_id": "miner_1_20270603_skip10_relstrength",
  "factor_name": "60-session volatility-scaled relative strength with 10-session skip",
  "version": "2027.06.03",
  "calculation": {
    "expression": "clip((close[t-10]/close[t-70]-1)/(std(returns[t-59:t])*sqrt(60)), -8, 8)",
    "description": "Ranks instruments by medium-horizon return measured from t-70 to t-10, normalized by trailing 60-session realized volatility. The ten-session skip reduces short-term reversal contamination and uses only completed observations at t."
  },
  "dependencies": ["close", "daily returns"],
  "parameters": {"lookback_sessions": 60, "skip_sessions": 10, "volatility_window": 60, "min_volatility_observations": 40, "clip_lower": -8, "clip_upper": 8},
