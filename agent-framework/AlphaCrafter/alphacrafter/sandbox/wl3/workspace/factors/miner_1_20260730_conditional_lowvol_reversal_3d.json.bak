  "factor_name": "Conditional Low-Volatility 3-Day Reversal",
  "version": "20260730_v1",
  "calculation": {
    "expression": "-return_3d when volatility_20d <= cross_sectional_median(volatility_20d), otherwise null",
    "description": "Ranks the three-trading-day reversal only among assets whose trailing 20-day return volatility is at or below the daily cross-sectional median. The signal is observable through the prior completed session and is intended for cross-sectional portfolio ranking."
