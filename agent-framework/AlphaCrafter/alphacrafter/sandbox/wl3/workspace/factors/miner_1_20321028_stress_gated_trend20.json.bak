{
  "factor_id": "miner_1_20321028_stress_gated_trend20",
  "factor_name": "VIX-DXY stress-gated risk-adjusted 20-day trend",
  "version": "1.0",
  "calculation": {
    "expression": "shift1(rolling_mean3((log(close/close[-20]) / (std(pct_change(close),30) * (1 - 0.55*I[VIX_5d_change>0 and DXY_5d_change>0])))))",
    "description": "Twenty-day log momentum divided by 30-day daily-return volatility, attenuated by 55% when both VIX and DXY have risen over five days, smoothed over three observations and lagged one completed day to avoid look-ahead."
  },
  "dependencies": ["close", "VIX.close", "DXY.close"],
  "parameters": {"momentum_window": 20, "volatility_window": 30, "volatility_min_periods": 20, "stress_window": 5, "stress_attenuation": 0.55, "smoothing_window": 3, "lag": 1, "forward_horizon": 10},
