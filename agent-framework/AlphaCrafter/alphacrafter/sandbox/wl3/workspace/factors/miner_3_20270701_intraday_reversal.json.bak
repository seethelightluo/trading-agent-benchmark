{
  "factor_id": "miner_3_20270701_intraday_reversal",
  "factor_name": "Volatility-Scaled Prior Intraday Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "clip(-(close_t/open_t-1)/(std(pct_change(close),30)+1e-12) - CS_median(signal), -6, 6)",
    "description": "At each completed session, reverse the same session open-to-close return and scale it by trailing 30-session close-to-close volatility. Cross-sectionally demean by the daily median and clip extremes. The signal predicts the next completed-session return and uses no future data."
  },
  "dependencies": [
    "open",
    "close"
  ],
  "parameters": {
    "volatility_window": 30,
    "volatility_min_periods": 20,
    "winsor_clip": 6,
    "cross_section_center": "median",
    "forward_horizon_sessions": 1,
    "minimum_cross_section": 8
  },
  "validation": {
