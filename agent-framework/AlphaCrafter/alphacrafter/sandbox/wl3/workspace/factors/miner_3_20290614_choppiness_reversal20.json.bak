{
  "factor_id": "miner_3_20290614_choppiness_reversal20",
  "factor_name": "Twenty-Day Path Choppiness Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-sum(log_return,20) / sum(abs(log_return),20)",
    "description": "Negative signed net log return divided by the total absolute log-return path over the prior 20 completed sessions. Higher values favor assets with choppy or recently reversing paths and lower values favor persistent directional movement. Computed cross-sectionally using only data available through date t."
  },
  "dependencies": ["close"],
  "parameters": {"lookback_days": 20, "min_periods": 18, "forward_horizons": [5, 10, 20], "minimum_cross_section": 8},
