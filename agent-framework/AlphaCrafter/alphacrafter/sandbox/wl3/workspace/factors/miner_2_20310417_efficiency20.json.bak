{
  "factor_id": "miner_2_20310417_efficiency20",
  "factor_name": "Volatility-adjusted return efficiency 20-day",
  "version": "1.0",
  "calculation": {
    "expression": "((close/close.shift(20)-1) / rolling_sum(abs(pct_change),20)) / (rolling_std(pct_change,40)*sqrt(20))",
    "description": "Ranks assets by 20-session return efficiency per unit of absolute-return activity, normalized by 40-session realized volatility. Higher values predict higher subsequent 20-session returns. All inputs are lagged at decision time.",
    "signal_artifact": "scripts/miner_2_20310417_efficiency20_signal.csv"
  },
  "dependencies": ["close", "pct_change"],
  "parameters": {"return_window": 20, "activity_window": 20, "volatility_window": 40, "forward_horizon": 20, "minimum_cross_section": 8},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-02 through 2031-04-16",
    "last_validated": "2031-04-17",
    "metrics": {
      "ic": 0.02370013,
      "icir": 0.08721542,
