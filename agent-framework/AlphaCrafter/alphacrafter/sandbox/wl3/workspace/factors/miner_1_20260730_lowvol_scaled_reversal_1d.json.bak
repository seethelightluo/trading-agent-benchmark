  "factor_name": "Low-Volatility-Scaled One-Day Reversal",
  "version": "20260730_v1",
  "calculation": {
    "expression": "-daily_return * rolling_std(daily_return,60) / rolling_std(daily_return,20)",
    "description": "One-day contrarian return scaled by the ratio of long-horizon to short-horizon volatility. A negative recent return receives greater reversal score when short-term volatility is subdued relative to its 60-day baseline."
