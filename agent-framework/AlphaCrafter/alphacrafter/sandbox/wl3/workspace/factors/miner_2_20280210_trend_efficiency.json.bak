{
  "factor_id": "miner_2_20280210_trend_efficiency",
  "factor_name": "20-day Signed Trend Efficiency",
  "version": "2028-02-10",
  "calculation": {
    "expression": "shift(rolling_sum(pct_change(close),20) / rolling_sum(abs(pct_change(close)),20), 1)",
    "description": "Lagged signed net return divided by total absolute daily path length; positive values indicate persistent upward trends and negative values persistent downward trends. Cross-sectional ranks are intended for medium-horizon allocation."
  },
  "dependencies": ["close"],
  "parameters": {"lookback_days": 20, "lag_days": 1, "minimum_observations": 15},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2028-02-09",
    "last_validated": "2028-02-10T00:00:00Z",
    "metrics": {
      "horizon_days": 5,
      "ic": 0.0163315,
      "icir": 2.7126,
      "ic_hit_ratio": 0.5270,
      "observations_dates": 2776,
      "average_instruments_per_date": 14.31,
      "universe_instruments": 15,
      "coverage": 0.9475,
      "turnover": 0.0813,
      "max_abs_library_correlation": 1.0
    },
    "decay": {"1d_ic": -0.0064242, "3d_ic": 0.0050379, "5d_ic": 0.0163315, "10d_ic": 0.0358079},
    "regime_notes": "Positive and strengthening at 5-10 session horizons over the full synthetic history; one-session effect is negative. Interpret conservatively given 15-name cross-section and exact overlap with an earlier trend-efficiency signal artifact.",
    "signal_artifact": "scripts/miner_2_20280210_trend_efficiency_signal.csv"
  },
  "tags": ["trend", "momentum", "path_efficiency", "cross_asset"]
}
