  "factor_name": "Cross-Asset Residual Momentum 20D",
  "version": "1.0",
  "calculation": {
    "expression": "(close_t/close_{t-20}-1 - cross_sectional_median_i(close_t/close_{t-20}-1)) lagged by 1 session",
    "description": "Ranks each tradable asset by its 20-session return in excess of the contemporaneous universe median, using only the prior completed session. Positive values indicate relative strength; the signal is designed for the 10-session portfolio horizon."
