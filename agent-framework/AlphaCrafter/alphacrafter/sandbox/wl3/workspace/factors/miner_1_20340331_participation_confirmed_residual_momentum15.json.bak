{
  "factor_id": "miner_1_20340331_participation_confirmed_residual_momentum15",
  "factor_name": "Participation-Confirmed Residual Momentum 15",
  "version": "1.0",
  "calculation": {
    "expression": "shift1(sum_15(log_return - cross_sectional_mean(log_return)) * clip(1 + 0.35*mean_10(log(volume / median_60(volume))), 0.6, 1.4))",
    "description": "Fifteen-session cross-asset residual momentum scaled by lagged relative-volume participation confirmation. The complete signal is shifted one session to prevent look-ahead bias."
  },
  "dependencies": ["close", "volume"],
  "parameters": {"momentum_window": 15, "volume_median_window": 60, "confirmation_window": 10, "confirmation_scale": 0.35, "multiplier_floor": 0.6, "multiplier_cap": 1.4, "lag": 1},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01/2034-03-31",
    "last_validated": "2034-03-31",
    "metrics": {
