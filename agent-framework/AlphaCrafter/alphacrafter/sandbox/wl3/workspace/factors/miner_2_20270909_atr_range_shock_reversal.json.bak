{
  "factor_id": "miner_2_20270909_atr_range_shock_reversal",
  "factor_name": "ATR-Normalized Range Shock Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "clip(-sum(return,3) * true_range / rolling_median(true_range,30), -6, 6), then cross-sectional median demean",
    "description": "Fade the completed three-session return when the completed-session true range is unusually large relative to its 30-session median true range. True range uses high-low and gaps versus the prior close. The signal is calculated using data through the signal date and predicts subsequent returns."
  },
  "dependencies": ["close", "high", "low"],
  "parameters": {"return_window": 3, "range_baseline_window": 30, "baseline": "median", "min_baseline_periods": 20, "clip": [-6, 6], "cross_sectional_demean": "median"},
  "validation": {
