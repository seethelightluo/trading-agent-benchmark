  "factor_name": "Volatility-Normalized Return Acceleration",
  "version": "1.0",
  "calculation": {
    "expression": "((close/close.shift(20)-1) - (close.shift(20)/close.shift(60)-1)) / rolling_std(pct_change(close),30)",
