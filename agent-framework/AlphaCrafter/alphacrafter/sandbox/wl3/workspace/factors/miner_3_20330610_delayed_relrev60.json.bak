{
  "factor_id": "miner_3_20330610_delayed_relrev60",
  "factor_name": "Delayed Volatility-Scaled Relative Reversal 60d",
  "version": "1.0",
  "calculation": {
    "expression": "-((log(close_t/log(close_t-60)) - cross_sectional_median) / (rolling_std(diff(log(close),40)*sqrt(40)))) shifted 21 sessions",
    "description": "Ranks assets for reversal of their 60-session relative performance after a 20-session gap, normalized by 40-session realized volatility; signal is lagged one further session to ensure no look-ahead."
  },
  "dependencies": ["close"],
  "parameters": {"lookback_sessions": 60, "volatility_window": 40, "volatility_min_periods": 30, "information_gap_sessions": 20, "execution_lag_sessions": 1, "forward_horizon_sessions": 10, "minimum_cross_section": 8},
