{
  "factor_id": "miner_1_20351109_downside_efficiency_momentum20",
  "factor_name": "Downside-path efficiency adjusted 20-day momentum",
  "version": "1.0",
  "calculation": {
    "expression": "lag(return(close,20)) / (lag(rolling_sum(abs(min(return(close,1),0)),40),1) + 1e-12)",
    "description": "Ranks assets by their lagged 20-session return normalized by the preceding 40-session cumulative downside path. Higher values indicate positive momentum achieved with less downside movement. All inputs are lagged before portfolio use."
  },
  "dependencies": ["close"],
  "parameters": {"momentum_window": 20, "downside_path_window": 40, "forward_horizon": 10, "minimum_history": 20},
  "validation": {
