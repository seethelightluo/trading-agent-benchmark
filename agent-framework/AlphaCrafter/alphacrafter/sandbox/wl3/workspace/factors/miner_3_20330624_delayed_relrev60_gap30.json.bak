  "factor_name": "Delayed Volatility-Scaled Relative Reversal 60d Gap30",
  "version": "1.0",
  "calculation": {
    "expression": "-((log(close_t)-log(close_{t-60})) - cross_sectional_median(log(close_t)-log(close_{t-60})))/(sqrt(40)*std(log_returns,40)) shifted 31 sessions",
