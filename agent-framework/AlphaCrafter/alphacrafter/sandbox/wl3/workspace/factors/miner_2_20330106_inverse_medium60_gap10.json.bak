{
  "factor_id": "miner_2_20330106_inverse_medium60_gap10",
  "factor_name": "Inverse medium trend with 10-session exclusion gap",
  "version": "1.0",
  "calculation": {
    "expression": "mean3( -(log(close[t-10]/close[t-70]) - cross_sectional_median_t) / (rolling_std_20(log_returns)*sqrt(20)) ).shift(1)",
    "description": "Fade the 60-session cross-asset relative return measured through t-10, risk-normalize by 20-session realized volatility, smooth over three sessions, and lag one session to prevent look-ahead."
