  "factor_name": "Volatility-Normalized Momentum with Medium-Term Trend Confirmation",
  "version": "1.0",
  "calculation": {
    "expression": "shift1(rolling_mean_5((log(close/close[-20]) / (std(log_returns,20)*sqrt(252))) * sign(log(close/close[-60]))))",
    "description": "Compute 20-day log momentum, scale by annualized 20-day realized volatility, confirm direction with the sign of 60-day momentum, smooth five sessions, and lag one session. Higher values predict higher subsequent 10-day returns."
