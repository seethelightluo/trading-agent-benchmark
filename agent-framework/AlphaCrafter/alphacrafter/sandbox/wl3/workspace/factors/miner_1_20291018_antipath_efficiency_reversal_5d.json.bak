{
  "factor_id": "miner_1_20291018_antipath_efficiency_reversal_5d",
  "factor_name": "Anti-Path-Efficiency Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-lag1(log(close/close[-20]) / sum(abs(log(close/close[-1])),20))",
    "description": "Ranks assets for reversal toward low path-efficiency trends: a negative lagged 20-session net move divided by cumulative absolute daily movement. Cross-sectionally median demeaned before evaluation. The one-session lag prevents look-ahead."
  },
  "dependencies": ["close"],
  "parameters": {"lookback": 20, "lag": 1, "forward_horizon": 5, "minimum_cross_section": 8},
  "validation": {
