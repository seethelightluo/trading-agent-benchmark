{
  "factor_id": "miner_1_20270826_intraday_norm_reversal",
  "factor_name": "ATR-normalized intraday reversal with short-trend conditioning",
  "version": "20270826",
  "calculation": {
    "expression": "demean_cs(clip(-(close/open-1)/ATR14 * (1 + 0.25*tanh(-(close/close_lag5-1)/0.05)), -6, 6))",
    "description": "Ranks instruments for next-day reversal using the normalized same-session open-to-close move, amplified modestly when the preceding five-session trend points in the same reversal direction. Cross-sectional median demeaning and clipping stabilize the signal. All inputs are lagged or completed-day OHLC data."
  },
  "dependencies": [
    "open",
    "close",
    "high",
    "low"
  ],
  "parameters": {
    "atr_window": 14,
    "atr_min_periods": 10,
    "trend_window": 5,
    "trend_scale": 0.05,
    "amplification": 0.25,
    "clip": [
      -6,
      6
    ]
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2027-08-25",
