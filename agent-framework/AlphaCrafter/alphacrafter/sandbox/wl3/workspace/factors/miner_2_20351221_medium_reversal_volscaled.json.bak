  "factor_name": "Volatility-scaled medium-horizon reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-pct_change(close, 60) / rolling_std(pct_change(close), 20)",
    "description": "Ranks assets favoring reversal of their 60-session return, with the reversal magnitude normalized by each asset's trailing 20-session realized volatility. Signal is lagged one completed session before use. Higher values predict higher subsequent returns."
