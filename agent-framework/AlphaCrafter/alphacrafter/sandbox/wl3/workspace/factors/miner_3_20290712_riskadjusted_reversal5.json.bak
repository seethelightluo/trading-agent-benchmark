  "factor_name": "Risk-Adjusted Five-Day Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-rolling_sum(log(close/close.shift(1)),5) / rolling_std(log(close/close.shift(1)),20), all shifted one completed session; cross-sectional median demean",
    "description": "Ranks assets for short-horizon reversal after scaling the prior five-day return by its trailing 20-day daily-return volatility. The one-session lag prevents use of the current incomplete observation. Cross-sectional median demeaning stabilizes scale without changing rank IC."
  },
  "dependencies": ["close"],
