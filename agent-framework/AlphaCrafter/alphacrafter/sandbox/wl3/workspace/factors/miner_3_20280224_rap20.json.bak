{
  "factor_id": "miner_3_20280224_rap20",
  "factor_name": "Risk-adjusted 20-session momentum",
  "version": "1.0",
  "calculation": {
    "expression": "pct_change(close,20) / (rolling_std(pct_change(close),30) * sqrt(252))",
    "description": "Twenty-session price momentum scaled by trailing 30-session annualized realized volatility. Signal is shifted by one completed session before forward-return evaluation to avoid look-ahead bias."
  },
  "dependencies": ["close", "date"],
  "parameters": {"momentum_window": 20, "volatility_window": 30, "volatility_min_periods": 20, "annualization": 252, "signal_lag_sessions": 1, "admission_horizon_sessions": 5},
