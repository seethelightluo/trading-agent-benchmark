{
  "factor_id": "miner_1_20330708_trend_accel20_60_gap5",
  "factor_name": "Volatility-Scaled Trend Acceleration (20d vs 60d, 5d Gap)",
  "version": "1.0",
  "calculation": {
    "expression": "((log(close_t)-log(close_{t-20})) - (log(close_t)-log(close_{t-60}))/3) / (std(log_return_{t-19:t})*sqrt(252)), shifted by 5 sessions",
    "description": "Ranks instruments by recent 20-session trend acceleration relative to one-third of the 60-session trend, normalized by trailing 20-session realized volatility. The five-session lag ensures the signal uses only completed information before the forward 10-session return."
  },
  "dependencies": ["close"],
  "parameters": {
    "short_window_sessions": 20,
    "long_window_sessions": 60,
    "long_trend_scaler": 3,
    "volatility_window_sessions": 20,
    "annualization": 252,
    "information_gap_sessions": 5,
    "forward_horizon_sessions": 10,
    "minimum_cross_section": 8
  },
