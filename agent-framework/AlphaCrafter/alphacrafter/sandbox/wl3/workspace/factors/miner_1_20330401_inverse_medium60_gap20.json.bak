{
  "factor_id": "inverse_medium60_gap20",
  "factor_name": "Inverse Medium Trend 60d with 20d Gap",
  "version": "20330401",
  "calculation": {
    "expression": "mean_3( -(log(close[t-20]/close[t-80]) - cross_sectional_median) / (std(log_returns,20)*sqrt(20)) ).lag(1)",
    "description": "Fades each asset's 60-session relative return measured through a 20-session information gap, scales by 20-session realized volatility, smooths three observations, and lags one session to avoid look-ahead. Positive values indicate stronger expected 10-session forward returns under the validated reversal relationship."
  },
  "dependencies": ["close"],
  "parameters": {
    "trend_window_sessions": 60,
    "exclusion_gap_sessions": 20,
    "volatility_window_sessions": 20,
    "volatility_min_periods": 15,
    "smoothing_observations": 3,
    "signal_lag_sessions": 1,
