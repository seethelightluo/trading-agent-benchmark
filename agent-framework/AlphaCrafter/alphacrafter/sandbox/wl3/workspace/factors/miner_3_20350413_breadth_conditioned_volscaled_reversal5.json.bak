{
  "factor_id": "miner_3_20350413_breadth_conditioned_volscaled_reversal5",
  "factor_name": "Downside-Breadth Conditioned Volatility-Scaled Five-Day Reversal",
  "version": "20350413",
  "calculation": {
    "expression": "-rolling_sum(pct_change(close),5) / (rolling_std(pct_change(close),20)*sqrt(20)+epsilon) * clip(1 + 0.40*zscore(cross_sectional_downside_breadth,120),0.45,1.55), lagged one completed session",
    "description": "Fades each asset's five-session move after volatility scaling. The reversal is amplified when an unusually broad share of the 15 tradable assets declined on the signal date, using only completed daily observations. Cross-sectional breadth is bounded to avoid extreme conditioning."
  },
  "dependencies": ["close", "daily_returns", "cross_asset_downside_breadth"],
  "parameters": {
    "reversal_window": 5,
    "volatility_window": 20,
    "breadth_baseline_window": 120,
    "breadth_z_clip": [-2, 2],
    "conditioning_strength": 0.40,
    "multiplier_clip": [0.45, 1.55],
    "signal_lag_sessions": 1,
    "minimum_cross_section": 8,
    "universe_size": 15
  },
