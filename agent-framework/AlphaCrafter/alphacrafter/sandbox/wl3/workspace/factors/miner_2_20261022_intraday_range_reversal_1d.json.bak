{
  "factor_id": "miner_2_20261022_intraday_range_reversal_1d",
  "factor_name": "Volatility-scaled intraday range reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(close/open - 1) / rolling_mean((high-low)/close, 20)",
    "description": "Ranks assets positively when their completed-session close-to-open return is negative, with the reversal signal normalized by the trailing 20-day mean intraday range. All inputs are available by the prior completed session."
  },
  "dependencies": ["open", "close", "high", "low"],
  "parameters": {"range_window": 20, "min_periods": 15, "horizon_days": 1},
