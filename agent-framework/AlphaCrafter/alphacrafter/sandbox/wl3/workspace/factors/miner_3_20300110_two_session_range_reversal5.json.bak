{
  "factor_id": "miner_3_20300110_two_session_range_reversal5",
  "factor_name": "Two-Session Range Expansion Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "shift1(-(rolling_sum(log_return,2))*abs(rolling_sum(log_return,2))/(rolling_std(log_return,20)*sqrt(2)) * clip(rolling_mean(log(high/low),2)/(rolling_std(log_return,20)),0,3)); cross-sectional median demean",
    "description": "Contrarian two-session shock signal amplified by the average two-session intraday range relative to 20-session annualized realized volatility. Signal is lagged one completed session to prevent lookahead."
  },
  "dependencies": ["close", "high", "low"],
  "parameters": {"shock_window": 2, "volatility_window": 20, "range_window": 2, "range_clip": [0, 3], "lag": 1, "validation_horizon_days": 5},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2030-01-09",
    "metrics": {
