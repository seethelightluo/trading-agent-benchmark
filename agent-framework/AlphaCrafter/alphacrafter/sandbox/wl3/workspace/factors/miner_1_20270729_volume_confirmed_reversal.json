{
  "factor_id": "miner_1_20270729_volume_confirmed_reversal",
  "factor_name": "Volume-confirmed 10-session cross-asset reversal",
  "version": "20270729",
  "calculation": {
    "expression": "clip((-pct_change(close,10) * (1 + 0.25*tanh(volume_zscore_60/2))) - cross_sectional_median, -6, 6)",
    "description": "Ranks instruments positively after poor ten-session performance, modestly amplifying reversal signals when contemporaneous volume is unusually high. Volume z-score uses a trailing 60-session window and all inputs are known at signal time. Cross-sectional median demeaning and clipping limit outliers."
  },
  "dependencies": [
    "close",
    "volume",
    "date"
  ],
  "parameters": {
    "return_lookback_sessions": 10,
    "volume_window_sessions": 60,
    "volume_min_periods": 30,
    "volume_amplification": 0.25,
    "volume_tanh_scale": 2.0,
    "winsor_clip": 6,
    "forward_admission_horizon_sessions": 1,
    "minimum_cross_section": 8
  },
