{
  "factor_id": "miner_3_20350202_downside_reversal60",
  "factor_name": "Downside-Deviation-Normalized 60-Day Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(sum(pct_change(close),60) / (rolling_std(clip(pct_change(close), upper=0),40) * sqrt(40) + 1e-12))",
    "description": "Fades the trailing 60-session return, scaling by trailing downside deviation rather than total volatility. Higher values favor assets with poor medium-term performance relative to their downside-risk budget. Signal uses only completed daily observations and is evaluated cross-sectionally.",
    "signal_artifact": "scripts/miner_3_20350202_downside_reversal_signal.csv"
  },
  "dependencies": ["close", "date", "watch_list"],
  "parameters": {
    "return_lookback": 60,
    "downside_volatility_window": 40,
    "forward_horizon_sessions": 10,
    "minimum_cross_section": 8,
    "lag": 1
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2035-02-01",
    "data_cutoff": "2035-02-01",
