{
  "factor_id": "miner_1_20320527_dxy_conditioned_momentum20",
  "factor_name": "DXY-Trend-Conditioned Cross-Asset Momentum",
  "version": "20320527",
  "calculation": {
    "expression": "shift1(rolling_mean5((log(close_t/close_t-20)) * (1 + percentile_rank(-log(DXY_t/DXY_t-20))), min_periods=5))",
    "description": "Compute each tradable asset's trailing 20-session log momentum, multiply the cross-section by a scalar determined by the inverse 20-session DXY trend percentile, smooth five sessions, and lag one completed session. DXY is observation-only and never tradable. Higher values indicate momentum favored when dollar trend is weaker."
  },
  "dependencies": ["close", "DXY close"],
  "parameters": {"asset_momentum_sessions": 20, "dxy_trend_sessions": 20, "smoothing_sessions": 5, "lag_sessions": 1, "forward_horizon_sessions": 10, "minimum_cross_section": 8},
  "signal_artifact": "scripts/miner_1_20320527_dxy_conditioned_momentum20_signal.csv",
