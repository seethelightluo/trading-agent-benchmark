{
  "factor_id": "miner_3_20300404_residual_blend5",
  "factor_name": "Smoothed Cross-Asset Residual Reversal 5D",
  "version": "1.0",
  "calculation": {
    "expression": "-shift1(0.75*(ret_5 - cross_sectional_median(ret_5))/vol_60 + 0.25*shift1((ret_5-cross_sectional_median(ret_5))/vol_60))",
    "description": "At each date, reverse the five-session return residual relative to the cross-asset median, scale by 60-session daily realized volatility, blend 75% current residual with 25% prior residual, and lag the complete signal one trading day to prevent look-ahead. Higher values indicate stronger expected five-session relative return."
  },
  "dependencies": ["close"],
  "parameters": {"return_lookback": 5, "volatility_lookback": 60, "blend_current": 0.75, "blend_lagged": 0.25, "signal_lag": 1, "minimum_cross_section": 8},
