{
  "factor_id": "miner_2_20320610_volnorm_beta_asym",
  "factor_name": "Volatility-normalized upside-minus-downside beta asymmetry",
  "version": "1.0",
  "calculation": {
    "expression": "shift1((beta_up_60 - beta_down_60) / annualized_volatility_60)",
    "description": "For each tradable asset, estimate rolling 60-day beta to the equal-weighted 15-asset market separately on market-up and market-down days, take upside beta minus downside beta, normalize by the asset's trailing 60-day annualized volatility, and lag one completed day to prevent lookahead."
  },
  "dependencies": ["close", "daily_returns"],
  "parameters": {"market": "equal_weight_mean_return_15_assets", "window": 60, "min_periods": 20, "forward_horizon_days": 10, "vol_annualization": 252, "lag_days": 1, "minimum_cross_section": 8},
