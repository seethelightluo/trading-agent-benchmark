{
  "factor_id": "miner_2_vix_regime_residual_trend20",
  "factor_name": "VIX-regime residual trend 20d",
  "version": "2034-04-14",
  "calculation": {
    "expression": "rank_cs(shift1(sum_20(log_return_i - cross_sectional_mean_log_return) * regime_multiplier)) - 0.5",
    "description": "Compute 20-session cumulative residual log return, multiply by 1 in normal VIX conditions and -0.5 when lagged VIX z-score exceeds 1, cross-sectionally percentile-rank, then lag one session to avoid look-ahead."
  },
  "dependencies": ["close", "VIX.close"],
  "parameters": {"trend_window": 20, "trend_min_periods": 15, "vix_window": 120, "vix_min_periods": 60, "stress_z_threshold": 1.0, "stress_multiplier": -0.5, "forward_horizon_sessions": 10, "universe_size": 15},
