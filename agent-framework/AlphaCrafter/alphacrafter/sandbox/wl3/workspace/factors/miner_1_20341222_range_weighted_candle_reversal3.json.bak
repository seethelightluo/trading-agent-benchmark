{
  "factor_id": "miner_1_20341222_range_weighted_candle_reversal3",
  "factor_name": "Range-weighted lagged three-day candle-pressure reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-shift(rolling_mean_3(((close-open)/(high-low))*clip(((high-low)/close)/rolling_median_20((high-low)/close),0,3)),1)",
    "description": "Fade the lagged three-day mean signed candle pressure, weighting candles by their range relative to the instrument's trailing 20-session median range and clipping the weight at 3. Zero-range observations are invalid."
  },
  "dependencies": ["open", "high", "low", "close"],
  "parameters": {"pressure_window": 3, "range_baseline_window": 20, "range_weight_clip": [0, 3], "lag": 1, "forward_horizon_days": 5},
  "validation": {
