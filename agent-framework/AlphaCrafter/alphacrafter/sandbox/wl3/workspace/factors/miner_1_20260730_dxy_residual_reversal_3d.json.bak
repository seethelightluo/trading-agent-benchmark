{
  "factor_id": "miner_1_20260730_dxy_residual_reversal_3d",
  "factor_name": "DXY-beta residual 3-day volatility-scaled reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-sum_{i=0..2}(r_asset,t-i - beta_60,t-i*r_DXY,t-i) / (sqrt(3)*std_20(residual))",
    "description": "For each tradable asset, estimate a trailing 60-observation beta to observation-only DXY, form daily return residuals, and take the negative trailing 3-day residual return scaled by trailing 20-day residual volatility. Higher values indicate stronger residual underperformance and expected reversal."
  },
  "dependencies": [
    "close",
    "DXY close"
  ],
  "parameters": {
    "beta_window": 60,
    "beta_min_periods": 30,
    "signal_window": 3,
    "vol_window": 20,
    "vol_min_periods": 15,
