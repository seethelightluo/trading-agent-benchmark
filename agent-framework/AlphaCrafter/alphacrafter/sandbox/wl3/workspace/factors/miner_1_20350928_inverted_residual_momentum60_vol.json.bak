{
  "factor_id": "miner_1_20350928_inverted_residual_momentum60_vol",
  "factor_name": "Inverted 60-session residual momentum, volatility normalized",
  "version": "1.0",
  "calculation": {
    "expression": "-(return(close,60) - cross_sectional_median(return(close,60))) / annualized_volatility(close_returns,60)",
    "description": "Ranks assets by the negative of their 60-session return relative to the cross-sectional median, divided by trailing 60-session realized volatility. This is an interpretable medium-horizon relative-trend fade signal. Values are computed using information available at the decision-date close cutoff."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "lookback_sessions": 60,
    "volatility_window": 60,
    "volatility_annualization": 252,
    "forward_horizon_sessions": 10,
    "minimum_cross_section": 8,
    "direction": "inverted"
  },
