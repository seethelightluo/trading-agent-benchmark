{
  "factor_id": "miner_1_20271007_short_volscaled_reversal",
  "factor_name": "Short-Horizon Volatility-Scaled Reversal",
  "version": "2027-10-07",
  "calculation": {
    "expression": "-((close / close.shift(5)) - 1) / (rolling_std(pct_change(close), 20) * sqrt(252))",
    "description": "Contrarian five-session return scaled by trailing 20-session annualized realized volatility, then cross-sectionally median-centered, MAD-standardized, and clipped to [-6,6]. All inputs are lagged or completed-day data."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "return_lookback": 5,
    "volatility_lookback": 20,
    "annualization": 252,
    "minimum_vol_observations": 15,
    "clip": 6,
    "cross_sectional_center": "median",
    "cross_sectional_scale": "MAD"
  },
