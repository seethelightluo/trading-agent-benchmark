{
  "factor_id": "miner_3_20271007_breadth_confirmed_momentum",
  "factor_name": "Cross-Asset Breadth-Confirmed Medium Momentum",
  "version": "20271007",
  "calculation": {
    "expression": "demean_cs(((close[t-3]/close[t-23])-1) * (2*((mean_i(1{r_i[t-3:t-23]>0}))-0.5)))",
    "description": "For each tradable asset, calculate the 20-session return ending three sessions before t, multiply it by a continuous cross-asset breadth confirmation score based on the fraction of the 15 assets with positive lagged 20-session returns, then median demean across assets. All inputs are lagged through t-3."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "lookback_sessions": 20,
    "skip_sessions": 3,
    "breadth_universe": "all 15 tradable benchmark instruments",
    "cross_section_demean": "median"
  },
