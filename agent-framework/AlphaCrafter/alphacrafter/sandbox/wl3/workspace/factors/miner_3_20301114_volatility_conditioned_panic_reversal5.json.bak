{
  "factor_id": "volatility_conditioned_panic_reversal5",
  "factor_name": "High-Volatility Extreme Broad-Selloff Panic Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-log_return_3d * I(breadth_3d <= 0.25) * I(cross_asset_median_vol20_percentile >= 0.70)",
    "description": "Fade each asset's lagged three-day return only when no more than 25% of the 15 tradable instruments have positive three-day returns and the cross-asset median 20-day volatility is in its trailing 252-day top 30%. Signal is lagged one completed day before forward return evaluation."
  },
  "dependencies": ["close"],
  "parameters": {"return_window_days": 3, "volatility_window_days": 20, "volatility_percentile_window_days": 252, "volatility_percentile_min_history": 126, "breadth_threshold": 0.25, "volatility_percentile_threshold": 0.70, "forward_horizon_days": 5, "execution_lag_days": 1, "universe_size": 15},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2030-11-14",
    "metrics": {"ic": 0.095768, "icir": 0.225419, "coverage": 0.99881, "turnover": 0.01603, "active_signal_fraction": 0.04076, "observations": 3509, "instruments": 15, "max_abs_library_correlation": null, "decay_ic_10d": 0.107067, "decay_ic_20d": 0.096446},
    "regime_notes": "5-day IC was positive in all tested regimes: 2020-2022 0.048972, 2023-2025 0.274302, 2026-2027 0.061047, 2028-2030 0.048004. Small cross-asset universe implies conservative uncertainty interpretation; signal is sparse and low turnover."
  },
  "signal_artifact": "scripts/miner_3_20301114_volpanic_signal.csv",
  "tags": ["reversal", "panic", "volatility", "cross-asset", "regime-conditioned"],
