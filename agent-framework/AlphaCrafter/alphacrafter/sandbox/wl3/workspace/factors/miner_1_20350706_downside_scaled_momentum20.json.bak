{
  "factor_id": "miner_1_20350706_downside_scaled_momentum20",
  "factor_name": "Downside-risk-scaled 20-session momentum",
  "version": "20350706",
  "calculation": {
    "expression": "lag1((close_t / close_{t-20} - 1) / downside_std(returns,20))",
    "description": "Scale each instrument's 20-session return by the rolling 20-session standard deviation of negative daily returns only, then lag one completed session. Positive values indicate momentum that was achieved with comparatively limited downside variability."
  },
  "dependencies": ["close"],
  "parameters": {
    "momentum_lookback_sessions": 20,
