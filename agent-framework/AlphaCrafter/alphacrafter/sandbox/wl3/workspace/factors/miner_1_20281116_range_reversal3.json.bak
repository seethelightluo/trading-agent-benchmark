  "factor_name": "Range-Scaled Three-Day Reversal",
  "version": "2028-11-16",
  "calculation": {
    "expression": "-pct_change(close,3) / rolling_mean((high-low)/close,20), shifted one session",
    "description": "Contrarian three-session return scaled by the instrument's recent mean daily high-low range; the one-session lag prevents use of the current completed bar as a fresh signal."
  },
  "dependencies": ["close", "high", "low"],
  "parameters": {"lookback_return": 3, "range_window": 20, "lag": 1, "minimum_range_observations": 15},
