{
  "factor_id": "miner_2_20270603_medium_dispersion_reversal",
  "factor_name": "Medium-Horizon Dispersion-Conditioned Risk-Normalized Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "clip(-(close/close.shift(5)-1)/rolling_std(pct_change(close),60) * clip(1+0.30*tanh(zscore(cross_asset_dispersion,120)),0.70,1.30), -8, 8)",
    "description": "Reverses each asset's five-day return, normalizes by 60-day realized volatility, and modestly increases signal magnitude during elevated cross-asset dispersion. All inputs are lagged or rolling historical observations available at decision time."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "return_lookback_days": 5,
    "risk_window_days": 60,
    "risk_min_periods": 30,
    "dispersion_window_days": 20,
    "dispersion_zscore_window_days": 120,
    "dispersion_zscore_min_periods": 60,
    "conditioning_strength": 0.3,
    "conditioning_clip": [
      0.7,
      1.3
    ],
    "signal_clip": [
      -8,
      8
    ],
    "minimum_cross_section": 8
  },
