{
  "factor_id": "miner_2_20290222_volnorm_reversal_1d",
  "factor_name": "Lagged Volatility-Normalized One-Day Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-pct_change(close,1) / lagged(rolling_std(pct_change(close,1),20),1)",
    "description": "Ranks each tradable asset by the negative completed one-day return, scaled by its lagged 20-session realized volatility. Volatility is shifted one session to prevent use of the current return in its own scale. Higher values indicate stronger risk-adjusted short-term reversal potential."
  },
  "dependencies": ["close"],
  "parameters": {"return_lookback_days": 1, "volatility_window_days": 20, "volatility_min_periods": 10, "forward_horizon_days": 1},
  "validation": {
