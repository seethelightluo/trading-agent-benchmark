{
  "factor_id": "miner_1_20320415_regime_conditioned_momentum20",
  "factor_name": "Cross-Asset Regime-Conditioned Risk-Adjusted Momentum",
  "version": "2032-04-15",
  "calculation": {
    "expression": "sign(median_cross_sectional_20d_return) * (asset_40d_log_return / (asset_20d_realized_volatility * sqrt(20)))",
    "description": "Compute each asset's 40-session log momentum divided by its 20-session realized volatility. If the cross-sectional median 20-session daily log return is positive, retain the score; otherwise reverse it. Lag the signal by one completed session before evaluating 10-session forward returns."
  },
  "dependencies": ["close"],
  "parameters": {"momentum_window": 40, "volatility_window": 20, "regime_window": 20, "forward_horizon": 10, "signal_lag": 1, "regime_statistic": "cross_sectional_median"},
