{
  "factor_id": "miner_3_20261105_continuous_dispersion_reversal_1d",
  "factor_name": "Continuous Dispersion-Scaled One-Day Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "clip(cross_sectional_mean_abs_return_t / rolling_median_60(cross_sectional_mean_abs_return), 0.5, 2.0) * (-return_1d / realized_volatility_20d)",
    "description": "Ranks assets by one-day reversal scaled by 20-day realized volatility and continuously amplified or damped by the current cross-asset absolute-return dispersion relative to its trailing 60-day median. Uses only information available at the signal date."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "vol_window": 20,
    "dispersion_window": 60,
    "dispersion_min_periods": 40,
    "vol_min_periods": 12,
    "multiplier_floor": 0.5,
    "multiplier_cap": 2.0,
    "forward_horizons_days": [
      1,
      3,
      5,
      10
    ],
    "min_cross_section": 8
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 to 2026-11-04",
