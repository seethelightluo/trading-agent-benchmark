{
  "factor_id": "miner_2_20280907_breakout_failure_reversal",
  "factor_name": "ATR-Normalized Breakout Failure Reversal (20D vs 60D)",
  "version": "1.0",
  "calculation": {
    "expression": "shift1(((close / rolling_max(close,60)) - 1) / mean((high-low)/close,10) - ((close / rolling_max(close,20)) - 1) / mean((high-low)/close,10))",
    "description": "Ranks assets higher when medium-term breakout pressure is stronger than short-term pressure, representing reversal after short-term breakout failure. Signal is lagged one completed session to prevent look-ahead."
  },
  "dependencies": [
    "close",
    "high",
    "low"
  ],
  "parameters": {
    "short_window": 20,
    "medium_window": 60,
