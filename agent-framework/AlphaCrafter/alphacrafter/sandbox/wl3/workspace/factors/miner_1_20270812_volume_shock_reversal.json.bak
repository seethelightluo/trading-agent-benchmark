{
  "factor_id": "miner_1_20270812_volume_shock_reversal",
  "factor_name": "Volume-Shock Confirmed 3-Day Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "clip(cross_sectional_median_demean(-(close/close.shift(3)-1) * (1 + 0.35*tanh(volume_zscore_60/2)), -6, 6)",
    "description": "Ranks recent three-session losers more positively, with the reversal signal amplified when trailing 60-session volume is unusually high. All rolling statistics use data available at the signal date."
  },
  "dependencies": [
    "close",
    "volume"
  ],
  "parameters": {
    "return_window": 3,
    "volume_window": 60,
    "volume_min_periods": 30,
    "volume_amplification": 0.35,
    "volume_zscore_scale": 2.0,
    "clip_lower": -6,
    "clip_upper": 6,
    "minimum_cross_section": 8
  },
  "validation": {
    "status": "EFFECTIVE",
    "timestamp": "2027-08-12T00:00:00Z",
