{
  "factor_id": "miner_2_20330317_blend_gap10_gap20",
  "factor_name": "Blended medium-term inverse return with recent-gap exclusion",
  "version": "1.0",
  "calculation": {
    "expression": "0.5*[-log(close[t-10]/close[t-70]) - cross_sectional_median] + 0.5*[-log(close[t-20]/close[t-80]) - cross_sectional_median], lagged one session",
    "description": "Cross-sectional mean-reversion blend of 60-session returns measured through 10 and 20 sessions ago. The one-session lag prevents same-day information use and the gaps reduce recent-return contamination. Higher values indicate stronger expected forward return."
  },
  "dependencies": ["close"],
  "parameters": {"lookback_sessions": [60, 60], "gap_sessions": [10, 20], "blend_weights": [0.5, 0.5], "forward_horizon_sessions": 10, "minimum_cross_section": 8, "lag_sessions": 1},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2033-03-17",
    "metrics": {
