{
  "factor_id": "miner_1_20260730_conditional_regime_blend",
  "factor_name": "Conditional Regime-Blended Residual Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "stress ? -(r_i,3d - median_cross_section(r,3d))/vol_i,20d : (r_i,3d)/vol_i,20d; stress = (median_cross_section(r,5d) < 0) OR (mean_cross_section(I[r>0],5d) < 0.45)",
    "description": "Uses volatility-scaled three-day residual reversal when aggregate breadth or median five-day market return is weak, and volatility-scaled three-day momentum in calm/broad markets. All rolling inputs use information available at the prior completed day.",
    "signal_artifact": "scripts/miner_1_20260730_conditional_regime_blend.py"
  },
  "dependencies": [
    "close",
    "daily_returns"
  ],
  "parameters": {
    "reversal_window_days": 3,
    "volatility_window_days": 20,
    "stress_return_window_days": 5,
    "breadth_window_days": 5,
    "breadth_threshold": 0.45,
    "minimum_cross_section": 8
  },
