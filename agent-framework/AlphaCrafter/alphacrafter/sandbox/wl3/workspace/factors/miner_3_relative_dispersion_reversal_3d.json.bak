{
  "factor_id": "miner_3_relative_dispersion_reversal_3d",
  "factor_name": "Cross-Asset Relative Dispersion Reversal (3D)",
  "version": "1.0",
  "calculation": {
    "expression": "-((sum_{k=0..2} return_{t-k}) - cross_sectional_median(sum_{k=0..2} return_{t-k}))",
    "description": "Ranks assets that underperformed the contemporaneous three-day cross-asset median highest, predicting short-horizon mean reversion. Returns are computed from close prices available through t; no future observations enter the signal."
  },
  "dependencies": ["close"],
  "parameters": {"lookback_days": 3, "forward_horizon_days": 1, "minimum_cross_section": 8, "universe_size": 15},
