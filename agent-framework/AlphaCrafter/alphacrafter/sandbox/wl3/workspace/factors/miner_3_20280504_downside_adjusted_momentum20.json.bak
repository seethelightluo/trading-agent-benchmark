{
  "factor_id": "miner_3_20280504_downside_adjusted_momentum20",
  "factor_name": "20-Session Downside-Risk-Adjusted Momentum",
  "version": "1.0",
  "calculation": {
    "expression": "(close / close.shift(20) - 1) / (rolling_std(where(daily_return < 0, daily_return, 0), 20) * sqrt(252))",
    "description": "Trailing 20-session return scaled by annualized downside deviation from negative daily returns only, shifted by one completed session to prevent look-ahead. Cross-sectional rank is suitable for portfolio use."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "lookback": 20,
    "downside_window": 20,
    "min_periods": 15,
    "annualization": 252,
    "signal_lag": 1
  },
