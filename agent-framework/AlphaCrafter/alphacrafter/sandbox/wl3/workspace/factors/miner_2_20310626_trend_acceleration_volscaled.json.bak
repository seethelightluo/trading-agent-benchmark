  "factor_name": "Volatility-scaled trend acceleration",
  "version": "2031-06-26",
  "calculation": {
    "expression": "((return_10d - lagged_return_20d)/(rolling_std_daily_return_20d + 1e-12)).shift(1)",
    "description": "Measures whether the recent 10-session return is accelerating relative to the preceding 20-session return, normalized by 20-session realized volatility. Positive values indicate strengthening trend; negative values indicate deceleration. The one-session lag ensures only completed-day data are used."
