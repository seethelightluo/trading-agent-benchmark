{
  "factor_id": "miner_3_20260730_volume_confirmed_reversal",
  "factor_name": "Volume-Confirmed Volatility-Scaled Reversal",
  "version": "20260730",
  "calculation": {
    "expression": "-ret_1d / vol20 * (1 + 0.35 * max(clip(volume_t / median_volume20_t, 0.5, 3.0) - 1, 0))",
    "description": "Reverses the completed one-session close-to-close return, scales by trailing 20-session realized volatility, and modestly amplifies the reversal when the session's volume exceeds its trailing 20-session median. All inputs are lagged or completed-session observations."
  },
  "dependencies": [
    "close",
    "volume"
  ],
  "parameters": {
    "volatility_window": 20,
    "volume_median_window": 20,
    "volume_ratio_clip": [
      0.5,
      3.0
    ],
    "volume_amplification": 0.35,
    "minimum_volatility_observations": 10,
    "forward_horizon_days": 1
  },
  "validation": {
