  "factor_name": "Cross-sectional residual volatility-scaled 20-day trend",
  "version": "1.0",
  "calculation": {
    "expression": "(return_20d - cross_sectional_mean(return_20d)) / (realized_volatility_40d * sqrt(20))",
    "description": "Ranks medium-term relative strength after removing the contemporaneous cross-asset average return, then dampens signals by 40-day realized volatility. Values are computed using information available at the decision date and are lagged before forward-return evaluation."
