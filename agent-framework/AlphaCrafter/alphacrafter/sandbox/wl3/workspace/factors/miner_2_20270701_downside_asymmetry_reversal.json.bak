{
  "factor_id": "miner_2_20270701_downside_asymmetry_reversal",
  "factor_name": "Downside-Adjusted 10-Day Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "cross_sectional_demean(clip(-(close/shift(close,10)-1)/(sqrt(252)*rolling_std(min(pct_change(close),0),20)+1e-8), -6, 6))",
    "description": "Ranks recent 10-day losers positively for reversal, scaling each return by 20-day downside volatility rather than total volatility; daily cross-sectional median is removed and extremes are clipped."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "lookback_return_days": 10,
    "downside_volatility_days": 20,
    "annualization": 252,
    "clip": [
      -6,
      6
    ],
    "minimum_cross_section": 8
  },
