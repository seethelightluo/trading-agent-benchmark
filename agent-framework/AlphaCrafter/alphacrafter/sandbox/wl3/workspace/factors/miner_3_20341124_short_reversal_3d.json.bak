  "factor_name": "Volatility-Scaled Short-Term Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-pct_change(close, 3) / rolling_std(pct_change(close, 1), 20), lagged 1 session",
    "description": "Ranks assets positively when their prior three-session return was weak relative to their recent 20-session volatility; the one-session lag prevents lookahead."
  },
