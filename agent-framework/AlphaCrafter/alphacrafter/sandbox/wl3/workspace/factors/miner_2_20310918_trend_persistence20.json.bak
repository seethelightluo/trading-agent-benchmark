  "factor_name": "Volatility-scaled 20-day trend persistence",
  "version": "1.0",
  "calculation": {
    "expression": "(log(close_t/close_{t-20}) / (std(log_returns,30)*sqrt(252))) * mean(I(return>0),20), lagged 1 session",
    "description": "Ranks assets by 20-day momentum scaled by annualized 30-day volatility and multiplied by the fraction of positive return sessions in the trailing 20 days. Inputs are lagged one session to prevent look-ahead."
