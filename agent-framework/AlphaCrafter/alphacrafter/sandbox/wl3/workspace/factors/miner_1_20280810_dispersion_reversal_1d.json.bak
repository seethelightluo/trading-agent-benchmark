{
  "factor_id": "miner_1_20280810_dispersion_reversal_1d",
  "factor_name": "High-Dispersion Cross-Asset One-Day Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-pct_change(close,1) if cross_sectional_std(pct_change(close,1)) > rolling_median(cross_sectional_std(pct_change(close,1)),60) else 0",
    "description": "Fades the prior one-session return only on elevated cross-sectional dispersion days; zero signal on ordinary-dispersion days. Signal is lagged one session before forward-return testing."
  },
  "dependencies": ["close", "daily returns"],
  "parameters": {"lookback_return": 1, "dispersion_window": 60, "dispersion_threshold": "rolling median", "minimum_dispersion_history": 30, "minimum_cross_section": 8},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2028-08-09",
    "last_validated": "2028-08-10T00:00:00Z",
    "metrics": {
