{
  "factor_id": "miner_1_20281019_reversal3_vol20",
  "factor_name": "Volatility-Scaled Three-Day Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "(-close/close.shift(3) + 1) / rolling_std(pct_change(close), 20, min_periods=15), then lag(1)",
    "description": "Negative three-session return divided by trailing 20-session realized daily-return volatility. The complete cross-sectional signal is lagged one session to avoid lookahead. Higher values indicate stronger recent loss relative to risk and a stronger reversal candidate."
  },
  "dependencies": ["close"],
  "parameters": {"return_lookback_days": 3, "volatility_lookback_days": 20, "vol_min_periods": 15, "signal_lag_days": 1},
