{
  "factor_id": "miner_3_20330429_inverse_relative_mean_reversion60_gap10",
  "factor_name": "Inverse volatility-scaled cross-asset relative mean reversion",
  "version": "1.0",
  "calculation": {
    "expression": "-((log(close/close_lag60) - cross_sectional_median(log(close/close_lag60))) / (rolling_std(asset_log_return,40)*sqrt(40))).shift(10).shift(1)",
    "description": "Fades each asset's 60-session performance relative to the cross-asset median, scaling by its 40-session realized volatility. The 10-session information gap plus one-session lag ensures the signal is available before the 10-session forward return. Higher values favor recent relative underperformers."
  },
  "dependencies": ["close", "watch_list"],
  "parameters": {
    "relative_return_window": 60,
    "volatility_window": 40,
    "volatility_min_periods": 30,
    "gap_days": 10,
    "lag_days": 1,
    "forward_horizon_days": 10,
    "minimum_cross_section": 8
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2033-04-29",
    "validated_at": "2033-04-29T00:00:00Z",
    "metrics": {
      "ic": 0.028712,
      "icir": 0.084453,
      "forward_horizon_days": 10,
      "dates": 4774,
      "average_instruments": 15.0,
      "coverage": 0.9999,
      "turnover": 0.0474,
      "hit_ratio": 0.5323,
      "max_abs_library_correlation": null,
      "recent_120": {"ic": 0.02670, "icir": 0.09841},
