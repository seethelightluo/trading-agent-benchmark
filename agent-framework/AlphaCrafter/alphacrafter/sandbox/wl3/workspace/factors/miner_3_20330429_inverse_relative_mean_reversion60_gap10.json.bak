      "recent_756": {"ic": 0.05760, "icir": 0.19414},
      "recent_1260": {"ic": 0.05815, "icir": 0.19480}
    },
    "regime_notes": "Passes both benchmark gates over 4,774 daily cross-sectional observations. The recent 120/252/756/1260-observation windows are consistently positive. The 15-instrument universe implies material IC uncertainty; library correlation requires deterministic post-Miner recomputation.",
    "signal_artifact": "scripts/miner_3_20330429_inverse_relative_mr_signal.csv",
