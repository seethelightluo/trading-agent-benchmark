{
  "factor_id": "miner_1_20300725_breadth_conditioned_shock_reversal3",
  "factor_name": "Breadth-Conditioned Three-Session Shock Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "gate * (-(rolling_sum(log_return,3) - cross_sectional_median(rolling_sum(log_return,3))) / (rolling_std(log_return,30)*sqrt(3)))",
    "description": "Ranks assets for reversal after an unusually weak three-session move relative to the cross-sectional median, normalized by 30-session volatility. The signal is activated when at least 55% of instruments had negative five-session returns and VIX exceeded its trailing 90-session median. The complete signal is lagged one session."
  },
  "dependencies": ["close", "VIX"],
  "parameters": {
    "shock_window": 3,
    "volatility_window": 30,
    "breadth_window": 5,
    "breadth_threshold": 0.55,
    "vix_median_window": 90,
    "minimum_cross_section": 8,
    "signal_lag": 1
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 to 2030-07-24",
    "data_cutoff": "2030-07-24",
    "validation_timestamp": "2030-07-25T00:00:00Z",
    "metrics": {
      "horizon_days": 1,
      "ic": 0.034231,
      "icir": 0.098947,
      "hit_ratio": 0.55,
      "ic_observations": 500,
      "average_instruments": 15.0,
      "universe_instruments": 15,
      "factor_coverage": 0.990634,
      "active_regime_dates": 500,
      "turnover": null,
      "decay": {
        "3d_ic": 0.046787,
        "3d_icir": 0.131546,
        "5d_ic": 0.050910,
        "5d_icir": 0.149199,
        "10d_ic": 0.046306,
        "10d_icir": 0.139905
      },
      "max_abs_library_correlation": null
    },
    "regime_notes": "Passes the benchmark daily paper IC and ICIR gates. IC remained positive through 2020-2027; the 2028-2030 tail has only 12 observations and was negative, so recency risk is material.",
    "signal_artifact": "scripts/miner_1_20300725_breadth_shock_signal.csv"
  },
  "tags": ["reversal", "shock", "breadth", "volatility-conditioned", "cross-asset"],
