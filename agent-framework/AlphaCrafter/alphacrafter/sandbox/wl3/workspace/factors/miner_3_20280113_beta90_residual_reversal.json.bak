{
  "factor_id": "miner_3_20280113_beta90_residual_reversal",
  "factor_name": "90-Session Beta-Residual Five-Day Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(asset_5d_return - rolling_beta_90(asset_return, equal_weight_benchmark_return)*benchmark_5d_return), lagged_one_session",
    "description": "Ranks assets higher when their prior five-session return underperformed the equal-weight 15-asset benchmark after removing rolling 90-session benchmark beta exposure. All signal inputs are shifted one completed session before evaluation or trading."
  },
  "dependencies": ["close", "daily_returns"],
  "parameters": {
    "universe": ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"],
    "benchmark": "equal_weight_mean_available_asset_returns",
    "beta_window": 90,
    "beta_min_periods": 45,
    "residual_return_window": 5,
    "signal_lag_sessions": 1
  },
