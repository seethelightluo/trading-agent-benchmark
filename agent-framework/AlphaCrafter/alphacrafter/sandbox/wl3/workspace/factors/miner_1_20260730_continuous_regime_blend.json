  "factor_name": "Continuous Regime-Scaled Volatility-Adjusted Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "((1 - 2*s_t) * sum_return_i_3d) / std_return_i_20d, where s_t = 0.5*(I[median_cross_section(sum_return_5d)<0] + I[mean_cross_section(I[daily_return>0],5d)<0.45])",
    "description": "Volatility-adjusted three-day momentum is smoothly multiplied by a regime coefficient: +1 in calm/broad markets, 0 when one stress indicator fires, and -1 when both fire. This continuously transitions from momentum to reversal and avoids hard signal jumps. All inputs are lagged through the prior completed session.",
