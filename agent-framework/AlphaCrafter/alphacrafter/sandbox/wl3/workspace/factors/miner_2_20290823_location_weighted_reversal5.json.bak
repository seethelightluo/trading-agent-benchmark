{
  "factor_id": "miner_2_20290823_location_weighted_reversal5",
  "factor_name": "Range-location weighted five-session reversal",
  "version": "20290823",
  "calculation": {
    "expression": "-sign(log(close/close[-5])) * abs(log(close/close[-5])) * (abs((close-rolling_min(close,20))/(rolling_max(close,20)-rolling_min(close,20))-0.5)+0.25) / (rolling_std(log_return,20)*sqrt(5)+1e-12), then cross-sectional demean",
    "description": "Fades stretched five-session moves, increasing reversal intensity when price is farther from the midpoint of its trailing 20-session range, and scales by five-session realized volatility. Signal uses only completed historical observations and is lagged by the execution convention.",
    "signal_artifact": "scripts/miner_2_20290823_location_reversal_signal.csv"
  },
  "dependencies": ["close"],
  "parameters": {"return_window": 5, "range_window": 20, "volatility_window": 20, "volatility_horizon_scaling": "sqrt(5)", "cross_sectional_demean": true},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2029-08-22",
    "last_validated": "2029-08-23",
    "metrics": {
