{
  "factor_id": "miner_1_20310123_stress_relative_reversal5",
  "factor_name": "VIX-Stress Conditioned Relative Reversal 5D",
  "version": "1.0",
  "calculation": {
    "expression": "I(VIX_t > median(VIX,60) and VIX_t/VIX_{t-5}-1 > 0) * (-(R5_i - median_cross_section(R5))/sigma20_i)",
    "description": "During elevated and rising VIX stress, rank assets that underperformed their cross-sectional five-session return median as prospective short-horizon rebound candidates; signal is lagged by using only completed-session data. Outside stress the signal is zero."
  },
  "dependencies": ["close", "VIX.close"],
  "parameters": {"return_window": 5, "volatility_window": 20, "vix_median_window": 60, "stress_change_window": 5, "minimum_cross_section": 8},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-02 through 2031-01-23",
    "metrics": {
      "admission_horizon_sessions": 3,
      "ic": 0.046521,
      "icir": 0.132923,
      "ic_hit_ratio": 0.1673,
      "observations": 3544,
      "historical_dates": 3546,
      "instruments": 15,
      "average_valid_instruments": 14.346,
      "coverage": 0.95071,
      "active_fraction": 0.30417,
      "turnover": 0.07024,
      "decay_ic": {"1": 0.029456, "3": 0.046521, "5": 0.041365, "10": 0.038817},
      "regime_ic": {"2020-2022": 0.071879, "2023-2025": 0.045247, "2026-2027": 0.061003, "2028-2030": 0.014114},
      "max_abs_library_correlation": null
    },
    "regime_notes": "Positive across all reported historical regimes at the admitted 3-session horizon, though weaker in 2028-2030. Small cross-section uncertainty is mitigated by 3,544 daily observations and average 14.346 valid instruments.",
