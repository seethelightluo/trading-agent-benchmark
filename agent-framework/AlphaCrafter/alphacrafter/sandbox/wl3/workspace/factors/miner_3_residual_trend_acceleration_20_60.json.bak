{
  "factor_id": "miner_3_residual_trend_acceleration_20_60",
  "factor_name": "Residual Trend Acceleration 20/60",
  "version": "1.0",
  "calculation": {
    "expression": "rank_pct((sum_20(residual_return) - sum_60(residual_return)/3)) - 0.5, shifted_one_session",
    "description": "For each tradable asset, subtract one third of its 60-session residual return from its 20-session residual return, where residual return is asset log return minus the cross-sectional mean log return. Rank cross-sectionally and lag one completed session to avoid look-ahead. Positive values indicate accelerating relative trend."
  },
  "dependencies": ["close"],
  "parameters": {"fast_window": 20, "slow_window": 60, "minimum_fast_observations": 15, "minimum_slow_observations": 40, "residual_definition": "daily_log_return minus cross_sectional_daily_mean", "lag_sessions": 1},
