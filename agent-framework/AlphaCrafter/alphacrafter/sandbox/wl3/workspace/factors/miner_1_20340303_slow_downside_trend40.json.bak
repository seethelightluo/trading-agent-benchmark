{
  "factor_id": "miner_1_20340303_slow_downside_trend40",
  "factor_name": "Slow Downside-Adjusted Quiet-Regime Residual Trend 40",
  "version": "1.0",
  "calculation": {
    "expression": "shift1((cross_sectional_log_return - cross_sectional_mean).rolling(40).mean / rolling_downside_std(45) * (1 - 0.4 * lagged_90d_dispersion_percentile))",
    "description": "Cross-asset residual 40-session trend normalized by 45-session downside deviation, attenuated by a one-session-lagged 90-session cross-sectional dispersion percentile. All inputs are lagged to completed sessions."
  },
  "dependencies": ["close"],
  "parameters": {"trend_window": 40, "downside_window": 45, "downside_min_periods": 20, "dispersion_window": 90, "dispersion_min_periods": 45, "dispersion_penalty": 0.4, "decision_lag": 1, "forward_horizon_days": 10},
