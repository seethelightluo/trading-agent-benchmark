{
  "factor_id": "miner_2_20280601_consistency30",
  "factor_name": "Trend-Consistency Weighted 30-Day Return",
  "version": "1.0",
  "calculation": {
    "expression": "lag1(pct_change(close,30) * (0.5 + rolling_mean(pct_change(close,1)>0,30)) )",
    "description": "The lagged 30-session return is weighted by the fraction of positive daily sessions in the same 30-session window, distinguishing persistent directional trends from isolated jumps. Cross-sectional ranking is used for portfolio signals."
  },
  "dependencies": ["close", "date"],
  "parameters": {"return_window": 30, "consistency_window": 30, "minimum_consistency_observations": 22, "lag_sessions": 1, "admission_horizon_days": 10},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2028-05-31",
    "data_cutoff": "2028-05-31",
