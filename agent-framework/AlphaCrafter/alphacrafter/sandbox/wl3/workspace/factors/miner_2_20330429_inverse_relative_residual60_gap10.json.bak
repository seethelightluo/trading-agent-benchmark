{
  "factor_id": "miner_2_20330429_inverse_relative_residual60_gap10",
  "factor_name": "Inverse volatility-scaled cross-asset relative strength residual",
  "version": "1.0",
  "calculation": {
    "expression": "-((log(close/close_lag60) - cross_sectional_median(log(close/close_lag60))) / rolling_std(asset_return - cross_sectional_median(asset_return), 60) * sqrt(60)).shift(10).shift(1)",
    "description": "Fades 60-session asset performance relative to the contemporaneous cross-asset median, scaling by 60-session volatility of asset returns after removing the daily cross-sectional median. The ten-session gap and one-session lag prevent overlap/look-ahead relative to the ten-session forward return. Higher values favor recent relative underperformers, a deliberately defensive medium-horizon reversal signal."
  },
  "dependencies": ["close", "watch_list"],
  "parameters": {
    "relative_return_window": 60,
    "residual_volatility_window": 60,
    "volatility_min_periods": 40,
    "gap_days": 10,
    "lag_days": 1,
    "forward_horizon_days": 10,
    "minimum_cross_section": 8
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2033-04-29",
    "validated_at": "2033-04-29T00:00:00Z",
    "metrics": {
      "ic": 0.030910,
      "icir": 0.088429,
      "forward_horizon_days": 10,
      "dates": 4774,
      "average_instruments": 15.0,
      "coverage": 0.9999,
      "turnover": 0.0470,
      "hit_ratio": 0.5364,
      "max_abs_library_correlation": null,
      "recent_120": {"ic": 0.03703, "icir": 0.13500},
      "recent_252": {"ic": 0.09402, "icir": 0.31987},
      "recent_756": {"ic": 0.06711, "icir": 0.22102},
      "recent_1260": {"ic": 0.06806, "icir": 0.22319}
    },
    "regime_notes": "Full-history result narrowly clears the benchmark daily paper IC and ICIR gates; recent 120/252/756/1260-observation windows are positive and stronger. Cross-sectional uncertainty remains material because the universe contains 15 instruments.",
    "signal_artifact": "scripts/miner_2_20330429_inverse_relative_residual60_signal.csv",
    "ic_artifact": "scripts/miner_2_20330429_inverse_relative_residual60_ic.csv",
    "admission_thresholds": {"absolute_daily_paper_ic": 0.007, "absolute_daily_paper_icir": 0.084}
  },
