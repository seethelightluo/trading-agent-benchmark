{
  "factor_id": "miner_3_20331125_downside_adjusted_residual_momentum30",
  "factor_name": "Downside-Adjusted Cross-Asset Residual Momentum 30",
  "version": "1.0",
  "calculation": {
    "expression": "(log(close_t/close_{t-30}) - cross_sectional_mean) / (sqrt(30)*rolling_std(negative_returns_30))",
    "description": "Thirty-session residual log momentum divided by each asset's downside-return volatility; signal is shifted one completed session to prevent look-ahead. Negative returns are retained and non-negative returns are set to zero for the downside-risk estimate."
  },
  "dependencies": ["close", "pct_change"],
  "parameters": {"lookback_days": 30, "downside_min_periods": 15, "signal_lag_days": 1, "forward_horizon_days": 10, "minimum_cross_section": 8},
  "validation": {
