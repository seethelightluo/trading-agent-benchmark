{
  "factor_id": "miner_3_volscaled_momentum20_vix",
  "factor_name": "VIX-Scaled Twenty-Day Relative Momentum",
  "version": "2034-09-29",
  "calculation": {
    "expression": "lag1(returns_20d / clip(VIX / median(VIX,60d), 0.5, 2.0))",
    "description": "Cross-asset 20-session price momentum divided by the contemporaneous VIX stress ratio, lagged one completed session. Momentum is downscaled during elevated volatility and modestly amplified in calm regimes; VIX is observation-only."
  },
  "dependencies": ["close", "VIX"],
  "parameters": {"momentum_window": 20, "volatility_proxy": "VIX", "vix_median_window": 60, "stress_clip": [0.5, 2.0], "lag_sessions": 1, "horizon_sessions": 10},
