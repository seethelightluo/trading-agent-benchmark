{
  "factor_id": "miner_3_20270520_vol_reversal3",
  "factor_name": "Volatility-Scaled Three-Day Cross-Asset Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "clip(-pct_change(close,3) / (rolling_std(pct_change(close),20) * sqrt(20)) - cross_sectional_median, -6, 6)",
    "description": "Fades each instrument's trailing three-session return, scaling by its 20-session realized volatility and centering against the contemporaneous universe median. All inputs are available at the signal date."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "reversal_lookback_days": 3,
    "volatility_window_days": 20,
    "volatility_min_periods": 15,
    "clip_lower": -6,
    "clip_upper": 6,
    "minimum_cross_section": 8
  },
