{
  "factor_id": "miner_2_20290322_dispersion_volreversal",
  "factor_name": "High-dispersion volatility-normalized reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-r_1d / lagged_20d_volatility when lagged_20d_cross_asset_dispersion exceeds its trailing_120d median; otherwise 0",
    "description": "Each asset's one-session reversal, normalized by its lagged 20-session volatility, is activated only during elevated cross-asset dispersion. Dispersion is the lagged 20-session mean of cross-sectional daily-return standard deviation, compared with its lagged trailing 120-session median. All inputs are available before the forecast day."
  },
  "dependencies": ["close", "daily_returns"],
  "parameters": {
    "asset_volatility_window": 20,
    "dispersion_window": 20,
    "dispersion_baseline_window": 120,
    "minimum_volatility_observations": 10,
    "activation": "dispersion > trailing median"
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 to 2029-03-20",
    "last_validated": "2029-03-22",
    "metrics": {
      "horizon_days": 1,
      "ic": 0.034526,
