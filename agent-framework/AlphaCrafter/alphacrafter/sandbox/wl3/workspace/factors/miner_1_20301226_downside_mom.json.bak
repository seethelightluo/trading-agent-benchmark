  "factor_name": "Downside-Risk-Adjusted Relative Momentum 20D",
  "version": "1.0",
  "calculation": {
    "expression": "(sum(log_return,20) / downside_std(log_return,20)).shift(1), cross-sectionally demeaned by median",
