{
  "factor_id": "miner_3_20351012_hybrid_downside40",
  "factor_name": "Hybrid downside-adjusted 20-session momentum (40-session risk)",
  "version": "1.0",
  "calculation": {
    "expression": "pct_change(close,20).shift(1) / (sqrt(20) * shifted(fillna(rolling_std(returns.where(returns<0),40,min_periods=13), rolling_std(returns,40,min_periods=20))))",
    "description": "Lagged 20-session momentum divided by a 40-session downside deviation; when downside observations are insufficient, total 40-session volatility is used as a deterministic fallback."
  },
  "dependencies": ["close"],
  "parameters": {"momentum_window": 20, "risk_window": 40, "downside_min_periods": 13, "total_vol_min_periods": 20, "forward_horizon": 10, "universe_size": 15},
  "validation": {
    "status": "EFFECTIVE",
    "period": {"start": "2020-01-01", "end": "2035-10-11", "cutoff": "2035-10-11"},
    "validated_at": "2035-10-12",
    "metrics": {
      "ic": 0.027961,
      "icir": 0.0861,
      "horizon_sessions": 10,
      "ic_method": "daily cross-sectional Spearman; minimum 8 valid instruments",
      "valid_ic_dates": 4724,
      "instruments": 15,
      "average_coverage": 1.0,
      "recent_252_ic": 0.046282,
      "recent_252_icir": 0.1375,
      "recent_252_hit_ratio": 0.5714,
      "turnover": null,
      "decay_ic": null,
      "max_abs_library_correlation": null
    },
    "admission_thresholds": {"absolute_daily_paper_ic": 0.007, "absolute_daily_paper_icir": 0.084},
    "regime_notes": "Full historical cross-asset sample; recent 252 observations are stronger than full sample. Small cross-section implies conservative interpretation. Coverage is 100% due to volatility fallback."
  },
  "signal_artifact": "scripts/miner_3_20351012_hybrid_downside40_signal.csv",
  "tags": ["momentum", "risk_adjusted", "downside_risk", "hybrid_volatility", "cross_asset"]
}
