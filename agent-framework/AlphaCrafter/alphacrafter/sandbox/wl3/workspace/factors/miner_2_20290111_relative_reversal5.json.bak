{
  "factor_id": "miner_2_20290111_relative_reversal5",
  "factor_name": "Cross-Asset Relative Five-Day Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-((close_t/close_{t-5}-1) - cross_sectional_median_i(close_t/close_{t-5}-1)) shifted by one completed session",
    "description": "Ranks assets whose prior five-session return lagged the cross-sectional median more highly, and assets that outperformed the median more negatively. The one-session lag prevents use of the decision day's information."
  },
  "dependencies": ["close"],
  "parameters": {"lookback_sessions": 5, "signal_lag_sessions": 1, "minimum_cross_section": 8},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-03 through 2029-01-10",
    "last_validated": "2029-01-11T00:00:00Z",
    "metrics": {
      "horizon_sessions": 5,
      "ic": 0.013393611569695343,
      "icir": 2.1522038832601855,
      "ic_hit_ratio": 0.5054690089492874,
      "observations": 3017,
      "instruments": 15,
      "average_valid_instruments": 14.950792602377808,
      "coverage": 0.9967195068251873,
      "rank_turnover_proxy": 0.15125796962318933,
      "max_abs_library_correlation": null
    },
    "regime_notes": "Positive over 2020-2022 (IC 0.02370, ICIR 2.2208), 2023-2025 (0.02210, 2.1616), and 2026-2027 (0.00957, 0.6893), but materially negative in 2028 (-0.05678, -2.7893) and recent 120 observations (-0.04415, -1.3632). Treat as regime-dependent and require ensemble/regime controls before substantial allocation.",
    "signal_artifact": "scripts/miner_2_20290111_relative_reversal5_signal.csv"
  },
