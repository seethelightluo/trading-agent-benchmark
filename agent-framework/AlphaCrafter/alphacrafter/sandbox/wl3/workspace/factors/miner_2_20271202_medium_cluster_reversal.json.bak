{
  "factor_id": "miner_2_20271202_medium_cluster_reversal",
  "factor_name": "Medium-Horizon Cluster-Relative Volatility-Normalized Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "clip(median_center(-(sum_{3..8}(r_i - median_cluster(r))/std_30(r_i)) * (1 + 0.25*sign(sum_3(relative_return))*sign(base_signal)), -6, 6)",
    "description": "For each of the 15 tradable benchmark assets, subtract the contemporaneous median return of its asset cluster, fade the eight-session relative move, normalize by 30-session volatility, and apply a small confirmation adjustment based on the recent three-session relative move. The cross-sectional signal is median-centered and clipped. Signals use only completed data through the prior session when deployed."
  },
  "dependencies": [
    "close",
    "date",
    "asset_cluster"
  ],
  "parameters": {
    "relative_return_window": 8,
    "volatility_window": 30,
    "volatility_min_periods": 20,
    "confirmation_window": 3,
    "confirmation_weight": 0.25,
    "clip_bounds": [
      -6,
      6
    ],
    "clusters": {
      "equities": [
        "000300.SH",
        "SPX",
        "HSI",
        "N225",
        "SX5E",
        "000688.SH",
        "SOX",
        "NDX"
      ],
      "commodities": [
