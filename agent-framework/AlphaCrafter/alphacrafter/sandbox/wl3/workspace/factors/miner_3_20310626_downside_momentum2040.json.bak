{
  "factor_id": "miner_3_20310626_downside_momentum2040",
  "factor_name": "Downside-volatility-managed medium momentum",
  "version": "1.0",
  "calculation": {
    "expression": "lag1(roc(close,20) / (rolling_std(min(pct_change(close),0),40,min_periods=25)*sqrt(20)))",
    "description": "Ranks tradable cross-asset instruments by their prior 20-session return scaled by prior downside deviation over 40 sessions. The one-session lag ensures the signal is available before the forward return interval."
  },
  "dependencies": ["close"],
  "parameters": {"momentum_window": 20, "downside_window": 40, "downside_min_periods": 25, "lag": 1, "forward_horizon": 10},
