{
  "factor_id": "miner_2_20350202_volscaled_trend_accel10_40",
  "factor_name": "Volatility-Normalized Short-to-Medium Trend Acceleration",
  "version": "20350202",
  "calculation": {
    "expression": "return_10d / (rolling_std(daily_log_return,10)*sqrt(252)) - return_40d / (rolling_std(daily_log_return,40)*sqrt(252)), evaluated after the completed session and lagged one session",
    "description": "Ranks assets whose recent 10-session risk-adjusted trend is strengthening relative to their 40-session risk-adjusted trend. All inputs are lagged to avoid lookahead."
  },
  "dependencies": [
    "close",
    "date"
  ],
  "parameters": {
    "short_window": 10,
    "long_window": 40,
    "short_volatility_window": 10,
    "long_volatility_window": 40,
    "forward_horizon_days": 10,
    "lag_sessions": 1,
    "minimum_cross_section": 8
  },
