{
  "factor_id": "miner_3_20310918_breadth_conditioned_trend10",
  "factor_name": "Breadth-Conditioned Volatility-Scaled 10D Trend",
  "version": "1.0",
  "calculation": {
    "expression": "lag1((log(close/close[-10]) / (sqrt(252)*std(log_returns,20))) * I(rolling_mean_5(cross_sectional_fraction_positive_10D_returns) > 0.50)",
    "description": "Compute each asset's 10-day log return divided by annualized 20-day realized volatility. Multiply the cross-sectional risk-adjusted trend by one when the five-day average fraction of assets with positive 10-day returns exceeds 50%, otherwise set the signal to zero; lag one session to avoid lookahead."
  },
  "dependencies": ["close", "daily_returns"],
  "parameters": {"return_window": 10, "volatility_window": 20, "breadth_window": 5, "breadth_threshold": 0.50, "lag": 1, "forward_horizon": 10},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 to 2031-09-17",
    "as_of": "2031-09-18",
    "metrics": {
      "ic": 0.03129076,
      "icir": 0.09669209,
      "horizon_days": 10,
      "valid_dates": 1442,
      "average_instruments": 14.94868,
      "coverage": 0.99658,
      "turnover": 0.0659253,
      "hit_ratio": 0.5562,
      "max_abs_library_correlation": null
    },
    "regime_notes": "Positive in 2020-2022 (IC 0.04636), negative in 2023-2025 (IC -0.01252), strongly positive in 2026-2030 but sparse 2028-2030 observations, and negative in the short 2031 YTD sample (IC -0.30514). Recent 120 observations remain positive (IC 0.14955; ICIR 0.43629). Interpret small recent regime samples conservatively.",
    "signal_artifact": "scripts/miner_3_20310918_breadth_trend_signal.csv"
  },
