{
  "factor_id": "miner_1_20301212_trend_quality_regime",
  "factor_name": "Regime-Filtered Relative Trend Quality",
  "version": "1.0",
  "calculation": {
    "expression": "(rolling_sum(log_return,60) / rolling_std(log_return,60)).shift(1) - cross_sectional_median((rolling_sum(log_return,60) / rolling_std(log_return,60)).shift(1)); multiply by +1 when lagged cross-sectional breadth(20d return > 0) > 0.5, else -1",
    "description": "Ranks assets by lagged 60-day trend quality (return normalized by 60-day volatility), demeaned against the available cross-asset median. In positive breadth regimes it follows leaders; in non-positive breadth regimes it reverses the ranking to favor defensive relative winners. All inputs are lagged one completed observation."
  },
  "dependencies": ["close"],
  "parameters": {
    "trend_window_days": 60,
    "volatility_window_days": 60,
    "breadth_window_days": 20,
    "breadth_threshold": 0.5,
    "signal_lag_days": 1,
    "universe_size": 15
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2030-12-12",
    "validation_timestamp": "2030-12-12",
    "metrics": {
      "admission_horizon_sessions": 10,
      "ic": 0.032918,
      "icir": 0.095219,
      "ic_hit_ratio": 0.5369,
      "observations": 3466,
