      "instruments": 15,
      "average_valid_instruments": 14.374,
      "minimum_cross_section": 8,
      "coverage": 0.94138,
      "turnover": 0.08963,
      "max_abs_library_correlation": null,
      "decay": {"1d_ic": 0.01076, "3d_ic": 0.018971, "5d_ic": 0.020003, "10d_ic": 0.032918},
      "regime_ic": {
        "2020-2022": 0.000068,
