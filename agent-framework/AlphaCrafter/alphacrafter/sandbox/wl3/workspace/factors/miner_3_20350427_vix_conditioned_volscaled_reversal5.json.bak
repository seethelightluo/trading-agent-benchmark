{
  "factor_id": "miner_3_20350427_vix_conditioned_volscaled_reversal5",
  "factor_name": "VIX-conditioned volatility-scaled five-session reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(sum_{i=0..4} return[t-i]) / (rolling_std(return,20)*sqrt(20)) * clip(1 + 0.35*zscore(VIX,120), 0.45, 1.55)",
    "description": "Fade the latest five-session cross-asset return after volatility normalization. Increase or decrease reversal magnitude according to the lagged 120-session standardized VIX level, bounded to avoid extreme regime leverage. Signal uses only data through the completed observation date.",
    "signal_artifact": "scripts/miner_3_20350427_vix_conditioned_reversal_signal.csv"
  },
  "dependencies": ["close", "VIX close"],
  "parameters": {"lookback_return_sessions": 5, "volatility_window": 20, "vix_zscore_window": 120, "vix_multiplier": 0.35, "multiplier_floor": 0.45, "multiplier_ceiling": 1.55, "minimum_cross_section": 8},
