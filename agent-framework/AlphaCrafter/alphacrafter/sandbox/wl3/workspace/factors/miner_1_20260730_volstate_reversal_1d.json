  "factor_name": "Volatility-state one-day reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-daily_return * rolling_std(daily_return, 60) / rolling_std(daily_return, 20)",
    "description": "Cross-sectional short-horizon reversal signal. The prior completed daily return is negated and scaled by the asset's 60-day volatility relative to its 20-day volatility; higher values indicate a recent decline during relatively compressed short-term volatility and are expected to mean-revert. Signals use only information available through the prior completed day."
  },
