{
  "factor_id": "miner_2_20271104_cluster_relative_reversal",
  "factor_name": "Cluster-Relative Volatility-Scaled Three-Day Reversal",
  "version": "2027-11-04",
  "calculation": {
    "expression": "-rolling_sum_3(asset_return - median_return_of_asset_cluster) / rolling_std_20(asset_return), then cross-sectional median-center and clip [-6,6]",
    "description": "For each tradable benchmark instrument, subtract the same-day median return of its broad asset cluster (equities, commodities, crypto, or rates) from its own return. Fade the trailing three-session cumulative relative return and divide by the asset's trailing 20-session volatility. Median-center and winsorize the cross-section. All inputs are lagged completed daily observations at decision time."
  },
  "dependencies": [
    "close",
    "daily_return"
  ],
  "parameters": {
