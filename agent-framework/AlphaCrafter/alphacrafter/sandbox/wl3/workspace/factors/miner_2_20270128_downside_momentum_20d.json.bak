{
  "factor_id": "miner_2_20270128_downside_momentum_20d",
  "factor_name": "Downside-adjusted 20-day momentum",
  "version": "2027-01-28",
  "calculation": {
    "expression": "pct_change(close,20) / (sqrt(20) * rolling_std(where(pct_change(close,1)<0,pct_change(close,1),0),20,min_periods=12))",
    "description": "Ranks assets by their trailing 20-session return per unit of downside deviation. Positive and persistent returns with limited negative daily variation receive larger signals; all inputs are available through the prior completed close at decision time."
  },
  "dependencies": ["close"],
  "parameters": {"return_window": 20, "downside_vol_window": 20, "min_periods": 12, "forward_horizon": 10},
  "validation": {
    "status": "EFFECTIVE",
