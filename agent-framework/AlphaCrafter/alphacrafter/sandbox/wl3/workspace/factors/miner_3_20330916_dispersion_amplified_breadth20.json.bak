{
  "factor_id": "miner_3_20330916_dispersion_amplified_breadth20",
  "factor_name": "Dispersion-Amplified Low-Risk Breadth 20",
  "version": "20330916",
  "calculation": {
    "expression": "shift_1(((mean(I[r_i>0],20)-0.5)/(std(r_i,20)+epsilon)) * clip(cross_sectional_dispersion_20 / median(cross_sectional_dispersion_20,252),0.5,2.0))",
    "description": "For each tradable asset, measure 20-session directional breadth centered at zero and scale it by its 20-session return volatility. Amplify the cross-section during elevated, lagged 20-session cross-asset dispersion relative to its trailing 252-session median. The entire signal is lagged one completed session to prevent look-ahead.",
    "signal_artifact": "scripts/miner_3_20330916_dispersion_amplified_breadth20_signal.csv"
  },
  "dependencies": ["close"],
  "parameters": {"breadth_window":20,"dispersion_window":20,"dispersion_baseline_window":252,"minimum_window":15,"scale_floor":0.5,"scale_cap":2.0,"forecast_horizon":10,"lag":1},
