{
  "factor_id": "miner_3_20260730_cross_asset_residual_reversal",
  "factor_name": "Cross-Asset Median-Residual Volatility-Scaled Reversal",
  "version": "20260730",
  "calculation": {
    "expression": "-(return_1d_asset - cross_sectional_median(return_1d_all_tradable_assets)) / rolling_std((return_1d_asset - cross_sectional_median(return_1d_all_tradable_assets)), 40)",
    "description": "Reverses an asset's completed daily return relative to the same-day median return of the 15 tradable benchmark instruments, then scales by trailing 40-observation volatility of that residual. Cross-sectional median is formed only from completed observations available on that date."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "cross_section": "15 tradable benchmark instruments",
    "residual_window": 40,
