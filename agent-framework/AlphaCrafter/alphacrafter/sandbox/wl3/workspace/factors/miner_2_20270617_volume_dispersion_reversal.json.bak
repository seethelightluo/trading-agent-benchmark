{
  "factor_id": "miner_2_20270617_volume_dispersion_reversal",
  "factor_name": "Volume-Amplified Dispersion-Conditioned Risk-Normalized Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "clip((-return_10d / (rolling_std(return_1d,40)*sqrt(40))) * clip(1+0.25*tanh(log(volume/rolling_median(volume,30))),0.75,1.25) * clip(1+0.25*tanh(dispersion_z120),0.75,1.25), -8, 8)",
    "description": "Cross-asset ten-day reversal normalized by 40-day realized risk, amplified modestly by unusual volume and elevated 20-day cross-sectional dispersion. All rolling quantities use data available through the signal date. Volume is clipped before the log transform and the final signal is clipped for robustness."
  },
  "dependencies": [
    "close",
    "volume"
  ],
  "parameters": {
    "reversal_lookback_days": 10,
    "risk_window_days": 40,
    "volume_median_window_days": 30,
    "dispersion_window_days": 20,
    "dispersion_z_window_days": 120,
    "volume_amplitude": 0.25,
    "dispersion_amplitude": 0.25,
    "signal_clip": 8,
    "minimum_cross_section": 8
  },
