{
  "factor_id": "miner_1_20260730_relative_vol_dispersion_3d",
  "factor_name": "Volatility-Normalized Relative Dispersion Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(sum_{i=0..2} return[t-i] - cross_sectional_median(sum_3d_return)) / rolling_std(daily_return,20)",
    "description": "Ranks assets that underperformed the cross-sectional median over three sessions, normalized by each asset's trailing 20-session realized volatility. Higher values indicate stronger relative-reversal opportunity. All inputs are lagged and evaluated only after the prior completed session."
  },
  "dependencies": ["close"],
  "parameters": {"lookback_return_days": 3, "volatility_window_days": 20, "minimum_volatility_observations": 15, "minimum_cross_section": 8, "universe_size": 15},
  "validation": {
