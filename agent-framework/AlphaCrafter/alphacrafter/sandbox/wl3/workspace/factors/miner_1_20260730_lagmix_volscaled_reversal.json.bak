{
  "factor_id": "miner_1_20260730_lagmix_volscaled_reversal",
  "factor_name": "Lag-Mixed Volatility-Scaled 3-Day Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "( -pct_change(close,3)/rolling_std(pct_change(close,1),20) + 0.5 * lag(-pct_change(close,3)/rolling_std(pct_change(close,1),20),1) ) / 1.5",
    "description": "Cross-sectional reversal score, combining the current observable three-day volatility-scaled reversal with a half-weight one-day lag to reduce sensitivity to a single daily shock. Higher values indicate stronger recent underperformance after risk scaling and hence a stronger reversal preference."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "reversal_window_days": 3,
    "volatility_window_days": 20,
    "lag_days": 1,
    "lag_weight": 0.5,
    "forward_horizon_days": 1,
    "min_cross_section": 8
  },
