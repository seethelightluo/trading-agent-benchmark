{
  "factor_id": "miner_3_20271216_rap_momentum",
  "factor_name": "Risk-Adjusted 20-Day Momentum",
  "version": "1.0",
  "calculation": {
    "expression": "(sum(return,20) / std(return,20)).shift(1)",
    "description": "Ranks assets by lagged 20-session cumulative return normalized by 20-session realized volatility. Higher values indicate stronger risk-adjusted momentum."
  },
  "dependencies": ["close"],
  "parameters": {"return_window": 20, "volatility_window": 20, "minimum_observations": 15, "lag": 1},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2027-12-15",
    "metrics": {"horizon_days": 5, "ic": 0.0143932, "icir": 2.3628, "hit_ratio": 0.5238, "coverage": 0.9685, "turnover": 0.0819, "observations": 2736, "average_instruments": 14.62, "max_abs_library_correlation": null},
    "regime_notes": "Positive medium-horizon relationship; daily horizon is weakly negative while 5-10 day horizons are positive. Conservative interpretation for 15-asset cross-section.",
    "validation_timestamp": "2027-12-16T00:00:00Z",
    "signal_artifact": "scripts/miner_3_20271216_rap_momentum_signal.csv"
  },
  "tags": ["momentum", "risk_adjusted", "cross_asset"]
}
