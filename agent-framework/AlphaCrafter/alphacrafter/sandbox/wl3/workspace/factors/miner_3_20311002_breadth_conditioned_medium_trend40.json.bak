{
  "factor_id": "miner_3_20311002_breadth_conditioned_medium_trend40",
  "factor_name": "Breadth-Conditioned Volatility-Scaled 40-Day Trend",
  "version": "1.0",
  "calculation": {
    "expression": "shift(1, (log(close/close[-40]) / (std(log_returns,60)*sqrt(252))) * I(rolling_mean_10(cross_sectional_fraction(log(close/close[-40])>0)) >= 0.50)",
    "description": "Ranks assets by 40-trading-day return scaled by 60-day annualized realized volatility, activated only when the trailing 10-session cross-asset participation breadth is at least 50 percent. The complete signal is lagged one session to prevent lookahead."
  },
  "dependencies": ["close"],
  "parameters": {"trend_window": 40, "volatility_window": 60, "breadth_window": 10, "breadth_threshold": 0.50, "forecast_horizon": 10, "lag": 1, "min_cross_section": 8},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2031-10-01",
    "metrics": {
      "ic": 0.06090054,
      "icir": 0.17613390,
      "hit_ratio": 0.5782,
      "valid_dates": 1503,
      "average_instruments": 14.92149,
      "coverage": 0.994766,
      "turnover": 0.0318420,
      "max_abs_library_correlation": null,
      "horizon_days": 10
    },
    "regime_notes": "Positive aggregate IC/ICIR across 2020-2022, 2023-2025, 2026-2027, 2028-2030, and 2031 YTD; recent 120 observations are approximately flat and require monitoring. Small 15-asset cross-section implies conservative interpretation of IC uncertainty.",
    "signal_artifact": "scripts/miner_3_20311002_medium_trend_signal.csv"
  },
  "tags": ["momentum", "trend", "volatility_scaled", "breadth_conditioned", "cross_asset"],
