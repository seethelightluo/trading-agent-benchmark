{
  "factor_id": "miner_2_20340106_smoothed_residual_momentum20_40",
  "factor_name": "Three-session smoothed volatility-scaled residual momentum 20/40",
  "version": "1.0",
  "calculation": {
    "expression": "shift(rolling_mean(0.70*residual_return(20)/[std_return(30)*sqrt(20)] + 0.30*residual_return(40)/[std_return(40)*sqrt(40)], 3), 1)",
    "description": "For each asset, subtract the cross-sectional mean log return over the lookback from its own log return, scale 20-session residual momentum by 30-session volatility and 40-session residual momentum by 40-session volatility, blend 70/30, smooth over three observations, and lag one session to avoid look-ahead. Higher values indicate stronger residual trend."
  },
  "dependencies": ["close"],
  "parameters": {"short_lookback": 20, "medium_lookback": 40, "short_vol_window": 30, "medium_vol_window": 40, "short_weight": 0.70, "medium_weight": 0.30, "smoothing_window": 3, "lag": 1, "forward_horizon": 10},
