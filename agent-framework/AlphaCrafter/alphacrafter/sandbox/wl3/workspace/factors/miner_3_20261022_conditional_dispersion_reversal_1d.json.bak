{
  "factor_id": "miner_3_20261022_conditional_dispersion_reversal_1d",
  "factor_name": "High-Dispersion Risk-Scaled One-Day Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "I(D_t > median_60d(D)) * (-return_1d / rolling_std(return_1d,20))",
    "description": "Risk-scaled one-day reversal activated only when cross-asset mean absolute daily return exceeds its trailing 60-day median; all inputs are known at the prior completed close."
  },
  "dependencies": [
    "close",
    "cross_asset_returns"
  ],
  "parameters": {
    "volatility_window": 20,
