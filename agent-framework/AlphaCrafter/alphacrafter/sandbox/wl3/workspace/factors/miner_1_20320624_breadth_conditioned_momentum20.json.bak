{
  "factor_id": "miner_1_20320624_breadth_conditioned_momentum20",
  "factor_name": "Cross-Asset Breadth-Conditioned Momentum 20D",
  "version": "1.0",
  "calculation": {
    "expression": "rolling_mean_5((log(close/close[-20])) * (1 + 0.6 * (breadth20 - 0.5) * 2)).shift(1)",
    "description": "Twenty-session log momentum is scaled by contemporaneous cross-asset breadth, where breadth is the fraction of the 15 tradable instruments with positive 20-session momentum. The signal is smoothed over five sessions and lagged one completed session to prevent look-ahead."
  },
  "dependencies": ["close"],
  "parameters": {"momentum_window": 20, "breadth_definition": "fraction of tradable assets with positive 20D log momentum", "breadth_scale": 0.6, "smoothing_window": 5, "signal_lag": 1, "forward_horizon": 10},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2032-06-24",
    "last_validated": "2032-06-24",
    "metrics": {
      "ic": 0.0383286405,
      "icir": 0.0893764273,
      "dates": 3902,
      "average_instruments": 15.0,
      "coverage": 0.9999,
      "turnover": 0.0301842155,
      "hit_ratio": 0.5386981035,
      "max_abs_library_correlation": null
    },
    "regime_notes": "Positive ICIR in 2020-2025 and 2031-2032, negative in 2026-2030; recent 120-session IC 0.26509 and ICIR 0.52653, recent 252-session IC 0.13119 and ICIR 0.29376. Small cross-asset sample implies conservative uncertainty interpretation.",
    "artifacts": {
      "signal": "scripts/miner_1_20320624_breadth_conditioned_momentum20_signal.csv",
