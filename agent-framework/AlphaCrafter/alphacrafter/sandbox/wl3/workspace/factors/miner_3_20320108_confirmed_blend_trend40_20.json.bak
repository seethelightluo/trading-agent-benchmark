{
  "factor_id": "miner_3_20320108_confirmed_blend_trend40_20",
  "factor_name": "Breadth-confirmed blended 40/20-day downside-risk-adjusted trend",
  "version": "1.0",
  "calculation": {
    "expression": "shift_1(((log(close/close_40d_ago)/2 + log(close/close_20d_ago)/2) / (sqrt(mean(clip(log_returns, upper=0)^2, window=40))*sqrt(252))) * I(rolling_mean_10(cross_sectional_fraction(log_return_20d>0)) >= 0.50))",
    "description": "Blends medium and shorter-term log momentum, scales by annualized downside semideviation, and activates only when 10-day cross-sectional breadth confirms at least half of assets have positive 20-day returns; lagged one session to prevent look-ahead."
  },
  "dependencies": ["close"],
  "parameters": {"long_window": 40, "short_window": 20, "downside_window": 40, "breadth_window": 10, "breadth_return_window": 20, "breadth_threshold": 0.5, "blend_weights": [0.5, 0.5], "annualization": 252, "signal_lag": 1, "forward_horizon": 10},
  "validation": {
    "status": "EFFECTIVE",
    "period": {"start": "2020-01-01", "end": "2032-01-07", "data_through": "2032-01-07"},
    "metrics": {"ic": 0.06740013, "icir": 0.19438572, "hit_ratio": 0.5882, "valid_dates": 1462, "average_instruments": 14.88372093, "coverage": 0.99224806, "turnover": 0.03353095, "max_abs_library_correlation": null},
    "regime_notes": "Passed benchmark gates across 1,462 date-level cross-sectional observations and 15 assets. IC/ICIR were positive in 2020-2022 and 2023-2025, very strong in 2026-2027, and negative in sparse 2028 and 2031 observations. Recent 120/252-observation IC remained strong (+0.14565/+0.14055), while the latest 60 observations were negative (-0.05410), indicating short-term regime drift requiring monitoring.",
    "signal_artifact": "scripts/miner_3_20320108_confirmed_blend_signal.csv",
    "ic_artifact": "scripts/miner_3_20320108_confirmed_blend_ic.csv",
    "validation_timestamp": "2032-01-08T00:00:00Z"
  },
  "tags": ["momentum", "trend", "downside-risk", "breadth-conditioned", "multi-horizon", "cross-asset"],
