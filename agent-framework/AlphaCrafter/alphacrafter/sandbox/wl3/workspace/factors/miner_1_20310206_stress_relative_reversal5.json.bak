{
  "factor_id": "miner_1_20310206_stress_relative_reversal5",
  "factor_name": "VIX-Stress Conditioned Relative Reversal 5D",
  "version": "2031-02-06",
  "calculation": {
    "expression": "I(VIX > rolling_median(VIX,60) AND VIX.pct_change(5)>0) * (-(asset_return_5d - cross_sectional_median(asset_return_5d)) / rolling_std(daily_log_return,20))",
    "description": "During elevated and rising observation-only VIX stress, rank assets that underperformed their cross-asset median on a volatility-scaled 5-session basis for contrarian rebound exposure. Zero signal outside stress."
  },
  "dependencies": ["close", "VIX observation-only close"],
  "parameters": {"return_window": 5, "volatility_window": 20, "vix_median_window": 60, "vix_rise_window": 5, "minimum_cross_section": 8},
