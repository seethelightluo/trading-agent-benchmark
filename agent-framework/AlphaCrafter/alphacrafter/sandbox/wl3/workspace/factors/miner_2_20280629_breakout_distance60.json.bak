{
  "factor_id": "miner_2_20280629_breakout_distance60",
  "factor_name": "ATR-Normalized Distance from 60D High",
  "version": "1.0",
  "calculation": {
    "expression": "((close / rolling_max(close,60)) - 1) / rolling_mean((high-low)/close,20), shifted by 1 session",
    "description": "Ranks assets by their lagged distance below the trailing 60-session high, normalized by recent average daily range. Less-negative values identify assets closer to breakout highs while controlling for scale and volatility. The one-session lag prevents use of the decision day's data."
  },
  "dependencies": [
    "close",
    "high",
    "low"
  ],
  "parameters": {
    "high_lookback": 60,
    "range_lookback": 20,
    "minimum_high_observations": 45,
    "minimum_range_observations": 15,
    "signal_lag": 1,
    "forward_horizons": [
      1,
      3,
      5,
      10
    ]
  },
