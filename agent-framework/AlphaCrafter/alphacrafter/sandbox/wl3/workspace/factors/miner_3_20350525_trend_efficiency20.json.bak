{
  "factor_id": "miner_3_20350525_trend_efficiency20",
  "factor_name": "20-session trend efficiency",
  "version": "1.0",
  "calculation": {
    "expression": "pct_change(close,20) / rolling_sum(abs(pct_change(close,1)),20)",
    "description": "Net 20-session return divided by the 20-session path length of absolute daily returns; higher values indicate persistent directional movement rather than choppy price action. Signals use only completed sessions."
  },
  "dependencies": ["close"],
  "parameters": {"trend_window": 20, "path_window": 20, "forward_horizon": 10, "min_periods": 15},
