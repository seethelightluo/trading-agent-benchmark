{
  "factor_id": "miner_2_20350413_trend60_contrarian",
  "factor_name": "Volatility-Normalized Medium-Trend Contrarian",
  "version": "20350413",
  "calculation": {
    "expression": "-sum(return, 60 sessions) / (rolling_std(daily_return, 60 sessions) * sqrt(252)), evaluated after the completed session and lagged one session",
    "description": "Ranks assets with weaker recent volatility-adjusted medium-term trends more highly, implementing a cross-sectional contrarian signal. Inputs are lagged and forward returns are measured over the next 10 trading sessions."
  },
  "dependencies": ["close", "date"],
  "parameters": {
    "trend_window": 60,
    "volatility_window": 60,
    "forward_horizon_days": 10,
    "lag_sessions": 1,
    "minimum_cross_section": 8
  },
