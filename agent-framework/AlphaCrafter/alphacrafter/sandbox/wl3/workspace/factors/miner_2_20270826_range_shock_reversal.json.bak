{
  "factor_id": "miner_2_20270826_range_shock_reversal",
  "factor_name": "Range Shock Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "clip(cross_sectional_median_demean(-sum(pct_change(close),3) * ((high-low)/close) / rolling_median_30((high-low)/close)), -6, 6)",
    "description": "Fades the trailing three-session return more strongly when the completed session's high-low range is unusually large relative to its trailing 30-session median range. All inputs are available through the completed signal date."
  },
  "dependencies": [
    "close",
    "high",
    "low"
  ],
  "parameters": {
    "return_window": 3,
    "range_baseline_window": 30,
    "range_baseline_min_periods": 20,
    "clip": 6,
    "cross_sectional_demean": "median"
  },
