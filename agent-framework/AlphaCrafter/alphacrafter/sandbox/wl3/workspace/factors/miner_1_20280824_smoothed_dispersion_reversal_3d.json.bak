{
  "factor_id": "miner_1_20280824_smoothed_dispersion_reversal_3d",
  "factor_name": "Three-day smoothed high-dispersion reversal",
  "version": "1.0",
  "calculation": {
    "expression": "mean((-return_1d * I(cross_sectional_dispersion > rolling_median(dispersion,60))).shift(1),3)",
    "description": "For each tradable asset, negate its one-session return only on sessions whose cross-sectional return dispersion exceeds the trailing 60-session median, lag the signal one session, and average the latest three lagged signals. Forward returns are measured from the decision-date close, avoiding look-ahead."
  },
  "dependencies": ["close", "pct_change"],
  "parameters": {"dispersion_window": 60, "threshold": "trailing_median", "smoothing_window": 3, "minimum_cross_section": 8},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2028-08-23",
    "last_validated": "2028-08-24",
