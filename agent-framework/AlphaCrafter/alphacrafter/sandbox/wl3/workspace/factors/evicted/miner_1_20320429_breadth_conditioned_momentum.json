{
  "factor_id": "miner_1_20320429_breadth_conditioned_momentum",
  "factor_name": "Breadth-Conditioned Risk-Adjusted Momentum",
  "version": "1.0",
  "calculation": {
    "expression": "sign((cross_sectional_breadth(rolling_sum(log_return,20)>0)>=0.5)-0.5) * rolling_mean(rolling_sum(log_return,40)/rolling_std(log_return,20),3), lag=1",
    "description": "Compute each asset's 40-session log momentum divided by 20-session realized volatility, multiply by the sign of aggregate 20-session positive-return breadth (positive when at least half of assets are positive, negative otherwise), smooth over three sessions, and lag one session. Evaluate against 10-session forward log returns."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "momentum_window": 40,
    "volatility_window": 20,
    "breadth_window": 20,
    "breadth_threshold": 0.5,
    "smooth_window": 3,
    "lag": 1,
    "forward_horizon": 10,
    "min_cross_section": 8
  },
