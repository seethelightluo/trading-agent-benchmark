  "factor_name": "60-Day High Breakout Distance, Volatility-Normalized",
  "version": "1.0",
  "calculation": {
    "expression": "((close / rolling_max(close, 60, min_periods=40)) - 1) / rolling_std(pct_change(close), 30, min_periods=20), lagged 1 session",
