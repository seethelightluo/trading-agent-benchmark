{
  "factor_id": "miner_3_20340106_dispersion_weighted_residual_momentum20",
  "factor_name": "Dispersion-Weighted Volatility-Normalized Cross-Asset Residual Momentum 20",
  "version": "1.0",
  "calculation": {
    "expression": "shift(rolling_mean((daily_log_return - cross_sectional_mean_daily_log_return) / rolling_std(daily_log_return,30),20),1) * (0.5 + percentile_rank(rolling_rank(cross_sectional_return_dispersion,60), cross_sectional_time))",
    "description": "Compute lagged 20-session volatility-normalized residual momentum for each tradable asset and multiply it by a common market-dispersion weight. The dispersion weight is 0.5 plus the trailing 60-session percentile rank of cross-sectional residual-return dispersion, emphasizing signals when cross-asset differentiation is elevated. All inputs are lagged before the forward-return test."
