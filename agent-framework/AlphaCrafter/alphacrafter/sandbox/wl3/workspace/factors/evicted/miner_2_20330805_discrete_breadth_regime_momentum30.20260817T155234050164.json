{
  "factor_id": "miner_2_20330805_discrete_breadth_regime_momentum30",
  "factor_name": "Discrete Breadth-Regime Risk-Adjusted Relative Momentum 30D",
  "version": "2033-09-02",
  "calculation": {
    "expression": "shift( (log(close_t/close_t-30) - cross_sectional_median) / annualized_std(log_return,30) * regime, 1)",
    "description": "Cross-sectional 30-session relative momentum scaled by 30-session annualized volatility. regime is +1 when at least 60% of instruments trade above their 50-session moving average, -1 when at most 40% do, and 0 otherwise; weak-breadth regimes therefore invert the signal. Lagged one session to avoid look-ahead."
