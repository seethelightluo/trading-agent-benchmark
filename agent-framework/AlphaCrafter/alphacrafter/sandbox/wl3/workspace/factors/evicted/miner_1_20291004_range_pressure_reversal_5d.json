  "version": "1.0",
  "calculation": {
    "expression": "-((log(close/close[-3])/(rolling_std(log_returns,30)*sqrt(3))) * (1 + clip(rolling_mean((close-open)/(high-low),5),-1,1)) * sigmoid(-log(close/close[-30])/0.10)).shift(1), cross-sectional median demean",
