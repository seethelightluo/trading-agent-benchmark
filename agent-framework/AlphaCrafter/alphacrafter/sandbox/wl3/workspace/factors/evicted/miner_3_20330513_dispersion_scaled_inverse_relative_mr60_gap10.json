{
  "factor_id": "miner_3_20330513_dispersion_scaled_inverse_relative_mr60_gap10",
  "factor_name": "Dispersion-scaled inverse relative mean reversion (60d, gap 10)",
  "version": "1.0",
  "calculation": {
    "expression": "(-((log(close_t/log(close_{t-60})) - cross_sectional_median) / (sqrt(40)*rolling_std(diff(log(close),40)))) * clip(dispersion20 / rolling_median(dispersion20,252), 0.5, 2.0)).shift(11)",
    "description": "Fades 60-session relative performance versus the cross-sectional median, volatility normalizes each asset, and scales the signal by the current 20-session cross-asset dispersion regime. The 10-session information gap and one-session lag prevent look-ahead for a 10-session forward return."
