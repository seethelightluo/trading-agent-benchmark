  "factor_name": "VIX-Conditioned Five-Day Cross-Asset Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-return(close,5) * (1 + 0.75*clip(zscore(VIX,60),0,2)), lagged 1 session",
    "description": "Ranks assets by the negative of their prior five-session return, with reversal magnitude amplified when observation-only VIX is above its rolling 60-session mean. VIX is used solely as a macro conditioning signal; it is not tradable. All prices and VIX observations are lagged by one completed session before signal use."
  },
  "dependencies": [
    "close",
    "VIX close",
    "date"
  ],
  "parameters": {
    "lookback_return": 5,
    "vix_zscore_window": 60,
    "stress_multiplier": 0.75,
