  "factor_name": "Slow Downside-Adjusted Quiet-Regime Residual Trend 40",
  "version": "1.0",
  "calculation": {
    "expression": "shift1((cross_sectional_log_return - cross_sectional_mean).rolling(40).mean / rolling_downside_std(45) * (1 - 0.4 * lagged_90d_dispersion_percentile))",
