  "factor_name": "Dispersion-Scaled Inverse Relative Mean Reversion 60d Gap15",
  "version": "1.0",
  "calculation": {
    "expression": "-((log(close_t/close_t-60) - cross_sectional_median(log(close_t/close_t-60)))/(rolling_std(diff(log(close)),40)*sqrt(40))) shifted 16 sessions",
