  "factor_name": "Breadth-Conditioned Relative Trend 20D",
  "version": "1.0",
  "calculation": {
    "expression": "shift1(((close/close[-20]-1)-cross_sectional_median_20d_return)/rolling_std(daily_return,30) * clip(2*(rolling_mean_20(daily_return>0)-0.5),-1,1))",
    "description": "Cross-asset relative 20-day momentum, risk scaled by 30-day volatility, multiplied by a continuous market breadth regime. Broad positive breadth preserves trend direction; broad negative breadth reverses it. Signal is lagged one day to prevent look-ahead."
