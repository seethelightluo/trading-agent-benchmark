  "factor_name": "Blended volatility-scaled residual momentum 20/40",
  "version": "1.0",
  "calculation": {
    "expression": "lag1(0.65*((log_close-log_close_lag20)-cross_section_mean)/((rolling_std(daily_log_return,30)*sqrt(20))+eps) + 0.35*((log_close-log_close_lag40)-cross_section_mean)/((rolling_std(daily_log_return,40)*sqrt(40))+eps))",
    "description": "A lagged blend of 20- and 40-session cross-sectional residual log momentum, independently scaled by trailing realized volatility. The one-session lag prevents use of the current completed session in the signal."
