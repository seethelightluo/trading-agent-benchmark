  "version": "1.0",
  "calculation": {
    "expression": "shift1(rolling_mean_5((close/close_lag20 - 1) / (sqrt(20)*std(log_returns,20)) * clip(0.5 + 1.5*(rolling_mean_5(cross_sectional_fraction_positive(return20))-0.5),0.15,0.85)))",
    "description": "Twenty-day risk-adjusted momentum, smoothed over five sessions and lagged one session. The signal is scaled by lagged-free cross-asset breadth: broad participation increases trend exposure while weak breadth reduces it. Forward returns are never used in the signal."
