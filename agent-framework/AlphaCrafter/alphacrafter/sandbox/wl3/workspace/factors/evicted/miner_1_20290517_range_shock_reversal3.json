{
  "factor_id": "miner_1_20290517_range_shock_reversal3",
  "factor_name": "Range-shock volatility-scaled 3-day reversal",
  "version": "1.0",
  "calculation": {
    "expression": "(-pct_change(close,3) / rolling_std(pct_change(close,1),20)) * (rolling_mean((high-low)/close,5) / rolling_mean((high-low)/close,60))",
    "description": "A short-horizon reversal signal, volatility normalized and amplified when the recent five-day average high-low range is unusually wide relative to its 60-day baseline. Signal is evaluated cross-sectionally using Spearman rank IC. All inputs are lagged by the decision cutoff in live use."
  },
  "dependencies": [
    "close",
    "high",
    "low"
  ],
  "parameters": {
    "reversal_lookback_days": 3,
    "volatility_window_days": 20,
    "range_short_window_days": 5,
    "range_baseline_window_days": 60,
    "minimum_valid_cross_section": 8
  },
