{
  "factor_id": "miner_2_20291101_drawdown_bounce",
  "factor_name": "Volatility-normalized drawdown bounce reversal",
  "version": "2029-11-01",
  "calculation": {
    "expression": "cross_sectional_demean((-log(close/close.shift(5)) / (rolling_std(log_returns,60)*sqrt(5))) * (1 + clip(-(close/rolling_max(close,60)-1),0,0.6)).shift(0), then lag 1 day)",
    "description": "Reverses the five-session return, normalizes by 60-session realized volatility, and increases the reversal score for assets farther below their rolling 60-session peak. The drawdown boost is capped at 0.6, followed by daily cross-sectional median demeaning and a one-session execution lag."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "reversal_window": 5,
    "volatility_window": 60,
    "drawdown_window": 60,
    "drawdown_cap": 0.6,
    "lag": 1,
    "cross_sectional_center": "median"
  },
