  "version": "2029-10-18",
  "calculation": {
    "expression": "demean_cs((-log(close/close[-5]) * abs(log(close/close[-5])) / (rolling_std(log_return,60)*sqrt(5))) * clip(cross_asset_dispersion_5 / rolling_median(cross_asset_dispersion_5,120), 0.35, 2.5), lag=1)",
