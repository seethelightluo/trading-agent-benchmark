{
  "factor_id": "miner_1_20330805_continuous_dispersion_trend_accel",
  "factor_name": "Continuous Dispersion-Scaled Trend Acceleration 20/60",
  "version": "1.0",
  "calculation": {
    "expression": "clip(CSDisp20 / median(CSDisp20,252), 0.5, 1.5) * (log(P/P[-20]) - log(P/P[-60])/3) / (std(log_returns,40)*sqrt(40))",
    "description": "Volatility-normalized medium-term trend acceleration multiplied by a bounded continuous cross-asset dispersion regime scaler. Signal is lagged one completed session to prevent look-ahead. Cross-asset dispersion is the 20-session mean of the cross-sectional standard deviation of daily log returns across the 15 tradable instruments."
  },
