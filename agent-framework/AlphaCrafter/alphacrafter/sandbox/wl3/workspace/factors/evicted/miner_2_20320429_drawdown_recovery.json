  "factor_name": "60D Drawdown Recovery Ratio",
  "version": "1.0",
  "calculation": {
    "expression": "SMA5((close - rolling_min(close,20)) / (abs(min(close - rolling_max(close,60),0)) + 0.02)) shifted by 1 day",
    "description": "Ranks assets by rebound from their recent 20-day trough, normalized by the severity of the current 60-day drawdown. The one-day lag prevents look-ahead."
