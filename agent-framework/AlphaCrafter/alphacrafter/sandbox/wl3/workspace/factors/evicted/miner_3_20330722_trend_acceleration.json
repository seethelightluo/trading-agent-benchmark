{
  "factor_id": "miner_3_20330722_trend_acceleration",
  "factor_name": "Volatility-Normalized Medium Trend Acceleration",
  "version": "1.0",
  "calculation": {
    "expression": "(log(close_t/close_{t-20}) - (1/3)*log(close_t/close_{t-60})) / (std(log_returns_{t-39:t}) * sqrt(40)); signal = expression.shift(1)",
    "description": "Measures whether the recent 20-session trend is stronger than the average per-20-session pace implied by the prior 60-session move, normalized by 40-session realized volatility. The one-session lag ensures only completed daily data are used. Positive values indicate accelerating upward trend."
