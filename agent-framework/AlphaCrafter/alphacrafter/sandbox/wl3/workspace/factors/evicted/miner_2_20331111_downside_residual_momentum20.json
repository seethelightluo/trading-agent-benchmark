  "factor_name": "20-Session Downside-Risk-Adjusted Residual Momentum",
  "version": "20331111",
  "calculation": {
    "expression": "lag1((log_close_i[t]-log_close_i[t-20] - cross_section_mean_i(log_close[t]-log_close[t-20])) / (sqrt(20)*rolling_std_20(min(daily_log_return_i,0))))",
    "description": "Ranks tradable instruments by 20-session return residual to the equal-weight cross-asset benchmark, scaled by each instrument's downside deviation over the same window and lagged one completed session. Higher values indicate stronger relative momentum per unit downside risk."
