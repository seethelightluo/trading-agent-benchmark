  "factor_name": "Breadth-Conditioned Volatility-Scaled 40-Day Trend",
  "version": "1.0",
  "calculation": {
    "expression": "shift(1, (log(close/close[-40]) / (std(log_returns,60)*sqrt(252))) * I(rolling_mean_10(cross_sectional_fraction(log(close/close[-40])>0)) >= 0.50)",
    "description": "Ranks assets by 40-trading-day return scaled by 60-day annualized realized volatility, activated only when the trailing 10-session cross-asset participation breadth is at least 50 percent. The complete signal is lagged one session to prevent lookahead."
