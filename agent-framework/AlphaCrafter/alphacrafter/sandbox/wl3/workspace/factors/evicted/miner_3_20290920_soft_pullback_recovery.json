{
  "factor_id": "miner_3_20290920_soft_pullback_recovery",
  "factor_name": "Soft Trend-Conditioned Volatility-Normalized Pullback Recovery",
  "version": "1.0",
  "calculation": {
    "expression": "cross_sectional_demean(shift(-log(close/close[-5]) / (std(log_returns,60)*sqrt(5)) * (0.35 + 0.65*sigmoid((close/close[-60]-1)/0.08)), 1))",
    "description": "Ranks recent five-session losers for rebound potential, scaled by 60-session volatility. A smooth trend-state multiplier gives greater weight to pullbacks in established uptrends while retaining coverage in neutral or weak trends. The one-session lag prevents look-ahead."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "loss_window": 5,
    "volatility_window": 60,
    "trend_window": 60,
    "trend_scale": 0.08,
    "base_gate": 0.35,
    "trend_gate_range": [
      0.35,
      1.0
    ],
    "lag": 1,
    "cross_sectional_demean": "median"
  },
