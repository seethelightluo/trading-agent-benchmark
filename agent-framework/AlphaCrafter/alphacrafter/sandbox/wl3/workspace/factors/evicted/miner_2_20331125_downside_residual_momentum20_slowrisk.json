  "factor_name": "Downside residual momentum 20 with slow downside risk",
  "version": "1.0",
  "calculation": {
    "expression": "shift(1, (log(close)-log(close[-20]) - cross_sectional_mean) / (sqrt(20) * rolling_std(negative_only(log_return), 40)))",
    "description": "Compute each asset's 20-session log return relative to the equal-weight cross-asset mean, scale by its 40-session downside deviation, and lag one session to prevent look-ahead."
