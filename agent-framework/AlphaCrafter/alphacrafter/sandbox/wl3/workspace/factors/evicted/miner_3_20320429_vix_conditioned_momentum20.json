  "factor_name": "VIX-conditioned downside-adjusted momentum 20D",
  "version": "1.0",
  "calculation": {
    "expression": "rolling_mean_5((sum(log_return,20)/sqrt(mean(min(log_return,0)^2,20))) * (1 - percentile_rank(VIX,252)),5).shift(1)",
