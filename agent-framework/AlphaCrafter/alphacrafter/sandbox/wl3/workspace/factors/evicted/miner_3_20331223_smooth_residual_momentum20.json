  "factor_name": "Smoothed Volatility-Normalized Cross-Asset Residual Momentum 20",
  "version": "1.0",
  "calculation": {
    "expression": "shift(ewm_mean(span=5, rolling_mean_20((daily_log_return - cross_sectional_mean_daily_log_return) / rolling_std_30), min_periods=15), 1)",
    "description": "For each tradable asset, subtract the same-day cross-sectional mean log return, normalize by its trailing 30-session volatility, average the normalized residual return over 20 sessions, then apply a 5-session exponential smoothing and lag one session. The lag prevents use of the current session in decisions."
