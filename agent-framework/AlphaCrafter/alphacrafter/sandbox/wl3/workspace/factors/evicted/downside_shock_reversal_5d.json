{
  "factor_id": "downside_shock_reversal_5d",
  "factor_name": "VIX-Gated Downside Shock Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-((sum(log_return,5) - cross_sectional_median(sum(log_return,5))) / downside_realized_volatility_20) * VIX_stress_gate, lagged_1",
    "description": "Ranks assets for reversal after a five-session relative downside shock, scaled by 20-session downside volatility. The signal is active when VIX exceeds its 60-session mean by 0.15 rolling standard deviations; all inputs are lagged one completed session."
  },
  "dependencies": [
    "close",
    "VIX"
  ],
  "parameters": {
    "shock_window": 5,
    "downside_vol_window": 20,
    "vix_window": 60,
    "vix_threshold_std": 0.15,
    "lag": 1,
    "min_cross_section": 8
  },
