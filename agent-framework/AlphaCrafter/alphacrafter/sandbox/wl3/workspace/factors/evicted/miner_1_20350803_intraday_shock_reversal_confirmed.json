  "factor_name": "Confirmed ATR-normalized intraday shock reversal",
  "version": "1.0",
  "calculation": {
    "expression": "mean_3(-(open_t/close_{t-1}-1)/(ATR20_{t-1}/close_{t-1})) * (1 + 0.5*sign(-return_10d_t))",
