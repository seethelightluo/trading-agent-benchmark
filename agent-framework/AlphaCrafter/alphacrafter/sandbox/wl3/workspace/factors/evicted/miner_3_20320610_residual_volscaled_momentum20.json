  "factor_name": "Volatility-Scaled Cross-Asset Residual Momentum 20D",
  "version": "1.0",
  "calculation": {
    "expression": "mean5(rolling_sum(residual_return_20d,20) / (rolling_std(asset_return,20)*sqrt(20))).shift(1)",
