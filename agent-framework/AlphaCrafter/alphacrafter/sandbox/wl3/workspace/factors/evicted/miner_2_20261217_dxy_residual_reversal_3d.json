  "factor_name": "DXY-beta residual three-day reversal",
  "version": "2026-12-17",
  "calculation": {
    "expression": "-sum_{3d}(asset_return - rolling_beta_60d(asset_return,DXY_return)*DXY_return) / (sqrt(3)*rolling_std_20d(residual_return))",
