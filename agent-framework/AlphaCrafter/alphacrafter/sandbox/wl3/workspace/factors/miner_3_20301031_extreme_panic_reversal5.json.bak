{
  "factor_id": "miner_3_20301031_extreme_panic_reversal5",
  "factor_name": "Extreme Broad-Selloff Panic Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-rolling_sum(log(close/close[-1]),3) * I(breadth_3d <= 0.25)",
    "description": "Fade each asset's lagged three-day log return only when no more than 25% of the 15 tradable assets had positive three-day returns. Signal is observed at date t and evaluated after a one-day execution lag.",
    "lookahead_control": "Forward returns begin at the first completed return strictly after signal date."
  },
  "dependencies": ["close"],
  "parameters": {"return_window_days": 3, "breadth_threshold": 0.25, "holding_horizons_days": [5,10,20], "min_cross_section": 8},
  "validation": {
