{
  "factor_id": "miner_2_20281019_intraday_gap_reversal",
  "factor_name": "Lagged Cross-Asset Intraday Shock Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-((close_t / open_t) - 1), shifted by one completed session",
    "description": "For each tradable benchmark instrument, reverse the prior session open-to-close return. The signal is lagged one session and evaluated cross-sectionally against forward close-to-close returns."
