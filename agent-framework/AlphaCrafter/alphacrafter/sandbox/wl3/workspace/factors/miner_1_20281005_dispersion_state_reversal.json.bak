  "factor_name": "Dispersion-State Volatility-Scaled Reversal 5D",
  "version": "1.0",
  "calculation": {
    "expression": "(-return_5d / rolling_std(daily_return,20)) * clip(rolling_mean(cross_asset_daily_return_dispersion,20) / rolling_median(previous_60d_dispersion_ratio,60), 0.5, 2.0), lagged one session",
    "description": "Ranks assets by five-session reversal normalized by their own 20-session volatility, with signal magnitude scaled by the prevailing cross-asset dispersion state. The signal is lagged one completed session to avoid lookahead."
  },
  "dependencies": ["close", "daily_return"],
  "parameters": {"reversal_window": 5, "volatility_window": 20, "dispersion_window": 20, "dispersion_baseline_window": 60, "state_clip": [0.5, 2.0], "lag": 1},
