{
  "factor_id": "miner_2_20341124_trend_acceleration20_60",
  "factor_name": "Volatility-Normalized 20-Day Trend Acceleration",
  "version": "20341124",
  "calculation": {
    "expression": "(return_20d - return_60d / 3) / (rolling_std(daily_return, 30) * sqrt(20)), shifted by 1 completed session",
    "description": "Measures whether the recent 20-session return is accelerating relative to the average 20-session pace implied by the prior 60 sessions, scaled by 30-session daily volatility. Higher values indicate strengthening intermediate trend; the one-session lag prevents lookahead."
  },
  "dependencies": [
    "close",
    "date"
  ],
  "parameters": {
    "short_window": 20,
    "long_window": 60,
    "volatility_window": 30,
    "lag_sessions": 1,
    "minimum_cross_section": 8
  },
