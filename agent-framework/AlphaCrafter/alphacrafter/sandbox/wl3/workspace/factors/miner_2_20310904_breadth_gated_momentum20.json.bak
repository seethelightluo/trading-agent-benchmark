{
  "factor_id": "miner_2_20310904_breadth_gated_momentum20",
  "factor_name": "Breadth-gated volatility-scaled 20-day momentum",
  "version": "1.0",
  "calculation": {
    "expression": "((log(close_t/close_{t-20}) / (std(log_returns_{t-29:t})*sqrt(252))) * (cross_sectional_breadth_{t}-0.5)).shift(1)",
    "description": "Volatility-normalized 20-day momentum multiplied by lagged market breadth deviation from neutral. Breadth is the fraction of the 15 tradable assets with positive 20-day mean log return; all inputs are shifted one session before forecasting. Positive breadth reinforces momentum in broad risk-on conditions and reverses it in broad risk-off conditions."
  },
  "dependencies": ["close", "daily_returns"],
  "parameters": {"momentum_window": 20, "volatility_window": 30, "annualization": 252, "breadth_window": 20, "breadth_center": 0.5, "signal_lag": 1, "forward_horizon_for_admission": 10, "universe_size": 15},
  "validation": {
