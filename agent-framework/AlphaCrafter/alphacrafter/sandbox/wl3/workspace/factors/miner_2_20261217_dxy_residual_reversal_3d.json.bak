{
  "factor_id": "miner_2_20261217_dxy_residual_reversal_3d",
  "factor_name": "DXY-beta residual three-day reversal",
  "version": "2026-12-17",
  "calculation": {
    "expression": "-sum_{3d}(asset_return - rolling_beta_60d(asset_return,DXY_return)*DXY_return) / (sqrt(3)*rolling_std_20d(residual_return))",
    "description": "Removes each asset's rolling 60-day linear exposure to the observation-only DXY macro series, then takes a volatility-normalized three-day contrarian residual return. DXY is used only as an explanatory signal and is not tradable."
  },
  "dependencies": ["close", "DXY.close"],
  "parameters": {"beta_window": 60, "beta_min_periods": 30, "residual_horizon": 3, "vol_window": 20, "vol_min_periods": 15},
