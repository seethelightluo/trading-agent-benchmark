      "ic": 0.0166261181,
      "icir": 2.7814908,
      "hit_ratio": 0.5251337,
      "observations": 2805,
      "historical_dates": 2828,
      "average_valid_instruments": 14.8769,
      "universe_size": 15,
      "factor_coverage": 0.9935644,
      "turnover": 0.0803101,
      "max_abs_library_correlation": null,
      "decay_ic": {"1": -0.0043278, "3": 0.0075016, "5": 0.0166261, "10": 0.0360671}
    },
    "regime_notes": "Validation spans the 2020-2028 synthetic cross-asset history and multiple risk, inflation, crypto, and stress regimes. Small cross-section (15 instruments) implies conservative uncertainty interpretation; 2,805 date-level IC observations meet the minimum 8-instrument requirement."
  },
  "signal_provenance": {"artifact": "scripts/miner_3_20280323_upday_dominance20_signal.csv", "data_cutoff": "2028-03-22", "universe": ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]},
