{
  "factor_id": "miner_3_20280323_upday_dominance20",
  "factor_name": "20-Session Up-Day Return Dominance",
  "version": "1.0",
  "calculation": {
    "expression": "(sum(max(r,0),20)-sum(max(-r,0),20))/(sum(abs(r),20)+epsilon), lagged 1 session",
    "description": "Cross-asset signal measuring whether trailing 20-session absolute return was driven more by positive than negative returns. The one-session lag ensures only completed data are used."
  },
  "dependencies": ["close", "daily_returns"],
  "parameters": {"lookback": 20, "min_periods": 16, "lag": 1, "epsilon": 1e-12},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2028-03-22",
    "last_validated": "2028-03-23T00:00:00",
    "metrics": {
