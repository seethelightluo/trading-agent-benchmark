  "version": "2028-09-07",
  "calculation": {
    "expression": "-(rolling_std(return,10) / rolling_std(return,60) - 1), lagged one session",
    "description": "Ranks assets whose recent volatility is low relative to its 60-session baseline, hypothesizing volatility normalization and subsequent relative-return advantage. Uses lagged completed-session data only."
