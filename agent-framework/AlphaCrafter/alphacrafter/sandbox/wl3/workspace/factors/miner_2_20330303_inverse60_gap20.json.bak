{
  "factor_id": "miner_2_20330303_inverse60_gap20",
  "factor_name": "Inverse medium-term return with 20-session gap",
  "version": "1.0",
  "calculation": {
    "expression": "-log(close[t-20]/close[t-80]), cross-sectionally median-centered and lagged one session",
    "description": "Ranks assets positively when their 60-session return ending 20 sessions ago was weak, avoiding overlap with the most recent 20 sessions; intended as medium-horizon cross-asset mean reversion."
