{
  "factor_id": "miner_3_20270422_skip_momentum_90d_skip15",
  "factor_name": "Volatility-Scaled 90-Day Momentum with 15-Day Skip",
  "version": "1.0",
  "calculation": {
    "expression": "clip((close[t-15]/close[t-105]-1)/(std(pct_change(close),60)*sqrt(60)), -6, 6)",
    "description": "Medium-term price trend measured over 90 sessions ending 15 sessions before the decision date, scaled by trailing 60-session realized volatility. The skip reduces contamination from short-term reversal and the clipping limits outliers."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "lookback_sessions": 90,
    "skip_sessions": 15,
    "volatility_window": 60,
    "volatility_annualization": "sqrt(60)",
    "clip_lower": -6,
    "clip_upper": 6,
    "minimum_volatility_observations": 40
  },
