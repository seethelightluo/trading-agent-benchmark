{
  "factor_id": "miner_1_20260730_cross_asset_residual_3d",
  "factor_name": "3-Day Volatility-Scaled Cross-Asset Residual Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-rolling_sum(r_i - median_j(r_j), 3) / rolling_std(r_i, 20)",
    "description": "Subtract the daily cross-sectional median return from each tradable asset return, accumulate the residual over three days, and negate it after scaling by 20-day realized volatility. Higher values favor recent relative losers for short-horizon reversal.",
    "signal_artifact": "scripts/miner_1_20260730_cross_asset_residual_3d.py",
    "lookahead_policy": "Signal uses closes through t and predicts returns beginning at t+1; online implementation must lag the signal one completed trading day."
  },
  "dependencies": [
    "close",
    "daily_return",
    "cross_sectional_median_return",
    "20d_realized_volatility"
  ],
  "parameters": {
    "residual_window": 3,
    "volatility_window": 20,
    "minimum_volatility_observations": 10,
    "cross_section": "all 15 tradable watchlist assets",
    "forward_horizon_days": 1
  },
