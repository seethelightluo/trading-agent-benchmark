  "version": "1.1",
  "calculation": {
    "expression": "-rolling_sum(log_return,3)/rolling_std(log_return,20) when cross_sectional_breadth(rolling_sum(log_return,3)>0)<=0.25 and percentile_252(cross_sectional_median(rolling_std(log_return,20)))>=0.70; otherwise 0",
