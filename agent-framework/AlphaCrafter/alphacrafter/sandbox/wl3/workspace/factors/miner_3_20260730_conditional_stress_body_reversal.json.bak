{
  "factor_id": "miner_3_20260730_conditional_stress_body_reversal",
  "factor_name": "Conditional Stress-Weighted Intraday Body Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-((close-open)/open) * (1.5 if breadth_5d<0.40 else 1.0 if 0.40<=breadth_5d<=0.60 else 0.5)",
    "description": "Cross-asset intraday body reversal, with stronger reversal exposure during broad five-day market weakness and damped exposure during broad strength. breadth_5d is the fraction of the 15 tradable instruments with positive trailing five-day close-to-close return, observed at the signal close.",
    "signal_provenance": "Reproducible from ../persistent/stock_data/{symbol}.csv; daily cross-sectional Spearman IC versus next-close return; cutoff 2026-07-15; minimum 8 valid instruments."
  },
  "dependencies": [
    "open",
    "close"
  ],
  "parameters": {
    "breadth_window": 5,
    "stress_threshold": 0.4,
    "strength_threshold": 0.6,
    "stress_multiplier": 1.5,
    "neutral_multiplier": 1.0,
    "strength_multiplier": 0.5,
    "universe_size": 15
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2026-07-15",
    "last_validated": "2026-07-30",
    "metrics": {
