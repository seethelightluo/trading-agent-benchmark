{
  "factor_id": "miner_2_20290906_location_weighted_reversal3",
  "factor_name": "Range-location weighted three-session reversal",
  "version": "1.0",
  "calculation": {
    "expression": "demean_cs(-sign(log(close/close[-3]))*abs(log(close/close[-3]))*(abs((close-rolling_min(close,20))/(rolling_max(close,20)-rolling_min(close,20)) - 0.5)+0.25)/(rolling_std(diff(log(close)),20)*sqrt(3)))",
    "description": "Fades the latest three-session move, increasing reversal exposure when the close is near a 20-session high or low, with 20-session realized-volatility normalization and daily cross-sectional demeaning. Signals use only completed historical observations."
  },
  "dependencies": ["close"],
  "parameters": {"lookback_return_sessions": 3, "range_sessions": 20, "volatility_sessions": 20, "minimum_range_observations": 15, "minimum_volatility_observations": 15, "constant": 0.25},
