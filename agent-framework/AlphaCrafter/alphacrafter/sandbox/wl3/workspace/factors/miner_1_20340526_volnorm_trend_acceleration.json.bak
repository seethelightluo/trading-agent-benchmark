{
  "factor_id": "volnorm_trend_acceleration20_60",
  "factor_name": "Volatility-Normalized Relative Trend Acceleration 20-over-60",
  "version": "1.0",
  "calculation": {
    "expression": "rank_cs(((sum_20(relative_log_return) - sum_60(relative_log_return)/3) / rolling_std_60(log_return))).shift(1) - 0.5",
    "description": "Subtracts one-third of 60-session cross-sectional relative momentum from 20-session relative momentum and scales each asset by trailing 60-session realized volatility. The signal is cross-sectionally percentile-ranked and lagged one completed session to avoid look-ahead."
  },
  "dependencies": ["close"],
  "parameters": {"short_window": 20, "medium_window": 60, "medium_divisor": 3, "volatility_window": 60, "min_periods_short": 15, "min_periods_medium_volatility": 40, "lag_sessions": 1},
