  "factor_name": "Volatility-Scaled Intraday Reversal",
  "version": "20260730",
  "calculation": {
    "expression": "-(close-open)/(high-low) * sqrt((high-low)/close)",
    "description": "Measures the adverse open-to-close candle body relative to its daily range, scaled by the square root of range-to-price. Higher values indicate stronger intraday weakness and predict higher next-day close-to-close returns. Zero-range observations are invalid."
  },
  "dependencies": ["open", "high", "low", "close"],
  "parameters": {
    "forward_horizon_days": 1,
