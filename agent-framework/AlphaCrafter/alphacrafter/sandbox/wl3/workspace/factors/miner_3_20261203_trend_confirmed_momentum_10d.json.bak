{
  "factor_id": "miner_3_20261203_trend_confirmed_momentum_10d",
  "factor_name": "Trend-Confirmed Risk-Adjusted Momentum",
  "version": "1.0",
  "calculation": {
    "expression": "(ret_10 / realized_vol_20) * (0.5 + 1.5 * clip(abs(ret_20) / rolling_sum(abs(daily_return),20), 0, 1)) * sign(ret_20)",
    "description": "Ten-session momentum scaled by annualized 20-session realized volatility and continuously strengthened by directional efficiency over the preceding 20 sessions. The efficiency multiplier rewards persistent directional paths while preserving the momentum sign. All inputs are lagged to the decision date's completed session."
  },
  "dependencies": [
    "close",
    "daily_return"
  ],
  "parameters": {
    "momentum_window": 10,
    "efficiency_window": 20,
    "volatility_window": 20,
    "volatility_min_periods": 12,
    "efficiency_floor": 0.5,
    "efficiency_scale": 1.5,
    "cross_section_minimum": 8
  },
