{
  "factor_id": "miner_2_20290308_volnorm_reversal3",
  "factor_name": "Lagged-volatility-normalized three-session reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-rolling_sum(close.pct_change(), 3) / shift(rolling_std(close.pct_change(), 20), 1)",
    "description": "Negative prior three-session return scaled by the prior 20-session realized volatility. The signal is evaluated at the completed close and predicts the next session, avoiding look-ahead."
  },
  "dependencies": ["close"],
  "parameters": {"reversal_window": 3, "volatility_window": 20, "volatility_shift": 1, "minimum_volatility_observations": 10, "universe_size": 15},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2029-03-06",
    "validated_at": "2029-03-08",
    "metrics": {
      "horizon": "1d",
      "ic": 0.032226,
      "icir": 0.099792,
      "hit_ratio": 0.5385,
      "validation_dates": 2364,
      "average_instruments": 11.15,
      "instruments": 15,
      "coverage": 0.7436,
      "turnover_proxy": 0.2476,
      "max_abs_library_correlation": null,
      "decay_ic_3d": 0.028226,
      "decay_ic_5d": 0.020761
    },
    "signal_artifact": "scripts/miner_2_20290308_volnorm_reversal3_signal.csv",
    "regime_notes": "Positive and above gate in 2020-2022, 2023-2025, and 2026-2027; weakly negative in 2028; strong recovery in the latest 120 observations. Small cross-asset cross-sections imply conservative uncertainty."
  },
  "tags": ["reversal", "volatility_scaled", "short_horizon", "cross_asset"],
