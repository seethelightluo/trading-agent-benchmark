{
  "factor_id": "miner_3_20270128_volstate_reversal_1d",
  "factor_name": "Volatility-State Short-Term Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-pct_change(close,1) * clip(0.65 + 0.70 * cross_sectional_percentile(realized_volatility(pct_change(close,1),20)), -3, 3)",
    "description": "Contrarian one-day return signal with a smooth boost when an instrument is in a high relative 20-session volatility state. Uses only prices available through the prior completed session."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "reversal_horizon_days": 1,
    "volatility_window_days": 20,
    "volatility_min_periods": 12,
    "base_weight": 0.65,
    "volatility_state_weight": 0.7,
    "clip_lower": -3,
    "clip_upper": 3
  },
