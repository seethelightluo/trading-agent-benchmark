{
  "factor_id": "miner_1_20270422_skip60_10_volscaled_trend",
  "factor_name": "10-session-skipped 60-day volatility-scaled trend",
  "version": "2027-04-22",
  "calculation": {
    "expression": "clip(return(close,60,skipping_recent=10) / (rolling_std(daily_returns,40) * sqrt(40)), -6, 6)",
    "description": "Ranks assets by medium-term trend after omitting the most recent ten sessions, normalized by trailing realized volatility. The skip reduces contamination from short-term reversal and uses only completed historical closes."
  },
  "dependencies": ["close", "date"],
  "parameters": {
    "trend_lookback_days": 60,
    "skip_days": 10,
    "volatility_window_days": 40,
    "volatility_min_periods": 30,
    "winsorization": [-6.0, 6.0],
    "universe_size": 15
  },
