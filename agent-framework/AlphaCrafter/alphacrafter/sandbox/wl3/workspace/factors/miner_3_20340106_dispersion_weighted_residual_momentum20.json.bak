{
  "factor_id": "miner_3_20340106_dispersion_weighted_residual_momentum20",
  "factor_name": "Dispersion-Weighted Residual Momentum 20",
  "version": "2034-03-17-revalidation",
  "calculation": {
    "expression": "rank_cs((sum_20(residual_return) * cross_sectional_dispersion_20) / (realized_volatility_20 + epsilon))",
    "description": "Compute each asset's 20-session return in excess of the cross-asset daily mean, multiply by recent cross-sectional return dispersion, scale by 20-session realized volatility, cross-sectionally rank, and lag one completed session. Higher values indicate persistent relative trends in a dispersed market.",
    "lag": "one completed trading session"
  },
  "dependencies": ["close"],
  "parameters": {"trend_window": 20, "volatility_window": 20, "dispersion_window": 20, "epsilon": 1e-12, "cross_section_minimum": 8},
