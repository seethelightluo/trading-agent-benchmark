{
  "factor_id": "miner_2_20271216_skip_reversal5",
  "factor_name": "Skipped Medium-Term Volatility-Normalized Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(close[t-2]/close[t-7]-1)/rolling_std(pct_change(close),60)",
    "description": "Contrarian five-session return ending two sessions before the decision, divided by trailing 60-session daily volatility, then cross-sectionally median-centered and clipped to [-6,6]. The two-session skip reduces immediate microstructure contamination and avoids using data after the completed cutoff."
  },
  "dependencies": ["close", "date"],
  "parameters": {"lookback_return_sessions": 5, "skip_sessions": 2, "volatility_window": 60, "min_volatility_observations": 30, "clip": [-6, 6]},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2027-12-15",
    "validation_date": "2027-12-16",
