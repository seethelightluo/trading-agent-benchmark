  "factor_name": "VIX-Beta-Residual Three-Day Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-sum_{i=0..2}(r_asset[t-i] - beta_60(asset,VIX)[t-i]*r_VIX[t-i]) / (sqrt(3)*std_20(residual_return))",
    "description": "Residualizes each tradable asset daily return against its trailing 60-day beta to observation-only VIX returns, then takes a negative three-day residual return scaled by 20-day residual volatility. VIX is macro observation-only and is never traded.",
