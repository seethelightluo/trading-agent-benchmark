{
  "factor_id": "miner_3_20291018_downside_reversal",
  "factor_name": "Downside-Path-Adjusted Relative Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "demean_cs(shift1(-relative_return_5/(realized_vol_20*sqrt(5))*(0.5+downside_share_5)))",
    "description": "Ranks recent five-session relative losers more positively when a larger share of their recent absolute path consisted of downside returns. The one-session lag uses only completed daily observations and cross-sectional median demeaning."
  },
  "dependencies": ["close"],
  "parameters": {"return_window": 5, "vol_window": 20, "downside_window": 5, "lag": 1, "minimum_cross_section": 8},
  "validation": {
