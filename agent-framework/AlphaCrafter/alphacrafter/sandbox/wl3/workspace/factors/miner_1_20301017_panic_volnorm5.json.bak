{
  "factor_id": "miner_1_20301017_panic_volnorm5",
  "factor_name": "Panic breadth volatility-normalized reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-rolling_sum(log_return,3) / (rolling_std(log_return,20)*sqrt(252)) * I(three_day_positive_breadth < 0.35)",
    "description": "Fades each instrument's lagged three-session return only during broad cross-asset selloffs, scaling by trailing 20-session annualized realized volatility. Signal uses data through the completed decision date and is evaluated against subsequent returns."
  },
  "dependencies": ["close", "date", "tradable_universe"],
  "parameters": {
    "shock_window_days": 3,
    "volatility_window_days": 20,
    "breadth_threshold": 0.35,
    "annualization": 252,
    "forward_horizons_days": [5, 10, 20],
    "minimum_cross_section": 8
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01/2030-10-17",
    "last_validated": "2030-10-17T00:00:00Z",
