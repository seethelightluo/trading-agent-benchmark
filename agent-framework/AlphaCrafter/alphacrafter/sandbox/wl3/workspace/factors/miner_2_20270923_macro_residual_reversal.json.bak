{
  "factor_id": "miner_2_20270923_macro_residual_reversal",
  "factor_name": "Benchmark-Residual Five-Day Reversal",
  "version": "2027-09-23",
  "calculation": {
    "expression": "-rolling_sum_5(return - rolling_beta_60(return, equal_weight_benchmark_return) * equal_weight_benchmark_return)",
    "description": "For each tradable asset, estimate a 60-session clipped beta to the equal-weight return of all 15 tradable assets, form the daily residual return, and fade its trailing five-session cumulative residual return. Cross-sectionally median demean and clip to [-6,6]. All inputs are lagged completed-session observations."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "residual_window": 60,
    "signal_window": 5,
    "minimum_beta_observations": 30,
    "beta_clip": [
      -3,
      3
    ],
    "cross_section": "15 tradable benchmark instruments",
    "min_ic_observation_instruments": 8
  },
