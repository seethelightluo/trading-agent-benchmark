{
  "factor_id": "miner_3_20280420_vol_adjusted_momentum20",
  "factor_name": "20-Session Volatility-Adjusted Momentum",
  "version": "2028-04-20",
  "calculation": {
    "expression": "(close / lag(close,20) - 1) / (rolling_std(daily_returns,20) * sqrt(252)), lagged by one completed session",
    "description": "Ranks assets by intermediate momentum normalized by their trailing 20-session annualized realized volatility. The one-session lag prevents use of the current completed day's close for the decision signal."
  },
  "dependencies": ["close"],
  "parameters": {"momentum_window": 20, "volatility_window": 20, "annualization": 252, "signal_lag": 1},
