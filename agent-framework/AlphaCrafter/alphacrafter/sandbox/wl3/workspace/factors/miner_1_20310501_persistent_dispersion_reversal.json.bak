{
  "factor_id": "miner_1_20310501_persistent_dispersion_reversal",
  "factor_name": "Persistent High-Dispersion Macro-Residual Reversal 3D",
  "version": "1.0",
  "calculation": {
    "expression": "-((log_return_3d_i - cross_sectional_median(log_return_3d)) / rolling_std(log_return_1d,20)) * I(dispersion_ratio_t>1 and dispersion_ratio_{t-1}>1)",
    "description": "Fade each asset's three-session return residual to the cross-sectional median only after two consecutive days of elevated cross-asset dispersion. Dispersion is the cross-sectional median absolute three-session residual, compared with its trailing 252-session median. Signal is lagged one completed session before use."
  },
  "dependencies": ["close"],
  "parameters": {"residual_window": 3, "volatility_window": 20, "dispersion_baseline_window": 252, "persistence_days": 2, "forward_validation_horizon_sessions": 6, "minimum_cross_section": 8},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-02 through 2031-04-24",
    "metrics": {
      "ic": 0.029022,
      "icir": 0.091018,
      "dates": 1013,
      "average_instruments": 14.404,
      "coverage": 0.26762,
      "turnover": 0.17558,
      "hit_ratio": 0.5262,
      "max_abs_library_correlation": null
    },
    "regime_notes": "Positive IC in 2020-22 (0.043274), 2023-25 (0.030813), and 2028-30 (0.026277); weak negative in 2026-27 (-0.001691); 2031 YTD positive but only 21 observations. Small cross-asset sample implies conservative interpretation.",
    "signal_artifact": "scripts/miner_1_20310501_persistent_dispersion_reversal_signal.csv"
  },
  "tags": ["reversal", "cross-asset", "dispersion", "macro-regime", "volatility-scaled"],
