{
  "factor_id": "miner_1_20290906_range_conditioned_reversal_5d",
  "factor_name": "Range-Conditioned Volatility-Normalized Three-Day Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "shift(1, (-rolling_sum(log_return,3) / (rolling_std(log_return,60)*sqrt(3))) / clip(rolling_mean(abs(log_return),10) / rolling_mean((high-low)/close,20), 0.2, 5.0))",
    "description": "Contrarian three-session return normalized by 60-session volatility, with the reversal magnitude divided by a bounded ratio of recent absolute-return activity to average daily range. The complete signal is lagged one completed trading day to prevent look-ahead. Cross-sectional ranking is recommended for portfolio use."
  },
  "dependencies": ["close", "high", "low"],
  "parameters": {"shock_window": 3, "volatility_window": 60, "annualization_factor": 3, "range_window": 20, "return_activity_window": 10, "range_ratio_clip": [0.2, 5.0], "signal_lag": 1, "forward_horizon": 5},
  "validation": {
