{
  "factor_id": "miner_2_20280323_medium_excess_momentum_20d",
  "factor_name": "Cross-Asset Excess 20-Day Risk-Adjusted Momentum",
  "version": "1.0",
  "calculation": {
    "expression": "shift(rolling_sum(return,20) - rolling_sum(cross_asset_mean_return,20), 1) / rolling_std(return - cross_asset_mean_return,30)",
    "description": "Ranks assets by their prior completed 20-session return in excess of the contemporaneous cross-asset mean, scaled by trailing 30-session idiosyncratic volatility. The one-session lag prevents look-ahead."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "lookback_sessions": 20,
    "volatility_window": 30,
    "volatility_min_periods": 20,
    "signal_lag_sessions": 1,
    "minimum_cross_section": 8
  },
