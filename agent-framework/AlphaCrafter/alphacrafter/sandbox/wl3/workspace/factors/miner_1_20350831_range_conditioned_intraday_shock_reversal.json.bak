{
  "factor_id": "miner_1_20350831_range_conditioned_intraday_shock_reversal",
  "factor_name": "Range-conditioned ATR-normalized intraday shock reversal",
  "version": "1.0",
  "calculation": {
    "expression": "S = mean_3(-((open_t / close_{t-1} - 1) / ATR20_{t-1})) * (1 + 0.5*sign(-return10_t)); F = S * (0.7 + 0.6*(1 - range_location60_t))",
    "description": "Ranks assets higher when recent overnight/intraday downside shocks are likely to mean-revert, normalized by lagged 20-session average high-low range. The shock reversal is amplified after negative 10-session return and conditionally strengthened for assets near the lower end of their 60-session price range. All inputs are lagged or current-day observable at the decision cutoff; forward returns are used only for validation.",
    "signal_artifact": "scripts/miner_1_20350831_range_conditioned_shock_signal.csv"
  },
  "dependencies": ["open", "high", "low", "close"],
  "parameters": {"shock_smoothing_sessions": 3, "atr_window": 20, "trend_condition_window": 10, "trend_amplifier": 0.5, "range_window": 60, "range_min_periods": 40, "range_low_multiplier": 0.7, "range_high_multiplier": 1.3},
