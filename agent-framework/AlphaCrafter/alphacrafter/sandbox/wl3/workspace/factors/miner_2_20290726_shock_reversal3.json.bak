{
  "factor_id": "miner_2_20290726_shock_reversal3",
  "factor_name": "Volatility-Scaled Three-Session Shock Reversal",
  "version": "20290726",
  "calculation": {
    "expression": "-sum(log_return,3) * abs(sum(log_return,3)) / (rolling_std(log_return,60) * sqrt(3)), cross_sectionally_demeaned, lagged one completed session",
    "description": "Fades unusually large three-session moves, with reversal intensity scaled by the size of the shock relative to 60-session realized volatility. Cross-sectional demeaning removes common market direction and the signal is only formed from completed sessions."
  },
  "dependencies": ["close", "daily_log_returns", "date"],
  "parameters": {
    "shock_window": 3,
    "volatility_window": 60,
    "minimum_cross_section": 8,
    "signal_lag_sessions": 1,
    "cross_sectional_center": "mean",
    "normalization": "realized_volatility_times_sqrt_3"
  },
