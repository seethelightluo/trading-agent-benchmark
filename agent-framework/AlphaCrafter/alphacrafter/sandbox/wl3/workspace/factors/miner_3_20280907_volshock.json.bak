  "factor_name": "Volatility Shock Compression",
  "version": "1.0",
  "calculation": {
    "expression": "-(std(return,10) / std(return,60) - 1), lagged 1 session",
    "description": "Ranks assets higher when their recent 10-session realized volatility is compressed relative to their 60-session baseline. Uses close-to-close returns and is lagged to prevent look-ahead."
