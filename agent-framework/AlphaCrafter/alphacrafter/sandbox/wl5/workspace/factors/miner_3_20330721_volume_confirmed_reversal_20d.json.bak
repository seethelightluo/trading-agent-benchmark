{
  "factor_id": "miner_3_20330721_volume_confirmed_reversal_20d",
  "factor_name": "Volume-Confirmed 20-Day Momentum Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-sum(pct_change(close),20) * (1 + 0.5*tanh(mean(log(volume/rolling_median(volume,60)),5)))",
    "description": "Contrarian intermediate-return signal, strengthened when recent activity is abnormally high relative to each asset's own 60-day median volume. The activity transform is bounded to reduce scale and data-quality artifacts."
  },
  "dependencies": [
    "close",
    "volume"
  ],
  "parameters": {
    "return_window": 20,
    "volume_baseline_window": 60,
    "activity_window": 5,
    "activity_multiplier": 0.5,
    "forward_horizon": 10,
    "minimum_cross_section": 8
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": {
      "start": "2026-07-28",
      "end": "2033-07-06"
