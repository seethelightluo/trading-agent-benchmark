{
  "factor_id": "miner_2_20350705_close_location_residual_reversal",
  "factor_name": "Close-Location Weighted Residual Reversal",
  "version": "2035-07-05",
  "calculation": {
    "expression": "clip((-rolling_sum(residual_return,10)/(rolling_std(residual_return,40)*sqrt(10))) * (1 - 0.9*rolling_mean((close-low)/(high-low)-0.5,15)), -8, 8)",
    "description": "Cross-sectional residual 10-session reversal, normalized by 40-session residual volatility, with a causal 15-session close-location overlay that modestly emphasizes adverse-range positioning."
  },
  "dependencies": ["close", "high", "low"],
  "parameters": {"reversal_window": 10, "volatility_window": 40, "location_window": 15, "location_multiplier": 0.9, "clip": 8, "minimum_cross_section": 8},
  "validation": {
