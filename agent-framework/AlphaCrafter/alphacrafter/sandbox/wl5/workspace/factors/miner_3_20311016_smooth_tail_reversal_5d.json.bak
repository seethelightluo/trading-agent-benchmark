{
  "factor_id": "miner_3_20311016_smooth_tail_reversal_5d",
  "factor_name": "Smooth tail-scaled five-day reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(log_return_5d / rolling_std_log_return_30d) * (0.90 + 0.10 * downside_abs_mean_30d / rolling_std_log_return_30d)",
    "description": "Cross-asset contrarian signal that reverses the trailing five-day log return, normalizes by trailing 30-day volatility, and applies a mild downside-asymmetry scaling. All inputs are lagged through the prior completed trading day."
  },
  "dependencies": ["close"],
  "parameters": {
    "return_window_days": 5,
    "volatility_window_days": 30,
    "tail_weight": 0.10,
    "forward_horizon_days": 5,
    "minimum_cross_section": 8
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2031-10-15",
    "validation_timestamp": "2031-10-16T00:00:00",
    "metrics": {
      "ic": 0.030261,
      "icir": 0.095496,
      "ic_hit_ratio": 0.52636,
      "dates": 2314,
      "mean_instruments": 14.67,
      "coverage": 0.97787,
      "turnover": 0.150708,
      "decay_ic_10d": 0.023716,
      "decay_icir_10d": 0.076595,
      "max_abs_library_correlation": null
    },
    "regime_notes": "Positive five-day IC in all tested regimes: 2020-2024 +0.032222; 2025-2027 +0.040718; 2028-2029 +0.023801; 2030-2031-10-15 +0.020114. Ten-day decay remains positive but fails the ICIR gate.",
    "signal_artifact": "scripts/miner_3_20311016_smooth_tail_reversal_signal.csv",
    "methodology": "Daily Spearman cross-sectional IC; observations require at least 8 valid tradable instruments; 15-instrument benchmark universe used."
  },
  "tags": ["reversal", "tail-risk", "volatility-scaled", "cross-asset", "short-horizon"],
  "last_validated": "2031-10-16"
}