{
  "factor_id": "miner_2_20271118_sign_consistency_20d",
  "factor_name": "Twenty-Day Positive-Return Consistency",
  "version": "1.0",
  "calculation": {
    "expression": "rolling_mean((pct_change(close)>0),20)-0.5, cross_sectional_median_center",
    "description": "For each tradable asset, measure the fraction of positive daily returns over the prior 20 completed sessions and median-center across the available universe. Higher values represent persistent directional trends."
