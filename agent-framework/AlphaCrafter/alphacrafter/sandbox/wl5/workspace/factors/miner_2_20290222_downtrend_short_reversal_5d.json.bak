{
  "factor_id": "miner_2_20290222_downtrend_short_reversal_5d",
  "factor_name": "Downtrend-Gated Volatility-Scaled 5-Day Reversal",
  "version": "2029-02-22",
  "calculation": {
    "expression": "-rolling_sum(pct_change(close),5) * (1 if rolling_sum(pct_change(close),60)<0 else 0.25) / rolling_std(pct_change(close),20)",
    "description": "Contrarian five-day return signal, amplified for assets below their 60-day trend and damped in positive trends; scaled by 20-day realized volatility. Signal is lagged one completed day before evaluating forward returns."
  },
  "dependencies": ["close"],
  "parameters": {"reversal_window": 5, "trend_window": 60, "volatility_window": 20, "positive_trend_multiplier": 0.25, "forward_horizon_days": 10, "minimum_cross_section": 8},
