{
  "factor_id": "miner_2_20311016_downside_skew_recovery_3d",
  "factor_name": "Downside-skew weighted short reversal recovery",
  "version": "1.0",
  "calculation": {
    "expression": "-(sum(log_return[t-2:t]))/std(log_return[t-19:t]) * clip(1 + 0.35*(count(log_return < -vol)-count(log_return > vol))/20, 0.65, 1.35)",
    "description": "Cross-asset contrarian recovery signal. Reverses the most recent three-day return, volatility normalizes it, and modestly amplifies or attenuates it according to the recent downside-versus-upside tail frequency. All inputs are lagged and causal at the signal date."
  },
  "dependencies": ["close"],
  "parameters": {"reversal_days": 3, "volatility_window": 20, "tail_threshold": "rolling volatility", "tail_sensitivity": 0.35, "tail_window": 20, "tail_clip": [0.65, 1.35]},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2031-10-15",
    "metrics": {
      "admission_horizon_days": 10,
      "ic": 0.027755,
      "icir": 0.084300,
      "ic_hit_ratio": 0.52536,
      "coverage": 0.97055,
      "average_instruments": 14.56,
      "observation_dates": 2307,
      "turnover": 0.192752,
      "max_abs_library_correlation": null
    },
    "decay": {"5d_ic": 0.024758, "5d_icir": 0.078728, "10d_ic": 0.027755, "10d_icir": 0.084300},
    "regime_ic_10d": {"2020-2024": 0.033379, "2025-2027": 0.030690, "2028-2029": 0.002655, "2030-2031-10-15": 0.043890},
    "regime_notes": "Positive across three of four regimes, near zero in 2028-2029, and strongest in the recent 2030-2031 regime. Small 15-asset cross-section implies conservative interpretation; 14.56 average valid instruments.",
    "signal_artifact": "scripts/miner_2_20311016_downside_skew_recovery_signal.csv"
  },
