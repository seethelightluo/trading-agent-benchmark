{
  "factor_id": "miner_1_20310109_inverse_trend_confirmed_20d",
  "factor_name": "Inverse 60-session trend with short-term downside confirmation",
  "version": "1.0",
  "calculation": {
    "expression": "-log(close_t/close_{t-59})/(std(log_returns_{t-19:t})*sqrt(20)) * (0.5 + 0.5*I(log(close_t/close_{t-9}) < 0))",
    "description": "Contrarian medium-term trend normalized by recent volatility; assets with negative short-term confirmation receive full reversal strength, while others receive half strength. All inputs are lagged through the prior completed session."
  },
  "dependencies": ["close"],
  "parameters": {"trend_window": 60, "volatility_window": 20, "short_confirmation_window": 10, "volatility_annualization": 20, "confirmation_multiplier_negative": 1.0, "confirmation_multiplier_other": 0.5},
  "validation": {
