  "factor_name": "20-day volatility-scaled cross-sectional reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(rolling_sum(pct_change(close),20) / rolling_std(pct_change(close),20))",
    "description": "Ranks assets favorably when their trailing 20-trading-day return is negative after scaling by their trailing 20-day daily-return volatility. The signal is computed using data available through the decision date and evaluated against the subsequent 10-trading-day return."
