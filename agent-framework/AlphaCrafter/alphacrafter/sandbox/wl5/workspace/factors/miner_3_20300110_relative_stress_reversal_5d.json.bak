{
  "factor_id": "miner_3_20300110_relative_stress_reversal_5d",
  "factor_name": "Relative short-term reversal with stress amplification",
  "version": "1.1",
  "calculation": {
    "expression": "-(R5_i - median_cross_section(R5))/annualized_std(R1,20) * (1 + 0.5*abs(2*breadth5 - 1))",
    "description": "Reverse each instrument's five-day return relative to the cross-sectional median, scale by 20-day realized volatility, and amplify symmetrically when five-day breadth is one-sided. All inputs are available at the signal cutoff.",
    "signal_artifact": "scripts/miner_3_20300110_stress_reversal_signal.csv"
  },
  "dependencies": ["close"],
  "parameters": {"return_window_days": 5, "volatility_window_days": 20, "min_vol_observations": 15, "stress_multiplier": 0.5, "forward_horizon_days": 5, "min_cross_section": 8},
  "validation": {
    "status": "EFFECTIVE",
    "period": {"start": "2020-01-01", "end": "2030-01-09", "causal_cutoff": "2030-01-09"},
    "metrics": {"ic": 0.027162, "icir": 0.085525, "horizon_days": 5, "dates": 2271, "mean_instruments_per_date": 14.264, "coverage": 0.94448, "turnover": 0.15672, "hit_ratio": 0.5385, "max_abs_library_correlation": null},
    "regime_notes": "Positive five-day paper IC and ICIR pass the benchmark gates on the 15-asset universe. Longer-horizon IC is positive but weaker; uncertainty remains material. Validation uses daily Spearman cross-sectional IC with at least 8 valid instruments per date.",
