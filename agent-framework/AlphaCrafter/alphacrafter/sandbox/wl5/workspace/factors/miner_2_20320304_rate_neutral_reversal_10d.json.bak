{
  "factor_id": "miner_2_20320304_rate_neutral_reversal_10d",
  "factor_name": "US10Y-CN10Y Rate-Neutralized Volatility-Scaled Reversal 10D",
  "version": "1.0",
  "calculation": {
    "expression": "-(sum(log_return_5d_asset)-beta_60d_asset*(sum(log_return_5d_US10Y)-sum(log_return_5d_CN10Y)))/std(log_return_60d_asset), with bounded cross-sectional dispersion scale",
    "description": "Fades each asset's five-day return after removing its trailing 60-day sensitivity to the US10Y-minus-CN10Y relative-rate shock, then scales by trailing volatility. A bounded recent dispersion adjustment modestly increases signal magnitude in broad-move conditions. All inputs are lagged at the decision date."
  },
  "dependencies": ["close", "US10Y close", "CN10Y close"],
  "parameters": {"beta_window": 60, "move_window": 5, "vol_window": 60, "dispersion_window": 20, "forward_horizon_days": 10, "min_cross_section": 8},
  "validation": {
