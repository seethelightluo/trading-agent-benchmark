{
  "factor_id": "miner_3_20301226_smooth_dispersion_residual_reversal_5d",
  "factor_name": "Smooth dispersion-scaled residual reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(sum_5d(log_return_i - cross_section_median_log_return) / downside_volatility_30d_i) * (0.35 + 0.65 * trailing_percentile_60d(cross_sectional_abs_residual_dispersion))",
    "description": "For each tradable asset, reverse its five-session cumulative return residual versus the daily cross-sectional median, normalize by 30-session downside residual volatility, and continuously scale activation from 0.35 to 1.0 using the percentile rank of today's median absolute residual dispersion within the trailing 60 sessions. All inputs are lagged through the decision date."
  },
  "dependencies": ["close"],
  "parameters": {"shock_window_days": 5, "downside_volatility_window_days": 30, "dispersion_window_days": 60, "base_activation": 0.35, "dispersion_activation_span": 0.65, "primary_forward_horizon_days": 5, "minimum_cross_section": 8},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2030-12-25 causal observations",
    "metrics": {
      "ic": 0.028563,
      "icir": 0.092445,
      "horizon_days": 5,
      "dates": 2128,
      "mean_assets_per_date": 14.28,
      "coverage": 0.95204,
      "hit_ratio": 0.53524,
      "rank_turnover": 0.15171,
      "max_abs_library_correlation": null,
      "decay": {"10d_ic": 0.016382, "10d_icir": 0.053956, "20d_ic": 0.012007, "20d_icir": 0.037654}
    },
    "regime_notes": "Aggregate five-day IC and ICIR pass benchmark gates, with positive IC in 2020-2029; performance weakened in 2028-2029 and was negative in 2030 YTD, so use with regime diversification and monitor recency closely.",
