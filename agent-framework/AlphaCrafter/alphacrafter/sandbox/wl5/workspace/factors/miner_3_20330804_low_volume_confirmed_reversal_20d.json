  "factor_name": "Low-volume-confirmed 20-day momentum reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-rolling_sum(pct_change(close),20) * (1 - 0.5*tanh(rolling_mean_5(log(volume/rolling_median_60(volume)))))",
    "description": "Ranks assets for contrarian reversal of 20-day cumulative return, with the reversal signal amplified when recent activity is below its trailing 60-day median. All windows use information available at the signal date."
