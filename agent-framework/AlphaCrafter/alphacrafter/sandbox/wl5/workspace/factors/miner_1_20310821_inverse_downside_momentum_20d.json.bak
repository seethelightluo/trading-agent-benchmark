{
  "factor_id": "miner_1_20310821_inverse_downside_momentum_20d",
  "factor_name": "Inverse downside-volatility-scaled 20-day momentum",
  "version": "1.0",
  "calculation": {
    "expression": "clip(-(sum(log(close/close_lag1),20)) / std(negative_daily_log_returns,40), -10, 10)",
    "description": "Contrarian signal: negative 20-day log momentum divided by trailing 40-day downside-return volatility, clipped for robustness. All inputs are lagged through the decision date. Higher values indicate stronger expected five-trading-day forward return."
  },
  "dependencies": ["close"],
  "parameters": {"momentum_window": 20, "downside_volatility_window": 40, "clip_lower": -10, "clip_upper": 10, "forward_horizon_days": 5},
