  "factor_id": "miner_3_20301114_robust_residual_reversal_5d",
  "factor_name": "Robust median residual downside-normalized 5-day reversal",
  "version": "2030-11-14",
  "calculation": {
    "expression": "-sum_5(log_return_i - cross_sectional_median_log_return) / (std_30(negative_residual_returns) * sqrt(30) + 1e-12)",
    "description": "Contrarian residual shock: assets with the largest recent five-day underperformance versus the robust cross-sectional median receive higher scores, normalized by their 30-day downside residual volatility. Uses only completed daily prices."
