{
  "factor_id": "miner_1_20290222_residual_reversal_5d",
  "factor_name": "Cross-sectional risk-normalized residual reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(return_5d - cross_sectional_median(return_5d)) / (rolling_std(daily_returns,20) * sqrt(5))",
    "description": "Fades each instrument's five-day return relative to the same-day median return, scaled by its trailing 20-day realized volatility. Positive values indicate comparatively stronger reversal potential. The median is computed only from the 15 tradable benchmark instruments available on that date."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "lookback_return_days": 5,
    "volatility_window_days": 20,
    "volatility_min_periods": 15,
    "cross_sectional_center": "median",
    "forward_horizons_tested": [
      5,
      10,
      20
    ]
  },
