{
  "factor_id": "miner_1_20320624_drawdown_oversold_recovery_5pct",
  "factor_name": "Drawdown-conditioned oversold recovery",
  "version": "1.0",
  "calculation": {
    "expression": "where(1 - close/max(close,60) > 0.05, -log(close/lag(close,20))/downside_volatility(log_returns,60), NaN)",
    "description": "Ranks assets for ten-day recovery after a material drawdown from the trailing 60-day high. The 20-day loss is inverted and scaled by trailing downside volatility; assets without at least a 5% drawdown are excluded. All inputs are observable through the decision date."
  },
  "dependencies": ["close"],
  "parameters": {"return_lookback_days": 20, "drawdown_lookback_days": 60, "drawdown_threshold": 0.05, "downside_volatility_window": 60, "forward_horizon_days": 10},
  "signal_artifact": "scripts/miner_1_20320624_drawdown_oversold_recovery_5pct_signal.csv",
