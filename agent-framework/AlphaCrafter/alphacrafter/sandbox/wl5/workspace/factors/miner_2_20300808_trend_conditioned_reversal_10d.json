{
  "factor_id": "miner_2_20300808_trend_conditioned_reversal_10d",
  "factor_name": "Trend-Conditioned Short-Shock Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "(-min(ret_3d,0)/volatility_20d) * clip(1 - ret_15d/(3*volatility_20d), 0, 2)",
    "description": "Ranks assets for ten-day rebound after a three-day downside shock, normalized by 20-day volatility and conditioned by the 15-day trend. The conditioning factor increases reversal opportunity when the medium trend is not strongly positive, while clipping limits extreme scores."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "shock_window_days": 3,
    "trend_window_days": 15,
    "volatility_window_days": 20,
    "forward_horizon_days": 10,
    "trend_scale": 3.0,
    "conditioning_clip": [
      0.0,
      2.0
    ],
    "minimum_cross_section": 8
  },
