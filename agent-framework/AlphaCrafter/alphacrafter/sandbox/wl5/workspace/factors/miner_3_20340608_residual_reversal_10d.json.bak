{
  "factor_id": "miner_3_20340608_residual_reversal_10d",
  "factor_name": "Market-residual downside-risk normalized reversal",
  "version": "1.0",
  "calculation": {
    "expression": "clip(-rolling_sum_10(residual_return) / (sqrt(10)*rolling_std_30(min(residual_return,0))), -10, 10)",
    "description": "Compute each asset's daily return residual to the equal-weight 15-asset benchmark using a causal 60-day rolling beta lagged one day. Rank assets by the negative ten-day cumulative residual return normalized by 30-day downside residual volatility. Higher values indicate stronger idiosyncratic rebound potential."
  },
  "dependencies": ["close", "pct_change"],
  "parameters": {
    "universe": 15,
    "benchmark": "equal_weight_mean_return",
    "beta_window": 60,
    "beta_min_periods": 30,
    "signal_window": 10,
    "downside_vol_window": 30,
    "downside_vol_min_periods": 20,
    "forward_horizon_days": 10,
    "winsorization": [-10, 10],
    "minimum_cross_section": 8
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2026-07-23 through 2034-05-24",
    "metrics": {
      "daily_paper_ic": 0.041340,
