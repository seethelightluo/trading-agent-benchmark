{
  "factor_id": "miner_1_20280601_relative_volatility_trend",
  "factor_name": "Cross-Asset Relative Volatility with Trend Tilt",
  "version": "2028.06.01",
  "calculation": {
    "expression": "0.75*rank_cs(vol20 / median_cs(vol20) - 1) + 0.25*rank_cs(sum_return_10d)",
    "description": "Ranks each tradable asset's 20-day realized volatility relative to the contemporaneous cross-sectional median, then adds a modest rank of its trailing 10-day return. Higher values indicate relatively elevated risk accompanied by recent strength. Uses only information available at the signal date."
  },
  "dependencies": ["close", "pct_change"],
  "parameters": {"vol_window": 20, "trend_window": 10, "vol_weight": 0.75, "trend_weight": 0.25, "forward_horizon": 10, "minimum_cross_section": 8},
