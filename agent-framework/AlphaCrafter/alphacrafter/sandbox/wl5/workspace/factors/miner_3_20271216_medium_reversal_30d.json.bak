  "factor_name": "Thirty-day volatility-adjusted cross-asset reversal",
  "version": "20271216",
  "calculation": {
    "expression": "-(close/shift(close,30)-1)/(rolling_std(pct_change(close),30)*sqrt(30)) - cross_sectional_median(same)",
    "description": "Fades each asset's 30-session compounded return after trailing volatility normalization, with same-date cross-sectional median centering. Uses only completed sessions."
  },
