{
  "factor_id": "miner_2_20350524_residual_reversal20_10d",
  "factor_name": "20-day volatility-normalized residual reversal",
  "version": "1.0",
  "calculation": {
    "expression": "clip(-rolling_sum(residual_returns,20) / (rolling_std(residual_returns,60)*sqrt(20)+epsilon), -8, 8)",
    "description": "For each tradable benchmark instrument, subtract the daily cross-sectional mean return to form residual returns, reverse the trailing 20-session residual return, and normalize by trailing 60-session residual volatility. All inputs are lagged through the decision date.",
