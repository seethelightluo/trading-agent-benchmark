{
  "factor_id": "miner_3_20300711_compressed_downside_reversal_20d",
  "factor_name": "Volatility-compression weighted downside reversal 20d",
  "version": "2030-07-11",
  "calculation": {
    "expression": "-min(return(close,5),0)/std(log_return(close),20) * (std(log_return(close),60)/std(log_return(close),20))^0.5",
    "description": "Ranks assets with recent downside moves positively, scaling the downside by short-term realized volatility and modestly increasing the score when short-term volatility is compressed relative to its 60-day baseline. All inputs are lagged through the decision date and the signal is evaluated against the subsequent 20-day return."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "reversal_lookback_days": 5,
    "short_volatility_days": 20,
    "long_volatility_days": 60,
    "compression_exponent": 0.5,
    "forward_horizon_days": 20,
    "minimum_cross_section": 8
  },
