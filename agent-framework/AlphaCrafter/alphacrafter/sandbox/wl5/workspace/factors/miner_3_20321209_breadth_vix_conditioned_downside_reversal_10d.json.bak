{
  "factor_id": "miner_3_20321209_breadth_vix_conditioned_downside_reversal_10d",
  "factor_name": "Breadth and VIX Conditioned Downside-Volatility Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "rank_pct((-sum(log_return,60)/(std(negative_log_return,90)+eps)) * (1 + 0.60*clip((0.5-breadth20)*2,0,1)*clip(cross_asset_meanvol20/cross_asset_meanvol120,0.5,2.0) + 0.50*clip(zscore(VIX_vs_60d_history),0,2)/2)",
    "description": "Ranks causal 60-day downside-volatility-normalized reversal, amplified by broad market stress and elevated observation-only VIX. All inputs use data available before the signal date; forward return horizon is 10 trading days."
  },
  "dependencies": ["close", "VIX observation-only macro series"],
  "parameters": {"reversal_window": 60, "downside_vol_window": 90, "breadth_window": 20, "market_vol_window": 20, "market_vol_baseline": 120, "vix_baseline": 60, "stress_weight": 0.60, "vix_weight": 0.50, "forward_horizon": 10, "epsilon": 1e-12},
  "signal_artifact": "scripts/miner_3_20321209_breadth_vix_reversal_signal.csv",
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2032-12-08",
    "last_validated": "2032-12-09",
    "metrics": {
      "ic": 0.044165,
      "icir": 0.136230,
      "ic_hit_ratio": 0.56418,
      "forward_horizon_days": 10,
      "usable_dates": 2602,
      "mean_instruments": 14.62,
      "coverage": 0.9744,
      "turnover": 0.048898,
      "max_abs_library_correlation": null
    },
    "regime_notes": "Negative in 2020-2024 (IC -0.022767), positive in 2025-2027 (0.028284), 2028-2029 (0.034223), and strongly positive in 2030-2032-12-08 (0.126728). Interpret small cross-section uncertainty conservatively; regime dependence is material."
  },
  "tags": ["reversal", "downside-volatility", "breadth", "VIX-conditioned", "cross-asset"]
}
