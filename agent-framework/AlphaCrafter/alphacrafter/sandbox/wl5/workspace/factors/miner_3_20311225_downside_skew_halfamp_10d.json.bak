{
  "factor_id": "miner_3_20311225_downside_skew_halfamp_10d",
  "factor_name": "Half-amplitude downside-skew recovery reversal (10d)",
  "version": "1.0",
  "calculation": {
    "expression": "-(log_return_3d / rolling_std(log_return,20)) * (1 + 0.50 * (down_days_20 - up_days_20) / 20)",
    "description": "Cross-sectional contrarian signal: fade each instrument's trailing three-session log return after volatility normalization; modestly amplify recovery exposure when downside sessions exceed upside sessions over the prior 20 sessions. All inputs are lagged through the decision date."
  },
  "dependencies": ["close"],
  "parameters": {"return_lookback_days": 3, "volatility_lookback_days": 20, "skew_lookback_days": 20, "downside_amplitude": 0.50, "forward_horizon_days": 10},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2031-12-24",
    "metrics": {
      "ic": 0.027794,
      "icir": 0.084006,
      "ic_hit_ratio": 0.53171,
      "dates": 2381,
      "mean_instruments": 14.56,
