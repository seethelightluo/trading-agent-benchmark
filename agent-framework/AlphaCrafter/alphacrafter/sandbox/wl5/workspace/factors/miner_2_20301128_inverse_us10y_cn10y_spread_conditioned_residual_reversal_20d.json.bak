{
  "factor_id": "miner_2_20301128_us10y_cn10y_spread_conditioned_residual_reversal_20d",
  "factor_name": "US10Y-CN10Y Spread Conditioned Cross-Asset Residual Reversal 20-Day",
  "version": "1.1",
  "calculation": {
    "expression": "(residual_20d_return / residualized_volatility_60d) * (0.5 + percentile_rank_252(US10Y-CN10Y))",
    "description": "Residualize each tradable asset's 20-day return against the equal-weight tradable-universe 20-day return using a causal 60-day rolling beta, divide by causal residual volatility, and scale by the causal 252-day percentile rank of the US10Y minus CN10Y close spread. Positive scores indicate higher expected forward return."
  },
  "dependencies": ["close", "US10Y", "CN10Y"],
  "parameters": {"residual_return_window": 20, "beta_window": 60, "volatility_window": 60, "macro_rank_window": 252, "forward_horizon_days": 10, "minimum_cross_section": 8, "tradable_universe_size": 15},
