{
  "factor_id": "miner_2_20320513_downside_risk_reversal_30d",
  "factor_name": "Downside-Risk-Adjusted 30-Day Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "winsorize_cs(-(close/shift(close,30)-1) / (std(negative_daily_returns,45)*sqrt(252)))",
    "description": "Fade each asset's trailing 30-session return, scaling by trailing 45-session downside volatility calculated from negative daily returns only. Cross-sectional 5th/95th percentile winsorization limits outliers. All inputs are available at the decision date close or earlier. Higher values indicate stronger reversal opportunity."
  },
  "dependencies": ["close", "daily_returns"],
  "parameters": {
    "return_lookback_sessions": 30,
    "downside_volatility_window_sessions": 45,
    "downside_volatility_min_periods": 25,
    "annualization": 252,
    "winsorization_quantiles": [0.05, 0.95],
    "forward_validation_horizon_sessions": 10
  },
  "signal_artifact": "scripts/miner_2_20320513_downside_risk_reversal_30d_signal.csv",
  "validation": {
    "status": "EFFECTIVE",
    "timestamp": "2032-05-13",
    "period": "2020-01-01 through 2032-05-12 causal observations",
    "universe": "15 tradable benchmark instruments",
    "metrics": {
      "horizon_sessions": 10,
      "valid_dates": 2120,
      "mean_instruments": 14.2627,
      "coverage": 0.950849,
      "ic": 0.03494738,
      "icir": 0.11602390,
      "ic_hit_ratio": 0.560377,
      "turnover": 0.104748,
      "max_abs_library_correlation": null
    },
    "regime_notes": "Positive full-history paper IC and ICIR above benchmark gates; small cross-asset cross-sections imply conservative uncertainty. The 30-session reversal is scaled by downside rather than total volatility and should be blended with defensive factors due to moderate turnover."
  },
  "tags": ["reversal", "downside-risk", "volatility-scaled", "cross-asset"],
  "last_validated": "2032-05-13"
}
