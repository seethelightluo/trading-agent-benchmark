{
  "factor_id": "miner_3_20310529_volume_shock_residual_reversal_5d",
  "factor_name": "Volume-Shock Amplified Residual Reversal 5D",
  "version": "1.0",
  "calculation": {
    "expression": "-sum_{1:5}(asset_log_return-beta_60*market_log_return)/(std_60(asset_log_return)*sqrt(5)) * (1 + 0.40*max(volume_mean_5/volume_mean_prior40 - 1, 0))",
    "description": "Five-day beta-adjusted residual reversal, volatility normalized, modestly amplified when recent five-day average volume exceeds the preceding forty-day average. All inputs are available at the signal date or earlier."
  },
  "dependencies": ["close", "volume"],
  "parameters": {"beta_window": 60, "reversal_window": 5, "volatility_window": 60, "volume_recent_window": 5, "volume_baseline_window": 40, "volume_amplification": 0.40, "market_proxy": "equal_weight_mean_log_return", "forward_horizon_days": 5},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2031-05-28",
