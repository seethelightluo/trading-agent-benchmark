{
  "factor_id": "miner_3_20340202_range_shock_reversal",
  "factor_name": "Range-position volatility-scaled shock reversal",
  "version": "1.1",
  "calculation": {
    "expression": "clip(-(return_5d / (std(return_1d,20)*sqrt(20))),-5,5) * (1 + 0.75*(1 - range_position_60d))",
    "description": "Ranks recent five-day selloffs positively for reversal, scales by 20-day realized volatility, and increases the score when price is near its causal 60-day rolling low. All rolling inputs are lag-safe at the signal date."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "shock_window_days": 5,
    "volatility_window_days": 20,
    "range_window_days": 60,
    "range_amplifier": 0.75,
    "clip": [
      -5,
      5
    ],
    "forward_horizon_days": 10
  },
