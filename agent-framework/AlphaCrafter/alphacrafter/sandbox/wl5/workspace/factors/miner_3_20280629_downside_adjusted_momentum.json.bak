{
  "factor_id": "miner_3_20280629_downside_adjusted_momentum",
  "factor_name": "20-day downside-adjusted momentum",
  "version": "20280629.v1",
  "calculation": {
    "expression": "rolling_sum(pct_change(close),20) / (rolling_std(where(pct_change(close)<0,pct_change(close),0),20)+1e-6)",
    "description": "Ranks assets by their trailing 20-trading-day cumulative return normalized by the volatility of negative daily returns. Higher values indicate momentum achieved with less downside variability. Signal is formed using data through the decision date and evaluated against the subsequent 10-trading-day return."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "lookback_days": 20,
    "forward_horizon_days": 10,
    "downside_floor": 1e-06
  },
