{
  "factor_id": "miner_1_20350621_downside_asymmetry_accel_reversal_10d",
  "factor_name": "Downside-asymmetry acceleration residual reversal",
  "version": "1.0",
  "calculation": {
    "expression": "clip((-cross_sectional_return_sum(10)/(realized_volatility(40)*sqrt(10))) * (1 + 0.75*clip(asymmetry_20/asymmetry_20_lag5 - 1,-1,1)),-8,8)",
    "description": "Causal 10-session volatility-scaled residual reversal amplified or attenuated by the five-session change in each asset's downside-to-upside return-amplitude ratio. Downside and upside amplitudes use rolling 20-session conditional absolute/positive returns with five observations minimum."
  },
  "dependencies": ["close", "pct_change"],
  "parameters": {"reversal_window": 10, "volatility_window": 40, "asymmetry_window": 20, "acceleration_lag": 5, "amplifier": 0.75, "clip": 8.0, "min_cross_section": 8},
