{
  "factor_id": "miner_2_20311113_volume_shock_reversal_5d",
  "factor_name": "Volume-shock weighted five-day reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(sum(log(close_t/close_{t-1}), t=-4..0) / std_60d(log_returns)) * (1 + 0.35*clip(log(volume_t/mean_volume_20d), -1, 1))",
    "description": "Contrarian five-day return normalized by trailing 60-day volatility, with a bounded boost for unusually high or low current volume relative to its trailing 20-day mean. All inputs are known at the signal date. Higher values indicate stronger expected forward return."
  },
  "dependencies": ["close", "volume"],
  "parameters": {"return_window_days": 5, "volatility_window_days": 60, "volume_baseline_days": 20, "volume_log_clip": 1.0, "volume_multiplier": 0.35, "forward_horizon_days": 5},
  "validation": {
    "status": "EFFECTIVE",
    "period": {"start": "2020-01-01", "end": "2031-11-12", "as_of": "2031-11-13"},
    "metrics": {
