{
  "factor_id": "miner_3_20321223_breadth_vix_conditioned_downside_reversal_20d",
  "factor_name": "Breadth/VIX-Conditioned Downside-Volatility Reversal 20D",
  "version": "1.0",
  "calculation": {
    "expression": "rank_pct((-sum(log_return,120) / downside_std(log_return,90)) * (1 + 0.60*stress_breadth_20d*clip(eqvol_20d/histvol_120d,0.5,2.0) + 0.50*vix_stress_60d)",
    "description": "Cross-sectional reversal score: negative trailing 120-day log return normalized by 90-day downside volatility, amplified by causal market breadth stress/volatility expansion and elevated VIX relative to its trailing 60-day history. Percentile rank is computed cross-sectionally each date. All inputs end no later than the prior completed day. Forward validation horizon is 20 trading days."
  },
  "dependencies": ["close", "VIX close"],
  "parameters": {
    "reversal_window_days": 120,
    "downside_volatility_window_days": 90,
    "breadth_window_days": 20,
    "historical_market_vol_window_days": 120,
    "vix_window_days": 60,
    "breadth_coefficient": 0.60,
    "vix_coefficient": 0.50,
    "min_cross_section": 8,
    "forward_horizon_days": 20
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2032-12-22 (causal observations; forward 20-day returns)",
    "metrics": {
      "ic": 0.058151,
      "icir": 0.167257,
      "hit_ratio": 0.57382,
      "usable_dates": 2933,
      "mean_instruments": 14.66,
      "coverage": 0.97716,
      "turnover": 0.035859,
      "max_abs_library_correlation": null
    },
    "regime_notes": "Small 15-instrument cross-asset universe; results interpreted conservatively. Regime IC: 2020-2024 -0.031518 (959 dates), 2025-2027 +0.081314 (697), 2028-2029 +0.129180 (521), 2030-2032-12-22 +0.101591 (756). Negative early regime indicates material regime dependence despite strong aggregate gate performance.",
    "signal_artifact": "scripts/miner_3_20321223_breadth_vix_reversal_20d_signal.csv"
  },
  "tags": ["reversal", "downside-volatility", "breadth", "VIX", "cross-asset", "20-day"],
