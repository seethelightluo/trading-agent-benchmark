{
  "factor_id": "miner_1_20330526_dxy_shock_neutral_reversal_10d",
  "factor_name": "DXY-shock-conditioned DXY-neutral reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-((sum_10(log_return_asset)-beta_60(asset,DXY)*sum_10(log_return_DXY))/(std_60(log_return_asset)*sqrt(10))) * clip(abs(sum_10(log_return_DXY))/(std_60(log_return_DXY)*sqrt(10)),0.5,2.0)",
    "description": "Ranks assets for reversal of their ten-day return residual to DXY exposure, volatility normalized and scaled by the magnitude of the recent DXY shock. All inputs are lagged through the decision date."
  },
  "dependencies": ["close", "DXY observation-only close"],
  "parameters": {"beta_window": 60, "signal_window": 10, "forward_horizon": 10, "min_beta_observations": 40, "shock_clip": [0.5, 2.0]},
  "validation": {
    "status": "EFFECTIVE",
    "period": {"start": "2020-03-31", "end": "2033-05-10", "as_of": "2033-05-26"},
