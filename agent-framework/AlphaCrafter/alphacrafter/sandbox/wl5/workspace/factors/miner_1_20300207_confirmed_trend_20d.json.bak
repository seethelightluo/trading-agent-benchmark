  "factor_name": "Breadth-Confirmed Risk-Adjusted Relative Trend 20d",
  "version": "1.0",
  "calculation": {
    "expression": "((return_10d - cross_sectional_median(return_10d)) / realized_vol_20d) * clip(2*breadth_10d_positive - 1, -1, 1)",
    "description": "Ranks assets by 10-day return relative to the cross-sectional median, normalizes by trailing 20-day realized volatility, and gates the signal by the breadth of assets with positive 10-day returns. Signal is causal through the previous completed trading day."
