  "factor_name": "Volatility-Shock Weighted Short Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(sum(log_return,5)/rolling_std(log_return,60)) * (rolling_std(log_return,5)/rolling_std(log_return,60))",
