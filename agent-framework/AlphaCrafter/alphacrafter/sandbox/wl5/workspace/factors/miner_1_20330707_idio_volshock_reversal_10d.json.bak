{
  "factor_id": "miner_1_20330707_idio_volshock_reversal_10d",
  "factor_name": "Idiosyncratic Volatility-Shock Reversal 10d",
  "version": "1.1",
  "calculation": {
    "expression": "-rolling_sum_10(asset_return - beta_40_to_equal_weight_market*market_return) * (1 + 0.5*I(idio_vol_20 > causal_126d_75th_percentile))",
    "description": "Estimate causal 40-day beta to the equal-weighted 15-asset tradable universe, calculate idiosyncratic residual returns, reverse the trailing 10-day residual shock, and amplify by 50% during high idiosyncratic-volatility states."
  },
  "dependencies": [
    "close",
    "tradable_universe_cross_section"
  ],
  "parameters": {
    "beta_window": 40,
    "beta_min_periods": 30,
    "residual_horizon": 10,
    "residual_min_periods": 8,
    "idiosyncratic_vol_window": 20,
    "idiosyncratic_vol_min_periods": 15,
    "threshold_window": 126,
    "threshold_min_periods": 80,
    "threshold_quantile": 0.75,
    "shock_multiplier": 0.5,
    "forward_horizon_for_validation": 10
  },
