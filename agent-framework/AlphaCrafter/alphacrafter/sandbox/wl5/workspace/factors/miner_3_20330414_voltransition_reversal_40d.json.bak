{
  "factor_id": "miner_3_20330414_voltransition_reversal_40d",
  "factor_name": "Volatility-Transition Gated Downside Reversal 40d",
  "version": "1.0",
  "calculation": {
    "expression": "rank_pct((-sum(log_return,80d)/std(negative_log_return,90d)) * (1 + 0.55*clip(recent_cross_asset_vol_10d/vol_60d - 1,0,1.5)/1.5 + 0.35*clip((0.5-breadth_20d)*2,0,1) + 0.35*clip(vix_zscore_60d,0,2)/2)",
    "description": "Cross-sectional downside-volatility normalized medium-term reversal, amplified after a recent cross-asset volatility transition and modestly conditioned on weak breadth and elevated VIX. All inputs use observations through the prior completed session."
  },
  "dependencies": [
    "close",
    "VIX"
  ],
  "parameters": {
    "reversal_window": 80,
    "downside_vol_window": 90,
    "recent_vol_window": 10,
    "baseline_vol_window": 60,
    "breadth_window": 20,
    "vix_window": 60,
    "forward_horizon_days": 40,
    "shock_weight": 0.55,
    "breadth_weight": 0.35,
    "vix_weight": 0.35
  },
