{
  "factor_id": "miner_1_20351025_dispersion_gated_residual_reversal_10d",
  "factor_name": "Dispersion-gated volatility-scaled residual reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-rolling_sum(residual_return,10)/rolling_std(residual_return,20) * clip(rolling_mean(cross_sectional_dispersion,20)/rolling_median(...,120),0.5,2.0)",
    "description": "Reverse each instrument's causal 10-session return relative to the equal-weight benchmark, scale by causal 20-session residual volatility, and amplify or attenuate according to the recent cross-asset dispersion regime. Uses only completed observations."
  },
  "dependencies": ["close"],
  "parameters": {"residual_benchmark": "equal_weight_mean_return", "reversal_window": 10, "volatility_window": 20, "dispersion_window": 20, "dispersion_baseline_window": 120, "dispersion_clip": [0.5, 2.0], "admission_horizon_days": 10},
  "validation": {
