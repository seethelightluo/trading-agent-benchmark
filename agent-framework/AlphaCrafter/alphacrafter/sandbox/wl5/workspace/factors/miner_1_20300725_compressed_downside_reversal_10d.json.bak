{
  "factor_id": "miner_1_20300725_compressed_downside_reversal_10d",
  "factor_name": "Compressed Downside Reversal 10D",
  "version": "1.0",
  "calculation": {
    "expression": "-min(ret_5d, 0) / (vol_20d + 1e-12) * sqrt(vol_60d / (vol_20d + 1e-12))",
    "description": "Ranks assets by recent downside magnitude normalized by short-term realized volatility, with a square-root compression adjustment rewarding assets whose 60-day volatility is high relative to 20-day volatility. Positive values identify recent losers with potentially attractive reversal characteristics; non-losers receive zero. All inputs use data available through the signal date."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "return_window_days": 5,
    "short_vol_window_days": 20,
    "long_vol_window_days": 60,
    "forward_horizon_days": 10,
    "volatility_definition": "standard deviation of daily log returns",
    "epsilon": 1e-12
  },
