{
  "factor_id": "miner_2_20331027_trend_efficiency60_inverse",
  "factor_name": "Skip-5 Trend-Efficiency 60D Volatility-Scaled Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-((R60_shift5 / (sqrt(60)*RV40_shift1)) * (0.5 + abs(R60_shift5)/sum(abs(daily_returns),60)_shift5))",
    "description": "Fade the 60-trading-day return measured five sessions before the decision, scale by 40-day realized volatility, and amplify by causal path efficiency. The five-session skip avoids immediate short-horizon contamination; clipping path efficiency to [0,1] limits amplification."
  },
  "dependencies": [
    "close",
    "daily_returns"
  ],
  "parameters": {
    "lookback_return": 60,
    "skip_sessions": 5,
    "volatility_window": 40,
    "path_window": 60,
    "min_return_observations": 45,
    "min_volatility_observations": 30,
    "forward_horizon": 10
  },
