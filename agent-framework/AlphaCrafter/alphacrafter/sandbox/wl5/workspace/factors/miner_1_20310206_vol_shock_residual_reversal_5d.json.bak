  "factor_name": "Volatility-Shock-Conditioned Residual Reversal (5D)",
  "version": "1.0",
  "calculation": {
    "expression": "-residual_return_5d / residual_volatility_20d * clip(residual_volatility_20d / residual_volatility_prior_40d, 0.75, 1.75)",
    "description": "Subtract the cross-sectional median log return each day, take the negative five-session cumulative residual return, normalize by trailing 20-session residual volatility, and condition strength on a temporary volatility shock versus the preceding 40 sessions. All inputs end at the decision cutoff. Higher values indicate stronger expected five-day rebound."
  },
  "dependencies": ["close"],
  "parameters": {"reversal_window": 5, "volatility_window": 20, "prior_volatility_window": 40, "shock_clip": [0.75, 1.75], "minimum_cross_section": 8},
