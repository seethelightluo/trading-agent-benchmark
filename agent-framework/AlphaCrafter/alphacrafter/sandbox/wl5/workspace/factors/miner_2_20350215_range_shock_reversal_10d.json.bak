{
  "factor_id": "miner_2_20350215_range_shock_reversal_10d",
  "factor_name": "Range-Shock Amplified Idiosyncratic Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "clip((-CSUM10/((STD40(CS)*sqrt(10))+eps))*(1+0.30*tanh(MEAN3((TRANGE-mean40(TRANGE))/(std40(TRANGE)+eps))),-8,8)",
    "description": "Fades a ten-session cumulative cross-sectional residual return, risk-normalized by 40-session residual volatility, with bounded amplification after an unusually wide high-low trading range. All inputs are causal at the signal date."
  },
  "dependencies": ["close", "high", "low", "pct_change"],
  "parameters": {
    "reversal_window": 10,
    "risk_window": 40,
    "range_smoothing_window": 3,
    "range_baseline_window": 40,
    "amplification": 0.30,
    "clip": [-8, 8],
    "minimum_valid_instruments": 8,
    "forward_horizon_days": 10
  },
  "validation": {
