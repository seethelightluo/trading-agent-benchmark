{
  "factor_id": "miner_1_20350315_volume_confirmed_reversal_10d",
  "factor_name": "Volume-confirmed cross-sectional residual reversal",
  "version": "1.0",
  "calculation": {
    "expression": "clip(-rolling_sum_10(cross_sectional_daily_return)/[sqrt(10)*rolling_std_40(cross_sectional_daily_return)],-8,8) * clip(1 + 0.35*tanh(volume_surprise_40),0.65,1.35)",
    "description": "Ranks instruments by volatility-normalized reversal of their 10-session return relative to the cross-sectional daily mean, amplified when log1p volume is unusually high versus its trailing 40-session history. All inputs are lagged completed-day observations."
  },
  "dependencies": ["close", "volume"],
  "parameters": {"reversal_window": 10, "volatility_window": 40, "volume_surprise_window": 40, "min_periods_return": 8, "min_periods_volatility": 25, "min_periods_volume": 25, "clip_reversal": [-8, 8], "volume_multiplier": 0.35, "multiplier_clip": [0.65, 1.35]},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2023-09-08 through 2035-02-28",
    "metrics": {"horizon_sessions": 10, "ic": 0.040380, "icir": 0.134438, "ic_hit_ratio": 0.551148, "usable_dates": 2395, "mean_valid_instruments": 14.776, "coverage": 0.985052, "rank_turnover": 0.112631, "max_abs_library_correlation": null, "decay_ic_5d": 0.034167, "decay_ic_20d": 0.046914},
    "regime_notes": "Regime IC: 2023-08-23 to 2025-12-31 +0.003788 (152 dates); 2026-2027 +0.057813 (375); 2028-2030 +0.017707 (782); 2031-2035-02-28 +0.055807 (1086). Small cross-asset universe; uncertainty interpreted conservatively. Meets absolute IC >= 0.0070 and absolute daily paper ICIR >= 0.0840.",
    "signal_artifact": "scripts/miner_1_20350315_volume_confirmed_reversal_signal.csv"
  },
  "tags": ["reversal", "volume", "cross-sectional", "volatility-adjusted"],
  "last_validated": "2035-03-15T00:00:00Z"
}