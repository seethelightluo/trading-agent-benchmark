{
  "factor_id": "miner_2_20310710_downside_residual_reversal_5d",
  "factor_name": "Downside-Volatility-Normalized Residual Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "clip(-sum_5d(log_return - beta_60d*equal_weight_market_return)/(sqrt(5)*downside_deviation_60d), q05, q95)",
    "description": "For each tradable asset, estimate a causal 60-day beta to the equal-weight cross-asset market, compute its five-day beta-adjusted residual return, and reverse it after normalization by 60-day downside deviation. Cross-sectional 5th/95th percentile clipping limits extreme signals. All inputs are lagged through the observation date."
  },
  "dependencies": ["close", "15-asset tradable universe"],
  "parameters": {"residual_window_days": 5, "risk_window_days": 60, "beta_window_days": 60, "forward_horizon_days": 5, "clip_quantiles": [0.05, 0.95], "minimum_cross_section": 8},
  "validation": {
