{
  "factor_id": "miner_2_20350426_dispersion_transition_residual_reversal_10d",
  "factor_name": "Dispersion-transition conditioned residual reversal",
  "version": "1.0",
  "calculation": {
    "expression": "clip(-cross_sectional_residual_return_sum(10d)/(residual_volatility(40d)*sqrt(10)), -8, 8) * clip(1 + 0.40*tanh(mean_3d(zscore_60d(cross_sectional_dispersion) - lag(zscore_60d(cross_sectional_dispersion),5))), 0.60, 1.40)",
    "description": "Ranks assets by normalized ten-day reversal of returns residualized by the contemporaneous cross-sectional mean. Multiplies the reversal signal by a bounded, causal transition response to changes in the 60-day standardized cross-sectional return dispersion. All inputs are lagged by the decision convention and use only completed observations."
  },
  "dependencies": ["close", "daily_returns"],
  "parameters": {
    "reversal_window": 10,
    "volatility_window": 40,
    "dispersion_zscore_window": 60,
    "transition_lag": 5,
    "transition_smoothing_window": 3,
    "multiplier_scale": 0.40,
    "multiplier_bounds": [0.60, 1.40],
    "minimum_cross_section": 8
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2023-10-20/2035-04-11",
    "validated_horizon_days": 10,
    "metrics": {
      "ic": 0.037632,
      "icir": 0.123899,
      "ic_hit_ratio": 0.548361,
      "valid_dates": 2440,
      "mean_instruments": 14.757,
      "coverage": 0.98377,
      "rank_turnover": 0.11295,
      "decay_ic_5d": 0.035421,
      "decay_ic_20d": 0.048391,
      "regime_ic_2023_2025": -0.001861,
      "regime_ic_2026_2030": 0.030751,
      "regime_ic_2031_2035": 0.050676,
      "max_abs_library_correlation": null
    },
    "regime_notes": "Weak in the earliest validation regime, positive in 2026-2030 and strongest in 2031-2035. Small 15-asset cross-section implies conservative uncertainty interpretation.",
    "provenance": {
      "validation_script": "scripts/miner_2_20350426_dispersion_transition_reversal.py",
