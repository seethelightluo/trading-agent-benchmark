{
  "factor_id": "miner_2_20301114_us10y_conditioned_residual_reversal_20d",
  "factor_name": "US10Y-Conditioned Cross-Asset Residual Reversal 20-Day",
  "version": "1.0",
  "calculation": {
    "expression": "-(asset_return_20d - causal_beta_60d * universe_mean_return_20d) / (causal_residual_volatility_60d) * (0.5 + percentile_rank_252d(US10Y))",
    "description": "Inverse residualized 20-day return, normalized by causal 60-day residual volatility and scaled by the causal 252-day percentile rank of the tradable US10Y yield series. US10Y is tradable in this benchmark and is used as the conditioning series; no future observations are used. Higher values indicate stronger expected forward 10-day return."
  },
  "dependencies": ["close", "US10Y close"],
  "parameters": {"residual_return_window": 20, "beta_window": 60, "min_beta_observations": 40, "volatility_window": 60, "min_volatility_observations": 40, "macro_percentile_window": 252, "min_macro_percentile_observations": 100, "forward_horizon_days": 10, "minimum_cross_section": 8, "orientation": "inverse"},
  "validation": {
