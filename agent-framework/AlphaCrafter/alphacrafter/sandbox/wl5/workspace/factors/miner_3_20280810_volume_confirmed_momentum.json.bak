{
  "factor_id": "miner_3_20280810_volume_confirmed_momentum",
  "factor_name": "Volume-Confirmed Risk-Normalized 20-Day Momentum",
  "version": "1.0",
  "calculation": {
    "expression": "(sum_return_20d / (std_daily_return_20d * sqrt(20) + 1e-6)) * (1 + 0.35 * clip(volume_mean_5d / volume_mean_60d - 1, -1, 3))",
    "description": "Ranks assets by 20-day momentum normalized by 20-day realized risk, strengthened when recent five-day volume is above its 60-day baseline. All inputs are lagged through the prior completed session at decision time."
  },
  "dependencies": ["close", "volume"],
  "parameters": {"return_window": 20, "risk_window": 20, "volume_fast_window": 5, "volume_slow_window": 60, "volume_weight": 0.35, "forward_horizon_days": 10},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-03-01 to 2028-07-26",
    "last_validated": "2028-08-10T00:00:00Z",
    "metrics": {
      "ic": 0.037657,
      "icir": 0.115852,
      "ic_hit_ratio": 0.5532,
      "forward_horizon_days": 10,
      "dates": 2858,
      "instruments": 15,
      "average_instruments_per_date": 15.0,
      "coverage": 0.9999,
      "rank_turnover": 0.080048,
      "max_abs_library_correlation": null
    },
    "regime_notes": "Positive and above admission gates in 2027-28 (IC 0.032791, ICIR 0.103348); negative in 2020-24 and 2025-26, so use as a modest continuation sleeve and monitor regime drift. The 15-name cross-section is small; inference relies on 2,858 dates and should be interpreted conservatively.",
    "signal_artifact": "scripts/miner_3_20280810_volume_confirmed_momentum_signal.csv"
  },
  "tags": ["momentum", "volume", "risk_adjusted", "cross_asset", "continuation"],
