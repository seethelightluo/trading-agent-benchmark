{
  "factor_id": "miner_1_20280713_downside_adjusted_momentum_20d",
  "factor_name": "Downside-volatility-adjusted 20-day momentum",
  "version": "1.0",
  "calculation": {
    "expression": "rolling_sum(pct_change(close),20) / rolling_std(min(pct_change(close),0),20)",
    "description": "Trailing 20-trading-day return divided by trailing 20-day downside return volatility; higher values indicate stronger momentum per unit of downside risk. Cross-sectional ranking is used by consumers."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "return_window": 20,
    "downside_vol_window": 20,
    "forward_horizon": 10,
    "epsilon": 1e-06
  },
