  "version": "2029-02-22",
  "calculation": {
    "expression": "-(return_5d(asset)-mean(return_5d(XAU,US10Y,CN10Y)))/(std(return_1d(asset),20)*sqrt(5))",
    "description": "Fades an instrument's five-day move relative to the defensive benchmark basket, normalized by its own 20-day realized volatility. The defensive basket is observation-free at the decision cutoff and consists only of tradable benchmark assets."
