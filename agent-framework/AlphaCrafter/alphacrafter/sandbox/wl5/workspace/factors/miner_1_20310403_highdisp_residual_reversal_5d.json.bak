{
  "factor_id": "miner_1_20310403_highdisp_residual_reversal_5d",
  "factor_name": "High-dispersion gated inverse-volatility residual reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-((sum(log_return,5)-cross_sectional_median(sum(log_return,5)))/rolling_std(log_return,60))*gate",
    "description": "For each tradable asset, reverse its causal five-day log-return residual versus the cross-sectional median and scale by inverse 60-day volatility. The signal is full strength when mean 20-day cross-asset daily dispersion is above its trailing 60-day median, and half strength otherwise. Dispersion is a market-state gate, not an asset selection filter. All inputs are lagged through the completed observation date."
  },
  "dependencies": ["close"],
  "parameters": {"short_return_window": 5, "volatility_window": 60, "dispersion_window": 20, "dispersion_baseline_window": 60, "low_dispersion_gate": 0.5, "high_dispersion_gate": 1.0, "forward_validation_horizon_days": 5},
  "validation": {
