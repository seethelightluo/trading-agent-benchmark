{
  "factor_id": "miner_1_20301226_activity_gated_residual_reversal_20d",
  "factor_name": "High-Activity Gated Cross-Asset Residual Reversal",
  "version": "20301226.v1",
  "calculation": {
    "expression": "-sum(return_i - cross_sectional_median(return), 10) / (std(return_i - cross_sectional_median(return), 60) * sqrt(20)) * I[median_abs_return_t >= rolling_40_quantile_60(median_abs_return, 60)]",
    "description": "Ranks tradable assets by ten-session reversal relative to the cross-asset median, normalized by trailing residual volatility. The signal activates only when lagged cross-asset absolute-return activity is above its trailing 60-session 60th percentile, using no future data."
  },
  "dependencies": ["close"],
  "parameters": {"reversal_window": 10, "volatility_window": 60, "activity_window": 60, "activity_quantile_window": 40, "activity_quantile": 0.60, "forward_horizon": 20, "min_cross_section": 8},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2030-12-25 causal cutoff",
    "last_validated": "2030-12-26",
    "metrics": {
      "ic": 0.031665,
      "icir": 0.105693,
      "forward_horizon_days": 20,
      "dates": 787,
      "mean_instruments": 14.60,
      "coverage": 0.97349,
      "hit_ratio": 0.53875,
      "rank_turnover": 0.129429,
      "max_abs_library_correlation": null,
      "decay": {"5d_ic": 0.019361, "10d_ic": 0.012308, "20d_ic": 0.031665}
    },
    "regime_notes": "20-day IC remained positive across 2020-2024 (0.024941), 2025-2027 (0.030469), 2028-2029 (0.029409), and 2030 YTD (0.059271). Small cross-asset universe requires conservative interpretation despite broad coverage."
  },
