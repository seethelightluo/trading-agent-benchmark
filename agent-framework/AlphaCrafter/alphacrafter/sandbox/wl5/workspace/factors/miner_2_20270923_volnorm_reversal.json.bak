{
  "factor_id": "miner_2_20270923_volnorm_reversal",
  "factor_name": "Volatility-normalized five-day reversal",
  "version": "20270923",
  "calculation": {
    "expression": "-return(close,5) / (std(pct_change(close),20) * sqrt(20))",
    "description": "Ranks instruments that have experienced a negative five-session return relative to their trailing 20-session annualized realized volatility; larger values indicate stronger normalized reversal potential. Signal uses only data through the decision-date close."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "return_window": 5,
    "volatility_window": 20,
    "min_periods": 15,
