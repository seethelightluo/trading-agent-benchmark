{
  "factor_id": "miner_3_20330929_residual_volscaled_reversal_20d",
  "factor_name": "Residualized volatility-scaled reversal 20d",
  "version": "1.0",
  "calculation": {
    "expression": "residual( -sum_return_20 / stdev_daily_return_20 | conditioned_reversal = -sum_return_20 / cross_asset_mean(stdev_daily_return_20) )",
    "description": "Cross-sectional residual from regressing volatility-scaled 20-day reversal on a dispersion-normalized reversal proxy. Positive values identify assets with unusually strong oversold reversal after removing the common dispersion-conditioned reversal component. Regression is cross-sectional and uses only information available at each date."
  },
  "dependencies": ["close"],
  "parameters": {
    "return_window": 20,
    "volatility_window": 20,
    "min_periods": 15,
    "forward_horizon": 10,
    "min_cross_section": 8,
    "residualization": "cross-sectional OLS with intercept"
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2026-07-28/2033-09-14",
    "metrics": {
      "ic": 0.009462,
      "icir": 0.485724,
      "ic_horizon_days": 10,
      "hit_ratio": 0.511278,
      "dates": 1862,
      "mean_instruments": 11.51,
      "coverage": 0.767347,
      "turnover": 0.110034,
      "max_abs_library_correlation": null
    },
    "regime_notes": "2025-2027: 374 observations, IC -0.029247, ICIR -1.530772 (no usable runtime data before 2026-07-28); 2028-2029: 521 observations, IC 0.036349, ICIR 2.033896; 2030-2033-09-14: 967 observations, IC 0.009946, ICIR 0.488671. Interpret conservatively because the cross-section averages 11.51 instruments.",
    "signal_artifact": "scripts/miner_3_20330929_residual_volscaled_reversal_20d_signal.csv"
