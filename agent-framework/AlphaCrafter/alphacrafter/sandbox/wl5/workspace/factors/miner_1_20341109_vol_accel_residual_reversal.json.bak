{
  "factor_id": "miner_1_20341109_vol_accel_residual_reversal",
  "factor_name": "Volatility-Acceleration Weighted Cross-Asset Residual Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "clip(-(r5_i-mean_cross_section(r5))/(sigma20_i*sqrt(5)) * clip(sigma20_i/sigma60_i,0.25,4.0), -8, 8)",
    "description": "Fade each instrument's five-day return relative to the contemporaneous equal-weight cross-asset five-day return, normalize by 20-day volatility, and amplify or attenuate by the ratio of short to medium volatility. All inputs are lagged completed daily observations."
  },
  "dependencies": ["close"],
  "parameters": {"relative_return_window": 5, "short_vol_window": 20, "medium_vol_window": 60, "vol_min_periods_short": 15, "vol_min_periods_medium": 40, "vol_ratio_clip": [0.25, 4.0], "signal_clip": [-8.0, 8.0], "forward_horizon": 10},
  "validation": {
