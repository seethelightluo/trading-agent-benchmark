{
  "factor_id": "miner_1_20310123_inverse_trend_40d_5d",
  "factor_name": "Inverse 40-day trend with short-term downside confirmation",
  "version": "1.0",
  "calculation": {
    "expression": "-log(close_t/close_{t-39})/(std(log_returns_{t-19:t})*sqrt(20)) * (0.5 + 0.5*I(log(close_t/close_{t-9}) < 0))",
    "description": "Contrarian medium-term trend signal, volatility normalized, with full strength for assets whose most recent 10-session trend is negative and half strength otherwise. Computed only from closes available at the decision cutoff. Higher values indicate stronger expected forward return."
  },
  "dependencies": ["close"],
  "parameters": {"trend_lookback_days": 40, "volatility_lookback_days": 20, "confirmation_lookback_days": 10, "volatility_annualization_factor": 20, "confirmation_multiplier_positive_recent_trend": 0.5, "confirmation_multiplier_negative_recent_trend": 1.0, "forward_horizon_days": 5},
  "validation": {
    "status": "EFFECTIVE",
    "period": {"start": "2020-01-01", "end": "2031-01-22", "causal_cutoff": "2031-01-22"},
    "metrics": {"horizon_days": 5, "dates": 1476, "mean_valid_instruments": 14.69, "coverage": 0.97963, "ic": 0.03243, "icir": 0.111039, "hit_ratio": 0.54336, "rank_turnover": 0.166735, "max_abs_library_correlation": null},
    "thresholds": {"absolute_daily_paper_ic_min": 0.007, "absolute_daily_paper_icir_min": 0.084},
    "regime_notes": "Positive IC in 2020-2024 (0.019665), 2025-2027 (0.029549), 2028-2029 (0.023989), and 2030-2031-01-22 (0.064337); recent strengthening is notable but uncertainty is material in a 15-instrument cross-section.",
    "signal_artifact": "scripts/miner_1_20310123_inverse_trend_40d_5d_signal.csv",
    "validation_timestamp": "2031-01-23T00:00:00Z"
  },
