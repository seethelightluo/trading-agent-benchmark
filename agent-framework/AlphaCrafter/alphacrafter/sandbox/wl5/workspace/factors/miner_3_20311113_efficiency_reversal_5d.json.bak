  "factor_name": "Path-efficiency twenty-day reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(sum(log_return,20) / (sum(abs(log_return),20) * (std(log_return,20)*sqrt(20)))",
    "description": "Contrarian signal on the signed 20-day move, divided by its realized path length and volatility. High positive values identify assets with inefficient/downward recent paths and expected short-horizon recovery; all inputs are lagged through the decision date."
  },
  "dependencies": ["close"],
  "parameters": {"lookback_days": 20, "volatility_floor": 1e-12, "forward_horizon_days": 5, "rank_correlation": "spearman"},
  "validation": {
