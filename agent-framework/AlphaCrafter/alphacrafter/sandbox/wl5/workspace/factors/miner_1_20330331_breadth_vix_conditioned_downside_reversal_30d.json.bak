{
  "factor_id": "miner_1_20330331_breadth_vix_conditioned_downside_reversal_30d",
  "factor_name": "Breadth/VIX-conditioned downside-volatility reversal, 30-day horizon",
  "version": "1.1",
  "calculation": {
    "expression": "rank_pct((-sum(log_return,120) / downside_std(log_return,90)) * (1 + 0.60*breadth_stress*cross_asset_dispersion_ratio + 0.50*vix_elevated_zscore))",
    "description": "Cross-sectional reversal signal, normalized by 90-day downside volatility and amplified during weak 20-day breadth/dispersion stress and elevated lagged VIX. All inputs are causal through the prior completed session."
  },
  "dependencies": [
    "close",
    "VIX.csv"
  ],
  "parameters": {
    "reversal_window_days": 120,
    "downside_vol_window_days": 90,
    "breadth_window_days": 20,
    "dispersion_window_days": 20,
    "dispersion_history_days": 120,
    "vix_z_window_days": 60,
    "forward_horizon_days": 30,
    "min_cross_section": 8
  },
