{
  "factor_id": "miner_3_20300404_dispersion_conditioned_reversal_5d",
  "factor_name": "High-dispersion inverse risk-adjusted 5-day reversal",
  "version": "1.0",
  "calculation": {
    "expression": "I(D_t > rolling_quantile_60%(D,252)) * demean_cs(-return_5d / (std_daily_20d * sqrt(252)))",
    "description": "When cross-asset daily-return dispersion is above its trailing 252-day 60th percentile, rank assets by the inverse of five-day return divided by trailing annualized 20-day volatility, after cross-sectional demeaning. Otherwise signal is unavailable. Positive values favor recent underperformers on a risk-adjusted basis."
  },
  "dependencies": ["close"],
  "parameters": {"return_window": 5, "volatility_window": 20, "dispersion_window": 252, "dispersion_quantile": 0.60, "min_cross_section": 8, "annualization": 252},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2030-04-03",
    "cutoff": "2030-04-03",
    "metrics": {
      "horizon_days": 5,
      "ic": 0.027671,
      "icir": 0.087725,
      "ic_hit_ratio": 0.5251,
      "ic_dates": 1274,
      "mean_instruments_per_date": 14.03,
      "min_instruments_per_date": 10,
      "coverage": 0.3794,
      "state_frequency": 0.37999,
      "turnover": null,
      "max_abs_library_correlation": null
    },
    "decay": {"5d_ic": 0.027671, "10d_ic": 0.019898, "20d_ic": 0.009407},
    "regime_notes": "Positive in 2020-2024 and 2025-2027 at the five-day horizon; negative in 2028-2030, indicating recent regime deterioration. Small 15-asset universe; uncertainty should be interpreted conservatively.",
    "artifact": "scripts/miner_3_20300404_dispersion_reversal_signal.csv",
    "validation_timestamp": "2030-04-04T00:00:00Z"
  },
