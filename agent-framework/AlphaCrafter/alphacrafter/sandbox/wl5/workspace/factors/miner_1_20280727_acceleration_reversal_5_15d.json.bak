{
  "factor_id": "miner_1_20280727_acceleration_reversal_5_15d",
  "factor_name": "Risk-normalized short-vs-medium acceleration reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(sum_return_5d - (sum_return_20d - sum_return_5d)/3) / (std_daily_return_20d * sqrt(20) + 1e-8)",
    "description": "Ranks instruments positively when their latest 5-day move has faded relative to the preceding 15-day average move, normalized by 20-day realized volatility. Higher values predict stronger 10-trading-day forward returns."
  },
  "dependencies": ["close"],
  "parameters": {"recent_window": 5, "prior_window": 15, "total_window": 20, "forward_horizon": 10, "min_cross_section": 8},
  "validation": {
