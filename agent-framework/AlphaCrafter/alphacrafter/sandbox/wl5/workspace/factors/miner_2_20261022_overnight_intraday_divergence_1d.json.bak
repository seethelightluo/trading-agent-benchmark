{
  "factor_id": "miner_2_20261022_overnight_intraday_divergence_1d",
  "factor_name": "Volatility-Scaled Overnight-Intraday Divergence",
  "version": "1.0",
  "calculation": {
    "expression": "(open_t / close_{t-1} - 1 - (close_t / open_t - 1)) / rolling_std(close_return,20)_t",
    "description": "Measures the one-session divergence between overnight and regular-session returns, scaled by trailing 20-session close-to-close volatility. Positive values favor assets with stronger overnight pressure relative to intraday pressure. Signal is formed only after the completed session and predicts next-session close return."
  },
  "dependencies": [
    "open",
    "close"
  ],
  "parameters": {
    "volatility_window": 20,
    "volatility_min_periods": 15,
    "forward_horizon_sessions": 1,
    "signal_lag": "after_close"
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2026-10-21",
    "metrics": {
