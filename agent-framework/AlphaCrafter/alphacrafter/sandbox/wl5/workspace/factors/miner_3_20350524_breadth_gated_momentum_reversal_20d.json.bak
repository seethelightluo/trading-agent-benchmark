{
  "factor_id": "miner_3_20350524_breadth_gated_momentum_reversal_20d",
  "factor_name": "Breadth-gated volatility-scaled 60-day momentum reversal",
  "version": "1.0",
  "calculation": {
    "expression": "clip(-(close/close.shift(60)-1)/(std(pct_change(close),20)*sqrt(20)), -8, 8) * clip(1 + 0.25*breadth_z, 0.55, 1.45)",
    "description": "Cross-asset 60-session momentum reversal, scaled by trailing 20-session volatility. Signal magnitude is modulated by the causal 60-session z-score of the fraction of tradable assets with positive 60-session momentum; the breadth state is bounded to limit regime and outlier sensitivity. The negative sign makes recent winners less attractive and recent losers more attractive.",
    "signal_artifact": "scripts/miner_3_20350524_breadth_gated_momentum_signal.csv"
  },
  "dependencies": ["close", "pct_change", "cross_sectional_breadth"],
  "parameters": {"momentum_window": 60, "volatility_window": 20, "breadth_z_window": 60, "breadth_multiplier_coefficient": 0.25, "signal_clip": 8.0, "minimum_valid_instruments": 8},
