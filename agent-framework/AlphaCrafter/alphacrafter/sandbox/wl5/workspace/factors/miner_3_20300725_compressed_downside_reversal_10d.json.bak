{
  "factor_id": "miner_3_20300725_compressed_downside_reversal_10d",
  "factor_name": "Volatility-compression weighted downside reversal 10d",
  "version": "2030-07-25",
  "calculation": {
    "expression": "-min(return(close,5),0)/std(log_return(close),20) * (std(log_return(close),60)/std(log_return(close),20))^0.5",
    "description": "Cross-sectional score for recent downside moves, adjusted by 20-day realized volatility and a modest volatility-compression multiplier; inputs are available through the decision date and evaluated against the subsequent 10-day return."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "reversal_lookback_days": 5,
    "short_volatility_days": 20,
    "long_volatility_days": 60,
    "compression_exponent": 0.5,
    "forward_horizon_days": 10,
    "minimum_cross_section": 8
  },
