{
  "factor_id": "miner_1_20281214_vol_compression_reversal",
  "factor_name": "Volatility-compression 20-day reversal",
  "version": "20281214",
  "calculation": {
    "expression": "-pct_change(close,20) * (1 + clip(1 - realized_vol_20 / realized_vol_60, -0.5, 0.5)); cross_sectional_demean",
    "description": "Fades the 20-trading-day return, with the contrarian signal amplified when short-horizon realized volatility is compressed relative to the 60-day baseline. Cross-sectional demeaning is applied each date."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "return_window": 20,
    "short_vol_window": 20,
    "long_vol_window": 60,
    "vol_min_periods_short": 15,
    "vol_min_periods_long": 40,
    "amplifier_clip": [
      -0.5,
      0.5
    ],
    "forward_horizon": 10
  },
