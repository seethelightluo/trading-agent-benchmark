{
  "factor_id": "miner_3_20310123_dispersion_weighted_fast_medium_reversal_5d",
  "factor_name": "Dispersion-weighted fast/medium residual reversal",
  "version": "1.0",
  "calculation": {
    "expression": "( -sum(residual_log_return,5)/vol30 + 0.5*dispersion_state*(-sum(residual_log_return,60)/vol60) ) / (1 + 0.5*dispersion_state)",
    "description": "Cross-asset residual reversal blending a fast 5-day and medium 60-day leg, each volatility normalized; the medium leg receives a smooth multiplier from recent versus trailing cross-asset dispersion. Residual return is asset log return minus same-day cross-sectional median. All inputs are lagged through the decision date."
  },
  "dependencies": ["close"],
  "parameters": {"fast_window": 5, "medium_window": 60, "fast_vol_window": 30, "medium_vol_window": 60, "dispersion_window": 20, "dispersion_baseline_window": 118, "medium_base_weight": 0.5, "state_clip": [0.5, 1.5], "forward_horizon_days": 5},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2031-01-22 causal daily data",
    "validated_at": "2031-01-23",
    "metrics": {"ic": 0.028725, "icir": 0.090936, "dates": 2128, "mean_instruments": 14.52, "coverage": 0.96832, "turnover": 0.104757, "hit_ratio": 0.53901, "max_abs_library_correlation": null},
    "decay": {"10d_ic": 0.024186, "10d_icir": 0.077848, "20d_ic": 0.021047, "20d_icir": 0.065878},
    "regime_notes": "Negative in 2020-2024 (IC -0.007776), positive in 2025-2027 (0.035530), 2028-2029 (0.045576), and 2030-2031-01-22 (0.041879); interpret full-history small-universe estimates conservatively."
  },
  "signal_artifact": "scripts/miner_3_20310123_blended_reversal_signal.csv",
  "tags": ["reversal", "residual", "dispersion", "cross_asset", "volatility_adjusted"]
}
