{
  "factor_id": "relative_reversal20_volscaled",
  "factor_name": "Cross-Asset Relative 20-Day Volatility-Scaled Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(return(close,20) - cross_sectional_median(return(close,20))) / (rolling_std(daily_return,40) * sqrt(20))",
    "description": "For each tradable benchmark asset, invert its 20-trading-day return relative to the cross-sectional median and scale by its trailing 40-day realized volatility. Higher values indicate stronger relative reversal opportunities. All inputs are lagged completed-day data."
  },
  "dependencies": ["close"],
  "parameters": {
    "lookback_return_days": 20,
    "volatility_window_days": 40,
    "forecast_horizon_days": 10,
    "minimum_cross_section": 8,
    "universe_size": 15
  },
  "validation": {
