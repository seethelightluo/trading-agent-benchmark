  "factor_name": "Market-residual risk-scaled 60-day momentum reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-sum_60(residual_return) / (sqrt(60)*rolling_std_60(residual_return))",
    "description": "For each tradable asset, estimate lagged 60-day beta to the equal-weight 15-asset benchmark, calculate 60-day cumulative residual return, and reverse it after scaling by trailing residual volatility. All rolling inputs are lagged to avoid look-ahead."
