{
  "factor_id": "miner_2_20340105_candle_reversal5",
  "factor_name": "Intraday Candle Pressure Contrarian Reversal (5d)",
  "version": "1.0",
  "calculation": {
    "expression": "-mean_{5d}((close-open)/(high-low))",
    "description": "For each tradable benchmark instrument, compute the five-day mean of the daily close-open candle body normalized by that day's high-low range, then negate it. Instruments with recent positive candle pressure receive lower scores and recent negative pressure receive higher contrarian scores. Zero ranges are treated as missing.",
    "signal_artifact": "scripts/miner_2_20340105_candle_reversal5_signal.csv",
    "generator_script": "scripts/miner_2_20340105_candle_reversal5.py"
  },
  "dependencies": ["open", "close", "high", "low"],
  "parameters": {
    "lookback_days": 5,
    "forward_horizon_days": 10,
    "minimum_observations_per_cross_section": 8,
    "winsorization": [-5.0, 5.0],
    "zero_range_policy": "missing",
    "universe_size": 15
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-10 through 2033-12-21",
    "validation_date": "2034-01-05",
    "regime_notes": "Positive overall and strongly positive in 2026-2027 and 2030-2033; weaker but positive in 2028-2029 and near-neutral in the 2020-2025 warmup. Cross-asset sample is small, so uncertainty should be interpreted conservatively.",
