{
  "factor_id": "miner_2_20301226_vix_stress_residual_reversal_20d",
  "factor_name": "VIX-Stress-Conditioned Cross-Asset Residual Reversal 20-Day",
  "version": "1.1",
  "calculation": {
    "expression": "shift_1((-residual_return_20d / rolling_std(residual_return_20d,60)) * (0.5 + percentile_rank_252(VIX.shift_1)))",
    "description": "For each tradable asset, remove its rolling-beta exposure to the equal-weight cross-asset 20-day benchmark, volatility-normalize the residual, reverse it, and amplify the signal when lagged VIX is elevated. All inputs are lagged or trailing to prevent look-ahead."
  },
  "dependencies": ["close", "VIX", "15-asset tradable watchlist"],
  "parameters": {"residual_horizon_days": 20, "beta_window_days": 60, "volatility_window_days": 60, "vix_percentile_window_days": 252, "forecast_horizon_days": 10, "minimum_cross_section": 8},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2026-10-19/2030-12-11",
    "validated_at": "2030-12-26T00:00:00Z",
    "metrics": {"daily_paper_ic": 0.0389100129, "daily_paper_icir": 0.1362334075, "same_horizon_ic_10d": 0.0389100129, "same_horizon_icir_10d": 0.1362334075, "ic_hit_ratio": 0.5687903970, "valid_dates": 1083, "mean_instruments": 12.9224, "coverage": 0.8614958449, "turnover": null, "max_abs_library_correlation": null},
    "decay": {"horizon": "10d", "interpretation": "Signal is designed for the 10-trading-day rebalance horizon; prior validation showed persistence through 20 days."},
    "regime_notes": "Validated across multiple regimes in a small 15-instrument cross-asset universe; uncertainty is interpreted conservatively.",
    "signal_artifact": "scripts/miner_2_20301226_vix_stress_residual_reversal_signal.csv",
