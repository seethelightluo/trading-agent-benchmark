{
  "factor_id": "miner_3_20301128_trend_confirmed_residual_reversal_5d",
  "factor_name": "Trend-confirmed robust residual reversal (5d)",
  "version": "2030-11-28",
  "calculation": {
    "expression": "(-sum_5(residual_return) / (sqrt(30)*downside_std_30(residual_return))) * (1 + 0.5*tanh(5*sum_20(residual_return)))",
    "description": "For each tradable asset, subtract the daily cross-sectional median log return, reverse the latest five-day residual shock, normalize by 30-day downside residual volatility, and softly condition the signal on the preceding 20-day residual trend. Positive values favor recent residual underperformers when medium-term residual trend is supportive. All inputs are lagged through the completed day."
  },
  "dependencies": ["close"],
  "parameters": {"shock_window_days": 5, "downside_window_days": 30, "trend_window_days": 20, "trend_scale": 5.0, "trend_multiplier": 0.5, "forward_horizon_days": 5, "minimum_cross_section": 8},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2030-11-28",
    "last_validated": "2030-11-28",
    "metrics": {
      "ic": 0.027186,
      "icir": 0.088413,
      "dates": 2111,
      "mean_instruments": 14.33,
      "coverage": 0.9556,
      "rank_turnover": 0.151734,
      "hit_ratio": 0.52487,
      "decay_10d_ic": 0.015497,
      "decay_10d_icir": 0.05132,
      "decay_20d_ic": 0.010739,
      "decay_20d_icir": 0.033834,
      "max_abs_library_correlation": null
    },
    "regime_notes": "Positive in 2020-2024 and 2025-2027, weaker in 2028-2029, and negative in 2030 YTD; use conservatively and revalidate promptly. Small cross-asset universe implies uncertainty.",
    "signal_provenance": "scripts/miner_3_20301128_trend_confirmed_residual_reversal_signal.csv"
  },
  "tags": ["reversal", "cross_asset", "residual", "downside_scaled", "regime_conditioned"]
}
