{
  "factor_id": "miner_2_20330707_idio_trend_gate_reversal_10d",
  "factor_name": "Idiosyncratic Shock Reversal with Trend-Instability Gate",
  "version": "1.0",
  "calculation": {
    "expression": "-idio_return_sum(10) * (0.5 + 0.5*I(|idio_return_sum(60)| < rolling_quantile_126(|idio_return_sum(60)|, 0.60)) )",
    "description": "For each tradable benchmark asset, remove rolling 40-day market-beta exposure from daily returns, reverse the trailing 10-day idiosyncratic shock, and apply only half strength when the 60-day idiosyncratic trend is unusually large. This reduces reversal exposure against persistent residual trends while retaining contrarian response to ordinary shocks. All inputs are lagged/canonical as of the signal date."
  },
  "dependencies": [
    "close",
    "cross_asset_returns"
  ],
  "parameters": {
    "beta_window_days": 40,
    "beta_min_periods": 30,
    "shock_window_days": 10,
    "shock_min_periods": 8,
    "trend_window_days": 60,
    "trend_min_periods": 45,
    "gate_history_days": 126,
    "gate_quantile": 0.6,
    "forward_horizon_days": 10,
    "universe": "15 tradable benchmark instruments"
  },
  "validation": {
    "status": "EFFECTIVE",
