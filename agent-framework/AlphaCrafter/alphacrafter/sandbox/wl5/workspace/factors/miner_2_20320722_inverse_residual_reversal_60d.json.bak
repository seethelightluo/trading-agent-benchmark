{
  "factor_id": "miner_2_20320722_inverse_residual_reversal_60d",
  "factor_name": "60-Day Inverse Cross-Asset Residual Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "rank_pct(-sum_{t=-20..-1}(r_asset,t - beta_asset*r_market,t) / std_{60}(r_asset - beta_asset*r_market))",
    "description": "Compute each asset's 60-session beta to the equal-weight cross-asset mean log return, form beta-adjusted residual returns, and rank the negative recent 20-session residual return normalized by 60-session residual volatility. Higher scores indicate stronger residual oversold reversal potential. All inputs are lagged to the decision date."
  },
  "dependencies": ["close"],
  "parameters": {
    "market_proxy": "equal_weight_mean_log_return_of_15_tradable_assets",
    "beta_window_days": 60,
    "signal_window_days": 20,
    "risk_window_days": 60,
    "forward_horizon_days": 10,
    "minimum_cross_section": 8,
    "ranking": "cross_sectional_percentile"
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2032-07-21 causal observations",
    "metrics": {
      "ic": 0.0354,
      "icir": 0.118637,
      "forward_horizon_days": 10,
      "valid_dates": 2510,
      "mean_instruments": 14.6,
      "coverage": 0.97315,
      "turnover": 0.079473,
      "hit_ratio": 0.54821,
      "max_abs_library_correlation": null
    },
    "regime_notes": "Near-zero in 2020-2024, positive in 2025-2027, strong in 2028-2029, and positive in 2030-2032. Results are encouraging but uncertainty is material because the cross-section has 15 assets.",
    "signal_artifact": "scripts/miner_2_20320722_inverse_residual_reversal_signal.csv"
  },
  "tags": ["cross_asset", "residual", "reversal", "volatility_adjusted", "market_neutral_proxy"],
  "last_validated": "2032-07-22T00:00:00Z"
}
