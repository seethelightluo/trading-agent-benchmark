{
  "factor_id": "miner_2_20280224_shock_reversal_3d",
  "factor_name": "Volatility-normalized 3-session shock reversal",
  "version": "2028-02-24",
  "calculation": {
    "expression": "-( (close_t/close_{t-3}-1) / (std(pct_change(close),30)*sqrt(3)) - cross_sectional_median )",
    "description": "Ranks instruments higher when their recent 3-session return is unusually negative versus their own 30-session volatility and relative to the cross-asset median."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "shock_window": 3,
    "vol_window": 30,
    "forward_horizon": 10,
    "minimum_cross_section": 8
  },
