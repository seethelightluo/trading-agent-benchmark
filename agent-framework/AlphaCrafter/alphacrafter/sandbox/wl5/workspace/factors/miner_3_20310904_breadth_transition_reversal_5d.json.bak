{
  "factor_id": "miner_3_20310904_breadth_transition_reversal_5d",
  "factor_name": "Breadth-Transition Amplified Residual Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-residual_return_5d/(rolling_volatility_60d*sqrt(5)) * (1 + 0.55*max(4*(breadth20-breadth5),0) - 0.20*max(-4*(breadth20-breadth5),0))",
    "description": "Cross-sectionally ranks five-day beta-adjusted residual reversal, with stronger reversal exposure after a causal deterioration in market breadth and mild suppression after improving breadth. Breadth is the mean fraction of the 15 tradable assets with positive daily returns over the stated windows."
  },
  "dependencies": ["close"],
  "parameters": {"beta_window": 60, "residual_window": 5, "volatility_window": 60, "breadth_long_window": 20, "breadth_short_window": 5, "breadth_scale": 4.0, "positive_transition_amplifier": 0.55, "negative_transition_suppressor": 0.20, "forward_horizon_days": 5},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2031-09-02",
    "metrics": {
      "ic": 0.029295,
