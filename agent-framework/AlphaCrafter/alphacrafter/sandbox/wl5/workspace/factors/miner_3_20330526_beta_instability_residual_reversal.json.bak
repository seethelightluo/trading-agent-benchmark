{
  "factor_id": "miner_3_20330526_beta_instability_residual_reversal",
  "factor_name": "Beta-instability conditioned market-residual reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-rolling_sum(asset_return - beta_60(asset,SPX)*SPX_return,20) * (1 + 0.5*I(abs(beta_60-beta_120_mean) > causal_252d_quantile(abs(beta_60-beta_120_mean),0.70)))",
    "description": "Reverse the causal 20-day cumulative market-residual return. Strength is increased by 50% when the asset's 60-day rolling beta deviation from its trailing 120-day mean is unusually high, capturing unstable cross-asset transmission without future data."
  },
  "dependencies": [
    "close",
    "daily_return",
    "SPX"
  ],
  "parameters": {
    "beta_window_days": 60,
    "beta_mean_window_days": 120,
    "instability_quantile_window_days": 252,
    "instability_quantile": 0.7,
    "residual_return_window_days": 20,
    "forward_horizon_days": 10,
    "normal_multiplier": 1.0,
    "unstable_multiplier": 1.5,
    "minimum_cross_section": 8,
    "rank_method": "spearman"
  },
