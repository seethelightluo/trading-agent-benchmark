  "factor_id": "miner_3_20330203_breadth_vix_conditioned_downside_reversal_60d",
  "factor_name": "Breadth/VIX-conditioned downside-volatility reversal, 60-day horizon",
  "version": "1.3",
  "calculation": {
    "expression": "rank_pct((-sum(log_return,120) / std(clip(log_return, upper=0),90)) * (1 + 0.60*stress_breadth + 0.50*vix_stress))",
