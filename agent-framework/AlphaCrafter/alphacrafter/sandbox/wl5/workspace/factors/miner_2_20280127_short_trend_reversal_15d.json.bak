{
  "factor_id": "miner_2_short_trend_reversal_15d",
  "factor_name": "Volatility-normalized 15-session trend reversal",
  "version": "2028-01-27",
  "calculation": {
    "expression": "rank_cs((-(close/close.shift(15)-1)) / (std(returns,30)*sqrt(30)))",
    "description": "Ranks instruments cross-sectionally by the inverse of their 15-session return scaled by 30-session realized volatility. Higher values indicate stronger short-term reversal preference. The underlying raw trend score is negated before ranking."
  },
  "dependencies": [
    "close",
    "pct_change"
  ],
  "parameters": {
    "return_window": 15,
    "volatility_window": 30,
    "volatility_min_periods": 20,
    "forward_horizon": 10,
    "cross_sectional_rank": true
  },
