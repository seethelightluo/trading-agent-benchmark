{
  "factor_id": "miner_2_20291129_trend_conditioned_downside_momentum",
  "factor_name": "Trend-Conditioned Downside-Risk Momentum",
  "version": "1.0",
  "calculation": {
    "expression": "I(return_60d > 0) * return_20d/(downside_std(return,40)*sqrt(20)) - I(return_60d <= 0) * return_20d/(downside_std(return,40)*sqrt(20))",
    "description": "Uses trailing 20-day momentum normalized by 40-day downside volatility. The orientation is momentum-following when the trailing 60-day trend is positive and reversed when the 60-day trend is non-positive. All inputs are lagged/trailing at the signal date."
  },
  "dependencies": ["close", "return"],
  "parameters": {
    "momentum_window_days": 20,
    "regime_window_days": 60,
    "downside_volatility_window_days": 40,
    "forward_horizon_days": 10,
    "minimum_cross_section": 8,
    "rank_method": "raw_cross_sectional_correlation"
  },
  "validation": {
