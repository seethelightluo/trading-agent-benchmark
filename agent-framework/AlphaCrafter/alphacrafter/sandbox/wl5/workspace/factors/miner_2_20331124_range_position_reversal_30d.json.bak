{
  "factor_id": "miner_2_20331124_range_position_reversal_30d",
  "factor_name": "30-Day Range Position Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "1 - (close - rolling_min(close,30)) / (rolling_max(close,30) - rolling_min(close,30))",
    "description": "Contrarian cross-asset signal that assigns higher values to assets nearer the bottom of their trailing 30-session price range, anticipating mean reversion over the next 10 trading sessions. Computed using only completed historical closes."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "lookback_days": 30,
    "forward_horizon_days": 10,
    "minimum_window_observations": 25,
    "minimum_cross_section": 8
  },
