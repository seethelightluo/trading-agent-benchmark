{
  "factor_id": "miner_3_20350927_market_residual_breadth_reversal_15d",
  "factor_name": "Market-Residual Breadth-Gated Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-((close/close.shift(15)-1) - cross_sectional_mean(close/close.shift(15)-1)) / (rolling_std(pct_change(close),20)*sqrt(20)) * clip(1 + 0.5*(rolling_mean(1-cross_sectional_positive_return_breadth,10)-0.5),0.7,1.3)",
    "description": "Reverse each instrument's 15-session return after removing the equal-weight cross-sectional market component, volatility-normalize with causal 20-session realized volatility, and apply a modest causal gate based on recent breadth weakness. Higher values indicate stronger expected forward return."
  },
  "dependencies": ["close", "pct_change"],
  "parameters": {
    "residual_lookback": 15,
    "volatility_lookback": 20,
    "breadth_lookback": 10,
    "breadth_gate_center": 0.5,
    "gate_slope": 0.5,
    "gate_bounds": [0.7, 1.3],
    "minimum_cross_section": 8
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2023-08-22 to 2035-09-26",
    "metrics": {
      "horizon_days": 10,
      "ic": 0.038560,
      "icir": 0.132794,
      "ic_hit_ratio": 0.547656,
      "coverage": 0.981641,
      "mean_valid_instruments": 14.725,
      "usable_dates": 2560,
      "universe_size": 15,
      "rank_turnover": 0.093640,
      "decay_ic_5d": 0.024137,
      "decay_icir_5d": 0.084563,
      "decay_ic_20d": 0.046622,
      "decay_icir_20d": 0.165627,
      "max_abs_library_correlation": null
    },
    "regime_notes": "10-day IC was -0.078823 over 2023-11-13 to 2025-12-31, then positive in 2026-2028 (+0.064604), 2029-2031 (+0.045712), and 2032-09-25 (+0.036166). Small cross-asset universe warrants conservative interpretation.",
    "signal_artifact": "scripts/miner_3_20350927_market_residual_breadth_reversal_signal.csv"
  },
  "tags": ["cross_asset", "residual_reversal", "breadth_conditioned", "volatility_scaled"],
