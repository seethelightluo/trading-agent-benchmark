{
  "factor_id": "miner_1_20330721_trend_efficiency_reversal_20d",
  "factor_name": "20-day trend-efficiency reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(close/close.shift(20)-1) / rolling_sum(abs(pct_change(close)), 20)",
    "description": "Reverses the cross-sectional 20-day directional return after scaling by the 20-day absolute-return path length. Low-efficiency or choppy directional moves receive stronger reversal scores; all inputs are causal at signal formation."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "lookback_days": 20,
    "forward_horizon_days": 10,
    "minimum_path_observations": 15,
    "minimum_cross_section": 8,
    "rank_correlation": "spearman"
  },
