  "factor_name": "Downside-volatility-normalized 60-day reversal",
  "version": "1.0",
  "calculation": {
    "expression": "clip(-(close/lag(close,60)-1) / (sqrt(60)*rolling_std(negative_only(pct_change(close)),60), -10, 10)",
    "description": "Cross-sectional contrarian signal: reverse the 60-day return and normalize by annualized downside volatility measured from the prior 60 daily returns. Negative daily returns contribute to downside volatility; non-negative returns are set to zero. Values are clipped to control outliers."
  },
  "dependencies": ["close"],
  "parameters": {
    "lookback_return_days": 60,
    "downside_volatility_days": 60,
    "min_periods": 40,
    "clip_lower": -10,
    "clip_upper": 10,
    "forward_validation_horizon_days": 10
  },
