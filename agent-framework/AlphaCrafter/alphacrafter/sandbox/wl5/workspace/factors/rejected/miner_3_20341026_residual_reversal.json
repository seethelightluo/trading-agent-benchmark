  "parameters": {
    "relative_return_window": 5,
    "volatility_window": 20,
    "volatility_min_periods": 15,
    "annualization_multiplier": "sqrt(5)",
    "clip_lower": -6,
    "clip_upper": 6,
    "minimum_cross_section": 8,
    "forward_horizon_days": 10
