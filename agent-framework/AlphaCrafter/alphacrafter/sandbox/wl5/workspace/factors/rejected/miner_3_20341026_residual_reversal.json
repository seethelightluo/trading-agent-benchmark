  "factor_name": "Cross-Asset Residual Volatility-Normalized 5-Day Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "clip(-(r5_i - mean_cross_section(r5))/(std20_i*sqrt(5)), -6, 6)",
    "description": "Fade each instrument's five-day return relative to the equal-weight cross-asset five-day benchmark, scaled by its 20-day realized volatility. The signal is positive for relatively underperforming assets and negative for relative winners."
