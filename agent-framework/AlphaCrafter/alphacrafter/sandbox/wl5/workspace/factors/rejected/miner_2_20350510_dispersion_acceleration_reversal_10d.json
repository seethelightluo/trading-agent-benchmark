{
  "factor_id": "miner_2_20350510_dispersion_acceleration_reversal_10d",
  "factor_name": "Dispersion-acceleration conditioned residual reversal",
  "version": "1.0",
  "calculation": {
    "expression": "base = -cs_return_sum(10) / (cs_residual_volatility(40)*sqrt(10)); dz=(dispersion-zscore_baseline(60))/zscore_scale(60); accel=rolling_mean((dz-dz[-5])-(dz[-5]-dz[-10]),3); transition=accel/rolling_std(accel,120); signal=base*(1+0.35*tanh(transition)), multiplier clipped to [0.65,1.35]",
    "description": "Cross-sectional residual-return reversal normalized by 40-day residual volatility, conditioned on the causal acceleration of standardized cross-asset return dispersion. The bounded multiplier emphasizes or de-emphasizes reversal during changing dispersion regimes without changing signal sign."
  },
  "dependencies": ["close"],
  "parameters": {
    "universe_size": 15,
    "residual_window_days": 10,
    "residual_volatility_window_days": 40,
    "dispersion_baseline_window_days": 60,
    "dispersion_velocity_lag_days": 5,
    "acceleration_lag_days": 5,
    "acceleration_smoothing_days": 3,
    "transition_scale_window_days": 120,
    "multiplier_coefficient": 0.35,
    "multiplier_floor": 0.65,
    "multiplier_ceiling": 1.35,
    "minimum_cross_section": 8,
    "forward_horizon_days": 10
  },
