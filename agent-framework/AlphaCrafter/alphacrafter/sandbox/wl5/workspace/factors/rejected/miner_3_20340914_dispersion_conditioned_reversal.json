  "factor_name": "Cross-Asset Dispersion-Conditioned 10-Day Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "clip(-(close/lag(close,10)-1) * clip((mean_i(std(daily_return_i,20)) / median_120(mean_i(std(daily_return_i,20)))) , 0.5, 2.5)^0.5, -6, 6)",
    "description": "Take the negative trailing 10-day return for each asset and amplify it when aggregate cross-asset daily-return dispersion is elevated relative to its trailing 120-day median. The signal is clipped for stability."
