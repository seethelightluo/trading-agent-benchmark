  "dependencies": ["close", "daily_returns"],
  "parameters": {
    "return_window": 60,
    "volatility_window": 60,
    "volatility_min_periods": 40,
    "breadth_window": 10,
    "breadth_threshold": 0.50,
    "forward_horizon": 10,
    "minimum_cross_section": 8
  },
