{
  "factor_id": "miner_3_20271230_conditional_reversal_60d",
  "factor_name": "Conditional 60-day risk-adjusted reversal",
  "version": "1.0",
  "calculation": {
    "expression": "I[breadth_10d < 0.50] * median_center(-((close/close.shift(60)-1)/(rolling_std(pct_change(close),60)*sqrt(60))))",
    "description": "Cross-sectional reversal of the 60-session risk-adjusted return, activated only when fewer than half of the tradable instruments have positive trailing 10-session returns. Median centering is performed by date."
