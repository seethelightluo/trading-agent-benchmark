  "factor_id": "residual_momentum180_inverse",
  "factor_name": "180-Day Inverse Residual Momentum",
  "version": "1.0",
  "calculation": {
    "expression": "clip(-rolling_sum_180(residual_return, shifted_1) / (rolling_std_180(residual_return, shifted_1)*sqrt(180)+1e-8), -10, 10)",
