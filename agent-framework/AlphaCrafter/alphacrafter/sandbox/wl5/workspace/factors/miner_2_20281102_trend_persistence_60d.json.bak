{
  "factor_id": "miner_2_20281102_trend_persistence_60d",
  "factor_name": "Risk-scaled 60-day trend with directional persistence confirmation",
  "version": "1.0",
  "calculation": {
    "expression": "((close/close.shift(60)-1) * (2*clip(rolling_mean(pct_change,60),0,1)-1) / (rolling_std(pct_change,40)*sqrt(40))) cross-sectionally demeaned",
    "description": "Ranks assets by medium-term return, rewards trends whose daily return direction has persisted over the prior 60 sessions, and scales by 40-session annualized realized volatility. The factor is computed only from information available at the signal date."
  },
  "dependencies": [
    "close",
    "pct_change"
  ],
  "parameters": {
    "trend_lookback": 60,
    "persistence_lookback": 60,
    "volatility_lookback": 40,
    "min_vol_observations": 25,
    "min_persistence_observations": 40,
    "forward_horizon_sessions": 10,
    "cross_section_minimum": 8
  },
