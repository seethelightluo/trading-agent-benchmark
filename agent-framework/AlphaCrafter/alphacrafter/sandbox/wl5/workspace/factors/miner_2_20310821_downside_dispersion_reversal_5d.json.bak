{
  "factor_id": "miner_2_20310821_downside_dispersion_reversal_5d",
  "factor_name": "Downside-dispersion-gated beta-adjusted residual reversal (5d)",
  "version": "1.0",
  "calculation": {
    "expression": "-residual_return_5d/(volatility_60d*sqrt(5)) * (1 + 0.45*clip(downside_dispersion_20d/(cross_asset_market_volatility_60d*sqrt(20)),0,2))",
    "description": "For each tradable benchmark asset, regress daily log returns on the equal-weighted cross-asset market return over 60 days. Reverse the asset's 5-day cumulative market-beta-adjusted residual return, normalize by 60-day volatility, and amplify the contrarian score when the cross-sectional dispersion of negative 20-day asset returns is elevated. All inputs are lagged through the prior completed day."
  },
  "dependencies": ["close"],
  "parameters": {"beta_window": 60, "residual_window": 5, "volatility_window": 60, "downside_window": 20, "amplification": 0.45, "gate_clip": [0.0, 2.0], "forward_horizon": 5},
  "validation": {
