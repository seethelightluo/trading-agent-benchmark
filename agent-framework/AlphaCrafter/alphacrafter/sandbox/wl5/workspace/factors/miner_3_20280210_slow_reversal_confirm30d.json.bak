{
  "factor_id": "miner_3_20280210_slow_reversal_confirm30d",
  "factor_name": "60-Day Risk-Adjusted Reversal with 30-Day Trend Confirmation",
  "version": "1.0",
  "calculation": {
    "expression": "rank_pct((-(close/shift(close,60)-1)/(rolling_std(pct_change(close),60)*sqrt(60)+1e-12)) * I(close/shift(close,30)-1 > 0))",
    "description": "Cross-sectional percentile rank of negative 60-session volatility-normalized return, activated only for instruments with positive independent 30-session return confirmation. Missing values remain missing. Positive scores indicate stronger reversal candidates."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "reversal_window": 60,
    "volatility_window": 60,
    "volatility_min_periods": 40,
    "confirmation_window": 30,
    "forward_horizon": 10,
    "min_cross_section": 8
  },
