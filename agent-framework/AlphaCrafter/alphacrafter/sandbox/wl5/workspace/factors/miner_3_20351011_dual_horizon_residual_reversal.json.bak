{
  "factor_id": "miner_3_20351011_dual_horizon_residual_reversal",
  "factor_name": "Dual-Horizon Market-Residual Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-[(0.65*(log_return_60d - cross_section_mean(log_return_60d)) + 0.35*(log_return_10d - cross_section_mean(log_return_10d)))/rolling_std(log_return_1d,40d)]",
    "description": "Volatility-normalized reversal of persistent and recent market-residual returns. The equal-weight cross-sectional means and rolling volatility use only observations through the signal date; negative raw trend is assigned a positive reversal score."
  },
  "dependencies": ["close"],
  "parameters": {"long_horizon_days": 60, "short_horizon_days": 10, "long_weight": 0.65, "short_weight": 0.35, "volatility_window_days": 40, "direction": -1, "clip": 10, "minimum_cross_section": 8},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2023-01-01 to 2035-09-30",
    "validated_at": "2035-10-11T00:00:00Z",
