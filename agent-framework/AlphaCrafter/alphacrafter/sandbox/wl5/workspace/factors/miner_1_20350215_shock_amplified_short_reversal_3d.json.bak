{
  "factor_id": "miner_1_20350215_shock_amplified_short_reversal_3d",
  "factor_name": "Shock-Amplified Volatility-Normalized Short Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "(-return_3d / (std(return_1d,20)*sqrt(3))) * (1 + 0.75*I[abs(return_3d) > rolling_quantile(abs(return_3d),126,0.75)])",
    "description": "Ranks assets for short-horizon reversal using the negative three-session return normalized by 20-session realized volatility, with a 75% amplification when the three-session move is in its trailing 126-session shock quartile. All rolling inputs are causal through the decision date."
  },
  "dependencies": ["close", "daily_returns"],
  "parameters": {
    "return_window": 3,
    "volatility_window": 20,
    "shock_window": 126,
    "shock_quantile": 0.75,
    "shock_amplification": 0.75,
    "forward_horizon": 10
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2023-06-30 through 2035-02-13",
    "last_validated": "2035-02-15",
    "metrics": {
      "ic": 0.03267131538958883,
