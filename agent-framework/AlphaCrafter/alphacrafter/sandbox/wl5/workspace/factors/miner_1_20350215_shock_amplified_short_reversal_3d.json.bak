      "mean_valid_instruments": 11.389344262295081,
      "usable_dates": 2440,
      "decay_ic_5d": 0.024756403840381105,
      "decay_ic_10d": 0.032218853619909615,
      "decay_ic_20d": 0.03643179903335029,
      "max_abs_library_correlation": null
    },
    "regime_notes": "Positive across the aggregate long sample; small 15-instrument cross-section warrants conservative uncertainty interpretation. Predictive strength increases through the 20-session horizon."
  },
