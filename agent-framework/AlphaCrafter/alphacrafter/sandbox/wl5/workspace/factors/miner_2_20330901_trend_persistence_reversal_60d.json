  "factor_name": "Trend-Persistence Volatility-Scaled Reversal 60D",
  "version": "1.0",
  "calculation": {
    "expression": "-(pct_change(close,60) * (1 + 0.8 * (rolling_mean(pct_change(close,1)>0,60)-0.5))) / rolling_std(pct_change(close,1),30)",
    "description": "Contrarian cross-asset signal that fades sustained 60-day directional trends, modestly amplifies by daily-path persistence, and scales by 30-day realized volatility. All rolling inputs are causal at the signal date."
