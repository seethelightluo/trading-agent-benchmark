{
  "factor_id": "dispersion_regime_reversal_10d",
  "factor_name": "Cross-Asset Dispersion-Regime Volatility-Scaled Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "(-return(close,10) / (stdev(daily_return,30)*sqrt(10))) * regime_sign",
    "description": "Rank cross-asset 10-day reversal after scaling by 30-day realized volatility. In unusually high cross-sectional dispersion (dispersion above its 120-day mean plus 0.50 standard deviations), switch to continuation by reversing the reversal signal; otherwise retain reversal. All inputs are causal through the decision date.",
    "regime_sign": "-1 when median absolute deviation of 10-day returns exceeds rolling120 mean + 0.50 rolling120 std; +1 otherwise"
  },
  "dependencies": ["close"],
  "parameters": {"return_window": 10, "vol_window": 30, "dispersion_window": 120, "dispersion_threshold_std": 0.5, "forward_horizon": 10},
