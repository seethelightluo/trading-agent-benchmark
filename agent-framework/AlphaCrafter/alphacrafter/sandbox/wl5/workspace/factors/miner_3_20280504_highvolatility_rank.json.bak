{
  "factor_id": "miner_3_20280504_highvolatility_rank",
  "factor_name": "Cross-Asset High Volatility Rank",
  "version": "2028.05.18",
  "calculation": {
    "expression": "0.8*rank_cs(rolling_std(pct_change(close),20)) - 0.2*rank_cs(sum(pct_change(close),5))",
    "description": "Ranks assets higher when trailing 20-day realized volatility is high, with a small penalty for strong recent five-day returns."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "vol_window": 20,
    "recent_return_window": 5,
    "vol_weight": 0.8,
    "return_penalty_weight": 0.2,
    "forward_horizon_days": 10,
    "min_cross_section": 8
  },
