{
  "factor_id": "miner_2_20271021_relative_momentum_acceleration_reversal",
  "factor_name": "Relative Momentum Acceleration Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(r_5 - shift(r_5,5).rolling_mean_equivalent_20d)",
    "description": "Cross-sectional reversal of momentum acceleration: subtract the prior 20-session average daily return from the latest 5-session return, negate the result, and median-center across the 15 tradable instruments. Positive scores favor assets whose recent trend has deteriorated relative to its prior pace. Only completed daily closes are used."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "recent_window": 5,
    "prior_window": 20,
    "prior_gap": 5,
    "horizon_days": 10,
    "min_cross_section": 8
  },
