{
  "factor_id": "miner_3_20270923_short_relative_reversal_3d",
  "factor_name": "Cross-Asset Short Relative Reversal",
  "version": "2027-09-23",
  "calculation": {
    "expression": "-(ret_3d(asset) - median_cross_section(ret_3d))",
    "description": "Fade each asset's three-trading-day return relative to the same-day cross-sectional median; larger values indicate stronger expected reversal. Signal uses only completed daily closes."
  },
