{
  "factor_id": "miner_3_20330818_activity_transition_reversal_20d",
  "factor_name": "Activity-transition-confirmed 20-day momentum reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-rolling_sum(pct_change(close),20) * (1 + 0.6*tanh(activity_5d - lag(activity_5d,5))) where activity_5d=rolling_mean_5(log(volume/rolling_median(volume,60)))",
    "description": "A causal contrarian 20-day return signal whose magnitude is increased after a recent five-day rise in relative trading activity; all rolling statistics use data available at the signal date. Higher values indicate stronger expected forward returns."
  },
  "dependencies": [
    "close",
    "volume"
  ],
  "parameters": {
    "return_window_days": 20,
    "volume_median_window_days": 60,
    "activity_smoothing_days": 5,
    "activity_change_lag_days": 5,
    "forward_horizon_days": 10,
    "multiplier": 0.6,
    "minimum_cross_section": 8,
