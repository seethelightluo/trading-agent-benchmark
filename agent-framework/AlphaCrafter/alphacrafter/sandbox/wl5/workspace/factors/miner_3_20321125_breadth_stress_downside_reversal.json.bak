{
  "factor_id": "miner_3_20321125_breadth_stress_downside_reversal",
  "factor_name": "Breadth-stress weighted downside-volatility reversal 60d",
  "version": "1.5",
  "calculation": {
    "expression": "rank_pct((-sum(log_return,60d) / downside_std(log_return,90d)) * (1 + 0.60 * clip(max(0,(0.5-breadth20)*2),0,1) * clip(cross_asset_mean_return_vol20 / cross_asset_mean_return_vol120,0.5,2.0)))",
    "description": "Medium-term reversal normalized by downside volatility, amplified during weak breadth and elevated aggregate volatility. Inputs are causal through the signal date."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "return_window_days": 60,
    "downside_vol_window_days": 90,
    "breadth_window_days": 20,
    "aggregate_vol_short_days": 20,
    "aggregate_vol_long_days": 120,
    "stress_weight": 0.6,
    "minimum_cross_section": 8,
    "forward_horizon_days": 10
  },
  "validation": {
