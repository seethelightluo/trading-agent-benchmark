{
  "factor_id": "residual_momentum60_inverse",
  "factor_name": "60-Day Inverse Residual Momentum",
  "version": "1.0",
  "calculation": {
    "expression": "-rolling_sum_60(residual_return_i) / (rolling_std_60(residual_return_i) * sqrt(60))",
    "description": "For each tradable asset, estimate lagged rolling beta to the equal-weight cross-asset return proxy, compute market residual returns, and invert residual cumulative momentum with residual-volatility scaling. Higher values favor negative residual momentum and expected mean reversion. All rolling statistics are shifted one completed observation and clipped to [-10,10]."
  },
  "dependencies": ["close"],
  "parameters": {
    "residual_window_days": 60,
    "beta_min_periods": 35,
    "signal_min_periods": 45,
    "forward_horizon_days": 10,
    "winsorization": [-10, 10],
    "market_proxy": "equal_weight_mean_of_available_asset_returns"
  },
