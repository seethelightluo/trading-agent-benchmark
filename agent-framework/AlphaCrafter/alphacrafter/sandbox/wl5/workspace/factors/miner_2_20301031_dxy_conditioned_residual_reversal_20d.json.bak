{
  "factor_id": "dxy_conditioned_residual_reversal_20d",
  "factor_name": "DXY-Conditioned Cross-Asset Residual Reversal 20-Day",
  "version": "1.0",
  "calculation": {
    "expression": "(20d asset return - causal 60d beta * 20d equal-weight market return) / causal 60d residual volatility * (0.5 + causal 252d DXY percentile rank)",
    "description": "Contrarian residual return relative to the equal-weight tradable universe, scaled by residual volatility and DXY stress percentile; direction inverted after validation."
  },
  "dependencies": [
    "close",
    "DXY"
  ],
  "parameters": {
    "residual_window": 20,
    "beta_window": 60,
    "vol_window": 60,
    "dxy_rank_window": 252,
    "forward_horizon": 10
  },
