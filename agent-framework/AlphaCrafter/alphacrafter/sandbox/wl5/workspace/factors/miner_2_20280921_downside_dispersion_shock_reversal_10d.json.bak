{
  "factor_id": "miner_2_20280921_downside_dispersion_shock_reversal_10d",
  "factor_name": "Downside Cross-Asset Dispersion-Shock 5d Reversal",
  "version": "20280921.v1",
  "calculation": {
    "expression": "-sum_{1..5}(return_i) when cross-sectional standard deviation of 5d mean downside returns exceeds its trailing 60d 70th percentile; otherwise 0",
    "description": "Ranks tradable cross-asset instruments by five-day reversal only during regimes of unusually dispersed downside returns. Downside dispersion isolates broad stress asymmetry while retaining an interpretable shock reversal signal."
  },
  "dependencies": [
    "close",
    "daily returns"
  ],
  "parameters": {
    "lookback_return_days": 5,
    "downside_window": 5,
    "dispersion_statistic": "cross_sectional_std",
    "threshold_window": 60,
    "threshold_quantile": 0.7,
    "forward_horizon_days": 10,
    "minimum_cross_section": 8
  },
