{
  "factor_id": "miner_2_20311211_vix_stress_reversal_5d",
  "factor_name": "VIX-stress gated five-day reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(log_return_5d / (rolling_std_log_return_20d * sqrt(20))) * clip(VIX / rolling_median(VIX,60) - 0.5, 0, 2.0)",
    "description": "Fades the trailing five-day asset return after volatility normalization, increasing signal magnitude when observation-only VIX is elevated relative to its trailing 60-day median. Signal uses only data through the signal date."
  },
  "dependencies": ["close", "VIX close"],
  "parameters": {"return_window": 5, "volatility_window": 20, "vix_median_window": 60, "stress_clip": [0.0, 2.0], "winsorization": "none"},
  "validation": {
    "status": "EFFECTIVE",
    "period": {"start": "2020-01-01", "end": "2031-12-10", "validation_date": "2031-12-11"},
    "metrics": {
      "horizon_days": 5,
      "ic": 0.029243,
      "icir": 0.092715,
      "ic_hit_ratio": 0.53125,
      "dates": 2336,
      "mean_valid_instruments": 14.67,
      "coverage": 0.97808,
      "rank_turnover": 0.149785,
      "decay_10d_ic": 0.024888,
      "decay_10d_icir": 0.080443,
      "max_abs_library_correlation": null
    },
    "thresholds": {"absolute_daily_paper_ic_min": 0.007, "absolute_daily_paper_icir_min": 0.084},
    "regime_notes": {"2020_2024_ic": 0.032031, "2025_2027_ic": 0.04167, "2028_2029_ic": 0.022611, "2030_2031_12_10_ic": 0.01675},
    "signal_artifact": "scripts/miner_2_20311211_vix_stress_reversal_signal.csv"
  },
