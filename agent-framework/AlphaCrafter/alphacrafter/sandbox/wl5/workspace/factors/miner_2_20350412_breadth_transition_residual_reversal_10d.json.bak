{
  "factor_id": "miner_2_20350412_breadth_transition_residual_reversal_10d",
  "factor_name": "Breadth-transition conditioned residual reversal",
  "version": "1.0",
  "calculation": {
    "expression": "clip(-cs_return_sum(10)/(cs_return_std(40)*sqrt(10)+epsilon),-8,8) * clip(1+0.40*tanh(mean_3(zscore_60(breadth_negative)-zscore_60(breadth_negative).shift(5))),0.60,1.40)",
    "description": "Cross-sectional 10-day residual-return reversal normalized by 40-day cross-sectional residual volatility, amplified when the standardized negative-return breadth is transitioning upward and damped when it transitions downward. All inputs are lagged through the decision date.",
    "cross_section": "15 tradable benchmark instruments; minimum 8 valid names per IC date"
  },
  "dependencies": ["close", "daily_returns", "watch_list"],
  "parameters": {"residual_window_days": 10, "volatility_window_days": 40, "breadth_zscore_window_days": 60, "breadth_transition_lag_days": 5, "transition_smoothing_days": 3, "amplification": 0.40, "multiplier_floor": 0.60, "multiplier_cap": 1.40, "forward_horizon_days": 10},
  "validation": {
