{
  "factor_id": "miner_2_20300530_vix_percentile_switch_10d",
  "factor_name": "VIX Percentile-Switch Trend/Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "demean_cs((1-pct_rank_252(VIX))*ret_20/ann_vol_30 + pct_rank_252(VIX)*(-ret_5)/ann_vol_30)",
    "description": "Blend volatility-adjusted 20-day momentum with volatility-adjusted 5-day reversal. The weight on reversal is the trailing 252-observation percentile rank of observation-only VIX, aligned to the last completed date; the result is cross-sectionally demeaned."
  },
  "dependencies": ["close", "VIX", "date"],
  "parameters": {"trend_window": 20, "reversal_window": 5, "volatility_window": 30, "vix_percentile_window": 252, "forward_horizon": 10, "minimum_cross_section": 8},
