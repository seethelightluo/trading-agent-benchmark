{
  "factor_id": "miner_1_20271118_macro_relative_strength_reversal",
  "factor_name": "Risk-adjusted cross-asset relative-strength reversal",
  "version": "2027-11-18",
  "calculation": {
    "expression": "-rolling_sum(asset_return - equal_weight_universe_return,20) / rolling_std(asset_return,20,min_periods=15)",
    "description": "Ranks assets by the negative of their trailing 20-session excess return versus the equal-weight tradable universe, scaled by own realized volatility. Higher values select recent relative winners as reversal shorts in signal space (implemented as lower long weight), while lower values select relative losers; the factor is strictly lagged at decision time and is intended as a contrarian cross-asset allocation signal."
  },
  "dependencies": [
    "close",
    "watch_list"
  ],
  "parameters": {
    "relative_return_window": 20,
    "volatility_window": 20,
    "volatility_min_periods": 15,
    "benchmark": "equal_weight_mean_return_across_15_tradable_assets",
    "holding_horizon_days": 10,
    "direction": -1
  },
