{
  "factor_id": "miner_2_20310612_dispersion_gated_residual_reversal_5d",
  "factor_name": "Dispersion-Gated Residual Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-5d_beta_adjusted_residual_return/(60d_asset_volatility*sqrt(5)) * (1 + 0.60*clip(mean_5d_cross_asset_dispersion/mean_60d_cross_asset_dispersion - 0.85, 0, 1.5))",
    "description": "Ranks assets for reversal of their last five-day market-beta-adjusted return, increasing the reversal exposure when recent cross-asset dispersion is unusually high. All inputs are lagged/causal at the signal date."
  },
  "dependencies": ["close"],
  "parameters": {"residual_window_days": 5, "beta_window_days": 60, "volatility_window_days": 60, "dispersion_window_days": 5, "dispersion_baseline_days": 60, "dispersion_floor": 0.85, "dispersion_amplifier": 0.60, "dispersion_cap": 1.5, "forward_horizon_days": 5},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2031-06-11",
    "validated_at": "2031-06-12",
    "metrics": {"ic": 0.031090, "icir": 0.099213, "dates": 2212, "mean_instruments": 14.66, "coverage": 0.97715, "turnover": 0.150770, "hit_ratio": 0.53074, "max_abs_library_correlation": null},
    "decay": {"5d_ic": 0.031090, "5d_icir": 0.099213, "10d_ic": 0.019932, "10d_icir": 0.065166},
    "regime_notes": "Positive across all tested regimes; recent 2030-06-11 IC +0.008951, materially weaker than earlier periods. Small 15-instrument cross-section implies conservative uncertainty interpretation.",
    "signal_artifact": "scripts/miner_2_20310612_dispersion_gated_residual_reversal_5d_signal.csv"
  },
  "tags": ["reversal", "residual", "dispersion", "cross_asset"],
  "last_validated": "2031-06-12"
}
