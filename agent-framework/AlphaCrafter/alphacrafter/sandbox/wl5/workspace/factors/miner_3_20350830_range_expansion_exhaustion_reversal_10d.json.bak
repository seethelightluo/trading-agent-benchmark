{
  "factor_id": "miner_3_20350830_range_expansion_exhaustion_reversal_10d",
  "factor_name": "Range-Expansion Exhaustion Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(close/close.shift(10)-1)/(rolling_std(pct_change(close),20)*sqrt(20)) * (1 + 0.8*clip((mean((high-low)/close,5)/mean((high-low)/close,40))-1,-0.6,1.5))",
    "description": "Causal 10-session volatility-normalized reversal, amplified when the recent five-session true-range proxy expands relative to its trailing forty-session baseline. The signal is computed only from data available at the decision date."
  },
  "dependencies": ["close", "high", "low"],
  "parameters": {
    "reversal_lookback_sessions": 10,
    "volatility_window_sessions": 20,
    "range_fast_window_sessions": 5,
    "range_slow_window_sessions": 40,
    "range_amplification": 0.8,
    "shock_clip": [-0.6, 1.5],
    "minimum_cross_section": 8
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2023-07-25 through 2035-08-29",
