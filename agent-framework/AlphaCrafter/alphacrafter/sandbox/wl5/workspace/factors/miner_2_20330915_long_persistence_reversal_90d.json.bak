{
  "factor_id": "miner_2_20330915_long_persistence_reversal_90d",
  "factor_name": "Trend-Persistence Volatility-Scaled Reversal 90D",
  "version": "1.0",
  "calculation": {
    "expression": "-(pct_change(close,90) * (1 + 0.8 * (mean(I[pct_change(close,1)>0],90)-0.5))) / std(pct_change(close,1),45)",
    "description": "Fades the causal 90-trading-day return, scales by 45-day realized volatility, and adjusts magnitude using 90-day positive-return persistence. Higher values indicate stronger reversal preference."
  },
  "dependencies": [
    "close",
    "daily_returns"
  ],
  "parameters": {
    "trend_window": 90,
    "persistence_window": 90,
    "persistence_min_periods": 65,
    "volatility_window": 45,
    "volatility_min_periods": 30,
    "persistence_multiplier": 0.8,
    "forward_horizon": 10
  },
