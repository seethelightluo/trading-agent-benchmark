{
  "factor_id": "miner_2_20350607_range_location_reversal_10d",
  "factor_name": "Range-location conditioned residual reversal",
  "version": "1.0",
  "calculation": {
    "expression": "clip((-cross_sectional_residual_return.rolling(20).sum() / (cross_sectional_residual_return.rolling(60).std()*sqrt(20))) * (1 - 0.8*rolling10(((close-low)/(high-low)-0.5)), -8, 8)",
    "description": "Volatility-normalized 20-day residual reversal, modulated by the causal 10-day average close location within each asset's daily high-low range. The signal fades residual moves when recent closes persist near a range edge. Cross-sectional residual returns subtract the same-day universe mean. All inputs are lag-safe through the observation date."
  },
  "dependencies": ["close", "high", "low"],
  "parameters": {"residual_window": 20, "volatility_window": 60, "location_window": 10, "location_multiplier": 0.8, "clip_lower": -8, "clip_upper": 8, "minimum_valid_instruments": 8},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2023-09-19/2035-06-06",
    "metrics": {
      "horizon_days": 10,
      "ic": 0.051555,
      "icir": 0.163231,
      "hit_ratio": 0.559708,
      "dates": 2462,
      "mean_instruments": 11.927,
      "coverage": 0.795153,
      "turnover": 0.087008,
      "decay_ic_5d": 0.04691,
      "decay_ic_20d": 0.055622,
      "max_abs_library_correlation": null
    },
    "regime_notes": "10-day IC was -0.052610 in 2024-2025 (163 dates), +0.051496 in 2026-2029 (889), +0.084304 in 2030-2032 (784), and +0.038623 in 2033-2035 (623). Interpret conservatively due to the 15-asset cross-section and lower average valid coverage caused by OHLC availability.",
    "thresholds": {"minimum_absolute_ic": 0.007, "minimum_absolute_icir": 0.084}
  },
  "signal_artifact": "scripts/miner_2_20350607_range_location_reversal_signal.csv",
  "validation_script": "scripts/miner_2_20350607_range_location_reversal.py",
  "tags": ["reversal", "residual", "range-location", "cross-asset", "volatility-normalized"],
