{
  "factor_id": "miner_1_20330623_idio_volshock_reversal_10d",
  "factor_name": "Idiosyncratic volatility-shock reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-rolling_sum(ret_i-beta_i*mean_cross_asset_ret,10)*(1+0.5*I[idio_vol20 > rolling_quantile(idio_vol20,126,0.75)])",
    "description": "Estimate each tradable asset's 40-day beta to the equal-weighted tradable-universe return, form causal idiosyncratic returns, reverse the recent 10-day residual shock, and amplify the reversal by 50% when 20-day idiosyncratic volatility is above its trailing 126-day 75th percentile."
  },
  "dependencies": [
    "close",
    "returns",
    "15 tradable benchmark instruments"
  ],
  "parameters": {
    "beta_window": 40,
    "beta_min_periods": 30,
    "shock_window": 10,
    "shock_min_periods": 8,
    "idiosyncratic_vol_window": 20,
    "vol_min_periods": 15,
    "vol_quantile_window": 126,
    "vol_quantile": 0.75,
    "shock_amplification": 0.5,
    "forward_validation_horizon_days": 10
  },
