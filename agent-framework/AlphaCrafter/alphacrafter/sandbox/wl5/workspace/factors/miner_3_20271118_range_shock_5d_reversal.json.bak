{
  "factor_id": "miner_3_20271118_range_shock_5d_reversal",
  "factor_name": "Five-day range-shock cross-asset reversal",
  "version": "20271118",
  "calculation": {
    "expression": "-(five_day_return / (rolling_mean((high-low)/close,20) * sqrt(5)) - cross_sectional_median(same))",
    "description": "Fade unusually large five-session price displacements after scaling by each asset's trailing 20-session mean normalized daily range and center cross-sectionally. Uses only completed sessions."
  },
  "dependencies": [
    "close",
    "high",
    "low"
  ],
  "parameters": {
    "shock_window": 5,
    "range_window": 20,
    "range_min_periods": 15,
    "horizon_admission_days": 10,
    "min_cross_section": 8
  },
