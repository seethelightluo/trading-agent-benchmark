{
  "factor_id": "miner_2_20351220_breadth_gated_residual_reversal_10d",
  "factor_name": "Breadth-gated volatility-scaled residual reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(r15_i - mean_cross_section(r15)) / (sqrt(20)*std30_daily_return_i) * clip(1.25 - 0.50*breadth5, 0.75, 1.25)",
    "description": "Reverses each asset's 15-day return residual to the cross-sectional mean, scales by 30-day realized volatility, and applies a causal market-breadth gate. Breadth is the fraction of tradable assets with positive trailing 5-day return; bearish breadth modestly amplifies reversal and bullish breadth dampens it."
  },
  "dependencies": ["close"],
  "parameters": {"residual_lookback_days": 15, "volatility_lookback_days": 30, "volatility_annualization_proxy": "sqrt(20)", "breadth_lookback_days": 5, "gate_intercept": 1.25, "gate_breadth_coefficient": 0.50, "gate_min": 0.75, "gate_max": 1.25, "forward_horizon_days": 10},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2023-11-22 through 2035-12-19",
    "validated_on": "2035-12-20",
