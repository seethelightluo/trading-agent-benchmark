{
  "factor_id": "miner_3_20341221_residual_reversal_10d",
  "factor_name": "Cross-Asset Residual Reversal, Volatility Normalized",
  "version": "1.0",
  "calculation": {
    "expression": "clip(-rolling_sum_10(asset_return - cross_sectional_mean_return_1d) / (rolling_std_40(asset_return - cross_sectional_mean_return_1d) * sqrt(10)), -8, 8)",
    "description": "For each tradable benchmark instrument, subtract the contemporaneous equal-weight cross-asset daily return from its daily return, accumulate the residual over 10 completed sessions, and reverse-sign it after scaling by 40-session residual volatility. Values are clipped to limit outliers. Higher values indicate stronger expected 10-day forward return."
  },
  "dependencies": ["close"],
  "parameters": {
    "residual_window_days": 10,
    "volatility_window_days": 40,
    "minimum_residual_observations": 8,
    "minimum_volatility_observations": 25,
    "normalization_horizon": 10,
    "clip_lower": -8,
    "clip_upper": 8,
    "cross_section": "equal_weight_mean_across_available_15_tradable_assets"
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2023-06-14 to 2034-12-06",
    "last_validated": "2034-12-21",
    "metrics": {
      "same_horizon_days": 10,
