  "factor_name": "90-day peak drawdown reversal",
  "version": "1.0",
  "calculation": {
    "expression": "1 - close / rolling_max(close, 90)",
    "description": "For each tradable benchmark asset, measure its causal closing-price drawdown from the trailing 90-session high; larger drawdowns receive higher expected 10-session reversal scores. The rolling window includes only data available at the signal date."
