{
  "factor_id": "miner_3_20320722_asset_vol_conditioned_residual_reversal_20d",
  "factor_name": "Asset-volatility-conditioned beta-neutral residual reversal 20d",
  "version": "1.0",
  "calculation": {
    "expression": "rank_pct((-sum_20(residual_log_return)/std_20(residual_log_return))/(clip(std_20(residual_log_return)/std_120(residual_log_return),0.25,4.0)^0.5))",
    "description": "For each asset, estimate an 80-day beta to the equal-weight cross-asset log-return series, form beta-neutral residual returns, and rank the negative 20-day residual return normalized by 20-day residual volatility and further conditioned by asset-specific volatility expansion relative to its 120-day residual volatility. All inputs are lagged through the decision date. Higher values indicate stronger rebound potential, with a penalty for recent volatility expansion."
  },
  "dependencies": ["close"],
  "parameters": {"beta_window_days": 80, "signal_window_days": 20, "volatility_baseline_days": 120, "forward_horizon_days": 10, "volatility_ratio_clip": [0.25, 4.0], "universe_size": 15},
  "validation": {
