{
  "factor_id": "miner_3_20340706_inverse_residual_momentum_40d",
  "factor_name": "40-day market-residual risk-scaled momentum reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-rolling_sum_40(residual_return, lag=1) / (sqrt(40) * rolling_std_40(residual_return, lag=1))",
    "description": "For each tradable asset, estimate lagged 40-day beta to the equal-weight mean return of the 15-asset tradable universe, form residual returns, sum the prior 40 residual returns, and invert the volatility-scaled result. The signal is lagged one completed day and is intended as a medium-term residual reversal signal."
  },
  "dependencies": ["close", "daily_returns", "15-asset equal-weight benchmark"],
  "parameters": {"window_days": 40, "beta_min_periods": 25, "signal_min_periods": 30, "forward_horizon_days": 10, "min_cross_section": 8, "clip": [-10, 10]},
