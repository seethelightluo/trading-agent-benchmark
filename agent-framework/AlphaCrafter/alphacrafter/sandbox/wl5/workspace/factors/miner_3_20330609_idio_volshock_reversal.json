  "factor_name": "Idiosyncratic Volatility-Shock Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(rolling_sum_10(asset_return - beta_40_to_equal_weight_market*market_return, 10)) * (1 + 0.5*I(idio_vol_20 > causal_126d_75th_percentile))",
    "description": "Compute a causal 40-day rolling beta to the equal-weighted tradable-universe market return, form daily idiosyncratic residual returns, and reverse the trailing 10-day residual shock. Strengthen the reversal by 50 percent when causal 20-day residual volatility is above its trailing 126-day 75th percentile. The market return and all thresholds use only information available on the signal date."
  },
