{
  "factor_id": "miner_3_20271104_volnorm_momentum_reversal",
  "factor_name": "Volatility-normalized momentum reversal",
  "version": "2027-11-04",
  "calculation": {
    "expression": "-pct_change(close,20) / (rolling_std(pct_change(close,1),20,min_periods=15)*sqrt(20))",
    "description": "Ranks assets by the negative of their trailing 20-session return divided by 20-session annualized realized volatility; higher values select recent losers after risk normalization, targeting the observed short-horizon cross-asset reversal. The signal is calculated independently per asset using only information available at the decision date."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "momentum_window": 20,
    "volatility_window": 20,
    "volatility_min_periods": 15,
    "holding_horizon_days": 10,
    "direction": -1
  },
