{
  "factor_id": "miner_3_20271104_range_shock_reversal",
  "factor_name": "Three-day range-shock cross-asset reversal",
  "version": "20271104",
  "calculation": {
    "expression": "-(three_day_return / (rolling_mean((high-low)/close,20) * sqrt(3)) - cross_sectional_median(same))",
    "description": "Fade unusually large three-day price shocks after scaling by each asset's trailing 20-session mean normalized daily range; center the shock cross-sectionally each date. Inputs are restricted to completed historical sessions."
  },
  "dependencies": [
    "close",
    "high",
    "low"
  ],
  "parameters": {
    "shock_window": 3,
    "range_window": 20,
    "range_min_periods": 15,
    "horizon_admission_days": 10,
    "min_cross_section": 8
  },
