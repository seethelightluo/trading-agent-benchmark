{
  "factor_id": "miner_2_20320610_vol_adjusted_reversal_20d",
  "factor_name": "20-day volatility-adjusted reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(close / lag(close,20) - 1) / (rolling_std(daily_return,40) * sqrt(252) + 1e-8), cross-sectionally clipped to 5th/95th percentiles",
    "description": "Fades the trailing 20-session return, giving lower scores to recent winners and higher scores to recent losers, while scaling by trailing 40-session total volatility. Winsorization limits outlier influence. All inputs are available through the signal date."
  },
  "dependencies": ["close"],
  "parameters": {"return_lookback": 20, "volatility_lookback": 40, "volatility_min_periods": 25, "annualization": 252, "winsor_lower": 0.05, "winsor_upper": 0.95, "forward_horizon": 10, "minimum_cross_section": 8},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2032-06-09 causal signals with 10-session forward returns",
    "timestamp": "2032-06-10",
    "metrics": {
