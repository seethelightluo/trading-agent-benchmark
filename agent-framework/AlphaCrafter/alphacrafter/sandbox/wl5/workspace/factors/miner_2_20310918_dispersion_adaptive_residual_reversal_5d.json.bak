{
  "factor_id": "miner_2_20310918_dispersion_adaptive_residual_reversal_5d",
  "factor_name": "Dispersion-Adaptive Beta-Residual Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-sum_5d(asset_log_return - beta_60d*market_log_return) / (volatility_60d*sqrt(5)) * clip(mean_20d_cross_asset_dispersion / baseline_60d_dispersion, 0.75, 1.45)",
    "description": "Five-day market-beta-adjusted residual reversal, volatility normalized and adaptively scaled by recent 20-day cross-asset return dispersion relative to a 60-day rolling baseline. The bounded gate increases signal magnitude in elevated dispersion and limits it in unusually compressed conditions.",
    "signal_artifact": "scripts/miner_2_20310918_dispersion_adaptive_residual_reversal_5d_signal.csv"
  },
  "dependencies": ["close"],
  "parameters": {
    "residual_window_days": 5,
    "beta_volatility_window_days": 60,
    "dispersion_window_days": 20,
    "dispersion_baseline_window_days": 20,
    "gate_lower": 0.75,
    "gate_upper": 1.45,
    "market_proxy": "cross-sectional mean log return",
    "forward_admission_horizon_days": 5
  },
