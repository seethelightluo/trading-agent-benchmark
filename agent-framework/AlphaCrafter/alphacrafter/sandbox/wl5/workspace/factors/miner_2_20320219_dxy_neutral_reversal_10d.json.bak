  "version": "2032-02-19",
  "calculation": {
    "expression": "-sum_5(asset_log_return - beta_60_DXY * DXY_log_return) / (sqrt(5) * sd_60(asset_log_return)) * clip(1 + sd_60(cross_asset_mean_return) / mean_60(abs(cross_asset_mean_return)), 1, 2)",
    "description": "Same causal five-day DXY-neutral reversal signal evaluated against ten-day forward returns."
  },
  "dependencies": ["close", "DXY close"],
  "parameters": {"residual_window": 5, "beta_window": 60, "volatility_window": 60, "forward_horizon": 10, "dispersion_clip": [1, 2]},
