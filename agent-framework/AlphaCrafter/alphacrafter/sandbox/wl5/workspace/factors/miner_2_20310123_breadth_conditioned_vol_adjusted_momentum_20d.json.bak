{
  "factor_id": "miner_2_20310123_breadth_conditioned_vol_adjusted_momentum_20d",
  "factor_name": "Breadth-Conditioned Volatility-Adjusted Momentum 20-Day",
  "version": "1.0",
  "calculation": {
    "expression": "shift_1((close/close.shift(20)-1) / rolling_std(pct_change(close),40) * 2*(rolling_mean(cross_sectional_positive_return_indicator,20)-0.5))",
    "description": "Ranks 20-day momentum after volatility adjustment, with the sign and magnitude conditioned on lagged 20-day cross-asset breadth. Broad participation reinforces momentum; weak participation reverses it. All inputs are shifted one completed day before use."
  },
  "dependencies": ["close", "daily_returns", "cross_asset_breadth"],
  "parameters": {"momentum_window": 20, "volatility_window": 40, "breadth_window": 20, "min_vol_observations": 25, "forward_horizon_days": 10, "universe_size": 15},
