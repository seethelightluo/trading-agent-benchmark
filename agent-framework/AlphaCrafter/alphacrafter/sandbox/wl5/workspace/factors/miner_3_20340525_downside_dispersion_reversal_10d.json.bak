{
  "factor_id": "miner_3_20340525_downside_dispersion_reversal_10d",
  "factor_name": "Downside-risk normalized reversal with causal cross-asset dispersion stress",
  "version": "1.0",
  "calculation": {
    "expression": "clip(-(close/close.shift(10)-1)/(downside_std(returns,30)*sqrt(10)+1e-8) * (1+0.30*clip(zscore(lag1(mean_cross_asset(rolling_std(returns,5))),252),0,3)), -10, 10)",
    "description": "Ranks ten-day reversal after normalizing by each asset's 30-day downside return volatility. The reversal is amplified when lagged cross-asset five-day realized-volatility dispersion is unusually elevated, using only information available before the signal date."
  },
  "dependencies": ["close", "daily_returns"],
  "parameters": {"reversal_lookback": 10, "downside_vol_window": 30, "dispersion_window": 5, "stress_window": 252, "stress_min_periods": 60, "amplification": 0.30, "winsor_limit": 10, "forward_horizon": 10},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-03-06/2034-05-10",
    "metrics": {
      "dates": 2665,
      "mean_instruments": 14.636,
      "coverage": 0.975735,
      "daily_paper_ic": 0.034687,
      "daily_paper_icir": 0.110491,
      "annualized_icir": 1.753984,
      "ic_hit_ratio": 0.547467,
      "turnover": 0.127279,
      "max_abs_library_correlation": null
    },
    "regime_notes": "Positive IC in all tested regimes; weaker in 2028-2029 and recent 2033-2034 period. Small 15-asset cross-section requires conservative interpretation.",
    "signal_artifact": "scripts/miner_3_20340525_downside_dispersion_reversal_signal.csv"
  },
  "tags": ["reversal", "downside-risk", "cross-asset-dispersion", "stress-conditioned"],
