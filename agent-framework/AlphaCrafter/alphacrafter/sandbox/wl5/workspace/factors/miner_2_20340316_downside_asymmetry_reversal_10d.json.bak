{
  "factor_id": "miner_2_20340316_downside_asymmetry_reversal_10d",
  "factor_name": "Downside-asymmetry volatility-normalized 10-day reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-((close/close.shift(10)-1)/(std(pct_change,40)*sqrt(40))) * clip(std(pct_change.where(pct_change<0),40)/std(pct_change,40),0.5,2.0)",
    "description": "Ranks recent 10-day cross-sectional losers positively, scaling the reversal by total volatility and by the asset's downside-to-total volatility asymmetry. All rolling inputs are lag-safe and use only completed observations."
  },
  "dependencies": ["close", "pct_change"],
  "parameters": {"lookback_return_days": 10, "volatility_window": 40, "min_periods": 15, "downside_ratio_floor": 0.5, "downside_ratio_cap": 2.0, "forward_horizon_days": 10, "minimum_cross_section": 8, "winsorization": [-5.0, 5.0]},
