{
  "factor_id": "miner_1_20310320_vix_gated_residual_reversal_5d",
  "factor_name": "VIX-percentile-gated residual reversal 5d",
  "version": "1.0",
  "calculation": {
    "expression": "-(r_5 - cross_sectional_median(r_5)) / rolling_std(r_1,60) * (1 + 0.75*max(0,(percentile(VIX,60)-0.60)/0.40))",
    "description": "Cross-sectional five-day residual reversal, risk-scaled by each asset's 60-day daily-return volatility and amplified only when the observation-only VIX 60-day percentile is above 60%. VIX is lagged/available only through the decision date; no tradable macro order is implied."
  },
  "dependencies": ["close", "VIX observation-only close"],
  "parameters": {"reversal_window_days": 5, "volatility_window_days": 60, "vix_percentile_window_days": 60, "vix_activation_percentile": 0.60, "high_vix_amplification": 0.75, "forward_horizon_days": 5, "minimum_cross_section": 8},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2031-03-19",
    "last_validated": "2031-03-20",
    "metrics": {"ic": 0.038328, "icir": 0.121428, "ic_hit_ratio": 0.54336, "dates": 2168, "mean_instruments": 14.65, "coverage": 0.97669, "rank_turnover": 0.156686, "max_abs_library_correlation": null},
    "regime_notes": {"2020-2024": 0.050104, "2025-2027": 0.039013, "2028-2029": 0.035062, "2030-2031-03-19": 0.015361},
    "gates": {"absolute_daily_paper_ic_min": 0.007, "absolute_daily_paper_icir_min": 0.084, "ic_pass": true, "icir_pass": true},
    "signal_artifact": "scripts/miner_1_20310320_vix_gated_residual_reversal_5d_signal.csv",
    "provenance": "Computed by scripts/miner_1_20310320_vix_gated_residual_reversal.py using all 15 tradable instruments and causal historical closes; VIX sourced from ../persistent/index_data/VIX.csv."
  },
  "tags": ["reversal", "residual", "volatility", "macro-conditioned", "vix"],
