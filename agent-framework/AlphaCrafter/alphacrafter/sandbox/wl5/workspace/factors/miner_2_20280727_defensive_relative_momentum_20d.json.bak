  "dependencies": ["close", "XAU", "US10Y", "CN10Y"],
  "parameters": {"lookback_days": 20, "anchor_weights": {"XAU": 0.333333, "US10Y": 0.333333, "CN10Y": 0.333333}, "forward_horizon_days": 10},
