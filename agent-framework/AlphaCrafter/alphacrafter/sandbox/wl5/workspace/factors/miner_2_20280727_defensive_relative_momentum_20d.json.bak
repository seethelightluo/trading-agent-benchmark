  "factor_name": "20-day momentum relative to defensive anchor",
  "version": "1.0",
  "calculation": {
    "expression": "rolling_sum_20d(asset_returns - mean(XAU_return, US10Y_return, CN10Y_return))",
    "description": "For each tradable asset, compute its 20-trading-day cumulative return in excess of the equal-weighted daily return of the defensive anchor basket XAU, US10Y, and CN10Y. Higher values indicate stronger relative momentum and receive higher portfolio scores."
