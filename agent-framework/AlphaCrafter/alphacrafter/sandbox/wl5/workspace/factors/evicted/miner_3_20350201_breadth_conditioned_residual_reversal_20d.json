{
  "factor_id": "miner_3_20350201_breadth_conditioned_residual_reversal_20d",
  "factor_name": "Breadth-Conditioned Residual Reversal 20D",
  "version": "1.0",
  "calculation": {
    "expression": "-clip((rolling_sum_20(residual_return) / (rolling_std_60(residual_return) * sqrt(20) + 1e-12)), -8, 8) * clip(0.65 + 0.70 * cross_sectional_breadth_60, 0.65, 1.35)",
    "description": "For each tradable instrument, subtract the daily cross-sectional mean return, normalize its trailing 20-session residual return by trailing 60-session residual volatility, and take the contrarian sign. Scale the signal by the contemporaneous fraction of instruments above their causal 60-session moving average. All inputs use data available at the signal date or earlier."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
