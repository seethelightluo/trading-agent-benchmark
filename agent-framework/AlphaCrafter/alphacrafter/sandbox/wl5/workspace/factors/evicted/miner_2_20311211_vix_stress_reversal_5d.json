  "factor_name": "VIX-stress gated five-day reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(log_return_5d / (rolling_std_log_return_20d * sqrt(20))) * clip(VIX / rolling_median(VIX,60) - 0.5, 0, 2.0)",
    "description": "Fades the trailing five-day asset return after volatility normalization, increasing signal magnitude when observation-only VIX is elevated relative to its trailing 60-day median. Signal uses only data through the signal date."
