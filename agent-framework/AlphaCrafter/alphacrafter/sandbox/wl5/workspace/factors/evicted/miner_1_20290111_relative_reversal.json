{
  "factor_id": "miner_1_20290111_relative_reversal",
  "factor_name": "Dispersion-Scaled Relative Reversal with Trend Dampening",
  "version": "1.0",
  "calculation": {
    "expression": "-(ret10 - cross_sectional_median(ret10))/vol20 * clip(cross_sectional_dispersion(ret10)/rolling_median_60(dispersion), 0.5, 2.0) * (1 - clip(abs(ret30)/(vol60*sqrt(30)), 0, 1))",
    "description": "Ranks assets positively when their 10-day return trails the cross-sectional median, scales reversal by the current relative dispersion regime, and suppresses the signal when a 30-day move is a persistent volatility-adjusted trend. Cross-sectional median makes the signal market-relative."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "reversal_window_days": 10,
    "trend_window_days": 30,
    "volatility_short_window_days": 20,
    "volatility_trend_window_days": 60,
    "dispersion_scale_window_days": 60,
    "dispersion_clip": [
      0.5,
      2.0
    ],
    "trend_strength_clip": [
      0.0,
      1.0
    ]
  },
