  "factor_id": "vix_conditioned_reversal_20d",
  "factor_name": "VIX-Conditioned Volatility-Normalized Reversal 20-Day",
  "version": "1.0",
  "calculation": {
    "expression": "-(close / close.shift(20) - 1) / (rolling_std(pct_change(close), 60) * sqrt(252)) * (0.5 + percentile_rank(VIX_close, 252))",
    "description": "Cross-asset 20-day mean reversion, normalized by 60-day annualized volatility and scaled by the causal 252-observation percentile rank of VIX. The stress multiplier is bounded between 0.5 and 1.5."
