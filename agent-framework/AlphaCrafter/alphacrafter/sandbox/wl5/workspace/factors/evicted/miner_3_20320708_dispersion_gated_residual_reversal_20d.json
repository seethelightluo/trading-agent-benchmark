{
  "factor_id": "miner_3_20320708_dispersion_gated_residual_reversal_20d",
  "factor_name": "Dispersion-gated beta-neutralized residual reversal 20d",
  "version": "1.0",
  "calculation": {
    "expression": "rank_pct((1 + 0.8*tanh((mean(std_20d(cross_asset_returns))/mean(std_80d(cross_asset_returns))-1)*3)) * (-sum_20d(residual_return_80d)/(std_20d(residual_return_80d)+eps)))",
    "description": "Compute each asset's 80-day beta to the equal-weight cross-asset return, form beta-neutralized residual returns, and rank the negative 20-day residual return normalized by residual volatility. Multiply the common signal by a causal cross-asset dispersion regime gate; since the gate is common across assets, it preserves the cross-sectional ordering while documenting the elevated-dispersion activation context. All inputs end no later than the signal date."
  },
  "dependencies": [
    "close",
    "daily_returns"
  ],
  "parameters": {
    "beta_window": 80,
    "signal_window": 20,
    "forward_horizon": 10,
    "dispersion_window": 20,
    "dispersion_baseline_window": 80,
    "gate_scale": 0.8,
    "gate_slope": 3.0,
    "epsilon": 1e-12,
    "min_cross_section": 8
  },
