{
  "factor_id": "miner_2_20350927_range_position_reversal_10d",
  "factor_name": "Volatility-normalized 60-day range-position reversal",
  "version": "1.0",
  "calculation": {
    "expression": "(0.5 - (close - rolling_min(close,60)) / (rolling_max(close,60)-rolling_min(close,60))) / rolling_std(pct_change(close),20)*sqrt(20)",
    "description": "Ranks assets for mean reversion based on causal 60-session range position: assets near the lower range receive positive scores and assets near the upper range receive negative scores. The signal is normalized by 20-session annualized realized volatility. Signal uses data through the signal date only; forward returns are used solely for validation."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "range_window": 60,
    "vol_window": 20,
    "vol_annualization": "sqrt(20)",
