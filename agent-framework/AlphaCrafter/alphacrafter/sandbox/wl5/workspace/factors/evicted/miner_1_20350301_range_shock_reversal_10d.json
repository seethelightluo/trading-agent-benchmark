{
  "factor_id": "miner_1_20350301_range_shock_reversal_10d",
  "factor_name": "Range-shock amplified cross-sectional reversal",
  "version": "1.0",
  "calculation": {
    "expression": "clip((-cs_return_sum(10) / (rolling_std(cs_daily_return,40)*sqrt(10))) * (1 + 0.30*tanh(rolling_mean(range_zscore,3)), -8, 8)",
    "description": "For each tradable instrument, fade its 10-session cumulative return relative to the cross-sectional daily return mean, normalize by 40-session idiosyncratic volatility, and amplify the reversal when the recent high-low range is unusually wide versus its 40-session history. All inputs are lagged/complete observations at the decision timestamp."
  },
  "dependencies": [
    "close",
    "high",
    "low"
  ],
  "parameters": {
