  "factor_name": "Inverse Relative Risk-Normalized Trend",
  "version": "1.0",
  "calculation": {
    "expression": "-((close/shift(close,20)-1) - cross_sectional_median(close/shift(close,20)-1)) / (rolling_std(pct_change(close),20)*sqrt(252))",
    "description": "For each tradable asset, subtract the same-day cross-sectional median 20-day return from its own 20-day return, divide by causal 20-day realized volatility annualized, then invert the signal. Higher values historically predict weaker subsequent returns in this universe, so the persisted direction is inverse."
