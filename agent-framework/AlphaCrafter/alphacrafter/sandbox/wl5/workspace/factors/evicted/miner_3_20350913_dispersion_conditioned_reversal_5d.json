{
  "factor_id": "miner_3_20350913_dispersion_conditioned_reversal_5d",
  "factor_name": "Dispersion-Conditioned Volatility-Scaled Short Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(close/close.shift(5)-1)/(rolling_std(daily_return,20)*sqrt(20)) * (1 + 0.35*clip((cross_sectional_dispersion - rolling_mean(dispersion,60))/rolling_std(dispersion,60), -2, 2))",
    "description": "Reverse the causal five-session return scaled by 20-session realized volatility. Modulate the reversal by contemporaneous cross-asset return dispersion relative to its trailing 60-session z-score; all inputs are known at the signal date. Higher values indicate stronger expected forward returns."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "reversal_lookback": 5,
    "realized_volatility_window": 20,
    "dispersion_window": 60,
    "dispersion_z_clip": [
      -2,
      2
    ],
    "dispersion_amplitude": 0.35
  },
