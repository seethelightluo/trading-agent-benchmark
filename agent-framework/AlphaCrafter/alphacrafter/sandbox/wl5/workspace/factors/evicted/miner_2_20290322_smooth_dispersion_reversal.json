  "factor_name": "Smooth Dispersion-Gated Volatility-Normalized Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "(-sum(return,5)/std(return,20)) * clip((cross_sectional_dispersion/rolling_median(dispersion,60))-1,0,1)",
    "description": "Five-day reversal normalized by 20-day realized volatility, continuously activated as cross-asset return dispersion rises above its trailing 60-day median, capped at twice the median dispersion. Uses only information through the signal date."
