  "factor_name": "Inverse Volatility-Adjusted Intermediate Momentum",
  "version": "1.0",
  "calculation": {
    "expression": "-(0.70*(return_20d/volatility_60d) + 0.30*(return_60d/volatility_60d)), clipped cross-sectionally to 5th/95th percentiles",
    "description": "A causal contrarian intermediate-momentum signal: assets with strong recent returns relative to risk receive lower scores, while weak risk-adjusted performers receive higher scores. The signal is designed for five-day forward returns and uses only closes through the observation date."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "short_window": 20,
    "long_window": 60,
    "volatility_window": 60,
    "short_weight": 0.7,
    "long_weight": 0.3,
    "clip_lower": 0.05,
    "clip_upper": 0.95,
    "forward_horizon": 5
  },
