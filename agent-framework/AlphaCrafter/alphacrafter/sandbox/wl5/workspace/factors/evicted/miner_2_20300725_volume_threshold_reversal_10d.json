  "factor_id": "miner_2_20300725_volume_threshold_reversal_10d",
  "factor_name": "Volume-Threshold Downside Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-min(ret_5d,0) * (sqrt(volume/median_volume_20d) if volume/median_volume_20d > 1 else 1) / volatility_20d",
    "description": "Ranks assets with recent five-day losses higher for expected ten-day rebound, while amplifying downside shocks accompanied by above-median volume and normalizing by 20-day log-return volatility. Volume ratio is clipped to [0.25,4]."
  },
  "dependencies": [
    "close",
    "volume"
  ],
  "parameters": {
    "loss_window_days": 5,
