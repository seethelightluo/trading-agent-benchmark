  "factor_name": "Defensive-Basket Residual Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-rolling_sum_5(asset_return - mean(defensive_returns[XAU,US10Y,CN10Y], axis=assets)) / (rolling_std_20(asset_return - defensive_basket_return) * sqrt(5))",
    "description": "Fades each tradable asset's five-session return relative to a defensive basket, normalized by 20-session volatility of the relative return. The defensive basket is the equal-weight mean of XAU, US10Y, and CN10Y returns."
