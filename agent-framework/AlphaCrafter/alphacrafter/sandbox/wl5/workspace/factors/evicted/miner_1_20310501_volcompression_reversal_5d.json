  "factor_name": "Volatility-compression weighted five-day residual reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(sum(log_return,5)-cross_sectional_median(sum(log_return,5)))/rolling_std(log_return,20) * clip(rolling_std(log_return,120)/rolling_std(log_return,20),0.6,1.8)",
    "description": "Fade each asset's causal five-day return residual versus the cross-sectional median, normalize by 20-day volatility, and modestly boost signals when long-run volatility exceeds recent volatility. All inputs are lag-safe as of the signal date."
