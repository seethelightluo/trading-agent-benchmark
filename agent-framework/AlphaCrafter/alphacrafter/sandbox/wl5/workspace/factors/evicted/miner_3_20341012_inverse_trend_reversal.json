  "factor_name": "Volatility-normalized 60-day contrarian trend reversal",
  "version": "1.0",
  "calculation": {
    "expression": "clip(-(close/lag(close,60)-1)/(rolling_std(pct_change(close),20)*sqrt(60)+epsilon), -6, 6)",
    "description": "Ranks assets positively when their 60-trading-day return is negative, with the contrarian signal normalized by recent 20-day realized volatility. Larger negative medium-term moves generate stronger reversal scores, while volatility normalization limits domination by noisy assets. Uses only information available at the signal date."
