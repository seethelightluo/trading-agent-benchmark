{
  "factor_id": "miner_3_20310206_stress_shock_reversal_5d",
  "factor_name": "Volatility-shock weighted residual short-term reversal",
  "version": "1.0",
  "calculation": {
    "expression": "(-sum_{k=0..4} residual_return_{t-k}) * clip(std20(residual_return)/std90_prior(residual_return),0.5,2.0) / (std20(residual_return)+epsilon)",
    "description": "For each asset, compute five-day reversal of returns relative to the daily cross-asset median. Scale the reversal by the recent 20-day residual volatility shock versus the prior 90-day baseline, then normalize by recent volatility. The shock multiplier emphasizes cross-asset losers during elevated volatility states. All inputs are lagged through the decision date."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
