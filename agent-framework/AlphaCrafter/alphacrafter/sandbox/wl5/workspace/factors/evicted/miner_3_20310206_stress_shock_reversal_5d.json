    "reversal_window_days": 5,
    "recent_volatility_window_days": 20,
    "baseline_volatility_window_days": 90,
    "shock_clip": [
      0.5,
      2.0
    ],
    "epsilon": 1e-12,
    "forward_horizon_days": 5
  },
