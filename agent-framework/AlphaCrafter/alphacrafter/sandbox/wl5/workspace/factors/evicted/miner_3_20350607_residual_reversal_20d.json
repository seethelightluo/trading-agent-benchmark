{
  "factor_id": "miner_3_20350607_residual_reversal_20d",
  "factor_name": "Volatility-normalized cross-asset residual reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-((return_20(asset) - beta_60(asset,market)*return_20(market)) / residual_vol_20(asset))",
    "description": "Compute the equal-weight cross-asset daily return as the market proxy. Estimate each asset's trailing 60-observation beta to that proxy, calculate the 20-session asset return residual to the corresponding market move, and invert it cross-sectionally. Normalize by trailing 20-session residual volatility. All rolling inputs are causal and clipped to [-8,8]."
  },
  "dependencies": [
    "close",
    "daily_returns"
  ],
  "parameters": {
    "market_proxy": "equal_weight_mean_of_available_asset_returns",
    "beta_window": 60,
    "beta_min_periods": 40,
    "return_window": 20,
    "residual_vol_window": 20,
    "residual_vol_min_periods": 15,
    "minimum_cross_section": 8,
    "clip": [
      -8,
      8
    ]
  },
