{
  "factor_id": "miner_3_20290308_vix_conditioned_reversal_5d",
  "factor_name": "VIX-conditioned volatility-scaled short-term reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(return_5d)/(rolling_std(return_1d,20)*sqrt(5)) * clip(1 + 0.5*zscore(VIX,60), 0.25, 2.0)",
    "description": "Fade each tradable asset's five-day return after volatility normalization, increasing or decreasing signal magnitude according to the observation-only VIX level relative to its trailing 60-session mean and standard deviation. VIX is used only as a conditioning signal and is not tradable."
  },
  "dependencies": [
    "close",
    "VIX"
  ],
