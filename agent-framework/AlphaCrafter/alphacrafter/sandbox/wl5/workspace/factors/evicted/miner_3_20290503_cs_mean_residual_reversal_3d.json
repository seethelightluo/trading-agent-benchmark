{
  "factor_id": "miner_3_20290503_cs_mean_residual_reversal_3d",
  "factor_name": "Cross-sectional Mean-Residual Reversal with Trend Dampening",
  "version": "1.0",
  "calculation": {
    "expression": "raw_i = -(sum_return_3d_i - cross_sectional_mean(sum_return_3d)) / (std_return_20d_i * sqrt(3)); factor_i = raw_i if raw_i * sign(sum_return_20d_i) <= 0 else 0.5 * raw_i",
    "description": "Ranks assets for reversal of three-day returns after removing the contemporaneous cross-sectional mean move, volatility-normalized by trailing 20-day daily volatility. When the shock agrees with the asset's 20-day trend, the reversal signal is damped by 50% to reduce continuation risk."
  },
  "dependencies": [
    "close",
    "daily_returns"
  ],
