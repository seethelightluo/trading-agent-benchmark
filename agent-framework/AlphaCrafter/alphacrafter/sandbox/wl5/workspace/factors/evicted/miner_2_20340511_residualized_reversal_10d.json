  "factor_name": "Cross-asset residualized volatility-normalized 10-day reversal",
  "version": "1.0",
  "calculation": {
    "expression": "clip(-(r10 - median_cross_section(r10)) / (std(returns,30)*sqrt(10)), -8, 8)",
    "description": "For each asset, subtract the same-date cross-sectional median 10-day return from its 10-day return, then reverse and normalize by 30-day realized daily volatility scaled to a 10-day horizon. Cross-sectional median and rolling volatility use only information available at the signal date."
