  "factor_name": "Breadth-Stress-Gated Inverse Downside Momentum",
  "version": "1.0",
  "calculation": {
    "expression": "clip(-sum(log_return,20d)/std(negative_log_return,40d),-10,10) * (1 + 0.75*clip((0.5 - mean(positive_20d_return_indicator))/0.5,0,1))",
    "description": "Contrarian downside-volatility-scaled 20-day momentum, amplified causally when fewer than half of the tradable cross-asset universe has positive 20-day returns. All inputs use data available through the signal date."
