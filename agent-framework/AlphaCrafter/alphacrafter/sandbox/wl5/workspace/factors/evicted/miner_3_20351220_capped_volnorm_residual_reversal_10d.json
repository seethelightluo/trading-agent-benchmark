  "factor_name": "Capped Volatility-Normalized Cross-Asset Residual Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(ret_20 - cross_sectional_mean(ret_20)) / max(realized_vol_20, 0.5 * cross_sectional_median(realized_vol_20))",
    "description": "Reverse each instrument's 20-trading-day return residual versus the contemporaneous equal-weight cross-asset mean, dividing by 20-day realized volatility with a cross-sectional median volatility floor to prevent unstable near-zero denominators. All inputs are lagged through the signal date."
