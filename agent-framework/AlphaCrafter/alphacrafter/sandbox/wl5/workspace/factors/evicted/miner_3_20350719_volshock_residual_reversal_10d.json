{
  "factor_id": "miner_3_20350719_volshock_residual_reversal_10d",
  "factor_name": "Idiosyncratic Volatility-Shock Residual Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "clip(-residual_return_20d / idiosyncratic_volatility_20d * clip(1 - 0.45 * (idiosyncratic_volatility_20d / idiosyncratic_volatility_60d - 1), 0.25, 1.8), ...)",
    "description": "Compute causal 20-day residual return after removing 60-day rolling market-beta exposure, normalize by 20-day idiosyncratic volatility, and condition reversal strength on the volatility shock versus its 60-day baseline. Volatility contraction strengthens reversal; volatility expansion attenuates it. All rolling inputs are backward-looking."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
