{
  "factor_id": "miner_2_20311030_downside_skew_recovery_10d",
  "factor_name": "Downside-skew recovery reversal (10-day)",
  "version": "1.0",
  "calculation": {
    "expression": "f_i = -(sum(log_return_i,t-2:t))/std(log_return_i,t-19:t) * clip(1 + 0.35*(downside_tail_count - upside_tail_count)/20, 0.65, 1.35)",
    "description": "Contrarian three-day return reversal normalized by trailing 20-day volatility. The recovery signal is amplified when the asset has more downside tail observations than upside tail observations, where tails are returns below minus or above plus the trailing volatility threshold. All inputs are lagged through the decision date and the signal forecasts the next 10 trading days."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "reversal_window_days": 3,
    "volatility_window_days": 20,
    "tail_window_days": 20,
    "tail_amplitude": 0.35,
    "tail_multiplier_floor": 0.65,
    "tail_multiplier_cap": 1.35,
    "forward_horizon_days": 10,
