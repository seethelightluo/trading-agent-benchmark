  "factor_name": "Smooth Tail-Adjusted Five-Day Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(sum(log_return,5) / (std(log_return,30)+epsilon)) * (0.90 + 0.10 * mean(abs(min(log_return,0)),30)/(std(log_return,30)+epsilon))",
