  "factor_name": "VIX-conditioned short-horizon reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-rolling_sum(pct_change(close), 5) * (0.35 + 0.65 * I(VIX > causal_252d_quantile(VIX, 0.70)))",
    "description": "Ranks assets by the negative of their causal five-day return, with stronger reversal exposure when VIX exceeds its trailing 252-trading-day 70th percentile. The signal uses only completed daily observations and is evaluated against the next ten-trading-day return."
  },
  "dependencies": [
    "close",
    "VIX"
  ],
  "parameters": {
    "lookback_days": 5,
    "forward_horizon_days": 10,
    "vix_window_days": 252,
