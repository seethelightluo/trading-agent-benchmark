  "factor_name": "VIX-beta gated compressed downside reversal",
  "version": "1.0",
  "calculation": {
    "expression": "[-min(pct_change(close,5),0)/std(pct_change(close,1),20)] * sqrt(clip(std(asset_returns,60)/std(asset_returns,20),0.25,4)) * clip(1 + beta_60(asset_return,VIX_return) * clip(sum(VIX_return,5),-0.5,0.5),0.25,1.75)",
    "description": "Ranks recent five-day downside reversals after short-volatility normalization and compression adjustment, with a causal VIX-return beta gate that modestly increases or decreases the signal according to recent VIX movement. VIX is observation-only and is never traded. All inputs are lagged to the signal date."
  },
  "dependencies": [
    "close",
    "VIX close"
  ],
