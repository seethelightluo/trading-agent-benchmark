{
  "factor_id": "miner_3_20350816_short_exhaustion_reversal_10d",
  "factor_name": "Short-Horizon Close-Location Exhaustion Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(close/shift(close,5)-1)/(rolling_std(pct_change(close),20)*sqrt(20)) * (1 - 0.9*clip(rolling_mean((close-low)/(high-low)-0.5,10,min_periods=7),-0.5,0.5))",
    "description": "Ranks causal five-session volatility-normalized reversal, amplified when the asset's preceding ten-session closes are persistently near the lower end of daily high-low ranges. Uses only data available through the signal date."
  },
  "dependencies": [
    "close",
    "high",
    "low"
  ],
  "parameters": {
    "reversal_lookback_days": 5,
    "volatility_window_days": 20,
    "location_window_days": 10,
    "location_min_periods": 7,
    "location_clip": [
      -0.5,
      0.5
    ],
    "conditioning_strength": 0.9,
    "forward_horizon_days": 10
  },
