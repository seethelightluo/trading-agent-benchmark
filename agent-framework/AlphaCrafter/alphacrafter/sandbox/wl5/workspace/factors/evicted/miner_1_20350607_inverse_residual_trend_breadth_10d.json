    "volatility_annualization": "sqrt(20)",
    "breadth_zscore_window": 60,
    "breadth_min_periods": 30,
    "breadth_multiplier_slope": 0.25,
    "breadth_multiplier_bounds": [
      0.55,
      1.45
    ],
