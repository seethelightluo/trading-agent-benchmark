{
  "factor_id": "miner_1_20350607_inverse_residual_trend_breadth_10d",
  "factor_name": "Inverse volatility-scaled 60-session trend conditioned on breadth",
  "version": "1.0",
  "calculation": {
    "expression": "-clip(pct_change(close,60)/(std(pct_change(close,1),20)*sqrt(20), -8, 8) * clip(1 + 0.25*zscore_cs_breadth(positive_60d_trend,60), 0.55, 1.45), -8, 8)",
    "description": "Cross-asset signal that explicitly inverts a 60-session volatility-scaled trend. The inverted trend is multiplied by a causal, bounded 60-session z-score of the cross-sectional breadth of positive 60-session trends. Larger values indicate stronger expected forward returns. All inputs use completed observations only."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "trend_lookback_sessions": 60,
