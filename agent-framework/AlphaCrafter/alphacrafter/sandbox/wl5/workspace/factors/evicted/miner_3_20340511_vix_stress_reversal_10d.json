{
  "factor_id": "miner_3_20340511_vix_stress_reversal_10d",
  "factor_name": "VIX-Stress Amplified Volatility-Normalized Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(close/close.shift(10)-1)/(std(pct_change(close),30)*sqrt(10)+1e-8) * (1 + 0.35*max(zscore_252(pct_change(VIX,10)),0))",
    "description": "Ranks the inverse 10-day return normalized by 30-day realized volatility, with stronger reversal magnitude during unusually rising VIX stress. VIX is aligned causally and forward-filled only from observed dates; stress is clipped to avoid extreme leverage."
  },
  "dependencies": [
    "close",
    "pct_change",
    "VIX"
  ],
