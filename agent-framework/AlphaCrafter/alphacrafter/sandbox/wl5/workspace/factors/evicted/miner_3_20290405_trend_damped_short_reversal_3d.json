{
  "factor_id": "miner_3_20290405_trend_damped_short_reversal_3d",
  "factor_name": "Trend-Damped Volatility-Normalized Short Reversal",
  "version": "20290405",
  "calculation": {
    "expression": "raw=-sum(pct_change(close),3)/(sqrt(3)*rolling_std(pct_change(close),20)); trend=sign(sum(pct_change(close),20)); factor=raw if raw*trend<=0 else 0.5*raw",
    "description": "Fade the latest three-day return after volatility normalization, but halve the reversal signal when it agrees with the prevailing 20-day trend. This limits the tendency of short reversal to unintentionally become momentum exposure."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "reversal_window_days": 3,
