  "factor_id": "residual_momentum40_inverse",
  "factor_name": "40-Day Market-Residual Momentum (Inverse Residual Risk)",
  "version": "2034-07-06",
  "calculation": {
    "expression": "-rolling_sum_40(residual_return_i) / (rolling_std_40(residual_return_i) * sqrt(40))",
    "description": "For each tradable asset, estimate rolling 40-day beta to the equal-weight cross-asset market return, compute lagged market residual returns, and rank the negative 40-day cumulative residual return normalized by residual volatility. Inputs are shifted one completed observation before scoring. Higher values favor assets with negative residual momentum, i.e. residual mean-reversion, after risk normalization."
  },
