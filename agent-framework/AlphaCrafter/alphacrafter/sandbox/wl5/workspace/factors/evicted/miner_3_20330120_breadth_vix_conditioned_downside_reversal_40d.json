{
  "factor_id": "miner_3_20330120_breadth_vix_conditioned_downside_reversal_40d",
  "factor_name": "Breadth/VIX-conditioned downside-volatility reversal, 40-day horizon",
  "version": "1.0",
  "calculation": {
    "expression": "rank_pct((-sum(log_return,120) / downside_std(log_return,90)) * (1 + 0.60*stress_breadth + 0.50*vix_stress), cross_section)",
    "description": "Ranks a 120-day downside-volatility-normalized reversal signal. The reversal magnitude is amplified when 20-day cross-asset breadth is stressed and recent cross-asset volatility is elevated versus its 120-day baseline, with an additional causal VIX z-score stress multiplier.",
    "causal_timing": "At signal date t, all price inputs end at t-1; VIX stress uses t-1 and the preceding 60 observations. Forward validation return is close[t+40]/close[t]-1."
  },
  "dependencies": [
    "close",
    "VIX"
  ],
  "parameters": {
    "reversal_window": 120,
    "downside_volatility_window": 90,
    "breadth_window": 20,
    "cross_asset_volatility_window": 20,
    "cross_asset_volatility_baseline": 120,
    "vix_history_window": 60,
    "forward_horizon_days": 40,
    "breadth_amplification": 0.6,
    "vix_amplification": 0.5,
    "minimum_cross_section": 8
  },
