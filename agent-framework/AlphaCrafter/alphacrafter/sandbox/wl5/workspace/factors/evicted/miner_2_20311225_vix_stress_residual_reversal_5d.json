{
  "factor_id": "miner_2_20311225_vix_stress_residual_reversal_5d",
  "factor_name": "VIX-stress gated cross-sectional residual reversal (5d)",
  "version": "1.0",
  "calculation": {
    "expression": "-(r_5(asset)-median_cross_section(r_5))/(std_20(asset)*sqrt(20)) * clip(VIX/rolling_median(VIX,60)-0.5, 0, 2.0)",
    "description": "Fade each asset's trailing five-day log return after removing the same-day cross-sectional mean, scale by trailing 20-day return volatility, and amplify the signal when lagged VIX is elevated relative to its 60-day median. Signal uses only information available on the signal date."
  },
  "dependencies": [
    "close",
    "VIX"
  ],
  "parameters": {
    "return_window": 5,
    "volatility_window": 20,
    "vix_median_window": 60,
    "stress_clip": [
      0.5,
      2.5
    ],
    "forward_horizon_days": 5,
    "minimum_cross_section": 8
  },
