{
  "factor_id": "miner_1_20350215_breadth_gated_reversal_60d",
  "factor_name": "Breadth-gated volatility-normalized relative reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-clip((60d_sum(relative_daily_returns))/(60d_std(relative_daily_returns)*sqrt(60)), -8, 8) * (0.5 + 0.5*clip((breadth20-0.5)/0.25,-1,1))",
    "description": "Compute each instrument's daily return minus the contemporaneous cross-sectional mean, aggregate the relative return over 60 sessions, normalize by 60-session relative-return volatility, and invert for contrarian reversal. Multiply by a bounded breadth gate based on the fraction of instruments with positive 20-session mean relative return. All inputs are lagged completed observations."
  },
