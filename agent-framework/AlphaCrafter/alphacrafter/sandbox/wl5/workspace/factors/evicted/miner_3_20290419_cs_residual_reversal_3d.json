{
  "factor_id": "miner_3_20290419_cs_residual_reversal_3d",
  "factor_name": "Cross-sectional residual trend-damped short reversal",
  "version": "1.0",
  "calculation": {
    "expression": "raw = -(sum_return_3d - cross_sectional_median(sum_return_3d)) / (rolling_std_daily_return_20d * sqrt(3)); signal = raw if raw*sign(sum_return_20d)<=0 else 0.5*raw",
    "description": "Fades each instrument's three-day return after removing the same-day cross-sectional median move, volatility-normalizes the residual, and halves reversal signals aligned with the 20-day trend. This reduces broad market beta and dampens momentum-contaminated reversals."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "short_window_days": 3,
    "volatility_window_days": 20,
    "trend_window_days": 20,
    "aligned_trend_damping": 0.5,
    "cross_sectional_center": "median",
