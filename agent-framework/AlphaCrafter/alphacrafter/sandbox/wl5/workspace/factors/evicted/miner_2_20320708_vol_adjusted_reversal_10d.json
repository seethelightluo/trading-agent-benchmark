  "factor_name": "10-day volatility-adjusted reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(close / close.shift(10) - 1) / (rolling_std(pct_change(close), 20) * sqrt(252) + 1e-8), cross-sectionally clipped at 5th/95th percentiles",
    "description": "Fades the prior 10-session return and normalizes by trailing 20-session annualized return volatility. All inputs are lagged or trailing and therefore causal."
  },
