{
  "factor_id": "miner_2_20321125_breadth_recovery_residual",
  "factor_name": "Breadth-Recovery Beta-Neutral Residual Reversal 20d",
  "version": "1.0",
  "calculation": {
    "expression": "rank_pct((-sum_20(residual_return))/(std_60(residual_return)+eps)) * (1 + 0.30*tanh((mean_5(breadth)-mean_20(breadth))/0.15))",
    "description": "For each tradable asset, remove rolling 80-day beta exposure to equal-weight cross-asset returns, take 20-day residual reversal scaled by 60-day residual volatility, and modestly gate it by improving five-day versus twenty-day breadth. All inputs are lagged through the decision date minus one completed day."
  },
