  "factor_name": "Downside-Adjusted Intermediate Momentum",
  "version": "1.0",
  "calculation": {
    "expression": "cross_sectional_median_demean(close.pct_change(20) / rolling_std(negative_daily_returns, 40))",
    "description": "Ranks 20-trading-day price momentum after scaling by 40-day downside-return volatility. Positive and negative daily returns are separated causally; only negative returns contribute to the risk denominator. Cross-sectional median demeaning preserves relative ranking."
