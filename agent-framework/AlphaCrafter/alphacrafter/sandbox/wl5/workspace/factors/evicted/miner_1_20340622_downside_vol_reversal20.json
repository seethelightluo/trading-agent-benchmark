{
  "factor_id": "downside_vol_relative_reversal20",
  "factor_name": "Cross-Asset 20-Day Relative Reversal Scaled by Downside Volatility",
  "version": "1.0",
  "calculation": {
    "expression": "-(return_20 - cross_sectional_median(return_20)) / downside_deviation_40",
    "description": "For each tradable benchmark instrument, invert its 20-trading-day return relative to the cross-sectional median and divide by the prior 40-day downside deviation annualized over a 20-day horizon. If downside deviation is zero, use total 40-day realized volatility as a fallback. All inputs are lagged completed daily observations."
  },
