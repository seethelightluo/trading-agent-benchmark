{
  "factor_id": "miner_2_20290111_trend_gated_downside_reversal_5d",
  "factor_name": "Trend-gated downside-risk-adjusted 5-day reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(close/close.shift(5)-1) / rolling_std(clip(pct_change, upper=0),20) * (1 - 0.75*sign((close/close.shift(5)-1)*(close/close.shift(20)-1)))",
    "description": "Ranks assets for short-horizon reversal using downside volatility normalization. When the 5-day move agrees with the 20-day trend, reversal exposure is damped by 75%; when conflicting, the reversal signal is retained. All inputs are lagged to the completed signal date."
  },
  "dependencies": [
    "close",
    "pct_change"
  ],
  "parameters": {
    "reversal_lookback": 5,
    "trend_lookback": 20,
    "downside_volatility_lookback": 20,
    "trend_agreement_dampening": 0.75,
    "forward_horizon_sessions": 10,
    "cross_section_minimum": 8
  },
