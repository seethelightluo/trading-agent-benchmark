  "factor_name": "Market-stress-gated beta-residual reversal (5d)",
  "version": "1.0",
  "calculation": {
    "expression": "-sum_{1:5}(asset_log_return - beta_60*market_log_return) / (sqrt(5)*asset_vol_60) * (1 + 0.65*clip(-sum_{1:20}(market_log_return)/(sqrt(20)*market_vol_60),0,1.5))",
    "description": "Five-day beta-adjusted residual reversal, normalized by 60-day asset volatility and amplified when the trailing 20-day cross-asset mean return is stressed to the downside. All inputs are lagged/casual as of the signal date. Higher values indicate stronger expected forward recovery."
  },
  "dependencies": [
