{
  "factor_id": "volatility_contraction_reversal",
  "factor_name": "Short-versus-baseline volatility contraction reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(rolling_std(pct_change(close), 5) / rolling_std(pct_change(close), 30) - 1)",
    "description": "At each completed-day observation, rank assets higher when their recent 5-day realized volatility is below their own 30-day baseline. The signal is lagged operationally by using only completed daily data; it is an interpretable volatility-state factor with a contrarian forward-return interpretation."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "short_window": 5,
    "baseline_window": 30,
    "short_min_periods": 4,
    "baseline_min_periods": 20,
    "horizon_days": 5,
    "universe": 15
  },
