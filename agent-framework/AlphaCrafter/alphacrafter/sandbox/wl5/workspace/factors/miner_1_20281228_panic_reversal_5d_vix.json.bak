{
  "factor_id": "miner_1_20281228_panic_reversal_5d_vix",
  "factor_name": "VIX-regime 5-day panic reversal",
  "version": "1.0",
  "calculation": {
    "expression": "demean_cross_section(-pct_change(close,5) * I(VIX > rolling_median(VIX,60)))",
    "description": "During elevated VIX regimes, rank assets by the negative of their trailing 5-day return to capture cross-asset panic reversal; signal is zero in normal VIX regimes and cross-sectionally demeaned. VIX is observation-only and is never traded."
  },
  "dependencies": ["close", "VIX"],
  "parameters": {"return_window": 5, "vix_median_window": 60, "forward_horizon": 10, "minimum_cross_section": 8},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-02 through 2028-12-27 (usable signal/forward observations)",
    "metrics": {
      "ic": 0.038515,
      "icir": 0.112387,
      "horizon_days": 10,
      "ic_dates": 1557,
      "average_instruments": 14.72,
      "coverage": 0.7426,
      "turnover": null,
      "hit_ratio": 0.5491,
      "decay": {"5d": {"ic": 0.032217, "icir": 0.097335}, "10d": {"ic": 0.038515, "icir": 0.112387}, "20d": {"ic": 0.046838, "icir": 0.136761}},
      "recent_252_ic": 0.047590,
      "recent_252_icir": 0.136803,
      "max_abs_library_correlation": null
    },
    "regime_notes": "Full available synthetic history clears both benchmark gates at the 10-day decision horizon. Predictive strength improves at 20 days and remains positive in the recent 252 observations. Coverage is conditional because the signal is intentionally inactive in normal-VIX regimes; valid price coverage among active/available observations is broad.",
    "validation_timestamp": "2028-12-28T00:00:00",
