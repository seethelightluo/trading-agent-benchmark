{
  "factor_id": "miner_3_20290517_smooth_residual_reversal_5d",
  "factor_name": "Smoothed volatility-normalized cross-sectional residual reversal with 60-day trend dampening",
  "version": "20290517",
  "calculation": {
    "expression": "rolling_mean_3(-((sum_5(return_i)-mean_i(sum_5(return_i)))/(std_20(return_i)*sqrt(5))) * trend_gate_i)",
    "description": "For each tradable asset, reverse its five-day return shock relative to the contemporaneous cross-sectional mean, scale by trailing 20-day volatility, dampen aligned shocks to 35 percent when they agree with the asset's trailing 60-day trend, and smooth the signal over three observations. All inputs are causal as of the signal date."
  },
  "dependencies": [
    "close",
    "daily_return"
  ],
  "parameters": {
    "residual_window": 5,
    "volatility_window": 20,
    "trend_window": 60,
    "trend_min_periods": 40,
    "dampening_multiplier": 0.35,
    "smoothing_window": 3,
    "forward_horizon_days": 10,
    "minimum_cross_section": 8
  },
