{
  "factor_id": "trend_conditioned_downside_reversal_10d",
  "factor_name": "Trend-Conditioned Downside Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(log_return_10d / downside_volatility_20d) * (1 + 0.5 * I(log_return_60d < 0))",
    "description": "Ranks assets positively after medium-horizon declines normalized by downside volatility, with a modest boost when the asset remains in a negative 60-day trend. Uses only completed daily closes."
  },
  "dependencies": ["close"],
  "parameters": {"reversal_window": 10, "volatility_window": 20, "trend_window": 60, "negative_trend_boost": 0.5},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2032-03-03",
