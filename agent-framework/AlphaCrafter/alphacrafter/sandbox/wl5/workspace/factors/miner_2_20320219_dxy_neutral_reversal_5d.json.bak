{
  "factor_id": "miner_2_20320219_dxy_neutral_reversal_5d",
  "factor_name": "DXY-neutral volatility-scaled short-term reversal (5d)",
  "version": "2032-02-19",
  "calculation": {
    "expression": "-sum_5(asset_log_return - beta_60_DXY * DXY_log_return) / (sqrt(5) * sd_60(asset_log_return)) * clip(1 + sd_60(cross_asset_mean_return) / mean_60(abs(cross_asset_mean_return)), 1, 2)",
    "description": "Fades the asset's five-day return residual after removing its trailing 60-day DXY sensitivity, scales by trailing volatility, and applies a bounded market-dispersion amplifier. All inputs are lagged through the prior completed day."
  },
  "dependencies": ["close", "DXY close"],
  "parameters": {"residual_window": 5, "beta_window": 60, "volatility_window": 60, "forward_horizon": 5, "dispersion_clip": [1, 2]},
  "validation": {
    "status": "EFFECTIVE",
    "last_validated": "2032-02-19T00:00:00Z",
    "period": "2020-01-01 through 2032-02-18",
