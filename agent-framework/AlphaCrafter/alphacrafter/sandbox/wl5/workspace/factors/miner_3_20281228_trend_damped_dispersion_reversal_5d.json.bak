{
  "factor_id": "miner_3_20281228_trend_damped_dispersion_reversal_5d",
  "factor_name": "Trend-damped continuous dispersion-scaled five-day reversal",
  "version": "1.0",
  "calculation": {
    "expression": "(-ret_5 / rolling_std(ret,20)) * clip(cross_sectional_std(ret_5) / rolling_median(cross_sectional_std(ret_5),60),0.5,2.0) * (1 - clip(abs(ret_60)/(rolling_std(ret,60)*sqrt(60)),0,1))",
    "description": "Cross-asset five-day reversal normalized by 20-day volatility and scaled by relative dispersion, with reversal exposure linearly damped when 60-day risk-adjusted directional trend strength is high. All rolling inputs use data available at the signal date."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "reversal_window": 5,
    "volatility_window": 20,
    "dispersion_median_window": 60,
    "trend_window": 60,
    "trend_vol_window": 60,
    "dispersion_clip": [
      0.5,
      2.0
    ],
    "trend_strength_clip": [
      0.0,
      1.0
    ]
  },
