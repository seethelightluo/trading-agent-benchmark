{
  "factor_id": "miner_3_20290208_downtrend_lowvol_reversal_5d",
  "factor_name": "Downtrend-conditioned volatility-scaled short-term reversal",
  "version": "1.0",
  "calculation": {
    "expression": "(-pct_change(close,5) / (rolling_std(pct_change(close,1),20) * sqrt(5))) * (1 + 0.50 * I[pct_change(close,20) < 0])",
    "description": "Volatility-scaled five-day reversal with a 50% score uplift when the instrument is below its 20-day trend, using only completed daily prices available at the signal date."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "reversal_window_days": 5,
    "volatility_window_days": 20,
    "trend_window_days": 20,
    "downtrend_uplift": 0.5,
    "min_periods": 15,
    "forward_horizon_days": 10
  },
