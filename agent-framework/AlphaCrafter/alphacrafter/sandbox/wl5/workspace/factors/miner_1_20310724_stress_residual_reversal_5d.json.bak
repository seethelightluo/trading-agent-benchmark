{
  "factor_id": "stress_residual_reversal_5d_20310724",
  "factor_name": "Market-stress amplified beta-residual reversal (5d)",
  "version": "1.0",
  "calculation": {
    "expression": "-sum_5d(asset_return - beta_60d*equal_weight_market_return)/(sqrt(5)*volatility_60d) * (1 + 0.65*clip(-sum_20d(market_return)/(sqrt(20)*volatility_60d(market_return)),0,1.5))",
    "description": "Reverse recent five-day idiosyncratic beta-adjusted shocks, volatility normalized, with a causal amplification during broad market stress. Equal-weight market uses the 15 tradable benchmark assets."
  },
  "dependencies": ["close"],
  "parameters": {"residual_window": 5, "beta_vol_window": 60, "market_stress_window": 20, "stress_cap": 1.5, "stress_amplification": 0.65, "horizon_days": 5},
