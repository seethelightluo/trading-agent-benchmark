{
  "factor_id": "miner_2_20290809_relative_strength_reversal_20d",
  "factor_name": "Cross-sectional relative-strength reversal (20d)",
  "version": "20290809",
  "calculation": {
    "expression": "-(close_t/close_{t-20}-1 - cross_sectional_median_i(close_t/close_{t-20}-1))",
    "description": "For each tradable benchmark, negate its 20-trading-day return after subtracting the same-day median 20-day return across the available 15-asset universe. Higher values select relative laggards for a reversal allocation. Values use only data through t."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "lookback_days": 20,
    "horizon_days": 10,
    "min_cross_section": 8,
    "universe_size": 15
  },
