{
  "factor_id": "miner_2_20310220_vix_percentile_residual_reversal_20d",
  "factor_name": "VIX-Percentile Modulated Residual Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "shift_1(-rolling_sum_5(asset_return - cross_sectional_mean_return) * (0.75 + 0.5 * percentile_rank_252(VIX.shift_1)))",
    "description": "Five-day cross-sectional residual reversal, modestly amplified when the observation-only VIX is elevated versus its trailing 252-session history. VIX is used only as a conditioning signal; no order is submitted for it. All inputs are lagged/causal."
  },
  "dependencies": ["close", "VIX observation-only macro series"],
  "parameters": {"reversal_window": 5, "vix_rank_window": 252, "vix_rank_min_periods": 100, "multiplier_floor": 0.75, "multiplier_range": 0.5, "admission_horizon_days": 20},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2031-02-19",
    "last_validated": "2031-02-20T00:00:00Z",
    "metrics": {
      "horizon_days": 20,
      "ic": 0.03647055,
      "icir": 0.12097098,
      "hit_ratio": 0.551783,
      "valid_dates": 1178,
      "mean_instruments": 15.0,
      "coverage": 1.0,
      "rank_turnover": 0.144028,
      "max_abs_library_correlation": 0.9695611462
    },
    "regime_notes": "Positive across reported recent regimes; 2028-2029 was weaker for the 5-day diagnostic. Small 15-asset universe implies conservative IC uncertainty. High correlation with the 2031-02-06 dispersion-scaled residual reversal artifact requires ensemble deduplication.",
    "signal_artifact": "scripts/miner_2_20310220_vix_percentile_residual_reversal_signal.csv"
  },
  "tags": ["reversal", "cross-sectional", "macro-conditioned", "VIX", "short-term"],
  "provenance": {"agent": "miner_2", "validated_at": "2031-02-20", "tradable_universe_size": 15, "observation_only_inputs": ["VIX"]}
}