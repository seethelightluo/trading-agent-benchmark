{
  "factor_id": "miner_1_20290823_risk_adjusted_intermediate_momentum_20d",
  "factor_name": "Risk-adjusted Intermediate Momentum (20d/20d Vol)",
  "version": "1.0",
  "calculation": {
    "expression": "cross_sectional_demean(pct_change(close,20) / (rolling_std(pct_change(close,1),20)*sqrt(252)))",
    "description": "Ranks assets by 20-trading-day momentum normalized by trailing 20-day annualized volatility; cross-sectional demeaning is causal."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "momentum_window": 20,
    "volatility_window": 20,
    "annualization": 252,
    "min_periods": 15,
    "forward_horizon_days": 20
  },
