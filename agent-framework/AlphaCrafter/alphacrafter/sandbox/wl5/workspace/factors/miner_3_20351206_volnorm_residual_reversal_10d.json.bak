{
  "factor_id": "miner_3_20351206_volnorm_residual_reversal_10d",
  "factor_name": "Volatility-Normalized Cross-Asset Residual Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(ret_20(asset)-mean_asset(ret_20))/ (std(ret_1,20)*sqrt(20))",
    "description": "At each date, reverse each instrument's 20-day return residual versus the equal-weight cross-asset 20-day return and normalize by its trailing 20-day realized volatility. All inputs are observable through the decision date."
  },
  "dependencies": ["close"],
  "parameters": {"residual_window_days": 20, "volatility_window_days": 20, "min_periods": 15, "forward_horizon_days": 10, "minimum_cross_section": 8},
  "validation": {
