{
  "factor_id": "miner_2_20311127_range_efficiency_reversal_5d",
  "factor_name": "Intraday-range efficiency weighted five-day reversal",
  "version": "1.0",
  "calculation": {
    "expression": "clip((-sum(log(close/close[-1]),5)/std(log_returns,60))/(1+8*mean(log(high/low),5)),-5,5)",
    "description": "Contrarian five-day log return normalized by 60-day volatility, with reversal magnitude attenuated when recent intraday ranges indicate noisy price action. Uses only completed daily OHLC data."
  },
  "dependencies": ["close", "high", "low"],
  "parameters": {"reversal_window": 5, "volatility_window": 60, "range_window": 5, "range_penalty": 8.0, "clip": 5.0, "forward_horizon": 5},
  "validation": {
    "status": "EFFECTIVE",
    "metrics": {
      "ic": 0.028141,
      "icir": 0.092209,
      "ic_hit_ratio": 0.52944,
      "coverage": 1.0,
      "mean_valid_instruments": 15.0,
      "observations": 3702,
      "rank_turnover": 0.153087,
      "max_abs_library_correlation": null,
      "decay_10d_ic": 0.023971,
      "decay_10d_icir": 0.078209
    },
    "period": "2020-01-01 through 2031-11-26",
    "validation_timestamp": "2031-11-27",
    "regime_notes": "Positive five-day IC in all tested regimes; latest 2030-2031 regime weaker but positive. Ten-day predictive stability is below the admission gate.",
    "signal_artifact": "scripts/miner_2_20311127_range_efficiency_reversal_signal.csv",
    "admission_thresholds": {"absolute_daily_paper_ic": 0.007, "absolute_daily_paper_icir": 0.084}
  },
  "tags": ["reversal", "range", "volatility", "cross_asset"],
  "last_validated": "2031-11-27"
}
