{
  "factor_id": "miner_2_20330331_breadth_vix_conditioned_downside_reversal_45d",
  "factor_name": "Breadth/VIX-conditioned downside-volatility reversal 45d",
  "version": "1.0",
  "calculation": {
    "expression": "rank_pct((-sum(log_return,90) + cross_sectional_median(sum(log_return,90))) / downside_volatility(120) * (1+0.60*breadth_stress*relative_dispersion + 0.50*vix_stress))",
    "description": "Long-horizon asset reversal relative to the cross-sectional median, normalized by each asset's 120-day downside volatility and amplified smoothly during weak breadth, elevated cross-asset dispersion, and VIX stress. All inputs are lagged through the prior completed session."
  },
  "dependencies": [
    "close",
    "VIX"
  ],
  "parameters": {
    "reversal_lookback_days": 90,
    "downside_volatility_lookback_days": 120,
    "forward_horizon_days": 45,
    "breadth_lookback_days": 20,
    "vix_lookback_days": 60,
    "breadth_amplitude": 0.6,
    "vix_amplitude": 0.5,
    "minimum_cross_section": 8
  },
