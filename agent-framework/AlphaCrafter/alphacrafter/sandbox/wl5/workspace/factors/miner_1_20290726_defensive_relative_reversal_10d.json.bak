{
  "factor_id": "miner_1_20290726_defensive_relative_reversal_10d",
  "factor_name": "Defensive-basket residual risk-adjusted reversal",
  "version": "20290726",
  "calculation": {
    "expression": "rank_cs(-(pct_change(close,60)-mean(pct_change(close_defensive_basket,60)))/(std(daily_return,20)*sqrt(252)))",
    "description": "For every tradable asset, subtract the contemporaneous 60-day return of the defensive basket (XAU, US10Y, CN10Y) from its own 60-day return, reverse the residual, divide by causal 20-day annualized volatility, and percentile-rank across the 15-asset cross-section. Signals use data through the prior completed date only."
  },
  "dependencies": [
    "close",
    "daily_return"
  ],
  "parameters": {
    "residual_window": 60,
    "defensive_basket": [
      "XAU",
      "US10Y",
      "CN10Y"
    ],
    "volatility_window": 20,
    "annualization": 252,
    "cross_section_rank": "percentile",
    "forward_horizon_days": 10,
    "minimum_cross_section": 8
  },
  "validation": {
    "status": "EFFECTIVE",
