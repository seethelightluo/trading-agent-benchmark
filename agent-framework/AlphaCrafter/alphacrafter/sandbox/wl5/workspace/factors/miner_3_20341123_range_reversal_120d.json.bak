{
  "factor_id": "miner_3_20341123_range_reversal_120d",
  "factor_name": "Volatility-adjusted 10-day range-position reversal",
  "version": "1.0",
  "calculation": {
    "expression": "clip(-(return_10 / (volatility_20 * sqrt(10))) * (1.5 - clip((close - rolling_min(close,120))/(rolling_max(close,120)-rolling_min(close,120)),0,1), -8, 8)",
    "description": "Fade each asset's volatility-adjusted 10-day return, with a smooth 0.5-1.5 multiplier that emphasizes assets near the lower end of their trailing 120-day price range. All inputs are lagged completed-day prices at decision time."
  },
  "dependencies": ["close"],
  "parameters": {
    "return_window_days": 10,
    "volatility_window_days": 20,
    "range_window_days": 120,
    "minimum_volatility_observations": 15,
    "range_gate_min": 0.5,
    "range_gate_max": 1.5,
    "clip_lower": -8,
    "clip_upper": 8,
    "universe_size": 15
  },
  "validation": {
