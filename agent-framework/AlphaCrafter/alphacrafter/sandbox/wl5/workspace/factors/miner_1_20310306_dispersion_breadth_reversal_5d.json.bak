{
  "factor_id": "miner_1_20310306_dispersion_breadth_reversal_5d",
  "factor_name": "Dispersion-scaled breadth-balanced residual reversal",
  "version": "1.0",
  "calculation": {
    "expression": "[-sum_5(residual_log_return)] / std_60(residual_log_return) * clip(mean_5(cross_sectional_dispersion)/mean_120(cross_sectional_dispersion),0.5,2.0) * clip(1.35 - 0.7*abs(positive_median_return_breadth_20 - 0.5),0.9,1.35)",
    "description": "Ranks assets by five-day residual reversal, risk-normalized by 60-day residual volatility, amplified when recent cross-sectional dispersion is elevated, and softly balanced by 20-day market breadth. All inputs use information available through the signal date."
  },
  "dependencies": ["close"],
  "parameters": {"residual_method":"subtract daily cross-sectional median log return", "reversal_window":5, "volatility_window":60, "dispersion_short_window":5, "dispersion_long_window":120, "breadth_window":20, "forward_horizon_days":5, "minimum_cross_section":8},
