{
  "factor_id": "volatility_term_reversal_10_30_5d",
  "factor_name": "10/30-day Volatility Term Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(rolling_std(pct_change(close), 10) / rolling_std(pct_change(close), 30))",
    "description": "Ranks assets higher when short-term realized volatility is lower relative to its 30-day realized volatility; signal is aligned at date t and evaluated against the next five trading-day return."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "short_window": 10,
    "long_window": 30,
    "forward_horizon": 5,
    "minimum_cross_section": 8
  },
