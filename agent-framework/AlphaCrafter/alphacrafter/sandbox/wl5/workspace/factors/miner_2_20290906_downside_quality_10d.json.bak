{
  "factor_id": "miner_2_20290906_downside_quality_10d",
  "factor_name": "Downside-Risk-Adjusted Trend Quality",
  "version": "1.0",
  "calculation": {
    "expression": "(close/close.shift(20)-1) / (sqrt(20)*rolling20(sqrt(mean(min(pct_change,0)^2)))) * (0.5 + rolling20(mean(pct_change>0)) )",
    "description": "Ranks assets by 20-day return adjusted for downside semideviation, with a consistency multiplier based on the fraction of positive sessions. Higher values forecast higher 10-trading-day forward returns. All inputs are lagged to the decision close."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "lookback_return_days": 20,
    "downside_window_days": 20,
    "forward_horizon_days": 10,
    "consistency_floor": 0.5
  },
