{
  "factor_id": "miner_1_20300321_smooth_breadth_blend",
  "factor_name": "Smooth breadth-conditioned trend/reversal blend",
  "version": "1.0",
  "calculation": {
    "expression": "((clip((breadth20-0.35)/0.30,0,1)*(ret20-cross_sectional_median(ret20)))-((1-clip((breadth20-0.35)/0.30,0,1))*(ret5-cross_sectional_median(ret5))))/rolling_std(ret1,20)",
    "description": "Blend volatility-normalized 20-day relative trend and negative 5-day relative reversal using a causal continuous market-breadth weight. Breadth is the fraction of available tradable instruments with positive 20-day return. All medians and rolling statistics are same-day observable only after the completed close used as signal input."
  },
  "dependencies": ["close", "pct_change", "rolling_std"],
  "parameters": {"trend_lookback": 20, "reversal_lookback": 5, "volatility_window": 20, "breadth_low": 0.35, "breadth_high": 0.65, "min_cross_section": 8, "universe_size": 15},
  "validation": {
    "status": "EFFECTIVE",
    "period": {"start": "2020-01-01", "end": "2030-03-20", "cutoff": "2030-03-20"},
    "metrics": {
