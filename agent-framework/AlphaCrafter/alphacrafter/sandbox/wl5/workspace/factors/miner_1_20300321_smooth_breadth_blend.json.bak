      "max_abs_library_correlation": null
    },
    "decay": {"5d_ic": 0.0126634389, "10d_ic": 0.0174390701, "20d_ic": 0.0329111332},
    "regime_notes": "20-day results: 2025-2026 IC 0.0817513, ICIR 0.291324 (104 observations); 2027-2028 IC 0.0235158, ICIR 0.076849 (521); 2029-03-20 IC 0.0322922, ICIR 0.101287 (298). Smooth gating removes the abrupt 50% switch and remains positive in the recent regime.",
    "signal_artifact": "scripts/miner_1_20300321_smooth_breadth_blend_signal.csv"
