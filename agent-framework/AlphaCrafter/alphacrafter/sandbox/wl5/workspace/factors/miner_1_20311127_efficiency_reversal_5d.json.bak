{
  "factor_id": "miner_1_20311127_efficiency_reversal_5d",
  "factor_name": "Volatility-normalized path-efficiency reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(sum(log_return_1d,20) / sum(abs(log_return_1d),20)) / (std(log_return_1d,20)*sqrt(20))",
    "description": "Ranks assets positively when their recent net move is a smooth decline rather than a choppy path, normalized by 20-day volatility; higher values predict five-day recovery. All inputs are lagged through the signal date."
  },
  "dependencies": ["close"],
  "parameters": {"lookback_days": 20, "forward_horizon_days": 5, "minimum_cross_section": 8},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2031-11-26",
    "validated_at": "2031-11-27T00:00:00Z",
