{
  "factor_id": "miner_3_20290531_downside_residual_reversal_5d",
  "factor_name": "Trend-gated volatility-normalized cross-sectional downside residual reversal",
  "version": "20290531",
  "calculation": {
    "expression": "rolling_mean_3(-((downside_sum_5_i - cross_sectional_mean(downside_sum_5))/(downside_rms_20_i*sqrt(5))) * trend_gate_i)",
    "description": "Compute each asset's sum of negative daily returns over five days, subtract the contemporaneous cross-sectional mean, reverse the idiosyncratic downside shock, and normalize by trailing downside RMS. If the reversal agrees with the trailing 60-day trend, dampen it to 40 percent. Smooth causally over three observations and clip to [-5,5]."
  },
  "dependencies": ["close", "daily_return"],
  "parameters": {
    "downside_window": 5,
    "downside_rms_window": 20,
    "trend_window": 60,
    "trend_min_periods": 40,
    "aligned_trend_multiplier": 0.4,
    "smoothing_window": 3,
    "clip": 5,
    "forward_horizon_days": 5,
    "minimum_cross_section": 8
  },
