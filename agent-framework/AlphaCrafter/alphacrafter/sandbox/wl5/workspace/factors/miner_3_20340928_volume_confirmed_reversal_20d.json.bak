{
  "factor_id": "miner_3_20340928_volume_confirmed_reversal_20d",
  "factor_name": "Volume-confirmed 20-day reversal",
  "version": "1.0",
  "calculation": {
    "expression": "clip(-(close/shift(close,20)-1) * (mean(volume,20)/mean(volume,60))^0.35, -8, 8)",
    "description": "Scores recent 20-day losers positively for reversal, with the reversal magnitude amplified when recent average volume is elevated relative to its 60-day baseline. All inputs use completed daily observations available at the signal date."
  },
  "dependencies": ["close", "volume"],
  "parameters": {
    "return_window_days": 20,
    "volume_short_window_days": 20,
    "volume_long_window_days": 60,
    "volume_exponent": 0.35,
    "clip": [-8, 8],
    "forward_horizon_days": 10
  },
  "validation": {
