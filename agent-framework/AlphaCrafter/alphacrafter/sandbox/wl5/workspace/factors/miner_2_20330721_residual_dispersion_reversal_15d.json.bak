{
  "factor_id": "miner_2_20330721_residual_dispersion_reversal_15d",
  "factor_name": "Dispersion-Amplified Idiosyncratic Residual Reversal 15D",
  "version": "1.0",
  "calculation": {
    "expression": "-(rolling_sum(residual_return,8)/(rolling_std(residual_return,45)*sqrt(8)))*(1+0.35*I[market_dispersion>rolling_quantile(market_dispersion,126,0.70)])",
    "description": "For each tradable asset, remove its 60-day rolling beta exposure to the equal-weight cross-asset daily return. Reverse the normalized eight-day idiosyncratic residual shock over a 15-trading-day forward horizon, with a modest amplification when cross-asset daily dispersion is above its causal 126-day 70th percentile. All inputs are lagged or rolling-causal."
  },
  "dependencies": [
    "close",
    "daily_returns",
    "cross_asset_equal_weight_return"
  ],
  "parameters": {
    "beta_window": 60,
    "beta_min_periods": 45,
    "shock_window": 8,
    "residual_vol_window": 45,
    "residual_vol_min_periods": 30,
    "dispersion_quantile_window": 126,
    "dispersion_quantile": 0.7,
    "dispersion_gate_multiplier": 0.35,
    "forward_horizon_days": 15,
    "minimum_cross_section": 8
  },
