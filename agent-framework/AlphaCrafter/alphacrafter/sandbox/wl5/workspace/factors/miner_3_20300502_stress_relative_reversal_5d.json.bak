{
  "factor_id": "miner_3_20300502_stress_relative_reversal_5d",
  "factor_name": "VIX-stress amplified relative short-term reversal",
  "version": "1.0",
  "calculation": {
    "expression": "clip(VIX / rolling_median(VIX,120),0.7,1.8) * ((-return_5d - cross_sectional_median(-return_5d)) / annualized_volatility_20d), then cross_sectional_demean",
    "description": "Ranks assets favoring recent underperformers relative to the daily cross-sectional median, risk-normalized and amplified when observation-only VIX is elevated versus its causal 120-day median. All inputs use data available at the signal date."
  },
  "dependencies": ["close", "VIX"],
  "parameters": {"reversal_window_days": 5, "volatility_window_days": 20, "stress_window_days": 120, "stress_clip": [0.7, 1.8], "forward_horizon_days": 5, "min_cross_section": 8},
  "validation": {
