{
  "factor_id": "miner_2_20350426_dispersion_transition_reversal_10d",
  "factor_name": "Dispersion-transition conditioned residual reversal",
  "version": "1.0",
  "calculation": {
    "expression": "clip(-cross_sectional_residual_return_10d/(rolling_residual_volatility_40d*sqrt(10)+epsilon),-8,8) * clip(1+0.40*tanh(mean_3(zscore_60(cross_sectional_dispersion)-zscore_60(cross_sectional_dispersion).shift(5))),0.60,1.40)",
    "description": "Cross-sectional 10-day residual-return reversal normalized by 40-day residual volatility, multiplied by a bounded causal transition multiplier based on the recent change in standardized cross-asset return dispersion. All rolling inputs use data through the prior completed session."
  },
  "dependencies": ["close", "daily_returns", "tradable_watchlist"],
  "parameters": {
    "residual_window_sessions": 10,
    "residual_volatility_window_sessions": 40,
    "dispersion_definition": "cross-sectional standard deviation of daily residual returns across the 15 tradable instruments",
    "dispersion_zscore_window_sessions": 60,
    "transition_lag_sessions": 5,
    "transition_smoothing_sessions": 3,
    "forward_horizon_sessions": 10,
    "multiplier_scale": 0.40,
    "multiplier_clip": [0.60, 1.40],
    "minimum_cross_section": 8
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2023-10-20 through 2035-04-11",
    "last_validated": "2035-04-26",
    "metrics": {
      "daily_paper_ic": 0.037632,
      "daily_paper_icir": 0.123899,
      "ic_hit_ratio": 0.548361,
      "valid_dates": 2440,
      "mean_instruments": 14.757,
      "factor_coverage": 0.98377,
      "rank_turnover": 0.11295,
      "decay_ic_5d": 0.035421,
      "decay_ic_10d": 0.037632,
      "decay_ic_20d": 0.048391,
      "regime_ic_2023_2025": -0.001861,
      "regime_ic_2026_2030": 0.030751,
      "regime_ic_2031_2035": 0.050676,
      "max_abs_library_correlation": null
    },
    "gates": {
      "absolute_daily_paper_ic_threshold": 0.007,
      "absolute_daily_paper_icir_threshold": 0.084,
      "passed": true
    },
    "regime_notes": "Weak and slightly negative early regime; predictive strength is positive in 2026-2030 and strongest in 2031-2035. Interpret small 15-name cross-sectional ICs conservatively.",
    "minimum_cross_section": 8
  },
  "provenance": {
