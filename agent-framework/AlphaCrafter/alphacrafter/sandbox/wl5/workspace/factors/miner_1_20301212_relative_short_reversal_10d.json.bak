{
  "factor_id": "miner_1_20301212_relative_short_reversal_10d",
  "factor_name": "Cross-Asset Relative Short Reversal Risk Normalized",
  "version": "1.0",
  "calculation": {
    "expression": "-(rolling_sum(pct_change(close),15) - cross_sectional_mean(rolling_sum(pct_change(close),15))) / rolling_std(pct_change(close),45)",
    "description": "Ranks assets contrarily to their recent 15-day return after removing the contemporaneous cross-asset average move and normalizing by 45-day realized volatility. All inputs are lagged to the completed decision-day close. Higher values indicate stronger relative reversal potential."
  },
  "dependencies": ["close"],
  "parameters": {"return_window_days": 15, "volatility_window_days": 45, "forward_horizon_days": 10, "min_valid_observations": 8, "universe_size": 15},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2030-12-11",
    "as_of": "2030-12-11",
    "metrics": {
      "ic": 0.027815644266421708,
      "icir": 0.09510653622492264,
      "hit_ratio": 0.554089709762533,
      "dates": 1137,
      "mean_instruments": 11.941072999120492,
      "coverage": 0.7960715332746996,
      "rank_turnover": 0.0704031213471077,
      "max_abs_library_correlation": null,
      "decay_ic_5d": 0.012340625484502077,
      "decay_ic_20d": 0.03020016951995499
    },
    "regime_notes": "Positive aggregate IC and ICIR across the full 2020-2030 cross-asset sample; uncertainty remains material because the cross-section is only 15 assets and usable dates average about 11.94 assets.",
