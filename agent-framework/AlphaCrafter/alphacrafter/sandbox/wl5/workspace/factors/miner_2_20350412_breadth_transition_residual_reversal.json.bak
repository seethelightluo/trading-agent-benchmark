{
  "factor_id": "miner_2_20350412_breadth_transition_residual_reversal",
  "factor_name": "Breadth-transition residual reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-residual_return_10d * (1 + 0.5 * clipped(abs(breadth_20d - breadth_60d), 0, 1))",
    "description": "Cross-sectional residual reversal over a 10-session return window, amplified when the transition in market breadth between 20-session and 60-session horizons is large. Breadth is computed causally from the available tradable universe; all rolling statistics are shifted so the signal uses only completed sessions."
  },
  "dependencies": ["close", "pct_change", "tradable_watchlist"],
  "parameters": {
    "residual_window_sessions": 10,
    "breadth_fast_window_sessions": 20,
    "breadth_slow_window_sessions": 60,
    "forward_horizon_sessions": 10,
    "amplification": 0.5,
    "clip_bounds": [0, 1],
    "minimum_cross_section": 8
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2023-10-19 through 2035-03-28",
