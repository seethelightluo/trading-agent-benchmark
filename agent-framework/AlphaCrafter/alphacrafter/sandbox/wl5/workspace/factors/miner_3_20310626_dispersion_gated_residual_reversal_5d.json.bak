{
  "factor_id": "miner_3_20310626_dispersion_gated_residual_reversal_5d",
  "factor_name": "High-dispersion-gated beta-residual reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-sum(log_return_1d,last_5d - beta_60d*cross_sectional_mean_return_1d,last_5d)/(sqrt(5)*volatility_60d) * (1 + 0.45*max(clip(dispersion_today/median(dispersion_last_60d)-1,-0.5,1),0))",
    "description": "Ranks assets for five-day reversal after removing 60-day market beta exposure and normalizing by 60-day volatility. The reversal magnitude receives a modest amplification when same-day cross-sectional return dispersion is above its trailing 60-day median. All inputs are available by the signal date."
  },
  "dependencies": ["close"],
  "parameters": {"residual_window": 5, "beta_window": 60, "volatility_window": 60, "dispersion_window": 60, "amplification": 0.45, "forward_horizon_days": 5, "minimum_cross_section": 8},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2031-06-25",
    "metrics": {
      "ic": 0.030081,
      "icir": 0.095941,
      "forward_horizon_days": 5,
      "dates": 2222,
      "mean_instruments": 14.66,
      "coverage": 0.97726,
      "turnover": 0.150705,
      "hit_ratio": 0.53015,
      "max_abs_library_correlation": null
    },
    "regime_notes": "Positive across 2020-2024 (+0.036550), 2025-2027 (+0.040183), 2028-2029 (+0.027916), and 2030-06-25 (+0.003434), but materially weakened in the latest regime. The 10-day decay result was IC +0.017843 and ICIR +0.058107, below the admission ICIR gate.",
    "signal_artifact": "scripts/miner_3_20310626_dispersion_gated_residual_reversal_5d_signal.csv"
  },
