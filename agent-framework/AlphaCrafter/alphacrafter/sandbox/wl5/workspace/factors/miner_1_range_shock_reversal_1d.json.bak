{
  "factor_id": "miner_1_range_shock_reversal_1d",
  "factor_name": "Range-Shock Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(r_1d * ((high - low) / close[-1])) / median_20((high - low) / close[-1])",
    "description": "Ranks assets positively when a completed-day return reverses an unusually large intraday range; the signal is calculated using only data available through the completed date. Negative return on a large-range shock produces a positive reversal score."
  },
  "dependencies": [
    "close",
    "high",
    "low"
  ],
  "parameters": {
    "range_window": 20,
    "range_min_periods": 10,
    "forward_horizon_for_admission": 1,
    "minimum_cross_section": 8
  },
  "validation": {
