{
  "factor_id": "miner_2_20351206_dispersion_conditioned_residual_reversal_10d",
  "factor_name": "Dispersion-Conditioned Volatility-Scaled Residual Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(r15_i - mean_cross_section(r15))/(rolling_std_30_daily_return_i*sqrt(20)) * clip(0.70 + 0.90*percentile_rank_252(mean_i(rolling_std_20_daily_return_i)), 0.70, 1.60)",
    "description": "Ranks assets by negative 15-trading-day cross-sectional residual return, volatility scaled. The reversal signal is smoothly amplified when average cross-asset return dispersion is elevated, using a causal 252-day percentile rank and clipped multiplier. All inputs are lagged or rolling and use only information available at the decision date."
  },
  "dependencies": ["close", "pct_change"],
  "parameters": {
    "residual_lookback_days": 15,
    "volatility_lookback_days": 30,
    "dispersion_lookback_days": 20,
    "dispersion_percentile_window_days": 252,
    "minimum_dispersion_history": 80,
    "multiplier_floor": 0.70,
    "multiplier_slope": 0.90,
    "multiplier_cap": 1.60,
    "forward_horizon_days": 10
  },
  "validation": {
    "status": "EFFECTIVE",
    "timestamp": "2035-12-06T00:00:00Z",
    "period": "2023-11-08 through 2035-12-05",
    "regime_notes": "2023-2025 was negative, while 2026-2035 was strongly positive; interpret regime dependence conservatively. The available API window covered 2023 onward despite the benchmark warm-up beginning in 2020.",
    "metrics": {
      "ic": 0.037990,
      "icir": 0.131403,
      "ic_hit_ratio": 0.547549,
      "valid_dates": 2734,
      "mean_instruments": 14.695,
      "factor_coverage": 0.979688,
      "rank_turnover": 0.097128,
      "decay_ic_5d": 0.024337,
      "decay_ic_20d": 0.037474,
      "max_abs_library_correlation": null
    }
  },
  "signal_artifact": "scripts/miner_2_20351206_dispersion_reversal_signal.csv",
  "tags": ["reversal", "cross_asset", "dispersion", "volatility_scaled", "10d"]
}
