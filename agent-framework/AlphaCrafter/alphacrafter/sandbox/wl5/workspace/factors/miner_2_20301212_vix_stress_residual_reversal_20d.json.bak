{
  "factor_id": "miner_2_20301212_vix_stress_residual_reversal_20d",
  "factor_name": "VIX-Stress-Conditioned Cross-Asset Residual Reversal 20-Day",
  "version": "1.0",
  "calculation": {
    "expression": "-(r20_i - beta60_i*mean_j(r20_j)) / std60(residual_i) * (0.5 + percentile_rank252(VIX))",
    "description": "Cross-asset 20-trading-day residual reversal, normalized by trailing residual volatility and scaled higher when the observation-only VIX macro signal is elevated. Beta and volatility are causal rolling estimates; the VIX percentile is shifted one session and the emitted signal is lagged one session before forward-return testing."
  },
  "dependencies": ["close", "VIX", "tradable_universe_prices"],
  "parameters": {"return_window": 20, "beta_window": 60, "volatility_window": 60, "vix_rank_window": 252, "forward_horizon": 10, "minimum_cross_section": 8, "tradable_assets": 15},
  "validation": {
    "status": "EFFECTIVE",
    "period": {"start": "2026-10-19", "end": "2030-11-27"},
    "metrics": {
      "ic": 0.0386732538,
      "icir": 0.1349956802,
      "horizon_days": 10,
      "valid_dates": 1073,
      "mean_instruments": 12.9403541,
      "coverage": 0.8626903,
      "hit_ratio": 0.5675676,
      "turnover": null,
      "decay_ic_5d": 0.0296667621,
      "decay_ic_20d": 0.0541454716,
      "max_abs_library_correlation": null
    },
    "thresholds": {"minimum_absolute_daily_paper_ic": 0.007, "minimum_absolute_daily_paper_icir": 0.084},
    "regime_notes": "Validated across 1,073 dates and approximately 13 of 15 instruments per date from the available post-warmup aligned history; uncertainty is interpreted conservatively for the small cross-section."
  },
  "signal_artifact": "scripts/miner_2_20301212_vix_stress_residual_reversal_signal.csv",
  "source_cutoff": "2030-12-11",
  "last_validated": "2030-12-12T00:00:00Z",
  "tags": ["reversal", "residual", "volatility", "macro-conditioned", "cross-asset"]
}
