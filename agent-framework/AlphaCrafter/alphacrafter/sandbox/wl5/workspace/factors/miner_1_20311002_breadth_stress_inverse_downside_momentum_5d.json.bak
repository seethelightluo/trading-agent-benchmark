{
  "factor_id": "miner_1_20311002_breadth_stress_inverse_downside_momentum_5d",
  "factor_name": "Breadth-stress-gated inverse downside-volatility momentum",
  "version": "1.1",
  "calculation": {
    "expression": "clip(-(sum(log(close/close_lag1),20))/std(negative_daily_log_returns,40),-10,10) * (1 + 0.75*clip((0.5 - mean_assets(20d_return>0))/0.5,0,1))",
    "description": "Contrarian 20-day momentum scaled by trailing downside volatility, amplified when fewer than half of the tradable cross-asset universe has positive 20-day returns. All inputs are causal through the signal date. Higher values indicate stronger expected five-trading-day forward return."
  },
  "dependencies": ["close"],
  "parameters": {
    "momentum_window": 20,
    "downside_volatility_window": 40,
    "breadth_window": 20,
    "stress_threshold": 0.5,
    "stress_amplification": 0.75,
    "clip_lower": -10,
    "clip_upper": 10,
    "forward_horizon_days": 5
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2031-09-17",
