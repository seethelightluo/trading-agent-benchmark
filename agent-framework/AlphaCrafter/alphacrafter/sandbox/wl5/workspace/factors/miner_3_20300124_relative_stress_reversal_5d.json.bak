{
  "factor_id": "miner_3_20300124_relative_stress_reversal_5d",
  "factor_name": "Cross-sectional stress-gated 5-day relative reversal",
  "version": "20300124",
  "calculation": {
    "expression": "-(return_5d - cross_sectional_median(return_5d)) / annualized_volatility_20d * (1 + 0.5 * clip(2*abs(breadth_5d-0.5), 0, 1))",
    "description": "Ranks assets for reversal of their five-day return relative to the cross-sectional median, risk-normalized by trailing 20-day volatility and amplified during broad cross-sectional stress. All values use completed data through the signal date."
  },
  "dependencies": ["close", "daily_return"],
  "parameters": {
    "relative_return_window": 5,
    "cross_section_center": "median",
    "volatility_window": 20,
    "breadth_window": 5,
    "stress_multiplier": 0.5,
    "minimum_cross_section": 8,
    "forward_horizon_days": 5
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2030-01-09",
    "last_validated": "2030-01-24T00:00:00Z",
