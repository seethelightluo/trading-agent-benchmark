{
  "factor_id": "miner_3_20330428_voltransition_reversal_40d",
  "factor_name": "Volatility-Transition Gated Downside Reversal 40D",
  "version": "1.0",
  "calculation": {
    "expression": "rank_pct((-sum(log_return,80)) / downside_volatility(log_return,90) * (1 + 0.55*clip(recent_cross_asset_vol_10 / cross_asset_vol_60 - 1,0,1.5)/1.5 + 0.35*clip((0.5-breadth_20)*2,0,1) + 0.35*clip(zscore(VIX_vs_60d_history),0,2)/2)",
    "description": "Cross-sectional downside-risk-adjusted 80-day reversal, amplified after a recent cross-asset volatility transition, weak 20-day breadth, and elevated VIX. All inputs use data available through the prior completed day; cross-sectional percentile ranking is applied across the 15 tradable instruments."
  },
  "dependencies": [
    "close",
    "VIX",
    "daily_log_returns"
  ],
  "parameters": {
    "reversal_window_days": 80,
    "downside_volatility_window_days": 90,
    "recent_cross_asset_vol_window_days": 10,
    "baseline_cross_asset_vol_window_days": 60,
    "breadth_window_days": 20,
    "vix_history_window_days": 60,
    "volatility_transition_weight": 0.55,
    "breadth_weakness_weight": 0.35,
    "vix_elevation_weight": 0.35,
    "forward_validation_horizon_days": 40,
    "universe_size": 15
  },
