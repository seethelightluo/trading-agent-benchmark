{
  "factor_id": "miner_1_20330317_breadth_vix_conditioned_downside_reversal_10d",
  "factor_name": "Breadth/VIX-Conditioned Downside-Volatility Reversal (10d)",
  "version": "1.0",
  "calculation": {
    "expression": "rank((-sum(log_return,120) / downside_std(log_return,90)) * (1 + 0.60*stress_breadth + 0.50*vix_stress), cross_section)",
    "description": "Ranks 120-day reversal normalized by 90-day downside volatility. The reversal is amplified when 20-day cross-asset breadth is weak and when lagged VIX is elevated relative to its trailing 60-day history. All inputs are lagged to the decision date."
  },
  "dependencies": ["close", "VIX", "cross_asset_returns"],
  "parameters": {
    "reversal_window": 120,
    "downside_vol_window": 90,
    "breadth_window": 20,
    "vix_window": 60,
    "forward_horizon_days": 10,
    "breadth_amplifier": 0.60,
    "vix_amplifier": 0.50,
    "minimum_cross_section": 8
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2033-03-16",
    "metrics": {
      "ic": 0.046717,
      "icir": 0.139207,
      "hit_ratio": 0.55876,
      "coverage": 0.97507,
      "mean_instruments": 14.63,
      "usable_dates": 2672,
      "turnover": 0.036092,
      "decay_horizon_days": 10,
      "max_abs_library_correlation": null
    },
    "regime_notes": "Negative in 2020-2024 (-0.028386 IC), positive thereafter: 2025-2027 (+0.065525), 2028-2029 (+0.083617), and 2030-03-16 (+0.073880). Interpret regime dependence conservatively.",
    "signal_artifact": "scripts/miner_1_20330317_breadth_vix_reversal_10d_signal.csv"
  },
  "tags": ["reversal", "downside-volatility", "breadth", "VIX", "defensive", "cross-asset"],
