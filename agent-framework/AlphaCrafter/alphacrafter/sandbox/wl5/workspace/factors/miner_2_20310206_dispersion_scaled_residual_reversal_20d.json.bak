{
  "factor_id": "miner_2_20310206_dispersion_scaled_residual_reversal_20d",
  "factor_name": "Dispersion-Scaled Residual Reversal 5-Day",
  "version": "1.0",
  "calculation": {
    "expression": "shift_1(-rolling_sum_5(asset_return - cross_sectional_mean_return) * clip(cross_sectional_mean(rolling_std_20(asset_return)) / rolling_median_120(cross_sectional_mean(rolling_std_20(asset_return))), 0.5, 2.0))",
    "description": "Ranks assets by causal five-day reversal of market-relative returns, scaled upward when cross-asset volatility dispersion is elevated relative to its trailing 120-day median. Signal is shifted one day before forward-return evaluation."
  },
  "dependencies": ["close"],
  "parameters": {"reversal_window": 5, "dispersion_window": 20, "dispersion_baseline_window": 120, "scale_floor": 0.5, "scale_cap": 2.0, "signal_lag": 1, "admission_horizon_days": 20},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2026-07-28 through 2031-02-05",
    "timestamp": "2031-02-06T00:00:00Z",
    "regime_notes": "Positive in reported 2025-2027, 2028-2029, and 2030-cutoff subperiods; conservative interpretation warranted because the cross-section is 15 instruments.",
    "metrics": {
      "ic": 0.03614077,
      "icir": 0.11975605,
      "horizon_days": 20,
      "valid_dates": 1168,
      "mean_instruments": 15.0,
      "coverage": 1.0,
      "rank_turnover": 0.144158,
      "hit_ratio": 0.55137,
      "decay": {"5d_ic": 0.02027187, "10d_ic": 0.02400626, "20d_ic": 0.03614077},
      "max_abs_library_correlation": null
    }
  },
  "signal_artifact": "scripts/miner_2_20310206_dispersion_scaled_residual_reversal_signal.csv",
  "tags": ["reversal", "residual", "dispersion", "cross_asset", "volatility_conditioned"]
}
