{
  "factor_id": "miner_1_20290322_dispersion_reversal_5d",
  "factor_name": "Dispersion-conditioned volatility-normalized short reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-return(close,5)/(std(pct_change(close),20)*sqrt(5)) * clip(1 + 0.5*zscore(rolling_mean(cross_sectional_std(pct_change(close)),20),60),0.25,2.0)",
    "description": "Fade each instrument's trailing five-day return, normalize by its 20-day volatility, and increase reversal exposure when the 20-day average cross-asset return dispersion is elevated relative to its trailing 60-day history. All inputs are lagged to the completed observation date."
  },
  "dependencies": [
    "close",
    "daily returns",
    "cross-sectional dispersion"
  ],
  "parameters": {
    "reversal_window": 5,
    "volatility_window": 20,
    "dispersion_window": 20,
    "dispersion_z_window": 60,
    "stress_slope": 0.5,
    "multiplier_floor": 0.25,
    "multiplier_cap": 2.0
  },
