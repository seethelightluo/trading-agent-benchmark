{
  "factor_id": "miner_1_20271216_medium_trend_reversal",
  "factor_name": "Volatility-normalized 60-day medium-trend reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(close/close.shift(60)-1) / max(rolling_std(pct_change(close),40)*sqrt(252),0.002)",
    "description": "Reverse the cross-sectional rank of the 60-session return normalized by trailing 40-session annualized volatility. The negative sign is admission direction because the raw medium-term trend has negative 10-session forward rank IC."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "return_lookback_days": 60,
    "volatility_window_days": 40,
    "volatility_min_periods": 25,
    "annualization": 252,
    "volatility_floor": 0.002,
    "admission_horizon_days": 10,
    "minimum_cross_section": 8,
    "universe_size": 15
  },
