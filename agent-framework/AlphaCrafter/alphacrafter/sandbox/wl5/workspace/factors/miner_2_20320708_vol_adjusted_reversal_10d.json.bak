{
  "factor_id": "miner_2_20320708_vol_adjusted_reversal_10d",
  "factor_name": "10-day volatility-adjusted reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(close / close.shift(10) - 1) / (rolling_std(pct_change(close), 20) * sqrt(252) + 1e-8), cross-sectionally clipped at 5th/95th percentiles",
    "description": "Fades the prior 10-session return and normalizes by trailing 20-session annualized return volatility. All inputs are lagged or trailing and therefore causal."
  },
  "dependencies": ["close"],
  "parameters": {"lookback_return_days": 10, "volatility_window_days": 20, "volatility_min_periods": 15, "winsorization": [0.05, 0.95], "forward_horizon_days": 10, "minimum_cross_section": 8},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2032-07-07",
    "metrics": {
      "ic": 0.03523835,
      "icir": 0.11116500,
      "ic_horizon_days": 10,
      "hit_ratio": 0.536941,
      "turnover": 0.09536261,
      "coverage_pct": 95.3174,
      "valid_dates": 1922,
      "mean_instruments": 14.2976,
      "max_abs_library_correlation": null
    },
    "regime_notes": "Negative in 2020-2024, positive in 2025-2027, weak positive in 2028-2029, and strongly positive in 2030-2032. Small cross-section warrants conservative interpretation.",
    "signal_artifact": "scripts/miner_2_20320708_vol_adjusted_reversal_10d_signal.csv"
  },
