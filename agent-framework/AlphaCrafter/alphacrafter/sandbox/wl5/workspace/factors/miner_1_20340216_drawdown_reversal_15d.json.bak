{
  "factor_id": "miner_1_20340216_drawdown_reversal_15d",
  "factor_name": "15-day Drawdown-Amplified Cross-Sectional Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(R_15 - cross_sectional_median(R_15)) * (1 + 0.8 * clip(-drawdown_60, 0, 0.5))",
    "description": "Ranks relatively oversold instruments positively, with a bounded amplification for instruments below their trailing 60-day high. Signal uses only prices through the signal date."
  },
  "dependencies": ["close"],
  "parameters": {"return_window_days": 15, "drawdown_window_days": 60, "amplification": 0.8, "drawdown_cap": 0.5, "forward_horizon_days": 10},
