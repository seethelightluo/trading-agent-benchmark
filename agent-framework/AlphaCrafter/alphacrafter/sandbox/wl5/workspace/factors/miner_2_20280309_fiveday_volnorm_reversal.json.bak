{
  "factor_id": "miner_2_20280309_fiveday_volnorm_reversal",
  "factor_name": "Five-session volatility-normalized reversal",
  "version": "2028-03-09",
  "calculation": {
    "expression": "-(close/close.shift(5)-1)/(rolling_std(pct_change(close),20)*sqrt(5)) - cross_sectional_median(...)",
    "description": "Ranks assets higher after an unusually negative five-session return relative to their recent 20-session volatility, centered against the daily cross-asset median."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "lookback_return": 5,
    "volatility_window": 20,
    "volatility_min_periods": 15,
    "forward_horizon": 10,
    "minimum_cross_section": 8
  },
