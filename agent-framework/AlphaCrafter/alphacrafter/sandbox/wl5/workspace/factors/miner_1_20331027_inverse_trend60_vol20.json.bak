{
  "factor_id": "miner_1_20331027_inverse_trend60_vol20",
  "factor_name": "Inverse 60-day trend scaled by 20-day volatility",
  "version": "1.0",
  "calculation": {
    "expression": "-rolling_sum(pct_change(close),60) / rolling_std(pct_change(close),20)",
    "description": "Ranks instruments higher when their prior 60-session return is more negative after scaling by recent 20-session volatility; a medium-horizon contrarian signal. Forward validation uses the next 10-session cumulative return.",
