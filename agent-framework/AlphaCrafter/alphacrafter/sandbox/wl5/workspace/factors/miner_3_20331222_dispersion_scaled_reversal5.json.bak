{
  "factor_id": "miner_3_20331222_dispersion_scaled_reversal5",
  "factor_name": "Dispersion-scaled short-term reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-clip((close/shift(close,5)-1)/(rolling_std(pct_change(close),20)*sqrt(252)),-5,5) * clip(cross_asset_mean_20d_volatility / rolling_median(cross_asset_mean_20d_volatility,252),0.5,1.5)",
    "description": "Ranks assets by inverse five-day risk-adjusted return. The reversal signal is strengthened when cross-asset realized volatility dispersion is high and bounded to avoid unstable extremes. All inputs are lagged or rolling causal observations."
  },
  "dependencies": [
    "close",
    "pct_change",
    "15_asset_cross_section"
  ],
  "parameters": {
    "return_lookback_days": 5,
    "volatility_lookback_days": 20,
    "annualization": 252,
    "dispersion_lookback_days": 20,
    "dispersion_baseline_days": 252,
    "dispersion_multiplier_bounds": [
      0.5,
      1.5
    ],
    "minimum_cross_section": 8
  },
