{
  "factor_id": "miner_3_20350315_true_range_reversal_20d",
  "factor_name": "True-range shock weighted idiosyncratic reversal",
  "version": "1.0",
  "calculation": {
    "expression": "clip(-sum_10(cross_sectional_return)/((std_40(cross_sectional_return)*sqrt(10))+eps),-8,8) * clip(1+0.35*tanh((log1p(true_range/close)-rolling_mean_40)/rolling_std_40),0.65,1.35)",
    "description": "A causal 10-day cross-sectional residual reversal normalized by 40-day residual volatility, amplified after an abnormal true-range shock. True range is max(high-low, abs(high-previous close), abs(low-previous close)); the range shock is trailing standardized log1p(true_range/close)."
  },
  "dependencies": ["close", "high", "low"],
  "parameters": {
    "reversal_window_days": 10,
    "volatility_window_days": 40,
    "range_shock_window_days": 40,
    "range_multiplier": 0.35,
    "base_clip": [-8, 8],
    "multiplier_clip": [0.65, 1.35],
    "minimum_cross_section": 8
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2023-09-14 through 2035-02-14",
    "metrics": {
      "ic": 0.055826,
      "icir": 0.178948,
      "horizon_days": 20,
