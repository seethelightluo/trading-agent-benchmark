  "factor_name": "Risk-normalized medium trend with short-trend confirmation",
  "version": "1.0",
  "calculation": {
    "expression": "(close/close.shift(60)-1)/(std(pct_change(close),60)*sqrt(252)) * (1 + 0.5*sign(close/close.shift(60)-1)*sign(close/close.shift(20)-1))",
    "description": "Ranks 60-day return per annualized 60-day volatility; increases magnitude when 20-day and 60-day trends agree. The empirically admitted direction is inverse (negative forward-return IC)."
  },
  "dependencies": ["close"],
  "parameters": {"momentum_window": 60, "confirmation_window": 20, "volatility_window": 60, "annualization": 252, "confirmation_multiplier": 0.5, "direction": -1},
