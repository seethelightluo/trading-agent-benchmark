{
  "factor_id": "miner_2_20290503_breadth_confirmed_trend_5d",
  "factor_name": "Breadth-confirmed volatility-normalized medium trend",
  "version": "20290503",
  "calculation": {
    "expression": "rolling_mean_3((close/close.shift(60)-1)/(std(pct_change(close),20)*sqrt(252)) * (2*(mean_i(rolling_sum_20(return_i)>0)-0.5)))",
    "description": "Ranks a 60-day trend normalized by 20-day annualized volatility, multiplied by a causal cross-asset breadth gate and smoothed over three observations. Breadth is the fraction of the 15 tradable instruments with positive 20-day return; the centered gate ranges from -1 to 1. Uses only data available through the signal date."
  },
  "dependencies": [
    "close",
    "daily_return"
  ],
  "parameters": {
    "trend_window": 60,
    "vol_window": 20,
    "breadth_window": 20,
    "smoothing_window": 3,
    "forward_horizon_days": 5,
    "minimum_cross_section": 8
  },
