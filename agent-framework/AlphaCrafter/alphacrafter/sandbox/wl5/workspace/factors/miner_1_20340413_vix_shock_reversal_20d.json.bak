{
  "factor_id": "miner_1_20340413_vix_shock_reversal_20d",
  "factor_name": "VIX-shock-conditioned trend reversal",
  "version": "1.0",
  "calculation": {
    "expression": "(2*I(VIX_z60 > 1)-1) * rolling_sum(return,20) / (rolling_std(return,40)*sqrt(20))",
    "description": "Use observation-only VIX to condition the direction of a volatility-normalized 20-day cross-asset trend signal: reverse the trend in normal VIX conditions and follow it after an unusually elevated VIX shock. VIX z-score uses only trailing 60 observations and is lag-safe."
  },
  "dependencies": ["close", "VIX"],
  "parameters": {"trend_window": 20, "vol_window": 40, "vix_window": 60, "shock_threshold": 1.0, "forward_horizon_days": 10, "minimum_cross_section": 8},
  "validation": {
