{
  "factor_id": "miner_3_20350510_dispersion_acceleration_reversal_10d",
  "factor_name": "Dispersion acceleration conditioned residual reversal",
  "version": "1.0",
  "calculation": {
    "expression": "clip(base_residual_reversal_10d * (1 + 0.20*clip(dispersion_z_20d, -1.5, 1.5) + 0.15*clip(dispersion_z_20d - lag5(dispersion_z_20d), -1, 1)), -8, 8)",
    "description": "Cross-sectional residual reversal, normalized by 40-session residual volatility, modulated by the current standardized 20-session cross-asset dispersion level and its causal five-session acceleration. All state inputs are lagged or computed from completed observations only. Positive values indicate expected relative forward performance."
  },
  "dependencies": ["close", "daily_returns"],
  "parameters": {
    "universe_size": 15,
    "residual_window": 10,
    "residual_volatility_window": 40,
    "dispersion_window": 20,
    "dispersion_z_window": 60,
    "dispersion_change_lag": 5,
    "state_clip": 1.5,
    "change_clip": 1.0,
    "level_coefficient": 0.20,
    "acceleration_coefficient": 0.15,
    "minimum_cross_section": 8,
    "signal_clip": 8.0
  },
