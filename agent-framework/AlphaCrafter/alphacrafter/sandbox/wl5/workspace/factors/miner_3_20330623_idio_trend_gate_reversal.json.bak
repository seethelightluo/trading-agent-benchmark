{
  "factor_id": "miner_3_20330623_idio_trend_gate_reversal",
  "factor_name": "Idiosyncratic shock reversal with residual-trend gate",
  "version": "1.0",
  "calculation": {
    "expression": "-residual_return_sum_10d * (0.5 + 0.5 * I(abs(residual_return_sum_60d) < rolling_quantile(abs(residual_return_sum_60d),126,0.60)))",
    "description": "Estimate each asset's causal 40-day beta to the equal-weighted tradable-universe return, compute residual returns, reverse the trailing 10-day residual shock, and retain full reversal strength only when the 60-day residual trend is relatively muted; otherwise halve the signal. All rolling inputs are backward-looking."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "universe": "15 tradable benchmark instruments",
    "beta_window": 40,
    "beta_min_periods": 30,
    "shock_window": 10,
    "shock_min_periods": 8,
    "trend_window": 60,
    "trend_min_periods": 45,
    "gate_window": 126,
    "gate_min_periods": 80,
    "gate_quantile": 0.6,
    "forward_horizon_days": 10
  },
  "validation": {
