{
  "factor_id": "miner_2_20271230_medium_volscaled_reversal_20_30",
  "factor_name": "20-session volatility-scaled medium-term reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-((close / lag(close,20)) - 1) / (rolling_std(daily_returns,30) * sqrt(20)); cross_sectional_median_center",
    "description": "Favors instruments with unusually negative 20-session returns after scaling by their trailing 30-session realized volatility. The cross-sectional median is subtracted for comparable ranking. Uses only information available at the signal date."
  },
  "dependencies": [
    "close",
    "daily_returns"
  ],
  "parameters": {
    "return_lookback_sessions": 20,
    "volatility_lookback_sessions": 30,
    "volatility_min_periods": 20,
    "forward_horizon_sessions": 10,
    "minimum_cross_section_names": 8
  },
