{
  "factor_id": "miner_2_20290712_breadth_conditioned_momentum",
  "factor_name": "Breadth-conditioned momentum and panic reversal",
  "version": "1.0",
  "calculation": {
    "expression": "rank_cs(gate*ret_20d + (1-gate)*(-sum(ret_1d,5)), pct=True), gate=clip((cross_sectional_breadth(ret_20d>0)-0.35)/0.30,0,1)",
    "description": "Continuously blends 20-session momentum when the tradable universe is broadly positive with five-session reversal when breadth is weak. All inputs are lagged completed daily closes at the decision cutoff. Higher values indicate stronger expected forward return."
  },
  "dependencies": ["close"],
  "parameters": {"momentum_window": 20, "reversal_window": 5, "breadth_low": 0.35, "breadth_high": 0.65, "cross_section_rank": true, "horizon_sessions": 10},
