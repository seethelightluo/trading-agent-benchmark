  "factor_name": "High-VIX regime volatility-normalized reversal",
  "version": "2029-04-09-revalidated",
  "calculation": {
    "expression": "-lagged_return(close,10)/(sqrt(10)*lagged_rolling_std(pct_change(close),20))*I(lagged_VIX > rolling_quantile(lagged_VIX,60,0.75))",
    "description": "When lagged VIX is above its trailing 60-session 75th percentile, rank assets by negative prior 10-session return normalized by prior 20-session volatility; otherwise signal is zero. All inputs are lagged."
