{
  "factor_id": "miner_1_20350903_residual_dispersion_reversal5",
  "factor_name": "Dispersion-Gated Cross-Asset Residual Reversal 5D",
  "version": "2035-09-03",
  "calculation": {
    "expression": "(-residual_return_5d / rolling_std(log_returns,20)) * I(cross_asset_dispersion_5d > rolling_median(dispersion_5d,120))",
    "description": "For each tradable benchmark instrument, subtract the contemporaneous cross-sectional mean 5-day log return, invert the residual shock, and scale by 20-day return volatility. Activate only when five-day average cross-asset daily volatility exceeds its trailing 120-day median. All inputs are lagged completed-day observations."
  },
  "dependencies": ["close"],
  "parameters": {"residual_lookback_days": 5, "volatility_lookback_days": 20, "dispersion_window_days": 5, "dispersion_threshold_lookback_days": 120, "forward_horizon_days": 5, "minimum_cross_section": 8},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2026-07-28 through 2035-08-12 (available online data)",
    "metrics": {
      "ic": 0.09415080,
      "icir": 0.30786271,
      "ic_hit_ratio": 0.5833,
      "observations": 12,
      "average_instruments": 15.0,
      "factor_coverage": 1.0,
      "turnover": null,
      "max_abs_library_correlation": null
    },
    "regime_notes": "Five-day result passes the benchmark absolute IC and ICIR gates, but only 12 daily cross-sectional observations were available in the runtime-visible sample; uncertainty is high. Ten-day and twenty-day versions were not admitted (10D IC/ICIR -0.08194/-0.22265; 20D +0.02666/+0.08187).",
    "signal_artifact": "scripts/miner_1_20350903_residual_dispersion_reversal_signal.csv"
