{
  "factor_id": "miner_3_20300923_dispersion_reversal3",
  "factor_name": "High-dispersion volatility-normalized three-day reversal",
  "version": "1.0",
  "calculation": {
    "expression": "clip((-return_3d / realized_volatility_20d) * I[dispersion_3d > rolling_median(dispersion_3d, 90)], -5, 5), lagged_by_1_session",
    "description": "For each tradable benchmark asset, take the negative three-session return normalized by 20-session daily-return volatility, activate it only when cross-asset three-session return dispersion is above its trailing 90-date median, clip extremes, and lag one completed session to avoid look-ahead. Positive values indicate expected short-horizon rebound."
  },
  "dependencies": ["close"],
  "parameters": {"return_window": 3, "volatility_window": 20, "dispersion_window": 90, "dispersion_stat": "median", "volatility_min_periods": 10, "dispersion_min_periods": 45, "clip_lower": -5, "clip_upper": 5, "signal_lag_sessions": 1},
  "validation": {
