{
  "factor_id": "miner_2_20300715_dispersion_recovery",
  "factor_name": "High-dispersion volatility-normalized 5d recovery",
  "version": "1.0",
  "calculation": {
    "expression": "I(dispersion_5d(t-1) > rolling_quantile(dispersion_5d,60,0.65)) * (-log(close_t/close_{t-5}) / (rolling_std(log_returns,20)*sqrt(5)))",
    "description": "During elevated cross-asset five-day return dispersion, favor assets with the largest prior five-day volatility-normalized drawdowns, using a one-day lag to avoid lookahead. Outside the high-dispersion regime the signal is inactive."
  },
  "dependencies": ["close"],
  "parameters": {"recovery_lookback_days": 5, "volatility_window_days": 20, "dispersion_window_days": 5, "dispersion_threshold_window_days": 60, "dispersion_quantile": 0.65, "minimum_cross_section": 8, "signal_lag_days": 1},
