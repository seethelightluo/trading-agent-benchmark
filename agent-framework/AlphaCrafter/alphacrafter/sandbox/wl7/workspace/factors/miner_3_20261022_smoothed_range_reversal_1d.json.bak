{
  "factor_id": "miner_3_20261022_smoothed_range_reversal_1d",
  "factor_name": "Smoothed Range-Weighted Intraday Reversal",
  "version": "1.1",
  "calculation": {
    "expression": "ewm_mean(span=3, raw.shift(1)); raw = -(close/open - 1) * clip(((high-low)/open) / rolling_median_20((high-low)/open), 0, 4)",
    "description": "Ranks assets favoring lagged reversal of the prior-session intraday return, weighted by abnormal trading range and smoothed with a three-observation exponentially weighted mean. Inputs are lagged so the forecast uses only completed sessions."
  },
  "dependencies": [
    "open",
    "high",
    "low",
    "close"
  ],
  "parameters": {
    "range_window": 20,
    "range_cap": 4.0,
    "ewm_span": 3,
    "signal_lag": 1,
    "forward_horizons": [
      1,
      5,
      10,
      20
    ]
  },
