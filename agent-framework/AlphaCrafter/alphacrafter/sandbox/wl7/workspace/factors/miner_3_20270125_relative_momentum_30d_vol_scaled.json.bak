{
  "factor_id": "miner_3_20270125_relative_momentum_30d_vol_scaled",
  "factor_name": "30-day Cross-Asset Relative Momentum, Volatility Scaled",
  "version": "1.0",
  "calculation": {
    "expression": "(return(close,30) - cross_sectional_median(return(close,30))) / rolling_std(daily_return,60), lagged 1 day",
    "description": "Ranks each tradable benchmark asset by its 30-day return relative to the contemporaneous 15-asset median, scaled by 60-day realized daily volatility. The one-day lag prevents use of the current completed day's return in the forecast."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "momentum_window_days": 30,
    "volatility_window_days": 60,
    "lag_days": 1,
    "minimum_cross_section": 8
  },
