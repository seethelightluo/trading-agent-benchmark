{
  "factor_id": "miner_3_20270422_sortino_momentum",
  "factor_name": "Downside-Risk-Adjusted Momentum with Trend Confirmation",
  "version": "1.0",
  "calculation": {
    "expression": "(close/close.shift(20)-1) / (sqrt(20)*rolling_std(min(pct_change(close),0),30) + 1e-12) * (0.5 + 0.5*sign(close/close.shift(60)-1)), shifted by one trading day",
    "description": "Ranks assets by 20-day momentum normalized by recent downside deviation, with a 60-day trend confirmation multiplier that halves signals when the long trend is non-positive. The one-day lag prevents look-ahead."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "momentum_window": 20,
    "downside_volatility_window": 30,
    "trend_confirmation_window": 60,
    "forward_validation_horizon_days": 1,
    "minimum_downside_observations": 20,
    "signal_lag_days": 1
  },
  "validation": {
