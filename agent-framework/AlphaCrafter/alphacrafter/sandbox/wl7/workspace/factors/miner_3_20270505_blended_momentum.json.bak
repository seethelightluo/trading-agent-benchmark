{
  "factor_id": "miner_3_20270505_blended_momentum",
  "factor_name": "Blended Multi-Horizon Volatility-Scaled Momentum",
  "version": "1.0",
  "calculation": {
    "expression": "shift(1, (0.5*sum_return_10d + 0.5*sum_return_30d) / rolling_std_daily_return_20d)",
    "description": "Equal blend of lagged 10-day and 30-day returns, scaled by lagged 20-day realized volatility; all inputs are known before the prediction date."
  },
  "dependencies": ["close"],
  "parameters": {"short_window": 10, "long_window": 30, "volatility_window": 20, "blend_short": 0.5, "blend_long": 0.5, "signal_lag": 1},
