{
  "factor_id": "miner_3_20351126_residual_momentum_reversal30",
  "factor_name": "Cross-Asset Residual Momentum Reversal 30d",
  "version": "1.0",
  "calculation": {
    "expression": "-(return_30d(asset) - rolling_sum_30d(equal_weight_cross_asset_daily_return)) / (sqrt(30) * rolling_std_40d(asset_daily_return - equal_weight_cross_asset_daily_return))",
    "description": "Ranks assets for 10-day forward returns by reversing 30-day performance relative to the equal-weight benchmark, normalized by 40-day idiosyncratic volatility. Signal is lagged one completed day."
  },
  "dependencies": ["close"],
  "parameters": {"lookback_days": 30, "volatility_window": 40, "forward_horizon_days": 10, "minimum_cross_section": 8, "lag_days": 1},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2035-12-31",
    "metrics": {
      "ic": 0.04424196,
      "icir": 2.42428609,
      "ic_hit_ratio": 0.5760,
      "observations": 2420,
      "average_instruments": 15.0,
      "coverage": 0.5659,
      "turnover": 0.119492,
      "max_abs_library_correlation": null,
      "recent_252_ic": 0.01675581
    },
    "regime_notes": "Positive reversal IC is strong across the available post-2024 observations; 2025-2029 and 2030-2034 were negative for the unreversed momentum formulation, while the persisted reversed signal is positive. Small 15-asset universe warrants conservative interpretation.",
    "signal_artifact": "scripts/miner_3_20351126_residual_momentum30_signal.csv",
    "artifact_transform": "Use negative of the stored residual-momentum signal; regenerate or apply sign inversion at load time."
