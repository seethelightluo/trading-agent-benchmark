{
  "factor_id": "miner_3_20321129_skip3_volnorm_medium_reversal",
  "factor_name": "Skip-3 volatility-normalized 10-day medium-term reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(close/close.shift(10)-1).shift(3) / pct_change(close).rolling(30).std().shift(3)",
    "description": "Fade the ten-session return ending three sessions before the signal date, normalized by lagged 30-session daily-return volatility. The three-session shift excludes the most recent three observations and avoids look-ahead."
  },
  "dependencies": ["close"],
  "parameters": {"return_window": 10, "volatility_window": 30, "skip_sessions": 3, "minimum_cross_section": 8},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2032-11-26",
    "metrics": {
      "admission_horizon_sessions": 10,
      "ic": 0.036796,
      "icir": 0.120948,
      "hit_ratio": 0.5302,
      "valid_dates": 1622,
      "average_valid_instruments": 11.24,
      "coverage": 0.3805,
      "turnover": 0.0888,
      "max_abs_library_correlation": null,
      "other_horizons": {"H1": {"ic": 0.009103, "icir": 0.028547}, "H5": {"ic": 0.024368, "icir": 0.075840}, "H20": {"ic": 0.033867, "icir": 0.113834}},
      "h20_chronological_thirds_ic": [0.057975, 0.037542, 0.006041]
    },
    "regime_notes": "Positive H10 and H20 IC across 1,600+ dates; H20 thirds remain positive but decay in the most recent third. Interpret conservatively because average valid cross-section is 11.24 and overall panel coverage is 38.05%.",
    "signal_artifact": "scripts/miner_3_20321129_delayed_medium_reversal_signal.csv"
  },
