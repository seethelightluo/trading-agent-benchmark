{
  "factor_id": "miner_3_20270128_vol_state_momentum",
  "factor_name": "Volatility-State Breadth-Confirmed Momentum",
  "version": "20270128",
  "calculation": {
    "expression": "shift((return(close,20)/std(return(close,1),20)) * (0.5 + cross_asset_positive_breadth_20) * clip(std(return(close,1),60)/std(return(close,1),20),0.5,1.5), 1)",
    "description": "Lagged 20-day momentum scaled by 20-day realized volatility, cross-asset positive-return breadth, and a clipped volatility-state ratio. Stable trends where short volatility is below long volatility receive greater emphasis; the one-day lag prevents look-ahead."
  },
  "dependencies": [
    "close",
    "daily_returns",
    "cross_asset_returns"
  ],
  "parameters": {
    "momentum_window": 20,
    "short_vol_window": 20,
    "long_vol_window": 60,
    "breadth_window": 20,
    "breadth_floor": 0.5,
    "vol_state_clip": [
      0.5,
      1.5
    ],
    "signal_lag": 1
  },
