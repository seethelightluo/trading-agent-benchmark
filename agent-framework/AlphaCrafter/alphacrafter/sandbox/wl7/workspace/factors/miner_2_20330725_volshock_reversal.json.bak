{
  "factor_id": "miner_2_20330725_volshock_reversal",
  "factor_name": "Lagged volatility-shock amplified five-day reversal",
  "version": "1.0",
  "calculation": {
    "expression": "((-pct_change(close,5)/(rolling_std(pct_change(close,1),20)*sqrt(5))) * clip(rolling_std_20/rolling_std_60,0.5,3.0)).shift(1)",
    "description": "A contrarian five-session return normalized by recent realized volatility and multiplied by a clipped ratio of 20-session to 60-session volatility. The one-session lag ensures only completed information is used."
  },
  "dependencies": ["close"],
  "parameters": {"return_window": 5, "short_vol_window": 20, "long_vol_window": 60, "short_vol_min_periods": 15, "long_vol_min_periods": 40, "shock_clip": [0.5, 3.0], "lag": 1},
  "validation": {
