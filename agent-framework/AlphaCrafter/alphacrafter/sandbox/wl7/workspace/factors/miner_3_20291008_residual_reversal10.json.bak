{
  "factor_id": "miner_3_20291008_residual_reversal10",
  "factor_name": "Market-residual 10-day reversal risk-adjusted by idiosyncratic volatility",
  "version": "1.0",
  "calculation": {
    "expression": "-rolling_sum_10(asset_return - equal_weight_cross_asset_return) / rolling_std_20(asset_return - equal_weight_cross_asset_return)",
    "description": "For each tradable asset, subtract the same-day equal-weight return of the available 15-asset universe, sum the lagged residual returns over 10 days, and negate it; divide by lagged 20-day residual volatility. The signal uses data through the previous completed day. Higher values indicate stronger residual reversal potential."
  },
  "dependencies": ["close", "daily_returns", "15-asset cross-section"],
  "parameters": {"residual_window_days": 10, "volatility_window_days": 20, "min_residual_observations": 7, "min_cross_section": 8, "horizons_tested": [5,10,20,40]},
  "validation": {
