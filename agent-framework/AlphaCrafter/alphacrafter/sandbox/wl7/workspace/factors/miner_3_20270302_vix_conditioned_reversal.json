{
  "factor_id": "miner_3_20270302_vix_conditioned_reversal",
  "factor_name": "VIX-Conditioned 10-Day Volatility-Scaled Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "where(VIX_zscore_60d_lag1 > 0.75, -return_10d_lag1 / rolling_std(return_1d,20), NaN)",
    "description": "During elevated implied-volatility stress, rank assets positively when their lagged 10-day return is more negative after scaling by trailing 20-day realized volatility. VIX conditioning and all price features are lagged to prevent look-ahead. VIX is observation-only and is never traded."
  },
  "dependencies": [
    "close",
    "VIX.close"
  ],
  "parameters": {
    "return_window_days": 10,
    "realized_vol_window_days": 20,
    "vix_zscore_window_days": 60,
    "vix_threshold": 0.75,
    "forward_horizon_days": 1,
    "minimum_cross_section": 8
  },
