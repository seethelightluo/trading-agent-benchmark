{
  "factor_id": "miner_3_range_weighted_intraday_reversal_1d",
  "factor_name": "Range-Weighted Intraday Reversal",
  "version": "2026-08-27.v1",
  "calculation": {
    "expression": "-(close/open - 1) * clip(((high-low)/open) / median20((high-low)/open), 0, 4)",
    "description": "Ranks assets higher when their same-session return is negative, with the reversal signal scaled by the session range relative to its 20-day rolling median. Uses only completed daily OHLC data at decision time."
  },
  "dependencies": [
    "open",
    "high",
    "low",
    "close"
  ],
  "parameters": {
    "range_scale_window": 20,
    "min_periods": 10,
    "clip_lower": 0,
    "clip_upper": 4,
    "forward_horizon_days": 1,
    "min_cross_section": 8
  },
