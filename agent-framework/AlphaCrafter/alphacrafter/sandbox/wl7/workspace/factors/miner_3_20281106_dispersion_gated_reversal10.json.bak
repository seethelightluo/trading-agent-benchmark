      "coverage": 0.7813836478,
      "turnover": 0.0945230222,
      "max_abs_library_correlation": null
    },
    "decay": {"horizon": "20 trading days", "note": "Admission horizon; shorter horizons were not used for this candidate."},
    "regime_notes": "Positive in both reported eligible regimes; 2025-2026 IC 0.15042 (34 dates), 2027-2028 IC 0.03406 (231 dates). Small cross-section and gate-induced selection require conservative interpretation.",
