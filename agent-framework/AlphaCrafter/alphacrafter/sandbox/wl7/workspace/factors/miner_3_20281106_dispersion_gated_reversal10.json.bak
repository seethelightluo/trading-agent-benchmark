{
  "factor_id": "miner_3_20281106_dispersion_gated_reversal10",
  "factor_name": "Dispersion-gated volatility-normalized ten-day reversal",
  "version": "1.0",
  "calculation": {
    "expression": "I[mean_i(std_5(return_i)) > rolling_median_60(mean_i(std_5(return_i)))] * demean_i(-return_10_i/(sqrt(10)*std_30(return_i)))",
    "description": "Ranks ten-day volatility-normalized reversal only when recent cross-asset dispersion is above its trailing 60-day median; cross-sectionally demean the active signal. Signal and forward-return observations use completed daily data only."
  },
  "dependencies": ["close"],
  "parameters": {"reversal_lookback_days": 10, "volatility_window_days": 30, "dispersion_window_days": 5, "dispersion_threshold_window_days": 60, "forward_horizon_days": 20, "minimum_cross_section": 8},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2028-11-05 (eligible observations 2025-01-03 through 2028-10-04)",
    "metrics": {
