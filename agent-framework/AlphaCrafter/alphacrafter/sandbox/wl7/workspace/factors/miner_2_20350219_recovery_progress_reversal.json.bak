{
  "factor_id": "miner_2_20350219_recovery_progress_reversal",
  "factor_name": "Recovery-progress weighted 10-day reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-sum_return(close,10) * (0.7 + 0.6 * clip((close - rolling_min(close,60))/(rolling_max(close,60)-rolling_min(close,60)),0,1))",
    "description": "Ranks recent losers positively for reversal, with a bounded multiplier that increases as price progresses from its 60-day trough toward its 60-day high. Uses only completed historical closes and dampens/reweights smooth drawdown signals by recovery progress."
  },
  "dependencies": ["close"],
  "parameters": {"return_window": 10, "progress_window": 60, "multiplier_base": 0.7, "multiplier_range": 0.6, "clip_progress": [0, 1]},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01/2035-02-16",
    "metrics": {
      "horizon_days": 10,
      "ic": 0.041769,
      "icir": 2.0704,
      "valid_dates": 2176,
      "average_instruments": 11.18,
      "minimum_instruments": 8,
      "hit_ratio": 0.546,
      "coverage": 0.4206,
      "rank_turnover": 0.0977,
      "max_abs_library_correlation": 0.9901559561
    },
    "regime_notes": "Positive across 2023-2026 (IC 0.010330), 2027-2030 (0.048806), and 2031-2034 (0.040545); negative 2035 YTD (IC -0.118990 over 25 observations), requiring conservative deployment and near-term revalidation.",
    "signal_artifact": "scripts/miner_2_20350219_recovery_progress_reversal_signal.csv",
    "provenance": "Cross-sectional rank IC over the 15 tradable benchmark instruments; dates with at least 8 valid instruments retained. Forward returns shifted by horizon to prevent lookahead."
  },
  "tags": ["reversal", "drawdown", "recovery", "cross-asset"],
  "last_validated": "2035-02-19T00:00:00Z"
}
