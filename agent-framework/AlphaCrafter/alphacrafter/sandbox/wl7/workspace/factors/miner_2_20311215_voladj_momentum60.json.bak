{
  "factor_id": "miner_2_20311215_voladj_momentum60",
  "factor_name": "Volatility-adjusted medium-term momentum",
  "version": "1.0",
  "calculation": {
    "expression": "cross_sectional_center((close / close.shift(60) - 1) / (std(pct_change(close), 60) * sqrt(60)))",
    "description": "For each tradable instrument, compute 60-session cumulative return divided by 60-session realized return volatility, demean cross-sectionally, and lag the signal by one completed session to prevent look-ahead. Positive values indicate stronger risk-adjusted momentum."
  },
  "dependencies": ["close", "pct_change"],
  "parameters": {
    "momentum_window_days": 60,
    "volatility_window_days": 60,
    "volatility_min_periods": 40,
    "signal_lag_days": 1,
    "forward_horizon_days": 10,
    "minimum_cross_section": 8
  },
