  "factor_name": "Volatility-scaled medium-horizon reversal (10/30)",
  "version": "1.0",
  "calculation": {
    "expression": "-lag1(rolling_sum(return,10) / rolling_std(return,30))",
    "description": "Ranks assets higher when their lagged 10-session return is more negative after normalization by 30-session realized volatility. The one-session lag ensures only completed data are used."
  },
  "dependencies": ["close"],
  "parameters": {"return_window": 10, "volatility_window": 30, "volatility_min_periods": 20, "signal_lag": 1, "forward_horizon": 10},
