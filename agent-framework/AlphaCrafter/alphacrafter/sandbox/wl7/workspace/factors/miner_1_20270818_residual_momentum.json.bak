{
  "factor_id": "miner_1_20270818_residual_momentum",
  "factor_name": "Relative residual momentum 30d volatility scaled",
  "version": "2027-08-18",
  "calculation": {
    "expression": "shift1((asset_return_30d - cross_sectional_median_return_30d) / (realized_daily_volatility_30d*sqrt(252)+0.01))",
    "description": "Ranks each tradable benchmark by its lagged 30-session return relative to the cross-sectional median, scaled by lagged 30-session realized volatility. The one-session shift prevents use of the current session in the forecast."
  },
  "dependencies": ["close"],
  "parameters": {"return_lookback": 30, "volatility_lookback": 30, "annualization": 252, "lag_sessions": 1, "minimum_valid_names": 8, "universe_size": 15},
