{
  "factor_id": "miner_2_20270421_volatility_shock_reversal",
  "factor_name": "Volatility-Shock Three-Day Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-ret_3d_lagged / (vol_10_lagged + eps) * (vol_10_lagged / (vol_60_lagged + eps))",
    "description": "Negates the lagged three-session return, scales it by recent 10-session volatility, and amplifies the reversal signal when short-term volatility is elevated relative to its 60-session baseline. All inputs are lagged one completed session.",
    "signal_artifact": "scripts/miner_2_20270421_vol_shock_reversal_signal.csv"
  },
  "dependencies": ["close", "daily_returns"],
  "parameters": {
    "return_window": 3,
    "short_vol_window": 10,
    "long_vol_window": 60,
    "short_vol_min_periods": 7,
    "long_vol_min_periods": 30,
    "epsilon": 1e-12,
    "forward_horizon_days": 1,
    "universe_size": 15
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2027-04-21",
    "last_validated": "2027-04-23T00:00:00Z",
    "metrics": {
      "daily_paper_ic": 0.0169230023,
      "daily_paper_icir": 0.8323473879,
      "ic_hit_ratio": 0.5224203133,
      "validation_dates": 1851,
      "average_instruments_per_date": 14.5954,
      "factor_coverage": 0.98347,
      "rank_turnover": 0.20495,
      "decay_ic_5d": 0.0053816923,
      "decay_ic_10d": -0.0104917716,
      "decay_ic_20d": -0.0059087832,
      "regime_ic_2020_2022": 0.0230440364,
      "regime_ic_2023_2024": 0.0012602707,
      "regime_ic_2025_2027": 0.0228931761,
      "max_abs_library_correlation": null
    },
    "regime_notes": "Strongest in 2020-2022 and 2025-2027; near zero in 2023-2024. One-day edge decays rapidly and is negative at 10-20 days, so use as a short-horizon complementary signal rather than a standalone persistent trend factor. Small cross-asset universe warrants conservative interpretation.",
    "coverage_note": "15 tradable benchmark instruments; dates with at least 8 valid instruments used for cross-sectional Spearman IC. Observation-only macro series were not traded or included as assets."
  },
  "tags": ["reversal", "volatility", "short_horizon", "cross_asset"]
}
