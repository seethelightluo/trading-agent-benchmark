{
  "factor_id": "miner_2_20330530_compression_breakout",
  "factor_name": "Volatility-compression risk-adjusted trend",
  "version": "1.0",
  "calculation": {
    "expression": "((close/close.shift(20)-1)/(std(pct_change,20)*sqrt(20))) / clip(std(pct_change,20)/std(pct_change,60),0.4,2.5), shifted by one completed session",
    "description": "A 20-session risk-adjusted trend signal scaled by the inverse ratio of short-term to medium-term realized volatility. Negative validation direction indicates inverse use (compression-conditioned trend is a cross-sectional loser signal in this sample)."
  },
  "dependencies": ["close"],
  "parameters": {"trend_window": 20, "short_vol_window": 20, "long_vol_window": 60, "min_periods_short": 15, "min_periods_long": 40, "compression_clip": [0.4, 2.5], "lag_sessions": 1},
  "validation": {
    "status": "EFFECTIVE",
    "period": {"start": "2026-07-16", "end": "2033-05-30", "cutoff": "2033-05-29"},
