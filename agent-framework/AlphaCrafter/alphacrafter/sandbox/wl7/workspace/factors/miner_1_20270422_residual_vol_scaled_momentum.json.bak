{
  "factor_id": "miner_1_20270422_residual_vol_scaled_momentum",
  "factor_name": "Cross-Asset Residual Volatility-Scaled Momentum",
  "version": "1.0",
  "calculation": {
    "expression": "lag1((return_20d(asset) - cross_sectional_median(return_20d)) / realized_vol_30d(asset))",
    "description": "For each asset, subtract the same-date cross-sectional median 20-day return, divide by its 30-day daily-return volatility, and lag one observation to prevent look-ahead. Higher values indicate momentum in excess of the benchmark universe, risk-adjusted for the asset's own volatility."
  },
  "dependencies": ["close"],
  "parameters": {"return_window": 20, "volatility_window": 30, "vol_min_periods": 20, "signal_lag": 1, "cross_section": "15 tradable watchlist; available instruments used"},
