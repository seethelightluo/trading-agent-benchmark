{
  "factor_id": "miner_2_20311006_voladj_momentum60_reversal",
  "factor_name": "Volatility-Adjusted 60-Day Cross-Asset Momentum Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(ret_60 / (sqrt(60) * rolling_std(pct_change(close), 60))).demean_cross_section().shift(1)",
    "description": "Ranks the prior-session-lagged negative of each instrument's 60-day return normalized by its 60-day realized volatility, after cross-sectional demeaning. The negative direction is used because the raw volatility-adjusted momentum signal exhibited robust reversal predictiveness."
  },
  "dependencies": ["close"],
  "parameters": {"return_window": 60, "volatility_window": 60, "volatility_min_periods": 40, "lag_sessions": 1, "cross_section_min_instruments": 8},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2031-10-06",
    "metrics": {
