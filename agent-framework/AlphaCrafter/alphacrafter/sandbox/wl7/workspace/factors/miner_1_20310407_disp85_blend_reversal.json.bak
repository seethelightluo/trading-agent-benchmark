{
  "factor_id": "miner_1_20310407_disp85_blend_reversal",
  "factor_name": "85th-percentile dispersion-gated blended shock reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(0.7*sum_return_3d/rolling_std_20d + 0.3*sum_return_10d/rolling_std_20d) * I(cross_asset_dispersion_20d > lagged_252d_quantile_85)",
    "description": "Contrarian volatility-normalized short- and medium-horizon shock signal, activated only when 20-day cross-asset return dispersion exceeds its lagged 252-session 85th percentile. Uses completed daily prices and no future data."
  },
  "dependencies": ["close"],
  "parameters": {
    "short_window": 3,
    "long_window": 10,
    "volatility_window": 20,
    "dispersion_window": 20,
    "threshold_window": 252,
    "threshold_quantile": 0.85,
    "lag_threshold": 1,
    "short_weight": 0.7,
    "long_weight": 0.3,
    "minimum_cross_section": 8
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2031-04-04",
    "metrics": {
      "daily_paper_ic": 0.035462381,
      "daily_paper_icir": 1.750447299,
      "ic_hit_ratio": 0.5413,
      "valid_ic_dates": 630,
      "average_instruments_per_date": 13.753968254,
      "factor_coverage": 0.9169,
      "rank_turnover": 0.03521,
      "ic_5d": 0.031515976,
      "ic_10d": 0.023361746,
      "ic_20d": 0.00446118,
      "max_abs_library_correlation": null
    },
    "regime_notes": "Positive IC in early, middle, and late chronological thirds (+0.02683, +0.05867, +0.02089). Strongest predictive decay at 1 to 5 sessions; materially weaker by 20 sessions. Small 15-instrument universe implies conservative uncertainty interpretation.",
    "validation_timestamp": "2031-04-07T00:00:00Z"
  },
  "artifacts": {
    "signal": "scripts/miner_1_20310407_disp85_blend_signal.csv",
    "ic_series": "scripts/miner_1_20310407_disp85_blend_ic.csv",
    "validation_script": "scripts/miner_1_20310407_disp85_blend.py"
  },
  "tags": ["reversal", "dispersion", "volatility-adjusted", "cross-asset", "short-horizon"]
}
