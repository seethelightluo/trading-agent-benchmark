{
  "factor_id": "miner_2_20351224_stress_drawdown_rebound20",
  "factor_name": "Stress-Conditioned Volatility-Normalized Drawdown Rebound",
  "version": "1.0",
  "calculation": {
    "expression": "shift(-((close/rolling_max(close,60))-1) / rolling_std(log_return,40) * clip((cross_asset_mean(negative_return_10d_fraction)-0.5)/0.5,0,1),1)",
    "description": "Ranks assets positively when they have deep 60-day drawdowns normalized by 40-day volatility, activated only when the 10-day cross-asset negative-return breadth exceeds 50%. The one-day lag prevents look-ahead."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "drawdown_window": 60,
    "volatility_window": 40,
    "stress_window": 10,
    "stress_threshold": 0.5,
    "forward_horizon_days": 10,
    "minimum_cross_section": 8
  },
  "validation": {
