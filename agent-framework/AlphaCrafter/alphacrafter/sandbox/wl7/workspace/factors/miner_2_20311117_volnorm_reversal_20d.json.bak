  "factor_name": "Volatility-Normalized Five-Day Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "shift1(-(close/shift(close,5)-1)/rolling_std(pct_change(close),20))",
    "description": "Ranks assets cross-sectionally by lagged five-session return reversal, normalized by trailing 20-session total volatility. Positive values favor assets with recent underperformance relative to their own risk that are expected to mean-revert over the medium horizon."
  },
  "dependencies": ["close"],
  "parameters": {
    "reversal_window_days": 5,
    "volatility_window_days": 20,
    "signal_lag_days": 1,
    "admission_horizon_days": 20,
    "minimum_cross_section": 8
  },
