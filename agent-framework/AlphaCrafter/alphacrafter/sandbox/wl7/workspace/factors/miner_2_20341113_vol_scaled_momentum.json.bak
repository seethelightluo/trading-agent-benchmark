  "factor_name": "Inverse volatility-scaled 60-day momentum",
  "version": "1.0",
  "calculation": {
    "expression": "-((sum_return_60d) / realized_volatility_20d).shift(1)",
    "description": "Cross-asset contrarian signal: negative of trailing 60-trading-day cumulative simple return divided by 20-day daily-return standard deviation, lagged one completed day to prevent lookahead. Higher values indicate weaker prior momentum and/or lower volatility. Direction is explicitly -1 relative to the raw momentum ratio."
  },
  "dependencies": ["close"],
  "parameters": {"momentum_window": 60, "volatility_window": 20, "min_momentum_observations": 40, "min_volatility_observations": 15, "lag_days": 1, "direction": -1, "forward_horizon_days": 10},
