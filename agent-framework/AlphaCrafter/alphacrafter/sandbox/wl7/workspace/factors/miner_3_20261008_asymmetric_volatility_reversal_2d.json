  "factor_name": "Asymmetric Volatility-Scaled Two-Day Reversal",
  "version": "1.2",
  "calculation": {
    "expression": "-(close/lag(close,2)-1)/(rolling_std(pct_change(close),20)+1e-8) * (1 + 0.5*clip((downside_semivol_20 - rolling_median(downside_semivol_20,60))/(rolling_std(downside_semivol_20,60)+1e-8),0,2))",
    "description": "Ranks recent two-day losers positively for reversal, volatility scales the signal, and amplifies it during elevated downside-semivolatility shocks. Signal is lagged one completed session."
  },
