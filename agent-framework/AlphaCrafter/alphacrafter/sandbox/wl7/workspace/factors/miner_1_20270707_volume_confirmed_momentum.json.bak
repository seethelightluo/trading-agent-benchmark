{
  "factor_id": "miner_1_20270707_volume_confirmed_momentum",
  "factor_name": "Volume-confirmed 20-day momentum",
  "version": "1.0",
  "calculation": {
    "expression": "shift1(rolling_sum(pct_change(close),20) * (0.5 + 0.5*clip(log(1 + volume/rolling_median(volume,60)), log(1.25), log(4))))",
    "description": "Ranks assets by lagged 20-session cumulative momentum, modestly amplified when current volume is above its trailing 60-session median and bounded to limit extreme volume effects. The one-session shift prevents look-ahead."
  },
  "dependencies": [
    "close",
    "volume"
  ],
  "parameters": {
    "momentum_window": 20,
    "volume_baseline_window": 60,
    "volume_min_observations": 20,
    "volume_multiplier_clip": [
      0.25,
      4.0
    ],
    "signal_lag_sessions": 1,
    "volume_amplification": "0.5 + 0.5*log1p(volume/rolling_median)"
  },
  "validation": {
