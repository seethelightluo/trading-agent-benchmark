{
  "factor_id": "miner_3_20350903_beta_downside_asymmetry_reversal20",
  "factor_name": "Beta-Residual Downside-Asymmetry Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "e = return - rolling_beta(return, equal_weight_15_asset_return, 60) * equal_weight_15_asset_return; F = -(rolling_sum(clip(e, upper=0),20) + 0.35*rolling_sum(clip(e, lower=0),20)) / rolling_std(clip(e, upper=0),40), followed by cross-sectional median residualization and one-day lag",
    "description": "Ranks assets for rebound after persistent downside beta-residual pressure, with a modest adjustment for positive residual days and normalization by downside residual volatility. All rolling inputs use trailing observations and the final signal is lagged one completed trading day."
  },
  "dependencies": ["close"],
  "parameters": {
    "beta_window": 60,
    "beta_min_periods": 40,
    "downside_path_window": 20,
    "downside_vol_window": 40,
    "path_min_periods": 15,
    "vol_min_periods": 25,
    "positive_path_weight": 0.35,
    "signal_lag": 1,
    "forward_horizon": 20,
    "minimum_cross_section": 8
  },
