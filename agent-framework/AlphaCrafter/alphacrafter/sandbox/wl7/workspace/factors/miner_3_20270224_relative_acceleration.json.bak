  "factor_name": "Cross-Asset Relative Momentum with Short-Term Acceleration",
  "version": "1.0",
  "calculation": {
    "expression": "shift_1((return_20d - cross_sectional_median(return_20d)) + 0.35*(return_5d - cross_sectional_median(return_5d)))",
    "description": "Ranks assets by lagged relative 20-day momentum, enhanced by a modest lagged 5-day relative acceleration term. Cross-sectional medians are computed on each date using only available instruments."
  },
  "dependencies": ["close"],
  "parameters": {"long_window": 20, "short_window": 5, "acceleration_weight": 0.35, "lag_sessions": 1, "min_cross_section": 8},
