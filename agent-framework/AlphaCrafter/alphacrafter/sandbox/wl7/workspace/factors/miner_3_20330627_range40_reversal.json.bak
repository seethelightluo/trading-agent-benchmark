{
  "factor_id": "miner_3_20330627_range40_reversal",
  "factor_name": "40-Day Range-Position Volatility-Scaled Reversal",
  "version": "1.1",
  "calculation": {
    "expression": "(0.5 - (close - rolling_min(close,40)) / (rolling_max(close,40)-rolling_min(close,40)+1e-12)) / (rolling_std(pct_change(close),20)+1e-12), shifted one completed session",
    "description": "Ranks assets higher when lagged prices are near the lower end of their trailing 40-session range, scaled by inverse 20-session realized volatility."
  },
  "dependencies": ["close"],
  "parameters": {"range_window_days": 40, "range_min_periods": 30, "volatility_window_days": 20, "volatility_min_periods": 15, "validation_forward_horizon_days": 10},
