{
  "factor_id": "miner_3_20270310_downside_risk_momentum",
  "factor_name": "Downside-risk-adjusted 20-day momentum",
  "version": "1.0",
  "calculation": {
    "expression": "(close/close.shift(20)-1) / rolling_std(where(daily_return<0,daily_return,0),30).shift(1)",
    "description": "Ranks assets by lagged 20-trading-day momentum divided by the trailing 30-day downside volatility. Positive-return observations do not increase the risk denominator; the signal is lagged one completed day to avoid look-ahead."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "momentum_window": 20,
    "downside_vol_window": 30,
    "min_periods": 15,
    "lag": 1,
    "forward_horizon_for_admission": 1
  },
