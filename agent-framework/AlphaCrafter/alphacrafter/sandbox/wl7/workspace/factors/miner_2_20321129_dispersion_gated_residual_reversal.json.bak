{
  "factor_id": "miner_2_20321129_dispersion_gated_residual_reversal",
  "factor_name": "High-Dispersion Volatility-Scaled Residual Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "IF(cross_sectional_dispersion(abs(ret_5)) > rolling_40d_quantile_60(cross_sectional_dispersion(abs(ret_5))), -(ret_5 - median_cross_sectional(ret_5)) / rolling_std(ret_1, 30), NaN)",
    "description": "At dates following elevated cross-asset dispersion, rank assets higher when their lagged five-session return is more negative than the cross-sectional median, scaled by trailing 30-session volatility. All inputs end at the previous completed session. The signal is intended as conditional mean reversion after idiosyncratic shocks."
  },
  "dependencies": ["close"],
  "parameters": {"return_window": 5, "volatility_window": 30, "dispersion_reference_window": 40, "dispersion_quantile": 0.60, "minimum_cross_section": 8, "signal_lag_sessions": 1},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-03-13 through 2032-11-28",
    "last_validated": "2032-11-29",
    "metrics": {
      "admission_horizon": "20-trading-day forward return",
      "ic": 0.057212,
      "icir": 0.176498,
      "ic_hit_ratio": 0.5668,
      "valid_dates": 277,
      "average_instruments": 11.38,
      "factor_coverage": 0.0569,
      "conditional_date_coverage": 0.0569,
      "rank_turnover": 0.20554,
      "decay_ic_1d": -0.002278,
      "decay_ic_5d": 0.026882,
      "decay_ic_10d": 0.017345,
      "decay_ic_20d": 0.057212,
      "regime_notes": "Conditional dates are elevated-dispersion sessions; H10 IC was positive in the second and third chronological thirds (0.019960, 0.022134), while H20 was the strongest measured horizon. Small conditional sample warrants conservative monitoring.",
      "max_abs_library_correlation": null
