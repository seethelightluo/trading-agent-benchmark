{
  "factor_id": "miner_2_20270622_compression_breakout_20d",
  "factor_name": "Medium-Horizon Volatility Compression Breakout Momentum",
  "version": "1.0",
  "calculation": {
    "expression": "[close/close.shift(20)-1] / [rolling_std(pct_change(close),20)*sqrt(20)] * [rolling_std(pct_change(close),20)/rolling_std(pct_change(close),60)]^(-0.5), lagged by 1 completed session",
    "description": "Twenty-day risk-adjusted momentum with a mild penalty for elevated recent volatility relative to its 60-day baseline. The one-session lag prevents look-ahead and the square-root compression adjustment avoids the extreme amplification of a raw volatility ratio."
  },
  "dependencies": ["close"],
  "parameters": {
    "momentum_window": 20,
    "short_vol_window": 20,
    "long_vol_window": 60,
    "short_vol_min_observations": 15,
    "long_vol_min_observations": 40,
    "compression_exponent": -0.5,
    "signal_lag": 1,
    "forward_horizons": [1, 5, 10, 20]
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-02 through 2027-06-21",
    "last_validated": "2027-06-22T00:00:00Z",
    "metrics": {
      "ic": 0.015655,
      "icir": 0.769216,
      "ic_horizon": "1-trading-day forward return (admission horizon)",
      "ic_definition": "mean daily cross-sectional Spearman IC; ICIR is mean/std multiplied by sqrt(252)",
      "valid_ic_dates": 1885,
      "average_instruments_per_date": 14.25,
      "factor_coverage": 0.7309,
      "rank_turnover": 0.096713,
      "decay_ic_5d": 0.018063,
      "decay_ic_10d": 0.042462,
      "decay_ic_20d": 0.047623,
      "ic_hit_ratio": 0.5088,
      "max_abs_library_correlation": null,
      "admission_thresholds": {"absolute_daily_paper_ic": 0.007, "absolute_daily_paper_icir": 0.084}
    },
    "regime_notes": "Daily IC was positive in all tested regimes: 2020-2022 +0.02410 (732 dates), 2023-2024 +0.004825 (516 dates), and 2025-2027 +0.014722 (637 dates). The middle regime is weak, so use as a capped diversifier rather than a dominant signal. Ten- and twenty-day decay was stronger than one-day predictiveness.",
    "signal_artifact": "scripts/miner_2_20270622_compression_breakout_signal.csv",
    "validation_script": "scripts/miner_2_20270622_compression_breakout.py",
    "validation_provenance": "Executed on 2027-06-22 using all 15 tradable benchmark instruments; dates with at least 8 valid instruments were included. DXY, FX observation series, and VIX were excluded."
  },
  "tags": ["momentum", "volatility", "breakout", "compression", "cross_asset", "medium_horizon"]
}
