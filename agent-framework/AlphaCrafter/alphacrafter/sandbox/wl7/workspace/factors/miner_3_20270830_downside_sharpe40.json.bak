{
  "factor_id": "miner_3_20270830_downside_sharpe40",
  "factor_name": "Downside-Risk-Adjusted 40-Day Momentum",
  "version": "1.0",
  "calculation": {
    "expression": "lag1(40d_return / (annualized_downside_volatility_40d + 0.01))",
    "description": "One-session-lagged 40-trading-day return divided by annualized downside volatility over the same window plus a 0.01 stabilizer. Higher values indicate persistent momentum with less downside risk."
  },
