{
  "factor_id": "miner_2_20330711_medium_reversal",
  "factor_name": "Lagged Volatility-Normalized Ten-Day Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "(-close/close.shift(10) + 1) / (rolling_std(pct_change(close), 30) * sqrt(10)), shifted one session",
    "description": "Contrarian ten-session cross-asset return, scaled by trailing 30-session realized volatility and lagged one completed session to avoid look-ahead."
  },
  "dependencies": ["close"],
  "parameters": {"return_lookback": 10, "volatility_window": 30, "volatility_min_periods": 20, "lag": 1, "validation_horizon": 20},
  "validation": {
    "status": "EFFECTIVE",
    "metrics": {
      "ic": 0.047167,
      "icir": 0.153532,
