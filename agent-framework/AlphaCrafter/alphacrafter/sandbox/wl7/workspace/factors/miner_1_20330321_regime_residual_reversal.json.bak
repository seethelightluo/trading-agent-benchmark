{
  "factor_id": "miner_1_20330321_regime_residual_reversal",
  "factor_name": "VIX-regime weighted cross-sectional residual delayed reversal",
  "version": "1.0",
  "calculation": {
    "expression": "clip(1+0.35*zscore(VIX_252),0.35,1.9) * demean_cs(-return_10d.shift(10)/rolling_std(return_1d,40).shift(10))",
    "description": "Ranks a ten-session delayed, volatility-normalized reversal signal after cross-sectional demeaning, then smoothly scales magnitude by the lagged VIX regime. All inputs are lagged or observable at the signal date.",
