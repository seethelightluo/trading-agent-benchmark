  },
  "dependencies": ["close", "VIX"],
  "parameters": {"reversal_window_sessions": 10, "delay_sessions": 10, "volatility_window_sessions": 40, "vix_zscore_window_sessions": 252, "regime_scale": 0.35, "regime_clip": [0.35, 1.9]},
