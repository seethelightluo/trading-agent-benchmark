{
  "factor_id": "miner_1_20261022_dispersion_conditional_reversal",
  "factor_name": "Cross-Asset Dispersion-Conditional Volatility-Normalized Five-Day Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(sum_{i=0..4} r_{asset,t-i})/std_20(r_asset) * clip(std_cross_section(r_t)/median_60(std_cross_section(r_t)), 0.5, 2.0)",
    "description": "A five-day volatility-normalized reversal signal amplified when contemporaneous cross-asset daily return dispersion is elevated relative to its trailing 60-day median. All inputs use information through t and predict returns beginning t+1."
  },
  "dependencies": [
    "close",
    "pct_change"
  ],
  "parameters": {
    "reversal_window_days": 5,
    "asset_volatility_window_days": 20,
    "cross_asset_dispersion": "cross_sectional_std_of_daily_returns",
    "dispersion_baseline_window_days": 60,
    "dispersion_multiplier_clip": [
      0.5,
      2.0
    ],
    "minimum_cross_section": 8
  },
