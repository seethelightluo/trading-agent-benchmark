{
  "factor_id": "miner_3_20270707_volume_confirmed_momentum",
  "factor_name": "Volume-Confirmed Risk-Adjusted Momentum",
  "version": "1.0",
  "calculation": {
    "expression": "shift_1((return_20 / (realized_vol_20*sqrt(252)+0.01)) * (0.75 + 0.25*clip(volume_mean_20/volume_mean_60, 0.5, 2.0)))",
    "description": "Lagged 20-session momentum scaled by realized volatility and modestly confirmed by relative volume participation. The one-day shift ensures only completed data are used."
  },
  "dependencies": ["close", "volume"],
  "parameters": {"momentum_window": 20, "volatility_window": 20, "volume_fast_window": 20, "volume_slow_window": 60, "volume_clip": [0.5, 2.0], "volume_weight_floor": 0.75, "forward_horizon": 10, "signal_lag": 1},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 to 2027-07-06",
    "last_validated": "2027-07-07T00:00:00Z",
    "metrics": {
