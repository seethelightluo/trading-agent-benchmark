{
  "factor_id": "miner_3_20340515_medium_reversal60",
  "factor_name": "Volatility-Normalized Long Medium-Horizon Reversal 60d",
  "version": "1.0",
  "calculation": {
    "expression": "-(close_t / close_{t-60} - 1) / (std(pct_change(close),120) * sqrt(60)), shifted by 1 completed session",
    "description": "Ranks assets higher when their lagged 60-session return is unusually weak relative to trailing 120-session daily volatility. The one-session shift prevents look-ahead."
  },
  "dependencies": ["close", "pct_change"],
  "parameters": {"lookback_sessions": 60, "volatility_window": 120, "signal_lag": 1, "forward_horizon_sessions": 10, "minimum_cross_section": 8},
