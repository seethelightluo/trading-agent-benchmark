{
  "factor_id": "miner_2_20321004_residual_reversal10",
  "factor_name": "Cross-sectional residual reversal 10-day volatility scaled",
  "version": "1.0",
  "calculation": {
    "expression": "-((sum(log_return,10) - cross_sectional_median(sum(log_return,10))) / (std(log_return,40)*sqrt(40))).shift(1)",
    "description": "Contrarian cross-sectional ten-session residual return, normalized by trailing forty-session annualized volatility and lagged one completed session. Positive values favor assets that underperformed their contemporaneous cross-sectional median."
  },
  "dependencies": ["close"],
  "parameters": {"residual_window": 10, "volatility_window": 40, "lag": 1, "minimum_cross_section": 8},
