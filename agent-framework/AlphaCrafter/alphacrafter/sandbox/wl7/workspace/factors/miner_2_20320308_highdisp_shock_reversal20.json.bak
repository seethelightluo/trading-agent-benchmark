{
  "factor_id": "miner_2_20320308_highdisp_shock_reversal20",
  "factor_name": "High-dispersion relative shock reversal (20-day)",
  "version": "1.0",
  "calculation": {
    "expression": "where(cs_std(rolling_sum(return,5)) > rolling_median(cs_std(rolling_sum(return,5)),120), -(rolling_sum(return,5)-cs_median(rolling_sum(return,5)))/rolling_std(return,20), NaN), then lag 1",
    "description": "Reverses each asset's five-day return relative to the contemporaneous cross-sectional median, volatility-normalized, and activates only during elevated cross-asset dispersion. The signal is lagged one session to avoid look-ahead."
  },
  "dependencies": ["close"],
  "parameters": {"shock_window": 5, "volatility_window": 20, "dispersion_window": 120, "dispersion_min_periods": 60, "signal_lag": 1, "forward_horizon": 20, "minimum_cross_section": 8},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2032-03-07",
    "validation_timestamp": "2032-03-08T00:00:00Z",
    "metrics": {
