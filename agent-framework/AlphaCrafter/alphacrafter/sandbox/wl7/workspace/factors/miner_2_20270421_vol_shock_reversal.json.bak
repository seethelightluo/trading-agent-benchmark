{
  "factor_id": "miner_2_20270421_vol_shock_reversal",
  "factor_name": "Volatility-Shock Scaled Short-Term Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "(-pct_change(close,3) / rolling_std(pct_change(close),10)) * (rolling_std_10 / rolling_std_60), all inputs lagged one session",
    "description": "Contrarian three-session return scaled by short-term volatility and amplified when short-term volatility is elevated relative to its 60-session baseline. Signal is shifted one session to avoid look-ahead bias."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "reversal_window": 3,
    "short_vol_window": 10,
    "baseline_vol_window": 60,
    "signal_lag": 1,
    "forward_horizon_admission": 1
  },
