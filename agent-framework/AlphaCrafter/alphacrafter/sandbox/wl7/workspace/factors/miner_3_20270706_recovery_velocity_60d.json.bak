{
  "factor_id": "miner_3_20270706_recovery_velocity_60d",
  "factor_name": "Downside-risk-normalized 60-day recovery velocity",
  "version": "1.0",
  "calculation": {
    "expression": "(close / rolling_min(close, 60) - 1) / (sqrt(rolling_mean(min(pct_change(close),0)^2,20)) + 1e-12), shifted by 1 session",
    "description": "Ranks assets by their recovery from the trailing 60-day low, normalized by recent downside semivolatility. The one-session shift prevents use of the current day's close when forecasting forward returns."
  },
  "dependencies": ["close"],
  "parameters": {"recovery_window": 60, "downside_volatility_window": 20, "minimum_recovery_observations": 40, "minimum_downside_volatility_observations": 12, "signal_lag_sessions": 1},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2027-07-05",
    "validation_date": "2027-07-06",
    "metrics": {
      "daily_paper_ic": 0.0153141964,
      "daily_paper_icir": 0.7362600637,
      "ic_hit_ratio": 0.5169312169,
      "coverage": 0.7484194295,
      "average_instruments_per_date": 14.6021164021,
      "validation_dates": 1890,
      "turnover": 0.0746219960,
      "decay_ic_5d": 0.0257594942,
      "decay_icir_5d": 1.2260128937,
      "decay_ic_10d": 0.0335239517,
      "decay_icir_10d": 1.5956785216,
      "max_abs_library_correlation": null
    },
    "regime_notes": "Daily rank IC remained positive across 2020-2022 (+0.02553), 2023-2024 (+0.00965), and 2025-2027 (+0.00819). Recent strength is weaker and the 2025-2027 hit ratio was 49.92%, so uncertainty is material in the 15-asset universe.",
    "admission_gates": {"minimum_absolute_daily_ic": 0.007, "minimum_absolute_daily_icir": 0.084}
  },
  "provenance": {"signal_artifact": "scripts/miner_3_20270706_recovery_velocity_signal.csv", "universe_size": 15, "assets_used": 15, "no_future_data": true},
  "tags": ["recovery", "momentum", "downside-risk", "cross-asset"]
}
