{
  "factor_id": "miner_2_20270212_path_persistence_momentum",
  "factor_name": "Path-Persistence Momentum 15d",
  "version": "20270212",
  "calculation": {
    "expression": "lag1((close/close.shift(15)-1) / rolling_sum(abs(pct_change(close)),20)",
    "description": "Fifteen-day momentum normalized by the absolute-return path length over the prior 20 sessions; lagged one completed session to prevent lookahead. Higher values indicate directional movement with less choppiness."
  },
  "dependencies": ["close"],
  "parameters": {"momentum_window": 15, "path_window": 20, "lag": 1, "forward_horizon": 5},
