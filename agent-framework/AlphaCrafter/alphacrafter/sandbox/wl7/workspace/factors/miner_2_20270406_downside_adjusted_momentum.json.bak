{
  "factor_id": "miner_2_20270406_downside_adjusted_momentum",
  "factor_name": "Downside-Risk-Adjusted Medium-Term Momentum",
  "version": "1.0",
  "calculation": {
    "expression": "lag1(ROC(close,20) / (rolling_std(min(pct_change(close),0),30) * sqrt(30) + 1e-12))",
    "description": "Ranks assets by their prior-session 20-trading-day momentum scaled by trailing 30-day downside deviation; negative daily returns contribute to the downside-risk estimate and the complete signal is lagged one session to avoid look-ahead."
  },
  "dependencies": ["close"],
  "parameters": {"momentum_window": 20, "downside_window": 30, "lag": 1, "epsilon": 1e-12},
  "validation": {
    "status": "EFFECTIVE",
