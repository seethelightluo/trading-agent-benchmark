  "factor_name": "Volatility-scaled 20-minus-60-session momentum acceleration",
  "version": "1.0",
  "calculation": {
    "expression": "lag1((sum_return_20 - sum_return_60) / (rolling_std_daily_return_20 * sqrt(252) + 1e-12))",
    "description": "The lagged improvement of 20-session cumulative return over 60-session cumulative return, normalized by annualized 20-session realized volatility. Higher values indicate strengthening trend per unit of recent risk; lagging uses only completed sessions."
