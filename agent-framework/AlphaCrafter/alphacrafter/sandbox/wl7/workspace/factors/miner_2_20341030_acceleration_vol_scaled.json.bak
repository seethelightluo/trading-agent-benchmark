{
  "factor_id": "miner_2_20341030_acceleration_vol_scaled",
  "factor_name": "Short-Term Acceleration over Volatility",
  "version": "1.0",
  "calculation": {
    "expression": "((close/close.shift(5)-1) - 0.5*(close/close.shift(60)-1)) / rolling_std(pct_change(close),20), shifted one day",
    "description": "Ranks assets whose recent five-day return accelerates relative to their medium-term 60-day return, scaled by 20-day realized volatility; lagged to prevent look-ahead."
  },
  "dependencies": ["close"],
  "parameters": {"short_window": 5, "medium_window": 60, "medium_weight": 0.5, "vol_window": 20, "lag": 1, "universe_size": 15},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2034-10-30",
    "metrics": {
      "horizon_days": 10,
