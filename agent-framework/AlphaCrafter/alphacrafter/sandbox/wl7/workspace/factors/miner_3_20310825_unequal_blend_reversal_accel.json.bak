{
  "factor_id": "miner_3_20310825_unequal_blend_reversal_accel",
  "factor_name": "Unequal Blend Residual Reversal and Trend Acceleration",
  "version": "1.0",
  "calculation": {
    "expression": "0.65*zscore_cs(-(ret20-mean_cs(ret20))) + 0.35*zscore_cs((ret10-lag10(ret10))/volatility40), shifted 1 session",
    "description": "Cross-sectionally standardize a 20-session residual reversal and a volatility-scaled 10-session trend acceleration, emphasize the reversal component, blend, and lag one completed session to prevent look-ahead."
  },
  "dependencies": ["close"],
  "parameters": {
    "reversal_lookback_days": 20,
    "acceleration_window_days": 10,
    "acceleration_lag_days": 10,
    "volatility_window_days": 40,
    "blend_weights": {"residual_reversal": 0.65, "trend_acceleration": 0.35},
    "signal_lag_days": 1,
    "minimum_valid_instruments": 8,
    "forward_horizons_days": [1, 5, 10]
  },
  "validation": {
