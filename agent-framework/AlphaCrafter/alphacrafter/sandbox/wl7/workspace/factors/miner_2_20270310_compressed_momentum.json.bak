{
  "factor_id": "miner_2_20270310_compressed_momentum",
  "factor_name": "Volatility-Compression-Adjusted Medium-Term Momentum",
  "version": "1.0",
  "calculation": {
    "expression": "[pct_change(close,15) / rolling_std(pct_change(close),20)] * [rolling_std(pct_change(close),60) / rolling_std(pct_change(close),20)], with the complete signal shifted one session",
    "description": "Ranks assets by 15-session momentum normalized by 20-session volatility and strengthened when short-term volatility is compressed relative to its 60-session baseline. All inputs are lagged one completed session to prevent look-ahead bias."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "momentum_window": 15,
    "short_vol_window": 20,
    "baseline_vol_window": 60,
    "signal_lag": 1,
    "forward_horizon_admission": 1
  },
