  "factor_name": "Three-session volatility-scaled shock reversal with smoothing",
  "version": "1.0",
  "calculation": {
    "expression": "clip(median_neutralize(shift(-rolling_mean(return/vol20, 3), 2), 1), -8, 8)",
    "description": "Negative three-session mean log return normalized by trailing 20-session annualized volatility, smoothed over two observations, cross-sectionally median-neutralized, lagged one completed session, and clipped."
