{
  "factor_id": "miner_1_20270830_stress_conditional_trend",
  "factor_name": "VIX-Stress-Conditional Risk-Adjusted Trend 30d",
  "version": "1.0",
  "calculation": {
    "expression": "lag1(30d_return / lag1(30d_realized_volatility)) * (1 - 0.25 * clip(max(lag1(VIX_zscore_60d),0),0,3))",
    "description": "Ranks assets by lagged 30-session momentum scaled by 30-session realized volatility, with the trend signal attenuated under elevated lagged VIX stress. All inputs are lagged to avoid look-ahead."
  },
  "dependencies": [
    "close",
    "VIX close"
  ],
  "parameters": {
    "momentum_window": 30,
    "volatility_window": 30,
    "vix_zscore_window": 60,
    "stress_amplitude": 0.25,
    "stress_floor": 0,
    "stress_cap": 3,
    "lag_sessions": 1
  },
