{
  "factor_id": "miner_3_20270730_momentum40_volscaled",
  "factor_name": "40-Day Volatility-Scaled Momentum",
  "version": "1.0",
  "calculation": {
    "expression": "shift(1, pct_change(close,40) / (std(pct_change(close,1),40) * sqrt(252) + 0.01))",
    "description": "Previous completed session's 40-session price momentum divided by annualized 40-session return volatility, with a small stabilizing denominator floor. Higher values indicate stronger risk-adjusted trend."
  },
  "dependencies": ["close"],
  "parameters": {"lookback_sessions": 40, "volatility_window": 40, "min_periods": 30, "annualization": 252, "denominator_floor": 0.01, "signal_lag_sessions": 1},
