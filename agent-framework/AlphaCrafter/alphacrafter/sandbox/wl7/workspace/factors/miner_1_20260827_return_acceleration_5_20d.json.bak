{
  "factor_id": "miner_1_20260827_return_acceleration_5_20d",
  "factor_name": "Short-versus-medium return acceleration",
  "version": "2026-08-27",
  "calculation": {
    "expression": "close[t]/close[t-5] - 1 - 0.25*(close[t]/close[t-20] - 1)",
    "description": "Five-day return minus the equivalent average daily component of the trailing 20-day return. Values are observable at completed close t and are negatively associated with next-day cross-sectional returns in validation; consumers should preserve the measured negative direction or invert the signal explicitly."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "short_window": 5,
    "long_window": 20,
    "short_weight": 1.0,
    "long_scaling": 0.25,
    "forward_horizon_days": 1,
    "minimum_cross_section": 8
  },
