{
  "factor_id": "miner_3_20291022_risk_adjusted_trend40_reversal",
  "factor_name": "Risk-adjusted 40-day trend reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(close[t-1] / close[t-41] - 1) / std(pct_change(close)[t-20:t-1])",
    "description": "Negative lagged 40-trading-day return divided by lagged 20-day realized volatility; higher values favor assets with weaker recent risk-adjusted trends. Computed cross-sectionally across the 15 tradable benchmark instruments."
  },
  "dependencies": ["close", "pct_change"],
  "parameters": {"trend_lookback": 40, "volatility_lookback": 20, "volatility_min_periods": 12, "lag": 1, "minimum_cross_section": 8},
  "validation": {
