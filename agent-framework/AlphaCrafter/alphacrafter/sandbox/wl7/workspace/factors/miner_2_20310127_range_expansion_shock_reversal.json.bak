{
  "factor_id": "miner_2_20310127_range_expansion_shock_reversal",
  "factor_name": "Range-Expansion Shock Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-zscore_20(close_return) * clip((high-low)/close / median20((high-low)/close), 0, 5), cross_sectional_median_center, lag_1",
    "description": "Reverses standardized close-to-close shocks, with stronger reversal scores for unusually wide daily trading ranges. The signal is median-centered cross-sectionally and lagged one completed session to avoid look-ahead."
  },
  "dependencies": ["close", "high", "low"],
  "parameters": {"return_vol_window": 20, "range_baseline_window": 20, "minimum_observations": 12, "range_clip_upper": 5, "lag_sessions": 1, "universe_size": 15},
  "validation": {
