{
  "factor_id": "miner_2_20310908_ewma40_residual_reversal20",
  "factor_name": "EWMA-40 Volatility-Scaled Smoothed Cross-Asset Residual Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-((0.4*(ret_5d-cross_sectional_mean(ret_5d)))+(0.6*(ret_10d-cross_sectional_mean(ret_10d))))/(0.5*ewm_std(ret_1d,span=20)+0.5*rolling_std(ret_1d,window=40))",
    "description": "Cross-asset residual reversal from 5-day and 10-day returns, scaled by a blended EWMA-20 and rolling-40 volatility estimate; signal is lagged by one completed session to prevent lookahead. Higher values indicate stronger expected 20-day forward return."
  },
  "dependencies": ["close"],
  "parameters": {
    "short_return_window": 5,
    "long_return_window": 10,
    "short_weight": 0.4,
    "long_weight": 0.6,
    "ewma_vol_span": 20,
    "rolling_vol_window": 40,
    "rolling_vol_min_periods": 25,
    "ewma_vol_min_periods": 15,
    "signal_lag": 1,
    "admission_horizon_days": 20,
    "minimum_cross_section": 8
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2031-09-08",
    "last_validated": "2031-09-08",
    "metrics": {
      "ic": 0.02548607,
      "icir": 0.09028681,
      "horizon_days": 20,
      "valid_dates": 1314,
      "average_instruments": 15.0,
      "factor_coverage": 0.442609,
      "approximate_rank_turnover": 0.106969,
      "ic_hit_ratio": 0.53349,
      "max_abs_library_correlation": null
    },
    "regime_notes": "Positive in first and final thirds (+0.04410 and +0.03633) but negative in middle third (-0.00397); regime concentration remains a monitoring risk. Daily 1d and 5d IC/ICIR did not meet admission gates; admission is specifically at the 20-day horizon.",
    "signal_artifact": "scripts/miner_2_20310908_ewma40_residual_reversal20_signal.csv",
    "ic_artifact": "scripts/miner_2_20310908_ewma40_residual_reversal20_ic.csv"
  },
  "tags": ["reversal", "cross_asset", "volatility_scaled", "residual", "medium_horizon"]
}
