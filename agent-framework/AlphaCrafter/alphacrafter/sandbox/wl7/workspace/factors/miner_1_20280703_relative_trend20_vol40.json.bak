{
  "factor_id": "miner_1_20280703_relative_trend20_vol40",
  "factor_name": "Relative 20d Trend versus Cross-Asset Median, Volatility Scaled",
  "version": "1.0",
  "calculation": {
    "expression": "rank_cs(((sum_return_20d - cross_sectional_median(sum_return_20d)) / (std_return_40d * sqrt(20) + 1e-8)).shift(1))",
    "description": "For each tradable asset, subtract the same-day cross-sectional median 20-session return, scale by its trailing 40-session return volatility, lag one completed session, and rank cross-sectionally. Positive values identify relative trend leaders."
  },
  "dependencies": [
    "close",
    "pct_change"
  ],
  "parameters": {
    "trend_window": 20,
    "volatility_window": 40,
    "min_trend_observations": 15,
    "min_volatility_observations": 25,
    "lag_sessions": 1,
    "forward_horizon_sessions": 10,
    "minimum_cross_section": 8
  },
