{
  "factor_id": "miner_3_20330613_range60_reversal",
  "factor_name": "60-day range-position volatility-scaled reversal",
  "version": "1.0",
  "calculation": {
    "expression": "(0.5 - (close - rolling_min(close,60)) / (rolling_max(close,60)-rolling_min(close,60)+epsilon)) / rolling_std(pct_change(close),20)",
    "description": "Ranks assets favoring prices near the lower end of their trailing 60-session range, scaled by inverse 20-session realized volatility; signal is shifted one completed session to prevent lookahead."
  },
  "dependencies": ["close"],
  "parameters": {"range_window": 60, "range_min_periods": 45, "vol_window": 20, "vol_min_periods": 15, "lag_sessions": 1, "epsilon": 1e-12, "horizons_tested": [1,5,10,20]},
  "validation": {
