{
  "factor_id": "miner_2_20330502_skip5_volnorm_reversal",
  "factor_name": "Skip-five-day volatility-normalized reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-pct_change(close,5) / (rolling_std(pct_change(close,1),20) * sqrt(5)), lagged 1 session",
    "description": "Ranks assets by inverse five-session return scaled by recent 20-session volatility. The one-session lag ensures only completed-session data are used; positive values indicate recent losers with lower normalized risk."
  },
  "dependencies": ["close"],
  "parameters": {"lookback_return_days": 5, "volatility_window": 20, "volatility_min_periods": 15, "execution_lag_days": 1, "admission_horizon_days": 20},
