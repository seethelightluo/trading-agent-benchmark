{
  "factor_id": "breadth_conditional_20d_momentum_reversal",
  "factor_name": "Breadth-Conditional 20-Day Momentum/Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "(gate > 0 ? r_20d : -r_20d) / (std(log_return,60)*sqrt(20)), gate=median_cross_section(r_20d)",
    "description": "Uses the lagged cross-asset median 20-day return as a regime gate: momentum when breadth is positive and reversal when breadth is non-positive; normalizes asset 20-day return by 60-day volatility.",
