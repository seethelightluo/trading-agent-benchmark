{
  "factor_id": "miner_3_20270604_smoothed_intraday_reversal",
  "factor_name": "Smoothed Intraday Range-Normalized Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(rolling_sum(close/open - 1, 3) / (3 * lagged_rolling_mean(high/low - 1, 20))) lagged by 1 session",
    "description": "Fade the prior three-session cumulative intraday return, normalized by the prior 20-session mean daily high-low range. All OHLC inputs are lagged before forecasting the next-session return."
  },
  "dependencies": ["open", "close", "high", "low"],
  "parameters": {"intraday_window": 3, "range_window": 20, "minimum_range_observations": 10, "forward_horizon_days": 1, "universe_size": 15},
  "validation": {
