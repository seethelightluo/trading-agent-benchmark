{
  "factor_id": "miner_3_20290423_lowdisp_riskadj_reversal20",
  "factor_name": "Low-dispersion risk-adjusted 20-day reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-((close[t-1]/close[t-21]-1) / rolling_std(pct_change(close),20)[t-1]) when cross_sectional_mean(rolling_std(pct_change(close),20))[t-1] is below its trailing 120-day 40th percentile; otherwise 0",
    "description": "A lagged 20-session return reversal normalized by lagged 20-session volatility, active only in relatively low cross-asset dispersion regimes. All inputs are lagged and the target is the 10-trading-day forward return."
  },
  "dependencies": ["close"],
  "parameters": {"lookback_return_days": 20, "volatility_days": 20, "dispersion_percentile_window": 120, "low_dispersion_quantile": 0.40, "forward_horizon_days": 10},
