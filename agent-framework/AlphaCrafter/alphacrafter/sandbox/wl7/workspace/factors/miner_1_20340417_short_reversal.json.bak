{
  "factor_id": "miner_1_20340417_short_reversal",
  "factor_name": "Risk-normalized 5-day short-horizon reversal",
  "version": "1.0",
  "calculation": {
    "expression": "(-(close/close.shift(5)-1)/(rolling_std(pct_change(close),60)*sqrt(5)+1e-12)).shift(1)",
    "description": "Negative trailing five-session return divided by 60-session realized daily volatility, lagged one completed session to prevent look-ahead. Intended for 10-session forward cross-sectional ranking."
  },
  "dependencies": ["close"],
  "parameters": {"lookback_return_days": 5, "volatility_days": 60, "volatility_scaling": "sqrt(5)", "signal_lag_days": 1, "forward_horizon_days": 10},
