{
  "factor_id": "miner_3_20290702_residual_beta_reversal10",
  "factor_name": "beta-residualized volatility-scaled ten-day reversal",
  "version": "1.0",
  "calculation": {
    "expression": "(-(return_10d - beta_60d(asset,equal_weight_market) * market_return_10d) / volatility_20d)",
    "description": "Favors assets whose lagged ten-day return underperformed their rolling-60-day beta-implied equal-weight cross-asset move, scaled by lagged 20-day volatility. Beta, returns, and volatility use only information available through the prior completed day."
  },
  "dependencies": ["close"],
  "parameters": {
    "reversal_window_days": 10,
    "beta_window_days": 60,
    "beta_min_periods": 40,
    "market_definition": "equal-weight mean of the 15 tradable benchmark assets",
    "market_return_window_days": 10,
    "volatility_window_days": 20,
    "volatility_min_periods": 15,
    "forward_horizon_days": 20,
    "minimum_cross_section": 8
  },
  "validation": {
