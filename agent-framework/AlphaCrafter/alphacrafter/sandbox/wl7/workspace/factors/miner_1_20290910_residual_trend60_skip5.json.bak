{
  "factor_id": "miner_1_20290910_residual_trend60_skip5",
  "factor_name": "Residual 60-day trend, five-day skip, volatility scaled",
  "version": "1.0",
  "calculation": {
    "expression": "(log(close[t-5]/close[t-65]) - cross_sectional_median(log(close[t-5]/close[t-65]))) / rolling_std(log(close/close[-1]),60)",
    "description": "At each decision date, measure each asset's lagged 60-day return excluding the most recent five sessions relative to the universe median, then scale by trailing 60-day daily log-return volatility. All rolling inputs are shifted to exclude the decision day's close. Negative historical IC indicates the factor is used in reversal direction by downstream portfolio construction."
  },
  "dependencies": ["close"],
  "parameters": {"lookback_days": 60, "skip_days": 5, "volatility_window": 60, "forward_horizon_days": 10, "minimum_cross_section": 8},
