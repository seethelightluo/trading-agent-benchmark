  "version": "1.0",
  "calculation": {
    "expression": "-((close / close.shift(20) - 1) / rolling_std(pct_change,20)) * clip(rolling_std(pct_change,20) / rolling_std(pct_change,60), 0.25, 4.0), then cross-sectional median residualization and one-day lag",
