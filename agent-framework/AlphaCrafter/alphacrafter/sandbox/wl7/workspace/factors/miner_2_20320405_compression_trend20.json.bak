{
  "factor_id": "miner_2_20320405_compression_trend20",
  "factor_name": "Compression-conditioned risk-adjusted 20-day trend",
  "version": "1.0",
  "calculation": {
    "expression": "lag1((log(close/close[-20])) / rolling_std(log_returns,40)) if rolling_std(log_returns,10)[-1] < rolling_std(log_returns,60)[-1], else missing",
    "description": "Ranks assets by 20-day log momentum scaled by 40-day daily log-return volatility, activated only when lagged short-term volatility is below lagged 60-day volatility. The one-session lag prevents look-ahead and the compression condition seeks continuation after volatility contraction. Cross-sectional rank usage is recommended."
  },
  "dependencies": ["close"],
  "parameters": {
    "momentum_window": 20,
    "scaling_volatility_window": 40,
    "short_volatility_window": 10,
    "long_volatility_window": 60,
    "activation": "short_vol[-1] < long_vol[-1]",
    "signal_lag_sessions": 1,
    "minimum_cross_section": 8
  },
  "validation": {
