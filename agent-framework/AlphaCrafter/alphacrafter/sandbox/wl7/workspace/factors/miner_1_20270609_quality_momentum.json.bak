{
  "factor_id": "miner_1_20270609_quality_momentum",
  "factor_name": "Volatility-Adjusted Momentum with Directional Consistency",
  "version": "1.0",
  "calculation": {
    "expression": "(close / close.shift(20) - 1) / rolling_std(pct_change(close),20) * (0.5 + rolling_mean(pct_change(close)>0,20))",
    "description": "Lagged 20-session momentum, scaled by realized volatility and rewarded for the fraction of positive daily returns in the trailing 20 sessions. The signal is shifted one completed day to avoid look-ahead."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "momentum_window": 20,
    "volatility_window": 20,
    "consistency_window": 20,
    "minimum_vol_observations": 15,
    "forward_horizon_days": 10,
    "signal_lag_days": 1
  },
