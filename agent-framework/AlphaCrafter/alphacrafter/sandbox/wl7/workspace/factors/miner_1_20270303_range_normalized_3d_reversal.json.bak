{
  "factor_id": "miner_1_20270303_range_normalized_3d_reversal",
  "factor_name": "Range-Normalized Three-Day Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-sum(return,3) / (sqrt(3)*rolling_std(return,20)*(1+rolling_range20/close))",
    "description": "Lagged cross-asset short-term reversal, normalized by recent realized volatility and attenuated when the recent 20-session price range is wide. Shifted one completed session to prevent look-ahead."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "reversal_window": 3,
    "volatility_window": 20,
    "range_window": 20,
    "minimum_observations": 15,
    "lag": 1
  },
