{
  "factor_id": "miner_2_20270402_residual_reversal",
  "factor_name": "Market-Residualized Five-Day Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-rolling_sum_5(residual_return) / rolling_std_20(residual_return), shifted_1; residual_return = asset_return - rolling_beta_60(asset, equal_weight_benchmark)*benchmark_return",
    "description": "Ranks assets higher when their recent five-session return has been weak relative to the equal-weight cross-asset benchmark, scaled by residual volatility. Beta and signal are lagged to prevent look-ahead."
  },
  "dependencies": ["close"],
  "parameters": {"residual_window": 60, "reversal_window": 5, "volatility_window": 20, "min_beta_observations": 40, "benchmark": "equal_weight_mean_return", "signal_lag": 1},
