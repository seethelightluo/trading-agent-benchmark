{
  "factor_id": "miner_3_20350108_volume_confirmed_reversal5",
  "factor_name": "Volume-confirmed 5-day reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-pct_change(close,5) * (1 + clip(log(volume / rolling_median(volume,40)), -1, 1))",
    "description": "Reverses the trailing five-day return and scales it by bounded abnormal volume. Higher values indicate recent losses (or gains) accompanied by unusual volume, with the signal computed only from data available at the decision date."
  },
  "dependencies": ["close", "volume"],
  "parameters": {"return_window_days": 5, "volume_median_window_days": 40, "volume_clip_log": [-1,1], "minimum_cross_section": 8},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2035-01-05",
    "validation_timestamp": "2035-01-08T00:00:00Z",
    "metrics": {
