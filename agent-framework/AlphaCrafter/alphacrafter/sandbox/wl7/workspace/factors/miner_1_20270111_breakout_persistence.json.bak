{
  "factor_id": "miner_1_20270111_breakout_persistence",
  "factor_name": "Volatility-normalized breakout persistence",
  "version": "1.0",
  "calculation": {
    "expression": "lag1((close/close.shift(20)-1) / (rolling_std(pct_change(close),20)*sqrt(20)+1e-8))",
    "description": "Twenty-session trend return normalized by realized volatility; all inputs are shifted one completed session to prevent look-ahead. Higher values indicate persistent risk-adjusted breakouts."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "trend_lookback": 20,
    "volatility_lookback": 20,
    "signal_lag": 1,
    "epsilon": 1e-08
  },
