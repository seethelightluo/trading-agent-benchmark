{
  "factor_id": "miner_3_20260924_overnight_gap_reversal",
  "factor_name": "Overnight Gap Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(open_t / close_{t-1} - 1)",
    "description": "Cross-sectional reversal score of the prior close-to-current open overnight gap; larger values favor assets with more negative overnight gaps.",
    "signal_lag": "Computed using completed day t open and prior completed close; paired with close_t to close_{t+1} forward return for validation."
  },
  "dependencies": [
    "open",
    "close"
  ],
  "parameters": {
    "forward_horizon_days": 1,
    "minimum_cross_section": 8,
    "rank_method": "spearman"
  },
