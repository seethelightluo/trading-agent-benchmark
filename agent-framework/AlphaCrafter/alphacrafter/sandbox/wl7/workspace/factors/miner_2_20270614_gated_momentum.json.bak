{
  "factor_id": "miner_2_20270614_gated_momentum",
  "factor_name": "Risk-scaled 10-session momentum with 60-session trend gate",
  "version": "2027-06-14",
  "calculation": {
    "expression": "shift_1((pct_change(close,10) / (std(pct_change(close),20)*sqrt(10))) * (1 if pct_change(close,60)>=0 else -0.35))",
    "description": "Ranks assets by lagged ten-session momentum normalized by twenty-session realized volatility. A positive 60-session trend retains the signal; a negative trend reverses and attenuates it. All inputs are shifted one completed session before forward returns."
  },
  "dependencies": ["close"],
  "parameters": {"momentum_window": 10, "volatility_window": 20, "trend_window": 60, "negative_trend_multiplier": -0.35, "lag_sessions": 1, "universe_size": 15},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2027-06-13",
    "validation_date": "2027-06-14",
    "metrics": {
      "admission_horizon_sessions": 5,
      "ic": 0.0168758,
      "icir": 0.86953,
      "hit_rate": 0.51788,
      "ic_dates": 1902,
      "average_instruments": 14.6,
      "coverage": 0.74946,
      "rank_turnover": 0.14145,
      "max_abs_library_correlation": null,
      "decay_ic_1d": 0.00697626,
      "decay_ic_10d": 0.01373326,
      "decay_ic_20d": 0.00520964
    },
    "thresholds": {"min_abs_daily_ic": 0.007, "min_abs_daily_icir": 0.084},
    "regime_notes": "Daily IC positive in 2020-2022 (+0.01671), near flat in 2023-2024 (-0.00144), and modestly positive in 2025-2027 (+0.00208). Five-session horizon is the admission horizon; uncertainty is material in the 15-asset cross-section.",
    "signal_provenance": "scripts/miner_2_20270614_gated_momentum_signal.csv"
  },
