{
  "factor_id": "miner_2_20350917_breadth_trend_blend_h40",
  "factor_name": "Breadth-conditioned 40/60 volatility-normalized trend blend",
  "version": "1.0",
  "calculation": {
    "expression": "((0.4*((close/close.shift(20))-1)/(rolling_std(pct_change,40)*sqrt(20)) + 0.6*((close/close.shift(60))-1)/(rolling_std(pct_change,40)*sqrt(60))) * sign(2*breadth20-1)) shifted one session",
    "description": "Ranks assets using a 40% 20-day and 60% 60-day volatility-normalized momentum blend, multiplied by the lagged cross-asset sign of the fraction of tradable assets with positive 20-day return. All inputs are lagged before the forward 20-trading-day return evaluation."
  },
  "dependencies": ["close", "pct_change"],
  "parameters": {
    "short_window": 20,
    "long_window": 60,
    "volatility_window": 40,
    "short_weight": 0.4,
    "long_weight": 0.6,
    "breadth_window": 20,
    "forward_horizon": 20,
    "minimum_cross_section": 8,
    "universe_size": 15
  },
