{
  "factor_id": "miner_1_20310922_regime_adaptive_residual_momentum",
  "factor_name": "Regime-adaptive volatility-scaled residual momentum",
  "version": "1.0",
  "calculation": {
    "expression": "where(M_t < rolling_quantile(rolling_sum(mean_cross_section(pct_change(close)),60),252,0.333), (ret20-cross_section_mean(ret20))/vol30, -(ret20-cross_section_mean(ret20))/vol30).shift(1)",
    "description": "Volatility-scaled 20-day residual momentum. In the trailing weakest-market-return regime it follows relative momentum; otherwise it reverses relative momentum. The one-day lag ensures only completed data are used."
  },
  "dependencies": ["close"],
  "parameters": {"momentum_window": 20, "volatility_window": 30, "vol_min_periods": 20, "market_window": 60, "regime_quantile_window": 252, "regime_quantile": 0.333, "lag_days": 1, "forward_horizon_days": 10},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2031-09-05",
    "last_validated": "2031-09-22T00:00:00Z",
    "metrics": {
      "ic": 0.04224126,
      "icir": 0.14196191,
      "ic_hit_ratio": 0.55255,
      "ic_observations": 1332,
      "average_instruments": 11.34,
      "factor_coverage": 0.35595,
      "turnover": 0.11064,
      "decay_ic_1d": 0.02075798,
      "decay_ic_5d": 0.05097496,
      "decay_ic_20d": 0.00895144,
      "max_abs_library_correlation": null
    },
    "regime_notes": "Chronological thirds of 10-day IC: 0.05770249, 0.03654791, 0.03247338. Conservative interpretation due to 15-asset cross-section; each IC date required at least 8 valid assets and average valid assets was 11.34.",
    "universe": {"assets": 15, "minimum_valid_assets_per_date": 8},
    "signal_artifact": "scripts/miner_1_20310922_regime_adaptive_signal.csv",
    "ic_artifact": "scripts/miner_1_20310922_regime_adaptive_ic_10d.csv"
  },
  "tags": ["momentum", "reversal", "cross-asset", "volatility-scaled", "regime-conditioned"],
  "lookahead_control": "All inputs are shifted one completed trading day before forward returns are evaluated."
}
