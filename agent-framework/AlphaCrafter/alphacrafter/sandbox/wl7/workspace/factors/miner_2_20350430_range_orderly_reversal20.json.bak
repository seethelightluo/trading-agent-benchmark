{
  "factor_id": "miner_2_20350430_range_orderly_reversal20",
  "factor_name": "Range-conditioned volatility-normalized short-term reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(sum(return,5) / std(return,20)) * clip(1.25 - 0.5 * mean((high-low)/close,5) / (mean((high-low)/close,60)+epsilon), 0.5, 1.25)",
    "description": "Fades the trailing five-day return after volatility normalization, modestly favoring orderly recent ranges over panic-range selloffs. Signal is evaluated using information available through date t and predicts the next 20 trading days."
  },
  "dependencies": ["close", "high", "low"],
  "parameters": {"return_window": 5, "volatility_window": 20, "range_recent_window": 5, "range_baseline_window": 60, "range_cap": [0.5, 1.25]},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2035-04-27",
    "metrics": {
      "horizon_days": 20,
      "ic": 0.0367963086,
