{
  "factor_id": "miner_1_20330822_momentum_acceleration",
  "factor_name": "20-minus-60 session momentum acceleration",
  "version": "1.0",
  "calculation": {
    "expression": "shift(ret_pct_change.rolling_sum(20) - ret_pct_change.rolling_sum(60), 1)",
    "description": "Lagged difference between medium-horizon and long-horizon cumulative returns; positive values identify assets whose recent momentum is strengthening relative to their long trend. The one-session lag prevents look-ahead."
  },
  "dependencies": ["close"],
  "parameters": {"short_window": 20, "long_window": 60, "min_periods_short": 15, "min_periods_long": 45, "lag": 1, "universe_size": 15},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2033-08-21",
    "metrics": {
      "horizon_days": 10,
      "ic": 0.031114,
      "icir": 0.102156,
      "hit_ratio": 0.5380,
      "valid_dates": 1814,
      "average_instruments": 15.0,
      "coverage": 0.5050,
      "turnover": 0.0494,
      "max_abs_library_correlation": null,
      "recent_180_ic": 0.022781,
      "recent_180_icir": 0.075998,
      "recent_500_ic": 0.017647,
      "recent_500_icir": 0.055842,
      "recent_750_ic": 0.016988,
