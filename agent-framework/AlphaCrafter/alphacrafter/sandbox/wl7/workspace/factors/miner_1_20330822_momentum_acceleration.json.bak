      "decay_ic": {"1": 0.006779, "5": 0.029189, "10": 0.031114, "20": 0.050504},
      "signal_artifact": "scripts/miner_1_20330822_momentum_acceleration_signal.csv"
    },
    "regime_notes": "Full-history daily paper IC and ICIR pass the benchmark gates. IC is positive in all three chronological thirds at 20 days and positive in recent 180/500/750-session windows, though recent ICIR is below the admission threshold; interpret small-cross-section uncertainty conservatively.",
    "validation_timestamp": "2033-08-22T00:00:00Z"
