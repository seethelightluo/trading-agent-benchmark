{
  "factor_id": "miner_1_20270208_downside_trend_15d",
  "factor_name": "Downside-Risk Adjusted Persistent Trend",
  "version": "20270208",
  "calculation": {
    "expression": "shift1((close/close[-15]-1)/(sqrt(rolling_mean(max(-pct_change(close),0)^2,20))*sqrt(20))*(0.5+rolling_mean(I[pct_change(close)>0],15)))",
    "description": "Fifteen-day momentum scaled by trailing downside deviation and rewarded for positive-day persistence; shifted one completed day to prevent lookahead."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "momentum_window": 15,
    "downside_window": 20,
    "persistence_window": 15,
    "persistence_floor": 0.5,
    "lag_days": 1
  },
