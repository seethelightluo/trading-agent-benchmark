{
  "factor_id": "miner_1_20290813_residual_reversal20",
  "factor_name": "Cross-Asset Residual Reversal Scaled by Idiosyncratic Volatility (20d)",
  "version": "1.0",
  "calculation": {
    "expression": "-(asset_return_20d_lagged - cross_sectional_median(asset_return_20d_lagged)) / rolling_std40(lagged_daily_return - cross_sectional_median(lagged_daily_return))",
    "description": "For each tradable benchmark, take the negative of its prior 20-trading-day return relative to the universe median, and scale by its prior 40-day cross-sectional-residual daily volatility. The signal is formed only from data available before the decision date; larger values indicate stronger residual mean-reversion opportunity."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "return_lookback_days": 20,
    "volatility_lookback_days": 40,
    "volatility_min_periods": 25,
    "cross_sectional_min_assets": 8,
    "forward_horizon_days": 20
  },
