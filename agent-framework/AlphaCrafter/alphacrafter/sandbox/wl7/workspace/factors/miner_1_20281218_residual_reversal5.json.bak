{
  "factor_id": "miner_1_20281218_residual_reversal5",
  "factor_name": "Cross-Asset Beta-Residual Five-Day Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-[(sum5(return_i) - beta_i,60 * sum5(equal_weight_market_return))] / (std30(return_i) * sqrt(5))",
    "description": "For each tradable asset, subtract its rolling 60-day beta exposure to the equal-weight 15-asset benchmark from its five-day return, then take the negative residual and scale by 30-day volatility. Cross-sectionally demean the resulting signal. Higher values indicate stronger idiosyncratic short-term reversal after removing common-market movement."
  },
  "dependencies": ["close"],
  "parameters": {"residual_window_days": 60, "residual_min_periods": 40, "signal_horizon_days": 5, "volatility_window_days": 30, "volatility_min_periods": 20, "forward_return_horizon_days": 20, "universe_size": 15},
