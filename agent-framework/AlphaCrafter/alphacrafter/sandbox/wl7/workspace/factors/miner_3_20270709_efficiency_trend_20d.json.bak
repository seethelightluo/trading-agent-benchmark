{
  "factor_id": "miner_3_20270709_efficiency_trend_20d",
  "factor_name": "Lagged 20-day directional efficiency trend",
  "version": "1.0",
  "calculation": {
    "expression": "shift(1, pct_change(close,20) / rolling_sum(abs(pct_change(close,1)),20))",
    "description": "Ranks assets by the fraction of their recent 20-session path represented by net return, rewarding persistent directional trends and penalizing choppy paths. Signal is lagged one completed session before forward-return evaluation."
  },
  "dependencies": ["close"],
  "parameters": {"lookback_days": 20, "path_window_days": 20, "minimum_observations": 15, "lag_sessions": 1},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2027-07-08",
    "last_validated": "2027-07-09T00:00:00Z",
    "metrics": {
      "daily_paper_ic": 0.01463047,
      "daily_paper_icir": 0.71755217,
      "ic_hit_ratio": 0.51380928,
      "validation_dates": 1919,
      "average_instruments_per_date": 14.6050,
      "factor_coverage": 0.75118230,
      "rank_turnover": 0.09654509,
      "decay_5d_ic": 0.01851663,
      "decay_5d_icir": 0.91212924,
      "decay_10d_ic": 0.03767850,
      "decay_10d_icir": 1.83929537,
      "max_abs_library_correlation": null
    },
    "regime_notes": "Daily IC remained positive in 2020-2022 (+0.02288), was weak but positive in 2023-2024 (+0.00398), and recovered in 2025-2027 (+0.01353). Small cross-asset universe requires conservative interpretation.",
    "signal_artifact": "scripts/miner_3_20270709_efficiency20_signal.csv",
    "methodology": "Cross-sectional Spearman IC on dates with at least 8 valid tradable instruments; forward returns use close[t+h]/close[t]-1 and factor uses data through t-1 only."
  },
  "tags": ["trend", "momentum", "directional-efficiency", "cross-asset", "risk-aware"]
}
