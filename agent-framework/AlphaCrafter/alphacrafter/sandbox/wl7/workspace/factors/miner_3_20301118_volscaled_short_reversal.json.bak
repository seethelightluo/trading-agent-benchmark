{
  "factor_id": "miner_3_20301118_volscaled_short_reversal",
  "factor_name": "Volatility-Scaled 3-Day Cross-Asset Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "clip((median_cs((-log(close_t/close_{t-3}))/rolling_std(log_returns,20)*sqrt(252)) - ((-log(close_t/close_{t-3}))/rolling_std(log_returns,20)*sqrt(252)))_{t-1}, -8, 8)",
    "description": "Ranks assets positively after unusually weak recent three-session performance, scaled by each asset's 20-session realized volatility, with cross-sectional median neutralization and one-session lag. Higher values indicate expected short-horizon rebound."
  },
  "dependencies": ["close"],
  "parameters": {
    "lookback_sessions": 3,
    "volatility_window_sessions": 20,
    "annualization": 252,
    "cross_sectional_neutralization": "median",
    "lag_sessions": 1,
    "clip": [-8, 8],
    "universe_size": 15
  },
  "validation": {
    "status": "EFFECTIVE",
    "validation_timestamp": "2030-11-18",
    "period": "2020-01-01 through 2030-11-15",
    "regime_notes": "Validated across the full synthetic cross-asset history, including multiple bull, bear, inflation, rate, commodity, and crypto regimes. Short-horizon reversal is strongest at one day and decays materially by 20 sessions.",
    "metrics": {
      "daily_forward_horizon_sessions": 1,
      "ic": 0.01288240,
