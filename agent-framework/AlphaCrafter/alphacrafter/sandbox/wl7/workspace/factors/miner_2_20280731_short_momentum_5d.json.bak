  "factor_id": "miner_2_20280731_short_momentum_5d",
  "factor_name": "Short-Term Reversal (Negative 5-Day Return)",
  "version": "2028-07-31",
  "calculation": {
    "expression": "(-1) * (close[t-1] / close[t-6] - 1)",
    "description": "One-session-lagged negative five-session return. Positive values identify recent cross-sectional losers and therefore represent a short-term reversal signal; the exact sign is preserved in the signal artifact.",
