{
  "factor_id": "miner_1_20331017_highdisp_beta_reversal",
  "factor_name": "High-Dispersion Beta-Neutral Medium Reversal",
  "version": "1.1",
  "calculation": {
    "expression": "where(cross_sectional_mean(rolling_std(returns,20)) > rolling_median(cross_sectional_mean(rolling_std(returns,20)),120), -(return_10d - beta_60 * benchmark_return_10d) / (annualized_volatility_40 + epsilon), 0).shift(1)",
    "description": "Remove each asset's 60-session beta exposure to the equal-weight 15-asset benchmark from its 10-session return, invert and volatility-scale the residual, and activate only when cross-asset dispersion exceeds its trailing 120-session median. Lag one completed session."
  },
  "dependencies": ["close", "pct_change"],
  "parameters": {"benchmark": "equal_weight_mean_of_15_tradable_assets", "beta_window": 60, "beta_min_periods": 40, "return_horizon": 10, "volatility_window": 40, "volatility_min_periods": 25, "dispersion_window": 20, "dispersion_min_periods": 15, "dispersion_threshold_window": 120, "dispersion_threshold_min_periods": 60, "activation": "dispersion > trailing_120_median", "lag_sessions": 1, "epsilon": 1e-12, "forward_evaluation_horizon": 10},
