{
  "factor_id": "miner_2_20320517_relative_reversal3",
  "factor_name": "Cross-sectional relative three-day reversal normalized by volatility",
  "version": "1.0",
  "calculation": {
    "expression": "-(sum(log_return, 3d) - cross_sectional_median(sum(log_return, 3d))) / rolling_std(log_return, 20d)",
    "description": "At each completed date, rank assets that underperformed the cross-sectional three-day median more highly, scaling the relative shock by each asset's trailing 20-day daily log-return volatility. All inputs are lag-safe through date t. Higher values indicate stronger mean-reversion opportunity."
  },
  "dependencies": ["close"],
  "parameters": {"shock_window_days": 3, "volatility_window_days": 20, "cross_section_center": "median", "minimum_cross_section": 8},
  "validation": {
    "status": "EFFECTIVE",
    "period": {"start": "2020-01-01", "end": "2032-05-15", "cutoff": "2032-05-15"},
    "metrics": {
      "horizon_days": 1,
      "ic": 0.031126,
      "icir": 0.094101,
