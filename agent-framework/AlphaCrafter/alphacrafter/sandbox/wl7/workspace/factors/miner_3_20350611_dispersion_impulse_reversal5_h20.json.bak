{
  "factor_id": "miner_3_20350611_dispersion_impulse_reversal5_h20",
  "factor_name": "Dispersion-Impulse Residual Reversal 5D, 20D Horizon",
  "version": "1.0",
  "calculation": {
    "expression": "lag1((-(close/close_shift5-1) - cross_sectional_median(-(close/close_shift5-1))) / rolling_std(pct_change,20)) active when median_asset_vol20 > rolling_median(median_asset_vol20,60) and median_asset_vol20 > lag5(median_asset_vol20)",
    "description": "Cross-sectional five-day reversal, residualized by the daily median and volatility scaled, activated during a dispersion impulse. All signal inputs are lagged one completed trading day."
  },
  "dependencies": ["close", "pct_change"],
  "parameters": {
    "reversal_window": 5,
    "volatility_window": 20,
    "dispersion_window": 60,
    "dispersion_lag": 5,
    "min_periods": {"volatility": 15, "dispersion": 40},
    "activation_quantile": "rolling median"
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2035-06-10; active observations primarily 2027-06-02 through 2035-06-10",
    "last_validated": "2035-06-11",
    "metrics": {
