  "factor_name": "30-Day Cross-Asset Relative Reversal Risk-Scaled",
  "version": "1.0",
  "calculation": {
    "expression": "-((close_return_30d - cross_sectional_mean_return_30d) / (annualized_volatility_30d + 0.01)).shift(1)",
    "description": "Ranks assets favoring recent underperformers relative to the contemporaneous tradable-universe mean, scaled by own 30-day volatility. The one-session lag prevents look-ahead bias."
  },
  "dependencies": ["close"],
  "parameters": {"lookback_days": 30, "volatility_window": 30, "annualization": 252, "volatility_floor": 0.01, "lag_days": 1, "universe": "15 tradable benchmark instruments"},
