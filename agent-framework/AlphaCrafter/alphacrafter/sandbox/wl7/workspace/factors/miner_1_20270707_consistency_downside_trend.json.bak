{
  "factor_id": "miner_1_20270707_consistency_downside_trend",
  "factor_name": "30D Consistency and Downside-Risk-Scaled Trend",
  "version": "1.0",
  "calculation": {
    "expression": "lag1(return_30d * mean(I[daily_return>0],30) / (sqrt(mean(min(daily_return,0)^2,30)) + epsilon))",
    "description": "Ranks assets by prior-session-lagged 30-day return, amplified by the fraction of positive sessions and scaled by downside volatility. All rolling inputs are formed only from data available at the signal date before applying a one-session lag."
  },
  "dependencies": ["close"],
  "parameters": {"trend_window": 30, "minimum_observations": 20, "epsilon": 1e-12, "lag_sessions": 1},
  "validation": {
