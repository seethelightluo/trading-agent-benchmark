{
  "factor_id": "miner_2_20270823_residual_momentum_20d",
  "factor_name": "Market-Residual Risk-Adjusted Momentum 20D",
  "version": "1.0",
  "calculation": {
    "expression": "shift1(rolling_sum(residual_return,20) / (rolling_std(residual_return,20)+0.01))",
    "description": "For each tradable asset, estimate rolling 60-session beta to the equal-weight cross-asset return, subtract beta times market return from daily return, then rank the one-session-lagged 20-session cumulative residual return normalized by residual volatility. The lag ensures only completed data are used."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "market": "equal_weight_mean_of_available_15_assets",
    "beta_window": 60,
    "beta_min_periods": 40,
    "signal_window": 20,
    "signal_min_periods": 15,
    "volatility_floor": 0.01,
    "lag_sessions": 1,
    "forward_horizon": 10
  },
