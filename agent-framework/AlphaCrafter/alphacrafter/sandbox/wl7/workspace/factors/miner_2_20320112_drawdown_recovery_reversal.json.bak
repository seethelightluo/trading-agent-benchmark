{
  "factor_id": "miner_2_20320112_drawdown_recovery_reversal",
  "factor_name": "Lagged 20-day drawdown-recovery reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-shift(pct_change(close,20) / abs(rolling_min(close/rolling_max(close,20)-1,20)), 1)",
    "description": "One-session-lagged reversal of 20-session return normalized by the absolute worst drawdown observed over the trailing peak-relative 20-session window. Higher values favor assets with weaker recovery efficiency after recent drawdowns."
  },
  "dependencies": ["close"],
  "parameters": {
    "return_lookback_days": 20,
    "peak_window_days": 20,
    "drawdown_window_days": 20,
    "minimum_observations": 15,
    "signal_lag_days": 1,
    "forward_horizon_days": 10
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01/2032-01-12",
    "validation_date": "2032-01-12T00:00:00Z",
    "regime_notes": "Validated over 1,404 daily cross-sectional observations using all 15 tradable benchmark instruments, with at least 8 valid instruments per observation. IC was positive in all chronological thirds, but the middle-third effect was weak; interpret conservatively given the small cross-section.",
    "metrics": {
      "ic": 0.05607448,
      "icir": 0.18881458,
      "horizon_days": 10,
      "ic_hit_ratio": 0.56980,
