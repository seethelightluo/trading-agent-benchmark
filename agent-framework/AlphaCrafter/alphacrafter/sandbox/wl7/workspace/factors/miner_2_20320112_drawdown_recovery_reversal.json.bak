    "script": "scripts/miner_2_20320112_drawdown_recovery.py",
    "universe_size": 15,
    "minimum_cross_section": 8,
    "method": "Daily Spearman cross-sectional IC against 10-day forward close-to-close returns; signal lagged one completed session and uses no future data."
