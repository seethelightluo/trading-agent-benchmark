{
  "factor_id": "miner_2_20300211_highdisp75_residual_reversal20",
  "factor_name": "Upper-Quartile Dispersion Cross-Asset Residual Reversal 20d",
  "version": "1.0",
  "calculation": {
    "expression": "-rolling_sum_20(asset_return - cross_sectional_median_return) activated when rolling_mean_20(cross_sectional_return_std) > rolling_quantile_252(0.75), lagged 1 day",
    "description": "Contrarian relative 20-trading-day return signal. It fades assets that outperformed their daily cross-asset median during unusually high dispersion, with a one-day lag to prevent look-ahead. Positive signal indicates expected relative reversal."
  },
  "dependencies": ["close"],
  "parameters": {
    "residual_window": 20,
    "dispersion_window": 20,
    "activation_window": 252,
    "activation_quantile": 0.75,
    "forward_horizon": 10,
    "minimum_cross_section": 8,
    "lag": 1,
    "universe_size": 15
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2030-02-11 (available observations; 289 valid IC dates)",
    "last_validated": "2030-02-11",
    "metrics": {
      "ic": 0.0622649603,
      "icir": 0.2151957867,
      "ic_horizon_days": 10,
      "ic_hit_ratio": 0.5847750865,
      "valid_ic_dates": 289,
      "instruments": 15,
      "average_coverage": 1.0,
      "turnover": 0.0897376543,
      "max_abs_library_correlation": null,
      "decay_ic": {"1d": 0.0226567363, "5d": 0.0675539746, "10d": 0.0622649603, "20d": 0.1359131776},
      "decay_icir": {"1d": 0.0728942701, "5d": 0.2175607838, "10d": 0.2151957867, "20d": 0.5091210272}
    },
    "regime_notes": "Chronological quartile ICs were +0.01393, +0.12435, +0.06781, and +0.04364; positive in all four partitions but weakest in the earliest partition. Small cross-section implies conservative uncertainty interpretation.",
    "signal_artifact": "scripts/miner_2_20300211_highdisp75_residual20_signal.csv",
    "gates": {"minimum_abs_daily_paper_ic": 0.007, "minimum_abs_daily_paper_icir": 0.084, "passed": true}
  },
  "tags": ["cross_asset", "residual_reversal", "dispersion_conditioned", "contrarian"]
