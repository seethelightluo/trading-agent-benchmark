  "factor_name": "Lagged Downside-Risk-Adjusted Momentum 30d",
  "version": "2027-07-16",
  "calculation": {
    "expression": "shift_1(pct_change(close,30) / (rolling_std(min(pct_change(close,1),0),30)*sqrt(252)+0.01))",
    "description": "Thirty-session momentum scaled by annualized downside realized volatility, lagged one completed session to avoid look-ahead bias."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "lookback_sessions": 30,
    "downside_volatility_window": 30,
    "annualization": 252,
    "stabilizer": 0.01,
    "lag_sessions": 1
  },
