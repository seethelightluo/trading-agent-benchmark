{
  "factor_id": "breadth_conditional_5d_momentum_reversal",
  "factor_name": "Cross-Asset Breadth-Conditional 5-Day Momentum/Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "sign(median_i(r20_i)) * r5_i / (vol40_i * sqrt(5))",
    "description": "For each asset, use lagged 5-day return normalized by trailing 40-day log-return volatility. If the cross-sectional median lagged 20-day return is positive, use momentum; otherwise invert the signal to use short-term reversal. All inputs are available through t and forward returns begin after t."
  },
  "dependencies": ["close"],
  "parameters": {"short_window": 5, "regime_window": 20, "volatility_window": 40, "regime_statistic": "cross-sectional median", "admission_horizon_days": 20},
