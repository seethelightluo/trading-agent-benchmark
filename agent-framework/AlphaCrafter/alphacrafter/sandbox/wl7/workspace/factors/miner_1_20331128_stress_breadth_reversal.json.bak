{
  "factor_id": "miner_1_20331128_stress_breadth_reversal",
  "factor_name": "VIX-stress and broad-breadth conditioned five-day reversal",
  "version": "1.0",
  "calculation": {
    "expression": "demean(cast(gate, (-sum(lagged_returns,5) / rolling_std(lagged_returns,30))))",
    "description": "Use only information through the prior completed session. Activate inverse five-session return scaled by 30-session volatility when the five-session VIX change exceeds its lagged 120-session 80th percentile and more than 60% of tradable assets have negative lagged 20-session returns; cross-sectionally demean the active signal. Inactive dates are zero."
  },
  "dependencies": ["close", "VIX close"],
  "parameters": {"reversal_window": 5, "volatility_window": 30, "vix_change_window": 5, "vix_quantile_window": 120, "vix_quantile": 0.8, "breadth_window": 20, "negative_breadth_threshold": 0.6, "lag_sessions": 1, "forward_horizon": 10},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2033-11-25",
    "metrics": {
      "ic": 0.056419,
      "icir": 0.169001,
      "ic_observations": 184,
      "average_instruments": 14.95,
      "coverage": 0.999861,
      "active_asset_coverage": 0.042691,
      "turnover": 0.012402,
      "hit_ratio": 0.5707,
      "decay_ic_h1": 0.022106,
      "decay_ic_h5": -0.010285,
      "decay_ic_h10": 0.056419,
      "decay_ic_h20": 0.018507,
      "max_abs_library_correlation": null
    },
    "regime_notes": "Conditional sample contains 184 active IC dates across all 15 tradable instruments. Daily IC was 0.009281 in the first chronological third and 0.042056 in the second; final third had no valid active observations because the stress gate did not activate. Interpret uncertainty conservatively due to sparse conditional sample."
  },
  "signal_artifact": "scripts/miner_1_20331128_stress_breadth_reversal_signal.csv",
  "tags": ["reversal", "volatility", "macro-regime", "breadth", "cross-asset"],
