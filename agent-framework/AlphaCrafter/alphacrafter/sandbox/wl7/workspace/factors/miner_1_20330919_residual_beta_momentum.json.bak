{
  "factor_id": "miner_1_20330919_residual_beta_momentum",
  "factor_name": "Inverse volatility-scaled cross-asset beta residual momentum",
  "version": "1.0",
  "calculation": {
    "expression": "-((R20_i - beta_i,60 * R20_benchmark) / annualized_sigma20_i), lagged 1 session",
    "description": "Compute each asset's 20-session return in excess of its rolling 60-session beta exposure to the equal-weight benchmark return, scale by its own annualized 20-session volatility, and lag one completed session. Validation finds an inverse relationship to forward returns, so consumers should use the negative signal direction shown in the expression."
  },
  "dependencies": ["close", "daily_returns"],
  "parameters": {"momentum_window": 20, "beta_window": 60, "volatility_window": 20, "beta_min_periods": 40, "vol_min_periods": 15, "benchmark": "equal_weight_mean_return", "lag_sessions": 1, "direction": -1},
