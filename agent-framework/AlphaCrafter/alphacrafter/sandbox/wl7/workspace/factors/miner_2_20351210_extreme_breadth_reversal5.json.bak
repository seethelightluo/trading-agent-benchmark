{
  "factor_id": "miner_2_20351210_extreme_breadth_reversal5",
  "factor_name": "Extreme Breadth-Gated 5-Day Reversal",
  "version": "2035-12-10",
  "calculation": {
    "expression": "-rolling_sum(log_return,5) / rolling_std(log_return,40) * clip(1-exp(-abs(breadth20-0.5)/std120(breadth20)),0.2,1), lagged 1 day",
    "description": "Risk-scaled short-term reversal, activated more strongly when the 20-day cross-asset positive-return breadth is far from neutral. Breadth is computed across the 15 tradable benchmark instruments."
  },
  "dependencies": ["close"],
  "parameters": {"reversal_window": 5, "volatility_window": 40, "breadth_window": 20, "breadth_baseline": 0.5, "breadth_scale_window": 120, "forward_horizon": 10, "minimum_cross_section": 8},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2035-12-09",
