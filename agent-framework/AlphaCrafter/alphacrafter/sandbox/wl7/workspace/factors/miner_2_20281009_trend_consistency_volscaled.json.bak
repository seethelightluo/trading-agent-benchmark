{
  "factor_id": "miner_2_20281009_trend_consistency_volscaled",
  "factor_name": "Lagged 40-Day Trend Consistency Volatility-Scaled",
  "version": "2028-10-09",
  "calculation": {
    "expression": "shift1(rolling_mean(pct_change(close),40) / rolling_std(pct_change(close),40))",
    "description": "Ranks assets by the consistency and risk-adjusted strength of their prior 40-session daily trend. The one-session shift ensures the signal uses only completed observations.",
