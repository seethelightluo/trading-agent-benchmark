{
  "factor_id": "miner_3_20290507_lowdisp50_riskadj_reversal20",
  "factor_name": "Low-dispersion median-gated risk-adjusted 20-day reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(close[t-1]/close[t-21]-1) / std(pct_change(close)[t-21:t-2]) * I(rank_pct(mean_cross_asset_std20[t-1],120)<0.50)",
    "description": "Negative lagged 20-trading-day return divided by lagged 20-day daily-return volatility, activated when lagged mean cross-asset 20-day volatility is below its trailing 120-day median percentile. All inputs are lagged and use no future data."
  },
  "dependencies": ["close", "pct_change"],
  "parameters": {
    "return_lookback_days": 20,
    "volatility_lookback_days": 20,
    "volatility_min_periods": 15,
    "dispersion_lookback_days": 20,
    "dispersion_rank_window_days": 120,
    "dispersion_rank_min_periods": 60,
    "activation_percentile": 0.50,
    "forward_horizon_days": 10,
    "minimum_cross_section": 8,
    "universe_size": 15
  },
  "validation": {
    "status": "EFFECTIVE",
