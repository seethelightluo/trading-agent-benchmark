{
  "factor_id": "miner_1_20270414_short_reversal",
  "factor_name": "Volatility-scaled 3-day cross-asset reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-pct_change(close,3) / (rolling_std(pct_change(close),20)*sqrt(3)+1e-8), lagged 1 session",
    "description": "Ranks assets favoring recent three-session losers after scaling the reversal by recent 20-session realized volatility. The one-session lag ensures only completed data are used."
  },
  "dependencies": ["close"],
  "parameters": {"return_lookback": 3, "volatility_lookback": 20, "minimum_vol_observations": 15, "signal_lag": 1},
