  "factor_name": "Breadth-Gated Defensive Relative Trend",
  "version": "1.0",
  "calculation": {
    "expression": "trend = lag1(20d_return / (annualized_30d_realized_vol + 0.01)); breadth = lag1(10d_mean(cross_sectional_fraction(20d_return > 0))); signal = trend when breadth >= 0.45, otherwise 0.35*trend + 0.65*mean(defensive_trend[XAU,US10Y,CN10Y]) added to defensive assets",
    "description": "A lagged volatility-scaled 20-day trend ranking that retains diversified trend in broad markets and tilts toward tradable defensive assets when recent cross-asset breadth is weak. All inputs are known at the decision timestamp."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "trend_window": 20,
    "vol_window": 30,
    "breadth_window": 10,
    "breadth_threshold": 0.45,
    "defensive_assets": [
      "XAU",
      "US10Y",
      "CN10Y"
    ],
    "weak_regime_base_weight": 0.35,
    "defensive_overlay": 0.65,
