{
  "factor_id": "miner_3_volume_confirmed_reversal_3d",
  "factor_name": "Volume-Confirmed Three-Day Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-pct_change(close,3) * (1 + clip(max(0, (log1p(volume)-rolling_median_20(log1p(volume)))/(rolling_std_20(log1p(volume))+1e-8)), 0, 2))",
    "description": "Ranks assets higher when their lagged three-day return is negative, with the reversal amplified when current volume is unusually high relative to its own recent history. All inputs are lagged at decision time and forward one-day returns are used only for validation."
  },
  "dependencies": [
    "close",
    "volume"
  ],
  "parameters": {
    "return_lookback_days": 3,
    "volume_window_days": 20,
    "min_periods": 10,
    "volume_z_clip": [
      0,
      2
    ],
    "validation_forward_horizon_days": 1
  },
