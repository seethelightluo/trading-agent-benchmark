  "factor_name": "Short-versus-medium momentum reversal",
  "version": "1.0",
  "calculation": {
    "expression": "pct_change(close,20) - pct_change(close,60)",
    "description": "Ranks assets whose recent 20-day return exceeds or lags their 60-day return; positive values represent short-term strength relative to medium-term trend and are used as a cross-sectional reversal/acceleration signal for the 20-trading-day forward horizon. All prices are lagged to the completed signal date."
  },
  "dependencies": ["close"],
  "parameters": {"short_window": 20, "medium_window": 60, "forward_horizon": 20, "minimum_cross_section": 8},
