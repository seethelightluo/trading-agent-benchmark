{
  "factor_id": "miner_2_20341211_inefficient_reversal20",
  "factor_name": "Volatility-scaled directional-efficiency reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-((close/close.shift(20)-1) / sum(abs(daily_return),20)) / (std(daily_return,20)*sqrt(252))",
    "description": "Ranks assets higher when their prior 20-day directional efficiency, after volatility scaling, is low; the signal is lagged one completed day and is intended as a medium-horizon cross-asset reversal factor."
  },
  "dependencies": ["close", "pct_change"],
  "parameters": {"lookback_days": 20, "volatility_window": 20, "annualization": 252, "signal_lag_days": 1, "admission_horizon_days": 10},
  "validation": {
    "status": "EFFECTIVE",
