{
  "factor_id": "miner_3_20270707_recovery_velocity_90d",
  "factor_name": "Downside-risk-normalized 90-day recovery velocity",
  "version": "1.0",
  "calculation": {
    "expression": "(close / rolling_min(close, 90) - 1) / (sqrt(rolling_mean(min(pct_change(close),0)^2,20)) + 1e-12), shifted by 1 session",
    "description": "Ranks the 15 tradable cross-asset benchmarks by recovery from the trailing 90-day low, normalized by recent downside semivolatility. The one-session lag prevents current-close look-ahead."
  },
  "dependencies": ["close"],
  "parameters": {
    "recovery_window": 90,
    "downside_volatility_window": 20,
    "minimum_recovery_observations": 60,
    "minimum_downside_volatility_observations": 12,
    "signal_lag_sessions": 1
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2027-07-05",
    "validation_date": "2027-07-07",
    "metrics": {
      "daily_paper_ic": 0.0086099184,
      "daily_paper_icir": 0.4177104905,
      "ic_hit_ratio": 0.4920042644,
      "coverage": 0.7471317829,
      "average_instruments_per_date": 14.6007462687,
      "validation_dates": 1876,
      "turnover": 0.0661074319,
      "decay_ic_5d": 0.0192218381,
      "decay_icir_5d": 0.9120970163,
      "decay_ic_10d": 0.0320517830,
      "decay_icir_10d": 1.5183887032,
      "max_abs_library_correlation": null
    },
    "regime_notes": "Daily rank IC was positive in 2020-2022 (+0.01536), 2023-2024 (+0.00278), and 2025-2027 (+0.00582), but the latter two regimes are weak and hit ratios were below 50%. Interpret conservatively given the 15-asset cross-section."
    ,"admission_gates": {"minimum_absolute_daily_ic": 0.007, "minimum_absolute_daily_icir": 0.084}
  },
  "provenance": {
    "signal_artifact": "scripts/miner_3_20270707_recovery_velocity_90d_signal.csv",
    "universe_size": 15,
    "assets_used": 15,
    "no_future_data": true,
    "method": "daily cross-sectional Spearman rank IC with at least 8 valid instruments per date"
  },
  "tags": ["recovery", "momentum", "downside-risk", "cross-asset", "medium-term"]
}
