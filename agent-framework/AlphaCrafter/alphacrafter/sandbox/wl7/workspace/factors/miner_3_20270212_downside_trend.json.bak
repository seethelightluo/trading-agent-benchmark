{
  "factor_id": "miner_3_20270212_downside_trend",
  "factor_name": "Downside-Risk-Adjusted Medium-Term Trend",
  "version": "1.0",
  "calculation": {
    "expression": "shift(1, pct_change(close,20) / (sqrt(rolling_mean(where(pct_change(close,1)<0, pct_change(close,1)^2, 0),60))*sqrt(20)))",
    "description": "Lagged 20-session return divided by 20-session-equivalent downside deviation computed from the prior 60 sessions. Higher values indicate trend persistence with less downside risk."
  },
  "dependencies": ["close"],
  "parameters": {"trend_window": 20, "downside_window": 60, "minimum_downside_observations": 40, "lag_sessions": 1},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2027-02-11",
    "last_validated": "2027-02-12",
    "metrics": {
      "daily_ic": 0.0137041182,
      "daily_icir": 0.6643017887,
      "daily_hit_ratio": 0.5083612040,
      "daily_valid_dates": 1794,
      "average_instruments": 14.5825,
      "factor_coverage": 0.7388310649,
      "rank_turnover": 0.0962743105,
      "max_abs_library_correlation": null,
      "decay": {"5d_ic": 0.0197799577, "10d_ic": 0.0388417090, "20d_ic": 0.0413597312},
      "regime_daily_ic": {"2020-2022": 0.0182680816, "2023-2024": -0.0016181332, "2025-2027": 0.0220727356}
    },
    "signal_artifact": "scripts/miner_3_20270212_downside_trend_signal.csv",
    "notes": "Validated on all 15 tradable benchmark instruments; dates require at least 8 valid instruments. Daily absolute IC and ICIR exceed benchmark gates. Results are positive in two of three regimes but uncertainty is material in the small cross-section; 2023-2024 was weak."
  },
  "tags": ["trend", "momentum", "downside-risk", "risk-adjusted"]
}
