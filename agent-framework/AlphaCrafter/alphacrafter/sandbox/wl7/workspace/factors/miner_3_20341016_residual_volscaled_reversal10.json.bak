{
  "factor_id": "miner_3_20341016_residual_volscaled_reversal10",
  "factor_name": "Cross-asset residual volatility-scaled 10-day reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-rolling_sum_10(asset_return - cross_sectional_median_return) / rolling_std_40(asset_return - cross_sectional_median_return)",
    "description": "Subtracts the daily cross-sectional median return to isolate asset-specific movement, sums ten residual returns, and reverses the volatility-scaled signal so recent residual underperformers rank higher. Higher values indicate expected residual mean reversion."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "residual_window_days": 10,
    "volatility_window_days": 40,
    "forward_horizon_days": 10,
    "minimum_cross_section": 8
  },
