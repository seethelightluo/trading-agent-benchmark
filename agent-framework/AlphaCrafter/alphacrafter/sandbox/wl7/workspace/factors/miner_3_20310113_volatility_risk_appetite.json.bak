  "factor_name": "Volatility and Drawdown Risk Appetite",
  "version": "1.0",
  "calculation": {
    "expression": "annualized_std(log_return,20) + 0.5*annualized_std(min(log_return,0),20) + 0.25*drawdown_from_60d_high",
    "description": "Ranks assets by realized volatility and downside-volatility appetite, with a drawdown adjustment. Signal is cross-sectionally median-centered and lagged one completed session. Higher values indicate riskier assets; the empirically validated direction is positive."
  },
  "dependencies": ["close"],
  "parameters": {"vol_window": 20, "downside_window": 20, "drawdown_window": 60, "downside_weight": 0.5, "drawdown_weight": 0.25, "annualization": 252, "lag": 1, "center": "cross_sectional_median"},
