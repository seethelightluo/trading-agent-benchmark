{
  "factor_id": "miner_3_20301021_downside_relative_reversal",
  "factor_name": "Downside-Adjusted Relative Trend Reversal 20D",
  "version": "1.0",
  "calculation": {
    "expression": "-(relative_return_20 / downside_deviation_20).shift(1)",
    "description": "For each tradable asset, subtract the cross-sectional median 20-session log return, scale by annualized 20-session downside deviation, lag one completed day, and reverse the sign. Higher values favor assets with relatively weak downside-adjusted trends, testing short-horizon cross-asset mean reversion without future data."
  },
  "dependencies": ["close"],
  "parameters": {"relative_return_window": 20, "downside_window": 20, "minimum_cross_section": 8, "lag_days": 1, "winsorization": [-8, 8]},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2030-10-18",
    "validated_at": "2030-10-21",
