  "factor_name": "VIX-Stress Conditional Volatility-Normalized Reversal",
  "version": "20270503",
  "calculation": {
    "expression": "where(zscore(VIX, 60).shift(1) > 0.75, -return_10d / rolling_std(return_1d,20), null)",
    "description": "When lagged VIX is unusually elevated versus its 60-session history, rank assets by the negative of their prior 10-day return divided by prior 20-day realized volatility. Higher values indicate stressed losers that may mean-revert. VIX is observation-only and is never traded. All inputs are lagged to prevent look-ahead."
  },
  "dependencies": [
    "close",
    "VIX.close"
  ],
