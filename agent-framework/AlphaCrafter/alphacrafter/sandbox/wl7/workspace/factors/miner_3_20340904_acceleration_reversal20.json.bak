{
  "factor_id": "miner_3_20340904_acceleration_reversal20",
  "factor_name": "Short-versus-Medium Momentum Reversal",
  "version": "2034-09-04.v2",
  "calculation": {
    "expression": "pct_change(close,20) - pct_change(close,60)",
    "description": "Ranks assets higher when their recent 20-session return is weaker than their 60-session return, an interpretable short-versus-medium momentum reversal signal. Prices are lagged at decision time and no future data are used."
  },
  "dependencies": ["close"],
  "parameters": {"short_window": 20, "medium_window": 60, "forward_horizon_days": 20, "min_cross_section": 8},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2034-09-03",
    "metrics": {
