{
  "factor_id": "miner_3_20330502_shock_reversal",
  "factor_name": "Volatility-normalized five-day shock reversal",
  "version": "1.0",
  "calculation": {
    "expression": "(-sum(pct_change(close), 5) / rolling_std(pct_change(close), 20)).shift(1)",
    "description": "Ranks assets higher after a recent five-session loss, scaled by their prevailing 20-session realized volatility. The one-session lag ensures only completed data are used."
  },
  "dependencies": ["close"],
  "parameters": {"shock_window": 5, "volatility_window": 20, "volatility_min_periods": 15, "signal_lag": 1},
