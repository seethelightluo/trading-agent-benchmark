  "factor_name": "VIX five-day shock gated volatility-normalized five-day reversal",
  "version": "1.0",
  "calculation": {
    "expression": "I(delta_5(VIX)/VIX_lag5 > 0.08) * clip(-delta_5(close)/rolling_std(pct_change(close),20), -5, 5), lagged one session",
    "description": "When the observation-only VIX has risen more than 8 percent over five sessions, rank assets by lagged five-session reversal normalized by 20-session realized volatility. The signal is zero outside the shock regime."
