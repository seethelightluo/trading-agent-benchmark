  "factor_name": "Dispersion-Gated Volatility-Normalized Three-Day Shock Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "when cross_sectional_median(abs(asset_3d_return - median_3d_return)) > median(abs(asset_3d_return)), -(asset_3d_return - cross_sectional_median(asset_3d_return))/(asset_20d_return_volatility*sqrt(3)); otherwise missing",
    "description": "At each date, during elevated cross-sectional return dispersion, reverse each asset's three-day return relative to the cross-sectional median and normalize by trailing 20-day return volatility. All input features are lagged by the decision date convention and the signal is used for next-day prediction."
  },
  "dependencies": [
    "close",
    "daily_return"
  ],
  "parameters": {
    "shock_lookback_days": 3,
    "volatility_lookback_days": 20,
    "dispersion_rule": "mean absolute deviation exceeds cross-sectional median absolute return",
    "minimum_cross_section": 8
  },
