  "factor_name": "Volume-Confirmed Risk-Adjusted Momentum",
  "version": "1.0",
  "calculation": {
    "expression": "shift_1((return_20 / (realized_vol_20*sqrt(252)+0.01)) * (0.75 + 0.25*clip(volume_mean_20/volume_mean_60, 0.5, 2.0)))",
