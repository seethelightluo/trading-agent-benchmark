{
  "factor_id": "miner_3_20270622_recovery_velocity",
  "factor_name": "Recovery Velocity with Downside-Risk Normalization",
  "version": "1.0",
  "calculation": {
    "expression": "((close / rolling_min(close,60)) - 1) / (sqrt(rolling_mean(min(pct_change(close),0)^2,20)) + 1e-12), shifted by 1 day",
    "description": "Measures recovery from the trailing 60-day trough, scaled by 20-day downside volatility. The one-day lag prevents look-ahead and favors assets with strong recovery relative to harmful downside variation."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "recovery_window": 60,
    "downside_vol_window": 20,
    "min_periods_recovery": 40,
    "min_periods_downside": 12,
    "lag_days": 1
  },
