  "factor_name": "High-dispersion volatility-scaled short-term reversal",
  "version": "1.0",
  "calculation": {
    "expression": "lag1(-rolling_sum(log_return,5) / rolling_std(log_return,20)) * I(cross_asset_mean_rolling_std20 > rolling_quantile(cross_asset_mean_rolling_std20,252,0.80))",
