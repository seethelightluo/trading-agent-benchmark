  "factor_name": "Volatility-Normalized Ten-Day Impulse with Long-Range Position",
  "version": "1.0",
  "calculation": {
    "expression": "shift1((log(close/close[-10]) / rolling_std(log_returns,20)) * (2*((close-rolling_min(close,60))/(rolling_max(close,60)-rolling_min(close,60)))-1)",
    "description": "Ranks lagged ten-day momentum by recent volatility and conditions its sign/magnitude on the asset's position within its trailing 60-day range. Positive range position reinforces continuation; lower position reverses the impulse. Computed using only completed data."
