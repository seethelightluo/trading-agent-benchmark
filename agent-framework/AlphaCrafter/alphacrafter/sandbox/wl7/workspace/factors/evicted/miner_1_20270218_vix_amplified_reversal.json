{
  "factor_id": "miner_1_20270218_vix_amplified_reversal",
  "factor_name": "VIX-amplified volatility-normalized short-term reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(close[t-1]/close[t-6]-1) / rolling_std(pct_change(close),20)[t-1] * (1 + 0.35*tanh(VIX_zscore_60[t-1]))",
    "description": "Ranks assets for reversal of the lagged five-session return, normalized by lagged 20-session realized volatility and modestly amplified when the observation-only VIX is elevated. All inputs are lagged one completed session."
  },
  "dependencies": [
    "close",
    "pct_change",
    "VIX"
  ],
  "parameters": {
    "return_lookback": 5,
    "volatility_lookback": 20,
    "vix_zscore_lookback": 60,
    "vix_amplification": 0.35,
    "lag_sessions": 1
  },
