{
  "factor_id": "miner_3_20270813_residual_trend_30d",
  "factor_name": "Lagged Volatility-Normalized Relative Trend",
  "version": "1.0",
  "calculation": {
    "expression": "((asset_return_30d - cross_sectional_median_return_30d) / (asset_daily_volatility_30d * sqrt(252) + 0.01)).shift(1)",
    "description": "Ranks each tradable asset by its 30-day return relative to the contemporaneous cross-sectional median, normalized by its own 30-day annualized volatility. One-session lag prevents look-ahead bias."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "return_lookback_days": 30,
    "volatility_lookback_days": 30,
    "annualization": 252,
    "volatility_floor": 0.01,
    "lag_days": 1,
    "universe": 15
  },
