{
  "factor_id": "miner_2_20270225_dispersion_conditioned_momentum",
  "factor_name": "Cross-Asset Dispersion-Conditioned Risk-Adjusted Momentum",
  "version": "1.0",
  "calculation": {
    "expression": "shift1((close/close[-15]-1)/(rolling_std(pct_change(close),20)+1e-8) * clip(mean_i(rolling_std_i(pct_change(close_i),20)) / rolling_mean_120(mean_i(rolling_std_i(pct_change(close_i),20)),40), 0.35, 1.5))",
    "description": "Compute each asset's lagged 15-day momentum divided by its 20-day realized volatility. Scale the score by the inverse current cross-asset 20-day volatility dispersion relative to its trailing 120-day mean, clipped to avoid extreme leverage. The cross-asset regime input uses only contemporaneously available and lagged price information; the final signal is shifted one session."
  },
  "dependencies": [
    "close",
    "pct_change",
    "cross_asset_prices"
  ],
  "parameters": {
    "momentum_window": 15,
    "volatility_window": 20,
    "dispersion_baseline_window": 120,
    "dispersion_min_periods": 40,
    "asset_vol_min_periods": 12,
    "scale_floor": 0.35,
    "scale_cap": 1.5,
    "signal_lag": 1
  },
