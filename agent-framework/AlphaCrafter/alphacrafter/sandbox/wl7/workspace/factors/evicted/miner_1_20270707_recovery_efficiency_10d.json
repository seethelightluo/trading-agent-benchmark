{
  "factor_id": "miner_1_20270707_recovery_efficiency_10d",
  "factor_name": "10-Day Recovery Efficiency with Drawdown and Volatility Penalty",
  "version": "1.0",
  "calculation": {
    "expression": "lag1(pct_change(close,10) / (realized_volatility(close,20) + 0.5 * drawdown_from_60d_high + 1e-8))",
    "description": "Ranks assets by their prior-day-lagged 10-day recovery return, penalized by 20-day realized volatility and distance from the 60-day high. Higher values indicate efficient recovery with lower risk and shallower drawdown."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "return_window": 10,
    "volatility_window": 20,
    "drawdown_window": 60,
