  "factor_name": "Lagged Close-Location Range Efficiency",
  "version": "1.0",
  "calculation": {
    "expression": "shift1(rolling_mean((close-open)/(high-low),15) / (rolling_mean((high-low)/close,15)+epsilon))",
    "description": "Ranks assets whose recent closes persistently finish favorably within their daily ranges, normalized by their average percentage range. The one-session lag prevents use of incomplete or same-day information."
