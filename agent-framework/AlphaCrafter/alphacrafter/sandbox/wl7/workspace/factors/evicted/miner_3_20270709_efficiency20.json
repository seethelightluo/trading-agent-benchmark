  "factor_name": "20-Day Directional Efficiency Trend",
  "version": "1.0",
  "calculation": {
    "expression": "lag1((close/close.shift(20)-1) / (rolling_sum(abs(pct_change(close)),20)+epsilon))",
    "description": "Ranks assets by net 20-session return relative to the absolute-return path length, using a one-completed-day lag to prevent look-ahead. Higher values indicate persistent, directionally efficient trends."
  },
