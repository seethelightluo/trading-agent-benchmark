{
  "factor_id": "miner_2_20270111_trend_consistency_risk_adjusted",
  "factor_name": "Trend Consistency Risk-Adjusted Momentum",
  "version": "1.0",
  "calculation": {
    "expression": "shift1((close/close.shift(20)-1) * (0.5 + mean(returns > 0, 20)) / (std(returns, 20)*sqrt(20) + 1e-8))",
    "description": "Lagged 20-session momentum, amplified by the fraction of positive daily returns over the trailing 20 sessions and normalized by trailing 20-session realized volatility. The one-session lag prevents use of the current completed day's close in a decision made before that day's completion."
  },
  "dependencies": [
    "close",
    "daily_returns"
  ],
  "parameters": {
    "momentum_window": 20,
    "consistency_window": 20,
    "volatility_window": 20,
    "positive_return_floor": 0.5,
    "lag_sessions": 1,
    "epsilon": 1e-08,
