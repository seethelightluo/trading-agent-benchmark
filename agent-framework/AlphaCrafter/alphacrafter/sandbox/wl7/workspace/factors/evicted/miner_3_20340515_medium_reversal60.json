  "factor_name": "Volatility-Normalized Long Medium-Horizon Reversal 60d",
  "version": "1.0",
  "calculation": {
    "expression": "-(close_t / close_{t-60} - 1) / (std(pct_change(close),120) * sqrt(60)), shifted by 1 completed session",
