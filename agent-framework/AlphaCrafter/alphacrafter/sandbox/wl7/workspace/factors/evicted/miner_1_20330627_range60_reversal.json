  "factor_name": "Volatility-Scaled 60-Session Range-Position Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "(0.5 - (close - rolling_min(close,60,min_periods=45))/(rolling_max(close,60,min_periods=45)-rolling_min(close,60,60)+epsilon)) / rolling_std(pct_change(close),20,min_periods=15), then shift(1)",
    "description": "Contrarian signal that favors assets near the lower end of their trailing 60-session price range and penalizes high realized volatility. The complete cross-sectional signal is lagged one completed session to prevent look-ahead."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "range_window": 60,
    "range_min_periods": 45,
    "volatility_window": 20,
    "volatility_min_periods": 15,
    "forward_horizon_days": 10,
    "signal_lag_days": 1,
    "epsilon": 1e-12
  },
