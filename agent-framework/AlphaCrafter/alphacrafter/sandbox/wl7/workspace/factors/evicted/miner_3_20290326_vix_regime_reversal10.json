  "factor_name": "High-VIX Regime Volatility-Normalized Ten-Day Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "demean_cs((-return_10d/(sqrt(10)*volatility_20d)) * I(VIX_lag1 > rolling_quantile(VIX_lag1,60,0.75)))",
    "description": "Ranks a volatility-normalized ten-day reversal only when the lagged VIX is above its trailing 60-session 75th percentile. All price and VIX inputs are lagged to prevent look-ahead; VIX is observation-only and is not tradable."
