  "factor_name": "Dispersion-Switch Volatility-Normalized Momentum",
  "version": "1.0",
  "calculation": {
    "expression": "lag1((pct_change(close,20)/rolling_std(pct_change(close,1),20)/sqrt(20)) * (1 - 2*I(cross_asset_std(pct_change(close,10)) > rolling_median(cross_asset_std(pct_change(close,10)),60)))",
    "description": "Ranks assets by 20-day volatility-normalized momentum. In high cross-asset dispersion regimes, reverses the signal; otherwise follows momentum. The signal is lagged one completed trading day to avoid look-ahead."
