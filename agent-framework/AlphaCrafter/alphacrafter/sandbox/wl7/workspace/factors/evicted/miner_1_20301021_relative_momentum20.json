{
  "factor_id": "miner_1_20301021_relative_momentum20",
  "factor_name": "Relative 20-Day Momentum versus Cross-Asset Median, Volatility Scaled",
  "version": "1.0",
  "calculation": {
    "expression": "((log(close / lag(close,20)) - cross_sectional_median(log(close / lag(close,20))) / (rolling_std(log_return,20) * sqrt(20) + 1e-8)).shift(1)",
    "description": "Compute each asset's 20-session log return relative to the contemporaneous cross-sectional median, divide the relative return by its trailing 20-session annualized-style volatility, and lag one completed session. Positive values identify relative momentum leaders."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "momentum_window": 20,
    "volatility_window": 20,
    "lag_sessions": 1,
    "forward_horizon_sessions": 10,
    "minimum_cross_section": 8,
    "winsor_clip": 5.0
  },
