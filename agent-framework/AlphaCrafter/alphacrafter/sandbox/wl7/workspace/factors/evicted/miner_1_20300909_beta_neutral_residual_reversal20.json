{
  "factor_id": "miner_1_20300909_beta_neutral_residual_reversal20",
  "factor_name": "Beta-neutralized residual downside-risk-adjusted reversal 20-day",
  "version": "1.0",
  "calculation": {
    "expression": "-lag1(rolling_sum_20(residual_return) / rolling_downside_rms_40(residual_return))",
    "description": "For each tradable asset, estimate a rolling 60-day beta to the equal-weight tradable-universe return, subtract beta times market return, then rank the negative lagged 20-day cumulative residual return divided by its 40-day downside RMS. The one-day lag prevents look-ahead."
  },
  "dependencies": [
    "close",
    "returns",
    "cross_asset_equal_weight_return"
  ],
