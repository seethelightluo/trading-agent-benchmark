{
  "factor_id": "miner_3_20351001_dxy_conditioned_trend10",
  "factor_name": "DXY-Conditioned Volatility-Scaled Trend (10D)",
  "version": "1.0",
  "calculation": {
    "expression": "cross_sectional_demean((close/close.shift(20)-1)/(rolling_std(pct_change(close),40)*sqrt(20)) * (1-2*I(DXY > rolling_median(DXY,60)))) then lag 1 day",
    "description": "Ranks 20-day volatility-scaled trend, following trend when DXY is below its trailing 60-day median and reversing it when DXY is above that median. The one-day lag prevents look-ahead."
  },
  "dependencies": [
    "close",
    "DXY",
    "pct_change",
    "rolling_std"
  ],
  "parameters": {
    "trend_window": 20,
