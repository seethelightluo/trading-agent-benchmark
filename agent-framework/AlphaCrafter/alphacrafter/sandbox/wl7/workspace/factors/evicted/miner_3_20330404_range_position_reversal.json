  "factor_name": "Volatility-normalized 40-day range-position reversal",
  "version": "1.0",
  "calculation": {
    "expression": "(0.5 - (close - rolling_min(close,40))/(rolling_max(close,40)-rolling_min(close,40))) / rolling_std(pct_change(close),20), shifted by 1 completed session",
    "description": "Ranks assets favoring prices near the lower end of their trailing 40-session range, with the reversal score normalized by trailing 20-session realized volatility. The one-session lag prevents use of the current completed day's information in a decision."
  },
