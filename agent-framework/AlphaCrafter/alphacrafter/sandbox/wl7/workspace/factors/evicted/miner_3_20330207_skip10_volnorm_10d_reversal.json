  "factor_name": "Delayed 10-Day Volatility-Normalized Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-pct_change(close, 10).shift(10) / rolling_std(pct_change(close, 1), 40).shift(10)",
    "description": "Fades the asset's ten-session return ending ten completed sessions before the decision, scaled by trailing 40-session daily volatility. The two-session lags ensure the signal uses only completed information available before the forward holding period. Higher values indicate stronger expected forward performance."
