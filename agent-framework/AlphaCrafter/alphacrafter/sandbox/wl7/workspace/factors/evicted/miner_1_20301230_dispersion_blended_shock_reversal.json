  "factor_name": "Dispersion-gated blended 3/10-day shock reversal",
  "version": "1.0",
  "calculation": {
    "expression": "shift(1, clip(cross_sectional_demean((0.7*(-sum(log_return,3)/std(log_return,20)) + 0.3*(-sum(log_return,10)/std(log_return,20))) * I[dispersion20 > rolling_median(dispersion20,80)], [-8,8]))",
    "description": "Fades a blend of three- and ten-session volatility-normalized returns relative to the cross-sectional median. The signal is active only when median absolute cross-asset dispersion is above its trailing 80-session median, and is lagged one completed session to prevent look-ahead."
