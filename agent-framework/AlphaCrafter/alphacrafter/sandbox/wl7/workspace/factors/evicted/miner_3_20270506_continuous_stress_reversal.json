  "factor_name": "Continuous VIX-Intensity Volatility-Scaled Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "clip(max(VIX_zscore_60_lag1 - 0.25, 0), 0, 2) / 2 * (-(return_10_lag1) / realized_vol_20_lag1)",
    "description": "Ranks tradable cross-asset instruments toward recent ten-day losers, scaled by twenty-day realized volatility, with a continuous lagged VIX stress-intensity multiplier. The multiplier is zero below a VIX 60-day z-score of 0.25 and capped at z-score excess 2.0. All price and VIX inputs are lagged to prevent look-ahead."
  },
