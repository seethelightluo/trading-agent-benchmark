{
  "factor_id": "miner_3_20340417_medium_reversal30",
  "factor_name": "Volatility-Normalized Medium-Horizon Reversal 30d",
  "version": "1.0",
  "calculation": {
    "expression": "-(close / close.shift(30) - 1) / (rolling_std(pct_change(close), 120) * sqrt(30)), shifted by 1 completed session",
    "description": "Ranks assets by their lagged 30-session loss relative to 120-session daily volatility; larger positive values identify unusually weak medium-term performers for reversal exposure. The one-session lag prevents look-ahead."
  },
  "dependencies": [
    "close",
    "pct_change(close)"
  ],
  "parameters": {
    "reversal_window_sessions": 30,
    "volatility_window_sessions": 120,
    "forward_horizon_sessions": 10,
    "signal_lag_sessions": 1,
    "minimum_cross_section": 8
  },
