  "factor_name": "Volatility-normalized lagged 10-day reversal",
  "version": "1.0",
  "calculation": {
    "expression": "(-pct_change(close,10) / rolling_std(pct_change(close,1),20)).shift(1)",
    "description": "Ranks assets higher when their prior completed 10-day return was more negative, scaled by trailing 20-day daily volatility. The one-session lag prevents use of the current incomplete session."
