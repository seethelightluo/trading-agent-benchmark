  "factor_name": "Close-location volatility-normalized 3-day reversal",
  "version": "1.0",
  "calculation": {
    "expression": "shift(-(pct_change(close,3)/(rolling_std(pct_change(close,1),20)*sqrt(3))) * (1-close_location_value), 1)",
