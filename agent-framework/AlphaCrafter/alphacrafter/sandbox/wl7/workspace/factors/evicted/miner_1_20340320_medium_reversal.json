  "factor_name": "Risk-normalized 20-day medium-horizon reversal",
  "version": "1.0",
  "calculation": {
    "expression": "(-rolling_sum(pct_change(close),20) / (rolling_std(pct_change(close),90)*sqrt(20)+1e-8)).shift(1)",
    "description": "Cross-asset reversal signal: recent 20-day return is negated and scaled by 90-day realized daily volatility, with a one-session lag to prevent look-ahead. Higher values indicate stronger expected 10-day relative return."
