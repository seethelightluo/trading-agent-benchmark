  "factor_name": "Range-scaled 15-session reversal",
  "version": "1.0",
  "calculation": {
    "expression": "(-(close / close.shift(15) - 1) / (pct_change(close).rolling(60).std() * sqrt(15))).shift(1)",
    "description": "Ranks assets higher after a recent 15-session loss, normalized by 60-session realized volatility and lagged one completed session to avoid look-ahead."
