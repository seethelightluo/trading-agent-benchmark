  "factor_name": "Skip-3 volatility-normalized 10-day medium-term reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(close/close.shift(10)-1).shift(3) / pct_change(close).rolling(30).std().shift(3)",
    "description": "Fade the ten-session return ending three sessions before the signal date, normalized by lagged 30-session daily-return volatility. The three-session shift excludes the most recent three observations and avoids look-ahead."
