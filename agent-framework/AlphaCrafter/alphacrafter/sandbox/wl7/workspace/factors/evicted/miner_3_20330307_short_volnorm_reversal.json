  "factor_name": "Delayed volatility-normalized short-term reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-((close_t / close_{t-5}) - 1) / (std(pct_change(close),20) * sqrt(10)), then shifted by 1 completed session",
