{
  "factor_id": "miner_1_20301118_stress_conditioned_reversal3",
  "factor_name": "Stress-Conditioned Risk-Scaled Reversal 3D",
  "version": "1.0",
  "calculation": {
    "expression": "shift(1, where(cross_asset_daily_dispersion > rolling_median(cross_asset_daily_dispersion,60), -log(close/close.shift(3))/(rolling_std(log_returns,20)*sqrt(252)), 0))",
    "description": "Reverses the lagged three-session return and scales it by 20-session annualized volatility. The signal is active only when same-day cross-asset return dispersion exceeds its trailing 60-session median; inactive dates receive zero. The final signal is shifted one session to prevent look-ahead."
  },
  "dependencies": [
    "close",
    "daily_returns"
  ],
  "parameters": {
    "reversal_lookback_days": 3,
    "volatility_window_days": 20,
    "dispersion_window_days": 60,
    "dispersion_definition": "cross-sectional standard deviation of daily log returns",
    "activation_threshold": "trailing 60-day median",
    "annualization": 252,
    "signal_lag_days": 1
  },
