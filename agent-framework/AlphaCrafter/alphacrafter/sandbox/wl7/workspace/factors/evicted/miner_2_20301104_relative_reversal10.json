{
  "factor_id": "miner_2_20301104_relative_reversal10",
  "factor_name": "Downside-Adjusted Relative Trend Reversal 10D",
  "version": "1.0",
  "calculation": {
    "expression": "-clip((log(close_t/close_{t-10}) - cross_sectional_median(log(close_t/close_{t-10}))) / (sqrt(10)*rolling_10d_rms(negative_daily_log_returns)), -8, 8), lagged 1 completed day",
    "description": "Contrarian cross-asset signal that fades each instrument's ten-day log-return relative to the same-day cross-sectional median, normalized by its recent downside deviation. The signal is lagged one completed session to prevent look-ahead bias."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "lookback_days": 10,
    "downside_window_days": 10,
    "clip_lower": -8,
