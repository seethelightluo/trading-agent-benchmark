{
  "factor_id": "miner_2_20330822_volscaled_drawdown_60d",
  "factor_name": "Volatility-scaled 60-session drawdown",
  "version": "1.0",
  "calculation": {
    "expression": "(close / rolling_max(close,60) - 1) / rolling_std(pct_change(close),20), lagged 1 session",
    "description": "Measures trailing drawdown from the 60-session high normalized by recent 20-session volatility. More negative values identify stressed assets; empirical forward-return relation is negative, so consume the signal inversely (favor larger drawdowns conditionally)."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "drawdown_window": 60,
    "volatility_window": 20,
    "min_drawdown_observations": 40,
    "min_volatility_observations": 15,
    "lag": 1,
    "direction": "inverse",
    "universe": "15 tradable benchmark instruments"
  },
