  "factor_name": "Risk-scaled 10-session momentum with 60-session trend gate",
  "version": "2027-06-14",
  "calculation": {
    "expression": "shift_1((pct_change(close,10) / (std(pct_change(close),20)*sqrt(10))) * (1 if pct_change(close,60)>=0 else -0.35))",
    "description": "Ranks assets by lagged ten-session momentum normalized by twenty-session realized volatility. A positive 60-session trend retains the signal; a negative trend reverses and attenuates it. All inputs are shifted one completed session before forward returns."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "momentum_window": 10,
    "volatility_window": 20,
    "trend_window": 60,
    "negative_trend_multiplier": -0.35,
    "lag_sessions": 1,
    "universe_size": 15
  },
