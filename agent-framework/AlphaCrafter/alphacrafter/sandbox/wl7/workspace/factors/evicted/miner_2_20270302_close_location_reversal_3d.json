{
  "factor_id": "miner_2_20270302_close_location_reversal_3d",
  "factor_name": "Close-Location Volatility-Scaled 3-Day Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-rolling_mean((close-open)/(high-low), 3) / rolling_std(pct_change(close), 20)",
    "description": "A lagged reversal signal that fades persistent closes near daily highs or lows, using the prior three-session average close location and scaling by prior 20-session return volatility. The signal is shifted one session before forward-return evaluation."
  },
  "dependencies": [
    "open",
    "high",
    "low",
    "close"
  ],
  "parameters": {
    "location_window_days": 3,
