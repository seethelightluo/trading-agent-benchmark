  "factor_name": "Lagged 20-day directional efficiency trend",
  "version": "1.0",
  "calculation": {
    "expression": "shift(1, pct_change(close,20) / rolling_sum(abs(pct_change(close,1)),20))",
    "description": "Ranks assets by the fraction of their recent 20-session path represented by net return, rewarding persistent directional trends and penalizing choppy paths. Signal is lagged one completed session before forward-return evaluation."
