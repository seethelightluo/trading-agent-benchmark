  "factor_name": "Downside-Risk-Adjusted Trend",
  "version": "1.0",
  "calculation": {
    "expression": "shift_1(pct_change(close,15) / (sqrt(20)*sqrt(rolling_mean(min(pct_change(close,1),0)^2,20)) + epsilon))",
    "description": "Fifteen-day trend divided by recent downside deviation, using only negative daily returns in the 20-day risk estimate. The complete signal is lagged one trading day to prevent look-ahead bias."
  },
