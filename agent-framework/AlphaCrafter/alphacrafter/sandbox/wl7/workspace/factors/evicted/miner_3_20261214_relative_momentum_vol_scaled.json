  "factor_name": "Cross-Asset Relative Momentum Volatility-Scaled",
  "version": "1.0",
  "calculation": {
    "expression": "((close_t/close_{t-20}-1) - cross_sectional_median_20d_return_t) / rolling_std(pct_change(close),20), lagged one completed day",
