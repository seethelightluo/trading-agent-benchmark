  "factor_id": "miner_1_20331017_highdisp_beta_reversal",
  "factor_name": "High-Dispersion Beta-Neutral Medium Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "where(cross_sectional_mean(rolling_std(returns,20)) > rolling_median(cross_sectional_mean(rolling_std(returns,20)),120), -(return_10d - beta_60 * benchmark_return_10d) / (annualized_volatility_40 + epsilon), 0).shift(1)",
    "description": "For each asset, remove its 60-session rolling beta exposure to the equal-weight benchmark from its 10-session return, invert and scale the residual by 40-session annualized volatility, and activate the signal only on high cross-asset dispersion days. The completed-day signal is lagged one session. Low-dispersion observations are neutral zeros."
  },
  "dependencies": [
    "close",
    "pct_change"
  ],
  "parameters": {
    "benchmark": "equal_weight_mean_of_15_tradable_assets",
    "beta_window": 60,
