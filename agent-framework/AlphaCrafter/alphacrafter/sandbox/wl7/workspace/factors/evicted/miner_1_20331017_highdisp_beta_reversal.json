    "volatility_min_periods": 25,
    "dispersion_window": 20,
    "dispersion_min_periods": 15,
    "dispersion_threshold_window": 120,
    "dispersion_threshold_min_periods": 60,
    "activation": "dispersion > trailing_120_median",
    "lag_sessions": 1,
    "epsilon": 1e-12,
    "forward_evaluation_horizon": 10
  },
