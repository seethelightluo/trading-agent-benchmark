{
  "factor_id": "miner_1_20301216_relative_shock3_reversal",
  "factor_name": "Dispersion-gated relative 3-day shock reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-((log(close/close.shift(3)) - cross_sectional_median(log(close/close.shift(3)))) / rolling_std(log(close).diff(),20)) * I[median_abs_cross_sectional_daily_return_deviation > rolling_median_80(median_abs_cross_sectional_daily_return_deviation)]",
    "description": "Fades each asset's three-session return relative to the cross-sectional median, volatility-normalized by 20-session return volatility, and activates only during elevated cross-asset dispersion. The signal is shifted by one completed session and clipped to [-8,8]."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "shock_lookback": 3,
    "volatility_lookback": 20,
    "dispersion_lookback": 80,
    "volatility_min_periods": 15,
    "dispersion_min_periods": 40,
    "min_cross_section": 8,
    "clip": [
      -8,
      8
    ],
    "signal_lag": 1
  },
