  "factor_name": "40-day range-position volatility-scaled reversal",
  "version": "1.0",
  "calculation": {
    "expression": "(0.5 - (close - rolling_min(close,40)) / (rolling_max(close,40)-rolling_min(close,40))) / rolling_std(pct_change(close),20), shifted_by_1_session",
