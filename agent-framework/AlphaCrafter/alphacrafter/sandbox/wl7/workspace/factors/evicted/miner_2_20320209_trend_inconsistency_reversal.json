  "factor_name": "Persistence-weighted trend inconsistency reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(return_60 / volatility_60) * positive_day_fraction_40, lagged_1",
    "description": "Ranks assets for reversal by negating 60-session volatility-scaled momentum and weighting by the fraction of positive sessions over the trailing 40 sessions. All inputs are shifted one completed session to prevent look-ahead. Higher values favor assets with persistent prior weakness."
