{
  "factor_id": "miner_3_20270325_range_scaled_reversal",
  "factor_name": "Range-Scaled Three-Day Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-sum(close.pct_change(), 3) / (rolling_mean(high-low, 10) / close), shifted by 1 day",
    "description": "Ranks recent three-session reversal by the prior ten-session average daily high-low range relative to price. The one-day lag prevents use of the current completed session in the forecast signal. Positive values indicate stronger recent losses after range normalization and therefore expected short-horizon rebound."
  },
  "dependencies": [
    "close",
    "high",
    "low"
  ],
  "parameters": {
    "reversal_window": 3,
    "range_window": 10,
    "range_min_periods": 7,
    "signal_lag": 1,
    "forward_horizon_days": 1
  },
