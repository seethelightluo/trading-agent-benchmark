{
  "factor_id": "miner_2_20270506_dispersion_reversal",
  "factor_name": "High-Dispersion Volatility-Normalized Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(close.pct_change(5) / rolling_std(pct_change(close),20)) conditioned on lagged 5-day cross-asset mean volatility > lagged 60-day median",
    "description": "Ranks recent five-session losers positively after an elevated cross-asset dispersion/volatility regime. The reversal score is normalized by each asset's 20-session realized volatility; both the asset signal and regime condition are lagged to prevent look-ahead."
  },
