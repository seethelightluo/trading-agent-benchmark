  "factor_name": "VIX-Regime Conditional Momentum-Reversal 20D",
  "version": "1.0",
  "calculation": {
    "expression": "if VIX_t > median(VIX_{t-59:t}), then -sum(log_return_{t-4:t})/std20(log_return), else sum(log_return_{t-19:t})/std20(log_return)",
    "description": "In elevated VIX regimes, rank assets by short-term five-day reversal; in calm regimes, rank by volatility-normalized twenty-day momentum. All inputs are lag-safe at decision time. Higher values are favorable."
  },
  "dependencies": [
    "close",
    "VIX close"
  ],
  "parameters": {
