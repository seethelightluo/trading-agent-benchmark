  "factor_name": "Downside-risk-normalized 60-day recovery velocity",
  "version": "1.0",
  "calculation": {
    "expression": "(close / rolling_min(close, 60) - 1) / (sqrt(rolling_mean(min(pct_change(close),0)^2,20)) + 1e-12), shifted by 1 session",
    "description": "Ranks assets by their recovery from the trailing 60-day low, normalized by recent downside semivolatility. The one-session shift prevents use of the current day's close when forecasting forward returns."
