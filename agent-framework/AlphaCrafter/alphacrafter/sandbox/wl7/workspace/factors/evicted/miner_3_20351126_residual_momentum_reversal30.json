  "factor_name": "Cross-Asset Residual Momentum Reversal 30d",
  "version": "1.0",
  "calculation": {
    "expression": "-(return_30d(asset) - rolling_sum_30d(equal_weight_cross_asset_daily_return)) / (sqrt(30) * rolling_std_40d(asset_daily_return - equal_weight_cross_asset_daily_return))",
    "description": "Ranks assets for 10-day forward returns by reversing 30-day performance relative to the equal-weight benchmark, normalized by 40-day idiosyncratic volatility. Signal is lagged one completed day."
