  "factor_name": "Low-dispersion 40th-percentile risk-adjusted 20-day reversal",
  "version": "1.0",
  "calculation": {
    "expression": "(-return_20d_lagged / volatility_20d_lagged) * I(cross_asset_mean_volatility_20d_lagged_rank_120 < 0.40)",
    "description": "Ranks assets by negative lagged 20-trading-day return scaled by lagged 20-day return volatility; activates the signal only when the lagged cross-asset mean volatility is below its trailing 120-day 40th percentile. All inputs are lagged and the portfolio horizon is 10 trading days."
