{
  "factor_id": "miner_3_20270303_recovery_efficiency",
  "factor_name": "Drawdown Recovery Efficiency Momentum",
  "version": "1.0",
  "calculation": {
    "expression": "((close/close.shift(20))-1) / (rolling_mean(-min(close/rolling_max(close,20)-1,0),20)+0.01) * (0.5+0.5*rolling_mean(indicator(daily_return>0),20))",
    "description": "Ranks assets by 20-session return per unit of recent adverse excursion, modestly rewarded for positive-return breadth. The signal is shifted one session before forward-return testing to prevent look-ahead."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "return_window": 20,
    "drawdown_window": 20,
    "adverse_window": 20,
    "breadth_window": 20,
    "stabilizer": 0.01,
    "signal_lag": 1
  },
