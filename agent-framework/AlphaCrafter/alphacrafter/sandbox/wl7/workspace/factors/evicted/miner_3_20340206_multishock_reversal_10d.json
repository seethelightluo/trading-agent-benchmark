  "factor_name": "Lagged Multi-Day Volatility-Shock Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "shift(-rolling_sum(return,5)/(rolling_std(return,60)*sqrt(5)+1e-8),1)",
    "description": "Ranks assets higher when their lagged five-session cumulative loss is large relative to their trailing 60-session volatility; intended as a cross-asset rebound signal. Signal is lagged one completed session and cross-sectionally median demeaned."
