  "factor_name": "Cross-Asset Residual Reversal with Breadth Confirmation",
  "version": "1.0",
  "calculation": {
    "expression": "-((ret20_i - median_cross_section(ret20)) / (rolling_std(daily_returns,40)*sqrt(20))) * breadth_confirmation; signal shifted by 1 day",
    "description": "Ranks assets favoring reversal of 20-day performance relative to the cross-sectional median, normalized by 40-day volatility. The magnitude is scaled by cross-sectional breadth confirmation and lagged one completed session to avoid lookahead."
  },
  "dependencies": [
    "close",
    "daily_returns"
  ],
  "parameters": {
    "return_window": 20,
    "volatility_window": 40,
    "forward_horizon_admission": 1,
    "min_cross_section": 8,
    "breadth_confirmation": "(0.5+2*abs(breadth20-0.5))*(0.75+0.5*I(breadth20>0.5))"
  },
