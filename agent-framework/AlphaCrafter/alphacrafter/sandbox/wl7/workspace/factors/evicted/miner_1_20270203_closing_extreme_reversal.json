{
  "factor_id": "miner_1_20270203_closing_extreme_reversal",
  "factor_name": "Close-extreme weighted 3-day reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(pct_change(close,3).shift(1) / rolling_std(pct_change(close),20).shift(1)) * (1 + 0.5 * rolling_mean(2*abs((close-low)/(high-low+eps)-0.5),3).shift(1))",
    "description": "Reverses the lagged three-session return, volatility normalizes it, and modestly increases the score when recent closes repeatedly occur near daily highs or lows. All inputs are lagged one session."
  },
  "dependencies": [
    "close",
    "high",
    "low"
  ],
  "parameters": {
    "return_window": 3,
    "volatility_window": 20,
    "extreme_window": 3,
    "extreme_amplitude": 0.5,
    "min_periods_vol": 15,
    "min_periods_extreme": 2,
    "epsilon": 1e-12
  },
