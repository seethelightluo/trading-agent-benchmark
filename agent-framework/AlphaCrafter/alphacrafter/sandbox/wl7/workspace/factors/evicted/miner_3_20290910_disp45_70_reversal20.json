  "factor_name": "Intermediate-dispersion risk-adjusted reversal (45th-70th percentile)",
  "version": "1.0",
  "calculation": {
    "expression": "gate(disp_lag > rolling_quantile(disp_lag,252,0.45) and disp_lag <= rolling_quantile(disp_lag,252,0.70)) * (-(close[t-1]/close[t-21]-1)/std(returns[t-20:t-1]))",
    "description": "Ranks assets by negative prior 20-trading-day return divided by prior 20-day return volatility, activated only in an intermediate lagged cross-asset dispersion regime. All inputs are lagged through the prior completed day."
