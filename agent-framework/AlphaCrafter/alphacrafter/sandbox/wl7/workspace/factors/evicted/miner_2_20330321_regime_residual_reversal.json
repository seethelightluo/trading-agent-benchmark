{
  "factor_id": "miner_2_20330321_regime_residual_reversal",
  "factor_name": "VIX-regime weighted cross-sectional residual delayed reversal",
  "version": "1.0",
  "calculation": {
    "expression": "((-(return_10d.shift(10))/std(return_1d,40).shift(10)) - cross_sectional_mean) * clip(1 + 0.35*zscore(VIX,252), 0.35, 1.9)",
    "description": "Compute a 10-session reversal signal delayed by 10 completed sessions and normalized by lagged 40-session volatility. Remove the contemporaneous cross-sectional mean to isolate relative residual reversal, then smoothly scale by the lagged VIX 252-session z-score. All market inputs are lagged and therefore available at decision time."
  },
  "dependencies": [
    "close",
    "VIX"
  ],
  "parameters": {
    "return_lookback": 10,
    "execution_delay": 10,
    "volatility_window": 40,
    "regime_window": 252,
    "regime_sensitivity": 0.35,
    "regime_weight_floor": 0.35,
    "regime_weight_cap": 1.9,
    "minimum_cross_section": 8
  },
