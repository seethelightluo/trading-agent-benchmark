  "factor_name": "VIX-Conditioned Volatility-Compression Breakout",
  "version": "1.0",
  "calculation": {
    "expression": "lag1((close.pct_change(15)/rolling_std(pct_change(close),20))*(rolling_std(pct_change(close),60)/rolling_std(pct_change(close),20))*(rolling_median(VIX,60)/VIX))",
    "description": "The compression-breakout momentum signal is scaled by the trailing 60-day median VIX divided by current VIX. This reduces breakout exposure during unusually stressed volatility regimes while retaining directional information; all inputs are lagged one completed session."
  },
  "dependencies": [
    "close",
    "VIX observation-only macro series"
  ],
  "parameters": {
