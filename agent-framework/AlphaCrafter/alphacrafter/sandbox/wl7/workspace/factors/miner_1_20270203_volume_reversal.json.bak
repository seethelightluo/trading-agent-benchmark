  "version":"1.0",
  "calculation":{"expression":"shift( -(close/shift(close,2)-1) / rolling_std(pct_change(close),20) * (1 + 0.25*max(0,zscore_rolling20(diff(log(volume))))) , 1)","description":"Lagged two-day reversal, scaled by 20-day realized volatility and modestly strengthened when log-volume change is unusually positive. Higher values predict higher next-day return."},
  "dependencies":["close","volume"],
  "parameters":{"return_window":2,"volatility_window":20,"volume_z_window":20,"volume_weight":0.25,"lag_days":1},
