{
  "factor_id": "miner_1_20270622_multihorizon_agreement",
  "factor_name": "Multi-Horizon Agreement Risk-Adjusted Momentum",
  "version": "1.0",
  "calculation": {
    "expression": "((0.4 * return_5d + 0.6 * return_20d) / (std(return_1d,20) * sqrt(20))) * (0.5 + 0.5 * I[sign(return_5d)==sign(return_20d)])",
    "description": "A lagged cross-asset momentum signal that combines short and medium horizons, scales by 20-day realized volatility, and doubles the aligned component while retaining half exposure when horizons disagree. Values are shifted one trading day to prevent look-ahead."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "short_window": 5,
    "medium_window": 20,
    "volatility_window": 20,
    "short_weight": 0.4,
    "medium_weight": 0.6,
    "forecast_horizon_days": 10,
    "signal_lag_days": 1
  },
