{
  "factor_id": "miner_2_20340807_gated_momentum",
  "factor_name": "Bull-regime volatility-normalized 20-day momentum",
  "version": "1.0",
  "calculation": {
    "expression": "shift(1, where(close/shift(close,20)-1 > 0 when close/shift(close,60)-1 > 0, NaN)) / (rolling_std(pct_change(close),20)*sqrt(20))",
    "description": "For each tradable asset, compute 20-day total return divided by annualized 20-day realized volatility, retain the signal only when the lagged 60-day return is positive, then lag the complete signal by one session to prevent look-ahead. Missing gated values are excluded from cross-sectional ranking."
  },
  "dependencies": ["close"],
  "parameters": {"momentum_window_days": 20, "regime_window_days": 60, "volatility_window_days": 20, "volatility_annualization": "sqrt(20)", "signal_lag_days": 1, "minimum_vol_observations": 15, "minimum_cross_section": 8},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2034-08-02",
    "as_of": "2034-08-07",
    "metrics": {
