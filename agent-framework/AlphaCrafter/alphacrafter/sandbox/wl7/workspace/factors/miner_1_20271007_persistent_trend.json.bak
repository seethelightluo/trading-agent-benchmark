{
  "factor_id": "miner_1_20271007_persistent_trend",
  "factor_name": "Persistence-Weighted Risk-Adjusted Trend 30d",
  "version": "1.0",
  "calculation": {
    "expression": "shift1(pct_change(close,30) / (rolling_std(pct_change(close),30)+1e-12)) * shift1(rolling_mean(indicator(pct_change(close)>0),20))",
    "description": "Ranks each tradable benchmark by prior-session-lagged 30-session momentum divided by realized volatility, weighted by the prior-session-lagged fraction of positive daily returns over the preceding 20 sessions. All inputs are lagged to prevent look-ahead."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "momentum_window": 30,
    "volatility_window": 30,
    "persistence_window": 20,
    "minimum_persistence_observations": 15,
    "signal_lag_sessions": 1,
    "forward_horizon": 10
  },
