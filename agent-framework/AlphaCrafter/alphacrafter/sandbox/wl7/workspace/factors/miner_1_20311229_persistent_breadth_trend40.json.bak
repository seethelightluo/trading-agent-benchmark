{
  "factor_id": "miner_1_20311229_persistent_breadth_trend40",
  "factor_name": "Persistent Cross-Asset Breadth Conditional Trend 40D",
  "version": "1.0",
  "calculation": {
    "expression": "lag1(pct_change(close,40) * sign(rolling_mean(rolling_mean(pct_change(close,1),20)>0,5)-0.5))",
    "description": "For each tradable asset, use its 40-trading-day return, multiplied by the lagged sign of a persistent broad-market breadth regime. Breadth is the fraction of the 15 assets whose 20-day mean daily return is positive; the regime is positive when its 5-day average is at least 50%, otherwise negative. The final one-day lag ensures only completed data are used."
  },
  "dependencies": ["close", "daily_return"],
  "parameters": {
    "universe_size": 15,
    "trend_window_days": 40,
    "breadth_return_window_days": 20,
    "breadth_persistence_days": 5,
    "breadth_threshold": 0.5,
    "signal_lag_days": 1
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2031-12-26",
    "metrics": {
      "admission_horizon_days": 20,
      "ic": 0.031867,
      "icir": 0.090844,
      "ic_hit_ratio": 0.5411,
      "ic_dates": 3748,
      "average_instruments": 15.0,
      "coverage": 0.9999,
      "turnover_proxy": 0.076805,
      "max_abs_library_correlation": null
    },
    "regime_notes": "Validated across the full synthetic cross-asset history, including pandemic, inflation, rate, crypto, and divergent equity regimes. Small cross-section uncertainty is mitigated by 3,748 daily observations; interpretation remains conservative.",
    "signal_artifact": "scripts/miner_1_20311229_persistent_breadth_trend_signal.csv"
  },
