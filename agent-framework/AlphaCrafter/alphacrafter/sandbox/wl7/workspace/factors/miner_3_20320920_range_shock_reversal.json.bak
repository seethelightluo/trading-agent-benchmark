{
  "factor_id": "miner_3_20320920_range_shock_reversal",
  "factor_name": "Range-Normalized Shock Reversal with Slow-Trend Conditioning",
  "version": "2032-09-20",
  "calculation": {
    "expression": "(-return(close,3)/median((high-low)/close,20)) * (1 + 0.35*tanh(-return(close,60)/0.15))",
    "description": "Contrarian three-session price shock normalized by the trailing 20-session median daily range; the reversal signal is amplified modestly when the 60-session trend is negative. All inputs are lag-safe at the decision close."
  },
  "dependencies": ["close", "high", "low"],
  "parameters": {"shock_window": 3, "range_window": 20, "trend_window": 60, "trend_scale": 0.15, "trend_amplifier": 0.35, "forward_horizon": 20},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2032-09-19",
    "metrics": {
