{
  "factor_id": "miner_3_20340918_stress_acceleration_reversal5",
  "factor_name": "VIX-stress-conditioned short-versus-medium acceleration reversal",
  "version": "1.0",
  "calculation": {
    "expression": "(return_5d - return_20d) * (1 + 0.5 * I(VIX_return_10d > 0))",
    "description": "Cross-asset acceleration signal: recent 5-day performance relative to 20-day performance, amplified when the observation-only VIX has risen over the prior 10 trading days. Positive values are interpreted according to the validated reversal direction against forward returns.",
    "lagging": "All prices and VIX observations are through the prior completed trading day; forward returns are used only for validation."
  },
  "dependencies": [
    "close",
    "VIX.close"
  ],
  "parameters": {
    "short_window": 5,
    "medium_window": 20,
    "stress_window": 10,
    "stress_multiplier": 0.5,
    "forward_horizon": 5,
    "min_cross_section": 8
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-02 through 2034-09-15 (information available through 2034-09-15)",
