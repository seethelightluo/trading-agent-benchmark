{
  "factor_id": "miner_3_20300909_dispersion_reversal10",
  "factor_name": "90-day dispersion-gated volatility-normalized ten-day reversal",
  "version": "1.0",
  "calculation": {
    "expression": "clip(shift_1((-return_10 / realized_vol_30) * I(cross_sectional_std(return_10) > rolling_median_90(cross_sectional_std(return_10))), -5, 5)",
    "description": "For each asset, take the negative ten-session return divided by 30-session daily-return volatility. Activate only when cross-asset ten-session return dispersion exceeds its trailing 90-date median. Lag the complete signal one session to prevent look-ahead."
  },
  "dependencies": ["close"],
  "parameters": {"return_lookback": 10, "volatility_lookback": 30, "dispersion_window": 90, "dispersion_min_periods": 45, "signal_lag": 1, "clip": [-5, 5], "min_cross_section": 8},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2030-09-09",
    "last_validated": "2030-09-09",
    "metrics": {
      "horizon_days": 1,
      "ic": 0.00982410,
      "icir": 0.46558577,
      "hit_ratio": 0.5040,
      "valid_dates": 1504,
      "average_instruments": 13.26,
      "factor_coverage": 0.9168,
      "rank_turnover": 0.065488,
      "max_abs_library_correlation": null,
      "decay_ic_5d": 0.00075048,
      "decay_ic_10d": -0.01284297,
      "decay_ic_20d": -0.01702596
    },
    "regime_notes": "Daily admission passes conservatively on 1-day IC and ICIR. Trough/medium regimes were mixed while the late third was positive; longer-horizon decay reverses and is not a holding-period claim."
  },
  "signal_artifact": "scripts/miner_3_20300909_dispersion_reversal10_signal.csv",
