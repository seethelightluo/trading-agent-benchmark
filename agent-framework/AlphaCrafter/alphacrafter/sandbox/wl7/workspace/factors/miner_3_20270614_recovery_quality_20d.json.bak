{
  "factor_id": "miner_3_20270614_recovery_quality_20d",
  "factor_name": "Drawdown- and volatility-adjusted 20-day recovery quality",
  "version": "1.0",
  "calculation": {
    "expression": "((close / close.shift(20)) - 1) / (max_drawdown_20 + 0.01) / rolling_std(pct_change(close), 20)",
    "description": "Ranks assets by 20-session recovery return, rewarding positive displacement achieved with shallow trailing drawdowns and lower realized volatility. The complete signal is shifted by one session before use; max_drawdown_20 is the rolling maximum of negative drawdown from the 20-session rolling peak. The 0.01 floor stabilizes the denominator.",
    "signal_artifact": "scripts/miner_3_20270614_recovery_quality_signal.csv"
  },
  "dependencies": ["close"],
  "parameters": {"return_window": 20, "drawdown_window": 20, "volatility_window": 20, "drawdown_floor": 0.01, "signal_lag_sessions": 1, "forward_horizon_admission": 1},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-02 through 2027-06-13",
    "last_validated": "2027-06-14T00:00:00Z",
