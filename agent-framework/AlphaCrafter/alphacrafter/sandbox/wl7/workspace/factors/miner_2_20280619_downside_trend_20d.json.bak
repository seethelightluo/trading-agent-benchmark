  "factor_name": "Downside-volatility-scaled 20-day momentum",
  "version": "1.0",
  "calculation": {
    "expression": "shift(1, pct_change(close,20) / (sqrt(rolling_mean(min(pct_change(close,1),0)^2,40)) + 0.005))",
    "description": "Lagged 20-session price momentum divided by trailing 40-session downside deviation, with a small stabilizer. Higher values indicate stronger return per unit of downside volatility. The one-session lag prevents use of the current incomplete observation."
  },
  "dependencies": ["close"],
  "parameters": {"momentum_window": 20, "downside_window": 40, "downside_min_periods": 30, "stabilizer": 0.005, "signal_lag": 1},
