{
  "factor_id": "miner_3_20270823_volume_confirmed_trend_20d",
  "factor_name": "Lagged Volume-Confirmed 20-Day Trend",
  "version": "1.0",
  "calculation": {
    "expression": "rank_cs(lag1(pct_change(close,20) * sqrt(clip(volume / rolling_median(volume,60), 0.5, 2.0))))",
    "description": "Ranks each tradable asset cross-sectionally by its prior-session 20-day price trend amplified by relative volume participation. Relative volume is clipped to limit outlier influence; all inputs are shifted one completed session to avoid look-ahead. Higher values indicate persistent trends supported by unusually strong participation."
  },
  "dependencies": ["close", "volume"],
  "parameters": {"return_window": 20, "volume_baseline": 60, "volume_clip_low": 0.5, "volume_clip_high": 2.0, "lag_sessions": 1, "rank_method": "cross_sectional_percentile"},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2027-08-22 available history",
