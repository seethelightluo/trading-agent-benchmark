{
  "factor_id": "miner_3_20351001_dxy_conditioned_trend10",
  "factor_name": "DXY-Conditioned Volatility-Scaled Trend (10D)",
  "version": "1.0",
  "calculation": {
    "expression": "cross_sectional_demean((close/close.shift(20)-1)/(rolling_std(pct_change(close),40)*sqrt(20)) * (1-2*I(DXY > rolling_median(DXY,60)))) then lag 1 day",
    "description": "Ranks 20-day volatility-scaled trend, following trend when DXY is below its trailing 60-day median and reversing it when DXY is above that median. The one-day lag prevents look-ahead."
  },
  "dependencies": ["close", "DXY", "pct_change", "rolling_std"],
  "parameters": {"trend_window": 20, "vol_window": 40, "dxy_regime_window": 60, "forward_horizon": 10, "min_vol_observations": 25, "min_cross_section": 8, "signal_lag": 1},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2035-09-30",
    "metrics": {
      "ic": 0.00726975,
      "icir": 0.38122367,
      "horizon_days": 10,
      "dates": 2380,
      "average_instruments": 11.21,
      "hit_ratio": 0.5059,
      "coverage": 0.43916493,
      "turnover": 0.24588678,
      "max_abs_library_correlation": null
    },
    "regime_notes": "H10 IC: 2027-2030 +0.01664644 (1043 observations), 2031-2034 +0.00278044 (1043), 2035 YTD through 2035-09-30 -0.02073710 (185). H5 was +0.01224541 with ICIR +0.62409778; H20 failed at -0.00024746. Interpret as regime-sensitive and not standalone.",
    "signal_artifact": "scripts/miner_3_20351001_dxy_conditioned_trend_signal.csv",
