{
  "factor_id": "miner_1_20290716_agreement_trend",
  "factor_name": "Agreement-weighted risk-adjusted 20-day trend",
  "version": "1.0",
  "calculation": {
    "expression": "((r20 / (std_20_lagged * sqrt(20))) * ((I[sign(r5)=sign(r20)] + I[sign(r60)=sign(r20)])/2))",
    "description": "Use only information through the prior completed day. Compute lagged 20-session return r20, normalize by lagged 20-session realized volatility, and retain the signal only in proportion to whether lagged 5-session and 60-session returns agree with the 20-session direction. The observed negative IC indicates the factor should be used with a contrarian direction if selected by the ensemble."
  },
  "dependencies": ["close"],
  "parameters": {"short_window": 5, "trend_window": 20, "long_window": 60, "vol_window": 20, "forward_horizon": 10, "min_valid_cross_section": 8},
