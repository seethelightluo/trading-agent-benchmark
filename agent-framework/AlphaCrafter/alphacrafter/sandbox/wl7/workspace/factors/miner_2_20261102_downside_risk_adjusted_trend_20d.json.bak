{
  "factor_id": "downside_risk_adjusted_trend_20d",
  "factor_name": "Downside-Risk-Adjusted 20-Day Trend",
  "version": "2026-11-02",
  "calculation": {
    "expression": "lag1(pct_change(close,20) / (sqrt(rolling_mean(20, max(-daily_return,0)^2)) + 1e-8))",
    "description": "Ranks assets by their lagged 20-trading-day return scaled by recent downside semideviation. Higher values indicate stronger trend per unit of downside risk. The one-day lag prevents use of the current completed day's return in the decision signal."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "lookback_days": 20,
    "downside_window": 20,
    "minimum_periods": 15,
    "lag_days": 1,
    "epsilon": 1e-08,
    "forward_horizon_days": 1
  },
