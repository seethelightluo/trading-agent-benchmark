{
  "factor_id": "miner_2_20300114_dispersion_conditioned_residual10",
  "factor_name": "Dispersion-Conditioned Cross-Asset Residual Trend 10d with 5d Skip",
  "version": "1.0",
  "calculation": {
    "expression": "where(mean rolling 20d cross-asset return dispersion <= its trailing 252d median, rolling_sum_10d(asset_return - cross_sectional_median_return).shift(5))",
    "description": "Ranks ten-day residual returns relative to the cross-asset median, delayed five trading days, and only activates during non-extreme dispersion regimes. The validated raw signal is contrarian."
  },
  "dependencies": ["close"],
  "parameters": {"trend_window": 10, "skip_days": 5, "dispersion_window": 20, "dispersion_threshold_window": 252, "minimum_threshold_history": 126, "forward_horizon": 10, "minimum_cross_section": 8, "direction": -1},
