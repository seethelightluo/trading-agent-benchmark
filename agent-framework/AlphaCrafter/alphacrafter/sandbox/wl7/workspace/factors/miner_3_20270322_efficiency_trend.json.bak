{
  "factor_id": "miner_3_20270322_efficiency_trend",
  "factor_name": "Efficiency-Weighted Volatility-Adjusted 15-Day Trend",
  "version": "1.0",
  "calculation": {
    "expression": "shift((sum_return_15 / (std_return_20 * sqrt(20))) * (0.5 + abs(sum_return_20) / (sum_abs_return_20 + eps)), 1)",
    "description": "Lagged signed 15-session momentum, scaled by 20-session realized volatility and multiplied by a bounded trend-efficiency weight. Higher values indicate persistent, risk-adjusted upward trends; lower values indicate persistent downward trends. The one-session lag prevents look-ahead bias."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "momentum_window": 15,
    "volatility_window": 20,
    "efficiency_window": 20,
    "minimum_momentum_observations": 12,
    "minimum_volatility_observations": 15,
    "efficiency_floor": 0.5,
    "epsilon": 1e-12,
    "lag_sessions": 1
  },
  "validation": {
    "status": "EFFECTIVE",
