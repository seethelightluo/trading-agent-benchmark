{
  "factor_id": "miner_2_20311229_downside_sharpe60_reversal",
  "factor_name": "Lagged 60-day downside-Sharpe momentum reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-shift(pct_change(close,60) / sqrt(rolling_mean_60(min(return,0)^2)), 1)",
    "description": "One-session-lagged reversal of 60-session return normalized by downside deviation; higher values favor assets with weaker downside-risk-adjusted trailing performance."
  },
  "dependencies": ["close"],
  "parameters": {
    "lookback": 60,
    "downside_window": 60,
    "minimum_downside_observations": 40,
    "lag": 1,
    "forward_horizon_days": 10
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01/2031-12-29",
    "validation_date": "2031-12-29T00:00:00Z",
    "regime_notes": "Across 1,707 dates and an average 11.75 instruments per date, the raw downside-Sharpe signal was consistently negatively predictive; reversing it produced positive IC in all three chronological thirds. Small cross-section warrants conservative interpretation.",
    "metrics": {
