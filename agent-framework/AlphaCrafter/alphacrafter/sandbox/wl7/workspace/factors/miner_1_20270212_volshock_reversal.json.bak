{
  "factor_id": "miner_1_20270212_volshock_reversal",
  "factor_name": "Volatility-Shock 3-Day Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "shift1((-sum(ret,3)/(sqrt(3)*rolling_std(ret,20))) * (rolling_std(ret,20)/rolling_std(ret,60)))",
    "description": "Fade the lagged three-session return, scaling by short-horizon volatility and emphasizing volatility-shock conditions through the 20-day to 60-day volatility ratio. All inputs are lagged one session before use."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "reversal_window": 3,
    "short_vol_window": 20,
    "long_vol_window": 60,
    "lag": 1
  },
