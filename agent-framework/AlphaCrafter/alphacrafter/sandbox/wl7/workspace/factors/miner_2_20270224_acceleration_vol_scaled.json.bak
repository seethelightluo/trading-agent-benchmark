{
  "factor_id": "miner_2_20270224_acceleration_vol_scaled",
  "factor_name": "Volatility-Scaled Trend Acceleration",
  "version": "1.0",
  "calculation": {
    "expression": "(pct_change(close,20) - pct_change(close,60)/3) / rolling_std(pct_change(close),30), shifted by 1 session",
    "description": "Measures medium-horizon return acceleration relative to the slow trend, normalized by recent volatility. The one-session lag prevents look-ahead and makes the signal suitable for next-session cross-sectional ranking."
  },
  "dependencies": ["close"],
  "parameters": {"fast_window": 20, "slow_window": 60, "slow_scaling": 3, "volatility_window": 30, "lag": 1, "forward_horizons": [1,5,10,20]},
  "validation": {
