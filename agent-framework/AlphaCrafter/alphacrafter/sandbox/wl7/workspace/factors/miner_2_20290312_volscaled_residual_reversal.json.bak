  "factor_name": "Volatility-scaled cross-asset residual 20-day reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(return_20d_i - median_j(return_20d_j)) / stdev(return_1d_i,20)",
    "description": "Contrarian cross-sectional residual 20-day return, normalized by each asset's trailing 20-day daily-return volatility. Uses only completed close prices and contemporaneous cross-section values."
