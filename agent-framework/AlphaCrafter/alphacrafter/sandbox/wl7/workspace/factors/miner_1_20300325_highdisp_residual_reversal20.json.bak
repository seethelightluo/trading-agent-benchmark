{
  "factor_id": "miner_1_20300325_highdisp_residual_reversal20",
  "factor_name": "80th-percentile dispersion-gated residual reversal 20d",
  "version": "1.0",
  "calculation": {
    "expression": "-rolling_sum_20d(asset_return - cross_sectional_median_return), gated when rolling_mean_20d(cross_sectional_return_std) > trailing_252d_80th_percentile, lagged 1 day",
    "description": "Fades 20-day relative winners and favors relative losers only during unusually high cross-asset dispersion. Signal is lagged one completed trading day and ranked cross-sectionally."
  },
  "dependencies": ["close"],
