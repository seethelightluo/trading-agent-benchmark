{
  "factor_id": "miner_1_20310224_disp75_blend_reversal",
  "factor_name": "75th-percentile dispersion-gated blended shock reversal",
  "version": "1.0",
  "calculation": {
    "expression": "I(dispersion_20 > lagged_252d_75th_percentile) * -(0.7*sum_return_3/volatility_20 + 0.3*sum_return_10/volatility_20)",
    "description": "Cross-asset short-horizon contrarian shock signal, activated only when the 20-session average cross-sectional return dispersion is above its trailing 252-session 75th percentile. Signal uses completed daily closes and is evaluated against next-session returns."
  },
  "dependencies": ["close"],
  "parameters": {"short_window": 3, "long_window": 10, "volatility_window": 20, "dispersion_window": 20, "threshold_percentile": 0.75, "threshold_window": 252, "blend_short": 0.7, "blend_long": 0.3, "lagged_inputs": true},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2031-02-20",
    "metrics": {
