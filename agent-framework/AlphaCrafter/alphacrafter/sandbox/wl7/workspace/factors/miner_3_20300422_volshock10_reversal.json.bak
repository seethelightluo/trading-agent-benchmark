{
  "factor_id": "miner_3_20300422_volshock10_reversal",
  "factor_name": "10-day Volatility-Shock Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-sum(ret,10) * (std(log_return,10) / (std(log_return,60)+epsilon)), lagged 1 day",
    "description": "Reverses the recent 10-trading-day return, with stronger signal when short-run realized volatility is elevated relative to its 60-day baseline. Cross-sectional ranking is used for portfolio construction."
  },
  "dependencies": ["close"],
  "parameters": {"return_window": 10, "short_vol_window": 10, "long_vol_window": 60, "annualization": "none", "lag": 1, "epsilon": 1e-10},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2030-04-15",
    "metrics": {
      "forward_horizon_days": 10,
      "ic": 0.0401994113,
