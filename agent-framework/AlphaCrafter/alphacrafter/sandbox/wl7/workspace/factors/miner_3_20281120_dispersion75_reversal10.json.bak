{
  "factor_id": "miner_3_20281120_dispersion75_reversal10",
  "factor_name": "75th-percentile-dispersion-gated volatility-normalized ten-day reversal",
  "version": "1.1",
  "calculation": {
    "expression": "demean_cs((-return_10d/(sqrt(10)*volatility_30d)) * I(mean_cross_asset_std_5d > rolling_quantile(mean_cross_asset_std_5d,60,0.75)))",
    "description": "Ranks a volatility-normalized ten-day reversal signal only during unusually high cross-asset dispersion, where dispersion is above its trailing 60-day 75th percentile; signals are cross-sectionally demeaned."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "reversal_window_days": 10,
    "volatility_window_days": 30,
    "dispersion_window_days": 5,
    "dispersion_threshold_window_days": 60,
    "dispersion_threshold_quantile": 0.75,
    "forward_horizon_days": 20,
    "minimum_cross_section": 8
  },
