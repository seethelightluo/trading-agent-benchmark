{
  "factor_id": "miner_2_20321018_smoothed_residual_reversal10",
  "factor_name": "Smoothed cross-sectional residual reversal 10-day",
  "version": "1.0",
  "calculation": {
    "expression": "mean_{k=0..4}[-(log_return_10d(t-k)-cross_sectional_median(log_return_10d(t-k)))/(sqrt(40)*std(log_return_1d,40))], lagged 1 day",
    "description": "Ranks assets by the negative ten-session log-return residual versus the contemporaneous universe median, volatility-normalized and averaged over the latest five completed observations. The one-session lag prevents look-ahead."
  },
  "dependencies": ["close"],
  "parameters": {"return_window": 10, "volatility_window": 40, "smoothing_window": 5, "minimum_smoothing_observations": 3, "lag": 1, "minimum_cross_section": 8},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2032-10-15",
    "validation_date": "2032-10-18",
    "regime_notes": "Validated across the full synthetic cross-asset history; H10 IC was positive in each chronological third. Small universe requires conservative interpretation.",
