{
  "factor_id": "miner_1_20281120_vix_gated_reversal20",
  "factor_name": "VIX-Gated Risk-Adjusted 20-Day Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-((close_t/close_{t-20})-1) / (sqrt(20)*std(returns_{t-39:t})) when VIX_t < median(VIX_{t-59:t}), else 0; cross-sectional demean",
    "description": "Contrarian 20-session return normalized by trailing 40-session volatility, activated only in low-VIX regimes using observation-only VIX data available at signal time. The negative sign makes the factor favor recent losers."
  },
  "dependencies": [
    "close",
    "daily_returns",
    "VIX observation-only macro signal"
  ],
  "parameters": {
    "lookback_return": 20,
    "volatility_window": 40,
    "vix_window": 60,
    "forward_horizon": 20,
    "minimum_cross_section": 8
  },
  "validation": {
    "status": "EFFECTIVE",
    "metrics": {
      "ic": 0.095165,
