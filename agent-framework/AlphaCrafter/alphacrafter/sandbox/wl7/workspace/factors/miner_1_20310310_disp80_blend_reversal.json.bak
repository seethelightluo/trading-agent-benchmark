{
  "factor_id": "miner_1_20310310_disp80_blend_reversal",
  "factor_name": "80th-percentile dispersion-gated blended shock reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(0.7*sum_return_3d/volatility_20d + 0.3*sum_return_10d/volatility_20d) * I(rolling_mean_20d_cross_asset_return_std > lagged_252d_80th_percentile)",
    "description": "Ranks assets for one-day contrarian exposure using volatility-normalized 3-day and 10-day returns, activated only when lagged cross-asset dispersion is unusually high. All inputs use completed daily observations."
  },
  "dependencies": ["close"],
  "parameters": {
    "short_window": 3,
    "long_window": 10,
    "volatility_window": 20,
    "dispersion_window": 20,
    "threshold_window": 252,
    "threshold_quantile": 0.8,
    "short_weight": 0.7,
    "long_weight": 0.3,
    "minimum_cross_section": 8
  },
  "validation": {
