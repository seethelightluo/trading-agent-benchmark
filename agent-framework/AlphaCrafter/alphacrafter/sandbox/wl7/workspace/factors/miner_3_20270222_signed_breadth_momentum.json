  "factor_id": "miner_3_20270222_signed_breadth_momentum",
  "factor_name": "Signed Cross-Asset Breadth-Confirmed Momentum",
  "version": "20270222",
  "calculation": {
    "expression": "shift((return_15d / realized_vol_20d) * (0.5 + cross_asset_positive_return_breadth_20d), 1)",
    "description": "Scale each asset's 15-session momentum by its 20-session realized volatility, then multiply by the contemporaneous cross-asset fraction of positive daily returns plus 0.5. The one-session lag ensures the signal uses only completed data. Unlike absolute breadth confirmation, signed breadth preserves stronger trend exposure in broadly positive tapes and attenuates it in bearish tapes without reversing the signal."
  },
