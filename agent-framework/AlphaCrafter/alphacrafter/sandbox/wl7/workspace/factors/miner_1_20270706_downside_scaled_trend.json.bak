{
  "factor_id": "miner_1_20270706_downside_scaled_trend",
  "factor_name": "Downside-Volatility-Scaled 15-Day Trend",
  "version": "1.0",
  "calculation": {
    "expression": "shift1(pct_change(close,15) / (rolling_std(min(pct_change(close),0),30) + 1e-12))",
    "description": "Ranks the 15 tradable cross-asset benchmarks by prior-session-lagged 15-session return divided by 30-session downside-return volatility. The one-session lag prevents use of incomplete or future information."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "trend_window": 15,
    "downside_volatility_window": 30,
    "minimum_volatility_observations": 20,
    "signal_lag_sessions": 1,
    "forward_horizon": 10
  },
