{
  "factor_id": "miner_2_20281204_defensive_relative_reversal04",
  "factor_name": "Bearish-breadth defensive relative reversal (40% threshold)",
  "version": "2028-12-04",
  "calculation": {
    "expression": "-pct_change(close,20)/(rolling_std(pct_change(close,1),30)*sqrt(20)) + 0.35*I(breadth20<0.40)*I(symbol in {XAU,US10Y,CN10Y})",
    "description": "Cross-asset 20-day risk-adjusted reversal, with a small defensive tilt only when fewer than 40% of tradable assets have positive 20-day returns. Signals are used cross-sectionally; all inputs are lagged through the completed observation date."
  },
  "dependencies": ["close"],
  "parameters": {"lookback_days": 20, "volatility_window_days": 30, "vol_min_periods": 20, "breadth_threshold": 0.40, "defensive_tilt": 0.35, "defensive_assets": ["XAU", "US10Y", "CN10Y"], "forward_horizon_days": 10},
  "validation": {
    "status": "EFFECTIVE",
    "period": {"start": "2026-04-23", "end": "2028-12-03"},
