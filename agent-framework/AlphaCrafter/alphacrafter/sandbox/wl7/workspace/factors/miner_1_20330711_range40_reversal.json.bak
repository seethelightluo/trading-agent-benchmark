{
  "factor_id": "miner_1_20330711_range40_reversal",
  "factor_name": "Volatility-Scaled 40-Session Range-Position Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "(0.5 - (close - rolling_min(close,40,min_periods=30))/(rolling_max(close,40,min_periods=30)-rolling_min(close,40,min_periods=30)+epsilon)) / rolling_std(pct_change(close),20,min_periods=15), then shift(1)",
    "description": "Contrarian cross-asset signal favoring assets near the lower end of their trailing 40-session price range, scaled by inverse 20-session realized volatility. Signal is lagged one completed session to avoid look-ahead."
  },
  "dependencies": ["close"],
  "parameters": {
    "range_window": 40,
    "range_min_periods": 30,
    "volatility_window": 20,
    "volatility_min_periods": 15,
    "forward_horizon_days": 10,
    "signal_lag_days": 1,
    "epsilon": 1e-12
  },
  "validation": {
