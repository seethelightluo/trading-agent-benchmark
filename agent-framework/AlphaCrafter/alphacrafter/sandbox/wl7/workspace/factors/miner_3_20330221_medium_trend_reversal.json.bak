  "factor_name": "Delayed 60-session volatility-normalized medium-trend reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-((close / close.shift(60)) - 1) / (rolling_std(pct_change(close), 40) * sqrt(10)); signal = expression.shift(1)",
    "description": "Cross-sectional reversal of the prior 60-session return, scaled by prior 40-session realized daily volatility and delayed one completed session to avoid lookahead."
  },
  "dependencies": ["close"],
  "parameters": {"lookback_return_sessions": 60, "volatility_window_sessions": 40, "volatility_horizon_scale": 10, "execution_delay_sessions": 1, "forward_validation_horizon_sessions": 10},
