{
  "factor_id": "miner_2_20310602_dispersion12_shock_reversal",
  "factor_name": "Moderate-Dispersion-Gated Three-Day Shock Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "I(mean(abs(r3)) > 1.20 * median(abs(r3))) * -(r3 - cross_sectional_median(r3)) / (rolling_std(daily_return,20) * sqrt(3))",
    "description": "When cross-sectional three-day absolute-return dispersion is moderately elevated, rank assets by the negative deviation of their three-day return from the contemporaneous cross-sectional median, normalized by 20-day realized volatility. The gate and all inputs use data observable at the decision date; forward returns are used only for validation."
  },
  "dependencies": ["close"],
  "parameters": {"shock_lookback_days": 3, "volatility_lookback_days": 20, "dispersion_threshold_multiple": 1.2, "minimum_cross_section": 8, "signal_lag_days": 1},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-06 through 2031-06-02",
    "timestamp": "2031-06-02T00:00:00Z",
    "regime_notes": "Positive across early, middle, and late chronological thirds; strongest early and decays beyond five trading days. Small cross-asset universe requires conservative interpretation.",
