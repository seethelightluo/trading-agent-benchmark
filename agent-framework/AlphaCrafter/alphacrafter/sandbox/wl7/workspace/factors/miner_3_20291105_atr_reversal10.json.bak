{
  "factor_id": "miner_3_20291105_atr_reversal10",
  "factor_name": "ATR-normalized 10-day reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(close[t-1]/close[t-11]-1) / mean(abs(close/close.shift(1)-1),20)[t-1]",
    "description": "Ranks prior 10-trading-day losers more highly after normalizing the lagged return by each asset's lagged 20-day mean absolute daily move. All inputs are shifted to the previous completed day.",
