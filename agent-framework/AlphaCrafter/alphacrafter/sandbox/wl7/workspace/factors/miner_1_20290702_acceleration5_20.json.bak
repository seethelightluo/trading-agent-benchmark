{
  "factor_id": "miner_1_20290702_acceleration5_20",
  "factor_name": "Lagged Five-Day Trend Acceleration over Twenty-Day Baseline",
  "version": "2029-07-02",
  "calculation": {
    "expression": "(lag1(pct_change(close,5)) - lag1(pct_change(close,20))/4) / (sqrt(20)*rolling_std(lag1(pct_change(close)),20))",
    "description": "Measures whether the latest five-session return is accelerating relative to the average daily return implied by the prior twenty-session trend, normalized by prior realized volatility. All signal inputs are lagged one completed session. Higher values indicate strengthening trend."
  },
  "dependencies": ["close"],
  "parameters": {
    "short_window_sessions": 5,
    "baseline_window_sessions": 20,
    "volatility_window_sessions": 20,
    "lag_sessions": 1,
    "forward_validation_horizon_sessions": 10,
    "minimum_cross_section": 8
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2026-07-31 through 2029-06-18",
    "last_validated": "2029-07-02T00:00:00Z",
    "metrics": {
