{
  "factor_id": "miner_2_20350903_breadth_trend_blend_h20",
  "factor_name": "Breadth-conditioned multi-horizon volatility-normalized trend blend",
  "version": "1.0",
  "calculation": {
    "expression": "shift1(0.5*((close/close[-20]-1)/(std_return_40*sqrt(20))) + 0.5*((close/close[-60]-1)/(std_return_40*sqrt(60)))) * (2*breadth_20d-1)",
    "description": "Blend 20-day and 60-day volatility-normalized returns, lagged one completed day, and multiply by the lagged cross-asset fraction with positive 20-day return transformed to [-1,1]. Higher values predict higher 20-day forward returns. Uses only the 15 tradable benchmark assets."
  },
  "dependencies": ["close", "daily_returns"],
  "parameters": {"short_horizon": 20, "long_horizon": 60, "volatility_window": 40, "blend_short": 0.5, "blend_long": 0.5, "breadth_window": 20, "signal_lag": 1, "forward_horizon": 20},
