{
  "factor_id": "miner_3_20270604_risk_adjusted_20d_momentum",
  "factor_name": "Lagged Risk-Adjusted 20-Day Momentum",
  "version": "2027-06-04",
  "calculation": {
    "expression": "lag1( pct_change(close,20) / (sqrt(20) * rolling_std(pct_change(close),20)) )",
    "description": "Cross-sectional momentum over the prior 20 sessions divided by prior 20-session realized volatility; all inputs are lagged one completed session to prevent look-ahead. Higher values indicate stronger risk-adjusted trend."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "lookback_sessions": 20,
    "volatility_window": 20,
    "lag_sessions": 1,
    "epsilon": 1e-08,
    "forward_validation_horizon_sessions": 10
  },
  "validation": {
