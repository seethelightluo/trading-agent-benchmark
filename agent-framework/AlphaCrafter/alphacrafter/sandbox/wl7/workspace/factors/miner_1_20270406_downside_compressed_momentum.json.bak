{
  "factor_id": "miner_1_20270406_downside_compressed_momentum",
  "factor_name": "Downside-Adjusted Compressed Momentum",
  "version": "1.0",
  "calculation": {
    "expression": "lag1((close/close.shift(20)-1) / (std(negative_returns,30)*sqrt(20)) * clip(std(returns,60)/std(returns,20),0.5,2.0))",
    "description": "Twenty-session momentum scaled by downside volatility, with higher score when medium-term volatility is compressed relative to its 60-day level. All inputs are shifted one completed session before the forward return."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "momentum_window": 20,
    "downside_vol_window": 30,
    "vol_fast_window": 20,
    "vol_slow_window": 60,
    "compression_clip": [
      0.5,
      2.0
    ],
    "lag_sessions": 1
  },
