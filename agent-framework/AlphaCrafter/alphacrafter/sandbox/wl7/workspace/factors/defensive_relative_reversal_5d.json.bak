{
  "factor_id": "defensive_relative_reversal_5d",
  "factor_name": "5-Day Defensive-Anchor Relative Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(log(close_t/close_{t-5}) - median_{d in {XAU,US10Y,CN10Y}} log(close_d,t/close_d,t-5))",
    "description": "Ranks each tradable asset higher when its lagged five-day return underperformed the median five-day return of defensive anchors XAU, US10Y, and CN10Y; designed to capture short-horizon cross-asset reversal relative to a defensive regime basket. The signal is lagged and uses only completed prices."
  },
  "dependencies": ["close", "XAU", "US10Y", "CN10Y"],
  "parameters": {
    "lookback_days": 5,
    "defensive_anchors": ["XAU", "US10Y", "CN10Y"],
    "normalization": "none",
    "minimum_cross_section": 8
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01/2032-07-10",
    "metrics": {
      "horizon_days": 1,
      "ic": 0.03122516297323094,
      "icir": 0.09224982215243696,
      "hit_ratio": 0.5418950665622553,
      "valid_dates": 2554,
      "average_instruments": 14.634203602191073,
      "coverage": 0.9791324736225089,
      "rank_turnover": 0.18014206323987286,
      "max_abs_library_correlation": null
    },
    "regime_notes": "Validated across 2,554 daily cross-sectional observations and 15 tradable benchmark instruments; uncertainty remains material for the small cross-section. Positive daily IC and ICIR clear benchmark gates.",
    "signal_artifact": "scripts/miner_3_20320712_raw_defensive_reversal_5d_signal.csv"
  },
  "tags": ["reversal", "cross-asset", "defensive-regime", "short-horizon"],
