{
  "factor_id": "miner_1_20340515_risk_reversal30",
  "factor_name": "Risk-normalized 30-session reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(close/close.shift(30)-1)/(rolling_std(pct_change(close),90)*sqrt(30)), then lag one completed session",
    "description": "Cross-asset reversal signal: negate the trailing 30-session return and scale by 90-session realized volatility, with a one-session lag to prevent look-ahead."
  },
  "dependencies": ["close"],
  "parameters": {"return_window": 30, "volatility_window": 90, "forward_horizon": 10, "lag": 1, "universe_size": 15},
  "validation": {
