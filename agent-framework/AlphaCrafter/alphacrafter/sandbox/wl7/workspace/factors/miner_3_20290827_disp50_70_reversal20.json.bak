  "factor_name": "Intermediate-dispersion 50th-70th percentile risk-adjusted reversal",
  "version": "2029.08.27",
  "calculation": {
    "expression": "gate * (-(close[t-1]/close[t-21]-1) / rolling_std(pct_change(close),20)[t-1])",
    "description": "Cross-asset 20-day reversal normalized by trailing 20-day volatility, enabled when lagged cross-sectional return dispersion is above its trailing 252-day 50th percentile and at or below its 70th percentile. All inputs are lagged one completed day."
