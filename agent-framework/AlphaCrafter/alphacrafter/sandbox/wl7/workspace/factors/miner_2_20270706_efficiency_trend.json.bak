  "factor_name": "Risk-scaled 10-session directional efficiency trend",
  "version": "1.0",
  "calculation": {
    "expression": "shift1((close/close[-10]-1) * abs(close/close[-10]-1) / sum(abs(daily_return),10) / rolling_std(daily_return,20))",
    "description": "Ten-session signed return, multiplied by directional efficiency (absolute net move divided by cumulative absolute daily movement) and normalized by 20-session volatility; shifted one completed session to avoid look-ahead."
