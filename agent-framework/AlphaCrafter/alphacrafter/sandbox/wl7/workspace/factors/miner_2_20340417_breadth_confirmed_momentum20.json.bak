{
  "factor_id": "miner_2_20340417_breadth_confirmed_momentum20",
  "factor_name": "Breadth-confirmed momentum with defensive short-horizon reversal",
  "version": "1.0",
  "calculation": {
    "expression": "((20d_momentum if cross_sectional_breadth(20d_momentum>0)>=0.5 else -10d_momentum) / (20d_annualized_volatility)) lagged 1 session",
    "description": "Ranks assets by volatility-scaled 20-day momentum when at least half of the tradable universe has positive 20-day momentum; otherwise uses volatility-scaled negative 10-day momentum as a defensive reversal signal. The signal is lagged one completed session."
  },
  "dependencies": ["close"],
  "parameters": {"momentum_window_days": 20, "reversal_window_days": 10, "volatility_window_days": 40, "volatility_scale_horizon": 20, "breadth_threshold": 0.5, "lag_days": 1, "forward_horizon_days": 20},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2034-04-14",
    "metrics": {
