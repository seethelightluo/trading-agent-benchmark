    },
    "decay": {"1d_ic": -0.0000565, "5d_ic": 0.0080736, "10d_ic": 0.0250767, "20d_ic": 0.0373728},
    "regime_notes": "Full-history cross-asset validation across 15 tradable benchmark instruments; recent 180/500/750-session 20-day ICs were 0.0948/0.0409/0.0246. Interpret uncertainty conservatively due to approximately 11 valid instruments per date.",
