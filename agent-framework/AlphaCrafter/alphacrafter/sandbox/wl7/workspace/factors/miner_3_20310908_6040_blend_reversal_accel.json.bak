{
  "factor_id": "miner_3_20310908_6040_blend_reversal_accel",
  "factor_name": "60/40 Residual Reversal and Volatility-Scaled Trend Acceleration",
  "version": "1.0",
  "calculation": {
    "expression": "shift1(0.60*zscore_cs(-return_20d_cs_centered) + 0.40*zscore_cs((return_10d-return_10d_lag10)/rolling_std_daily_return_40d))",
    "description": "Cross-sectional blend of lagged 20-day residual reversal and lagged volatility-scaled 10-day trend acceleration; signal is shifted one completed session to prevent look-ahead."
  },
  "dependencies": ["close"],
  "parameters": {"reversal_window": 20, "acceleration_window": 10, "volatility_window": 40, "reversal_weight": 0.6, "acceleration_weight": 0.4, "signal_lag": 1, "min_cross_section": 8},
