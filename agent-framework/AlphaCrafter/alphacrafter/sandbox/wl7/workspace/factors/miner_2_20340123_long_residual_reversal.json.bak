  "factor_name": "60d Residual Momentum Reversal, Volatility Scaled",
  "version": "1.0",
  "calculation": {
    "expression": "-demean_cs(sum(log_return,60)) / rolling_std(log_return,40)",
    "description": "Cross-sectional inverse residual of 60-session log-return momentum, scaled by 40-session daily return volatility. Signal is shifted by one completed session to prevent lookahead. Intended holding horizon is 20 sessions."
