{
  "factor_id": "miner_2_20340529_reversal90",
  "factor_name": "Volatility-normalized 90-day cross-asset reversal",
  "version": "1.0",
  "calculation": {
    "expression": "(-(close / close.shift(90) - 1) / (std(pct_change(close), 180) * sqrt(90))).shift(1)",
    "description": "Ranks assets by lagged 90-session reversal normalized by trailing 180-session daily volatility. Higher values indicate larger prior declines on a risk-adjusted basis. The one-session lag prevents use of the current completed session in the forecast."
  },
  "dependencies": ["close"],
  "parameters": {"lookback_sessions": 90, "volatility_window": 180, "volatility_scaling": "sqrt(90)", "lag_sessions": 1, "minimum_cross_section": 8},
