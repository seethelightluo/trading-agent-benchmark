  "factor_name": "10-Day Volatility-Normalized Reversal (20-Day Horizon)",
  "version": "1.0",
  "calculation": {
    "expression": "-(close / close.shift(10) - 1) / (rolling_std(pct_change(close), 30) * sqrt(20) + 1e-8)",
    "description": "Ranks assets favoring negative trailing 10-session returns, scaled by trailing 30-session realized volatility. Signal is evaluated against the subsequent 20-session return, with all inputs lagged to the decision date."
  },
  "dependencies": ["close"],
  "parameters": {"lookback_sessions": 10, "volatility_window_sessions": 30, "forward_horizon_sessions": 20, "volatility_annualization_scale": "sqrt(20)", "minimum_cross_section": 8},
