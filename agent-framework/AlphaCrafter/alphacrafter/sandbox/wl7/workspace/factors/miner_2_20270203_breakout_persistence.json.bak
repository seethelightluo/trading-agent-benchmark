{
  "factor_id": "miner_2_20270203_breakout_persistence",
  "factor_name": "Channel Breakout Persistence",
  "version": "1.0",
  "calculation": {
    "expression": "shift(1, ((close-min(close,60))/(max(close,60)-min(close,60))*2-1) * (2*mean(I(return>0,15))-1))",
    "description": "Lagged 60-session channel position multiplied by lagged 15-session directional consistency. Positive values favor assets near persistent upper-channel breakouts and negative values favor persistent lower-channel moves."
  },
  "dependencies": ["close"],
  "parameters": {"channel_window": 60, "consistency_window": 15, "lag": 1, "forward_horizons": [1,5,10,20]},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-02 through 2027-02-03",
    "last_validated": "2027-02-03T00:00:00Z",
    "metrics": {
      "daily_paper_ic": 0.014751011505194273,
      "daily_paper_icir": 0.8022171057474048,
      "ic_hit_rate": 0.5162192393736018,
      "dates": 1788,
      "average_instruments": 14.58109619686801,
      "coverage": 0.7382022471910112,
      "turnover": 0.12737155780712167,
      "decay_ic_5d": 0.02515136222326365,
      "decay_ic_10d": 0.03915507792309744,
      "decay_ic_20d": 0.04038604394391634,
      "max_abs_library_correlation": null
    },
    "regime_notes": "Positive in 2020-2022 (IC 0.03235), approximately flat in 2023-2024 (IC -0.00018), and modestly positive in 2025-2027 (IC 0.00511). Full-sample gate passes, but regime variation warrants conservative use.",
    "admission_thresholds": {"absolute_daily_ic": 0.007, "absolute_daily_icir": 0.084}
  },
