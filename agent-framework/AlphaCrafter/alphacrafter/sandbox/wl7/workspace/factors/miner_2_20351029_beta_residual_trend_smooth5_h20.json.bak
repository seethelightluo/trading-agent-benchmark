{
  "factor_id": "miner_2_20351029_beta_residual_trend_smooth5_h20",
  "factor_name": "Five-session smoothed beta-residualized breadth trend",
  "version": "1.0",
  "calculation": {
    "expression": "rolling_mean_5(residualize_cs((0.4*ret20/(vol40*sqrt20)+0.6*ret60/(vol40*sqrt60))*sign(2*breadth20_lag1-1)*sqrt(abs(2*breadth20_lag1-1)), beta60_lag1))",
    "description": "Blend volatility-scaled 20-day and 60-day momentum, condition it on lagged cross-asset breadth confidence, cross-sectionally residualize against lagged 60-day beta to the equal-weight benchmark return, then smooth the resulting lagged signal over five sessions. All inputs are lagged and the forecast horizon is 20 trading days."
  },
  "dependencies": ["close"],
  "parameters": {"momentum_windows": [20, 60], "momentum_weights": [0.4, 0.6], "volatility_window": 40, "breadth_window": 20, "beta_window": 60, "smoothing_window": 5, "forecast_horizon": 20, "min_cross_section": 8},
