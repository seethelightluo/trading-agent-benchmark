{
  "factor_id": "miner_1_20270303_closing_extreme_reversal",
  "factor_name": "Close-Extreme Weighted 3-Day Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "lag1((-return_3d / (rolling_std(return_1d,20)*sqrt(3))) * (1 + 0.5*rolling_mean(abs(2*close_location-1),3)) )",
    "description": "Reverse the lagged three-session return, volatility-normalized, with a modest amplification when recent closes repeatedly occur near daily highs or lows. The one-session lag prevents look-ahead."
  },
  "dependencies": ["close", "high", "low"],
  "parameters": {"return_lookback": 3, "volatility_window": 20, "volatility_min_periods": 15, "location_window": 3, "location_amplifier": 0.5, "lag": 1},
