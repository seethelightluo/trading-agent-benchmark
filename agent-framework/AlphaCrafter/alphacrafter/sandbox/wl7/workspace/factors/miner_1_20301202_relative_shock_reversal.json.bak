{
  "factor_id": "miner_1_20301202_relative_shock_reversal",
  "factor_name": "Dispersion-Gated Relative Shock Reversal 5D",
  "version": "1.0",
  "calculation": {
    "expression": "shift(1, gate * (-(log(close/close[-5]) - cross_sectional_median(log(close/close[-5]))) / rolling_std(log_returns,30)) )",
    "description": "Fades an instrument's five-session return relative to the cross-sectional median, scaled by its 30-session realized volatility. The signal is active only when median absolute cross-sectional return dispersion exceeds its trailing 80-session median, and is lagged one completed session."
  },
  "dependencies": ["close", "daily_returns"],
  "parameters": {"lookback_return_days": 5, "volatility_window": 30, "dispersion_window": 80, "min_dispersion_window": 40, "activation": "dispersion > trailing_median", "lag_days": 1, "clip": [-8, 8], "min_cross_section": 8},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 to 2030-11-29",
    "last_validated": "2030-12-02",
    "metrics": {
      "daily_ic": 0.00993784,
      "daily_icir": 0.48540511,
      "ic_hit_ratio": 0.5011,
      "horizon_5d_ic": 0.01385127,
      "horizon_5d_icir": 0.67617437,
      "horizon_10d_ic": 0.01411905,
      "horizon_10d_icir": 0.69049371,
      "horizon_20d_ic": 0.00293714,
      "horizon_20d_icir": 0.14423929,
      "valid_dates_daily": 1748,
      "average_instruments_daily": 14.17,
      "coverage": 0.93796,
      "rank_turnover": 0.15678,
      "activation_frequency": 0.49547,
      "max_abs_library_correlation": null
    },
    "admission_thresholds": {"absolute_daily_ic_min": 0.007, "absolute_daily_icir_min": 0.084},
    "regime_notes": "Positive and above gate at daily, 5-day, and 10-day horizons across the full 2020-2030 sample; 20-day predictive power is weaker. Small 15-asset cross-section implies conservative uncertainty interpretation.",
    "provenance": {"signal_artifact": "scripts/miner_1_20301202_relative_shock_reversal_signal.csv", "ic_artifact": "scripts/miner_1_20301202_relative_shock_reversal_ic.csv", "universe_size": 15, "lookahead_control": "signal shifted one completed session; forward returns begin after signal date"}
  },
