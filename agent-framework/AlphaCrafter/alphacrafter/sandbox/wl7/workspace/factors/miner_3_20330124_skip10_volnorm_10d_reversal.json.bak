{
  "factor_id": "miner_3_20330124_skip10_volnorm_10d_reversal",
  "factor_name": "Skip-10 volatility-normalized 10-day reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(close/close.shift(10)-1).shift(10) / pct_change(close).rolling(40).std().shift(10)",
    "description": "Fade the 10-session return ending ten completed sessions before the signal date, scaled by lagged 40-session realized daily-return volatility. The ten-session delay prevents use of the latest completed returns and avoids look-ahead."
  },
  "dependencies": ["close"],
  "parameters": {
    "return_lookback_sessions": 10,
    "information_delay_sessions": 10,
    "volatility_lookback_sessions": 40,
    "minimum_cross_section": 8,
    "universe": ["000300.SH", "SPX", "HSI", "N225", "SX5E", "000688.SH", "SOX", "NDX", "XAU", "COPPER", "WTI", "BTC", "ETH", "US10Y", "CN10Y"]
  },
  "validation": {
