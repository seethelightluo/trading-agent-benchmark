{
  "factor_id": "miner_3_20340220_drawdown10_reversal_10d",
  "factor_name": "Lagged Ten-Day Volatility-Normalized Drawdown Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "(-rolling_sum(pct_change(close), 10) / (rolling_std(pct_change(close), 60) * sqrt(10) + 1e-8)).shift(1)",
    "description": "Ranks assets higher when their lagged ten-session cumulative loss is large relative to trailing 60-session daily volatility; intended to capture cross-asset rebound potential. Signal is lagged one completed session."
  },
  "dependencies": ["close"],
  "parameters": {"shock_window": 10, "volatility_window": 60, "lag": 1, "epsilon": 1e-8, "forward_horizon": 10},
  "validation": {
