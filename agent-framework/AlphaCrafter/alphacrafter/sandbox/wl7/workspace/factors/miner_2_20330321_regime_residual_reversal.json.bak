{
  "factor_id": "miner_2_20330321_regime_residual_reversal",
  "factor_name": "VIX-regime weighted cross-sectional residual delayed reversal",
  "version": "1.0",
  "calculation": {
    "expression": "((-(return_10d.shift(10))/std(return_1d,40).shift(10)) - cross_sectional_mean) * clip(1 + 0.35*zscore(VIX,252), 0.35, 1.9)",
    "description": "Compute a 10-session reversal signal delayed by 10 completed sessions and normalized by lagged 40-session volatility. Remove the contemporaneous cross-sectional mean to isolate relative residual reversal, then smoothly scale by the lagged VIX 252-session z-score. All market inputs are lagged and therefore available at decision time."
  },
  "dependencies": ["close", "VIX"],
  "parameters": {
    "return_lookback": 10,
    "execution_delay": 10,
    "volatility_window": 40,
    "regime_window": 252,
    "regime_sensitivity": 0.35,
    "regime_weight_floor": 0.35,
    "regime_weight_cap": 1.9,
    "minimum_cross_section": 8
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2033-03-18",
    "cutoff_date": "2033-03-18",
    "validation_date": "2033-03-21",
    "universe_size": 15,
    "metrics": {
      "horizon_sessions": 10,
      "ic": 0.051325,
      "icir": 0.168339,
      "hit_ratio": 0.5650,
      "observations": 1685,
      "average_valid_instruments": 11.23,
      "coverage": 0.3778,
      "turnover": 0.0891,
      "decay_ic_h5": 0.048732,
      "decay_ic_h20": 0.038821,
      "chronological_third_ic": [0.068506, 0.028250, 0.057231],
      "max_abs_library_correlation": null
    },
    "signal_artifact": "scripts/miner_1_20330307_regime_residual_reversal_signal.csv",
    "regime_notes": "Positive and stable across chronological thirds; strongest at H10, with persistence through H20. VIX is observation-only and is not tradable. Small cross-section uncertainty is addressed through 1,685 date-level observations.",
    "admission_gates": {
      "absolute_ic_minimum": 0.0070,
      "absolute_icir_minimum": 0.0840,
      "passed": true
    }
  },
  "tags": ["reversal", "residual", "volatility-normalized", "macro-regime", "cross-asset"],
