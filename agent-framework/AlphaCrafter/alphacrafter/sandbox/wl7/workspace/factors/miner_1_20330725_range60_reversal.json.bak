{
  "factor_id": "miner_1_20330725_range60_reversal",
  "factor_name": "Volatility-scaled 60-session range-position reversal",
  "version": "1.0",
  "calculation": {
    "expression": "shift1((0.5 - (close - rolling_min(close,60,min_periods=40))/(rolling_max(close,60,min_periods=40)-rolling_min(close,60,min_periods=40))) / rolling_std(pct_change(close),20,min_periods=12))",
    "description": "Contrarian range-location signal: assets near the lower end of their trailing 60-session range receive higher scores, scaled by inverse 20-session realized volatility. The signal is lagged one completed session to avoid look-ahead."
  },
  "dependencies": ["close"],
  "parameters": {"range_window": 60, "range_min_periods": 40, "volatility_window": 20, "volatility_min_periods": 12, "lag_sessions": 1, "forward_horizon_for_admission": 10},
  "validation": {
