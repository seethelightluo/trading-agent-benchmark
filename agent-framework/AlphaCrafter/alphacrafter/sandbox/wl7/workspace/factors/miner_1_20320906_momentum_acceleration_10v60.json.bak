{
  "factor_id": "miner_1_20320906_momentum_acceleration_10v60",
  "factor_name": "Lagged medium-versus-slow momentum acceleration",
  "version": "1.0",
  "calculation": {
    "expression": "(log(close[t-5]/close[t-15]) - log(close[t-5]/close[t-65])/6) / rolling_std(log_return,40)[t-1]",
    "description": "Compares the lagged 10-session return with one-sixth of the lagged 60-session return, normalized by trailing 40-session volatility. All inputs are lagged to avoid look-ahead. Higher values indicate recent acceleration relative to the slower trend."
  },
  "dependencies": ["close"],
  "parameters": {"recent_window": 10, "slow_window": 60, "lag_sessions": 5, "volatility_window": 40, "minimum_volatility_observations": 25},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-03-06 through 2032-09-03",
    "validation_timestamp": "2032-09-06T00:00:00Z",
    "metrics": {"horizon_sessions": 20, "ic": 0.026284, "icir": 0.084560, "ic_hit_ratio": 0.5223, "valid_ic_dates": 3201, "average_cross_section": 11.04, "coverage": 0.6328, "rank_turnover": 0.1504, "max_abs_library_correlation": null},
    "regime_notes": "20-session IC and ICIR pass benchmark gates on 15 tradable cross-asset instruments. Chronological thirds show IC/ICIR 0.04783/0.14603, 0.02867/0.09022, and -0.01324/-0.04399; recent deterioration makes the result regime-sensitive and warrants conservative use.",
    "signal_artifact": "scripts/miner_1_20320906_momentum_acceleration_signal.csv",
    "universe": "15 tradable benchmark instruments; observations require at least 8 valid instruments"
  },
  "tags": ["momentum", "acceleration", "volatility_normalized", "cross_asset"]
}
