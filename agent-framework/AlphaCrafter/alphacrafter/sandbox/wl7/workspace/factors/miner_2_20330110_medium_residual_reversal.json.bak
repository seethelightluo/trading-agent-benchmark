{
  "factor_id": "miner_2_20330110_medium_residual_reversal",
  "factor_name": "10d Cross-Sectional Residual Reversal, Volatility Scaled",
  "version": "2033-01-10",
  "calculation": {
    "expression": "-((sum_return_10d(asset) - cross_sectional_median(sum_return_10d)) / (std_return_40d * sqrt(40))) shifted by 2 sessions",
    "description": "Ranks assets that underperformed their contemporaneous 10-day cross-asset median, scaled by 40-day annualized volatility; the two-session lag prevents look-ahead and permits delayed reversal."
  },
  "dependencies": ["close", "pct_change"],
  "parameters": {"formation_window": 10, "volatility_window": 40, "skip_sessions": 2, "minimum_cross_section": 8, "forward_horizon": 10},
  "signal_artifact": "scripts/miner_2_20330110_medium_residual_reversal_signal.csv",
