{
  "factor_id": "miner_1_20320126_slow_volume_volnorm_momentum",
  "factor_name": "Slow-Volume Confirmed Volatility-Normalized Momentum",
  "version": "1.1",
  "calculation": {
    "expression": "(close_t/close_{t-10}-1)/std(log_return,20) * (1 + 0.35*clip(mean(log(volume)_{t-4:t}) - median(log(volume)_{t-44:t-5}), -2, 2))",
    "description": "Lagged ten-day momentum normalized by trailing 20-day log-return volatility, amplified or attenuated by the difference between recent five-day mean log volume and the preceding 40-day median log volume. Signal uses information available at date t and predicts subsequent returns; volume confirmation multiplier is bounded. Cross-sectional rank may be used for portfolio combination."
  },
  "dependencies": [
    "close",
    "volume"
  ],
  "parameters": {
    "momentum_window_days": 10,
    "volatility_window_days": 20,
    "recent_volume_window_days": 5,
    "baseline_volume_window_days": 40,
    "volume_gap_clip": 2.0,
    "volume_amplification": 0.35,
    "minimum_cross_section": 8,
    "universe_size": 15
  },
