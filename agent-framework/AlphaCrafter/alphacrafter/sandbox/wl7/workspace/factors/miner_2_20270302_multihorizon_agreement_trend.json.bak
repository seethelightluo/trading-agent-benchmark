  "factor_name": "Multi-horizon agreement volatility-scaled trend",
  "version": "2027-03-02",
  "calculation": {
    "expression": "shift1(((sign(ret_5)+sign(ret_20)+sign(ret_60))/3) * ret_20 / rolling_std(ret_1,20))",
    "description": "For each tradable benchmark asset, calculate 5-, 20-, and 60-session returns. Multiply the 20-session return by the average sign agreement across the three horizons, divide by 20-session realized volatility, and lag one session so only completed data are used. Positive values indicate persistent aligned trend; disagreement suppresses the signal."
  },
  "dependencies": ["close"],
