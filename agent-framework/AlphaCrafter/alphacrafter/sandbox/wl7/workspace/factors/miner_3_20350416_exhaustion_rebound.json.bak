{
  "factor_id": "miner_3_20350416_exhaustion_rebound",
  "factor_name": "Floor-preserving short-shock exhaustion rebound",
  "version": "1.0",
  "calculation": {
    "expression": "(-sum(ret,3)) * (0.5 + clip(close/rolling_min(close,120)-1,0,3)) / (downside_std(ret,20)*sqrt(20)); set null when sum(ret,20) <= -0.35; cross-sectional median demean",
    "description": "Ranks assets for a short three-day rebound after a negative shock, amplified when price is above its 120-day floor and scaled by downside volatility. A deep medium-term collapse is excluded to avoid structural falling knives."
  },
  "dependencies": ["close", "daily_returns"],
  "parameters": {
    "shock_window_days": 3,
    "floor_window_days": 120,
    "risk_window_days": 20,
    "medium_trend_window_days": 20,
    "medium_trend_floor": -0.35,
    "minimum_cross_section": 8,
    "universe": 15
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2035-04-13",
    "last_validated": "2035-04-16T00:00:00Z",
    "metrics": {
      "daily_paper_horizon_days": 1,
      "daily_paper_ic": 0.007040,
      "daily_paper_icir": 0.3590,
      "ic_hit_ratio": 0.499,
      "valid_ic_dates": 653,
      "average_instruments_per_date": 8.38,
      "universe_instruments": 15,
      "factor_coverage": 0.237987,
      "rank_turnover": 0.170575,
      "max_abs_library_correlation": null,
      "decay_ic_1d": 0.007040,
      "decay_ic_5d": -0.007054,
      "decay_ic_10d": -0.013485,
      "decay_ic_20d": 0.006148,
      "regime_notes": "Only 653 dates met the minimum cross-section because the floor/trend gating leaves partial coverage. One-day IC narrowly clears the benchmark gate, but 5-day and 10-day IC are negative; 2035 YTD is positive but only 9 observations. Treat as a small, low-confidence tactical sleeve.",
      "admission_thresholds": {
        "absolute_daily_paper_ic": 0.0070,
        "absolute_daily_paper_icir": 0.0840
      }
    },
    "signal_artifact": "scripts/miner_3_20350416_exhaustion_rebound_signal.csv"
  },
