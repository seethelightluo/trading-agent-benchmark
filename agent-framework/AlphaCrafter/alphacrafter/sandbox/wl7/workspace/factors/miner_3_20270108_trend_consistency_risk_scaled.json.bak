{
  "factor_id": "miner_3_20270108_trend_consistency_risk_scaled",
  "factor_name": "Trend Consistency Risk-Scaled Momentum",
  "version": "20270108",
  "calculation": {
    "expression": "shift(20d_momentum * (0.5 + rolling20_positive_return_fraction) / (rolling20_return_std * sqrt(20)), 1)",
    "description": "Ranks assets by lagged 20-trading-day momentum, strengthened when daily returns have been directionally persistent and scaled by recent realized risk. All inputs are lagged before portfolio use."
  },
  "dependencies": [
    "close",
    "pct_change"
  ],
  "parameters": {
    "momentum_window": 20,
    "consistency_window": 20,
    "volatility_window": 20,
    "minimum_periods": 15,
    "risk_scaling": "volatility_times_sqrt_20",
    "lag": 1
  },
