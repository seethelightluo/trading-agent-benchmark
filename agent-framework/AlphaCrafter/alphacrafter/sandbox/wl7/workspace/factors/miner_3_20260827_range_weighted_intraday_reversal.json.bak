{
  "factor_id": "miner_3_20260827_range_weighted_intraday_reversal",
  "factor_name": "Range-Weighted Intraday Reversal",
  "version": "20260827",
  "calculation": {
    "expression": "-(close/open - 1) * clip(((high-low)/open) / rolling_median(((high-low)/open), 20), 0, 4)",
    "description": "Favors negative open-to-close returns, with greater weight when the session range is unusually wide relative to its 20-session median; predicts next valid close-to-close cross-asset return.",
    "forward_horizon": "1 trading day",
    "signal_artifact": "scripts/miner_3_20260827_range_weighted_intraday_reversal.py"
  },
  "dependencies": [
    "open",
    "close",
    "high",
    "low"
  ],
  "parameters": {
    "range_window": 20,
    "min_periods": 10,
    "range_clip": [
      0,
      4
    ],
    "min_cross_section": 8,
