{
  "factor_id": "miner_1_20300211_highdisp_residual_reversal20",
  "factor_name": "High-dispersion residual reversal 20d",
  "version": "1.0",
  "calculation": {
    "expression": "-rolling_sum(close_return - cross_sectional_median_return, 20) when rolling_mean(cross_sectional_return_dispersion,20) > rolling_median(rolling_mean(dispersion,20),252), lagged 1 day",
    "description": "Fades persistent relative winners and buys relative losers during elevated cross-asset dispersion. The regime gate uses only trailing dispersion history and the signal is lagged one completed day, avoiding look-ahead."
  },
  "dependencies": ["close"],
  "parameters": {
    "residual_window_days": 20,
    "dispersion_window_days": 20,
    "dispersion_threshold_window_days": 252,
    "threshold_min_periods": 126,
    "signal_lag_days": 1,
    "admission_horizon_days": 10,
    "minimum_cross_section": 8,
    "universe_size": 15
  },
