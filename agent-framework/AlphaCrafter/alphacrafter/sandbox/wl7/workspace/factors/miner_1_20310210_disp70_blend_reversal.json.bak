{
  "factor_id": "miner_1_20310210_disp70_blend_reversal",
  "factor_name": "Dispersion-gated blended volatility-normalized shock reversal",
  "version": "2031-02-10",
  "calculation": {
    "expression": "cross_sectional_center( -(0.7*mean(zscore_return_3d)+0.3*mean(zscore_return_10d)) * I(dispersion80 > rolling_quantile(dispersion80,252,0.70)) ).shift(1)",
    "description": "Ranks recent volatility-normalized shocks contrarily, activating only in unusually dispersed cross-asset regimes. The one-session lag prevents use of the current completed-day return in the decision signal."
  },
  "dependencies": ["close", "daily_returns"],
  "parameters": {"volatility_window": 20, "shock_windows": [3, 10], "blend_weights": [0.7, 0.3], "dispersion_window": 80, "dispersion_quantile_window": 252, "dispersion_quantile": 0.70, "lag_sessions": 1, "clip": [-8, 8]},
