{
  "factor_id": "miner_3_20341127_robust_dispweighted_residual_reversal15",
  "factor_name": "Robust dispersion-weighted residual volatility-scaled 15-day reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(15d rolling sum of residual returns / 60d residual volatility) * clip(0.5 + percentile_rank_120d(dispersion / 60d median dispersion), 0.5, 1.5)",
    "description": "Subtract the daily cross-sectional median return from each asset return, accumulate the 15-day residual return, reverse and scale by 60-day residual volatility, then apply a bounded trailing percentile-rank dispersion multiplier. All inputs are lagged completed daily observations."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "residual_window_days": 15,
    "volatility_window_days": 60,
    "dispersion_baseline_days": 60,
    "dispersion_rank_window_days": 120,
    "minimum_volatility_observations": 40,
    "minimum_dispersion_rank_observations": 60,
    "multiplier_floor": 0.5,
    "multiplier_cap": 1.5,
    "universe_size": 15
  },
  "validation": {
