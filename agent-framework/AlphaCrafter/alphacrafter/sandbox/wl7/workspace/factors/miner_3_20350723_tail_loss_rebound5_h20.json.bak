{
  "factor_id": "miner_3_20350723_tail_loss_rebound5_h20",
  "factor_name": "Tail-loss rebound scaled by downside risk",
  "version": "1.0",
  "calculation": {
    "expression": "shift1((-(close/close.shift(5)-1) / (downside_returns.rolling(40).std()*sqrt(40))) * (1 + 0.5*max(-(close/close.shift(60)-1),0))) residualized by cross-sectional median",
    "description": "Ranks assets for a delayed rebound after severe five-day losses, scaling loss severity by 40-day downside volatility and modestly increasing the score for assets in longer-term drawdown. All inputs are lagged one trading day."
  },
  "dependencies": ["close", "pct_change"],
  "parameters": {"loss_window": 5, "downside_vol_window": 40, "trend_window": 60, "trend_gate_weight": 0.5, "signal_lag": 1, "forward_horizon": 20, "min_cross_section": 8},
  "validation": {
