{
  "factor_id": "miner_3_20300826_dispersion_reversal5",
  "factor_name": "Cross-sectional dispersion-gated five-day volatility-normalized reversal",
  "version": "1.0",
  "calculation": {
    "expression": "shift_1((-pct_change(close,5) / rolling_std(pct_change(close,1),20)) * I(cross_sectional_std(pct_change(close,5)) > rolling_median_60(cross_sectional_std(pct_change(close,5)))))",
    "description": "When cross-asset five-day return dispersion is above its trailing 60-date median, rank a lagged five-day reversal normalized by 20-day realized volatility. Signal is clipped to [-5,5]. All inputs are lagged before use for forward-return testing."
  },
  "dependencies": ["close"],
  "parameters": {"reversal_window": 5, "volatility_window": 20, "dispersion_window": 60, "dispersion_threshold": "trailing_median", "clip": [-5, 5], "lag": 1},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2030-08-26",
    "metrics": {
      "daily_ic": 0.00880326,
      "daily_icir": 0.41610925,
      "daily_hit_ratio": 0.5071,
      "daily_valid_dates": 1487,
      "average_instruments": 13.16,
      "factor_coverage": 0.9192,
      "rank_turnover": 0.082921,
      "decay_ic_5d": 0.00851007,
      "decay_ic_10d": 0.00040961,
      "decay_ic_20d": 0.00606551,
      "regime_ic_early": 0.02553872,
      "regime_ic_middle": 0.00266782,
      "regime_ic_late": -0.00181816,
      "max_abs_library_correlation": null
    },
    "signal_artifact": "scripts/miner_3_20300826_dispersion_reversal5_signal.csv",
    "ic_artifact": "scripts/miner_3_20300826_dispersion_reversal5_ic.csv",
    "regime_notes": "Positive aggregate daily and 5-day predictiveness, strongest early and near-zero late; late drift warrants defensive weighting and revalidation. Small cross-section uncertainty is addressed with 1,487 dates and approximately 13 instruments per date.",
    "admission_thresholds": {"absolute_daily_ic": 0.007, "absolute_daily_icir": 0.084}
  },
