{
  "factor_id": "miner_1_20290730_highdisp_reversal20",
  "factor_name": "High-dispersion volatility-scaled 10-day reversal",
  "version": "1.0",
  "calculation": {
    "expression": "gate_t * (-(close[t-1]/close[t-11]-1) / std(pct_change[t-20:t-1]))",
    "description": "Cross-asset contrarian reversal over the prior 10 sessions, normalized by lagged 20-session volatility and active only when cross-sectional lagged daily-return dispersion is above its strictly lagged 252-session 60th percentile. All inputs are lagged to prevent look-ahead. Zero-gated observations are treated as missing."
  },
  "dependencies": ["close", "pct_change"],
  "parameters": {
    "reversal_lookback_days": 10,
    "volatility_window_days": 20,
    "dispersion_window_days": 252,
    "dispersion_quantile": 0.60,
    "minimum_cross_section": 8,
    "validation_forward_horizon_days": 20
  },
  "signal_artifacts": {
    "signal_csv": "scripts/miner_1_20290730_highdisp_reversal_signal.csv",
    "ic_csv": "scripts/miner_1_20290730_highdisp_reversal_ic.csv",
    "universe_size": 15,
    "signal_direction": "positive"
  },
  "validation": {
    "status": "EFFECTIVE",
    "last_validated": "2029-07-30T00:00:00Z",
