{
  "factor_id": "miner_2_20270818_recovery_efficiency",
  "factor_name": "Recovery Efficiency 20D Gain per 60D Adverse Excursion",
  "version": "1.0",
  "calculation": {
    "expression": "lag1(pct_change(close,20) / (mean(max(0, rolling_max(close,60)/close - 1),60) + 0.01))",
    "description": "Ranks instruments by their lagged 20-session gain scaled by the average trailing 60-session drawdown magnitude; higher values indicate efficient recovery with less adverse excursion. The one-session lag prevents look-ahead."
  },
  "dependencies": ["close"],
  "parameters": {"return_lookback": 20, "drawdown_lookback": 60, "drawdown_min_periods": 45, "stabilizer": 0.01, "signal_lag_sessions": 1},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-21 through 2027-08-17",
    "last_validated": "2027-08-18T00:00:00Z",
