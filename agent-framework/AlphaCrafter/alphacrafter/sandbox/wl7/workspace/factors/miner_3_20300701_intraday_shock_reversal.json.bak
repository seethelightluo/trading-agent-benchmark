{
  "factor_id": "miner_3_20300701_intraday_shock_reversal",
  "factor_name": "Volatility-scaled intraday shock reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-rolling_mean(clip(log(close/open) / rolling_median(true_range/previous_close,20), -5, 5), 3).shift(1)",
    "description": "For each asset, measure the close-to-open return as a multiple of its trailing 20-day median true-range percentage, clip extreme observations, reverse the sign, smooth over three sessions, and lag by one completed session. Higher values favor assets whose recent intraday shocks are more likely to mean-revert."
  },
  "dependencies": ["open", "close", "high", "low"],
  "parameters": {"range_window": 20, "smoothing_window": 3, "shock_clip": 5.0, "intraday_return_clip": 0.25, "lag": 1, "min_cross_section": 8},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-02 through 2030-06-28",
    "validation_date": "2030-07-01",
    "metrics": {
      "horizon_days": 1,
      "ic": 0.01158532,
      "icir": 0.57367412,
      "hit_ratio": 0.5189,
      "ic_dates": 2704,
      "average_instruments": 13.37,
      "factor_coverage": 0.9331,
      "rank_turnover": 0.106596,
      "max_abs_library_correlation": null
