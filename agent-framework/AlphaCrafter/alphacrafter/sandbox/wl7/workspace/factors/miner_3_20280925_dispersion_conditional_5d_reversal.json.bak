{
  "factor_id": "miner_3_20280925_dispersion_conditional_5d_reversal",
  "factor_name": "Dispersion-Conditional Bounded Five-Day Reversal Volatility Scaled",
  "version": "1.0",
  "calculation": {
    "expression": "where(D_t >= median_252(D), -bounded(return_5d)/volatility_20d, -0.35*bounded(return_5d)/volatility_20d)",
    "description": "Cross-asset five-day bounded reversal divided by 20-day annualized volatility, with signal magnitude reduced in low cross-sectional-dispersion regimes. Signal uses data through date t and predicts t+1 return.",
