{
  "factor_id": "miner_1_20300715_path_efficiency20",
  "factor_name": "Lagged 20-day trend path efficiency",
  "version": "1.0",
  "calculation": {
    "expression": "lag1(ROC(close,20) / rolling_sum(abs(daily_return),20))",
    "description": "Ranks assets by directional 20-trading-day price change relative to total absolute daily movement over the same window; higher values indicate persistent, efficient trends rather than choppy movement."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "return_window": 20,
    "path_window": 20,
    "forward_horizon": 10,
    "lag": 1,
    "min_cross_section": 8
  },
