{
  "factor_id": "miner_3_20301021_downside_relative_trend",
  "factor_name": "Downside-Adjusted Relative Trend 20D",
  "version": "1.0",
  "calculation": {
    "expression": "lag1((log(close/close_20d_ago) - cross_sectional_median(log(close/close_20d_ago))) / downside_deviation_20d",
    "description": "Cross-asset relative 20-session momentum scaled by recent downside deviation, lagged one completed session and clipped to [-8, 8]. Higher values indicate stronger relative trend per unit downside risk."
  },
  "dependencies": ["close", "date"],
  "parameters": {
    "lookback_sessions": 20,
    "downside_window": 20,
    "lag_sessions": 1,
    "clip": [-8, 8],
    "minimum_cross_section": 8,
    "universe_size": 15
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2030-10-18",
