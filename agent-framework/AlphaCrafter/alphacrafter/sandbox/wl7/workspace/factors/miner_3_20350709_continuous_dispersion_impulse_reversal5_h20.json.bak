{
  "factor_id": "miner_3_20350709_continuous_dispersion_impulse_reversal5_h20",
  "factor_name": "Continuous Dispersion-Impulse Volatility-Scaled Reversal",
  "version": "2035-07-09",
  "calculation": {
    "expression": "shift1((-(close/close[-5]-1) - cross_sectional_median) / rolling_std(returns,20) * (1+max(z_dispersion,0)) * (1+max(delta5_dispersion,0)))",
    "description": "For each tradable asset, take the negative five-day return after cross-sectional median demeaning and scale by its 20-day return volatility. Multiply by continuous positive dispersion-surprise terms: one plus the positive z-score of median cross-asset 20-day volatility versus its trailing 60-day median/std, and one plus the positive five-day dispersion increase standardized by the same trailing dispersion volatility. Lag the complete signal one day to avoid look-ahead. Unlike a hard gate, this remains continuous and broadly ranked during dispersion regimes."
  },
  "dependencies": ["close", "pct_change", "rolling_std"],
  "parameters": {"reversal_window": 5, "asset_vol_window": 20, "dispersion_window": 60, "dispersion_change_window": 5, "lag": 1, "forward_horizon": 20, "min_cross_section": 8},
