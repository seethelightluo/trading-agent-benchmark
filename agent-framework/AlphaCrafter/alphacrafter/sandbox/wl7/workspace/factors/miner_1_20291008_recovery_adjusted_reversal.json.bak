{
  "factor_id": "miner_1_20291008_recovery_adjusted_reversal",
  "factor_name": "Recovery-adjusted medium-term reversal",
  "version": "1.1",
  "calculation": {
    "expression": "-(0.50*log(close/close.shift(60) + 0.30*log(close/close.shift(20) + 0.20*(close/rolling_max(close,60)-1)))/rolling_std(log_returns,20)).shift(1)",
    "description": "Reverses a medium-term trend and recovery score, with a drawdown component, scaled by 20-day volatility. All rolling inputs are lagged one completed day before use. Higher values indicate expected superior forward returns."
  },
  "dependencies": ["close"],
  "parameters": {"trend_window": 60, "recovery_window": 20, "drawdown_window": 60, "volatility_window": 20, "trend_weight": 0.5, "recovery_weight": 0.3, "drawdown_weight": 0.2, "signal_lag": 1},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01/2029-10-08",
    "validation_timestamp": "2029-10-08T00:00:00Z",
    "metrics": {"horizon_days": 10, "ic": 0.0681, "icir": 0.243234, "ic_hit_ratio": 0.6348, "dates": 805, "average_instruments": 11.48, "coverage": 0.7655, "rank_turnover": 0.036383, "max_abs_library_correlation": null},
    "regime_notes": "Positive full-sample and recent validation after reversing the score; recent 2028-10-01 onward IC 0.04107 and ICIR 0.158293. Small cross-section implies conservative uncertainty interpretation.",
    "artifacts": {"signal": "scripts/miner_1_20291008_recovery_adjusted_reversal_signal.csv", "ic": "scripts/miner_1_20291008_recovery_adjusted_reversal_ic.csv", "source_script": "scripts/miner_1_20291008_recovery_adjusted_trend.py"}
  },
