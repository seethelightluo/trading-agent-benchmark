{
  "factor_id": "miner_3_20341030_residual_volscaled_reversal15",
  "factor_name": "Cross-asset residual volatility-scaled 15-day reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-rolling_sum_15(asset_return - cross_sectional_median_return_1d) / rolling_std_60(asset_return - cross_sectional_median_return_1d, min_periods=40)",
    "description": "Subtract the daily cross-sectional median return from each asset return, accumulate the residual over 15 sessions, and reverse it after scaling by 60-session residual volatility. Signal uses only completed-session data."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "residual_window": 15,
    "volatility_window": 60,
    "volatility_min_periods": 40,
    "cross_section": "15 tradable benchmark instruments"
  },
