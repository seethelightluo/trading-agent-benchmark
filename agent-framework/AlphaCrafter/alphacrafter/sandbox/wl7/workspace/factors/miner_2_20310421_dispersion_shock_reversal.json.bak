{"factor_id":"miner_2_20310421_dispersion_shock_reversal","factor_name":"High-Dispersion Volatility-Normalized Shock Reversal","version":"2031-04-21","calculation":{"expression":"if mean_i(abs(ret_3_i-median(ret_3))) > median_i(abs(ret_3_i)), then -(ret_3_i-median(ret_3))/(std20_i(ret_daily)*sqrt(3)), else missing","description":"When cross-asset three-day dispersion is elevated, favor reversal of each instrument's volatility-normalized three-day shock; otherwise suppress the signal."},"dependencies":["close"],"parameters":{"shock_lookback_days":3,"volatility_lookback_days":20,"dispersion_gate":"mean absolute deviation of 3d returns > cross-sectional median absolute 3d return","minimum_cross_section":8},"validation":{"status":"EFFECTIVE","period":{"start":"2020-01-06","end":"2031-04-21"},"metrics":{"ic":0.03003998,"icir":0.09454252,"ic_hit_ratio":0.5313,"dates":2140,"average_instruments":13.5154,"coverage":0.815549,"turnover":null,"decay_5d":null,"decay_10d":null,"decay_20d":null,"max_abs_library_correlation":null},"regime_notes":"Elevated-dispersion observations across multiple regimes; small cross-section interpreted conservatively. Daily paper IC and ICIR exceed benchmark gates of 0.0070 and 0.0840.","signal_artifact":"scripts/miner_2_20310421_dispersion_shock.py","provenance":"Executed cross-sectional Spearman IC on 15 tradable benchmark instruments; no future data used."},"tags":["reversal","dispersion","volatility_scaled","short_horizon"],"last_validated":"2031-04-21T00:00:00Z"}