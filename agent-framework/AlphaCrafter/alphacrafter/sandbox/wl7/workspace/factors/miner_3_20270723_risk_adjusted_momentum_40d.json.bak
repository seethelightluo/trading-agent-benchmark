  "factor_name": "Lagged Risk-Adjusted Momentum 40d",
  "version": "2027-07-23",
  "calculation": {
    "expression": "shift_1(pct_change(close,40) / (rolling_std(pct_change(close,1),40)*sqrt(252)+0.01))",
    "description": "Forty-session price momentum scaled by annualized realized volatility, shifted by one completed session to prevent look-ahead bias."
