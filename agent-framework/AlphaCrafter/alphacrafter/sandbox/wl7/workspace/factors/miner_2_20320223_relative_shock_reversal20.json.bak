{
  "factor_id": "miner_2_20320223_relative_shock_reversal20",
  "factor_name": "Cross-Sectional Relative Shock Reversal 20D",
  "version": "1.0",
  "calculation": {
    "expression": "-((sum_return_3d(asset) - cross_sectional_median(sum_return_3d)) / rolling_std_daily_return_20d).shift(1)",
    "description": "Ranks recent three-session performance relative to the contemporaneous 15-asset median, reverses the relative shock, and scales it by 20-day volatility. The one-session lag prevents look-ahead."
  },
  "dependencies": ["close"],
  "parameters": {"shock_window_days": 3, "volatility_window_days": 20, "lag_days": 1, "min_cross_section": 8, "forward_horizon_days": 20},
  "validation": {
