{
  "factor_id": "miner_2_20301007_weak_breadth_reversal",
  "factor_name": "Weak-breadth volatility-normalized short reversal",
  "version": "1.0",
  "calculation": {
    "expression": "shift1((-return_5 / rolling_std(daily_return,20)) * (1.5 - 0.5 * cross_sectional_breadth(return_20 > 0)))",
    "description": "Five-day volatility-normalized reversal, strengthened when fewer tradable instruments have positive 20-day returns; lagged one completed trading day."
  },
  "dependencies": ["close"],
  "parameters": {"reversal_window": 5, "breadth_window": 20, "vol_window": 20, "forward_horizon_days": 10, "breadth_multiplier": "1.5 - 0.5*breadth", "lag_days": 1},
