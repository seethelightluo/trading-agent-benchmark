{
  "factor_id": "miner_1_20330418_breadth_conditioned_momentum",
  "factor_name": "Breadth-conditioned volatility-scaled momentum reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-((close/close.shift(20)-1)/(std(pct_change(close),40)*sqrt(20))) * (0.5 + abs(cross_sectional_mean(I[20d_return>0])-0.5)), shifted 1 session",
    "description": "Inverse of volatility-scaled 20-session momentum, with signal magnitude amplified when cross-sectional breadth is far from neutral. All inputs are lagged one completed session before scoring; negative direction converts the observed continuation failure into a reversal signal."
  },
  "dependencies": ["close", "daily_returns"],
  "parameters": {"momentum_window": 20, "volatility_window": 40, "breadth_window": 20, "lag": 1, "min_vol_observations": 25},
  "validation": {
