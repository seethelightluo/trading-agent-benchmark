{
  "factor_id": "miner_1_20331226_residual_stress_reversal",
  "factor_name": "Residual Cross-Asset Stress Reversal",
  "version": "1.1",
  "calculation": {
    "expression": "when breadth20_lagged > 0.55 and VIX_change5_lagged > lagged_120d_70th_percentile, -(asset_return10_lagged - cross_asset_mean_return10_lagged) / volatility40_lagged; otherwise 0; cross-sectionally demean",
    "description": "Reverses lagged ten-session asset-specific performance relative to the cross-asset mean during broad weak and elevated-volatility regimes. All inputs are lagged to prevent look-ahead."
  },
  "dependencies": ["close", "VIX"],
  "parameters": {"return_window": 10, "volatility_window": 40, "breadth_window": 20, "breadth_threshold": 0.55, "vix_change_window": 5, "vix_percentile_window": 120, "vix_percentile": 0.70, "minimum_cross_section": 8},
  "validation": {
    "status": "EFFECTIVE",
    "period": {"start": "2020-01-01", "end": "2034-01-06"},
    "metrics": {
      "admission_horizon_days": 10,
