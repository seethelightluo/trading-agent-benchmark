  "factor_name": "Volume-Confirmed Volatility-Normalized Three-Day Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "lag1((-sum_return_3d) * clip(1 + volume/median_volume_20d - 1, 0.25, 3.0) / realized_volatility_20d)",
    "description": "Negative lagged three-day return, normalized by 20-day realized volatility and scaled by clipped unusual-volume intensity. The one-session lag prevents use of the forecast day's information."
  },
  "dependencies": ["close", "volume"],
  "parameters": {"return_window": 3, "volatility_window": 20, "volume_median_window": 20, "min_vol_observations": 15, "volume_clip": [0.25, 3.0], "signal_lag": 1},
