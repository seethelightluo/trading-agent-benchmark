{
  "factor_id": "miner_3_20350917_vix_conditioned_trend10",
  "factor_name": "VIX-Conditioned Volatility-Scaled Trend",
  "version": "1.0",
  "calculation": {
    "expression": "lag1(cross_sectional_demean((close/close[-20]-1)/(rolling_std(return,40)*sqrt(20)) * (1-2*I[VIX > rolling_median(VIX,60)])))",
    "description": "Twenty-day volatility-scaled trend continuation in low-VIX regimes and sign-inverted trend (reversal) in elevated-VIX regimes; all signals lagged one completed day."
  },
  "dependencies": ["close", "pct_change", "VIX"],
  "parameters": {"trend_window": 20, "volatility_window": 40, "vix_window": 60, "horizon": 10, "min_cross_section": 8, "signal_lag": 1},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2035-09-15",
    "metrics": {
