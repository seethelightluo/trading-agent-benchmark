  "factor_name": "Volume-Confirmed Volatility-Scaled 20-Day Trend",
  "version": "2035-06-25",
  "calculation": {
    "expression": "winsorize_5_95((close/lag(close,20)-1)/std(daily_returns,20) * sqrt(clamp(mean(volume,5)/mean(volume_lagged_5,20),0.25,4.0)))",
    "description": "Ranks medium-term directional return adjusted for realized volatility, with higher scores when recent five-day volume is elevated relative to the preceding 20-day baseline. Computed using data available through the prior completed date.",
