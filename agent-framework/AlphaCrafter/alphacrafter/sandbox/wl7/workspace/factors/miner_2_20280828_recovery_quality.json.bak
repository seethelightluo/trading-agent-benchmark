{
  "factor_id": "miner_2_20280828_recovery_quality",
  "factor_name": "Downside-Risk-Adjusted Recovery Quality",
  "version": "2028-08-28",
  "calculation": {
    "expression": "((close[t-5]/close[t-25]-1)/(downside_std_40[t]*sqrt(252)+0.01) * (1 if close[t-5]/close[t-65]-1 > 0 else 0.25)).shift(1)",
    "description": "Ranks recent 20-session recovery by downside volatility, with a softer score when the lagged 60-session trend is negative. The signal is lagged one completed session. Validation found negative predictive association, so consumers should use direction -1 if selected."
  },
  "dependencies": ["close", "daily_returns"],
  "parameters": {"recovery_return_sessions": 20, "skip_sessions": 5, "downside_window": 40, "trend_window": 60, "trend_skip": 5, "negative_trend_multiplier": 0.25, "annualization": 252, "vol_floor": 0.01, "validation_horizon_sessions": 10},
  "validation": {
    "status": "EFFECTIVE",
    "metrics": {
      "same_horizon": "10-trading-day forward return",
      "daily_paper_ic": -0.049946,
      "daily_paper_icir": -0.145305,
      "ic_hit_ratio": 0.4532,
      "valid_ic_dates": 203,
      "average_valid_instruments": 8.40,
      "tradable_assets": 15,
      "factor_coverage": 0.1456,
      "rank_turnover": 0.085182,
      "decay_ic_1d": -0.010854,
      "decay_ic_5d": -0.019742,
      "decay_ic_10d": -0.049946,
      "decay_ic_20d": -0.108589,
      "max_abs_library_correlation": null,
      "signal_artifact": "scripts/miner_2_20280828_recovery_quality_signal.csv"
    },
    "period": "2020-01-01 through 2028-08-28 (203 valid cross-sectional dates; minimum 8 instruments; average 8.40)",
    "regime_notes": "The usable observations were concentrated in the recent portion because the downside-volatility and lagged trend inputs require complete histories across the panel. The 10-session IC is negative; reverse direction is required. Uncertainty is high because coverage is only 14.56% and the cross-section is small.",
    "gate": "Absolute daily paper IC and absolute daily paper ICIR exceed 0.0070 and 0.0840; retain with inverse direction pending independent ensemble review."
  },
  "tags": ["recovery", "risk_adjusted", "downside_volatility", "conditional_momentum", "reversal"],
