  "factor_name": "Multi-horizon volatility-adjusted reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-median_center((0.65*(close[t-1]/close[t-21]-1)+0.35*(close[t-1]/close[t-61]-1))/(sqrt(40)*std(pct_change(close),40)[t-1]))",
    "description": "Negated, lagged blend of 20-session and 60-session returns, scaled by trailing 40-session realized volatility and cross-sectionally median-centered. Uses only completed data at decision time."
  },
  "dependencies": ["close"],
  "parameters": {"short_lookback": 20, "long_lookback": 60, "short_weight": 0.65, "long_weight": 0.35, "vol_lookback": 40, "lag": 1, "center": "cross_sectional_median"},
