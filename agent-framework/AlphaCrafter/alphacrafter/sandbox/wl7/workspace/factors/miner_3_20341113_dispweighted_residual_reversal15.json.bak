{
  "factor_id": "miner_3_20341113_dispweighted_residual_reversal15",
  "factor_name": "Dispersion-weighted cross-asset residual volatility-scaled 15-day reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-sum_15(r_i - median_cross_section(r)) / std_60(r_i - median_cross_section(r)) * median_cross_section(abs(r - median_cross_section(r))) / rolling_median_60(median_cross_section(abs(r - median_cross_section(r))))",
    "description": "Reverse each asset's 15-session cumulative return residual to the daily cross-sectional median, volatility-scale it using 60-session residual volatility, and weight by contemporaneous cross-asset return dispersion relative to its trailing 60-session median. All inputs are lagged completed daily observations at decision time."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "residual_window_days": 15,
    "volatility_window_days": 60,
    "volatility_min_periods": 40,
    "dispersion_baseline_days": 60,
    "dispersion_baseline_min_periods": 40,
    "cross_section": "15 tradable benchmark instruments",
    "minimum_valid_instruments": 8
  },
