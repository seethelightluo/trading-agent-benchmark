{
  "factor_id": "miner_3_20351210_breadth_gated_relative_trend60",
  "factor_name": "Breadth-Gated Volatility-Scaled Relative Trend 60d",
  "version": "1.0",
  "calculation": {
    "expression": "shift( (close_return_60d - cross_asset_mean_return_60d) / (rolling_std_daily_return_40d * sqrt(40)) * I(cross_asset_positive_20d_breadth >= 0.50), 1)",
    "description": "Ranks assets by 60-trading-day return relative to the equal-weight cross-asset return, volatility scaled and activated only when at least half of the tradable universe has positive 20-day return. One-day lag prevents look-ahead."
  },
  "dependencies": ["close"],
  "parameters": {"relative_window": 60, "volatility_window": 40, "breadth_window": 20, "breadth_threshold": 0.50, "signal_lag": 1, "forward_horizon_admission": 20},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2035-12-07",
    "validated_at": "2035-12-10T00:00:00Z",
    "metrics": {
      "ic": 0.03458949,
      "icir": 0.31794495,
      "horizon_days": 20,
      "dates": 396,
      "average_instruments": 15.0,
      "coverage": 0.5603,
      "turnover": 4.967984,
      "ic_hit_ratio": 0.5379,
      "recent_252_ic": 0.06102451,
      "max_abs_library_correlation": null
    },
    "regime_notes": "H20 IC was positive in 2024-2028 (0.017875, 120 observations), 2029-2033 (0.042703, 245), and 2034-2035 YTD (0.035166, 31). Small cross-asset sample warrants conservative interpretation. H5/H10 also passed the shared absolute IC/ICIR thresholds, but H20 is the admission horizon."
  },
  "signal_artifact": "scripts/miner_3_20351210_breadth_gated_relative_trend60_signal.csv",
