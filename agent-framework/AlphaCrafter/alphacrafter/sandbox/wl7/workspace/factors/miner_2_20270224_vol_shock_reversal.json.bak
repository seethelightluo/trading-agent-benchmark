{
  "factor_id": "miner_2_20270224_vol_shock_reversal",
  "factor_name": "Volatility-Shock Reversal",
  "version": "2027-02-24.v1",
  "calculation": {
    "expression": "-pct_change(close,3) / rolling_std(pct_change(close,1),10) * (rolling_std(pct_change(close,1),10) / rolling_std(pct_change(close,1),60)), lagged one session",
    "description": "Ranks assets for next-day rebound after a recent three-session loss, scaled by short-term volatility and its shock relative to the 60-session baseline. All inputs are lagged to prevent look-ahead."
  },
  "dependencies": ["close"],
  "parameters": {"loss_window": 3, "short_vol_window": 10, "baseline_vol_window": 60, "minimum_short_vol_observations": 7, "minimum_baseline_vol_observations": 30, "lag": 1},
