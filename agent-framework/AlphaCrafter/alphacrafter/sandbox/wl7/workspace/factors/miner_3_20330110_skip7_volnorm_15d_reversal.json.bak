{
  "factor_id": "miner_3_20330110_skip7_volnorm_15d_reversal",
  "factor_name": "Skip-7 volatility-normalized 15-day medium reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(close_t / close_{t-15} - 1) delayed by 7 sessions, divided by rolling_std(pct_change(close), 60) delayed by 7 sessions",
    "description": "Fades the 15-session return ending seven completed sessions before the signal date and scales it by lagged 60-session realized volatility. The seven-session delay excludes recent observations and avoids look-ahead."
  },
  "dependencies": ["close"],
  "parameters": {"lookback_return_sessions": 15, "signal_delay_sessions": 7, "volatility_window_sessions": 60, "minimum_cross_section": 8, "primary_horizon_sessions": 10},
