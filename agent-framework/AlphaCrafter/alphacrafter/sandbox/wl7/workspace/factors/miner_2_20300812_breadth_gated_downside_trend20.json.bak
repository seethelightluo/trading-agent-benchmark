{
  "factor_id": "miner_2_20300812_breadth_gated_downside_trend20",
  "factor_name": "Breadth-gated downside-risk-adjusted 20-day trend",
  "version": "1.0",
  "calculation": {
    "expression": "gate_t * log(close_t/close_{t-20}) / (sqrt(20)*downside_rms40_t), lagged one day; gate=-1 when cross-sectional fraction of positive 20-day returns < 0.40, otherwise +1",
    "description": "Ranks the 20-day trend normalized by trailing 40-day downside RMS. In broad selloffs, reverses the cross-sectional trend signal to favor recovery/defensive relative strength; all inputs are lagged before the forecast.",
    "signal_artifact": "scripts/miner_2_20300812_breadth_gated_downside_trend20_signal.csv",
    "ic_artifact": "scripts/miner_2_20300812_breadth_gated_downside_trend20_ic.csv"
  },
  "dependencies": ["close"],
  "parameters": {"trend_window": 20, "downside_window": 40, "downside_rms_scaler": 20, "breadth_window": 20, "breadth_threshold": 0.40, "signal_lag": 1, "winsorization": [-10, 10]},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2030-08-12",
    "validation_date": "2030-08-12",
