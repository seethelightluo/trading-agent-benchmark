{
  "factor_id": "miner_3_20350820_beta_residual_reversal20",
  "factor_name": "Cross-Asset-Beta-Residual Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-rolling_sum_20(residual_return_i) / rolling_std_40(residual_return_i), residual_return_i = return_i - beta_i*equal_weight_cross_asset_return",
    "description": "For each tradable instrument, remove its trailing 60-day beta exposure to the equal-weight 15-asset benchmark, then rank the negative 20-day residual trend normalized by 40-day residual volatility. Cross-sectional median residualization and one-day lag prevent level and look-ahead effects."
  },
  "dependencies": ["close", "returns"],
  "parameters": {"benchmark": "equal_weight_available_tradable_assets", "beta_window": 60, "residual_trend_window": 20, "residual_volatility_window": 40, "min_periods_beta": 40, "min_periods_trend": 15, "min_periods_volatility": 25, "cross_sectional_residualization": "median", "signal_lag_days": 1},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2035-08-19",
    "validation_date": "2035-08-20",
