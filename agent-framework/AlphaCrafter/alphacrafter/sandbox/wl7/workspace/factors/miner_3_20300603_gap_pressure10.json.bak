{
  "factor_id": "miner_3_20300603_gap_pressure10",
  "factor_name": "Volatility-normalized ten-day overnight gap pressure",
  "version": "1.0",
  "calculation": {
    "expression": "rolling_sum_10(clip(log(open_t/close_{t-1}), -0.15, 0.15)) / (rolling_std_20(log(close_t/close_{t-1})) * sqrt(10)), lagged 1 day",
    "description": "Accumulates signed overnight gaps over ten sessions and scales by prevailing 20-day close-to-close volatility; positive values indicate persistent upward opening pressure. Signal is lagged one completed session."
  },
  "dependencies": [
    "open",
    "close"
  ],
  "parameters": {
    "gap_window": 10,
    "vol_window": 20,
    "gap_clip": 0.15,
    "forward_horizon": 10,
    "lag": 1,
    "minimum_cross_section": 8
  },
