{
  "factor_id": "miner_1_20320112_stress_band_trend40",
  "factor_name": "Persistent Stress-Band Conditional Trend 40D",
  "version": "1.0",
  "calculation": {
    "expression": "lag1(RET40_asset * regime5_breadth_band)",
    "description": "Compute 20-day positive-return breadth across the 15 tradable assets. A five-day average breadth at or above 60% sets expansion regime +1; at or below 40% sets stress regime -1; intermediate observations retain the prior regime. Multiply each asset's 40-day return by the lagged regime and lag the resulting signal one day. Neutral initialization is +1."
  },
  "dependencies": ["close"],
  "parameters": {"trend_window": 40, "breadth_window": 20, "breadth_persistence": 5, "upper_band": 0.60, "lower_band": 0.40, "signal_lag": 1, "universe_size": 15},
