  "version": "1.0",
  "calculation": {
    "expression": "-(sum_5(asset_returns) - rolling_beta_60(asset, equal_weight_market)*sum_5(equal_weight_market_returns)) / rolling_std_30(asset_returns)",
    "description": "Fade the asset's five-session idiosyncratic return after removing its rolling 60-session beta to the equal-weight tradable-universe market; scale by trailing 30-session volatility. All inputs are lag-safe at the signal date."
  },
  "dependencies": ["close"],
  "parameters": {"shock_window": 5, "beta_window": 60, "volatility_window": 30, "market_definition": "equal-weight mean of available tradable-asset daily returns", "minimum_beta_observations": 40, "minimum_volatility_observations": 20, "forward_horizon_admission": 20},
