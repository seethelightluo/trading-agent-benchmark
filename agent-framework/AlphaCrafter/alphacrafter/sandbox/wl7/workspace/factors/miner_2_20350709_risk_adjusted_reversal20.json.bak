{
  "factor_id": "miner_2_20350709_risk_adjusted_reversal20",
  "factor_name": "Downside-risk-adjusted 20-day reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-((close/close.shift(20)-1)/rolling_std_30(daily_return)) * rolling_std_30(daily_return) / (rolling_std_30(negative_daily_return)+rolling_std_30(daily_return)), then divide by (1+median_cross_sectional_rolling_std_20) and lag one session",
    "description": "Reverses 20-session momentum, discounts assets with comparatively high downside volatility, normalizes by total volatility, and applies a mild cross-asset dispersion stabilizer. The signal is lagged one completed session and uses only the 15 tradable benchmark instruments."
  },
  "dependencies": ["close"],
  "parameters": {"momentum_window": 20, "risk_window": 30, "dispersion_window": 20, "min_periods": 15, "lag_sessions": 1, "minimum_cross_section": 8},
