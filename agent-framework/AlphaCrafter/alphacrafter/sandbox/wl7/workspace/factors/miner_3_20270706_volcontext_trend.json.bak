{
  "factor_id": "miner_3_20270706_volcontext_trend",
  "factor_name": "Volatility-Contextualized 30-Day Trend",
  "version": "1.0",
  "calculation": {
    "expression": "lag1((close/close[-30]-1)/(std(ret,20)*sqrt(30)) * (std(ret,60)/std(ret,20)))",
    "description": "Thirty-session momentum normalized by recent 20-session volatility and amplified when slow 60-session volatility exceeds short volatility. The complete signal is shifted one session to prevent look-ahead."
  },
  "dependencies": ["close"],
  "parameters": {"trend_window": 30, "short_vol_window": 20, "long_vol_window": 60, "minimum_short_vol_observations": 15, "minimum_long_vol_observations": 40, "lag_sessions": 1},
  "validation": {
    "status": "EFFECTIVE",
    "period": {"start": "2020-01-01", "end": "2027-07-05"},
    "validated_at": "2027-07-06",
    "metrics": {
