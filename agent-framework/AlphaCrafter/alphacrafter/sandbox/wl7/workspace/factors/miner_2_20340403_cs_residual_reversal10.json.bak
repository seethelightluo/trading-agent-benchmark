{
  "factor_id": "miner_2_20340403_cs_residual_reversal10",
  "factor_name": "Cross-sectional Volatility-Scaled Residual Reversal 10d",
  "version": "1.0",
  "calculation": {
    "expression": "-((sum(ret,5) - cross_sectional_median(sum(ret,5))) / (std(ret,40)*sqrt(5))) lagged 1 day",
    "description": "Ranks assets that underperformed or outperformed the contemporaneous 5-day cross-sectional median, reversing the residual move and scaling by trailing 40-day volatility. The one-session lag prevents look-ahead."
  },
  "dependencies": ["close"],
  "parameters": {"residual_window": 5, "volatility_window": 40, "lag": 1, "admission_horizon_days": 10},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2034-03-31",
    "validated_at": "2034-04-03T00:00:00Z",
