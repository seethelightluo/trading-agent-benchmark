{
  "factor_id": "miner_3_20300812_vixshock_reversal5",
  "factor_name": "VIX five-day shock gated volatility-normalized five-day reversal",
  "version": "1.0",
  "calculation": {
    "expression": "I(delta_5(VIX)/VIX_lag5 > 0.08) * clip(-delta_5(close)/rolling_std(pct_change(close),20), -5, 5), lagged one session",
    "description": "When the observation-only VIX has risen more than 8 percent over five sessions, rank assets by lagged five-session reversal normalized by 20-session realized volatility. The signal is zero outside the shock regime."
  },
  "dependencies": ["close", "VIX observation-only macro series"],
  "parameters": {"vix_change_window": 5, "vix_shock_threshold": 0.08, "return_window": 5, "volatility_window": 20, "signal_lag": 1, "clip": [-5, 5], "minimum_cross_section": 8},
  "validation": {
    "status": "EFFECTIVE",
    "period": {"start": "2020-01-01", "end": "2030-08-12"},
    "metrics": {
      "admission_horizon_days": 1,
      "ic": 0.01397431,
      "icir": 0.68077695,
      "hit_ratio": 0.5290,
      "valid_dates": 673,
      "average_instruments": 12.99,
      "coverage": 0.8107,
      "rank_turnover": 0.042477,
      "max_abs_library_correlation": null,
      "decay_ic_5d": 0.02602384,
      "decay_ic_10d": 0.02840830,
      "decay_ic_20d": 0.03400859
    },
    "regime_notes": "Early, middle, and late one-day IC means were +0.02132440, +0.02844241, and -0.00774692 respectively; late-regime drift is negative, so use conservatively and revalidate.",
    "signal_artifact": "scripts/miner_3_20300812_vixshock_reversal5_signal.csv",
