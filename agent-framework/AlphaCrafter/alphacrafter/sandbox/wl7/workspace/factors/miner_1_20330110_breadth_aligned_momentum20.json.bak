{
  "factor_id": "miner_1_20330110_breadth_aligned_momentum20",
  "factor_name": "Breadth-aligned lagged medium momentum",
  "version": "1.0",
  "calculation": {
    "expression": "((close_t-3 / close_t-23) - 1) * sign(mean_i(I[mean_return20_i,t-3 > 0]) - 0.5)",
    "description": "Uses 20-session cross-asset momentum ending three sessions before the signal. The cross-sectional direction is aligned with the sign of lagged 20-session market breadth: continuation when breadth is positive and reversal when breadth is negative. Zero breadth is treated as missing. All features use data available no later than t-3."
  },
  "dependencies": ["close", "daily_returns"],
  "parameters": {
    "momentum_window": 20,
    "breadth_window": 20,
    "signal_lag": 3,
    "minimum_valid_assets": 8,
    "universe_size": 15
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2033-01-07",
    "last_validated": "2033-01-10T00:00:00Z",
