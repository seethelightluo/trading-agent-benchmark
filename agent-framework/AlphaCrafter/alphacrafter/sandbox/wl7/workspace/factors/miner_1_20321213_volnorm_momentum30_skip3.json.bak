{
  "factor_id": "miner_1_20321213_volnorm_momentum30_skip3",
  "factor_name": "Skip-3 volatility-normalized medium-term momentum (30-day volatility)",
  "version": "1.0",
  "calculation": {
    "expression": "(close[t-3] / close[t-23] - 1) / (std(pct_change(close)[t-29:t-3]) * sqrt(252))",
    "description": "Twenty-session return ending three sessions before the signal, normalized by lagged 30-session annualized realized volatility. Higher values indicate stronger risk-adjusted momentum."
  },
  "dependencies": ["close"],
  "parameters": {"return_window": 20, "skip": 3, "volatility_window": 30, "volatility_min_periods": 25, "annualization": 252, "forward_validation_horizon": 20},
