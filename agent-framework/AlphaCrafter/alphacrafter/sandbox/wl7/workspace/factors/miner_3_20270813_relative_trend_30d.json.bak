{
  "factor_id": "miner_3_20270813_relative_trend_30d",
  "factor_name": "Cross-Asset Relative Trend, Volatility Normalized",
  "version": "1.0",
  "calculation": {
    "expression": "((asset_close / asset_close.shift(30) - cross_sectional_median_30d_return) / (annualized_rolling_std(pct_change,30) + 0.01)).shift(1)",
    "description": "Ranks each instrument's lagged 30-session return relative to the same-day cross-asset median, scaled by its trailing annualized volatility. The one-session lag prevents use of the current completed day's close in a forward decision."
  },
  "dependencies": ["close"],
  "parameters": {"lookback_sessions": 30, "volatility_window": 30, "volatility_min_periods": 24, "volatility_floor": 0.01, "lag_sessions": 1, "universe_size": 15},
  "validation": {
