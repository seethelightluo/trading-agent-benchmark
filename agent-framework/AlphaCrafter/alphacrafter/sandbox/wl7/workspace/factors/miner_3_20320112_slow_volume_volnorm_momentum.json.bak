{
  "factor_id": "miner_3_20320112_slow_volume_volnorm_momentum",
  "factor_name": "Slow-volume-confirmed volatility-normalized momentum",
  "version": "1.0",
  "calculation": {
    "expression": "(close_t/close_{t-10}-1)/std(log_return,20) * (1 + 0.35*clip(mean(log(volume)_{t-4:t}) - median(log(volume)_{t-44:t-5}), -2, 2))",
    "description": "Ten-day momentum normalized by trailing 20-day return volatility, amplified or attenuated by a bounded slow volume-surprise confirmation. Uses only data available through date t."
  },
  "dependencies": ["close", "volume"],
  "parameters": {
    "momentum_window_days": 10,
    "volatility_window_days": 20,
    "volume_recent_window_days": 5,
    "volume_baseline_window_days": 40,
    "volume_multiplier": 0.35,
    "volume_clip": [-2.0, 2.0],
    "forward_horizon_days": 10
  },
