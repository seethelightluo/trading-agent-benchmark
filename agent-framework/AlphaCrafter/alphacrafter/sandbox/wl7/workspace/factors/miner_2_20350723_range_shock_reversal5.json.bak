{
  "factor_id": "miner_2_20350723_range_shock_reversal5",
  "factor_name": "Range-shock risk-normalized 5-day reversal",
  "version": "1.0",
  "calculation": {
    "expression": "shift_1((-return_5 / (sqrt(5)*realized_volatility_20)) * clip(avg_true_range_fraction_20 / median_60(avg_true_range_fraction_20), 0.25, 4.0))",
    "description": "Reverse the prior five-session return, normalize by 20-day realized volatility, and amplify unusually large recent high-low ranges as an interpretable attention/forced-move proxy. The one-session lag prevents look-ahead."
  },
  "dependencies": ["close", "high", "low"],
  "parameters": {"reversal_window": 5, "volatility_window": 20, "range_window": 20, "range_baseline_window": 60, "shock_clip": [0.25, 4.0], "lag": 1, "forward_horizon": 20},
