{
  "factor_id": "miner_1_20321101_skip5_beta_neutral_reversal10",
  "factor_name": "Skip-5 beta-neutral residual reversal (10-day shock)",
  "version": "1.0",
  "calculation": {
    "expression": "-(sum_10(asset_return) - beta_60(asset, equal_weight_market_return)*sum_10(market_return)).shift(5) / rolling_std_40(asset_return)",
    "description": "For each tradable asset, estimate a lagged 60-session beta to the equal-weight return of the 15-asset tradable universe, remove the beta-explained 10-session market shock, lag the residual shock by five sessions, and take its contrarian value normalized by 40-session realized volatility. The five-session skip reduces overlap with the decision-date close and avoids look-ahead. Higher values indicate stronger expected forward return."
  },
  "dependencies": ["close", "pct_change"],
  "parameters": {
    "market_definition": "equal_weight_mean_of_available_15_tradable_asset_returns",
    "beta_window": 60,
    "beta_min_periods": 40,
    "shock_window": 10,
    "skip_sessions": 5,
    "volatility_window": 40,
    "volatility_min_periods": 25,
    "forward_admission_horizon_sessions": 10,
    "minimum_cross_section": 8
  },
  "validation": {
    "status": "EFFECTIVE",
