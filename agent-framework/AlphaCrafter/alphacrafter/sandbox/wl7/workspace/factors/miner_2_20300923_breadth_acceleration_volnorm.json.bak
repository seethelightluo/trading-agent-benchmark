{
  "factor_id": "miner_2_20300923_breadth_acceleration_volnorm",
  "factor_name": "Breadth-conditioned volatility-normalized trend acceleration",
  "version": "1.0",
  "calculation": {
    "expression": "shift1(((return_5 - return_20/4) / rolling_std(daily_return,20)) * (0.5 + 0.5 * cross_sectional_breadth(return_20 > 0)))",
    "description": "Volatility-normalized five-day acceleration relative to the 20-day trend, scaled by contemporaneous cross-asset breadth and lagged one completed day."
  },
  "dependencies": ["close"],
  "parameters": {"short_window": 5, "trend_window": 20, "vol_window": 20, "forward_horizon_days": 10, "breadth_floor": 0.5, "breadth_scale": 0.5, "lag_days": 1},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2030-09-20",
    "validation_timestamp": "2030-09-23",
    "metrics": {
