{
  "factor_id": "miner_3_20280619_trend_acceleration_risk_adjusted",
  "factor_name": "Risk-Adjusted Trend Acceleration 20/60d",
  "version": "1.1",
  "calculation": {
    "expression": "shift_1(pct_change(close,20)/(ann_vol_20+0.02) - pct_change(close,60)/(ann_vol_60+0.02))",
    "description": "Measures acceleration of risk-adjusted trend: recent 20-day return per unit volatility relative to the corresponding 60-day measure. Positive values indicate strengthening trend; signal is lagged one completed session to avoid look-ahead. Cross-sectional ranking is performed across the available 15 tradable benchmark assets."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "short_window": 20,
    "long_window": 60,
    "volatility_windows": [
      20,
      60
    ],
    "annualization": 252,
    "volatility_floor": 0.02,
    "lag_sessions": 1,
    "forward_horizon_days": 10
  },
