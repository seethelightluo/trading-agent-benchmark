{
  "factor_id": "miner_3_20340306_medium_reversal_10d",
  "factor_name": "Lagged Twenty-Day Volatility-Normalized Medium-Horizon Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(sum(pct_change(close),20))/(std(pct_change(close),90)*sqrt(20)+1e-8), lagged one completed session",
    "description": "Ranks tradable cross-asset instruments that experienced unusually large 20-session losses relative to their 90-session daily volatility. Higher values indicate stronger reversal candidates. The signal is shifted one session to avoid look-ahead."
  },
  "dependencies": ["close", "daily returns"],
  "parameters": {"drawdown_window": 20, "volatility_window": 90, "forecast_horizon_sessions": 10, "signal_lag_sessions": 1},
  "validation": {
