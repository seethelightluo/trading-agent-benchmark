{
  "factor_id": "miner_1_20290507_slow_breadth_selloff_reversal",
  "factor_name": "Five-day breadth-conditioned selloff relative reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-2 * (0.5 - rolling_mean(cross_sectional_positive_return_breadth, 5)) * (asset_return_10d - cross_sectional_mean_return_10d), active only when rolling breadth <= 0.25; lagged one session",
    "description": "During sustained broad cross-asset weakness, rank assets by relative 10-trading-day reversal. The five-day breadth state and asset returns are lagged before measuring the following 10-trading-day return, avoiding look-ahead. Signal is zero outside the extreme selloff regime."
  },
  "dependencies": ["close"],
  "parameters": {
    "breadth_window": 5,
    "return_lookback": 10,
    "forward_horizon": 10,
    "breadth_threshold": 0.25,
    "cross_section_minimum": 8,
    "universe_size": 15
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2029-05-06",
    "metrics": {
      "ic": 0.0398596359105095,
      "icir_daily": 0.09819392261114106,
      "icir": 0.09819392261114106,
      "hit_ratio": 0.4957983193277311,
      "valid_dates": 238,
      "average_instruments": 13.138655462184873,
      "coverage": 0.8759103641456583,
      "turnover": null,
      "decay": {"horizon": 10, "note": "Validated at the 10-trading-day horizon only"},
      "max_abs_library_correlation": null
    },
    "regime_notes": "Extreme selloff conditioning materially improves stability versus the prior unconditioned and one-day breadth variants, but the effective sample is selective; interpret uncertainty conservatively for the 15-instrument universe.",
    "signal_artifact": "scripts/miner_1_20290507_slow_breadth_signal.csv",
    "validation_script": "scripts/miner_1_20290507_slow_breadth_signal.py"
  },
  "tags": ["reversal", "breadth", "selloff", "cross_asset", "regime_conditioned"],
  "last_validated": "2029-05-07T00:00:00Z"
}
