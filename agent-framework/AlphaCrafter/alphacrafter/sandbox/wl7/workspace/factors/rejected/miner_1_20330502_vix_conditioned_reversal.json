{
  "factor_id": "miner_1_20330502_vix_conditioned_reversal",
  "factor_name": "VIX-stress-conditioned volatility-scaled 10-day reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-((close/close.shift(10)-1)/(std(pct_change(close),30)*sqrt(10))) * clip(1 + 0.5*zscore(VIX.pct_change(5),60),0.25,2.0), shifted one completed session",
    "description": "Ranks assets for 10-session reversal using volatility-scaled trailing return. Reversal magnitude is increased in recent VIX-stress regimes and decreased in calm regimes. The complete signal is lagged one session to prevent look-ahead."
  },
  "dependencies": ["close", "VIX close"],
  "parameters": {"return_window": 10, "volatility_window": 30, "vix_change_window": 5, "vix_zscore_window": 60, "stress_multiplier": 0.5, "stress_clip": [0.25, 2.0], "signal_lag": 1, "forward_horizon": 10},
