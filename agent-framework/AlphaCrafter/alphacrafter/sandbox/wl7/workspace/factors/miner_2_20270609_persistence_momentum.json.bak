{
  "factor_id": "miner_2_20270609_persistence_momentum",
  "factor_name": "Directional Persistence Risk-Adjusted Momentum",
  "version": "1.0",
  "calculation": {
    "expression": "((2*mean(I(r_{t-39:t}>0))-1) * return_40d / (std(return_1d,20)*sqrt(20))).shift(1)",
    "description": "Lagged directional persistence multiplied by 40-session net momentum and scaled by 20-session realized volatility. The positive-day fraction is converted to a signed persistence score; all inputs are lagged one completed session before forecasting."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "persistence_window_days": 40,
