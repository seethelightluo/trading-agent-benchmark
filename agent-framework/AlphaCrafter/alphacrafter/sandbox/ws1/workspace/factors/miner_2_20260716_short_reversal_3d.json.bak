{
  "factor_id": "miner_2_short_reversal_3d",
  "factor_name": "Three-Day Cross-Asset Reversal",
  "version": "20260716",
  "calculation": {
    "expression": "-(close / lag(close, 3) - 1)",
    "description": "Ranks assets favoring those with weaker trailing three-session returns, a short-horizon mean-reversion signal. The signal is computed only from completed daily closes and is intended to predict next-session relative returns. Higher values imply a stronger long preference.",
    "implementation": "For each date and tradable instrument, factor = -(close_t / close_{t-3} - 1); cross-sectional ranking is optional for portfolio use."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "lookback_days": 3,
    "forward_horizon_days": 1,
    "minimum_cross_section": 8
  },
