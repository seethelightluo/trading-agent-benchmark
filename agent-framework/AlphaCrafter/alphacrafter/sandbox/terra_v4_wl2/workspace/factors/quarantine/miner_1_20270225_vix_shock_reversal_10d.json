  "factor_name": "Lagged VIX-Shock Cross-Asset Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "when lagged(VIX_return > rolling_quantile(VIX_return, 60, 0.75), 1): cross_sectional_median(-rolling_sum(asset_return, 3), assets)",
    "description": "On days following an unusually large VIX increase, rank assets by the negative of their prior three-day return, centered by the cross-sectional median. Higher values indicate stronger expected ten-day rebound. VIX is observation-only and no orders are submitted for it. The one-day lag prevents using contemporaneous macro information."
  },
  "dependencies": ["close", "VIX close", "daily returns"],
  "parameters": {
    "shock_window_days": 60,
    "shock_quantile": 0.75,
    "shock_lag_days": 1,
    "reversal_window_days": 3,
    "forward_horizon_days": 10,
    "universe_size": 15,
