{
  "factor_id": "miner_1_20270225_dispersion_only_reversal_10d",
  "factor_name": "Lagged cross-asset dispersion reversal",
  "version": "1.0",
  "calculation": {
    "expression": "where(lagged_cross_asset_dispersion > rolling_quantile(dispersion,60,0.75), -rolling_sum(asset_return,3) - cross_sectional_median(-rolling_sum(asset_return,3)), 0)",
    "description": "On the day after an unusually dispersed cross-asset return session, rank the three-day lagging assets for ten-day reversal. Dispersion is the cross-sectional standard deviation of daily returns and the activation threshold uses only the prior 60 observations. Cross-sectional median centering preserves relative rankings."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "lookback_return_days": 3,
    "dispersion_window": 60,
