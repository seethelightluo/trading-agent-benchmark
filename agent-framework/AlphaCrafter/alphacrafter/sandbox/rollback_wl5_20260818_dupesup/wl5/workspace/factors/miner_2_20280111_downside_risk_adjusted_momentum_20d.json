  "factor_id": "miner_2_20280111_downside_risk_adjusted_momentum_20d",
  "factor_name": "Downside-Risk-Adjusted Medium-Term Momentum",
  "version": "1.0",
  "calculation": {
    "expression": "cross_sectional_demean((close/close.shift(20)-1)/(rolling_std(negative_daily_returns,20)*sqrt(252)+1e-8))",
    "description": "Ranks 20-day price momentum after penalizing instruments by their trailing 20-day downside volatility. Negative daily returns are retained and positive returns set to zero for the downside-risk estimate; the daily cross-section is median demeaned. All inputs end at the prior completed date."
  },
  "dependencies": [
    "close",
    "daily_returns"
  ],
  "parameters": {
    "momentum_window_days": 20,
