{
  "factor_id": "miner_2_20280921_contrarian_risk_adjusted_30d",
  "factor_name": "Contrarian Risk-Adjusted 30-Session Persistence",
  "version": "1.0",
  "calculation": {
    "expression": "-pct_change(close, 30).shift(1) / (rolling_std(pct_change(close), 20).shift(1) * sqrt(30) + 1e-12)",
    "description": "Ranks assets positively when their lagged 30-session return is negative after volatility normalization. All inputs are lagged at least one completed session and are evaluated against the subsequent 10-session return."
  },
  "dependencies": ["close"],
  "parameters": {"lookback_sessions": 30, "volatility_window": 20, "forward_horizon_sessions": 10, "minimum_cross_section": 8},
