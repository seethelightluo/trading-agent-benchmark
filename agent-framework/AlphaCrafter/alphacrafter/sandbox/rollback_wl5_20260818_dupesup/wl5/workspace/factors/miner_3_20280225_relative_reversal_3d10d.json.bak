  "factor_name": "Three-Day Relative Reversal",
  "version": "2028-02-25",
  "calculation": {
    "expression": "-(return_3d(asset) - cross_sectional_median(return_3d))",
    "description": "Ranks assets positively when their trailing three-trading-day return is below the same-day cross-sectional median, forecasting a ten-trading-day forward return. Uses only completed prices."
