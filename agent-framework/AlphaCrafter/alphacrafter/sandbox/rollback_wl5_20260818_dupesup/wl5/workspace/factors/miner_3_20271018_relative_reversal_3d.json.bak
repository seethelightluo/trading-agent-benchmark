{
  "factor_id": "miner_3_20271018_relative_reversal_3d",
  "factor_name": "Cross-Asset Relative 3-Day Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(asset_return_3d - cross_sectional_median(asset_return_3d))",
    "description": "Invert each tradable benchmark instrument's three-trading-day return relative to the same-date cross-sectional median. Positive values identify recent relative underperformers and target short-horizon mean reversion. Signal is formed using close through t and predicts close-to-close return t+1."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "lookback_days": 3,
    "forward_horizon_days": 1,
    "minimum_valid_assets": 8,
    "cross_section": "15 tradable benchmark instruments"
  },
