{
  "factor_id": "miner_1_20280523_trend_acceleration_20v40",
  "factor_name": "Volatility-scaled trend acceleration",
  "version": "20280523",
  "calculation": {
    "expression": "((close_t / close_{t-20} - 1) - (close_{t-20} / close_{t-60} - 1)) / (std(pct_change(close), 20) * sqrt(20))",
    "description": "Measures whether the latest 20-trading-day return is stronger or weaker than the preceding 40-to-20-day return, scaled by trailing 20-day realized volatility. Higher values indicate strengthening trend; all inputs are lagged completed observations.",
