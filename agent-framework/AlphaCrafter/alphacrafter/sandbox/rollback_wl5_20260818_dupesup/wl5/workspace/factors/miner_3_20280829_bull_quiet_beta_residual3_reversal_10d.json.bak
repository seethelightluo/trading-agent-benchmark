  "calculation": {
    "expression": "-(return_3d(asset) - beta_60d(asset, equal_weight_benchmark) * return_3d(equal_weight_benchmark)); active only when return_5d(benchmark)>0 and vol_20d(benchmark)<rolling_median_252d(vol_20d(benchmark))",
