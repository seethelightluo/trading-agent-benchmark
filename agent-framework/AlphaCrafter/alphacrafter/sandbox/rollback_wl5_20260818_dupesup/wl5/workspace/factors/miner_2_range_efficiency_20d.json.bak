{
  "factor_id": "miner_2_range_efficiency_20d",
  "factor_name": "20-day Range Efficiency",
  "version": "2027-10-19",
  "calculation": {
    "expression": "sum(return,20) / (sum(abs(return),20) + 1e-12)",
    "description": "Net 20-trading-day return divided by the sum of absolute daily returns; positive values identify persistent directional movement and negative values identify persistent decline. Computed using prices available through the decision date.",
