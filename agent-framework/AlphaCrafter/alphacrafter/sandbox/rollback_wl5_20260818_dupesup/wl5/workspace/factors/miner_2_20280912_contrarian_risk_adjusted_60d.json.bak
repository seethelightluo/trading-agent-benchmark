  "factor_name": "Contrarian risk-adjusted 60-day persistence",
  "version": "2028-09-12",
  "calculation": {
    "expression": "-pct_change(close,60).shift(1) / (rolling_std(pct_change(close),20).shift(1)*sqrt(60)+1e-12)",
    "description": "Cross-asset contrarian score: assets with poorer lagged 60-session performance, normalized by lagged 20-session volatility, receive higher scores. All inputs are lagged to prevent look-ahead."
