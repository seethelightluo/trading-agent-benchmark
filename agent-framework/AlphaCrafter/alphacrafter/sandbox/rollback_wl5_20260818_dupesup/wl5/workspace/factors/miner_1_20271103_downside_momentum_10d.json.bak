{
  "factor_id": "miner_1_20271103_downside_momentum_10d",
  "factor_name": "Downside-Volatility-Adjusted 20-Day Momentum (10-Day Horizon)",
  "version": "1.0",
  "calculation": {
    "expression": "(close_t / close_{t-20} - 1) / (sqrt(mean(max(pct_change,0)^2? no: min(pct_change,0)^2,20)) * sqrt(20) + 1e-8)",
    "description": "Ranks assets by trailing 20-day return scaled by trailing 20-day downside deviation; only prices through the prior completed day are used. Higher values predict higher forward 10-trading-day returns. Downside deviation uses squared negative daily returns, with a minimum of 10 observations."
  },
  "dependencies": [
    "close",
    "pct_change"
  ],
  "parameters": {
    "lookback_days": 20,
    "downside_window": 20,
    "min_downside_observations": 10,
    "forward_horizon_days": 10,
    "epsilon": 1e-08
  },
