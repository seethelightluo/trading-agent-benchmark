{
  "factor_id": "miner_2_20280215_volneutral_recovery_10d",
  "factor_name": "Volatility-Neutralized Drawdown Recovery",
  "version": "1.0",
  "calculation": {
    "expression": "0.5*rank_cs(-(close/rolling_min(close,60)-1)) + 0.5*rank_cs(-(sum(return,5)/(rolling_std(return,20)*sqrt(5))))",
    "description": "Ranks instruments near their 60-day lows and combines this with a five-day reversal score normalized by each instrument's recent 20-day volatility. Higher values indicate stronger recovery potential per unit of recent risk."
  },
  "dependencies": [
    "close",
    "pct_change"
  ],
  "parameters": {
    "drawdown_window": 60,
    "reversal_window": 5,
    "volatility_window": 20,
    "min_history_drawdown": 40,
    "min_history_volatility": 15,
    "forward_horizon_days": 10
  },
