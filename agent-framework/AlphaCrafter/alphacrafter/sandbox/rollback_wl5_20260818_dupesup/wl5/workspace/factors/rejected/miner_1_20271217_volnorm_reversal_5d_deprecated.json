  "factor_name": "Volatility-normalized five-day reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(close / close.shift(5) - 1) / (rolling_std(pct_change(close), 20) * sqrt(252) + 1e-8)",
    "description": "Ranks assets positively when their trailing five-day return is negative, scaled by trailing 20-day annualized volatility. Signal uses only information through the decision date and predicts the next ten trading-day return."
  },
