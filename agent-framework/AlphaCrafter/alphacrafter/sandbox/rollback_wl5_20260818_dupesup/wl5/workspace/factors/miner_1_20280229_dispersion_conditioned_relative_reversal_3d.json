{
  "factor_id": "miner_1_20280229_dispersion_conditioned_relative_reversal_3d",
  "factor_name": "Dispersion-Conditioned Three-Day Relative Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(r3_i - median_cross_section(r3)) when median_abs(r3_i - median_cross_section(r3)) > rolling_median_60d(median_abs(r3_i - median_cross_section(r3))); otherwise null",
    "description": "Ranks assets contrarily to their three-day return relative to the cross-sectional median, but activates the signal only on dates whose cross-sectional dispersion exceeds its trailing 60-day median. The activation rule uses only information available at the decision date."
  },
  "dependencies": [
    "close"
  ],
