{
  "factor_id": "miner_2_20280704_acceleration_reversal_10d",
  "factor_name": "Volatility-adaptive acceleration reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(return(close,3) - return(close,12)/4) / (std(pct_change(close),20) + 1e-8)",
    "description": "Fades a recent three-day acceleration relative to the asset's prior twelve-day drift, normalized by twenty-day realized volatility. Positive values indicate stronger reversal potential.",
