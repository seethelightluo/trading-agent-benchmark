{
  "factor_id": "miner_3_20280815_conditional_beta_residual3_up_10d",
  "factor_name": "Up-Regime Beta-Residual Three-Day Reversal",
  "version": "2028-08-15",
  "calculation": {
    "expression": "IF(sum(equal_weighted_benchmark_return, 5) > 0, -(asset_return_3d - rolling_beta_60d * benchmark_return_3d), NaN)",
    "description": "Negated three-day asset return residual after removing 60-day rolling beta exposure to the equal-weighted 15-asset benchmark; active only when the trailing five-day benchmark return is positive. All inputs are lag-safe at the decision date."
  },
  "dependencies": ["close", "pct_change", "rolling_covariance", "rolling_variance"],
  "parameters": {
    "universe": 15,
    "beta_window": 60,
    "reversal_window": 3,
    "regime_window": 5,
    "forward_horizon_days": 10,
    "regime": "benchmark trailing 5-day return > 0",
    "min_cross_section": 8
  },
  "validation": {
