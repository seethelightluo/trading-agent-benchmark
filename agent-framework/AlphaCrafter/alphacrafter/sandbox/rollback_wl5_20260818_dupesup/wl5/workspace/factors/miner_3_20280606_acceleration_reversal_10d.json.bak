{
  "factor_id": "miner_3_20280606_acceleration_reversal_10d",
  "factor_name": "Volatility-scaled short-term acceleration reversal",
  "version": "20280606_v1",
  "calculation": {
    "expression": "-(return_3d - return_12d / 4) / rolling_std(daily_return, 20d)",
    "description": "Fade the recent three-day move relative to the average daily contribution of the preceding twelve-day trend, scaling by trailing 20-day daily volatility. Higher values indicate stronger expected forward returns. All inputs are known at the signal date."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
