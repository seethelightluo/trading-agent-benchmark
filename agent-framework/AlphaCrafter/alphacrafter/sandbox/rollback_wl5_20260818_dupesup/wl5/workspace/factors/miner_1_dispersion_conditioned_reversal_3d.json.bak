{
  "factor_id": "miner_1_dispersion_conditioned_reversal_3d",
  "factor_name": "High-Dispersion Three-Day Cross-Asset Reversal",
  "version": "2028-02-25",
  "calculation": {
    "expression": "where(mean_i(std(ret_i,5)) >= rolling_median(mean_i(std(ret_i,5)),60), -(ret_3d_i - median_i(ret_3d)))",
    "description": "Ranks assets contrarily to their three-session returns, activating the signal only when mean cross-asset five-day realized volatility is at or above its trailing 60-session median. Inactive dates carry no signal and should be handled by the portfolio layer."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "reversal_lookback_days": 3,
    "dispersion_window_days": 5,
    "activation_window_days": 60,
    "activation_quantile": 0.5,
    "forward_horizon_days": 10
  },
