{
  "factor_id": "miner_2_20271217_vix_shock_resilience_10d",
  "factor_name": "VIX Shock Resilience Spread",
  "version": "1.0",
  "calculation": {
    "expression": "-(mean(asset_returns during VIX-up days over trailing 60 sessions) - mean(asset_returns over trailing 60 sessions))",
    "description": "For each tradable asset, estimate whether its return is relatively resilient on sessions when observation-only VIX rises. Higher values indicate less deterioration, or stronger relative performance, during volatility shocks. VIX is used only as an observation signal and is not tradable."
  },
  "dependencies": [
    "close",
    "VIX",
    "pct_change"
  ],
  "parameters": {
    "lookback_days": 60,
    "minimum_vix_up_days": 5,
    "forward_horizon_days": 10,
    "universe_size": 15
  },
