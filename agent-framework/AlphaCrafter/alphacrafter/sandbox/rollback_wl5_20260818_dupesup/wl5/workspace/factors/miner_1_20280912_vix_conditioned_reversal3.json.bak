{
  "factor_id": "miner_1_20280912_vix_conditioned_reversal3",
  "factor_name": "VIX-conditioned 3-day cross-asset reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-pct_change(close,3) * (1 + 2*max(rolling_percentile_rank(VIX,252)-0.5,0))",
    "description": "Cross-sectional short-term reversal, strengthened only when trailing observable VIX percentile is above its median. VIX percentile uses data available through the signal date; no future data is used."
  },
  "dependencies": ["close", "VIX"],
  "parameters": {"reversal_window_days": 3, "forward_horizon_days": 10, "vix_window_days": 252, "vix_min_periods": 60, "stress_multiplier": 2.0},
  "signal_artifact": "scripts/miner_1_20280912_vix_conditioned_reversal3_signal.csv",
