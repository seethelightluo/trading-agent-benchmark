{
  "factor_id": "miner_2_channel_trend_20d",
  "factor_name": "20-day Smoothed Price-Channel Trend",
  "version": "1.0",
  "calculation": {
    "expression": "mean_3((close - rolling_min(low,20)) / (rolling_max(high,20) - rolling_min(low,20) + epsilon)) - 0.5",
    "description": "Ranks instruments by smoothed position in the trailing 20-day high-low channel; higher values indicate persistent strength."
  },
  "dependencies": [
    "close",
    "high",
    "low"
  ],
  "parameters": {
    "channel_window": 20,
    "smoothing_window": 3,
    "min_periods": 15,
    "epsilon": 1e-12
  },
