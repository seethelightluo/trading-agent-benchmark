  "factor_name": "Volatility-Scaled Cross-Asset Relative Reversal 5D",
  "version": "1.0",
  "calculation": {
    "expression": "-(asset_return_5d - cross_sectional_median(asset_return_5d)) / annualized_trailing_volatility_20d",
    "description": "Ranks assets higher when their recent five-day return underperformed the cross-sectional median, scaled by trailing 20-day realized volatility. The negative sign expresses mean-reversion expectations.",
