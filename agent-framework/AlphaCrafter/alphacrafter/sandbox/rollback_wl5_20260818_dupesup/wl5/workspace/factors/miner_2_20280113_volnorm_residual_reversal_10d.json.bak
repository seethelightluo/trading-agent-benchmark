{
  "factor_id": "miner_2_20280113_volnorm_residual_reversal_10d",
  "factor_name": "Volatility-Normalized Cross-Asset Residual Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(sum(asset_pct_change,5) - cross_sectional_median(sum(asset_pct_change,5))) / (rolling_std(asset_pct_change,20) + 1e-8)",
    "description": "At each decision date, rank assets that underperformed or outperformed the cross-asset five-day median after scaling by their trailing 20-day volatility. Higher scores favor recent relative losers, with volatile assets penalized; all inputs are shifted one completed session before the forward return."
  },
  "dependencies": [
    "close",
    "pct_change"
  ],
  "parameters": {
    "short_lookback_days": 5,
    "volatility_lookback_days": 20,
    "forward_horizon_days": 10,
    "minimum_cross_section": 8,
    "universe_size": 15
  },
