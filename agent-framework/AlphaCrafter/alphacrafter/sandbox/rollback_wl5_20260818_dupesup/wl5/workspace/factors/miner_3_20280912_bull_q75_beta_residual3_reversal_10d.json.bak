{
  "factor_id": "miner_3_20280912_bull_q75_beta_residual3_reversal_10d",
  "factor_name": "Bull-Constructive Beta-Residual 3D Reversal (Volatility Below 75th Percentile)",
  "version": "1.0",
  "calculation": {
    "expression": "-(asset_return_3d - rolling_beta_60(asset_returns, equal_weight_benchmark_returns) * benchmark_return_3d) when benchmark_return_5d > 0 and benchmark_volatility_20d < rolling_quantile(benchmark_volatility_20d,252,0.75), otherwise NaN",
    "description": "Cross-asset short-term reversal in a constructive regime. Removes each instrument's 60-day rolling beta exposure to the equal-weight 15-asset benchmark, then negates the 3-day residual return. The signal is active when the benchmark has positive 5-day momentum and its 20-day volatility is below its trailing 252-day 75th percentile. Forward horizon is 10 trading days."
  },
  "dependencies": ["close", "daily_returns"],
  "parameters": {"residual_return_window": 3, "beta_window": 60, "regime_momentum_window": 5, "benchmark_volatility_window": 20, "regime_quantile_window": 252, "regime_quantile": 0.75, "forward_horizon": 10, "minimum_cross_section": 8},
