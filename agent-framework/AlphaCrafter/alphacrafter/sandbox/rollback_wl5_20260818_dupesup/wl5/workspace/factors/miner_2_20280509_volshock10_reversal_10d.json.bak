{
  "factor_id": "miner_2_20280509_volshock10_reversal_10d",
  "factor_name": "Volatility-shock-scaled ten-day reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-return_10d * clip(volatility_10d / (volatility_60d + epsilon), 0, 5)",
    "description": "Cross-asset ten-day reversal amplified when recent ten-day realized volatility is elevated relative to its 60-trading-day baseline; uses only information available at signal date and predicts the next 10 trading-day return."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "return_window": 10,
    "short_volatility_window": 10,
    "baseline_volatility_window": 60,
    "forward_horizon_days": 10,
    "clip_lower": 0,
    "clip_upper": 5,
    "epsilon": 1e-12,
    "minimum_cross_section": 8,
    "universe_size": 15
  },
