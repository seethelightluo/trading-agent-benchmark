{
  "factor_id": "miner_3_20280829_bull_quiet_residual3",
  "factor_name": "Bull-Quiet Beta-Residual 3D Reversal",
  "version": "2028-08-29",
  "calculation": {
    "expression": "-((P_t/P_{t-3}-1) - beta_60(asset,benchmark)*sum_3d(benchmark_return)) conditioned on benchmark 5d return > 0 and benchmark 20d volatility < trailing 252d median",
    "description": "Ranks assets by the negative three-day beta-residual return, activating only in positive and relatively quiet benchmark regimes. Higher values indicate stronger short-term underperformance after removing benchmark exposure and are expected to mean-revert over the next 10 trading days. All inputs are lagged or contemporaneous at signal time."
  },
  "dependencies": [
    "close",
    "daily_returns"
  ],
  "parameters": {
    "residual_lookback_days": 3,
    "beta_lookback_days": 60,
    "beta_min_periods": 30,
    "regime_return_days": 5,
    "regime_vol_days": 20,
    "regime_vol_median_days": 252,
    "forward_horizon_days": 10,
    "minimum_cross_section": 8
  },
