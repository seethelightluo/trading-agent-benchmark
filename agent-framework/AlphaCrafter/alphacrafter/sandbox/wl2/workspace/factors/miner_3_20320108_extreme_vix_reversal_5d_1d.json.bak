{
  "factor_id": "miner_3_20320108_extreme_vix_reversal_5d_1d",
  "factor_name": "Extreme VIX and broad-weakness five-day risk-adjusted reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(sum(return,5) / rolling_std(return,20)) when pct_change(VIX,5)>0.04 and fraction(10-day returns<0)>=0.70, otherwise NaN",
    "description": "Ranks tradable cross-asset instruments for rebound potential after an extreme five-day VIX rise coinciding with broad ten-day weakness. VIX is observation-only and never traded."
  },
  "dependencies": [
    "close",
    "VIX close"
  ],
  "parameters": {
    "return_window_days": 5,
    "volatility_window_days": 20,
    "vix_window_days": 5,
    "vix_rise_threshold": 0.04,
    "breadth_window_days": 10,
    "negative_breadth_threshold": 0.7,
    "forward_horizon_days": 1
  },
