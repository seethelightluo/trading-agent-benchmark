{
  "factor_id": "volume_confirmed_reversal_3d",
  "factor_name": "Volume-Confirmed Three-Day Volatility-Normalized Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-sum(return,3)/(sqrt(3)*rolling_std(return,5)) * clip(mean(volume,5)/mean(volume,20),0.5,2.5), then lag 1 day",
    "description": "Ranks recent three-day reversals after volatility normalization, with stronger reversal exposure when five-day average volume is elevated relative to its 20-day baseline. The one-day lag prevents use of the current incomplete session."
  },
  "dependencies": ["close", "volume"],
  "parameters": {"return_window": 3, "volatility_window": 5, "volume_fast_window": 5, "volume_slow_window": 20, "volume_ratio_clip": [0.5, 2.5], "lag_days": 1, "forward_horizon_days": 1},
