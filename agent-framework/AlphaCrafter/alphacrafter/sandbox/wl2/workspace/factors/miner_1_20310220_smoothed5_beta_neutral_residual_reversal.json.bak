{
  "factor_id": "miner_1_20310220_smoothed5_beta_neutral_residual_reversal",
  "factor_name": "Smoothed 5-day Beta-Neutral Residual Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-EWMA(residual_return, span=5) / rolling_std(asset_return, 20)",
    "description": "For each tradable asset, remove the 60-day beta exposure to the cross-sectional median return, smooth the residual return with a 5-day EWMA, and invert it after scaling by 20-day realized volatility. Higher values indicate stronger short-horizon residual mean-reversion adjusted for asset risk. All inputs are lagged at the decision date."
  },
  "dependencies": ["close", "pct_change", "cross_sectional_median_return"],
  "parameters": {"beta_window": 60, "beta_min_periods": 40, "smoothing_span": 5, "volatility_window": 20, "volatility_min_periods": 15, "minimum_cross_section": 8},
