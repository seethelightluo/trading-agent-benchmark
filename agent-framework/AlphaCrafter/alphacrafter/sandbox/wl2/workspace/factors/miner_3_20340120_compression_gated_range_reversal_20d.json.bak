{
  "factor_id": "miner_3_20340120_compression_gated_range_reversal_20d",
  "factor_name": "Volatility-Compression-Gated Range-Efficiency Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-rank_cs(range_efficiency_20d) when vol10/vol60 <= cross_sectional_75th_percentile, lagged 1 day",
    "description": "For each tradable benchmark, compute 20-day signed log-return displacement divided by 20-day absolute log-return path length. Reverse-rank this measure, but retain only assets whose 10-day realized volatility divided by 60-day realized volatility is below the daily cross-sectional 75th percentile. All signals are lagged one completed session."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "efficiency_window": 20,
    "short_vol_window": 10,
    "long_vol_window": 60,
    "compression_quantile": 0.75,
    "signal_lag_days": 1,
    "forward_horizon_days": 20,
    "minimum_cross_section": 8
  },
