{
  "factor_id": "miner_2_20311030_continuous_defensive_lead_reversal_3d",
  "factor_name": "Continuous defensive-lead intensity weighted short-term reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(sum_return_3d / rolling_std_return_20d) * clip(max(defensive_mean_return_10d - risk_mean_return_10d, 0) / 0.01, 0, 1) * (1 - risk_positive_breadth_10d)",
    "description": "Risk-adjusted three-day reversal scaled continuously by defensive-lead intensity and weak risk-asset breadth. Defensive assets are XAU, US10Y, CN10Y; risk assets are SPX, NDX, SOX, 000300.SH, SX5E, HSI, N225, BTC, ETH, COPPER, WTI. All inputs use information available through the prior completed day."
  },
  "dependencies": ["close"],
  "parameters": {
    "reversal_window_days": 3,
    "volatility_window_days": 20,
    "regime_window_days": 10,
    "defensive_assets": ["XAU", "US10Y", "CN10Y"],
    "risk_assets": ["SPX", "NDX", "SOX", "000300.SH", "SX5E", "HSI", "N225", "BTC", "ETH", "COPPER", "WTI"],
    "lead_cap": 0.01
  },
