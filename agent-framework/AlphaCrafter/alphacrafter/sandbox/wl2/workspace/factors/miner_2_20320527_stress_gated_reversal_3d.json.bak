{
  "factor_id": "miner_2_20320527_stress_gated_reversal_3d",
  "factor_name": "Cross-Asset Stress-Gated Volatility-Normalized Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "I[rolling_std_cross_section(rolling_sum(return,3)) >= rolling_quantile_252(0.70) AND rolling_mean_cross_section(I[rolling_sum(return,3)>0]) <= 0.35] * (-(rolling_sum(return,3) / rolling_std(return,20)))",
    "description": "Fades three-day volatility-normalized directional moves only when cross-asset dispersion is elevated and broad three-day breadth is weak. Signal is computed using completed daily bars and is NaN outside the stress regime."
  },
  "dependencies": [
    "close",
    "pct_change"
  ],
  "parameters": {
    "move_window": 3,
    "volatility_window": 20,
    "stress_quantile_window": 252,
    "stress_quantile": 0.7,
    "negative_breadth_threshold": 0.35,
    "minimum_cross_section": 8
  },
  "validation": {
