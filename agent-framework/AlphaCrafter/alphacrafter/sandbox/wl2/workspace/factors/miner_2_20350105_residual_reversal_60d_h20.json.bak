{
  "factor_id": "miner_2_20350105_residual_reversal_60d_h20",
  "factor_name": "60-Day Beta-Neutral Cross-Asset Residual Reversal Volatility-Scaled",
  "version": "1.0",
  "calculation": {
    "expression": "-rolling_sum(residual_return,60).shift(1)/(rolling_std(residual_return,60).shift(1)*sqrt(60)+epsilon)",
    "description": "For each tradable asset, estimate a lagged 90-session beta to the equal-weight 15-asset benchmark, compute beta-neutral daily residual returns, fade the lagged 60-session cumulative residual return, and scale by lagged 60-session residual volatility. All signal inputs are lagged to avoid look-ahead."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "universe_size": 15,
    "beta_window": 90,
    "beta_min_periods": 60,
