  "factor_name": "Four-day smoothed volatility-scaled residual reversal",
  "version": "1.0",
  "calculation": {
    "expression": "mean_{j=0..3}[-(r_{t-j}-median_cross_section(r_{t-j}))/((rolling_std_20(r)_{t-j}))]",
