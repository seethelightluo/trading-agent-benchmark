{
  "factor_id": "miner_3_20340203_continuous_compression_reversal_20d",
  "factor_name": "Continuous Compression-Weighted Range-Efficiency Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "(-rank_cs(range_efficiency_20)) * rank_cs(clip(1 - stdev(log_return,10)/stdev(log_return,60), -2, 2)), lagged_1d",
    "description": "Ranks assets inversely by 20-day range efficiency and continuously weights that reversal signal by the cross-sectional rank of low-volatility compression. The complete signal is lagged one completed session to prevent look-ahead bias."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "range_window": 20,
    "short_vol_window": 10,
    "long_vol_window": 60,
    "compression_transform": "clip(1 - short_vol/long_vol, -2, 2)",
    "cross_section_rank": "percentile",
    "lag_days": 1,
    "minimum_cross_section": 8,
    "validation_horizon_days": 20
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2034-02-03",
