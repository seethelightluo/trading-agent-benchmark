{
  "factor_id": "miner_2_20350511_benchmark_residual_reversal_20d",
  "factor_name": "Stress-conditioned benchmark-residual reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-((return_20d) - rolling_beta_60d(asset, equal_weight_benchmark) * benchmark_return_20d), activated when mean 20d cross-asset volatility exceeds its rolling 120d median; lagged 1 trading day",
    "description": "Ranks assets for medium-horizon reversal of returns unexplained by the equal-weight tradable benchmark. The signal is active in elevated cross-asset volatility and uses only completed historical observations."
  },
  "dependencies": ["close"],
  "parameters": {"return_window": 20, "beta_window": 60, "benchmark": "equal_weight_mean_daily_return", "regime_vol_window": 20, "regime_median_window": 120, "forward_horizon_days": 20, "lag_days": 1, "minimum_cross_section": 8},
  "validation": {
