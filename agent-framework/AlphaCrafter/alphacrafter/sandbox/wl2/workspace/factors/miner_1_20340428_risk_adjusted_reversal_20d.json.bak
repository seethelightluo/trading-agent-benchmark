{
  "factor_id": "miner_1_20340428_risk_adjusted_reversal_20d",
  "factor_name": "20-day risk-adjusted reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-rolling_sum(log(close/close[-1]),20) / (rolling_std(log(close/close[-1]),20) * sqrt(20)), lagged 1 trading day",
    "description": "Ranks assets positively when their prior 20-session return was weak after adjustment for realized volatility; the one-session lag prevents use of the decision day's close."
  },
  "dependencies": ["close"],
  "parameters": {"lookback_days": 20, "volatility_window_days": 20, "lag_days": 1, "forward_horizons_days": [10,20,40]},
