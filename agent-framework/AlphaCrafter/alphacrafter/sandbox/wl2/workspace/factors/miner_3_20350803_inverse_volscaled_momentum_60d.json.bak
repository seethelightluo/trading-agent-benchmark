{
  "factor_id": "miner_3_20350803_inverse_volscaled_momentum_60d",
  "factor_name": "Inverse volatility-scaled 60-day momentum",
  "version": "1.0",
  "calculation": {
    "expression": "-pct_change(close, 60) / rolling_std(pct_change(close, 1), 20)",
    "description": "Cross-sectional contrarian score: negative 60-trading-day return scaled by trailing 20-day daily volatility. Inputs are shifted one completed day before use to prevent look-ahead. Higher values favor assets with poorer medium-term risk-adjusted performance."
  },
  "dependencies": ["close"],
  "parameters": {"lookback_return_days": 60, "volatility_window_days": 20, "minimum_volatility_observations": 15, "signal_lag_days": 1, "forward_validation_horizon_days": 40},
