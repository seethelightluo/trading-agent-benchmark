{
  "factor_id": "miner_3_20350330_stress_location_reversal_40d",
  "factor_name": "Stress-gated 120-day range-location reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-range_location_120d * I(VIX > trailing_120d_median(VIX) OR breadth_20d < 0.40)",
    "description": "At each lagged decision date, buy the cross-sectional reversal implied by assets near the bottom of their trailing 120-day price range, activating under elevated VIX or weak tradable-universe breadth. Signal is lagged one completed day; zero outside activation. Forward horizon for admission is 40 trading days."
  },
  "dependencies": [
    "close",
    "VIX close",
    "tradable-universe returns"
  ],
  "parameters": {
    "range_window": 120,
    "breadth_window": 20,
    "breadth_threshold": 0.4,
    "vix_median_window": 120,
    "activation_lag_days": 1,
    "admission_horizon_days": 40
  },
