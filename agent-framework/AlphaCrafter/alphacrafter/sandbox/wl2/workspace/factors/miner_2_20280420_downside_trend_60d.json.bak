{
  "factor_id": "miner_2_20280420_downside_trend_60d",
  "factor_name": "Cross-sectional downside-risk-adjusted 60-day trend",
  "version": "1.0",
  "calculation": {
    "expression": "(return_60d - cross_sectional_median(return_60d)) / (rolling_60d_downside_deviation + 1e-6)",
    "description": "Ranks instruments by 60-session excess trend relative to the 15-asset universe median, scaled by trailing downside volatility. Uses only completed historical bars and is intended as a low-turnover defensive trend signal."
  },
  "dependencies": [
    "close",
    "daily_returns"
  ],
  "parameters": {
    "trend_window": 60,
    "downside_window": 60,
    "downside_min_periods": 30,
    "winsorize_cross_section": [
      0.05,
      0.95
    ],
    "epsilon": 1e-06
  },
