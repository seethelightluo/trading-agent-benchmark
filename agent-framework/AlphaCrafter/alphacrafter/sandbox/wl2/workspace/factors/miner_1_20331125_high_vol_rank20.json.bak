{
  "factor_id": "miner_1_20331125_high_vol_rank20",
  "factor_name": "Lagged 20-day volatility rank continuation",
  "version": "1.0",
  "calculation": {
    "expression": "cross_sectional_rank(rolling_std(log(close/close[-1]),20)).shift(1)",
    "description": "Compute each tradable asset's trailing 20-session log-return volatility, rank across the 15-asset universe, and lag one completed session. Higher values indicate continuation toward assets with higher recent volatility. The lag prevents lookahead."
  },
  "dependencies": ["close"],
  "parameters": {"volatility_window": 20, "lag_days": 1, "forward_horizon_days": 10, "minimum_cross_section": 8},
