{
  "factor_id": "miner_2_20280309_quiet_trend",
  "factor_name": "Quiet trend: downside-risk and path-noise adjusted 15-day momentum",
  "version": "1.0",
  "calculation": {
    "expression": "sum(ret,15) / (downside_std(ret,20) + 1e-6) / (1 + 5 * mean(abs(ret),15))",
    "description": "Ranks assets by recent 15-session cumulative return, rewarding trends with low downside volatility and a quiet absolute-return path. All inputs are lagged completed daily bars; higher values are preferred."
  },
  "dependencies": [
    "close",
    "daily_returns"
  ],
  "parameters": {
    "momentum_window": 15,
    "downside_vol_window": 20,
    "downside_vol_min_periods": 10,
    "path_window": 15,
    "path_penalty": 5.0,
    "epsilon": 1e-06,
    "min_cross_section": 8
  },
