{
  "factor_id": "miner_1_20330610_high_dispersion_residual_reversal_5d",
  "factor_name": "High-dispersion lagged cross-sectional residual reversal",
  "version": "1.0",
  "calculation": {
    "expression": "if mean_20d(cross_sectional_std(log_return)) lagged > rolling_252d_75th_percentile then -lagged_3d(cross_sectional_return)",
    "description": "Ranks instruments for five-day forward returns by reversing their lagged three-day return relative to the daily cross-sectional mean, activated only when lagged cross-asset dispersion is in its upper historical quartile. The signal is lagged to avoid look-ahead."
  },
  "dependencies": ["close"],
  "parameters": {"residual_lookback_days": 3, "dispersion_window_days": 20, "threshold_window_days": 252, "threshold_quantile": 0.75, "forward_horizon_days": 5, "minimum_cross_section": 8},
  "signal_artifact": "scripts/miner_1_20330610_dispersion_reversal_signal.csv",
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2033-06-10",
    "last_validated": "2033-06-10T00:00:00Z",
    "metrics": {
      "ic": 0.034831770040305514,
      "icir": 0.10764124302685668,
      "ic_hit_ratio": 0.5229982964224872,
      "ic_dates": 587,
      "average_valid_instruments": 14.816013628620102,
      "coverage": 0.9877342419080067,
      "turnover_proxy": 0.18103531255961128,
      "max_abs_library_correlation": null
    },
    "regime_notes": "Selective high-dispersion dates only; 15-instrument universe, at least 8 valid names per IC date. Strongest tested result at 5-day horizon; 1d and 3d were below ICIR gate and 10d was weak."
  },
  "tags": ["cross_asset", "reversal", "dispersion", "regime_conditioned", "short_horizon"]
}
