{
  "factor_id": "miner_1_20290125_dispersion_conditioned_reversal_10d",
  "factor_name": "Dispersion-Conditioned Reversal/Trend Switch",
  "version": "1.0",
  "calculation": {
    "expression": "where(mean(asset rolling_5d return volatility) > rolling_120d 70th percentile, -rolling_sum(return,3), rolling_sum(return,20)); all components shifted one completed day",
    "description": "After unusually high cross-asset dispersion, rank assets by short-term reversal; in normal dispersion, rank by medium-term momentum. This conditional switch seeks to exploit rebound following broad dislocation while retaining trend exposure in calm regimes."
  },
  "dependencies": [
    "close",
    "daily returns"
  ],
  "parameters": {
    "dispersion_window": 5,
    "threshold_window": 120,
    "threshold_quantile": 0.7,
    "reversal_window": 3,
    "trend_window": 20,
    "lag_days": 1,
    "forward_horizon_days": 10
  },
