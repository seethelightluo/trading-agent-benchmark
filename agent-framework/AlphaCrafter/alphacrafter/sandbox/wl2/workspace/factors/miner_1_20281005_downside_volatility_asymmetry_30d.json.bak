{
  "factor_id": "downside_volatility_asymmetry_30d",
  "factor_name": "Downside Volatility Asymmetry 30D",
  "version": "1.0",
  "calculation": {
    "expression": "1 - rolling_mean(min(log_return,0)^2,30) / (rolling_mean(min(log_return,0)^2,30) + rolling_mean(max(log_return,0)^2,30))",
    "description": "Ranks assets whose recent realized variance is less concentrated in downside moves; higher values indicate cleaner upside/downside risk asymmetry. Signal is shifted one completed trading day to prevent look-ahead."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "window": 30,
    "min_periods": 20,
    "lag": 1,
    "admission_horizon_days": 10
  },
