{
  "factor_id": "miner_1_20300808_stress_conditioned_residual_recovery_3d_1d",
  "factor_name": "Stress-Conditioned Volatility-Scaled Residual Recovery",
  "version": "1.0",
  "calculation": {
    "expression": "-residual_return_3d / volatility_20d * stress_intensity",
    "description": "Cross-asset residual reversal after a broad downside and volatility-stress episode. Residual return removes the asset beta to the equal-weighted benchmark, and stress intensity rises with five-day downside breadth above 50% and benchmark volatility above its 120-day median. Uses only completed bars."
  },
  "dependencies": ["close", "pct_change"],
  "parameters": {"residual_window": 60, "shock_window": 3, "volatility_window": 20, "breadth_window": 5, "benchmark_vol_window": 120, "minimum_cross_section": 8},
