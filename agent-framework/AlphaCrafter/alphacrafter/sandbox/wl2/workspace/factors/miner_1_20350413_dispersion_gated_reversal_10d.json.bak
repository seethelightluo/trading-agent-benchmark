{
  "factor_id": "miner_1_20350413_dispersion_gated_reversal_10d",
  "factor_name": "Dispersion-Gated 10-Day Cross-Asset Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-pct_change(close,10).shift(1) when mean_i(std_20(ret_i)) > rolling_median_120(mean_i(std_20(ret_i))).shift(1), else 0",
    "description": "Ranks assets by lagged 10-session reversal, activating the signal only when trailing cross-asset volatility dispersion is above its trailing 120-session median. All inputs are lagged before forward-return measurement."
  },
  "dependencies": [
    "close",
    "pct_change",
    "cross_asset_returns"
  ],
  "parameters": {
    "reversal_lookback_sessions": 10,
    "dispersion_window_sessions": 20,
    "dispersion_baseline_sessions": 120,
    "minimum_dispersion_observations": 15,
    "activation": "above trailing median",
    "forward_admission_horizon_sessions": 20
  },
