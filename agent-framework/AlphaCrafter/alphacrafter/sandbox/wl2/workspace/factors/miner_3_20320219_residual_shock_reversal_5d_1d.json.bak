{
  "factor_id": "miner_3_20320219_residual_shock_reversal_5d_1d",
  "factor_name": "Breadth-gated residual five-day shock reversal",
  "version": "1.0",
  "calculation": {
    "expression": "(-[sum(pct_change(close),5) - cross_asset_mean(sum(pct_change(close),5)]) / rolling_std(pct_change(close),20) when cross_asset_downside_breadth_5d >= 0.60 and cross_asset_mean(rolling_std(pct_change(close),5))/rolling_median_60(cross_asset_mean(rolling_std(pct_change(close),5))) >= 1.15; otherwise null",
    "description": "During broad downside breadth and elevated cross-asset dispersion, fade each instrument's five-day return residual versus the cross-sectional mean, scaled by its 20-day volatility. The signal uses only information through the prior completed session and forecasts subsequent returns."
  },
  "dependencies": ["close", "pct_change"],
  "parameters": {
    "residual_return_window_days": 5,
    "volatility_window_days": 20,
    "dispersion_window_days": 5,
    "dispersion_baseline_days": 60,
    "downside_breadth_threshold": 0.60,
    "dispersion_ratio_threshold": 1.15,
    "forward_horizon_days": 1,
    "minimum_cross_section": 8
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-02-11 through 2032-02-18",
    "metrics": {
      "daily_paper_ic": 0.044541,
      "daily_paper_icir": 0.116770,
      "ic_hit_ratio": 0.5516,
      "ic_dates": 223,
      "average_instruments": 14.57,
      "factor_coverage": 0.0619,
      "active_dates": 0.0641,
      "decay_ic_3d": 0.063705,
      "decay_ic_5d": 0.064399,
      "decay_ic_10d": 0.053649,
      "max_abs_library_correlation": null
    },
    "regime_notes": "Positive IC and ICIR across 2020-2022, 2023-2025, and 2026-2031; no observations in the 2030-2032 slice under the active-date filter. Sparse activation warrants overlay use and monitoring.",
    "signal_artifact": "scripts/miner_3_20320219_residual_shock_signal.csv",
    "validation_timestamp": "2032-02-19T00:00:00"
  },
  "tags": ["reversal", "shock", "breadth", "dispersion", "cross_asset", "residual"],
  "last_validated": "2032-02-19"
}
