{
  "factor_id": "miner_3_20350105_defensive_residual_reversal_40d",
  "factor_name": "Defensive-Basket-Relative Residual Reversal (40D)",
  "version": "1.0",
  "calculation": {
    "expression": "-rolling_sum_30d(residual_return_to_defensive_basket) / (sqrt(30) * rolling_std_60d(residual_return))",
    "description": "For each tradable asset, estimate a lagged 90-day beta to the equal-weight defensive basket of XAU, US10Y, and CN10Y. Remove that beta exposure from daily returns, fade the prior 30-day cumulative residual return, and scale by lagged 60-day residual volatility. Signal is available only with information through the prior completed day."
  },
  "dependencies": ["close", "XAU", "US10Y", "CN10Y"],
  "parameters": {"defensive_basket": ["XAU", "US10Y", "CN10Y"], "beta_window": 90, "beta_min_periods": 60, "reversal_window": 30, "vol_window": 60, "vol_min_periods": 40, "horizon_days": 40},
