  "factor_name": "40-day beta-neutral residual reversal",
  "version": "2035-06-22",
  "calculation": {
    "expression": "-((return_40d - beta_120d(asset, equal_weight_benchmark) * benchmark_return_40d) / rolling_std_40d(daily_return)).shift(1)",
    "description": "Reverse the asset's 40-trading-day return residual after removing its trailing 120-day beta exposure to the equal-weight tradable benchmark, scale by trailing 40-day volatility, and lag one completed day."
