{
  "factor_id": "miner_1_20301226_continuous_dispersion_shock_reversal_1d",
  "factor_name": "Continuous dispersion-weighted volatility-scaled shock residual reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(sum_return_3d - cross_sectional_median(sum_return_3d)) / rolling_std(return_1d,20) * clip(cross_sectional_dispersion_1d / rolling_median(cross_sectional_dispersion_1d,60),0,3)",
    "description": "Fade each asset's volatility-scaled three-day return residual versus the cross-sectional median, continuously weighted by current cross-asset dispersion relative to its trailing 60-session median. All inputs are lagged at decision time."
  },
  "dependencies": ["close", "pct_change"],
  "parameters": {"shock_window_days": 3, "volatility_window_days": 20, "dispersion_window_days": 60, "dispersion_baseline": "trailing_median", "intensity_clip": [0, 3], "forward_horizon_days": 1},
