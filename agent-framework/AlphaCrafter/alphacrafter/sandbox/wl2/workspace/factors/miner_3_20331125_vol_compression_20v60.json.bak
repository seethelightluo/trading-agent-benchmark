{
  "factor_id": "miner_3_20331125_vol_compression_20v60",
  "factor_name": "20-day versus 60-day volatility compression rank",
  "version": "1.0",
  "calculation": {
    "expression": "cross_sectional_rank(-(rolling_std(log_return,20) / rolling_std(log_return,60)), pct=True), lagged 1 session",
    "description": "Ranks instruments higher when their recent 20-day volatility is low relative to their 60-day volatility. The one-session lag prevents lookahead."
  },
  "dependencies": ["close"],
  "parameters": {"short_window": 20, "long_window": 60, "lag": 1, "rank_method": "cross_sectional_percentile", "minimum_cross_section": 8},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2033-11-25",
    "validated_at": "2033-11-25",
    "metrics": {
      "horizon_days": 20,
      "ic": 0.037085,
      "icir": 0.156276,
      "hit_ratio": 0.5627,
      "valid_dates": 1843,
      "average_instruments": 12.269,
      "factor_coverage": 0.427029,
      "rank_turnover": 0.047519,
      "max_abs_library_correlation": null
    },
    "regimes": {
      "2026-2029": {"dates": 845, "ic": 0.054677, "icir": 0.229434},
      "2030-2033": {"dates": 998, "ic": 0.022189, "icir": 0.094207}
    },
    "thresholds": {"minimum_absolute_ic": 0.007, "minimum_absolute_icir": 0.084},
    "signal_artifact": "scripts/miner_3_20331125_vol_compression_20d_ic.csv",
    "regime_notes": "Positive in both recent regimes, with weaker but still gate-passing performance in 2030-2033. Small 15-asset cross-section warrants conservative interpretation."
  },
  "tags": ["volatility", "compression", "cross_asset", "rank"],
  "last_validated": "2033-11-25"
}
