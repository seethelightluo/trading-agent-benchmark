{
  "factor_id": "miner_3_20310515_dispersion_surprise_reversal_3d_1d",
  "factor_name": "Dispersion-surprise three-day volatility-normalized reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-sum(return,3)/(rolling_std(return,20)*sqrt(252)) * max(0, dispersion20/median(dispersion20,60)-1)",
    "description": "Fade each asset's recent three-day move, scaled by its 20-day volatility and by the positive surprise in cross-asset dispersion. Dispersion is the 20-day mean absolute cross-sectional deviation from the daily cross-sectional mean; all inputs are lagged through the prior completed day at decision time."
  },
  "dependencies": ["close", "daily_returns"],
  "parameters": {"lookback_return_days": 3, "volatility_days": 20, "dispersion_days": 20, "dispersion_baseline_days": 60, "minimum_cross_section": 8},
  "signal_artifact": "scripts/miner_3_20310515_dispersion_surprise_reversal_signal.csv",
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2031-05-15",
    "metrics": {"daily_paper_ic": 0.029639, "daily_paper_icir": 0.091474, "ic": 0.029639, "icir": 0.091474, "hit_ratio": 0.5240, "coverage": 0.9351, "turnover": 0.1098, "dates": 1750, "average_instruments": 14.186, "max_abs_library_correlation": null},
    "regime_notes": "IC/ICIR by regime: 2020-2022 0.027885/0.083353; 2023-2025 0.031056/0.096753; 2026-2031 0.029759/0.093060. Small 15-asset cross-section implies conservative uncertainty interpretation.",
    "validation_timestamp": "2031-05-15T00:00:00Z"
  },
  "tags": ["cross_asset", "reversal", "dispersion", "volatility_scaled"]
}
