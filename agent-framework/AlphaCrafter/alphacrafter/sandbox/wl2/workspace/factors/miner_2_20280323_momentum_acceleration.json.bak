{
  "factor_id": "miner_2_20280323_momentum_acceleration",
  "factor_name": "Risk-scaled momentum acceleration",
  "version": "1.0",
  "calculation": {
    "expression": "(sum_return(close,10) - 0.5*sum_return(close,10..29)) / rolling_std(pct_change(close),20)",
    "description": "Measures recent 10-session return in excess of the preceding 20-session average return, scaled by 20-session volatility. Higher values indicate strengthening trends; all inputs are lagged to the last completed bar at decision time."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "recent_window": 10,
    "prior_window": 20,
    "volatility_window": 20,
    "epsilon": 1e-06
  },
