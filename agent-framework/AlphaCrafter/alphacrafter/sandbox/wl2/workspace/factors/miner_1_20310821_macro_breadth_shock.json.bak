{
  "factor_id": "miner_1_20310821_macro_breadth_shock",
  "factor_name": "VIX stress and weak-breadth downside-shock reversal",
  "version": "1.0",
  "calculation": {
    "expression": "active * -(asset_return_5d - cross_sectional_median_return_5d)",
    "description": "When VIX is above its trailing 252-session 70th percentile and the five-day average breadth is below 45%, rank assets by the negative five-day return residual versus the cross-sectional median. The signal is lagged through completed daily data and is intended as a short-horizon cross-asset reversal factor. Inactive dates are missing rather than assigned a neutral score."
  },
  "dependencies": [
    "close",
    "VIX",
    "daily_returns"
  ],
  "parameters": {
    "return_window": 5,
    "forward_horizon": 1,
    "vix_window": 252,
    "vix_quantile": 0.7,
    "vix_min_periods": 126,
    "breadth_window": 5,
    "breadth_threshold": 0.45,
    "minimum_cross_section": 8
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2031-08-20",
