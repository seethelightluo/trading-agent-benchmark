{
  "factor_id": "miner_3_20310501_dispersion_tail_reversal_3d_1d",
  "factor_name": "Elevated-Dispersion Three-Day Tail Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-sum_{k=0..2}(return_t-k)/(rolling_std(return,20)*sqrt(252)) * I(dispersion_20 > rolling_quantile(dispersion_20,252,0.60))",
    "description": "For each tradable benchmark asset, fade its three-day cumulative return, volatility-normalized, only when the 20-day rolling cross-sectional mean absolute deviation of daily returns is above its trailing 252-day 60th percentile. The signal is lagged and evaluated against next-day returns."
  },
  "dependencies": ["close"],
  "parameters": {"lookback_days": 3, "volatility_window": 20, "dispersion_window": 20, "threshold_window": 252, "threshold_quantile": 0.60, "forward_horizon_days": 1},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01/2031-05-01",
    "last_validated": "2031-05-01T00:00:00Z",
