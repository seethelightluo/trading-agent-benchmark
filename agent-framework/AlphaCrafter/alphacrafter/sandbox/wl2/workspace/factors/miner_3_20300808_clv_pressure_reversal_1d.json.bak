{
  "factor_id": "miner_3_20300808_clv_pressure_reversal_1d",
  "factor_name": "Volatility-Scaled Close-Location Pressure Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-rolling_mean(((close-low)/(high-low)-0.5)*(high-low)/close, 3) / rolling_std(pct_change(close), 20)",
    "description": "Measures repeated closes near the daily low or high, weighted by normalized range and averaged over three sessions; the negative sign ranks downside close pressure as a next-day reversal opportunity, scaled by 20-day volatility. Calculated using data available through the prior completed day."
  },
  "dependencies": ["close", "high", "low"],
  "parameters": {"pressure_window": 3, "volatility_window": 20, "min_periods_pressure": 2, "min_periods_volatility": 15, "minimum_cross_section": 8},
  "validation": {
