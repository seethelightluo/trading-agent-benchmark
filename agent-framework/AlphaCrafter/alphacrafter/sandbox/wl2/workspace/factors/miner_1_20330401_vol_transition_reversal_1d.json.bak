  "factor_name": "Volatility-transition stress reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-cross_sectional_residual_return_5d / rolling_volatility_20d when lagged negative breadth > 60%, lagged 20d market return < 0, and lagged cross-asset mean(rv20)/mean(rv60)-1 > 0.15; otherwise NaN",
    "description": "During a synchronized bearish and rapidly volatility-expanding cross-asset regime, ranks recent five-day residual losers for next-day reversal. All regime and asset inputs are lagged to the prior completed day; inactive dates/assets are missing.",
