  },
  "dependencies": ["close", "pct_change", "cross_asset_returns", "rolling_std"],
  "parameters": {
    "residual_lookback_days": 5,
    "volatility_fast_days": 20,
    "volatility_slow_days": 60,
    "breadth_lookback_days": 1,
    "negative_breadth_threshold": 0.60,
    "market_trend_days": 20,
    "volatility_transition_threshold": 0.15,
    "minimum_cross_section": 8
  },
