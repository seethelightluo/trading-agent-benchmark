{
  "factor_id": "miner_1_20320205_volume_shock_reversal_3d_1d",
  "factor_name": "Conditional three-day volatility-scaled shock reversal",
  "version": "1.0",
  "calculation": {
    "expression": "(-sum(pct_change(close),3) / rolling_std(pct_change(close),20)) when cross_asset_mean(abs(pct_change(close))/rolling_std(pct_change(close),20) > 1.15, else null",
    "description": "On dates when the cross-asset average standardized absolute return exceeds 1.15, rank the negative three-day return scaled by each instrument's 20-day volatility; otherwise leave inactive. The signal is available after the prior completed day and predicts next-day return."
  },
  "dependencies": ["close", "pct_change", "rolling_std"],
  "parameters": {"return_window_days": 3, "volatility_window_days": 20, "shock_threshold": 1.15, "forward_horizon_days": 1, "minimum_cross_section": 8},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-02-11 through 2032-02-04",
    "metrics": {
      "daily_paper_ic": 0.036934,
      "daily_paper_icir": 0.108012,
      "ic_hit_ratio": 0.5480,
