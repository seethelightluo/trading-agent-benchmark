{
  "factor_id": "vol_scaled_reversal_1d",
  "factor_name": "Volatility-scaled one-day reversal",
  "version": "2028.02.24",
  "calculation": {
    "expression": "-pct_change(close,1) / (rolling_std(pct_change(close,1),20) + 1e-5)",
    "description": "Ranks instruments that fell on the completed prior session more highly for next-session mean reversion, with the move scaled by 20-day realized volatility. All inputs are lagged through the previous completed trading day."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "lookback_return_days": 1,
    "volatility_window": 20,
    "epsilon": 1e-05,
    "min_periods": 10
  },
