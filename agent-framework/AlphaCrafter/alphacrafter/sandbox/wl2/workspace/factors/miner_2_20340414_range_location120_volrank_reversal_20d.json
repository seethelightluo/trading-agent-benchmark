{
  "factor_id": "miner_2_20340414_range_location120_volrank_reversal_20d",
  "factor_name": "120-Day Range-Location Volatility-Rank Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "shift_1((1 - (close - rolling_min(close,120))/(rolling_max(close,120)-rolling_min(close,120))) * cross_sectional_percentile_rank(rolling_std(log_return,20)))",
    "description": "Ranks assets positively when they are near the bottom of their trailing 120-session price range, with emphasis on higher cross-sectional 20-session volatility. Signal is lagged one session to prevent look-ahead."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "range_window": 120,
    "volatility_window": 20,
    "forward_horizon_days": 20,
    "lag_sessions": 1,
    "minimum_cross_section": 8
  },
