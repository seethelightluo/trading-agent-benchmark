{
  "factor_id": "miner_1_20321111_risk_adjusted_trend_reversal_10d",
  "factor_name": "Risk-Adjusted Trend Reversal (20d trend, 10d horizon)",
  "version": "1.0",
  "calculation": {
    "expression": "-((pct_change(close,20)/(std(pct_change(close,1),20)*sqrt(20)) * clip(std(return,20)/std(return,60),0.5,2.0)).shift(1))",
    "description": "Contrarian signal: negate the lagged 20-session return normalized by 20-session realized volatility and scaled by the 20/60-day volatility ratio. Cross-sectional Spearman ranking is used for IC evaluation."
  },
  "dependencies": ["close"],
  "parameters": {"trend_window_days": 20, "short_volatility_window_days": 20, "long_volatility_window_days": 60, "forward_horizon_days": 10, "volatility_ratio_clip": [0.5, 2.0], "lag_days": 1, "cross_sectional_method": "spearman"},
