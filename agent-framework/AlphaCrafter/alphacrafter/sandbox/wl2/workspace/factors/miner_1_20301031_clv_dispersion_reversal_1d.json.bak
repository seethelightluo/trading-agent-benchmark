{
  "factor_id": "miner_1_20301031_clv_dispersion_reversal_1d",
  "factor_name": "Dispersion-gated candle-location reversal",
  "version": "1.1",
  "calculation": {
    "expression": "-cross_sectional_demean(CLV_5d_mean) * I(cross_asset_return_dispersion > rolling_median_60d(dispersion))",
    "description": "Fade five-day average candle close-location pressure only when cross-asset return dispersion is above its trailing 60-day median. Signal is cross-sectionally demeaned each date and uses only completed daily OHLC data."
  },
  "dependencies": ["open", "high", "low", "close"],
  "parameters": {"clv_window": 5, "dispersion_window": 60, "min_instruments": 8, "forward_horizon": 1},
  "validation": {
    "status": "EFFECTIVE",
    "timestamp": "2030-11-28T00:00:00Z",
    "period": "2020-01-01 through 2030-11-27",
    "metrics": {
      "horizon": "1 trading day",
      "dates": 1660,
