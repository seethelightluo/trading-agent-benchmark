{
  "factor_id": "miner_1_20260910_downside_adjusted_efficiency_20d",
  "factor_name": "20-Day Downside-Adjusted Directional Efficiency",
  "version": "20260910",
  "calculation": {
    "expression": "lag(rank_cs(sum(return,20)/(sum(-min(return,0),20)+0.01)),1)",
    "description": "Ranks twenty-session cumulative return by adverse-return burden. Higher values represent positive persistence achieved with less cumulative downside movement; lagged one completed session to prevent look-ahead."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "window_days": 20,
    "downside_definition": "sum(-min(daily_return,0))",
    "stabilizer": 0.01,
    "lag_days": 1,
    "minimum_observations": 15,
    "minimum_cross_section": 8
  },
