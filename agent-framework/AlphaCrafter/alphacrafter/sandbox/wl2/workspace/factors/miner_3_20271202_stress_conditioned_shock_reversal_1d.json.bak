{
  "factor_id": "miner_3_20271202_stress_conditioned_shock_reversal_1d",
  "factor_name": "Stress-Conditioned Shock Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-daily_return_t * (0.25 + 0.75 * I(dispersion5_t > rolling_median60(dispersion5_t)))",
    "description": "Reverse the most recent completed daily return, increasing reversal intensity when the 5-day cross-asset dispersion is above its trailing 60-observation median. The signal at close t forecasts return from t to t+1; no future data are used. Cross-sectional values are winsorized at the 5th and 95th percentiles for evaluation/portfolio use.",
    "dispersion5": "cross_sectional_mean(rolling_std(daily_return, 5))",
    "stress_threshold": "rolling_median(dispersion5, 60)"
  },
  "dependencies": [
    "close",
    "daily_return",
    "15-asset cross-section"
  ],
  "parameters": {
    "return_lookback": 1,
    "dispersion_lookback": 5,
    "stress_window": 60,
    "calm_scale": 0.25,
    "stress_increment": 0.75,
    "winsor_lower": 0.05,
    "winsor_upper": 0.95,
    "minimum_cross_section": 8
  },
  "validation": {
