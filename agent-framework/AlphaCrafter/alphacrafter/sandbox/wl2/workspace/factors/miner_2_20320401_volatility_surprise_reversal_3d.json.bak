{
  "factor_id": "volatility_surprise_weighted_reversal_3d",
  "factor_name": "Volatility-Surprise Weighted Three-Day Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-sum(return,3)/(sqrt(3)*rolling_std(return,5)) * clip(rolling_std(return,5)/rolling_std(return,60),0.5,3.0)",
    "description": "Fades the recent three-day move, scaling the reversal by short-term volatility relative to its 60-day baseline. Signal is lagged one completed day before forecasting the next-day cross-sectional return. Continuous rather than threshold-gated to preserve coverage."
  },
  "dependencies": ["close"],
  "parameters": {"return_window": 3, "short_vol_window": 5, "baseline_vol_window": 60, "surprise_clip": [0.5, 3.0], "signal_lag": 1, "forecast_horizon_days": 1},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-03 through 2032-04-01",
    "metrics": {
      "daily_ic": 0.010204704,
      "daily_icir": 0.498895744,
      "ic_hit_ratio": 0.5239,
      "ic_dates": 2409,
      "average_instruments": 15.0,
      "coverage": 1.0,
      "turnover": 0.0450,
      "max_abs_library_correlation": 0.985203
    },
    "decay": {"1d": 0.010204704, "3d": 0.012228016, "5d": 0.003385481, "10d": -0.004426831},
    "regime_notes": "Full-sample and recent 2026-2031/2032 samples passed the daily gates; 2020-2025 had no valid observations in the aligned artifact due to source-date availability. Interpret stability conservatively. Pairwise artifact screening found high overlap with an existing downside-asymmetry signal; retain as a documented candidate for deterministic post-Miner redundancy review.",
    "signal_artifact": "scripts/miner_2_20320401_vol_surprise_reversal_signal.csv",
    "validation_timestamp": "2032-04-01T00:00:00Z"
  },
  "tags": ["volatility", "reversal", "cross_asset", "short_horizon"]
}
