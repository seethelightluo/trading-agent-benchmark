{
  "factor_id": "miner_1_20320304_residual_shock_reversal_3d_1d",
  "factor_name": "Breadth-gated residual three-day shock reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(rolling_sum(return,3)-cross_sectional_mean(rolling_sum(return,3)))/rolling_std(return,20), active when negative_3d_breadth >= 0.60 and mean(rolling_std(return,5))/rolling_median_60(mean(rolling_std(return,5))) >= 1.15",
    "description": "During broad, high-dispersion selloffs, fade each instrument's volatility-scaled three-day return residual relative to the cross-asset mean. Inactive observations are missing."
  },
  "dependencies": ["close"],
  "parameters": {"shock_window_days": 3, "volatility_window_days": 20, "dispersion_window_days": 5, "dispersion_baseline_days": 60, "breadth_threshold": 0.60, "dispersion_threshold": 1.15, "forward_horizon_days": 1},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-02-11 through 2032-03-03",
    "metrics": {"ic": 0.035295, "icir": 0.092705, "ic_hit_ratio": 0.5189, "ic_dates": 212, "average_instruments": 14.59, "coverage": 0.0597, "active_dates": 0.0614, "turnover": null, "decay_ic_3d": 0.068896, "decay_ic_5d": 0.082948, "decay_ic_10d": 0.064652, "max_abs_library_correlation": null},
    "regime_notes": "Strong in 2020-2022, weak/negative in 2026-2031; sparse conditional overlay and recent active observations are insufficient for reliable recent-regime inference.",
    "signal_artifact": "scripts/miner_1_20320304_residual_shock_3d_signal.csv"
  },
  "tags": ["reversal", "shock", "cross_asset", "breadth_conditioned", "residual", "volatility_scaled"],
