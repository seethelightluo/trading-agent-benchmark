  "factor_name": "Five-Session Volatility-Conditioned Reversal (60d horizon)",
  "version": "1.0",
  "calculation": {
    "expression": "(-pct_change(close,5)/(rolling_std(log_return,20)*sqrt(5)))/(1+rolling_std(log_return,20)/rolling_std(log_return,60)), lagged 1 session",
    "description": "Contrarian five-session return, normalized by 20-session realized volatility and attenuated when current volatility exceeds its 60-session baseline; signal is lagged one completed session."
  },
  "dependencies": ["close"],
  "parameters": {"reversal_window": 5, "risk_window": 20, "volatility_baseline_window": 60, "forward_horizon": 60, "lag": 1},
