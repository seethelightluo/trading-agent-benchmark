{
  "factor_id": "miner_2_20340203_rankblend_range_asymmetry_reversal_20d",
  "factor_name": "Rank-Blended Range Reversal and Volatility-Asymmetry Signal",
  "version": "1.0",
  "calculation": {
    "expression": "0.7*cs_rank(-(2*close-min(close,60)-max(close,60))/(max(close,60)-min(close,60)) + 0.3*cs_rank((upside_vol_20-downside_vol_20)/(upside_vol_20+downside_vol_20)), lagged_1d",
    "description": "Blends a 60-day range-location reversal rank with a volatility-asymmetry rank. Assets near the bottom of their range and with relatively greater upside than downside volatility receive higher scores. All inputs are lagged one completed session."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "range_window": 60,
    "asymmetry_window": 20,
    "minimum_range_observations": 45,
    "minimum_vol_observations": 5,
    "range_weight": 0.7,
    "asymmetry_weight": 0.3,
    "lag_days": 1,
    "minimum_cross_section": 8,
    "validation_horizon_days": 20
  },
