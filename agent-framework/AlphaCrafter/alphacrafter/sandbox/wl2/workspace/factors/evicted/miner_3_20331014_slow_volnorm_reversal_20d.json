  "factor_name": "Lagged slow volatility-normalized reversal",
  "version": "1.0",
  "calculation": {
    "expression": "cross_sectional_rank(-(close/close_lag_20 - 1) / rolling_std(log_return, 60)) shifted by 1 completed session",
    "description": "Ranks instruments higher when their prior 20-trading-day return was more negative after normalization by 60-day daily return volatility. The one-session lag prevents look-ahead. Higher scores predict stronger subsequent 20-day returns in the tested sample."
