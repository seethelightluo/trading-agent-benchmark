{
  "factor_id": "miner_2_20310626_dispersion_scaled_range5_reversal_1d",
  "factor_name": "Dispersion-scaled five-day range-location reversal",
  "version": "1.0",
  "calculation": {
    "expression": "(0.5 - (close - rolling_min(close,5))/(rolling_max(close,5)-rolling_min(close,5))) * clip(cross_asset_dispersion / rolling_median(cross_asset_dispersion,252), 0.5, 2.0)",
    "description": "Ranks assets higher when their close is near the bottom of its five-session range, with the reversal score scaled by unusually high or low cross-asset return dispersion. Cross-asset dispersion is the equal-weight mean absolute deviation of each asset return from the daily universe mean return. All inputs are lag-safe at the decision date."
  },
  "dependencies": [
    "close",
    "daily_return",
    "15-asset cross-sectional dispersion"
  ],
  "parameters": {
    "range_window": 5,
    "dispersion_baseline_window": 252,
