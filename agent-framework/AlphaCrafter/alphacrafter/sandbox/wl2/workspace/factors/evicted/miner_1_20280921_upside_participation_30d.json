  "factor_name": "Upside Participation Efficiency 30D",
  "version": "1.0",
  "calculation": {
    "expression": "0.5 * rolling_sum(max(log_return,0),30) / rolling_sum(abs(log_return),30) + 0.5 * rolling_mean(log_return > 0,30), lagged 1 day",
