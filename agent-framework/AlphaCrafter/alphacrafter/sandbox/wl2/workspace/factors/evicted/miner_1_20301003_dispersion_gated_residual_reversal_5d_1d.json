  "factor_name": "Dispersion-gated five-day residual reversal",
  "version": "1.0",
  "calculation": {
    "expression": "demean_cs((-return_5d / volatility_20d) * I(dispersion_1d > median_60d(dispersion_1d)))",
    "description": "Ranks assets positively when their five-day return is below the cross-sectional median, scaled by inverse 20-day volatility and activated when cross-asset daily dispersion exceeds its trailing 60-day median. The signal uses only completed-day data."
