{
  "factor_id": "miner_3_20310220_smoothed5_beta_residual_reversal_1d",
  "factor_name": "5-Day Smoothed Beta-Neutral Residual Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-EMA(residual_return, span=5) / rolling_std(asset_return, 20)",
    "description": "For each tradable asset, estimate 60-day rolling beta to the cross-sectional median daily return, remove beta times the median return, smooth the residual return with a 5-observation EMA, and negate and divide by 20-day realized volatility. Higher values indicate stronger short-horizon residual-reversal exposure."
  },
  "dependencies": [
    "close",
    "cross_sectional_median_return"
  ],
  "parameters": {
    "beta_window": 60,
    "beta_min_periods": 40,
    "ema_span": 5,
    "volatility_window": 20,
    "volatility_min_periods": 15,
    "minimum_cross_section": 8
  },
