  "factor_id": "quiet_volscaled_trend_90d",
  "factor_name": "Low-dispersion regime volatility-scaled 10-day trend",
  "version": "1.0",
  "calculation": {
    "expression": "where(10d_cross_asset_dispersion <= rolling_median(90d, min_periods=45), 10d_return / rolling_std(daily_return,20), NaN), then lag one session",
    "description": "Ranks tradable assets by ten-session return divided by trailing 20-session daily volatility, only during low cross-asset dispersion regimes. The regime and signal are lagged one completed session to prevent look-ahead."
