{
  "factor_id": "miner_3_20311127_broad_selloff_reversal_10d_1d",
  "factor_name": "Broad Selloff Dispersion-Conditioned 10-Day Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(rolling_sum(pct_change(close),10) / rolling_std(pct_change(close),20)) when (cross_sectional_downside_breadth_10d >= 0.60) and (cross_sectional_dispersion_10d > rolling_median(cross_sectional_dispersion_10d,60)); otherwise NaN",
    "description": "Contrarian risk-adjusted ten-day loss signal activated only during broad selloffs whose cross-asset ten-day return dispersion is above its trailing 60-day median. Higher values indicate stronger recent underperformance and expected near-term reversal."
  },
  "dependencies": [
    "close",
    "pct_change",
    "cross_sectional_breadth",
    "cross_sectional_dispersion"
  ],
  "parameters": {
    "lookback_return_days": 10,
