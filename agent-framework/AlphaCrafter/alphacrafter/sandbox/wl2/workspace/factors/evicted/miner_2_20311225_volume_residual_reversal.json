{
  "factor_id": "miner_2_20311225_volume_residual_reversal",
  "factor_name": "Volume-Weighted Beta-Neutral 3-Day Residual Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(rolling_sum_3(asset_return - equal_weight_cross_asset_return) / rolling_std_20(asset_return)) * (1 + 0.25 * clip(log(volume / rolling_median_40(volume)), -1, 1))",
    "description": "Reverse the recent three-day asset return after removing the equal-weight cross-asset move, risk-scale by 20-day volatility, and modestly increase the reversal magnitude when relative volume is abnormal. All inputs are lagged through the decision date."
  },
  "dependencies": [
    "close",
    "volume"
  ],
  "parameters": {
    "residual_window_days": 3,
    "volatility_window_days": 20,
    "relative_volume_window_days": 40,
    "volume_clip_log": [
      -1.0,
      1.0
    ],
    "volume_multiplier": 0.25,
    "minimum_cross_section": 8
  },
