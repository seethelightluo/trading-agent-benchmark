  "factor_name": "Volatility-Conditioned Short Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "(-pct_change(close,5)/(rolling_std(log_returns,20)*sqrt(5))) * (1/(1 + rolling_std(log_returns,20)/rolling_std(log_returns,60)))",
    "description": "Reverses the lagged five-session return, risk-normalizes it, and attenuates the signal when current volatility is elevated relative to its 60-session baseline. Signal is shifted one session before use."
  },
