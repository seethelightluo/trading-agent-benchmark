  "version": "1.0",
  "calculation": {
    "expression": "-rolling_sum_3(residual_return_i)/((rolling_std_20_i)*sqrt(252)) * max(dispersion/rolling_median_252(dispersion)-1,0) * I(dispersion_t < dispersion_{t-5})",
