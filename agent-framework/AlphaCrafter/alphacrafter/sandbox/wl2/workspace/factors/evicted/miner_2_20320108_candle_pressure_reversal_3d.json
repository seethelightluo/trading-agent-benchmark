  "factor_name": "Cross-Asset Candle-Pressure Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-demean_cs(rolling_sum(3, CLV * (high-low)/close_lag1)) / rolling_std(returns,20)",
    "description": "Fade three-day accumulated close-location pressure, normalized by each asset's 20-day return volatility and neutralized against the cross-asset mean pressure. CLV=(2*close-high-low)/(high-low). Uses only completed daily OHLC data."
