{
  "factor_id": "miner_2_20340707_dispersion_conditioned_reversal_40d",
  "factor_name": "Cross-Asset Dispersion-Conditioned 5-Day Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "rank_cs(-sum(log_return,5) * clip(cross_asset_dispersion_20 / median(cross_asset_dispersion_20,120),0.5,2.0)), lagged_1d",
    "description": "Ranks short-term reversal more strongly when recent cross-asset return dispersion is elevated. Cross-asset dispersion is the cross-sectional standard deviation of each instrument's trailing 20-session cumulative log return, normalized by its trailing 120-session median. Every input is shifted one completed session before signal use."
  },
  "dependencies": [
    "close"
  ],
