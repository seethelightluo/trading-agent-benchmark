{
  "factor_id": "miner_1_20320108_vix_breadth_reversal_5d_1d",
  "factor_name": "VIX-stress and downside-breadth conditioned 5-day volatility-scaled reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(close/close.shift(5)-1)/(rolling_std(pct_change(close),20)*sqrt(5)) when VIX > rolling_median(VIX,60) and VIX > rolling_mean(VIX,20) and cross_sectional_mean(I[pct_change(close,5)<0]) > 0.55; otherwise NaN",
    "description": "Ranks instruments for mean reversion after a volatility-stressed, broadly weak cross-asset selloff. All inputs are lagged completed-day data and the signal is paired with next-day forward returns."
  },
  "dependencies": [
    "close",
    "VIX",
    "pct_change",
    "rolling_std"
  ],
  "parameters": {
    "reversal_window_days": 5,
    "volatility_window_days": 20,
    "stress_vix_median_window_days": 60,
    "stress_vix_mean_window_days": 20,
    "breadth_return_window_days": 5,
    "downside_breadth_threshold": 0.55,
    "normalization_scale": "sqrt(5)",
    "forward_horizon_days": 1,
    "minimum_cross_section": 8
  },
