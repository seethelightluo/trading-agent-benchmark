  "version": "1.0",
  "calculation": {
    "expression": "-EMA(residual_return_60d_beta, span=7) / rolling_std(asset_return, 20d)",
    "description": "Estimate each asset's 60-day beta to the cross-sectional median return, remove the beta-adjusted common component, smooth residual returns with a 7-observation EMA, then negate and scale by 20-day realized volatility. Higher values indicate stronger short-term residual-reversal opportunity."
