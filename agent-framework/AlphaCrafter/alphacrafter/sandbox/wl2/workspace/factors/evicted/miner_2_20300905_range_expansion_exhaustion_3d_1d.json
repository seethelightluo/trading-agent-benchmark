{
  "factor_id": "miner_2_20300905_range_expansion_exhaustion_3d_1d",
  "factor_name": "Range-Expansion Exhaustion Residual Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-rolling_sum_3d(asset_return - cross_sectional_median_return) * (1 + clip(max(true_range_pct / rolling_median_20d(true_range_pct) - 1, 0), 0, 4))",
    "description": "Ranks assets for next-day relative reversal after a three-day asset-specific move, amplifying the reversal signal only when the current daily high-low range is above its own 20-day median. The range multiplier is clipped to limit outlier influence."
  },
  "dependencies": [
    "close",
    "high",
    "low"
  ],
  "parameters": {
    "residual_window_days": 3,
    "range_baseline_days": 20,
    "baseline_min_periods": 10,
    "range_multiplier_clip": [
      0,
      4
    ],
    "forward_horizon_days": 1,
    "minimum_cross_section": 8
  },
