  "factor_name": "Candle-location volume-pressure reversal",
  "version": "1.0",
  "calculation": {
    "expression": "cross_sectional_demean(-(CLV_3d_mean * (1 + 0.25*clip((log1p(volume)-MA20(log1p(volume)))/STD60(log1p(volume)),-2,2)))/(STD20(daily_return)*sqrt(3)))",
    "description": "Reverse three-day average candle close-location pressure, with a bounded volume-surprise modulation, and normalize by 20-day return volatility. Cross-sectional demeaning is applied each date."
