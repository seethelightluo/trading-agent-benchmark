  "factor_name": "Relative Slow Volatility-Normalized Reversal (20-day)",
  "version": "1.0",
  "calculation": {
    "expression": "cross_sectional_rank(-(asset_return_20d - cross_sectional_median(asset_return_20d)) / rolling_std(log_return,60)), shifted by 1 completed session",
    "description": "Ranks each tradable asset's 20-day underperformance relative to the cross-sectional median, normalized by its own 60-day daily return volatility. The one-session lag prevents look-ahead. Higher scores indicate relatively weaker, risk-adjusted assets expected to mean-revert over 20 trading days."
  },
  "dependencies": [
    "close",
    "daily log returns"
  ],
  "parameters": {
    "return_window": 20,
