  "factor_name": "VIX-Stress Downside Shock Reversal (5-day)",
  "version": "1.0",
  "calculation": {
    "expression": "max(0, -rolling_sum(pct_change(close), 5) / (rolling_std(pct_change(close), 20) * sqrt(5))) * I(VIX > rolling_quantile(VIX, 252, 0.70))",
