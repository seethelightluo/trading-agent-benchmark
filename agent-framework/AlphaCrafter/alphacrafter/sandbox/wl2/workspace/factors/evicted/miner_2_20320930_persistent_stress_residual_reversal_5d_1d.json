  "factor_name": "Five-Day Persistent Stress-Gated Residual Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "active5 * (-(rolling_sum_5(residual_return_1d)) / rolling_std_20(return_1d))",
    "description": "For each tradable asset, calculate five-day cumulative return relative to the cross-asset equal-weight mean, reverse it and scale by lagged 20-day volatility. Apply the signal only when lagged five-day breadth is below 50% and lagged VIX exceeds its lagged 252-day 60th percentile; persist activation for five trading days. All inputs are shifted to prevent look-ahead."
