{
  "factor_id": "miner_2_20261022_consistency_gated_risk_adjusted_momentum_30d",
  "factor_name": "30D Directional-Consistency-Gated Risk-Adjusted Momentum",
  "version": "1.0",
  "calculation": {
    "expression": "rank_cs((sum(return,30))/(std(return,30)*sqrt(30)+0.005) * mean(return>0,30)), lagged by 1 session",
    "description": "Cross-sectional percentile rank of 30-session cumulative return divided by annualization-free 30-session daily volatility and a stabilizing constant, multiplied by the fraction of positive daily returns. The signal is lagged one completed session to avoid look-ahead."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "lookback_sessions": 30,
    "minimum_observations": 20,
    "volatility_floor": 0.005,
    "consistency_definition": "fraction of positive daily returns",
    "signal_lag_sessions": 1,
    "forward_horizon_sessions": 10
  },
