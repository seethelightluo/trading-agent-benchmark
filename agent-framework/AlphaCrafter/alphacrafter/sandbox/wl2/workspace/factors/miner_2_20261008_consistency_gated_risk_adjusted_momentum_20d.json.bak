  "factor_name": "Directional-Consistency-Gated Risk-Adjusted Momentum 20D",
  "version": "1.0",
  "calculation": {
    "expression": "lag1(rank_cs((sum_return_20 / (std_daily_20 * sqrt(20) + 0.005)) * mean(I(return_daily > 0),20)))",
    "description": "Cross-sectional rank of 20-session risk-adjusted momentum multiplied by the fraction of positive daily returns in the same window; lagged one completed session to avoid look-ahead."
  },
