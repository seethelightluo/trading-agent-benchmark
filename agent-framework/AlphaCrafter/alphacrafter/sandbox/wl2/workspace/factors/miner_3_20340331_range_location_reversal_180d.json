{
  "factor_id": "miner_3_20340331_range_location_reversal_180d",
  "factor_name": "180-day range-location reversal with volatility tilt",
  "version": "1.0",
  "calculation": {
    "expression": "shift(1, (1 - (close - rolling_min(close,180))/(rolling_max(close,180)-rolling_min(close,180))) * rank_cs(rolling_std(log_return,20)))",
    "description": "Ranks assets favorably when they sit near the bottom of their trailing 180-session price range, tilted toward the higher-ranked short-term volatility state. The complete signal is lagged one session before use."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "range_window": 180,
    "volatility_window": 20,
    "forward_validation_horizon": 40,
    "minimum_cross_section": 8,
    "lag_sessions": 1
  },
