{
  "factor_id": "miner_2_20310807_conditional_dispersion_range_reversal_5d",
  "factor_name": "Elevated-dispersion conditional five-day range reversal",
  "version": "1.0",
  "calculation": {
    "expression": "(0.5 - (close - rolling_min(close,5)) / (rolling_max(close,5)-rolling_min(close,5))) * I(cross_asset_dispersion > rolling_median(cross_asset_dispersion,252))",
    "description": "Cross-sectional five-day range-location reversal is activated only when mean absolute demeaned daily return dispersion across the 15 tradable benchmark assets exceeds its trailing 252-session median. Inactive signals are zero."
  },
  "dependencies": ["close", "daily_returns", "watch_list"],
  "parameters": {"range_window": 5, "dispersion_window": 252, "dispersion_definition": "mean absolute demeaned return across available tradable assets", "activation": "dispersion greater than trailing median", "min_cross_section": 8},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-02 through 2031-08-06",
    "metrics": {
      "daily_ic": 0.041829,
      "daily_icir": 0.131618,
      "ic_hit_ratio": 0.5350,
      "ic_dates": 1787,
      "average_instruments": 13.295,
      "universe_size": 15,
      "coverage": 0.9452,
      "turnover": 0.1639,
      "active_fraction": 0.4821,
      "max_abs_library_correlation": null
    },
    "regime_notes": "2020-2022 IC 0.051519 / ICIR 0.161948; 2023-2025 IC 0.044167 / ICIR 0.141241; 2026-2031 IC 0.034560 / ICIR 0.107584. Predictive strength weakened but remained above both admission thresholds in the latest regime.",
    "signal_artifact": "scripts/miner_2_20310807_conditional_dispersion_range_signal.csv"
  },
