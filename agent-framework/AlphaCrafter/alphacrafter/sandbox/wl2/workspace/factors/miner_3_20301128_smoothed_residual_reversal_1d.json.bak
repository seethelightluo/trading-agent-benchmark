{
  "factor_id": "miner_3_20301128_smoothed_residual_reversal_1d",
  "factor_name": "Three-day smoothed volatility-scaled cross-sectional residual reversal",
  "version": "1.0",
  "calculation": {
    "expression": "mean_{j=0..2}[-(r_t-j - median_cross_section(r_t-j)) / rolling_std(r,20)_t-j]",
    "description": "For each tradable benchmark, compute the negative one-day return residual relative to the cross-sectional median, divide by its trailing 20-session volatility, and average the current and prior two valid shocks. Positive values identify recent underperformers expected to mean-revert over the next session. The signal is strictly lagged and uses no future data.",
    "signal_artifact": "scripts/miner_3_20301128_smoothed_residual_reversal_signal.csv"
  },
  "dependencies": ["close", "daily_returns"],
  "parameters": {
    "volatility_window": 20,
    "volatility_min_periods": 15,
    "smoothing_window": 3,
    "smoothing_min_periods": 2,
    "minimum_cross_section": 8,
    "forward_horizon_sessions": 1
  },
