{
  "factor_id": "miner_2_20330527_vix_conditioned_residual_reversal_1d",
  "factor_name": "VIX-Stress Conditioned Residual Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "active * (-(ret_5d - cross_sectional_median(ret_5d)) / realized_vol_20d_lagged)",
    "description": "On dates when lagged VIX is above its trailing 60-session median and rising versus the prior session, rank assets by the negative five-session return residual relative to the cross-sectional median, scaled by lagged 20-session return volatility. Otherwise emit no signal. All inputs are available through the completed decision-day close."
  },
  "dependencies": ["close", "VIX close"],
  "parameters": {"return_lookback_days": 5, "volatility_lookback_days": 20, "vix_median_window": 60, "vix_rising_lag": 1, "forward_horizon_days": 1},
  "validation": {
