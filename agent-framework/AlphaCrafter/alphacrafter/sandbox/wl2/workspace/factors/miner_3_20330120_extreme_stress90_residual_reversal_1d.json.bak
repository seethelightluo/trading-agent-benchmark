{
  "factor_id": "miner_3_20330120_extreme_stress90_residual_reversal_1d",
  "factor_name": "Extreme VIX-and-breadth stress 90th-percentile residual reversal",
  "version": "1.0",
  "calculation": {
    "expression": "gate * (-rolling_sum(cross_sectional_residual_return, 5) / rolling_std(asset_return, 20))",
    "description": "Lagged five-day reversal of each asset's daily return relative to the cross-sectional mean, volatility normalized. Active only when lagged VIX exceeds its trailing 252-day 90th percentile and at least 80% of tradable assets had negative returns. All inputs are shifted one day before signal formation."
  },
  "dependencies": [
    "close",
    "VIX"
  ],
  "parameters": {
    "reversal_window": 5,
    "volatility_window": 20,
    "vix_quantile_window": 252,
    "vix_quantile": 0.9,
    "breadth_threshold": 0.8,
    "forward_horizon_days": 1,
    "minimum_cross_section": 8
  },
