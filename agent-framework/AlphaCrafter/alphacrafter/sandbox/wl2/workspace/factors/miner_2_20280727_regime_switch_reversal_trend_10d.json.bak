{
  "factor_id": "miner_2_20280727_regime_switch_reversal_trend_10d",
  "factor_name": "Stress-Conditioned Reversal/Trend Switch",
  "version": "1.0",
  "calculation": {
    "expression": "where(VIX > rolling_median(VIX,60) and VIX_5d_change > 0, -sum(return,5), sum(log(1+return),20)) / (std(return,20)*sqrt(20)), lagged 1 day",
    "description": "Uses short-term reversal during rising elevated volatility and medium-term trend otherwise, volatility-normalized and lagged to prevent look-ahead. Signal applies to all 15 tradable benchmark instruments; VIX is observation-only macro input."
  },
  "dependencies": [
    "close",
    "pct_change",
    "VIX macro series"
  ],
  "parameters": {
    "stress_vix_window": 60,
    "stress_vix_change_window": 5,
    "reversal_window": 5,
    "trend_window": 20,
    "volatility_window": 20,
    "lag": 1,
    "forward_horizon": 10
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2028-07-26",
    "metrics": {
