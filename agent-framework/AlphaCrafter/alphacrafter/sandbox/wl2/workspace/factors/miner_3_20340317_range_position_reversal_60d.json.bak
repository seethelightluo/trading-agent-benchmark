{
  "factor_id": "miner_3_20340317_range_position_reversal_60d",
  "factor_name": "60-day range-position reversal with volatility-state tilt",
  "version": "1.0",
  "calculation": {
    "expression": "-rank_pct((close-rolling_min(close,60))/(rolling_max(close,60)-rolling_min(close,60)))*rank_pct(rolling_std(log_return,20)/rolling_std(log_return,60)), shifted by one session",
    "description": "Cross-sectionally favors assets near the lower end of their trailing 60-day price range, amplified when short-term volatility is high relative to its 60-day baseline. The complete signal is lagged one trading session."
  },
  "dependencies": ["close"],
  "parameters": {"range_window": 60, "short_vol_window": 20, "long_vol_window": 60, "forward_horizon": 40, "lag": 1, "min_cross_section": 8},
