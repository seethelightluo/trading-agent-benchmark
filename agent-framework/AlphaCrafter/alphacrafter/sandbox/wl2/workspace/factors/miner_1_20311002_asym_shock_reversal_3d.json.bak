{
  "factor_id": "miner_1_20311002_asym_shock_reversal_3d",
  "factor_name": "Elevated-dispersion asymmetric downside shock reversal",
  "version": "1.0",
  "calculation": {
    "expression": "I(dispersion >= rolling_quantile_252(dispersion,0.60)) * max(0,-rolling_sum_3(residual_return)) / rolling_std_20(return)",
    "description": "During elevated cross-asset dispersion, rank assets by volatility-normalized reversal of negative three-day residual shocks; positive shocks receive zero signal. Residual return is asset return minus the contemporaneous cross-sectional median. Cross-sectional median centering is applied after activation."
  },
  "dependencies": ["close", "daily_return"],
  "parameters": {"shock_window_days": 3, "volatility_window_days": 20, "dispersion_window_days": 252, "activation_quantile": 0.60, "minimum_valid_instruments": 8},
