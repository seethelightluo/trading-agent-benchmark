{
  "factor_id": "miner_2_20290823_highdisp_binary_beta_residual_reversal_3d",
  "factor_name": "High-dispersion binary beta-neutral residual reversal",
  "version": "1.0",
  "calculation": {
    "expression": "if(asset_return_dispersion >= rolling_quantile(asset_dispersion,120,0.65), -sum_3d(asset_return - beta_60d * cross_asset_mean_return)/vol_60d, 0)",
    "description": "During unusually high cross-asset daily dispersion, rank assets by the negative three-day beta-neutral residual return, scaled by asset 60-day volatility. In quiet regimes the signal is zero. Every input is lagged through the last completed session."
  },
  "dependencies": [
    "close",
    "daily_returns"
  ],
  "parameters": {
    "beta_window": 60,
    "residual_horizon": 3,
    "volatility_window": 60,
    "dispersion_quantile_window": 120,
    "dispersion_quantile": 0.65,
    "minimum_cross_section": 8,
    "lag_days": 1
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2024-11-20 through 2029-08-22",
