{
  "factor_id": "miner_3_20281116_smooth_risk_trend_10d",
  "factor_name": "Volatility-Shock-Moderated Risk-Adjusted Trend",
  "version": "1.0",
  "calculation": {
    "expression": "shift1(center20(log(close_t/close_t-20)/(sqrt(20)*std(log_returns_20)) /(1 + 0.6*(sqrt(5)*std(log_returns_5))/(sqrt(60/3)*std(log_returns_60)))), 1)",
    "description": "Twenty-day momentum divided by 20-day annualized-style volatility, further moderated when five-day volatility is elevated relative to 60-day volatility; cross-sectional median centered and lagged one completed trading day."
  },
  "dependencies": ["close"],
  "parameters": {"momentum_window": 20, "short_vol_window": 5, "trend_vol_window": 20, "long_vol_window": 60, "min_periods_short": 4, "min_periods_trend": 15, "min_periods_long": 40, "shock_coefficient": 0.6, "forward_horizon_days": 10, "lag_days": 1, "minimum_cross_section": 8},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2028-11-16",
    "validated_at": "2028-11-16",
