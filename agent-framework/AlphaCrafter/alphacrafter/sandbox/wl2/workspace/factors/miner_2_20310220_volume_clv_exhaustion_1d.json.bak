{
  "factor_id": "miner_2_20310220_volume_clv_exhaustion_1d",
  "factor_name": "Volume-confirmed CLV residual exhaustion reversal",
  "version": "1.1",
  "calculation": {
    "expression": "-residual_return_3d / rolling_std_return_30d * (1 + 0.5*cross_sectional_rank(volume/median_volume_30d)) * (1 + 0.35*abs(close_location_value))",
    "description": "Ranks three-day returns relative to the cross-sectional median, reverses the move, volatility-scales it, and amplifies moves accompanied by abnormal volume and candle-location extremity. Uses only completed OHLCV data."
  },
  "dependencies": ["close", "high", "low", "volume"],
  "parameters": {
    "residual_window_days": 3,
    "volatility_window_days": 30,
    "volume_baseline_days": 30,
    "volume_rank_multiplier": 0.5,
    "clv_multiplier": 0.35,
    "forward_horizon_days": 1
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01/2031-03-06",
    "validation_timestamp": "2031-03-06T00:00:00Z",
    "metrics": {
