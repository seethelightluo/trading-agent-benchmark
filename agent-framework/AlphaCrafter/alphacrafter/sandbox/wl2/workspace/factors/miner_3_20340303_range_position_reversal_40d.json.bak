{
  "factor_id": "miner_3_20340303_range_position_reversal_40d",
  "factor_name": "Broad-range position reversal with volatility-state tilt",
  "version": "1.0",
  "calculation": {
    "expression": "-CS_rank((close - rolling_min(close,120)) / (rolling_max(close,120)-rolling_min(close,120))) * CS_rank(rolling_std(log_return,20) / rolling_std(log_return,120)), lagged 1 session",
    "description": "Ranks assets toward the lower end of their 120-session price range and tilts toward assets whose short-run volatility is elevated relative to their 120-session volatility. The signal is lagged one session and is intended as a medium-horizon cross-sectional reversal factor."
  },
  "dependencies": ["close", "log_return"],
  "parameters": {"range_window": 120, "short_vol_window": 20, "long_vol_window": 120, "lag": 1, "min_cross_section": 8, "horizons_tested": [10,20,40]},
