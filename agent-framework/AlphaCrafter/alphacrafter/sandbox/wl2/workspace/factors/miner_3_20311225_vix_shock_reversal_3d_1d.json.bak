{
  "factor_id": "miner_3_20311225_vix_shock_reversal_3d_1d",
  "factor_name": "VIX-shock broad-weakness 3-day risk-adjusted reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(rolling_sum(return,3) / rolling_std(return,20)) when VIX_return_5d > 0.04 and fraction(10d_returns < 0) >= 0.60, otherwise NaN",
    "description": "Fades recent three-day risk-adjusted losses during an observation-only VIX shock and broad cross-asset weakness. The signal is cross-sectional and long-only compatible; inactive assets/dates receive no signal."
  },
  "dependencies": [
    "close",
    "VIX.close",
    "returns"
  ],
  "parameters": {
    "short_return_window": 3,
    "volatility_window": 20,
    "vix_change_window": 5,
    "vix_shock_threshold": 0.04,
    "breadth_window": 10,
    "negative_breadth_threshold": 0.6,
    "forward_horizon_days": 1,
    "minimum_cross_section": 8
  },
