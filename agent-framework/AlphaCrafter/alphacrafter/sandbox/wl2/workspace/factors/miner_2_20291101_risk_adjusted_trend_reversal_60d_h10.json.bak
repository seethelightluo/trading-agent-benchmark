{
  "factor_id": "miner_2_20291101_risk_adjusted_trend_reversal_60d_h10",
  "factor_name": "Risk-adjusted trend reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-((close/close.shift(60)-1)/(sqrt(60)*rolling_std(pct_change,60)+1e-8))*rolling_mean(I[pct_change>0],60), lagged one day",
    "description": "Contrarian cross-sectional score: negate 60-day return scaled by realized 60-day volatility and by the fraction of positive daily returns (breadth). The one-day lag ensures only completed data are used."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "lookback_days": 60,
    "forward_horizon_days": 10,
    "breadth_window_days": 60,
    "signal_lag_days": 1,
    "epsilon": 1e-08
  },
