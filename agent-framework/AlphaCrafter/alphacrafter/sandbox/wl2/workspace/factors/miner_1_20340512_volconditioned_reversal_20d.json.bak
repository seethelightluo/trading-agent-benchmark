{
  "factor_id": "miner_1_20340512_volconditioned_reversal_20d",
  "factor_name": "Volatility-Conditioned Risk-Adjusted Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "(-log(close/close[-20]) / rolling_std(log_returns,20)) * (1 - percentile_rank(rolling_std(log_returns,20),120)); lag(1)",
    "description": "Ranks prior 20-session risk-adjusted losses positively for reversal, with greater weight when current volatility is low relative to the instrument's own 120-session volatility history. The signal is lagged one completed session."
  },
  "dependencies": ["close"],
  "parameters": {"return_window": 20, "volatility_window": 20, "volatility_rank_window": 120, "lag": 1, "forward_horizon": 20, "min_cross_section": 8},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2026-07-16 to 2034-05-11",
    "validated_on": "2034-05-12",
    "metrics": {
      "ic": 0.0757052115,
      "icir": 0.2429773072,
      "forward_horizon_days": 20,
      "observations": 1944,
      "average_instruments": 15.0,
      "universe_size": 15,
      "coverage": 1.0,
      "turnover": 0.0716595114,
      "hit_ratio": 0.6085390947,
      "decay_ic_10d": 0.0317573504,
      "decay_ic_40d": 0.0852860877,
      "max_abs_library_correlation": null
    },
    "regime_notes": "Positive and stable across early (ICIR 0.2068), middle (0.2458), and recent (0.2738) periods; small 15-instrument universe warrants conservative interpretation.",
    "signal_artifact": "scripts/miner_1_20340512_volconditioned_reversal_signal.csv",
