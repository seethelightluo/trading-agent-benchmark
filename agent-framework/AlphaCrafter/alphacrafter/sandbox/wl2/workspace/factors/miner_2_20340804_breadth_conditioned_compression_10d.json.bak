{
  "factor_id": "miner_2_20340804_breadth_conditioned_compression_10d",
  "factor_name": "Breadth-Conditioned Volatility Compression",
  "version": "1.0",
  "calculation": {
    "expression": "-(std(log_return,10)/std(log_return,60)) * sign(rolling_mean(20, cross_sectional_positive_return_breadth)-0.5), lagged one session",
    "description": "Ranks assets with lower recent volatility relative to long volatility more highly when lagged 20-session cross-asset breadth is at least neutral; reverses the compression score when breadth is weak, providing a defensive conditional response. All inputs are shifted to prevent look-ahead."
  },
  "dependencies": ["close"],
  "parameters": {"short_vol_window": 10, "long_vol_window": 60, "breadth_window": 20, "horizon_sessions": 10, "min_cross_section": 8, "lag_sessions": 1},
