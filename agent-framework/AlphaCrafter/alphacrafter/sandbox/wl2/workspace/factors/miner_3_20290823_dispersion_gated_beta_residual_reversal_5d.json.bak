  "factor_name": "Dispersion-gated beta-neutral residual reversal (5-day)",
  "version": "1.0",
  "calculation": {
    "expression": "-sum_5d(asset_return - beta_60d(asset_return, equal_weight_cross_asset_return)*equal_weight_cross_asset_return) / stdev_60d(asset_return) * clip(cross_sectional_dispersion / mean_20d_dispersion, 0, 2)",
    "description": "Reverse the recent five-day beta-neutral residual return, volatility scale it, and gate signal magnitude by current cross-asset return dispersion relative to its 20-day mean. All inputs are lagged through the decision date."
  },
  "dependencies": ["close", "daily_returns"],
  "parameters": {"beta_window": 60, "residual_window": 5, "volatility_window": 60, "dispersion_window": 20, "minimum_cross_section": 8, "dispersion_clip": [0, 2]},
