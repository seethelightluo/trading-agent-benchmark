{
  "factor_id": "miner_1_20341110_stress_dxy_reversal_20d",
  "factor_name": "VIX-high and DXY-rising volatility-normalized reversal",
  "version": "1.1",
  "calculation": {
    "expression": "active * -(log(close[t-1]) - log(close[t-21])) / (std(log_returns[t-20:t-1]) * sqrt(252))",
    "description": "Lagged cross-asset reversal activated when lagged VIX exceeds its trailing 252-trading-day median and lagged DXY 20-day return is positive; higher values predict stronger forward 20-day returns."
  },
  "dependencies": ["close", "VIX", "DXY"],
  "parameters": {"lookback_reversal_days": 20, "volatility_days": 20, "regime_median_days": 252, "dxy_trend_days": 20, "forward_horizon_days": 20, "minimum_cross_section": 8},
