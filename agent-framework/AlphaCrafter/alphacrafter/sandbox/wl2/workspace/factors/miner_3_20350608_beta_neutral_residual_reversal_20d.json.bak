{
  "factor_id": "miner_3_20350608_beta_neutral_residual_reversal_20d",
  "factor_name": "20-Day Beta-Neutral Residual Reversal, Volatility Scaled",
  "version": "1.0",
  "calculation": {
    "expression": "-((close_t/close_{t-20}-1) - beta_120(asset, equal_weight_benchmark) * sum_{k=1..20}(benchmark_return_{t-k})) / std(asset_return, 40), lagged 1 trading day",
    "description": "Ranks assets that underperformed their 20-day beta-implied benchmark move, with residual reversal scaled by trailing 40-day volatility. All inputs are lagged or based on completed observations to avoid look-ahead."
  },
  "dependencies": ["close", "daily_returns"],
  "parameters": {"residual_return_window": 20, "beta_window": 120, "beta_min_periods": 80, "benchmark": "equal_weight_mean_of_15_tradable_assets", "volatility_window": 40, "signal_lag": 1},
