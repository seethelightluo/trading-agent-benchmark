{
  "factor_id": "miner_3_20340106_range_efficiency_reversal_20d",
  "factor_name": "20-day Range-Efficiency Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-rank((sum(log_return,20)) / (sum(abs(log_return),20))) shifted by 1 session",
    "description": "Ranks the negative 20-day directional efficiency (net displacement divided by total absolute path). Higher values favor assets with choppy or inefficient recent paths, implementing a cross-sectional reversal signal while avoiding look-ahead."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
