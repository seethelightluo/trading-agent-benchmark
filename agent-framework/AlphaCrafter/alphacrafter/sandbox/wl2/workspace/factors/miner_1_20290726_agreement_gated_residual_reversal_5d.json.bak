{
  "factor_id": "miner_1_20290726_agreement_gated_residual_reversal_5d",
  "factor_name": "Trend-Agreement Gated Cross-Asset Residual Reversal",
  "version": "1.1",
  "calculation": {
    "expression": "-sum_5d(asset_return - beta_40d*cross_asset_median_return) / (volatility_40d*sqrt(5)), applied only when sign(asset_20d_return) == sign(equal_weight_cross_asset_20d_return)",
    "description": "Risk-scaled five-day reversal of each instrument's market-beta residual, gated to periods where the instrument and equal-weight cross-asset benchmark share the same 20-day trend direction. All inputs are lagged to the completed day before the forward return."
  },
  "dependencies": [
    "close",
    "daily_returns"
  ],
  "parameters": {
    "beta_window_days": 40,
    "reversal_window_days": 5,
    "volatility_window_days": 40,
    "trend_window_days": 20,
    "minimum_cross_section": 8
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2029-08-08",
    "metrics": {
      "daily_ic": 0.10157,
