{
  "factor_id": "miner_2_20340818_continuous_breadth_conditioned_compression_10d",
  "factor_name": "Continuous Breadth-Conditioned Volatility Compression",
  "version": "1.0",
  "calculation": {
    "expression": "lag1(-(std(log_return,10)/std(log_return,60)) * lag1(2*cross_sectional_mean(I[sum(log_return,20)>0])-1))",
    "description": "For each tradable asset, negative short-term volatility relative to long-term volatility is multiplied by the lagged continuous breadth intensity. Positive breadth favors compressed assets; negative breadth reverses the signal toward defensive assets. The final signal is lagged one completed session.",
    "signal_artifact": "scripts/miner_2_20340818_continuous_breadth_compression_signal.csv"
  },
  "dependencies": ["close"],
  "parameters": {"short_vol_window": 10, "long_vol_window": 60, "breadth_window": 20, "forward_horizon": 10, "signal_lag": 1, "min_cross_section": 8},
