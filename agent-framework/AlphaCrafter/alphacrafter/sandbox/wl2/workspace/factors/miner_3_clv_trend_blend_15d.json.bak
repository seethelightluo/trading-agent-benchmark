{
  "factor_id": "miner_3_clv_trend_blend_15d",
  "factor_name": "Close-Location Reversal with 20-Day Trend Blend (15% Trend)",
  "version": "20260730",
  "calculation": {
    "expression": "rank_cs(shift1(-(2*(close-low)/(high-low)))) + 0.15*rank_cs(shift1(close/close[-20]-1))",
    "description": "Ranks assets closing nearer the low of the completed daily range, with a modest positive 20-trading-day momentum overlay. The signal is lagged one completed observation before ranking against next-day cross-asset returns.",
    "forward_horizon": "1 trading day"
  },
  "dependencies": [
    "high",
    "low",
    "close"
  ],
  "parameters": {
    "trend_window": 20,
    "trend_weight": 0.15,
    "cross_section_rank": "percentile",
    "lag": 1,
    "min_cross_section": 8
  },
