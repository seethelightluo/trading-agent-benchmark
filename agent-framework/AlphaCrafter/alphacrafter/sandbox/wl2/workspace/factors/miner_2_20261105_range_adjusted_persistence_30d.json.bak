{
  "factor_id": "miner_2_20261105_range_adjusted_persistence_30d",
  "factor_name": "30D Range-Adjusted Persistence Momentum",
  "version": "1.0",
  "calculation": {
    "expression": "(sum_{t=1..30}(close_t/close_{t-1}-1) / (0.05 + sum_{t=1..30}((high_t-low_t)/close_{t-1}))) * (positive_return_fraction_30d ^ 1.5)",
    "description": "Ranks assets by 30-session cumulative momentum normalized by aggregate intraday range, with a nonlinear gate favoring persistent positive daily returns. Signal is computed using data through the prior completed session and lagged one session before forward-return evaluation."
  },
  "dependencies": [
    "close",
    "high",
    "low"
  ],
  "parameters": {
    "lookback_sessions": 30,
    "positive_fraction_exponent": 1.5,
    "stabilizer": 0.05,
    "forward_horizon_sessions": 10,
    "minimum_cross_section": 8,
    "tradable_universe_size": 15
  },
  "validation": {
