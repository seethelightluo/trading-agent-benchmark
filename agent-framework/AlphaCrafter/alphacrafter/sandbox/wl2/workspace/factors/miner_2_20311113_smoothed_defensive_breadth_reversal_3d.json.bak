{
  "factor_id": "miner_2_20311113_smoothed_defensive_breadth_reversal_3d",
  "factor_name": "Smoothed defensive-lead intensity weighted 3-day volatility-normalized reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(sum(return,3)/std(return,20)) * clip(max(defensive_10d_mean - risk_10d_mean,0)/0.01,0,1) * sqrt(max(1 - rolling_mean_20(risk_positive_breadth_10d),0))",
    "description": "Ranks short-term reversal after volatility normalization, activated continuously by defensive leadership and a 20-day smoothed weakness in risk-asset breadth. Defensive assets are XAU, US10Y, CN10Y; risk assets are the other 11 non-defensive tradables."
  },
  "dependencies": ["close"],
  "parameters": {"reversal_window": 3, "volatility_window": 20, "lead_window": 10, "breadth_window": 10, "breadth_smoothing_window": 20, "lead_scale": 0.01, "min_cross_section": 8},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 to 2031-11-13",
    "last_validated": "2031-11-13T00:00:00Z",
    "metrics": {
      "daily_paper_ic": 0.039306,
      "daily_paper_icir": 0.117730,
