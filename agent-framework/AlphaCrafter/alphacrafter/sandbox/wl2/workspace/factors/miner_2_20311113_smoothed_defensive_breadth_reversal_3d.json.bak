      "validation_dates": 1582,
      "average_instruments": 12.973,
      "coverage": 0.8531,
      "nonzero_signal_date_fraction": 0.4452,
      "turnover": null,
      "max_abs_library_correlation": null,
      "decay_ic_1d": 0.039306,
      "decay_ic_3d": 0.041661,
      "decay_ic_5d": 0.041265,
      "decay_ic_10d": 0.026024
    },
    "regime_notes": "Positive across all periods; ICIR 0.147185 in 2020-2022, 0.156876 in 2023-2025, and 0.074180 in 2026-2031. Recent stability is below the admission ICIR gate and requires monitoring.",
    "signal_artifact": "scripts/miner_2_20311113_smoothed_defensive_breadth_reversal_signal.csv"
  },
