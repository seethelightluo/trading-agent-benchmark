{
  "factor_id": "miner_1_20340609_drawdown_vol_persistence_reversal_90d",
  "factor_name": "90-day drawdown reversal with volatility-persistence rank",
  "version": "1.0",
  "calculation": {
    "expression": "(1 - (close - rolling_min(close,90)) / (rolling_max(close,90)-rolling_min(close,90))) * rank_pct(rolling_std(log_return,10) / rolling_std(log_return,60))",
    "description": "Ranks assets favoring deep 90-day drawdowns and elevated recent volatility relative to 60-day volatility. The complete signal is lagged one trading day to prevent look-ahead."
  },
  "dependencies": ["close"],
  "parameters": {"drawdown_window": 90, "recent_vol_window": 10, "baseline_vol_window": 60, "vol_ratio_clip": [0.25, 4.0], "signal_lag_days": 1, "forward_horizon_days": 10},
