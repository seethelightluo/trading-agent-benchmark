{
  "factor_id": "miner_2_20311127_ema_defensive_breadth_reversal_3d",
  "factor_name": "EMA defensive leadership and weak breadth 3-day reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(sum_return(close,3)/rolling_std(pct_change(close),20)) * clip(max(EMA10(defensive_return)-EMA10(risk_return),0)/0.008,0,1) * max(1-EMA20(positive_10d_risk_breadth),0)^0.75",
    "description": "Risk-normalized three-day reversal scaled by exponentially smoothed defensive leadership and a nonlinear measure of weak risk-asset breadth. Defensive assets are XAU, US10Y, CN10Y; risk assets are the remaining equity, commodity and crypto risk proxies listed in parameters. All inputs are lagged through the prior completed day during use."
  },
  "dependencies": ["close", "pct_change"],
  "parameters": {
    "reversal_days": 3,
    "volatility_window": 20,
    "lead_ema_span": 10,
    "breadth_return_window": 10,
    "breadth_ema_span": 20,
    "lead_scale": 0.008,
    "breadth_exponent": 0.75,
    "minimum_cross_section": 8,
    "defensive_assets": ["XAU", "US10Y", "CN10Y"],
    "risk_assets": ["SPX", "NDX", "SOX", "000300.SH", "SX5E", "HSI", "N225", "BTC", "ETH", "COPPER", "WTI"]
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2031-11-13",
    "metrics": {
      "daily_paper_ic": 0.031461,
      "daily_paper_icir": 0.093977,
      "ic_hit_ratio": 0.5361,
      "ic_dates": 1593,
      "average_instruments": 13.334,
      "factor_coverage": 0.8758,
      "active_signal_fraction": 0.4491,
      "decay_ic_1d": 0.031461,
      "decay_ic_3d": 0.039311,
      "decay_ic_5d": 0.0323,
      "decay_ic_10d": 0.022928,
      "max_abs_library_correlation": null
    },
    "regime_notes": "Positive full-period admission metrics across 1,593 dates, but predictive power weakened materially in 2026-2031 (IC 0.007780, ICIR 0.023654); use conservatively and monitor drift. Strongest decay range is 3-5 days.",
    "signal_artifact": "scripts/miner_2_20311127_ema_defensive_breadth_reversal_signal.csv"
  },
