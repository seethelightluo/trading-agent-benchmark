{
  "factor_id": "miner_1_20311113_vix_stress_reversal_5d_1d",
  "factor_name": "VIX-Stress Volatility-Normalized Five-Day Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(five_day_return / (rolling_std(daily_return,20)*sqrt(5))) when observation-only VIX > trailing 60-day VIX median and VIX > trailing 20-day VIX mean; otherwise NaN",
    "description": "Fades the latest five-day risk-adjusted move during elevated and persistently high implied-volatility stress. VIX is used only as an observation-only macro condition; all prices and signals are lagged to the prior completed trading day."
  },
  "dependencies": [
    "close",
    "daily_return",
    "VIX close"
  ],
  "parameters": {
    "return_window": 5,
    "volatility_window": 20,
    "vix_median_window": 60,
    "vix_mean_window": 20,
    "forward_horizon_days": 1,
    "minimum_cross_section": 8
  },
  "validation": {
