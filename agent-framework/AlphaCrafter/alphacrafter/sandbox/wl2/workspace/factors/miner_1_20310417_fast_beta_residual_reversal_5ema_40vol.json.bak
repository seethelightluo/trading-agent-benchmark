{
  "factor_id": "miner_1_20310417_fast_beta_residual_reversal_5ema_40vol",
  "factor_name": "Fast 5-day beta-neutral residual reversal with 40-day volatility scaling",
  "version": "1.0",
  "calculation": {
    "expression": "-EMA_5(r_i - beta_i_60 * median_cross_sectional(r)) / rolling_std_40(r_i)",
    "description": "For each tradable asset, remove its 60-day rolling beta exposure to the cross-sectional median return, smooth the residual return with a 5-day EMA, and negate it for short-horizon residual reversal. Scale by 40-day return volatility. Values are cross-sectionally ranked by downstream portfolio construction.",
