  "dependencies": ["close", "daily_returns"],
  "parameters": {"beta_window": 60, "ema_span": 5, "volatility_window": 40, "beta_min_periods": 40, "volatility_min_periods": 25, "universe_size": 15, "minimum_cross_section": 8},
