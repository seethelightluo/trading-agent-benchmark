{
  "factor_id": "miner_3_20331111_high_volatility_20d",
  "factor_name": "20-day volatility continuation",
  "version": "1.0",
  "calculation": {
    "expression": "rank_cs(rolling_std(log(close).diff(), 20)).shift(1)",
    "description": "Cross-sectional percentile rank of each tradable asset's 20-session log-return volatility, lagged one completed session. Higher values indicate higher recent volatility and receive larger forecast scores."
  },
  "dependencies": ["close"],
  "parameters": {"volatility_window": 20, "rank_method": "cross_sectional_percentile", "lag_sessions": 1, "minimum_cross_section": 8},
