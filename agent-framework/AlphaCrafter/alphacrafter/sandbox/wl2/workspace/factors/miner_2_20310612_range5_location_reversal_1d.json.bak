{
  "factor_id": "miner_2_20310612_range5_location_reversal_1d",
  "factor_name": "Five-day range location reversal",
  "version": "1.0",
  "calculation": {
    "expression": "0.5 - (close - rolling_min(close,5)) / (rolling_max(close,5) - rolling_min(close,5))",
    "description": "Cross-sectional reversal score: assets near the bottom of their recent five-day close range receive positive scores, while assets near the top receive negative scores. Ties are stabilized with a small denominator floor. Uses only completed daily closes."
  },
  "dependencies": ["close"],
  "parameters": {"window": 5, "horizon_days": 1, "denominator_floor": 1e-12},
  "validation": {
    "status": "EFFECTIVE",
    "timestamp": "2031-06-12",
    "period": "2020-01-01 to 2031-06-11",
    "universe": "15 tradable benchmark instruments",
