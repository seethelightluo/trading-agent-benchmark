  "factor_name": "Regime-Attenuated Volatility-Scaled Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "(-pct_change(close,1)/(0.001+std(pct_change(close,1),20))) * (1 - abs(pct_change(close,20))/(abs(pct_change(close,20))+0.05))",
    "description": "One-day reversal scaled by 20-day realized volatility, with reversal exposure attenuated when the asset has a strong 20-day directional trend. Signal is lagged by one completed trading day for use.",
