{
  "factor_id": "trend_agreement_20_60_10d",
  "factor_name": "Volatility-Scaled Trend Agreement (20/60-day)",
  "version": "1.0",
  "calculation": {
    "expression": "clip((m20 / rolling_std(return,20)) * (1.0 if sign(m20)==sign(m60) else 0.35), -20, 20), lagged 1 completed session",
    "description": "Ranks instruments by 20-session return normalized by 20-session volatility, retaining most signal strength when 20- and 60-session trends agree and attenuating it when they conflict. The one-session lag prevents look-ahead."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "short_window": 20,
    "confirmation_window": 60,
    "volatility_window": 20,
    "disagreement_multiplier": 0.35,
    "clip_lower": -20,
    "clip_upper": 20,
    "lag_sessions": 1,
    "admission_horizon_sessions": 10
  },
