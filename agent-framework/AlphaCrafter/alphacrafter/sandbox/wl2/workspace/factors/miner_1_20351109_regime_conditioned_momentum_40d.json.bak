{
  "factor_id": "miner_1_20351109_regime_conditioned_momentum_40d",
  "factor_name": "Observable regime-conditioned risk-adjusted 40-day momentum",
  "version": "1.0",
  "calculation": {
    "expression": "sign(rolling_mean_20(pct_change_1) cross_sectional_positive_breadth - 0.5) * pct_change(close,40) / (rolling_std(pct_change(close,1),20)*sqrt(252))",
    "description": "Risk-adjusted 40-session momentum, with direction aligned to the observable prior 20-session cross-sectional breadth: positive momentum in broad-positive regimes and inverse momentum in broad-negative regimes. Signal is lagged one completed session before forward-return evaluation."
  },
  "dependencies": ["close"],
  "parameters": {"momentum_window": 40, "volatility_window": 20, "breadth_window": 20, "breadth_threshold": 0.5, "annualization": 252, "signal_lag_sessions": 1, "forward_horizon_sessions": 10},
  "validation": {
    "status": "EFFECTIVE",
    "last_validated": "2035-11-09",
    "period": "2020-01-01 through 2035-10-15 available observations",
    "metrics": {
      "ic": 0.029521,
      "icir": 0.088214,
      "ic_hit_ratio": 0.5351,
      "ic_dates": 2396,
      "average_instruments": 12.99,
      "coverage": 0.8660,
      "turnover_proxy": 0.14508,
      "decay_ic_1d": 0.003825,
      "decay_ic_5d": 0.014388,
      "decay_ic_10d": 0.029356,
      "decay_ic_20d": 0.048837,
      "max_abs_library_correlation": null
    },
    "regime_notes": "Strong in 2025-2027 (IC 0.081839, ICIR 0.272378) and 2028-2031 (IC 0.064976, ICIR 0.201307), but negative in 2032-2035 (IC -0.027595, ICIR -0.078781); admission passes full-sample gates but recent drift warrants monitoring.",
    "signal_artifact": "../persistent/miner_1_20351109_regime_conditioned_momentum_signal.csv",
