  "factor_name": "Volatility-Normalized Five-Day Reversal",
  "version": "20281228",
  "calculation": {
    "expression": "-sum(pct_change(close), 5) / (std(pct_change(close), 20) + 1e-6)",
    "description": "Cross-asset short-horizon reversal scaled by trailing 20-day realized volatility; higher values indicate recent underperformance after risk adjustment and predict stronger next-day returns. Uses only completed bars."
