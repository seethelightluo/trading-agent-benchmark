{
  "factor_id": "miner_2_20340623_breadth_conditioned_momentum_reversal_60d",
  "factor_name": "Breadth-Conditioned 60-Day Momentum Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(close/close.shift(60)-1).shift(1) * (0.5 + cross_sectional_mean(indicator(pct_change(close,20).shift(1)>0)))",
    "description": "At each date, rank a lagged negative 60-session return (reversal signal) and amplify it modestly by the lagged fraction of tradable assets with positive 20-session returns. All inputs are lagged one completed session; breadth uses only the 15 tradable benchmark instruments. Higher values indicate stronger expected forward return."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "momentum_lookback": 60,
    "breadth_lookback": 20,
    "breadth_base": 0.5,
    "lag": 1,
    "forward_horizon": 60
  },
  "signal_artifact": "scripts/miner_2_20340623_breadth_conditioned_momentum_signal.csv",
  "validation": {
    "status": "EFFECTIVE",
