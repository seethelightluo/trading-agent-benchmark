{
  "factor_id": "stress_downside_shock_reversal_3d",
  "factor_name": "VIX-Stress Downside Shock Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "max(0, -sum(pct_change(close), 3) / (rolling_std(pct_change(close), 20) * sqrt(3))) * I(VIX > rolling_quantile(VIX, 252, 0.70))",
    "description": "During elevated VIX stress, rank assets higher when they have suffered a recent three-day downside shock, normalized by 20-day volatility. Upside shocks receive zero signal; the factor is intended as conditional cross-asset rebound exposure.",
    "signal_artifact": "scripts/miner_1_20310515_stress_downside_shock_signal.csv"
  },
  "dependencies": [
    "close",
    "VIX"
  ],
  "parameters": {
    "shock_lookback_days": 3,
    "volatility_lookback_days": 20,
    "stress_quantile_lookback_days": 252,
    "stress_quantile": 0.7,
    "annualization": "sqrt(3) denominator normalization only",
    "min_cross_section": 8
  },
  "validation": {
