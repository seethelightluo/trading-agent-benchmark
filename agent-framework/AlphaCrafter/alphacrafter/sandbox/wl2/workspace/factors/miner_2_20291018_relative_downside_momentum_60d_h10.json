  "factor_name": "Relative Downside-Adjusted Momentum (60d, 10d)",
  "version": "1.0",
  "calculation": {
    "expression": "-((asset_return_60d - cross_sectional_mean_return_60d) / downside_deviation_60d).shift(1)",
    "description": "Ranks assets positively when they have lagged relative momentum after downside-volatility normalization; the leading minus sign is selected from the validated inverse relationship observed in the full sample. Signal is lagged one completed day and predicts 10-trading-day forward return."
