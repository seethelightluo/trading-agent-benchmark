{
  "factor_id": "miner_3_20331209_compression_reversal_20d",
  "factor_name": "Volatility Compression with Medium-Term Reversal",
  "version": "1.1",
  "calculation": {
    "expression": "0.5 * rank(-(std(log_return,20)/std(log_return,60))) - 0.5 * rank(sum(log_return,60))",
    "description": "Ranks assets by relative volatility compression and subtracts their 60-session return rank; higher values favor compressed, lagging assets. The complete signal is shifted one session before use."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "short_vol_window": 20,
    "long_vol_window": 60,
    "reversal_window": 60,
    "rank_method": "cross_sectional_percentile",
    "signal_lag": 1,
    "validation_horizon_days": 20
  },
