{
  "factor_id": "miner_2_20310206_clv_extreme_residual_reversal_1d",
  "factor_name": "Candle-extreme amplified three-day residual reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-((sum_3d(asset_return)-sum_3d(cross_sectional_median_return))/rolling_std_30d(asset_return)) * (1 + 0.75*abs(((close-low)/(high-low))-0.5)/(clip((high-low)/close, upper=3)+epsilon))",
    "description": "Ranks assets for one-day mean reversion using three-day residual returns, volatility scaling, and amplification when the latest close is near a candle extreme. All inputs are lagged completed daily bars."
  },
  "dependencies": ["close", "high", "low"],
  "parameters": {"residual_window_days": 3, "volatility_window_days": 30, "clv_amplifier": 0.75, "minimum_cross_section": 8},
