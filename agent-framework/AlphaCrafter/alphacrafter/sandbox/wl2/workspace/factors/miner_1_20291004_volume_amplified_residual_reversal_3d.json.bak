{
  "factor_id": "miner_1_20291004_volume_amplified_residual_reversal_3d",
  "factor_name": "Volume-Amplified Beta-Residual Reversal (3d)",
  "version": "1.0",
  "calculation": {
    "expression": "-(sum_{k=0..2}(r_i[t-k]-beta_i,60*r_m[t-k]))/vol_i,60 * (1 + 0.35*clip(log(1+volume_i[t]/mean(volume_i[t-19:t])), -1, 1))",
    "description": "Three-day market-beta residual reversal, volatility normalized, with a capped contemporaneous activity multiplier. Cross-sectional factor values are computed using information available through the prior completed day. The market return is the equal-weight mean across the 15 tradable instruments."
  },
  "dependencies": ["close", "volume", "pct_change"],
  "parameters": {"beta_window": 60, "reversal_window": 3, "activity_window": 20, "activity_coefficient": 0.35, "min_cross_section": 8, "universe_size": 15},
