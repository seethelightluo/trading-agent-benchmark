{
  "factor_id": "miner_1_20320805_lagged_stress_residual_reversal_5d_1d",
  "factor_name": "Lagged high-stress residual reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(asset_return_5d - cross_sectional_median_return_5d) / (sqrt(5) * rolling_std_daily_return_30d), activated when lagged 5d mean breadth < 0.45 and lagged VIX exceeds its trailing 252d 70th percentile; cross-sectional demean",
    "description": "A volatility-scaled reversal signal that is evaluated only after a completed prior-day broad weakness and elevated-VIX stress state. The one-day forward test uses data available at the decision timestamp and avoids contemporaneous stress look-ahead."
  },
  "dependencies": ["close", "VIX observation-only macro series"],
  "parameters": {"shock_window_days": 5, "volatility_window_days": 30, "breadth_window_days": 5, "breadth_threshold": 0.45, "vix_quantile_window_days": 252, "vix_quantile": 0.70, "activation_lag_days": 1, "winsorization": "none", "cross_sectional_demean": true},
  "validation": {
