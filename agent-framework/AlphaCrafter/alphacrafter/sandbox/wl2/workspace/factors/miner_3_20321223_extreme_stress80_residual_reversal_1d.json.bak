{
  "factor_id": "miner_3_20321223_extreme_stress80_residual_reversal_1d",
  "factor_name": "Extreme VIX80 Broad-Stress Residual Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-rolling_sum(residual_return,5).shift(1) / rolling_std(asset_return,20).shift(1) * I(VIX.shift(1) > rolling_quantile(VIX,252,0.80) and downside_breadth.shift(1) >= 0.80)",
    "description": "Cross-sectional reversal of each asset's lagged five-day market-residual return, scaled by lagged 20-day volatility. The signal is active only when lagged VIX is above its trailing 252-day 80th percentile and at least 80% of tradable assets had negative returns on the prior day. All inputs are lagged before forward-return evaluation."
  },
  "dependencies": [
    "close",
    "VIX observation-only macro series"
  ],
  "parameters": {
    "residual_window_days": 5,
    "volatility_window_days": 20,
    "vix_quantile_window_days": 252,
    "vix_quantile": 0.8,
    "downside_breadth_threshold": 0.8,
    "forward_horizon_days": 1,
    "minimum_cross_section": 8
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2032-12-22",
