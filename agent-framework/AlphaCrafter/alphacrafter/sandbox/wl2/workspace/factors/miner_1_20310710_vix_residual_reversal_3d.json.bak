      "max_abs_library_correlation": null
    },
    "signal_artifact": "scripts/miner_1_20310710_vix_residual_reversal_3d_signal.csv",
    "regime_notes": "Elevated-VIX active observations; all 960 observations had 15 valid instruments. Sparse regime activation warrants conservative interpretation in the 15-asset universe."
