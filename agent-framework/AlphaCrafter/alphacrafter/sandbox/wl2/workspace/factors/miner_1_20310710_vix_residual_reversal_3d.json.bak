{
  "factor_id": "miner_1_20310710_vix_residual_reversal_3d",
  "factor_name": "VIX-stress beta-neutral residual reversal 3-day",
  "version": "1.0",
  "calculation": {
    "expression": "when VIX > rolling_quantile(VIX,252,0.70): -(rolling_sum(asset_return - cross_sectional_mean_return,3) / rolling_std(asset_return - cross_sectional_mean_return,20))",
    "description": "Within the 15-asset tradable benchmark universe, remove the contemporaneous cross-asset mean return, volatility-normalize each asset's three-session residual move, and fade the residual shock only during elevated VIX regimes. Signal is lagged one completed session for forward-return testing."
  },
  "dependencies": ["close", "VIX", "cross-sectional returns"],
  "parameters": {"reversal_window": 3, "volatility_window": 20, "vix_quantile_window": 252, "vix_quantile": 0.70, "minimum_cross_section": 8},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2031-07-10",
    "validation_timestamp": "2031-07-10",
    "metrics": {
      "daily_paper_ic": 0.0459959234,
      "daily_paper_icir": 0.1294632126,
      "ic_hit_ratio": 0.5458333333,
      "ic_dates": 960,
