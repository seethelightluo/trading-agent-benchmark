{
  "factor_id": "miner_1_20310123_adaptive_residual_reversal_1d",
  "factor_name": "Dispersion-adaptive idiosyncratic shock reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-((r_i - mean_cross_section(r)) / rolling_std(r_i,20)) * clip(cross_section_std(r) / rolling_median(cross_section_std(r),60), 0.5, 2.0)",
    "description": "For each tradable asset, reverse its one-day return residual versus the equal-weight cross-asset return, volatility-normalized over 20 days. Scale the signal by a bounded 60-day relative cross-sectional dispersion weight so differentiated shocks receive more emphasis without unbounded leverage. Uses only information available at the completed observation date."
  },
  "dependencies": ["close", "pct_change"],
  "parameters": {"residual_window": 1, "volatility_window": 20, "dispersion_baseline_window": 60, "dispersion_floor": 0.5, "dispersion_cap": 2.0, "minimum_cross_section": 8},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2030-12-31",
    "validation_timestamp": "2031-01-23",
    "metrics": {
      "daily_paper_ic": 0.0392689604,
      "daily_paper_icir": 0.0946945665,
      "ic_hit_ratio": 0.3588531,
      "dates": 3383,
      "average_instruments": 14.7641,
      "coverage": 0.9755979,
      "turnover": 0.3215031,
      "decay_ic_3d": -0.4473935,
      "decay_ic_5d": -0.3369568,
      "decay_ic_10d": -0.2407692,
      "regime_2020_2022_ic": 0.0505801,
      "regime_2020_2022_icir": 0.1262448,
      "regime_2023_2025_ic": 0.0362578,
      "regime_2023_2025_icir": 0.0850573,
      "regime_2026_2030_ic": 0.0070516,
      "regime_2026_2030_icir": 0.0170745,
