{
  "factor_id": "miner_1_20271118_vol_scaled_shock_rebound_3d",
  "factor_name": "Volatility-Scaled Shock Rebound with Positive-Trend Dampening",
  "version": "1.2",
  "calculation": {
    "expression": "(-rolling_sum(pct_change(close),3) / rolling_std(pct_change(close),20)) * (1 + 0.25 * max(rolling_sum(pct_change(close),20),0))",
    "description": "Ranks assets favoring a three-session selloff rebound opportunity, normalized by 20-session volatility; positive 20-session trends receive a modest boost. Inputs use only completed-session data."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "shock_window": 3,
    "vol_window": 20,
    "trend_window": 20,
    "positive_trend_boost": 0.25,
    "forward_horizon_sessions": 1
  },
