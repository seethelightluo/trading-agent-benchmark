{
  "factor_id": "downside_persistence_breadth_20d_10d",
  "factor_name": "Downside-risk-adjusted 20-day persistence with breadth gate",
  "version": "1.0",
  "calculation": {
    "expression": "shift1((sum(log_return,20) / rolling_std(max(-log_return,0),30)) * (0.6 + 0.8 * cross_sectional_mean(sum(log_return,20)>0))",
    "description": "Ranks medium-term trend persistence by return per downside semideviation, then scales all assets by the contemporaneous positive 20-day breadth. The complete signal is shifted one session so only completed bars are used."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "trend_window": 20,
    "downside_window": 30,
    "downside_min_periods": 20,
    "breadth_window": 20,
    "breadth_floor": 0.6,
    "breadth_scale": 0.8,
    "signal_lag": 1,
    "forward_horizon": 10,
    "min_cross_section": 8
  },
  "validation": {
