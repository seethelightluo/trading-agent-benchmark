{
  "factor_id": "miner_1_20290419_residual_trend_breadth_15d",
  "factor_name": "Breadth-attenuated market-residual trend",
  "version": "1.0",
  "calculation": {
    "expression": "residual_return_15d / residual_volatility_20d * (1 - 0.5*abs(2*mean_cross_asset_breadth_10d - 1))",
    "description": "For each tradable asset, regress the last 60 daily returns on the equal-weighted cross-asset daily return, sum the last 15 residual returns, scale by the last 20 residual-return standard deviation, and continuously attenuate exposure when 10-day breadth is one-sided. Signal uses data through the prior completed day."
  },
  "dependencies": ["close", "daily_returns"],
  "parameters": {"beta_window": 60, "trend_window": 15, "residual_vol_window": 20, "breadth_window": 10, "breadth_attenuation": 0.5, "lag_days": 1},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2021-12-09 through 2029-04-18",
    "metrics": {"horizon_days": 1, "ic": 0.0072292832, "icir": 0.3415913705, "valid_dates": 1628, "average_instruments": 15.0, "universe_size": 15, "coverage": 0.9728, "turnover": null, "max_abs_library_correlation": null},
    "regime_notes": "Full cross-asset history across multiple regimes; daily IC clears the benchmark gate narrowly and ICIR clears it. Five-day IC was not used for admission. Recent half-period behavior was not used to override the full-sample admission; monitor drift.",
    "signal_artifact": "scripts/miner_1_20290419_residual_trend_signal.csv"
  },
  "tags": ["trend", "market_residual", "breadth", "cross_asset", "risk_adjusted"],
  "last_validated": "2029-04-19T00:00:00"
}
