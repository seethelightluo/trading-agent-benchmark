{
  "factor_id": "miner_1_20350427_breadth_gated_risk_trend_20d",
  "factor_name": "Breadth-Gated Risk-Adjusted 20-Day Trend",
  "version": "1.0",
  "calculation": {
    "expression": "sum_20(ret_i).shift(1) / std_40(ret_i).shift(1) when cross_asset_breadth_20.shift(1) > 0.5, else 0",
    "description": "Scores each tradable asset by lagged 20-session return divided by lagged 40-session return volatility, activating only when more than half of the tradable universe had positive trailing 20-session returns. All inputs precede the forward-return horizon."
  },
  "dependencies": ["close", "returns", "cross_asset_breadth", "rolling_volatility"],
  "parameters": {
    "trend_lookback_sessions": 20,
    "risk_window_sessions": 40,
    "breadth_window_sessions": 20,
    "breadth_threshold": 0.5,
    "forward_admission_horizon_sessions": 20
  },
  "validation": {
