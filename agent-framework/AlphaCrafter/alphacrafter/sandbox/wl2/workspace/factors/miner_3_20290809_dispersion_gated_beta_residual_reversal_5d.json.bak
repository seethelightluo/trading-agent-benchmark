{
  "factor_id": "miner_3_20290809_dispersion_gated_beta_residual_reversal_5d",
  "factor_name": "Dispersion-gated beta-neutral residual reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-sum_{k=0..4}(r_i[t-k]-beta_i[t] * mean_cross_section(r[t-k])) / vol_i[t] * clip(cross_section_dispersion[t] / mean_dispersion_20d[t], 0, 2)",
    "description": "For each tradable asset, estimate a 60-day rolling beta to the equal-weight cross-asset daily return, compute the trailing 5-day beta-neutral residual return, reverse and scale it by asset volatility, then gate signal strength by contemporaneous cross-sectional dispersion relative to its 20-day mean. All inputs are lagged at the decision date and predict next-day cross-sectional returns."
  },
  "dependencies": ["close", "daily_returns"],
  "parameters": {"beta_window_days": 60, "residual_horizon_days": 5, "volatility_window_days": 60, "dispersion_window_days": 20, "dispersion_clip": [0, 2], "minimum_cross_section": 8, "universe_size": 15},
  "validation": {
    "status": "EFFECTIVE",
