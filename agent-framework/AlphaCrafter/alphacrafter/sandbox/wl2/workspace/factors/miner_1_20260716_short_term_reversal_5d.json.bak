{
  "factor_id": "short_term_reversal_5d",
  "factor_name": "Five-day Cross-Asset Short-Term Reversal",
  "version": "20260716",
  "calculation": {
    "expression": "-(close / close.shift(5) - 1)",
    "description": "Ranks recent five-trading-day losers above recent winners; intended to capture short-horizon mean reversion across the 15 tradable benchmark assets. Values are computed using completed bars only."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "lookback_days": 5,
    "forward_horizon_days": 1
  },
  "validation": {
    "period": "2020-01-01 through 2026-07-15",
