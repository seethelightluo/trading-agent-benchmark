{
  "factor_id": "miner_3_20340428_range_location_reversal_180d",
  "factor_name": "180-day range-location reversal with volatility tilt (revalidated)",
  "version": "1.1",
  "calculation": {
    "expression": "shift(1, (1-(close-rolling_min(close,180))/(rolling_max(close,180)-rolling_min(close,180))) * rank_cs(rolling_std(log_return,20)))",
    "description": "Favors assets near the bottom of their trailing 180-session range, tilted toward higher short-term volatility rank; lagged one completed session."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "range_window": 180,
    "volatility_window": 20,
    "forward_validation_horizon": 40,
    "minimum_cross_section": 8,
    "lag_sessions": 1
  },
