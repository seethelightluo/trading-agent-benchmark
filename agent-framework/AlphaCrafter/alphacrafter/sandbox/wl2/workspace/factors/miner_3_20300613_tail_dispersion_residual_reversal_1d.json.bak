{
  "factor_id": "miner_3_20300613_tail_dispersion_residual_reversal_1d",
  "factor_name": "High-Dispersion Three-Day Residual Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "I(dispersion_t > rolling_quantile(dispersion,120,0.75)) * (-rolling_sum(residual_return,3) / rolling_std(return,20))",
    "description": "Within the 15-asset cross-section, remove the daily cross-asset mean return from each asset, sum the residual return over three completed sessions, and reverse it after cross-asset return dispersion is in its trailing 120-day top quartile. Scale by 20-day realized volatility. Zero signal outside the dispersion regime. All inputs end at the decision bar."
  },
  "dependencies": ["close"],
  "parameters": {"reversal_window_days": 3, "volatility_window_days": 20, "dispersion_window_days": 120, "dispersion_quantile": 0.75, "minimum_dispersion_history": 60, "lag_days": 0},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2030-06-13",
    "validation_timestamp": "2030-06-13",
    "regime_notes": "Validated on all 15 tradable benchmark instruments with at least 8 valid instruments per daily cross-sectional observation. Strongest and most stable at the one-day horizon; five-day effect weakens in the most recent regime and ten-day effect fails, so use as a short-horizon component rather than a standalone medium-term forecast.",
