  "factor_name": "60th-percentile low-dispersion 60-day trend reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-pct_change(close,60)/rolling_std(pct_change(close,1),40) * I(cross_asset_mean(rolling_std(return,20)) < rolling_quantile(cross_asset_mean(rolling_std(return,20)),120,0.60)), shifted 1 day",
    "description": "Cross-sectional reversal of 60-day risk-scaled trend, active when mean 20-day volatility across the 15 tradable assets is below its trailing 120-day 60th percentile. All inputs are lagged by one completed trading day."
  },
  "dependencies": ["close"],
  "parameters": {"trend_window": 60, "volatility_window": 40, "dispersion_window": 20, "threshold_window": 120, "threshold_quantile": 0.60, "lag_days": 1, "forward_horizon_days": 40},
