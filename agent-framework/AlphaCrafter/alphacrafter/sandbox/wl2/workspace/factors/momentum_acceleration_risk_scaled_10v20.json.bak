{
  "factor_id": "momentum_acceleration_risk_scaled_10v20",
  "factor_name": "Risk-Scaled Momentum Acceleration",
  "version": "20280323.v1",
  "calculation": {
    "expression": "(sum_return(close,10) - 0.5*sum_return(close,20,lag=10)) / (std(return_1d,20) + 1e-6)",
    "description": "Measures recent 10-session cumulative return relative to half the preceding 20-session cumulative return, scaled by trailing 20-session daily volatility. Positive values indicate strengthening momentum; negative values indicate deceleration or deterioration. Cross-sectional IC uses the signal available at the close of the completed prior day.",
    "signal_lag": 1,
    "artifact_script": "scripts/miner_2_20280323_momentum_acceleration.py"
  },
  "dependencies": [
    "close",
    "pct_change",
    "trailing volatility"
  ],
  "parameters": {
    "recent_window": 10,
    "prior_window": 20,
    "prior_lag": 10,
    "volatility_window": 20,
    "winsorization_for_validation": [
      0.05,
      0.95
    ],
    "minimum_cross_section": 8
  },
