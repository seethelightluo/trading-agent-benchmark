{
  "factor_id": "miner_3_20351026_dispersion_gated_reversal_20d",
  "factor_name": "High-Dispersion Relative Downside Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "I[cross_sectional_std(ret20) > rolling_median_60(cross_sectional_std(ret20))] * -(ret20 - cross_sectional_median(ret20)) / rolling_downside_std_20(daily_returns)",
    "description": "At each date, activate a contrarian relative-return signal only when 20-day cross-asset dispersion exceeds its lagged 60-day median. Rank assets by negative 20-day return relative to the cross-sectional median, scaled by 20-day downside volatility. The signal is lagged one completed trading day before forward-return evaluation. Inactive dates are missing rather than assigned zero."
  },
  "dependencies": ["close"],
  "parameters": {"return_window": 20, "downside_vol_window": 20, "dispersion_window": 60, "dispersion_baseline": "rolling_median", "forward_horizon": 10, "signal_lag": 1, "minimum_cross_section": 8},
