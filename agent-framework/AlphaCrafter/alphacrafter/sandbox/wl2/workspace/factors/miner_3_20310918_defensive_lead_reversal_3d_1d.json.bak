{
  "factor_id": "miner_3_20310918_defensive_lead_reversal_3d_1d",
  "factor_name": "Defensive-lead 3-day relative reversal",
  "version": "1.0",
  "calculation": {
    "expression": "where(defensive_basket_return_3d > risk_basket_return_3d, (asset_return_3d - defensive_basket_return_3d) / rolling_downside_volatility_20d, NaN)",
    "description": "During defensive leadership, rank assets by their three-day return relative to the XAU/US10Y/CN10Y defensive basket, scaled by 20-day return volatility. The empirical signal is consumed contrarianly because its raw IC is negative."
  },
  "dependencies": ["close", "returns", "XAU", "US10Y", "CN10Y"],
  "parameters": {"lookback_days": 3, "volatility_window": 20, "defensive_assets": ["XAU", "US10Y", "CN10Y"], "direction": -1, "minimum_cross_section": 8},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01/2031-09-18",
