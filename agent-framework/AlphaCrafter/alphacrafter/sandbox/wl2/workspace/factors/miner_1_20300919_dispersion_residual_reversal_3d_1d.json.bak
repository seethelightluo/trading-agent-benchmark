{
  "factor_id": "miner_1_20300919_dispersion_residual_reversal_3d_1d",
  "factor_name": "Dispersion-gated volatility-scaled residual reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(rolling_sum(return,3)-cross_sectional_median(rolling_sum(return,3))) / rolling_std(return,20) * clip(cross_sectional_dispersion_3d / rolling_median(cross_sectional_dispersion_3d,20),0.5,2.0)",
    "description": "Ranks assets for next-day reversal relative to the cross-sectional three-day median, scales by inverse 20-day volatility, and emphasizes dates with elevated cross-sectional dispersion. All inputs are lagged to the decision date."
  },
  "dependencies": ["close", "daily_return"],
  "parameters": {"residual_lookback_days": 3, "volatility_lookback_days": 20, "dispersion_baseline_days": 20, "dispersion_floor": 0.5, "dispersion_cap": 2.0, "minimum_cross_section": 8},
  "validation": {
