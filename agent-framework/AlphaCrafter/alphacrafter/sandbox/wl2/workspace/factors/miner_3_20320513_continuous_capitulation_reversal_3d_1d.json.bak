{
  "factor_id": "miner_3_20320513_continuous_capitulation_reversal_3d_1d",
  "factor_name": "Continuous breadth-dispersion weighted capitulation reversal",
  "version": "1.1",
  "calculation": {
    "expression": "-(3d_return_i / rolling_std(daily_return_i,20)) * clip((negative_3d_breadth-0.5)/0.5,0,inf) * clip(cross_sectional_dispersion_3d / rolling_median(dispersion_3d,60),0,3)",
    "description": "Volatility-scaled three-day reversal, continuously weighted by broad negative three-day breadth and elevated cross-sectional dispersion. Inputs are lagged through the prior completed session; zero intensity outside broad downside conditions."
  },
  "dependencies": ["close", "daily_return"],
  "parameters": {
    "shock_window": 3,
    "vol_window": 20,
    "dispersion_median_window": 60,
    "breadth_midpoint": 0.5,
    "dispersion_weight_cap": 3.0,
    "minimum_cross_section": 8,
    "lag_days": 1
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2032-06-23",
    "metrics": {
      "daily_paper_ic": 0.049680,
      "daily_paper_icir": 0.152609,
      "ic_hit_ratio": 0.5451,
      "valid_ic_dates": 875,
      "average_valid_instruments": 14.299,
      "factor_coverage": 0.8907,
      "turnover": null,
      "max_abs_library_correlation": null,
      "decay_ic_1d": 0.049680,
      "decay_ic_3d": 0.047481,
      "decay_ic_5d": 0.041578,
      "decay_ic_10d": 0.014263
    },
    "regime_notes": "Positive and above admission gates in all usable reported regimes: 2020-2022 IC/ICIR +0.077932/+0.230886; 2023-2025 +0.039890/+0.122962; 2026-2029 +0.029467/+0.096545; 2030-2032 +0.068176/+0.197711. The 15-asset cross-section and unequal asset histories warrant conservative inference."
  },
  "tags": ["reversal", "capitulation", "breadth", "dispersion", "volatility_scaled", "cross_asset"],
