{
  "factor_id": "miner_1_20291213_volume_amplified_residual_reversal_5d",
  "factor_name": "Volume-Amplified Beta-Residual Reversal (5d)",
  "version": "1.0",
  "calculation": {
    "expression": "-(sum_{k=0..4}(r_i[t-k]-beta_i,60*r_m[t-k]))/sigma_i,60 * (1+0.35*clip(volume_i[t]/mean(volume_i[t-19:t])-1,-0.5,1))",
    "description": "Five-day market-beta residual reversal, normalized by 60-day volatility and amplified by unusual contemporaneous volume. The equal-weight mean return of the 15 tradable instruments is the market proxy; signal uses only data through the completed observation date."
  },
  "dependencies": [
    "close",
    "volume",
    "pct_change"
  ],
  "parameters": {
    "beta_window": 60,
    "reversal_window": 5,
    "activity_window": 20,
    "activity_coefficient": 0.35,
    "min_cross_section": 8,
    "universe_size": 15
  },
