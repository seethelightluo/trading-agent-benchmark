{
  "factor_id": "miner_2_20310724_dispersion_scaled_range_reversal_5d",
  "factor_name": "Dispersion-Scaled Five-Day Range Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "(0.5 - (close - rolling_min(close,5))/(rolling_max(close,5)-rolling_min(close,5))) * clip(cross_sectional_mean(abs(return - cross_sectional_mean(return))) / rolling_median_252(cross_sectional_mean(abs(return - cross_sectional_mean(return))), 0.5, 2.0)",
    "description": "Ranks assets for short-horizon mean reversion from their five-day range location, increasing the signal when cross-asset return dispersion is unusually high. Positive values favor assets near the bottom of their recent range and negative values favor assets near the top."
  },
  "dependencies": ["close", "daily_return"],
  "parameters": {"range_window": 5, "dispersion_median_window": 252, "dispersion_floor": 0.5, "dispersion_cap": 2.0, "forward_horizon_days": 1, "minimum_cross_section": 8},
  "validation": {
    "status": "EFFECTIVE",
    "timestamp": "2031-07-24T00:00:00Z",
    "period": "2020-01-02 through 2031-07-23",
    "universe_size": 15,
    "metrics": {
      "daily_ic": 0.031258,
      "daily_icir": 0.098692,
      "ic_hit_ratio": 0.5249,
      "observations": 3595,
      "average_instruments": 13.35,
      "coverage": 0.8659,
      "turnover": 0.1928,
      "max_abs_library_correlation": null,
      "decay_ic_1d": 0.031258,
      "regime_2020_2022_ic": 0.039558,
      "regime_2020_2022_icir": 0.125068,
      "regime_2023_2025_ic": 0.033745,
      "regime_2023_2025_icir": 0.110912,
      "regime_2026_2031_ic": 0.023962,
      "regime_2026_2031_icir": 0.073542
    },
    "signal_artifact": "scripts/miner_2_20310626_dispersion_range_signal.csv",
    "regime_notes": "Positive and above-gate through 2020-2022 and 2023-2025; remains positive in 2026-2031 but ICIR is below the benchmark gate in that subperiod. Full-history daily IC and ICIR pass the admission thresholds; uncertainty is material because the cross-section averages 13.35 instruments."
  },
  "tags": ["mean_reversion", "range", "cross_asset_dispersion", "short_horizon"]
}
