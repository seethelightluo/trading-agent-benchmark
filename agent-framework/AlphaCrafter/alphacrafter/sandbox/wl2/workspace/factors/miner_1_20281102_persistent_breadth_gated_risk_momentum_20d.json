  "factor_name": "Persistent Breadth-Gated Risk-Adjusted Momentum 20D",
  "version": "1.0",
  "calculation": {
    "expression": "shift_1((rolling_mean_5(2*(cross_sectional_fraction(rolling_sum_20(log_return)>0)-0.5), min_periods=3)) * (rolling_sum_20(log_return)/(rolling_std_20(log_return)*sqrt(20)+epsilon)))",
    "description": "Twenty-day risk-adjusted momentum scaled by the five-day average of the cross-asset breadth gate. The one-day lag ensures only completed bars are used; persistent breadth reduces sensitivity to a single noisy breadth observation."
