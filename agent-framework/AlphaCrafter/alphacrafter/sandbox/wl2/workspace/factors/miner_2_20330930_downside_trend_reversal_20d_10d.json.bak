  "factor_name": "Downside-Risk-Normalized Trend Reversal",
  "version": "20330930",
  "calculation": {
    "expression": "-cross_section_demean((close/close.shift(20)-1)/sqrt(mean_40(min(pct_change,0)^2)))",
