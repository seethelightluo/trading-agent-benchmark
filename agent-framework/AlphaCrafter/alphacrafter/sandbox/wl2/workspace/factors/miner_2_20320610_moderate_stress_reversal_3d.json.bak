{
  "factor_id": "miner_2_20320610_moderate_stress_reversal_3d",
  "factor_name": "Moderate Cross-Asset Stress-Gated Volatility-Normalized Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(rolling_sum(return,3)/rolling_std(return,20)) * I[dispersion_3d >= rolling_quantile(dispersion_3d,252,0.60) AND positive_breadth_3d <= 0.45]",
    "description": "For moderate cross-asset stress days, rank assets for reversal using the negative three-day return normalized by 20-day volatility. Stress is defined using cross-sectional standard deviation of three-day returns above its trailing 252-day 60th percentile and positive three-day breadth no greater than 45 percent. Signals are unavailable outside the gate."
  },
  "dependencies": ["close", "daily_returns"],
  "parameters": {"return_window_days": 3, "volatility_window_days": 20, "dispersion_window_days": 3, "dispersion_quantile_window_days": 252, "dispersion_quantile": 0.60, "positive_breadth_threshold": 0.45, "minimum_cross_section": 8},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2032-06-09",
    "validated_at": "2032-06-10T00:00:00Z",
    "metrics": {
