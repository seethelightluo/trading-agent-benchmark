{
  "factor_id": "miner_2_20350119_stress_conditioned_residual_reversal_40d",
  "factor_name": "Defensive-Basket Stress-Conditioned Beta-Neutral Residual Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "I(sum_{t-59..0} defensive_basket_return_t > 0) * [-sum_{t-29..0}(r_i,t-beta_i,t*r_def,t)] / [sqrt(30)*rolling_std_60(residual_i)]",
    "description": "Estimate lagged 90-session beta to the equal-weight defensive basket (XAU, US10Y, CN10Y), compute beta-neutral residual returns, and reverse the prior 30-session residual return scaled by lagged 60-session residual volatility. Activate only when the defensive basket's lagged 60-session cumulative return is positive. All inputs are shifted to avoid look-ahead."
  },
  "dependencies": [
    "close",
    "XAU",
    "US10Y",
    "CN10Y"
  ],
  "parameters": {
    "defensive_basket": [
      "XAU",
      "US10Y",
      "CN10Y"
    ],
    "beta_window": 90,
    "beta_min_periods": 60,
    "reversal_window": 30,
    "reversal_min_periods": 20,
    "volatility_window": 60,
    "volatility_min_periods": 40,
    "activation_window": 60,
    "forecast_horizon_days": 40,
    "activation": "defensive_basket_60d_return > 0"
  },
