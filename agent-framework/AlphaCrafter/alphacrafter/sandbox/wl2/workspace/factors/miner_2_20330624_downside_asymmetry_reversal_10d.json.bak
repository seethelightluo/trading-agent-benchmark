{
  "factor_id": "miner_2_20330624_downside_asymmetry_reversal_10d",
  "factor_name": "Downside-Asymmetry Reversal 10-Day",
  "version": "2033.06.24",
  "calculation": {
    "expression": "-(cross_sectional_demean(sum(ret_1d,60)/std(ret_1d,60) + 0.8*(mean(ret_1d,60 where ret>0)/mean(-ret_1d,60 where ret<0)-1)))",
    "description": "For each tradable asset, combine 60-session volatility-scaled cumulative return with upside/downside average-move asymmetry, demean across the 15-asset universe, and reverse the score. The signal is evaluated using information available through the prior completed session; higher values indicate expected lower subsequent 10-session returns in the raw construction, so portfolio direction should use the negative IC orientation."
  },
  "dependencies": ["close", "daily_returns"],
  "parameters": {"lookback_days": 60, "holding_horizon_days": 10, "asymmetry_weight": 0.8, "cross_section": "all_15_tradable_assets", "minimum_history": 61},
