{
  "factor_id": "macro_breadth_shock_residual_reversal_5d_1d",
  "factor_name": "VIX High-Breadth Stress Residual Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "- (asset_return_5d - cross_sectional_median_return_5d) when VIX > trailing_252d_70th_percentile and trailing_5d_mean_breadth < 0.45; else NaN",
    "description": "During elevated VIX and weak market breadth, rank assets by the negative five-day return residual versus the 15-asset cross-sectional median; larger values identify relative laggards expected to rebound over the next day. Uses only information available at signal date."
  },
  "dependencies": [
    "close",
    "VIX",
    "cross_sectional_returns"
  ],
  "parameters": {
    "residual_lookback_days": 5,
    "vix_lookback_days": 252,
    "vix_percentile": 0.7,
    "breadth_lookback_days": 5,
    "breadth_threshold": 0.45,
    "forward_horizon_days": 1
  },
