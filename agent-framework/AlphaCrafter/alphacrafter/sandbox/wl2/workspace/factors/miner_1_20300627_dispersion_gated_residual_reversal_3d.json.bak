{
  "factor_id": "miner_1_20300627_dispersion_gated_residual_reversal_3d",
  "factor_name": "Low-Dispersion Gated Cross-Asset Residual Shock Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "gate * -(sum_return_3d - cross_sectional_median(sum_return_3d)) / rolling_std_return_20d, where gate=1 if cross_sectional_dispersion_3d <= rolling_60_observation_median_dispersion, else 0.35",
    "description": "Reverses volatility-normalized three-day asset-specific shocks after removing the contemporaneous cross-asset median. The signal is full-strength in relatively quiet cross-sectional dispersion regimes and attenuated to 35% during unusually dispersed regimes, reducing exposure when moves are more likely to represent structural repricing. All inputs are lagged completed daily bars at decision time."
  },
  "dependencies": ["close", "daily_returns"],
  "parameters": {"shock_window_days": 3, "volatility_window_days": 20, "dispersion_window_days": 3, "dispersion_history_observations": 60, "high_dispersion_gate": 0.35, "minimum_cross_section": 8},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2030-06-27",
    "validation_timestamp": "2030-06-27T00:00:00Z",
    "metrics": {
      "horizon_days": 1,
      "ic": 0.030031,
      "icir": 0.084003,
      "hit_ratio": 0.5386,
      "dates": 3175,
      "average_instruments_per_date": 13.466,
      "factor_coverage": 0.8978,
      "turnover": "signal artifact available; not summarized as portfolio turnover",
      "decay_ic": {"1d": 0.030031, "5d": 0.028679, "10d": 0.009988},
      "max_abs_library_correlation": null
    },
    "regime_notes": "Daily cross-sectional IC gate passed narrowly; predictive effect is strongest at 1d and decays by 10d. Recent 2030-01-01 onward IC/ICIR was 0.055234/0.164261, but subperiod variation is material and the 15-asset cross-section implies uncertainty.",
    "signal_artifact": "scripts/miner_1_20300627_dispersion_gated_residual_reversal_signal.csv",
