{
  "factor_id": "miner_1_20310918_dispersion_reversal_5d",
  "factor_name": "Elevated-dispersion risk-normalized residual reversal",
  "version": "1.0",
  "calculation": {
    "expression": "where(cs_return_5d / volatility_20d is active, -cs_return_5d / volatility_20d, null)",
    "description": "For each tradable benchmark, take the negative five-day cumulative return relative to the daily cross-sectional median, normalize by trailing 20-day daily return volatility, and activate only when cross-sectional daily return dispersion exceeds its trailing 252-day 60th percentile. Values use completed-day data and are lagged for forward-return testing. Higher values indicate stronger short-horizon reversal potential."
  },
  "dependencies": ["close", "pct_change", "cross_sectional_median", "cross_sectional_dispersion"],
  "parameters": {"shock_window_days": 5, "volatility_window_days": 20, "dispersion_window_days": 252, "dispersion_quantile": 0.60, "min_dispersion_history": 100, "min_valid_cross_section": 8},
  "validation": {
