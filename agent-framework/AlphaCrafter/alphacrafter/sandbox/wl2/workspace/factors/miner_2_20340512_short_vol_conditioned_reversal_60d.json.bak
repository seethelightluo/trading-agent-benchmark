{
  "factor_id": "miner_2_20340512_short_vol_conditioned_reversal_60d",
  "factor_name": "Short Reversal with Volatility Conditioning",
  "version": "1.0",
  "calculation": {
    "expression": "shift_1(-(close/close[-3]-1) / (sqrt(3)*std(log_returns,20)) / (1 + std(log_returns,20)/std(log_returns,60)))",
    "description": "Reverse the lagged three-session return, normalize by 20-session realized volatility, and attenuate the signal when current volatility is elevated versus its 60-session baseline. Higher values indicate stronger expected forward returns."
  },
  "dependencies": ["close"],
  "parameters": {"lookback_return": 3, "vol_window": 20, "vol_baseline_window": 60, "lag": 1, "validation_horizon": 60},
  "validation": {
