{
  "factor_id": "miner_3_20320304_asymmetric_downside_residual_reversal_5d_1d",
  "factor_name": "Asymmetric Downside Residual Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "where(active & residual_5d < 0, -residual_5d / rolling_std(return,20), NaN)",
    "description": "Cross-sectional 5-day return residual versus the universe mean, risk-scaled by 20-day volatility, and activated only for unusually weak relative performers during broad downside and elevated dispersion. The asymmetric negative-residual restriction targets reversal of downside shocks."
  },
  "dependencies": ["close"],
  "parameters": {
    "residual_window_days": 5,
    "volatility_window_days": 20,
    "dispersion_window_days": 5,
    "dispersion_baseline_days": 60,
