  "factor_id": "stress_downside_shock_reversal_10d",
  "factor_name": "VIX-Stress Downside Shock Reversal, 10-day",
  "version": "1.0",
  "calculation": {
    "expression": "max(0, -sum(return,10)/(rolling_std(return,20)*sqrt(10))) * I(VIX > rolling_quantile(VIX,252,0.70))",
    "description": "Volatility-normalized ten-session downside shock, activated only when the observation-only VIX signal is above its trailing 252-session 70th percentile; larger downside shocks receive larger expected rebound scores."
  },
  "dependencies": ["close", "VIX"],
  "parameters": {"shock_lookback_days": 10, "volatility_lookback_days": 20, "vix_quantile_lookback_days": 252, "vix_quantile": 0.70, "forward_horizon_days": 1},
