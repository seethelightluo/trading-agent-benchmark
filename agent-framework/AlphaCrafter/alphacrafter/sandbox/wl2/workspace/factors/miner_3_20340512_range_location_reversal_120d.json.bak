{
  "factor_id": "miner_3_20340512_range_location_reversal_120d",
  "factor_name": "120-day range-location reversal with volatility tilt",
  "version": "1.0",
  "calculation": {
    "expression": "(1 - (close - rolling_min(close,120))/(rolling_max(close,120)-rolling_min(close,120))) * cross_sectional_percentile_rank(rolling_std(log_return,20))",
    "description": "Ranks instruments higher when they are near the bottom of their trailing 120-day price range, with a stronger score for higher recent volatility; signal is lagged one session to avoid look-ahead."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "range_window": 120,
    "volatility_window": 20,
    "forward_horizon": 40,
    "signal_lag": 1,
    "min_cross_section": 8
  },
