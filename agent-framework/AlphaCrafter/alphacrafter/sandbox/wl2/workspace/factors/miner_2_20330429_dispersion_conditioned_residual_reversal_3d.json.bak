  "factor_name": "High-dispersion cross-asset residual reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(asset_return_5d - cross_sectional_median_return_5d) / rolling_std(asset_daily_return,20), active when rolling20d mean cross-sectional daily dispersion exceeds its trailing252d 70th percentile",
    "description": "Ranks unusually weak assets for subsequent mean reversion during elevated cross-asset dispersion; volatility normalization avoids rewarding merely high-risk instruments. Signal is lagged and uses only completed daily bars."
  },
  "dependencies": ["close"],
  "parameters": {"return_window": 5, "volatility_window": 20, "dispersion_window": 20, "regime_lookback": 252, "regime_quantile": 0.70, "forward_horizon_days": 3, "minimum_cross_section": 8},
