  "factor_name": "Volatility-Normalized Three-Day Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-sum(pct_change(close, 3)) / (std(pct_change(close), 20) + 1e-6)",
    "description": "Ranks assets higher when their completed three-day return is more negative after scaling by trailing 20-day daily realized volatility; predicts next-day cross-sectional returns. Uses no future data."
  },
  "dependencies": [
    "close"
  ],
  "parameters": {
    "reversal_window_days": 3,
    "volatility_window_days": 20,
    "epsilon": 1e-06,
    "forward_horizon_days": 1
  },
