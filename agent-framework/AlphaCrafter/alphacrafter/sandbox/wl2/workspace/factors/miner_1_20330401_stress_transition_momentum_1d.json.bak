  "dependencies": ["close", "daily_returns"],
  "parameters": {"residual_horizon_days": 5, "volatility_window_days": 20, "volatility_baseline_days": 60, "breadth_threshold": 0.60, "market_momentum_window_days": 20, "volatility_transition_threshold": 0.15, "forward_horizon_days": 1},
