{
  "factor_id": "miner_3_20350119_stress_conditioned_residual_reversal_40d",
  "factor_name": "Stress-conditioned defensive-beta residual reversal",
  "version": "1.0",
  "calculation": {
    "expression": "where(mean_return(XAU,US10Y,CN10Y,60) lagged > 0, -rolling_sum(residual_return_90d_beta,30) lagged / (lagged_residual_volatility_60d * sqrt(30)), null)",
    "description": "Compute each tradable asset's daily return residual after lagged 90-session beta to the defensive basket (XAU, US10Y, CN10Y). Fade the lagged 30-session cumulative residual, scale by lagged 60-session residual volatility, and activate only when the defensive basket's lagged 60-session cumulative return is positive. All inputs are lagged to prevent look-ahead."
  },
  "dependencies": ["close", "XAU close", "US10Y close", "CN10Y close"],
  "parameters": {"beta_window": 90, "beta_min_periods": 60, "residual_vol_window": 60, "residual_vol_min_periods": 40, "reversal_window": 30, "activation_window": 60, "forward_horizon": 40, "minimum_cross_section": 8},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 to 2035-01-19",
    "metrics": {
      "ic": 0.073466,
