      "turnover": 0.0617,
      "decay_horizon": "40d",
      "max_abs_library_correlation": null
    },
    "thresholds": {"absolute_daily_paper_ic_min": 0.007, "absolute_daily_paper_icir_min": 0.084},
    "regime_notes": "Strong in 2026-2030 (IC 0.154278, ICIR 0.474164); near flat in 2031-2035 (IC -0.003582, ICIR -0.010595); materially negative in 2034-2035 (IC -0.170756, ICIR -0.572364). Treat as drift-sensitive and attenuate during recent adverse regime.",
