{
  "factor_id": "miner_3_20350216_persistent_stress_residual_reversal_40d",
  "factor_name": "Persistent stress-conditioned defensive residual reversal",
  "version": "1.0",
  "calculation": {
    "expression": "where(defensive_basket_sharpe_60 > 0.25 and positive_basket_days_40 > 0.55, -residual_return_30 / (residual_volatility_60 * sqrt(30)), NaN)",
    "description": "Compute lagged 90-day beta of each tradable asset to the equal-weight XAU, US10Y, CN10Y defensive basket, remove beta exposure from daily returns, and reverse the prior 30-day residual return normalized by lagged 60-day residual volatility. Activate only when the lagged 60-day defensive basket Sharpe exceeds 0.25 and more than 55% of the prior 40 basket-return observations are positive. All inputs are shifted to avoid look-ahead."
  },
  "dependencies": [
    "close",
    "XAU close",
    "US10Y close",
    "CN10Y close"
  ],
  "parameters": {
    "beta_window": 90,
    "beta_min_periods": 60,
    "residual_vol_window": 60,
    "residual_vol_min_periods": 40,
    "reversal_window": 30,
    "activation_sharpe_window": 60,
    "activation_sharpe_threshold": 0.25,
    "persistence_window": 40,
    "persistence_min_periods": 30,
    "persistence_threshold": 0.55,
    "forward_horizon": 40,
    "minimum_cross_section": 8
  },
