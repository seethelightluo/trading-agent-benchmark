{
  "factor_id": "miner_1_20331223_smoothed_efficiency_trend_10_40d",
  "factor_name": "Smoothed multi-scale path-efficiency trend",
  "version": "1.0",
  "calculation": {
    "expression": "rank_cs(rolling_mean_3((log(close/close[-10])/rolling_sum_10(abs(log_return)))[-1] + (log(close/close[-40])/rolling_sum_40(abs(log_return))) [-1]) / 2)",
    "description": "Average lagged 10-session and 40-session directional path efficiency, cross-sectionally ranked and smoothed over three observations. Positive values favor efficient directional trends; negative values favor inefficient or reversing paths. The one-session lag prevents look-ahead."
