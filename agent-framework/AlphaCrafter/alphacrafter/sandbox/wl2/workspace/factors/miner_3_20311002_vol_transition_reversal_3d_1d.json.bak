{
  "factor_id": "miner_3_20311002_vol_transition_reversal_3d_1d",
  "factor_name": "Volatility-transition 3-day reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(sum_return_3d / rolling_std_20d) when median(asset_vol_5d/asset_vol_60d - 1) > 0.10 and median(abs(return_5d)) > 0.002; otherwise missing",
    "description": "During broad cross-asset volatility expansion and meaningful recent dispersion, fade each asset's three-day risk-adjusted move. The factor is intentionally conditional and contrarian."
  },
  "dependencies": ["close", "pct_change"],
  "parameters": {
    "return_window_days": 3,
    "volatility_window_days": 20,
    "volatility_short_window_days": 5,
    "volatility_baseline_window_days": 60,
    "volatility_shock_threshold": 0.10,
    "breadth_activity_threshold": 0.002,
    "minimum_cross_section": 8
  },
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2031-10-01",
