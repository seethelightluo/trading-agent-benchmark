{
  "factor_id": "miner_1_20330203_conditional_slow_shock_reversal_1d",
  "factor_name": "Conditional Slow Residual Shock Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "gate * (-rolling_sum(residual_return,10).shift(1) / rolling_std(return,30).shift(1))",
    "description": "Cross-sectional reversal of lagged 10-day residual shocks, volatility scaled and activated when lagged downside breadth is 60%-87% and lagged 20-day mean market return is negative. All inputs are lagged.",
    "signal_artifact": "scripts/miner_1_20330203_conditional_slow_shock_reversal_signal.csv"
  },
  "dependencies": ["close", "daily_returns"],
  "parameters": {"residual_window_days": 10, "volatility_window_days": 30, "breadth_lower": 0.60, "breadth_upper": 0.87, "macro_mean_window_days": 20, "forward_horizon_days": 1},
  "validation": {
