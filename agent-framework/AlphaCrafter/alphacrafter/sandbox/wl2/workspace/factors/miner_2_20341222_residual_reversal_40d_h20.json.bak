  "factor_name": "40-Day Cross-Asset Residual Reversal Volatility-Scaled",
  "version": "1.0",
  "calculation": {
    "expression": "-rolling_sum_40(log_return_i - equal_weight_cross_asset_log_return) / (sqrt(40) * rolling_std_60(log_return_i - equal_weight_cross_asset_log_return))",
    "description": "For each tradable benchmark asset, accumulate 40 sessions of return residual versus the equal-weight cross-asset return, reverse the residual direction, and volatility-scale it using 60-session residual volatility. Higher values indicate stronger expected medium-horizon rebound."
  },
  "dependencies": ["close"],
