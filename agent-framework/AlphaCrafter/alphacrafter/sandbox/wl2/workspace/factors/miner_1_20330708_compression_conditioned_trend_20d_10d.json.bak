  "factor_name": "Compression-conditioned volatility-normalized medium trend",
  "version": "1.0",
  "calculation": {
    "expression": "lagged_20d_return / lagged_60d_volatility * lagged_60d_volatility / lagged_10d_volatility, active when at least 8 of 15 assets have lagged 10d volatility below lagged 60d volatility",
    "description": "Ranks medium-term trend by a volatility-normalized return, activated only on dates where compression is present across a majority of the tradable cross-asset universe. All inputs are shifted one completed day before signal use."
  },
  "dependencies": [
    "close",
    "pct_change"
  ],
