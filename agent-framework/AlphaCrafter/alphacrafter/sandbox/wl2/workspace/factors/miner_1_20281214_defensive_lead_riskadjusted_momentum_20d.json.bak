{
  "factor_id": "miner_1_20281214_defensive_lead_riskadjusted_momentum_20d",
  "factor_name": "Defensive-Leadership Risk-Adjusted Momentum",
  "version": "1.0",
  "calculation": {
    "expression": "(mom20 / vol20) - cross_sectional_median(mom20 / vol20), multiplied by (1 + clip(rolling_mean_5(defensive_mom_lead), -0.5, 0.5)); lag 1 day",
    "description": "Ranks 20-day momentum by recent volatility, demeaned across the 15 tradable assets, and modulates it with the five-day average leadership of XAU, US10Y and CN10Y relative to SPX, NDX and 000300.SH. All inputs are lagged one completed trading day."
  },
  "dependencies": ["close"],
  "parameters": {"momentum_window": 20, "volatility_window": 20, "lead_smoothing": 5, "defensive_assets": ["XAU", "US10Y", "CN10Y"], "cyclical_assets": ["SPX", "NDX", "000300.SH"], "lead_clip": [-0.5, 0.5], "lag_days": 1},
  "validation": {
    "status": "EFFECTIVE",
    "period": "2020-01-01 through 2028-12-13",
    "validated_horizon": "10D",
    "metrics": {"ic": 0.030790, "icir": 0.098110, "hit_ratio": 0.5353, "valid_dates": 2989, "average_instruments": 14.8, "coverage": 0.9867, "turnover": null, "max_abs_library_correlation": null},
    "regime_notes": "Passes benchmark IC and ICIR gates over the full history; recent 2027-01-01 onward IC was -0.021689 and ICIR -0.074320, so current drift is adverse and ensemble weight should be conservative.",
    "signal_artifact": "scripts/miner_1_20281214_defensive_lead_riskadj_signal.csv",
    "admission_thresholds": {"absolute_ic_min": 0.007, "absolute_icir_min": 0.084}
  },
  "tags": ["momentum", "risk_adjusted", "defensive_lead", "cross_asset", "regime_conditioned"],
  "last_validated": "2028-12-14T00:00:00"
}
