{
  "factor_id": "miner_2_20330203_dispersion80_residual3_reversal_1d",
  "factor_name": "High-dispersion three-day residual reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-((sum_return_i_3d - cross_sectional_median(sum_return_3d))/rolling_std(return_i_1d,20)).shift(1) activated when lagged 5d mean cross-sectional volatility exceeds its trailing 252d 80th percentile",
    "description": "Ranks assets for next-day returns by reversing their three-day return residual versus the universe median, volatility scaled and gated to unusually high cross-asset dispersion. All signal components are lagged one completed trading day."
  },
  "dependencies": ["close", "pct_change"],
  "parameters": {"lookback_return_days": 3, "volatility_window": 20, "dispersion_window": 5, "dispersion_quantile": 0.8, "dispersion_history_days": 252, "minimum_history": 100, "minimum_cross_section": 8},
