{
  "factor_id": "miner_2_20270325_volume_range_reversal",
  "factor_name": "Volume-and-range normalized intraday reversal",
  "version": "2027-03-25.v1",
  "calculation": {
    "expression": "-(close/open - 1) * clip(volume / rolling_median(volume,20), 0, 4) / (abs(close/open - 1) + (high/low - 1) + epsilon)",
    "description": "Ranks assets for next-day reversal using the negative open-to-close return, amplified by abnormal volume and normalized by the day's total range to avoid treating tiny moves as large signals. Volume median uses the trailing 20 observations and all inputs are lagged at decision time."
  },
  "dependencies": ["open", "close", "high", "low", "volume"],
  "parameters": {
    "volume_window": 20,
    "volume_clip": [0, 4],
    "epsilon": 1e-08,
    "forward_horizon_days": 1
  },
