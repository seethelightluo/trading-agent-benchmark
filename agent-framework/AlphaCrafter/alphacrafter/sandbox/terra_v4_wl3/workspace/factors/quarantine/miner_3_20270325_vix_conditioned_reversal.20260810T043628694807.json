{
  "factor_id": "miner_3_20270325_vix_conditioned_reversal",
  "factor_name": "VIX-Conditioned Intraday Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-CLV_t * abs(close_t/open_t-1) / rolling_median_20(abs(close/open-1)) * (1 + clip((VIX_t - rolling_median_60(VIX))/rolling_std_60(VIX), 0, 3)/3)",
    "description": "Fades weak/strong close-location and unusually large intraday moves, increasing reversal exposure only when contemporaneous VIX is elevated relative to its trailing 60-day distribution. VIX is used only as an observation signal; the factor is applied to the 15 tradable assets. All inputs are known by the decision timestamp."
  },
  "dependencies": ["open", "high", "low", "close", "VIX"],
  "parameters": {"intraday_abs_window": 20, "vix_window": 60, "vix_min_periods": 30, "clv_clip": 0.5, "stress_z_clip": [0, 3], "minimum_cross_section": 8},
