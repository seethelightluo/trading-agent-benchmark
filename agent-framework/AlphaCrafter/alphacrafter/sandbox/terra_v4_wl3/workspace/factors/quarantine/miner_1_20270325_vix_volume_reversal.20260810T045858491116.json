{
  "factor_id": "miner_1_20270325_vix_volume_reversal",
  "factor_name": "VIX- and Volume-Shock Conditioned Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "clip(-pct_change(close,2)/rolling_std(pct_change(close),10),-10,10) * (1 + 0.75*max(positive_clip((pct_change(VIX)-rolling_median(pct_change(VIX),20)),-0.5,0.5),0)) * (1 + 0.35*max(positive_clip(log(volume)-rolling_median(log(volume),20),-3,3),0))",
    "description": "Two-day volatility-normalized contrarian return, amplified only during positive VIX shocks and positive asset-specific volume shocks. VIX is observation-only and is never traded."
  },
  "dependencies": ["close", "volume", "VIX.close"],
  "parameters": {"return_window": 2, "volatility_window": 10, "macro_window": 20, "volume_window": 20, "vix_amplifier": 0.75, "volume_amplifier": 0.35, "minimum_valid_cross_section": 8},
