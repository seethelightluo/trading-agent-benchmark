  "factor_name": "Conditional Cross-Asset Stress Rebound",
  "version": "1.0",
  "calculation": {
    "expression": "-zscore_cs(ret_3d - median_cs(ret_3d)) * clip((breadth_5d_down - 0.5) / 0.25, 0, 1)",
    "description": "Fade each asset's three-day return relative to the cross-sectional median only when the fraction of assets with negative five-day returns indicates broad market stress. Cross-sectional z-normalization makes the reversal comparable across dates; the signal is zero outside stressed regimes."
  },
  "dependencies": ["close"],
