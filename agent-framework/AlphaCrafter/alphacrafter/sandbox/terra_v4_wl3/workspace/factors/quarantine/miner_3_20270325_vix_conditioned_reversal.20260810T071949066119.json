{
  "factor_id": "miner_3_20270325_vix_conditioned_reversal",
  "factor_name": "VIX-Conditioned Intraday Close-Location Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-CLV_t * abs(close_t/open_t-1) / median20(abs(close/open-1)) * (1 + clip(z60(VIX_t),0,3)/3)",
    "description": "For each tradable benchmark, fade the prior completed day's intraday close-location and scale by its intraday move relative to a 20-day median. Amplify only when the observation-only VIX level is above its trailing 60-day mean in standardized units. Signal is formed using data through the prior completed day. CLV is ((close-low)/(high-low)-0.5), clipped to [-0.5,0.5]."
  },
  "dependencies": ["open", "high", "low", "close", "VIX"],
  "parameters": {
    "intraday_vol_window": 20,
    "vix_window": 60,
    "vix_min_periods": 30,
    "vix_amplification_cap_z": 3.0,
    "minimum_cross_section": 8
  },
