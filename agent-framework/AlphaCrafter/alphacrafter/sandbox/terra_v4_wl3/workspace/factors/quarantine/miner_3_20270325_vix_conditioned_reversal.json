{
  "factor_id": "miner_3_20270325_vix_conditioned_reversal",
  "factor_name": "VIX-Conditioned Intraday Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "(-(CLV_t-0.5) * clip(abs(close_t/open_t-1) / rolling_median_20(abs(close/open-1)), 0, 5)) * (1 + clip((VIX_t-rolling_median_60(VIX))/rolling_std_60(VIX), 0, 3)/3)",
    "description": "Contrarian close-location/intraday-move signal, amplified progressively during elevated VIX stress. CLV is (close-low)/(high-low); all inputs are observable through the prior completed day at decision time. Cross-sectional higher values indicate stronger long preference."
