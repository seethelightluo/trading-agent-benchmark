  "factor_name": "Dispersion-Conditioned Relative Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(R_3d_i - median_j(R_3d_j)) / stdev_20d_i * (1 + clip(zscore_60d(cross_asset_mean_stdev_20d), 0, 3)/3)",
