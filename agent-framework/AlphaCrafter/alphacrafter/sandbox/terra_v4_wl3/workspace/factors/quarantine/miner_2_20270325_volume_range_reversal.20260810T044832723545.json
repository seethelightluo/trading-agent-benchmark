  "factor_name": "Volume- and Range-Adjusted Intraday Reversal",
  "version": "2027.03.25",
  "calculation": {
    "expression": "-(close/open - 1) * clip(volume/rolling_median(volume,20),0,4) * (1 - abs(close-open)/(high-low))",
    "description": "Fades the completed-session open-to-close return, emphasizing abnormal-volume sessions while downweighting sessions whose body consumed most of the daily range. All inputs are lag-safe at the next decision.",
    "signal_artifact": "scripts/miner_2_20270325_volume_range_reversal_signal.csv"
  },
  "dependencies": ["open", "close", "high", "low", "volume"],
  "parameters": {"volume_window": 20, "volume_clip_low": 0, "volume_clip_high": 4, "minimum_history": 10, "minimum_cross_section": 8},
