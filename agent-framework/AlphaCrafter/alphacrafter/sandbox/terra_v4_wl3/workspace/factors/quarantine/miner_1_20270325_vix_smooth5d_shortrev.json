  "factor_name": "VIX-smoothed volatility-normalized five-day short reversal",
  "version": "1.0",
  "calculation": {
    "expression": "clip(-sum(return,5)/rolling_std(return,20), -6, 6) * (1 + 0.30*max(standardized_VIX_change_10d,0)/3)",
    "description": "Ranks assets by five-session contrarian return normalized by 20-session realized volatility. The reversal signal is moderately amplified when the observation-only VIX has a positive standardized ten-session shock, with all inputs lagged to the last completed session."
