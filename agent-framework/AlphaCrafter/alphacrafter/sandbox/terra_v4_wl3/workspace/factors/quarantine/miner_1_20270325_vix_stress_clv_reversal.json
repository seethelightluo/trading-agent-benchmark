{
  "factor_id": "miner_1_20270325_vix_stress_clv_reversal",
  "factor_name": "VIX-stress close-location reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-CLV_t * abs(close_t/open_t-1) / rolling_median_20(abs(close/open-1)) * (1 + clip(zscore_60(VIX_t), 0, 3)/3)",
    "description": "For each tradable asset, fade an unusually strong intraday move using the negative close-location value, then amplify the reversal signal when VIX is above its recent 60-day median. CLV is (close-low)/(high-low)-0.5 and is clipped to [-0.5,0.5]. The VIX multiplier is based only on information available at the signal date. Cross-sectional use is permitted with the available 15-asset universe."
  },
  "dependencies": ["open", "high", "low", "close", "VIX close"],
  "parameters": {
    "intraday_abs_window": 20,
    "vix_window": 60,
    "vix_median_min_periods": 30,
    "vix_std_min_periods": 30,
    "clv_clip": [-0.5, 0.5],
    "vix_z_clip": [0, 3],
    "forward_horizon_days": 1,
    "minimum_cross_section": 8
  },
