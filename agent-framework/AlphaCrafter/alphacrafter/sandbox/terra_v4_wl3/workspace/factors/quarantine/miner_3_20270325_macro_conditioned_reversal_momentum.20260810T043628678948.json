  "factor_name": "Macro-Conditioned Reversal-Momentum Switch",
  "version": "1.0",
  "calculation": {
    "expression": "-ret_5d * I(VIX > rolling_median(VIX,60)) + ret_20d * (1-I(VIX > rolling_median(VIX,60)))",
    "description": "In elevated volatility regimes, favor cross-sectional short-term reversal by fading five-day returns; otherwise favor 20-day momentum. VIX is lagged to the decision date and prices are observed only through the prior completed day."
  },
  "dependencies": ["close", "VIX"],
  "parameters": {
    "reversal_window_days": 5,
    "momentum_window_days": 20,
    "vix_regime_window_days": 60,
