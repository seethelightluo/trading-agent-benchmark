{
  "factor_id": "miner_2_20270325_yieldspread_residual_reversal",
  "factor_name": "Yield-Spread-Stress Residual Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "clip(-residual_return_i,t * (1 + 0.30 * abs(clip((delta5(log(US10Y/CN10Y)) - rolling_median120) / (rolling_median120(abs(shock - rolling_median120)) + 1e-6), -3, 3))), -0.2, 0.2)",
    "description": "For each tradable instrument, remove its rolling 60-day beta exposure to the cross-sectional median market return, then reverse the residual daily shock. Amplify reversal modestly when the five-day log US10Y/CN10Y spread change is an extreme robust deviation. Yield series are tradable benchmark assets and are used as the conditioning series; no observation-only macro symbol is ordered. All inputs are lagged at decision time."
  },
  "dependencies": ["close", "US10Y close", "CN10Y close"],
  "parameters": {
    "beta_window": 60,
    "beta_min_periods": 30,
    "spread_change_horizon": 5,
    "stress_window": 120,
    "stress_min_periods": 60,
    "stress_clip": 3.0,
    "stress_amplifier": 0.30,
    "output_clip": 0.20,
    "minimum_cross_section": 8
  },
