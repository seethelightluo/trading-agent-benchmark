  "dependencies": ["open", "close", "high", "low", "volume"],
  "parameters": {"volume_window": 20, "volume_min_periods": 10, "volume_clip_lower": 0, "volume_clip_upper": 4, "minimum_cross_section": 8, "forward_horizons": [1,5,10]},
