  "factor_name": "Volume-Range Normalized Intraday Reversal",
  "version": "2027-03-25",
  "calculation": {
    "expression": "-(close/open - 1) * clip(volume/rolling_median(volume,20),0,4) * (1 - abs(close-open)/(high-low))",
    "description": "Reverses the signed open-to-close move, scales it by abnormal volume, and emphasizes sessions whose candle body is small relative to the daily range. Signals are computed using information available at the close and predict next-day cross-sectional return."
