{
  "factor_id": "miner_2_20270325_expanding_breakout",
  "factor_name": "ATR-Normalized Expanding Breakout Momentum",
  "version": "1.0",
  "calculation": {
    "expression": "((close / rolling_max(close,20)) - 1) / (median_true_range(20) / close) * sign(pct_change(close,5)) * (median_true_range(20) / median_true_range(60) - 1)",
    "description": "Measures directional breakout displacement from the 20-day high, normalized by recent ATR, and emphasizes expanding-volatility breakouts relative to the 60-day baseline. All inputs are lagged at decision time."
  },
  "dependencies": ["close", "high", "low"],
  "parameters": {"breakout_window": 20, "trend_window": 5, "atr_fast_window": 20, "atr_slow_window": 60},
  "validation": {
