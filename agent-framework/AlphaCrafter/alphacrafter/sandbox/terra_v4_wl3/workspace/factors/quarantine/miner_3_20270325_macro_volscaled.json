  "factor_name": "VIX-conditioned volatility-scaled reversal/momentum",
  "version": "1.0",
  "calculation": {
    "expression": "stress * (-sum_return_5 / rolling_std_return_10) + (1-stress) * (return_20 / rolling_std_return_20)",
    "description": "When observation-only VIX exceeds its trailing 60-session median, rank assets by five-session reversal scaled by their ten-session volatility; otherwise rank by twenty-session momentum scaled by twenty-session volatility. Signals use only completed daily data."
