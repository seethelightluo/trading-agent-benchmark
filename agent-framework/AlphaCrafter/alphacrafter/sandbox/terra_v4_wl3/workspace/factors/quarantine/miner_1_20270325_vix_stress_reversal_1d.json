{
  "factor_id": "vix_stress_reversal_1d",
  "factor_name": "VIX-Stress Conditional One-Day Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-pct_change_1d(asset_close) * I(VIX_return > rolling_quantile(VIX_return, 20, 0.60))",
    "description": "Reverse each tradable asset's latest daily return only on sessions where the observation-only VIX daily return exceeds its trailing 20-session 60th percentile. Signal is zero outside stress sessions. VIX is used solely as a macro conditioning signal and is not tradable."
  },
  "dependencies": ["close", "VIX.close"],
  "parameters": {"lookback_return_days": 1, "vix_quantile_window": 20, "vix_quantile": 0.60, "minimum_quantile_observations": 10},
  "validation": {
