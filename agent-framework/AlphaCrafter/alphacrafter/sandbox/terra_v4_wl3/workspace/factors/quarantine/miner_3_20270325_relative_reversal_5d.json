  "factor_name": "Cross-Sectional Relative Reversal 5D Vol-Scaled",
  "version": "1.0",
  "calculation": {
    "expression": "-(return_5d(asset) - cross_sectional_median(return_5d)) / rolling_std(daily_return,20)",
    "description": "Fade each instrument's five-session return relative to the contemporaneous universe median, scaled by its own 20-session daily volatility. Positive values identify relatively weaker assets expected to mean-revert. The signal uses only data available through the completed signal date."
  },
  "dependencies": ["close", "daily_return"],
  "parameters": {"lookback_return_days": 5, "volatility_window_days": 20, "minimum_volatility_observations": 10, "minimum_cross_section": 8},
