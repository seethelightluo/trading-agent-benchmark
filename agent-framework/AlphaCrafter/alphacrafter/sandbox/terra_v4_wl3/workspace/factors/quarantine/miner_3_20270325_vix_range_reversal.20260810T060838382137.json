{
  "factor_id": "miner_3_20270325_vix_range_reversal",
  "factor_name": "VIX-Regime and Range-Expansion Volatility-Normalized Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "clip(-(3d_return)/(sqrt(3)*rolling_std(return,15)) * (1+0.5*max(0, rolling_mean((high-low)/close,5)/rolling_median((high-low)/close,30)-1)) * (1+0.35*VIX_252d_percentile), -12, 12)",
    "description": "Fades each instrument's three-day return after volatility normalization. The reversal is amplified by instrument-level range expansion and by the percentile rank of observation-only VIX over its trailing 252-day history. VIX is used solely as a macro conditioning signal and is never traded. All inputs are lagged/available at the decision timestamp."
  },
  "dependencies": ["close", "high", "low", "VIX.close"],
  "parameters": {
    "return_lookback_days": 3,
    "volatility_window_days": 15,
    "range_fast_window_days": 5,
    "range_baseline_window_days": 30,
    "vix_percentile_window_days": 252,
    "range_weight": 0.5,
    "vix_weight": 0.35,
    "clip_limits": [-12, 12],
    "minimum_valid_observations": 8
  },
