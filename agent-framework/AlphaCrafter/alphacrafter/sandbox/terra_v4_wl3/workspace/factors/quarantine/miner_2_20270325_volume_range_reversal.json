  "factor_name": "Volume-Weighted Intraday Range Reversal",
  "version": "1.0",
  "calculation": {
    "expression": "-(close/open - 1) * clip(volume/rolling_median(volume,20),0,4) * (1 - abs(close-open)/(high-low))",
    "description": "Contrarian next-day return signal: fade the intraday move, emphasizing abnormal volume and sessions whose close is near the middle of the high-low range; zero/invalid ranges are excluded."
  },
  "dependencies": ["open", "close", "high", "low", "volume"],
  "parameters": {"volume_window": 20, "volume_min_periods": 10, "volume_clip_lower": 0, "volume_clip_upper": 4, "minimum_cross_section": 8},
