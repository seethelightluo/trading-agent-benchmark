  "factor_name": "VIX-Stress-Conditioned Intraday Reversal",
  "version": "2027-03-25",
  "calculation": {
    "expression": "-CLV_t * abs(close_t/open_t-1) / rolling_median(abs(close/open-1),20), CLV=(close-low)/(high-low)-0.5, multiplied by 1+clip((VIX-rolling_median(VIX,60))/rolling_std(VIX,60),0,3)/3",
    "description": "Fades unusually strong intraday moves and weak/strong close-location outcomes, with the contrarian signal amplified during elevated VIX stress. All inputs are lag-safe and use data through the signal date only."
