  "dependencies": ["open", "high", "low", "close", "VIX.close"],
  "parameters": {
    "intraday_move_median_window": 20,
    "vix_window": 60,
    "vix_median_min_periods": 30,
    "vix_stress_clip": [0, 3],
    "minimum_cross_section": 8
  },
